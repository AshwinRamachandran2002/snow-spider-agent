```sql
--Description: 
-- We want, for every actor, the 3 films that earn the most money *for that actor*,
-- where a film’s revenue is divided equally among its cast.  We also need the
-- actor’s average revenue across those top-3 films.
--
-- 1. film_rev    : total revenue per film (sum of all payments tied to that film).
-- 2. actor_count : how many actors each film has (to split revenue).
-- 3. actor_film  : revenue_per_actor = total_revenue ÷ actor_count for every
--                  actor–film pair.
-- 4. ranked      : rank the films inside each actor by revenue_per_actor.
-- 5. top3        : keep rows whose rank ≤ 3 (the actor’s best three films).
-- 6. final SELECT joins back to actor/film tables for readable names and
--    adds a window AVG() to compute the actor’s mean revenue over those
--    top-3 films (avg_top3_revenue).
WITH film_rev AS (
        SELECT i.film_id,
               SUM(p.amount) AS total_revenue
        FROM   inventory  AS i
        JOIN   rental     AS r ON r.inventory_id = i.inventory_id
        JOIN   payment    AS p ON p.rental_id    = r.rental_id
        GROUP  BY i.film_id
), actor_count AS (
        SELECT film_id,
               COUNT(*) AS actor_cnt
        FROM   film_actor
        GROUP  BY film_id
), actor_film AS (
        SELECT fa.actor_id,
               fa.film_id,
               fr.total_revenue / ac.actor_cnt AS revenue_per_actor
        FROM   film_actor  AS fa
        JOIN   film_rev    AS fr ON fr.film_id = fa.film_id
        JOIN   actor_count AS ac ON ac.film_id = fa.film_id
), ranked AS (
        SELECT actor_id,
               film_id,
               revenue_per_actor,
               RANK() OVER (PARTITION BY actor_id
                            ORDER BY revenue_per_actor DESC) AS rk
        FROM   actor_film
), top3 AS (
        SELECT *
        FROM   ranked
        WHERE  rk <= 3
)
SELECT
       a.actor_id,
       a.first_name || ' ' || a.last_name                AS actor_name,
       f.film_id,
       f.title,
       ROUND(t.revenue_per_actor, 2)                     AS revenue_per_actor,
       ROUND(AVG(t.revenue_per_actor)
             OVER (PARTITION BY a.actor_id), 2)          AS avg_top3_revenue
FROM   top3  AS t
JOIN   actor AS a ON a.actor_id = t.actor_id
JOIN   film  AS f ON f.film_id  = t.film_id
ORDER  BY a.actor_id,
          t.revenue_per_actor DESC;
```
