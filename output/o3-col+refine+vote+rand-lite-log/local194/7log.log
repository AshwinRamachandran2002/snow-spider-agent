```sql
--Description: Final query – top three revenue-generating films for each actor (film revenue is split equally among its cast).  
--The inner sub-query that calculates film revenue no longer references an undefined alias “f”.
SELECT DISTINCT
       sub.actor_id,
       sub.actor_name,
       sub.film_id,
       sub.title,
       sub.revenue_per_actor
FROM (
        SELECT  a.actor_id,
                a.first_name || ' ' || a.last_name     AS actor_name,
                f.film_id,
                f.title,
                fr.total_revenue / ac.actor_count      AS revenue_per_actor,
                RANK() OVER (PARTITION BY a.actor_id
                             ORDER BY fr.total_revenue / ac.actor_count DESC) AS film_rank
        FROM   actor       AS a
        JOIN   film_actor  AS fa ON a.actor_id = fa.actor_id
        JOIN   film        AS f  ON f.film_id  = fa.film_id
        
        /* total revenue per film */
        JOIN  ( SELECT i.film_id,
                       SUM(p.amount) AS total_revenue
                FROM   inventory i
                JOIN   rental    r ON r.inventory_id = i.inventory_id
                JOIN   payment   p ON p.rental_id    = r.rental_id
                GROUP  BY i.film_id
              ) AS fr ON fr.film_id = f.film_id
        
        /* number of actors in each film */
        JOIN  ( SELECT film_id,
                       COUNT(*) AS actor_count
                FROM   film_actor
                GROUP  BY film_id
              ) AS ac ON ac.film_id = f.film_id
     ) AS sub
WHERE sub.film_rank <= 3
LIMIT 20;
```
