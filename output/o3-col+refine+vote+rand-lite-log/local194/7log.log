Query:
--Description: Compute revenue-per-actor for every actor-film combination. 
SELECT DISTINCT
       fa.actor_id,
       fa.film_id,
       t.total_revenue / ac.actor_count AS revenue_per_actor
FROM   film_actor AS fa
JOIN  (SELECT f.film_id,
              SUM(p.amount) AS total_revenue
       FROM   film      AS f
       JOIN   inventory AS i ON i.film_id      = f.film_id
       JOIN   rental    AS r ON r.inventory_id = i.inventory_id
       JOIN   payment   AS p ON p.rental_id    = r.rental_id
       GROUP  BY f.film_id)             AS t  ON t.film_id = fa.film_id
JOIN  (SELECT film_id,
              COUNT(*) AS actor_count
       FROM   film_actor
       GROUP  BY film_id)               AS ac ON ac.film_id = fa.film_id
LIMIT  20;
