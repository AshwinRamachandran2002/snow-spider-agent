```sql
--Description: Preview film IDs and titles to know the universe of films. 
SELECT DISTINCT
       film_id,
       title
FROM   film
LIMIT  20;
```

```sql
--Description: Show the bridge between actors and films (who acted in what). 
SELECT DISTINCT
       actor_id,
       film_id
FROM   film_actor
LIMIT  20;
```

```sql
--Description: Check some actor-film pairs together with the film title. 
SELECT DISTINCT
       a.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       f.title
FROM   actor       AS a
JOIN   film_actor  AS fa ON a.actor_id = fa.actor_id
JOIN   film        AS f  ON f.film_id  = fa.film_id
LIMIT  20;
```

```sql
--Description: See individual payment amounts tied to each film (via inventory → rental → payment). 
SELECT DISTINCT
       f.film_id,
       f.title,
       p.amount
FROM   film      AS f
JOIN   inventory AS i ON i.film_id      = f.film_id
JOIN   rental    AS r ON r.inventory_id = i.inventory_id
JOIN   payment   AS p ON p.rental_id    = r.rental_id
LIMIT  20;
```

```sql
--Description: Aggregate total revenue per film. 
SELECT DISTINCT
       t.film_id,
       t.total_revenue
FROM  (SELECT f.film_id,
              SUM(p.amount) AS total_revenue
       FROM   film      AS f
       JOIN   inventory AS i ON i.film_id      = f.film_id
       JOIN   rental    AS r ON r.inventory_id = i.inventory_id
       JOIN   payment   AS p ON p.rental_id    = r.rental_id
       GROUP  BY f.film_id) AS t
LIMIT  20;
```

```sql
--Description: Count how many actors each film has (needed to split revenue equally). 
SELECT DISTINCT
       film_id,
       actor_count
FROM  (SELECT film_id,
              COUNT(*) AS actor_count
       FROM   film_actor
       GROUP  BY film_id) AS ac
LIMIT  20;
```

```sql
--Description: Compute revenue-per-actor for every actor-film combination. 
SELECT DISTINCT
       fa.actor_id,
       fa.film_id,
       t.total_revenue / ac.actor_count AS revenue_per_actor
FROM   film_actor AS fa
JOIN  (SELECT f.film_id,
              SUM(p.amount) AS total_revenue
       FROM   film      AS f
       JOIN   inventory AS i ON i.film_id      = f.film_id
       JOIN   rental    AS r ON r.inventory_id = i.inventory_id
       JOIN   payment   AS p ON p.rental_id    = r.rental_id
       GROUP  BY f.film_id)             AS t  ON t.film_id = fa.film_id
JOIN  (SELECT film_id,
              COUNT(*) AS actor_count
       FROM   film_actor
       GROUP  BY film_id)               AS ac ON ac.film_id = fa.film_id
LIMIT  20;
```

```sql
--Description: Rank each actor’s films by revenue-per-actor (highest first). 
SELECT DISTINCT
       actor_id,
       film_id,
       revenue_per_actor,
       RANK() OVER (PARTITION BY actor_id
                    ORDER BY revenue_per_actor DESC) AS film_rank
FROM  (SELECT fa.actor_id,
              fa.film_id,
              t.total_revenue / ac.actor_count AS revenue_per_actor
       FROM   film_actor AS fa
       JOIN  (SELECT f.film_id,
                     SUM(p.amount) AS total_revenue
              FROM   film
              JOIN   inventory USING (film_id)
              JOIN   rental    USING (inventory_id)
              JOIN   payment   USING (rental_id)
              GROUP  BY f.film_id)  AS t  ON t.film_id = fa.film_id
       JOIN  (SELECT film_id,
                     COUNT(*) AS actor_count
              FROM   film_actor
              GROUP  BY film_id)     AS ac ON ac.film_id = fa.film_id)
LIMIT  20;
```

```sql
--Description: Final query – top three revenue-generating films for each actor with revenue per actor. 
SELECT DISTINCT
       actor_id,
       actor_name,
       film_id,
       title,
       revenue_per_actor
FROM  (SELECT a.actor_id,
              a.first_name || ' ' || a.last_name AS actor_name,
              f.film_id,
              f.title,
              t.total_revenue / ac.actor_count   AS revenue_per_actor,
              RANK() OVER (PARTITION BY a.actor_id
                           ORDER BY t.total_revenue / ac.actor_count DESC) AS film_rank
       FROM   actor      AS a
       JOIN   film_actor AS fa ON a.actor_id = fa.actor_id
       JOIN   film       AS f  ON f.film_id  = fa.film_id
       JOIN  (SELECT f.film_id,
                     SUM(p.amount) AS total_revenue
              FROM   film
              JOIN   inventory USING (film_id)
              JOIN   rental    USING (inventory_id)
              JOIN   payment   USING (rental_id)
              GROUP  BY f.film_id) AS t  ON t.film_id = f.film_id
       JOIN  (SELECT film_id,
                     COUNT(*) AS actor_count
              FROM   film_actor
              GROUP  BY film_id)     AS ac ON ac.film_id = f.film_id)
WHERE  film_rank <= 3
LIMIT  20;
```
