```sql
-- 1) List a few actors to become familiar with the identifiers we will use later
SELECT DISTINCT actor_id,
                first_name || ' ' || last_name  AS actor_name
FROM   actor
LIMIT 20;
```

```sql
-- 2) List a few films with their identifiers
SELECT DISTINCT film_id,
                title
FROM   film
LIMIT 20;
```

```sql
-- 3) Show which films each actor appeared in (many-to-many join sample)
SELECT DISTINCT fa.actor_id,
                a.first_name || ' ' || a.last_name AS actor_name,
                fa.film_id,
                f.title
FROM   film_actor AS fa
JOIN   actor      AS a ON a.actor_id = fa.actor_id
JOIN   film       AS f ON f.film_id  = fa.film_id
LIMIT 20;
```

```sql
-- 4) Compute total revenue generated by every film
SELECT DISTINCT f.film_id,
                f.title,
                SUM(p.amount) AS film_revenue
FROM   payment  AS p
JOIN   rental   AS r  ON r.rental_id   = p.rental_id
JOIN   inventory AS i ON i.inventory_id = r.inventory_id
JOIN   film      AS f ON f.film_id      = i.film_id
GROUP  BY f.film_id
ORDER  BY film_revenue DESC
LIMIT 20;
```

```sql
-- 5) How many actors does each film have?
SELECT DISTINCT film_id,
                COUNT(*) AS actor_cnt
FROM   film_actor
GROUP  BY film_id
ORDER  BY actor_cnt DESC
LIMIT 20;
```

```sql
-- 6) Revenue that belongs to every actor-film pair
--    (total film revenue divided equally among its actors)
SELECT DISTINCT fa.actor_id,
                fa.film_id,
                fr.film_revenue / ac.actor_cnt AS revenue_per_actor
FROM   film_actor AS fa
JOIN   (        -- sub-query from step-4
        SELECT   f.film_id,
                 SUM(p.amount) AS film_revenue
        FROM     payment  AS p
        JOIN     rental   AS r ON r.rental_id   = p.rental_id
        JOIN     inventory AS i ON i.inventory_id = r.inventory_id
        JOIN     film      AS f ON f.film_id      = i.film_id
        GROUP BY f.film_id
       ) AS fr  ON fr.film_id = fa.film_id
JOIN   (        -- sub-query from step-5
        SELECT film_id,
               COUNT(*) AS actor_cnt
        FROM   film_actor
        GROUP  BY film_id
       ) AS ac  ON ac.film_id = fa.film_id
LIMIT 20;
```

```sql
-- 7) Rank every film of each actor by that revenue share
SELECT actor_id,
       film_id,
       revenue_per_actor,
       ROW_NUMBER() OVER (PARTITION BY actor_id
                          ORDER BY revenue_per_actor DESC) AS rn
FROM   (
        /* query from step-6 */
        SELECT fa.actor_id,
               fa.film_id,
               fr.film_revenue / ac.actor_cnt AS revenue_per_actor
        FROM   film_actor AS fa
        JOIN   (SELECT f.film_id,
                       SUM(p.amount) AS film_revenue
                FROM   payment  AS p
                JOIN   rental   AS r ON r.rental_id   = p.rental_id
                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                JOIN   film      AS f ON f.film_id      = i.film_id
                GROUP  BY f.film_id
               ) AS fr  ON fr.film_id = fa.film_id
        JOIN   (SELECT film_id,
                       COUNT(*) AS actor_cnt
                FROM   film_actor
                GROUP  BY film_id
               ) AS ac  ON ac.film_id = fa.film_id
       )
LIMIT 20;
```

```sql
-- 8) Keep only the TOP-3 revenue films for each actor
SELECT *
FROM   (
        /* query from step-7 */
        SELECT actor_id,
               film_id,
               revenue_per_actor,
               ROW_NUMBER() OVER (PARTITION BY actor_id
                                  ORDER BY revenue_per_actor DESC) AS rn
        FROM   (
                /* query from step-6 */
                SELECT fa.actor_id,
                       fa.film_id,
                       fr.film_revenue / ac.actor_cnt AS revenue_per_actor
                FROM   film_actor AS fa
                JOIN   (SELECT f.film_id,
                               SUM(p.amount) AS film_revenue
                        FROM   payment  AS p
                        JOIN   rental   AS r ON r.rental_id   = p.rental_id
                        JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                        JOIN   film      AS f ON f.film_id      = i.film_id
                        GROUP  BY f.film_id
                       ) AS fr  ON fr.film_id = fa.film_id
                JOIN   (SELECT film_id,
                               COUNT(*) AS actor_cnt
                        FROM   film_actor
                        GROUP  BY film_id
                       ) AS ac  ON ac.film_id = fa.film_id
               )
       )
WHERE  rn <= 3
LIMIT 20;
```

```sql
-- 9) Average revenue of those TOP-3 films per actor
SELECT actor_id,
       AVG(revenue_per_actor) AS avg_top3_revenue
FROM   (
        /* step-8 result (top 3 films per actor) */
        SELECT *
        FROM   (
                /* same as step-7, repeated for clarity */
                SELECT actor_id,
                       film_id,
                       revenue_per_actor,
                       ROW_NUMBER() OVER (PARTITION BY actor_id
                                          ORDER BY revenue_per_actor DESC) AS rn
                FROM   (
                        SELECT fa.actor_id,
                               fa.film_id,
                               fr.film_revenue / ac.actor_cnt AS revenue_per_actor
                        FROM   film_actor AS fa
                        JOIN   (SELECT f.film_id,
                                       SUM(p.amount) AS film_revenue
                                FROM   payment  AS p
                                JOIN   rental   AS r ON r.rental_id   = p.rental_id
                                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                                JOIN   film      AS f ON f.film_id      = i.film_id
                                GROUP  BY f.film_id
                               ) AS fr  ON fr.film_id = fa.film_id
                        JOIN   (SELECT film_id,
                                       COUNT(*) AS actor_cnt
                                FROM   film_actor
                                GROUP  BY film_id
                               ) AS ac  ON ac.film_id = fa.film_id
                       )
               )
        WHERE  rn <= 3
       )
GROUP  BY actor_id
LIMIT 20;
```

```sql
-- 10) FINAL RESULT: top-3 revenue films for every actor with the actor’s
--     average revenue across those films, ready for reporting
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       f.title                             AS film_title,
       t.revenue_per_actor,
       avg_tbl.avg_top3_revenue
FROM   (
        /* step-8: top-3 films per actor with revenue per actor */
        SELECT actor_id,
               film_id,
               revenue_per_actor
        FROM   (
                SELECT actor_id,
                       film_id,
                       revenue_per_actor,
                       ROW_NUMBER() OVER (PARTITION BY actor_id
                                          ORDER BY revenue_per_actor DESC) AS rn
                FROM   (
                        SELECT fa.actor_id,
                               fa.film_id,
                               fr.film_revenue / ac.actor_cnt AS revenue_per_actor
                        FROM   film_actor AS fa
                        JOIN   (SELECT f.film_id,
                                       SUM(p.amount) AS film_revenue
                                FROM   payment  AS p
                                JOIN   rental   AS r ON r.rental_id   = p.rental_id
                                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                                JOIN   film      AS f ON f.film_id      = i.film_id
                                GROUP  BY f.film_id
                               ) AS fr  ON fr.film_id = fa.film_id
                        JOIN   (SELECT film_id,
                                       COUNT(*) AS actor_cnt
                                FROM   film_actor
                                GROUP  BY film_id
                               ) AS ac  ON ac.film_id = fa.film_id
                       )
               )
        WHERE  rn <= 3
       ) AS t
JOIN   film   AS f   ON f.film_id   = t.film_id
JOIN   actor  AS a   ON a.actor_id  = t.actor_id
JOIN   (      -- average top-3 revenue per actor (step-9)
        SELECT actor_id,
               AVG(revenue_per_actor) AS avg_top3_revenue
        FROM   (
                /* same sub-query used in step-8 */
                SELECT actor_id,
                       film_id,
                       revenue_per_actor,
                       ROW_NUMBER() OVER (PARTITION BY actor_id
                                          ORDER BY revenue_per_actor DESC) AS rn
                FROM   (
                        SELECT fa.actor_id,
                               fa.film_id,
                               fr.film_revenue / ac.actor_cnt AS revenue_per_actor
                        FROM   film_actor AS fa
                        JOIN   (SELECT f.film_id,
                                       SUM(p.amount) AS film_revenue
                                FROM   payment  AS p
                                JOIN   rental   AS r ON r.rental_id   = p.rental_id
                                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                                JOIN   film      AS f ON f.film_id      = i.film_id
                                GROUP  BY f.film_id
                               ) AS fr  ON fr.film_id = fa.film_id
                        JOIN   (SELECT film_id,
                                       COUNT(*) AS actor_cnt
                                FROM   film_actor
                                GROUP  BY film_id
                               ) AS ac  ON ac.film_id = fa.film_id
                       )
               )
        WHERE  rn <= 3
        GROUP  BY actor_id
       ) AS avg_tbl ON avg_tbl.actor_id = a.actor_id
ORDER  BY a.actor_id,
          t.revenue_per_actor DESC,
          f.title
LIMIT 20;
```

Each successive query builds the logic needed to produce the requested report—culminating in query 10, which lists every actor’s three highest-earning films (revenue share basis) together with that actor’s average revenue across those top three titles.
