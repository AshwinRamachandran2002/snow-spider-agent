Query:
-- 6) Revenue that belongs to every actor-film pair
--    (total film revenue divided equally among its actors)
SELECT DISTINCT fa.actor_id,
                fa.film_id,
                fr.film_revenue / ac.actor_cnt AS revenue_per_actor
FROM   film_actor AS fa
JOIN   (        -- sub-query from step-4
        SELECT   f.film_id,
                 SUM(p.amount) AS film_revenue
        FROM     payment  AS p
        JOIN     rental   AS r ON r.rental_id   = p.rental_id
        JOIN     inventory AS i ON i.inventory_id = r.inventory_id
        JOIN     film      AS f ON f.film_id      = i.film_id
        GROUP BY f.film_id
       ) AS fr  ON fr.film_id = fa.film_id
JOIN   (        -- sub-query from step-5
        SELECT film_id,
               COUNT(*) AS actor_cnt
        FROM   film_actor
        GROUP  BY film_id
       ) AS ac  ON ac.film_id = fa.film_id
LIMIT 20;
