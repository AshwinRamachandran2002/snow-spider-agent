                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                JOIN   film      AS f ON f.film_id      = i.film_id
                GROUP  BY f.film_id
               ) AS fr  ON fr.film_id = fa.film_id
        JOIN   (SELECT film_id,
                       COUNT(*) AS actor_cnt
                FROM   film_actor
                GROUP  BY film_id
               ) AS ac  ON ac.film_id = fa.film_id
       )
LIMIT 20;
