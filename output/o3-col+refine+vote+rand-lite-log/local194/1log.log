-- 10) FINAL RESULT: top-3 revenue films for every actor with the actor’s
--     average revenue across those films, ready for reporting
SELECT a.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       f.title                             AS film_title,
       t.revenue_per_actor,
       avg_tbl.avg_top3_revenue
FROM   (
        /* step-8: top-3 films per actor with revenue per actor */
        SELECT actor_id,
               film_id,
               revenue_per_actor
        FROM   (
                SELECT actor_id,
                       film_id,
                       revenue_per_actor,
                       ROW_NUMBER() OVER (PARTITION BY actor_id
                                          ORDER BY revenue_per_actor DESC) AS rn
                FROM   (
                        SELECT fa.actor_id,
                               fa.film_id,
                               fr.film_revenue / ac.actor_cnt AS revenue_per_actor
                        FROM   film_actor AS fa
                        JOIN   (SELECT f.film_id,
                                       SUM(p.amount) AS film_revenue
                                FROM   payment  AS p
                                JOIN   rental   AS r ON r.rental_id   = p.rental_id
                                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                                JOIN   film      AS f ON f.film_id      = i.film_id
                                GROUP  BY f.film_id
                               ) AS fr  ON fr.film_id = fa.film_id
                        JOIN   (SELECT film_id,
                                       COUNT(*) AS actor_cnt
                                FROM   film_actor
                                GROUP  BY film_id
                               ) AS ac  ON ac.film_id = fa.film_id
                       )
               )
        WHERE  rn <= 3
       ) AS t
JOIN   film   AS f   ON f.film_id   = t.film_id
JOIN   actor  AS a   ON a.actor_id  = t.actor_id
JOIN   (      -- average top-3 revenue per actor (step-9)
        SELECT actor_id,
               AVG(revenue_per_actor) AS avg_top3_revenue
        FROM   (
                /* same sub-query used in step-8 */
                SELECT actor_id,
                       film_id,
                       revenue_per_actor,
                       ROW_NUMBER() OVER (PARTITION BY actor_id
                                          ORDER BY revenue_per_actor DESC) AS rn
                FROM   (
                        SELECT fa.actor_id,
                               fa.film_id,
                               fr.film_revenue / ac.actor_cnt AS revenue_per_actor
                        FROM   film_actor AS fa
                        JOIN   (SELECT f.film_id,
                                       SUM(p.amount) AS film_revenue
                                FROM   payment  AS p
                                JOIN   rental   AS r ON r.rental_id   = p.rental_id
                                JOIN   inventory AS i ON i.inventory_id = r.inventory_id
                                JOIN   film      AS f ON f.film_id      = i.film_id
                                GROUP  BY f.film_id
                               ) AS fr  ON fr.film_id = fa.film_id
                        JOIN   (SELECT film_id,
                                       COUNT(*) AS actor_cnt
                                FROM   film_actor
                                GROUP  BY film_id
                               ) AS ac  ON ac.film_id = fa.film_id
                       )
               )
        WHERE  rn <= 3
        GROUP  BY actor_id
       ) AS avg_tbl ON avg_tbl.actor_id = a.actor_id
ORDER  BY a.actor_id,
          t.revenue_per_actor DESC,
          f.title
LIMIT 20;
