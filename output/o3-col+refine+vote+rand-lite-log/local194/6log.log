```sql
--Description: Peek into the payments that drive our revenue calculations.
SELECT DISTINCT "payment_id", "amount", "rental_id"
FROM "payment"
LIMIT 20;
```

```sql
--Description: Trace a payment back to the film that earned it.
SELECT DISTINCT f."film_id",
                f."title",
                p."amount"
FROM   "payment"  AS p
JOIN   "rental"   AS r ON r."rental_id"   = p."rental_id"
JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
JOIN   "film"      AS f ON f."film_id"      = i."film_id"
LIMIT 20;
```

```sql
--Description: Total revenue generated by every film.
SELECT DISTINCT f."film_id",
                f."title",
                SUM(p."amount") AS "film_revenue"
FROM   "payment"   AS p
JOIN   "rental"    AS r  ON r."rental_id"   = p."rental_id"
JOIN   "inventory" AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film"      AS f  ON f."film_id"      = i."film_id"
GROUP  BY f."film_id", f."title"
ORDER  BY "film_revenue" DESC
LIMIT 20;
```

```sql
--Description: See which actors appear in which films.
SELECT DISTINCT fa."actor_id",
                a."first_name",
                a."last_name",
                fa."film_id"
FROM   "film_actor" AS fa
JOIN   "actor"      AS a ON a."actor_id" = fa."actor_id"
LIMIT 20;
```

```sql
--Description: Count how many actors worked in each film (needed for equal-share revenue).
SELECT DISTINCT fa."film_id",
                COUNT(*) AS "actor_count"
FROM   "film_actor" AS fa
GROUP  BY fa."film_id"
LIMIT 20;
```

```sql
--Description: Compute each actor’s revenue share per film 
--             (total film revenue ÷ number of actors in that film).
SELECT DISTINCT fa."actor_id",
                f."film_id",
                SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS "actor_share"
FROM   "film_actor" AS fa                     -- focal actor
JOIN   "film"       AS f  ON f."film_id" = fa."film_id"
JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"  -- to count co-actors
JOIN   "inventory"  AS i  ON i."film_id"     = f."film_id"
JOIN   "rental"     AS r  ON r."inventory_id" = i."inventory_id"
JOIN   "payment"    AS p  ON p."rental_id"    = r."rental_id"
GROUP  BY fa."actor_id", f."film_id"
LIMIT 20;
```

```sql
--Description: Rank films by total revenue within each actor’s filmography 
--             and keep only the top three for each actor.
SELECT *
FROM   (
        SELECT fa."actor_id",
               a."first_name",
               a."last_name",
               f."film_id",
               f."title",
               SUM(p."amount")                       AS "film_revenue",
               SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS "actor_share",
               RANK() OVER (PARTITION BY fa."actor_id"
                            ORDER BY SUM(p."amount") DESC)      AS "film_rank"
        FROM   "film_actor" AS fa
        JOIN   "actor"      AS a  ON a."actor_id" = fa."actor_id"
        JOIN   "film"       AS f  ON f."film_id"  = fa."film_id"
        JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"
        JOIN   "inventory"  AS i  ON i."film_id"   = f."film_id"
        JOIN   "rental"     AS r  ON r."inventory_id" = i."inventory_id"
        JOIN   "payment"    AS p  ON p."rental_id"    = r."rental_id"
        GROUP  BY fa."actor_id", f."film_id"
       ) AS ranked
WHERE  "film_rank" <= 3
LIMIT 20;
```

```sql
--Description: Average of an actor’s revenue shares across those top three films.
SELECT DISTINCT ranked."actor_id",
                ranked."first_name",
                ranked."last_name",
                AVG(ranked."actor_share") AS "avg_top3_revenue"
FROM   (
        SELECT fa."actor_id",
               a."first_name",
               a."last_name",
               f."film_id",
               SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS "actor_share",
               RANK() OVER (PARTITION BY fa."actor_id"
                            ORDER BY SUM(p."amount") DESC)      AS "film_rank"
        FROM   "film_actor" AS fa
        JOIN   "actor"      AS a  ON a."actor_id" = fa."actor_id"
        JOIN   "film"       AS f  ON f."film_id"  = fa."film_id"
        JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"
        JOIN   "inventory"  AS i  ON i."film_id"   = f."film_id"
        JOIN   "rental"     AS r  ON r."inventory_id" = i."inventory_id"
        JOIN   "payment"    AS p  ON p."rental_id"    = r."rental_id"
        GROUP  BY fa."actor_id", f."film_id"
       ) AS ranked
WHERE  "film_rank" <= 3
GROUP  BY ranked."actor_id"
LIMIT 20;
```

```sql
--Description: Final report – each actor’s top-3 films with the 
--             corresponding revenue share and the actor’s average share.
SELECT DISTINCT t."actor_id",
                t."first_name",
                t."last_name",
                t."film_id",
                t."title",
                t."actor_share",
                a."avg_top3_revenue"
FROM   (
        SELECT fa."actor_id",
               a."first_name",
               a."last_name",
               f."film_id",
               f."title",
               SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS "actor_share",
               RANK() OVER (PARTITION BY fa."actor_id"
                            ORDER BY SUM(p."amount") DESC)      AS "film_rank"
        FROM   "film_actor" AS fa
        JOIN   "actor"      AS a  ON a."actor_id" = fa."actor_id"
        JOIN   "film"       AS f  ON f."film_id"  = fa."film_id"
        JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"
        JOIN   "inventory"  AS i  ON i."film_id"   = f."film_id"
        JOIN   "rental"     AS r  ON r."inventory_id" = i."inventory_id"
        JOIN   "payment"    AS p  ON p."rental_id"    = r."rental_id"
        GROUP  BY fa."actor_id", f."film_id"
       ) AS t
JOIN   (
        SELECT ranked."actor_id",
               AVG(ranked."actor_share") AS "avg_top3_revenue"
        FROM   (
                SELECT fa."actor_id",
                       SUM(p."amount") / COUNT(DISTINCT fa2."actor_id") AS "actor_share",
                       RANK() OVER (PARTITION BY fa."actor_id"
                                    ORDER BY SUM(p."amount") DESC) AS "film_rank"
                FROM   "film_actor" AS fa
                JOIN   "film"       AS f  ON f."film_id"  = fa."film_id"
                JOIN   "film_actor" AS fa2 ON fa2."film_id" = f."film_id"
                JOIN   "inventory"  AS i  ON i."film_id"   = f."film_id"
                JOIN   "rental"     AS r  ON r."inventory_id" = i."inventory_id"
                JOIN   "payment"    AS p  ON p."rental_id"    = r."rental_id"
                GROUP  BY fa."actor_id", f."film_id"
               ) AS ranked
        WHERE  ranked."film_rank" <= 3
        GROUP  BY ranked."actor_id"
       ) AS a  ON a."actor_id" = t."actor_id"
WHERE  t."film_rank" <= 3
ORDER  BY t."actor_id", t."actor_share" DESC
LIMIT 20;
```
