Query:
--Description: Retrieve the top-3 revenue-generating films (by evenly-split share) for every actor
SELECT
       a.actor_id,
       a.first_name,
       a.last_name,
       f.title,
       ROUND(share.actor_share, 2) AS revenue_share
FROM  (SELECT
              fa.actor_id,
              fa.film_id,
              fr.film_revenue / ac.actor_cnt AS actor_share,
              ROW_NUMBER() OVER (PARTITION BY fa.actor_id
                                 ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
       FROM   film_actor AS fa
       JOIN  (SELECT f.film_id,
                     SUM(p.amount) AS film_revenue
              FROM   payment  AS p
              JOIN   rental   AS r  ON p.rental_id   = r.rental_id
              JOIN   inventory AS i ON r.inventory_id = i.inventory_id
              JOIN   film      AS f ON i.film_id      = f.film_id
              GROUP  BY f.film_id) AS fr
              ON fr.film_id = fa.film_id
       JOIN  (SELECT fa2.film_id,
                     COUNT(DISTINCT fa2.actor_id) AS actor_cnt
              FROM   film_actor AS fa2
              GROUP  BY fa2.film_id) AS ac
              ON ac.film_id = fa.film_id
      ) AS share
JOIN   film  AS f ON f.film_id = share.film_id
JOIN   actor AS a ON a.actor_id = share.actor_id
WHERE  share.rn <= 3
ORDER  BY a.actor_id,
          share.rn
LIMIT 20;
