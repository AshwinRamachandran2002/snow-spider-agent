```sql
--Description: Inspect a few actors to understand their identifiers and names
SELECT DISTINCT
       a.actor_id,
       a.first_name,
       a.last_name
FROM   actor AS a
LIMIT 20;
```

```sql
--Description: See which films a given actor (e.g., actor_id = 1) appears in
SELECT DISTINCT
       fa.actor_id,
       fa.film_id
FROM   film_actor AS fa
WHERE  fa.actor_id = 1
LIMIT 20;
```

```sql
--Description: Count how many actors play in each film
SELECT
       fa.film_id,
       COUNT(DISTINCT fa.actor_id) AS actor_cnt
FROM   film_actor AS fa
GROUP  BY fa.film_id
LIMIT 20;
```

```sql
--Description: Calculate raw revenue per film by summing all payments tied to that film
SELECT
       f.film_id,
       SUM(p.amount) AS film_revenue
FROM   payment  AS p
JOIN   rental   AS r  ON p.rental_id   = r.rental_id
JOIN   inventory AS i ON r.inventory_id = i.inventory_id
JOIN   film      AS f ON i.film_id      = f.film_id
GROUP  BY f.film_id
LIMIT 20;
```

```sql
--Description: Attach film title to its total revenue for easier reading
SELECT
       f.film_id,
       f.title,
       fr.film_revenue
FROM   film                       AS f
JOIN  (SELECT f.film_id,
              SUM(p.amount) AS film_revenue
       FROM   payment  AS p
       JOIN   rental   AS r  ON p.rental_id   = r.rental_id
       JOIN   inventory AS i ON r.inventory_id = i.inventory_id
       JOIN   film      AS f ON i.film_id      = f.film_id
       GROUP  BY f.film_id) AS fr
       ON fr.film_id = f.film_id
LIMIT 20;
```

```sql
--Description: Combine revenue with actor counts so we can later split revenue evenly among actors
SELECT
       fr.film_id,
       fr.film_revenue,
       ac.actor_cnt
FROM  (SELECT f.film_id,
              SUM(p.amount) AS film_revenue
       FROM   payment  AS p
       JOIN   rental   AS r  ON p.rental_id   = r.rental_id
       JOIN   inventory AS i ON r.inventory_id = i.inventory_id
       JOIN   film      AS f ON i.film_id      = f.film_id
       GROUP  BY f.film_id) AS fr
JOIN  (SELECT fa.film_id,
              COUNT(DISTINCT fa.actor_id) AS actor_cnt
       FROM   film_actor AS fa
       GROUP  BY fa.film_id) AS ac
      ON fr.film_id = ac.film_id
LIMIT 20;
```

```sql
--Description: Compute each actor’s share of revenue for all films they appear in
SELECT
       fa.actor_id,
       fr.film_id,
       fr.film_revenue / ac.actor_cnt AS actor_share
FROM   film_actor AS fa
JOIN  (SELECT f.film_id,
              SUM(p.amount) AS film_revenue
       FROM   payment  AS p
       JOIN   rental   AS r  ON p.rental_id   = r.rental_id
       JOIN   inventory AS i ON r.inventory_id = i.inventory_id
       JOIN   film      AS f ON i.film_id      = f.film_id
       GROUP  BY f.film_id) AS fr
       ON fr.film_id = fa.film_id
JOIN  (SELECT fa2.film_id,
              COUNT(DISTINCT fa2.actor_id) AS actor_cnt
       FROM   film_actor AS fa2
       GROUP  BY fa2.film_id) AS ac
       ON ac.film_id = fa.film_id
LIMIT 20;
```

```sql
--Description: Retrieve the top-3 revenue-generating films (by evenly-split share) for every actor
SELECT
       a.actor_id,
       a.first_name,
       a.last_name,
       f.title,
       ROUND(share.actor_share, 2) AS revenue_share
FROM  (SELECT
              fa.actor_id,
              fa.film_id,
              fr.film_revenue / ac.actor_cnt AS actor_share,
              ROW_NUMBER() OVER (PARTITION BY fa.actor_id
                                 ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
       FROM   film_actor AS fa
       JOIN  (SELECT f.film_id,
                     SUM(p.amount) AS film_revenue
              FROM   payment  AS p
              JOIN   rental   AS r  ON p.rental_id   = r.rental_id
              JOIN   inventory AS i ON r.inventory_id = i.inventory_id
              JOIN   film      AS f ON i.film_id      = f.film_id
              GROUP  BY f.film_id) AS fr
              ON fr.film_id = fa.film_id
       JOIN  (SELECT fa2.film_id,
                     COUNT(DISTINCT fa2.actor_id) AS actor_cnt
              FROM   film_actor AS fa2
              GROUP  BY fa2.film_id) AS ac
              ON ac.film_id = fa.film_id
      ) AS share
JOIN   film  AS f ON f.film_id = share.film_id
JOIN   actor AS a ON a.actor_id = share.actor_id
WHERE  share.rn <= 3
ORDER  BY a.actor_id,
          share.rn
LIMIT 20;
```

```sql
--Description: Calculate the average of those top-3 revenue shares for each actor
SELECT
       res.actor_id,
       a.first_name,
       a.last_name,
       ROUND(AVG(res.revenue_share), 2) AS avg_top3_revenue
FROM  (SELECT
              fa.actor_id,
              fr.film_revenue / ac.actor_cnt AS revenue_share,
              ROW_NUMBER() OVER (PARTITION BY fa.actor_id
                                 ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
       FROM   film_actor AS fa
       JOIN  (SELECT f.film_id,
                     SUM(p.amount) AS film_revenue
              FROM   payment  AS p
              JOIN   rental   AS r  ON p.rental_id   = r.rental_id
              JOIN   inventory AS i ON r.inventory_id = i.inventory_id
              JOIN   film      AS f ON i.film_id      = f.film_id
              GROUP  BY f.film_id) AS fr
              ON fr.film_id = fa.film_id
       JOIN  (SELECT fa2.film_id,
                     COUNT(DISTINCT fa2.actor_id) AS actor_cnt
              FROM   film_actor AS fa2
              GROUP  BY fa2.film_id) AS ac
              ON ac.film_id = fa.film_id
      ) AS res
JOIN   actor AS a ON a.actor_id = res.actor_id
WHERE  res.rn <= 3
GROUP  BY res.actor_id
ORDER  BY avg_top3_revenue DESC
LIMIT 20;
```

```sql
--Description: Final consolidated report: actor, their top-3 films with revenue split, plus the actor’s average of those three
SELECT
       t.actor_id,
       t.first_name,
       t.last_name,
       t.title,
       ROUND(t.revenue_share, 2)      AS revenue_share,
       ROUND(avg_tbl.avg_top3_revenue, 2) AS avg_top3_revenue
FROM  (
        SELECT
               a.actor_id,
               a.first_name,
               a.last_name,
               f.title,
               fr.film_revenue / ac.actor_cnt AS revenue_share,
               ROW_NUMBER() OVER (PARTITION BY a.actor_id
                                  ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
        FROM   actor      AS a
        JOIN   film_actor AS fa ON fa.actor_id = a.actor_id
        JOIN   film       AS f  ON f.film_id   = fa.film_id
        JOIN  (SELECT f2.film_id,
                      SUM(p.amount) AS film_revenue
               FROM   payment  AS p
               JOIN   rental   AS r  ON p.rental_id   = r.rental_id
               JOIN   inventory AS i ON r.inventory_id = i.inventory_id
               JOIN   film      AS f2 ON i.film_id     = f2.film_id
               GROUP  BY f2.film_id) AS fr
               ON fr.film_id = f.film_id
        JOIN  (SELECT fa2.film_id,
                      COUNT(DISTINCT fa2.actor_id) AS actor_cnt
               FROM   film_actor AS fa2
               GROUP  BY fa2.film_id) AS ac
               ON ac.film_id = f.film_id
       ) AS t
JOIN (
        SELECT
               res.actor_id,
               AVG(res.revenue_share) AS avg_top3_revenue
        FROM  (
                SELECT
                       fa.actor_id,
                       fr.film_revenue / ac.actor_cnt AS revenue_share,
                       ROW_NUMBER() OVER (PARTITION BY fa.actor_id
                                          ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
                FROM   film_actor AS fa
                JOIN  (SELECT f.film_id,
                              SUM(p.amount) AS film_revenue
                       FROM   payment  AS p
                       JOIN   rental   AS r  ON p.rental_id   = r.rental_id
                       JOIN   inventory AS i ON r.inventory_id = i.inventory_id
                       JOIN   film      AS f ON i.film_id      = f.film_id
                       GROUP  BY f.film_id) AS fr
                       ON fr.film_id = fa.film_id
                JOIN  (SELECT fa3.film_id,
                              COUNT(DISTINCT fa3.actor_id) AS actor_cnt
                       FROM   film_actor AS fa3
                       GROUP  BY fa3.film_id) AS ac
                       ON ac.film_id = fa.film_id
               ) AS res
        WHERE  res.rn <= 3
        GROUP  BY res.actor_id
     ) AS avg_tbl
     ON avg_tbl.actor_id = t.actor_id
WHERE t.rn <= 3
ORDER BY t.actor_id, t.rn
LIMIT 20;
```
