Query:
--Description: Final consolidated report: actor, their top-3 films with revenue split, plus the actor’s average of those three
SELECT
       t.actor_id,
       t.first_name,
       t.last_name,
       t.title,
       ROUND(t.revenue_share, 2)      AS revenue_share,
       ROUND(avg_tbl.avg_top3_revenue, 2) AS avg_top3_revenue
FROM  (
        SELECT
               a.actor_id,
               a.first_name,
               a.last_name,
               f.title,
               fr.film_revenue / ac.actor_cnt AS revenue_share,
               ROW_NUMBER() OVER (PARTITION BY a.actor_id
                                  ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
        FROM   actor      AS a
        JOIN   film_actor AS fa ON fa.actor_id = a.actor_id
        JOIN   film       AS f  ON f.film_id   = fa.film_id
        JOIN  (SELECT f2.film_id,
                      SUM(p.amount) AS film_revenue
               FROM   payment  AS p
               JOIN   rental   AS r  ON p.rental_id   = r.rental_id
               JOIN   inventory AS i ON r.inventory_id = i.inventory_id
               JOIN   film      AS f2 ON i.film_id     = f2.film_id
               GROUP  BY f2.film_id) AS fr
               ON fr.film_id = f.film_id
        JOIN  (SELECT fa2.film_id,
                      COUNT(DISTINCT fa2.actor_id) AS actor_cnt
               FROM   film_actor AS fa2
               GROUP  BY fa2.film_id) AS ac
               ON ac.film_id = f.film_id
       ) AS t
JOIN (
        SELECT
               res.actor_id,
               AVG(res.revenue_share) AS avg_top3_revenue
        FROM  (
                SELECT
                       fa.actor_id,
                       fr.film_revenue / ac.actor_cnt AS revenue_share,
                       ROW_NUMBER() OVER (PARTITION BY fa.actor_id
                                          ORDER BY fr.film_revenue / ac.actor_cnt DESC) AS rn
                FROM   film_actor AS fa
                JOIN  (SELECT f.film_id,
                              SUM(p.amount) AS film_revenue
                       FROM   payment  AS p
                       JOIN   rental   AS r  ON p.rental_id   = r.rental_id
                       JOIN   inventory AS i ON r.inventory_id = i.inventory_id
                       JOIN   film      AS f ON i.film_id      = f.film_id
                       GROUP  BY f.film_id) AS fr
                       ON fr.film_id = fa.film_id
                JOIN  (SELECT fa3.film_id,
                              COUNT(DISTINCT fa3.actor_id) AS actor_cnt
                       FROM   film_actor AS fa3
                       GROUP  BY fa3.film_id) AS ac
                       ON ac.film_id = fa.film_id
               ) AS res
        WHERE  res.rn <= 3
        GROUP  BY res.actor_id
     ) AS avg_tbl
     ON avg_tbl.actor_id = t.actor_id
WHERE t.rn <= 3
ORDER BY t.actor_id, t.rn
LIMIT 20;
