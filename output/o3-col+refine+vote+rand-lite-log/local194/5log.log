Query:
-- Description: 7) FINAL ANSWER – every actor’s three highest-grossing films
--                with the revenue share they earn in each film and the
--                average share across those three films.
WITH film_revenue AS (
        SELECT f.film_id,
               SUM(p.amount) AS total_revenue
        FROM   film AS f
        JOIN   inventory AS i ON i.film_id   = f.film_id
        JOIN   rental    AS r ON r.inventory_id = i.inventory_id
        JOIN   payment   AS p ON p.rental_id = r.rental_id
        GROUP  BY f.film_id
), actor_count AS (
        SELECT fa.film_id,
               COUNT(DISTINCT fa.actor_id) AS actor_cnt
        FROM   film_actor AS fa
        GROUP  BY fa.film_id
), actor_film_revenue AS (
        SELECT  fa.actor_id,
                fa.film_id,
                fr.total_revenue * 1.0 / ac.actor_cnt AS actor_revenue
        FROM   film_actor AS fa
        JOIN   film_revenue AS fr ON fr.film_id = fa.film_id
        JOIN   actor_count  AS ac ON ac.film_id = fa.film_id
), ranked AS (
        SELECT  afr.actor_id,
                afr.film_id,
                afr.actor_revenue,
                ROW_NUMBER() OVER (PARTITION BY afr.actor_id
                                   ORDER BY afr.actor_revenue DESC) AS rn
        FROM   actor_film_revenue AS afr
), avg_top3 AS (
        SELECT  actor_id,
                AVG(actor_revenue) AS avg_revenue_top3
        FROM   ranked
        WHERE  rn <= 3
        GROUP  BY actor_id
)
SELECT  a.actor_id,
        a.first_name || ' ' || a.last_name AS actor_name,
        f.title                          AS film_title,
        ROUND(r.actor_revenue, 2)        AS revenue_share,
        ROUND(at.avg_revenue_top3, 2)    AS avg_revenue_share_top3
FROM        ranked   AS r
JOIN        film     AS f  ON f.film_id   = r.film_id
JOIN        actor    AS a  ON a.actor_id  = r.actor_id
JOIN        avg_top3 AS at ON at.actor_id = r.actor_id
WHERE       r.rn <= 3
ORDER BY    a.actor_id,
            r.actor_revenue DESC,
            f.title
LIMIT 20;   -- remove or adjust limit as needed
