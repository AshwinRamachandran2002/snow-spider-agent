```sql
-- Description: 1) Peek at the list of actors.
SELECT DISTINCT
       actor_id,
       first_name,
       last_name
FROM   actor
LIMIT 20;
```

```sql
-- Description: 2) Total revenue generated by every film.
SELECT DISTINCT
       f.film_id,
       f.title,
       SUM(p.amount) AS total_revenue
FROM   film       AS f
JOIN   inventory  AS i ON i.film_id   = f.film_id
JOIN   rental     AS r ON r.inventory_id = i.inventory_id
JOIN   payment    AS p ON p.rental_id = r.rental_id
GROUP  BY f.film_id
ORDER  BY total_revenue DESC
LIMIT 20;
```

```sql
-- Description: 3) Count actors that participated in each film.
SELECT DISTINCT
       fa.film_id,
       COUNT(DISTINCT fa.actor_id) AS actor_cnt
FROM   film_actor AS fa
GROUP  BY fa.film_id
LIMIT 20;
```

```sql
-- Description: 4) Revenue per film together with its average share per actor.
SELECT DISTINCT
       fr.film_id,
       fr.total_revenue,
       ac.actor_cnt,
       ROUND(fr.total_revenue * 1.0 / ac.actor_cnt, 2) AS revenue_per_actor
FROM  (
        SELECT f.film_id,
               SUM(p.amount) AS total_revenue
        FROM   film AS f
        JOIN   inventory AS i ON i.film_id   = f.film_id
        JOIN   rental    AS r ON r.inventory_id = i.inventory_id
        JOIN   payment   AS p ON p.rental_id = r.rental_id
        GROUP  BY f.film_id
      ) AS fr
JOIN  (
        SELECT fa.film_id,
               COUNT(DISTINCT fa.actor_id) AS actor_cnt
        FROM   film_actor AS fa
        GROUP  BY fa.film_id
      ) AS ac  ON ac.film_id = fr.film_id
LIMIT 20;
```

```sql
-- Description: 5) Actor-film pairs with the revenue share each actor receives.
SELECT DISTINCT
       fa.actor_id,
       f.film_id,
       f.title,
       ROUND(fr.total_revenue * 1.0 / ac.actor_cnt, 2) AS actor_revenue
FROM   film_actor AS fa
JOIN   film       AS f  ON f.film_id = fa.film_id
JOIN  ( /* revenue per film */  
        SELECT f.film_id,
               SUM(p.amount) AS total_revenue
        FROM   film AS f
        JOIN   inventory AS i ON i.film_id   = f.film_id
        JOIN   rental    AS r ON r.inventory_id = i.inventory_id
        JOIN   payment   AS p ON p.rental_id = r.rental_id
        GROUP  BY f.film_id
      ) AS fr ON fr.film_id = fa.film_id
JOIN  ( /* #actors in film */
        SELECT fa2.film_id,
               COUNT(DISTINCT fa2.actor_id) AS actor_cnt
        FROM   film_actor AS fa2
        GROUP  BY fa2.film_id
      ) AS ac ON ac.film_id = fa.film_id
LIMIT 20;
```

```sql
-- Description: 6) Top-3 revenue films for one sample actor (actor_id = 1).
SELECT  sub.actor_id,
        sub.title,
        ROUND(sub.actor_revenue, 2) AS actor_revenue
FROM   (
        SELECT  fa.actor_id,
                f.title,
                fr.total_revenue * 1.0 / ac.actor_cnt AS actor_revenue,
                ROW_NUMBER() OVER (PARTITION BY fa.actor_id
                                   ORDER BY fr.total_revenue DESC) AS rn
        FROM   film_actor AS fa
        JOIN   film       AS f  ON f.film_id = fa.film_id
        JOIN  ( /* film revenue */ 
                SELECT f.film_id,
                       SUM(p.amount) AS total_revenue
                FROM   film AS f
                JOIN   inventory AS i ON i.film_id = f.film_id
                JOIN   rental    AS r ON r.inventory_id = i.inventory_id
                JOIN   payment   AS p ON p.rental_id = r.rental_id
                GROUP  BY f.film_id
              ) AS fr ON fr.film_id = fa.film_id
        JOIN  ( /* #actors */ 
                SELECT fa2.film_id,
                       COUNT(DISTINCT fa2.actor_id) AS actor_cnt
                FROM   film_actor AS fa2
                GROUP  BY fa2.film_id
              ) AS ac ON ac.film_id = fa.film_id
      ) AS sub
WHERE  sub.actor_id = 1
  AND  sub.rn <= 3
ORDER BY sub.actor_revenue DESC;
```

```sql
-- Description: 7) FINAL ANSWER – every actor’s three highest-grossing films
--                with the revenue share they earn in each film and the
--                average share across those three films.
WITH film_revenue AS (
        SELECT f.film_id,
               SUM(p.amount) AS total_revenue
        FROM   film AS f
        JOIN   inventory AS i ON i.film_id   = f.film_id
        JOIN   rental    AS r ON r.inventory_id = i.inventory_id
        JOIN   payment   AS p ON p.rental_id = r.rental_id
        GROUP  BY f.film_id
), actor_count AS (
        SELECT fa.film_id,
               COUNT(DISTINCT fa.actor_id) AS actor_cnt
        FROM   film_actor AS fa
        GROUP  BY fa.film_id
), actor_film_revenue AS (
        SELECT  fa.actor_id,
                fa.film_id,
                fr.total_revenue * 1.0 / ac.actor_cnt AS actor_revenue
        FROM   film_actor AS fa
        JOIN   film_revenue AS fr ON fr.film_id = fa.film_id
        JOIN   actor_count  AS ac ON ac.film_id = fa.film_id
), ranked AS (
        SELECT  afr.actor_id,
                afr.film_id,
                afr.actor_revenue,
                ROW_NUMBER() OVER (PARTITION BY afr.actor_id
                                   ORDER BY afr.actor_revenue DESC) AS rn
        FROM   actor_film_revenue AS afr
), avg_top3 AS (
        SELECT  actor_id,
                AVG(actor_revenue) AS avg_revenue_top3
        FROM   ranked
        WHERE  rn <= 3
        GROUP  BY actor_id
)
SELECT  a.actor_id,
        a.first_name || ' ' || a.last_name AS actor_name,
        f.title                          AS film_title,
        ROUND(r.actor_revenue, 2)        AS revenue_share,
        ROUND(at.avg_revenue_top3, 2)    AS avg_revenue_share_top3
FROM        ranked   AS r
JOIN        film     AS f  ON f.film_id   = r.film_id
JOIN        actor    AS a  ON a.actor_id  = r.actor_id
JOIN        avg_top3 AS at ON at.actor_id = r.actor_id
WHERE       r.rn <= 3
ORDER BY    a.actor_id,
            r.actor_revenue DESC,
            f.title
LIMIT 20;   -- remove or adjust limit as needed
```
