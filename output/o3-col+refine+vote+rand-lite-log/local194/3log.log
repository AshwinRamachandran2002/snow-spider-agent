2025-05-05 04:44:02 - Thread-3828 (execute) - INFO - [Exploration]
Below is a progressive set of seven inspection queries (all limited to 20 rows) that move step-by-step from simple look-ups to the final result – “top three revenue-generating films for each actor, with the average revenue per actor in those films”.

```sql
-- Description: 1)  Sample the films in which actor #1 appears.
SELECT DISTINCT fa."film_id"
FROM "film_actor" AS fa
WHERE fa."actor_id" = 1
LIMIT 20;
```

```sql
-- Description: 2)  Peek at individual payment amounts that belong to film #1.
SELECT DISTINCT p."amount"
FROM "payment"   AS p
JOIN "rental"    AS r ON p."rental_id"   = r."rental_id"
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
WHERE i."film_id" = 1
LIMIT 20;
```

```sql
-- Description: 3)  Aggregate total revenue earned by each film.
SELECT f."film_id",
       f."title",
       SUM(p."amount") AS "total_revenue"
FROM "film"      AS f
JOIN "inventory" AS i ON f."film_id"      = i."film_id"
JOIN "rental"    AS r ON i."inventory_id" = r."inventory_id"
JOIN "payment"   AS p ON r."rental_id"    = p."rental_id"
GROUP BY f."film_id", f."title"
LIMIT 20;
```

```sql
-- Description: 4)  Count how many distinct actors appear in every film.
SELECT fa."film_id",
       COUNT(DISTINCT fa."actor_id") AS "actor_count"
FROM "film_actor" AS fa
GROUP BY fa."film_id"
LIMIT 20;
```

```sql
-- Description: 5)  Compute ‘average revenue per actor’ for every (actor, film) pair.
SELECT DISTINCT fa."actor_id",
       f."film_id",
       f."title",
       fr."total_revenue" / ac."actor_count" AS "avg_revenue_per_actor"
FROM "film_actor" AS fa
JOIN (                       -- film-level revenue
      SELECT f."film_id",
             SUM(p."amount") AS "total_revenue"
      FROM "film" AS f
      JOIN "inventory" AS i ON f."film_id"      = i."film_id"
      JOIN "rental"    AS r ON i."inventory_id" = r."inventory_id"
      JOIN "payment"   AS p ON r."rental_id"    = p."rental_id"
      GROUP BY f."film_id"
     ) AS fr              ON fa."film_id" = fr."film_id"
JOIN (                       -- actor count per film
      SELECT fa2."film_id",
             COUNT(DISTINCT fa2."actor_id") AS "actor_count"
      FROM "film_actor" AS fa2
      GROUP BY fa2."film_id"
     ) AS ac              ON fa."film_id" = ac."film_id"
JOIN "film" AS f          ON fa."film_id" = f."film_id"
LIMIT 20;
```

```sql
-- Description: 6)  Add actor names to the previous result for readability.
SELECT DISTINCT a."actor_id",
       a."first_name",
       a."last_name",
       f."film_id",
       f."title",
       fr."total_revenue" / ac."actor_count" AS "avg_revenue_per_actor"
FROM "actor"      AS a
JOIN "film_actor" AS fa ON a."actor_id" = fa."actor_id"
JOIN (  SELECT f."film_id", SUM(p."amount") AS "total_revenue"
        FROM "film" AS f
        JOIN "inventory" AS i ON f."film_id"      = i."film_id"
        JOIN "rental"    AS r ON i."inventory_id" = r."inventory_id"
        JOIN "payment"   AS p ON r."rental_id"    = p."rental_id"
        GROUP BY f."film_id"
     ) AS fr            ON fa."film_id" = fr."film_id"
JOIN (  SELECT fa2."film_id",
               COUNT(DISTINCT fa2."actor_id") AS "actor_count"
        FROM "film_actor" AS fa2
        GROUP BY fa2."film_id"
     ) AS ac            ON fa."film_id" = ac."film_id"
JOIN "film" AS f        ON fa."film_id" = f."film_id"
LIMIT 20;
```

```sql
-- Description: 7)  Final answer – pick the TOP 3 revenue-generating films per actor.
SELECT *
FROM (
        SELECT a."actor_id",
               a."first_name",
               a."last_name",
               f."film_id",
               f."title",
               fr."total_revenue" / ac."actor_count" AS "avg_revenue_per_actor",
               ROW_NUMBER() OVER (PARTITION BY a."actor_id"
                                  ORDER BY fr."total_revenue" DESC) AS "rn"
        FROM "actor"      AS a
        JOIN "film_actor" AS fa ON a."actor_id" = fa."actor_id"
        JOIN (  SELECT f."film_id",
                       SUM(p."amount") AS "total_revenue"
                FROM "film" AS f
                JOIN "inventory" AS i ON f."film_id"      = i."film_id"
                JOIN "rental"    AS r ON i."inventory_id" = r."inventory_id"
                JOIN "payment"   AS p ON r."rental_id"    = p."rental_id"
                GROUP BY f."film_id"
             ) AS fr      ON fa."film_id" = fr."film_id"
        JOIN (  SELECT fa2."film_id",
                       COUNT(DISTINCT fa2."actor_id") AS "actor_count"
                FROM "film_actor" AS fa2
                GROUP BY fa2."film_id"
             ) AS ac      ON fa."film_id" = ac."film_id"
        JOIN "film" AS f  ON fa."film_id" = f."film_id"
     ) AS ranked
WHERE ranked."rn" <= 3
LIMIT 20;
```

These queries should let you explore the data and ultimately obtain, for every actor, their three highest-grossing films together with the “average revenue per actor” figure (i.e., film revenue divided evenly among all its actors).
