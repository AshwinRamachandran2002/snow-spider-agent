--Description:  Fetch the top-2 multipolygons (by point-feature count) that  
--intersect Estonia’s bounding box (derived from the multipolygon whose tag  
--“wikidata” = Q191), contain at least one “name” tag, and have NO “wikidata” tag.  
--The LISTAGG delimiter is correctly quoted as '; ' to prevent SQL-syntax errors.

WITH q191 AS (                                 -- Estonia bounding box
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS env_geom
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p
         ,LATERAL FLATTEN(input => p."all_tags") f
  WHERE  p."feature_type" = 'multipolygons'
    AND  f.value:"key"::STRING   = 'wikidata'
    AND  f.value:"value"::STRING = 'Q191'
  LIMIT 1
),
cands AS (                                     -- polygons in bbox, name present, no wikidata
  SELECT
      p."osm_way_id",
      TO_GEOGRAPHY(p."geometry") AS poly_geom,
