```sql
--Description: Count how many point-features fall inside each candidate multipolygon
WITH q191 AS (
  SELECT ST_ENVELOPE(TO_GEOGRAPHY("geometry")) AS env_geom
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES
  WHERE "feature_type" = 'multipolygons'
    AND EXISTS (
          SELECT 1
          FROM  LATERAL FLATTEN(input => "all_tags") f
          WHERE  f.value:"key"::STRING = 'wikidata'
             AND f.value:"value"::STRING = 'Q191'
        )
  LIMIT 1
),
cands AS (
  SELECT 
      pf."osm_way_id",
      TO_GEOGRAPHY(pf."geometry") AS poly_geom,
      (SELECT LISTAGG(f.value:"value"::STRING, '; ')
         FROM LATERAL FLATTEN(input => pf."all_tags") f
         WHERE f.value:"key"::STRING = 'name'
      ) AS "poly_name"
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf, q191
  WHERE pf."feature_type" = 'multipolygons'
    AND ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.env_geom )
    AND NOT EXISTS (
          SELECT 1
          FROM  LATERAL FLATTEN(input => pf."all_tags") f
          WHERE  f.value:"key"::STRING = 'wikidata'
        )
)
SELECT 
    c."osm_way_id",
    c."poly_name",
    COUNT(*) AS "pts_inside"
FROM c c
JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pt
  ON ST_CONTAINS(c.poly_geom, TO_GEOGRAPHY(pt."geometry"))
GROUP BY c."osm_way_id", c."poly_name"
ORDER BY "pts_inside" DESC
LIMIT 20;
