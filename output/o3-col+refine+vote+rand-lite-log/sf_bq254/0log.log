--Description:  Generate the point counts for each qualifying multipolygon that intersects
--Estonia’s bounding box (wikidata = Q191), has at least one “name” tag, and no “wikidata”
--tag, then display the TOP-2 polygons by that count.  LISTAGG’s delimiter is the properly
--quoted literal '; ' (fixing the prior unterminated-quote error).

WITH q191 AS (                            -- Estonia bounding envelope
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS env_geom
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p ,
         LATERAL FLATTEN(input => p."all_tags") f
  WHERE  p."feature_type" = 'multipolygons'
    AND  f.value:"key"::STRING = 'wikidata'
    AND  f.value:"value"::STRING = 'Q191'
  LIMIT 1
),
cands AS (                                -- polygons in bbox, name present, no wikidata
  SELECT
      p."osm_way_id",
      TO_GEOGRAPHY(p."geometry") AS poly_geom,
      LISTAGG(
        CASE WHEN f.value:"key"::STRING = 'name'
             THEN f.value:"value"::STRING END,
        '; '                              -- fixed delimiter
      ) WITHIN GROUP (ORDER BY 1)         AS poly_name
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p ,
         LATERAL FLATTEN(input => p."all_tags") f ,
         q191
  WHERE  p."feature_type" = 'multipolygons'
    AND  ST_INTERSECTS(TO_GEOGRAPHY(p."geometry"), q191.env_geom)
  GROUP  BY p."osm_way_id", p."geometry"
  HAVING MAX(CASE WHEN f.value:"key"::STRING='name'     THEN 1 ELSE 0 END)=1
     AND MAX(CASE WHEN f.value:"key"::STRING='wikidata' THEN 1 ELSE 0 END)=0
),
pt_counts AS (                            -- count points inside each candidate
  SELECT
      c."osm_way_id",
      c.poly_name,
      COUNT(*) AS point_cnt
  FROM   cands c
  JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pt
         ON ST_CONTAINS(c.poly_geom, TO_GEOGRAPHY(pt."geometry"))
  GROUP  BY c."osm_way_id", c.poly_name
  ORDER  BY point_cnt DESC
  LIMIT 2
)
SELECT *
FROM pt_counts;
