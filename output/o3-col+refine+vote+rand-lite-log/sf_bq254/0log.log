```sql
--Description:  Determine the two multipolygons that (1) intersect Estonia’s bounding box
--(identified via the relation whose “wikidata” = Q191), (2) possess at least one “name” tag, 
--(3) lack a “wikidata” tag, and (4) contain the greatest number of point-features.  
--The query builds Estonia’s bounding box (q191), selects qualifying polygons (cands), 
--counts contained points, orders by that count, and returns the top two results.
WITH q191 AS (   ------------------------------------------------------------------ ❶ Estonia envelope
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS env_geom
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") f
  WHERE  pf."feature_type" = 'multipolygons'
    AND  f.value:"key"::STRING   = 'wikidata'
    AND  f.value:"value"::STRING = 'Q191'
  LIMIT 1
),
cands AS (      -------------------------------------------------------------------- ❷ polygons in box, name present, no wikidata
  SELECT
      pf."osm_way_id",
      TO_GEOGRAPHY(pf."geometry")                                        AS poly_geom,
      LISTAGG( CASE WHEN f.value:"key"::STRING = 'name'
                    THEN f.value:"value"::STRING END,
               '; ' )                                                    AS poly_name
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
         LATERAL FLATTEN(input => pf."all_tags") f,
         q191
  WHERE  pf."feature_type" = 'multipolygons'
    AND  ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.env_geom )
  GROUP  BY pf."osm_way_id", pf."geometry"
  HAVING MAX( CASE WHEN f.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1   -- has name
     AND MAX( CASE WHEN f.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0   -- no wikidata
),
ranked AS (    ---------------------------------------------------------------------- ❸ count points inside each candidate
  SELECT
      c."osm_way_id",
      c."poly_name",
      COUNT(*) AS points_inside
  FROM   cands c
  JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pt
         ON ST_CONTAINS(c.poly_geom, TO_GEOGRAPHY(pt."geometry"))
  GROUP  BY c."osm_way_id", c."poly_name"
)
SELECT
    "poly_name"     AS multipolygon_name,
    points_inside
FROM ranked
ORDER BY points_inside DESC
LIMIT 2;
