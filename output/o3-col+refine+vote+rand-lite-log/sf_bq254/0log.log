      TO_GEOGRAPHY(pf."geometry")                           AS poly_geom,
      LISTAGG( CASE WHEN f.value:"key"::STRING='name'
                    THEN f.value:"value"::STRING END, '; ' )  
          WITHIN GROUP (ORDER BY 1)                         AS poly_name
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
       LATERAL FLATTEN(input => pf."all_tags") f, q191
  WHERE pf."feature_type" = 'multipolygons'
    AND ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.env_geom )
  GROUP BY pf."osm_way_id", pf."geometry"
