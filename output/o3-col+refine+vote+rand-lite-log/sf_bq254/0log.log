--the correctly quoted delimiter '; '.

WITH estonia_bbox AS (                          -- derive Estonia’s envelope
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(p."geometry")) AS env_geom
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
         LATERAL FLATTEN(input => p."all_tags") f
  WHERE  p."feature_type" = 'multipolygons'
    AND  f.value:"key"::STRING   = 'wikidata'
    AND  f.value:"value"::STRING = 'Q191'
  LIMIT 1
),
candidates AS (                                 -- polygons in box, name present, no wikidata
  SELECT
      p."osm_way_id",
      TO_GEOGRAPHY(p."geometry") AS poly_geom,
      LISTAGG(
        CASE
          WHEN f.value:"key"::STRING = 'name'
          THEN f.value:"value"::STRING
        END,
        '; '
      ) WITHIN GROUP (ORDER BY 1)               AS poly_name
  FROM   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES p,
         LATERAL FLATTEN(input => p."all_tags") f,
         estonia_bbox
  WHERE  p."feature_type" = 'multipolygons'
    AND  ST_INTERSECTS(TO_GEOGRAPHY(p."geometry"), estonia_bbox.env_geom)
  GROUP  BY p."osm_way_id", p."geometry"
  HAVING MAX(CASE WHEN f.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
     AND MAX(CASE WHEN f.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
)
SELECT
    c.poly_name      AS multipolygon_name,
    COUNT(*)         AS points_inside
FROM   candidates c
JOIN   GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pt
  ON   ST_CONTAINS(c.poly_geom, TO_GEOGRAPHY(pt."geometry"))
GROUP  BY c.poly_name
ORDER  BY points_inside DESC
LIMIT 2;
```
