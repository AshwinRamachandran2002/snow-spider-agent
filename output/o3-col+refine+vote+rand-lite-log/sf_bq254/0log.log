```sql
--Description: List every multipolygon located within Estonia’s (Q191) bounding box
--that HAS at least one “name” tag but NO “wikidata” tag.  Strategy:
--1. Obtain Estonia’s envelope (q191 CTE).
--2. For every multipolygon whose geometry intersects that envelope, FLATTEN its
--   tag array so each tag is examined.
--3. GROUP BY osm_way_id and use conditional MAX() to require:
--     • at least one tag where key = 'name'
--     • zero tags where key = 'wikidata'
--4. Also return the aggregated name values for quick inspection.
WITH q191 AS (   -- bounding box of the multipolygon that carries wikidata Q191
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS env_geom
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
       LATERAL FLATTEN (input => pf."all_tags") f
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING   = 'wikidata'
    AND f.value:"value"::STRING = 'Q191'
  LIMIT 1
)
SELECT
    pf."osm_way_id",
    LISTAGG( CASE
               WHEN f.value:"key"::STRING = 'name'
               THEN f.value:"value"::STRING
             END, '; ' ) 
      WITHIN GROUP (ORDER BY 1)                         AS name_values
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
     LATERAL FLATTEN(input => pf."all_tags") f,
     q191
WHERE pf."feature_type" = 'multipolygons'
  AND ST_INTERSECTS( TO_GEOGRAPHY(pf."geometry"), q191.env_geom )
GROUP BY pf."osm_way_id"
HAVING
    MAX( CASE WHEN f.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END ) = 1   -- has name
AND MAX( CASE WHEN f.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END ) = 0   -- lacks wikidata
LIMIT 20;
```
