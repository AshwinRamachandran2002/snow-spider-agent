--Description: Inspect the complete tag arrays for the two winning multipolygons returned
--by the previous query (embedded here as CTE `winners`) – no manual ID replacement needed.
WITH q191 AS (
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS env_geom
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
       LATERAL FLATTEN(input => pf."all_tags") f
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING   = 'wikidata'
    AND f.value:"value"::STRING = 'Q191'
  LIMIT 1
),
cands AS (
  SELECT
      pf."osm_way_id",
      TO_GEOGRAPHY(pf."geometry")                               AS poly_geom,
      LISTAGG(
        CASE WHEN f.value:"key"::STRING = 'name'
             THEN f.value:"value"::STRING END,
        '; '
      ) WITHIN GROUP (ORDER BY 1)                               AS poly_name
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
       LATERAL FLATTEN(input => pf."all_tags") f,
       q191
  WHERE pf."feature_type" = 'multipolygons'
    AND ST_INTERSECTS(TO_GEOGRAPHY(pf."geometry"), q191.env_geom)
  GROUP BY pf."osm_way_id", pf."geometry"
  HAVING MAX(CASE WHEN f.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1
     AND MAX(CASE WHEN f.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0
),
winners AS (
  SELECT c."osm_way_id"
  FROM cands c
  JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pt
    ON ST_CONTAINS(c.poly_geom, TO_GEOGRAPHY(pt."geometry"))
  GROUP BY c."osm_way_id"
  ORDER BY COUNT(*) DESC
  LIMIT 2
)
SELECT
    pf."osm_way_id",
    pf."all_tags"
FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf
JOIN winners w
  ON pf."osm_way_id" = w."osm_way_id";
