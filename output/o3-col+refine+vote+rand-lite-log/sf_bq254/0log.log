```sql
--Description: Count how many point-features lie inside every multipolygon that
--intersects Estonia’s envelope (wikidata Q191), has at least one “name” tag,
--and NO “wikidata” tag of its own.  Return each candidate’s name(s) and the
--point count.
WITH q191 AS (                                -- 1. Estonia bounding box
  SELECT ST_ENVELOPE(TO_GEOGRAPHY(pf."geometry")) AS env_geom
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
       LATERAL FLATTEN(input => pf."all_tags") f
  WHERE pf."feature_type" = 'multipolygons'
    AND f.value:"key"::STRING   = 'wikidata'
    AND f.value:"value"::STRING = 'Q191'
  LIMIT 1
),
cands AS (                                    -- 2. multipolygons inside that box w/ name & no wikidata
  SELECT
      pf."osm_way_id",
      TO_GEOGRAPHY(pf."geometry")                               AS poly_geom,
      LISTAGG(
        CASE WHEN f.value:"key"::STRING = 'name'
             THEN f.value:"value"::STRING END,
        '; '
      ) WITHIN GROUP (ORDER BY 1)                               AS poly_name
  FROM GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES pf,
       LATERAL FLATTEN(input => pf."all_tags") f,
       q191
  WHERE pf."feature_type" = 'multipolygons'
    AND ST_INTERSECTS(TO_GEOGRAPHY(pf."geometry"), q191.env_geom)
  GROUP BY pf."osm_way_id", pf."geometry"
  HAVING MAX(CASE WHEN f.value:"key"::STRING = 'name'     THEN 1 ELSE 0 END) = 1   -- has at least one name
     AND MAX(CASE WHEN f.value:"key"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0   -- lacks wikidata
),
pt_cnt AS (                                    -- 3. overlay point features
  SELECT
      c."osm_way_id",
      c."poly_name",
      COUNT(*) AS pts_inside
  FROM cands c
  JOIN GEO_OPENSTREETMAP.GEO_OPENSTREETMAP.PLANET_FEATURES_POINTS pt
    ON ST_CONTAINS(c.poly_geom, TO_GEOGRAPHY(pt."geometry"))
  GROUP BY c."osm_way_id", c."poly_name"
)
SELECT *
FROM pt_cnt
ORDER BY pts_inside DESC
LIMIT 20;
```

