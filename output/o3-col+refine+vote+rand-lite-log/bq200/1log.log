```sql
--Description: Team-by-team highest non-zero pitch speed for the 2016-22 regular seasons
SELECT   team_id,
         pitcherId,
         first_name,
         last_name,
         max_speed
FROM   (
        SELECT   IF(homeTeamId = pitcher_team, homeTeamId, awayTeamId) AS team_id,
                 pitcherId,
                 ANY_VALUE(pitcherFirstName) AS first_name,
                 ANY_VALUE(pitcherLastName)  AS last_name,
                 MAX(pitchSpeed)             AS max_speed,
                 ROW_NUMBER() OVER (PARTITION BY IF(homeTeamId = pitcher_team, homeTeamId, awayTeamId)
                                    ORDER BY MAX(pitchSpeed) DESC) AS rn
        FROM   (
               SELECT g.*,
                      CASE
                          WHEN pitcherId IN (homeFielder1, homeFielder10) THEN homeTeamId
                          WHEN pitcherId IN (awayFielder1, awayFielder10) THEN awayTeamId
                          ELSE NULL
                      END AS pitcher_team
               FROM   `bigquery-public-data.baseball.games_wide` AS g
               WHERE  pitchSpeed > 0
               )
        WHERE  pitcher_team IS NOT NULL
        GROUP  BY team_id, pitcherId
       )
WHERE  rn = 1
ORDER  BY max_speed DESC
LIMIT  20;
```

