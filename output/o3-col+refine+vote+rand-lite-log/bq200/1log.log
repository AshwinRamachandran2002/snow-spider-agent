Query:
--Description: Candidate top-speed pitchers for a team (regular season example – Cleveland Guardians)
SELECT   awayTeamId                AS team_id,
         pitcherId,
         MAX(pitchSpeed)           AS max_speed,
         ANY_VALUE(pitcherFirstName) AS first_name,
         ANY_VALUE(pitcherLastName)  AS last_name
FROM     `bigquery-public-data.baseball.games_wide`
WHERE    pitchSpeed > 0
