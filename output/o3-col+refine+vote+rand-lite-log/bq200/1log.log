```sql
--Description / Thinking process:
-- 1. We UNION the regular-season (games_wide) and post-season (games_post_wide) pitch-by-pitch
--    tables so every pitch appears once.  Only rows with pitchSpeed > 0 are needed.
-- 2. For each row we must know which club the pitcher is throwing for.  The pitcher on the
--    mound should appear in the defensive lists:
--        • homeFielder1  or homeFielder10  → homeTeamId
--        • awayFielder1  or awayFielder10  → awayTeamId
--    A CASE expression tags the row with that club (team_id); rows where the pitcherId
--    is not found in those slots are ignored (team_id IS NOT NULL).
-- 3. per_pitcher: For every (team_id, pitcherId) pair we retain the fastest pitch the
--    pitcher ever threw for that team, plus a representative first/last name via ANY_VALUE.
-- 4. ranked: Inside each team we rank pitchers by their max_speed, then keep rank = 1
--    → the pitcher with the single highest valid pitch speed for that franchise.
-- 5. Final SELECT returns one row per team with the pitcher’s full name and top speed,
--    ordered from fastest to slowest.

WITH all_pitches AS (
  SELECT *
  FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT *
  FROM `bigquery-public-data.baseball.games_post_wide`
),
tagged AS (
  SELECT
    CASE
      WHEN pitcherId IN (homeFielder1, homeFielder10) THEN homeTeamId
      WHEN pitcherId IN (awayFielder1, awayFielder10) THEN awayTeamId
      ELSE NULL
    END                         AS team_id,
    pitcherId,
    pitcherFirstName            AS first_name,
    pitcherLastName             AS last_name,
    pitchSpeed
  FROM all_pitches
  WHERE pitchSpeed > 0
),
per_pitcher AS (
  SELECT
    team_id,
    pitcherId,
    ANY_VALUE(first_name) AS first_name,
    ANY_VALUE(last_name)  AS last_name,
    MAX(pitchSpeed)       AS max_speed
  FROM tagged
  WHERE team_id IS NOT NULL
  GROUP BY team_id, pitcherId
),
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY team_id ORDER BY max_speed DESC) AS rn
  FROM per_pitcher
)
SELECT
  team_id,
  pitcherId,
  CONCAT(first_name, ' ', last_name) AS pitcher_name,
  max_speed
FROM ranked
WHERE rn = 1
ORDER BY max_speed DESC;
```
