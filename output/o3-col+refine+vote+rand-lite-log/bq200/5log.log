```sql
--Description:  (Thinking process inline)
--  • Start with two source tables (regular-season & post-season) and UNION ALL rows
--    that have a positive pitchSpeed.                                                   
--  • For every row, build two STRING arrays containing every home- and away-fielder ID. 
--  • Compare pitcherId against those arrays to decide which club (team_id) he is        
--    pitching for in that play.  Discard rows where that test fails (safety filter).    
--  • Aggregate to the maximum pitch speed a given pitcher ever reached for that team.   
--  • Per team, keep only the pitcher(s) whose max_speed equals the absolute fastest     
--    thrown by anyone on that club.  Attach a human-readable full name via ANY_VALUE.   
--  • Return one row per (team_id, pitcher) that shares the team’s fastest recorded      
--    pitch, sorted by velocity.                                                         
WITH all_pitches AS (                         -- 1) merge REG + PST pitches
  SELECT
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
    homeTeamId,
    awayTeamId,
    [homeFielder1,homeFielder2,homeFielder3,homeFielder4,
     homeFielder5,homeFielder6,homeFielder7,homeFielder8,
     homeFielder9,homeFielder10,homeFielder11,homeFielder12] AS home_ids,
    [awayFielder1,awayFielder2,awayFielder3,awayFielder4,
     awayFielder5,awayFielder6,awayFielder7,awayFielder8,
     awayFielder9,awayFielder10,awayFielder11,awayFielder12] AS away_ids
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0

  UNION ALL

  SELECT
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
    homeTeamId,
    awayTeamId,
    [homeFielder1,homeFielder2,homeFielder3,homeFielder4,
     homeFielder5,homeFielder6,homeFielder7,homeFielder8,
     homeFielder9,homeFielder10,homeFielder11,homeFielder12],
    [awayFielder1,awayFielder2,awayFielder3,awayFielder4,
     awayFielder5,awayFielder6,awayFielder7,awayFielder8,
     awayFielder9,awayFielder10,awayFielder11,awayFielder12]
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
),

team_pitches AS (                           -- 2) validate which club the pitcher is on
  SELECT
    pitchSpeed,
    pitcherId,
    pitcher_name,
    CASE
      WHEN pitcherId IN UNNEST(home_ids) THEN homeTeamId
      WHEN pitcherId IN UNNEST(away_ids) THEN awayTeamId
    END AS team_id
  FROM all_pitches
  WHERE
    (pitcherId IN UNNEST(home_ids))
    OR
    (pitcherId IN UNNEST(away_ids))       -- ensures team_id not null
),

pitcher_peak AS (                           -- 3) max speed per (team, pitcher)
  SELECT
    team_id,
    pitcherId,
    MAX(pitchSpeed) AS max_speed
  FROM team_pitches
  GROUP BY team_id, pitcherId
),

team_fastest AS (                           -- 4) overall fastest per team
  SELECT
    team_id,
    MAX(max_speed) AS team_top_speed
  FROM pitcher_peak
  GROUP BY team_id
)

SELECT
  p.team_id,
  ANY_VALUE(tp.pitcher_name) AS pitcher_full_name,
  p.max_speed AS highest_pitch_speed
FROM pitcher_peak AS p
JOIN team_fastest AS t
  ON p.team_id = t.team_id
 AND p.max_speed = t.team_top_speed        -- keep only the club-record holder(s)
-- join back to team_pitches once to fetch a name (ANY_VALUE due to 1-to-many ok)
JOIN team_pitches AS tp
  ON tp.team_id = p.team_id
 AND tp.pitcherId = p.pitcherId
GROUP BY p.team_id, p.pitcherId, p.max_speed
ORDER BY highest_pitch_speed DESC, team_id
LIMIT 100;
