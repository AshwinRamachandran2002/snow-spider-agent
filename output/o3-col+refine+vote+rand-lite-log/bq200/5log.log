Query:
-- 1. Quick look at the distribution of pitch speeds (regular-season table only)
SELECT DISTINCT `pitchSpeed`
FROM `bigquery-public-data.baseball.games_wide`
WHERE `pitchSpeed` > 0
ORDER BY `pitchSpeed` DESC
LIMIT 20;
