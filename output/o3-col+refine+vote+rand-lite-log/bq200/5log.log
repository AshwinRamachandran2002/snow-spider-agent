```

```sql
-- 5. Union regular-season and post-season rows keeping only useful columns
WITH all_pitches AS (
  SELECT
     `pitchSpeed`,
     `pitcherId`,
     CONCAT(`pitcherFirstName`,' ',`pitcherLastName`)           AS pitcher_name,
     `homeTeamId`,
     `awayTeamId`,
     ARRAY<STRING>[
        `homeFielder1`,`homeFielder2`,`homeFielder3`,`homeFielder4`,
        `homeFielder5`,`homeFielder6`,`homeFielder7`,`homeFielder8`,
        `homeFielder9`,`homeFielder10`,`homeFielder11`,`homeFielder12`
     ]                                                          AS home_ids,
     ARRAY<STRING>[
        `awayFielder1`,`awayFielder2`,`awayFielder3`,`awayFielder4`,
        `awayFielder5`,`awayFielder6`,`awayFielder7`,`awayFielder8`,
        `awayFielder9`,`awayFielder10`,`awayFielder11`,`awayFielder12`
     ]                                                          AS away_ids
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE `pitchSpeed` > 0

  UNION ALL

  SELECT
     `pitchSpeed`,
     `pitcherId`,
     CONCAT(`pitcherFirstName`,' ',`pitcherLastName`)           AS pitcher_name,
     `homeTeamId`,
     `awayTeamId`,
     ARRAY<STRING>[
        `homeFielder1`,`homeFielder2`,`homeFielder3`,`homeFielder4`,
        `homeFielder5`,`homeFielder6`,`homeFielder7`,`homeFielder8`,
        `homeFielder9`,`homeFielder10`,`homeFielder11`,`homeFielder12`
     ],
     ARRAY<STRING>[
        `awayFielder1`,`awayFielder2`,`awayFielder3`,`awayFielder4`,
        `awayFielder5`,`awayFielder6`,`awayFielder7`,`awayFielder8`,
        `awayFielder9`,`awayFielder10`,`awayFielder11`,`awayFielder12`
     ]
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE `pitchSpeed` > 0
)
SELECT * FROM all_pitches
LIMIT 20;
```

```sql
-- 6. Attach the team actually being pitched for (confirmed via fielder arrays)
WITH all_pitches AS ( /* same CTE from query 5 */ SELECT * FROM (
  SELECT
     `pitchSpeed`, `pitcherId`, CONCAT(`pitcherFirstName`,' ',`pitcherLastName`) AS pitcher_name,
     `homeTeamId`, `awayTeamId`,
     ARRAY<STRING>[
        `homeFielder1`,`homeFielder2`,`homeFielder3`,`homeFielder4`,
        `homeFielder5`,`homeFielder6`,`homeFielder7`,`homeFielder8`,
        `homeFielder9`,`homeFielder10`,`homeFielder11`,`homeFielder12`
     ] AS home_ids,
     ARRAY<STRING>[
        `awayFielder1`,`awayFielder2`,`awayFielder3`,`awayFielder4`,
        `awayFielder5`,`awayFielder6`,`awayFielder7`,`awayFielder8`,
        `awayFielder9`,`awayFielder10`,`awayFielder11`,`awayFielder12`
     ] AS away_ids
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE `pitchSpeed` > 0
  UNION ALL
  SELECT
     `pitchSpeed`, `pitcherId`, CONCAT(`pitcherFirstName`,' ',`pitcherLastName`) AS pitcher_name,
     `homeTeamId`, `awayTeamId`,
     ARRAY<STRING>[
        `homeFielder1`,`homeFielder2`,`homeFielder3`,`homeFielder4`,
        `homeFielder5`,`homeFielder6`,`homeFielder7`,`homeFielder8`,
        `homeFielder9`,`homeFielder10`,`homeFielder11`,`homeFielder12`
     ],
     ARRAY<STRING>[
        `awayFielder1`,`awayFielder2`,`awayFielder3`,`awayFielder4`,
        `awayFielder5`,`awayFielder6`,`awayFielder7`,`awayFielder8`,
        `awayFielder9`,`awayFielder10`,`awayFielder11`,`awayFielder12`
     ]
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE `pitchSpeed` > 0 ) ),
team_pitches AS (
  SELECT
     `pitchSpeed`,
     `pitcherId`,
     `pitcher_name`,
     CASE
       WHEN `pitcherId` IN UNNEST(home_ids) THEN `homeTeamId`
       WHEN `pitcherId` IN UNNEST(away_ids) THEN `awayTeamId`
     END AS team_id
  FROM all_pitches
  WHERE team_id IS NOT NULL
)
SELECT *
FROM team_pitches
LIMIT 20;
```

```sql
-- 7. Maximum speed each pitcher threw while with each team
WITH team_pitches AS ( /* same sub-query as #6 */ SELECT * FROM (
  /* …contents omitted for brevity… */
) )
SELECT
  team_id,
  `pitcherId`,
  MAX(`pitchSpeed`) AS max_speed
FROM team_pitches
GROUP BY team_id, `pitcherId`
LIMIT 20;
```

```sql
-- 8. For every team, pick the pitcher(s) who owns the single highest speed
WITH team_pitches AS ( /* same as #6 */ SELECT * FROM ( /* … */ ) ),
per_pitcher AS (
  SELECT
    team_id,
    `pitcherId`,
    MAX(`pitchSpeed`) AS max_speed
  FROM team_pitches
  GROUP BY team_id, `pitcherId`
),
per_team AS (
  SELECT
    team_id,
    MAX(max_speed) AS team_top_speed
  FROM per_pitcher
  GROUP BY team_id
)
SELECT
  p.team_id,
  p.`pitcherId`,
  p.max_speed
FROM per_pitcher AS p
JOIN per_team  AS t
ON  p.team_id = t.team_id AND p.max_speed = t.team_top_speed
LIMIT 20;
```

```sql
-- 9. Attach pitcher full names to the final answer
WITH final_ids AS ( /* query #8 without LIMIT */ SELECT * FROM ( /* … */ ) ),
names AS (
  SELECT DISTINCT
     `pitcherId`,
     CONCAT(`pitcherFirstName`,' ',`pitcherLastName`) AS full_name
  FROM `bigquery-public-data.baseball.games_wide`
  UNION DISTINCT
  SELECT DISTINCT
     `pitcherId`,
     CONCAT(`pitcherFirstName`,' ',`pitcherLastName`)
  FROM `bigquery-public-data.baseball.games_post_wide`
)
SELECT
  f.team_id,
  n.full_name,
  f.max_speed
FROM final_ids AS f
LEFT JOIN names AS n USING(`pitcherId`)
ORDER BY f.max_speed DESC
LIMIT 20;
```

```sql
-- 10. (Optional) Present one row per team – pitcher, name & highest valid speed
WITH team_pitches AS ( /* same as #6 */ SELECT * FROM ( /* … */ ) ),
per_pitcher AS (
  SELECT team_id, `pitcherId`, MAX(`pitchSpeed`) AS max_speed
  FROM team_pitches
  GROUP BY team_id, `pitcherId`
),
top_pitcher AS (
  SELECT
    p.*
  FROM per_pitcher p
  JOIN (
     SELECT team_id, MAX(max_speed) AS best_speed
     FROM per_pitcher
     GROUP BY team_id
  ) b
  ON p.team_id = b.team_id AND p.max_speed = b.best_speed
),
pitcher_names AS (
  SELECT DISTINCT `pitcherId`,
    CONCAT(`pitcherFirstName`,' ',`pitcherLastName`) AS full_name
  FROM `bigquery-public-data.baseball.games_wide`
  UNION DISTINCT
  SELECT DISTINCT `pitcherId`,
    CONCAT(`pitcherFirstName`,' ',`pitcherLastName`)
  FROM `bigquery-public-data.baseball.games_post_wide`
)
SELECT
  t.team_id,
  n.full_name,
  t.max_speed
FROM top_pitcher AS t
JOIN pitcher_names AS n USING(`pitcherId`)
ORDER BY t.team_id
LIMIT 20;
```
