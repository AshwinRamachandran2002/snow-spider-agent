    team_id,
    pitcherId,
    MAX(pitchSpeed) AS max_speed
  FROM team_pitches
  GROUP BY team_id, pitcherId
),
per_team AS (
  SELECT
    team_id,
    MAX(max_speed) AS team_top_speed
  FROM per_pitcher
  GROUP BY team_id
),
final_ids AS (
