Query:
-- 4. Make sure the pitcher really appears in the proper fielder list (one example)
SELECT
  `gameId`, `pitcherId`,
  CONCAT(`pitcherFirstName`,' ',`pitcherLastName`) AS pitcher_name,
  `homeFielder1`, `awayFielder1`
FROM `bigquery-public-data.baseball.games_wide`
WHERE `pitchSpeed` > 0
  AND `pitcherId` = `homeFielder1`
LIMIT 20;
