```sql
-- 6. Create a per-row “teamId” for the pitcher 
--    (regular season only, for illustration)
SELECT
  pitcherId,
  CONCAT(pitcherFirstName,' ',pitcherLastName)  AS pitcher_name,
  pitchSpeed,
  CASE
    WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                              homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                              homeFielder9,homeFielder10,homeFielder11,homeFielder12])
         THEN homeTeamId
    WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                              awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                              awayFielder9,awayFielder10,awayFielder11,awayFielder12])
         THEN awayTeamId
  END AS teamId
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
  AND teamId IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Get each (team, pitcher) pair’s maximum valid pitch speed 
--    across REG + PST games
WITH all_games AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
), pitch_team AS (
  SELECT
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
    pitchSpeed,
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                                homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                                homeFielder9,homeFielder10,homeFielder11,homeFielder12])
           THEN homeTeamId
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                                awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                                awayFielder9,awayFielder10,awayFielder11,awayFielder12])
           THEN awayTeamId
    END AS teamId
  FROM all_games
  WHERE pitchSpeed > 0
), max_pitch AS (
  SELECT
    teamId,
    pitcherId,
    MAX(pitchSpeed) AS max_speed
  FROM pitch_team
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId
)
SELECT * FROM max_pitch
LIMIT 20;
```

```sql
-- 8. Rank pitchers by max speed within each team and keep the fastest one
WITH all_games AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
), pitch_team AS (
  SELECT
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
    pitchSpeed,
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                                homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                                homeFielder9,homeFielder10,homeFielder11,homeFielder12])
           THEN homeTeamId
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                                awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                                awayFielder9,awayFielder10,awayFielder11,awayFielder12])
           THEN awayTeamId
    END AS teamId
  FROM all_games
  WHERE pitchSpeed > 0
), max_pitch AS (
  SELECT
    teamId,
    pitcherId,
    MAX(pitchSpeed) AS max_speed
  FROM pitch_team
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId
), ranked AS (
  SELECT
    teamId,
    pitcherId,
    max_speed,
    ROW_NUMBER() OVER (PARTITION BY teamId ORDER BY max_speed DESC) AS rn
  FROM max_pitch
)
SELECT teamId,
       pitcherId,
       max_speed
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: fastest valid pitch for every team with pitcher’s full name
WITH all_games AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
), pitch_team AS (
  SELECT
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
    pitchSpeed,
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                                homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                                homeFielder9,homeFielder10,homeFielder11,homeFielder12])
           THEN homeTeamId
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                                awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                                awayFielder9,awayFielder10,awayFielder11,awayFielder12])
           THEN awayTeamId
    END AS teamId
  FROM all_games
  WHERE pitchSpeed > 0
), max_pitch AS (
  SELECT
    teamId,
    pitcherId,
    ANY_VALUE(pitcher_name) AS pitcher_name,
    MAX(pitchSpeed) AS max_speed
  FROM pitch_team
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId
), ranked AS (
  SELECT
    teamId,
    pitcherId,
    pitcher_name,
    max_speed,
    ROW_NUMBER() OVER (PARTITION BY teamId ORDER BY max_speed DESC) AS rn
  FROM max_pitch
)
SELECT
  teamId        AS team_id,
  pitcher_name  AS fastest_pitcher,
  max_speed     AS fastest_non_zero_pitch_speed
FROM ranked
WHERE rn = 1
ORDER BY team_id
LIMIT 100;
```

```sql
-- 10. Verify a specific team (example) – show all speeds for its fastest pitcher
WITH fastest AS (
  /* reuse CTEs from query 9 but keep only one team, e.g. '55714da8-fcaf-4574-8443-59bfb511a524' */
  WITH all_games AS (
    SELECT * FROM `bigquery-public-data.baseball.games_wide`
    UNION ALL
    SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
  ), pitch_team AS (
    SELECT
      pitcherId,
      CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
      pitchSpeed,
      CASE
        WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                                  homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                                  homeFielder9,homeFielder10,homeFielder11,homeFielder12])
             THEN homeTeamId
        WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                                  awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                                  awayFielder9,awayFielder10,awayFielder11,awayFielder12])
             THEN awayTeamId
      END AS teamId
    FROM all_games
    WHERE pitchSpeed > 0
  ), max_pitch AS (
    SELECT
      teamId,
      pitcherId,
      ANY_VALUE(pitcher_name) AS pitcher_name,
      MAX(pitchSpeed) AS max_speed
    FROM pitch_team
    WHERE teamId IS NOT NULL
    GROUP BY teamId, pitcherId
  ), ranked AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY teamId ORDER BY max_speed DESC) AS rn
    FROM max_pitch
  )
  SELECT teamId, pitcherId
  FROM ranked
  WHERE rn = 1
    AND teamId = '55714da8-fcaf-4574-8443-59bfb511a524'   -- Cubs (example)
)
SELECT pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
  AND pitcherId = (SELECT pitcherId FROM fastest)
ORDER BY pitchSpeed DESC
LIMIT 20;
```

These ten queries proceed from simple inspection to constructing and returning the final list of fastest non-zero pitches for every team across both the regular season and the post-season.
