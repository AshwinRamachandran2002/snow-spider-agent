                         homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                         homeFielder9,homeFielder10,homeFielder11,homeFielder12)
           THEN homeTeamId
      WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                         awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                         awayFielder9,awayFielder10,awayFielder11,awayFielder12)
           THEN awayTeamId
    END AS teamId
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
)
WHERE teamId IS NOT NULL
GROUP BY teamId, pitcherId
LIMIT 20;
```

```sql
--Description: UNION the two aggregates (regular + post) so every pitch
-- for every team is available in one place.
WITH uni AS (
  SELECT teamId, pitcherId, MAX(pitchSpeed) AS max_speed
  FROM (
    SELECT
      pitchSpeed,
      pitcherId,
      CASE
        WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                           homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                           homeFielder9,homeFielder10,homeFielder11,homeFielder12)
             THEN homeTeamId
        WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                           awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                           awayFielder9,awayFielder10,awayFielder11,awayFielder12)
             THEN awayTeamId
      END AS teamId
    FROM `bigquery-public-data.baseball.games_wide`
    WHERE pitchSpeed > 0
    UNION ALL
    SELECT
      pitchSpeed,
      pitcherId,
      CASE
        WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                           homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                           homeFielder9,homeFielder10,homeFielder11,homeFielder12)
             THEN homeTeamId
        WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                           awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                           awayFielder9,awayFielder10,awayFielder11,awayFielder12)
             THEN awayTeamId
      END AS teamId
    FROM `bigquery-public-data.baseball.games_post_wide`
    WHERE pitchSpeed > 0
  )
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId
)
SELECT *
FROM uni
LIMIT 20;
```

```sql
--Description: From the UNION table choose, for every club, the single
-- pitcher whose recorded max_speed is the highest.
WITH all_pitcher_team AS (
  SELECT teamId, pitcherId, MAX(pitchSpeed) AS max_speed
  FROM (
    SELECT
      pitchSpeed,
      pitcherId,
      CASE
        WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                           homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                           homeFielder9,homeFielder10,homeFielder11,homeFielder12)
             THEN homeTeamId
        WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                           awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                           awayFielder9,awayFielder10,awayFielder11,awayFielder12)
             THEN awayTeamId
      END AS teamId
    FROM `bigquery-public-data.baseball.games_wide`
    WHERE pitchSpeed > 0
    UNION ALL
    SELECT
      pitchSpeed,
      pitcherId,
      CASE
        WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                           homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                           homeFielder9,homeFielder10,homeFielder11,homeFielder12)
             THEN homeTeamId
        WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                           awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                           awayFielder9,awayFielder10,awayFielder11,awayFielder12)
             THEN awayTeamId
      END AS teamId
    FROM `bigquery-public-data.baseball.games_post_wide`
    WHERE pitchSpeed > 0
  )
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId
),
team_best AS (
  SELECT
    teamId,
    ARRAY_AGG(STRUCT(pitcherId, max_speed) ORDER BY max_speed DESC LIMIT 1)[OFFSET(0)] AS best
  FROM all_pitcher_team
  GROUP BY teamId
)
SELECT *
FROM team_best
LIMIT 20;
```

```sql
--Description: Attach pitcher first/last names (take any one row for name),
-- show each team’s fastest pitcher and his top verified velocity.
WITH all_pitches AS (
  SELECT
    pitchSpeed,
    pitcherId,
    pitcherFirstName,
    pitcherLastName,
    CASE
      WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                         homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                         homeFielder9,homeFielder10,homeFielder11,homeFielder12)
           THEN homeTeamId
      WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                         awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                         awayFielder9,awayFielder10,awayFielder11,awayFielder12)
           THEN awayTeamId
    END AS teamId
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  UNION ALL
  SELECT
    pitchSpeed,
    pitcherId,
    pitcherFirstName,
    pitcherLastName,
    CASE
      WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                         homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                         homeFielder9,homeFielder10,homeFielder11,homeFielder12)
           THEN homeTeamId
      WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                         awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                         awayFielder9,awayFielder10,awayFielder11,awayFielder12)
           THEN awayTeamId
    END AS teamId
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
),
max_by_pitcher AS (
  SELECT
    teamId,
    pitcherId,
    MAX(pitchSpeed) AS max_speed
  FROM all_pitches
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId
),
team_fastest AS (
  SELECT
    teamId,
    ARRAY_AGG(STRUCT(pitcherId,max_speed) ORDER BY max_speed DESC LIMIT 1)[OFFSET(0)] AS fastest
  FROM max_by_pitcher
  GROUP BY teamId
)
SELECT
  t.teamId,
  p.max_speed AS fastest_pitchSpeed,
  n.pitcherFirstName,
  n.pitcherLastName
FROM team_fastest t
CROSS JOIN UNNEST([t.fastest]) AS p
LEFT JOIN (
  SELECT DISTINCT pitcherId, pitcherFirstName, pitcherLastName
  FROM all_pitches
) AS n
ON n.pitcherId = p.pitcherId
ORDER BY p.max_speed DESC
LIMIT 20;
```

