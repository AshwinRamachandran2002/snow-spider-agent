```

```sql
--Description: What are the highest (non-zero) pitch speeds that appear
-- in the regular-season table?
SELECT DISTINCT pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
ORDER BY pitchSpeed DESC
LIMIT 20;
```

```sql
--Description: For one regular-season row, confirm how to decide which
-- club the pitcher belongs to by checking the fielder lists.
SELECT
  pitcherId,
  pitcherFirstName,
  pitcherLastName,
  pitchSpeed,
  CASE
    WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                       homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                       homeFielder9,homeFielder10,homeFielder11,homeFielder12)
         THEN homeTeamId
    WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                       awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                       awayFielder9,awayFielder10,awayFielder11,awayFielder12)
         THEN awayTeamId
  END AS teamId
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
LIMIT 20;
```

```sql
--Description: Aggregate the maximum pitch speed each pitcher reached for
-- every team in the regular season (after assigning club properly).
SELECT
  teamId,
  pitcherId,
  MAX(pitchSpeed) AS max_pitch_speed
FROM (
  SELECT
    pitchSpeed,
    pitcherId,
    CASE
      WHEN pitcherId IN (homeFielder1,homeFielder2,homeFielder3,homeFielder4,
                         homeFielder5,homeFielder6,homeFielder7,homeFielder8,
                         homeFielder9,homeFielder10,homeFielder11,homeFielder12)
           THEN homeTeamId
      WHEN pitcherId IN (awayFielder1,awayFielder2,awayFielder3,awayFielder4,
                         awayFielder5,awayFielder6,awayFielder7,awayFielder8,
                         awayFielder9,awayFielder10,awayFielder11,awayFielder12)
           THEN awayTeamId
    END AS teamId
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
)
WHERE teamId IS NOT NULL
GROUP BY teamId, pitcherId
LIMIT 20;
```

```sql
