```sql
--1) Quick glance at regular–season pitch–speed values together with pitcher & both teams involved
SELECT 
  pitcherId,
  CONCAT(pitcherFirstName,' ',pitcherLastName)            AS pitcher_name,
  pitchSpeed,
  homeTeamId, homeTeamName,
  awayTeamId, awayTeamName
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
LIMIT 20;
```

```sql
--2) Inspect which “fielder” slots normally hold the active pitcher (regular season sample)
SELECT 
  pitcherId, 
  homeFielder1, homeFielder2, homeFielder3,
  awayFielder1, awayFielder2, awayFielder3,
  pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
LIMIT 20;
```

```sql
--3) Show rows where the pitcherId actually appears in one of the 12 home-fielder slots
SELECT 
  pitcherId,
  CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
  homeTeamId, homeTeamName,
  pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
  AND pitcherId IN UNNEST([
        homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,homeFielder6,
        homeFielder7,homeFielder8,homeFielder9,homeFielder10,homeFielder11,homeFielder12])
LIMIT 20;
```

```sql
--4) Same check for away-fielder slots (regular season)
SELECT 
  pitcherId,
  CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcher_name,
  awayTeamId, awayTeamName,
  pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
  AND pitcherId IN UNNEST([
        awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,awayFielder6,
        awayFielder7,awayFielder8,awayFielder9,awayFielder10,awayFielder11,awayFielder12])
LIMIT 20;
```

```sql
--5) Maximum non-zero pitch-speed each pitcher reached for every team (REG-season only, 20 samples)
WITH plays AS (
  SELECT
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,
                                homeFielder6,homeFielder7,homeFielder8,homeFielder9,homeFielder10,
                                homeFielder11,homeFielder12])
        THEN homeTeamId
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,
                                awayFielder6,awayFielder7,awayFielder8,awayFielder9,awayFielder10,
                                awayFielder11,awayFielder12])
        THEN awayTeamId
    END                                                     AS teamId,
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,
                                homeFielder6,homeFielder7,homeFielder8,homeFielder9,homeFielder10,
                                homeFielder11,homeFielder12])
        THEN homeTeamName
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,
                                awayFielder6,awayFielder7,awayFielder8,awayFielder9,awayFielder10,
                                awayFielder11,awayFielder12])
        THEN awayTeamName
    END                                                     AS teamName,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName)            AS pitcher_name,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
)
SELECT teamId, teamName, pitcherId, pitcher_name, MAX(pitchSpeed) AS max_speed
FROM plays
WHERE teamId IS NOT NULL
GROUP BY teamId, teamName, pitcherId, pitcher_name
ORDER BY max_speed DESC
LIMIT 20;
```

```sql
--6) Repeat previous step for POST-season only (20 samples)
WITH plays AS (
  SELECT
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,
                                homeFielder6,homeFielder7,homeFielder8,homeFielder9,homeFielder10,
                                homeFielder11,homeFielder12])
        THEN homeTeamId
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,
                                awayFielder6,awayFielder7,awayFielder8,awayFielder9,awayFielder10,
                                awayFielder11,awayFielder12])
        THEN awayTeamId
    END                                   AS teamId,
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,
                                homeFielder6,homeFielder7,homeFielder8,homeFielder9,homeFielder10,
                                homeFielder11,homeFielder12])
        THEN homeTeamName
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,
                                awayFielder6,awayFielder7,awayFielder8,awayFielder9,awayFielder10,
                                awayFielder11,awayFielder12])
        THEN awayTeamName
    END                                   AS teamName,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName)  AS pitcher_name,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
)
SELECT teamId, teamName, pitcherId, pitcher_name, MAX(pitchSpeed) AS max_speed
FROM plays
WHERE teamId IS NOT NULL
GROUP BY teamId, teamName, pitcherId, pitcher_name
ORDER BY max_speed DESC
LIMIT 20;
```

```sql
--7) Combine REG + POST season rows into one common source
WITH union_games AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
)
SELECT 
  COUNT(*) AS total_rows,
  MIN(startTime) AS first_game,
  MAX(startTime) AS last_game
FROM union_games
LIMIT 20;
```

```sql
--8) FINAL: for each team, return the pitcher that recorded the single highest non-zero pitch-speed (REG + POST)
WITH union_games AS (
  SELECT * FROM `bigquery-public-data.baseball.games_wide`
  UNION ALL
  SELECT * FROM `bigquery-public-data.baseball.games_post_wide`
),
plays AS (
  SELECT
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,
                                homeFielder6,homeFielder7,homeFielder8,homeFielder9,homeFielder10,
                                homeFielder11,homeFielder12])
        THEN homeTeamId
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,
                                awayFielder6,awayFielder7,awayFielder8,awayFielder9,awayFielder10,
                                awayFielder11,awayFielder12])
        THEN awayTeamId
    END                                                     AS teamId,
    CASE
      WHEN pitcherId IN UNNEST([homeFielder1,homeFielder2,homeFielder3,homeFielder4,homeFielder5,
                                homeFielder6,homeFielder7,homeFielder8,homeFielder9,homeFielder10,
                                homeFielder11,homeFielder12])
        THEN homeTeamName
      WHEN pitcherId IN UNNEST([awayFielder1,awayFielder2,awayFielder3,awayFielder4,awayFielder5,
                                awayFielder6,awayFielder7,awayFielder8,awayFielder9,awayFielder10,
                                awayFielder11,awayFielder12])
        THEN awayTeamName
    END                                                     AS teamName,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName)            AS pitcher_name,
    pitchSpeed
  FROM union_games
  WHERE pitchSpeed > 0
),
max_by_team AS (
  SELECT teamId, MAX(pitchSpeed) AS max_speed
  FROM plays
  WHERE teamId IS NOT NULL
  GROUP BY teamId
)
SELECT DISTINCT
  m.teamId,
  ANY_VALUE(p.teamName)      AS teamName,
  p.pitcherId,
  ANY_VALUE(p.pitcher_name)  AS pitcher_name,
  m.max_speed
FROM max_by_team AS m
JOIN plays         AS p
  ON p.teamId = m.teamId
 AND p.pitchSpeed = m.max_speed
ORDER BY m.max_speed DESC
LIMIT 20;
```
