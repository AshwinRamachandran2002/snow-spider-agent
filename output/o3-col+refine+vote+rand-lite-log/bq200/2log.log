--Description: Fastest recorded pitch by any pitcher (regular + post-season), showing
--             the pitcher’s full name and the top velocity.
WITH combined AS (
  SELECT
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  
  UNION ALL
  
  SELECT
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
),
per_pitcher AS (
  SELECT
    pitcherId,
    pitcherName,
    MAX(pitchSpeed) AS fastest_pitch
  FROM combined
  GROUP BY pitcherId, pitcherName
)
SELECT *
FROM per_pitcher
ORDER BY fastest_pitch DESC
LIMIT 20;
