```sql
--Description: List every pitcher whose best fastball equals the absolute MLB-wide
--             maximum speed (ties included) and display that top velocity.
WITH combined AS (
  SELECT
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  
  UNION ALL
  
  SELECT
    pitchSpeed,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
),
per_pitcher AS (
  SELECT
    pitcherId,
    pitcherName,
    MAX(pitchSpeed) AS fastest_pitch
  FROM combined
  GROUP BY pitcherId, pitcherName
),
global_max AS (
  SELECT MAX(fastest_pitch) AS top_speed_mph FROM per_pitcher
)
SELECT
  p.pitcherName,
  p.pitcherId,
  p.fastest_pitch AS top_speed_mph
FROM per_pitcher p
JOIN global_max g
  ON p.fastest_pitch = g.top_speed_mph;
```
