    END                        AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  UNION ALL
  SELECT
