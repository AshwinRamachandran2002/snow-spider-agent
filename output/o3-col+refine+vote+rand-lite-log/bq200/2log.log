```sql
--Description / Thinking process ------------------------------------------------
--Objective:  For every MLB club, find the pitcher who recorded the single
--            highest (non-zero) pitch speed during the 2016 season, looking at
--            both regular-season (`games_wide`) and post-season
--            (`games_post_wide`) pitch-by-pitch data.
--
--Logical steps (implemented with CTEs):
-- 1. team_names  : obtain distinct teamId ↔ teamName pairs from `schedules`.
-- 2. all_pitches : gather every pitch with speed > 0 from both wide tables and
--                  deduce which club the pitcher was working for by checking if
--                  his ID appears in any home- or away-fielder slot.  Keep
--                  teamId, pitcherId, pitcherName, and pitchSpeed.
-- 3. per_pitcher : collapse to one row per (team, pitcher) holding that
--                  pitcher’s maximum recorded velocity for that club.
-- 4. ranked      : rank pitchers inside each club by max_speed.
-- 5. final SELECT: keep the #1 (fastest) pitcher for every team and output
--                  team name, pitcher name, and top velocity.
---------------------------------------------------------------------------------
WITH team_names AS (
  SELECT DISTINCT homeTeamId AS teamId, homeTeamName AS teamName
  FROM `bigquery-public-data.baseball.schedules`
  UNION DISTINCT
  SELECT DISTINCT awayTeamId, awayTeamName
  FROM `bigquery-public-data.baseball.schedules`
),
all_pitches AS (
  -- Regular-season pitches ------------------------------------------------------
  SELECT
    CASE
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
    END                                           AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName)  AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  UNION ALL
  -- Post-season pitches ---------------------------------------------------------
  SELECT
    CASE
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
    END                                           AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName)  AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
),
per_pitcher AS (
  -- Best velocity for each pitcher-team pairing -------------------------------
  SELECT
    teamId,
    pitcherId,
    pitcherName,
    MAX(pitchSpeed) AS max_speed
  FROM all_pitches
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId, pitcherName
),
ranked AS (
  -- Rank pitchers inside each club by velocity ---------------------------------
  SELECT
    teamId,
    pitcherId,
    pitcherName,
    max_speed,
    ROW_NUMBER() OVER (PARTITION BY teamId ORDER BY max_speed DESC) AS rn
  FROM per_pitcher
)
-- Final: fastest pitcher per team ---------------------------------------------
SELECT
  tn.teamName         AS team,
  r.pitcherName       AS hardest_thrower,
  r.max_speed         AS top_velocity_mph
FROM ranked r
JOIN team_names tn
  ON r.teamId = tn.teamId
WHERE r.rn = 1
ORDER BY tn.teamName;   -- remove or adjust ORDER BY / LIMIT as needed
```
