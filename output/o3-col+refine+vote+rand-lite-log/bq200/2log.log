```sql
--Description: Preview a few non-zero pitch–speed records and the pitchers who threw them in regular-season data.
SELECT DISTINCT pitcherId, pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
LIMIT 20;
```

```sql
--Description: Check whether the current pitcher also appears in the “home/away fielder-1” slots for the same play.
SELECT pitcherId,
       awayFielder1 AS awayPitchingSlot,
       homeFielder1 AS homePitchingSlot
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
LIMIT 20;
```

```sql
--Description: For each pitch, work out which club the pitcher was actually playing for (home or away) in the regular season.
SELECT
  gameId,
  pitcherId,
  CASE
    WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                       awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                       awayFielder9, awayFielder10, awayFielder11, awayFielder12)
         THEN awayTeamId
    WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                       homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                       homeFielder9, homeFielder10, homeFielder11, homeFielder12)
         THEN homeTeamId
  END AS teamId,
  pitchSpeed
FROM `bigquery-public-data.baseball.games_wide`
WHERE pitchSpeed > 0
LIMIT 20;
```

```sql
--Description: Build one combined (regular + post-season) set that keeps only pitches with a confirmed team for the pitcher.
WITH combined AS (
  SELECT
    CASE
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
    END                        AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0

  UNION ALL

  SELECT
    CASE
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
    END                        AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
)
SELECT *
FROM combined
WHERE teamId IS NOT NULL
LIMIT 20;
```

```sql
--Description: For every pitcher–team pair, find that pitcher’s maximum valid pitch speed.
WITH combined AS ( /* same CTE as above */ 
  SELECT
    CASE
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
    END                        AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  UNION ALL
  SELECT
    CASE
      WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                         awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                         awayFielder9, awayFielder10, awayFielder11, awayFielder12)
           THEN awayTeamId
      WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                         homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                         homeFielder9, homeFielder10, homeFielder11, homeFielder12)
           THEN homeTeamId
    END                        AS teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    pitchSpeed
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
)
SELECT
  teamId,
  pitcherId,
  pitcherName,
  MAX(pitchSpeed) AS max_speed
FROM combined
WHERE teamId IS NOT NULL
GROUP BY teamId, pitcherId, pitcherName
LIMIT 20;
```

```sql
--Description: Rank pitchers within each club by their top velocity so we know who threw the hardest for every team.
WITH per_pitcher AS ( /* query from step 5 */ 
  SELECT
    teamId,
    pitcherId,
    pitcherName,
    MAX(pitchSpeed) AS max_speed
  FROM (
    /* identical COMBINED CTE as before */
    SELECT
      CASE
        WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                           awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                           awayFielder9, awayFielder10, awayFielder11, awayFielder12)
             THEN awayTeamId
        WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                           homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                           homeFielder9, homeFielder10, homeFielder11, homeFielder12)
             THEN homeTeamId
      END                        AS teamId,
      pitcherId,
      CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
      pitchSpeed
    FROM `bigquery-public-data.baseball.games_wide`
    WHERE pitchSpeed > 0
    UNION ALL
    SELECT
      CASE
        WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                           awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                           awayFielder9, awayFielder10, awayFielder11, awayFielder12)
             THEN awayTeamId
        WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                           homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                           homeFielder9, homeFielder10, homeFielder11, homeFielder12)
             THEN homeTeamId
      END                        AS teamId,
      pitcherId,
      CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
      pitchSpeed
    FROM `bigquery-public-data.baseball.games_post_wide`
    WHERE pitchSpeed > 0
  )
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId, pitcherName
),
ranked AS (
  SELECT
    teamId,
    pitcherId,
    pitcherName,
    max_speed,
    ROW_NUMBER() OVER (PARTITION BY teamId ORDER BY max_speed DESC) AS rn
  FROM per_pitcher
)
SELECT *
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Gather a master list of team-ID ↔ team-name pairs from the schedules table.
SELECT DISTINCT homeTeamId AS teamId, homeTeamName AS teamName
FROM `bigquery-public-data.baseball.schedules`
UNION DISTINCT
SELECT DISTINCT awayTeamId, awayTeamName
FROM `bigquery-public-data.baseball.schedules`
LIMIT 20;
```

```sql
--Description: Final answer (first 20 clubs) – hardest-throwing pitcher for each MLB team with his top recorded velocity.
WITH team_names AS (
  SELECT DISTINCT homeTeamId AS teamId, homeTeamName AS teamName
  FROM `bigquery-public-data.baseball.schedules`
  UNION DISTINCT
  SELECT DISTINCT awayTeamId, awayTeamName
  FROM `bigquery-public-data.baseball.schedules`
),
per_pitcher AS (
  /* same logic as step 5 */
  SELECT
    teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    MAX(pitchSpeed) AS max_speed
  FROM (
    SELECT
      CASE
        WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                           awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                           awayFielder9, awayFielder10, awayFielder11, awayFielder12)
             THEN awayTeamId
        WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                           homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                           homeFielder9, homeFielder10, homeFielder11, homeFielder12)
             THEN homeTeamId
      END                        AS teamId,
      pitcherId,
      pitcherFirstName,
      pitcherLastName,
      pitchSpeed
    FROM `bigquery-public-data.baseball.games_wide`
    WHERE pitchSpeed > 0
    UNION ALL
    SELECT
      CASE
        WHEN pitcherId IN (awayFielder1, awayFielder2, awayFielder3, awayFielder4,
                           awayFielder5, awayFielder6, awayFielder7, awayFielder8,
                           awayFielder9, awayFielder10, awayFielder11, awayFielder12)
             THEN awayTeamId
        WHEN pitcherId IN (homeFielder1, homeFielder2, homeFielder3, homeFielder4,
                           homeFielder5, homeFielder6, homeFielder7, homeFielder8,
                           homeFielder9, homeFielder10, homeFielder11, homeFielder12)
             THEN homeTeamId
      END                        AS teamId,
      pitcherId,
      pitcherFirstName,
      pitcherLastName,
      pitchSpeed
    FROM `bigquery-public-data.baseball.games_post_wide`
    WHERE pitchSpeed > 0
  )
  WHERE teamId IS NOT NULL
  GROUP BY teamId, pitcherId, pitcherFirstName, pitcherLastName
),
ranked AS (
  SELECT
    teamId,
    pitcherId,
    CONCAT(pitcherFirstName,' ',pitcherLastName) AS pitcherName,
    max_speed,
    ROW_NUMBER() OVER (PARTITION BY teamId ORDER BY max_speed DESC) AS rn
  FROM per_pitcher
)
SELECT
  t.teamName,
  r.pitcherName,
  r.max_speed
FROM ranked r
JOIN team_names t
  ON r.teamId = t.teamId
WHERE r.rn = 1
LIMIT 20;
```

```sql
--Description: (Optional extra) Show the fastest recorded pitch for the single hardest-throwing pitcher overall.
WITH combined AS (
  SELECT pitchSpeed, pitcherId
  FROM `bigquery-public-data.baseball.games_wide`
  WHERE pitchSpeed > 0
  UNION ALL
  SELECT pitchSpeed, pitcherId
  FROM `bigquery-public-data.baseball.games_post_wide`
  WHERE pitchSpeed > 0
)
SELECT pitcherId, MAX(pitchSpeed) AS fastest_pitch
FROM combined
GROUP BY pitcherId
ORDER BY fastest_pitch DESC
LIMIT 20;
```

```sql
--Description: (Optional extra) Display the team and pitcher names whose best fastball tied at the absolute MLB-wide maximum.
WITH top_speed AS ( /* query from step 9, but keep top value only */ 
  SELECT MAX(pitchSpeed) AS global_top
  FROM (
    SELECT pitchSpeed FROM `bigquery-public-data.baseball.games_wide` WHERE pitchSpeed > 0
    UNION ALL
    SELECT pitchSpeed FROM `bigquery-public-data.baseball.games_post_wide` WHERE pitchSpeed > 0
  )
),
candidates AS (
  SELECT
    pitcherId,
    pitchSpeed
  FROM (
    SELECT pitcherId, pitchSpeed
    FROM `bigquery-public-data.baseball.games_wide`
    WHERE pitchSpeed > 0
    UNION ALL
    SELECT pitcherId, pitchSpeed
    FROM `bigquery-public-data.baseball.games_post_wide`
    WHERE pitchSpeed > 0
  )
  JOIN top_speed USING (pitchSpeed)
)
SELECT DISTINCT pitcherId, pitchSpeed
FROM candidates
LIMIT 20;
```

These step-wise queries progress from simple exploration to the final answer: for each franchise, the pitcher who threw the fastest non-zero pitch (verified by roster slots) and the speed of that pitch.
