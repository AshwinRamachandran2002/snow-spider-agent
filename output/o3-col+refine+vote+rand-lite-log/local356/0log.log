```sql
-- 5. Description:  For one driver, show his lap-to-lap position change (ignoring grid/start lap).  
WITH pos AS (
    SELECT "race_id",
           "driver_id",
           "lap",
           "position",
           LAG("position") OVER(PARTITION BY "race_id","driver_id" ORDER BY "lap") AS "prev_pos"
    FROM   "lap_positions"
    WHERE  "lap_type"='Race'
      AND  "driver_id" = 1      -- sample driver
      AND  "lap" > 1            -- skip start lap
)
SELECT DISTINCT *
FROM   pos
WHERE  "prev_pos" IS NOT NULL
LIMIT 20;
```

```sql
-- 6. Description:  Still for that one driver, count how many places he gained (overtakes made)  
--    and lost (was overtaken) on track, excluding pit-stop laps.  
WITH pos AS (
    SELECT lp."race_id",
           lp."driver_id",
           lp."lap",
           lp."position",
           LAG(lp."position") OVER(PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_pos"
    FROM   "lap_positions" AS lp
    WHERE  lp."lap_type" = 'Race'
      AND  lp."driver_id" = 1
      AND  lp."lap" > 1
),
no_pit AS (
    SELECT p.*
    FROM   pos  AS p
    LEFT   JOIN "pit_stops" ps
           ON  ps."race_id"  = p."race_id"
           AND ps."driver_id"= p."driver_id"
           AND ps."lap"      = p."lap"
    WHERE  ps."lap" IS NULL
)
SELECT DISTINCT
       SUM(CASE WHEN "prev_pos" > "position" THEN "prev_pos"-"position" ELSE 0 END) AS "overtakes_made",
       SUM(CASE WHEN "prev_pos" < "position" THEN "position"-"prev_pos" ELSE 0 END) AS "overtakes_lost"
FROM   no_pit
LIMIT 20;
```

```sql
-- 7. Description:  Build the same logic for EVERY driver, already excluding pit-stops,  
--    first-lap changes, and laps after a retirement.  
WITH pos AS (
    SELECT lp."race_id",
           lp."driver_id",
           lp."lap",
           lp."position",
           LAG(lp."position") OVER(PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_pos"
    FROM   "lap_positions" AS lp
    WHERE  lp."lap_type" = 'Race'
      AND  lp."lap" > 1
),
no_pit AS (
    SELECT p.*
    FROM   pos AS p
    LEFT   JOIN "pit_stops" ps
           ON  ps."race_id"  = p."race_id"
           AND ps."driver_id"= p."driver_id"
           AND ps."lap"      = p."lap"
    WHERE  ps."lap" IS NULL
),
no_ret AS (
    SELECT np.*
    FROM   no_pit AS np
    LEFT   JOIN "retirements" rt
           ON  rt."race_id"   = np."race_id"
           AND rt."driver_id" = np."driver_id"
           AND np."lap"      >= rt."lap"          -- laps after retirement
    WHERE  rt."lap" IS NULL                      -- keep only laps before retirement
)
SELECT DISTINCT
       "driver_id",
       SUM(CASE WHEN "prev_pos" > "position" THEN "prev_pos"-"position" ELSE 0 END) AS "overtakes_made",
       SUM(CASE WHEN "prev_pos" < "position" THEN "position"-"prev_pos" ELSE 0 END) AS "overtakes_lost"
FROM   no_ret
GROUP  BY "driver_id"
LIMIT 20;
```

```sql
-- 8. Description:  Final answer – list the full names of drivers who have been overtaken  
--    MORE times than they have overtaken others, under the required exclusions.  
WITH pos AS (
    SELECT lp."race_id",
           lp."driver_id",
           lp."lap",
           lp."position",
           LAG(lp."position") OVER(PARTITION BY lp."race_id", lp."driver_id" ORDER BY lp."lap") AS "prev_pos"
    FROM   "lap_positions" AS lp
    WHERE  lp."lap_type" = 'Race'
      AND  lp."lap" > 1
),
no_pit AS (
    SELECT p.*
    FROM   pos AS p
    LEFT   JOIN "pit_stops" ps
           ON  ps."race_id"  = p."race_id"
           AND ps."driver_id"= p."driver_id"
           AND ps."lap"      = p."lap"
    WHERE  ps."lap" IS NULL
),
no_ret AS (
    SELECT np.*
    FROM   no_pit AS np
    LEFT   JOIN "retirements" rt
           ON  rt."race_id"   = np."race_id"
           AND rt."driver_id" = np."driver_id"
           AND np."lap"      >= rt."lap"
    WHERE  rt."lap" IS NULL
),
changes AS (
    SELECT
        "driver_id",
        SUM(CASE WHEN "prev_pos" > "position" THEN "prev_pos"-"position" ELSE 0 END) AS "overtakes_made",
        SUM(CASE WHEN "prev_pos" < "position" THEN "position"-"prev_pos" ELSE 0 END) AS "overtakes_lost"
    FROM   no_ret
    GROUP  BY "driver_id"
),
lose_more_than_gain AS (
    SELECT "driver_id"
    FROM   changes
    WHERE  "overtakes_lost" > "overtakes_made"
)
SELECT DISTINCT d."full_name"
FROM   lose_more_than_gain l
JOIN   "drivers_ext"        d ON d."driver_id" = l."driver_id"
ORDER  BY d."full_name"
LIMIT 20;
```
