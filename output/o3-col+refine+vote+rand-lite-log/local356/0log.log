Query:
-- 5. Description:  For one driver, show his lap-to-lap position change (ignoring grid/start lap).  
WITH pos AS (
    SELECT "race_id",
           "driver_id",
           "lap",
           "position",
           LAG("position") OVER(PARTITION BY "race_id","driver_id" ORDER BY "lap") AS "prev_pos"
    FROM   "lap_positions"
    WHERE  "lap_type"='Race'
      AND  "driver_id" = 1      -- sample driver
      AND  "lap" > 1            -- skip start lap
)
SELECT DISTINCT *
FROM   pos
WHERE  "prev_pos" IS NOT NULL
LIMIT 20;
