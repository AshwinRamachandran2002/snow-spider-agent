```sql
--Description: 5) Sample of lap-to-lap position changes for one race (lap n ➜ n+1).  
SELECT p1."race_id",
       p1."driver_id",
       p1."lap"        AS "lap_before",
       p1."position"   AS "pos_before",
       p2."lap"        AS "lap_after",
       p2."position"   AS "pos_after"
FROM   "lap_positions" AS p1
JOIN   "lap_positions" AS p2
       ON  p2."race_id"  = p1."race_id"
       AND p2."driver_id"= p1."driver_id"
       AND p2."lap"      = p1."lap" + 1
WHERE  p1."race_id" = 18
  AND  p1."lap_type" = 'Race'
  AND  p2."lap_type" = 'Race'
ORDER  BY p1."driver_id", p1."lap"
LIMIT 20;
```

```sql
--Description: 6) Count how many on-track overtakes (driver gained places) each driver made, 
--              excluding lap-1, pit-stop laps and retirement laps.
SELECT p1."driver_id",
       COUNT(*) AS "num_overtakes"
FROM   "lap_positions" AS p1
JOIN   "lap_positions" AS p2
       ON  p2."race_id"  = p1."race_id"
       AND p2."driver_id"= p1."driver_id"
       AND p2."lap"      = p1."lap" + 1
LEFT  JOIN "pit_stops"   AS ps
       ON  ps."race_id"  = p2."race_id"
       AND ps."driver_id"= p2."driver_id"
       AND ps."lap"      = p2."lap"
LEFT  JOIN "retirements" AS rt
       ON  rt."race_id"  = p2."race_id"
       AND rt."driver_id"= p2."driver_id"
       AND rt."lap"      = p2."lap"
WHERE  p1."lap_type" = 'Race'
  AND  p2."lap_type" = 'Race'
  AND  p1."lap"      > 0                 -- ignore start-lap changes
  AND  p2."position" < p1."position"     -- position gained  ⇒ overtake
  AND  ps."lap"      IS NULL             -- exclude pit-stop lap
  AND  rt."lap"      IS NULL             -- exclude retirement lap
GROUP BY p1."driver_id"
LIMIT 20;
```

```sql
--Description: 7) Count how many times each driver was overtaken (lost places) under the same rules.  
SELECT p1."driver_id",
       COUNT(*) AS "num_overtaken"
FROM   "lap_positions" AS p1
JOIN   "lap_positions" AS p2
       ON  p2."race_id"  = p1."race_id"
       AND p2."driver_id"= p1."driver_id"
       AND p2."lap"      = p1."lap" + 1
LEFT  JOIN "pit_stops"   AS ps
       ON  ps."race_id"  = p2."race_id"
       AND ps."driver_id"= p2."driver_id"
       AND ps."lap"      = p2."lap"
LEFT  JOIN "retirements" AS rt
       ON  rt."race_id"  = p2."race_id"
       AND rt."driver_id"= p2."driver_id"
       AND rt."lap"      = p2."lap"
WHERE  p1."lap_type" = 'Race'
  AND  p2."lap_type" = 'Race'
  AND  p1."lap"      > 0
  AND  p2."position" > p1."position"     -- position lost ⇒ was overtaken
  AND  ps."lap"      IS NULL
  AND  rt."lap"      IS NULL
GROUP BY p1."driver_id"
LIMIT 20;
```

```sql
--Description: 8) Combine the two previous summaries to get a net balance (lost minus gained).  
WITH overtakes AS (
     SELECT p1."driver_id",
            COUNT(*) AS "gained"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"  = p1."race_id"
            AND p2."driver_id"= p1."driver_id"
            AND p2."lap"      = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"  = p2."race_id"
            AND ps."driver_id"= p2."driver_id"
            AND ps."lap"      = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"  = p2."race_id"
            AND rt."driver_id"= p2."driver_id"
            AND rt."lap"      = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" < p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
), overtaken AS (
     SELECT p1."driver_id",
            COUNT(*) AS "lost"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"  = p1."race_id"
            AND p2."driver_id"= p1."driver_id"
            AND p2."lap"      = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"  = p2."race_id"
            AND ps."driver_id"= p2."driver_id"
            AND ps."lap"      = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"  = p2."race_id"
            AND rt."driver_id"= p2."driver_id"
            AND rt."lap"      = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" > p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
)
SELECT d."driver_id",
       COALESCE(overtaken."lost",     0) AS "lost_places",
       COALESCE(overtakes."gained",   0) AS "gained_places",
       COALESCE(overtaken."lost", 0) 
       - COALESCE(overtakes."gained",0) AS "net_loss"
FROM   "drivers" AS d
LEFT  JOIN overtakes ON overtakes."driver_id" = d."driver_id"
LEFT  JOIN overtaken ON overtaken."driver_id" = d."driver_id"
ORDER  BY "net_loss" DESC
LIMIT 20;
```

```sql
--Description: 9) Keep only drivers whose net balance is negative 
--              (they lost more positions than they gained).  
WITH overtakes AS (
     SELECT p1."driver_id",
            COUNT(*) AS "gained"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"  = p1."race_id"
            AND p2."driver_id"= p1."driver_id"
            AND p2."lap"      = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"  = p2."race_id"
            AND ps."driver_id"= p2."driver_id"
            AND ps."lap"      = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"  = p2."race_id"
            AND rt."driver_id"= p2."driver_id"
            AND rt."lap"      = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" < p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
), overtaken AS (
     SELECT p1."driver_id",
            COUNT(*) AS "lost"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"  = p1."race_id"
            AND p2."driver_id"= p1."driver_id"
            AND p2."lap"      = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"  = p2."race_id"
            AND ps."driver_id"= p2."driver_id"
            AND ps."lap"      = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"  = p2."race_id"
            AND rt."driver_id"= p2."driver_id"
            AND rt."lap"      = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" > p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
)
SELECT d."driver_id",
       COALESCE(overtaken."lost", 0)  AS "lost_places",
       COALESCE(overtakes."gained",0) AS "gained_places"
FROM   "drivers" AS d
LEFT  JOIN overtakes ON overtakes."driver_id" = d."driver_id"
LEFT  JOIN overtaken ON overtaken."driver_id" = d."driver_id"
WHERE  COALESCE(overtaken."lost",0) > COALESCE(overtakes."gained",0)
LIMIT 20;
```

```sql
--Description: 10) List the full names of those drivers (final answer).  
WITH overtakes AS (
     SELECT p1."driver_id",
            COUNT(*) AS "gained"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"  = p1."race_id"
            AND p2."driver_id"= p1."driver_id"
            AND p2."lap"      = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"  = p2."race_id"
            AND ps."driver_id"= p2."driver_id"
            AND ps."lap"      = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"  = p2."race_id"
            AND rt."driver_id"= p2."driver_id"
            AND rt."lap"      = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" < p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
), overtaken AS (
     SELECT p1."driver_id",
            COUNT(*) AS "lost"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"  = p1."race_id"
            AND p2."driver_id"= p1."driver_id"
            AND p2."lap"      = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"  = p2."race_id"
            AND ps."driver_id"= p2."driver_id"
            AND ps."lap"      = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"  = p2."race_id"
            AND rt."driver_id"= p2."driver_id"
            AND rt."lap"      = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" > p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
)
SELECT DISTINCT (d."forename" || ' ' || d."surname") AS "full_name"
FROM   "drivers" AS d
LEFT  JOIN overtakes ON overtakes."driver_id" = d."driver_id"
LEFT  JOIN overtaken ON overtaken."driver_id" = d."driver_id"
WHERE  COALESCE(overtaken."lost",0) > COALESCE(overtakes."gained",0)
ORDER  BY "full_name"
LIMIT 20;
```
