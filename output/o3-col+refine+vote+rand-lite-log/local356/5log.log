Query:
--Description: 10) List the full names of drivers who were overtaken more times
--              than they overtook others during race laps (final answer).
WITH overtakes AS (
     SELECT p1."driver_id",
            COUNT(*) AS "gained"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"   = p1."race_id"
            AND p2."driver_id" = p1."driver_id"
            AND p2."lap"       = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"   = p2."race_id"
            AND ps."driver_id" = p2."driver_id"
            AND ps."lap"       = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"   = p2."race_id"
            AND rt."driver_id" = p2."driver_id"
            AND rt."lap"       = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" < p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
), overtaken AS (
     SELECT p1."driver_id",
            COUNT(*) AS "lost"
     FROM   "lap_positions" AS p1
     JOIN   "lap_positions" AS p2
            ON  p2."race_id"   = p1."race_id"
            AND p2."driver_id" = p1."driver_id"
            AND p2."lap"       = p1."lap" + 1
     LEFT  JOIN "pit_stops" AS ps
            ON  ps."race_id"   = p2."race_id"
            AND ps."driver_id" = p2."driver_id"
            AND ps."lap"       = p2."lap"
     LEFT  JOIN "retirements" AS rt
            ON  rt."race_id"   = p2."race_id"
            AND rt."driver_id" = p2."driver_id"
            AND rt."lap"       = p2."lap"
     WHERE  p1."lap_type"='Race'
       AND  p2."lap_type"='Race'
       AND  p1."lap"    > 0
       AND  p2."position" > p1."position"
       AND  ps."lap"    IS NULL
       AND  rt."lap"    IS NULL
     GROUP BY p1."driver_id"
)
SELECT DISTINCT (d."forename" || ' ' || d."surname") AS "full_name"
FROM   "drivers" AS d
LEFT  JOIN overtakes ON overtakes."driver_id" = d."driver_id"
LEFT  JOIN overtaken ON overtaken."driver_id" = d."driver_id"
WHERE  COALESCE(overtaken."lost",0) > COALESCE(overtakes."gained",0)
ORDER  BY "full_name"
LIMIT 20
