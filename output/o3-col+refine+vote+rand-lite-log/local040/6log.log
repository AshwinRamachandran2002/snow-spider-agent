-- Description: Return the three boroughs containing the greatest number of trees, together with the tree-count
--              and the average mean income (rounded) for those boroughs.  Steps:
--   1. Join the trees file to the income file on ZIP code.
--   2. Keep only rows whose median and mean incomes are both positive.
--   3. Group by borough to compute:  (a) COUNT(*) = trees per borough, (b) AVG(mean income).
--   4. Sort by tree count in descending order and keep the top three.
SELECT   t."boroname"                             AS borough,
         COUNT(*)                                 AS number_of_trees,
         ROUND(AVG(i."Estimate_Mean_income"), 0)  AS average_mean_income
FROM     "trees"        AS t
JOIN     "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE    i."Estimate_Median_income" > 0
  AND    i."Estimate_Mean_income"  > 0
  AND    t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY number_of_trees DESC
LIMIT 3;
```
