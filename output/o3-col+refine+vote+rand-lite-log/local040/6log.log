Query:
-- Description: 7) Rank boroughs by tree count (using a sub-query with ROW_NUMBER)
SELECT  *
FROM (
        SELECT   t."boroname",
                 COUNT(*)                      AS "tree_count",
                 AVG(i."Estimate_Mean_income") AS "avg_mean_income",
                 ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rnk
        FROM     "trees" AS t
        JOIN     "income_trees" AS i
                 ON t."zipcode" = i."zipcode"
        WHERE    i."Estimate_Median_income" > 0
          AND    i."Estimate_Mean_income"  > 0
          AND    t."boroname" IS NOT NULL
        GROUP BY t."boroname"
     ) AS q
WHERE   rnk <= 3;
Answer:
boroname,tree_count,avg_mean_income,rnk
Queens,256056,79312.57225763114,1
Brooklyn,184711,73675.97696942792,2
Staten Island,106374,94029.32783386917,3
