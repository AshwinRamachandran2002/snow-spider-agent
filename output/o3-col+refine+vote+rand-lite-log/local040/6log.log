```sql
-- Description / Thinking process:
-- 1. Join “trees” with “income_trees” on the common ZIP code so each tree inherits its ZIP-level income statistics.
-- 2. Require both median and mean income to be positive to ensure valid income data.
-- 3. Require a non-NULL borough name.
-- 4. Aggregate by borough:   • COUNT(*)  → total number of trees
--                            • AVG(mean income) → average mean income across all ZIPs that host those trees
-- 5. Sort the boroughs by tree count in descending order and keep the top three, which are the boroughs
--    containing the most trees.
SELECT   t."boroname"                            AS borough,
         COUNT(*)                                AS tree_count,
         ROUND(AVG(i."Estimate_Mean_income"),2)  AS avg_mean_income
FROM     "trees"        AS t
JOIN     "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE    i."Estimate_Median_income" > 0
  AND    i."Estimate_Mean_income"  > 0
  AND    t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY tree_count DESC
LIMIT 3;
```
