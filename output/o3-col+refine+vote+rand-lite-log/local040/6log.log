```sql
-- Description: 5) Join one tree sample to its income to verify the join logic
SELECT t."tree_id",
       t."boroname",
       t."zipcode",
       i."Estimate_Median_income",
       i."Estimate_Mean_income"
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
  AND  t."boroname" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 6) Aggregate – count the number of trees and average the mean income per borough
SELECT   t."boroname",
         COUNT(*)                          AS "tree_count",
         AVG(i."Estimate_Mean_income")     AS "avg_mean_income"
FROM     "trees" AS t
JOIN     "income_trees" AS i
         ON t."zipcode" = i."zipcode"
WHERE    i."Estimate_Median_income" > 0
  AND    i."Estimate_Mean_income"  > 0
  AND    t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
```

```sql
-- Description: 7) Rank boroughs by tree count (using a sub-query with ROW_NUMBER)
SELECT  *
FROM (
        SELECT   t."boroname",
                 COUNT(*)                      AS "tree_count",
                 AVG(i."Estimate_Mean_income") AS "avg_mean_income",
                 ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rnk
        FROM     "trees" AS t
        JOIN     "income_trees" AS i
                 ON t."zipcode" = i."zipcode"
        WHERE    i."Estimate_Median_income" > 0
          AND    i."Estimate_Mean_income"  > 0
          AND    t."boroname" IS NOT NULL
        GROUP BY t."boroname"
     ) AS q
WHERE   rnk <= 3;
```

