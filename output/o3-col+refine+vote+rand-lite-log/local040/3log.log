```sql
-- Description: Inspect a sample of borough names and ZIP codes from the trees table
SELECT "boroname", "zipcode"
FROM "trees"
LIMIT 20;
```

```sql
-- Description: List the distinct borough names present in the trees data
SELECT DISTINCT "boroname"
FROM "trees"
LIMIT 20;
```

```sql
-- Description: Preview the income data (total, median, and mean income) by ZIP code
SELECT *
FROM "income_trees"
LIMIT 20;
```

```sql
-- Description: Check how many trees have NULL or zero ZIP codes
SELECT 
    SUM(CASE WHEN "zipcode" IS NULL THEN 1 ELSE 0 END)  AS null_zip,
    SUM(CASE WHEN "zipcode" = 0    THEN 1 ELSE 0 END)  AS zero_zip,
    COUNT(*)                                            AS total_trees
FROM "trees";
```

```sql
-- Description: Preview the merged tree-and-income records after joining on ZIP code
SELECT
    t."boroname",
    t."zipcode",
    i."Estimate_Median_income",
    i."Estimate_Mean_income"
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
LIMIT 20;
```

```sql
-- Description: Count of trees per borough (restricting to positive median & mean income)
SELECT
    t."boroname",
    COUNT(*) AS tree_count
FROM "trees"  AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
WHERE i."Estimate_Median_income" > 0
  AND i."Estimate_Mean_income"  > 0
  AND t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY tree_count DESC
LIMIT 20;
```

```sql
-- Description: Average mean income per borough with the same positive-income filter
SELECT
    t."boroname",
    AVG(i."Estimate_Mean_income") AS avg_mean_income
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
WHERE i."Estimate_Median_income" > 0
  AND i."Estimate_Mean_income"  > 0
  AND t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
```

```sql
-- Description: Top three boroughs with the most trees (positive income only) 
--              and their average mean income
SELECT
    t."boroname",
    COUNT(*)                        AS tree_count,
    AVG(i."Estimate_Mean_income")   AS avg_mean_income
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
WHERE i."Estimate_Median_income" > 0
  AND i."Estimate_Mean_income"  > 0
  AND t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY tree_count DESC
LIMIT 3;
```
