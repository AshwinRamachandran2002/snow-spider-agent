```sql
-- Description: Inspect borough names and ZIP codes in the trees table
SELECT DISTINCT "boroname", "zipcode"
FROM "trees"
WHERE "boroname" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Inspect income figures for the same ZIP codes in income_trees
SELECT DISTINCT "zipcode", "Estimate_Median_income", "Estimate_Mean_income"
FROM "income_trees"
LIMIT 20;
```

```sql
-- Description: Preview the joined dataset of trees with income information by ZIP
SELECT t."boroname",
       t."zipcode",
       i."Estimate_Median_income",
       i."Estimate_Mean_income"
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
LIMIT 20;
```

```sql
-- Description: Check rows whose median and mean income are both greater than zero and have a valid borough name
SELECT t."boroname",
       COUNT(*) AS tree_cnt
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
```

```sql
-- Description: Rank boroughs by the number of trees using the same restrictions
SELECT t."boroname",
       COUNT(*) AS tree_cnt
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY tree_cnt DESC
LIMIT 5;
```

```sql
-- Description: Compute the average mean income for each borough (restricted rows)
SELECT t."boroname",
       ROUND(AVG(i."Estimate_Mean_income"), 2) AS avg_mean_income
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
```

```sql
-- Description: Combine tree counts and average mean income, order by trees, keep top-3 boroughs
SELECT t."boroname",
       COUNT(*)                         AS tree_cnt,
       ROUND(AVG(i."Estimate_Mean_income"), 2) AS avg_mean_income
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY tree_cnt DESC
LIMIT 3;
```

```sql
-- Description: Final answer – only the three boroughs with most trees and their average mean income
SELECT t."boroname"                                AS borough,
       ROUND(AVG(i."Estimate_Mean_income"), 2)     AS avg_mean_income
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY COUNT(*) DESC
LIMIT 3;
```

```sql
-- Description: (Optional) Show exact tree count next to the average mean income for the top-3 boroughs
SELECT t."boroname"                                AS borough,
       COUNT(*)                                    AS tree_count,
       ROUND(AVG(i."Estimate_Mean_income"), 2)     AS avg_mean_income
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY tree_count DESC
LIMIT 3;
```
