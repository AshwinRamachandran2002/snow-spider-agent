Query:
-- Description: Check rows whose median and mean income are both greater than zero and have a valid borough name
SELECT t."boroname",
       COUNT(*) AS tree_cnt
FROM   "trees" AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"   > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
