```sql
-- 1. List all distinct borough names present in the trees table
SELECT DISTINCT boroname
FROM trees
LIMIT 20;
```

```sql
-- 2. Inspect a handful of rows in trees that do NOT have a zipcode
SELECT *
FROM trees
WHERE zipcode IS NULL
LIMIT 20;
```

```sql
-- 3. See which boroughs have the most trees overall (no income join yet)
SELECT boroname,
       COUNT(*) AS tree_count
FROM trees
GROUP BY boroname
ORDER BY tree_count DESC
LIMIT 10;
```

```sql
-- 4. Quick look at the income table’s basic columns
SELECT DISTINCT zipcode,
       Estimate_Median_income,
       Estimate_Mean_income
FROM income_trees
LIMIT 20;
```

```sql
-- 5. Count trees by borough after joining to income data
--    and keeping only records with median & mean income > 0
SELECT t.boroname,
       COUNT(*) AS tree_count
FROM trees AS t
JOIN income_trees AS i
  ON t.zipcode = i.zipcode
WHERE i.Estimate_Median_income > 0
  AND i.Estimate_Mean_income  > 0
  AND t.boroname IS NOT NULL
GROUP BY t.boroname
ORDER BY tree_count DESC
LIMIT 10;
```

```sql
-- 6. For one borough (e.g., Brooklyn) preview zip-level mean incomes
SELECT t.boroname,
       i.zipcode,
       i.Estimate_Mean_income
FROM trees AS t
JOIN income_trees AS i
  ON t.zipcode = i.zipcode
WHERE t.boroname = 'Brooklyn'
LIMIT 20;
```

```sql
-- 7. Calculate the average mean income per borough
--    (still with the income filters) to compare with tree counts
SELECT t.boroname,
       ROUND(AVG(i.Estimate_Mean_income), 2) AS avg_mean_income,
       COUNT(*) AS tree_count
FROM trees AS t
JOIN income_trees AS i
  ON t.zipcode = i.zipcode
WHERE i.Estimate_Median_income > 0
  AND i.Estimate_Mean_income  > 0
  AND t.boroname IS NOT NULL
GROUP BY t.boroname
ORDER BY tree_count DESC
LIMIT 10;
```

```sql
-- 8. FINAL ANSWER:
--    Top 3 boroughs by number of trees, plus their average mean income
SELECT t.boroname AS borough,
       COUNT(*)   AS number_of_trees,
       ROUND(AVG(i.Estimate_Mean_income), 2) AS average_mean_income
FROM trees AS t
JOIN income_trees AS i
  ON t.zipcode = i.zipcode
WHERE i.Estimate_Median_income > 0
  AND i.Estimate_Mean_income  > 0
  AND t.boroname IS NOT NULL
GROUP BY t.boroname
ORDER BY number_of_trees DESC
LIMIT 3;
```
