Query:
--Description: Compute the average mean income for each borough (with valid income data)
--and list the tree counts to compare wealth and tree distribution.
SELECT t.boroname,
       ROUND(AVG(i.Estimate_Mean_income), 2) AS avg_mean_income,
       COUNT(*) AS tree_count
FROM trees AS t
JOIN income_trees AS i
  ON t.zipcode = i.zipcode
WHERE i.Estimate_Median_income > 0
  AND i.Estimate_Mean_income  > 0
  AND t.boroname IS NOT NULL
GROUP BY t.boroname
ORDER BY tree_count DESC
LIMIT 10
