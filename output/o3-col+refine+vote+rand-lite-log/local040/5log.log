```sql
-- 4. Description:  Join trees with income data by ZIP code to see sample combined rows, 
--                 keeping only rows that have both mean and median income figures.
SELECT  t."tree_id",
        t."zipcode",
        t."boroname",
        i."Estimate_Mean_income",
        i."Estimate_Median_income"
FROM    "trees"  AS t
JOIN    "income_trees" AS i
  ON    t."zipcode" = i."zipcode"
WHERE   i."Estimate_Mean_income"   > 0
  AND   i."Estimate_Median_income" > 0
  AND   t."boroname" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Description:  Count how many trees per borough satisfy the income filter.
SELECT  t."boroname",
        COUNT(*) AS "tree_cnt"
FROM    "trees"  AS t
JOIN    "income_trees" AS i
  ON    t."zipcode" = i."zipcode"
WHERE   i."Estimate_Mean_income"   > 0
  AND   i."Estimate_Median_income" > 0
  AND   t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
```

```sql
-- 6. Description:  Same as #5 but ordered from the highest‐tree borough downward.
SELECT  t."boroname",
        COUNT(*) AS "tree_cnt"
FROM    "trees"  AS t
JOIN    "income_trees" AS i
  ON    t."zipcode" = i."zipcode"
WHERE   i."Estimate_Mean_income"   > 0
  AND   i."Estimate_Median_income" > 0
  AND   t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY COUNT(*) DESC
LIMIT 20;
```

```sql
-- 7. Description:  Compute both the tree count and the average mean income per borough.
SELECT  t."boroname",
        COUNT(*)                              AS "tree_cnt",
        AVG(i."Estimate_Mean_income")         AS "avg_mean_income"
FROM    "trees"  AS t
JOIN    "income_trees" AS i
  ON    t."zipcode" = i."zipcode"
WHERE   i."Estimate_Mean_income"   > 0
  AND   i."Estimate_Median_income" > 0
  AND   t."boroname" IS NOT NULL
GROUP BY t."boroname"
LIMIT 20;
```

```sql
-- 8. Description:  Order boroughs by average mean income (descending) while keeping the filters.
SELECT  t."boroname",
        COUNT(*)                      AS "tree_cnt",
        AVG(i."Estimate_Mean_income") AS "avg_mean_income"
FROM    "trees" AS t
JOIN    "income_trees" AS i
  ON    t."zipcode" = i."zipcode"
WHERE   i."Estimate_Mean_income"   > 0
  AND   i."Estimate_Median_income" > 0
  AND   t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "avg_mean_income" DESC
LIMIT 20;
```

```sql
-- 9. Description:  Retrieve the three boroughs with the greatest number of trees after the join and filters.
SELECT  t."boroname",
        COUNT(*) AS "tree_cnt"
FROM    "trees"  AS t
JOIN    "income_trees" AS i
  ON    t."zipcode" = i."zipcode"
WHERE   i."Estimate_Mean_income"   > 0
  AND   i."Estimate_Median_income" > 0
  AND   t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "tree_cnt" DESC
LIMIT 3;
```

```sql
-- 10. Description:  Final answer – for the top three boroughs (by tree count) show their average mean income.
WITH ranked AS (
    SELECT  t."boroname",
            COUNT(*)                      AS "tree_cnt",
            AVG(i."Estimate_Mean_income") AS "avg_mean_income",
            ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
    FROM    "trees"  AS t
    JOIN    "income_trees" AS i
      ON    t."zipcode" = i."zipcode"
    WHERE   i."Estimate_Mean_income"   > 0
      AND   i."Estimate_Median_income" > 0
      AND   t."boroname" IS NOT NULL
    GROUP BY t."boroname"
)
SELECT  "boroname",
        "avg_mean_income"
FROM    ranked
WHERE   rn <= 3
ORDER BY rn;
```
