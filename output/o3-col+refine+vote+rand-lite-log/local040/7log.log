```sql
-- 1. Description: View the list of borough names recorded in the tree inventory
SELECT DISTINCT "boroname"
FROM "trees"
LIMIT 20;
```

```sql
-- 2. Description: Check how many tree records have a valid ZIP Code
SELECT COUNT(*) AS "trees_with_zip"
FROM "trees"
WHERE "zipcode" IS NOT NULL;
```

```sql
-- 3. Description: Inspect ZIP codes available in the household-income table
SELECT DISTINCT "zipcode"
FROM "income_trees"
LIMIT 20;
```

```sql
-- 4. Description: Preview a few rows of the joined data (tree + income) to be sure the ZIP merge works
SELECT t."boroname",
       t."zipcode",
       i."Estimate_Median_income",
       i."Estimate_Mean_income"
FROM   "trees"  AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
  AND  t."boroname" IS NOT NULL
LIMIT 20;
```

```sql
-- 5. Description: Count how many trees are matched with income data for each borough
SELECT t."boroname",
       COUNT(*) AS "matched_tree_count"
FROM   "trees"  AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
GROUP BY t."boroname"
ORDER BY "matched_tree_count" DESC
LIMIT 10;
```

```sql
-- 6. Description: Calculate the average of mean household income per borough (using only valid-income records)
SELECT t."boroname",
       AVG(i."Estimate_Mean_income") AS "avg_mean_income"
FROM   "trees"  AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "avg_mean_income" DESC
LIMIT 10;
```

```sql
-- 7. Description: Produce one result set that simultaneously shows tree count and average mean income, then pick the top-3 boroughs by tree count
SELECT t."boroname",
       COUNT(*)                                     AS "tree_count",
       ROUND(AVG(i."Estimate_Mean_income"), 0)      AS "avg_mean_income"
FROM   "trees"  AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "tree_count" DESC
LIMIT 3;
```

```sql
-- 8. Description: Break down the previous query to see contribution by ZIP within each of the top-3 boroughs (sub-query points to those boroughs)
WITH top3 AS (
    SELECT t."boroname"
    FROM   "trees" t
    JOIN   "income_trees" i
           ON t."zipcode" = i."zipcode"
    WHERE  i."Estimate_Median_income" > 0
      AND  i."Estimate_Mean_income"  > 0
      AND  t."boroname" IS NOT NULL
    GROUP BY t."boroname"
    ORDER BY COUNT(*) DESC
    LIMIT 3
)
SELECT t."boroname",
       t."zipcode",
       COUNT(*)                        AS "trees_in_zip",
       ROUND(AVG(i."Estimate_Mean_income"), 0) AS "avg_mean_income_zip"
FROM   "trees" t
JOIN   "income_trees" i
       ON t."zipcode" = i."zipcode"
JOIN   top3
       USING("boroname")
GROUP BY t."boroname", t."zipcode"
ORDER BY t."boroname", "trees_in_zip" DESC
LIMIT 20;
```

```sql
-- 9. Description: Verify that there are no duplicated tree IDs within our joined sample (data-quality check)
SELECT COUNT(DISTINCT t."tree_id") AS "distinct_tree_ids",
       COUNT(*)                    AS "rows_after_join"
FROM   "trees" t
JOIN   "income_trees" i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
  AND  t."boroname" IS NOT NULL;
```

```sql
-- 10. Description: (Final result) Re-run the top-3 borough summary, explicitly aliasing fields for easy reading
SELECT t."boroname"                          AS "borough",
       COUNT(*)                              AS "number_of_trees",
       ROUND(AVG(i."Estimate_Mean_income"),0) AS "average_mean_income"
FROM   "trees"  AS t
JOIN   "income_trees" AS i
       ON t."zipcode" = i."zipcode"
WHERE  i."Estimate_Median_income" > 0
  AND  i."Estimate_Mean_income"  > 0
  AND  t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "number_of_trees" DESC
LIMIT 3;
```
