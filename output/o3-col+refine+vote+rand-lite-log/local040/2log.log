```sql
-- Description: Inspect some tree records together with their borough and ZIP code
SELECT "boroname", "zipcode", "spc_common"
FROM "trees"
LIMIT 20;
```

```sql
-- Description: Inspect several rows from the income table to see income numbers by ZIP code
SELECT "zipcode", "Estimate_Median_income", "Estimate_Mean_income"
FROM "income_trees"
LIMIT 20;
```

```sql
-- Description: List all distinct borough names that appear in the trees table
SELECT DISTINCT "boroname"
FROM "trees";
```

```sql
-- Description: Count how many tree records have a NULL or 0 ZIP code (needed for later join quality)
SELECT COUNT(*) AS "trees_with_missing_zip"
FROM "trees"
WHERE "zipcode" IS NULL
   OR "zipcode" = 0;
```

```sql
-- Description: Preview the join between trees and income tables on ZIP code
SELECT t."boroname", t."zipcode", i."Estimate_Mean_income", i."Estimate_Median_income"
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
LIMIT 20;
```

```sql
-- Description: Count trees per borough after joining with income, keeping only rows where both median and mean income are > 0
SELECT t."boroname",
       COUNT(*) AS "tree_count"
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
WHERE i."Estimate_Median_income" > 0
  AND i."Estimate_Mean_income"  > 0
  AND t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "tree_count" DESC
LIMIT 10;
```

```sql
-- Description: Compute the average of mean income for each borough under the same filters
SELECT t."boroname",
       AVG(i."Estimate_Mean_income") AS "avg_mean_income"
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
WHERE i."Estimate_Median_income" > 0
  AND i."Estimate_Mean_income"  > 0
  AND t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "avg_mean_income" DESC
LIMIT 10;
```

```sql
-- Description: Final answer – the three boroughs with the most trees (under income filters) and their average mean income
SELECT t."boroname",
       COUNT(*)                       AS "tree_count",
       AVG(i."Estimate_Mean_income")  AS "avg_mean_income"
FROM "trees" AS t
JOIN "income_trees" AS i
  ON t."zipcode" = i."zipcode"
WHERE i."Estimate_Median_income" > 0
  AND i."Estimate_Mean_income"  > 0
  AND t."boroname" IS NOT NULL
GROUP BY t."boroname"
ORDER BY "tree_count" DESC
LIMIT 3;
```
