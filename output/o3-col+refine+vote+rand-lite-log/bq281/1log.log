Query:
--Description: 7) Compute, for each day, the number of electric-bike rides (>10 min) by 'Student Membership' users,
--               excluding rides that start OR end at 'Mobile Station' or 'Repair Shop'.
SELECT
  DATE(`start_time`) AS ride_date,
  COUNT(*)           AS rides_over_10min
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE `bike_type` = 'electric'                           -- electric bikes
  AND `duration_minutes` > 10                            -- longer than 10 minutes
  AND `subscriber_type` = 'Student Membership'
  AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
  AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
  AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
  AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
GROUP BY ride_date
ORDER BY rides_over_10min DESC
LIMIT 20
Answer:
ride_date,rides_over_10min
2023-10-13,201
2023-10-07,193
2023-10-14,193
2023-10-28,191
2023-10-06,186
2023-10-15,186
2022-10-14,181
2023-12-09,178
Query:
--Description: 8) Pull only the highest single-day ride count from the aggregation above.
SELECT
  MAX(rides_over_10min) AS max_daily_student_electric_rides
FROM (
  SELECT
    DATE(`start_time`) AS ride_date,
    COUNT(*) AS rides_over_10min
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE `bike_type` = 'electric'
    AND `duration_minutes` > 10
    AND `subscriber_type` = 'Student Membership'
    AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
    AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
    AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
    AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
  GROUP BY ride_date
)
LIMIT 20
Answer:
max_daily_student_electric_rides
201
Query:
--Description: 9) Return the date and count of the single day with the most qualifying rides.
SELECT
  ride_date,
  rides_over_10min AS max_rides_that_day
FROM (
  SELECT
    DATE(`start_time`) AS ride_date,
    COUNT(*) AS rides_over_10min,
    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE `bike_type` = 'electric'
    AND `duration_minutes` > 10
    AND `subscriber_type` = 'Student Membership'
    AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
    AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
    AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
    AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
  GROUP BY ride_date
)
WHERE rn = 1
LIMIT 20
Answer:
ride_date,max_rides_that_day
2023-10-13,201
Query:
--Description: 10) Show yearly distribution of such rides for extra context.
SELECT
  EXTRACT(YEAR FROM `start_time`) AS ride_year,
  COUNT(*)                        AS total_qualifying_rides
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE `bike_type` = 'electric'
  AND `duration_minutes` > 10
  AND `subscriber_type` = 'Student Membership'
  AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
  AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
  AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
  AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
GROUP BY ride_year
ORDER BY ride_year
LIMIT 20
