```sql
--Description: 1) Look at the different kinds of bikes recorded in the trips table.  
SELECT DISTINCT `bike_type`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
LIMIT 20;
```

```sql
--Description: 2) Inspect a handful of electric-bike (“ebike”) trips to confirm column contents.  
SELECT *
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`bike_type`) LIKE '%ebike%'
LIMIT 20;
```

```sql
--Description: 3) Find every subscriber category that uses the system.  
SELECT DISTINCT `subscriber_type`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
LIMIT 20;
```

```sql
--Description: 4) Quickly sample trips taken with the 'Student Membership' subscriber type.  
SELECT *
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE `subscriber_type` = 'Student Membership'
LIMIT 20;
```

```sql
--Description: 5) Verify whether start/end stations ever contain 'Mobile Station' or 'Repair Shop'.  
SELECT DISTINCT `start_station_name`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`start_station_name`) LIKE '%mobile station%'
   OR LOWER(`start_station_name`) LIKE '%repair shop%'
LIMIT 20;
```

```sql
--Description: 6) The same check for end-station names.  
SELECT DISTINCT `end_station_name`
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`end_station_name`) LIKE '%mobile station%'
   OR LOWER(`end_station_name`) LIKE '%repair shop%'
LIMIT 20;
```

```sql
--Description: 7) Compute, for each day, the number of electric-bike rides longer than 10 minutes 
--   by 'Student Membership' users, excluding rides that start OR end at the two unwanted station types.  
SELECT
  DATE(`start_time`) AS ride_date,
  COUNT(*)             AS rides_over_10min
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`bike_type`) LIKE '%ebike%'                     -- electric bikes
  AND `duration_minutes` > 10                               -- longer than 10 minutes
  AND `subscriber_type` = 'Student Membership'              -- correct subscriber
  AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
  AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
  AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
  AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
GROUP BY ride_date
ORDER BY rides_over_10min DESC
LIMIT 20;
```

```sql
--Description: 8) Pull only the highest single-day ride count from the aggregation above.  
SELECT
  MAX(rides_over_10min) AS max_daily_student_ebike_rides
FROM (
  SELECT
    DATE(`start_time`) AS ride_date,
    COUNT(*) AS rides_over_10min
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE LOWER(`bike_type`) LIKE '%ebike%'
    AND `duration_minutes` > 10
    AND `subscriber_type` = 'Student Membership'
    AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
    AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
    AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
    AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
  GROUP BY ride_date
)
LIMIT 20;
```

```sql
--Description: 9) If you also want to know *which* day had that record, return both date and count.  
SELECT
  ride_date,
  rides_over_10min AS max_rides_that_day
FROM (
  SELECT
    DATE(`start_time`) AS ride_date,
    COUNT(*) AS rides_over_10min,
    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
  FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
  WHERE LOWER(`bike_type`) LIKE '%ebike%'
    AND `duration_minutes` > 10
    AND `subscriber_type` = 'Student Membership'
    AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
    AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
    AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
    AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
  GROUP BY ride_date
)
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 10) (Optional) Show yearly distribution of such rides for extra context.  
SELECT
  EXTRACT(YEAR FROM `start_time`) AS ride_year,
  COUNT(*)                        AS total_qualifying_rides
FROM `bigquery-public-data.austin_bikeshare.bikeshare_trips`
WHERE LOWER(`bike_type`) LIKE '%ebike%'
  AND `duration_minutes` > 10
  AND `subscriber_type` = 'Student Membership'
  AND LOWER(`start_station_name`) NOT LIKE '%mobile station%'
  AND LOWER(`end_station_name`)   NOT LIKE '%mobile station%'
  AND LOWER(`start_station_name`) NOT LIKE '%repair shop%'
  AND LOWER(`end_station_name`)   NOT LIKE '%repair shop%'
GROUP BY ride_year
ORDER BY ride_year
LIMIT 20;
```
