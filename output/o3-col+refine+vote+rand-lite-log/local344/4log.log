```sql
-- 1) Races for which pit-stop information exists
SELECT DISTINCT ps."race_id",
                r."year",
                r."round",
                r."name"
FROM   "pit_stops" AS ps
JOIN   "races"      AS r USING ("race_id")
ORDER  BY r."year", r."round"
LIMIT 20;
```

```sql
-- 2) How many pit-stops were recorded in each of those races
SELECT ps."race_id",
       COUNT(*) AS "nbr_stops"
FROM   "pit_stops" AS ps
GROUP  BY ps."race_id"
ORDER  BY "nbr_stops" DESC
LIMIT 20;
```

```sql
-- 3) Different kinds of lap_position entries that can appear
SELECT DISTINCT "lap_type"
FROM   "lap_positions"
LIMIT 20;
```

```sql
-- 4) Sample of lap-by-lap positions for one pit-stop race (first one found)
SELECT lp.*
FROM   "lap_positions" AS lp
WHERE  lp."race_id" = (SELECT MIN("race_id") FROM "pit_stops")
ORDER  BY lp."lap", lp."position"
LIMIT 20;
```

```sql
-- 5) Retirements that happened in races with pit-stop data
SELECT rt.*
FROM   "retirements" AS rt
WHERE  rt."race_id" IN (SELECT DISTINCT "race_id" FROM "pit_stops")
ORDER  BY rt."race_id", rt."lap"
LIMIT 20;
```

```sql
-- 6) Full list of status descriptions (helps classifying retirements vs. finishes)
SELECT DISTINCT "status_id", "status"
FROM   "status"
ORDER  BY "status_id"
LIMIT 20;
```

```sql
-- 7) Lap-by-lap position trace for a driver that made a pit-stop (driver 153 in race 841)
SELECT lp.*
FROM   "lap_positions" AS lp
WHERE  lp."race_id" = 841
  AND  lp."driver_id" = 153
ORDER  BY lp."lap"
LIMIT 20;
```

```sql
-- 8) Position of every driver on consecutive laps
--    (will later let us know whether someone was now *behind* a car he was not behind before)
SELECT cur."race_id",
       cur."driver_id",
       cur."lap"                      AS "this_lap",
       cur."position"                 AS "this_pos",
       prev."position"                AS "prev_pos"
FROM   "lap_positions" AS cur
JOIN   "lap_positions" AS prev
       ON  prev."race_id"  = cur."race_id"
       AND prev."driver_id"= cur."driver_id"
       AND prev."lap"      = cur."lap" - 1
WHERE  cur."lap_type"  = 'Race'
  AND  prev."lap_type" = 'Race'
LIMIT 20;
```

```sql
-- 9) When the *same* lap where a pit-stop occurred for that driver
--    (potential “pit-in” overtake candidate)
SELECT lp."race_id",
       lp."driver_id",
       lp."lap",
       lp."position",
       ps."stop" AS "stop_nbr"
FROM   "lap_positions" AS lp
JOIN   "pit_stops"     AS ps
       ON ps."race_id"  = lp."race_id"
      AND ps."driver_id"= lp."driver_id"
      AND ps."lap"      = lp."lap"
LIMIT 20;
```

```sql
-- 10) Sketch of counting “overtake type” events across all laps
--     (categories: On-track, Pit-in, Pit-out, Retirement, Race-start)
SELECT evt."overtake_type",
       COUNT(*) AS "nbr_overtakes"
FROM (
      /* this derived table would be built from the logic:
         – build driver order per lap (Race only)
         – compare with previous lap order
         – filter where driver was NOT behind car A on lap-1 but IS behind on lap
         – tag the reason using pit_stops / retirements / lap=1 */
      SELECT 'On-track' AS "overtake_type"  -- placeholder
      FROM   "lap_positions"
      LIMIT 0      -- remove LIMIT when full logic is implemented
) AS evt
GROUP BY evt."overtake_type";
```




