Successfully corrected. SQL:
--Description: Identify every occasion in races that contain pit-stop data where a
--             driver’s numeric position increases from one racing lap to the next
--             (i.e. he drops behind at least one extra car) and then categorise
--             that “overtake” into one of five buckets in priority order:
--               1. Race-start  – first racing lap (lap = 1)
--               2. Pit-in      – the driver pitted on the previous lap
--               3. Pit-out     – the driver pitted on the current lap
--               4. Retirement  – any retirement occurred on the current lap
--               5. On-track    – none of the above (pure racing pass)
--             Finally, count how many times each bucket occurs.
WITH lap_changes AS (                       -- step-1: detect position losses
    SELECT
        cur.race_id,
        cur.driver_id,
        cur.lap              AS cur_lap,
        prev.lap             AS prev_lap,
        prev.position        AS prev_pos,
        cur.position         AS cur_pos
    FROM   lap_positions cur
    JOIN   lap_positions prev
           ON  prev.race_id   = cur.race_id
           AND prev.driver_id = cur.driver_id
           AND prev.lap       = cur.lap - 1
    WHERE  cur.lap_type  = 'Race'
      AND  prev.lap_type = 'Race'
      AND  cur.race_id IN (SELECT DISTINCT race_id FROM pit_stops) -- only races with pit data
      AND  cur.position  > prev.position       -- driver now behind at least one more car
),
classified AS (                             -- step-2: tag every loss with an overtake_type
    SELECT
        lc.*,
        CASE
            WHEN lc.cur_lap = 1 THEN 'Race-start'
            WHEN EXISTS (SELECT 1 FROM pit_stops ps
                         WHERE ps.race_id  = lc.race_id
                           AND ps.driver_id = lc.driver_id
                           AND ps.lap       = lc.prev_lap)
                 THEN 'Pit-in'
            WHEN EXISTS (SELECT 1 FROM pit_stops ps
                         WHERE ps.race_id  = lc.race_id
                           AND ps.driver_id = lc.driver_id
                           AND ps.lap       = lc.cur_lap)
                 THEN 'Pit-out'
            WHEN EXISTS (SELECT 1 FROM retirements rt
                         WHERE rt.race_id = lc.race_id
                           AND rt.lap     = lc.cur_lap)
                 THEN 'Retirement'
            ELSE 'On-track'
        END AS overtake_type
    FROM lap_changes lc
)
SELECT   overtake_type,
         COUNT(*) AS nbr_overtakes          -- step-3: final tally
FROM     classified
GROUP BY overtake_type
ORDER BY nbr_overtakes DESC;
