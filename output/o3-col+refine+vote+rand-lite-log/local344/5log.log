       "status_id",
       "retirement_type"
FROM   "retirements"
WHERE  "race_id" = 841
LIMIT 20;
```

```sql
-- 7. Description: Compare a driver’s position on consecutive laps (race_id = 841) to see where position losses occurred.
SELECT l1."race_id",
       l1."driver_id",
       l1."lap"         AS "prev_lap",
       l1."position"    AS "prev_pos",
       l2."lap"         AS "curr_lap",
       l2."position"    AS "curr_pos"
FROM   "lap_positions" AS l1
JOIN   "lap_positions" AS l2
       ON  l2."race_id"  = l1."race_id"
       AND l2."driver_id" = l1."driver_id"
       AND l2."lap"       = l1."lap" + 1
WHERE  l1."race_id" = 841
ORDER  BY l1."driver_id", l1."lap"
LIMIT 20;
```

```sql
-- 8. Description: Identify instances (in race 841) where a driver was not behind on the previous lap
--    but is now behind (i.e. lost positions), irrespective of reason.
SELECT l1."race_id",
       l1."driver_id",
       l1."lap"  + 1     AS "lap_where_overtaken",
       l1."position"     AS "prev_pos",
       l2."position"     AS "curr_pos"
FROM   "lap_positions" AS l1
JOIN   "lap_positions" AS l2
       ON  l2."race_id"  = l1."race_id"
       AND l2."driver_id" = l1."driver_id"
       AND l2."lap"       = l1."lap" + 1
WHERE  l1."race_id" = 841
  AND  l1."position" < l2."position"          -- driver drops back
ORDER  BY l1."driver_id", l1."lap"
LIMIT 20;
```

```sql
-- 9. Description: Classify each position-loss event into “Race Start”, “Pit Entry”, “Pit Exit”,
--    “Retirement”, or “On Track” for all races that have pit data.
SELECT CASE
         WHEN l1."lap" = 0 THEN 'Race Start'
         WHEN EXISTS (SELECT 1
                      FROM   "pit_stops" ps
                      WHERE  ps."race_id" = l1."race_id"
                      AND    ps."driver_id" = l1."driver_id"
                      AND    ps."lap"       = l2."lap")        THEN 'Pit Entry'
         WHEN EXISTS (SELECT 1
                      FROM   "pit_stops" ps
                      WHERE  ps."race_id" = l1."race_id"
                      AND    ps."driver_id" = l1."driver_id"
                      AND    ps."lap"       = l1."lap")        THEN 'Pit Exit'
         WHEN EXISTS (SELECT 1
                      FROM   "retirements" rt
                      WHERE  rt."race_id" = l1."race_id"
                      AND    rt."driver_id" = l1."driver_id"
                      AND    rt."lap"       = l2."lap")        THEN 'Retirement'
         ELSE 'On Track'
       END                         AS "overtake_type",
       l1."race_id",
       l1."driver_id",
       l1."lap" + 1                AS "lap"
FROM   "lap_positions"  AS l1
JOIN   "lap_positions"  AS l2
       ON  l2."race_id"  = l1."race_id"
       AND l2."driver_id" = l1."driver_id"
       AND l2."lap"       = l1."lap" + 1
JOIN   "races_ext"      AS re
       ON  re."race_id"              = l1."race_id"
       AND re."is_pit_data_available" = 1
WHERE  l1."position" < l2."position"      -- driver was ahead, now behind
LIMIT 20;
```

```sql
-- 10. Description: Count how many times each classified overtake type has ever happened.
SELECT "overtake_type",
       COUNT(*) AS "num_overtakes"
FROM   (
        SELECT CASE
                 WHEN l1."lap" = 0 THEN 'Race Start'
                 WHEN EXISTS (SELECT 1
                              FROM   "pit_stops" ps
                              WHERE  ps."race_id" = l1."race_id"
                              AND    ps."driver_id" = l1."driver_id"
                              AND    ps."lap"       = l2."lap")        THEN 'Pit Entry'
                 WHEN EXISTS (SELECT 1
                              FROM   "pit_stops" ps
                              WHERE  ps."race_id" = l1."race_id"
                              AND    ps."driver_id" = l1."driver_id"
                              AND    ps."lap"       = l1."lap")        THEN 'Pit Exit'
                 WHEN EXISTS (SELECT 1
                              FROM   "retirements" rt
                              WHERE  rt."race_id" = l1."race_id"
                              AND    rt."driver_id" = l1."driver_id"
                              AND    rt."lap"       = l2."lap")        THEN 'Retirement'
                 ELSE 'On Track'
               END AS "overtake_type"
        FROM   "lap_positions" AS l1
        JOIN   "lap_positions" AS l2
               ON  l2."race_id"  = l1."race_id"
               AND l2."driver_id" = l1."driver_id"
               AND l2."lap"       = l1."lap" + 1
        JOIN   "races_ext"  AS re
               ON  re."race_id" = l1."race_id"
               AND re."is_pit_data_available" = 1
        WHERE  l1."position" < l2."position"
       )
GROUP  BY "overtake_type"
LIMIT 20;
```

