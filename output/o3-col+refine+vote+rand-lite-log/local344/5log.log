-- 7. Description: Compare a driver’s position on consecutive laps (race_id = 841) to see where position losses occurred.
SELECT l1."race_id",
       l1."driver_id",
       l1."lap"         AS "prev_lap",
       l1."position"    AS "prev_pos",
       l2."lap"         AS "curr_lap",
       l2."position"    AS "curr_pos"
FROM   "lap_positions" AS l1
JOIN   "lap_positions" AS l2
       ON  l2."race_id"  = l1."race_id"
       AND l2."driver_id" = l1."driver_id"
       AND l2."lap"       = l1."lap" + 1
WHERE  l1."race_id" = 841
ORDER  BY l1."driver_id", l1."lap"
LIMIT 20;
