-- 10. Description: Count how many times each classified overtake type has ever happened.
SELECT "overtake_type",
       COUNT(*) AS "num_overtakes"
FROM   (
        SELECT CASE
                 WHEN l1."lap" = 0 THEN 'Race Start'
                 WHEN EXISTS (SELECT 1
                              FROM   "pit_stops" ps
                              WHERE  ps."race_id" = l1."race_id"
                              AND    ps."driver_id" = l1."driver_id"
                              AND    ps."lap"       = l2."lap")        THEN 'Pit Entry'
                 WHEN EXISTS (SELECT 1
                              FROM   "pit_stops" ps
                              WHERE  ps."race_id" = l1."race_id"
                              AND    ps."driver_id" = l1."driver_id"
                              AND    ps."lap"       = l1."lap")        THEN 'Pit Exit'
                 WHEN EXISTS (SELECT 1
                              FROM   "retirements" rt
                              WHERE  rt."race_id" = l1."race_id"
                              AND    rt."driver_id" = l1."driver_id"
                              AND    rt."lap"       = l2."lap")        THEN 'Retirement'
                 ELSE 'On Track'
               END AS "overtake_type"
        FROM   "lap_positions" AS l1
        JOIN   "lap_positions" AS l2
               ON  l2."race_id"  = l1."race_id"
               AND l2."driver_id" = l1."driver_id"
               AND l2."lap"       = l1."lap" + 1
        JOIN   "races_ext"  AS re
               ON  re."race_id" = l1."race_id"
               AND re."is_pit_data_available" = 1
        WHERE  l1."position" < l2."position"
       )
GROUP  BY "overtake_type"
LIMIT 20;
