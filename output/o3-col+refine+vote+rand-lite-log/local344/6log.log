-- 8. Description: Same NEW pairs but restricted to races that have pit data
WITH new_pairs AS (
  SELECT c."race_id",
         c."lap",
         c."follower_driver_id",
         c."leader_driver_id"
  FROM (
        SELECT curr."race_id",
               curr."lap",
               curr."driver_id"  AS "follower_driver_id",
               leadr."driver_id" AS "leader_driver_id"
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS leadr
          ON   leadr."race_id"  = curr."race_id"
         AND   leadr."lap"      = curr."lap"
         AND   leadr."position" = curr."position" - 1
        WHERE  curr."race_id" IN (
                 SELECT "race_id" FROM "races_ext" WHERE "is_pit_data_available" = 1
               )
       ) AS c
  LEFT JOIN (
        SELECT prev."race_id",
               prev."lap" + 1          AS "lap",
               prev."driver_id"        AS "follower_driver_id",
               lead_prev."driver_id"   AS "leader_driver_id"
        FROM   "lap_positions" AS prev
        JOIN   "lap_positions" AS lead_prev
          ON   lead_prev."race_id"  = prev."race_id"
         AND   lead_prev."lap"      = prev."lap"
         AND   lead_prev."position" = prev."position" - 1
       ) AS p
    ON  p."race_id"           = c."race_id"
   AND p."lap"                = c."lap"
   AND p."follower_driver_id" = c."follower_driver_id"
   AND p."leader_driver_id"   = c."leader_driver_id"
  WHERE p."race_id" IS NULL
    AND c."lap" > 0
)
SELECT *
FROM   new_pairs
LIMIT 20;
