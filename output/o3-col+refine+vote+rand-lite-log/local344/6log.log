       )
ORDER  BY rt."race_id", rt."driver_id"
LIMIT 20;
```

```sql
-- 6. Description: Build all (follower, leader) pairs where the follower is
--     directly behind the leader on a given lap (position difference = 1)
SELECT curr."race_id",
       curr."lap",
       curr."driver_id"  AS "follower_driver_id",
       leadr."driver_id" AS "leader_driver_id"
FROM   "lap_positions" AS curr
JOIN   "lap_positions" AS leadr
  ON   leadr."race_id"  = curr."race_id"
 AND   leadr."lap"      = curr."lap"
 AND   leadr."position" = curr."position" - 1
LIMIT 20;
```

```sql
-- 7. Description: Keep only NEW follower-leader pairs that did not exist
--     on the previous lap (potential overtakes)
SELECT c."race_id",
       c."lap",
       c."follower_driver_id",
       c."leader_driver_id"
FROM (
        /* Current-lap pairs */
        SELECT curr."race_id",
               curr."lap",
               curr."driver_id"  AS "follower_driver_id",
               leadr."driver_id" AS "leader_driver_id"
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS leadr
          ON   leadr."race_id"  = curr."race_id"
         AND   leadr."lap"      = curr."lap"
         AND   leadr."position" = curr."position" - 1
     ) AS c
LEFT JOIN (
        /* Same pair one lap earlier (if it existed) */
        SELECT prev."race_id",
               prev."lap" + 1          AS "lap",
               prev."driver_id"        AS "follower_driver_id",
               lead_prev."driver_id"   AS "leader_driver_id"
        FROM   "lap_positions" AS prev
        JOIN   "lap_positions" AS lead_prev
          ON   lead_prev."race_id"  = prev."race_id"
         AND   lead_prev."lap"      = prev."lap"
         AND   lead_prev."position" = prev."position" - 1
     ) AS p
  ON  p."race_id"            = c."race_id"
 AND p."lap"                 = c."lap"
 AND p."follower_driver_id"  = c."follower_driver_id"
 AND p."leader_driver_id"    = c."leader_driver_id"
WHERE p."race_id" IS NULL        -- pair is NEW this lap
  AND c."lap"       > 0          -- skip the grid
LIMIT 20;
```

```sql
-- 8. Description: Same NEW pairs but restricted to races that have pit data
WITH new_pairs AS (
  SELECT c."race_id",
         c."lap",
         c."follower_driver_id",
         c."leader_driver_id"
  FROM (
        SELECT curr."race_id",
               curr."lap",
               curr."driver_id"  AS "follower_driver_id",
               leadr."driver_id" AS "leader_driver_id"
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS leadr
          ON   leadr."race_id"  = curr."race_id"
         AND   leadr."lap"      = curr."lap"
         AND   leadr."position" = curr."position" - 1
        WHERE  curr."race_id" IN (
                 SELECT "race_id" FROM "races_ext" WHERE "is_pit_data_available" = 1
               )
       ) AS c
  LEFT JOIN (
        SELECT prev."race_id",
               prev."lap" + 1          AS "lap",
               prev."driver_id"        AS "follower_driver_id",
               lead_prev."driver_id"   AS "leader_driver_id"
        FROM   "lap_positions" AS prev
        JOIN   "lap_positions" AS lead_prev
          ON   lead_prev."race_id"  = prev."race_id"
         AND   lead_prev."lap"      = prev."lap"
         AND   lead_prev."position" = prev."position" - 1
       ) AS p
    ON  p."race_id"           = c."race_id"
   AND p."lap"                = c."lap"
   AND p."follower_driver_id" = c."follower_driver_id"
   AND p."leader_driver_id"   = c."leader_driver_id"
  WHERE p."race_id" IS NULL
    AND c."lap" > 0
)
SELECT *
FROM   new_pairs
LIMIT 20;
```

```sql
-- 9. Description: Tag each new follower-leader pairing with an over-take TYPE
--                 (Retirement, Pit-Stop, Race Start, On-Track)
WITH new_pairs AS (
  /* (same CTE as in query #8) */
  SELECT c."race_id",
         c."lap",
         c."follower_driver_id",
         c."leader_driver_id"
  FROM (
        SELECT curr."race_id",
               curr."lap",
               curr."driver_id"  AS "follower_driver_id",
               leadr."driver_id" AS "leader_driver_id"
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS leadr
          ON   leadr."race_id"  = curr."race_id"
         AND   leadr."lap"      = curr."lap"
         AND   leadr."position" = curr."position" - 1
        WHERE  curr."race_id" IN (
                 SELECT "race_id" FROM "races_ext" WHERE "is_pit_data_available" = 1
               )
       ) AS c
  LEFT JOIN (
        SELECT prev."race_id",
               prev."lap" + 1         AS "lap",
               prev."driver_id"       AS "follower_driver_id",
               lead_prev."driver_id"  AS "leader_driver_id"
        FROM   "lap_positions" AS prev
        JOIN   "lap_positions" AS lead_prev
          ON   lead_prev."race_id"  = prev."race_id"
         AND   lead_prev."lap"      = prev."lap"
         AND   lead_prev."position" = prev."position" - 1
       ) AS p
    ON  p."race_id"            = c."race_id"
   AND p."lap"                 = c."lap"
   AND p."follower_driver_id"  = c."follower_driver_id"
   AND p."leader_driver_id"    = c."leader_driver_id"
  WHERE p."race_id" IS NULL
    AND c."lap" > 0
),
typed AS (
  SELECT np.*,
         CASE
             WHEN rt."driver_id" IS NOT NULL
                  THEN 'Retirement'
             WHEN ps_lead."driver_id" IS NOT NULL
               OR ps_foll."driver_id" IS NOT NULL
                  THEN 'Pit-Stop'
             WHEN np."lap" = 1
                  THEN 'Race Start'
             ELSE 'On-Track'
         END AS "overtake_type"
  FROM   new_pairs        AS np
  LEFT  JOIN "retirements" AS rt
         ON rt."race_id" = np."race_id"
        AND rt."driver_id" IN (np."leader_driver_id", np."follower_driver_id")
        AND rt."lap"     = np."lap"
  LEFT  JOIN "pit_stops" AS ps_lead
         ON ps_lead."race_id"  = np."race_id"
        AND ps_lead."driver_id"= np."leader_driver_id"
        AND ps_lead."lap"      = np."lap"
  LEFT  JOIN "pit_stops" AS ps_foll
         ON ps_foll."race_id"  = np."race_id"
        AND ps_foll."driver_id"= np."follower_driver_id"
        AND ps_foll."lap"      = np."lap"
)
SELECT *
FROM   typed
LIMIT 20;
```

```sql
-- 10. Description: Final aggregation – total number of occurrences of
--                  each over-take TYPE in Formula 1 history (within races that have pit data)
WITH new_pairs AS (
  /* same construction as above */
  SELECT c."race_id",
         c."lap",
         c."follower_driver_id",
         c."leader_driver_id"
  FROM (
        SELECT curr."race_id",
               curr."lap",
               curr."driver_id"  AS "follower_driver_id",
               leadr."driver_id" AS "leader_driver_id"
        FROM   "lap_positions" AS curr
        JOIN   "lap_positions" AS leadr
          ON   leadr."race_id"  = curr."race_id"
         AND   leadr."lap"      = curr."lap"
         AND   leadr."position" = curr."position" - 1
        WHERE  curr."race_id" IN (
                 SELECT "race_id" FROM "races_ext" WHERE "is_pit_data_available" = 1
               )
       ) AS c
  LEFT JOIN (
        SELECT prev."race_id",
               prev."lap" + 1         AS "lap",
               prev."driver_id"       AS "follower_driver_id",
               lead_prev."driver_id"  AS "leader_driver_id"
        FROM   "lap_positions" AS prev
        JOIN   "lap_positions" AS lead_prev
          ON   lead_prev."race_id"  = prev."race_id"
         AND   lead_prev."lap"      = prev."lap"
         AND   lead_prev."position" = prev."position" - 1
       ) AS p
    ON  p."race_id"            = c."race_id"
   AND p."lap"                 = c."lap"
   AND p."follower_driver_id"  = c."follower_driver_id"
   AND p."leader_driver_id"    = c."leader_driver_id"
  WHERE p."race_id" IS NULL
    AND c."lap" > 0
),
typed AS (
  SELECT np.*,
         CASE
             WHEN rt."driver_id" IS NOT NULL
                  THEN 'Retirement'
             WHEN ps_lead."driver_id" IS NOT NULL
               OR ps_foll."driver_id" IS NOT NULL
                  THEN 'Pit-Stop'
             WHEN np."lap" = 1
                  THEN 'Race Start'
             ELSE 'On-Track'
         END AS "overtake_type"
  FROM   new_pairs        AS np
  LEFT  JOIN "retirements" AS rt
         ON rt."race_id" = np."race_id"
        AND rt."driver_id" IN (np."leader_driver_id", np."follower_driver_id")
        AND rt."lap"     = np."lap"
  LEFT  JOIN "pit_stops" AS ps_lead
         ON ps_lead."race_id"  = np."race_id"
        AND ps_lead."driver_id"= np."leader_driver_id"
        AND ps_lead."lap"      = np."lap"
  LEFT  JOIN "pit_stops" AS ps_foll
         ON ps_foll."race_id"  = np."race_id"
        AND ps_foll."driver_id"= np."follower_driver_id"
        AND ps_foll."lap"      = np."lap"
)
SELECT "overtake_type",
       COUNT(*) AS "num_of_occurrences"
FROM   typed
GROUP  BY "overtake_type"
LIMIT 20;
```
