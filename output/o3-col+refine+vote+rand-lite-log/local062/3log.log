```sql
--Description:  We must create ten equal-width profit buckets for Italian customers’ purchases in
--December 2021 and, for each bucket, return the number of customers together with the
--minimum and maximum total profit that fall inside that bucket.  The steps are:
-- 1) Identify Italian customers via countries.country_iso_code = 'IT'.
-- 2) Restrict sales to December-2021 by joining to the times dimension
--    (calendar_year = 2021 AND calendar_month_number = 12).
-- 3) Join each sale to its matching record in costs so profit per sale can be
--    calculated:  quantity_sold * (unit_price – unit_cost).
-- 4) Sum those profits per customer to get each customer’s total December-2021
--    profit (CTE customer_profit).
-- 5) Obtain the minimum and maximum total profit so that the overall range can be
--    divided into ten equal intervals (CTE limits).
-- 6) Convert every customer’s total profit into an integer bucket_id 0-9
--    (CTE bucketed).  The formula is:
--       bucket_id = CASE WHEN total_profit = max_p THEN 9               --put the top
--                         WHEN (max_p = min_p)      THEN 0               --all profits equal
--                         ELSE CAST((total_profit - min_p) / bucket_width AS INTEGER)
--                    END
--    where bucket_width = (max_p - min_p) / 10.0.
-- 7) Finally, group by bucket_id to count customers and report the
--    bucket’s own min and max profit.
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM   sales  AS s
    JOIN   costs  AS c
           ON  s.prod_id    = c.prod_id
           AND s.time_id    = c.time_id
           AND s.channel_id = c.channel_id
           AND s.promo_id   = c.promo_id
    JOIN   times      AS t   ON s.time_id    = t.time_id
    JOIN   customers  AS cu  ON s.cust_id    = cu.cust_id
    JOIN   countries  AS co  ON cu.country_id = co.country_id
    WHERE  co.country_iso_code   = 'IT'
      AND  t.calendar_year       = 2021
      AND  t.calendar_month_number = 12
    GROUP  BY s.cust_id
),
limits AS (
    SELECT MIN(total_profit) AS min_p,
           MAX(total_profit) AS max_p,
           (MAX(total_profit) - MIN(total_profit)) / 10.0 AS bucket_width
    FROM customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           CASE
               WHEN cp.total_profit = (SELECT max_p FROM limits) THEN 9
               WHEN (SELECT max_p FROM limits) = (SELECT min_p FROM limits) THEN 0
               ELSE CAST(
                     (cp.total_profit - (SELECT min_p FROM limits))
                     / NULLIF((SELECT bucket_width FROM limits),0) AS INTEGER)
           END AS bucket_id
    FROM customer_profit AS cp
)
SELECT bucket_id               AS profit_bucket,
       COUNT(*)                AS customer_count,
       MIN(total_profit)       AS bucket_min_profit,
       MAX(total_profit)       AS bucket_max_profit
FROM   bucketed
GROUP  BY bucket_id
ORDER  BY bucket_id;
```
