        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  t.calendar_year = 2021
          AND  t.calendar_month_number = 12)
LIMIT 20;
```

```sql
--Description: Compute profit per sale for a sample of Italian customers in Dec-2021
SELECT DISTINCT s.cust_id,
       s.prod_id,
       s.time_id,
       (s.quantity_sold * (c.unit_price - c.unit_cost)) AS profit_per_sale
FROM   sales AS s
JOIN   costs AS c
       ON  s.prod_id    = c.prod_id
       AND s.time_id    = c.time_id
       AND s.channel_id = c.channel_id
       AND s.promo_id   = c.promo_id
JOIN   times      AS t   ON s.time_id   = t.time_id
JOIN   customers  AS cu  ON s.cust_id   = cu.cust_id
JOIN   countries  AS co  ON cu.country_id = co.country_id
WHERE  co.country_iso_code = 'IT'
  AND  t.calendar_year      = 2021
  AND  t.calendar_month_number = 12
LIMIT 20;
```

```sql
--Description: Aggregate total December-2021 profit for each Italian customer
SELECT DISTINCT s.cust_id,
       SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
FROM   sales  AS s
JOIN   costs  AS c
       ON  s.prod_id    = c.prod_id
       AND s.time_id    = c.time_id
       AND s.channel_id = c.channel_id
       AND s.promo_id   = c.promo_id
JOIN   times      AS t   ON s.time_id   = t.time_id
JOIN   customers  AS cu  ON s.cust_id   = cu.cust_id
JOIN   countries  AS co  ON cu.country_id = co.country_id
WHERE  co.country_iso_code = 'IT'
  AND  t.calendar_year      = 2021
  AND  t.calendar_month_number = 12
GROUP  BY s.cust_id
LIMIT 20;
```

```sql
--Description: Find the overall minimum and maximum total profits (Italian customers, Dec-2021)
SELECT DISTINCT
       MIN(total_profit) AS min_profit,
       MAX(total_profit) AS max_profit
FROM (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM   sales AS s
    JOIN   costs AS c
           ON  s.prod_id    = c.prod_id
           AND s.time_id    = c.time_id
           AND s.channel_id = c.channel_id
           AND s.promo_id   = c.promo_id
    JOIN   times      AS t   ON s.time_id   = t.time_id
    JOIN   customers  AS cu  ON s.cust_id   = cu.cust_id
    JOIN   countries  AS co  ON cu.country_id = co.country_id
    WHERE  co.country_iso_code = 'IT'
      AND  t.calendar_year      = 2021
      AND  t.calendar_month_number = 12
    GROUP  BY s.cust_id
) AS cp
LIMIT 20;
```

```sql
--Description: Place each Italian customer into one of ten equal-width buckets
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM   sales AS s
    JOIN   costs AS c
           ON  s.prod_id    = c.prod_id
           AND s.time_id    = c.time_id
           AND s.channel_id = c.channel_id
           AND s.promo_id   = c.promo_id
    JOIN   times      AS t   ON s.time_id   = t.time_id
    JOIN   customers  AS cu  ON s.cust_id   = cu.cust_id
    JOIN   countries  AS co  ON cu.country_id = co.country_id
    WHERE  co.country_iso_code = 'IT'
      AND  t.calendar_year      = 2021
      AND  t.calendar_month_number = 12
    GROUP  BY s.cust_id
),
limits AS (
    SELECT MIN(total_profit) AS min_p, MAX(total_profit) AS max_p FROM customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           CASE
             WHEN cp.total_profit = (SELECT max_p FROM limits) THEN 9      --ensure the max goes into last bucket
             ELSE CAST( ( (cp.total_profit - (SELECT min_p FROM limits))
                         / ( (SELECT (max_p - min_p) FROM limits) / 10.0 ) ) AS INTEGER)
           END AS bucket_id
    FROM customer_profit AS cp
)
SELECT DISTINCT cust_id, total_profit, bucket_id
FROM bucketed
LIMIT 20;
```

```sql
--Description: Final answer – for each bucket show #customers and the min & max profits inside the bucket
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM   sales AS s
    JOIN   costs AS c
           ON  s.prod_id    = c.prod_id
           AND s.time_id    = c.time_id
           AND s.channel_id = c.channel_id
           AND s.promo_id   = c.promo_id
    JOIN   times      AS t   ON s.time_id   = t.time_id
    JOIN   customers  AS cu  ON s.cust_id   = cu.cust_id
    JOIN   countries  AS co  ON cu.country_id = co.country_id
    WHERE  co.country_iso_code = 'IT'
      AND  t.calendar_year      = 2021
      AND  t.calendar_month_number = 12
    GROUP  BY s.cust_id
),
limits AS (
    SELECT MIN(total_profit) AS min_p, MAX(total_profit) AS max_p FROM customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           CASE
             WHEN cp.total_profit = (SELECT max_p FROM limits) THEN 9
             ELSE CAST( ( (cp.total_profit - (SELECT min_p FROM limits))
                         / ( (SELECT (max_p - min_p) FROM limits) / 10.0 ) ) AS INTEGER)
           END AS bucket_id
    FROM customer_profit AS cp
)
SELECT bucket_id                             AS profit_bucket,
       COUNT(*)                              AS customer_count,
       MIN(total_profit)                     AS bucket_min_profit,
       MAX(total_profit)                     AS bucket_max_profit
FROM   bucketed
GROUP  BY bucket_id
ORDER  BY bucket_id
LIMIT 20;
```
