Query:
--Description: Assign each Italian customer to one of 10 equal-width profit buckets for December 2021 and list the assignments
WITH customer_profit AS (
    SELECT s.cust_id,
           SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
    FROM   sales  AS s
    JOIN   costs  AS c  ON  s.prod_id    = c.prod_id
                       AND s.time_id    = c.time_id
                       AND s.channel_id = c.channel_id
                       AND s.promo_id   = c.promo_id
    JOIN   times      AS t  ON s.time_id    = t.time_id
    JOIN   customers  AS cu ON s.cust_id    = cu.cust_id
    JOIN   countries  AS co ON cu.country_id = co.country_id
    WHERE  co.country_iso_code     = 'IT'
      AND  t.calendar_year         = 2021
      AND  t.calendar_month_number = 12
    GROUP  BY s.cust_id
),
limits AS (
    SELECT MIN(total_profit) AS min_p,
           MAX(total_profit) AS max_p,
           (MAX(total_profit) - MIN(total_profit)) / 10.0 AS bucket_width
    FROM   customer_profit
),
bucketed AS (
    SELECT cp.cust_id,
           cp.total_profit,
           CASE
               WHEN (SELECT max_p FROM limits) = (SELECT min_p FROM limits) THEN 0               --all equal profits
               WHEN cp.total_profit = (SELECT max_p FROM limits)            THEN 9               --put absolute max into bucket 9
               ELSE CAST(
                     (cp.total_profit - (SELECT min_p FROM limits))
                     / NULLIF((SELECT bucket_width FROM limits), 0) AS INTEGER)
           END AS bucket_id
    FROM   customer_profit AS cp
)
SELECT DISTINCT
       cust_id,
       total_profit,
       bucket_id
FROM   bucketed
LIMIT 20
