```sql
--Description: Sample cost records in December 2021
SELECT DISTINCT *
FROM costs
WHERE time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Compute sample profit per sale for Italian customers in December 2021
SELECT s.cust_id,
       s.prod_id,
       s.quantity_sold,
       (c2.unit_price - c2.unit_cost) AS unit_margin,
       s.quantity_sold * (c2.unit_price - c2.unit_cost) AS profit
FROM sales  AS s
JOIN costs  AS c2 ON s.prod_id = c2.prod_id
                 AND s.time_id = c2.time_id
JOIN times      AS t  ON s.time_id = t.time_id
JOIN customers  AS cu ON s.cust_id = cu.cust_id
JOIN countries  AS co ON cu.country_id = co.country_id
WHERE co.country_name = 'Italy'
  AND t.time_id BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Total profit per Italian customer for December 2021
SELECT s.cust_id,
       SUM(s.quantity_sold * (c2.unit_price - c2.unit_cost)) AS total_profit
FROM sales  AS s
JOIN costs  AS c2 ON s.prod_id = c2.prod_id
                 AND s.time_id = c2.time_id
JOIN times      AS t  ON s.time_id = t.time_id
JOIN customers  AS cu ON s.cust_id = cu.cust_id
JOIN countries  AS co ON cu.country_id = co.country_id
WHERE co.country_name = 'Italy'
  AND t.time_id BETWEEN '2021-12-01' AND '2021-12-31'
GROUP BY s.cust_id
LIMIT 20;
```

```sql
--Description: Find overall minimum and maximum total profit among Italian customers
WITH customer_profit AS (
  SELECT s.cust_id,
         SUM(s.quantity_sold * (c2.unit_price - c2.unit_cost)) AS total_profit
  FROM sales  AS s
  JOIN costs  AS c2 ON s.prod_id = c2.prod_id
                   AND s.time_id = c2.time_id
  JOIN times      AS t  ON s.time_id = t.time_id
  JOIN customers  AS cu ON s.cust_id = cu.cust_id
  JOIN countries  AS co ON cu.country_id = co.country_id
  WHERE co.country_name = 'Italy'
    AND t.time_id BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s.cust_id
)
SELECT MIN(total_profit) AS min_profit,
       MAX(total_profit) AS max_profit
FROM customer_profit
LIMIT 20;
```

```sql
--Description: Assign each Italian customer to one of 10 equal-width profit buckets
WITH customer_profit AS (
  SELECT s.cust_id,
         SUM(s.quantity_sold * (c2.unit_price - c2.unit_cost)) AS total_profit
  FROM sales  AS s
  JOIN costs  AS c2 ON s.prod_id = c2.prod_id
                   AND s.time_id = c2.time_id
  JOIN times      AS t  ON s.time_id = t.time_id
  JOIN customers  AS cu ON s.cust_id = cu.cust_id
  JOIN countries  AS co ON cu.country_id = co.country_id
  WHERE co.country_name = 'Italy'
    AND t.time_id BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s.cust_id
),
stats AS (
  SELECT MIN(total_profit) AS min_p,
         MAX(total_profit) AS max_p
  FROM customer_profit
),
profits_with_bucket AS (
  SELECT cp.*,
         1 + CAST(
               CASE
                 WHEN (max_p - min_p) = 0 THEN 0
                 ELSE ((cp.total_profit - min_p) / ((max_p - min_p) / 10.0))
               END
             AS INTEGER) AS bucket_no
  FROM customer_profit AS cp
  CROSS JOIN stats
)
SELECT *
FROM profits_with_bucket
ORDER BY bucket_no, total_profit
LIMIT 20;
```

```sql
--Description: For each bucket, provide number of customers and min/max total profits
WITH customer_profit AS (
  SELECT s.cust_id,
         SUM(s.quantity_sold * (c2.unit_price - c2.unit_cost)) AS total_profit
  FROM sales  AS s
  JOIN costs  AS c2 ON s.prod_id = c2.prod_id
                   AND s.time_id = c2.time_id
  JOIN times      AS t  ON s.time_id = t.time_id
  JOIN customers  AS cu ON s.cust_id = cu.cust_id
  JOIN countries  AS co ON cu.country_id = co.country_id
  WHERE co.country_name = 'Italy'
    AND t.time_id BETWEEN '2021-12-01' AND '2021-12-31'
  GROUP BY s.cust_id
),
stats AS (
  SELECT MIN(total_profit) AS min_p,
         MAX(total_profit) AS max_p
  FROM customer_profit
),
profits_with_bucket AS (
  SELECT cp.*,
         1 + CAST(
               CASE
                 WHEN (max_p - min_p) = 0 THEN 0
                 ELSE ((cp.total_profit - min_p) / ((max_p - min_p) / 10.0))
               END
             AS INTEGER) AS bucket_no
  FROM customer_profit AS cp
  CROSS JOIN stats
)
SELECT bucket_no         AS bucket,
       COUNT(*)          AS customer_count,
       MIN(total_profit) AS bucket_min_profit,
       MAX(total_profit) AS bucket_max_profit
FROM profits_with_bucket
GROUP BY bucket_no
ORDER BY bucket_no
LIMIT 20;
```
