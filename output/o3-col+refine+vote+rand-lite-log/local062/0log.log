FROM   times
WHERE  calendar_year  = 2021
  AND  calendar_month_number = 12
LIMIT 20;
```

```sql
--Description: 4) Display a few Sales rows that occurred in December-2021
SELECT DISTINCT prod_id,
                cust_id,
                time_id,
                quantity_sold,
                amount_sold
FROM   sales
WHERE  time_id IN (SELECT time_id
                   FROM   times
                   WHERE  calendar_year = 2021
                     AND  calendar_month_number = 12)
LIMIT 20;
```

```sql
--Description: 5) Display the Cost records that match December-2021 dates
SELECT DISTINCT prod_id,
                time_id,
                promo_id,
                channel_id,
                unit_cost,
                unit_price
FROM   costs
WHERE  time_id IN (SELECT time_id
                   FROM   times
                   WHERE  calendar_year = 2021
                     AND  calendar_month_number = 12)
LIMIT 20;
```

```sql
--Description: 6) Join Sales & Costs for December-2021 to preview line-level profits
SELECT DISTINCT s.cust_id,
                s.time_id,
                s.prod_id,
                s.quantity_sold * (c.unit_price - c.unit_cost) AS profit
FROM   sales  AS s
JOIN   costs  AS c
       ON  s.prod_id     = c.prod_id
       AND s.time_id     = c.time_id
       AND s.channel_id  = c.channel_id
       AND s.promo_id    = c.promo_id
WHERE  s.time_id IN (SELECT time_id
                     FROM   times
                     WHERE  calendar_year = 2021
                       AND  calendar_month_number = 12)
LIMIT 20;
```

```sql
--Description: 7) Aggregate December-2021 profit per Italian customer
SELECT s.cust_id,
       SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
FROM   sales  AS s
JOIN   costs  AS c
       ON  s.prod_id    = c.prod_id
       AND s.time_id    = c.time_id
       AND s.channel_id = c.channel_id
       AND s.promo_id   = c.promo_id
JOIN   customers AS cu
       ON s.cust_id = cu.cust_id
WHERE  cu.country_id = (SELECT country_id
                        FROM   countries
                        WHERE  country_name = 'Italy')
  AND  s.time_id IN (SELECT time_id
                     FROM   times
                     WHERE  calendar_year = 2021
                       AND  calendar_month_number = 12)
GROUP  BY s.cust_id
LIMIT 20;
```

```sql
--Description: 8) Find the overall minimum and maximum total December-2021 profit among Italian customers
SELECT MIN(total_profit) AS min_overall_profit,
       MAX(total_profit) AS max_overall_profit
FROM  (SELECT s.cust_id,
              SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
       FROM   sales  AS s
       JOIN   costs  AS c
              ON  s.prod_id    = c.prod_id
              AND s.time_id    = c.time_id
              AND s.channel_id = c.channel_id
              AND s.promo_id   = c.promo_id
       JOIN   customers AS cu
              ON s.cust_id = cu.cust_id
       WHERE  cu.country_id = (SELECT country_id
                               FROM   countries
                               WHERE  country_name = 'Italy')
         AND  s.time_id IN (SELECT time_id
                            FROM   times
                            WHERE  calendar_year = 2021
                              AND  calendar_month_number = 12)
       GROUP  BY s.cust_id);
```

```sql
--Description: 9) Bucket the Italian customers’ December-2021 total profits into 10 equal-sized NTILEs
SELECT cust_id,
       total_profit,
       NTILE(10) OVER (ORDER BY total_profit) AS profit_bucket
FROM  (SELECT s.cust_id,
              SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
       FROM   sales  AS s
       JOIN   costs  AS c
              ON  s.prod_id    = c.prod_id
              AND s.time_id    = c.time_id
              AND s.channel_id = c.channel_id
              AND s.promo_id   = c.promo_id
       JOIN   customers AS cu
              ON s.cust_id = cu.cust_id
       WHERE  cu.country_id = (SELECT country_id
                               FROM   countries
                               WHERE  country_name = 'Italy')
         AND  s.time_id IN (SELECT time_id
                            FROM   times
                            WHERE  calendar_year = 2021
                              AND  calendar_month_number = 12)
       GROUP  BY s.cust_id)
LIMIT 20;
```

```sql
--Description: 10) Final step – produce bucket-level statistics (customer count, min & max profit per bucket)
SELECT profit_bucket,
       COUNT(*)               AS num_customers,
       MIN(total_profit)      AS min_profit_in_bucket,
       MAX(total_profit)      AS max_profit_in_bucket
FROM  (SELECT cust_id,
              total_profit,
              NTILE(10) OVER (ORDER BY total_profit) AS profit_bucket
       FROM  (SELECT s.cust_id,
                     SUM(s.quantity_sold * (c.unit_price - c.unit_cost)) AS total_profit
              FROM   sales  AS s
              JOIN   costs  AS c
                     ON  s.prod_id    = c.prod_id
                     AND s.time_id    = c.time_id
                     AND s.channel_id = c.channel_id
                     AND s.promo_id   = c.promo_id
              JOIN   customers AS cu
                     ON s.cust_id = cu.cust_id
              WHERE  cu.country_id = (SELECT country_id
                                      FROM   countries
                                      WHERE  country_name = 'Italy')
                AND  s.time_id IN (SELECT time_id
                                   FROM   times
                                   WHERE  calendar_year = 2021
                                     AND  calendar_month_number = 12)
              GROUP  BY s.cust_id))
GROUP BY profit_bucket
ORDER BY profit_bucket;
```
