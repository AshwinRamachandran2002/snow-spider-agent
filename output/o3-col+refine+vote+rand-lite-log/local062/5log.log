```sql
--Description: Inspect a few Italian customers and their IDs.
SELECT DISTINCT "cust_id", "cust_first_name", "cust_last_name"
FROM "customers"
WHERE "country_id" = (SELECT "country_id"
                      FROM "countries"
                      WHERE "country_name" = 'Italy')
LIMIT 20;
```

```sql
--Description: List the calendar dates that fall in December-2021.
SELECT DISTINCT "time_id"
FROM "times"
WHERE "time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Show sales rows for Italian customers during December-2021.
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       s."quantity_sold"
FROM "sales" AS s
JOIN "customers" AS c
     ON s."cust_id" = c."cust_id"
WHERE c."country_id" = (SELECT "country_id"
                        FROM "countries"
                        WHERE "country_name" = 'Italy')
  AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Check the corresponding cost rows (unit_cost vs unit_price)
--             for products sold to Italian customers in December-2021.
SELECT DISTINCT ct."prod_id",
       ct."time_id",
       ct."unit_cost",
       ct."unit_price"
FROM "costs" AS ct
WHERE ct."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
  AND ct."prod_id" IN (SELECT DISTINCT s."prod_id"
                       FROM "sales" AS s
                       JOIN "customers" AS cu
                            ON s."cust_id" = cu."cust_id"
                       WHERE cu."country_id" = (SELECT "country_id"
                                                FROM "countries"
                                                WHERE "country_name" = 'Italy')
                         AND s."time_id" BETWEEN '2021-12-01'
                                            AND '2021-12-31')
LIMIT 20;
```

```sql
--Description: Compute per-transaction profit for those Italian December-2021 sales.
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       (ct."unit_price" - ct."unit_cost") * s."quantity_sold" AS "profit"
FROM "sales"  AS s
JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
JOIN "costs"  AS ct   ON ct."prod_id"    = s."prod_id"
                     AND ct."time_id"    = s."time_id"
                     AND ct."channel_id" = s."channel_id"
                     AND ct."promo_id"   = s."promo_id"
WHERE cu."country_id" = (SELECT "country_id"
                         FROM "countries"
                         WHERE "country_name" = 'Italy')
  AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: Aggregate total December-2021 profit per Italian customer.
SELECT DISTINCT cu."cust_id",
       SUM((ct."unit_price" - ct."unit_cost") * s."quantity_sold") AS "total_profit"
FROM "sales"  AS s
JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
JOIN "costs"  AS ct   ON ct."prod_id"    = s."prod_id"
                     AND ct."time_id"    = s."time_id"
                     AND ct."channel_id" = s."channel_id"
                     AND ct."promo_id"   = s."promo_id"
WHERE cu."country_id" = (SELECT "country_id"
                         FROM "countries"
                         WHERE "country_name" = 'Italy')
  AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
GROUP BY cu."cust_id"
LIMIT 20;
```

```sql
--Description: Get the overall minimum and maximum of those customer profits
--             (needed to build equal-width buckets).
SELECT MIN("total_profit") AS "min_profit",
       MAX("total_profit") AS "max_profit"
FROM (
    SELECT cu."cust_id",
           SUM((ct."unit_price" - ct."unit_cost") * s."quantity_sold") AS "total_profit"
    FROM "sales"  AS s
    JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
    JOIN "costs"  AS ct   ON ct."prod_id"    = s."prod_id"
                         AND ct."time_id"    = s."time_id"
                         AND ct."channel_id" = s."channel_id"
                         AND ct."promo_id"   = s."promo_id"
    WHERE cu."country_id" = (SELECT "country_id"
                             FROM "countries"
                             WHERE "country_name" = 'Italy')
      AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP BY cu."cust_id"
)
LIMIT 20;
```

```sql
--Description: Place the Italian customers into ten equal-width profit buckets,
--             then report how many customers fall into each bucket together
--             with the min / max profit inside that bucket.
WITH cust_profit AS (
    SELECT cu."cust_id",
           SUM((ct."unit_price" - ct."unit_cost") * s."quantity_sold") AS "total_profit"
    FROM "sales"  AS s
    JOIN "customers" AS cu ON s."cust_id" = cu."cust_id"
    JOIN "costs"  AS ct   ON ct."prod_id"    = s."prod_id"
                         AND ct."time_id"    = s."time_id"
                         AND ct."channel_id" = s."channel_id"
                         AND ct."promo_id"   = s."promo_id"
    WHERE cu."country_id" = (SELECT "country_id"
                             FROM "countries"
                             WHERE "country_name" = 'Italy')
      AND s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
    GROUP BY cu."cust_id"
), range_vals AS (
    SELECT MIN("total_profit") AS min_p,
           MAX("total_profit") AS max_p
    FROM cust_profit
), bucketed AS (
    SELECT cp."cust_id",
           cp."total_profit",
           1 + CAST(
               FLOOR( (cp."total_profit" - rv.min_p) /
                      ((rv.max_p - rv.min_p) / 10.0) )
           AS INTEGER) AS bucket
    FROM cust_profit AS cp, range_vals AS rv
)
SELECT bucket,
       COUNT(DISTINCT "cust_id")      AS "num_customers",
       MIN("total_profit")            AS "bucket_min_profit",
       MAX("total_profit")            AS "bucket_max_profit"
FROM bucketed
GROUP BY bucket
ORDER BY bucket
LIMIT 20;
```
