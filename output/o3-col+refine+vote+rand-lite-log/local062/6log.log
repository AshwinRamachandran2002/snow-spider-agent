--Description: 4)  For those December-2021 rows, join to costs to examine unit_price vs unit_cost
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       s."channel_id",
       s."promo_id",
       cst."unit_cost",
       cst."unit_price"
FROM   "sales"  AS s
JOIN   "customers" AS cu
       ON cu."cust_id" = s."cust_id"
JOIN   "costs"  AS cst
       ON  cst."prod_id"   = s."prod_id"
       AND cst."time_id"   = s."time_id"
       AND cst."channel_id"= s."channel_id"
