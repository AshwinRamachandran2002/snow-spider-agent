```sql
--Description: 1)  Find Italy’s “country_id” and basic info in the countries table
SELECT DISTINCT "country_id",
       "country_iso_code",
       "country_name",
       "country_region"
FROM   "countries"
WHERE  "country_name" = 'Italy'
LIMIT 20;
```

```sql
--Description: 2)  List (a sample of) customers whose “country_id” is Italy’s id
SELECT DISTINCT "cust_id",
       "cust_first_name",
       "cust_last_name",
       "country_id"
FROM   "customers"
WHERE  "country_id" IN (
         SELECT "country_id"
         FROM   "countries"
         WHERE  "country_name" = 'Italy'
       )
LIMIT 20;
```

```sql
--Description: 3)  Pull December-2021 sales made by Italian customers
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       s."promo_id",
       s."channel_id",
       s."quantity_sold",
       s."amount_sold"
FROM   "sales"  AS s
JOIN   "customers" AS c
       ON c."cust_id" = s."cust_id"
WHERE  c."country_id" IN (
         SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
       )
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 4)  For those December-2021 rows, join to costs to examine unit_price vs unit_cost
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       s."channel_id",
       s."promo_id",
       cst."unit_cost",
       cst."unit_price"
FROM   "sales"  AS s
JOIN   "customers" AS cu
       ON cu."cust_id" = s."cust_id"
JOIN   "costs"  AS cst
       ON  cst."prod_id"   = s."prod_id"
       AND cst."time_id"   = s."time_id"
       AND cst."channel_id"= s."channel_id"
       AND cst."promo_id"  = s."promo_id"
WHERE  cu."country_id" IN (
         SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
       )
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 5)  Calculate profit per individual sales record (Italian customers, Dec-2021)
SELECT DISTINCT s."cust_id",
       s."prod_id",
       s."time_id",
       (s."quantity_sold" * (cst."unit_price" - cst."unit_cost")) AS "profit"
FROM   "sales"  AS s
JOIN   "customers" AS cu
       ON cu."cust_id" = s."cust_id"
JOIN   "costs"  AS cst
       ON  cst."prod_id"   = s."prod_id"
       AND cst."time_id"   = s."time_id"
       AND cst."channel_id"= s."channel_id"
       AND cst."promo_id"  = s."promo_id"
WHERE  cu."country_id" IN (
         SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
       )
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
LIMIT 20;
```

```sql
--Description: 6)  Aggregate those profits to total monthly profit per customer (Dec-2021, Italy)
SELECT DISTINCT s."cust_id",
       SUM( s."quantity_sold" * (cst."unit_price" - cst."unit_cost") ) AS "total_profit"
FROM   "sales"  AS s
JOIN   "customers" AS cu
       ON cu."cust_id" = s."cust_id"
JOIN   "costs"  AS cst
       ON  cst."prod_id"   = s."prod_id"
       AND cst."time_id"   = s."time_id"
       AND cst."channel_id"= s."channel_id"
       AND cst."promo_id"  = s."promo_id"
WHERE  cu."country_id" IN (
         SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
       )
  AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
GROUP  BY s."cust_id"
LIMIT 20;
```

```sql
--Description: 7)  Identify the overall minimum and maximum total profit for Italian customers in Dec-2021
SELECT MIN("total_profit") AS "min_profit",
       MAX("total_profit") AS "max_profit"
FROM (
        SELECT s."cust_id",
               SUM( s."quantity_sold" * (cst."unit_price" - cst."unit_cost") ) AS "total_profit"
        FROM   "sales"  AS s
        JOIN   "customers" AS cu
               ON cu."cust_id" = s."cust_id"
        JOIN   "costs"  AS cst
               ON  cst."prod_id"   = s."prod_id"
               AND cst."time_id"   = s."time_id"
               AND cst."channel_id"= s."channel_id"
               AND cst."promo_id"  = s."promo_id"
        WHERE  cu."country_id" IN (
                 SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
               )
          AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP  BY s."cust_id"
     )
LIMIT 20;
```

```sql
--Description: 8)  Show the ordered list of customers’ total profits to help visualise buckets
SELECT *
FROM (
        SELECT s."cust_id",
               SUM( s."quantity_sold" * (cst."unit_price" - cst."unit_cost") ) AS "total_profit"
        FROM   "sales"  AS s
        JOIN   "customers" AS cu
               ON cu."cust_id" = s."cust_id"
        JOIN   "costs"  AS cst
               ON  cst."prod_id"   = s."prod_id"
               AND cst."time_id"   = s."time_id"
               AND cst."channel_id"= s."channel_id"
               AND cst."promo_id"  = s."promo_id"
        WHERE  cu."country_id" IN (
                 SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
               )
          AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP  BY s."cust_id"
     )
ORDER BY "total_profit" DESC
LIMIT 20;
```

```sql
--Description: 9)  (Optional inspection) view profits near the lower end
SELECT *
FROM (
        SELECT s."cust_id",
               SUM( s."quantity_sold" * (cst."unit_price" - cst."unit_cost") ) AS "total_profit"
        FROM   "sales"  AS s
        JOIN   "customers" AS cu
               ON cu."cust_id" = s."cust_id"
        JOIN   "costs"  AS cst
               ON  cst."prod_id"   = s."prod_id"
               AND cst."time_id"   = s."time_id"
               AND cst."channel_id"= s."channel_id"
               AND cst."promo_id"  = s."promo_id"
        WHERE  cu."country_id" IN (
                 SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
               )
          AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
        GROUP  BY s."cust_id"
     )
ORDER BY "total_profit" ASC
LIMIT 20;
```

```sql
--Description: 10)  Display counts of customers falling into 10 equal-width buckets (final structure check)
WITH profits AS (
     SELECT s."cust_id",
            SUM( s."quantity_sold" * (cst."unit_price" - cst."unit_cost") ) AS "total_profit"
     FROM   "sales"  AS s
     JOIN   "customers" AS cu
            ON cu."cust_id" = s."cust_id"
     JOIN   "costs"  AS cst
            ON  cst."prod_id"   = s."prod_id"
            AND cst."time_id"   = s."time_id"
            AND cst."channel_id"= s."channel_id"
            AND cst."promo_id"  = s."promo_id"
     WHERE  cu."country_id" IN (
              SELECT "country_id" FROM "countries" WHERE "country_name" = 'Italy'
            )
       AND  s."time_id" BETWEEN '2021-12-01' AND '2021-12-31'
     GROUP BY s."cust_id"
), bounds AS (
     SELECT MIN("total_profit") AS min_p,
            MAX("total_profit") AS max_p
     FROM   profits
), bucketed AS (
     SELECT p."cust_id",
            p."total_profit",
            CAST( (p."total_profit" - b.min_p) /
                  ((b.max_p - b.min_p) / 10.0) AS INTEGER) AS bucket_no
     FROM   profits AS p
     CROSS JOIN bounds AS b
)
SELECT bucket_no,
       COUNT(*)                           AS customers_in_bucket,
       MIN(total_profit)                  AS min_profit_in_bucket,
       MAX(total_profit)                  AS max_profit_in_bucket
FROM   bucketed
GROUP  BY bucket_no
ORDER BY bucket_no
LIMIT 20;
```

These queries step from locating Italy’s country_id, through identifying Italian customers and their December-2021 sales, to computing individual and aggregated profits, and finally previewing a ten-bucket breakdown of total monthly profits.
