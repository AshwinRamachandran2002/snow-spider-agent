Query:
--Description: 9) Compute, for every product, the absolute difference between
--its month-end inventory and minimum level during 2019, then keep the month
--with the smallest gap (LIMIT 20 so we can preview the result set).  The query
--uses a single WITH RECURSIVE chain—no nested WITH and no stray “recursive”
--keyword inside the CTE list.
WITH RECURSIVE
  /* calendar driver from 2018-12 through 2019-12 */
  months(mth) AS (
      SELECT date('2018-12-01')
      UNION ALL
      SELECT date(mth,'+1 month') FROM months WHERE mth<'2019-12-01'
  ),
  /* incoming & outgoing qty for each product / month (2019 only for speed) */
  in_out AS (
      SELECT  m.mth,
              p.product_id,
              COALESCE(i.qty_in,0)  AS qty_in,
              COALESCE(o.qty_out,0) AS qty_out
      FROM  months AS m
      CROSS JOIN (SELECT DISTINCT product_id FROM inventory) AS p
      LEFT JOIN (
          SELECT  product_id,
                  date(strftime('%Y-%m-01', purchased)) AS mth,
                  SUM(qty) AS qty_in
          FROM    purchases
          WHERE   purchased BETWEEN '2019-01-01' AND '2019-12-31'
          GROUP BY product_id, date(strftime('%Y-%m-01', purchased))
      ) AS i ON i.product_id=p.product_id AND i.mth=m.mth
      LEFT JOIN (
          SELECT  ol.product_id,
                  date(strftime('%Y-%m-01', o.ordered)) AS mth,
                  SUM(ol.qty) AS qty_out
          FROM    orderlines AS ol
          JOIN    orders     AS o ON o.id=ol.order_id
          WHERE   o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
          GROUP BY ol.product_id, date(strftime('%Y-%m-01', o.ordered))
      ) AS o ON o.product_id=p.product_id AND o.mth=m.mth
  ),
  /* opening balance = summed stock on 2018-12-31 */
  start_stock AS (
      SELECT product_id, SUM(qty) AS start_qty
      FROM   inventory
      GROUP  BY product_id
  ),
  mins AS (
      SELECT product_id, qty_minimum, qty_purchase
      FROM   product_minimums
  ),
  /* recursive roll-forward with conditional restock */
  inv(product_id, mth, end_qty) AS (
      /* seed row = December-2018 */
      SELECT s.product_id, date('2018-12-01'), s.start_qty
      FROM   start_stock AS s
      UNION ALL
      SELECT io.product_id,
             io.mth,
             CASE
                 WHEN prev.end_qty + io.qty_in - io.qty_out
                      < COALESCE(mn.qty_minimum, -1e9)
                 THEN prev.end_qty + io.qty_in - io.qty_out
                      + COALESCE(mn.qty_purchase,0)
                 ELSE prev.end_qty + io.qty_in - io.qty_out
             END
      FROM   inv  AS prev
      JOIN   in_out AS io
             ON  io.product_id = prev.product_id
             AND io.mth = date(prev.mth,'+1 month')
      LEFT  JOIN mins AS mn
             ON  mn.product_id = prev.product_id
  ),
  gaps AS (   /* gap to minimum for each 2019 month */
      SELECT  i.product_id,
              i.mth,
              ABS(i.end_qty - mn.qty_minimum) AS gap_to_min
      FROM    inv AS i
      JOIN    mins AS mn USING(product_id)
      WHERE   i.mth BETWEEN '2019-01-01' AND '2019-12-01'
  ),
  ranked AS ( /* rank months by smallest gap */
      SELECT  g.*,
              ROW_NUMBER() OVER(
                   PARTITION BY g.product_id
                   ORDER BY g.gap_to_min, g.mth
              ) AS rn
      FROM    gaps AS g
  )
SELECT  product_id,
        mth  AS month_with_smallest_gap,
        gap_to_min AS abs_difference
FROM    ranked
WHERE   rn=1
LIMIT 20
