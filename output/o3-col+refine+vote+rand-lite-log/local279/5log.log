```sql
--Description: 7) Assemble the three building blocks – opening stock,
--2019 sales, and 2019 purchases – so that later recursion can simply
--look up ‘qty_in’ and ‘qty_out’ for every product / month.
WITH
  months(mth) AS (
      SELECT date('2018-12-01')
      UNION ALL
      SELECT date(mth, '+1 month') FROM months WHERE mth < '2019-12-01'
  ),
  open AS (
      SELECT "product_id", SUM("qty") AS start_qty
      FROM   "inventory"
      GROUP  BY "product_id"
  ),
  ins AS (
      SELECT "product_id",
             date(strftime('%Y-%m-01', "purchased")) AS mth,
             SUM("qty")  AS qty_in
      FROM   "purchases"
      WHERE  "purchased" BETWEEN '2019-01-01' AND '2019-12-31'
      GROUP  BY "product_id", date(strftime('%Y-%m-01', "purchased"))
  ),
  outs AS (
      SELECT ol."product_id",
             date(strftime('%Y-%m-01', o."ordered")) AS mth,
             SUM(ol."qty") AS qty_out
      FROM   "orderlines" AS ol
      JOIN   "orders"     AS o ON o."id" = ol."order_id"
      WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
      GROUP  BY ol."product_id", date(strftime('%Y-%m-01', o."ordered"))
  )
SELECT  m.mth,
        o."product_id",
        COALESCE(ins.qty_in, 0)  AS qty_in,
        COALESCE(outs.qty_out,0) AS qty_out
FROM    months AS m
CROSS JOIN open  AS o
LEFT JOIN ins    ON ins."product_id" = o."product_id" AND ins.mth = m.mth
LEFT JOIN outs   ON outs."product_id"= o."product_id" AND outs.mth = m.mth
LIMIT 20;
```

```sql
--Description: 8) Recursive month-by-month inventory with automatic restock
--whenever ending inventory goes below the minimum.  Shows the running
--ending inventory and the absolute gap to the minimum.
WITH
  months(mth) AS (
      SELECT date('2018-12-01')
      UNION ALL
      SELECT date(mth, '+1 month') FROM months WHERE mth < '2019-12-01'
  ),
  in_out AS (
      SELECT  m.mth,
              p."product_id",
              COALESCE(i.qty_in, 0)  AS qty_in,
              COALESCE(o.qty_out,0)  AS qty_out
      FROM  months AS m
      CROSS JOIN (SELECT DISTINCT "product_id" FROM "inventory") AS p
      LEFT  JOIN (
            SELECT "product_id",
                   date(strftime('%Y-%m-01', "purchased")) AS mth,
                   SUM("qty") AS qty_in
            FROM   "purchases"
            WHERE  "purchased" BETWEEN '2019-01-01' AND '2019-12-31'
            GROUP  BY "product_id", date(strftime('%Y-%m-01', "purchased"))
      ) AS i ON i."product_id" = p."product_id" AND i.mth = m.mth
      LEFT  JOIN (
            SELECT ol."product_id",
                   date(strftime('%Y-%m-01', o."ordered")) AS mth,
                   SUM(ol."qty") AS qty_out
            FROM   "orderlines" AS ol
            JOIN   "orders"     AS o ON o."id" = ol."order_id"
            WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
            GROUP  BY ol."product_id", date(strftime('%Y-%m-01', o."ordered"))
      ) AS o ON o."product_id" = p."product_id" AND o.mth = m.mth
  ),
  start_stock AS (
      SELECT  "product_id",
              SUM("qty") AS start_qty
      FROM    "inventory"
      GROUP BY "product_id"
  ),
  mins AS (
      SELECT  "product_id",
              "qty_minimum",
              "qty_purchase"
      FROM    "product_minimums"
  ),
  recursive inv(product_id, mth, end_qty) AS (
      --seed = December-2018 stock
      SELECT  s."product_id",
              date('2018-12-01') AS mth,
              s.start_qty        AS end_qty
      FROM    start_stock AS s
      
      UNION ALL
      
      --one row per next month
      SELECT  io."product_id",
              io.mth,
              /* inventory roll-forward with conditional restock */
              CASE
                   WHEN prev.end_qty + io.qty_in - io.qty_out < mn.qty_minimum
                   THEN prev.end_qty + io.qty_in - io.qty_out + mn.qty_purchase
                   ELSE prev.end_qty + io.qty_in - io.qty_out
              END  AS end_qty
      FROM    inv  AS prev
      JOIN    in_out AS io
                ON   io."product_id" = prev."product_id"
                AND  io.mth          = date(prev.mth, '+1 month')
      LEFT JOIN mins AS mn
                ON mn."product_id"   = prev."product_id"
  )
SELECT *
FROM   inv
WHERE  mth BETWEEN '2019-01-01' AND '2019-12-01'
LIMIT 20;
```

```sql
--Description: 9) For every product, compute in 2019 the absolute difference
--between ending inventory and its minimum, then keep the month having the
--smallest gap.
WITH
  inv AS (   --same CTE as in #8 but without LIMIT clause
      WITH
        months(mth) AS (
            SELECT date('2018-12-01')
            UNION ALL
            SELECT date(mth, '+1 month') FROM months WHERE mth < '2019-12-01'
        ),
        in_out AS (
            SELECT  m.mth,
                    p."product_id",
                    COALESCE(i.qty_in, 0)  AS qty_in,
                    COALESCE(o.qty_out,0)  AS qty_out
            FROM  months AS m
            CROSS JOIN (SELECT DISTINCT "product_id" FROM "inventory") AS p
            LEFT  JOIN (
                  SELECT "product_id",
                         date(strftime('%Y-%m-01', "purchased")) AS mth,
                         SUM("qty") AS qty_in
                  FROM   "purchases"
                  WHERE  "purchased" BETWEEN '2019-01-01' AND '2019-12-31'
                  GROUP  BY "product_id", date(strftime('%Y-%m-01', "purchased"))
            ) AS i ON i."product_id" = p."product_id" AND i.mth = m.mth
            LEFT  JOIN (
                  SELECT ol."product_id",
                         date(strftime('%Y-%m-01', o."ordered")) AS mth,
                         SUM(ol."qty") AS qty_out
                  FROM   "orderlines" AS ol
                  JOIN   "orders"     AS o ON o."id" = ol."order_id"
                  WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
                  GROUP  BY ol."product_id", date(strftime('%Y-%m-01', o."ordered"))
            ) AS o ON o."product_id" = p."product_id" AND o.mth = m.mth
        ),
        start_stock AS (
            SELECT  "product_id", SUM("qty") AS start_qty
            FROM    "inventory"
            GROUP BY "product_id"
        ),
        mins AS (
            SELECT  "product_id", "qty_minimum", "qty_purchase"
            FROM    "product_minimums"
        ),
        recursive inv(product_id, mth, end_qty) AS (
            SELECT  s."product_id",
                    date('2018-12-01'),
                    s.start_qty
            FROM    start_stock AS s
            UNION ALL
            SELECT  io."product_id",
                    io.mth,
                    CASE
                         WHEN prev.end_qty + io.qty_in - io.qty_out < mn.qty_minimum
                         THEN prev.end_qty + io.qty_in - io.qty_out + mn.qty_purchase
                         ELSE prev.end_qty + io.qty_in - io.qty_out
                    END
            FROM    inv  AS prev
            JOIN    in_out AS io
                       ON io."product_id" = prev."product_id"
                       AND io.mth = date(prev.mth, '+1 month')
            LEFT JOIN mins AS mn ON mn."product_id" = prev."product_id"
        )
      SELECT  *
      FROM    inv
      WHERE   mth BETWEEN '2019-01-01' AND '2019-12-01'
  ),
  mins AS (
      SELECT  "product_id", "qty_minimum"
      FROM    "product_minimums"
  ),
  gaps AS (
      SELECT  i."product_id",
              i.mth,
              ABS(i.end_qty - mn.qty_minimum) AS gap_to_min
      FROM    inv AS i
      JOIN    mins AS mn USING ("product_id")
  ),
  ranked AS (
      SELECT  g.*,
              ROW_NUMBER() OVER (
                   PARTITION BY g."product_id"
                   ORDER BY g.gap_to_min, g.mth
              ) AS rn
      FROM    gaps AS g
  )
SELECT  "product_id",
        mth        AS month_with_smallest_gap,
        gap_to_min AS abs_difference
FROM    ranked
WHERE   rn = 1
LIMIT 20;
```

