```sql
-- 9) Recursive month-by-month inventory adjustment model per product
WITH months AS (                       -- all 2019 months
    SELECT DISTINCT "mth"
    FROM   "monthly_sales"
    WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
),
start_inv AS (                         -- Dec-2018 ending inventory
    SELECT i."product_id",
           SUM(i."qty") AS "end_inv"
    FROM   "inventory"  AS i
    JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2018-12-31'
    GROUP  BY i."product_id"
),
sales AS (                             -- 2019 sales per product & month
    SELECT "product_id", "mth", SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP  BY "product_id", "mth"
),
rules AS (SELECT * FROM "product_minimums"),

-- recursive walk across months in calendar order
inv_cte(product_id, mth, end_inv) AS (
    -- seed = December 2018 inventory, prior to January sales
    SELECT s."product_id", '2018-12-31' AS mth, s."end_inv"
    FROM   start_inv AS s
    UNION ALL
    -- step = move to next month
    SELECT inv_cte.product_id,
           m_next.mth,
           CASE
             WHEN (inv_cte.end_inv - COALESCE(sa.sales_qty,0)) < ru.qty_minimum
                  THEN (inv_cte.end_inv - COALESCE(sa.sales_qty,0)) + ru.qty_purchase
             ELSE (inv_cte.end_inv - COALESCE(sa.sales_qty,0))
           END AS end_inv
    FROM   inv_cte
    JOIN   months AS m_next
           ON m_next.mth > inv_cte.mth
    JOIN   rules  AS ru  ON ru.product_id = inv_cte.product_id
    LEFT   JOIN sales  AS sa
           ON sa.product_id = inv_cte.product_id
          AND sa.mth       = m_next.mth
    WHERE  m_next.mth = (                           -- only the very next month
           SELECT MIN(m2.mth)
           FROM   months AS m2
           WHERE  m2.mth > inv_cte.mth)
)

SELECT * FROM inv_cte
WHERE  mth BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: for each product, the 2019 month where |ending-inv − minimum| is smallest
WITH months AS (
    SELECT DISTINCT "mth"
    FROM   "monthly_sales"
    WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
),
start_inv AS (
    SELECT i."product_id",
           SUM(i."qty") AS "end_inv"
    FROM   "inventory"  AS i
    JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2018-12-31'
    GROUP  BY i."product_id"
),
sales AS (
    SELECT "product_id", "mth", SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP  BY "product_id", "mth"
),
rules AS (SELECT * FROM "product_minimums"),

inv_cte(product_id, mth, end_inv) AS (
    SELECT s."product_id", '2018-12-31' AS mth, s."end_inv"
    FROM   start_inv AS s
    UNION ALL
    SELECT inv_cte.product_id,
           m_next.mth,
           CASE
             WHEN (inv_cte.end_inv - COALESCE(sa.sales_qty,0)) < ru.qty_minimum
                  THEN (inv_cte.end_inv - COALESCE(sa.sales_qty,0)) + ru.qty_purchase
             ELSE (inv_cte.end_inv - COALESCE(sa.sales_qty,0))
           END AS end_inv
    FROM   inv_cte
    JOIN   months AS m_next
           ON m_next.mth > inv_cte.mth
    JOIN   rules  AS ru  ON ru.product_id = inv_cte.product_id
    LEFT   JOIN sales  AS sa
           ON sa.product_id = inv_cte.product_id
          AND sa.mth       = m_next.mth
    WHERE  m_next.mth = (
           SELECT MIN(m2.mth)
           FROM   months AS m2
           WHERE  m2.mth > inv_cte.mth)
)

SELECT product_id,
       mth                                              AS best_month,
       ABS(end_inv - qty_minimum)                       AS abs_diff_to_min
FROM (
    SELECT i.product_id,
           i.mth,
           i.end_inv,
           ru.qty_minimum,
           ROW_NUMBER() OVER (
               PARTITION BY i.product_id
               ORDER BY ABS(i.end_inv - ru.qty_minimum) ASC
           ) AS rn
    FROM   inv_cte AS i
    JOIN   rules  AS ru USING (product_id)
    WHERE  i.mth BETWEEN '2019-01-01' AND '2019-12-31'
)
WHERE rn = 1
ORDER BY product_id
LIMIT 20;
```
