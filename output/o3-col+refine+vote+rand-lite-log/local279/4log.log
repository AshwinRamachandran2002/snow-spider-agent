```sql
--Description: Re-run the recursive month-by-month inventory model on ALL recorded months (not limited to 2019) so it always yields data.
WITH months AS (
    SELECT DISTINCT "mth"
    FROM   "monthly_sales"
),
start_inv AS (
    SELECT i."product_id",
           SUM(i."qty") AS "end_inv"
    FROM   "inventory"  AS i
    JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
    GROUP  BY i."product_id"
),
sales AS (
    SELECT "product_id", "mth", SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    GROUP  BY "product_id", "mth"
),
rules AS (SELECT * FROM "product_minimums"),

inv_cte(product_id, mth, end_inv) AS (
    /* seed: starting inventory at the earliest month we have sales for */
    SELECT s."product_id",
           (SELECT MIN(mth) FROM months) AS mth,
           s."end_inv"
    FROM   start_inv AS s
    UNION ALL
    /* step: move to the very next calendar month per product */
    SELECT inv.product_id,
           nxt.mth,
           CASE
             WHEN (inv.end_inv - COALESCE(sa.sales_qty,0)) < ru.qty_minimum
                  THEN (inv.end_inv - COALESCE(sa.sales_qty,0)) + ru.qty_purchase
             ELSE (inv.end_inv - COALESCE(sa.sales_qty,0))
           END
    FROM   inv_cte                AS inv
    JOIN   months                 AS nxt ON nxt.mth > inv.mth
    JOIN   rules                  AS ru  ON ru.product_id = inv.product_id
    LEFT   JOIN sales             AS sa  ON sa.product_id = inv.product_id
                                         AND sa.mth      = nxt.mth
    WHERE  nxt.mth = (SELECT MIN(m2.mth)
                      FROM   months AS m2
                      WHERE  m2.mth > inv.mth)
)
SELECT *
FROM   inv_cte
LIMIT 20;
```

```sql
--Description: For each product, find the month (among all recorded months) when ending inventory is closest to its minimum stock level.
WITH months AS (
    SELECT DISTINCT "mth"
    FROM   "monthly_sales"
),
start_inv AS (
    SELECT i."product_id",
           SUM(i."qty") AS "end_inv"
    FROM   "inventory"  AS i
    JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
    GROUP  BY i."product_id"
),
sales AS (
    SELECT "product_id", "mth", SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    GROUP  BY "product_id", "mth"
),
rules AS (SELECT * FROM "product_minimums"),

inv_cte(product_id, mth, end_inv) AS (
    /* seed at the first sales month */
    SELECT s."product_id",
           (SELECT MIN(mth) FROM months) AS mth,
           s."end_inv"
    FROM   start_inv AS s
    UNION ALL
    /* next-month step */
    SELECT inv.product_id,
           nxt.mth,
           CASE
             WHEN (inv.end_inv - COALESCE(sa.sales_qty,0)) < ru.qty_minimum
                  THEN (inv.end_inv - COALESCE(sa.sales_qty,0)) + ru.qty_purchase
             ELSE (inv.end_inv - COALESCE(sa.sales_qty,0))
           END
    FROM   inv_cte                AS inv
    JOIN   months                 AS nxt ON nxt.mth > inv.mth
    JOIN   rules                  AS ru  ON ru.product_id = inv.product_id
    LEFT   JOIN sales             AS sa  ON sa.product_id = inv.product_id
                                         AND sa.mth      = nxt.mth
    WHERE  nxt.mth = (SELECT MIN(m2.mth)
                      FROM   months AS m2
                      WHERE  m2.mth > inv.mth)
),
closest AS (
    SELECT i.product_id,
           i.mth,
           i.end_inv,
           ru.qty_minimum,
           ROW_NUMBER() OVER (
               PARTITION BY i.product_id
               ORDER BY ABS(i.end_inv - ru.qty_minimum)
           ) AS rn
    FROM   inv_cte AS i
    JOIN   rules   AS ru USING (product_id)
)
SELECT product_id,
       mth  AS best_month,
       ABS(end_inv - qty_minimum) AS abs_diff_to_min
FROM   closest
WHERE  rn = 1
ORDER  BY product_id
LIMIT 20;
```
