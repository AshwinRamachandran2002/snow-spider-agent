--Description: Re-check December-2018 stock versus minimum levels (this query already worked; kept unchanged).
SELECT d."product_id",
       d."dec18_on_hand",
       pm."qty_minimum",
       (d."dec18_on_hand" - pm."qty_minimum") AS "initial_diff"
FROM (
    SELECT i."product_id",
           SUM(i."qty") AS "dec18_on_hand"
    FROM   "inventory"  AS i
    JOIN   "purchases"  AS p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2018-12-31'
    GROUP  BY i."product_id"
) AS d
JOIN "product_minimums" AS pm  USING ("product_id")
LIMIT 20
