Query:
-- 6)  Build a compact fact table: for each product & month
--     show purchases in, sales out, and the minimum level
WITH months AS (
     SELECT '2019-01' AS mth UNION ALL SELECT '2019-02' UNION ALL
     SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
     SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
     SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
     SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
     SELECT '2019-11' UNION ALL SELECT '2019-12'
), fact AS (
     SELECT
         pm.product_id,
         m.mth,
         IFNULL(pur.purchased_qty, 0) AS purchased_qty,
         IFNULL(sal.sold_qty,     0) AS sold_qty,
         pm.qty_minimum
     FROM months AS m
     CROSS JOIN product_minimums AS pm
     LEFT JOIN (
         SELECT strftime('%Y-%m', purchased) AS mth, product_id, SUM(qty) AS purchased_qty
         FROM   purchases
         WHERE  purchased >= '2019-01-01' AND purchased < '2020-01-01'
         GROUP  BY product_id, mth
     ) AS pur  ON pur.product_id = pm.product_id AND pur.mth = m.mth
     LEFT JOIN (
         SELECT strftime('%Y-%m', o.ordered) AS mth, ol.product_id, SUM(ol.qty) AS sold_qty
         FROM   orderlines AS ol
         JOIN   orders AS o ON o.id = ol.order_id
         WHERE  o.ordered >= '2019-01-01' AND o.ordered < '2020-01-01'
         GROUP  BY ol.product_id, mth
     ) AS sal  ON sal.product_id = pm.product_id AND sal.mth = m.mth
)
SELECT DISTINCT * FROM fact LIMIT 20;
