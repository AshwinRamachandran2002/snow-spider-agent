Query:
--Description: Corrected “step 9 / step 10” combined — 
--re-runs the recursive inventory simulation starting from Dec-2018, computes the
--absolute difference between each 2019 month-end stock and its product-specific
--minimum, ranks the months by that gap (then by month) and returns, for every
--product with a minimum rule, the 2019 month where its ending inventory is
--closest to the minimum (preview limited to 20 rows).
WITH dec AS (
    SELECT
        pm.product_id,
        COALESCE(SUM(i.qty), 0) AS start_qty,
        pm.qty_minimum,
        pm.qty_purchase
    FROM product_minimums AS pm
    LEFT JOIN inventory AS i ON i.product_id = pm.product_id
    GROUP BY pm.product_id
),
months AS (
    SELECT 1 AS seq, '2019-01' AS mth UNION ALL
    SELECT 2, '2019-02' UNION ALL
    SELECT 3, '2019-03' UNION ALL
    SELECT 4, '2019-04' UNION ALL
    SELECT 5, '2019-05' UNION ALL
    SELECT 6, '2019-06' UNION ALL
    SELECT 7, '2019-07' UNION ALL
    SELECT 8, '2019-08' UNION ALL
    SELECT 9, '2019-09' UNION ALL
    SELECT 10, '2019-10' UNION ALL
    SELECT 11, '2019-11' UNION ALL
    SELECT 12, '2019-12'
),
demand AS (
    SELECT strftime('%Y-%m', o.ordered) AS mth,
           ol.product_id,
           SUM(ol.qty) AS sold_qty
    FROM orderlines AS ol
    JOIN orders AS o ON o.id = ol.order_id
    WHERE o.ordered >= '2019-01-01' AND o.ordered < '2020-01-01'
    GROUP BY ol.product_id, mth
),
supply AS (
    SELECT strftime('%Y-%m', purchased) AS mth,
           product_id,
           SUM(qty) AS purch_qty
    FROM purchases
    WHERE purchased >= '2019-01-01' AND purchased < '2020-01-01'
    GROUP BY product_id, mth
),
sim AS (
    -- initial state (end-Dec-2018)
    SELECT
        d.product_id,
        0            AS seq,
        '2018-12'    AS mth,
        d.start_qty  AS opening_qty,
        0            AS purchased_in,
        0            AS sold_out,
        d.start_qty  AS ending_qty
    FROM dec AS d
    UNION ALL
    -- recursive monthly roll-forward through 2019
    SELECT
        s.product_id,
        m.seq,
        m.mth,
        s.ending_qty                                   AS opening_qty,
        IFNULL(sup.purch_qty,0)                        AS purchased_in,
        IFNULL(dem.sold_qty,0)                         AS sold_out,
        CASE
            WHEN (s.ending_qty + IFNULL(sup.purch_qty,0) - IFNULL(dem.sold_qty,0)) < d.qty_minimum
            THEN (s.ending_qty + IFNULL(sup.purch_qty,0) - IFNULL(dem.sold_qty,0)) + d.qty_purchase
            ELSE  (s.ending_qty + IFNULL(sup.purch_qty,0) - IFNULL(dem.sold_qty,0))
        END                                            AS ending_qty
    FROM sim AS s
    JOIN months  AS m   ON m.seq = s.seq + 1
    JOIN dec     AS d   ON d.product_id = s.product_id
    LEFT JOIN supply AS sup ON sup.product_id = s.product_id AND sup.mth = m.mth
    LEFT JOIN demand AS dem ON dem.product_id = s.product_id AND dem.mth = m.mth
),
gap AS (
    SELECT
        product_id,
        mth,
        ABS(ending_qty - (SELECT qty_minimum
                          FROM product_minimums
                          WHERE product_id = sim.product_id)) AS abs_gap
    FROM sim
    WHERE mth LIKE '2019-%'
),
ranked AS (
    SELECT
        g.*,
        ROW_NUMBER() OVER (PARTITION BY product_id
                           ORDER BY abs_gap, mth) AS rn
    FROM gap AS g
)
SELECT
    product_id,
    mth  AS closest_month_in_2019,
    abs_gap
FROM ranked
WHERE rn = 1
ORDER BY product_id
LIMIT 20
