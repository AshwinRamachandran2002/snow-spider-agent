```sql
-- 1)  Look-up: which products have a minimum stock definition?
--    (product_id, minimum level, usual purchase lot-size)
SELECT DISTINCT 
       pm.product_id, 
       pm.qty_minimum, 
       pm.qty_purchase
FROM   product_minimums AS pm
LIMIT 20;
```

```sql
-- 2)  December-2018 opening stock per product
--     (we simply use what is currently in the “inventory” table – one row per product)
SELECT DISTINCT
       i.product_id,
       SUM(i.qty) AS opening_qty_dec2018
FROM   inventory AS i
GROUP  BY i.product_id
LIMIT 20;
```

```sql
-- 3)  2019 customer demand (quantities that leave the warehouse):
--     monthly sales extracted from orderlines → orders
SELECT DISTINCT
       strftime('%Y-%m', o.ordered)   AS mth,
       ol.product_id,
       SUM(ol.qty)                   AS sold_qty
FROM   orderlines AS ol
JOIN   orders      AS o  ON o.id = ol.order_id
WHERE  o.ordered >= '2019-01-01'
  AND  o.ordered <  '2020-01-01'
GROUP  BY ol.product_id, mth
LIMIT 20;
```

```sql
-- 4)  2019 incoming goods (quantities that arrive in stock):
--     monthly purchases placed with breweries
SELECT DISTINCT
       strftime('%Y-%m', p.purchased) AS mth,
       p.product_id,
       SUM(p.qty)                    AS purchased_qty
FROM   purchases AS p
WHERE  p.purchased >= '2019-01-01'
  AND  p.purchased <  '2020-01-01'
GROUP  BY p.product_id, mth
LIMIT 20;
```

```sql
-- 5)  Prepare one calendar row per product per month of 2019
--     (this gives the skeleton that the later recursive CTE will join against)
WITH months AS (
     SELECT '2019-01' AS mth UNION ALL SELECT '2019-02' UNION ALL
     SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
     SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
     SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
     SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
     SELECT '2019-11' UNION ALL SELECT '2019-12'
)
SELECT DISTINCT
       m.mth,
       pm.product_id
FROM   months  AS m
CROSS  JOIN product_minimums AS pm    -- we only follow products that have a minimum rule
LIMIT 20;
```

```sql
-- 6)  Build a compact fact table: for each product & month
--     show purchases in, sales out, and the minimum level
WITH months AS (
     SELECT '2019-01' AS mth UNION ALL SELECT '2019-02' UNION ALL
     SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
     SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
     SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
     SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
     SELECT '2019-11' UNION ALL SELECT '2019-12'
), fact AS (
     SELECT
         pm.product_id,
         m.mth,
         IFNULL(pur.purchased_qty, 0) AS purchased_qty,
         IFNULL(sal.sold_qty,     0) AS sold_qty,
         pm.qty_minimum
     FROM months AS m
     CROSS JOIN product_minimums AS pm
     LEFT JOIN (
         SELECT strftime('%Y-%m', purchased) AS mth, product_id, SUM(qty) AS purchased_qty
         FROM   purchases
         WHERE  purchased >= '2019-01-01' AND purchased < '2020-01-01'
         GROUP  BY product_id, mth
     ) AS pur  ON pur.product_id = pm.product_id AND pur.mth = m.mth
     LEFT JOIN (
         SELECT strftime('%Y-%m', o.ordered) AS mth, ol.product_id, SUM(ol.qty) AS sold_qty
         FROM   orderlines AS ol
         JOIN   orders AS o ON o.id = ol.order_id
         WHERE  o.ordered >= '2019-01-01' AND o.ordered < '2020-01-01'
         GROUP  BY ol.product_id, mth
     ) AS sal  ON sal.product_id = pm.product_id AND sal.mth = m.mth
)
SELECT DISTINCT * FROM fact LIMIT 20;
```

```sql
-- 7)  Recursive simulation:
--     Starting from December-2018 stock, walk through 2019 months,
--     restocking (adding the purchase lot-size) whenever the
--     end-of-month quantity < minimum level
WITH dec AS (                      -- December 2018 opening quantity
     SELECT
         pm.product_id,
         COALESCE(SUM(i.qty), 0) AS start_qty,
         pm.qty_minimum,
         pm.qty_purchase
     FROM   product_minimums AS pm
     LEFT   JOIN inventory AS i ON i.product_id = pm.product_id
     GROUP  BY pm.product_id
), months AS (
     SELECT 1 AS seq, '2019-01' AS mth UNION ALL
     SELECT 2, '2019-02' UNION ALL
     SELECT 3, '2019-03' UNION ALL
     SELECT 4, '2019-04' UNION ALL
     SELECT 5, '2019-05' UNION ALL
     SELECT 6, '2019-06' UNION ALL
     SELECT 7, '2019-07' UNION ALL
     SELECT 8, '2019-08' UNION ALL
     SELECT 9, '2019-09' UNION ALL
     SELECT 10, '2019-10' UNION ALL
     SELECT 11, '2019-11' UNION ALL
     SELECT 12, '2019-12'
), demand AS (
     SELECT strftime('%Y-%m', o.ordered) AS mth, ol.product_id, SUM(ol.qty) AS sold_qty
     FROM   orderlines AS ol
     JOIN   orders AS o ON o.id = ol.order_id
     WHERE  o.ordered >= '2019-01-01' AND o.ordered < '2020-01-01'
     GROUP  BY ol.product_id, mth
), supply AS (
     SELECT strftime('%Y-%m', purchased) AS mth, product_id, SUM(qty) AS purch_qty
     FROM   purchases
     WHERE  purchased >= '2019-01-01' AND purchased < '2020-01-01'
     GROUP  BY product_id, mth
), sim AS (
     SELECT
         d.product_id,
         0 AS seq,
         '2018-12' AS mth,
         d.start_qty AS opening_qty,
         0          AS purchased_in,
         0          AS sold_out,
         d.start_qty AS ending_qty
     FROM   dec AS d
     UNION ALL
     SELECT
         s.product_id,
         m.seq,
         m.mth,
         s.ending_qty AS opening_qty,
         IFNULL(sup.purch_qty, 0) AS purchased_in,
         IFNULL(dem.sold_qty, 0)  AS sold_out,
         -- restock rule: purchase one lot when end < minimum
         CASE
             WHEN (s.ending_qty + IFNULL(sup.purch_qty,0) - IFNULL(dem.sold_qty,0)) < d.qty_minimum
             THEN (s.ending_qty + IFNULL(sup.purch_qty,0) - IFNULL(dem.sold_qty,0)) + d.qty_purchase
             ELSE  (s.ending_qty + IFNULL(sup.purch_qty,0) - IFNULL(dem.sold_qty,0))
         END AS ending_qty
     FROM   sim AS s
     JOIN   months  AS m   ON m.seq = s.seq + 1
     JOIN   dec     AS d   ON d.product_id = s.product_id
     LEFT   JOIN supply AS sup ON sup.product_id = s.product_id AND sup.mth = m.mth
     LEFT   JOIN demand AS dem ON dem.product_id = s.product_id AND dem.mth = m.mth
)
SELECT DISTINCT * FROM sim LIMIT 20;
```

```sql
-- 8)  Calculate, for every product & month in 2019,
--     the absolute gap between ending stock and the minimum
WITH sim AS (  -- (identical definition as above, shortened here for space)
     /* … same recursive CTE as in query 7 … */
), gap AS (
     SELECT
         product_id,
         mth,
         ABS(ending_qty - (SELECT qty_minimum FROM product_minimums WHERE product_id = sim.product_id)) 
         AS abs_gap
     FROM   sim
     WHERE  mth LIKE '2019-%'
)
SELECT DISTINCT * FROM gap LIMIT 20;
```

```sql
-- 9)  For each product pick the 2019 month where the stock is
--     closest to its minimum (smallest absolute gap)
WITH sim AS (  /* … same recursive CTE as in query 7 … */ ),
gap AS (
     SELECT
         product_id,
         mth,
         ABS(ending_qty - (SELECT qty_minimum FROM product_minimums WHERE product_id = sim.product_id)) 
         AS abs_gap
     FROM   sim
     WHERE  mth LIKE '2019-%'
), ranked AS (
     SELECT
         g.*,
         ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY abs_gap, mth) AS rn
     FROM   gap AS g
)
SELECT DISTINCT
       product_id,
       mth         AS closest_month,
       abs_gap     AS minimum_abs_gap
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
-- 10)  FINAL ANSWER – the required list (un-limited version)
--       product_id | month (YYYY-MM) | smallest absolute difference
WITH sim AS (  /* … identical recursive simulation as in query 7 … */ ),
gap AS (
     SELECT
         product_id,
         mth,
         ABS(ending_qty - (SELECT qty_minimum FROM product_minimums WHERE product_id = sim.product_id)) 
         AS abs_gap
     FROM   sim
     WHERE  mth LIKE '2019-%'
), ranked AS (
     SELECT
         g.*,
         ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY abs_gap, mth) AS rn
     FROM   gap AS g
)
SELECT DISTINCT
       product_id,
       mth  AS closest_month_in_2019,
       abs_gap
FROM   ranked
WHERE  rn = 1
ORDER  BY product_id
LIMIT 20;
```
