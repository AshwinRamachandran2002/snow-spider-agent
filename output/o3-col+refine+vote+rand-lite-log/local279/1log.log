Query:
--Description: Preview one product’s month-by-month balance for 2019 using a recursive CTE, 
--             but allow inflows up to 2019-12-31 (not just inside 2019) so we don’t miss earlier purchases.
WITH opening AS (   -- closing stock as of 2018-12-31
    SELECT 6520 AS product_id,
           '2018-12' AS mth,
           COALESCE((
               SELECT SUM(inv.qty)
               FROM inventory inv
               JOIN purchases pur ON pur.id = inv.purchase_id
               WHERE inv.product_id = 6520
                 AND pur.purchased <= '2018-12-31'
           ),0) AS ending_qty
),
mov AS (            -- all inflow/outflow rows up to 2019-12
    SELECT substr(pur.purchased,1,7) AS mth,
           SUM(pur.qty) AS in_qty,
           0            AS out_qty
    FROM purchases pur
    WHERE pur.product_id = 6520
      AND pur.purchased <= '2019-12-31'
    GROUP BY mth
    UNION ALL
    SELECT substr(o.ordered,1,7) AS mth,
           0            AS in_qty,
           SUM(ol.qty)  AS out_qty
    FROM orderlines ol
    JOIN orders o ON o.id = ol.order_id
    WHERE ol.product_id = 6520
      AND o.ordered <= '2019-12-31'
    GROUP BY mth
),
mth_sum AS (        -- collapse duplicate rows
    SELECT mth,
           SUM(in_qty)  AS in_qty,
           SUM(out_qty) AS out_qty
    FROM mov
    GROUP BY mth
),
months AS (         -- hard-wired list of 2019 months
    SELECT '2019-01' AS mth UNION ALL SELECT '2019-02' UNION ALL
    SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
    SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
    SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
    SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
    SELECT '2019-11' UNION ALL SELECT '2019-12'
),
rec AS (            -- recursive running balance
    SELECT
        o.product_id,
        m.mth,
        o.ending_qty
        + COALESCE(ms.in_qty,0)
        - COALESCE(ms.out_qty,0) AS ending_qty
    FROM opening o
    JOIN months  m  ON m.mth = '2019-01'
    LEFT JOIN mth_sum ms ON ms.mth = m.mth
    UNION ALL
    SELECT
        r.product_id,
        m.mth,
        r.ending_qty
        + COALESCE(ms.in_qty,0)
        - COALESCE(ms.out_qty,0)
    FROM rec r
    JOIN months m ON m.mth = strftime('%Y-%m', date(r.mth||'-01','+1 month'))
    LEFT JOIN mth_sum ms ON ms.mth = m.mth
    WHERE m.mth <= '2019-12'
)
SELECT *
FROM rec
LIMIT 20
