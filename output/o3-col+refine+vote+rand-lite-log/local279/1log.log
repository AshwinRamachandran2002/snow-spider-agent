2025-05-05 04:53:25 - Thread-4066 (execute) - INFO - [Exploration]
Below are up-to-10 exploratory SQL statements (each with a brief comment) that help inspect the data needed to build a recursive, month-by-month inventory model (start point: 31-Dec-2018; horizon: calendar-2019).

```sql
--Description: List every product that has a defined minimum level and its purchasing multiple
SELECT DISTINCT product_id, qty_minimum, qty_purchase
FROM product_minimums
LIMIT 20;
```

```sql
--Description: Inspect the on-hand quantity per product coming from purchases
--              that were received on or before 31-Dec-2018 (our opening stock)
SELECT inv.product_id,
       SUM(inv.qty) AS opening_qty
FROM inventory AS inv
JOIN purchases  AS pur ON pur.id = inv.purchase_id
WHERE pur.purchased <= '2018-12-31'
GROUP BY inv.product_id
ORDER BY opening_qty DESC
LIMIT 20;
```

```sql
--Description: Check restocking events in 2019 (purchase receipts)
SELECT DISTINCT pur.product_id,
       substr(pur.purchased, 1, 7) AS mth,   -- e.g. '2019-03'
       SUM(pur.qty) AS purchased_qty
FROM purchases AS pur
WHERE pur.purchased BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY pur.product_id, mth
ORDER BY mth, pur.product_id
LIMIT 20;
```

```sql
--Description: Check sales (outflow) in 2019 per product & month
SELECT DISTINCT ol.product_id,
       substr(o.ordered, 1, 7) AS mth,
       SUM(ol.qty) AS sold_qty
FROM orderlines AS ol
JOIN orders      AS o ON o.id = ol.order_id
WHERE o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY ol.product_id, mth
ORDER BY mth, ol.product_id
LIMIT 20;
```

```sql
--Description: Net inventory movement per product & month in 2019
--              (positive = restock > sales, negative = more sales than restock)
WITH buys AS (
    SELECT pur.product_id,
           substr(pur.purchased, 1, 7) AS mth,
           SUM(pur.qty) AS in_qty
    FROM purchases AS pur
    WHERE pur.purchased BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY pur.product_id, mth
),
sales AS (
    SELECT ol.product_id,
           substr(o.ordered, 1, 7) AS mth,
           SUM(ol.qty) AS out_qty
    FROM orderlines AS ol
    JOIN orders AS o ON o.id = ol.order_id
    WHERE o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY ol.product_id, mth
)
SELECT DISTINCT COALESCE(b.product_id, s.product_id) AS product_id,
       COALESCE(b.mth, s.mth)                         AS mth,
       COALESCE(in_qty,0) - COALESCE(out_qty,0)       AS net_qty
FROM buys  AS b
FULL JOIN sales AS s
  ON b.product_id = s.product_id AND b.mth = s.mth
ORDER BY mth, product_id
LIMIT 20;
```

```sql
--Description: Preview one product’s full 2019 monthly balance using a recursive CTE
--              (choose an example product e.g. 6520 that has a minimum defined)
WITH opening AS (
    SELECT 6520 AS product_id,
           '2018-12' AS mth,
           (SELECT COALESCE(SUM(inv.qty),0)
            FROM inventory AS inv
            JOIN purchases AS pur ON pur.id = inv.purchase_id
            WHERE inv.product_id = 6520
              AND pur.purchased <= '2018-12-31') AS ending_qty
),
mov AS (
    SELECT substr(pur.purchased,1,7) AS mth,
           SUM(pur.qty) AS in_qty,
           0            AS out_qty
    FROM purchases pur
    WHERE pur.product_id = 6520
      AND pur.purchased BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY mth
    UNION ALL
    SELECT substr(o.ordered,1,7) AS mth,
           0            AS in_qty,
           SUM(ol.qty)  AS out_qty
    FROM orderlines ol
    JOIN orders o ON o.id = ol.order_id
    WHERE ol.product_id = 6520
      AND o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY mth
),
mth_sum AS (
    SELECT mth,
           SUM(in_qty)  AS in_qty,
           SUM(out_qty) AS out_qty
    FROM mov
    GROUP BY mth
),
months AS (
    SELECT '2019-01' AS mth UNION ALL SELECT '2019-02' UNION ALL
    SELECT '2019-03' UNION ALL SELECT '2019-04' UNION ALL
    SELECT '2019-05' UNION ALL SELECT '2019-06' UNION ALL
    SELECT '2019-07' UNION ALL SELECT '2019-08' UNION ALL
    SELECT '2019-09' UNION ALL SELECT '2019-10' UNION ALL
    SELECT '2019-11' UNION ALL SELECT '2019-12'
),
rec AS (
    SELECT o.product_id,
           m.mth,
           o.ending_qty
           + COALESCE(ms.in_qty,0)
           - COALESCE(ms.out_qty,0) AS ending_qty
    FROM opening o
    JOIN mth_sum ms ON ms.mth = '2019-01'
    JOIN months  m  ON m.mth = '2019-01'
    UNION ALL
    SELECT r.product_id,
           m.mth,
           r.ending_qty
           + COALESCE(ms.in_qty,0)
           - COALESCE(ms.out_qty,0)
    FROM rec r
    JOIN months   m  ON m.mth = (SELECT strftime('%Y-%m', date(r.mth||'-01','+1 month')))
    LEFT JOIN mth_sum ms ON ms.mth = m.mth
    WHERE m.mth <= '2019-12'
)
SELECT * FROM rec LIMIT 20;
```

```sql
--Description: Verify all products that actually moved (sold or purchased) in 2019
SELECT DISTINCT product_id
FROM (
    SELECT product_id FROM purchases  WHERE purchased BETWEEN '2019-01-01' AND '2019-12-31'
    UNION
    SELECT product_id FROM orderlines ol JOIN orders o ON o.id = ol.order_id
           WHERE o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
) 
LIMIT 20;
```

```sql
--Description: Pick products whose minimum level is not met in opening stock
SELECT DISTINCT pm.product_id,
       pm.qty_minimum,
       COALESCE(op.opening_qty,0) AS opening_qty,
       pm.qty_minimum - COALESCE(op.opening_qty,0) AS shortfall
FROM product_minimums pm
LEFT JOIN (
    SELECT inv.product_id,
           SUM(inv.qty) AS opening_qty
    FROM inventory inv
    JOIN purchases pur ON pur.id = inv.purchase_id
    WHERE pur.purchased <= '2018-12-31'
    GROUP BY inv.product_id
) AS op ON op.product_id = pm.product_id
WHERE COALESCE(op.opening_qty,0) < pm.qty_minimum
LIMIT 20;
```

```sql
--Description: For sanity, list any product that had neither minimum nor any movement (unused in model)
SELECT DISTINCT p.id AS product_id, p.name
FROM products AS p
LEFT JOIN product_minimums pm ON pm.product_id = p.id
LEFT JOIN purchases       pur ON pur.product_id = p.id
LEFT JOIN orderlines      ol  ON ol.product_id  = p.id
WHERE pm.product_id IS NULL
  AND pur.id IS NULL
  AND ol.id  IS NULL
LIMIT 20;
```

These queries give you:  
1) the minimum levels,  
2) opening inventory at 31-Dec-2018,  
3) all 2019 inflows (restocks) and outflows (sales), and  
4) a prototype recursive balance for one product.  
With these pieces you can generalize the recursion to all products, compare each month’s ending balance against its minimum, and finally pick (per product) the 2019 month whose absolute difference is smallest.
