WITH RECURSIVE
/* ------------------------------------------------------------
   basic lookup tables
   ------------------------------------------------------------ */
products_min AS (        -- only products that have minimum levels
    SELECT product_id,
           qty_minimum,
           qty_purchase
    FROM product_minimums
),
opening AS (             -- stock on hand as of 2018-12-31
