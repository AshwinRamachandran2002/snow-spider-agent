Query:
--Description: Net inventory movement per product & month (all years).  
--SQLite lacks FULL JOIN, so we UNION inflow and outflow rows first, then re-aggregate.
WITH movements AS (
  /* inflow rows (purchases) */
  SELECT product_id,
         substr(purchased, 1, 7) AS mth,
         SUM(qty) AS in_qty,
         0       AS out_qty
  FROM purchases
  GROUP BY product_id, mth
  UNION ALL
  /* outflow rows (sales) */
  SELECT ol.product_id,
         substr(o.ordered, 1, 7) AS mth,
         0              AS in_qty,
         SUM(ol.qty)    AS out_qty
  FROM orderlines ol
  JOIN orders o ON o.id = ol.order_id
  GROUP BY ol.product_id, mth
),
agg AS (
  SELECT product_id,
         mth,
         SUM(in_qty)  AS in_qty,
         SUM(out_qty) AS out_qty
  FROM movements
  GROUP BY product_id, mth
)
SELECT product_id,
       mth,
       in_qty - out_qty AS net_qty
FROM agg
ORDER BY mth, product_id
LIMIT 20
