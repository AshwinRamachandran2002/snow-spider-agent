```sql
WITH
/* products that have a minimum level defined */
products_min AS (
    SELECT product_id,
           qty_minimum,
           qty_purchase
    FROM product_minimums
),
/* closing stock as of 2018-12-31 (our opening level for 2019) */
opening AS (
    SELECT  pm.product_id,
            COALESCE((
                SELECT SUM(inv.qty)
                FROM inventory  inv
                JOIN purchases pur ON pur.id = inv.purchase_id
                WHERE inv.product_id = pm.product_id
                  AND pur.purchased <= '2018-12-31'
            ),0) AS opening_qty
    FROM products_min pm
),
/* 2019 inflow (real purchases) */
purch_19 AS (
    SELECT product_id,
           substr(purchased,1,7) AS mth,
           SUM(qty) AS in_qty
    FROM purchases
    WHERE purchased BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY product_id, mth
),
/* 2019 outflow (sales) */
sales_19 AS (
    SELECT ol.product_id,
           substr(o.ordered,1,7) AS mth,
           SUM(ol.qty) AS out_qty
    FROM orderlines ol
    JOIN orders o ON o.id = ol.order_id
    WHERE o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP BY ol.product_id, mth
),
/* merge the two movement lists */
mov AS (
    SELECT product_id,
           mth,
           SUM(in_qty)  AS in_qty,
           SUM(out_qty) AS out_qty
    FROM (
        SELECT product_id, mth, in_qty, 0 AS out_qty FROM purch_19
        UNION ALL
        SELECT product_id, mth, 0 AS in_qty, out_qty FROM sales_19
    )
    GROUP BY product_id, mth
),
/* ------------------------------------------------------------
   Recursive month-by-month balance with automatic restocking
   ------------------------------------------------------------ */
RECURSIVE rec(product_id, mth, ending_qty, qty_minimum, qty_purchase) AS (
    /* first month (2019-01) */
    SELECT
        pm.product_id,
        '2019-01'                       AS mth,
        CASE
            WHEN (op.opening_qty + COALESCE(mv.in_qty,0) - COALESCE(mv.out_qty,0)) < pm.qty_minimum
            THEN (op.opening_qty + COALESCE(mv.in_qty,0) - COALESCE(mv.out_qty,0)) + pm.qty_purchase
            ELSE (op.opening_qty + COALESCE(mv.in_qty,0) - COALESCE(mv.out_qty,0))
        END                              AS ending_qty,
        pm.qty_minimum,
        pm.qty_purchase
    FROM products_min pm
    LEFT JOIN opening op ON op.product_id = pm.product_id
    LEFT JOIN mov     mv ON mv.product_id = pm.product_id
                        AND mv.mth       = '2019-01'

    UNION ALL

    /* subsequent months up to 2019-12 */
    SELECT
        r.product_id,
        strftime('%Y-%m', date(r.mth||'-01','+1 month'))               AS mth,
        CASE
            WHEN (r.ending_qty + COALESCE(mv.in_qty,0) - COALESCE(mv.out_qty,0)) < r.qty_minimum
            THEN (r.ending_qty + COALESCE(mv.in_qty,0) - COALESCE(mv.out_qty,0)) + r.qty_purchase
            ELSE (r.ending_qty + COALESCE(mv.in_qty,0) - COALESCE(mv.out_qty,0))
        END                                                           AS ending_qty,
        r.qty_minimum,
        r.qty_purchase
    FROM rec r
    LEFT JOIN mov mv
           ON mv.product_id = r.product_id
          AND mv.mth        = strftime('%Y-%m', date(r.mth||'-01','+1 month'))
    WHERE r.mth < '2019-12'
),
/* absolute difference between month-end stock and minimum */
diffs AS (
    SELECT product_id,
           mth,
           ABS(ending_qty - qty_minimum) AS diff
    FROM rec
),
min_diff AS (           -- smallest difference per product
    SELECT product_id,
           MIN(diff) AS min_diff
    FROM diffs
    GROUP BY product_id
),
best AS (               -- keep only the month(s) with that minimum difference
    SELECT d.product_id,
           d.mth,
           d.diff
    FROM diffs d
    JOIN min_diff m
      ON m.product_id = d.product_id
     AND m.min_diff   = d.diff
)
/* ------------------------------------------------------------
   Final answer: for each product, the 2019 month where the
   absolute gap to the minimum is smallest (earliest such month
   if there is a tie)
   ------------------------------------------------------------ */
SELECT
    product_id,
    MIN(mth)      AS mth,
    MIN(diff)     AS abs_difference
FROM best
GROUP BY product_id
ORDER BY product_id;
```
