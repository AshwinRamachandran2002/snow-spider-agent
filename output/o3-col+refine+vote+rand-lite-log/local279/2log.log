```sql
--Description: Monthly incoming (restock) quantities during 2019  
SELECT strftime('%Y-%m', p.purchased) AS mth,
       p.product_id,
       SUM(p.qty) AS purchased_qty
FROM purchases AS p
WHERE p.purchased >= '2019-01-01'
  AND p.purchased <  '2020-01-01'
GROUP BY mth, p.product_id
ORDER BY mth, p.product_id
LIMIT 20;
```

```sql
--Description: Monthly outgoing quantities (sales) based on customer orders in 2019  
SELECT strftime('%Y-%m', o.ordered) AS mth,
       ol.product_id,
       SUM(ol.qty) AS sold_qty
FROM orderlines AS ol
JOIN orders     AS o  ON o.id = ol.order_id
WHERE o.ordered >= '2019-01-01'
  AND o.ordered <  '2020-01-01'
GROUP BY mth, ol.product_id
ORDER BY mth, ol.product_id
LIMIT 20;
```

```sql
--Description: Pre-aggregated monthly sales rows already stored for 2019  
SELECT product_id, mth, qty
FROM monthly_sales
WHERE mth >= '2019-01-01'
  AND mth <= '2019-12-01'
LIMIT 20;
```

```sql
--Description: Budgeted / planned usage per month for 2019  
