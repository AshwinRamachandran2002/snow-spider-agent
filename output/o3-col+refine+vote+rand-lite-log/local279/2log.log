FROM monthly_budget
WHERE mth >= '2019-01-01'
  AND mth <= '2019-12-01'
LIMIT 20;
```

```sql
--Description: Current deviation between stock on hand and the minimum required level  
SELECT pm.product_id,
       SUM(i.qty)              AS stock_qty,
       pm.qty_minimum,
       ABS(SUM(i.qty) - pm.qty_minimum) AS abs_diff
FROM product_minimums AS pm
LEFT JOIN inventory      AS i ON i.product_id = pm.product_id
GROUP BY pm.product_id, pm.qty_minimum
ORDER BY abs_diff
LIMIT 20;
```

```sql
--Description: Recursive month-by-month inventory projection for product 6520 across 2019  
WITH RECURSIVE months(mth) AS (
    SELECT '2019-01-01'
    UNION ALL
    SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
init AS (
    SELECT 6520 AS product_id,
           COALESCE(SUM(i.qty),0) AS start_qty
    FROM inventory i
    WHERE i.product_id = 6520
),
flow AS (
    SELECT m.mth,
           init.product_id,
           init.start_qty                                               AS starting,
           (SELECT COALESCE(SUM(ol.qty),0)
              FROM orderlines ol
              JOIN orders o ON o.id = ol.order_id
             WHERE ol.product_id = init.product_id
               AND o.ordered >= m.mth
               AND o.ordered <  date(m.mth,'+1 month'))                AS sold,
           (SELECT COALESCE(SUM(p.qty),0)
              FROM purchases p
             WHERE p.product_id = init.product_id
               AND p.purchased >= m.mth
               AND p.purchased <  date(m.mth,'+1 month'))              AS bought
    FROM months m, init
),
inv AS (
    SELECT mth,
           product_id,
           starting - sold + bought AS ending_qty
    FROM flow
)
SELECT * FROM inv
LIMIT 20;
```

```sql
--Description: Month in 2019 where product 6520’s ending inventory is closest to its minimum level  
WITH RECURSIVE months(mth) AS (
    SELECT '2019-01-01'
    UNION ALL SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
base AS (
    SELECT COALESCE(SUM(i.qty),0) AS opening
    FROM inventory i
    WHERE i.product_id = 6520
),
inv AS (
    SELECT m.mth,
           base.opening
             - (SELECT COALESCE(SUM(ol.qty),0)
                  FROM orderlines ol
                  JOIN orders o ON o.id = ol.order_id
                 WHERE ol.product_id = 6520
                   AND o.ordered >= m.mth
                   AND o.ordered < date(m.mth,'+1 month'))
             + (SELECT COALESCE(SUM(p.qty),0)
                  FROM purchases p
                 WHERE p.product_id = 6520
                   AND p.purchased >= m.mth
                   AND p.purchased < date(m.mth,'+1 month'))           AS ending_qty
    FROM months m, base
),
diffs AS (
    SELECT mth,
           ABS(ending_qty - (SELECT qty_minimum FROM product_minimums WHERE product_id = 6520)) AS abs_diff
    FROM inv
)
SELECT mth AS closest_month, abs_diff
FROM diffs
ORDER BY abs_diff ASC
LIMIT 20;
```
