Query:
--Description: This query also purposefully targets 2019 to find the month the inventory is closest to the minimum; no correction needed.
WITH RECURSIVE months(mth) AS (
    SELECT '2019-01-01'
    UNION ALL SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
base AS (
    SELECT COALESCE(SUM(i.qty),0) AS opening
    FROM inventory i
    WHERE i.product_id = 6520
),
inv AS (
    SELECT m.mth,
           base.opening
             - (SELECT COALESCE(SUM(ol.qty),0)
                  FROM orderlines ol
                  JOIN orders o ON o.id = ol.order_id
                 WHERE ol.product_id = 6520
                   AND o.ordered >= m.mth
                   AND o.ordered < date(m.mth,'+1 month'))
             + (SELECT COALESCE(SUM(p.qty),0)
                  FROM purchases p
                 WHERE p.product_id = 6520
                   AND p.purchased >= m.mth
                   AND p.purchased < date(m.mth,'+1 month'))           AS ending_qty
    FROM months m, base
),
diffs AS (
    SELECT mth,
           ABS(ending_qty - (SELECT qty_minimum FROM product_minimums WHERE product_id = 6520)) AS abs_diff
    FROM inv
)
SELECT mth AS closest_month,
       abs_diff
FROM diffs
ORDER BY abs_diff
LIMIT 20
