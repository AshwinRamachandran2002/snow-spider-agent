             WHERE ol.product_id = init.product_id
               AND o.ordered >= m.mth
               AND o.ordered <  date(m.mth,'+1 month'))                AS sold,
           (SELECT COALESCE(SUM(p.qty),0)
              FROM purchases p
             WHERE p.product_id = init.product_id
               AND p.purchased >= m.mth
               AND p.purchased <  date(m.mth,'+1 month'))              AS bought
    FROM months m, init
),
inv AS (
