2025-05-05 04:53:07 - Thread-4071 (execute) - INFO - [Exploration]
Here are some exploration queries that look at the tables involved in inventory levels, product minimum rules, and the 2019 activity that may change stock.  

```sql
--Description: 1) List every product that has a minimum-stock rule together with its minimum and purchase-batch quantities
SELECT DISTINCT
       "product_id",
       "qty_minimum",
       "qty_purchase"
FROM   "product_minimums"
LIMIT 20;
```

```sql
--Description: 2) Show the on-hand inventory lots for those products, together with the purchase date (useful for finding Dec-2018 ending levels)
SELECT DISTINCT
       i."id"           AS "inv_id",
       i."product_id",
       i."qty",
       p."purchased"
FROM   "inventory" AS i
JOIN   "purchases" AS p
       ON p."id" = i."purchase_id"
WHERE  i."product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 3) Check December-2018 inventory only (ending balance snapshot candidates)
SELECT DISTINCT
       i."product_id",
       i."qty",
       p."purchased"
FROM   "inventory" AS i
JOIN   "purchases" AS p
       ON p."id" = i."purchase_id"
WHERE  p."purchased" <= '2018-12-31'
  AND  i."product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 4) Look at purchases made during 2019 that would increase stock
SELECT DISTINCT
       "product_id",
       "qty",
       "purchased"
FROM   "purchases"
WHERE  "purchased" BETWEEN '2019-01-01' AND '2019-12-31'
  AND  "product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 5) Examine outgoing sales orders in 2019 (these reduce inventory)
SELECT DISTINCT
       ol."product_id",
       ol."qty",
       o."ordered"
FROM   "orderlines" AS ol
JOIN   "orders"     AS o
       ON o."id" = ol."order_id"
WHERE  o."ordered" BETWEEN '2019-01-01' AND '2019-12-31'
  AND  ol."product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 6) Review 2019 monthly sales quantities recorded in the monthly_sales table
SELECT DISTINCT
       "product_id",
       "mth",
       "qty"
FROM   "monthly_sales"
WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
  AND  "product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 7) Inspect any 2019 monthly budget targets (can serve as demand proxies) 
SELECT DISTINCT
       "product_id",
       "mth",
       "qty"
FROM   "monthly_budget"
WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
  AND  "product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 8) Check if there are picking lines in 2019 that moved stock (another outflow source)
SELECT DISTINCT
       "product_id",
       "qty",
       "order_id",
       pl."picklist_id"
FROM   "picking_line" AS pl
JOIN   "picking_list" AS plst
       ON pl."picklist_id" = plst."id"
WHERE  plst."created" BETWEEN '2019-01-01' AND '2019-12-31'
  AND  pl."product_id" IN (SELECT "product_id" FROM "product_minimums")
LIMIT 20;
```

```sql
--Description: 9) Summarise (Dec-2018) on-hand quantity per product to use as starting inventory
SELECT DISTINCT
       i."product_id",
       SUM(i."qty") AS "qty_on_hand_dec2018"
FROM   "inventory" AS i
JOIN   "purchases" AS p
       ON p."id" = i."purchase_id"
WHERE  p."purchased" <= '2018-12-31'
  AND  i."product_id" IN (SELECT "product_id" FROM "product_minimums")
GROUP  BY i."product_id"
LIMIT 20;
```

```sql
--Description: 10) Get the minimum-required level again (to be joined with simulated ending inventories)
SELECT DISTINCT
       "product_id",
       "qty_minimum"
FROM   "product_minimums"
LIMIT 20;
```
