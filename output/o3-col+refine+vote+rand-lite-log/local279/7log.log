)
SELECT * FROM cal;
```

```sql
-- 10. Recursive monthly inventory model & final answer:
WITH RECURSIVE
cal(mth) AS (                -- 12 calendar months for 2019
    VALUES('2019-01')
    UNION ALL
    SELECT strftime('%Y-%m', date(mth||'-01','start of month','+1 month'))
    FROM   cal
    WHERE  mth < '2019-12'
),
start_inv AS (               -- closing stock 31-Dec-2018
    SELECT i."product_id",
           SUM(i."qty") AS "qty"
    FROM   "inventory" i
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2018-12-31'
    GROUP  BY i."product_id"
),
sales AS (                    -- 2019 sales by product & month
    SELECT "product_id",
           substr("mth",1,7) AS "mth",
           SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP  BY 1,2
),
minlvl AS (                   -- minimum & purchase-to
    SELECT * FROM "product_minimums"
),
products AS (                 -- universe of products to model
    SELECT "product_id" FROM minlvl
    UNION
    SELECT "product_id" FROM start_inv
    UNION
    SELECT "product_id" FROM sales
),
rec AS (                      -- recursive inventory adjustment, month by month
    SELECT p."product_id"                    AS prod,
           '2019-01'                         AS mth,
           COALESCE(sinv.qty,0)              AS beg_qty,
           COALESCE(s1.sales_qty,0)          AS sales_qty,
           COALESCE(sinv.qty,0)-COALESCE(s1.sales_qty,0) AS end_qty
    FROM   products  p
    LEFT JOIN start_inv sinv ON sinv."product_id" = p."product_id"
    LEFT JOIN sales     s1   ON s1."product_id" = p."product_id" AND s1.mth='2019-01'
    
    UNION ALL
    
    SELECT r.prod,
           c2.mth,
           CASE WHEN r.end_qty < ml.qty_minimum
                THEN r.end_qty + ml.qty_purchase
                ELSE r.end_qty
           END                                AS beg_qty,
           COALESCE(s2.sales_qty,0)           AS sales_qty,
           CASE WHEN r.end_qty < ml.qty_minimum
                THEN r.end_qty + ml.qty_purchase
                ELSE r.end_qty
           END - COALESCE(s2.sales_qty,0)     AS end_qty
    FROM   rec              r
    JOIN   cal              c1 ON c1.mth = r.mth
    JOIN   cal              c2 ON c2.mth = strftime('%Y-%m', date(c1.mth||'-01','start of month','+1 month'))
    JOIN   minlvl           ml  ON ml."product_id" = r.prod
    LEFT JOIN sales         s2  ON s2."product_id" = r.prod AND s2.mth = c2.mth
    WHERE  c2.mth <= '2019-12'
)
, diff AS (                   -- absolute deviation from minimum each month
    SELECT r.prod      AS product_id,
           r.mth,
           ABS(r.end_qty - ml.qty_minimum) AS abs_diff
    FROM   rec  r
    JOIN   minlvl ml ON ml."product_id" = r.prod
)
SELECT d1.product_id,
       d1.mth,
       d1.abs_diff
FROM   diff d1
JOIN   (
    SELECT product_id,
           MIN(abs_diff) AS best
    FROM   diff
    GROUP  BY product_id
) d2 ON d2.product_id = d1.product_id
     AND d2.best       = d1.abs_diff
ORDER BY d1.product_id;
```
