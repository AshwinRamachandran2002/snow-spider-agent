),
start_inv AS (                             -- closing stock 31-Dec-2017
    SELECT i."product_id",
           SUM(i."qty") AS "qty"
    FROM   "inventory" i
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2017-12-31'
    GROUP  BY i."product_id"
),
sales AS (                                 -- 2018 sales by product & month
    SELECT "product_id",
           substr("mth",1,7) AS "mth",
           SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    WHERE  "mth" LIKE '2018-%'
    GROUP  BY 1,2
),
minlvl AS (                                -- minimum & purchase-to
    SELECT * FROM "product_minimums"
),
products AS (                              -- union of all products we must simulate
    SELECT "product_id" FROM minlvl
    UNION
    SELECT "product_id" FROM start_inv
    UNION
    SELECT "product_id" FROM sales
),
rec AS (                                   -- month-by-month recursive adjustment
    SELECT p."product_id" AS prod,
           '2018-01'      AS mth,
           COALESCE(si.qty,0)              AS beg_qty,
           COALESCE(ss.sales_qty,0)        AS sales_qty,
           COALESCE(si.qty,0) - COALESCE(ss.sales_qty,0) AS end_qty
    FROM   products  p
    LEFT  JOIN start_inv si ON si."product_id" = p."product_id"
    LEFT  JOIN sales     ss ON ss."product_id" = p."product_id"
                             AND ss.mth = '2018-01'

    UNION ALL

    SELECT r.prod,
           nxt.mth,
           CASE WHEN r.end_qty < ml.qty_minimum
                THEN r.end_qty + ml.qty_purchase   -- restock
                ELSE r.end_qty
