--Description: 10. Full recursive inventory-adjustment model for 2018 (starting Dec-2017 stock); returns the month in 2018 where each product’s ending inventory is closest to its minimum level.
WITH RECURSIVE
cal(mth) AS (                              -- calendar for 2018
    VALUES('2018-01')
    UNION ALL
    SELECT strftime('%Y-%m', date(mth||'-01','start of month','+1 month'))
    FROM   cal
    WHERE  mth < '2018-12'
),
start_inv AS (                             -- closing stock 31-Dec-2017
    SELECT i."product_id",
           SUM(i."qty") AS "qty"
    FROM   "inventory" i
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2017-12-31'
    GROUP  BY i."product_id"
),
sales AS (                                 -- 2018 sales by product & month
    SELECT "product_id",
           substr("mth",1,7) AS "mth",
           SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    WHERE  "mth" LIKE '2018-%'
    GROUP  BY 1,2
),
minlvl AS (                                -- minimum & purchase-to
    SELECT * FROM "product_minimums"
),
products AS (                              -- union of all products we must simulate
    SELECT "product_id" FROM minlvl
    UNION
    SELECT "product_id" FROM start_inv
    UNION
    SELECT "product_id" FROM sales
),
rec AS (                                   -- month-by-month recursive adjustment
    SELECT p."product_id" AS prod,
           '2018-01'      AS mth,
           COALESCE(si.qty,0)              AS beg_qty,
           COALESCE(ss.sales_qty,0)        AS sales_qty,
           COALESCE(si.qty,0) - COALESCE(ss.sales_qty,0) AS end_qty
    FROM   products  p
    LEFT  JOIN start_inv si ON si."product_id" = p."product_id"
    LEFT  JOIN sales     ss ON ss."product_id" = p."product_id"
                             AND ss.mth = '2018-01'

    UNION ALL

    SELECT r.prod,
           nxt.mth,
           CASE WHEN r.end_qty < ml.qty_minimum
                THEN r.end_qty + ml.qty_purchase   -- restock
                ELSE r.end_qty
           END                     AS beg_qty,
           COALESCE(s2.sales_qty,0)                AS sales_qty,
           CASE WHEN r.end_qty < ml.qty_minimum
                THEN r.end_qty + ml.qty_purchase
                ELSE r.end_qty
           END - COALESCE(s2.sales_qty,0)          AS end_qty
    FROM   rec      r
    JOIN   cal      cur ON cur.mth = r.mth
    JOIN   cal      nxt ON nxt.mth = strftime('%Y-%m', date(cur.mth||'-01','+1 month'))
    JOIN   minlvl   ml  ON ml."product_id" = r.prod
    LEFT  JOIN sales    s2 ON s2."product_id" = r.prod AND s2.mth = nxt.mth
    WHERE  nxt.mth <= '2018-12'
),
diff AS (                                   -- absolute deviation from minimum
    SELECT r.prod AS product_id,
           r.mth,
           ABS(r.end_qty - ml.qty_minimum) AS abs_diff
    FROM   rec r
    JOIN   minlvl ml ON ml."product_id" = r.prod
)
SELECT d1.product_id,
       d1.mth,
       d1.abs_diff
FROM   diff d1
JOIN  ( SELECT product_id, MIN(abs_diff) AS best
        FROM   diff
        GROUP  BY product_id ) AS b
      ON  b.product_id = d1.product_id
      AND b.best        = d1.abs_diff
ORDER BY d1.product_id
