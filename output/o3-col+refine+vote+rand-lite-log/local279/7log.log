```sql
-- 6. Derive the closing inventory as at 31-Dec-2018 (sum of lots bought on/before that date).
SELECT i."product_id",
       SUM(i."qty") AS "dec18_end_inventory"
FROM   "inventory"  AS i
JOIN   "purchases" AS p ON p."id" = i."purchase_id"
WHERE  p."purchased" <= '2018-12-31'
GROUP  BY i."product_id"
LIMIT 20;
```

```sql
-- 7. Aggregate sales quantities per product & month for calendar-year 2019.
SELECT "product_id",
       substr("mth",1,7) AS "month",
       SUM("qty")        AS "sales_qty"
FROM   "monthly_sales"
WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
GROUP  BY "product_id", substr("mth",1,7)
LIMIT 20;
```

```sql
-- 8. Put the ingredients together: starting stock, minimums, purchase-to levels, and 2019 sales.
SELECT mr."product_id",
       mr."qty_minimum",
       mr."qty_purchase",
       si."dec18_end_inventory",
       s."month",
       s."sales_qty"
FROM   "product_minimums"  AS mr
LEFT JOIN (
    SELECT i."product_id", SUM(i."qty") AS "dec18_end_inventory"
    FROM   "inventory"  i
    JOIN   "purchases" p ON p."id" = i."purchase_id"
    WHERE  p."purchased" <= '2018-12-31'
    GROUP  BY i."product_id"
) AS si ON si."product_id" = mr."product_id"
LEFT JOIN (
    SELECT "product_id", substr("mth",1,7) AS "month", SUM("qty") AS "sales_qty"
    FROM   "monthly_sales"
    WHERE  "mth" BETWEEN '2019-01-01' AND '2019-12-31'
    GROUP  BY "product_id", substr("mth",1,7)
) AS s ON s."product_id" = mr."product_id"
LIMIT 20;
```

