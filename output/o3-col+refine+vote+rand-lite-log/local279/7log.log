--Description: 8. Combine minimum levels, purchase-to levels, starting inventory (Dec-2017 close) and 2018 monthly sales so we can see all inputs in one place.
SELECT mr."product_id",
       mr."qty_minimum",
       mr."qty_purchase",
       si."dec17_end_inventory",
       s."month",
       s."sales_qty"
FROM   "product_minimums" AS mr
LEFT  JOIN (
      SELECT i."product_id",
             SUM(i."qty") AS "dec17_end_inventory"
      FROM   "inventory" i
      JOIN   "purchases" p ON p."id" = i."purchase_id"
      WHERE  p."purchased" <= '2017-12-31'
      GROUP  BY i."product_id"
) AS si ON si."product_id" = mr."product_id"
LEFT  JOIN (
      SELECT "product_id",
             substr("mth",1,7) AS "month",
             SUM("qty") AS "sales_qty"
      FROM   "monthly_sales"
      WHERE  "mth" LIKE '2018-%'
      GROUP  BY "product_id", substr("mth",1,7)
) AS s  ON s."product_id" = mr."product_id"
LIMIT 20
