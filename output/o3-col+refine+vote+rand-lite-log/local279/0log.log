--Description: Recursive inventory calculation for EVERY product that has a
--minimum rule, producing the ending inventory for each month in 2019.
WITH RECURSIVE
months(mth) AS (
       SELECT '2019-01-01'
       UNION ALL
       SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
start_inv AS (
       SELECT pm.product_id,
              pm.qty_minimum,
              pm.qty_purchase,
              COALESCE(SUM(i.qty),0) AS start_qty
       FROM   product_minimums pm
       LEFT   JOIN inventory i ON i.product_id = pm.product_id
       LEFT   JOIN purchases p ON p.id = i.purchase_id
                              AND p.purchased <= '2018-12-31'
       GROUP  BY pm.product_id
),
sales AS (
       SELECT ol.product_id,
              substr(o.ordered,1,7)||'-01' AS mth,
              SUM(ol.qty) AS sold
       FROM   orderlines ol
       JOIN   orders     o ON o.id = ol.order_id
       WHERE  o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
       GROUP  BY ol.product_id, substr(o.ordered,1,7)
),
seed AS (
       SELECT si.product_id,
              si.qty_minimum,
              si.qty_purchase,
              m.mth,
              si.start_qty                  AS begin_inv,
              COALESCE(s.sold,0)            AS sold_qty,
              1                             AS rn                -- row number helper
       FROM   start_inv si
       CROSS  JOIN months   m
       LEFT   JOIN sales    s ON s.product_id = si.product_id
                             AND s.mth       = m.mth
),
calc AS (
       -- January rows
       SELECT product_id, qty_minimum, qty_purchase, mth,
              begin_inv - sold_qty                       AS tmp_inv,
              sold_qty
       FROM   seed
       WHERE  mth = '2019-01-01'
       UNION ALL
       -- February..December rows
       SELECT s.product_id, s.qty_minimum, s.qty_purchase, s.mth,
              (CASE
                   WHEN (c.tmp_inv < s.qty_minimum)
                   THEN c.tmp_inv + s.qty_purchase
                   ELSE c.tmp_inv
              END) - s.sold_qty                          AS tmp_inv,
              s.sold_qty
       FROM   calc c
       JOIN   seed s ON s.product_id = c.product_id
                    AND s.mth        = date(c.mth,'+1 month')
)
SELECT *
FROM   calc
LIMIT 20;
