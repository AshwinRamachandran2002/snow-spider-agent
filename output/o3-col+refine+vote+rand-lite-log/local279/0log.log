                   WHEN c.end_inv - COALESCE(s.sold,0) < params.qty_minimum
                   THEN c.end_inv - COALESCE(s.sold,0) + params.qty_purchase
                   ELSE c.end_inv - COALESCE(s.sold,0)
              END
       FROM   calc   c
       JOIN   months m ON m.mth = date(c.mth,'+1 month')
       LEFT   JOIN sales  s ON s.mth = m.mth
       CROSS  JOIN params
)
SELECT
