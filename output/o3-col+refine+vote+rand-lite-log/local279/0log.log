--Description: Compute the ending inventory for January-2019 only (before applying
--any “top-up” logic) so we can see the basic arithmetic.
WITH jan_sales AS (
       SELECT ol.product_id, SUM(ol.qty) AS sold
       FROM   orderlines ol
       JOIN   orders    o  ON o.id = ol.order_id
       WHERE  o.ordered BETWEEN '2019-01-01' AND '2019-01-31'
       GROUP  BY ol.product_id
),
start_inv AS (
       SELECT i.product_id, SUM(i.qty) AS start_qty
       FROM   inventory i
       JOIN   purchases p ON p.id = i.purchase_id
       WHERE  p.purchased <= '2018-12-31'
       GROUP  BY i.product_id
)
SELECT
       pm.product_id,
       si.start_qty,
       COALESCE(js.sold,0)                    AS jan_sold,
       (si.start_qty - COALESCE(js.sold,0))   AS jan_end_inv
FROM   product_minimums pm
LEFT   JOIN start_inv si USING(product_id)
LEFT   JOIN jan_sales js ON js.product_id = pm.product_id
LIMIT 20;
