```sql
--Description: Put the minimum rules, the starting inventory (as of 31-Dec-2018),
--and the calendar months side-by-side to create the skeleton for the model.
WITH RECURSIVE months(mth) AS (
       SELECT '2019-01-01'
       UNION ALL
       SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
start_inv AS (
       SELECT i.product_id, SUM(i.qty) AS start_qty
       FROM   inventory i
       JOIN   purchases p ON p.id = i.purchase_id
       WHERE  p.purchased <= '2018-12-31'
       GROUP  BY i.product_id
)
SELECT
       pm.product_id,
       pm.qty_minimum,
       pm.qty_purchase,
       si.start_qty,
       m.mth
FROM   product_minimums AS pm
LEFT   JOIN start_inv  AS si ON si.product_id = pm.product_id
CROSS  JOIN months     AS m
ORDER  BY pm.product_id, m.mth
LIMIT 20;
```

```sql
--Description: Compute the ending inventory for January-2019 only (before applying
--any “top-up” logic) so we can see the basic arithmetic.
WITH jan_sales AS (
       SELECT ol.product_id, SUM(ol.qty) AS sold
       FROM   orderlines ol
       JOIN   orders    o  ON o.id = ol.order_id
       WHERE  o.ordered BETWEEN '2019-01-01' AND '2019-01-31'
       GROUP  BY ol.product_id
),
start_inv AS (
       SELECT i.product_id, SUM(i.qty) AS start_qty
       FROM   inventory i
       JOIN   purchases p ON p.id = i.purchase_id
       WHERE  p.purchased <= '2018-12-31'
       GROUP  BY i.product_id
)
SELECT
       pm.product_id,
       si.start_qty,
       COALESCE(js.sold,0)                    AS jan_sold,
       (si.start_qty - COALESCE(js.sold,0))   AS jan_end_inv
FROM   product_minimums pm
LEFT   JOIN start_inv si USING(product_id)
LEFT   JOIN jan_sales js ON js.product_id = pm.product_id
LIMIT 20;
```

```sql
--Description: Full month-by-month, restock-aware inventory simulation for ONE
--example product (id = 6520).  A purchase is triggered whenever the ending
--inventory would fall below the minimum.
WITH RECURSIVE
months(mth) AS (
       SELECT '2019-01-01'
       UNION ALL
       SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
sales AS (
       SELECT substr(o.ordered,1,7)||'-01' AS mth, SUM(ol.qty) AS sold
       FROM   orderlines ol
       JOIN   orders    o  ON o.id = ol.order_id
       WHERE  ol.product_id = 6520
         AND  o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
       GROUP  BY substr(o.ordered,1,7)
),
params AS (
       SELECT pm.qty_minimum,
              pm.qty_purchase,
              COALESCE( (SELECT SUM(i.qty)
                         FROM   inventory i
                         JOIN   purchases p ON p.id = i.purchase_id
                         WHERE  i.product_id = 6520
                           AND  p.purchased <= '2018-12-31'), 0) AS start_inv
       FROM   product_minimums pm
       WHERE  pm.product_id = 6520
),
calc(mth,end_inv) AS (
       -- January
       SELECT m.mth,
              CASE
                   WHEN params.start_inv - COALESCE(s.sold,0) < params.qty_minimum
                   THEN params.start_inv - COALESCE(s.sold,0) + params.qty_purchase
                   ELSE params.start_inv - COALESCE(s.sold,0)
              END
       FROM   months m
       LEFT   JOIN sales  s USING(mth)
       CROSS  JOIN params
       WHERE  m.mth = '2019-01-01'
       UNION ALL
       -- February .. December
       SELECT date(c.mth,'+1 month'),
              CASE
                   WHEN c.end_inv - COALESCE(s.sold,0) < params.qty_minimum
                   THEN c.end_inv - COALESCE(s.sold,0) + params.qty_purchase
                   ELSE c.end_inv - COALESCE(s.sold,0)
              END
       FROM   calc   c
       JOIN   months m ON m.mth = date(c.mth,'+1 month')
       LEFT   JOIN sales  s ON s.mth = m.mth
       CROSS  JOIN params
)
SELECT
       mth,
       end_inv,
       params.qty_minimum          AS minimum_req,
       ABS(end_inv - params.qty_minimum) AS abs_diff
FROM   calc, params
ORDER  BY mth
LIMIT 20;
```

```sql
--Description: Recursive inventory calculation for EVERY product that has a
--minimum rule, producing the ending inventory for each month in 2019.
WITH RECURSIVE
months(mth) AS (
       SELECT '2019-01-01'
       UNION ALL
       SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
start_inv AS (
       SELECT pm.product_id,
              pm.qty_minimum,
              pm.qty_purchase,
              COALESCE(SUM(i.qty),0) AS start_qty
       FROM   product_minimums pm
       LEFT   JOIN inventory i ON i.product_id = pm.product_id
       LEFT   JOIN purchases p ON p.id = i.purchase_id
                              AND p.purchased <= '2018-12-31'
       GROUP  BY pm.product_id
),
sales AS (
       SELECT ol.product_id,
              substr(o.ordered,1,7)||'-01' AS mth,
              SUM(ol.qty) AS sold
       FROM   orderlines ol
       JOIN   orders     o ON o.id = ol.order_id
       WHERE  o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
       GROUP  BY ol.product_id, substr(o.ordered,1,7)
),
seed AS (
       SELECT si.product_id,
              si.qty_minimum,
              si.qty_purchase,
              m.mth,
              si.start_qty                  AS begin_inv,
              COALESCE(s.sold,0)            AS sold_qty,
              1                             AS rn                -- row number helper
       FROM   start_inv si
       CROSS  JOIN months   m
       LEFT   JOIN sales    s ON s.product_id = si.product_id
                             AND s.mth       = m.mth
),
calc AS (
       -- January rows
       SELECT product_id, qty_minimum, qty_purchase, mth,
              begin_inv - sold_qty                       AS tmp_inv,
              sold_qty
       FROM   seed
       WHERE  mth = '2019-01-01'
       UNION ALL
       -- February..December rows
       SELECT s.product_id, s.qty_minimum, s.qty_purchase, s.mth,
              (CASE
                   WHEN (c.tmp_inv < s.qty_minimum)
                   THEN c.tmp_inv + s.qty_purchase
                   ELSE c.tmp_inv
              END) - s.sold_qty                          AS tmp_inv,
              s.sold_qty
       FROM   calc c
       JOIN   seed s ON s.product_id = c.product_id
                    AND s.mth        = date(c.mth,'+1 month')
)
SELECT *
FROM   calc
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – for each product, return the month in 2019 where
--the absolute difference between the ending inventory and the minimum
--requirement is the smallest.
WITH RECURSIVE
months(mth) AS (
       SELECT '2019-01-01'
       UNION ALL
       SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
start_inv AS (
       SELECT pm.product_id,
              pm.qty_minimum,
              pm.qty_purchase,
              COALESCE(SUM(i.qty),0) AS start_qty
       FROM   product_minimums pm
       LEFT   JOIN inventory i ON i.product_id = pm.product_id
       LEFT   JOIN purchases p ON p.id = i.purchase_id
                              AND p.purchased <= '2018-12-31'
       GROUP  BY pm.product_id
),
sales AS (
       SELECT ol.product_id,
              substr(o.ordered,1,7)||'-01' AS mth,
              SUM(ol.qty) AS sold
       FROM   orderlines ol
       JOIN   orders o ON o.id = ol.order_id
       WHERE  o.ordered BETWEEN '2019-01-01' AND '2019-12-31'
       GROUP  BY ol.product_id, substr(o.ordered,1,7)
),
state AS (
       -- January seed row for every product
       SELECT si.product_id,
              si.qty_minimum,
              si.qty_purchase,
              '2019-01-01'               AS mth,
              si.start_qty               AS begin_inv,
              COALESCE(s.sold,0)         AS sold_qty
       FROM   start_inv si
       LEFT   JOIN sales s
              ON s.product_id = si.product_id
             AND s.mth        = '2019-01-01'
       UNION ALL
       -- Recursively build February..December
       SELECT st.product_id,
              st.qty_minimum,
              st.qty_purchase,
              date(st.mth,'+1 month')    AS mth,
              CASE
                   WHEN st.begin_inv - st.sold_qty < st.qty_minimum
                   THEN st.begin_inv - st.sold_qty + st.qty_purchase
                   ELSE st.begin_inv - st.sold_qty
              END                        AS begin_inv,          -- becomes next month’s opening
              COALESCE(s.sold,0)         AS sold_qty
       FROM   state st
       LEFT   JOIN sales s
              ON s.product_id = st.product_id
             AND s.mth        = date(st.mth,'+1 month')
       WHERE  st.mth < '2019-12-01'
),
ending AS (
       SELECT product_id,
              mth,
              begin_inv - sold_qty        AS end_inv,
              qty_minimum
       FROM   state
),
ranked AS (
       SELECT product_id,
              mth,
              ABS(end_inv - qty_minimum)  AS abs_diff,
              ROW_NUMBER() OVER (PARTITION BY product_id
                                 ORDER BY ABS(end_inv - qty_minimum)) AS rn
       FROM   ending
)
SELECT
       product_id,
       mth        AS month_with_smallest_gap,
       abs_diff
FROM   ranked
WHERE  rn = 1
ORDER  BY product_id
LIMIT 20;
```
