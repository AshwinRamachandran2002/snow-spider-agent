--Description: Put the minimum rules, the starting inventory (as of 31-Dec-2018),
--and the calendar months side-by-side to create the skeleton for the model.
WITH RECURSIVE months(mth) AS (
       SELECT '2019-01-01'
       UNION ALL
       SELECT date(mth,'+1 month') FROM months WHERE mth < '2019-12-01'
),
start_inv AS (
       SELECT i.product_id, SUM(i.qty) AS start_qty
       FROM   inventory i
       JOIN   purchases p ON p.id = i.purchase_id
       WHERE  p.purchased <= '2018-12-31'
       GROUP  BY i.product_id
)
SELECT
       pm.product_id,
       pm.qty_minimum,
       pm.qty_purchase,
       si.start_qty,
       m.mth
FROM   product_minimums AS pm
LEFT   JOIN start_inv  AS si ON si.product_id = pm.product_id
CROSS  JOIN months     AS m
ORDER  BY pm.product_id, m.mth
LIMIT 20;
