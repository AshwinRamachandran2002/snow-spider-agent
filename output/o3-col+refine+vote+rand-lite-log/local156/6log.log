```sql
-- 3.  Preview a few BTC “BUY” transactions together with the member’s region
SELECT bt."txn_id",
       bt."txn_date",
       bt."quantity",
       bm."region"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
       ON bt."member_id" = bm."member_id"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 4.  What calendar years appear for BTC purchase activity?
SELECT DISTINCT CAST(SUBSTR(bt."txn_date", -4) AS INTEGER) AS "year"
FROM   "bitcoin_transactions" AS bt
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
ORDER  BY "year"
LIMIT 20;
```

```sql
-- 5.  Inspect the available Bitcoin daily prices (used as cost basis)
SELECT DISTINCT bp."market_date",
       bp."price"
FROM   "bitcoin_prices" AS bp
WHERE  bp."ticker" = 'BTC'
ORDER  BY bp."market_date"
LIMIT 20;
```

```sql
-- 6.  Check that a single BTC buy can be matched to the same-day market price
SELECT bt."txn_id",
       bt."txn_date",
       bp."price"                AS "btc_price_usd",
       bt."quantity",
       (bt."quantity" * bp."price") AS "dollar_spent"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_prices"       AS bp
       ON  bp."ticker"      = 'BTC'
       AND bp."market_date" = bt."txn_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 7.  Aggregate yearly totals & average purchase price per region
SELECT CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)           AS "year",
       bm."region",
       SUM(bt."quantity" * bp."price")                      AS "total_spent_usd",
       SUM(bt."quantity")                                   AS "total_qty",
       SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd_per_btc"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
       ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON  bp."ticker"      = 'BTC'
       AND bp."market_date" = bt."txn_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
GROUP  BY "year", bm."region"
ORDER  BY "year", bm."region"
LIMIT 20;
```

```sql
-- 8.  Determine each region’s first active year (to be excluded later)
SELECT bm."region",
       MIN(CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)) AS "first_year"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
       ON bt."member_id" = bm."member_id"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
GROUP  BY bm."region"
LIMIT 20;
```

```sql
-- 9.  Average purchase prices excluding the first year for every region
WITH region_first AS (
    SELECT bm."region",
           MIN(CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)) AS "first_year"
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm
           ON bt."member_id" = bm."member_id"
    WHERE  bt."ticker"   = 'BTC'
      AND  bt."txn_type" = 'BUY'
    GROUP  BY bm."region"
),
yearly_cost AS (
    SELECT CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)           AS "year",
           bm."region",
           SUM(bt."quantity" * bp."price")                      AS "total_spent_usd",
           SUM(bt."quantity")                                   AS "total_qty",
           SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd_per_btc"
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
    JOIN   "bitcoin_prices"       AS bp  ON bp."ticker" = 'BTC'
                                        AND bp."market_date" = bt."txn_date"
    WHERE  bt."ticker"   = 'BTC'
      AND  bt."txn_type" = 'BUY'
    GROUP  BY "year", bm."region"
)
SELECT yc.*
FROM   yearly_cost AS yc
JOIN   region_first AS rf  ON yc."region" = rf."region"
WHERE  yc."year" > rf."first_year"
LIMIT 20;
```

```sql
-- 10.  Final report: rank regions by avg cost per BTC each year & YoY % change
WITH region_first AS (
    SELECT bm."region",
           MIN(CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)) AS "first_year"
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm
           ON bt."member_id" = bm."member_id"
    WHERE  bt."ticker"   = 'BTC'
      AND  bt."txn_type" = 'BUY'
    GROUP  BY bm."region"
),
yearly_cost AS (
    SELECT CAST(SUBSTR(bt."txn_date", -4) AS INTEGER)           AS "year",
           bm."region",
           SUM(bt."quantity" * bp."price") / SUM(bt."quantity") AS "avg_price_usd_per_btc"
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
    JOIN   "bitcoin_prices"       AS bp  ON bp."ticker" = 'BTC'
                                        AND bp."market_date" = bt."txn_date"
    WHERE  bt."ticker"   = 'BTC'
      AND  bt."txn_type" = 'BUY'
    GROUP  BY "year", bm."region"
),
filtered_cost AS (
    SELECT yc.*
    FROM   yearly_cost AS yc
    JOIN   region_first AS rf  ON yc."region" = rf."region"
    WHERE  yc."year" > rf."first_year"          -- exclude each region’s first year
),
ranked AS (
    SELECT fc.*,
           RANK() OVER (PARTITION BY "year"
                        ORDER BY "avg_price_usd_per_btc" DESC)  AS "region_rank",
           LAG("avg_price_usd_per_btc") OVER (PARTITION BY "region"
                                              ORDER BY "year") AS "prev_year_price"
    FROM   filtered_cost AS fc
)
SELECT  "year",
        "region",
        ROUND("avg_price_usd_per_btc", 2)        AS "avg_cost_usd",
        "region_rank",
        ROUND(100.0 * ( "avg_price_usd_per_btc" - "prev_year_price")
              / "prev_year_price", 2)            AS "yoy_%_change"
FROM    ranked
ORDER BY "year", "region_rank"
LIMIT 20;
```
