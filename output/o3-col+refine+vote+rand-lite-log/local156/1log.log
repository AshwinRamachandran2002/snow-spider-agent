```sql
--Description: 1) All regions that have at least one Bitcoin member  
SELECT DISTINCT "region"
FROM "bitcoin_members"
LIMIT 20;
```

```sql
--Description: 2) Distinct calendar years that contain BTC BUY transactions  
SELECT DISTINCT substr("txn_date", -4) AS "year"
FROM "bitcoin_transactions"
WHERE "ticker" = 'BTC'
  AND "txn_type" = 'BUY'
LIMIT 20;
```

```sql
--Description: 3) Preview BTC BUY transactions joined to member regions  
SELECT DISTINCT m."region",
       t."txn_date",
       t."quantity",
       t."percentage_fee"
FROM "bitcoin_transactions" AS t
JOIN "bitcoin_members"     AS m
  ON t."member_id" = m."member_id"
WHERE t."ticker"   = 'BTC'
  AND t."txn_type" = 'BUY'
LIMIT 20;
```

```sql
--Description: 4) Match each BTC transaction to the daily market price  
SELECT DISTINCT m."region",
       t."txn_date",
       t."quantity",
       p."price"
FROM "bitcoin_transactions" AS t
JOIN "bitcoin_members"     AS m
  ON t."member_id" = m."member_id"
JOIN "bitcoin_prices"      AS p
  ON p."ticker"      = t."ticker"
 AND p."market_date" = t."txn_date"
WHERE t."txn_type" = 'BUY'
LIMIT 20;
```

```sql
--Description: 5) Calculate dollar cost (including fee) per individual BUY  
SELECT DISTINCT m."region",
       t."txn_date",
       ROUND(t."quantity"
           * p."price"
           * (1 + t."percentage_fee" / 100.0), 2) AS "cost_usd"
FROM "bitcoin_transactions" AS t
JOIN "bitcoin_members"     AS m
  ON t."member_id" = m."member_id"
JOIN "bitcoin_prices"      AS p
  ON p."ticker"      = t."ticker"
 AND p."market_date" = t."txn_date"
WHERE t."ticker"   = 'BTC'
  AND t."txn_type" = 'BUY'
LIMIT 20;
```

```sql
--Description: 6) Yearly totals and average purchase price per BTC by region  
SELECT m."region",
       substr(t."txn_date", -4) AS "year",
       SUM(ROUND(t."quantity"
              * p."price"
              * (1 + t."percentage_fee" / 100.0), 2))          AS "total_spent",
       SUM(t."quantity")                                         AS "total_qty",
       ROUND(SUM(t."quantity" * p."price"
              * (1 + t."percentage_fee" / 100.0))
             / SUM(t."quantity"), 2)                             AS "avg_price"
FROM "bitcoin_transactions" AS t
JOIN "bitcoin_members"     AS m
  ON t."member_id" = m."member_id"
JOIN "bitcoin_prices"      AS p
  ON p."ticker"      = t."ticker"
 AND p."market_date" = t."txn_date"
WHERE t."ticker"   = 'BTC'
  AND t."txn_type" = 'BUY'
GROUP BY m."region", substr(t."txn_date", -4)
LIMIT 20;
```

```sql
--Description: 7) Same yearly averages but omit each region’s first year of data  
SELECT *
FROM (
     SELECT m."region",
            substr(t."txn_date", -4)                     AS "year",
            ROUND(SUM(t."quantity" * p."price"
                   * (1 + t."percentage_fee" / 100.0))
                  / SUM(t."quantity"), 2)               AS "avg_price",
            ROW_NUMBER() OVER (
                PARTITION BY m."region"
                ORDER BY substr(t."txn_date", -4)
            )                                           AS "yr_rank"
     FROM "bitcoin_transactions" AS t
     JOIN "bitcoin_members"     AS m
       ON t."member_id" = m."member_id"
     JOIN "bitcoin_prices"      AS p
       ON p."ticker"      = t."ticker"
      AND p."market_date" = t."txn_date"
     WHERE t."ticker"   = 'BTC'
       AND t."txn_type" = 'BUY'
     GROUP BY m."region", substr(t."txn_date", -4)
) 
WHERE "yr_rank" > 1
LIMIT 20;
```

```sql
--Description: 8) Rank regions each year based on their average purchase price  
SELECT *
FROM (
     SELECT a."region",
            a."year",
            a."avg_price",
            RANK() OVER (
                PARTITION BY a."year"
                ORDER BY a."avg_price" DESC
            ) AS "region_rank"
     FROM (
         -- reusable sub-query from #7 without the LIMIT
         SELECT m."region",
                substr(t."txn_date", -4)                  AS "year",
                ROUND(SUM(t."quantity" * p."price"
                       * (1 + t."percentage_fee" / 100.0))
                      / SUM(t."quantity"), 2)            AS "avg_price",
                ROW_NUMBER() OVER (
                    PARTITION BY m."region"
                    ORDER BY substr(t."txn_date", -4)
                )                                        AS "yr_rank"
         FROM "bitcoin_transactions" AS t
         JOIN "bitcoin_members"     AS m
           ON t."member_id" = m."member_id"
         JOIN "bitcoin_prices"      AS p
           ON p."ticker"      = t."ticker"
          AND p."market_date" = t."txn_date"
         WHERE t."ticker"   = 'BTC'
           AND t."txn_type" = 'BUY'
         GROUP BY m."region", substr(t."txn_date", -4)
     ) AS a
     WHERE a."yr_rank" > 1
) 
LIMIT 20;
```

```sql
--Description: 9) Add year-over-year percentage change for each region  
SELECT b."region",
       b."year",
       b."avg_price",
       b."region_rank",
       ROUND(
           (b."avg_price"
            - LAG(b."avg_price") OVER (
                  PARTITION BY b."region"
                  ORDER BY b."year"
              )
           ) * 100.0
           / LAG(b."avg_price") OVER (
                  PARTITION BY b."region"
                  ORDER BY b."year"
             ), 2
       ) AS "pct_change_vs_prev_year"
FROM (
     -- sub-query from #8 without LIMIT
     SELECT a."region",
            a."year",
            a."avg_price",
            RANK() OVER (
                PARTITION BY a."year"
                ORDER BY a."avg_price" DESC
            ) AS "region_rank"
     FROM (
         SELECT m."region",
                substr(t."txn_date", -4)                  AS "year",
                ROUND(SUM(t."quantity" * p."price"
                       * (1 + t."percentage_fee" / 100.0))
                      / SUM(t."quantity"), 2)            AS "avg_price",
                ROW_NUMBER() OVER (
                    PARTITION BY m."region"
                    ORDER BY substr(t."txn_date", -4)
                )                                        AS "yr_rank"
         FROM "bitcoin_transactions" AS t
         JOIN "bitcoin_members"     AS m
           ON t."member_id" = m."member_id"
         JOIN "bitcoin_prices"      AS p
           ON p."ticker"      = t."ticker"
          AND p."market_date" = t."txn_date"
         WHERE t."ticker"   = 'BTC'
           AND t."txn_type" = 'BUY'
         GROUP BY m."region", substr(t."txn_date", -4)
     ) AS a
     WHERE a."yr_rank" > 1
) AS b
LIMIT 20;
```

```sql
--Description: 10) Final answer – full yearly table (no LIMIT) with average price, rank, and % change  
SELECT b."region",
       b."year",
       b."avg_price",
       b."region_rank",
       ROUND(
           (b."avg_price"
            - LAG(b."avg_price") OVER (
                  PARTITION BY b."region"
                  ORDER BY b."year"
              )
           ) * 100.0
           / LAG(b."avg_price") OVER (
                  PARTITION BY b."region"
                  ORDER BY b."year"
             ), 2
       ) AS "pct_change_vs_prev_year"
FROM (
     SELECT a."region",
            a."year",
            a."avg_price",
            RANK() OVER (
                PARTITION BY a."year"
                ORDER BY a."avg_price" DESC
            ) AS "region_rank"
     FROM (
         SELECT m."region",
                substr(t."txn_date", -4)                  AS "year",
                ROUND(SUM(t."quantity" * p."price"
                       * (1 + t."percentage_fee" / 100.0))
                      / SUM(t."quantity"), 2)            AS "avg_price",
                ROW_NUMBER() OVER (
                    PARTITION BY m."region"
                    ORDER BY substr(t."txn_date", -4)
                )                                        AS "yr_rank"
         FROM "bitcoin_transactions" AS t
         JOIN "bitcoin_members"     AS m
           ON t."member_id" = m."member_id"
         JOIN "bitcoin_prices"      AS p
           ON p."ticker"      = t."ticker"
          AND p."market_date" = t."txn_date"
         WHERE t."ticker"   = 'BTC'
           AND t."txn_type" = 'BUY'
         GROUP BY m."region", substr(t."txn_date", -4)
     ) AS a
     WHERE a."yr_rank" > 1
) AS b;
```
