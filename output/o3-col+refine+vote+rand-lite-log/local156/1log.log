--Description: 9) Add year-over-year percentage change for each region  
SELECT b."region",
       b."year",
       b."avg_price",
       b."region_rank",
       ROUND(
           (b."avg_price"
            - LAG(b."avg_price") OVER (
                  PARTITION BY b."region"
                  ORDER BY b."year"
              )
           ) * 100.0
           / LAG(b."avg_price") OVER (
                  PARTITION BY b."region"
                  ORDER BY b."year"
             ), 2
       ) AS "pct_change_vs_prev_year"
FROM (
     -- sub-query from #8 without LIMIT
     SELECT a."region",
            a."year",
            a."avg_price",
            RANK() OVER (
                PARTITION BY a."year"
                ORDER BY a."avg_price" DESC
            ) AS "region_rank"
     FROM (
         SELECT m."region",
                substr(t."txn_date", -4)                  AS "year",
                ROUND(SUM(t."quantity" * p."price"
                       * (1 + t."percentage_fee" / 100.0))
                      / SUM(t."quantity"), 2)            AS "avg_price",
                ROW_NUMBER() OVER (
                    PARTITION BY m."region"
                    ORDER BY substr(t."txn_date", -4)
                )                                        AS "yr_rank"
         FROM "bitcoin_transactions" AS t
         JOIN "bitcoin_members"     AS m
           ON t."member_id" = m."member_id"
         JOIN "bitcoin_prices"      AS p
           ON p."ticker"      = t."ticker"
          AND p."market_date" = t."txn_date"
         WHERE t."ticker"   = 'BTC'
           AND t."txn_type" = 'BUY'
         GROUP BY m."region", substr(t."txn_date", -4)
     ) AS a
     WHERE a."yr_rank" > 1
) AS b
LIMIT 20;
