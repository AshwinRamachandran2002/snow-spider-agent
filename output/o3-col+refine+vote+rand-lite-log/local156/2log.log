Query:
--Description: 10) Rank regions by yearly average price & calculate year-over-year % change in cost.
WITH region_year_cost AS (
  SELECT bm."region",
         substr(bt."txn_date", 7, 4) AS "calendar_year",
         SUM(bt."quantity" * bp."price") AS "total_cost",
         SUM(bt."quantity")              AS "total_qty"
  FROM "bitcoin_transactions" AS bt
  JOIN "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
  JOIN "bitcoin_prices"       AS bp ON bp."ticker"    = 'BTC'
                                   AND bp."market_date" = bt."txn_date"
  WHERE bt."txn_type" = 'BUY'
  GROUP BY bm."region", substr(bt."txn_date", 7, 4)
),
region_year_calc AS (
  SELECT *,
         "total_cost" * 1.0 / "total_qty" AS "avg_price_btc",
         ROW_NUMBER() OVER (PARTITION BY "region" ORDER BY "calendar_year") AS rn,
         LAG("total_cost" * 1.0 / "total_qty") OVER (PARTITION BY "region" ORDER BY "calendar_year") AS prior_avg
  FROM region_year_cost
),
filtered AS (
  SELECT *
  FROM region_year_calc
  WHERE rn > 1   -- exclude first year per region
)
SELECT "calendar_year",
       "region",
       "avg_price_btc",
       RANK() OVER (PARTITION BY "calendar_year" ORDER BY "avg_price_btc" DESC)   AS "region_rank",
       ROUND( (("avg_price_btc" - "prior_avg") / "prior_avg") * 100, 2)           AS "pct_change_vs_prev_year"
FROM filtered
ORDER BY "calendar_year", "region_rank"
LIMIT 20;
