--Description: 7) Join BTC BUY transactions to the price table (same day) to get the dollar value per row.
SELECT bt."txn_id",
       bm."region",
       bt."txn_date",
       bp."price"            AS "btc_price_usd",
       bt."quantity",
       bt."quantity" * bp."price" AS "cost_usd"
