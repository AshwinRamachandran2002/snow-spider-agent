```sql
-- 1.  Look at all member regions that can appear in the analysis
SELECT DISTINCT region
FROM bitcoin_members
LIMIT 20;
```

```sql
-- 2.  Inspect the years that occur in the raw bitcoin_transactions table
SELECT DISTINCT SUBSTR(txn_date, 7, 4)  AS txn_year
FROM bitcoin_transactions
ORDER BY txn_year
LIMIT 20;
```

```sql
-- 3.  Check BTC-only BUY transactions together with the member’s region
SELECT bt.txn_id,
       bt.member_id,
       bm.region,
       bt.txn_date,
       bt.quantity,
       bt.percentage_fee
FROM bitcoin_transactions AS bt
JOIN bitcoin_members      AS bm
  ON bt.member_id = bm.member_id
WHERE bt.ticker    = 'BTC'
  AND bt.txn_type  = 'BUY'
LIMIT 20;
```

```sql
-- 4.  Verify that a matching BTC daily price exists for a transaction date
SELECT bt.txn_id,
       bt.txn_date,
       bp.market_date,
       bp.price
FROM bitcoin_transactions AS bt
JOIN bitcoin_prices       AS bp
  ON bp.ticker      = bt.ticker
 AND bp.market_date = bt.txn_date      -- both are dd-mm-yyyy
WHERE bt.ticker   = 'BTC'
  AND bt.txn_type = 'BUY'
LIMIT 20;
```

```sql
-- 5.  Calculate the dollar amount (price * quantity) per txn after joining to price
SELECT bt.txn_id,
       bm.region,
       SUBSTR(bt.txn_date, 7, 4) AS txn_year,
       bt.quantity,
       bp.price,
       ROUND(bt.quantity * bp.price, 2) AS dollar_spent
FROM bitcoin_transactions AS bt
JOIN bitcoin_members      AS bm ON bt.member_id = bm.member_id
JOIN bitcoin_prices       AS bp ON bp.ticker = bt.ticker
                               AND bp.market_date = bt.txn_date
WHERE bt.ticker   = 'BTC'
  AND bt.txn_type = 'BUY'
LIMIT 20;
```

```sql
-- 6.  Aggregate yearly totals: total dollars spent and total quantity bought
SELECT bm.region,
       SUBSTR(bt.txn_date, 7, 4) AS txn_year,
       SUM(bt.quantity * bp.price) AS total_spent_usd,
       SUM(bt.quantity)            AS total_qty_btc
FROM bitcoin_transactions AS bt
JOIN bitcoin_members      AS bm ON bt.member_id = bm.member_id
JOIN bitcoin_prices       AS bp ON bp.ticker = bt.ticker
                               AND bp.market_date = bt.txn_date
WHERE bt.ticker   = 'BTC'
  AND bt.txn_type = 'BUY'
GROUP BY bm.region, txn_year
ORDER BY bm.region, txn_year
LIMIT 20;
```

```sql
-- 7.  Derive the annual average purchase price per BTC for every region & year
WITH yearly_totals AS (
    SELECT bm.region,
           SUBSTR(bt.txn_date, 7, 4) AS txn_year,
           SUM(bt.quantity * bp.price) AS total_spent_usd,
           SUM(bt.quantity)            AS total_qty_btc
    FROM bitcoin_transactions AS bt
    JOIN bitcoin_members      AS bm ON bt.member_id = bm.member_id
    JOIN bitcoin_prices       AS bp ON bp.ticker = bt.ticker
                                   AND bp.market_date = bt.txn_date
    WHERE bt.ticker   = 'BTC'
      AND bt.txn_type = 'BUY'
    GROUP BY bm.region, txn_year
)
SELECT region,
       txn_year,
       ROUND(total_spent_usd / total_qty_btc, 2) AS avg_price_usd
FROM yearly_totals
ORDER BY region, txn_year
LIMIT 20;
```

```sql
-- 8.  Identify the first transaction year for each region
WITH region_first_year AS (
    SELECT region,
           MIN(SUBSTR(txn_date, 7, 4)) AS first_year
    FROM bitcoin_transactions bt
    JOIN bitcoin_members bm
      ON bt.member_id = bm.member_id
    WHERE bt.ticker = 'BTC'
      AND bt.txn_type = 'BUY'
    GROUP BY region
)
SELECT *
FROM region_first_year
LIMIT 20;
```

```sql
-- 9.  Annual average price per region excluding its first year of data
WITH yearly_totals AS (
    SELECT bm.region,
           SUBSTR(bt.txn_date, 7, 4) AS txn_year,
           SUM(bt.quantity * bp.price) AS total_spent_usd,
           SUM(bt.quantity)            AS total_qty_btc
    FROM bitcoin_transactions AS bt
    JOIN bitcoin_members      AS bm ON bt.member_id = bm.member_id
    JOIN bitcoin_prices       AS bp ON bp.ticker = bt.ticker
                                   AND bp.market_date = bt.txn_date
    WHERE bt.ticker   = 'BTC'
      AND bt.txn_type = 'BUY'
    GROUP BY bm.region, txn_year
), region_first_year AS (
    SELECT region,
           MIN(txn_year) AS first_year
    FROM yearly_totals
    GROUP BY region
)
SELECT y.region,
       y.txn_year,
       ROUND(y.total_spent_usd / y.total_qty_btc, 2) AS avg_price_usd
FROM yearly_totals AS y
JOIN region_first_year AS f
  ON y.region = f.region
WHERE y.txn_year > f.first_year                       -- exclude first year
ORDER BY y.region, y.txn_year
LIMIT 20;
```

```sql
-- 10.  Final answer: rank regions by annual avg price and show YoY % change
WITH yearly_totals AS (
    SELECT bm.region,
           SUBSTR(bt.txn_date, 7, 4) AS txn_year,
           SUM(bt.quantity * bp.price) AS total_spent_usd,
           SUM(bt.quantity)            AS total_qty_btc
    FROM bitcoin_transactions AS bt
    JOIN bitcoin_members      AS bm ON bt.member_id = bm.member_id
    JOIN bitcoin_prices       AS bp ON bp.ticker = bt.ticker
                                   AND bp.market_date = bt.txn_date
    WHERE bt.ticker   = 'BTC'
      AND bt.txn_type = 'BUY'
    GROUP BY bm.region, txn_year
), region_first_year AS (
    SELECT region,
           MIN(txn_year) AS first_year
    FROM yearly_totals
    GROUP BY region
), avg_price AS (
    SELECT y.region,
           y.txn_year,
           ROUND(y.total_spent_usd / y.total_qty_btc, 2) AS avg_price_usd
    FROM yearly_totals AS y
    JOIN region_first_year AS f
      ON y.region = f.region
    WHERE y.txn_year > f.first_year                     -- exclude first year
)
SELECT region,
       txn_year,
       avg_price_usd,
       RANK() OVER (PARTITION BY txn_year ORDER BY avg_price_usd DESC) AS price_rank,
       ROUND(
           (avg_price_usd - LAG(avg_price_usd) OVER (PARTITION BY region ORDER BY txn_year))
           /
           LAG(avg_price_usd) OVER (PARTITION BY region ORDER BY txn_year)
           * 100, 2
       ) AS pct_change_vs_prev_year
FROM avg_price
ORDER BY txn_year, price_rank
LIMIT 20;
```
