Query:
-- 9.  Annual average price per region excluding its first year of data
WITH yearly_totals AS (
    SELECT bm.region,
           SUBSTR(bt.txn_date, 7, 4) AS txn_year,
           SUM(bt.quantity * bp.price) AS total_spent_usd,
           SUM(bt.quantity)            AS total_qty_btc
    FROM bitcoin_transactions AS bt
    JOIN bitcoin_members      AS bm ON bt.member_id = bm.member_id
    JOIN bitcoin_prices       AS bp ON bp.ticker = bt.ticker
                                   AND bp.market_date = bt.txn_date
    WHERE bt.ticker   = 'BTC'
      AND bt.txn_type = 'BUY'
    GROUP BY bm.region, txn_year
), region_first_year AS (
    SELECT region,
           MIN(txn_year) AS first_year
    FROM yearly_totals
    GROUP BY region
)
SELECT y.region,
       y.txn_year,
       ROUND(y.total_spent_usd / y.total_qty_btc, 2) AS avg_price_usd
FROM yearly_totals AS y
JOIN region_first_year AS f
  ON y.region = f.region
WHERE y.txn_year > f.first_year                       -- exclude first year
ORDER BY y.region, y.txn_year
LIMIT 20;
