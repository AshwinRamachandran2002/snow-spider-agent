            JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
            JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
            WHERE  bt."ticker"   = 'BTC'
              AND  bt."txn_type" = 'BUY'
              AND  bp."ticker"   = 'BTC'
            GROUP  BY bm."region",
                     CAST(substr(bt."txn_date", -4) AS INTEGER)
      )
) AS x
WHERE rn > 1
LIMIT 20;
