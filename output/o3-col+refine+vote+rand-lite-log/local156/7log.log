-- 10. Final answer: average cost, year-on-year % change, and regional ranking per year
SELECT calendar_year,
       region,
       avg_buy_px,
       ROUND(100.0 *
             (avg_buy_px - LAG(avg_buy_px) OVER (PARTITION BY region ORDER BY calendar_year))
             / LAG(avg_buy_px)             OVER (PARTITION BY region ORDER BY calendar_year), 2)
             AS pct_change_vs_prev_year,
       RANK() OVER (PARTITION BY calendar_year ORDER BY avg_buy_px DESC) AS region_rank
FROM (
      SELECT region,
             calendar_year,
             avg_buy_px,
             ROW_NUMBER() OVER (PARTITION BY region ORDER BY calendar_year) AS rn
      FROM (
            SELECT bm."region"                    AS region,
                   CAST(substr(bt."txn_date", -4) AS INTEGER) AS calendar_year,
