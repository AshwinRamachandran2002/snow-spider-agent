SELECT DISTINCT "region"
FROM "bitcoin_members"
LIMIT 20;
```

```sql
-- 3. Look at a few BUY-side Bitcoin transactions together with the member’s region
SELECT bt."txn_id",
       bt."member_id",
       bm."region",
       bt."txn_date",
       bt."quantity",
       bt."percentage_fee"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm
  ON   bt."member_id" = bm."member_id"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 4. Inspect the price series we have for BTC in the daily price table
SELECT "ticker",
       "market_date",
       "price",
       "open",
       "high",
       "low"
FROM   "bitcoin_prices"
WHERE  "ticker" = 'BTC'
LIMIT 20;
```

```sql
-- 5. Combine one day of BUY transactions with the closing price to confirm the join works
SELECT bt."txn_id",
       bt."txn_date",
       bp."price"           AS "btc_close_px",
       bt."quantity",
       (bt."quantity" * bp."price") AS "amount_spent_usd"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_prices"      AS bp
  ON   bt."txn_date" = bp."market_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
  AND  bp."ticker"   = 'BTC'
LIMIT 20;
```

```sql
-- 6. Aggregate yearly totals (quantity & dollar amount) per region
SELECT bm."region",
       CAST(substr(bt."txn_date", -4) AS INTEGER) AS "calendar_year",
       SUM(bt."quantity")              AS "qty_bought",
       SUM(bt."quantity" * bp."price") AS "usd_spent"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp  ON bt."txn_date"  = bp."market_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
  AND  bp."ticker"   = 'BTC'
GROUP  BY bm."region",
          CAST(substr(bt."txn_date", -4) AS INTEGER)
LIMIT 20;
```

```sql
-- 7. Calculate the yearly average purchase price (USD per BTC) for every region
SELECT region,
       calendar_year,
       ROUND(usd_spent / qty_bought, 2) AS avg_buy_px
FROM (
      SELECT bm."region"                    AS region,
             CAST(substr(bt."txn_date", -4) AS INTEGER) AS calendar_year,
             SUM(bt."quantity")              AS qty_bought,
             SUM(bt."quantity" * bp."price") AS usd_spent
      FROM   "bitcoin_transactions" AS bt
      JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
      JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
      WHERE  bt."ticker"   = 'BTC'
        AND  bt."txn_type" = 'BUY'
        AND  bp."ticker"   = 'BTC'
      GROUP BY bm."region",
               CAST(substr(bt."txn_date", -4) AS INTEGER)
) AS yr
LIMIT 20;
```

```sql
-- 8. Remove each region’s first observed year and keep the rest
SELECT *
FROM (
      SELECT region,
             calendar_year,
             avg_buy_px,
             ROW_NUMBER() OVER (PARTITION BY region ORDER BY calendar_year) AS rn
      FROM (
            SELECT bm."region"                    AS region,
                   CAST(substr(bt."txn_date", -4) AS INTEGER) AS calendar_year,
                   ROUND(SUM(bt."quantity" * bp."price") /
                         SUM(bt."quantity"), 2)  AS avg_buy_px
            FROM   "bitcoin_transactions" AS bt
            JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
            JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
            WHERE  bt."ticker"   = 'BTC'
              AND  bt."txn_type" = 'BUY'
              AND  bp."ticker"   = 'BTC'
            GROUP  BY bm."region",
                     CAST(substr(bt."txn_date", -4) AS INTEGER)
      )
) AS t
WHERE rn > 1          -- exclude the first year for every region
LIMIT 20;
```

```sql
-- 9. Rank the regions by their average purchase price within each calendar year, after exclusions
SELECT calendar_year,
       region,
       avg_buy_px,
       RANK() OVER (PARTITION BY calendar_year
                    ORDER BY avg_buy_px DESC) AS region_rank
FROM (
      SELECT region,
             calendar_year,
             avg_buy_px,
             ROW_NUMBER() OVER (PARTITION BY region ORDER BY calendar_year) AS rn
      FROM (
            SELECT bm."region"                    AS region,
                   CAST(substr(bt."txn_date", -4) AS INTEGER) AS calendar_year,
                   ROUND(SUM(bt."quantity" * bp."price") /
                         SUM(bt."quantity"), 2)  AS avg_buy_px
            FROM   "bitcoin_transactions" AS bt
            JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
            JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
            WHERE  bt."ticker"   = 'BTC'
              AND  bt."txn_type" = 'BUY'
              AND  bp."ticker"   = 'BTC'
            GROUP  BY bm."region",
                     CAST(substr(bt."txn_date", -4) AS INTEGER)
      )
) AS x
WHERE rn > 1
LIMIT 20;
```

```sql
-- 10. Final answer: average cost, year-on-year % change, and regional ranking per year
SELECT calendar_year,
       region,
       avg_buy_px,
       ROUND(100.0 *
             (avg_buy_px - LAG(avg_buy_px) OVER (PARTITION BY region ORDER BY calendar_year))
             / LAG(avg_buy_px)             OVER (PARTITION BY region ORDER BY calendar_year), 2)
             AS pct_change_vs_prev_year,
       RANK() OVER (PARTITION BY calendar_year ORDER BY avg_buy_px DESC) AS region_rank
FROM (
      SELECT region,
             calendar_year,
             avg_buy_px,
             ROW_NUMBER() OVER (PARTITION BY region ORDER BY calendar_year) AS rn
      FROM (
            SELECT bm."region"                    AS region,
                   CAST(substr(bt."txn_date", -4) AS INTEGER) AS calendar_year,
                   ROUND(SUM(bt."quantity" * bp."price") /
                         SUM(bt."quantity"), 2)  AS avg_buy_px
            FROM   "bitcoin_transactions" AS bt
            JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
            JOIN   "bitcoin_prices"       AS bp ON bt."txn_date"  = bp."market_date"
            WHERE  bt."ticker"   = 'BTC'
              AND  bt."txn_type" = 'BUY'
              AND  bp."ticker"   = 'BTC'
            GROUP  BY bm."region",
                     CAST(substr(bt."txn_date", -4) AS INTEGER)
      )
) AS y
WHERE rn > 1                 -- drop the initial year per region
ORDER BY calendar_year, region_rank
LIMIT 20;
```
