Query:
-- 8.  Add a year-over-year % change in average purchase price.
SELECT  region,
        year,
        avg_purchase_price,
        ROUND( (avg_purchase_price -
                LAG(avg_purchase_price) OVER (PARTITION BY region ORDER BY year)
               ) * 100.0 /
               LAG(avg_purchase_price) OVER (PARTITION BY region ORDER BY year)
        , 2)                                                AS "pct_change_vs_prev_year"
FROM   (
       SELECT bm."region"                                   AS region,
              substr(bt."txn_date", 7, 4)                   AS year,
              ROUND(SUM(bt."quantity" * bp."price") /
                    SUM(bt."quantity"), 2)                  AS avg_purchase_price,
              ROW_NUMBER() OVER (PARTITION BY bm."region"
                                 ORDER BY substr(bt."txn_date", 7, 4)) AS rn
       FROM   "bitcoin_transactions" AS bt
       JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
       JOIN   "bitcoin_prices"       AS bp
              ON  bt."ticker"      = bp."ticker"
              AND bt."txn_date"    = bp."market_date"
       WHERE  bt."txn_type" = 'BUY'
       GROUP  BY bm."region", substr(bt."txn_date", 7, 4)
       ) 
WHERE  rn > 1
ORDER  BY year, region
LIMIT 20;
