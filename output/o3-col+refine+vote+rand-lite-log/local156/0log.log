FROM "bitcoin_transactions"
LIMIT 20;
```

```sql
-- 2.  Which crypto‐tickers appear in the transactions file?
SELECT DISTINCT "ticker"
FROM "bitcoin_transactions"
LIMIT 20;
```

```sql
-- 3.  List all customer regions recorded in the members table.
SELECT DISTINCT "region"
FROM "bitcoin_members"
LIMIT 20;
```

```sql
-- 4.  Quick spot-check: link one day’s BUYs to the daily market price
--     (shows how price and quantity line up in a joined dataset).
SELECT bt."member_id",
       bm."region",
       bt."txn_date",
       bt."quantity",
       bp."price"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON  bt."ticker"      = bp."ticker"
       AND bt."txn_date"    = bp."market_date"
WHERE  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 5.  Annual BUY totals: dollars spent and quantity bought per region.
SELECT substr(bt."txn_date", 7, 4)                          AS "year",
       bm."region",
       SUM(bt."quantity" * bp."price")                      AS "total_spent",
       SUM(bt."quantity")                                   AS "total_qty"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON  bt."ticker"      = bp."ticker"
       AND bt."txn_date"    = bp."market_date"
WHERE  bt."txn_type" = 'BUY'
GROUP  BY "year", bm."region"
ORDER  BY "year", bm."region"
LIMIT 20;
```

```sql
-- 6.  Turn those totals into an annual average purchase price (USD / BTC).
SELECT substr(bt."txn_date", 7, 4)                          AS "year",
       bm."region",
       ROUND(SUM(bt."quantity" * bp."price") /
             SUM(bt."quantity"), 2)                         AS "avg_purchase_price"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON  bt."ticker"      = bp."ticker"
       AND bt."txn_date"    = bp."market_date"
WHERE  bt."txn_type" = 'BUY'
GROUP  BY "year", bm."region"
ORDER  BY "year", bm."region"
LIMIT 20;
```

```sql
-- 7.  Exclude each region’s first year of data
--     (ROW_NUMBER lets us keep only rows where rn > 1).
SELECT *
FROM   (
       SELECT bm."region",
              substr(bt."txn_date", 7, 4)                  AS "year",
              ROUND(SUM(bt."quantity" * bp."price") /
                    SUM(bt."quantity"), 2)                 AS "avg_purchase_price",
              ROW_NUMBER() OVER (PARTITION BY bm."region"
                                 ORDER BY substr(bt."txn_date", 7, 4)) AS rn
       FROM   "bitcoin_transactions" AS bt
       JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
       JOIN   "bitcoin_prices"       AS bp
              ON  bt."ticker"      = bp."ticker"
              AND bt."txn_date"    = bp."market_date"
       WHERE  bt."txn_type" = 'BUY'
       GROUP  BY bm."region", substr(bt."txn_date", 7, 4)
       ) 
WHERE  rn > 1
ORDER  BY "year", "region"
LIMIT 20;
```

```sql
-- 8.  Add a year-over-year % change in average purchase price.
SELECT  region,
        year,
        avg_purchase_price,
        ROUND( (avg_purchase_price -
                LAG(avg_purchase_price) OVER (PARTITION BY region ORDER BY year)
               ) * 100.0 /
               LAG(avg_purchase_price) OVER (PARTITION BY region ORDER BY year)
        , 2)                                                AS "pct_change_vs_prev_year"
FROM   (
       SELECT bm."region"                                   AS region,
              substr(bt."txn_date", 7, 4)                   AS year,
              ROUND(SUM(bt."quantity" * bp."price") /
                    SUM(bt."quantity"), 2)                  AS avg_purchase_price,
              ROW_NUMBER() OVER (PARTITION BY bm."region"
                                 ORDER BY substr(bt."txn_date", 7, 4)) AS rn
       FROM   "bitcoin_transactions" AS bt
       JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
       JOIN   "bitcoin_prices"       AS bp
              ON  bt."ticker"      = bp."ticker"
              AND bt."txn_date"    = bp."market_date"
       WHERE  bt."txn_type" = 'BUY'
       GROUP  BY bm."region", substr(bt."txn_date", 7, 4)
       ) 
WHERE  rn > 1
ORDER  BY year, region
LIMIT 20;
```

```sql
-- 9.  Rank regions by cost within each year (after first-year exclusion).
SELECT year,
       region,
       avg_purchase_price,
       RANK() OVER (PARTITION BY year ORDER BY avg_purchase_price DESC) AS "cost_rank"
FROM (
     SELECT bm."region"                                   AS region,
            substr(bt."txn_date", 7, 4)                   AS year,
            ROUND(SUM(bt."quantity" * bp."price") /
                  SUM(bt."quantity"), 2)                  AS avg_purchase_price,
            ROW_NUMBER() OVER (PARTITION BY bm."region"
                               ORDER BY substr(bt."txn_date", 7, 4)) AS rn
     FROM   "bitcoin_transactions" AS bt
     JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
     JOIN   "bitcoin_prices"       AS bp
            ON  bt."ticker"      = bp."ticker"
            AND bt."txn_date"    = bp."market_date"
     WHERE  bt."txn_type" = 'BUY'
     GROUP  BY bm."region", substr(bt."txn_date", 7, 4)
     ) 
WHERE  rn > 1
ORDER  BY year, cost_rank
LIMIT 20;
```

```sql
-- 10.  Final answer: combine % change and ranking in one concise report.
SELECT  a.year,
        a.region,
        a.avg_purchase_price,
        a.pct_change_vs_prev_year,
        RANK() OVER (PARTITION BY a.year
                     ORDER BY a.avg_purchase_price DESC)   AS "cost_rank"
FROM   (
        SELECT  region,
                year,
                avg_purchase_price,
                ROUND( (avg_purchase_price -
                        LAG(avg_purchase_price) OVER (PARTITION BY region ORDER BY year)
                       ) * 100.0 /
                       LAG(avg_purchase_price) OVER (PARTITION BY region ORDER BY year)
                , 2)                                       AS pct_change_vs_prev_year
        FROM   (
               SELECT bm."region"                         AS region,
                      substr(bt."txn_date", 7, 4)         AS year,
                      ROUND(SUM(bt."quantity" * bp."price") /
                            SUM(bt."quantity"), 2)        AS avg_purchase_price,
                      ROW_NUMBER() OVER (PARTITION BY bm."region"
                                         ORDER BY substr(bt."txn_date", 7, 4)) AS rn
               FROM   "bitcoin_transactions" AS bt
               JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
               JOIN   "bitcoin_prices"       AS bp
                      ON  bt."ticker"      = bp."ticker"
                      AND bt."txn_date"    = bp."market_date"
               WHERE  bt."txn_type" = 'BUY'
               GROUP  BY bm."region", substr(bt."txn_date", 7, 4)
               ) 
        WHERE rn > 1
       ) AS a
ORDER  BY a.year,
          a.cost_rank
LIMIT 20;
```
