```sql
--Description: compute each region’s annual average BTC purchase price (USD/BTC),
--             drop the first year per region, add YoY % change, rank regions
--             by cost within each year.
--Thinking process / steps:
--  • Join bitcoin_transactions (BUY only) to bitcoin_members (for region)
--    and bitcoin_prices (to get USD price on that day).
--  • Aggregate to region-year level → average purchase price.
--  • Use ROW_NUMBER() to identify & discard each region’s first calendar year.
--  • Add year-over-year % change with LAG().
--  • Rank regions inside each year by average cost (high → low).
SELECT
    yr_region.year,
    yr_region.region,
    yr_region.avg_purchase_price,
    ROUND(
        (yr_region.avg_purchase_price -
         LAG(yr_region.avg_purchase_price) OVER (PARTITION BY yr_region.region ORDER BY yr_region.year))
        * 100.0 /
        LAG(yr_region.avg_purchase_price) OVER (PARTITION BY yr_region.region ORDER BY yr_region.year),
    2) AS pct_change_vs_prev_year,
    RANK() OVER (PARTITION BY yr_region.year ORDER BY yr_region.avg_purchase_price DESC) AS cost_rank
FROM (
    SELECT
        bm."region"                                                    AS region,
        substr(bt."txn_date", 7, 4)                                    AS year,
        ROUND(SUM(bt."quantity" * bp."price") / SUM(bt."quantity"), 2) AS avg_purchase_price,
        ROW_NUMBER() OVER (PARTITION BY bm."region" ORDER BY substr(bt."txn_date", 7, 4)) AS rn
    FROM   "bitcoin_transactions" AS bt
    JOIN   "bitcoin_members"      AS bm ON bt."member_id" = bm."member_id"
    JOIN   "bitcoin_prices"       AS bp
           ON bt."ticker" = bp."ticker"
          AND bt."txn_date" = bp."market_date"
    WHERE  bt."txn_type" = 'BUY'
    GROUP  BY bm."region", substr(bt."txn_date", 7, 4)
) AS yr_region
WHERE yr_region.rn > 1            -- exclude the first year for each region
ORDER BY yr_region.year, cost_rank
LIMIT 20;
```
