LIMIT 20;
```

```sql
-- 6. Daily market-price records available for BTC
SELECT *
FROM   "bitcoin_prices"
WHERE  "ticker" = 'BTC'
LIMIT 20;
```

```sql
-- 7. Join a BTC purchase to the same-day market price to see spend/price per trade
SELECT bt."txn_id",
       bm."region",
       substr(bt."txn_date",7,4)          AS "year",
       bt."quantity",
       bp."price",
       bt."quantity" * bp."price"         AS "amount_spent"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON  bp."ticker"      = bt."ticker"
       AND bp."market_date" = bt."txn_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
LIMIT 20;
```

```sql
-- 8. Yearly totals & average purchase price (total_spent / qty) per region
SELECT bm."region",
       substr(bt."txn_date",7,4)                       AS "year",
       SUM(bt."quantity")                              AS "total_qty",
       SUM(bt."quantity" * bp."price")                 AS "total_spent",
       SUM(bt."quantity" * bp."price") * 1.0
         / SUM(bt."quantity")                          AS "avg_price"
FROM   "bitcoin_transactions" AS bt
JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
JOIN   "bitcoin_prices"       AS bp
       ON  bp."ticker"      = bt."ticker"
       AND bp."market_date" = bt."txn_date"
WHERE  bt."ticker"   = 'BTC'
  AND  bt."txn_type" = 'BUY'
GROUP  BY bm."region", substr(bt."txn_date",7,4)
LIMIT 20;
```

```sql
-- 9. Same result as above but remove the first year of data for every region
WITH region_year_price AS (
  SELECT bm."region"                        AS region,
         substr(bt."txn_date",7,4)          AS year,
         SUM(bt."quantity" * bp."price")*1.0 / SUM(bt."quantity") AS avg_price,
         ROW_NUMBER() OVER (PARTITION BY bm."region" ORDER BY substr(bt."txn_date",7,4)) AS rn
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp
         ON  bp."ticker"      = bt."ticker"
         AND bp."market_date" = bt."txn_date"
  WHERE  bt."ticker"   = 'BTC'
    AND  bt."txn_type" = 'BUY'
  GROUP  BY bm."region", substr(bt."txn_date",7,4)
)
SELECT *
FROM   region_year_price
WHERE  rn > 1
LIMIT 20;
```

```sql
-- 10. Rank regions by annual average BTC purchase price and calculate YoY % change
WITH region_year_price AS (
  SELECT bm."region"                        AS region,
         substr(bt."txn_date",7,4)          AS year,
         SUM(bt."quantity" * bp."price")*1.0 / SUM(bt."quantity") AS avg_price,
         ROW_NUMBER() OVER (PARTITION BY bm."region" ORDER BY substr(bt."txn_date",7,4)) AS rn
  FROM   "bitcoin_transactions" AS bt
  JOIN   "bitcoin_members"      AS bm  ON bt."member_id" = bm."member_id"
  JOIN   "bitcoin_prices"       AS bp
         ON  bp."ticker"      = bt."ticker"
         AND bp."market_date" = bt."txn_date"
  WHERE  bt."ticker"   = 'BTC'
    AND  bt."txn_type" = 'BUY'
  GROUP  BY bm."region", substr(bt."txn_date",7,4)
),
filtered AS (
  SELECT *
  FROM   region_year_price
  WHERE  rn > 1                   -- exclude the first available year per region
)
SELECT region,
       year,
       avg_price,
       RANK() OVER (PARTITION BY year ORDER BY avg_price DESC)                           AS region_rank,
       ROUND(
         100.0 * (avg_price - LAG(avg_price) OVER (PARTITION BY region ORDER BY year))
         / LAG(avg_price) OVER (PARTITION BY region ORDER BY year)
       ,2)                                                                                AS pct_change_vs_prev_year
FROM   filtered
ORDER  BY year, region_rank
LIMIT 20;
```
