```sql
--Description: ③ Compare overall 2022 vs 2023 revenue to understand magnitude of change
SELECT EXTRACT(YEAR FROM `date`) AS year,
       SUM(sale_dollars)            AS total_sales
FROM   `bigquery-public-data.iowa_liquor_sales.sales`
WHERE  EXTRACT(YEAR FROM `date`) IN (2022, 2023)
GROUP  BY year
ORDER  BY year
LIMIT 20;
```

```sql
--Description: ④ Total 2022 / 2023 sales for each individual item (sample)
SELECT item_number,
       item_description,
       EXTRACT(YEAR FROM `date`) AS year,
       SUM(sale_dollars)         AS sales_year
FROM   `bigquery-public-data.iowa_liquor_sales.sales`
WHERE  EXTRACT(YEAR FROM `date`) IN (2022, 2023)
GROUP  BY item_number, item_description, year
ORDER  BY sales_year DESC
LIMIT 20;
```

```sql
--Description: ⑤ Build year-specific sums for every item & calculate YoY % (preview)
SELECT item_number,
       item_description,
       SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
       SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023,
       SAFE_DIVIDE(
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) -
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END),
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END)
       ) * 100                                                     AS growth_pct
FROM   `bigquery-public-data.iowa_liquor_sales.sales`
WHERE  EXTRACT(YEAR FROM `date`) IN (2022, 2023)
GROUP  BY item_number, item_description
LIMIT 20;
```

```sql
--Description: ⑥ Same as above but keep only items with positive 2022 sales and sort by growth
SELECT item_number,
       item_description,
       SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
       SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023,
       SAFE_DIVIDE(
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) -
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END),
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END)
       ) * 100                                                     AS growth_pct
FROM   `bigquery-public-data.iowa_liquor_sales.sales`
WHERE  EXTRACT(YEAR FROM `date`) IN (2022, 2023)
GROUP  BY item_number, item_description
HAVING sales_2022 > 0
ORDER  BY growth_pct DESC
LIMIT 20;
```

```sql
--Description: ⑦ FINAL ANSWER – top 5 items with the highest YoY growth % in total sales revenue (2023 vs 2022)
SELECT item_number,
       item_description,
       ROUND(sales_2022, 2) AS sales_2022,
       ROUND(sales_2023, 2) AS sales_2023,
       ROUND(growth_pct, 2) AS growth_pct
FROM (
  SELECT item_number,
         item_description,
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
         SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023,
         SAFE_DIVIDE(
           SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) -
           SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END),
           SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END)
         ) * 100                                                   AS growth_pct
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP  BY item_number, item_description
  HAVING sales_2022 > 0
)
ORDER  BY growth_pct DESC
LIMIT 5;
```

