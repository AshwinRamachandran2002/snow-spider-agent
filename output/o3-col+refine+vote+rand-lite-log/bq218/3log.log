```

```sql
-- Description: 7) Compare 2022 vs 2023 sales for every item (20 rows, highest growth % first)
WITH yr AS (
  SELECT
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars)         AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, yr
)
SELECT
  item_description,
  SUM(CASE WHEN yr = 2022 THEN sales END) AS sales_2022,
  SUM(CASE WHEN yr = 2023 THEN sales END) AS sales_2023,
  SAFE_DIVIDE(SUM(CASE WHEN yr = 2023 THEN sales END) -
              SUM(CASE WHEN yr = 2022 THEN sales END),
              SUM(CASE WHEN yr = 2022 THEN sales END))*100  AS yoy_growth_pct
FROM yr
GROUP BY item_description
HAVING sales_2022 > 0
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
-- Description: 8) Same as #7 but keeping only items whose 2023 sales are positive (20 rows)
WITH yr AS (
  SELECT
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars)         AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, yr
)
SELECT
  item_description,
  SUM(CASE WHEN yr = 2022 THEN sales END) AS sales_2022,
  SUM(CASE WHEN yr = 2023 THEN sales END) AS sales_2023,
  SAFE_DIVIDE(SUM(CASE WHEN yr = 2023 THEN sales END) -
              SUM(CASE WHEN yr = 2022 THEN sales END),
              SUM(CASE WHEN yr = 2022 THEN sales END))*100  AS yoy_growth_pct
FROM yr
GROUP BY item_description
HAVING sales_2022 > 0 AND sales_2023 > 0
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
-- Description: 9) Make sure negative-sales items (returns) don’t dominate; show 20 with largest negative growth
WITH yr AS (
  SELECT
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars)         AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, yr
)
SELECT
  item_description,
  SUM(CASE WHEN yr = 2022 THEN sales END) AS sales_2022,
  SUM(CASE WHEN yr = 2023 THEN sales END) AS sales_2023,
  SAFE_DIVIDE(SUM(CASE WHEN yr = 2023 THEN sales END) -
              SUM(CASE WHEN yr = 2022 THEN sales END),
              SUM(CASE WHEN yr = 2022 THEN sales END))*100  AS yoy_growth_pct
FROM yr
GROUP BY item_description
HAVING sales_2022 > 0
ORDER BY yoy_growth_pct ASC   -- negative growth first
LIMIT 20;
```

```sql
-- Description: 10) FINAL ANSWER – Top 5 items with the highest year-over-year growth % (2023 vs 2022)
WITH sales_by_year AS (
  SELECT
    item_description,
    EXTRACT(YEAR FROM `date`)      AS sales_year,
    SUM(sale_dollars)              AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, sales_year
), pivot AS (
  SELECT
    item_description,
    SUM(CASE WHEN sales_year = 2022 THEN total_sales END) AS sales_2022,
    SUM(CASE WHEN sales_year = 2023 THEN total_sales END) AS sales_2023
  FROM sales_by_year
  GROUP BY item_description
), growth AS (
  SELECT
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
  FROM pivot
  WHERE sales_2022 > 0
)
SELECT
  item_description,
  sales_2022,
  sales_2023,
  yoy_growth_pct
FROM growth
ORDER BY yoy_growth_pct DESC
LIMIT 5;
```
