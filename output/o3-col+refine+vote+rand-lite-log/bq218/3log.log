--Description: 8) 2022 vs 2023 comparison keeping only items whose 2023 sales are positive,
--              then listing the 20 highest YoY-growth percentages.
WITH item_year_sales AS (        -- aggregate to (item, year)
  SELECT
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars)         AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, yr
), pivot_sales AS (              -- pivot into two columns
  SELECT
    item_description,
    SUM(CASE WHEN yr = 2022 THEN sales ELSE 0 END) AS sales_2022,
    SUM(CASE WHEN yr = 2023 THEN sales ELSE 0 END) AS sales_2023
  FROM item_year_sales
  GROUP BY item_description
)
SELECT                           -- compute YoY % and filter
  item_description,
  sales_2022,
  sales_2023,
  SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
FROM pivot_sales
WHERE sales_2022 > 0
  AND sales_2023 > 0
ORDER BY yoy_growth_pct DESC
LIMIT 20
