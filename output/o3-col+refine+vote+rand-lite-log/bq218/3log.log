```sql
-- Description: 6) Total 2023 sales revenue for each item (20-row sample)
SELECT
  item_description,
  SUM(sale_dollars) AS sales_2023
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2023
