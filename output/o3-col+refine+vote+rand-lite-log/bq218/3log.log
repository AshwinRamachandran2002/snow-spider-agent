```sql
-- Description / Thinking process:
-- Objective: Identify the 5 liquor items that experienced the greatest
--            percentage increase in total sales dollars from 2022 to 2023.
--
-- Step-1  Aggregate data at the (item, year) level so we know each item’s
--         sales in 2022 and 2023.
-- Step-2  “Pivot” those two years into separate columns (sales_2022, sales_2023).
-- Step-3  Compute year-over-year (YoY) growth percentage:
--              (sales_2023 − sales_2022) / sales_2022 * 100
-- Step-4  Filter out cases where 2022 sales are zero or negative (to avoid
--         division-by-zero and returns) and where 2023 sales are non-positive.
-- Step-5  Sort by YoY growth descending and keep the top 5 records.

WITH item_year_sales AS (           -- Step-1
  SELECT
    item_description,
    EXTRACT(YEAR FROM `date`) AS sales_year,
    SUM(sale_dollars)         AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_description, sales_year
),
pivot_sales AS (                    -- Step-2
  SELECT
    item_description,
    SUM(CASE WHEN sales_year = 2022 THEN total_sales ELSE 0 END) AS sales_2022,
    SUM(CASE WHEN sales_year = 2023 THEN total_sales ELSE 0 END) AS sales_2023
  FROM item_year_sales
  GROUP BY item_description
)
SELECT                               -- Steps-3, 4, 5
  item_description,
  sales_2022,
  sales_2023,
  SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_growth_pct
FROM pivot_sales
WHERE sales_2022 > 0       -- ensure a valid baseline
  AND sales_2023 > 0       -- ensure actual growth
ORDER BY yoy_growth_pct DESC
LIMIT 5;
```
