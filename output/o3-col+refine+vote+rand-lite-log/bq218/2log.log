```sql
--Description: Quick look at the raw data
SELECT *
FROM `bigquery-public-data.iowa_liquor_sales.sales`
LIMIT 20;
```

```sql
--Description: Distinct calendar years present in the table
SELECT DISTINCT EXTRACT(YEAR FROM `date`) AS yr
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY yr
LIMIT 20;
```

```sql
--Description: Total sales revenue (positive dollars only) by year
SELECT 
  EXTRACT(YEAR FROM `date`) AS yr,
  SUM(sale_dollars) AS total_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE sale_dollars > 0
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

```sql
--Description: Top-20 items by 2023 sales revenue (positive dollars only)
SELECT 
  item_number,
  item_description,
  SUM(sale_dollars) AS sales_2023
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE sale_dollars > 0
  AND EXTRACT(YEAR FROM `date`) = 2023
GROUP BY item_number, item_description
ORDER BY sales_2023 DESC
LIMIT 20;
```

```sql
--Description: Top-20 items by 2022 sales revenue (positive dollars only)
SELECT 
  item_number,
  item_description,
  SUM(sale_dollars) AS sales_2022
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE sale_dollars > 0
  AND EXTRACT(YEAR FROM `date`) = 2022
GROUP BY item_number, item_description
ORDER BY sales_2022 DESC
LIMIT 20;
```

```sql
--Description: Year-over-year sales comparison (2022 → 2023) for all items
WITH yearly_sales AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE sale_dollars > 0
    AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
)
SELECT
  a.item_number,
  a.item_description,
  b.sales AS sales_2022,
  a.sales AS sales_2023,
  SAFE_DIVIDE(a.sales - b.sales, b.sales) AS yoy_growth_pct
FROM yearly_sales a
JOIN yearly_sales b
  ON a.item_number = b.item_number
 AND a.yr = 2023
 AND b.yr = 2022
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
--Description: Filter to items with at least $10,000 sales in 2022 to avoid tiny bases
WITH yearly_sales AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE sale_dollars > 0
    AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
)
SELECT
  a.item_number,
  a.item_description,
  b.sales AS sales_2022,
  a.sales AS sales_2023,
  SAFE_DIVIDE(a.sales - b.sales, b.sales) AS yoy_growth_pct
FROM yearly_sales a
JOIN yearly_sales b
  ON a.item_number = b.item_number
 AND a.yr = 2023
 AND b.yr = 2022
WHERE b.sales >= 10000   -- keep reasonably large base year
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
--Description: FINAL – Top-5 items with the highest year-over-year % growth in total
--             sales revenue for 2023 (vs. 2022), considering only items that had
--             at least $10K in 2022 positive sales
WITH yearly_sales AS (
  SELECT
    item_number,
    item_description,
    EXTRACT(YEAR FROM `date`) AS yr,
    SUM(sale_dollars) AS sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE sale_dollars > 0
    AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY item_number, item_description, yr
),
yoy AS (
  SELECT
    a.item_number,
    a.item_description,
    b.sales AS sales_2022,
    a.sales AS sales_2023,
    SAFE_DIVIDE(a.sales - b.sales, b.sales) AS yoy_growth_pct
  FROM yearly_sales a
  JOIN yearly_sales b
    ON a.item_number = b.item_number
   AND a.yr = 2023
   AND b.yr = 2022
  WHERE b.sales >= 10000
)
SELECT
  item_number,
  item_description,
  sales_2022,
  sales_2023,
  ROUND(yoy_growth_pct * 100, 2) AS yoy_growth_percentage
FROM yoy
ORDER BY yoy_growth_pct DESC
LIMIT 20;   -- returns the top 5 rows (5 items) well within the limit
```
