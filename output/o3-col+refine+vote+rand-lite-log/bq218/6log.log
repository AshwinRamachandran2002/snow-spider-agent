```sql
-- Description: 7) Add percentage growth for all items and sort by growth   
SELECT
  `item_number`,
  sales_2022,
  sales_2023,
  SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS growth_pct
FROM (
  SELECT
    `item_number`,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN `sale_dollars` END) AS sales_2022,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN `sale_dollars` END) AS sales_2023
  FROM
    `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE
    EXTRACT(YEAR FROM `date`) IN (2022, 2023)
    AND `sale_dollars` > 0
  GROUP BY
    `item_number`
)
ORDER BY
  growth_pct DESC
LIMIT 20;
```

```sql
-- Description: 8) Bring in a representative description for each item (ANY_VALUE)  
SELECT
  s.`item_number`,
  ANY_VALUE(s.`item_description`) AS item_description,
  SUM(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2022 THEN s.`sale_dollars` END) AS sales_2022,
  SUM(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2023 THEN s.`sale_dollars` END) AS sales_2023
FROM
  `bigquery-public-data.iowa_liquor_sales.sales` AS s
WHERE
  EXTRACT(YEAR FROM s.`date`) IN (2022, 2023)
  AND s.`sale_dollars` > 0
GROUP BY
  s.`item_number`
HAVING
  sales_2022 IS NOT NULL
  AND sales_2023 IS NOT NULL
ORDER BY
  sales_2023 - sales_2022 DESC
LIMIT 20;
```

```sql
-- Description: 9) FINAL ANSWER – Top-5 items with the highest 2023 YoY growth % in total sales revenue  
SELECT
  item_number,
  ANY_VALUE(item_description) AS item_description,
  sales_2022,
  sales_2023,
  ROUND(SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100, 2) AS growth_pct
FROM (
  SELECT
    item_number,
    ANY_VALUE(item_description) AS item_description,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023
  FROM
    `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE
    EXTRACT(YEAR FROM `date`) IN (2022, 2023)
    AND sale_dollars > 0          -- ignore returns / negative values
  GROUP BY
    item_number
)
WHERE
  sales_2022 > 0                  -- avoid divide-by-zero
  AND sales_2023 IS NOT NULL
ORDER BY
  growth_pct DESC
LIMIT 5;
