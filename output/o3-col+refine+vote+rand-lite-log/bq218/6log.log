-- Description: 8) Bring in a representative description for each item (ANY_VALUE)  
SELECT
  s.`item_number`,
  ANY_VALUE(s.`item_description`) AS item_description,
  SUM(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2022 THEN s.`sale_dollars` END) AS sales_2022,
  SUM(CASE WHEN EXTRACT(YEAR FROM s.`date`) = 2023 THEN s.`sale_dollars` END) AS sales_2023
FROM
  `bigquery-public-data.iowa_liquor_sales.sales` AS s
WHERE
  EXTRACT(YEAR FROM s.`date`) IN (2022, 2023)
  AND s.`sale_dollars` > 0
GROUP BY
  s.`item_number`
HAVING
  sales_2022 IS NOT NULL
  AND sales_2023 IS NOT NULL
ORDER BY
  sales_2023 - sales_2022 DESC
LIMIT 20;
