--   Exclude items whose 2022 sales are zero to avoid division by zero.
-- • Step 4  (rank): sort by growth_pct descending and return the top five.

SELECT
  s.item_number,
  s.item_description,
  s.sales_2022,
  s.sales_2023,
  ROUND(SAFE_DIVIDE(s.sales_2023 - s.sales_2022, s.sales_2022) * 100, 2) AS growth_pct
FROM (
  SELECT
    item_number,
    ANY_VALUE(item_description) AS item_description,
