  SUM(`sale_dollars`) AS sales_2022
FROM
  `bigquery-public-data.iowa_liquor_sales.sales`
WHERE
  EXTRACT(YEAR FROM `date`) = 2022
  AND `sale_dollars` > 0
GROUP BY
