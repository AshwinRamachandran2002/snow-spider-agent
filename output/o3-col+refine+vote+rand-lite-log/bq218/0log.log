```sql
--Description: 1. Inspect which calendar years exist in the table.
SELECT DISTINCT
  EXTRACT(YEAR FROM `date`) AS sales_year
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY sales_year
LIMIT 20;
```

```sql
--Description: 2. Look at total (positive) sales dollars by year to confirm 2022 & 2023 are well-populated.
SELECT
  EXTRACT(YEAR FROM `date`) AS sales_year,
  SUM(sale_dollars) AS total_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE sale_dollars > 0            -- ignore returns / corrections
GROUP BY sales_year
ORDER BY sales_year DESC
LIMIT 20;
```

```sql
--Description: 3. Sample 20 item descriptions that sold in 2023.
SELECT DISTINCT
  item_description
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2023
  AND sale_dollars > 0
LIMIT 20;
```

```sql
--Description: 4. Show 2022 & 2023 sales totals for one example item to understand structure.
SELECT
  item_description,
  EXTRACT(YEAR FROM `date`) AS sales_year,
  SUM(sale_dollars) AS total_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE item_description = 'TITOS HANDMADE VODKA'
  AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  AND sale_dollars > 0
GROUP BY item_description, sales_year
ORDER BY sales_year
LIMIT 20;
```

```sql
--Description: 5. Aggregate every item’s annual sales for 2022 & 2023 (positive sales only).
SELECT
  item_description,
  EXTRACT(YEAR FROM `date`) AS sales_year,
  SUM(sale_dollars) AS total_sales_yr
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  AND sale_dollars > 0
GROUP BY item_description, sales_year
ORDER BY item_description, sales_year
LIMIT 20;
```

```sql
--Description: 6. Pivot the previous result so each item has 2022 and 2023 totals in separate columns.
SELECT
  item_description,
  SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
  SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  AND sale_dollars > 0
GROUP BY item_description
HAVING sales_2022 IS NOT NULL AND sales_2023 IS NOT NULL
LIMIT 20;
```

```sql
--Description: 7. Add the year-over-year growth percentage for each item.
SELECT
  item_description,
  sales_2022,
  sales_2023,
  ROUND( (sales_2023 - sales_2022) / sales_2022 * 100 , 2) AS yoy_pct_growth
FROM (
  SELECT
    item_description,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
    AND sale_dollars > 0
  GROUP BY item_description
)
WHERE sales_2022 > 0
LIMIT 20;
```

```sql
--Description: 8. Order by the highest YoY growth to see leading candidates (still capped to 20 rows).
SELECT
  item_description,
  sales_2022,
  sales_2023,
  ROUND( (sales_2023 - sales_2022) / sales_2022 * 100 , 2) AS yoy_pct_growth
FROM (
  SELECT
    item_description,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
    AND sale_dollars > 0
  GROUP BY item_description
)
WHERE sales_2022 > 0
ORDER BY yoy_pct_growth DESC
LIMIT 20;
```

```sql
--Description: 9. Same as above but restrict to items that had at least $5,000 sales in 2023
--   to avoid huge percentages caused by a tiny base year.
SELECT
  item_description,
  sales_2022,
  sales_2023,
  ROUND( (sales_2023 - sales_2022) / sales_2022 * 100 , 2) AS yoy_pct_growth
FROM (
  SELECT
    item_description,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
    AND sale_dollars > 0
  GROUP BY item_description
)
WHERE sales_2022 > 0
  AND sales_2023 >= 5000
ORDER BY yoy_pct_growth DESC
LIMIT 20;
```

```sql
--Description: 10. FINAL ANSWER – return the top 5 items with the highest YoY growth percentage
--   in total sales revenue from 2022 → 2023 (positive sales only).
SELECT
  item_description,
  ROUND(sales_2022, 2) AS sales_2022,
  ROUND(sales_2023, 2) AS sales_2023,
  ROUND( (sales_2023 - sales_2022) / sales_2022 * 100 , 2) AS yoy_pct_growth
FROM (
  SELECT
    item_description,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2022 THEN sale_dollars END) AS sales_2022,
    SUM(CASE WHEN EXTRACT(YEAR FROM `date`) = 2023 THEN sale_dollars END) AS sales_2023
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM `date`) IN (2022, 2023)
    AND sale_dollars > 0
  GROUP BY item_description
)
WHERE sales_2022 > 0
ORDER BY yoy_pct_growth DESC
LIMIT 5;
```
