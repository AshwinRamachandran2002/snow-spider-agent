       `item_number`,
       `item_description`,
       `sale_dollars`
FROM `bigquery-public-data.iowa_liquor_sales.sales`
ORDER BY `date` DESC
LIMIT 20;
```

```sql
--Description: Sample of total 2022 sales revenue per item (highest first, 20 rows).
SELECT `item_number`,
       `item_description`,
       SUM(`sale_dollars`) AS total_2022_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2022
GROUP BY `item_number`, `item_description`
ORDER BY total_2022_sales DESC
LIMIT 20;
```

```sql
--Description: Sample of total 2023 sales revenue per item (highest first, 20 rows).
SELECT `item_number`,
       `item_description`,
       SUM(`sale_dollars`) AS total_2023_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE EXTRACT(YEAR FROM `date`) = 2023
GROUP BY `item_number`, `item_description`
ORDER BY total_2023_sales DESC
LIMIT 20;
```

```sql
--Description: 2022 vs 2023 sales side-by-side for 20 random items.
SELECT a.`item_number`,
       a.`item_description`,
       a.total_2022_sales,
       b.total_2023_sales
FROM (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2022_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2022
      GROUP BY `item_number`, `item_description`
     ) a
JOIN (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2023_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2023
      GROUP BY `item_number`, `item_description`
     ) b
ON a.`item_number` = b.`item_number`
ORDER BY RAND()
LIMIT 20;
```

```sql
--Description: Compute YoY growth % for 2023 vs 2022, show 20 items with biggest % increase.
SELECT a.`item_number`,
       a.`item_description`,
       a.total_2022_sales,
       b.total_2023_sales,
       ROUND(100 * (b.total_2023_sales - a.total_2022_sales) / a.total_2022_sales, 2) AS yoy_growth_pct
FROM (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2022_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2022
      GROUP BY `item_number`, `item_description`
     ) a
JOIN (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2023_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2023
      GROUP BY `item_number`, `item_description`
     ) b
ON a.`item_number` = b.`item_number`
WHERE a.total_2022_sales > 0
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
--Description: Same as above but exclude items whose 2023 sales are negative (returns), show 20 rows.
SELECT a.`item_number`,
       a.`item_description`,
       a.total_2022_sales,
       b.total_2023_sales,
       ROUND(100 * (b.total_2023_sales - a.total_2022_sales) / a.total_2022_sales, 2) AS yoy_growth_pct
FROM (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2022_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2022
      GROUP BY `item_number`, `item_description`
     ) a
JOIN (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2023_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2023
      GROUP BY `item_number`, `item_description`
     ) b
ON a.`item_number` = b.`item_number`
WHERE a.total_2022_sales > 0
  AND b.total_2023_sales > 0
ORDER BY yoy_growth_pct DESC
LIMIT 20;
```

```sql
--Description: Final query – Top 5 items with the highest year-over-year growth % in total sales revenue for the year 2023.
SELECT a.`item_number`,
       a.`item_description`,
       a.total_2022_sales,
       b.total_2023_sales,
       ROUND(100 * (b.total_2023_sales - a.total_2022_sales) / a.total_2022_sales, 2) AS yoy_growth_pct
FROM (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2022_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2022
      GROUP BY `item_number`, `item_description`
     ) a
JOIN (
      SELECT `item_number`,
             `item_description`,
             SUM(`sale_dollars`) AS total_2023_sales
      FROM `bigquery-public-data.iowa_liquor_sales.sales`
      WHERE EXTRACT(YEAR FROM `date`) = 2023
      GROUP BY `item_number`, `item_description`
     ) b
ON a.`item_number` = b.`item_number`
WHERE a.total_2022_sales > 0            -- avoid divide-by-zero
  AND b.total_2023_sales > 0            -- keep only items that actually grew
ORDER BY yoy_growth_pct DESC
LIMIT 5;
```

These eight queries (all `SELECT` statements) progressively build understanding of the data, compare 2022 vs 2023 sales, and finally return the top 5 items that experienced the highest year-over-year growth in total sales revenue during 2023.
