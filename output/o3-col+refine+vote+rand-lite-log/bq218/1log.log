GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: Identify the 10 highest-grossing items (positive sales only) in 2023.
SELECT
  `item_number`,
  `item_description`,
  SUM(`sale_dollars`) AS sales_2023
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE `sale_dollars` > 0
  AND EXTRACT(YEAR FROM `date`) = 2023
GROUP BY `item_number`, `item_description`
ORDER BY sales_2023 DESC
LIMIT 10;
```

```sql
--Description: For one sample item, compare its 2022 vs 2023 revenue (helps validate YoY logic).
SELECT
  `item_number`,
  `item_description`,
  EXTRACT(YEAR FROM `date`) AS year,
  SUM(`sale_dollars`) AS total_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE `item_number` = '38178'        -- <-- any item from previous query
  AND `sale_dollars` > 0
  AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
GROUP BY `item_number`, `item_description`, year
ORDER BY year
LIMIT 20;
```

```sql
--Description: Aggregate yearly sales for every item for 2022 & 2023 (positive sales only).
SELECT
  `item_number`,
  `item_description`,
  EXTRACT(YEAR FROM `date`) AS year,
  SUM(`sale_dollars`) AS total_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE `sale_dollars` > 0
  AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
GROUP BY `item_number`, `item_description`, year
LIMIT 20;
```

```sql
--Description: Pivot the previous result to have 2022 & 2023 columns side-by-side per item.
WITH yearly_sales AS (
  SELECT
    `item_number`,
    `item_description`,
    EXTRACT(YEAR FROM `date`) AS year,
    SUM(`sale_dollars`) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `sale_dollars` > 0
    AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)
  GROUP BY `item_number`, `item_description`, year
)
SELECT
  item_number,
  item_description,
  MAX(IF(year = 2022, total_sales, NULL)) AS sales_2022,
  MAX(IF(year = 2023, total_sales, NULL)) AS sales_2023
FROM yearly_sales
GROUP BY item_number, item_description
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – Top 5 items with the highest YoY % growth in total sales revenue for 2023.
WITH yearly_sales AS (
  SELECT
    `item_number`,
    `item_description`,
    EXTRACT(YEAR FROM `date`) AS year,
    SUM(`sale_dollars`) AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `sale_dollars` > 0                         -- ignore returns/credits
    AND EXTRACT(YEAR FROM `date`) IN (2022, 2023)  -- compare only these two years
  GROUP BY `item_number`, `item_description`, year
),
sales_pivot AS (
  SELECT
    item_number,
    item_description,
    MAX(IF(year = 2022, total_sales, NULL)) AS sales_2022,
    MAX(IF(year = 2023, total_sales, NULL)) AS sales_2023
  FROM yearly_sales
  GROUP BY item_number, item_description
),
growth AS (
  SELECT
    item_number,
    item_description,
    sales_2022,
    sales_2023,
    SAFE_DIVIDE(sales_2023 - sales_2022, sales_2022) * 100 AS yoy_pct_growth
  FROM sales_pivot
  WHERE sales_2022 > 0        -- must have sales in 2022 to compute % growth
)
SELECT
  item_number,
  item_description,
  ROUND(sales_2022, 2) AS sales_2022,
  ROUND(sales_2023, 2) AS sales_2023,
  ROUND(yoy_pct_growth, 2) AS yoy_pct_growth
FROM growth
ORDER BY yoy_pct_growth DESC
LIMIT 5;
```

These queries progress from basic exploration to the final computation of the “top 5 items with the highest year-over-year growth percentage in total sales revenue for 2023.”
