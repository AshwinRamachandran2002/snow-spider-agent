ON  LPAD(c.geo_id, 5, '0') = s.county_fips_code
WHERE s.date = '2020-08-27'
LIMIT 20;
```

```sql
-- 4. Description: Compute COVID cases and deaths per 100k plus case-fatality rate
--    for a handful of joined counties (population filter added).
SELECT
  s.county_name,
  s.state,
  c.total_pop,
  s.confirmed_cases,
  s.deaths,
  ROUND(s.confirmed_cases / c.total_pop * 100000, 1) AS cases_per_100k,
  ROUND(s.deaths         / c.total_pop * 100000, 1) AS deaths_per_100k,
  ROUND(s.deaths / s.confirmed_cases * 100, 2)      AS cfr_pct
FROM `bigquery-public-data.covid19_usafacts.summary` AS s
JOIN `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
ON  LPAD(c.geo_id, 5, '0') = s.county_fips_code
WHERE s.date = '2020-08-27'
  AND c.total_pop > 50000
LIMIT 20;
```

```sql
-- 5. Description: Rank all counties (pop > 50k) by case-fatality rate on 2020-08-27.
SELECT
  s.county_name,
  s.state,
  ROUND(s.deaths / s.confirmed_cases * 100, 2) AS cfr_pct
FROM `bigquery-public-data.covid19_usafacts.summary` AS s
JOIN `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
ON  LPAD(c.geo_id, 5, '0') = s.county_fips_code
WHERE s.date = '2020-08-27'
  AND c.total_pop > 50000
  AND s.confirmed_cases > 0
ORDER BY cfr_pct DESC
LIMIT 20;
```

```sql
-- 6. Description: Pull the full detail for the top three counties with the highest
--    COVID-19 case-fatality rates (population > 50k) on 27-Aug-2020.
SELECT
  s.county_name                                          AS county,
  s.state,
  c.median_age,
  c.total_pop,
  ROUND(s.confirmed_cases / c.total_pop * 100000, 1)     AS cases_per_100k,
  ROUND(s.deaths         / c.total_pop * 100000, 1)      AS deaths_per_100k,
  ROUND(s.deaths / s.confirmed_cases * 100, 2)           AS case_fatality_rate_pct
FROM `bigquery-public-data.covid19_usafacts.summary` AS s
JOIN `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
  ON LPAD(c.geo_id, 5, '0') = s.county_fips_code
WHERE s.date = '2020-08-27'
  AND c.total_pop > 50000
  AND s.county_fips_code != '00000'      -- exclude statewide aggregates
  AND s.confirmed_cases > 0
ORDER BY case_fatality_rate_pct DESC
LIMIT 3;
```

These six queries (well under the 10-query limit) progress from simple inspection to the final answer, identifying the three 50 k+‐population counties with the highest COVID-19 case-fatality rates on 27 Aug 2020 and reporting all requested statistics.
