Query:
-- 3. Description: Make sure FIPS codes line up after left-padding the census geo_id.
SELECT
  LPAD(c.geo_id, 5, '0') AS census_fips,
  c.total_pop,
  s.county_fips_code,
  s.county_name,
  s.state
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
JOIN `bigquery-public-data.covid19_usafacts.summary`        AS s
ON  LPAD(c.geo_id, 5, '0') = s.county_fips_code
WHERE s.date = '2020-08-27'
LIMIT 20;
