Query:
-- 5. Description: Rank all counties (pop > 50k) by case-fatality rate on 2020-08-27.
SELECT
  s.county_name,
  s.state,
  ROUND(s.deaths / s.confirmed_cases * 100, 2) AS cfr_pct
FROM `bigquery-public-data.covid19_usafacts.summary` AS s
JOIN `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c
ON  LPAD(c.geo_id, 5, '0') = s.county_fips_code
WHERE s.date = '2020-08-27'
  AND c.total_pop > 50000
  AND s.confirmed_cases > 0
ORDER BY cfr_pct DESC
LIMIT 20;
