```sql
--Description: Test join (with zero-padding) between county ACS data and confirmed cases for 20 records.
SELECT
  LPAD(c2020.geo_id,5,'0') AS fips,
  c2020.total_pop,
  cc._2020_08_27 AS cases
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases` AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
LIMIT 20;
```

```sql
--Description: Test full join (ACS + confirmed cases + deaths) and compute simple CFR for 20 rows.
SELECT
  LPAD(c2020.geo_id,5,'0') AS fips,
  cc._2020_08_27 AS cases,
  cd._2020_08_27 AS deaths,
  SAFE_DIVIDE(cd._2020_08_27, cc._2020_08_27)*100 AS cfr_pct
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases`  AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
JOIN `bigquery-public-data.covid19_usafacts.deaths`           AS cd
  ON cc.county_fips_code = cd.county_fips_code
LIMIT 20;
```

```sql
--Description: List counties (pop > 50,000) with cases, deaths, computed rates; show 20 highest CFRs.
SELECT
  cc.county_name,
  cc.state,
  c2020.total_pop,
  cc._2020_08_27 AS cases,
  cd._2020_08_27 AS deaths,
  SAFE_DIVIDE(cc._2020_08_27, c2020.total_pop)*100000 AS cases_per_100k,
  SAFE_DIVIDE(cd._2020_08_27, c2020.total_pop)*100000 AS deaths_per_100k,
  SAFE_DIVIDE(cd._2020_08_27, cc._2020_08_27)*100     AS cfr_pct
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases` AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
JOIN `bigquery-public-data.covid19_usafacts.deaths` AS cd
  ON cc.county_fips_code = cd.county_fips_code
WHERE c2020.total_pop > 50000
  AND cc._2020_08_27 IS NOT NULL
  AND cc._2020_08_27 > 0
ORDER BY cfr_pct DESC
LIMIT 20;
```

```sql
--Description: Same list as above, but include median age; still showing top 20 CFRs.
SELECT
  cc.county_name,
  cc.state,
  c2020.median_age,
  c2020.total_pop,
  cc._2020_08_27 AS cases,
  cd._2020_08_27 AS deaths,
  SAFE_DIVIDE(cc._2020_08_27, c2020.total_pop)*100000 AS cases_per_100k,
  SAFE_DIVIDE(cd._2020_08_27, c2020.total_pop)*100000 AS deaths_per_100k,
  SAFE_DIVIDE(cd._2020_08_27, cc._2020_08_27)*100     AS cfr_pct
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases` AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
JOIN `bigquery-public-data.covid19_usafacts.deaths` AS cd
  ON cc.county_fips_code = cd.county_fips_code
WHERE c2020.total_pop > 50000
  AND cc._2020_08_27 IS NOT NULL
  AND cc._2020_08_27 > 0
ORDER BY cfr_pct DESC
LIMIT 20;
```

```sql
--Description: Final query – top 3 counties (pop > 50k) with highest COVID-19 case fatality rate on 2020-08-27.
SELECT
  cc.county_name      AS county,
  cc.state            AS state,
  c2020.median_age    AS median_age,
  c2020.total_pop     AS total_population,
  ROUND(SAFE_DIVIDE(cc._2020_08_27, c2020.total_pop)*100000, 1) AS cases_per_100k,
  ROUND(SAFE_DIVIDE(cd._2020_08_27, c2020.total_pop)*100000, 1) AS deaths_per_100k,
  ROUND(SAFE_DIVIDE(cd._2020_08_27, cc._2020_08_27)*100, 2)    AS case_fatality_rate_pct
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases`   AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
JOIN `bigquery-public-data.covid19_usafacts.deaths`            AS cd
  ON cc.county_fips_code = cd.county_fips_code
WHERE c2020.total_pop > 50000
  AND cc._2020_08_27 IS NOT NULL
  AND cc._2020_08_27 > 0
ORDER BY case_fatality_rate_pct DESC
LIMIT 3;
```

