--Description: List counties (pop > 50,000) with cases, deaths, computed rates; show 20 highest CFRs.
SELECT
  cc.county_name,
  cc.state,
  c2020.total_pop,
  cc._2020_08_27 AS cases,
  cd._2020_08_27 AS deaths,
  SAFE_DIVIDE(cc._2020_08_27, c2020.total_pop)*100000 AS cases_per_100k,
  SAFE_DIVIDE(cd._2020_08_27, c2020.total_pop)*100000 AS deaths_per_100k,
  SAFE_DIVIDE(cd._2020_08_27, cc._2020_08_27)*100     AS cfr_pct
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases` AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
JOIN `bigquery-public-data.covid19_usafacts.deaths` AS cd
  ON cc.county_fips_code = cd.county_fips_code
WHERE c2020.total_pop > 50000
  AND cc._2020_08_27 IS NOT NULL
  AND cc._2020_08_27 > 0
ORDER BY cfr_pct DESC
LIMIT 20;
