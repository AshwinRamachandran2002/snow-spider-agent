Query:
--Description: Test join (with zero-padding) between county ACS data and confirmed cases for 20 records.
SELECT
  LPAD(c2020.geo_id,5,'0') AS fips,
  c2020.total_pop,
  cc._2020_08_27 AS cases
FROM `bigquery-public-data.census_bureau_acs.county_2020_5yr` AS c2020
JOIN `bigquery-public-data.covid19_usafacts.confirmed_cases` AS cc
  ON LPAD(c2020.geo_id,5,'0') = cc.county_fips_code
LIMIT 20;
