```

```sql
--Description: 4) Quick check of how many counties have both cases & deaths reported that day
SELECT COUNT(*) AS joined_rows
FROM   `bigquery-public-data.covid19_usafacts.confirmed_cases`  c
JOIN   `bigquery-public-data.covid19_usafacts.deaths`           d
ON     c.county_fips_code = d.county_fips_code;
```

```sql
--Description: 5) Join cases & deaths to compute raw case-fatality (deaths / cases) for a sample
SELECT c.county_fips_code,
       c.county_name,
       c.state,
       c._2020_08_27 AS cases,
       d._2020_08_27 AS deaths,
       SAFE_DIVIDE(d._2020_08_27 , c._2020_08_27) * 100 AS case_fatality_pct
FROM   `bigquery-public-data.covid19_usafacts.confirmed_cases`  c
JOIN   `bigquery-public-data.covid19_usafacts.deaths`           d
ON     c.county_fips_code = d.county_fips_code
LIMIT  20;
```

```sql
--Description: 6) Add 2020 demographic data to get population & median age alongside COVID numbers
SELECT  c.county_fips_code,
        c.county_name,
        c.state,
        pop.total_pop,
        pop.median_age,
        c._2020_08_27 AS cases,
        d._2020_08_27 AS deaths
FROM    `bigquery-public-data.covid19_usafacts.confirmed_cases`  c
JOIN    `bigquery-public-data.covid19_usafacts.deaths`           d
         ON  c.county_fips_code = d.county_fips_code
JOIN    `bigquery-public-data.census_bureau_acs.county_2020_5yr` pop
         ON  pop.geo_id = c.county_fips_code
LIMIT   20;
```

```sql
--Description: 7) Compute per-100k rates & fatality % for every county (population filter applied)
SELECT  c.county_fips_code,
        c.county_name,
        c.state,
        pop.total_pop,
        SAFE_DIVIDE(c._2020_08_27 , pop.total_pop)*100000  AS cases_per_100k,
        SAFE_DIVIDE(d._2020_08_27 , pop.total_pop)*100000  AS deaths_per_100k,
        SAFE_DIVIDE(d._2020_08_27 , c._2020_08_27)*100     AS case_fatality_pct
FROM    `bigquery-public-data.covid19_usafacts.confirmed_cases`  c
JOIN    `bigquery-public-data.covid19_usafacts.deaths`           d
         ON  c.county_fips_code = d.county_fips_code
JOIN    `bigquery-public-data.census_bureau_acs.county_2020_5yr` pop
         ON  pop.geo_id = c.county_fips_code
WHERE   pop.total_pop > 50000
LIMIT   20;
```

```sql
--Description: 8) Order counties (pop>50k) by highest case-fatality, view top 10 for sanity-check
SELECT  c.county_fips_code,
        c.county_name,
        c.state,
        pop.total_pop,
        SAFE_DIVIDE(d._2020_08_27 , c._2020_08_27)*100 AS case_fatality_pct
FROM    `bigquery-public-data.covid19_usafacts.confirmed_cases`  c
JOIN    `bigquery-public-data.covid19_usafacts.deaths`           d
         ON c.county_fips_code = d.county_fips_code
JOIN    `bigquery-public-data.census_bureau_acs.county_2020_5yr` pop
         ON pop.geo_id = c.county_fips_code
WHERE   pop.total_pop > 50000
ORDER BY case_fatality_pct DESC
LIMIT   10;
```

```sql
--Description: 9) Final answer – top 3 large-population counties with the highest 8/27/20 fatality rates
SELECT  c.county_name                                   AS county,
        c.state,
        pop.median_age,
        pop.total_pop,
        ROUND(SAFE_DIVIDE(c._2020_08_27 , pop.total_pop)*100000 , 1) AS cases_per_100k,
        ROUND(SAFE_DIVIDE(d._2020_08_27 , pop.total_pop)*100000 , 1) AS deaths_per_100k,
        ROUND(SAFE_DIVIDE(d._2020_08_27 , c._2020_08_27)*100  , 2)  AS case_fatality_rate_pct
FROM    `bigquery-public-data.covid19_usafacts.confirmed_cases`  c
JOIN    `bigquery-public-data.covid19_usafacts.deaths`           d
         ON  c.county_fips_code = d.county_fips_code
JOIN    `bigquery-public-data.census_bureau_acs.county_2020_5yr` pop
         ON  pop.geo_id = c.county_fips_code
WHERE   pop.total_pop > 50000
  AND   c._2020_08_27  > 0                                     -- avoid divide-by-zero
ORDER BY SAFE_DIVIDE(d._2020_08_27 , c._2020_08_27) DESC
LIMIT   3;
```
