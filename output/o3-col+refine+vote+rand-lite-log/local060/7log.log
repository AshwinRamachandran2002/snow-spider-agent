```sql
--Description: 5)  Total Q4-2020 sales (no-promotion = promo_id 999) by city.
SELECT c."cust_city",
       SUM(s."amount_sold") AS sales_q4_2020
FROM   "sales"      AS s
JOIN   "customers"  AS c ON s."cust_id" = c."cust_id"
JOIN   "times"      AS t ON s."time_id" = t."time_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" = 2020
  AND  s."promo_id" = 999          -- “NO PROMOTION”
GROUP  BY c."cust_city"
ORDER  BY sales_q4_2020 DESC
LIMIT 20;
```

```sql
--Description: 6)  Cities whose Q4-2020 (no-promo) sales ≥120 % of Q4-2019 (no-promo) sales.
WITH q4_19 AS (
     SELECT c."cust_city", SUM(s."amount_sold") AS sales_19
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times" AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" = 2019
       AND  s."promo_id" = 999
     GROUP  BY c."cust_city"
), q4_20 AS (
     SELECT c."cust_city", SUM(s."amount_sold") AS sales_20
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times" AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" = 2020
       AND  s."promo_id" = 999
     GROUP  BY c."cust_city"
)
SELECT a."cust_city",
       a.sales_19,
       b.sales_20,
       ROUND(1.0*b.sales_20 / a.sales_19, 2) AS growth_factor
FROM   q4_19 AS a
JOIN   q4_20 AS b ON a."cust_city" = b."cust_city"
WHERE  b.sales_20 >= 1.2 * a.sales_19
ORDER  BY growth_factor DESC
LIMIT 20;
```

```sql
--Description: 7)  For the growth cities from (6), total Q4-2019 & Q4-2020 (no-promo) sales by product.
WITH growth_cities AS (
     SELECT a."cust_city"
     FROM (
           SELECT c."cust_city",
                  SUM(CASE WHEN t."calendar_year" = 2019 THEN s."amount_sold" END) AS s19,
                  SUM(CASE WHEN t."calendar_year" = 2020 THEN s."amount_sold" END) AS s20
           FROM   "sales" AS s
           JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
           JOIN   "times" AS t ON s."time_id" = t."time_id"
           WHERE  t."calendar_quarter_number" = 4
             AND  t."calendar_year" IN (2019, 2020)
             AND  s."promo_id" = 999
           GROUP  BY c."cust_city"
           HAVING s20 >= 1.2 * s19
     ) a
)
SELECT s."prod_id",
       SUM(s."amount_sold") AS two_qtrs_sales
FROM   "sales" AS s
JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
JOIN   "times"     AS t ON s."time_id" = t."time_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" IN (2019, 2020)
  AND  s."promo_id" = 999
  AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
GROUP  BY s."prod_id"
ORDER  BY two_qtrs_sales DESC
LIMIT 20;
```

```sql
--Description: 8)  Rank products from (7) and keep the top 20 % by total two-quarter sales.
WITH prod_rank AS (
     SELECT s."prod_id",
            SUM(s."amount_sold") AS tot_sales,
            ROW_NUMBER() OVER (ORDER BY SUM(s."amount_sold") DESC) AS rn,
            COUNT(*) OVER () AS cnt
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times"     AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019, 2020)
       AND  s."promo_id" = 999
       AND  c."cust_city" IN (SELECT "cust_city"
                              FROM (
                                   SELECT c2."cust_city",
                                          SUM(CASE WHEN t2."calendar_year"=2019 THEN s2."amount_sold" END) AS s19,
                                          SUM(CASE WHEN t2."calendar_year"=2020 THEN s2."amount_sold" END) AS s20
                                   FROM   "sales" AS s2
                                   JOIN   "customers" AS c2 ON s2."cust_id" = c2."cust_id"
                                   JOIN   "times"     AS t2 ON s2."time_id" = t2."time_id"
                                   WHERE  t2."calendar_quarter_number" = 4
                                     AND  t2."calendar_year" IN (2019,2020)
                                     AND  s2."promo_id" = 999
                                   GROUP  BY c2."cust_city"
                                   HAVING s20 >= 1.2 * s19))
     GROUP BY s."prod_id"
)
SELECT "prod_id", tot_sales
FROM   prod_rank
WHERE  rn <= 0.2 * cnt
ORDER  BY tot_sales DESC
LIMIT 20;
```

```sql
--Description: 9)  For those top-20 % products, compute their Q4-2019 sales share in growth cities.
WITH growth_cities AS (
     SELECT c."cust_city"
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times" AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" = 999
     GROUP  BY c."cust_city"
     HAVING SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) >=
            1.2 * SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END)
), top_prod AS (
     SELECT "prod_id"
     FROM (
          SELECT s."prod_id",
                 SUM(s."amount_sold") AS tot,
                 ROW_NUMBER() OVER (ORDER BY SUM(s."amount_sold") DESC) AS rn,
                 COUNT(*)     OVER () AS cnt
          FROM   "sales" AS s
          JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
          JOIN   "times"     AS t ON s."time_id" = t."time_id"
          WHERE  t."calendar_quarter_number" = 4
            AND  t."calendar_year" IN (2019,2020)
            AND  s."promo_id" = 999
            AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
          GROUP  BY s."prod_id"
     ) r
     WHERE rn <= 0.2 * cnt
), tot19 AS (
     SELECT SUM(s."amount_sold") AS all_sales_19
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times"     AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" = 2019
       AND  s."promo_id" = 999
       AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
)
SELECT tp."prod_id",
       SUM(s."amount_sold") AS prod_sales_2019,
       ROUND(1.0 * SUM(s."amount_sold") / (SELECT all_sales_19 FROM tot19), 4) AS share_2019
FROM   top_prod AS tp
JOIN   "sales"  AS s ON s."prod_id" = tp."prod_id"
JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
JOIN   "times"     AS t ON s."time_id" = t."time_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" = 2019
  AND  s."promo_id" = 999
  AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
GROUP  BY tp."prod_id"
ORDER  BY share_2019 DESC
LIMIT 20;
```

```sql
--Description: 10)  Share change (Q4-2020 vs Q4-2019) for the same top products in growth cities.
WITH growth_cities AS (
     SELECT c."cust_city"
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times" AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" = 999
     GROUP  BY c."cust_city"
     HAVING SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) >=
            1.2 * SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END)
), top_prod AS (
     SELECT "prod_id"
     FROM (
          SELECT s."prod_id",
                 SUM(s."amount_sold") AS tot,
                 ROW_NUMBER() OVER (ORDER BY SUM(s."amount_sold") DESC) AS rn,
                 COUNT(*)     OVER () AS cnt
          FROM   "sales" AS s
          JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
          JOIN   "times"     AS t ON s."time_id" = t."time_id"
          WHERE  t."calendar_quarter_number" = 4
            AND  t."calendar_year" IN (2019,2020)
            AND  s."promo_id" = 999
            AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
          GROUP  BY s."prod_id"
     ) r
     WHERE rn <= 0.2 * cnt
), yearly_tot AS (
     SELECT
            SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS tot19,
            SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS tot20
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times"     AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" = 999
       AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
), shares AS (
     SELECT tp."prod_id",
            SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
            SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
     FROM   top_prod AS tp
     JOIN   "sales"  AS s ON s."prod_id" = tp."prod_id"
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times"     AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" = 999
       AND  c."cust_city" IN (SELECT "cust_city" FROM growth_cities)
     GROUP  BY tp."prod_id"
)
SELECT sh."prod_id",
       ROUND(1.0*sh.s19 / (SELECT tot19 FROM yearly_tot),4) AS share_2019,
       ROUND(1.0*sh.s20 / (SELECT tot20 FROM yearly_tot),4) AS share_2020,
       ROUND(1.0*sh.s20 / (SELECT tot20 FROM yearly_tot) -
             1.0*sh.s19 / (SELECT tot19 FROM yearly_tot),4)  AS share_change
FROM   shares AS sh
ORDER  BY share_change DESC
LIMIT 20;
```
