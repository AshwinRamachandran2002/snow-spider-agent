```sql
--Description: 4)  Total Q4-2019 sales (no promotion) by city to get a feel for magnitudes.
SELECT c."cust_city",
       SUM(s."amount_sold") AS "sales_q4_2019"
FROM   "sales"  AS s
JOIN   "customers" AS c  ON s."cust_id" = c."cust_id"
JOIN   "times" AS t      ON s."time_id" = t."time_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" = 2019
  AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")   -- no-promo
GROUP  BY c."cust_city"
ORDER  BY "sales_q4_2019" DESC
LIMIT 20;
```

```sql
--Description: 5)  Total Q4-2020 sales (no promotion) by city using the same logic.
SELECT c."cust_city",
       SUM(s."amount_sold") AS "sales_q4_2020"
FROM   "sales"  AS s
JOIN   "customers" AS c  ON s."cust_id" = c."cust_id"
JOIN   "times" AS t      ON s."time_id" = t."time_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" = 2020
  AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
GROUP  BY c."cust_city"
ORDER  BY "sales_q4_2020" DESC
LIMIT 20;
```

```sql
--Description: 6)  Combine the two previous queries to list only the cities whose 2020 Q4 sales
--               are at least 120 % of 2019 Q4 sales ( ≥20 % growth).  
SELECT a."cust_city",
       a."sales_q4_2019",
       b."sales_q4_2020",
       ROUND(1.0*b."sales_q4_2020"/a."sales_q4_2019",2) AS "growth_factor"
FROM (
        SELECT c."cust_city", SUM(s."amount_sold") AS "sales_q4_2019"
        FROM   "sales" AS s
        JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN   "times" AS t ON s."time_id" = t."time_id"
        WHERE  t."calendar_quarter_number" = 4
          AND  t."calendar_year" = 2019
          AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
        GROUP BY c."cust_city"
     ) a
JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS "sales_q4_2020"
        FROM   "sales" AS s
        JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN   "times" AS t ON s."time_id" = t."time_id"
        WHERE  t."calendar_quarter_number" = 4
          AND  t."calendar_year" = 2020
          AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
        GROUP BY c."cust_city"
     ) b
     ON a."cust_city" = b."cust_city"
WHERE  b."sales_q4_2020" >= 1.2 * a."sales_q4_2019"
ORDER  BY "growth_factor" DESC
LIMIT 20;
```

```sql
--Description: 7)  For the qualified growth cities from (6), pull the raw transaction lines 
--               for BOTH Q4-2019 and Q4-2020 – still “no promotion” – 
--               so we can rank products by total sales within those cities.
SELECT s."prod_id",
       SUM(s."amount_sold") AS "two_qtrs_sales"
FROM   "sales" AS s
JOIN   "customers" AS c  ON s."cust_id" = c."cust_id"
JOIN   "times" AS t      ON s."time_id" = t."time_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" IN (2019,2020)
  AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
  AND  c."cust_city" IN (
          SELECT a."cust_city"
          FROM (
                  SELECT c."cust_city", SUM(s."amount_sold") AS "sales_q4_2019"
                  FROM "sales" AS s
                  JOIN "customers" AS c ON s."cust_id" = c."cust_id"
                  JOIN "times" AS t ON s."time_id" = t."time_id"
                  WHERE t."calendar_quarter_number" = 4
                    AND t."calendar_year" = 2019
                    AND s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                  GROUP BY c."cust_city"
               ) a
          JOIN (
                  SELECT c."cust_city", SUM(s."amount_sold") AS "sales_q4_2020"
                  FROM "sales" AS s
                  JOIN "customers" AS c ON s."cust_id" = c."cust_id"
                  JOIN "times" AS t ON s."time_id" = t."time_id"
                  WHERE t."calendar_quarter_number" = 4
                    AND t."calendar_year" = 2020
                    AND s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                  GROUP BY c."cust_city"
               ) b
            ON a."cust_city" = b."cust_city"
          WHERE b."sales_q4_2020" >= 1.2 * a."sales_q4_2019"
       )
GROUP  BY s."prod_id"
ORDER  BY "two_qtrs_sales" DESC
LIMIT 20;
```

```sql
--Description: 8)  Show each product’s Q4-2019 share among ONLY the “top-20 % products”
--               (taken from the ranking in 7) – here we simply LIMIT by 20 % of row-count.  
--               First get the cut-off count.
WITH ranked AS (
     SELECT s."prod_id",
            SUM(s."amount_sold") AS "two_qtrs_sales",
            ROW_NUMBER() OVER (ORDER BY SUM(s."amount_sold") DESC) AS rn,
            COUNT(*) OVER ()  AS cnt
     FROM   "sales" AS s
     JOIN   "customers" AS c  ON s."cust_id" = c."cust_id"
     JOIN   "times"     AS t  ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
       AND  c."cust_city" IN (  /* same city filter as step 6 */ 
             SELECT g."cust_city"
             FROM (
                   SELECT c."cust_city",
                          SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                          SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                   FROM   "sales" AS s
                   JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
                   JOIN   "times" AS t ON s."time_id" = t."time_id"
                   WHERE  t."calendar_quarter_number" = 4
                     AND  t."calendar_year" IN (2019,2020)
                     AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                   GROUP BY c."cust_city"
                  ) g
             WHERE g."s20" >= 1.2 * g."s19"
          )
     GROUP  BY s."prod_id"
)
SELECT *
FROM   ranked
WHERE  rn <= 0.2*cnt
ORDER  BY "two_qtrs_sales" DESC
LIMIT 20;
```

```sql
--Description: 9)  Compute each top product’s share of total “no-promo” sales in the growth
--               cities for Q4-2019.
WITH top_prod AS (  -- the product list obtained in step 8
     SELECT r."prod_id"
     FROM   (
               SELECT s."prod_id",
                      SUM(s."amount_sold") AS tot,
                      ROW_NUMBER() OVER (ORDER BY SUM(s."amount_sold") DESC) AS rn,
                      COUNT(*) OVER () AS cnt
               FROM   "sales" AS s
               JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
               JOIN   "times" AS t ON s."time_id" = t."time_id"
               WHERE  t."calendar_quarter_number" = 4
                 AND  t."calendar_year" IN (2019,2020)
                 AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                 AND  c."cust_city" IN (SELECT "cust_city" FROM ( /* city filter same as above */ 
                                            SELECT c."cust_city",
                                                   SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                                                   SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                                            FROM "sales" AS s
                                            JOIN "customers" AS c ON s."cust_id" = c."cust_id"
                                            JOIN "times" AS t ON s."time_id" = t."time_id"
                                            WHERE t."calendar_quarter_number" = 4
                                              AND t."calendar_year" IN (2019,2020)
                                              AND s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                                            GROUP BY c."cust_city"
                                            HAVING s20 >= 1.2*s19 ) )
               GROUP BY s."prod_id"
            ) r
     WHERE r.rn <= 0.2*r.cnt
),
total19 AS ( -- total sales over all products (for denominator)
     SELECT SUM(s."amount_sold") AS tot19
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times" AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" = 2019
       AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
       AND  c."cust_city" IN (SELECT "cust_city"
                              FROM (SELECT c."cust_city",
                                           SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                                           SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                                    FROM "sales" AS s
                                    JOIN "customers" AS c ON s."cust_id" = c."cust_id"
                                    JOIN "times" AS t ON s."time_id" = t."time_id"
                                    WHERE t."calendar_quarter_number" = 4
                                      AND t."calendar_year" IN (2019,2020)
                                      AND s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                                    GROUP BY c."cust_city"
                                    HAVING s20 >= 1.2*s19))
)
SELECT tp."prod_id",
       SUM(s."amount_sold") AS prod_sales_2019,
       (SELECT tot19 FROM total19)                AS total_sales_2019,
       ROUND(1.0*SUM(s."amount_sold")/(SELECT tot19 FROM total19),4) AS share_2019
FROM   "sales" AS s
JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
JOIN   "times" AS t ON s."time_id" = t."time_id"
JOIN   top_prod  AS tp ON s."prod_id" = tp."prod_id"
WHERE  t."calendar_quarter_number" = 4
  AND  t."calendar_year" = 2019
  AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
  AND  c."cust_city" IN (SELECT "cust_city"
                         FROM (SELECT c."cust_city",
                                      SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                                      SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                               FROM "sales" AS s
                               JOIN "customers" AS c ON s."cust_id" = c."cust_id"
                               JOIN "times" AS t ON s."time_id" = t."time_id"
                               WHERE t."calendar_quarter_number" = 4
                                 AND t."calendar_year" IN (2019,2020)
                                 AND s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                               GROUP BY c."cust_city"
                               HAVING s20 >= 1.2*s19))
GROUP  BY tp."prod_id"
ORDER  BY share_2019 DESC
LIMIT 20;
```

```sql
--Description: 10)  Repeat share computation for Q4-2020, then combine with the 2019 shares
--               to calculate share change, listing products by descending change.
WITH top_prod AS ( /* same top-20 % product set as query 9 */ 
     SELECT r."prod_id"
     FROM   (
          SELECT s."prod_id",
                 SUM(s."amount_sold") AS tot,
                 ROW_NUMBER() OVER (ORDER BY SUM(s."amount_sold") DESC) AS rn,
                 COUNT(*) OVER () AS cnt
          FROM   "sales" AS s
          JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
          JOIN   "times" AS t ON s."time_id" = t."time_id"
          WHERE  t."calendar_quarter_number" = 4
            AND  t."calendar_year" IN (2019,2020)
            AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
            AND  c."cust_city" IN (
                    SELECT "cust_city"
                    FROM (
                          SELECT c."cust_city",
                                 SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                                 SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                          FROM   "sales" AS s
                          JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
                          JOIN   "times"     AS t ON s."time_id" = t."time_id"
                          WHERE  t."calendar_quarter_number" = 4
                            AND  t."calendar_year" IN (2019,2020)
                            AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                          GROUP  BY c."cust_city"
                          HAVING s20 >= 1.2*s19 )
                  )
          GROUP  BY s."prod_id"
        ) r
     WHERE r.rn <= 0.2*r.cnt
),
shares AS (
     SELECT tp."prod_id",
            SUM(CASE WHEN t."calendar_year" = 2019 THEN s."amount_sold" END) AS sales_2019,
            SUM(CASE WHEN t."calendar_year" = 2020 THEN s."amount_sold" END) AS sales_2020,
            SUM(s."amount_sold")                                            AS both_sales
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times" AS t ON s."time_id" = t."time_id"
     JOIN   top_prod  AS tp ON s."prod_id" = tp."prod_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
       AND  c."cust_city" IN (
              SELECT "cust_city"
              FROM (
                    SELECT c."cust_city",
                           SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                           SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                    FROM   "sales" AS s
                    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
                    JOIN   "times"     AS t ON s."time_id" = t."time_id"
                    WHERE  t."calendar_quarter_number" = 4
                      AND  t."calendar_year" IN (2019,2020)
                      AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                    GROUP  BY c."cust_city"
                    HAVING s20 >= 1.2*s19 )
           )
     GROUP BY tp."prod_id"
),
totals AS (   -- denominators for each year
     SELECT
         SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS tot19,
         SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS tot20
     FROM   "sales" AS s
     JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
     JOIN   "times"     AS t ON s."time_id" = t."time_id"
     WHERE  t."calendar_quarter_number" = 4
       AND  t."calendar_year" IN (2019,2020)
       AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
       AND  c."cust_city" IN (
          SELECT "cust_city"
          FROM (
                SELECT c."cust_city",
                       SUM(CASE WHEN t."calendar_year"=2019 THEN s."amount_sold" END) AS s19,
                       SUM(CASE WHEN t."calendar_year"=2020 THEN s."amount_sold" END) AS s20
                FROM   "sales" AS s
                JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
                JOIN   "times"     AS t ON s."time_id" = t."time_id"
                WHERE  t."calendar_quarter_number" = 4
                  AND  t."calendar_year" IN (2019,2020)
                  AND  s."promo_id" NOT IN (SELECT "promo_id" FROM "promotions")
                GROUP  BY c."cust_city"
                HAVING s20 >= 1.2*s19 )
       )
)
SELECT sh."prod_id",
       ROUND(1.0*sh."sales_2019" / (SELECT tot19 FROM totals),4) AS share_2019,
       ROUND(1.0*sh."sales_2020" / (SELECT tot20 FROM totals),4) AS share_2020,
       ROUND(1.0*sh."sales_2020" / (SELECT tot20 FROM totals) 
            - 1.0*sh."sales_2019" / (SELECT tot19 FROM totals),4) AS share_change
FROM   shares AS sh
ORDER  BY share_change DESC
LIMIT 20;
```

