```sql
--Description: Pull a small joined sample of sales with customer city and sale date (limited to Q4-2019/Q4-2020) to be sure the joins work and amounts are present.
SELECT s.cust_id,
       c.cust_city,
       t.time_id,
       t.calendar_quarter_desc,
       s.amount_sold,
       s.promo_id
FROM sales AS s
JOIN customers AS c     ON s.cust_id = c.cust_id
JOIN times     AS t     ON s.time_id  = t.time_id
WHERE t.calendar_year IN (2019, 2020)
  AND t.calendar_quarter_number = 4
LIMIT 20;
```

```sql
--Description: Aggregate total sales per city in Q4-2019 (excluding the promo IDs we think are “no promotion”, here tentatively 0 and 999) to gauge volumes.
SELECT c.cust_city,
       SUM(s.amount_sold) AS q4_2019_sales
FROM sales      AS s
JOIN customers  AS c ON s.cust_id = c.cust_id
JOIN times      AS t ON s.time_id = t.time_id
WHERE t.calendar_year = 2019
  AND t.calendar_quarter_number = 4
  AND s.promo_id IN (0, 999)          -- adjust after confirming “no promotion” ID
GROUP BY c.cust_city
ORDER BY q4_2019_sales DESC
LIMIT 20;
```

```sql
--Description: Same aggregation for Q4-2020 (still filtering for “no promotion”) to later compare the 20 % growth.
SELECT c.cust_city,
       SUM(s.amount_sold) AS q4_2020_sales
FROM sales      AS s
JOIN customers  AS c ON s.cust_id = c.cust_id
JOIN times      AS t ON s.time_id = t.time_id
WHERE t.calendar_year = 2020
  AND t.calendar_quarter_number = 4
  AND s.promo_id IN (0, 999)          -- adjust after confirming “no promotion” ID
GROUP BY c.cust_city
ORDER BY q4_2020_sales DESC
LIMIT 20;
```

```sql
--Description: For one qualifying city (replace 'SampleCity') show its product-level sales in both quarters to help rank top products later.
SELECT p.prod_id,
       pr.prod_name,
       SUM(CASE WHEN t.calendar_year = 2019 THEN s.amount_sold END) AS sales_2019,
       SUM(CASE WHEN t.calendar_year = 2020 THEN s.amount_sold END) AS sales_2020
FROM sales       AS s
JOIN customers   AS p ON s.cust_id = p.cust_id
JOIN times       AS t ON s.time_id = t.time_id
JOIN products    AS pr ON s.prod_id = pr.prod_id
WHERE p.cust_city = 'SampleCity'                 -- replace with actual city after step-8/9
  AND t.calendar_year IN (2019, 2020)
  AND t.calendar_quarter_number = 4
  AND s.promo_id IN (0, 999)                     -- adjust after confirming “no promotion” ID
GROUP BY pr.prod_id
ORDER BY COALESCE(sales_2020,0) + COALESCE(sales_2019,0) DESC
LIMIT 20;
```
