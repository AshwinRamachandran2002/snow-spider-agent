```sql
--Description: 
--Objective: demonstrate the correct joins and conditional aggregation needed for the
--later “top-20 % product set” step, but limited to a single city so the result stays small.  
--Thinking process (embedded):  
-- 1. “No-promotion” sales are identified by promo_id = 999 (confirmed earlier).  
-- 2. Q4 corresponds to calendar_quarter_number = 4 in the times table; restrict to 2019 & 2020.  
-- 3. Join path: sales → customers (to filter on city) → times (to get quarter/year) → products (for names).  
-- 4. Use conditional SUM(CASE WHEN … THEN amount_sold END) to split totals by year.  
-- 5. Order by combined two-year volume so we can later pick the top 20 % of products.  
--Note: replace 'Dolores' with whichever city ultimately meets the ≥20 % growth rule.
SELECT
    s.prod_id,
    pr.prod_name,
    SUM(CASE WHEN t.calendar_year = 2019 THEN s.amount_sold END) AS q4_2019_sales,
    SUM(CASE WHEN t.calendar_year = 2020 THEN s.amount_sold END) AS q4_2020_sales
FROM sales      AS s
JOIN customers  AS c  ON s.cust_id = c.cust_id
JOIN times      AS t  ON s.time_id = t.time_id
JOIN products   AS pr ON s.prod_id = pr.prod_id
WHERE c.cust_city              = 'Dolores'      -- target city (placeholder)
  AND t.calendar_quarter_number = 4             -- Q4 only
  AND t.calendar_year IN (2019, 2020)           -- years of interest
  AND s.promo_id               = 999            -- “NO PROMOTION”
GROUP BY s.prod_id
ORDER BY (IFNULL(q4_2019_sales, 0) + IFNULL(q4_2020_sales, 0)) DESC
LIMIT 20;
```
