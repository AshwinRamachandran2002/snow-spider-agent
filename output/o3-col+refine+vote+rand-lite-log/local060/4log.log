```sql
--Description:
-- We need to:                                                       
-- 1) Pick U.S. cities whose “no-promotion” revenue rose ≥20 % from   
--    Q4 2019 to Q4 2020.                                            
-- 2) Inside those cities, total each product’s no-promo sales for    
--    the same two quarters and keep only the TOP-20 % products by    
--    that combined amount.                                          
-- 3) For every kept product, compute its share of the cities’ total  
--    sales in Q4 2019 and Q4 2020, then calculate the change in      
--    share.  Show results ordered by that change.                    
WITH
country_us AS (                  -- United States id
    SELECT country_id
    FROM   countries
    WHERE  country_name = 'United States of America'
),

q19 AS (                         -- Q4-2019 city totals (no promo)
    SELECT c.cust_city,
           SUM(s.amount_sold) AS amt19
    FROM   sales     s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  c.country_id = (SELECT country_id FROM country_us)
      AND  t.calendar_quarter_desc = '2019-04'
      AND  s.promo_id = 999
    GROUP  BY c.cust_city
),

q20 AS (                         -- Q4-2020 city totals (no promo)
    SELECT c.cust_city,
           SUM(s.amount_sold) AS amt20
    FROM   sales     s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  c.country_id = (SELECT country_id FROM country_us)
      AND  t.calendar_quarter_desc = '2020-04'
      AND  s.promo_id = 999
    GROUP  BY c.cust_city
),

fast_cities AS (                 -- ≥20 % growth cities
    SELECT q19.cust_city
    FROM   q19
    JOIN   q20 USING (cust_city)
    WHERE  (q20.amt20 - q19.amt19) * 1.0 / q19.amt19 >= 0.20
),

prod_tot AS (                    -- combined sales (Q4 19 & Q4 20)
    SELECT s.prod_id,
           SUM(s.amount_sold) AS tot_amt
    FROM   sales     s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  c.cust_city IN (SELECT cust_city FROM fast_cities)
      AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
      AND  s.promo_id = 999
    GROUP  BY s.prod_id
),

top_prod AS (                    -- keep top 20 % of products
    SELECT prod_id
    FROM (
        SELECT prod_id,
               tot_amt,
               ROW_NUMBER() OVER (ORDER BY tot_amt DESC) AS rn,
               COUNT(*)    OVER ()                       AS cnt
        FROM   prod_tot
    )
    WHERE rn <= cnt * 0.20
),

prod_year AS (                   -- yearly sales of kept products
    SELECT s.prod_id,
           t.calendar_year AS yr,
           SUM(s.amount_sold) AS prod_amt
    FROM   sales     s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  s.prod_id IN (SELECT prod_id FROM top_prod)
      AND  c.cust_city IN (SELECT cust_city FROM fast_cities)
      AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
      AND  s.promo_id = 999
    GROUP  BY s.prod_id, t.calendar_year
),

year_tot AS (                    -- city totals per year (all products)
    SELECT t.calendar_year AS yr,
           SUM(s.amount_sold) AS tot_amt
    FROM   sales     s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  c.cust_city IN (SELECT cust_city FROM fast_cities)
      AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
      AND  s.promo_id = 999
    GROUP  BY t.calendar_year
),

share AS (                       -- share per product per year
    SELECT p.prod_id,
           COALESCE(SUM(CASE WHEN yr = 2019 THEN prod_amt END),0) AS amt19,
           COALESCE(SUM(CASE WHEN yr = 2020 THEN prod_amt END),0) AS amt20
    FROM   prod_year p
    GROUP  BY p.prod_id
)

SELECT
    s.prod_id,
    ROUND(100.0 * amt19 / (SELECT tot_amt FROM year_tot WHERE yr = 2019), 2) AS share_2019_pct,
    ROUND(100.0 * amt20 / (SELECT tot_amt FROM year_tot WHERE yr = 2020), 2) AS share_2020_pct,
    ROUND(100.0 * (amt20 / (SELECT tot_amt FROM year_tot WHERE yr = 2020)
         -          amt19 / (SELECT tot_amt FROM year_tot WHERE yr = 2019)), 2) AS share_change_pct
FROM   share s
ORDER  BY share_change_pct DESC;
