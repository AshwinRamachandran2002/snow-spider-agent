```sql
--Description: 1)  Get the “United States” key so we can isolate U-S customers.  
SELECT DISTINCT country_id, country_name 
FROM countries 
WHERE country_name LIKE '%United%' 
LIMIT 20;
```

```sql
--Description: 2)  List some U-S cities that occur in the customer table.  
SELECT DISTINCT cust_city, cust_state_province, cust_city_id  
FROM customers 
WHERE country_id IN (SELECT country_id 
                     FROM countries 
                     WHERE country_name LIKE '%United%') 
LIMIT 20;
```

```sql
--Description: 3)  Check how the calendar quarter is written for 2019-Q4 & 2020-Q4.  
SELECT DISTINCT calendar_quarter_desc  
FROM times 
WHERE calendar_year IN (2019,2020) 
ORDER BY calendar_quarter_desc 
LIMIT 20;
```

```sql
--Description: 4)  Total “no-promotion” sales per U-S city in 2019-Q4.  
SELECT c.cust_city,
       SUM(s.amount_sold) AS total_2019_q4
FROM   sales      AS s
JOIN   customers  AS c   ON s.cust_id = c.cust_id
JOIN   countries  AS co  ON c.country_id = co.country_id
JOIN   times      AS t   ON s.time_id  = t.time_id
WHERE  co.country_name LIKE '%United%'
  AND  t.calendar_quarter_desc = '2019-04'   -- Q4-2019
  AND  s.promo_id = 999                      -- “no promo”
GROUP  BY c.cust_city
ORDER  BY total_2019_q4 DESC
LIMIT 20;
```

```sql
--Description: 5)  Total “no-promotion” sales per U-S city in 2020-Q4.  
SELECT c.cust_city,
       SUM(s.amount_sold) AS total_2020_q4
FROM   sales      AS s
JOIN   customers  AS c   ON s.cust_id = c.cust_id
JOIN   countries  AS co  ON c.country_id = co.country_id
JOIN   times      AS t   ON s.time_id  = t.time_id
WHERE  co.country_name LIKE '%United%'
  AND  t.calendar_quarter_desc = '2020-04'   -- Q4-2020
  AND  s.promo_id = 999                      -- “no promo”
GROUP  BY c.cust_city
ORDER  BY total_2020_q4 DESC
LIMIT 20;
```

```sql
--Description: 6)  Cities whose sales grew ≥20 % from 2019-Q4 to 2020-Q4.  
WITH q19 AS (SELECT c.cust_city, SUM(s.amount_sold) AS amt19
             FROM sales s
             JOIN customers c ON s.cust_id = c.cust_id
             JOIN countries co ON c.country_id = co.country_id
             JOIN times t ON s.time_id = t.time_id
             WHERE co.country_name LIKE '%United%'
               AND t.calendar_quarter_desc = '2019-04'
               AND s.promo_id = 999
             GROUP BY c.cust_city),
     q20 AS (SELECT c.cust_city, SUM(s.amount_sold) AS amt20
             FROM sales s
             JOIN customers c ON s.cust_id = c.cust_id
             JOIN countries co ON c.country_id = co.country_id
             JOIN times t ON s.time_id = t.time_id
             WHERE co.country_name LIKE '%United%'
               AND t.calendar_quarter_desc = '2020-04'
               AND s.promo_id = 999
             GROUP BY c.cust_city)
SELECT q19.cust_city,
       q19.amt19,
       q20.amt20,
       ROUND(100.0*(q20.amt20-q19.amt19)/q19.amt19,2) AS pct_increase
FROM   q19
JOIN   q20 USING (cust_city)
WHERE  (q20.amt20-q19.amt19)*1.0/q19.amt19 >= 0.20
ORDER  BY pct_increase DESC
LIMIT 20;
```

```sql
--Description: 7)  Product totals (no-promo, both quarters) inside the fast-growing cities.  
WITH fast_cities AS (  -- query 6 without the LIMIT
      SELECT q19.cust_city
      FROM   (SELECT c.cust_city, SUM(s.amount_sold) AS amt19
              FROM sales s
              JOIN customers c ON s.cust_id = c.cust_id
              JOIN countries co ON c.country_id = co.country_id
              JOIN times t ON s.time_id = t.time_id
              WHERE co.country_name LIKE '%United%'
                AND t.calendar_quarter_desc = '2019-04'
                AND s.promo_id = 999
              GROUP BY c.cust_city) q19
      JOIN   (SELECT c.cust_city, SUM(s.amount_sold) AS amt20
              FROM sales s
              JOIN customers c ON s.cust_id = c.cust_id
              JOIN countries co ON c.country_id = co.country_id
              JOIN times t ON s.time_id = t.time_id
              WHERE co.country_name LIKE '%United%'
                AND t.calendar_quarter_desc = '2020-04'
                AND s.promo_id = 999
              GROUP BY c.cust_city) q20
      USING (cust_city)
      WHERE  (q20.amt20-q19.amt19)*1.0/q19.amt19 >= 0.20 ),
prod_tot AS (
      SELECT s.prod_id,
             SUM(s.amount_sold) AS tot_amt
      FROM   sales     s
      JOIN   customers c  ON s.cust_id = c.cust_id
      JOIN   times     t  ON s.time_id = t.time_id
      WHERE  c.cust_city IN (SELECT cust_city FROM fast_cities)
        AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
        AND  s.promo_id = 999
      GROUP  BY s.prod_id)
SELECT prod_id, tot_amt
FROM   prod_tot
ORDER  BY tot_amt DESC
LIMIT 20;
```

```sql
--Description: 8)  Keep only the top 20 % of those products (by combined sales).  
WITH prod_tot AS ( /* same CTE as query 7 */ 
      SELECT s.prod_id,
             SUM(s.amount_sold) AS tot_amt
      FROM   sales     s
      JOIN   customers c  ON s.cust_id = c.cust_id
      JOIN   times     t  ON s.time_id = t.time_id
      WHERE  c.cust_city IN ( /* fast cities */ 
             SELECT cust_city FROM (
                    /* body identical to fast_cities CTE above */ ) )
        AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
        AND  s.promo_id = 999
      GROUP  BY s.prod_id)
SELECT prod_id, tot_amt
FROM   (SELECT prod_id,
               tot_amt,
               ROW_NUMBER() OVER(ORDER BY tot_amt DESC)         AS rn,
               COUNT(*)  OVER()                                 AS cnt
        FROM   prod_tot)
WHERE  rn <= cnt*0.20             -- top 20 %
ORDER  BY tot_amt DESC
LIMIT 20;
```

```sql
--Description: 9)  Each top product’s share of city-total sales in the two quarters.  
WITH fast_cities AS ( /* same as in query 7 */ ),
top_prod AS ( /* same as query 8 without LIMIT */ ),
quarter_prod AS (
      SELECT s.prod_id,
             t.calendar_year                            AS yr,
             SUM(s.amount_sold)                         AS prod_amt
      FROM   sales     s
      JOIN   customers c ON s.cust_id = c.cust_id
      JOIN   times     t ON s.time_id = t.time_id
      WHERE  c.cust_city IN (SELECT cust_city FROM fast_cities)
        AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
        AND  s.promo_id = 999
        AND  s.prod_id IN (SELECT prod_id FROM top_prod)
      GROUP  BY s.prod_id, t.calendar_year),
quarter_tot AS (
      SELECT t.calendar_year AS yr,
             SUM(s.amount_sold) AS tot_amt
      FROM   sales     s
      JOIN   customers c ON s.cust_id = c.cust_id
      JOIN   times     t ON s.time_id = t.time_id
      WHERE  c.cust_city IN (SELECT cust_city FROM fast_cities)
        AND  t.calendar_quarter_desc IN ('2019-04','2020-04')
        AND  s.promo_id = 999
      GROUP  BY t.calendar_year)
SELECT qp.prod_id,
       ROUND(100.0*SUM(CASE WHEN yr=2019 THEN prod_amt END)
                   / (SELECT tot_amt FROM quarter_tot WHERE yr=2019),2) AS share_2019,
       ROUND(100.0*SUM(CASE WHEN yr=2020 THEN prod_amt END)
                   / (SELECT tot_amt FROM quarter_tot WHERE yr=2020),2) AS share_2020
FROM   quarter_prod qp
GROUP  BY qp.prod_id
LIMIT 20;
```

```sql
--Description: 10)  Change in share from 2019-Q4 to 2020-Q4, ordered largest-to-smallest.  
WITH fast_cities  AS ( /* as earlier */ ),
top_prod      AS ( /* as earlier */ ),
quarter_prod  AS ( /* as earlier */ ),
quarter_tot   AS ( /* as earlier */ ),
prod_share AS (
      SELECT qp.prod_id,
             SUM(CASE WHEN yr=2019 THEN prod_amt END) *1.0 
                 / (SELECT tot_amt FROM quarter_tot WHERE yr=2019) AS sh19,
             SUM(CASE WHEN yr=2020 THEN prod_amt END) *1.0
                 / (SELECT tot_amt FROM quarter_tot WHERE yr=2020) AS sh20
      FROM   quarter_prod qp
      GROUP  BY qp.prod_id)
SELECT prod_id,
       ROUND(100.0*sh19,2) AS share_2019_pct,
       ROUND(100.0*sh20,2) AS share_2020_pct,
       ROUND(100.0*(sh20-sh19),2) AS share_change_pct
FROM   prod_share
ORDER  BY share_change_pct DESC
LIMIT 20;
```
