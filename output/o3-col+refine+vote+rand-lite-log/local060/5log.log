```sql
-- 1. Inspect the list of countries to confirm the exact spelling of “United States”
SELECT DISTINCT "country_name"
FROM "countries"
LIMIT 20;
```

```sql
-- 2. Retrieve the country_id for anything that looks like the United States
SELECT "country_id",
       "country_name"
FROM   "countries"
WHERE  "country_name" LIKE '%United%'
LIMIT 20;
```

```sql
-- 3. See a handful of U.S. cities that appear in the customers table
SELECT DISTINCT c."cust_city",
       c."cust_state_province"
FROM   "customers"  AS c
JOIN   "countries"  AS co
       ON c."country_id" = co."country_id"
WHERE  co."country_name" = 'United States'
LIMIT 20;
```

```sql
-- 4. Verify that promo_id = 999 represents “No Promotion”
SELECT *
FROM   "promotions"
WHERE  "promo_id" = 999
LIMIT 20;
```

```sql
-- 5. Check the range of promotion IDs that are actually referenced in sales
SELECT DISTINCT "promo_id"
FROM   "sales"
LIMIT 20;
```

```sql
-- 6. Take a quick look at some 2019-Q4 dates in the time dimension
SELECT DISTINCT "time_id",
       "calendar_month_number",
       "calendar_quarter_number",
       "calendar_year"
FROM   "times"
WHERE  "calendar_year" = 2019
  AND  "calendar_quarter_number" = 4
LIMIT 20;
```

```sql
-- 7. Do the same for 2020-Q4 to confirm date coverage
SELECT DISTINCT "time_id",
       "calendar_month_number",
       "calendar_quarter_number",
       "calendar_year"
FROM   "times"
WHERE  "calendar_year" = 2020
  AND  "calendar_quarter_number" = 4
LIMIT 20;
```

```sql
-- 8. Sample of “no-promotion” sales rows in U.S. cities during 2019-Q4
SELECT s."amount_sold",
       cu."cust_city",
       cu."cust_state_province",
       t."time_id"
FROM   "sales"      AS s
JOIN   "customers"  AS cu  ON s."cust_id" = cu."cust_id"
JOIN   "countries"  AS co  ON cu."country_id" = co."country_id"
JOIN   "times"      AS t   ON s."time_id" = t."time_id"
WHERE  co."country_name"        = 'United States'
  AND  s."promo_id"             = 999          -- no promotion
  AND  t."calendar_year"        = 2019
  AND  t."calendar_quarter_number" = 4
LIMIT 20;
```

```sql
-- 9. Aggregate total “no-promotion” sales per U.S. city for 2019-Q4
SELECT cu."cust_city",
       SUM(s."amount_sold") AS "total_sales_q4_2019"
FROM   "sales"      AS s
JOIN   "customers"  AS cu  ON s."cust_id" = cu."cust_id"
JOIN   "countries"  AS co  ON cu."country_id" = co."country_id"
JOIN   "times"      AS t   ON s."time_id" = t."time_id"
WHERE  co."country_name"        = 'United States'
  AND  s."promo_id"             = 999
  AND  t."calendar_year"        = 2019
  AND  t."calendar_quarter_number" = 4
GROUP BY cu."cust_city"
ORDER BY "total_sales_q4_2019" DESC
LIMIT 20;
```

```sql
-- 10. Aggregate total “no-promotion” sales per U.S. city for 2020-Q4
SELECT cu."cust_city",
       SUM(s."amount_sold") AS "total_sales_q4_2020"
FROM   "sales"      AS s
JOIN   "customers"  AS cu  ON s."cust_id" = cu."cust_id"
JOIN   "countries"  AS co  ON cu."country_id" = co."country_id"
JOIN   "times"      AS t   ON s."time_id" = t."time_id"
WHERE  co."country_name"        = 'United States'
  AND  s."promo_id"             = 999
  AND  t."calendar_year"        = 2020
  AND  t."calendar_quarter_number" = 4
GROUP BY cu."cust_city"
ORDER BY "total_sales_q4_2020" DESC
LIMIT 20;
```
