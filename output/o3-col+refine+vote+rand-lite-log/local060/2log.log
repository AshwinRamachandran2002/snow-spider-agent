Query:
--Description: Aggregate “no-promotion” sales by city for Q4-2019 in the United States; these figures will be compared with Q4-2020 to find cities with ≥20 % growth.
SELECT   c.cust_city,
         SUM(s.amount_sold) AS total_sales_2019_Q4
FROM     sales      AS s
JOIN     times      AS t  ON t.time_id      = s.time_id
JOIN     customers  AS c  ON c.cust_id      = s.cust_id
JOIN     countries  AS co ON co.country_id  = c.country_id
WHERE    co.country_name LIKE '%United%'
  AND    t.calendar_year           = 2019
  AND    t.calendar_quarter_number = 4
  AND    s.promo_id                = 999      -- “no promotion”
GROUP BY c.cust_city
ORDER BY total_sales_2019_Q4 DESC
LIMIT 20
