-- 1) Find the country_id that represents the United States (or any variant that contains the
--    word “United”) so we can restrict customers to the U-S later on.
SELECT DISTINCT country_id, country_iso_code, country_name
FROM countries
WHERE country_name LIKE '%United%'
LIMIT 20;
```

```sql
-- 2) Take a quick look at customers that belong to that country_id
--    (replace  <<US_ID>> with the id discovered in query-1).
SELECT DISTINCT cust_id,
       cust_city,
       cust_state_province,
       country_id
FROM customers
WHERE country_id = <<US_ID>>
LIMIT 20;
```

```sql
-- 3) Inspect the different promo_id values that appear in the sales table.
--    We want to confirm what value represents “no promotion”.
