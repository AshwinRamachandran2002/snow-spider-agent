FROM sales
ORDER BY promo_id
LIMIT 20;
```

```sql
-- 4) Check whether promo_id = 999 really has a row in the promotions table.
SELECT *
FROM promotions
WHERE promo_id = 999
LIMIT 20;
```

```sql
-- 5) If 999 is missing in `promotions`, peek at one example sales row that carries
--    that promo_id so that we are sure it is used for “no promotion”.
SELECT *
FROM sales
WHERE promo_id = 999
LIMIT 20;
```

```sql
-- 6) Examine a few dates that belong to Q4-2019 to verify the
--    quarter fields in the times table.
SELECT DISTINCT time_id,
       calendar_year,
       calendar_quarter_number,
       calendar_month_name
FROM times
WHERE calendar_year = 2019
  AND calendar_quarter_number = 4
LIMIT 20;
```

```sql
-- 7) Do the same check for Q4-2020.
SELECT DISTINCT time_id,
       calendar_year,
       calendar_quarter_number,
       calendar_month_name
FROM times
WHERE calendar_year = 2020
  AND calendar_quarter_number = 4
LIMIT 20;
```

```sql
-- 8) Aggregate “no-promotion” sales by city for Q4-2019 in the U-S
--    so that later we can compare with Q4-2020 and find the ≥20 % growers.
SELECT c.cust_city,
       SUM(s.amount_sold) AS total_sales_2019_Q4
FROM   sales      AS s
JOIN   times      AS t ON t.time_id  = s.time_id
JOIN   customers  AS c ON c.cust_id  = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name LIKE '%United%'
  AND  t.calendar_year = 2019
  AND  t.calendar_quarter_number = 4
  AND  s.promo_id = 999          -- “no promotion”
GROUP  BY c.cust_city
ORDER  BY total_sales_2019_Q4 DESC
LIMIT 20;
```

```sql
-- 9) Same aggregation for Q4-2020.
SELECT c.cust_city,
       SUM(s.amount_sold) AS total_sales_2020_Q4
FROM   sales      AS s
JOIN   times      AS t ON t.time_id  = s.time_id
JOIN   customers  AS c ON c.cust_id  = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name LIKE '%United%'
  AND  t.calendar_year = 2020
  AND  t.calendar_quarter_number = 4
  AND  s.promo_id = 999          -- “no promotion”
GROUP  BY c.cust_city
ORDER  BY total_sales_2020_Q4 DESC
LIMIT 20;
```

```sql
-- 10) For the U-S cities that we will later find to exceed the 20 % growth,
--      get an overall ranking of product sales (still “no promotion”)
--      across both quarters (2019-Q4 and 2020-Q4).  This will help
--      identify the “top 20 %” products afterwards.
--      (Use the same city list once the ≥20 % filter is known.)
SELECT s.prod_id,
       SUM(s.amount_sold) AS total_sales_both_Q4s
FROM   sales      AS s
JOIN   times      AS t ON t.time_id  = s.time_id
JOIN   customers  AS c ON c.cust_id  = s.cust_id
JOIN   countries  AS co ON co.country_id = c.country_id
WHERE  co.country_name LIKE '%United%'
  AND  t.calendar_year IN (2019, 2020)
  AND  t.calendar_quarter_number = 4
  AND  s.promo_id = 999          -- “no promotion”
GROUP  BY s.prod_id
ORDER  BY total_sales_both_Q4s DESC
LIMIT 20;
```

Each query gathers a small, focused slice of data that will be needed to construct the full solution for the task.
