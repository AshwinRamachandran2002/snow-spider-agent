```sql
-- 5) Total “no-promo” sales (assuming promo_id = 999) by city in 2019-Q4
SELECT c."cust_city",
       SUM(s."amount_sold") AS "amount_2019Q4"
FROM   "sales"     AS s
JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
JOIN   "times"     AS t ON s."time_id" = t."time_id"
WHERE  s."promo_id" = 999
  AND  t."calendar_year"       = 2019
  AND  t."calendar_quarter_number" = 4
GROUP  BY c."cust_city"
ORDER  BY "amount_2019Q4" DESC
LIMIT 20;
```

```sql
-- 6) Total “no-promo” sales by city in 2020-Q4
SELECT c."cust_city",
       SUM(s."amount_sold") AS "amount_2020Q4"
FROM   "sales"     AS s
JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
JOIN   "times"     AS t ON s."time_id" = t."time_id"
WHERE  s."promo_id" = 999
  AND  t."calendar_year"       = 2020
  AND  t."calendar_quarter_number" = 4
GROUP  BY c."cust_city"
ORDER  BY "amount_2020Q4" DESC
LIMIT 20;
```

```sql
-- 7) Identify cities whose “no-promo” sales grew ≥20 % from 2019-Q4 to 2020-Q4
WITH q19 AS (
    SELECT c."cust_city", SUM(s."amount_sold") AS amt19
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999 AND t."calendar_year" = 2019
      AND  t."calendar_quarter_number" = 4
    GROUP  BY c."cust_city"
),
q20 AS (
    SELECT c."cust_city", SUM(s."amount_sold") AS amt20
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999 AND t."calendar_year" = 2020
      AND  t."calendar_quarter_number" = 4
    GROUP  BY c."cust_city"
)
SELECT q20."cust_city",
       amt19, amt20,
       ROUND( (amt20 - amt19) * 100.0 / amt19, 1) AS "pct_growth"
FROM   q19
JOIN   q20 USING ("cust_city")
WHERE  amt20 >= 1.2 * amt19
ORDER  BY "pct_growth" DESC
LIMIT 20;
```

```sql
-- 8) For the qualifying cities, rank products by combined 2019+2020 Q4 sales (no promos)
WITH good_cities AS (
    -- re-use previous CTE to keep the growing-city list
    SELECT q20."cust_city"
    FROM (
        SELECT c."cust_city", SUM(s."amount_sold") AS amt19
        FROM "sales" AS s
        JOIN "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN "times" AS t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999 AND t."calendar_year" = 2019
          AND t."calendar_quarter_number" = 4
        GROUP BY c."cust_city"
    ) AS q19
    JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS amt20
        FROM "sales" AS s
        JOIN "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN "times" AS t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999 AND t."calendar_year" = 2020
          AND t."calendar_quarter_number" = 4
        GROUP BY c."cust_city"
    ) AS q20 USING ("cust_city")
    WHERE q20.amt20 >= 1.2 * q19.amt19
),
prod_tot AS (
    SELECT s."prod_id",
           SUM(s."amount_sold") AS tot_sales
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
    GROUP  BY s."prod_id"
)
SELECT p."prod_id", p."prod_name", pt."tot_sales"
FROM   prod_tot AS pt
JOIN   "products" AS p USING ("prod_id")
ORDER  BY pt."tot_sales" DESC
LIMIT 20;
```

```sql
-- 9) Compute each top product’s share of total sales in Q4-2019 & Q4-2020
--    (only the products that fell in the top 20 % above are kept)
WITH good_cities AS (          /* same as in query 8, abbreviated here */ 
    SELECT q20."cust_city"
    FROM (
        SELECT c."cust_city", SUM(s."amount_sold") AS amt19
        FROM "sales" AS s
        JOIN "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN "times" AS t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999 AND t."calendar_year" = 2019
          AND t."calendar_quarter_number" = 4
        GROUP BY c."cust_city"
    ) AS q19
    JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS amt20
        FROM "sales" AS s
        JOIN "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN "times" AS t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999 AND t."calendar_year" = 2020
          AND t."calendar_quarter_number" = 4
        GROUP BY c."cust_city"
    ) AS q20 USING ("cust_city")
    WHERE q20.amt20 >= 1.2 * q19.amt19
),
prod_rank AS (                /* rank products and keep top 20 % */
    SELECT pt.*,
           NTILE(5) OVER (ORDER BY pt.tot_sales DESC) AS quint
    FROM (
        SELECT s."prod_id",
               SUM(s."amount_sold") AS tot_sales
        FROM   "sales" AS s
        JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN   "times" AS t ON s."time_id" = t."time_id"
        WHERE  s."promo_id" = 999
          AND  t."calendar_year" IN (2019, 2020)
          AND  t."calendar_quarter_number" = 4
          AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
        GROUP  BY s."prod_id"
    ) AS pt
),
top_prod AS (
    SELECT "prod_id"
    FROM   prod_rank
    WHERE  quint = 1          -- top 20 %
),
yr_tot AS (                    /* total city-filtered sales per year */
    SELECT t."calendar_year"         AS yr,
           SUM(s."amount_sold")      AS tot_amt
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
    GROUP  BY t."calendar_year"
),
prod_yr AS (
    SELECT s."prod_id",
           t."calendar_year" AS yr,
           SUM(s."amount_sold") AS prod_amt
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times"     AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
      AND  s."prod_id" IN (SELECT "prod_id" FROM top_prod)
    GROUP  BY s."prod_id", t."calendar_year"
)
SELECT p."prod_id",
       p."prod_name",
       ROUND( 100.0 * SUM(CASE WHEN yr=2019 THEN prod_amt END) 
              / (SELECT tot_amt FROM yr_tot WHERE yr=2019), 2) AS "share_2019Q4",
       ROUND( 100.0 * SUM(CASE WHEN yr=2020 THEN prod_amt END) 
              / (SELECT tot_amt FROM yr_tot WHERE yr=2020), 2) AS "share_2020Q4",
       ROUND(   (SUM(CASE WHEN yr=2020 THEN prod_amt END) 
                / (SELECT tot_amt FROM yr_tot WHERE yr=2020) )
             - (SUM(CASE WHEN yr=2019 THEN prod_amt END) 
                / (SELECT tot_amt FROM yr_tot WHERE yr=2019) ), 4)      AS "share_change"
FROM   prod_yr
JOIN   "products" AS p USING ("prod_id")
GROUP  BY p."prod_id", p."prod_name"
ORDER  BY "share_change" DESC
LIMIT 20;
```

```sql
-- 10) (Final) Same as above but keeping only the columns requested and ordering by share change
SELECT p."prod_id",
       p."prod_name",
       ROUND( 100.0 * SUM(CASE WHEN yr=2019 THEN prod_amt END) 
              / (SELECT tot_amt FROM yr_tot WHERE yr=2019), 2) AS "share_2019Q4",
       ROUND( 100.0 * SUM(CASE WHEN yr=2020 THEN prod_amt END) 
              / (SELECT tot_amt FROM yr_tot WHERE yr=2020), 2) AS "share_2020Q4",
       ROUND(   (SUM(CASE WHEN yr=2020 THEN prod_amt END) 
                / (SELECT tot_amt FROM yr_tot WHERE yr=2020) )
             - (SUM(CASE WHEN yr=2019 THEN prod_amt END) 
                / (SELECT tot_amt FROM yr_tot WHERE yr=2019) ), 4) AS "share_change"
FROM   prod_yr
JOIN   "products" AS p USING ("prod_id")
GROUP  BY p."prod_id", p."prod_name"
ORDER  BY "share_change" DESC
LIMIT 20;
```
