Query:
-- 7) Identify cities whose “no-promo” sales grew ≥20 % from 2019-Q4 to 2020-Q4
WITH q19 AS (
    SELECT c."cust_city", SUM(s."amount_sold") AS amt19
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999 AND t."calendar_year" = 2019
      AND  t."calendar_quarter_number" = 4
    GROUP  BY c."cust_city"
),
q20 AS (
    SELECT c."cust_city", SUM(s."amount_sold") AS amt20
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999 AND t."calendar_year" = 2020
      AND  t."calendar_quarter_number" = 4
    GROUP  BY c."cust_city"
)
SELECT q20."cust_city",
       amt19, amt20,
       ROUND( (amt20 - amt19) * 100.0 / amt19, 1) AS "pct_growth"
FROM   q19
JOIN   q20 USING ("cust_city")
WHERE  amt20 >= 1.2 * amt19
ORDER  BY "pct_growth" DESC
LIMIT 20;
