        JOIN "times" AS t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999 AND t."calendar_year" = 2019
          AND t."calendar_quarter_number" = 4
        GROUP BY c."cust_city"
    ) AS q19
    JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS amt20
        FROM "sales" AS s
        JOIN "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN "times" AS t ON s."time_id" = t."time_id"
        WHERE s."promo_id" = 999 AND t."calendar_year" = 2020
          AND t."calendar_quarter_number" = 4
        GROUP BY c."cust_city"
    ) AS q20 USING ("cust_city")
    WHERE q20.amt20 >= 1.2 * q19.amt19
),
prod_rank AS (                /* rank products and keep top 20 % */
    SELECT pt.*,
           NTILE(5) OVER (ORDER BY pt.tot_sales DESC) AS quint
    FROM (
        SELECT s."prod_id",
               SUM(s."amount_sold") AS tot_sales
        FROM   "sales" AS s
        JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
        JOIN   "times" AS t ON s."time_id" = t."time_id"
        WHERE  s."promo_id" = 999
          AND  t."calendar_year" IN (2019, 2020)
          AND  t."calendar_quarter_number" = 4
          AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
        GROUP  BY s."prod_id"
    ) AS pt
),
top_prod AS (
    SELECT "prod_id"
    FROM   prod_rank
    WHERE  quint = 1          -- top 20 %
),
yr_tot AS (                    /* total city-filtered sales per year */
    SELECT t."calendar_year"         AS yr,
           SUM(s."amount_sold")      AS tot_amt
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
    JOIN   "times" AS t ON s."time_id" = t."time_id"
    WHERE  s."promo_id" = 999
      AND  t."calendar_year" IN (2019, 2020)
      AND  t."calendar_quarter_number" = 4
      AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
    GROUP  BY t."calendar_year"
),
prod_yr AS (
    SELECT s."prod_id",
           t."calendar_year" AS yr,
           SUM(s."amount_sold") AS prod_amt
    FROM   "sales" AS s
    JOIN   "customers" AS c ON s."cust_id" = c."cust_id"
