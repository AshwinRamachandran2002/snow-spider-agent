--Description: one-shot solution built step-by-step inside CTEs
-- • us_cust       – pick U.S. customers via countries.country_iso_code = 'US'.
-- • city19,city20 – Q4-2019 and Q4-2020 “no-promo” (promo_id = 999) sales per city.
-- • good_cities   – cities whose 2020 amount ≥ 120 % of 2019 (i.e. ≥20 % growth).
-- • prod_totals   – total sales (both years) per product restricted to good cities.
-- • ranked/top_prod – keep the top 20 % of those products (by total sales).
-- • yr_tot        – overall sales totals for good cities per year (denominators).
-- • prod_year     – yearly sales for each retained product.
-- Final SELECT    – compute each product’s share in 2019-Q4 & 2020-Q4 and the change,
--                  ordered by descending share change.
WITH
us_cust AS (
    SELECT c.cust_id,
           c.cust_city
    FROM   customers  c
    JOIN   countries  co ON c.country_id = co.country_id
    WHERE  co.country_iso_code = 'US'
),
city19 AS (
    SELECT uc.cust_city,
           SUM(s.amount_sold) AS amt19
    FROM   sales  s
    JOIN   us_cust uc ON s.cust_id = uc.cust_id
    JOIN   times  t  ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_year = 2019
      AND  t.calendar_quarter_number = 4
    GROUP  BY uc.cust_city
),
city20 AS (
    SELECT uc.cust_city,
           SUM(s.amount_sold) AS amt20
    FROM   sales  s
    JOIN   us_cust uc ON s.cust_id = uc.cust_id
    JOIN   times  t  ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_year = 2020
      AND  t.calendar_quarter_number = 4
    GROUP  BY uc.cust_city
),
good_cities AS (
    SELECT c20.cust_city
    FROM   city19 c19
    JOIN   city20 c20 USING (cust_city)
    WHERE  c20.amt20 >= 1.2 * c19.amt19          -- ≥20 % growth
),
prod_totals AS (
    SELECT s.prod_id,
           SUM(s.amount_sold) AS tot_sales
    FROM   sales  s
    JOIN   us_cust uc ON s.cust_id = uc.cust_id
    JOIN   times  t  ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_number = 4
      AND  t.calendar_year IN (2019, 2020)
      AND  uc.cust_city IN (SELECT cust_city FROM good_cities)
    GROUP  BY s.prod_id
),
ranked AS (
    SELECT prod_id,
           tot_sales,
           ROW_NUMBER() OVER (ORDER BY tot_sales DESC) AS rn,
           COUNT(*) OVER () AS cnt
    FROM   prod_totals
),
top_prod AS (
    SELECT prod_id
    FROM   ranked
    WHERE  rn <= cnt * 0.20                      -- top 20 %
),
yr_tot AS (
    SELECT t.calendar_year AS yr,
           SUM(s.amount_sold) AS tot_amt
    FROM   sales  s
    JOIN   us_cust uc ON s.cust_id = uc.cust_id
    JOIN   times  t  ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_number = 4
      AND  t.calendar_year IN (2019, 2020)
      AND  uc.cust_city IN (SELECT cust_city FROM good_cities)
    GROUP  BY t.calendar_year
),
prod_year AS (
    SELECT s.prod_id,
           t.calendar_year AS yr,
           SUM(s.amount_sold) AS prod_amt
    FROM   sales  s
    JOIN   us_cust uc ON s.cust_id = uc.cust_id
    JOIN   times  t  ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_number = 4
      AND  t.calendar_year IN (2019, 2020)
      AND  uc.cust_city IN (SELECT cust_city FROM good_cities)
      AND  s.prod_id IN (SELECT prod_id FROM top_prod)
    GROUP  BY s.prod_id, t.calendar_year
)
SELECT p.prod_id,
       p.prod_name,
       ROUND(100.0 * SUM(CASE WHEN yr = 2019 THEN prod_amt END)
             / (SELECT tot_amt FROM yr_tot WHERE yr = 2019), 2) AS share_2019Q4,
       ROUND(100.0 * SUM(CASE WHEN yr = 2020 THEN prod_amt END)
             / (SELECT tot_amt FROM yr_tot WHERE yr = 2020), 2) AS share_2020Q4,
       ROUND(
           (SUM(CASE WHEN yr = 2020 THEN prod_amt END) * 1.0 
              / (SELECT tot_amt FROM yr_tot WHERE yr = 2020))
         - (SUM(CASE WHEN yr = 2019 THEN prod_amt END) * 1.0 
              / (SELECT tot_amt FROM yr_tot WHERE yr = 2019)),
       4) AS share_change
FROM   prod_year
JOIN   products p USING (prod_id)
GROUP  BY p.prod_id, p.prod_name
ORDER  BY share_change DESC;
