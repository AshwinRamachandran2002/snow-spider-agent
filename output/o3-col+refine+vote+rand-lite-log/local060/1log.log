```sql
--Description: (6) Identify U.S. (country_id = 52790) cities whose “NO PROMOTION” (promo_id = 999) sales grew ≥ 20 % from Q4-2019 to Q4-2020.
WITH city_growth AS (
    SELECT c.cust_city,
           SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                    THEN s.amount_sold END) AS sales_2019,
           SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                    THEN s.amount_sold END) AS sales_2020
    FROM   sales      AS s
    JOIN   customers  AS c USING (cust_id)
    WHERE  c.country_id = 52790   -- United States
      AND  s.promo_id  = 999      -- NO PROMOTION
      AND  s.time_id  BETWEEN '2019-10-01' AND '2020-12-31'
    GROUP  BY c.cust_city
)
SELECT cust_city,
       sales_2019,
       sales_2020,
       ROUND((sales_2020 - sales_2019)*1.0/sales_2019,3) AS pct_growth
FROM   city_growth
WHERE  sales_2019 > 0
  AND  sales_2020 >= 1.2 * sales_2019
LIMIT 20;
```

```sql
--Description: (7) For the growth-qualified cities, total Q4-2019+Q4-2020 no-promotion sales by product.
WITH kept_cities AS (
    SELECT cust_city
    FROM (
        SELECT c.cust_city,
               SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31' THEN s.amount_sold END) AS s19,
               SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31' THEN s.amount_sold END) AS s20
        FROM   sales AS s
        JOIN   customers AS c USING (cust_id)
        WHERE  c.country_id = 52790
          AND  s.promo_id  = 999
          AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
        GROUP  BY c.cust_city
    )
    WHERE s20 >= 1.2 * s19
)
SELECT s.prod_id,
       SUM(s.amount_sold) AS total_q4_sales
FROM   sales      AS s
JOIN   customers  AS c USING (cust_id)
WHERE  c.cust_city IN (SELECT cust_city FROM kept_cities)
  AND  s.promo_id  = 999
  AND  s.time_id  BETWEEN '2019-10-01' AND '2020-12-31'
GROUP  BY s.prod_id
ORDER  BY total_q4_sales DESC
LIMIT 20;
```

```sql
--Description: (8) Rank products on total sales from query 7 and keep the top 20 % (window functions).
WITH kept_cities AS (
    SELECT cust_city
    FROM (
        SELECT c.cust_city,
               SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31' THEN s.amount_sold END) AS s19,
               SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31' THEN s.amount_sold END) AS s20
        FROM   sales AS s
        JOIN   customers AS c USING (cust_id)
        WHERE  c.country_id = 52790
          AND  s.promo_id  = 999
          AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
        GROUP  BY c.cust_city
        HAVING s20 >= 1.2 * s19
    )
),
prod_tot AS (
    SELECT s.prod_id,
           SUM(s.amount_sold) AS total_sales
    FROM   sales      AS s
    JOIN   customers  AS c USING (cust_id)
    WHERE  c.cust_city IN (SELECT cust_city FROM kept_cities)
      AND  s.promo_id  = 999
      AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
    GROUP  BY s.prod_id
),
prod_rank AS (
    SELECT prod_id,
           total_sales,
           ROW_NUMBER() OVER (ORDER BY total_sales DESC)        AS rn,
           COUNT(*)    OVER ()                                  AS n_all
    FROM   prod_tot
)
SELECT prod_id,
       total_sales,
       rn,
       n_all
FROM   prod_rank
WHERE  rn <= 0.2 * n_all      -- top 20 %
ORDER  BY rn
LIMIT 20;
