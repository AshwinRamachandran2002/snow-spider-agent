Below is a progressive set of exploratory-to-solution SQLs (≤ 10, each limited to 20 rows) with short annotations.

```sql
-- 1) Countries that look like the United States – we need its country_id
SELECT DISTINCT country_id, country_name
FROM countries
WHERE country_name LIKE '%United%'                 -- will match “United States …”
LIMIT 20;
```

```sql
-- 2) Look for a “No Promotion” row to learn its promo_id
SELECT promo_id, promo_name
FROM promotions
WHERE promo_name LIKE '%no%promo%' COLLATE NOCASE   -- case-insensitive scan
LIMIT 20;
```

```sql
-- 3) See the most-frequent promo_id values recorded in sales
SELECT promo_id, COUNT(*) AS rows_in_sales
FROM sales
GROUP BY promo_id
ORDER BY rows_in_sales DESC
LIMIT 20;
```

```sql
-- 4) Sample US customer sales lines in Q4-2019 (helps confirm date layout)
SELECT s.*, c.cust_city
FROM   sales      AS s
JOIN   customers  AS c  USING (cust_id)
WHERE  c.country_id IN (SELECT country_id
                        FROM   countries
                        WHERE  country_name LIKE '%United%')
  AND  s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
LIMIT 20;
```

```sql
-- 5) Q4 sales – split by year – WITHOUT promotions (promo_id found in step-2 / 3)
--    Replace :no_promo_id with the actual value you observed.
SELECT c.cust_city,
       SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                THEN s.amount_sold END) AS q4_2019_sales,
       SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                THEN s.amount_sold END) AS q4_2020_sales
FROM   sales      AS s
JOIN   customers  AS c  USING (cust_id)
WHERE  c.country_id IN (SELECT country_id
                        FROM   countries
                        WHERE  country_name LIKE '%United%')
  AND  s.promo_id = :no_promo_id
  AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
GROUP  BY c.cust_city
HAVING q4_2019_sales > 0                                   -- keep cities with sales
LIMIT 20;
```

```sql
-- 6) Keep only the cities whose sales rose ≥ 20 %
WITH city_growth AS (
  SELECT c.cust_city,
         SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                  THEN s.amount_sold END) AS sales_2019,
         SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                  THEN s.amount_sold END) AS sales_2020
  FROM   sales AS s
  JOIN   customers AS c USING (cust_id)
  WHERE  c.country_id IN (SELECT country_id
                          FROM   countries
                          WHERE  country_name LIKE '%United%')
    AND  s.promo_id = :no_promo_id
    AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
  GROUP  BY c.cust_city
)
SELECT cust_city,
       sales_2019,
       sales_2020,
       ROUND((sales_2020 - sales_2019)*1.0 / sales_2019, 3) AS pct_growth
FROM   city_growth
WHERE  sales_2020 >= 1.2 * sales_2019
LIMIT 20;
```

```sql
-- 7) Overall Q4-2019 + Q4-2020 sales by product across ONLY the grown cities
WITH kept_cities AS (
  SELECT cust_city
  FROM   (
      /* Re-use query #6 but without LIMIT so it feeds us every grown city */
      SELECT c.cust_city,
             SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                      THEN s.amount_sold END) AS s19,
             SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                      THEN s.amount_sold END) AS s20
      FROM   sales AS s
      JOIN   customers AS c USING (cust_id)
      WHERE  c.country_id IN (SELECT country_id
                              FROM   countries
                              WHERE  country_name LIKE '%United%')
        AND  s.promo_id = :no_promo_id
        AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
      GROUP  BY c.cust_city
  )
  WHERE  s20 >= 1.2 * s19
)
SELECT s.prod_id,
       SUM(s.amount_sold) AS total_q4_sales
FROM   sales      AS s
JOIN   customers  AS c  USING (cust_id)
WHERE  c.cust_city IN (SELECT cust_city FROM kept_cities)
  AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
  AND  s.promo_id = :no_promo_id
GROUP  BY s.prod_id
ORDER  BY total_q4_sales DESC
LIMIT 20;
```

```sql
-- 8) Rank products and keep the top 20 % (uses window functions)
WITH prod_rank AS (
  SELECT prod_id,
         total_q4_sales,
         RANK()        OVER (ORDER BY total_q4_sales DESC)           AS rnk,
         COUNT(*)      OVER ()                                       AS n_prod
  FROM (
      /* query #7 without LIMIT so we get all products */
      SELECT s.prod_id,
             SUM(s.amount_sold) AS total_q4_sales
      FROM   sales     AS s
      JOIN   customers AS c USING (cust_id)
      WHERE  c.cust_city IN (
               SELECT cust_city
               FROM   (
                   /* same as kept_cities cte */
                   SELECT c.cust_city,
                          SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                                   THEN s.amount_sold END) AS s19,
                          SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                                   THEN s.amount_sold END) AS s20
                   FROM   sales AS s
                   JOIN   customers AS c USING (cust_id)
                   WHERE  c.country_id IN (SELECT country_id
                                           FROM   countries
                                           WHERE  country_name LIKE '%United%')
                     AND  s.promo_id = :no_promo_id
                     AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
                   GROUP  BY c.cust_city
                   HAVING s20 >= 1.2 * s19
               )
             )
        AND s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
        AND s.promo_id = :no_promo_id
      GROUP  BY s.prod_id
  )
)
SELECT prod_id, total_q4_sales, rnk, n_prod
FROM   prod_rank
WHERE  rnk <= 0.2 * n_prod                               -- top 20 %
ORDER  BY rnk
LIMIT 20;
```

```sql
-- 9) Compute each top product’s share of total sales in Q4-2019 and Q4-2020
WITH top_prod AS ( /* query #8 without LIMIT */ 
  SELECT prod_id
  FROM   (
    /* same prod_rank CTE as #8 */
    SELECT prod_id,
           total_q4_sales,
           RANK()  OVER (ORDER BY total_q4_sales DESC) AS rnk,
           COUNT(*) OVER ()                            AS n_prod
    FROM   ( /* inner query identical to #7 */ 
             SELECT s.prod_id,
                    SUM(s.amount_sold) AS total_q4_sales
             FROM   sales AS s
             JOIN   customers AS c USING (cust_id)
             WHERE  c.cust_city IN ( /* kept cities CTE again */ 
                      SELECT cust_city
                      FROM   ( /* growth calc */ 
                               SELECT c.cust_city,
                                      SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                                               THEN s.amount_sold END) AS s19,
                                      SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                                               THEN s.amount_sold END) AS s20
                               FROM   sales AS s
                               JOIN   customers AS c USING (cust_id)
                               WHERE  c.country_id IN (SELECT country_id
                                                       FROM   countries
                                                       WHERE  country_name LIKE '%United%')
                                 AND  s.promo_id = :no_promo_id
                                 AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
                               GROUP  BY c.cust_city
                               HAVING s20 >= 1.2 * s19)
                    )
               AND s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
               AND s.promo_id = :no_promo_id
             GROUP  BY s.prod_id)
  )
  WHERE rnk <= 0.2 * n_prod
),
city_pool AS ( /* every qualified sale line */ 
  SELECT s.*
  FROM   sales     AS s
  JOIN   customers AS c USING (cust_id)
  WHERE  c.cust_city IN (SELECT cust_city
                         FROM   ( /* same growth calc as above */ 
                                 SELECT c.cust_city,
                                        SUM(CASE WHEN s.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                                                 THEN s.amount_sold END) AS s19,
                                        SUM(CASE WHEN s.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                                                 THEN s.amount_sold END) AS s20
                                 FROM   sales AS s
                                 JOIN   customers AS c USING (cust_id)
                                 WHERE  c.country_id IN (SELECT country_id
                                                         FROM   countries
                                                         WHERE  country_name LIKE '%United%')
                                   AND  s.promo_id = :no_promo_id
                                   AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
                                 GROUP  BY c.cust_city
                                 HAVING s20 >= 1.2 * s19))
    AND s.promo_id = :no_promo_id
    AND s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
)
SELECT tp.prod_id,
       /* product sales per quarter */
       SUM(CASE WHEN time_id BETWEEN '2019-10-01' AND '2019-12-31'
                THEN amount_sold END) AS prod_q4_2019,
       SUM(CASE WHEN time_id BETWEEN '2020-10-01' AND '2020-12-31'
                THEN amount_sold END) AS prod_q4_2020,
       /* total market sales per quarter */
       (SELECT SUM(amount_sold)
        FROM   city_pool
        WHERE  time_id BETWEEN '2019-10-01' AND '2019-12-31') AS tot_2019,
       (SELECT SUM(amount_sold)
        FROM   city_pool
        WHERE  time_id BETWEEN '2020-10-01' AND '2020-12-31') AS tot_2020
FROM   top_prod AS tp
JOIN   city_pool AS cp
  ON   cp.prod_id = tp.prod_id
GROUP  BY tp.prod_id
LIMIT 20;
```

```sql
-- 10) Final answer – share in each Q4 and change, ordered by biggest jump
WITH final AS ( /* reuse CTEs from #9 and compute shares */
  SELECT tp.prod_id,
         SUM(CASE WHEN cp.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                  THEN cp.amount_sold END)                                    AS prod_19,
         SUM(CASE WHEN cp.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                  THEN cp.amount_sold END)                                    AS prod_20,
         (SELECT SUM(amount_sold) FROM city_pool
          WHERE time_id BETWEEN '2019-10-01' AND '2019-12-31')                AS tot_19,
         (SELECT SUM(amount_sold) FROM city_pool
          WHERE time_id BETWEEN '2020-10-01' AND '2020-12-31')                AS tot_20
  FROM   top_prod tp
  JOIN   city_pool cp ON cp.prod_id = tp.prod_id
  GROUP  BY tp.prod_id
)
SELECT prod_id,
       ROUND(prod_19   *1.0 / tot_19, 4) AS share_q4_2019,
       ROUND(prod_20   *1.0 / tot_20, 4) AS share_q4_2020,
       ROUND(prod_20*1.0/tot_20 - prod_19*1.0/tot_19, 4) AS share_change
FROM   final
ORDER  BY share_change DESC
LIMIT 20;
```

