--Description: 
--Single-statement solution for the whole task.  
--1) Build U.S. no-promotion (“promo_id = 999”) sales for Q4-2019 & Q4-2020.  
--2) Keep only those cities whose 2020 total ≥ 120 % of 2019.  
--3) Inside those cities, rank products by combined Q4-19+20 sales and keep the top 20 %.  
--4) For each kept product, compute its share of overall sales in Q4-2019 and Q4-2020,  
--   then return the products ordered by the change in share (descending).
WITH us_sales AS (               -- all US rows, no promotion, Q4-2019/2020
    SELECT s.prod_id,
           s.cust_id,
           s.time_id,
           s.amount_sold
    FROM   sales     AS s
    JOIN   customers AS c ON s.cust_id = c.cust_id
    WHERE  c.country_id = 52790      -- United States of America
      AND  s.promo_id  = 999         -- NO PROMOTION
      AND  s.time_id  BETWEEN '2019-10-01' AND '2020-12-31'
),
city_growth AS (                  -- Q4 totals per city, the two years
    SELECT c.cust_city AS city,
           SUM(CASE WHEN u.time_id BETWEEN '2019-10-01' AND '2019-12-31'
                    THEN u.amount_sold END) AS sales_2019,
           SUM(CASE WHEN u.time_id BETWEEN '2020-10-01' AND '2020-12-31'
                    THEN u.amount_sold END) AS sales_2020
    FROM   us_sales  AS u
    JOIN   customers AS c ON u.cust_id = c.cust_id
    GROUP  BY c.cust_city
),
kept_cities AS (                  -- cities whose 2020 ≥ 120 % of 2019
    SELECT city
    FROM   city_growth
    WHERE  sales_2019 > 0
      AND  sales_2020 >= 1.2 * sales_2019
),
filtered_sales AS (               -- only sales inside the kept cities
    SELECT u.*
    FROM   us_sales  AS u
    JOIN   customers AS c ON u.cust_id = c.cust_id
    WHERE  c.cust_city IN (SELECT city FROM kept_cities)
),
prod_total AS (                   -- combined Q4-19+20 sales per product
    SELECT prod_id,
           SUM(amount_sold) AS total_sales
    FROM   filtered_sales
    GROUP  BY prod_id
),
prod_rank AS (                    -- rank products and capture N
    SELECT prod_id,
           total_sales,
           ROW_NUMBER()     OVER (ORDER BY total_sales DESC) AS rn,
           COUNT(*)         OVER ()                          AS n_prod
    FROM   prod_total
),
top_products AS (                 -- keep top 20 %
    SELECT prod_id
    FROM   prod_rank
    WHERE  rn <= n_prod * 0.2
),
prod_year_sales AS (              -- per product, sales by year
    SELECT prod_id,
           SUM(CASE WHEN time_id BETWEEN '2019-10-01' AND '2019-12-31'
                    THEN amount_sold END) AS sales_2019,
           SUM(CASE WHEN time_id BETWEEN '2020-10-01' AND '2020-12-31'
                    THEN amount_sold END) AS sales_2020
    FROM   filtered_sales
    WHERE  prod_id IN (SELECT prod_id FROM top_products)
    GROUP  BY prod_id
),
totals AS (                       -- market totals for each Q4
    SELECT
        SUM(CASE WHEN time_id BETWEEN '2019-10-01' AND '2019-12-31'
                 THEN amount_sold END) AS total_2019,
        SUM(CASE WHEN time_id BETWEEN '2020-10-01' AND '2020-12-31'
                 THEN amount_sold END) AS total_2020
    FROM filtered_sales
)
SELECT
    pys.prod_id,
    ROUND(pys.sales_2019 * 1.0 / t.total_2019, 4) AS share_q4_2019,
    ROUND(pys.sales_2020 * 1.0 / t.total_2020, 4) AS share_q4_2020,
    ROUND(pys.sales_2020 * 1.0 / t.total_2020
         - pys.sales_2019 * 1.0 / t.total_2019, 4) AS share_change
FROM   prod_year_sales pys
CROSS  JOIN totals t
ORDER  BY share_change DESC
LIMIT 20;
