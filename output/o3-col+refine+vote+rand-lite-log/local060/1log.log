        JOIN   customers AS c USING (cust_id)
        WHERE  c.country_id = 52790
          AND  s.promo_id  = 999
          AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
        GROUP  BY c.cust_city
        HAVING s20 >= 1.2 * s19
    )
),
filtered_sales AS (
    SELECT s.*
    FROM   sales      AS s
    JOIN   customers  AS c USING (cust_id)
    WHERE  c.cust_city IN (SELECT cust_city FROM kept_cities)
      AND  s.promo_id  = 999
      AND  s.time_id BETWEEN '2019-10-01' AND '2020-12-31'
),
prod_tot AS (
    SELECT prod_id,
           SUM(amount_sold) AS tot
    FROM   filtered_sales
    GROUP  BY prod_id
),
top_prod AS (
    SELECT prod_id
    FROM (
        SELECT prod_id,
               tot,
               ROW_NUMBER() OVER (ORDER BY tot DESC)          AS rn,
               COUNT(*)  OVER ()                              AS n_all
        FROM   prod_tot
    )
    WHERE rn <= 0.2 * n_all
),
market_tot AS (
    SELECT
        SUM(CASE WHEN time_id BETWEEN '2019-10-01' AND '2019-12-31' THEN amount_sold END) AS tot19,
        SUM(CASE WHEN time_id BETWEEN '2020-10-01' AND '2020-12-31' THEN amount_sold END) AS tot20
    FROM filtered_sales
)
SELECT tp.prod_id,
       SUM(CASE WHEN fs.time_id BETWEEN '2019-10-01' AND '2019-12-31' THEN fs.amount_sold END) AS prod19,
       SUM(CASE WHEN fs.time_id BETWEEN '2020-10-01' AND '2020-12-31' THEN fs.amount_sold END) AS prod20,
       mt.tot19,
       mt.tot20
FROM   top_prod      AS tp
JOIN   filtered_sales AS fs ON fs.prod_id = tp.prod_id
CROSS  JOIN market_tot mt
GROUP  BY tp.prod_id
LIMIT 20
