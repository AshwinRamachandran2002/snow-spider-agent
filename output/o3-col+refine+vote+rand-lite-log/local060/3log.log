```sql
--Description: Find U.S. cities whose Q4-2020 sales exceeded their Q4-2019 sales by at least 20 %.
WITH sales19 AS (
    SELECT c."cust_city",
           SUM(s."amount_sold") AS tot19
    FROM   "sales" s
    JOIN   "customers"  c  ON c."cust_id" = s."cust_id"
    JOIN   "countries"  ct ON ct."country_id" = c."country_id"
    JOIN   "times"      t  ON t."time_id"    = s."time_id"
    WHERE  ct."country_name" LIKE '%United%States%'
      AND  t."calendar_year"  = 2019
      AND  t."calendar_month_number" IN (10,11,12)
    GROUP BY c."cust_city"
),
sales20 AS (
    SELECT c."cust_city",
           SUM(s."amount_sold") AS tot20
    FROM   "sales" s
    JOIN   "customers"  c  ON c."cust_id" = s."cust_id"
    JOIN   "countries"  ct ON ct."country_id" = c."country_id"
    JOIN   "times"      t  ON t."time_id"    = s."time_id"
    WHERE  ct."country_name" LIKE '%United%States%'
      AND  t."calendar_year"  = 2020
      AND  t."calendar_month_number" IN (10,11,12)
    GROUP BY c."cust_city"
)
SELECT a."cust_city",
       a.tot19  AS "total_sales_2019_Q4",
       b.tot20  AS "total_sales_2020_Q4",
       ROUND( (b.tot20 - a.tot19) * 100.0 / a.tot19, 1) AS "pct_growth"
FROM   sales19 a
JOIN   sales20 b ON a."cust_city" = b."cust_city"
WHERE  b.tot20 >= a.tot19 * 1.20
ORDER BY "pct_growth" DESC
LIMIT 20;
```

