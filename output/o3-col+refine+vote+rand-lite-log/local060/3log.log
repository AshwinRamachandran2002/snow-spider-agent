--Description: Take the top-20 % products (combined Q4-2019 & Q4-2020 sales in rising cities) and compute their market-share change.
WITH rising_cities AS (
    SELECT a."cust_city"
    FROM (
        SELECT c."cust_city", SUM(s."amount_sold") AS tot19
        FROM   "sales" s
        JOIN   "customers" c  ON c."cust_id" = s."cust_id"
        JOIN   "countries" ct ON ct."country_id" = c."country_id"
        JOIN   "times"     t  ON t."time_id"    = s."time_id"
        WHERE  ct."country_name" LIKE '%United%States%'
          AND  t."calendar_year" = 2019
          AND  t."calendar_month_number" IN (10,11,12)
        GROUP BY c."cust_city"
    ) a
    JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS tot20
        FROM   "sales" s
        JOIN   "customers" c  ON c."cust_id" = s."cust_id"
        JOIN   "countries" ct ON ct."country_id" = c."country_id"
        JOIN   "times"     t  ON t."time_id"    = s."time_id"
        WHERE  ct."country_name" LIKE '%United%States%'
          AND  t."calendar_year" = 2020
          AND  t."calendar_month_number" IN (10,11,12)
        GROUP BY c."cust_city"
    ) b ON a."cust_city" = b."cust_city"
    WHERE b.tot20 >= a.tot19 * 1.20
),
prod_sales AS (
    SELECT s."prod_id",
           SUM(CASE WHEN t."calendar_year" = 2019 THEN s."amount_sold" END) AS sales19,
           SUM(CASE WHEN t."calendar_year" = 2020 THEN s."amount_sold" END) AS sales20
    FROM   "sales" s
    JOIN   "customers"  c  ON c."cust_id"  = s."cust_id"
    JOIN   "countries"  ct ON ct."country_id" = c."country_id"
    JOIN   "times"      t  ON t."time_id"   = s."time_id"
    WHERE  ct."country_name" LIKE '%United%States%'
      AND  t."calendar_year" IN (2019,2020)
      AND  t."calendar_month_number" IN (10,11,12)
      AND  c."cust_city" IN (SELECT "cust_city" FROM rising_cities)
    GROUP BY s."prod_id"
),
ranked AS (
    SELECT *,
           RANK()  OVER (ORDER BY (COALESCE(sales19,0)+COALESCE(sales20,0)) DESC) AS rnk,
           COUNT(*) OVER ()                                                      AS total_cnt
    FROM   prod_sales
),
top_products AS (
    SELECT *
    FROM   ranked
    WHERE  rnk <= ROUND(total_cnt*0.20)   -- keep top 20 %
)
SELECT tp."prod_id",
       ROUND(100.0 * tp.sales19 / SUM(tp.sales19) OVER (), 2) AS "share_2019",
       ROUND(100.0 * tp.sales20 / SUM(tp.sales20) OVER (), 2) AS "share_2020",
       ROUND( (100.0 * tp.sales20 / SUM(tp.sales20) OVER ()) -
              (100.0 * tp.sales19 / SUM(tp.sales19) OVER ()), 2) AS "share_change"
FROM   top_products AS tp
ORDER BY "share_change" DESC
LIMIT 20
