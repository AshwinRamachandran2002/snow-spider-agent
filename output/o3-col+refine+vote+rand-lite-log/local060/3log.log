Query:
--Description: See how many distinct products appear in those two quarters and compute the cut-off for the top 20 % by combined sales.
WITH ranked AS (
    SELECT s."prod_id",
           SUM(s."amount_sold") AS total_two_years
    FROM   "sales" s
    JOIN   "customers"  c  ON c."cust_id"  = s."cust_id"
