```sql
-- 7. Cities whose Q4-2020 sales (no promo) are at least 20 % higher than Q4-2019
SELECT a."cust_city",
       a."total_sales_2019_Q4",
       b."total_sales_2020_Q4",
       ROUND( (b."total_sales_2020_Q4" - a."total_sales_2019_Q4") * 100.0 / a."total_sales_2019_Q4", 1) 
       AS "pct_growth"
FROM  (
        SELECT c."cust_city",
               SUM(s."amount_sold") AS "total_sales_2019_Q4"
        FROM   "sales" s
        JOIN   "customers"  c  ON c."cust_id"   = s."cust_id"
        JOIN   "countries"  ct ON ct."country_id" = c."country_id"
        JOIN   "times"      t  ON t."time_id"   = s."time_id"
        LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
        WHERE  ct."country_name" LIKE '%United%States%'
          AND  p."promo_id" IS NULL
          AND  t."calendar_year"          = 2019
          AND  t."calendar_month_number" IN (10,11,12)
        GROUP BY c."cust_city"
      ) a
JOIN  (
        SELECT c."cust_city",
               SUM(s."amount_sold") AS "total_sales_2020_Q4"
        FROM   "sales" s
        JOIN   "customers"  c  ON c."cust_id"   = s."cust_id"
        JOIN   "countries"  ct ON ct."country_id" = c."country_id"
        JOIN   "times"      t  ON t."time_id"   = s."time_id"
        LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
        WHERE  ct."country_name" LIKE '%United%States%'
          AND  p."promo_id" IS NULL
          AND  t."calendar_year"          = 2020
          AND  t."calendar_month_number" IN (10,11,12)
        GROUP BY c."cust_city"
      ) b
ON    a."cust_city" = b."cust_city"
WHERE b."total_sales_2020_Q4" >= a."total_sales_2019_Q4" * 1.20
ORDER BY "pct_growth" DESC
LIMIT 20;
```

```sql
-- 8. Product-level totals (no promo) in the cities that cleared the 20 % hurdle, for Q4-2019 & Q4-2020
WITH rising_cities AS (
     SELECT a."cust_city"
     FROM  (
            SELECT c."cust_city",
                   SUM(s."amount_sold") AS tot19
            FROM   "sales" s
            JOIN   "customers" c  ON c."cust_id" = s."cust_id"
            JOIN   "countries" ct ON ct."country_id" = c."country_id"
            JOIN   "times"     t  ON t."time_id"    = s."time_id"
            LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
            WHERE  ct."country_name" LIKE '%United%States%'
              AND  p."promo_id" IS NULL
              AND  t."calendar_year" = 2019
              AND  t."calendar_month_number" IN (10,11,12)
            GROUP BY c."cust_city"
          ) a
     JOIN (
            SELECT c."cust_city",
                   SUM(s."amount_sold") AS tot20
            FROM   "sales" s
            JOIN   "customers" c  ON c."cust_id" = s."cust_id"
            JOIN   "countries" ct ON ct."country_id" = c."country_id"
            JOIN   "times"     t  ON t."time_id"    = s."time_id"
            LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
            WHERE  ct."country_name" LIKE '%United%States%'
              AND  p."promo_id" IS NULL
              AND  t."calendar_year" = 2020
              AND  t."calendar_month_number" IN (10,11,12)
            GROUP BY c."cust_city"
          ) b
     ON  a."cust_city" = b."cust_city"
     WHERE b.tot20 >= a.tot19 * 1.20
)
SELECT s."prod_id",
       SUM(CASE WHEN t."calendar_year" = 2019 THEN s."amount_sold" END) AS "sales_2019_Q4",
       SUM(CASE WHEN t."calendar_year" = 2020 THEN s."amount_sold" END) AS "sales_2020_Q4"
FROM   "sales"      AS s
JOIN   "customers"  AS c  ON c."cust_id" = s."cust_id"
JOIN   "countries"  AS ct ON ct."country_id" = c."country_id"
JOIN   "times"      AS t  ON t."time_id"    = s."time_id"
LEFT  JOIN "promotions" AS p ON p."promo_id" = s."promo_id"
WHERE  ct."country_name" LIKE '%United%States%'
  AND  p."promo_id" IS NULL
  AND  t."calendar_year" IN (2019,2020)
  AND  t."calendar_month_number" IN (10,11,12)
  AND  c."cust_city" IN (SELECT "cust_city" FROM rising_cities)
GROUP BY s."prod_id"
ORDER BY (COALESCE("sales_2019_Q4",0)+COALESCE("sales_2020_Q4",0)) DESC
LIMIT 20;
```

```sql
-- 9. Check how many products should be kept when taking the top 20 % by combined sales
WITH ranked AS (
     SELECT s."prod_id",
            SUM(s."amount_sold") AS total_two_years
     FROM   "sales" s
     JOIN   "customers"  c  ON c."cust_id" = s."cust_id"
     JOIN   "countries"  ct ON ct."country_id" = c."country_id"
     JOIN   "times"      t  ON t."time_id"    = s."time_id"
     LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
     WHERE  ct."country_name" LIKE '%United%States%'
       AND  p."promo_id" IS NULL
       AND  t."calendar_year" IN (2019,2020)
       AND  t."calendar_month_number" IN (10,11,12)
     GROUP BY s."prod_id"
     ORDER BY total_two_years DESC
)
SELECT COUNT(*) AS "total_distinct_products",
       ROUND(COUNT(*)*0.20) AS "top_20_percent_cutoff"
FROM   ranked;
```

```sql
-- 10. For the previously identified top products, compute their share in each year and the change
WITH rising_cities AS (   -- same CTE as in query 8
     SELECT a."cust_city"
     FROM  (
            SELECT c."cust_city", SUM(s."amount_sold") AS tot19
            FROM   "sales" s
            JOIN   "customers" c ON c."cust_id" = s."cust_id"
            JOIN   "countries" ct ON ct."country_id" = c."country_id"
            JOIN   "times"     t ON t."time_id"    = s."time_id"
            LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
            WHERE  ct."country_name" LIKE '%United%States%'
              AND  p."promo_id" IS NULL
              AND  t."calendar_year" = 2019
              AND  t."calendar_month_number" IN (10,11,12)
            GROUP BY c."cust_city"
          ) a
     JOIN (
            SELECT c."cust_city", SUM(s."amount_sold") AS tot20
            FROM   "sales" s
            JOIN   "customers" c ON c."cust_id" = s."cust_id"
            JOIN   "countries" ct ON ct."country_id" = c."country_id"
            JOIN   "times"     t ON t."time_id"    = s."time_id"
            LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
            WHERE  ct."country_name" LIKE '%United%States%'
              AND  p."promo_id" IS NULL
              AND  t."calendar_year" = 2020
              AND  t."calendar_month_number" IN (10,11,12)
            GROUP BY c."cust_city"
          ) b
     ON  a."cust_city" = b."cust_city"
     WHERE b.tot20 >= a.tot19 * 1.20
),                                                      
prod_sales AS (      -- product totals restricted to rising cities
     SELECT s."prod_id",
            SUM(CASE WHEN t."calendar_year" = 2019 THEN s."amount_sold" END) AS sales19,
            SUM(CASE WHEN t."calendar_year" = 2020 THEN s."amount_sold" END) AS sales20
     FROM   "sales" s
     JOIN   "customers"  c  ON c."cust_id" = s."cust_id"
     JOIN   "countries"  ct ON ct."country_id" = c."country_id"
     JOIN   "times"      t  ON t."time_id"    = s."time_id"
     LEFT  JOIN "promotions" p ON p."promo_id" = s."promo_id"
     WHERE  ct."country_name" LIKE '%United%States%'
       AND  p."promo_id" IS NULL
       AND  t."calendar_year" IN (2019,2020)
       AND  t."calendar_month_number" IN (10,11,12)
       AND  c."cust_city" IN (SELECT "cust_city" FROM rising_cities)
     GROUP BY s."prod_id"
),
ranked AS (           -- bring the combined ranking, keep only top 20 %
     SELECT *,
            RANK() OVER (ORDER BY (COALESCE(sales19,0)+COALESCE(sales20,0)) DESC) AS rnk,
            COUNT(*) OVER ()                                            AS total_cnt
     FROM   prod_sales
),
top_products AS (
     SELECT *
     FROM   ranked
     WHERE  rnk <= ROUND(total_cnt*0.20)            -- top 20 %
)
SELECT tp."prod_id",
       ROUND(100.0 * tp.sales19 / SUM(tp.sales19) OVER (), 2) AS "share_2019",
       ROUND(100.0 * tp.sales20 / SUM(tp.sales20) OVER (), 2) AS "share_2020",
       ROUND( (100.0 * tp.sales20 / SUM(tp.sales20) OVER ()) -
              (100.0 * tp.sales19 / SUM(tp.sales19) OVER ()), 2) AS "share_change"
FROM   top_products AS tp
ORDER BY "share_change" DESC
LIMIT 20;
```

Each query (up to 10) progressively explores the necessary columns and builds toward the final computation requested in the task. All queries are limited to 20 rows where appropriate and use only the tables provided in the database.
