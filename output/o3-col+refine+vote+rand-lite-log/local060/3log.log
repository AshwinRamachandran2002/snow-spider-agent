--Description: For those rising cities, get product-level totals for Q4-2019 and Q4-2020.
WITH rising_cities AS (
    SELECT a."cust_city"
    FROM (
        SELECT c."cust_city", SUM(s."amount_sold") AS tot19
        FROM   "sales" s
        JOIN   "customers" c  ON c."cust_id" = s."cust_id"
        JOIN   "countries" ct ON ct."country_id" = c."country_id"
        JOIN   "times"     t  ON t."time_id"    = s."time_id"
        WHERE  ct."country_name" LIKE '%United%States%'
          AND  t."calendar_year" = 2019
          AND  t."calendar_month_number" IN (10,11,12)
        GROUP BY c."cust_city"
    ) a
    JOIN (
        SELECT c."cust_city", SUM(s."amount_sold") AS tot20
        FROM   "sales" s
        JOIN   "customers" c  ON c."cust_id" = s."cust_id"
        JOIN   "countries" ct ON ct."country_id" = c."country_id"
        JOIN   "times"     t  ON t."time_id"    = s."time_id"
        WHERE  ct."country_name" LIKE '%United%States%'
          AND  t."calendar_year" = 2020
          AND  t."calendar_month_number" IN (10,11,12)
        GROUP BY c."cust_city"
    ) b ON a."cust_city" = b."cust_city"
    WHERE b.tot20 >= a.tot19 * 1.20
)
SELECT s."prod_id",
       SUM(CASE WHEN t."calendar_year" = 2019 THEN s."amount_sold" END) AS "sales_2019_Q4",
       SUM(CASE WHEN t."calendar_year" = 2020 THEN s."amount_sold" END) AS "sales_2020_Q4"
FROM   "sales"      AS s
JOIN   "customers"  AS c  ON c."cust_id"   = s."cust_id"
JOIN   "countries"  AS ct ON ct."country_id" = c."country_id"
JOIN   "times"      AS t  ON t."time_id"   = s."time_id"
WHERE  ct."country_name" LIKE '%United%States%'
  AND  t."calendar_year" IN (2019,2020)
  AND  t."calendar_month_number" IN (10,11,12)
  AND  c."cust_city" IN (SELECT "cust_city" FROM rising_cities)
GROUP BY s."prod_id"
ORDER BY (COALESCE("sales_2019_Q4",0) + COALESCE("sales_2020_Q4",0)) DESC
LIMIT 20
