```sql
--Description: 6) For that top assignee (replace %TOP_ASSIGNEE% after viewing previous query), show their yearly A61 filing counts.
SELECT 
    TO_CHAR(t."publication_date", 'YYYY') AS "year",
    COUNT(DISTINCT t."publication_number") AS "a61_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%' 
  AND a.value:"name"::STRING ILIKE '%TOP_ASSIGNEE%'
GROUP BY TO_CHAR(t."publication_date", 'YYYY')
ORDER BY "a61_count" DESC
LIMIT 20;
```

```sql
--Description: 7) Retrieve the busiest year for the top assignee (one row, highest count).
SELECT 
    TO_CHAR(t."publication_date", 'YYYY') AS "year",
    COUNT(DISTINCT t."publication_number") AS "a61_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%' 
  AND a.value:"name"::STRING ILIKE '%TOP_ASSIGNEE%'
GROUP BY TO_CHAR(t."publication_date", 'YYYY')
ORDER BY "a61_count" DESC
LIMIT 1;
```

```sql
--Description: 8) During that busiest year (replace %BUSIEST_YEAR%), list patent counts by jurisdiction (country_code) for the assignee.
SELECT 
    t."country_code",
    COUNT(DISTINCT t."publication_number") AS "patent_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%' 
  AND a.value:"name"::STRING ILIKE '%TOP_ASSIGNEE%'
  AND TO_CHAR(t."publication_date", 'YYYY') = '%BUSIEST_YEAR%'
GROUP BY t."country_code"
ORDER BY "patent_count" DESC
LIMIT 20;
```

```sql
--Description: 9) Fetch the top five jurisdiction codes where the assignee filed the most A61 patents in that busiest year.
SELECT 
    t."country_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%' 
  AND a.value:"name"::STRING ILIKE '%TOP_ASSIGNEE%'
  AND TO_CHAR(t."publication_date", 'YYYY') = '%BUSIEST_YEAR%'
GROUP BY t."country_code"
ORDER BY COUNT(DISTINCT t."publication_number") DESC
LIMIT 5;
```

```sql
--Description: 10) Same as query 9 but returns the five codes as a single comma-separated string (final formatting step).
SELECT 
    STRING_AGG(t."country_code", ',') AS "top_5_jurisdictions"
FROM (
    SELECT 
        t."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") c,
         LATERAL FLATTEN(input => t."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%' 
      AND a.value:"name"::STRING ILIKE '%TOP_ASSIGNEE%'
      AND TO_CHAR(t."publication_date", 'YYYY') = '%BUSIEST_YEAR%'
    GROUP BY t."country_code"
    ORDER BY COUNT(DISTINCT t."publication_number") DESC
    LIMIT 5
) t;
```
