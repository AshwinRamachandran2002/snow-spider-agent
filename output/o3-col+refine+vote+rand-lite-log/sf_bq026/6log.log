```sql
--Description: Identify PROCTER & GAMBLE’s busiest publication year for A61-category patents.
--Rationale:
--  • PUBLICATIONS.cpc is a JSON array; we FLATTEN it and keep rows where the CPC code begins with 'A61'.
--  • PUBLICATIONS.assignee_harmonized is also a JSON array; FLATTEN it and retain rows whose harmonised assignee
--    name contains both “PROCTER” and “GAMBLE” (case-insensitive wildcard search).
--  • publication_date is stored numerically as YYYYMMDD; converting to VARCHAR and taking the first four characters
--    yields the year.
--  • We then count distinct publication_numbers per year, sort by descending count, and keep the top 20 rows.
SELECT
    LEFT(t."publication_date"::VARCHAR, 4)                       AS "year",
    COUNT(DISTINCT t."publication_number")                       AS "a61_patent_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc")                 c,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'                -- filter to A61 CPC codes
  AND a.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'    -- filter to Procter & Gamble assignee
GROUP BY LEFT(t."publication_date"::VARCHAR, 4)
ORDER BY "a61_patent_count" DESC
LIMIT 20;
```
