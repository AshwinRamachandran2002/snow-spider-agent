```sql
--Description: Produce the five patent-office country codes (comma-separated) where the most-active A61 assignee
--             ― PROCTER & GAMBLE ― filed the most patents during its single busiest publication year.
--             Logic:
--               1) CTE “busiest” locates the year (YYYY) with the highest count of PROCTER & GAMBLE
--                  publications whose CPC codes start with ‘A61’.
--               2) CTE “top5” counts those same patents by country_code within that year and keeps the top five.
--               3) Final SELECT concatenates the five country codes with LISTAGG, giving the required string.
WITH busiest AS (
    SELECT LEFT(p."publication_date"::VARCHAR, 4) AS yr
    FROM PATENTS.PATENTS.PUBLICATIONS          p,
         LATERAL FLATTEN(input => p."cpc")      c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a
    WHERE c.value:"code"::STRING ILIKE 'A61%'                 -- A61 category
      AND a.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'     -- target assignee
    GROUP BY LEFT(p."publication_date"::VARCHAR, 4)
    ORDER BY COUNT(DISTINCT p."publication_number") DESC
    LIMIT 1
), top5 AS (
    SELECT p."country_code"
    FROM PATENTS.PATENTS.PUBLICATIONS          p,
         LATERAL FLATTEN(input => p."cpc")      c,
         LATERAL FLATTEN(input => p."assignee_harmonized") a,
         busiest
    WHERE c.value:"code"::STRING ILIKE 'A61%'
      AND a.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
      AND LEFT(p."publication_date"::VARCHAR, 4) = busiest.yr
    GROUP BY p."country_code"
    ORDER BY COUNT(DISTINCT p."publication_number") DESC
    LIMIT 5
)
SELECT LISTAGG("country_code", ',') AS "top_5_jurisdictions"
FROM top5;
