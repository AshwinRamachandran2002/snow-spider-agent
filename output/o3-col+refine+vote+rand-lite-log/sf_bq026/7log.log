```sql
--Description:
-- Goal: return the five patent-office country codes where the most-active A61 assignee
--       (“PROCTER & GAMBLE”) filed the most A61 patents **during its single busiest year**.
-- Strategy (annotated in-line):
--   1. CTE YEAR_COUNTS: for all Procter & Gamble A61 publications, count how many fall in
--      each publication year (derive year as FLOOR(publication_date/10000)).
--      Keep only the row with the maximum count → the “busiest year”.
--   2. Final SELECT: re-filter the same publication set to that busiest year and
--      aggregate by country_code, ordering by descending volume, limiting to top five.
WITH YEAR_COUNTS AS (
    SELECT
           FLOOR(p."publication_date" / 10000) AS "year",
           COUNT(*)                            AS "pubs_in_year"
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc")                c,
           LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE  c.value:"code"::STRING ILIKE 'A61%'                 -- keep A61 CPC codes
      AND  ah.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'    -- keep P&G assignee rows
    GROUP BY FLOOR(p."publication_date" / 10000)
    ORDER BY "pubs_in_year" DESC
    LIMIT 1                                                    -- the busiest year only
)
SELECT
       p."country_code",
       COUNT(*) AS "patent_count"
FROM   PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."cpc")                c,
       LATERAL FLATTEN(input => p."assignee_harmonized") ah,
       YEAR_COUNTS yc                                    -- cross-join to filter by year
WHERE  c.value:"code"::STRING ILIKE 'A61%'
  AND  ah.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
  AND  FLOOR(p."publication_date" / 10000) = yc."year"   -- restrict to busiest year
GROUP BY p."country_code"
ORDER BY "patent_count" DESC
LIMIT 5;                                                 -- top-5 jurisdictions
```
