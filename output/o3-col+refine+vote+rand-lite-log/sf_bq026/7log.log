--Description: Count A61 patents per assignee to find the most active assignee overall (top-10 preview).
SELECT 
    ah.value:"name"::STRING           AS "assignee_name",
    COUNT(*)                          AS "a61_patent_count"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")               c,
     LATERAL FLATTEN(input => p."assignee_harmonized") ah
WHERE c.value:"code"::STRING ILIKE 'A61%'
GROUP BY ah.value:"name"::STRING
ORDER BY "a61_patent_count" DESC
LIMIT 10;
