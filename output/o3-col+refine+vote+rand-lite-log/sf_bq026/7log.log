Query:
--Description: Breakdown of CPC subgroups (first 4 characters) for P&G A61 patents in its busiest year.
WITH BUSY AS (
    SELECT  FLOOR(p."publication_date"/10000) AS "year",
            COUNT(*) AS "cnt"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."cpc")               c,
            LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE   c.value:"code"::STRING ILIKE 'A61%'
      AND   ah.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
    GROUP BY FLOOR(p."publication_date"/10000)
    ORDER BY "cnt" DESC
    LIMIT 1
)
SELECT 
    SUBSTR(c.value:"code"::STRING,1,4) AS "cpc_subgroup",
    COUNT(*)                           AS "cnt"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."cpc")               c,
     LATERAL FLATTEN(input => p."assignee_harmonized") ah,
     BUSY b
WHERE c.value:"code"::STRING ILIKE 'A61%'
  AND ah.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
  AND FLOOR(p."publication_date"/10000) = b."year"
GROUP BY SUBSTR(c.value:"code"::STRING,1,4)
ORDER BY "cnt" DESC
LIMIT 20
