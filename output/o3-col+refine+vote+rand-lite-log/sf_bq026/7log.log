Query:
--Description: Display the five jurisdiction country codes where “PROCTER & GAMBLE” filed the most A61 patents in its busiest publication year (auto-detected).
WITH YEAR_COUNTS AS (
    SELECT  FLOOR(p."publication_date"/10000) AS "year",
            COUNT(*)                          AS "pubs_in_year"
    FROM    PATENTS.PATENTS.PUBLICATIONS p,
            LATERAL FLATTEN(input => p."cpc")               c,
            LATERAL FLATTEN(input => p."assignee_harmonized") ah
    WHERE   c.value:"code"::STRING ILIKE 'A61%'
      AND   ah.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
    GROUP BY FLOOR(p."publication_date"/10000)
    ORDER BY "pubs_in_year" DESC
    LIMIT 1
)
SELECT  p."country_code",
        COUNT(*) AS "patent_count"
FROM    PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."cpc")               c,
        LATERAL FLATTEN(input => p."assignee_harmonized") ah,
        YEAR_COUNTS yc
WHERE   c.value:"code"::STRING ILIKE 'A61%'
  AND   ah.value:"name"::STRING ILIKE '%PROCTER%GAMBLE%'
  AND   FLOOR(p."publication_date"/10000) = yc."year"
GROUP BY p."country_code"
ORDER BY "patent_count" DESC
LIMIT 5
