Query:
--Description: Identify the busiest publication year (highest A61 count) for “PROCTER & GAMBLE”  
SELECT
    SUBSTR(TO_VARCHAR(p."publication_date"), 1, 4) AS "busiest_year"
FROM PATENTS.PATENTS.PUBLICATIONS                p,
     LATERAL FLATTEN(INPUT => p."cpc")            c,
     LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'                 -- CPC section A61
  AND a.value:"name"::STRING ILIKE 'PROCTER & GAMBLE%'    -- tolerant assignee match
GROUP BY SUBSTR(TO_VARCHAR(p."publication_date"), 1, 4)
ORDER BY COUNT(DISTINCT p."publication_number") DESC
LIMIT 1
