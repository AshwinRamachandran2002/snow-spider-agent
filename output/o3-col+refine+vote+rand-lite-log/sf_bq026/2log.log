--Description: Retrieve the single assignee with the highest number of “A61” patents  
SELECT
    a.value:"name"::STRING  AS "top_assignee"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(INPUT => p."cpc") c,
     LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
GROUP BY a.value:"name"::STRING
ORDER BY COUNT(*) DESC
LIMIT 1;
