```sql
--Description: We need yearly counts of “A61”-class patents for the most-active assignee.  
--Step-by-step thinking (as comments):  
-- 1) “A61” patents are identified by CPC codes that start with ‘A61’.  
-- 2) The assignee with the highest overall A61 activity is “PROCTER & GAMBLE” (found earlier).  
--    Variants like “PROCTER & GAMBLE CO”, “PROCTER & GAMBLE COMPANY” may appear,  
--    so we match with the prefix ‘PROCTER & GAMBLE%’ using ILIKE.  
-- 3) Extract the publication year from the 8-digit numeric “publication_date” (YYYYMMDD)  
--    by converting to text and taking the first 4 characters.  
-- 4) Count distinct publications per year, order by the largest counts, and limit to 20 rows.

SELECT
    SUBSTR(TO_VARCHAR(p."publication_date"), 1, 4) AS "pub_year",
    COUNT(DISTINCT p."publication_number")         AS "yearly_a61_count"
FROM PATENTS.PATENTS.PUBLICATIONS                p,
     LATERAL FLATTEN(INPUT => p."cpc")            c,
     LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'                 -- filter CPC section A61
  AND a.value:"name"::STRING ILIKE 'PROCTER & GAMBLE%'    -- flexible assignee match
GROUP BY SUBSTR(TO_VARCHAR(p."publication_date"), 1, 4)
ORDER BY "yearly_a61_count" DESC
LIMIT 20;
```
