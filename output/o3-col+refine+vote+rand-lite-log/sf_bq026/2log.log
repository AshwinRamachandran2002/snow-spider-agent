Query:
--Description: Cross-check – list publication numbers for the single top jurisdiction
--             (most filings) among Procter & Gamble’s A61 patents in 1999.
--             The top country is selected automatically via a sub-query.
SELECT
    p."publication_number",
    p."country_code"
FROM PATENTS.PATENTS.PUBLICATIONS              p,
     LATERAL FLATTEN(INPUT => p."cpc")         c,
     LATERAL FLATTEN(INPUT => p."assignee_harmonized") a
WHERE c.value:"code"::STRING ILIKE 'A61%'
  AND a.value:"name"::STRING ILIKE 'PROCTER & GAMBLE%'
  AND SUBSTR(TO_VARCHAR(p."publication_date"),1,4) = '1999'
  AND p."country_code" = (
        SELECT COALESCE(p2."country_code",'UNKNOWN')
        FROM PATENTS.PATENTS.PUBLICATIONS          p2,
             LATERAL FLATTEN(INPUT => p2."cpc")    c2,
             LATERAL FLATTEN(INPUT => p2."assignee_harmonized") a2
        WHERE c2.value:"code"::STRING ILIKE 'A61%'
          AND a2.value:"name"::STRING ILIKE 'PROCTER & GAMBLE%'
          AND SUBSTR(TO_VARCHAR(p2."publication_date"),1,4) = '1999'
        GROUP BY COALESCE(p2."country_code",'UNKNOWN')
        ORDER BY COUNT(DISTINCT p2."publication_number") DESC
        LIMIT 1
      )
LIMIT 20
