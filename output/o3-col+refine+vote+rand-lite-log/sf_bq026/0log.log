Query:
--Description: Count number of A61-category publications per assignee, show the 20 most active
SELECT a.value:"name"::STRING  AS "assignee_name",
       COUNT(*)               AS "a61_pub_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") f,
     LATERAL FLATTEN(input => t."assignee_harmonized") a
WHERE f.value:"code"::STRING ILIKE 'A61%'
GROUP BY a.value:"name"::STRING
ORDER BY "a61_pub_count" DESC
LIMIT 20;
