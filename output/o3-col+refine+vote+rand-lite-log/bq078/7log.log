Query:
--Description: Retrieve only the highest-score value (in case of ties may return >1)
SELECT *
FROM (
  SELECT a.targetId,
         t.approvedSymbol,
         a.score,
         RANK() OVER (ORDER BY a.score DESC) AS rnk
  FROM `bigquery-public-data.open_targets_platform.association_by_datasource_indirect` AS a
  JOIN `bigquery-public-data.open_targets_platform.targets`                            AS t
    ON a.targetId = t.id
  WHERE a.datasourceId = 'impc'
    AND a.diseaseId    = 'EFO_0000676'
)
WHERE rnk = 1
LIMIT 20
Answer:
targetId,approvedSymbol,score,rnk
ENSG00000160255,ITGB2,0.6635407862226913,1
Query:
--Description: Same as above but keeping only the approved gene symbols (final tidy answer)
SELECT DISTINCT approvedSymbol
FROM (
  SELECT t.approvedSymbol,
         a.score,
         RANK() OVER (ORDER BY a.score DESC) AS rnk
  FROM `bigquery-public-data.open_targets_platform.association_by_datasource_indirect` AS a
  JOIN `bigquery-public-data.open_targets_platform.targets`                            AS t
    ON a.targetId = t.id
  WHERE a.datasourceId = 'impc'
    AND a.diseaseId    = 'EFO_0000676'
)
WHERE rnk = 1
LIMIT 20
