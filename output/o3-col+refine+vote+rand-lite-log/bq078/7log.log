```sql
--Description:  Using the public Open Targets dataset, this query
--1) filters the indirect association table for rows coming from IMPC (`datasourceId = 'impc'`)
--   and concerning the disease EFO_0000676,
--2) ranks those rows by descending `score`,
--3) keeps only the target(s) with the highest score (`rnk = 1`),
--4) joins to the targets table to obtain the corresponding approved gene symbol(s),
--5) returns the distinct symbol(s).
WITH ranked AS (
  SELECT
    targetId,
    score,
    RANK() OVER (ORDER BY score DESC) AS rnk
  FROM `bigquery-public-data.open_targets_platform.association_by_datasource_indirect`
  WHERE datasourceId = 'impc'
    AND diseaseId    = 'EFO_0000676'
)
SELECT DISTINCT t.approvedSymbol
FROM ranked r
JOIN `bigquery-public-data.open_targets_platform.targets` t
  ON t.id = r.targetId
WHERE r.rnk = 1;
```
