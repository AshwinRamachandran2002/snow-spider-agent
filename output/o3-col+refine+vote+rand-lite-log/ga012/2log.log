2025-05-05 04:24:55 - Thread-3083 (execute) - INFO - [Exploration]
Below is a progressive set of BigQuery SQL statements (max 10) that explore November 30 2020 data, locate the item-category that has the highest tax-rate ( tax_value_in_usd ÷ purchase_revenue_in_usd ) for “purchase” events, and finally return the required information for every purchase that belongs to that top-tax-rate category.

```sql
--1--------------------------------------------------------------
--Description: List every distinct event type that exists on 2020-11-30.
SELECT DISTINCT `event_name`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
LIMIT 20;
```

```sql
--2--------------------------------------------------------------
--Description: Quick look at the ecommerce block in “purchase” events.
SELECT
  `event_timestamp`,
  `ecommerce`.purchase_revenue_in_usd  AS purchase_rev_usd,
  `ecommerce`.tax_value_in_usd         AS tax_usd,
  `ecommerce`.transaction_id           AS txn_id,
  `ecommerce`.total_item_quantity      AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
WHERE `event_name` = 'purchase'
LIMIT 20;
```

```sql
--3--------------------------------------------------------------
--Description: Inspect the items array for those purchase events.
SELECT
  e.event_timestamp,
  item.item_category,
  item.item_name,
  item.price_in_usd,
  item.quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e,
UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
LIMIT 20;
```

```sql
--4--------------------------------------------------------------
--Description: Compute the tax-rate for each individual purchase event.
SELECT
  `ecommerce`.transaction_id                         AS txn_id,
  `ecommerce`.tax_value_in_usd                       AS tax_usd,
  `ecommerce`.purchase_revenue_in_usd                AS rev_usd,
  SAFE_DIVIDE(`ecommerce`.tax_value_in_usd,
              `ecommerce`.purchase_revenue_in_usd)   AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
WHERE `event_name` = 'purchase'
LIMIT 20;
```

```sql
--5--------------------------------------------------------------
--Description: Aggregate tax-rate by item_category across ALL purchases.
SELECT
  item.item_category                                  AS item_category,
  SUM(e.ecommerce.tax_value_in_usd)                   AS total_tax_usd,
  SUM(e.ecommerce.purchase_revenue_in_usd)            AS total_rev_usd,
  SAFE_DIVIDE(SUM(e.ecommerce.tax_value_in_usd),
              SUM(e.ecommerce.purchase_revenue_in_usd)) AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
GROUP BY item.item_category
ORDER BY tax_rate DESC
LIMIT 20;
```

```sql
--6--------------------------------------------------------------
--Description: Grab ONLY the single item_category with the highest tax-rate.
SELECT
  item.item_category,
  SAFE_DIVIDE(SUM(e.ecommerce.tax_value_in_usd),
              SUM(e.ecommerce.purchase_revenue_in_usd)) AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
GROUP BY item.item_category
ORDER BY tax_rate DESC
LIMIT 1;
```

```sql
--7--------------------------------------------------------------
--Description: For that top-tax-rate category, list every related purchase.
--(Uses the sub-query from step-6 so no hard-coding is needed.)
SELECT
  e.ecommerce.transaction_id           AS transaction_id,
  e.ecommerce.total_item_quantity      AS total_item_quantity,
  e.ecommerce.purchase_revenue_in_usd  AS purchase_revenue_in_usd,
  e.ecommerce.purchase_revenue         AS purchase_revenue
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
  AND item.item_category = (
        SELECT item_category
        FROM (
          SELECT
            item.item_category,
            SAFE_DIVIDE(SUM(e2.ecommerce.tax_value_in_usd),
                        SUM(e2.ecommerce.purchase_revenue_in_usd)) AS tax_rate
          FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e2
          JOIN UNNEST(e2.items) AS item
          WHERE e2.event_name = 'purchase'
          GROUP BY item.item_category
          ORDER BY tax_rate DESC
          LIMIT 1
        )
      )
LIMIT 20;
```

```sql
--8--------------------------------------------------------------
--Description: Same as #7 but showing DISTINCT transactions only.
SELECT DISTINCT
  e.ecommerce.transaction_id,
  e.ecommerce.purchase_revenue_in_usd,
  e.ecommerce.purchase_revenue
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
  AND item.item_category = (
        SELECT item_category
        FROM (
          SELECT
            item.item_category,
            SAFE_DIVIDE(SUM(e2.ecommerce.tax_value_in_usd),
                        SUM(e2.ecommerce.purchase_revenue_in_usd)) AS tax_rate
          FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e2
          JOIN UNNEST(e2.items) AS item
          WHERE e2.event_name = 'purchase'
          GROUP BY item.item_category
          ORDER BY tax_rate DESC
          LIMIT 1
        )
      )
LIMIT 20;
```

```sql
--9--------------------------------------------------------------
--Description: Final answer – delivers transaction_id, quantity, and both 
--forms of revenue for EVERY purchase in the top-tax-rate category.
--(The LIMIT can be removed when you are ready for the complete result.)
SELECT
  e.ecommerce.transaction_id           AS transaction_id,
  e.ecommerce.total_item_quantity      AS total_item_quantity,
  e.ecommerce.purchase_revenue_in_usd  AS purchase_revenue_in_usd,
  e.ecommerce.purchase_revenue         AS purchase_revenue
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
  AND item.item_category = (
        SELECT item_category
        FROM (
          SELECT
            item.item_category,
            SAFE_DIVIDE(SUM(e2.ecommerce.tax_value_in_usd),
                        SUM(e2.ecommerce.purchase_revenue_in_usd)) AS tax_rate
          FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e2
          JOIN UNNEST(e2.items) AS item
          WHERE e2.event_name = 'purchase'
          GROUP BY item.item_category
          ORDER BY tax_rate DESC
          LIMIT 1
        )
      )
LIMIT 20;
```

```sql
--10-------------------------------------------------------------
--Description: (Optional) Verify the tax-rate of those selected purchases.
SELECT
  item.item_category,
  SUM(e.ecommerce.tax_value_in_usd)        AS total_tax_usd,
  SUM(e.ecommerce.purchase_revenue_in_usd) AS total_rev_usd,
  SAFE_DIVIDE(SUM(e.ecommerce.tax_value_in_usd),
              SUM(e.ecommerce.purchase_revenue_in_usd)) AS verified_tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
  AND item.item_category = (
        SELECT item_category
        FROM (
          SELECT
            item.item_category,
            SAFE_DIVIDE(SUM(e2.ecommerce.tax_value_in_usd),
                        SUM(e2.ecommerce.purchase_revenue_in_usd)) AS tax_rate
          FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e2
          JOIN UNNEST(e2.items) AS item
          WHERE e2.event_name = 'purchase'
          GROUP BY item.item_category
          ORDER BY tax_rate DESC
          LIMIT 1
        )
      )
GROUP BY item.item_category
LIMIT 20;
```

