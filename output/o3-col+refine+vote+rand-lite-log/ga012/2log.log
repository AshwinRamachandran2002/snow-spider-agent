Query:
--5--------------------------------------------------------------
--Description: Aggregate tax-rate by item_category across ALL purchases.
SELECT
  item.item_category                                  AS item_category,
  SUM(e.ecommerce.tax_value_in_usd)                   AS total_tax_usd,
  SUM(e.ecommerce.purchase_revenue_in_usd)            AS total_rev_usd,
  SAFE_DIVIDE(SUM(e.ecommerce.tax_value_in_usd),
              SUM(e.ecommerce.purchase_revenue_in_usd)) AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e
JOIN UNNEST(e.items) AS item
WHERE e.event_name = 'purchase'
GROUP BY item.item_category
ORDER BY tax_rate DESC
LIMIT 20;
