Query:
-- 6) Average tax-rate by EACH item_category (highest at the top)
SELECT
  itm.item_category AS item_category,
  AVG(ecommerce.tax_value_in_usd / NULLIF(ecommerce.purchase_revenue_in_usd,0)) AS avg_tax_rate
