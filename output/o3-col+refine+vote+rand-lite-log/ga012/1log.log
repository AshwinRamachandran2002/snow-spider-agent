```sql
-- 1) Quick look at November-30 purchase events
SELECT
  event_timestamp,
  event_name,
  ecommerce
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
-- 2) Inspect the monetary fields inside the ecommerce STRUCT
SELECT
  ecommerce.purchase_revenue_in_usd,
  ecommerce.purchase_revenue,
  ecommerce.tax_value_in_usd,
  ecommerce.total_item_quantity,
  ecommerce.transaction_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
-- 3) See what item categories exist for purchase events
SELECT DISTINCT
  itm.item_category
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
UNNEST(items) AS itm
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
-- 4) Join the items array to the parent row and keep one line per event–item pair
SELECT
  ecommerce.transaction_id,
  itm.item_category,
  ecommerce.purchase_revenue_in_usd,
  ecommerce.tax_value_in_usd,
  ecommerce.tax_value_in_usd / NULLIF(ecommerce.purchase_revenue_in_usd,0) AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
UNNEST(items) AS itm
WHERE event_name = 'purchase'
LIMIT 20;
```

```sql
-- 5) Compute the tax-rate per purchase event (no UNNEST yet)
SELECT
  ecommerce.transaction_id,
  ecommerce.tax_value_in_usd / NULLIF(ecommerce.purchase_revenue_in_usd,0) AS tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`
WHERE event_name = 'purchase'
  AND ecommerce.purchase_revenue_in_usd > 0
LIMIT 20;
```

```sql
-- 6) Average tax-rate by EACH item_category (highest at the top)
SELECT
  itm.item_category AS item_category,
  AVG(ecommerce.tax_value_in_usd / NULLIF(ecommerce.purchase_revenue_in_usd,0)) AS avg_tax_rate
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
UNNEST(items) AS itm
WHERE event_name = 'purchase'
  AND ecommerce.purchase_revenue_in_usd > 0
GROUP BY item_category
ORDER BY avg_tax_rate DESC
LIMIT 20;
```

```sql
-- 7) Identify the single item_category with the HIGHEST avg tax-rate (top 1)
WITH ranked AS (
  SELECT
    itm.item_category,
    AVG(ecommerce.tax_value_in_usd / NULLIF(ecommerce.purchase_revenue_in_usd,0)) AS avg_tax_rate
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
  UNNEST(items) AS itm
  WHERE event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd > 0
  GROUP BY item_category
  ORDER BY avg_tax_rate DESC
  LIMIT 1
)
SELECT * FROM ranked;
```

```sql
-- 8) FINAL ANSWER: for purchase events in the top-tax-rate category,
-- return the transaction id, quantity, and both revenue metrics
WITH top_category AS (
  SELECT
    itm.item_category AS best_category
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
  UNNEST(items) AS itm
  WHERE event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd > 0
  GROUP BY best_category
  ORDER BY AVG(ecommerce.tax_value_in_usd / ecommerce.purchase_revenue_in_usd) DESC
  LIMIT 1
)
SELECT DISTINCT
  ecommerce.transaction_id,
  ecommerce.total_item_quantity,
  ecommerce.purchase_revenue_in_usd,
  ecommerce.purchase_revenue
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130`,
UNNEST(items) AS itm,
top_category
WHERE event_name = 'purchase'
  AND itm.item_category = top_category.best_category
LIMIT 20;
```

