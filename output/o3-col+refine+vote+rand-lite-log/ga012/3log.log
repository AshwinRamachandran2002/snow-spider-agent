Query:
--Description: Inspect the items array for purchases – see the item_category carried in each transaction  
SELECT
  e.`ecommerce`.transaction_id,
  i.item_category,
  i.item_name,
  i.quantity,
  i.price_in_usd
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` AS e,
     UNNEST(e.items) AS i
WHERE e.`event_name` = 'purchase'
LIMIT 20;
