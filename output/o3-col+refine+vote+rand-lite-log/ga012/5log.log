Query:
--Description: 5) Compute total revenue & tax by item category and rank them by the tax-to-revenue ratio  
SELECT  itm.`item_category`,
        SUM(t.`ecommerce`.`tax_value_in_usd`)        AS total_tax_usd,
        SUM(t.`ecommerce`.`purchase_revenue_in_usd`) AS total_rev_usd,
        SAFE_DIVIDE(SUM(t.`ecommerce`.`tax_value_in_usd`),
                    SUM(t.`ecommerce`.`purchase_revenue_in_usd`)) AS tax_rate
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` t
CROSS  JOIN UNNEST(t.`items`) AS itm
WHERE  t.`event_name` = 'purchase'
  AND  t.`ecommerce`.`purchase_revenue_in_usd` IS NOT NULL
GROUP  BY itm.`item_category`
ORDER  BY tax_rate DESC
LIMIT 20;
