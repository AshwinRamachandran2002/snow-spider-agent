```sql
--Description: Thinking Process ─────────────────────────────────────────────
-- 1. Goal: Find, for 30-Nov-2020, the item_category whose purchase events have
--    the greatest overall tax-to-revenue ratio, then list every purchase event
--    that contains at least one item from that category, returning its
--    transaction-level facts (ID, quantity, revenues).
-- 2. CTE top_cat:
--      • Unnests items for every purchase event.
--      • Aggregates total tax and total revenue per category.
--      • Orders by tax / revenue descending and keeps the single highest one.
-- 3. Main query:
--      • Unnests items again so each purchase event is paired with its
--        categories.
--      • Keeps rows whose category equals the top one (join to top_cat).
--      • Selects distinct transaction-level columns to avoid duplication when
--        multiple qualifying items exist in the same transaction.
-- 4. LIMIT 20 shown just for preview; remove or adjust for full result set.
WITH top_cat AS (
  SELECT itm.item_category AS cat
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` t
  CROSS  JOIN UNNEST(t.items) AS itm
  WHERE  t.event_name = 'purchase'
    AND  t.ecommerce.purchase_revenue_in_usd IS NOT NULL
  GROUP  BY cat
  ORDER  BY SAFE_DIVIDE(SUM(t.ecommerce.tax_value_in_usd),
                        SUM(t.ecommerce.purchase_revenue_in_usd)) DESC
  LIMIT 1
)
SELECT DISTINCT
       t.ecommerce.transaction_id        AS transaction_id,
       t.ecommerce.total_item_quantity   AS total_item_quantity,
       t.ecommerce.purchase_revenue_in_usd,
       t.ecommerce.purchase_revenue
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` t
CROSS  JOIN UNNEST(t.items) AS it
JOIN   top_cat
  ON   it.item_category = top_cat.cat
WHERE  t.event_name = 'purchase'
LIMIT 20;
