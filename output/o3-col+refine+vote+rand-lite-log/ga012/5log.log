WITH top_cat AS (                 -- derive the top tax-rate category
  SELECT itm.item_category AS cat
  FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` t
  CROSS  JOIN UNNEST(t.items) AS itm
  WHERE  t.event_name = 'purchase'
    AND  t.ecommerce.purchase_revenue_in_usd IS NOT NULL
  GROUP  BY cat
  ORDER  BY SAFE_DIVIDE(SUM(t.ecommerce.tax_value_in_usd),
                        SUM(t.ecommerce.purchase_revenue_in_usd)) DESC
  LIMIT 1
)

SELECT DISTINCT
       t.ecommerce.transaction_id      AS transaction_id,
       t.ecommerce.total_item_quantity AS total_item_quantity,
       t.ecommerce.purchase_revenue_in_usd,
       t.ecommerce.purchase_revenue
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201130` t
JOIN   top_cat ON TRUE                 -- simple join to make top_cat available
WHERE  t.event_name = 'purchase'
  AND  EXISTS (                        -- keep only events that contain the cat
        SELECT 1
        FROM   UNNEST(t.items) it
        WHERE  it.item_category = top_cat.cat
      )
LIMIT 20
