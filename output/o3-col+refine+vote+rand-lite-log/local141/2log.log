-- 6. Join the two aggregates to compare annual sales with annual quota.
SELECT  q."BusinessEntityID"               AS "SalesPersonID",
        q."Year",
        s."AnnualSales",
        q."AnnualQuota",
        (s."AnnualSales" - q."AnnualQuota") AS "Difference"
FROM   (
        SELECT  "BusinessEntityID",
                strftime('%Y',"QuotaDate") AS "Year",
                SUM("SalesQuota")          AS "AnnualQuota"
        FROM    "SalesPersonQuotaHistory"
        GROUP BY "BusinessEntityID", "Year"
       ) AS q
LEFT JOIN (
        SELECT  "salespersonid",
                strftime('%Y',"orderdate") AS "Year",
                SUM("totaldue")            AS "AnnualSales"
        FROM    "salesorderheader"
        GROUP BY "salespersonid", "Year"
       ) AS s
ON  q."BusinessEntityID" = s."salespersonid"
AND q."Year"            = s."Year"
LIMIT 20;
