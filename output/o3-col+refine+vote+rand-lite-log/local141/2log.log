```sql
--Description:  One‐shot query that supplies, for every salesperson and year,
--              his/her total sales, total sales-quota, and the difference.
--              Because SQLite lacks FULL OUTER JOIN, we emulate it:
--              • Build two CTEs – one for annual quotas (quota_cte) and one for annual sales (sales_cte).
--              • First SELECT = quota-side LEFT JOIN sales-side   (rows that have a quota record).
--              • Second SELECT = sales rows whose LEFT JOIN to quota is NULL (sales but no quota).
--              • UNION ALL of the two SELECTs gives the full set.
--              • COALESCE() turns missing values into 0 so the “Difference” arithmetic works.
WITH quota_cte AS (                    -- annual quota totals
        SELECT  "BusinessEntityID"      AS salesperson_id,
                strftime('%Y',"QuotaDate") AS yr,
                SUM("SalesQuota")       AS annual_quota
        FROM    "SalesPersonQuotaHistory"
        GROUP BY salesperson_id, yr
),
sales_cte AS (                         -- annual sales totals
        SELECT  "salespersonid"        AS salesperson_id,
                strftime('%Y',"orderdate") AS yr,
                SUM("totaldue")        AS annual_sales
        FROM    "salesorderheader"
        GROUP BY salesperson_id, yr
)
SELECT  COALESCE(q.salesperson_id, s.salesperson_id)   AS SalesPersonID,
        COALESCE(q.yr, s.yr)                           AS Year,
        COALESCE(s.annual_sales, 0.0)                  AS AnnualSales,
        COALESCE(q.annual_quota, 0.0)                  AS AnnualQuota,
        COALESCE(s.annual_sales, 0.0) -
        COALESCE(q.annual_quota, 0.0)                  AS Difference
FROM    quota_cte q
LEFT JOIN sales_cte s
       ON q.salesperson_id = s.salesperson_id
      AND q.yr            = s.yr

UNION ALL                                           -- add “sales-only” rows
SELECT  s.salesperson_id                            AS SalesPersonID,
        s.yr                                        AS Year,
        s.annual_sales                              AS AnnualSales,
        0.0                                         AS AnnualQuota,
        s.annual_sales                              AS Difference
FROM    sales_cte s
LEFT JOIN quota_cte q
       ON q.salesperson_id = s.salesperson_id
      AND q.yr            = s.yr
WHERE   q.salesperson_id IS NULL                    -- keep rows with no quota match

ORDER BY SalesPersonID, Year;
```
