        SELECT  s."salespersonid"                  AS "SalesPersonID",
                s."Year",
                s."AnnualSales",
                0.0                                AS "AnnualQuota",
                s."AnnualSales"                    AS "Difference"
        FROM   (
                SELECT  "salespersonid",
                        strftime('%Y',"orderdate") AS "Year",
                        SUM("totaldue")            AS "AnnualSales"
                FROM    "salesorderheader"
                GROUP BY "salespersonid", "Year"
               ) AS s
        LEFT JOIN "SalesPersonQuotaHistory" q2
              ON q2."BusinessEntityID"  = s."salespersonid"
             AND strftime('%Y',q2."QuotaDate") = s."Year"
        WHERE  q2."BusinessEntityID" IS NULL
)
WHERE   "Difference" > 0
ORDER BY "SalesPersonID", "Year"
LIMIT 20;
