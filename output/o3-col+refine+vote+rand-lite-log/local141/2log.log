```sql
-- 1. Take a first look at the quota history: who has quota records and what years appear?
SELECT DISTINCT "BusinessEntityID",
                strftime('%Y',"QuotaDate") AS "Year",
                "SalesQuota"
FROM "SalesPersonQuotaHistory"
ORDER BY "BusinessEntityID", "Year"
LIMIT 20;
```

```sql
-- 2. See which salespeople actually have sales orders recorded.
SELECT DISTINCT "salespersonid"
FROM "salesorderheader"
LIMIT 20;
```

```sql
-- 3. Inspect the years for which each salesperson has orders.
SELECT DISTINCT "salespersonid",
                strftime('%Y',"orderdate") AS "Year"
FROM "salesorderheader"
ORDER BY "salespersonid"
LIMIT 20;
```

```sql
-- 4. Aggregate monthly quotas into an annual quota for every salesperson-year pair.
SELECT  "BusinessEntityID",
        strftime('%Y',"QuotaDate") AS "Year",
        SUM("SalesQuota")          AS "AnnualQuota"
FROM    "SalesPersonQuotaHistory"
GROUP BY "BusinessEntityID", "Year"
LIMIT 20;
```

```sql
-- 5. Aggregate total sales (TotalDue) for every salesperson-year pair.
SELECT  "salespersonid",
        strftime('%Y',"orderdate") AS "Year",
        SUM("totaldue")            AS "AnnualSales"
FROM    "salesorderheader"
GROUP BY "salespersonid", "Year"
LIMIT 20;
```

```sql
-- 6. Join the two aggregates to compare annual sales with annual quota.
SELECT  q."BusinessEntityID"               AS "SalesPersonID",
        q."Year",
        s."AnnualSales",
        q."AnnualQuota",
        (s."AnnualSales" - q."AnnualQuota") AS "Difference"
FROM   (
        SELECT  "BusinessEntityID",
                strftime('%Y',"QuotaDate") AS "Year",
                SUM("SalesQuota")          AS "AnnualQuota"
        FROM    "SalesPersonQuotaHistory"
        GROUP BY "BusinessEntityID", "Year"
       ) AS q
LEFT JOIN (
        SELECT  "salespersonid",
                strftime('%Y',"orderdate") AS "Year",
                SUM("totaldue")            AS "AnnualSales"
        FROM    "salesorderheader"
        GROUP BY "salespersonid", "Year"
       ) AS s
ON  q."BusinessEntityID" = s."salespersonid"
AND q."Year"            = s."Year"
LIMIT 20;
```

```sql
-- 7. Identify years where a salesperson had sales but no quota (right-side unmatched).
SELECT  s."salespersonid" AS "SalesPersonID",
        s."Year",
        s."AnnualSales",
        0.0                AS "AnnualQuota",
        s."AnnualSales"    AS "Difference"
FROM   (
        SELECT  "salespersonid",
                strftime('%Y',"orderdate") AS "Year",
                SUM("totaldue")            AS "AnnualSales"
        FROM    "salesorderheader"
        GROUP BY "salespersonid", "Year"
       ) AS s
LEFT JOIN "SalesPersonQuotaHistory" q
      ON q."BusinessEntityID" = s."salespersonid"
     AND strftime('%Y',q."QuotaDate") = s."Year"
WHERE  q."BusinessEntityID" IS NULL
LIMIT 20;
```

```sql
-- 8. Bring the two result sets (queries 6 and 7) together for a full picture.
SELECT * FROM (
        /* query 6 */ 
        SELECT  q."BusinessEntityID"               AS "SalesPersonID",
                q."Year",
                s."AnnualSales",
                q."AnnualQuota",
                (s."AnnualSales" - q."AnnualQuota") AS "Difference"
        FROM   (
                SELECT  "BusinessEntityID",
                        strftime('%Y',"QuotaDate") AS "Year",
                        SUM("SalesQuota")          AS "AnnualQuota"
                FROM    "SalesPersonQuotaHistory"
                GROUP BY "BusinessEntityID", "Year"
               ) AS q
        LEFT JOIN (
                SELECT  "salespersonid",
                        strftime('%Y',"orderdate") AS "Year",
                        SUM("totaldue")            AS "AnnualSales"
                FROM    "salesorderheader"
                GROUP BY "salespersonid", "Year"
               ) AS s
        ON  q."BusinessEntityID" = s."salespersonid"
        AND q."Year"            = s."Year"
        
        UNION ALL
        
        /* query 7 */
        SELECT  s."salespersonid"                  AS "SalesPersonID",
                s."Year",
                s."AnnualSales",
                0.0                                AS "AnnualQuota",
                s."AnnualSales"                    AS "Difference"
        FROM   (
                SELECT  "salespersonid",
                        strftime('%Y',"orderdate") AS "Year",
                        SUM("totaldue")            AS "AnnualSales"
                FROM    "salesorderheader"
                GROUP BY "salespersonid", "Year"
               ) AS s
        LEFT JOIN "SalesPersonQuotaHistory" q2
              ON q2."BusinessEntityID"  = s."salespersonid"
             AND strftime('%Y',q2."QuotaDate") = s."Year"
        WHERE  q2."BusinessEntityID" IS NULL
) 
ORDER BY "SalesPersonID", "Year"
LIMIT 20;
```

```sql
-- 9. (Optional) Only show those salesperson-years where sales exceeded quota.
SELECT  *
FROM   (
        /* result of query 8 without LIMIT */
        SELECT  q."BusinessEntityID"               AS "SalesPersonID",
                q."Year",
                s."AnnualSales",
                q."AnnualQuota",
                (s."AnnualSales" - q."AnnualQuota") AS "Difference"
        FROM   (
                SELECT  "BusinessEntityID",
                        strftime('%Y',"QuotaDate") AS "Year",
                        SUM("SalesQuota")          AS "AnnualQuota"
                FROM    "SalesPersonQuotaHistory"
                GROUP BY "BusinessEntityID", "Year"
               ) AS q
        LEFT JOIN (
                SELECT  "salespersonid",
                        strftime('%Y',"orderdate") AS "Year",
                        SUM("totaldue")            AS "AnnualSales"
                FROM    "salesorderheader"
                GROUP BY "salespersonid", "Year"
               ) AS s
        ON  q."BusinessEntityID" = s."salespersonid"
        AND q."Year"            = s."Year"
        
        UNION ALL
        
        SELECT  s."salespersonid"                  AS "SalesPersonID",
                s."Year",
                s."AnnualSales",
                0.0                                AS "AnnualQuota",
                s."AnnualSales"                    AS "Difference"
        FROM   (
                SELECT  "salespersonid",
                        strftime('%Y',"orderdate") AS "Year",
                        SUM("totaldue")            AS "AnnualSales"
                FROM    "salesorderheader"
                GROUP BY "salespersonid", "Year"
               ) AS s
        LEFT JOIN "SalesPersonQuotaHistory" q2
              ON q2."BusinessEntityID"  = s."salespersonid"
             AND strftime('%Y',q2."QuotaDate") = s."Year"
        WHERE  q2."BusinessEntityID" IS NULL
)
WHERE   "Difference" > 0
ORDER BY "SalesPersonID", "Year"
LIMIT 20;
```

```sql
-- 10. (Final answer) Full, unconstrained list (remove LIMIT) of every salesperson-year
--      with annual sales, annual quota, and the difference (sales – quota).
SELECT  q."BusinessEntityID"               AS "SalesPersonID",
        q."Year",
        COALESCE(s."AnnualSales",0.0)      AS "AnnualSales",
        COALESCE(q."AnnualQuota",0.0)      AS "AnnualQuota",
        (COALESCE(s."AnnualSales",0.0) -
         COALESCE(q."AnnualQuota",0.0))    AS "Difference"
FROM   (
        SELECT  "BusinessEntityID",
                strftime('%Y',"QuotaDate") AS "Year",
                SUM("SalesQuota")          AS "AnnualQuota"
        FROM    "SalesPersonQuotaHistory"
        GROUP BY "BusinessEntityID", "Year"
       ) AS q
FULL OUTER JOIN (
        SELECT  "salespersonid",
                strftime('%Y',"orderdate") AS "Year",
                SUM("totaldue")            AS "AnnualSales"
        FROM    "salesorderheader"
        GROUP BY "salespersonid", "Year"
       ) AS s
ON  q."BusinessEntityID" = s."salespersonid"
AND q."Year"            = s."Year"
ORDER BY "SalesPersonID", "Year";
```
