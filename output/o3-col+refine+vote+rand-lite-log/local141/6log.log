Query:
--Description: Corrected version of original “#9” that emulates FULL OUTER JOIN with
--             UNION ALL (so it works in SQLite) and also calculates the difference
--             for every row.  A WITH-clause builds annual quota and sales sets once,
--             then assembles them; finally returns only 20 rows as the exploratory
--             sample that the original #9 intended.
WITH
quota AS (
    SELECT
        BusinessEntityID,
        substr(QuotaDate,1,4)        AS year,
        SUM(SalesQuota)              AS annual_quota
    FROM SalesPersonQuotaHistory
    GROUP BY BusinessEntityID, substr(QuotaDate,1,4)
),
sales AS (
    SELECT
        salespersonid                AS BusinessEntityID,
        substr(orderdate,1,4)        AS year,
        SUM(totaldue)                AS annual_sales
    FROM salesorderheader
    WHERE salespersonid IS NOT NULL
    GROUP BY salespersonid, substr(orderdate,1,4)
),
full AS (
    /* quota years (keep even if no sales) */
    SELECT
        q.BusinessEntityID,
        q.year,
        s.annual_sales,
        q.annual_quota
    FROM quota q
    LEFT JOIN sales s
      ON s.BusinessEntityID = q.BusinessEntityID
     AND s.year             = q.year

    UNION ALL

    /* sales years with no quota */
    SELECT
        s.BusinessEntityID,
        s.year,
        s.annual_sales,
        NULL AS annual_quota
    FROM sales s
    LEFT JOIN quota q
      ON q.BusinessEntityID = s.BusinessEntityID
     AND q.year             = s.year
    WHERE q.BusinessEntityID IS NULL
)
SELECT
    BusinessEntityID,
    year,
    annual_sales,
    annual_quota,
    COALESCE(annual_sales,0) - COALESCE(annual_quota,0) AS sales_minus_quota
FROM full
ORDER BY BusinessEntityID, year
LIMIT 20
