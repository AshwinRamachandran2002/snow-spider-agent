```sql
--Description:
-- Goal: show, for every salesperson and calendar year, how their TotalDue sales compare
--       to their summed annual sales quota (SalesQuota).  Because SQLite lacks FULL OUTER
--       JOIN we emulate it by UNION-ing:
--          1) quota-years (LEFT JOINed to any matching sales)           → keeps rows that
--             have a quota even if sales are absent.                    q LEFT JOIN s
--          2) sales-years that lack a quota (identified via LEFT JOIN)  → keeps rows that
--             have sales but no quota.                                  s LEFT JOIN q
--       COALESCE() converts missing values to 0 so the subtraction works in every case.
WITH
/* annual quota per salesperson & year */
quota AS (
    SELECT
        BusinessEntityID,
        substr(QuotaDate,1,4)        AS year,
        SUM(SalesQuota)              AS annual_quota
    FROM SalesPersonQuotaHistory
    GROUP BY BusinessEntityID, substr(QuotaDate,1,4)
),
/* annual sales per salesperson & year */
sales AS (
    SELECT
        salespersonid                AS BusinessEntityID,
        substr(orderdate,1,4)        AS year,
        SUM(totaldue)                AS annual_sales
    FROM salesorderheader
    WHERE salespersonid IS NOT NULL
    GROUP BY salespersonid, substr(orderdate,1,4)
),
/* emulate FULL OUTER JOIN */
full AS (
    -- Part-A: all quota rows (with or without matching sales)
    SELECT
        q.BusinessEntityID,
        q.year,
        s.annual_sales,
        q.annual_quota
    FROM quota q
    LEFT JOIN sales s
      ON s.BusinessEntityID = q.BusinessEntityID
     AND s.year             = q.year

    UNION ALL

    -- Part-B: sales rows with no quota
    SELECT
        s.BusinessEntityID,
        s.year,
        s.annual_sales,
        NULL                 AS annual_quota
    FROM sales s
    LEFT JOIN quota q
      ON q.BusinessEntityID = s.BusinessEntityID
     AND q.year             = s.year
    WHERE q.BusinessEntityID IS NULL
)
SELECT
    BusinessEntityID,
    year,
    annual_sales,
    annual_quota,
    COALESCE(annual_sales,0) - COALESCE(annual_quota,0) AS sales_minus_quota
FROM full
ORDER BY BusinessEntityID, year;
```
