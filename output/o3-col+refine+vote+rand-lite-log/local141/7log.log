```sql
-- 1) Distinct salespeople that have a quota history
SELECT DISTINCT "BusinessEntityID"
FROM "SalesPersonQuotaHistory"
LIMIT 20;
```

```sql
-- 2) Distinct years (first 4 characters) that appear in the quota history
SELECT DISTINCT SUBSTR("QuotaDate",1,4) AS "year"
FROM "SalesPersonQuotaHistory"
LIMIT 20;
```

```sql
-- 3) Distinct salespeople that actually sold something (appear in SalesOrderHeader)
SELECT DISTINCT "salespersonid"
FROM "salesorderheader"
WHERE "salespersonid" IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Inspect sample sales orders: salesperson, order date, subtotal, total due
SELECT "salesorderid",
       "salespersonid",
       "orderdate",
       "subtotal",
       "totaldue"
FROM "salesorderheader"
WHERE "salespersonid" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Annual total sales (using SubTotal) for every salesperson & year
SELECT "salespersonid",
       SUBSTR("orderdate",1,4) AS "year",
       SUM("subtotal")         AS "annual_sales"
FROM   "salesorderheader"
WHERE  "salespersonid" IS NOT NULL
GROUP  BY "salespersonid", SUBSTR("orderdate",1,4)
LIMIT 20;
```

```sql
-- 6) Annual quota (sum of SalesQuota entries) for every salesperson & year
SELECT "BusinessEntityID"                    AS "salespersonid",
       SUBSTR("QuotaDate",1,4)               AS "year",
       SUM("SalesQuota")                     AS "annual_quota"
FROM   "SalesPersonQuotaHistory"
GROUP  BY "BusinessEntityID", SUBSTR("QuotaDate",1,4)
LIMIT 20;
```

```sql
-- 7) Combine annual sales with annual quotas to see both side-by-side
SELECT s."salespersonid",
       s."year",
       s."annual_sales",
       q."annual_quota"
FROM (
        SELECT "salespersonid",
               SUBSTR("orderdate",1,4) AS "year",
               SUM("subtotal")         AS "annual_sales"
        FROM   "salesorderheader"
        WHERE  "salespersonid" IS NOT NULL
        GROUP  BY "salespersonid", SUBSTR("orderdate",1,4)
     ) AS s
LEFT JOIN (
        SELECT "BusinessEntityID"      AS "salespersonid",
               SUBSTR("QuotaDate",1,4) AS "year",
               SUM("SalesQuota")       AS "annual_quota"
        FROM   "SalesPersonQuotaHistory"
        GROUP  BY "BusinessEntityID", SUBSTR("QuotaDate",1,4)
     ) AS q
ON  s."salespersonid" = q."salespersonid"
AND s."year"          = q."year"
LIMIT 20;
```

```sql
-- 8) Show the difference (sales minus quota) for each salesperson & year
SELECT s."salespersonid",
       s."year",
       s."annual_sales"               AS "total_sales",
       COALESCE(q."annual_quota",0)   AS "total_quota",
       s."annual_sales" - COALESCE(q."annual_quota",0) AS "sales_minus_quota"
FROM (
        SELECT "salespersonid",
               SUBSTR("orderdate",1,4) AS "year",
               SUM("subtotal")         AS "annual_sales"
        FROM   "salesorderheader"
        WHERE  "salespersonid" IS NOT NULL
        GROUP  BY "salespersonid", SUBSTR("orderdate",1,4)
     ) AS s
LEFT JOIN (
        SELECT "BusinessEntityID"      AS "salespersonid",
               SUBSTR("QuotaDate",1,4) AS "year",
               SUM("SalesQuota")       AS "annual_quota"
        FROM   "SalesPersonQuotaHistory"
        GROUP  BY "BusinessEntityID", SUBSTR("QuotaDate",1,4)
     ) AS q
ON  s."salespersonid" = q."salespersonid"
AND s."year"          = q."year"
LIMIT 20;
```

```sql
-- 9) Focus on a single salesperson (e.g., ID 274) to inspect yearly detail
SELECT s."salespersonid",
       s."year",
       s."annual_sales",
       COALESCE(q."annual_quota",0) AS "annual_quota",
       s."annual_sales" - COALESCE(q."annual_quota",0) AS "sales_minus_quota"
FROM (
        SELECT "salespersonid",
               SUBSTR("orderdate",1,4) AS "year",
               SUM("subtotal")         AS "annual_sales"
        FROM   "salesorderheader"
        WHERE  "salespersonid" = 274
        GROUP  BY "salespersonid", SUBSTR("orderdate",1,4)
     ) AS s
LEFT JOIN (
        SELECT "BusinessEntityID"      AS "salespersonid",
               SUBSTR("QuotaDate",1,4) AS "year",
               SUM("SalesQuota")       AS "annual_quota"
        FROM   "SalesPersonQuotaHistory"
        WHERE  "BusinessEntityID" = 274
        GROUP  BY "BusinessEntityID", SUBSTR("QuotaDate",1,4)
     ) AS q
ON  s."salespersonid" = q."salespersonid"
AND s."year"          = q."year"
LIMIT 20;
```

```sql
-- 10) Final report ordered neatly by salesperson then year
SELECT s."salespersonid",
       s."year",
       s."annual_sales"               AS "total_sales",
       COALESCE(q."annual_quota",0)   AS "total_quota",
       s."annual_sales" - COALESCE(q."annual_quota",0) AS "sales_minus_quota"
FROM (
        SELECT "salespersonid",
               SUBSTR("orderdate",1,4) AS "year",
               SUM("subtotal")         AS "annual_sales"
        FROM   "salesorderheader"
