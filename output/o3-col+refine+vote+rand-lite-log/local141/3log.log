```sql
--Description: Identify salesperson-year pairs that exist in only one data source (sales totals or quotas).
-- Strategy:
--   1. Build CTE “s” – yearly SubTotal per salesperson from SalesOrderHeader.
--   2. Build CTE “q” – yearly SalesQuota per salesperson from SalesPersonQuotaHistory.
--   3. Because SQLite lacks FULL OUTER JOIN, emulate it by:
--        a) taking (s LEFT JOIN q) and keeping rows where q is NULL  → sales without quota.
--        b) UNION with (q LEFT JOIN s) where s is NULL               → quota without sales.
--   4. Return the combined set, ordered for easy reading, limited to 20 rows for preview.
WITH
    s AS (
        SELECT salespersonid,
               strftime('%Y', orderdate) AS yr,
               SUM(subtotal)             AS total_sales
        FROM salesorderheader
        GROUP BY salespersonid, yr
    ),
    q AS (
        SELECT BusinessEntityID          AS salespersonid,
               strftime('%Y', QuotaDate) AS yr,
               SUM(SalesQuota)           AS annual_quota
        FROM SalesPersonQuotaHistory
        GROUP BY salespersonid, yr
    )
SELECT s.salespersonid,
       s.yr             AS year,
       s.total_sales,
       NULL             AS annual_quota
FROM s
LEFT JOIN q
  ON s.salespersonid = q.salespersonid
 AND s.yr            = q.yr
WHERE q.annual_quota IS NULL

UNION

SELECT q.salespersonid,
       q.yr             AS year,
       NULL             AS total_sales,
       q.annual_quota
FROM q
LEFT JOIN s
  ON q.salespersonid = s.salespersonid
 AND q.yr            = s.yr
WHERE s.total_sales IS NULL

ORDER BY salespersonid, year
LIMIT 20;
```
