--Description: Final report showing, for each salesperson and year, total sales, annual quota, and the difference.
--             Uses two derived tables: “soh” aggregates yearly SubTotal from SalesOrderHeader,
--             “q” aggregates yearly SalesQuota from SalesPersonQuotaHistory.
--             Joining on salesperson + year lets us compare the two amounts.
--             ORDER BY now references columns exposed in the SELECT list (soh.salespersonid, soh.so_year).
SELECT 
       soh.salespersonid                AS "Salesperson_ID",
       soh.so_year                      AS "Year",
       ROUND(soh.total_sales,   2)      AS "Total_Sales",
       ROUND(q.annual_quota,   2)       AS "Annual_Quota",
       ROUND(soh.total_sales - q.annual_quota, 2) AS "Sales_minus_Quota"
FROM (
        SELECT salespersonid,
               strftime('%Y', orderdate) AS so_year,
               SUM(subtotal)             AS total_sales
        FROM salesorderheader
        GROUP BY salespersonid, so_year
     ) AS soh
JOIN (
        SELECT BusinessEntityID          AS salespersonid,
               strftime('%Y', QuotaDate) AS quota_year,
               SUM(SalesQuota)           AS annual_quota
        FROM SalesPersonQuotaHistory
        GROUP BY salespersonid, quota_year
     ) AS q
  ON soh.salespersonid = q.salespersonid
 AND soh.so_year       = q.quota_year
ORDER BY soh.salespersonid, soh.so_year
LIMIT 20;
