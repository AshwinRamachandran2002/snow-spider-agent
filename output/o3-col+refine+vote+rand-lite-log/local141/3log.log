```sql
--Description: We need salesperson–year combinations that appear in only one dataset
--             (either in annual sales totals or in annual quota totals).
--             Because SQLite lacks FULL OUTER JOIN, we:
--                 1) Aggregate yearly sales (CTE s)
--                 2) Aggregate yearly quotas (CTE q)
--                 3) Take rows in s with no counterpart in q  (sales w/o quota)
--                 4) UNION those with rows in q with no counterpart in s (quota w/o sales)
--             The unified result reveals any “missing-side” situations.
WITH
    s AS (  -- yearly sales totals
        SELECT salespersonid,
               strftime('%Y', orderdate) AS yr,
               SUM(subtotal)             AS total_sales
        FROM salesorderheader
        GROUP BY salespersonid, yr
    ),
    q AS (  -- yearly quota totals
        SELECT BusinessEntityID          AS salespersonid,
               strftime('%Y', QuotaDate) AS yr,
               SUM(SalesQuota)           AS annual_quota
        FROM SalesPersonQuotaHistory
        GROUP BY salespersonid, yr
    ),
    missing AS (
        ----------------------------------------------------
        -- sales present but quota absent
        ----------------------------------------------------
        SELECT s.salespersonid,
               s.yr               AS year,
               s.total_sales,
               NULL               AS annual_quota
        FROM s
        LEFT JOIN q
          ON s.salespersonid = q.salespersonid
         AND s.yr            = q.yr
        WHERE q.annual_quota IS NULL

        UNION

        ----------------------------------------------------
        -- quota present but sales absent
        ----------------------------------------------------
        SELECT q.salespersonid,
               q.yr               AS year,
               NULL               AS total_sales,
               q.annual_quota
        FROM q
        LEFT JOIN s
          ON q.salespersonid = s.salespersonid
         AND q.yr            = s.yr
        WHERE s.total_sales IS NULL
    )
SELECT *
FROM missing
ORDER BY salespersonid, year
LIMIT 20;
```
