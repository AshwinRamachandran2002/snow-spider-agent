--Description: 1) Inspect the available “DATE” values in RETAIL_ANALYTICS_SALES for the Manufacturing distributor view around our target window (30 days before 06-Feb-2022).  
SELECT DISTINCT 
       "DATE"
FROM   "AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET"."PUBLIC"."RETAIL_ANALYTICS_SALES"
