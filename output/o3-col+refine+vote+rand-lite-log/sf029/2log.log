```sql
--Description / Thinking process:
-- Build the final 30-day daily report (08-Jan-2022 to 06-Feb-2022) for the ‘Manufacturing’
-- distributor view by joining the four required source tables on DATE & ASIN, then aggregating
-- per DAY & ASIN.  Metrics:
--   • Totals: ordered units/revenue, shipped units/revenue, glance views
--   • Rates:  ASP (ordered revenue ÷ ordered units), conversion rate, avg NET_PPM,
--             avg procurable OOS, avg vendor confirmation, receive fill, sell-through,
--             vendor lead time
--   • Stock:  total on-hand units (= sellable + unsellable), on-hand value (ASP*units),
--             net-received units/value, open PO qty, unfilled customer ordered units
-- Steps:
--   1. Join SALES (s) ↔ TRAFFIC (t) on DATE, ASIN, PROGRAM, PERIOD, DISTRIBUTOR_VIEW.
--   2. Join INVENTORY (i) to that set on DATE & ASIN (Manufacturing only).
--   3. Left-join NET_PPM (n) for additional profitability metric.
--   4. Aggregate with SUM / AVG as appropriate.
SELECT
        s."DATE"                                                AS "DATE",
        s."ASIN"                                                AS "ASIN",

        /* ───── Sales & Traffic aggregates ───── */
        SUM(s."ORDERED_UNITS")                                  AS "TOTAL_ORDERED_UNITS",
        SUM(s."ORDERED_REVENUE")                                AS "ORDERED_REVENUE",
        CASE WHEN SUM(s."ORDERED_UNITS") = 0 THEN NULL
             ELSE SUM(s."ORDERED_REVENUE") / SUM(s."ORDERED_UNITS") END
                                                               AS "AVG_SELLING_PRICE",
        SUM(t."GLANCE_VIEWS")                                   AS "GLANCE_VIEWS",
        CASE WHEN SUM(t."GLANCE_VIEWS") = 0 THEN NULL
             ELSE SUM(s."ORDERED_UNITS") / SUM(t."GLANCE_VIEWS") END
                                                               AS "CONVERSION_RATE",
        SUM(s."SHIPPED_UNITS")                                  AS "SHIPPED_UNITS",
        SUM(s."SHIPPED_REVENUE")                                AS "SHIPPED_REVENUE",

        /* ───── Profitability & Inventory averages ───── */
        AVG(n."NET_PPM")                                        AS "AVG_NET_PPM",
        AVG(i."PROCURABLE_PRODUCT_OOS")                         AS "AVG_PROCURABLE_PRODUCT_OOS",

        /* ───── Stock levels ───── */
        SUM(i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS")
                                                               AS "TOTAL_ON_HAND_UNITS",
        /* on-hand value uses ASP multiplied by summed on-hand units */
        CASE WHEN SUM(s."ORDERED_UNITS") = 0 THEN NULL
             ELSE (SUM(s."ORDERED_REVENUE") / SUM(s."ORDERED_UNITS"))
                  * SUM(i."SELLABLE_ON_HAND_UNITS" + i."UNSELLABLE_ON_HAND_UNITS") END
                                                               AS "ON_HAND_VALUE",
        SUM(i."NET_RECEIVED_UNITS")                             AS "NET_RECEIVED_UNITS",
        CASE WHEN SUM(s."ORDERED_UNITS") = 0 THEN NULL
             ELSE (SUM(s."ORDERED_REVENUE") / SUM(s."ORDERED_UNITS"))
                  * SUM(i."NET_RECEIVED_UNITS") END             AS "NET_RECEIVED_VALUE",
        SUM(i."OPEN_PURCHASE_ORDER_QUANTITY")                   AS "OPEN_PO_QUANTITY",
        SUM(i."UNFILLED_CUSTOMER_ORDERED_UNITS")                AS "UNFILLED_CUSTOMER_ORDERED_UNITS",

        /* ───── Supplier / performance averages ───── */
        AVG(i."VENDOR_CONFIRMATION_RATE")                       AS "AVG_VENDOR_CONFIRMATION_RATE",
        AVG(i."RECEIVE_FILL_RATE")                              AS "AVG_RECEIVE_FILL_RATE",
        AVG(i."SELL_THROUGH_RATE")                              AS "AVG_SELL_THROUGH_RATE",
        AVG(i."OVERALL_VENDOR_LEAD_TIME_DAYS")                  AS "AVG_VENDOR_LEAD_TIME_DAYS"
FROM    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"    s
JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC"  t
       ON  s."DATE"            = t."DATE"
      AND  s."ASIN"            = t."ASIN"
      AND  s."PROGRAM"         = t."PROGRAM"
      AND  s."PERIOD"          = t."PERIOD"
      AND  s."DISTRIBUTOR_VIEW"= t."DISTRIBUTOR_VIEW"

JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON  s."DATE"            = i."DATE"
      AND  s."ASIN"            = i."ASIN"
      AND  i."DISTRIBUTOR_VIEW"= 'Manufacturing'

LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" n
       ON  s."DATE"            = n."DATE"
      AND  s."ASIN"            = n."ASIN"
      AND  n."DISTRIBUTOR_VIEW"= 'Manufacturing'

WHERE   s."DISTRIBUTOR_VIEW"   = 'Manufacturing'
  AND   s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
  AND   s."PERIOD" = 'DAILY'  -- ensure daily granularity across tables
GROUP BY
        s."DATE",
        s."ASIN"
ORDER BY
        s."DATE",
        s."ASIN"
LIMIT 20;
```
