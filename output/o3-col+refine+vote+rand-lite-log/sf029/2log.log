Query:
--Description: 7) Bring in inventory metrics (on-hand units, PO quantities, etc.) with the previous join.
SELECT  st."DATE",
        st."ASIN",
        st."ORDERED_UNITS",
        st."ORDERED_REVENUE",
        st."SHIPPED_UNITS",
        st."SHIPPED_REVENUE",
        st."GLANCE_VIEWS",
        i."SELLABLE_ON_HAND_UNITS"        AS "ON_HAND_UNITS",
        i."UNSELLABLE_ON_HAND_UNITS"      AS "UNSELLABLE_UNITS",
        i."OPEN_PURCHASE_ORDER_QUANTITY"  AS "PO_QTY",
        i."UNFILLED_CUSTOMER_ORDERED_UNITS"
FROM   (
        SELECT  s."DATE",
                s."ASIN",
                s."ORDERED_UNITS",
                s."ORDERED_REVENUE",
                s."SHIPPED_UNITS",
                s."SHIPPED_REVENUE",
                t."GLANCE_VIEWS"
        FROM    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
        JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
          ON    s."DATE"            = t."DATE"
         AND    s."ASIN"            = t."ASIN"
         AND    s."PROGRAM"         = t."PROGRAM"
         AND    s."PERIOD"          = t."PERIOD"
         AND    s."DISTRIBUTOR_VIEW"= t."DISTRIBUTOR_VIEW"
        WHERE   s."DISTRIBUTOR_VIEW" = 'Manufacturing'
          AND   s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
      ) st
JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
   ON   st."DATE"           = i."DATE"
  AND   st."ASIN"           = i."ASIN"
  AND   i."DISTRIBUTOR_VIEW"= 'Manufacturing'
LIMIT 20;
Answer:
DATE,ASIN,ORDERED_UNITS,ORDERED_REVENUE,SHIPPED_UNITS,SHIPPED_REVENUE,GLANCE_VIEWS,ON_HAND_UNITS,UNSELLABLE_UNITS,PO_QTY,UNFILLED_CUSTOMER_ORDERED_UNITS
