--Description: 10)  Produce the final daily detailed report by joining the aggregated
--               result from query #9 (alias d) with INVENTORY for additional fields
--               not rolled-up in #9, then compute financial values based on ASP.
SELECT  d."DATE",
        d."ASIN",

        /* ------------ demand ------------ */
        d."TOTAL_ORDERED_UNITS",
        d."TOTAL_ORDERED_REV"                     AS "ORDERED_REVENUE",
        d."ASP"                                   AS "AVG_SELLING_PRICE",
        d."GLANCE_VIEWS",
        d."CONVERSION_RATE",

        /* ------------ fulfilment ------------ */
        d."SHIPPED_UNITS",
        d."SHIPPED_REVENUE",

        /* ------------ profitability & OOS ------------ */
        d."AVG_NET_PPM",
        inv."PROCURABLE_PRODUCT_OOS"              AS "AVG_PROCURABLE_PRODUCT_OOS",

        /* ------------ inventory values ------------ */
        d."TOTAL_ON_HAND_UNITS",
        d."TOTAL_ON_HAND_UNITS" * d."ASP"         AS "ON_HAND_VALUE",

        inv."NET_RECEIVED_UNITS",
        inv."NET_RECEIVED_UNITS" * d."ASP"        AS "NET_RECEIVED_VALUE",

        d."OPEN_PO_QTY"                           AS "OPEN_PURCHASE_ORDER_QUANTITY",
        d."UNFILLED_UNITS"                        AS "UNFILLED_CUSTOMER_ORDERED_UNITS",

        /* ------------ supplier metrics ------------ */
        d."AVG_VENDOR_CONFIRMATION_RATE",
        d."AVG_RECEIVE_FILL_RATE",
        d."AVG_VENDOR_LEAD_TIME"

FROM  ( /* === query #9 without LIMIT === */ ) d
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" inv
       ON  d."DATE" = inv."DATE"
      AND d."ASIN"  = inv."ASIN"
      AND inv."DISTRIBUTOR_VIEW" = 'Manufacturing'
WHERE d."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
ORDER BY d."DATE", d."ASIN"
LIMIT 20;
