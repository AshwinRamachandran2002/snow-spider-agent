```sql
--Description: 6) Join sales and traffic to get Ordered Units, Ordered Revenue, Shipped Units, Shipped Revenue, and Glance Views.
SELECT  s."DATE",
        s."ASIN",
        s."ORDERED_UNITS",
        s."ORDERED_REVENUE",
        s."SHIPPED_UNITS",
        s."SHIPPED_REVENUE",
        t."GLANCE_VIEWS"
FROM    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
      ON  s."DATE"            = t."DATE"
     AND s."ASIN"             = t."ASIN"
     AND s."PROGRAM"          = t."PROGRAM"
     AND s."PERIOD"           = t."PERIOD"
     AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE   s."DISTRIBUTOR_VIEW"  = 'Manufacturing'
  AND   s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
LIMIT 20;
```

```sql
--Description: 7) Bring in inventory metrics (on-hand units, PO quantities, etc.) with the previous join.
SELECT  st."DATE",
        st."ASIN",
        st."ORDERED_UNITS",
        st."ORDERED_REVENUE",
        st."SHIPPED_UNITS",
        st."SHIPPED_REVENUE",
        st."GLANCE_VIEWS",
        i."SELLABLE_ON_HAND_UNITS"        AS "ON_HAND_UNITS",
        i."UNSELLABLE_ON_HAND_UNITS"      AS "UNSELLABLE_UNITS",
        i."OPEN_PURCHASE_ORDER_QUANTITY"  AS "PO_QTY",
        i."UNFILLED_CUSTOMER_ORDERED_UNITS"
FROM   (
        SELECT  s."DATE",
                s."ASIN",
                s."ORDERED_UNITS",
                s."ORDERED_REVENUE",
                s."SHIPPED_UNITS",
                s."SHIPPED_REVENUE",
                t."GLANCE_VIEWS"
        FROM    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
        JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
          ON    s."DATE"            = t."DATE"
         AND    s."ASIN"            = t."ASIN"
         AND    s."PROGRAM"         = t."PROGRAM"
         AND    s."PERIOD"          = t."PERIOD"
         AND    s."DISTRIBUTOR_VIEW"= t."DISTRIBUTOR_VIEW"
        WHERE   s."DISTRIBUTOR_VIEW" = 'Manufacturing'
          AND   s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
      ) st
JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
   ON   st."DATE"           = i."DATE"
  AND   st."ASIN"           = i."ASIN"
  AND   i."DISTRIBUTOR_VIEW"= 'Manufacturing'
LIMIT 20;
```

```sql
--Description: 8) Add NET_PPM and supplier metrics (confirmation rate, fill rate, lead time) to the join.
SELECT  si."DATE",
        si."ASIN",
        si."ORDERED_UNITS",
        si."ORDERED_REVENUE",
        si."SHIPPED_UNITS",
        si."SHIPPED_REVENUE",
        si."GLANCE_VIEWS",
        si."ON_HAND_UNITS",
        si."UNSELLABLE_UNITS",
        si."PO_QTY",
        si."UNFILLED_CUSTOMER_ORDERED_UNITS",
        n."NET_PPM",
        i."VENDOR_CONFIRMATION_RATE",
        i."RECEIVE_FILL_RATE",
        i."OVERALL_VENDOR_LEAD_TIME_DAYS"
FROM  (
        /* previous sales-traffic-inventory join */
        SELECT  st."DATE",
                st."ASIN",
                st."ORDERED_UNITS",
                st."ORDERED_REVENUE",
                st."SHIPPED_UNITS",
                st."SHIPPED_REVENUE",
                st."GLANCE_VIEWS",
                i."SELLABLE_ON_HAND_UNITS"   AS "ON_HAND_UNITS",
                i."UNSELLABLE_ON_HAND_UNITS" AS "UNSELLABLE_UNITS",
                i."OPEN_PURCHASE_ORDER_QUANTITY" AS "PO_QTY",
                i."UNFILLED_CUSTOMER_ORDERED_UNITS"
        FROM   (
                SELECT  s."DATE",
                        s."ASIN",
                        s."ORDERED_UNITS",
                        s."ORDERED_REVENUE",
                        s."SHIPPED_UNITS",
                        s."SHIPPED_REVENUE",
                        t."GLANCE_VIEWS"
                FROM    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
                JOIN    AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
                  ON    s."DATE"            = t."DATE"
                 AND    s."ASIN"            = t."ASIN"
                 AND    s."PROGRAM"         = t."PROGRAM"
                 AND    s."PERIOD"          = t."PERIOD"
                 AND    s."DISTRIBUTOR_VIEW"= t."DISTRIBUTOR_VIEW"
                WHERE   s."DISTRIBUTOR_VIEW" = 'Manufacturing'
                  AND   s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
              ) st
        JOIN  AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
          ON  st."DATE"           = i."DATE"
         AND  st."ASIN"           = i."ASIN"
         AND  i."DISTRIBUTOR_VIEW"= 'Manufacturing'
      ) si
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" n
       ON si."DATE" = n."DATE"
      AND si."ASIN" = n."ASIN"
      AND n."DISTRIBUTOR_VIEW" = 'Manufacturing'
LIMIT 20;
```

```sql
--Description: 9) Aggregate the joined data by DATE & ASIN to compute rates such as Conversion Rate and Average Selling Price (ASP).
SELECT  j."DATE",
        j."ASIN",
        SUM(j."ORDERED_UNITS")        AS "TOTAL_ORDERED_UNITS",
        SUM(j."ORDERED_REVENUE")      AS "TOTAL_ORDERED_REV",
        CASE WHEN SUM(j."ORDERED_UNITS") = 0 THEN NULL
             ELSE SUM(j."ORDERED_REVENUE")/SUM(j."ORDERED_UNITS") END AS "ASP",
        SUM(j."GLANCE_VIEWS")         AS "GLANCE_VIEWS",
        CASE WHEN SUM(j."GLANCE_VIEWS") = 0 THEN NULL
             ELSE SUM(j."ORDERED_UNITS")/SUM(j."GLANCE_VIEWS") END    AS "CONVERSION_RATE",
        SUM(j."SHIPPED_UNITS")        AS "SHIPPED_UNITS",
        SUM(j."SHIPPED_REVENUE")      AS "SHIPPED_REVENUE",
        AVG(j."NET_PPM")              AS "AVG_NET_PPM",
        AVG(j."ON_HAND_UNITS" + j."UNSELLABLE_UNITS") AS "TOTAL_ON_HAND_UNITS",
        AVG(j."PO_QTY")               AS "OPEN_PO_QTY",
        AVG(j."UNFILLED_CUSTOMER_ORDERED_UNITS") AS "UNFILLED_UNITS",
        AVG(j."VENDOR_CONFIRMATION_RATE") AS "AVG_VENDOR_CONFIRMATION_RATE",
        AVG(j."RECEIVE_FILL_RATE")        AS "AVG_RECEIVE_FILL_RATE",
        AVG(j."OVERALL_VENDOR_LEAD_TIME_DAYS") AS "AVG_VENDOR_LEAD_TIME"
FROM  ( /* use query #8 without LIMIT */ 
       /* place query #8 here but without LIMIT for production */
      ) j
GROUP BY j."DATE", j."ASIN"
LIMIT 20;
```

```sql
--Description: 10) Produce the final daily detailed sales report for the period, joining all four datasets and calculating every requested metric.
SELECT  d."DATE",
        d."ASIN",
        d."TOTAL_ORDERED_UNITS",
        d."TOTAL_ORDERED_REV"                        AS "ORDERED_REVENUE",
        d."ASP"                                      AS "AVG_SELLING_PRICE",
        d."GLANCE_VIEWS",
        d."CONVERSION_RATE",
        d."SHIPPED_UNITS",
        d."SHIPPED_REVENUE",
        d."AVG_NET_PPM",
        inv."PROCURABLE_PRODUCT_OOS"                 AS "AVG_PROCURABLE_PRODUCT_OOS",
        d."TOTAL_ON_HAND_UNITS",
        (d."TOTAL_ON_HAND_UNITS"  * d."ASP")         AS "ON_HAND_VALUE",
        inv."NET_RECEIVED_UNITS"                     AS "NET_RECEIVED_UNITS",
        (inv."NET_RECEIVED_UNITS" * d."ASP")         AS "NET_RECEIVED_VALUE",
        d."OPEN_PO_QTY",
        d."UNFILLED_UNITS",
        d."AVG_VENDOR_CONFIRMATION_RATE",
        d."AVG_RECEIVE_FILL_RATE",
        d."AVG_VENDOR_LEAD_TIME"
FROM   (
        /* query #9 without LIMIT goes here */
      ) d
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" inv
     ON  d."DATE" = inv."DATE"
    AND d."ASIN" = inv."ASIN"
    AND inv."DISTRIBUTOR_VIEW" = 'Manufacturing'
WHERE  d."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
ORDER BY d."DATE", d."ASIN"
LIMIT 20;
```
