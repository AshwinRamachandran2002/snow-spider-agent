--Description: 9) Aggregate (query #8 output ➜ alias j) by DATE & ASIN to compute daily
--              roll-ups and rate metrics that will feed the final report.  Query #8
--              already contributes ORDER/SHIP/TRAFFIC numbers plus inventory & PPM.
SELECT  j."DATE",
        j."ASIN",

        /* ------------ volume & value ------------ */
        SUM(j."ORDERED_UNITS")                     AS "TOTAL_ORDERED_UNITS",
        SUM(j."ORDERED_REVENUE")                   AS "TOTAL_ORDERED_REV",
        CASE WHEN SUM(j."ORDERED_UNITS") = 0
             THEN NULL
             ELSE SUM(j."ORDERED_REVENUE") / SUM(j."ORDERED_UNITS")
        END                                        AS "ASP",

        /* ------------ traffic & conversion ------------ */
        SUM(j."GLANCE_VIEWS")                      AS "GLANCE_VIEWS",
        CASE WHEN SUM(j."GLANCE_VIEWS") = 0
             THEN NULL
             ELSE SUM(j."ORDERED_UNITS") / SUM(j."GLANCE_VIEWS")
        END                                        AS "CONVERSION_RATE",

        /* ------------ shipped ------------ */
        SUM(j."SHIPPED_UNITS")                     AS "SHIPPED_UNITS",
        SUM(j."SHIPPED_REVENUE")                   AS "SHIPPED_REVENUE",

        /* ------------ profitability / inventory averages ------------ */
        AVG(j."NET_PPM")                           AS "AVG_NET_PPM",

        /* stock quantities */
        SUM(j."ON_HAND_UNITS" + j."UNSELLABLE_UNITS")
                                                 AS "TOTAL_ON_HAND_UNITS",
        AVG(j."PO_QTY")                            AS "OPEN_PO_QTY",
        AVG(j."UNFILLED_CUSTOMER_ORDERED_UNITS")   AS "UNFILLED_UNITS",

        /* supplier performance */
        AVG(j."VENDOR_CONFIRMATION_RATE")          AS "AVG_VENDOR_CONFIRMATION_RATE",
        AVG(j."RECEIVE_FILL_RATE")                 AS "AVG_RECEIVE_FILL_RATE",
        AVG(j."OVERALL_VENDOR_LEAD_TIME_DAYS")     AS "AVG_VENDOR_LEAD_TIME"
FROM   (  /* ===  query #8 (sales × traffic × inventory × net_ppm) WITHOUT its LIMIT  === */
          SELECT  si."DATE",
                  si."ASIN",
                  si."ORDERED_UNITS",
                  si."ORDERED_REVENUE",
                  si."SHIPPED_UNITS",
                  si."SHIPPED_REVENUE",
                  si."GLANCE_VIEWS",
                  si."ON_HAND_UNITS",
                  si."UNSELLABLE_UNITS",
                  si."PO_QTY",
                  si."UNFILLED_CUSTOMER_ORDERED_UNITS",
                  n."NET_PPM",
                  si."VENDOR_CONFIRMATION_RATE",
                  si."RECEIVE_FILL_RATE",
                  si."OVERALL_VENDOR_LEAD_TIME_DAYS"
          FROM   (   /* sales × traffic × inventory  (see fixed query #8) */   ) si
          LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" n
                 ON si."DATE" = n."DATE"
                AND si."ASIN" = n."ASIN"
                AND n."DISTRIBUTOR_VIEW" = 'Manufacturing'
      ) j
GROUP BY
        j."DATE",
        j."ASIN"
LIMIT 20;
