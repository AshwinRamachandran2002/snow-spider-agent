--Description: 10) Produce the final daily detailed sales report by
--  • re-using the step-9 aggregation (CTE agg) built from a joined base of
--    SALES × TRAFFIC × INVENTORY ⇢ NET_PPM,
--  • then enriching that roll-up with INVENTORY to bring in OOS and
--    NET_RECEIVED metrics, and
--  • calculating inventory values with the aggregated ASP.
WITH base AS (   -- joined detail rows
    SELECT
        s."DATE",
        s."ASIN",
        s."ORDERED_UNITS",
        s."ORDERED_REVENUE",
        s."SHIPPED_UNITS",
        s."SHIPPED_REVENUE",
        t."GLANCE_VIEWS",
        i."SELLABLE_ON_HAND_UNITS"        AS "ON_HAND_UNITS",
        i."UNSELLABLE_ON_HAND_UNITS"      AS "UNSELLABLE_UNITS",
        i."OPEN_PURCHASE_ORDER_QUANTITY"  AS "PO_QTY",
        i."UNFILLED_CUSTOMER_ORDERED_UNITS",
        i."VENDOR_CONFIRMATION_RATE",
        i."RECEIVE_FILL_RATE",
        i."OVERALL_VENDOR_LEAD_TIME_DAYS",
        n."NET_PPM"
    FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
    JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
           ON  s."DATE"            = t."DATE"
           AND s."ASIN"            = t."ASIN"
           AND s."PROGRAM"         = t."PROGRAM"
           AND s."PERIOD"          = t."PERIOD"
           AND s."DISTRIBUTOR_VIEW"= t."DISTRIBUTOR_VIEW"
    JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
           ON  s."DATE"            = i."DATE"
           AND s."ASIN"            = i."ASIN"
           AND i."DISTRIBUTOR_VIEW"= 'Manufacturing'
    LEFT  JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM" n
           ON  s."DATE"            = n."DATE"
           AND s."ASIN"            = n."ASIN"
           AND n."DISTRIBUTOR_VIEW"= 'Manufacturing'
    WHERE  s."DISTRIBUTOR_VIEW"    = 'Manufacturing'
      AND  s."PERIOD"              = 'DAILY'
      AND  s."DATE" BETWEEN '2022-01-08' AND '2022-02-06'
),
agg AS (        -- step-9 daily roll-up
    SELECT
        "DATE",
        "ASIN",
        SUM("ORDERED_UNITS")                                  AS "TOTAL_ORDERED_UNITS",
        SUM("ORDERED_REVENUE")                                AS "TOTAL_ORDERED_REV",
        CASE WHEN SUM("ORDERED_UNITS") = 0
             THEN NULL
             ELSE SUM("ORDERED_REVENUE") / SUM("ORDERED_UNITS") END
                                                             AS "ASP",
        SUM("GLANCE_VIEWS")                                   AS "GLANCE_VIEWS",
        CASE WHEN SUM("GLANCE_VIEWS") = 0
             THEN NULL
             ELSE SUM("ORDERED_UNITS") / SUM("GLANCE_VIEWS") END
                                                             AS "CONVERSION_RATE",
        SUM("SHIPPED_UNITS")                                  AS "SHIPPED_UNITS",
        SUM("SHIPPED_REVENUE")                                AS "SHIPPED_REVENUE",
        AVG("NET_PPM")                                        AS "AVG_NET_PPM",
        SUM("ON_HAND_UNITS" + "UNSELLABLE_UNITS")             AS "TOTAL_ON_HAND_UNITS",
        AVG("PO_QTY")                                         AS "OPEN_PO_QTY",
        AVG("UNFILLED_CUSTOMER_ORDERED_UNITS")                AS "UNFILLED_UNITS",
        AVG("VENDOR_CONFIRMATION_RATE")                       AS "AVG_VENDOR_CONFIRMATION_RATE",
        AVG("RECEIVE_FILL_RATE")                              AS "AVG_RECEIVE_FILL_RATE",
        AVG("OVERALL_VENDOR_LEAD_TIME_DAYS")                  AS "AVG_VENDOR_LEAD_TIME"
    FROM   base
    GROUP BY "DATE","ASIN"
)
SELECT
        a."DATE",
        a."ASIN",

        /* demand */
        a."TOTAL_ORDERED_UNITS",
        a."TOTAL_ORDERED_REV"                     AS "ORDERED_REVENUE",
        a."ASP"                                   AS "AVG_SELLING_PRICE",
        a."GLANCE_VIEWS",
        a."CONVERSION_RATE",

        /* fulfilment */
        a."SHIPPED_UNITS",
        a."SHIPPED_REVENUE",

        /* profitability & OOS */
        a."AVG_NET_PPM",
        i."PROCURABLE_PRODUCT_OOS"               AS "AVG_PROCURABLE_PRODUCT_OOS",

        /* stock values */
        a."TOTAL_ON_HAND_UNITS",
        a."TOTAL_ON_HAND_UNITS" * a."ASP"        AS "ON_HAND_VALUE",
        i."NET_RECEIVED_UNITS",
        i."NET_RECEIVED_UNITS" * a."ASP"         AS "NET_RECEIVED_VALUE",

        /* PO / unfilled */
        a."OPEN_PO_QTY"                          AS "OPEN_PURCHASE_ORDER_QUANTITY",
        a."UNFILLED_UNITS"                       AS "UNFILLED_CUSTOMER_ORDERED_UNITS",

        /* supplier metrics */
        a."AVG_VENDOR_CONFIRMATION_RATE",
        a."AVG_RECEIVE_FILL_RATE",
        a."AVG_VENDOR_LEAD_TIME"
FROM        agg a
LEFT JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
       ON   a."DATE" = i."DATE"
      AND   a."ASIN" = i."ASIN"
      AND   i."DISTRIBUTOR_VIEW" = 'Manufacturing'
ORDER BY    a."DATE", a."ASIN"
LIMIT 20;
