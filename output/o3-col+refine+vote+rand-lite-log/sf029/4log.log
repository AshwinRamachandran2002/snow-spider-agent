--Description: 8) Incorporate Net PPM into the multi-table join  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."SHIPPED_UNITS",
       t."GLANCE_VIEWS",
       n."NET_PPM"
