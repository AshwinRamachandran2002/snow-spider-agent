Query:
--Description: 7) Extend the join by adding inventory (on-hand units, OOS, etc.)  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."SHIPPED_UNITS",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS",
       i."UNSELLABLE_ON_HAND_UNITS",
       i."PROCURABLE_PRODUCT_OOS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   AS s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" AS t
  ON   s."DATE"            = t."DATE"
 AND  s."ASIN"            = t."ASIN"
 AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
 AND  s."PERIOD"           = t."PERIOD"
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" AS i
  ON   s."DATE"            = i."DATE"
 AND  s."ASIN"            = i."ASIN"
 AND  s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
 AND  s."PERIOD"           = i."PERIOD"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PERIOD"           = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
Answer:
DATE,ASIN,ORDERED_UNITS,SHIPPED_UNITS,GLANCE_VIEWS,SELLABLE_ON_HAND_UNITS,UNSELLABLE_ON_HAND_UNITS,PROCURABLE_PRODUCT_OOS
