Query:
--Description: 6) Join sales and traffic to see ordered units, shipped units, and glance views together  
SELECT s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       s."SHIPPED_UNITS",
       t."GLANCE_VIEWS"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"  AS s
JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" AS t
  ON   s."DATE"            = t."DATE"
 AND  s."ASIN"            = t."ASIN"
 AND  s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
 AND  s."PERIOD"           = t."PERIOD"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND s."PERIOD"           = 'DAILY'
  AND s."DATE" BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
Answer:
DATE,ASIN,ORDERED_UNITS,SHIPPED_UNITS,GLANCE_VIEWS
