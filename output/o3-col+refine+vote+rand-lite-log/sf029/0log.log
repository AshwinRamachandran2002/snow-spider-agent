```sql
--7. Description: Join sales and traffic to see conversion rate (ordered units / glance views) for sample ASIN-days
SELECT 
       s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       t."GLANCE_VIEWS",
       CASE WHEN t."GLANCE_VIEWS" > 0 THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" ELSE NULL END AS "CONVERSION_RATE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON   s."DATE" = t."DATE"
 AND   s."ASIN" = t."ASIN"
 AND   s."PROGRAM" = t."PROGRAM"
 AND   s."PERIOD"  = t."PERIOD"
 AND   s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."PERIOD" = 'DAILY'
  AND  s."PROGRAM" = 'Amazon Retail'
  AND  s."DATE" >= '2022-01-08' AND s."DATE" <= '2022-02-06'
ORDER BY s."DATE","ASIN"
LIMIT 20;
```

```sql
--8. Description: Bring inventory data into the previous join to evaluate on-hand units alongside sales & traffic
SELECT 
       s."DATE",
       s."ASIN",
       s."ORDERED_UNITS",
       t."GLANCE_VIEWS",
       i."SELLABLE_ON_HAND_UNITS",
       i."UNSELLABLE_ON_HAND_UNITS",
       i."OPEN_PURCHASE_ORDER_QUANTITY"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON   s."DATE" = t."DATE"
 AND   s."ASIN" = t."ASIN"
 AND   s."PROGRAM" = t."PROGRAM"
 AND   s."PERIOD"  = t."PERIOD"
 AND   s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
JOIN   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
  ON   s."DATE" = i."DATE"
 AND   s."ASIN" = i."ASIN"
 AND   s."PROGRAM" = i."PROGRAM"
 AND   s."PERIOD"  = i."PERIOD"
 AND   s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE  s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  s."PERIOD" = 'DAILY'
  AND  s."PROGRAM" = 'Amazon Retail'
  AND  s."DATE" >= '2022-01-08' AND s."DATE" <= '2022-02-06'
ORDER BY s."DATE","ASIN"
LIMIT 20;
