--1. Description: List the daily dates in the 30-day window (2022-01-08 – 2022-02-06) that have sales records for the Manufacturing distributor view
SELECT DISTINCT 
       "DATE"
FROM   AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"
WHERE  "DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND  "PERIOD" = 'DAILY'
  AND  "PROGRAM" = 'Amazon Retail'
  AND  "DATE" >= '2022-01-08' AND "DATE" <= '2022-02-06'
ORDER BY "DATE"
LIMIT 20;
