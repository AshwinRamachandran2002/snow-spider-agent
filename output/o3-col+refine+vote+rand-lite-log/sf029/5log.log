```sql
--Description: 7) Join sales and traffic to calculate a simple daily conversion rate (ordered units / glance views) for Manufacturing.  
SELECT s."ASIN" ,
       TO_DATE(s."DATE")                       AS "DATE" ,
       s."ORDERED_UNITS" ,
       t."GLANCE_VIEWS" ,
       CASE WHEN t."GLANCE_VIEWS" > 0 
            THEN s."ORDERED_UNITS" / t."GLANCE_VIEWS" 
       END                                     AS "CONVERSION_RATE" 
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON TO_DATE(s."DATE") = TO_DATE(t."DATE")
 AND s."ASIN"          = t."ASIN"
 AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND TO_DATE(s."DATE") BETWEEN '2022-01-07' AND '2022-02-06'
LIMIT 20;
```

```sql
