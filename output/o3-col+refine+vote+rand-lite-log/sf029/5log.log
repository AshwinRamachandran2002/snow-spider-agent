```sql
--Description: 10) Aggregate the joined data to get total ordered units, shipped units, and average metrics per day across all Manufacturing ASINs in the window.  
SELECT TO_DATE(s."DATE")                                       AS "DATE",
       SUM(s."ORDERED_UNITS")                                  AS "TOTAL_ORDERED_UNITS",
       SUM(s."SHIPPED_UNITS")                                  AS "TOTAL_SHIPPED_UNITS",
       AVG(t."GLANCE_VIEWS")                                   AS "AVG_GLANCE_VIEWS",
       AVG(n."NET_PPM")                                        AS "AVG_NET_PPM",
       AVG(i."SELLABLE_ON_HAND_UNITS")                         AS "AVG_SELLABLE_ON_HAND",
       AVG(i."PROCURABLE_PRODUCT_OOS")                         AS "AVG_PROCURABLE_OOS",
       SUM(i."OPEN_PURCHASE_ORDER_QUANTITY")                   AS "TOTAL_OPEN_PO_QTY",
       AVG(i."VENDOR_CONFIRMATION_RATE")                       AS "AVG_VENDOR_CONFIRM_RATE",
       AVG(i."RECEIVE_FILL_RATE")                              AS "AVG_RECEIVE_FILL_RATE",
       AVG(i."SELL_THROUGH_RATE")                              AS "AVG_SELL_THROUGH_RATE",
       AVG(i."OVERALL_VENDOR_LEAD_TIME_DAYS")                  AS "AVG_VENDOR_LEAD_TIME"
FROM AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_SALES"   s
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_TRAFFIC" t
  ON TO_DATE(s."DATE") = TO_DATE(t."DATE")
 AND s."ASIN"          = t."ASIN"
 AND s."DISTRIBUTOR_VIEW" = t."DISTRIBUTOR_VIEW"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_NET_PPM"  n
  ON TO_DATE(s."DATE") = TO_DATE(n."DATE")
 AND s."ASIN"          = n."ASIN"
 AND s."DISTRIBUTOR_VIEW" = n."DISTRIBUTOR_VIEW"
LEFT JOIN AMAZON_VENDOR_ANALYTICS__SAMPLE_DATASET.PUBLIC."RETAIL_ANALYTICS_INVENTORY" i
  ON TO_DATE(s."DATE") = TO_DATE(i."DATE")
 AND s."ASIN"          = i."ASIN"
 AND s."DISTRIBUTOR_VIEW" = i."DISTRIBUTOR_VIEW"
WHERE s."DISTRIBUTOR_VIEW" = 'Manufacturing'
  AND TO_DATE(s."DATE") BETWEEN '2022-01-07' AND '2022-02-06'
GROUP BY TO_DATE(s."DATE")
ORDER BY "DATE"
LIMIT 20;
```
