```sql
--Description: find the Person-ID that belongs to Yash Chopra
SELECT DISTINCT PID, TRIM(Name) AS Name
FROM Person
WHERE TRIM(Name) LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
--Description: list the movies that were directed by Yash Chopra
SELECT DISTINCT d.MID, m.title, m.year
FROM M_Director AS d
JOIN Person      AS p ON d.PID = p.PID
JOIN Movie       AS m ON d.MID = m.MID
WHERE TRIM(p.Name) LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
--Description: actors (cast members) that appear in any Yash Chopra film
SELECT DISTINCT c.PID, TRIM(pr.Name) AS Actor_Name
FROM M_Cast  AS c
JOIN Person  AS pr ON c.PID = pr.PID
WHERE c.MID IN (
      SELECT d.MID
      FROM M_Director AS d
      JOIN Person     AS p ON d.PID = p.PID
      WHERE TRIM(p.Name) LIKE '%Yash Chopra%')
LIMIT 20;
```

```sql
--Description: for each actor, count how many Yash Chopra movies they have done
SELECT c.PID,
       COUNT(*) AS yash_collabs
FROM M_Cast     AS c
JOIN M_Director AS d ON c.MID = d.MID
JOIN Person     AS p ON d.PID = p.PID
WHERE TRIM(p.Name) LIKE '%Yash Chopra%'
GROUP BY c.PID
LIMIT 20;
```

```sql
--Description: for every actor–director pair in the whole database, count joint movies
SELECT c.PID  AS actor_pid,
       d.PID  AS director_pid,
       COUNT(*) AS num_movies
FROM M_Cast     AS c
JOIN M_Director AS d ON c.MID = d.MID
GROUP BY c.PID, d.PID
LIMIT 20;
```

```sql
--Description: for each actor, locate the biggest collaboration count with NON-Yash directors
WITH director_counts AS (
     SELECT c.PID  AS actor_pid,
            d.PID  AS director_pid,
            COUNT(*) AS num_movies
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     GROUP BY c.PID, d.PID),
yash AS (
     SELECT PID FROM Person WHERE TRIM(Name) LIKE '%Yash Chopra%')
SELECT dc.actor_pid,
       MAX(dc.num_movies) AS max_other_collabs
FROM director_counts AS dc
WHERE dc.director_pid NOT IN (SELECT PID FROM yash)
GROUP BY dc.actor_pid
LIMIT 20;
```

```sql
--Description: combine “movies with Yash” vs “max movies with another director” for each actor
WITH yashPID AS (
     SELECT PID FROM Person WHERE TRIM(Name) LIKE '%Yash Chopra%'),
yash_counts AS (
     SELECT c.PID AS actor_pid,
            COUNT(*) AS yash_collabs
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     WHERE d.PID IN (SELECT PID FROM yashPID)
     GROUP BY c.PID),
other_counts AS (
     SELECT c.PID AS actor_pid,
            d.PID AS director_pid,
            COUNT(*) AS num_movies
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     WHERE d.PID NOT IN (SELECT PID FROM yashPID)
     GROUP BY c.PID, d.PID),
max_other AS (
     SELECT actor_pid, MAX(num_movies) AS max_other_collabs
     FROM other_counts
     GROUP BY actor_pid)
SELECT y.actor_pid,
       y.yash_collabs,
       mo.max_other_collabs
FROM yash_counts AS y
LEFT JOIN max_other AS mo ON y.actor_pid = mo.actor_pid
LIMIT 20;
```

```sql
--Description: actors whose Yash Chopra count is strictly greater than with any other director
WITH yashPID AS (
     SELECT PID FROM Person WHERE TRIM(Name) LIKE '%Yash Chopra%'),
yash_counts AS (
     SELECT c.PID AS actor_pid,
            COUNT(*) AS yash_collabs
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     WHERE d.PID IN (SELECT PID FROM yashPID)
     GROUP BY c.PID),
other_counts AS (
     SELECT c.PID AS actor_pid,
            d.PID AS director_pid,
            COUNT(*) AS num_movies
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     WHERE d.PID NOT IN (SELECT PID FROM yashPID)
     GROUP BY c.PID, d.PID),
max_other AS (
     SELECT actor_pid, MAX(num_movies) AS max_other_collabs
     FROM other_counts
     GROUP BY actor_pid),
actors_more_with_yash AS (
     SELECT y.actor_pid
     FROM yash_counts AS y
     LEFT JOIN max_other AS mo ON y.actor_pid = mo.actor_pid
     WHERE y.yash_collabs > COALESCE(mo.max_other_collabs, 0))
SELECT DISTINCT p.PID, TRIM(p.Name) AS Actor_Name
FROM Person AS p
JOIN actors_more_with_yash AS a ON p.PID = a.actor_pid
LIMIT 20;
```

```sql
--Description: final count – how many actors have worked on MORE films with Yash Chopra than with anyone else
WITH yashPID AS (
     SELECT PID FROM Person WHERE TRIM(Name) LIKE '%Yash Chopra%'),
yash_counts AS (
     SELECT c.PID AS actor_pid,
            COUNT(*) AS yash_collabs
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     WHERE d.PID IN (SELECT PID FROM yashPID)
     GROUP BY c.PID),
other_counts AS (
     SELECT c.PID AS actor_pid,
            d.PID AS director_pid,
            COUNT(*) AS num_movies
     FROM M_Cast     AS c
     JOIN M_Director AS d ON c.MID = d.MID
     WHERE d.PID NOT IN (SELECT PID FROM yashPID)
     GROUP BY c.PID, d.PID),
max_other AS (
     SELECT actor_pid, MAX(num_movies) AS max_other_collabs
     FROM other_counts
     GROUP BY actor_pid),
actors_more_with_yash AS (
     SELECT y.actor_pid
     FROM yash_counts AS y
     LEFT JOIN max_other AS mo ON y.actor_pid = mo.actor_pid
     WHERE y.yash_collabs > COALESCE(mo.max_other_collabs, 0))
SELECT COUNT(*) AS num_actors_more_with_yash
FROM actors_more_with_yash;
```

These ten progressively-complex queries let you (1) identify Yash Chopra, (2) collect his films and casts, (3) measure each actor’s collaborations with him vs. any other director, and finally (4) return the count of actors who have worked on more films with Yash Chopra than with anyone else.
