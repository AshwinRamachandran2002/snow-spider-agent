Query:
--Description: for each actor, locate the biggest collaboration count with NON-Yash directors (TRIM actor-PID)
WITH yash AS (
     SELECT PID
     FROM   Person
     WHERE  TRIM(Name) LIKE '%Yash Chopra%'
),
director_counts AS (
     SELECT TRIM(c.PID) AS actor_pid,
