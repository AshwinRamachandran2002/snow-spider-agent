           COUNT(*)      AS films_together
    FROM   "M_Cast"     AS c
    JOIN   "M_Director" AS d ON d."MID" = c."MID"
    GROUP BY actor_pid, director_pid
), max_other AS (
    SELECT adc.actor_pid,
           MAX(adc.films_together) AS max_with_other
    FROM   actor_dir_counts AS adc
    JOIN   "Person"        AS pd ON pd."PID" = adc.director_pid
    WHERE  pd."Name" NOT LIKE '%Yash%Chopra%'
    GROUP BY adc.actor_pid
)
SELECT *
