```sql
--Description: Find up to 20 actors who have appeared in any movie directed by Yash Chopra.
--Logic:
-- 1) First collect the set of movie IDs (MID) whose director’s name contains ‘Yash Chopra’.
-- 2) From the cast table, pick rows whose MID belongs to that set.
-- 3) TRIM() is applied because many PIDs in M_Cast have a leading space, while Person.PID does not.
-- 4) Join with Person to obtain the actor names and return distinct pairs.
SELECT DISTINCT pr."PID",
                pr."Name"
FROM   "M_Cast" AS c
JOIN   "Person" AS pr
       ON pr."PID" = TRIM(c."PID")
WHERE  c."MID" IN (
        SELECT d."MID"
        FROM   "M_Director" AS d
        JOIN   "Person"     AS p ON p."PID" = d."PID"
        WHERE  p."Name" LIKE '%Yash%Chopra%'
      )
LIMIT 20;
```
