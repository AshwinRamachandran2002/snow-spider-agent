```sql
-- 1. Find Yash Chopra’s PID in the Person table  
SELECT DISTINCT "PID", "Name"
FROM "Person"
WHERE "Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- 2. Verify that the PID we found belongs to directors (link Person ↔ M_Director)  
SELECT DISTINCT d."PID", p."Name"
FROM "M_Director" AS d
JOIN "Person"   AS p ON p."PID" = d."PID"
WHERE p."Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- 3. List the movies (MID & title) that were directed by Yash Chopra  
SELECT DISTINCT m."MID", m."title"
FROM "Movie"       AS m
JOIN "M_Director"  AS d ON d."MID" = m."MID"
JOIN "Person"      AS p ON p."PID" = d."PID"
WHERE p."Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- 4. Show the first 20 actors who appeared in at least one Yash Chopra film  
SELECT DISTINCT a."PID", pr."Name"
FROM "M_Cast"      AS a
JOIN "M_Director"  AS d  ON d."MID" = a."MID"
JOIN "Person"      AS pr ON pr."PID" = a."PID"
JOIN "Person"      AS pd ON pd."PID" = d."PID"
WHERE pd."Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- 5. Count, for every actor, how many times they have worked with Yash Chopra  
SELECT a."PID", pr."Name", COUNT(*) AS yash_films
FROM "M_Cast"      AS a
JOIN "M_Director"  AS d  ON d."MID" = a."MID"
JOIN "Person"      AS pr ON pr."PID" = a."PID"
JOIN "Person"      AS pd ON pd."PID" = d."PID"
WHERE pd."Name" LIKE '%Yash%Chopra%'
GROUP BY a."PID", pr."Name"
ORDER BY yash_films DESC
LIMIT 20;
```

```sql
-- 6. Count, for every actor-director pair, the number of shared films  
SELECT a."PID"               AS actor_pid,
       pr."Name"             AS actor_name,
       d."PID"               AS director_pid,
       pd."Name"             AS director_name,
       COUNT(*)              AS films_together
FROM "M_Cast"      AS a
JOIN "M_Director"  AS d  ON d."MID" = a."MID"
JOIN "Person"      AS pr ON pr."PID" = a."PID"
JOIN "Person"      AS pd ON pd."PID" = d."PID"
GROUP BY a."PID", pr."Name", d."PID", pd."Name"
LIMIT 20;
```

```sql
-- 7. For every actor, find the director (other than Yash Chopra) with whom they have the most films  
WITH actor_dir_counts AS (
    SELECT a."PID"  AS actor_pid,
           d."PID"  AS director_pid,
           COUNT(*) AS films_together
    FROM "M_Cast"     AS a
    JOIN "M_Director" AS d ON d."MID" = a."MID"
    GROUP BY a."PID", d."PID"
), max_other AS (
    SELECT adc.actor_pid,
           MAX(adc.films_together) AS max_with_other
    FROM actor_dir_counts AS adc
    JOIN "Person" AS pd ON pd."PID" = adc.director_pid
    WHERE pd."Name" NOT LIKE '%Yash%Chopra%'
    GROUP BY adc.actor_pid
)
SELECT *
FROM max_other
LIMIT 20;
```

```sql
-- 8. Combine Yash Chopra counts with each actor’s max-other count  
WITH yash_counts AS (
    SELECT a."PID" AS actor_pid, COUNT(*) AS yash_films
    FROM "M_Cast"     AS a
    JOIN "M_Director" AS d  ON d."MID" = a."MID"
    JOIN "Person"     AS pd ON pd."PID" = d."PID"
    WHERE pd."Name" LIKE '%Yash%Chopra%'
    GROUP BY a."PID"
), max_other AS (
    SELECT adc.actor_pid,
           MAX(adc.films_together) AS max_with_other
    FROM (
        SELECT a."PID" AS actor_pid,
               d."PID" AS director_pid,
               COUNT(*) AS films_together
        FROM "M_Cast"     AS a
        JOIN "M_Director" AS d ON d."MID" = a."MID"
        GROUP BY a."PID", d."PID"
    ) AS adc
    JOIN "Person" AS pd ON pd."PID" = adc.director_pid
    WHERE pd."Name" NOT LIKE '%Yash%Chopra%'
    GROUP BY adc.actor_pid
)
SELECT yc.actor_pid,
       p."Name"                     AS actor_name,
       yc.yash_films,
       IFNULL(mo.max_with_other,0)  AS max_with_other
FROM yash_counts AS yc
LEFT JOIN max_other AS mo ON mo.actor_pid = yc.actor_pid
JOIN "Person" AS p ON p."PID" = yc.actor_pid
LIMIT 20;
```

```sql
-- 9. Actors with more Yash Chopra films than with any other single director  
WITH yash_counts AS (
    SELECT a."PID" AS actor_pid, COUNT(*) AS yash_films
    FROM "M_Cast"     AS a
    JOIN "M_Director" AS d  ON d."MID" = a."MID"
    JOIN "Person"     AS pd ON pd."PID" = d."PID"
    WHERE pd."Name" LIKE '%Yash%Chopra%'
    GROUP BY a."PID"
), max_other AS (
    SELECT adc.actor_pid,
           MAX(adc.films_together) AS max_with_other
    FROM (
        SELECT a."PID" AS actor_pid,
               d."PID" AS director_pid,
               COUNT(*) AS films_together
        FROM "M_Cast"     AS a
        JOIN "M_Director" AS d ON d."MID" = a."MID"
        GROUP BY a."PID", d."PID"
    ) AS adc
    JOIN "Person" AS pd ON pd."PID" = adc.director_pid
    WHERE pd."Name" NOT LIKE '%Yash%Chopra%'
    GROUP BY adc.actor_pid
)
SELECT yc.actor_pid,
       p."Name"            AS actor_name,
       yc.yash_films,
       IFNULL(mo.max_with_other,0) AS max_with_other
FROM yash_counts AS yc
LEFT JOIN max_other AS mo ON mo.actor_pid = yc.actor_pid
JOIN "Person" AS p ON p."PID" = yc.actor_pid
WHERE yc.yash_films > IFNULL(mo.max_with_other,0)
LIMIT 20;
```

```sql
-- 10. Final answer: the number of such actors  
WITH yash_counts AS (
    SELECT a."PID" AS actor_pid, COUNT(*) AS yash_films
