```sql
-- 1. Find the PID of Yash Chopra in the Person table
SELECT DISTINCT "PID", "Name"
FROM "Person"
WHERE "Name" LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
-- 2. List all movies he directed (using the PID from query 1, suppose it is 'nm0005930')
SELECT DISTINCT d."MID", m."title", m."year"
FROM "M_Director" AS d
JOIN "Movie" AS m ON m."MID" = d."MID"
WHERE d."PID" = 'nm0005930'
LIMIT 20;
```

```sql
-- 3. Show the full cast for one of those movies to verify links
SELECT DISTINCT c."MID", c."PID", p."Name"
FROM "M_Cast"  AS c
JOIN "Person"  AS p ON p."PID" = c."PID"
WHERE c."MID" IN (
    SELECT "MID" FROM "M_Director" WHERE "PID" = 'nm0005930'
)
LIMIT 20;
```

```sql
-- 4. Count how many films each actor has made with Yash Chopra
SELECT c."PID", p."Name",
       COUNT(*) AS films_with_yash
FROM   "M_Cast"    AS c
JOIN   "M_Director" AS d ON d."MID" = c."MID"            -- same film
JOIN   "Person"     AS p ON p."PID" = c."PID"
WHERE  d."PID" = 'nm0005930'
GROUP BY c."PID"
LIMIT 20;
```

```sql
-- 5. For every actor–director pair, count the number of shared films
SELECT c."PID"        AS actor_pid,
       d."PID"        AS director_pid,
       COUNT(*)       AS films_together
FROM   "M_Cast"    AS c
JOIN   "M_Director" AS d ON d."MID" = c."MID"
GROUP  BY actor_pid, director_pid
LIMIT 20;
```

```sql
-- 6. For each actor, find the maximum films they have with any director
WITH pair_counts AS (
  SELECT c."PID" AS actor_pid,
         d."PID" AS director_pid,
         COUNT(*) AS films_together
  FROM   "M_Cast"    AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  GROUP BY actor_pid, director_pid
)
SELECT actor_pid,
       MAX(films_together) AS max_with_any_director
FROM   pair_counts
GROUP BY actor_pid
LIMIT 20;
```

```sql
-- 7. Combine the counts: actors whose max collaboration is with Yash Chopra
WITH
pair_counts AS (
  SELECT c."PID" AS actor_pid,
         d."PID" AS director_pid,
         COUNT(*) AS films_together
  FROM   "M_Cast"    AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  GROUP BY actor_pid, director_pid
),
max_per_actor AS (
  SELECT actor_pid,
         MAX(films_together) AS max_with_any
  FROM   pair_counts
  GROUP BY actor_pid
),
yash_collabs AS (
  SELECT actor_pid,
         films_together AS films_with_yash
  FROM   pair_counts
  WHERE  director_pid = 'nm0005930'
)
SELECT y.actor_pid,
       p."Name",
       y.films_with_yash
FROM   yash_collabs AS y
JOIN   max_per_actor AS m ON m.actor_pid = y.actor_pid
JOIN   "Person"      AS p ON p."PID"    = y.actor_pid
WHERE  y.films_with_yash = m.max_with_any
LIMIT 20;
```

```sql
-- 8. Finally, count how many such actors exist
WITH
pair_counts AS (
  SELECT c."PID" AS actor_pid,
         d."PID" AS director_pid,
         COUNT(*) AS films_together
  FROM   "M_Cast"    AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  GROUP BY actor_pid, director_pid
),
max_per_actor AS (
  SELECT actor_pid,
         MAX(films_together) AS max_with_any
  FROM   pair_counts
  GROUP BY actor_pid
),
yash_collabs AS (
  SELECT actor_pid,
         films_together AS films_with_yash
  FROM   pair_counts
  WHERE  director_pid = 'nm0005930'
)
SELECT COUNT(*) AS actors_preferring_yash_chopra
FROM   yash_collabs AS y
JOIN   max_per_actor AS m ON m.actor_pid = y.actor_pid
WHERE  y.films_with_yash = m.max_with_any;
```

