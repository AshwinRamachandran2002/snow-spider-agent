Query:
--Description: Show the cast members for every movie directed by Yash Chopra.  
--We identify his films by joining M_Director → Person (filter name LIKE '%Yash Chopra%')  
--and then pull the actors from M_Cast, trimming PIDs to merge spacing variations.
SELECT DISTINCT c."MID",
                TRIM(c."PID")  AS actor_pid,
                p2."Name"      AS actor_name
FROM   "M_Director" AS d
JOIN   "Person"     AS p1 ON TRIM(p1."PID") = TRIM(d."PID")          -- director
JOIN   "M_Cast"     AS c  ON c."MID"      = d."MID"                 -- same movie
JOIN   "Person"     AS p2 ON TRIM(p2."PID") = TRIM(c."PID")         -- actor
WHERE  p1."Name" LIKE '%Yash%Chopra%'
LIMIT 20
