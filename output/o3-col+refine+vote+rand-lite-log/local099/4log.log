--Description: For each actor, find the maximum number of films they have with any director.
WITH pair_counts AS (
  SELECT TRIM(c."PID") AS actor_pid,
         TRIM(d."PID") AS director_pid,
         COUNT(*)      AS films_together
  FROM   "M_Cast"     AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  GROUP BY actor_pid, director_pid
)
SELECT actor_pid,
       MAX(films_together) AS max_with_any_director
FROM   pair_counts
GROUP  BY actor_pid
LIMIT 20
