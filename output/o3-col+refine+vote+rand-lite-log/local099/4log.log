       p2."Name"                AS actor_name,
       COUNT(*)                 AS films_with_yash
FROM   "M_Cast"     AS c
JOIN   "M_Director" AS d  ON d."MID" = c."MID"
JOIN   "Person"     AS p1 ON TRIM(p1."PID") = TRIM(d."PID")         -- director (Yash)
JOIN   "Person"     AS p2 ON TRIM(p2."PID") = TRIM(c."PID")         -- actor
WHERE  p1."Name" LIKE '%Yash%Chopra%'
GROUP  BY TRIM(c."PID")
LIMIT 20;
```

```sql
