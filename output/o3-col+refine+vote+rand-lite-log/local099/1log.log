SELECT DISTINCT TRIM(c."PID") AS actor_pid,
       TRIM(p."Name")        AS actor_name
FROM   "M_Cast"     AS c
JOIN   "Person"     AS p  ON TRIM(p."PID") = TRIM(c."PID")
WHERE  c."MID" IN (
        SELECT d."MID"
        FROM   "M_Director" d
        WHERE  TRIM(d."PID") = 'nm0007181'
)
LIMIT 20;
