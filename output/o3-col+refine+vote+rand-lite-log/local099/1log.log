```sql
-- Description: find the (director) person–ID rows whose trimmed name contains ‘Yash Chopra’.
SELECT DISTINCT "PID", TRIM("Name") AS "Name"
FROM "Person"
WHERE TRIM("Name") LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- Description: list a few movies that have Yash Chopra in the director table.
SELECT DISTINCT d."MID", m."title", m."year"
FROM "M_Director" AS d
JOIN "Person"  AS p ON d."PID" = p."PID"
JOIN "Movie"   AS m ON d."MID" = m."MID"
WHERE TRIM(p."Name") LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
-- Description: actors (PIDs & names) that appear in the movies Yash Chopra directed.
SELECT DISTINCT c."PID", TRIM(pr."Name") AS "Actor_Name"
FROM "M_Cast"  AS c
JOIN "Person"  AS pr ON c."PID" = pr."PID"
WHERE c."MID" IN (
        SELECT d."MID"
        FROM "M_Director" AS d
        JOIN "Person"     AS p ON d."PID" = p."PID"
        WHERE TRIM(p."Name") LIKE '%Yash%Chopra%'
      )
LIMIT 20;
```

```sql
-- Description: how many Yash-Chopra-directed films each actor has appeared in.
SELECT c."PID",
       COUNT(*) AS "yash_collab_count"
FROM "M_Cast" AS c
WHERE c."MID" IN (
        SELECT "MID"
        FROM "M_Director"
        WHERE "PID" IN (SELECT "PID"
                        FROM "Person"
                        WHERE TRIM("Name") LIKE '%Yash%Chopra%')
      )
GROUP BY c."PID"
LIMIT 20;
```

```sql
-- Description: number of collaborations every actor has with every director (including Yash).
SELECT c."PID"  AS "actor_pid",
       d."PID"  AS "director_pid",
       COUNT(*) AS "collab_count"
FROM "M_Cast"     AS c
JOIN "M_Director" AS d ON c."MID" = d."MID"
GROUP BY c."PID", d."PID"
LIMIT 20;
```

```sql
-- Description: for each actor, maximum collaborations with directors other than Yash Chopra.
SELECT t."actor_pid",
       MAX(t."collab_count") AS "max_other_collab"
FROM (
        SELECT c."PID" AS "actor_pid",
               d."PID" AS "director_pid",
               COUNT(*) AS "collab_count"
        FROM "M_Cast"     AS c
        JOIN "M_Director" AS d ON c."MID" = d."MID"
        WHERE d."PID" NOT IN (
                SELECT "PID" FROM "Person"
                WHERE TRIM("Name") LIKE '%Yash%Chopra%')
        GROUP BY c."PID", d."PID"
     ) AS t
GROUP BY t."actor_pid"
LIMIT 20;
```

```sql
-- Description: actors whose Yash-collaboration count is strictly larger than
--              their best collaboration count with any *other* director.
SELECT y."actor_pid"
FROM (
        SELECT c."PID" AS "actor_pid",
               COUNT(*) AS "yash_collab"
        FROM "M_Cast" AS c
        WHERE c."MID" IN (
                SELECT "MID"
                FROM "M_Director"
                WHERE "PID" IN (SELECT "PID"
                                FROM "Person"
                                WHERE TRIM("Name") LIKE '%Yash%Chopra%'))
        GROUP BY c."PID"
     ) AS y
LEFT JOIN (
        SELECT t."actor_pid",
               MAX(t."collab_count") AS "max_other_collab"
        FROM (
                SELECT c."PID" AS "actor_pid",
                       d."PID" AS "director_pid",
                       COUNT(*) AS "collab_count"
                FROM "M_Cast"     AS c
                JOIN "M_Director" AS d ON c."MID" = d."MID"
                WHERE d."PID" NOT IN (
                        SELECT "PID"
                        FROM "Person"
                        WHERE TRIM("Name") LIKE '%Yash%Chopra%')
                GROUP BY c."PID", d."PID"
             ) AS t
        GROUP BY t."actor_pid"
     ) AS o
     ON y."actor_pid" = o."actor_pid"
WHERE y."yash_collab" > COALESCE(o."max_other_collab", 0)
LIMIT 20;
```

```sql
-- Description: finally, count how many actors have made *more* films with Yash Chopra
--              than with any other single director.
SELECT COUNT(*) AS "actors_preferring_yash"
FROM (
        SELECT y."actor_pid"
        FROM (
                SELECT c."PID" AS "actor_pid",
                       COUNT(*) AS "yash_collab"
                FROM "M_Cast" AS c
                WHERE c."MID" IN (
                        SELECT "MID"
                        FROM "M_Director"
                        WHERE "PID" IN (SELECT "PID"
                                        FROM "Person"
                                        WHERE TRIM("Name") LIKE '%Yash%Chopra%'))
                GROUP BY c."PID"
             ) AS y
        LEFT JOIN (
                SELECT t."actor_pid",
                       MAX(t."collab_count") AS "max_other_collab"
                FROM (
                        SELECT c."PID" AS "actor_pid",
                               d."PID" AS "director_pid",
                               COUNT(*) AS "collab_count"
                        FROM "M_Cast"     AS c
                        JOIN "M_Director" AS d ON c."MID" = d."MID"
                        WHERE d."PID" NOT IN (
                                SELECT "PID"
                                FROM "Person"
                                WHERE TRIM("Name") LIKE '%Yash%Chopra%')
                        GROUP BY c."PID", d."PID"
                     ) AS t
                GROUP BY t."actor_pid"
             ) AS o
          ON y."actor_pid" = o."actor_pid"
        WHERE y."yash_collab" > COALESCE(o."max_other_collab", 0)
     )
LIMIT 20;
```
