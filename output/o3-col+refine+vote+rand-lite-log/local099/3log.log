```sql
-- 1. Find the row(s) for the director “Yash Chopra” and note his PID.
SELECT * 
FROM "Person" 
WHERE "Name" LIKE '%Yash Chopra%' 
LIMIT 20;
```

```sql
-- 2. List all movies that were directed by Yash Chopra.
SELECT d."MID", m."title", m."year"
FROM "M_Director" AS d
JOIN "Person"  AS p ON p."PID" = d."PID"
JOIN "Movie"   AS m ON m."MID" = d."MID"
WHERE p."Name" LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
-- 3. Show the first 20 actor-movie pairs for films directed by Yash Chopra.
SELECT c."PID"  AS actorPID,
       per."Name" AS actorName,
       c."MID"
FROM "M_Cast"    AS c
JOIN "Person"    AS per ON per."PID" = c."PID"
WHERE c."MID" IN (
        SELECT d."MID"
        FROM "M_Director" AS d
        JOIN "Person"     AS p ON p."PID" = d."PID"
        WHERE p."Name" LIKE '%Yash Chopra%'
      )
LIMIT 20;
```

```sql
-- 4. Count how many times every actor has worked with Yash Chopra (top 20 by count).
SELECT c."PID"            AS actorPID,
       per."Name"         AS actorName,
       COUNT(*)           AS yash_count
FROM "M_Cast"    AS c
JOIN "Person"    AS per ON per."PID" = c."PID"
WHERE c."MID" IN (
        SELECT d."MID"
        FROM "M_Director" AS d
        JOIN "Person"     AS p ON p."PID" = d."PID"
        WHERE p."Name" LIKE '%Yash Chopra%'
      )
GROUP BY c."PID"
ORDER BY yash_count DESC
LIMIT 20;
```

```sql
-- 5. Build the complete actor–director collaboration counts (sample 20 rows).
SELECT c."PID"            AS actorPID,
       per."Name"         AS actorName,
       d."PID"            AS directorPID,
       pdir."Name"        AS directorName,
       COUNT(*)           AS num_movies
FROM "M_Cast"    AS c
JOIN "M_Director" AS d   ON d."MID" = c."MID"
JOIN "Person"     AS per ON per."PID" = c."PID"
JOIN "Person"     AS pdir ON pdir."PID" = d."PID"
GROUP BY c."PID", d."PID"
ORDER BY num_movies DESC
LIMIT 20;
```

```sql
-- 6. For every actor, get the maximum number of films done with any *non-Yash* director (sample).
WITH yash AS (
  SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Yash Chopra%'
)
SELECT adc.actorPID,
       per."Name"          AS actorName,
       MAX(adc.num_movies) AS max_with_other
FROM (
       SELECT c."PID" AS actorPID,
              d."PID" AS directorPID,
              COUNT(*) AS num_movies
       FROM "M_Cast"      AS c
       JOIN "M_Director"  AS d ON d."MID" = c."MID"
       GROUP BY c."PID", d."PID"
     ) AS adc
JOIN "Person" AS per  ON per."PID" = adc.actorPID
WHERE adc.directorPID NOT IN (SELECT * FROM yash)
GROUP BY adc.actorPID
LIMIT 20;
```

```sql
-- 7. Combine Yash–actor counts with each actor’s maximum collaboration count
--    with other directors (sample to verify the logic).
WITH
yash AS (
  SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Yash Chopra%'
),
yash_movies AS (
  SELECT "MID" FROM "M_Director"
  WHERE "PID" IN (SELECT * FROM yash)
),
actor_yash AS (
  SELECT "PID" AS actorPID, COUNT(*) AS yash_count
  FROM "M_Cast"
  WHERE "MID" IN (SELECT * FROM yash_movies)
  GROUP BY "PID"
),
actor_dir AS (
  SELECT c."PID" AS actorPID,
         d."PID" AS directorPID,
         COUNT(*) AS cnt
  FROM "M_Cast"     AS c
  JOIN "M_Director" AS d ON d."MID" = c."MID"
  GROUP BY c."PID", d."PID"
),
max_other AS (
  SELECT actorPID, MAX(cnt) AS max_cnt_other
  FROM actor_dir
  WHERE directorPID NOT IN (SELECT * FROM yash)
  GROUP BY actorPID
)
SELECT ay.actorPID,
       per."Name"         AS actorName,
       ay.yash_count,
       COALESCE(mo.max_cnt_other,0) AS max_other_director_count
FROM actor_yash AS ay
LEFT JOIN max_other AS mo ON mo.actorPID = ay.actorPID
JOIN "Person"     AS per ON per."PID" = ay.actorPID
ORDER BY ay.yash_count DESC
LIMIT 20;
```

```sql
-- 8. FINAL ANSWER: number of actors who have done *more* films with Yash Chopra
--    than with any other individual director.
WITH
yash AS (
  SELECT "PID" FROM "Person" WHERE "Name" LIKE '%Yash Chopra%'
),
yash_movies AS (
  SELECT "MID" FROM "M_Director"
  WHERE "PID" IN (SELECT * FROM yash)
),
actor_yash AS (
  SELECT "PID" AS actorPID, COUNT(*) AS yash_count
  FROM "M_Cast"
  WHERE "MID" IN (SELECT * FROM yash_movies)
  GROUP BY "PID"
),
actor_dir AS (
  SELECT c."PID" AS actorPID,
         d."PID" AS directorPID,
         COUNT(*) AS cnt
  FROM "M_Cast"     AS c
  JOIN "M_Director" AS d ON d."MID" = c."MID"
  GROUP BY c."PID", d."PID"
),
max_other AS (
  SELECT actorPID, MAX(cnt) AS max_cnt_other
  FROM actor_dir
  WHERE directorPID NOT IN (SELECT * FROM yash)
  GROUP BY actorPID
)
SELECT COUNT(*) AS num_actors
FROM actor_yash AS ay
LEFT JOIN max_other AS mo ON mo.actorPID = ay.actorPID
WHERE ay.yash_count > COALESCE(mo.max_cnt_other, 0);
```
