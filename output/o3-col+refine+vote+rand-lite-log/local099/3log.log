--Description: 4) Count how many times every actor has worked with Yash Chopra.
--              Uses the director-PID ‘nm0007181’ and TRIM() to neutralise
--              leading/trailing spaces in the junction tables; shows top 20.
SELECT
        TRIM(c."PID")          AS actorPID,
        per."Name"             AS actorName,
        COUNT(*)               AS yash_count
FROM    "M_Cast"      AS c
JOIN    "M_Director"  AS d   ON d."MID" = c."MID"
JOIN    "Person"      AS per ON per."PID" = TRIM(c."PID")
WHERE   TRIM(d."PID") = 'nm0007181'          -- Yash Chopra
GROUP BY actorPID
ORDER BY yash_count DESC
LIMIT 20;
```

```sql
--Description: 5) Build complete actor–director collaboration counts (sample 20 rows),
--              trimming PIDs on both sides so they match the Person table.
SELECT
        TRIM(c."PID")          AS actorPID,
        per."Name"             AS actorName,
        TRIM(d."PID")          AS directorPID,
        pdir."Name"            AS directorName,
        COUNT(*)               AS num_movies
FROM    "M_Cast"      AS c
JOIN    "M_Director"  AS d    ON d."MID" = c."MID"
JOIN    "Person"      AS per  ON per."PID" = TRIM(c."PID")
JOIN    "Person"      AS pdir ON pdir."PID" = TRIM(d."PID")
GROUP BY actorPID, directorPID
ORDER BY num_movies DESC
LIMIT 20;
```

```sql
--Description: 6) For every actor, find the maximum number of films done with any
--              single director other than Yash Chopra; sample 20 rows.
WITH actor_dir AS (
     SELECT TRIM(c."PID")  AS actorPID,
            TRIM(d."PID")  AS directorPID,
            COUNT(*)       AS num_movies
     FROM   "M_Cast"     AS c
     JOIN   "M_Director" AS d ON d."MID" = c."MID"
     GROUP BY actorPID, directorPID
),
max_other AS (
     SELECT actorPID,
            MAX(num_movies) AS max_with_other
     FROM   actor_dir
     WHERE  directorPID <> 'nm0007181'           -- exclude Yash Chopra
     GROUP BY actorPID
)
SELECT mo.actorPID,
       per."Name"       AS actorName,
       mo.max_with_other
FROM   max_other  AS mo
JOIN   "Person"   AS per ON per."PID" = mo.actorPID
LIMIT 20;
```

```sql
--Description: 7) Combine (a) each actor’s Yash Chopra count with
--              (b) their maximum count with any other director; show 20 rows.
WITH actor_yash AS (
     SELECT TRIM(c."PID") AS actorPID,
            COUNT(*)      AS yash_count
     FROM   "M_Cast"     AS c
     JOIN   "M_Director" AS d ON d."MID" = c."MID"
     WHERE  TRIM(d."PID") = 'nm0007181'
     GROUP BY actorPID
),
actor_dir AS (
     SELECT TRIM(c."PID") AS actorPID,
            TRIM(d."PID") AS directorPID,
            COUNT(*)      AS cnt
     FROM   "M_Cast"     AS c
     JOIN   "M_Director" AS d ON d."MID" = c."MID"
     GROUP BY actorPID, directorPID
),
max_other AS (
     SELECT actorPID,
            MAX(cnt) AS max_cnt_other
     FROM   actor_dir
     WHERE  directorPID <> 'nm0007181'
     GROUP BY actorPID
)
SELECT ay.actorPID,
       per."Name"                AS actorName,
       ay.yash_count,
       COALESCE(mo.max_cnt_other,0) AS max_other_director_count
FROM   actor_yash ay
LEFT  JOIN max_other mo ON mo.actorPID = ay.actorPID
JOIN   "Person"    per ON per."PID"   = ay.actorPID
ORDER BY ay.yash_count DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – Count actors who have appeared in more films
--              with Yash Chopra than with any other single director.
WITH actor_yash AS (
     SELECT TRIM(c."PID") AS actorPID,
            COUNT(*)      AS yash_count
     FROM   "M_Cast"     AS c
     JOIN   "M_Director" AS d ON d."MID" = c."MID"
     WHERE  TRIM(d."PID") = 'nm0007181'
     GROUP BY actorPID
),
actor_dir AS (
     SELECT TRIM(c."PID") AS actorPID,
            TRIM(d."PID") AS directorPID,
            COUNT(*)      AS cnt
     FROM   "M_Cast"     AS c
     JOIN   "M_Director" AS d ON d."MID" = c."MID"
     GROUP BY actorPID, directorPID
),
max_other AS (
     SELECT actorPID,
            MAX(cnt) AS max_cnt_other
     FROM   actor_dir
     WHERE  directorPID <> 'nm0007181'
     GROUP BY actorPID
)
SELECT COUNT(*) AS num_actors
FROM   actor_yash ay
LEFT  JOIN max_other mo ON mo.actorPID = ay.actorPID
WHERE  ay.yash_count > COALESCE(mo.max_cnt_other, 0);
