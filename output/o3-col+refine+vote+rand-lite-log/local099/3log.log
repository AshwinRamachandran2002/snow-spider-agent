```sql
--Description:
-- We need actor-movie pairs for Yash Chopra films.  
-- • Yash Chopra’s director-PID is ‘nm0007181’.  
-- • In junction tables (M_Cast, M_Director) the PID values often carry leading/trailing
--   spaces, while Person.PID is clean; therefore TRIM() is applied before comparison.  
-- • Steps:  
--   1) Filter M_Director rows where TRIM(PID) = 'nm0007181' to get movies he directed.  
--   2) Join those movies to M_Cast to fetch actor PIDs.  
--   3) Join to Person (after trimming) for actor names, and to Movie for titles.  
--   4) Limit to 20 rows as a quick sample.  
SELECT DISTINCT
       TRIM(c."PID")          AS actorPID,
       per."Name"             AS actorName,
       c."MID"                AS movieMID,
       mv."title"             AS movieTitle,
       mv."year"              AS movieYear
FROM   "M_Director"  AS d
JOIN   "M_Cast"      AS c   ON c."MID" = d."MID"
JOIN   "Person"      AS per ON per."PID" = TRIM(c."PID")
JOIN   "Movie"       AS mv  ON mv."MID"  = c."MID"
WHERE  TRIM(d."PID") = 'nm0007181'      -- Yash Chopra
LIMIT  20;
```
