```sql
--Description: List all movies (MID–title–year) that Yash Chopra directed.
SELECT DISTINCT md."MID",
       m."title",
       m."year"
FROM   "M_Director" AS md
JOIN   "Person"      AS p ON p."PID" = md."PID"
JOIN   "Movie"       AS m ON m."MID" = md."MID"
WHERE  p."Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
--Description: Count how many distinct films were directed by Yash Chopra.
