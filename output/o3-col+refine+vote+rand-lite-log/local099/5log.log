FROM   "M_Director" AS md
JOIN   "Person"      AS p ON p."PID" = md."PID"
WHERE  p."Name" LIKE '%Yash%Chopra%';
```

```sql
--Description: Show the first 20 distinct actors who appeared in any Yash Chopra-directed film.
SELECT DISTINCT mc."PID",
       a."Name"
FROM   "M_Cast"     AS mc
JOIN   "M_Director" AS md ON md."MID" = mc."MID"
JOIN   "Person"     AS d  ON d."PID"  = md."PID"
JOIN   "Person"     AS a  ON a."PID"  = mc."PID"
WHERE  d."Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
--Description: For every actor, count how many Yash Chopra films he/she has acted in.
SELECT   a."PID",
         a."Name",
         COUNT(DISTINCT mc."MID") AS yash_collabs
FROM     "M_Cast"     AS mc
JOIN     "M_Director" AS md ON md."MID" = mc."MID"
JOIN     "Person"     AS d  ON d."PID"  = md."PID"
JOIN     "Person"     AS a  ON a."PID"  = mc."PID"
WHERE    d."Name" LIKE '%Yash%Chopra%'
GROUP BY a."PID",
         a."Name"
ORDER BY yash_collabs DESC
LIMIT 20;
```

```sql
--Description: Build a general actor-director collaboration matrix (first 20 rows).
SELECT mc."PID"                    AS actor_id,
       a."Name"                    AS actor_name,
       md."PID"                    AS director_id,
       d."Name"                    AS director_name,
       COUNT(DISTINCT mc."MID")    AS num_movies
FROM   "M_Cast"     AS mc
JOIN   "M_Director" AS md ON md."MID" = mc."MID"
JOIN   "Person"     AS a  ON a."PID"  = mc."PID"
JOIN   "Person"     AS d  ON d."PID"  = md."PID"
GROUP  BY actor_id,
          actor_name,
          director_id,
          director_name
LIMIT 20;
```

```sql
--Description: For every actor, find the largest number of films made with any single director.
SELECT   actor_id,
         actor_name,
         MAX(num_movies) AS max_collabs_with_any_director
FROM   (
         SELECT mc."PID"                 AS actor_id,
                a."Name"                 AS actor_name,
                md."PID"                 AS director_id,
                COUNT(DISTINCT mc."MID") AS num_movies
         FROM   "M_Cast"     AS mc
         JOIN   "M_Director" AS md ON md."MID" = mc."MID"
         JOIN   "Person"     AS a  ON a."PID"  = mc."PID"
         GROUP  BY actor_id,
                   director_id
       ) AS sub
GROUP BY actor_id,
         actor_name
LIMIT 20;
```

```sql
--Description: Compare each actor’s Yash Chopra collaborations with his/her personal maximum with ANY director.
SELECT   y.actor_id,
         y.actor_name,
         y.yash_collabs,
         m.max_collabs_with_any_director
FROM   (
         SELECT   a."PID"                 AS actor_id,
                  a."Name"                AS actor_name,
                  COUNT(DISTINCT mc."MID") AS yash_collabs
         FROM     "M_Cast"     AS mc
         JOIN     "M_Director" AS md ON md."MID" = mc."MID"
         JOIN     "Person"     AS d  ON d."PID"  = md."PID"
         JOIN     "Person"     AS a  ON a."PID"  = mc."PID"
         WHERE    d."Name" LIKE '%Yash%Chopra%'
         GROUP BY a."PID",
                  a."Name"
       ) AS y
JOIN   (
         SELECT   actor_id,
                  MAX(num_movies) AS max_collabs_with_any_director
         FROM   (
                 SELECT mc."PID"                 AS actor_id,
                        md."PID"                 AS director_id,
                        COUNT(DISTINCT mc."MID") AS num_movies
                 FROM   "M_Cast"     AS mc
                 JOIN   "M_Director" AS md ON md."MID" = mc."MID"
                 GROUP  BY actor_id,
                           director_id
               )
         GROUP BY actor_id
       ) AS m
ON     y.actor_id = m.actor_id
LIMIT 20;
```

```sql
--Description: List actors whose collaboration count with Yash Chopra exceeds what they have with ANY other single director.
SELECT y.actor_id,
       y.actor_name,
       y.yash_collabs
FROM (
       SELECT   a."PID"                 AS actor_id,
                a."Name"                AS actor_name,
                COUNT(DISTINCT mc."MID") AS yash_collabs
       FROM     "M_Cast"     AS mc
       JOIN     "M_Director" AS md ON md."MID" = mc."MID"
       JOIN     "Person"     AS d  ON d."PID"  = md."PID"
       JOIN     "Person"     AS a  ON a."PID"  = mc."PID"
       WHERE    d."Name" LIKE '%Yash%Chopra%'
       GROUP BY a."PID",
                a."Name"
     ) AS y
JOIN (
       SELECT   actor_id,
                MAX(num_movies) AS best_with_other_director
       FROM  (
               SELECT mc."PID"                 AS actor_id,
                      md."PID"                 AS director_id,
                      COUNT(DISTINCT mc."MID") AS num_movies
               FROM   "M_Cast"     AS mc
               JOIN   "M_Director" AS md ON md."MID" = mc."MID"
               JOIN   "Person"     AS d  ON d."PID"  = md."PID"
               WHERE  d."Name" NOT LIKE '%Yash%Chopra%'   -- exclude Yash Chopra
               GROUP  BY actor_id,
                         director_id
             )
       GROUP BY actor_id
     ) AS o ON o.actor_id = y.actor_id
WHERE  y.yash_collabs > IFNULL(o.best_with_other_director, 0)
LIMIT 20;
```

```sql
--Description: FINAL – count how many actors meet the condition “more films with Yash Chopra than with any other director”.
SELECT COUNT(*) AS num_actors_with_more_films_with_yash
FROM (
       SELECT y.actor_id
       FROM (
              SELECT   a."PID"                 AS actor_id,
                       COUNT(DISTINCT mc."MID") AS yash_collabs
              FROM     "M_Cast"     AS mc
              JOIN     "M_Director" AS md ON md."MID" = mc."MID"
              JOIN     "Person"     AS d  ON d."PID"  = md."PID"
              JOIN     "Person"     AS a  ON a."PID"  = mc."PID"
              WHERE    d."Name" LIKE '%Yash%Chopra%'
              GROUP BY a."PID"
            ) AS y
       LEFT JOIN (
              SELECT   actor_id,
                       MAX(num_movies) AS best_with_other_director
              FROM  (
                      SELECT mc."PID"                 AS actor_id,
                             md."PID"                 AS director_id,
                             COUNT(DISTINCT mc."MID") AS num_movies
                      FROM   "M_Cast"     AS mc
                      JOIN   "M_Director" AS md ON md."MID" = mc."MID"
                      JOIN   "Person"     AS d  ON d."PID"  = md."PID"
                      WHERE  d."Name" NOT LIKE '%Yash%Chopra%'   -- exclude Yash Chopra
                      GROUP  BY actor_id,
                                director_id
                    )
              GROUP BY actor_id
            ) AS o
         ON o.actor_id = y.actor_id
       WHERE y.yash_collabs > IFNULL(o.best_with_other_director, 0)
     );
```
