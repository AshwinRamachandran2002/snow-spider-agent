               a."Name"                 AS actor_name,
               COUNT(DISTINCT mc."MID") AS yash_collabs
       FROM    "M_Cast" AS mc
       JOIN    "Person" AS a ON a."PID" = TRIM(mc."PID")
       WHERE   mc."MID" IN (SELECT "MID"
                            FROM   "M_Director"
                            WHERE  "PID" = 'nm0007181')
       GROUP BY actor_id,
                actor_name
     ) AS y
LEFT JOIN (
       SELECT  actor_id,
               MAX(num_movies) AS best_with_other_director
       FROM   (
               SELECT  TRIM(mc."PID")           AS actor_id,
                       md."PID"                 AS director_id,
                       COUNT(DISTINCT mc."MID") AS num_movies
               FROM    "M_Cast" AS mc
               JOIN    "M_Director" AS md ON md."MID" = mc."MID"
               WHERE   md."PID" <> 'nm0007181'
               GROUP BY actor_id,
                        director_id
             )
       GROUP BY actor_id
     ) AS o  ON o.actor_id = y.actor_id
WHERE  y.yash_collabs > IFNULL(o.best_with_other_director, 0)
LIMIT 20
