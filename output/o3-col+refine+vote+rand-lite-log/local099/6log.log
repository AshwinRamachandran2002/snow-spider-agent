```sql
--Description: 1) Find Yash Chopra’s person-id (PID) in the Person table  
SELECT DISTINCT "PID", "Name"
FROM "Person"
WHERE "Name" LIKE '%Yash%Chopra%'
LIMIT 20;
```

```sql
--Description: 2) List the first 20 movies directed by Yash Chopra  
SELECT DISTINCT "MID"
FROM "M_Director"
WHERE "PID" IN (SELECT "PID"
                FROM "Person"
                WHERE "Name" LIKE '%Yash%Chopra%')
LIMIT 20;
```

```sql
--Description: 3) Show the first 20 actors who appear in Yash Chopra–directed movies  
SELECT DISTINCT "M_Cast"."PID" AS "Actor_PID"
FROM "M_Cast"
WHERE "MID" IN (SELECT DISTINCT "MID"
                FROM "M_Director"
                WHERE "PID" IN (SELECT "PID"
                                FROM "Person"
                                WHERE "Name" LIKE '%Yash%Chopra%'))
LIMIT 20;
```

```sql
--Description: 4) Count how many Yash-Chopra films every actor has appeared in (top 20 rows)  
SELECT "M_Cast"."PID"  AS "Actor_PID",
       COUNT(DISTINCT "M_Cast"."MID") AS "Yash_Films"
FROM   "M_Cast"
WHERE  "M_Cast"."MID" IN (SELECT DISTINCT "MID"
                          FROM "M_Director"
                          WHERE "PID" IN (SELECT "PID"
                                          FROM "Person"
                                          WHERE "Name" LIKE '%Yash%Chopra%'))
GROUP BY "M_Cast"."PID"
ORDER BY "Yash_Films" DESC
LIMIT 20;
```

```sql
--Description: 5) Count how many films every actor has done with every OTHER director (top 20 rows)  
SELECT mc."PID"  AS "Actor_PID",
       md."PID"  AS "Other_Director_PID",
       COUNT(DISTINCT mc."MID") AS "Films_Together"
FROM   "M_Cast"     AS mc
JOIN   "M_Director" AS md
       ON mc."MID" = md."MID"
WHERE  md."PID" NOT IN (SELECT "PID"
                        FROM "Person"
                        WHERE "Name" LIKE '%Yash%Chopra%')
GROUP BY mc."PID", md."PID"
ORDER BY "Films_Together" DESC
LIMIT 20;
```

```sql
--Description: 6) For every actor, take the maximum number of films made with a single non-Yash director  
WITH other_counts AS (
  SELECT mc."PID" AS "Actor_PID",
         md."PID" AS "Director_PID",
         COUNT(DISTINCT mc."MID") AS "Films_Together"
  FROM   "M_Cast"     AS mc
  JOIN   "M_Director" AS md
         ON mc."MID" = md."MID"
  WHERE  md."PID" NOT IN (SELECT "PID"
                          FROM "Person"
                          WHERE "Name" LIKE '%Yash%Chopra%')
  GROUP BY mc."PID", md."PID"
)
SELECT "Actor_PID",
       MAX("Films_Together") AS "Max_Other_Films"
FROM   other_counts
GROUP BY "Actor_PID"
LIMIT 20;
```

```sql
--Description: 7) List actors who have done MORE films with Yash Chopra than with any other director  
WITH yash_pid AS (
     SELECT "PID"
     FROM "Person"
     WHERE "Name" LIKE '%Yash%Chopra%'
),
yash_movies AS (
     SELECT "MID"
     FROM "M_Director"
     WHERE "PID" IN (SELECT "PID" FROM yash_pid)
),
yash_actor_counts AS (
     SELECT mc."PID" AS "Actor_PID",
            COUNT(DISTINCT mc."MID") AS "Yash_Films"
     FROM   "M_Cast" AS mc
     WHERE  mc."MID" IN (SELECT "MID" FROM yash_movies)
     GROUP BY mc."PID"
),
other_counts AS (
     SELECT mc."PID" AS "Actor_PID",
            md."PID" AS "Director_PID",
            COUNT(DISTINCT mc."MID") AS "Films_Together"
     FROM   "M_Cast"     AS mc
     JOIN   "M_Director" AS md
            ON mc."MID" = md."MID"
     WHERE  md."PID" NOT IN (SELECT "PID" FROM yash_pid)
     GROUP BY mc."PID", md."PID"
),
max_other AS (
     SELECT "Actor_PID",
            MAX("Films_Together") AS "Max_Other_Films"
     FROM   other_counts
     GROUP BY "Actor_PID"
)
SELECT y."Actor_PID"
FROM   yash_actor_counts AS y
LEFT JOIN max_other AS m
       ON y."Actor_PID" = m."Actor_PID"
WHERE  y."Yash_Films" > IFNULL(m."Max_Other_Films", 0)
LIMIT 20;
```

```sql
--Description: 8) Finally, count how many such actors exist (the required answer)  
WITH yash_pid AS (
     SELECT "PID"
     FROM "Person"
     WHERE "Name" LIKE '%Yash%Chopra%'
),
yash_movies AS (
     SELECT "MID"
     FROM "M_Director"
     WHERE "PID" IN (SELECT "PID" FROM yash_pid)
),
yash_actor_counts AS (
     SELECT mc."PID" AS "Actor_PID",
            COUNT(DISTINCT mc."MID") AS "Yash_Films"
     FROM   "M_Cast" AS mc
     WHERE  mc."MID" IN (SELECT "MID" FROM yash_movies)
     GROUP BY mc."PID"
),
other_counts AS (
     SELECT mc."PID" AS "Actor_PID",
            md."PID" AS "Director_PID",
            COUNT(DISTINCT mc."MID") AS "Films_Together"
     FROM   "M_Cast"     AS mc
     JOIN   "M_Director" AS md
            ON mc."MID" = md."MID"
     WHERE  md."PID" NOT IN (SELECT "PID" FROM yash_pid)
     GROUP BY mc."PID", md."PID"
),
max_other AS (
     SELECT "Actor_PID",
            MAX("Films_Together") AS "Max_Other_Films"
     FROM   other_counts
     GROUP BY "Actor_PID"
)
SELECT COUNT(*) AS "Num_Actors_With_More_Films_With_Yash_Chopra"
FROM (
     SELECT y."Actor_PID"
     FROM   yash_actor_counts AS y
     LEFT JOIN max_other AS m
            ON y."Actor_PID" = m."Actor_PID"
     WHERE  y."Yash_Films" > IFNULL(m."Max_Other_Films", 0)
) AS q;
```

