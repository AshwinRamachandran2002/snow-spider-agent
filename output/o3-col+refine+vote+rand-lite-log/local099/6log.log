Query:
--Description: 6) For every actor, take the maximum number of films made with a single non-Yash director  
WITH other_counts AS (
  SELECT mc."PID" AS "Actor_PID",
         md."PID" AS "Director_PID",
         COUNT(DISTINCT mc."MID") AS "Films_Together"
  FROM   "M_Cast"     AS mc
  JOIN   "M_Director" AS md
         ON mc."MID" = md."MID"
  WHERE  md."PID" NOT IN (SELECT "PID"
                          FROM "Person"
                          WHERE "Name" LIKE '%Yash%Chopra%')
  GROUP BY mc."PID", md."PID"
)
SELECT "Actor_PID",
       MAX("Films_Together") AS "Max_Other_Films"
FROM   other_counts
GROUP BY "Actor_PID"
LIMIT 20;
