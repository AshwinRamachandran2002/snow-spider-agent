    GROUP  BY actor_PID
),
other_dir_counts AS (       -- max films the same actor did with any *other* director
    SELECT actor_PID,
           MAX(films_together) AS max_with_other_dir
    FROM (
        SELECT TRIM(c."PID")  AS actor_PID,
               TRIM(d."PID")  AS director_PID,
               COUNT(*)       AS films_together
        FROM   "M_Cast"     AS c
