         COUNT(*) AS yc_movie_cnt
  FROM   "M_Cast"     AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  WHERE  d."PID" = 'nmXXXXXXX'          -- Yash Chopra’s PID
  GROUP BY c."PID"
),
other_best AS (
  SELECT actor_PID,
         MAX(n_movies) AS max_with_other
  FROM (
        SELECT c."PID" AS actor_PID,
               d."PID" AS director_PID,
               COUNT(*) AS n_movies
        FROM   "M_Cast"     AS c
        JOIN   "M_Director" AS d ON d."MID" = c."MID"
        WHERE  d."PID" <> 'nmXXXXXXX'      -- exclude Yash Chopra
        GROUP BY c."PID", d."PID"
       )
  GROUP BY actor_PID
)
SELECT yc.actor_PID, p."Name"
