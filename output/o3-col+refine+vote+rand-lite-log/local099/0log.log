--Description: Combine each actor’s Yash-Chopra film count with that actor’s best (max) collaboration count with any other director.
WITH yc_counts AS (
  SELECT TRIM(c."PID") AS actor_PID,
         COUNT(*)      AS yc_movie_cnt
  FROM   "M_Cast"     AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  WHERE  d."PID" = 'nm0007181'
  GROUP  BY actor_PID
),
other_best AS (
  SELECT actor_PID,
         MAX(n_movies) AS max_with_other
  FROM (
        SELECT TRIM(c."PID") AS actor_PID,
               TRIM(d."PID") AS director_PID,
               COUNT(*)      AS n_movies
        FROM   "M_Cast"     AS c
        JOIN   "M_Director" AS d ON d."MID" = c."MID"
        WHERE  d."PID" <> 'nm0007181'
        GROUP  BY actor_PID, director_PID
       )
  GROUP  BY actor_PID
)
SELECT yc.actor_PID,
       yc.yc_movie_cnt,
       COALESCE(ob.max_with_other, 0) AS max_with_other
FROM   yc_counts AS yc
LEFT  JOIN other_best AS ob ON ob.actor_PID = yc.actor_PID
LIMIT 20
