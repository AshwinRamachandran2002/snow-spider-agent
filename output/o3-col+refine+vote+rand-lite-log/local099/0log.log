WITH yc_counts AS (         -- films each actor did with director Yash Chopra
    SELECT TRIM(c."PID") AS actor_PID,
           COUNT(*)      AS yash_chopra_films
    FROM   "M_Cast"     AS c
    JOIN   "M_Director" AS d
