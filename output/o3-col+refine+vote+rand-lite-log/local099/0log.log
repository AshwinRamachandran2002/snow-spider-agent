FROM "Person"
WHERE "Name" LIKE '%Yash Chopra%'
LIMIT 20;
```

```sql
-- 2) All movies directed by Yash Chopra (using the PID found above)
SELECT DISTINCT d."MID", m."title", m."year"
FROM "M_Director" AS d
JOIN "Movie" AS m ON m."MID" = d."MID"
WHERE d."PID" = 'nmXXXXXXX'          -- replace with Yash Chopra’s PID
LIMIT 20;
```

```sql
-- 3) Cast members of Yash Chopra–directed films
SELECT DISTINCT c."PID" AS "actor_PID", p."Name", c."MID"
FROM "M_Cast"     AS c
JOIN "Person"     AS p ON p."PID" = c."PID"
JOIN "M_Director" AS d ON d."MID" = c."MID"
WHERE d."PID" = 'nmXXXXXXX'          -- Yash Chopra’s PID
LIMIT 20;
```

```sql
-- 4) How many Yash Chopra movies each actor has appeared in
SELECT c."PID"          AS "actor_PID",
       COUNT(*)         AS "yc_movie_cnt"
FROM   "M_Cast"     AS c
JOIN   "M_Director" AS d ON d."MID" = c."MID"
WHERE  d."PID" = 'nmXXXXXXX'         -- Yash Chopra’s PID
GROUP BY c."PID"
LIMIT 20;
```

```sql
-- 5) For every actor-director pair: total number of shared films
SELECT c."PID"               AS "actor_PID",
       d."PID"               AS "director_PID",
       COUNT(*)              AS "n_movies_together"
FROM   "M_Cast"     AS c
JOIN   "M_Director" AS d ON d."MID" = c."MID"
GROUP BY c."PID", d."PID"
LIMIT 20;
```

```sql
-- 6) For each actor: the most-frequent collaboration count with directors OTHER than Yash Chopra
WITH actor_dir AS (
  SELECT c."PID"   AS actor_PID,
         d."PID"   AS director_PID,
         COUNT(*)  AS n_movies
  FROM   "M_Cast"     AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  WHERE  d."PID" <> 'nmXXXXXXX'          -- exclude Yash Chopra
  GROUP BY c."PID", d."PID"
)
SELECT actor_PID,
       MAX(n_movies) AS max_with_other_dir
FROM   actor_dir
GROUP BY actor_PID
LIMIT 20;
```

```sql
-- 7) Combine Yash Chopra counts with each actor’s best non-YC director count
WITH yc_counts AS (
  SELECT c."PID" AS actor_PID,
         COUNT(*) AS yc_movie_cnt
  FROM   "M_Cast"     AS c
  JOIN   "M_Director" AS d ON d."MID" = c."MID"
  WHERE  d."PID" = 'nmXXXXXXX'          -- Yash Chopra’s PID
  GROUP BY c."PID"
),
other_best AS (
  SELECT actor_PID,
         MAX(n_movies) AS max_with_other
  FROM (
        SELECT c."PID" AS actor_PID,
               d."PID" AS director_PID,
               COUNT(*) AS n_movies
        FROM   "M_Cast"     AS c
        JOIN   "M_Director" AS d ON d."MID" = c."MID"
        WHERE  d."PID" <> 'nmXXXXXXX'      -- exclude Yash Chopra
        GROUP BY c."PID", d."PID"
       )
  GROUP BY actor_PID
)
SELECT yc.actor_PID,
       yc.yc_movie_cnt,
       COALESCE(ob.max_with_other, 0) AS max_with_other
FROM   yc_counts AS yc
LEFT JOIN other_best AS ob ON ob.actor_PID = yc.actor_PID
LIMIT 20;
```

```sql
-- 8) Actors whose count with Yash Chopra is strictly greater than with any other director
