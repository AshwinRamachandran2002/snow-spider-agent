--Description: 6) Identify every new user’s FIRST session-date in the window  
WITH first_visit AS (
  /* grab the very first session for each new visitor using ARRAY_AGG-ordering
     (avoids STRUCT-aggregate problems)                                        */
  SELECT
    fullVisitorId,
    ARRAY_AGG(date ORDER BY visitStartTime ASC LIMIT 1)[OFFSET(0)] AS first_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
        AND totals.newVisits = 1
  GROUP BY fullVisitorId
)
SELECT *
FROM   first_visit
LIMIT 20
