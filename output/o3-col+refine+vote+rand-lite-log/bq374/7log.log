Query:
--Description: 8) Users that made at least one purchase AFTER their first visit  
WITH first_date AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
        AND totals.newVisits = 1
  GROUP BY fullVisitorId
)
SELECT DISTINCT
  s.fullVisitorId,
  s.date                AS purchase_date,
  s.totals.transactions AS txn_cnt
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
JOIN first_date AS f
  ON s.fullVisitorId = f.fullVisitorId
WHERE s.date  > f.first_date
  AND s.totals.transactions IS NOT NULL
LIMIT 20
