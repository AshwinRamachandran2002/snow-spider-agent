Query:
--Description: 4) Grab NEW-user sessions whose first visit already lasted > 5 minutes  
SELECT
  fullVisitorId ,
  date ,
  totals.timeOnSite AS seconds_on_site
FROM  `bigquery-public-data.google_analytics_sample.ga_sessions_*`
