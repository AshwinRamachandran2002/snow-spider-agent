Query:
--Description: 7) Users whose very first session lasted > 5 min  
WITH first_session AS (
  SELECT
    fullVisitorId,
    date,
    totals.timeOnSite                     AS seconds_on_site,
    ROW_NUMBER() OVER (PARTITION BY fullVisitorId ORDER BY visitStartTime) AS rn
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE _TABLE_SUFFIX BETWEEN '20160801' AND '20170430'
        AND totals.newVisits = 1
)
SELECT
  fullVisitorId,
  date,
  seconds_on_site
FROM first_session
WHERE rn = 1
  AND seconds_on_site > 300
LIMIT 20
