SELECT
  _TABLE_SUFFIX                        AS table_day ,
  date ,
  fullVisitorId ,
  visitId ,
  visitNumber ,
  totals.newVisits                     AS is_new_user ,
  totals.timeOnSite                   AS seconds_on_site ,
  totals.transactions                  AS txn_cnt
