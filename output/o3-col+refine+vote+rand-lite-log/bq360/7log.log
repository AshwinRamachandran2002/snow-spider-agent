-- Description:  Retrieve the TOP-10 most common specializations by distinct NPI count
WITH spec_counts AS (
  SELECT
    specialization,
    COUNT(DISTINCT npi) AS npi_cnt
  FROM (
    SELECT DISTINCT
      npi,
      specialization
    FROM (
      SELECT
        u.npi,
        r.specialization
      FROM (
          SELECT
            npi,
            taxonomy_code
