  FROM (
    SELECT
      npi,
      t.specialization
    FROM `bigquery-public-data.nppes.npi_optimized`,
    UNNEST([
      STRUCT(healthcare_provider_taxonomy_code_1  AS code, healthcare_provider_taxonomy_1_specialization  AS specialization),
      STRUCT(healthcare_provider_taxonomy_code_2  ,        healthcare_provider_taxonomy_2_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_3  ,        healthcare_provider_taxonomy_3_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_4  ,        healthcare_provider_taxonomy_4_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_5  ,        healthcare_provider_taxonomy_5_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_6  ,        healthcare_provider_taxonomy_6_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_7  ,        healthcare_provider_taxonomy_7_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_8  ,        healthcare_provider_taxonomy_8_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_9  ,        healthcare_provider_taxonomy_9_specialization  ),
      STRUCT(healthcare_provider_taxonomy_code_10 ,        healthcare_provider_taxonomy_10_specialization ),
      STRUCT(healthcare_provider_taxonomy_code_11 ,        healthcare_provider_taxonomy_11_specialization ),
      STRUCT(healthcare_provider_taxonomy_code_12 ,        healthcare_provider_taxonomy_12_specialization ),
      STRUCT(healthcare_provider_taxonomy_code_13 ,        healthcare_provider_taxonomy_13_specialization ),
      STRUCT(healthcare_provider_taxonomy_code_14 ,        healthcare_provider_taxonomy_14_specialization ),
      STRUCT(healthcare_provider_taxonomy_code_15 ,        healthcare_provider_taxonomy_15_specialization )
    ]) AS t
    WHERE UPPER(provider_business_practice_location_address_city_name) = 'MOUNTAIN VIEW'
      AND provider_business_practice_location_address_state_name = 'CA'
      AND t.code IS NOT NULL AND t.code <> ''
      AND t.specialization IS NOT NULL AND t.specialization <> ''
  ) t
  GROUP BY t.specialization
  ORDER BY npi_cnt DESC
  LIMIT 10
), avg_val AS (
  SELECT AVG(npi_cnt) AS avg_cnt FROM top10
)
SELECT
  top10.specialization,
  top10.npi_cnt,
  avg_val.avg_cnt,
  ABS(top10.npi_cnt - avg_val.avg_cnt) AS diff_from_avg
FROM top10, avg_val
ORDER BY diff_from_avg
LIMIT 1;
