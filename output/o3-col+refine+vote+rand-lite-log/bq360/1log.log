    STRUCT(healthcare_provider_taxonomy_code_7  ,        healthcare_provider_taxonomy_7_specialization  ),
    STRUCT(healthcare_provider_taxonomy_code_8  ,        healthcare_provider_taxonomy_8_specialization  ),
    STRUCT(healthcare_provider_taxonomy_code_9  ,        healthcare_provider_taxonomy_9_specialization  ),
    STRUCT(healthcare_provider_taxonomy_code_10 ,        healthcare_provider_taxonomy_10_specialization ),
    STRUCT(healthcare_provider_taxonomy_code_11 ,        healthcare_provider_taxonomy_11_specialization ),
    STRUCT(healthcare_provider_taxonomy_code_12 ,        healthcare_provider_taxonomy_12_specialization ),
    STRUCT(healthcare_provider_taxonomy_code_13 ,        healthcare_provider_taxonomy_13_specialization ),
    STRUCT(healthcare_provider_taxonomy_code_14 ,        healthcare_provider_taxonomy_14_specialization ),
    STRUCT(healthcare_provider_taxonomy_code_15 ,        healthcare_provider_taxonomy_15_specialization )
  ]) AS t
