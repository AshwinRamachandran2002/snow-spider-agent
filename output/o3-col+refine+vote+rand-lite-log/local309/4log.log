Query:
-- Description: 9) Rank constructors within every season and keep the best one.
SELECT DISTINCT year,
       constructor_id,
       season_points,
       RANK() OVER (PARTITION BY year ORDER BY season_points DESC) AS cons_rank
FROM (
     SELECT r.year,
            cr.constructor_id,
            SUM(cr.points) AS season_points
     FROM constructor_results cr
     JOIN races r ON r.race_id = cr.race_id
     GROUP BY r.year, cr.constructor_id
) AS t
ORDER BY year, cons_rank
LIMIT 20;
