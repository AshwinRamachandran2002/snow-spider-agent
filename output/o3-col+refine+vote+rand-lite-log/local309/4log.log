Query:
-- Description: 8) Aggregate each constructor’s points over a season.
SELECT DISTINCT r.year,
       cr.constructor_id,
       SUM(cr.points) AS season_points
FROM constructor_results cr
JOIN races             AS r ON r.race_id = cr.race_id
GROUP BY r.year, cr.constructor_id
ORDER BY r.year, season_points DESC
LIMIT 20;
