Query:
-- Description: 10) Final answer – for each year, show the highest-scoring driver (full name) 
-- and highest-scoring constructor.
SELECT DISTINCT d_year.year,
       d_year.top_driver,
       d_year.driver_points,
       c_year.top_constructor,
       c_year.constructor_points
FROM
    -- top driver per season
    (
      SELECT year,
             drv.forename || ' ' || drv.surname AS top_driver,
             season_points AS driver_points
      FROM (
           SELECT r.year,
                  ds.driver_id,
                  SUM(ds.points) AS season_points,
                  RANK() OVER (PARTITION BY r.year ORDER BY SUM(ds.points) DESC) AS rk
           FROM driver_standings ds
           JOIN races r ON r.race_id = ds.race_id
           GROUP BY r.year, ds.driver_id
      ) AS y
      JOIN drivers drv ON drv.driver_id = y.driver_id
      WHERE y.rk = 1
    ) AS d_year
JOIN
    -- top constructor per season
    (
      SELECT year,
             cons.name AS top_constructor,
             season_points AS constructor_points
      FROM (
           SELECT r.year,
                  cr.constructor_id,
                  SUM(cr.points) AS season_points,
                  RANK() OVER (PARTITION BY r.year ORDER BY SUM(cr.points) DESC) AS rk
           FROM constructor_results cr
           JOIN races r ON r.race_id = cr.race_id
           GROUP BY r.year, cr.constructor_id
      ) AS y
      JOIN constructors cons ON cons.constructor_id = y.constructor_id
      WHERE y.rk = 1
    ) AS c_year
  ON d_year.year = c_year.year
ORDER BY d_year.year
LIMIT 20;
