Query:
-- Description: 6) Keep only the top-ranked (rank = 1) driver for every season and show the full name.
SELECT DISTINCT t.year,
       d.forename || ' ' || d.surname AS top_driver,
       t.season_points
FROM (
     SELECT year,
            driver_id,
            season_points,
            RANK() OVER (PARTITION BY year ORDER BY season_points DESC) AS drv_rank
     FROM (
          SELECT r.year,
                 ds.driver_id,
                 SUM(ds.points) AS season_points
          FROM driver_standings ds
          JOIN races r ON r.race_id = ds.race_id
          GROUP BY r.year, ds.driver_id
     )
) AS t
JOIN drivers d ON d.driver_id = t.driver_id
WHERE t.drv_rank = 1
ORDER BY t.year
LIMIT 20;
