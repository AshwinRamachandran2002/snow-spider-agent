Query:
-- Description: 5) Add a window-rank so we can later isolate the best scoring driver of each year.
SELECT DISTINCT year,
       driver_id,
       season_points,
       RANK() OVER (PARTITION BY year ORDER BY season_points DESC) AS drv_rank
FROM (
     SELECT r.year,
            ds.driver_id,
            SUM(ds.points) AS season_points
     FROM driver_standings ds
     JOIN races r ON r.race_id = ds.race_id
     GROUP BY r.year, ds.driver_id
) AS t
ORDER BY year, drv_rank
LIMIT 20;
