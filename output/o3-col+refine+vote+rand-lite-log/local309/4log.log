```sql
-- Description: 1) Peek at the list of drivers together with a handy full-name field.
SELECT DISTINCT driver_id,
       forename || ' ' || surname AS full_name,
       nationality
FROM drivers
LIMIT 20;
```

```sql
-- Description: 2) Look at which race-ids belong to which season (year).
SELECT DISTINCT race_id,
       year,
       round,
       name
FROM races
ORDER BY year, round
LIMIT 20;
```

```sql
-- Description: 3) Glimpse at the raw driver-standings points that are recorded per race.
SELECT DISTINCT driver_standings_id,
       race_id,
       driver_id,
       points,
       position
FROM driver_standings
LIMIT 20;
```

```sql
-- Description: 4) Aggregate every driver’s total points over a whole season.
SELECT DISTINCT r.year,
       ds.driver_id,
       SUM(ds.points) AS season_points
FROM driver_standings AS ds
JOIN races            AS r  ON r.race_id = ds.race_id
GROUP BY r.year, ds.driver_id
ORDER BY r.year, season_points DESC
LIMIT 20;
```

```sql
-- Description: 5) Add a window-rank so we can later isolate the best scoring driver of each year.
SELECT DISTINCT year,
       driver_id,
       season_points,
       RANK() OVER (PARTITION BY year ORDER BY season_points DESC) AS drv_rank
FROM (
     SELECT r.year,
            ds.driver_id,
            SUM(ds.points) AS season_points
     FROM driver_standings ds
     JOIN races r ON r.race_id = ds.race_id
     GROUP BY r.year, ds.driver_id
) AS t
ORDER BY year, drv_rank
LIMIT 20;
```

```sql
-- Description: 6) Keep only the top-ranked (rank = 1) driver for every season and show the full name.
SELECT DISTINCT t.year,
       d.forename || ' ' || d.surname AS top_driver,
       t.season_points
FROM (
     SELECT year,
            driver_id,
            season_points,
            RANK() OVER (PARTITION BY year ORDER BY season_points DESC) AS drv_rank
     FROM (
          SELECT r.year,
                 ds.driver_id,
                 SUM(ds.points) AS season_points
          FROM driver_standings ds
          JOIN races r ON r.race_id = ds.race_id
          GROUP BY r.year, ds.driver_id
     )
) AS t
JOIN drivers d ON d.driver_id = t.driver_id
WHERE t.drv_rank = 1
ORDER BY t.year
LIMIT 20;
```

```sql
-- Description: 7) Inspect the constructor-level points that are recorded per race.
SELECT DISTINCT constructor_results_id,
       race_id,
       constructor_id,
       points
FROM constructor_results
LIMIT 20;
```

```sql
-- Description: 8) Aggregate each constructor’s points over a season.
SELECT DISTINCT r.year,
       cr.constructor_id,
       SUM(cr.points) AS season_points
FROM constructor_results cr
JOIN races             AS r ON r.race_id = cr.race_id
GROUP BY r.year, cr.constructor_id
ORDER BY r.year, season_points DESC
LIMIT 20;
```

```sql
-- Description: 9) Rank constructors within every season and keep the best one.
SELECT DISTINCT year,
       constructor_id,
       season_points,
       RANK() OVER (PARTITION BY year ORDER BY season_points DESC) AS cons_rank
FROM (
     SELECT r.year,
            cr.constructor_id,
            SUM(cr.points) AS season_points
     FROM constructor_results cr
     JOIN races r ON r.race_id = cr.race_id
     GROUP BY r.year, cr.constructor_id
) AS t
ORDER BY year, cons_rank
LIMIT 20;
```

```sql
-- Description: 10) Final answer – for each year, show the highest-scoring driver (full name) 
-- and highest-scoring constructor.
SELECT DISTINCT d_year.year,
       d_year.top_driver,
       d_year.driver_points,
       c_year.top_constructor,
       c_year.constructor_points
FROM
    -- top driver per season
    (
      SELECT year,
             drv.forename || ' ' || drv.surname AS top_driver,
             season_points AS driver_points
      FROM (
           SELECT r.year,
                  ds.driver_id,
                  SUM(ds.points) AS season_points,
                  RANK() OVER (PARTITION BY r.year ORDER BY SUM(ds.points) DESC) AS rk
           FROM driver_standings ds
           JOIN races r ON r.race_id = ds.race_id
           GROUP BY r.year, ds.driver_id
      ) AS y
      JOIN drivers drv ON drv.driver_id = y.driver_id
      WHERE y.rk = 1
    ) AS d_year
JOIN
    -- top constructor per season
    (
      SELECT year,
             cons.name AS top_constructor,
             season_points AS constructor_points
      FROM (
           SELECT r.year,
                  cr.constructor_id,
                  SUM(cr.points) AS season_points,
                  RANK() OVER (PARTITION BY r.year ORDER BY SUM(cr.points) DESC) AS rk
           FROM constructor_results cr
           JOIN races r ON r.race_id = cr.race_id
           GROUP BY r.year, cr.constructor_id
      ) AS y
      JOIN constructors cons ON cons.constructor_id = y.constructor_id
      WHERE y.rk = 1
    ) AS c_year
  ON d_year.year = c_year.year
ORDER BY d_year.year
LIMIT 20;
```
