Query:
-- 5) Add full driver name to the previous result
SELECT r."year",
       (d."forename" || ' ' || d."surname") AS "driver_full_name",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
JOIN  (SELECT "year", MAX("round") AS max_round
       FROM   "races"
       GROUP  BY "year") AS last  ON last."year" = r."year"
                                 AND last.max_round = r."round"
JOIN   "drivers"          AS d  ON d."driver_id"  = ds."driver_id"
WHERE  ds."position" = 1
ORDER BY r."year"
LIMIT 20;
