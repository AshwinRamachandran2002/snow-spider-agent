```sql
-- 1) Overview of the seasons we have
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 2) A look at one season’s race calendar (2009 as an example)
SELECT "race_id", "year", "round", "name"
FROM "races"
WHERE "year" = 2009
ORDER BY "round"
LIMIT 20;
```

```sql
-- 3) Driver-standings entries joined to their race year & round
SELECT ds."driver_standings_id",
       r."year",
       r."round",
       ds."driver_id",
       ds."points",
       ds."position"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
ORDER BY r."year", r."round", ds."position"
LIMIT 20;
```

```sql
-- 4) Driver-standings for the last round of each season (champions should have position = 1)
SELECT r."year",
       r."round",
       ds."driver_id",
       ds."points",
       ds."position"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
JOIN  (SELECT "year", MAX("round") AS max_round
       FROM   "races"
       GROUP  BY "year") AS last  ON last."year" = r."year"
                                 AND last.max_round = r."round"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 5) Add full driver name to the previous result
SELECT r."year",
       (d."forename" || ' ' || d."surname") AS "driver_full_name",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
JOIN  (SELECT "year", MAX("round") AS max_round
       FROM   "races"
       GROUP  BY "year") AS last  ON last."year" = r."year"
                                 AND last.max_round = r."round"
JOIN   "drivers"          AS d  ON d."driver_id"  = ds."driver_id"
WHERE  ds."position" = 1
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 6) Constructor-standings for the last round of each season (position = 1)
SELECT r."year",
       cs."constructor_id",
       cs."points"
FROM   "constructor_standings" AS cs
JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
JOIN  (SELECT "year", MAX("round") AS max_round
       FROM   "races"
       GROUP  BY "year") AS last   ON last."year" = r."year"
                                   AND last.max_round = r."round"
WHERE  cs."position" = 1
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 7) Attach constructor (team) names to the previous query
SELECT r."year",
       c."name"  AS "constructor_name",
       cs."points"
FROM   "constructor_standings" AS cs
JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
JOIN  (SELECT "year", MAX("round") AS max_round
       FROM   "races"
       GROUP  BY "year") AS last   ON last."year" = r."year"
                                   AND last.max_round = r."round"
JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
WHERE  cs."position" = 1
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 8) Combine season champion driver & constructor in a single view
SELECT dres."year",
       dres."driver_full_name",
       cres."constructor_name"
FROM (
       SELECT r."year",
              (d."forename" || ' ' || d."surname") AS "driver_full_name"
       FROM   "driver_standings" AS ds
       JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
       JOIN  (SELECT "year", MAX("round") AS max_round
              FROM   "races"
              GROUP  BY "year") AS last  ON last."year" = r."year"
                                        AND last.max_round = r."round"
       JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
       WHERE  ds."position" = 1
) AS dres
JOIN (
       SELECT r."year",
              c."name" AS "constructor_name"
       FROM   "constructor_standings" AS cs
       JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
       JOIN  (SELECT "year", MAX("round") AS max_round
              FROM   "races"
              GROUP  BY "year") AS last   ON last."year" = r."year"
                                         AND last.max_round = r."round"
       JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
       WHERE  cs."position" = 1
) AS cres
ON  dres."year" = cres."year"
ORDER BY dres."year"
LIMIT 20;
```

```sql
-- 9) Final answer for every season in the database (no LIMIT)
SELECT dres."year",
       dres."driver_full_name",
       cres."constructor_name"
FROM (
       SELECT r."year",
              (d."forename" || ' ' || d."surname") AS "driver_full_name"
       FROM   "driver_standings" AS ds
       JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
       JOIN  (SELECT "year", MAX("round") AS max_round
              FROM   "races"
              GROUP  BY "year") AS last  ON last."year" = r."year"
                                        AND last.max_round = r."round"
       JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
       WHERE  ds."position" = 1
) AS dres
JOIN (
       SELECT r."year",
              c."name" AS "constructor_name"
       FROM   "constructor_standings" AS cs
       JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
       JOIN  (SELECT "year", MAX("round") AS max_round
              FROM   "races"
              GROUP  BY "year") AS last   ON last."year" = r."year"
                                         AND last.max_round = r."round"
       JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
       WHERE  cs."position" = 1
) AS cres
ON  dres."year" = cres."year"
ORDER BY dres."year";
```
