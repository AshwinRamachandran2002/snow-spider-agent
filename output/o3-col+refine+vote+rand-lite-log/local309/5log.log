```sql
-- Description: Distinct list of race years available in the data
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: A quick look at the 2009 driver-standings table (race_id 18 in sample)
SELECT DISTINCT "driver_standings_id",
       "race_id",
       "driver_id",
       "points",
       "position"
FROM "driver_standings"
WHERE "race_id" = 18
ORDER BY "points" DESC
LIMIT 20;
```

```sql
-- Description: Join driver-standings with races to see (year, driver_id, points) pairs
SELECT DISTINCT r."year",
       ds."driver_id",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
ORDER BY r."year", ds."points" DESC
LIMIT 20;
```

```sql
-- Description: Get each driver’s full name (concatenate forename + surname) to verify names
SELECT DISTINCT d."driver_id",
       d."forename" || ' ' || d."surname" AS "full_name",
       d."nationality"
FROM   "drivers" AS d
ORDER BY d."driver_id"
LIMIT 20;
```

```sql
-- Description: For 2009, list drivers ranked by total points (aggregated over the season)
SELECT DISTINCT r."year",
       d."forename" || ' ' || d."surname" AS "driver_full_name",
       SUM(ds."points")                    AS "season_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
WHERE  r."year" = 2009
GROUP  BY r."year", d."driver_id"
ORDER  BY "season_points" DESC
LIMIT 20;
```

```sql
-- Description: Use a window function to pick the top-scoring driver in every year
SELECT DISTINCT *
FROM (
    SELECT r."year",
           d."forename" || ' ' || d."surname" AS "driver_full_name",
           SUM(ds."points")                    AS "season_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(ds."points") DESC) AS rn
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
    JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", d."driver_id"
) AS t
WHERE  rn = 1
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: Similar aggregation for constructor-standings (single season example 2009)
SELECT DISTINCT r."year",
       c."name"              AS "constructor_name",
       SUM(cs."points")      AS "season_points"
FROM   "constructor_standings" AS cs
JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
WHERE  r."year" = 2009
GROUP  BY r."year", c."constructor_id"
ORDER  BY "season_points" DESC
LIMIT 20;
```

```sql
-- Description: Window-function variant to find the top constructor each year
SELECT DISTINCT *
FROM (
    SELECT r."year",
           c."name"           AS "constructor_name",
           SUM(cs."points")   AS "season_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(cs."points") DESC) AS rn
    FROM   "constructor_standings" AS cs
    JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
    JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", c."constructor_id"
) AS t
WHERE  rn = 1
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: Combine the two window queries to report (year, top-driver, top-constructor)
WITH top_drivers AS (
    SELECT r."year",
           d."forename" || ' ' || d."surname" AS "driver_full_name",
           SUM(ds."points")                    AS "driver_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(ds."points") DESC) AS rn
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
    JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", d."driver_id"
), top_constructors AS (
    SELECT r."year",
           c."name"           AS "constructor_name",
           SUM(cs."points")   AS "constructor_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(cs."points") DESC) AS rn
    FROM   "constructor_standings" AS cs
    JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
    JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", c."constructor_id"
)
SELECT DISTINCT td."year",
       td."driver_full_name",
       td."driver_points",
       tc."constructor_name",
       tc."constructor_points"
FROM   top_drivers      AS td
JOIN   top_constructors AS tc
       ON tc."year" = td."year"
WHERE  td.rn = 1
  AND  tc.rn = 1
ORDER  BY td."year"
LIMIT 20;
```

```sql
-- Description: Final compact answer without intermediate CTE names (all seasons)
SELECT DISTINCT *
FROM (
    SELECT r."year",
           d."forename" || ' ' || d."surname" AS "driver_full_name",
           SUM(ds."points")                    AS "driver_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(ds."points") DESC) AS drv_rank
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
    JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", d."driver_id"
) AS dwin
JOIN (
    SELECT r."year",
           c."name"           AS "constructor_name",
           SUM(cs."points")   AS "constructor_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(cs."points") DESC) AS con_rank
    FROM   "constructor_standings" AS cs
    JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
    JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", c."constructor_id"
) AS cwin
  ON cwin."year" = dwin."year"
WHERE dwin.drv_rank = 1
  AND cwin.con_rank = 1
ORDER BY dwin."year"
LIMIT 20;
```
