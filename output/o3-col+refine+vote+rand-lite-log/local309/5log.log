Query:
-- Description: Final compact answer without intermediate CTE names (all seasons)
SELECT DISTINCT *
FROM (
    SELECT r."year",
           d."forename" || ' ' || d."surname" AS "driver_full_name",
           SUM(ds."points")                    AS "driver_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(ds."points") DESC) AS drv_rank
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
    JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", d."driver_id"
) AS dwin
JOIN (
    SELECT r."year",
           c."name"           AS "constructor_name",
           SUM(cs."points")   AS "constructor_points",
           ROW_NUMBER() OVER (PARTITION BY r."year"
                              ORDER BY SUM(cs."points") DESC) AS con_rank
    FROM   "constructor_standings" AS cs
    JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
    JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", c."constructor_id"
) AS cwin
  ON cwin."year" = dwin."year"
WHERE dwin.drv_rank = 1
  AND cwin.con_rank = 1
ORDER BY dwin."year"
LIMIT 20;
Answer:
year,driver_full_name,driver_points,drv_rank,year,constructor_name,constructor_points,con_rank
