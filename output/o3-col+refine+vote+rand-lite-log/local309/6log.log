2025-05-05 04:58:17 - Thread-4191 (execute) - INFO - [Exploration]
Below are up-to-10 exploratory SQL queries (each limited to 20 rows) that progressively inspect the relevant columns and finally provide, for every season, the driver (full name) and the constructor that ended the year with the highest number of points.

```sql
-- 1. Distinct list of seasons we have results for
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 2. Quick look at the raw driver-standing rows
SELECT DISTINCT "driver_id", "race_id", "points"
FROM "driver_standings"
LIMIT 20;
```

```sql
-- 3. Map a driver-standing row to its season
SELECT DISTINCT ds."driver_id",
                r."year",
                ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
LIMIT 20;
```

```sql
-- 4. For each season, find the last (max-round) Grand Prix
SELECT r."year",
       MAX(r."round") AS "max_round"
FROM   "races" AS r
GROUP  BY r."year"
ORDER  BY r."year"
LIMIT 20;
```

```sql
-- 5. Final (post-season) driver standings for 2009, ordered by position
SELECT r."year",
       ds."driver_id",
       ds."points",
       ds."position"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
WHERE  r."year"  = 2009
  AND  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = 2009)
ORDER  BY ds."position"
LIMIT 20;
```

```sql
-- 6. Final (post-season) constructor standings for 2009, ordered by position
SELECT r."year",
       cs."constructor_id",
       cs."points",
       cs."position"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r  ON r."race_id" = cs."race_id"
WHERE  r."year"  = 2009
  AND  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = 2009)
ORDER  BY cs."position"
LIMIT 20;
```

```sql
-- 7. Drivers table: see how full names can be constructed
SELECT DISTINCT "driver_id",
       "forename" || ' ' || "surname" AS "driver_full_name"
FROM   "drivers"
LIMIT 20;
```

```sql
-- 8. Constructors table: verify the team names
SELECT DISTINCT "constructor_id",
       "name" AS "constructor_name"
FROM   "constructors"
LIMIT 20;
```

```sql
-- 9. Check who tops the driver points after the last race of a year (single season example)
SELECT r."year",
       ds."driver_id",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
WHERE  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
ORDER  BY r."year", ds."points" DESC
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER: For every season, the champion driver (full name) and champion constructor
SELECT DISTINCT r."year",
       drv."forename" || ' ' || drv."surname" AS "driver_full_name",
       cons."name"                             AS "constructor_name",
       ds."points"  AS "driver_points",
       cs."points"  AS "constructor_points"
FROM   "races"                 AS r
-- last round of each season
JOIN  (SELECT "year", MAX("round") AS "max_round"
       FROM   "races"
       GROUP  BY "year")        AS lr
           ON lr."year" = r."year" AND lr."max_round" = r."round"
-- standings tables
JOIN   "driver_standings"      AS ds  ON ds."race_id" = r."race_id"
JOIN   "constructor_standings" AS cs  ON cs."race_id" = r."race_id"
-- person & team look-ups
JOIN   "drivers"               AS drv ON drv."driver_id"      = ds."driver_id"
JOIN   "constructors"          AS cons ON cons."constructor_id" = cs."constructor_id"
-- keep only the driver(s) & constructor(s) with maximum seasonal points
WHERE  ds."points" = (SELECT MAX(ds2."points")
                      FROM   "driver_standings" AS ds2
                      JOIN   "races"            AS r2 ON r2."race_id" = ds2."race_id"
                      WHERE  r2."year"  = r."year"
                        AND  r2."round" = r."round")
  AND  cs."points" = (SELECT MAX(cs2."points")
                      FROM   "constructor_standings" AS cs2
                      JOIN   "races"                 AS r3 ON r3."race_id" = cs2."race_id"
                      WHERE  r3."year"  = r."year"
                        AND  r3."round" = r."round")
ORDER  BY r."year"
LIMIT 20;
```

Each query is distinct, builds upon the previous ones, and the last statement returns (per year) the full driver name and the constructor that scored the most points after the final event of that season.
