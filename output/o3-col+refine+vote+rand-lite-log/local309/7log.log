```sql
--Description: List a sample of all seasons we have results for.
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: Look at raw driver-standings points together with the year of the race.
SELECT r."year",
       ds."driver_id",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
LIMIT 20;
```

```sql
--Description: Join the driver table so we can read a driver’s full name for each standing line.
SELECT r."year",
       dex."full_name",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r   ON r."race_id"  = ds."race_id"
JOIN   "drivers_ext"      AS dex ON dex."driver_id" = ds."driver_id"
LIMIT 20;
```

```sql
--Description: Aggregate every driver’s total points by season (highest totals will appear first in each year block).
SELECT r."year",
       dex."full_name",
       SUM(ds."points") AS "total_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r   ON r."race_id"  = ds."race_id"
JOIN   "drivers_ext"      AS dex ON dex."driver_id" = ds."driver_id"
GROUP  BY r."year", dex."full_name"
ORDER  BY r."year", "total_points" DESC
LIMIT 20;
```

```sql
--Description: Preview constructor-standings points with the season attached.
SELECT r."year",
       cs."constructor_id",
       cs."points"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
LIMIT 20;
```

```sql
--Description: Aggregate every constructor’s total points by season.
SELECT r."year",
       c."name",
       SUM(cs."points") AS "total_points"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id"      = cs."race_id"
JOIN   "constructors"          AS c ON c."constructor_id" = cs."constructor_id"
GROUP  BY r."year", c."name"
ORDER  BY r."year", "total_points" DESC
LIMIT 20;
```

```sql
--Description: Identify the top-scoring driver(s) per season.
WITH driver_year_points AS (
    SELECT r."year",
           ds."driver_id",
           SUM(ds."points") AS "total_points"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id" = ds."race_id"
    GROUP  BY r."year", ds."driver_id"
),
max_driver_points AS (
    SELECT "year",
           MAX("total_points") AS "max_points"
    FROM   driver_year_points
    GROUP  BY "year"
)
SELECT dyp."year",
       dex."full_name",
       dyp."total_points"
FROM   driver_year_points AS dyp
JOIN   max_driver_points  AS mdp ON mdp."year" = dyp."year"
                                 AND mdp."max_points" = dyp."total_points"
JOIN   "drivers_ext"      AS dex ON dex."driver_id" = dyp."driver_id"
ORDER  BY dyp."year"
LIMIT 20;
```

```sql
--Description: Identify the top-scoring constructor(s) per season.
WITH constructor_year_points AS (
    SELECT r."year",
           cs."constructor_id",
           SUM(cs."points") AS "total_points"
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
    GROUP  BY r."year", cs."constructor_id"
),
max_constructor_points AS (
    SELECT "year",
           MAX("total_points") AS "max_points"
    FROM   constructor_year_points
    GROUP  BY "year"
)
SELECT cyp."year",
       c."name",
       cyp."total_points"
FROM   constructor_year_points AS cyp
JOIN   max_constructor_points  AS mcp ON mcp."year" = cyp."year"
                                      AND mcp."max_points" = cyp."total_points"
JOIN   "constructors"          AS c   ON c."constructor_id" = cyp."constructor_id"
ORDER  BY cyp."year"
LIMIT 20;
```

```sql
--Description: Combine the two previous CTEs to show, for every season, the driver and constructor that scored the most points.
WITH driver_year_points AS (
    SELECT r."year",
           ds."driver_id",
           SUM(ds."points") AS "total_points"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id" = ds."race_id"
    GROUP  BY r."year", ds."driver_id"
),
top_driver AS (
    SELECT dyp."year",
           dyp."driver_id",
           dyp."total_points"
    FROM   driver_year_points AS dyp
    JOIN  (SELECT "year",
                  MAX("total_points") AS "max_points"
           FROM   driver_year_points
           GROUP  BY "year") AS mx
      ON  mx."year" = dyp."year"
     AND mx."max_points" = dyp."total_points"
),
constructor_year_points AS (
    SELECT r."year",
           cs."constructor_id",
           SUM(cs."points") AS "total_points"
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
    GROUP  BY r."year", cs."constructor_id"
),
top_constructor AS (
    SELECT cyp."year",
           cyp."constructor_id",
           cyp."total_points"
    FROM   constructor_year_points AS cyp
    JOIN  (SELECT "year",
                  MAX("total_points") AS "max_points"
           FROM   constructor_year_points
           GROUP  BY "year") AS mx
      ON  mx."year" = cyp."year"
     AND mx."max_points" = cyp."total_points"
)
SELECT td."year",
       dex."full_name"          AS "champion_driver",
       td."total_points"        AS "driver_pts",
       c."name"                 AS "champion_constructor",
       tc."total_points"        AS "constructor_pts"
FROM   top_driver      AS td
JOIN   "drivers_ext"   AS dex ON dex."driver_id"      = td."driver_id"
JOIN   top_constructor AS tc  ON tc."year"            = td."year"
JOIN   "constructors"  AS c   ON c."constructor_id"   = tc."constructor_id"
ORDER  BY td."year"
LIMIT 20;
```

```sql
--Description: (Optional) Show seasons where more than one driver or constructor tied for the most points.
WITH driver_year_points AS (
    SELECT r."year",
           ds."driver_id",
           SUM(ds."points") AS "total_points"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id" = ds."race_id"
    GROUP  BY r."year", ds."driver_id"
),
max_driver_points AS (
    SELECT "year",
           MAX("total_points") AS "max_points"
    FROM   driver_year_points
    GROUP  BY "year"
)
SELECT dyp."year",
       COUNT(*) AS "drivers_tied_for_most_points"
FROM   driver_year_points AS dyp
JOIN   max_driver_points  AS mdp ON mdp."year" = dyp."year"
                                 AND mdp."max_points" = dyp."total_points"
GROUP  BY dyp."year"
HAVING COUNT(*) > 1
LIMIT 20;
```
