    WHERE y."total_points" = (
            SELECT MAX(z."total_points")
            FROM   (
                     SELECT r4."year",
                            cs4."constructor_id",
                            SUM(cs4."points") AS "total_points"
                     FROM   "constructor_standings" AS cs4
                     JOIN   "races"                 AS r4 ON r4."race_id" = cs4."race_id"
                     WHERE  r4."year" = y."year"
                     GROUP  BY r4."year", cs4."constructor_id"
                   ) AS z
         )
)
SELECT d."year",
       d."driver_full_name",
       c."constructor_name"
FROM   driver_winners      AS d
JOIN   constructor_winners AS c ON c."year" = d."year"
ORDER  BY d."year"
LIMIT 20;
