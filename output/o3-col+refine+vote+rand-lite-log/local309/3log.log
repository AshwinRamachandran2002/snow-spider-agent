```sql
-- 9. Description: Combine the yearly top driver and top constructor into a single view (first 20 years shown).
WITH driver_winners AS (
    SELECT x."year",
           d."full_name" AS "driver_full_name",
           x."total_points"
    FROM  (
            SELECT r."year",
                   ds."driver_id",
                   SUM(ds."points") AS "total_points"
            FROM   "driver_standings" AS ds
            JOIN   "races"            AS r ON r."race_id" = ds."race_id"
            GROUP  BY r."year", ds."driver_id"
          ) AS x
    JOIN "drivers_ext" AS d ON d."driver_id" = x."driver_id"
    WHERE x."total_points" = (
            SELECT MAX(t."total_points")
            FROM   (
                     SELECT r3."year",
                            ds3."driver_id",
                            SUM(ds3."points") AS "total_points"
                     FROM   "driver_standings" AS ds3
                     JOIN   "races"            AS r3 ON r3."race_id" = ds3."race_id"
                     WHERE  r3."year" = x."year"
                     GROUP  BY r3."year", ds3."driver_id"
                   ) AS t
         )
),
constructor_winners AS (
    SELECT y."year",
           c."name" AS "constructor_name",
           y."total_points"
    FROM (
            SELECT r."year",
                   cs."constructor_id",
                   SUM(cs."points") AS "total_points"
            FROM   "constructor_standings" AS cs
            JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
            GROUP  BY r."year", cs."constructor_id"
         ) AS y
    JOIN "constructors" AS c ON c."constructor_id" = y."constructor_id"
    WHERE y."total_points" = (
            SELECT MAX(z."total_points")
            FROM   (
                     SELECT r4."year",
                            cs4."constructor_id",
                            SUM(cs4."points") AS "total_points"
                     FROM   "constructor_standings" AS cs4
                     JOIN   "races"                 AS r4 ON r4."race_id" = cs4."race_id"
                     WHERE  r4."year" = y."year"
                     GROUP  BY r4."year", cs4."constructor_id"
                   ) AS z
         )
)
SELECT d."year",
       d."driver_full_name",
       c."constructor_name"
FROM   driver_winners      AS d
JOIN   constructor_winners AS c ON c."year" = d."year"
ORDER  BY d."year"
LIMIT 20;
```

