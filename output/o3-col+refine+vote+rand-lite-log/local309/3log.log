LIMIT 20;
```

```sql
-- 5. Description: Aggregate total points each driver scored in every year (top 20 rows after ordering).
SELECT r."year",
       ds."driver_id",
       SUM(ds."points") AS "total_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
GROUP  BY r."year", ds."driver_id"
ORDER  BY r."year", "total_points" DESC
LIMIT 20;
```

```sql
-- 6. Description: For every year, pick the driver with the maximum summed points and attach the full name.
SELECT x."year",
       d."full_name",
       x."total_points"
FROM  (
        SELECT r."year",
               ds."driver_id",
               SUM(ds."points") AS "total_points"
        FROM   "driver_standings" AS ds
        JOIN   "races"            AS r ON r."race_id" = ds."race_id"
        GROUP  BY r."year", ds."driver_id"
      ) AS x
JOIN "drivers_ext" AS d ON d."driver_id" = x."driver_id"
WHERE x."total_points" = (
        SELECT MAX(y."total_points")
        FROM   (
                 SELECT r2."year",
                        ds2."driver_id",
                        SUM(ds2."points") AS "total_points"
                 FROM   "driver_standings" AS ds2
                 JOIN   "races"            AS r2 ON r2."race_id" = ds2."race_id"
                 WHERE  r2."year" = x."year"
                 GROUP  BY r2."year", ds2."driver_id"
               ) AS y
     )
ORDER BY x."year"
LIMIT 20;
```

```sql
