```sql
--Description: 1.  Peek at which seasons exist in the raw races table.  
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: 2.  Inspect how driver-standings rows map to races (to see year and points).  
SELECT r."year",
       ds."driver_id",
       ds."points",
       ds."wins"
FROM "driver_standings"  AS ds
JOIN "races"             AS r ON r."race_id" = ds."race_id"
ORDER BY r."year", ds."driver_id"
LIMIT 20;
```

```sql
--Description: 3.  Attach each driver’s full name (from drivers_ext) to one driver-standing sample.  
SELECT r."year",
       d."full_name",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id"  = ds."race_id"
JOIN   "drivers_ext"      AS d ON d."driver_id" = ds."driver_id"
ORDER  BY r."year", d."full_name"
LIMIT 20;
```

```sql
--Description: 4.  Sum every driver’s points within each year.  
SELECT r."year",
       d."full_name",
       SUM(ds."points") AS "season_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id"  = ds."race_id"
JOIN   "drivers_ext"      AS d ON d."driver_id" = ds."driver_id"
GROUP  BY r."year", ds."driver_id"
ORDER  BY r."year", "season_points" DESC
LIMIT 20;
```

```sql
--Description: 5.  From the previous result, keep only the top-scoring driver of each year.  
WITH season_totals AS (
    SELECT r."year",
           d."full_name",
           SUM(ds."points") AS "season_points",
           RANK() OVER (PARTITION BY r."year" ORDER BY SUM(ds."points") DESC) AS "rk"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id"  = ds."race_id"
    JOIN   "drivers_ext"      AS d ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", ds."driver_id"
)
SELECT "year", "full_name", "season_points"
FROM   season_totals
WHERE  "rk" = 1
ORDER  BY "year"
LIMIT 20;
```

```sql
--Description: 6.  Inspect constructor-standing rows tied to races to verify year & points.  
SELECT r."year",
       cs."constructor_id",
       cs."points",
       cs."wins"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
ORDER  BY r."year", cs."constructor_id"
LIMIT 20;
```

```sql
--Description: 7.  Aggregate constructor points within each year.  
SELECT r."year",
       c."name"          AS "constructor_name",
       SUM(cs."points")  AS "season_points"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id"      = cs."race_id"
JOIN   "constructors"          AS c ON c."constructor_id" = cs."constructor_id"
GROUP  BY r."year", cs."constructor_id"
ORDER  BY r."year", "season_points" DESC
LIMIT 20;
```

```sql
--Description: 8.  Keep only the top-scoring constructor of each season.  
WITH constructor_totals AS (
    SELECT r."year",
           c."name" AS "constructor_name",
           SUM(cs."points") AS "season_points",
           RANK() OVER (PARTITION BY r."year" ORDER BY SUM(cs."points") DESC) AS "rk"
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id"      = cs."race_id"
    JOIN   "constructors"          AS c ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", cs."constructor_id"
)
SELECT "year", "constructor_name", "season_points"
FROM   constructor_totals
WHERE  "rk" = 1
ORDER  BY "year"
LIMIT 20;
```

```sql
--Description: 9.  Combine both CTEs to list, for each season, the driver and constructor that scored the most points.  
WITH driver_totals AS (
    SELECT r."year",
           d."full_name",
           SUM(ds."points") AS "driver_points",
           RANK() OVER (PARTITION BY r."year" ORDER BY SUM(ds."points") DESC) AS "rk"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id"  = ds."race_id"
    JOIN   "drivers_ext"      AS d ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", ds."driver_id"
),
constructor_totals AS (
    SELECT r."year",
           c."name" AS "constructor_name",
           SUM(cs."points") AS "constructor_points",
           RANK() OVER (PARTITION BY r."year" ORDER BY SUM(cs."points") DESC) AS "rk"
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id"      = cs."race_id"
    JOIN   "constructors"          AS c ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", cs."constructor_id"
)
SELECT dt."year",
       dt."full_name"       AS "top_driver",
       dt."driver_points",
       ct."constructor_name" AS "top_constructor",
       ct."constructor_points"
FROM   driver_totals       AS dt
JOIN   constructor_totals  AS ct USING ("year")
WHERE  dt."rk" = 1
  AND  ct."rk" = 1
ORDER  BY dt."year"
LIMIT 20;
```

```sql
--Description: 10.  Same as #9 but only the final answer, no extra columns (clean).  
WITH driver_totals AS (
    SELECT r."year",
           d."full_name" AS "top_driver",
           SUM(ds."points") AS "driver_points",
           RANK() OVER (PARTITION BY r."year" ORDER BY SUM(ds."points") DESC) AS "rk"
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id"  = ds."race_id"
    JOIN   "drivers_ext"      AS d ON d."driver_id" = ds."driver_id"
    GROUP  BY r."year", ds."driver_id"
),
constructor_totals AS (
    SELECT r."year",
           c."name" AS "top_constructor",
           SUM(cs."points") AS "constructor_points",
           RANK() OVER (PARTITION BY r."year" ORDER BY SUM(cs."points") DESC) AS "rk"
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id"      = cs."race_id"
    JOIN   "constructors"          AS c ON c."constructor_id" = cs."constructor_id"
    GROUP  BY r."year", cs."constructor_id"
)
SELECT dt."year",
       dt."top_driver",
       ct."top_constructor"
FROM   driver_totals      AS dt
JOIN   constructor_totals AS ct USING ("year")
WHERE  dt."rk" = 1
  AND  ct."rk" = 1
ORDER  BY dt."year"
LIMIT 20;
```
