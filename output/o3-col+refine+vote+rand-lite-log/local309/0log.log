Query:
--Description: 5) For every season, return the champion driver’s full name and total points
WITH driver_year_pts AS (
    SELECT r."year",
           ds."driver_id",
           SUM(ds."points") AS total_driver_points
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id" = ds."race_id"
    GROUP  BY r."year", ds."driver_id"
)
SELECT dyp."year",
       de."full_name",
       dyp.total_driver_points
FROM   driver_year_pts AS dyp
JOIN   "drivers_ext"  AS de ON de."driver_id" = dyp."driver_id"
JOIN  (
        SELECT "year",
               MAX(total_driver_points) AS max_pts
        FROM   driver_year_pts
        GROUP  BY "year"
      ) AS mx
   ON mx."year"   = dyp."year"
  AND mx."max_pts" = dyp.total_driver_points
ORDER BY dyp."year"
LIMIT 20
