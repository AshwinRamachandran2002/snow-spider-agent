```sql
-- Description: 1) Inspect the available seasons (years) in the data set
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: 2) Look at a few driver-standing records together with the race year
SELECT ds."driver_standings_id",
       r."year",
       ds."driver_id",
       ds."points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
LIMIT 20;
```

```sql
-- Description: 3) Aggregate total points each driver scored in a given year
SELECT r."year",
       ds."driver_id",
       SUM(ds."points") AS "total_driver_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
GROUP  BY r."year", ds."driver_id"
ORDER  BY r."year", "total_driver_points" DESC
LIMIT 20;
```

```sql
-- Description: 4) For every year, return the driver-ID with the maximum points
SELECT t1."year",
       t1."driver_id",
       t1."total_driver_points"
FROM  (
        SELECT r."year",
               ds."driver_id",
               SUM(ds."points") AS "total_driver_points"
        FROM   "driver_standings" AS ds
        JOIN   "races"            AS r ON r."race_id" = ds."race_id"
        GROUP  BY r."year", ds."driver_id"
      ) AS t1
JOIN  (
        SELECT r."year",
               MAX(SUM(ds."points")) AS "max_pts"
        FROM   "driver_standings" AS ds
        JOIN   "races"            AS r ON r."race_id" = ds."race_id"
        GROUP  BY r."year"
      ) AS t2
      ON t1."year" = t2."year"
     AND t1."total_driver_points" = t2."max_pts"
ORDER BY t1."year"
LIMIT 20;
```

```sql
-- Description: 5) Same as above, but show each winner’s full name
SELECT t."year",
       d."full_name",
       t."total_driver_points"
FROM  (
        SELECT r."year",
               ds."driver_id",
               SUM(ds."points") AS "total_driver_points"
        FROM   "driver_standings" AS ds
        JOIN   "races"            AS r ON r."race_id" = ds."race_id"
        GROUP  BY r."year", ds."driver_id"
      ) AS t
JOIN   "drivers_ext" AS d ON d."driver_id" = t."driver_id"
JOIN  (
        SELECT r."year",
               MAX(SUM(ds."points")) AS "max_pts"
        FROM   "driver_standings" AS ds
        JOIN   "races"            AS r ON r."race_id" = ds."race_id"
        GROUP  BY r."year"
      ) AS m
      ON m."year" = t."year"
     AND m."max_pts" = t."total_driver_points"
ORDER BY t."year"
LIMIT 20;
```

```sql
-- Description: 6) Aggregate total points each constructor scored in a given year
SELECT r."year",
       cs."constructor_id",
       SUM(cs."points") AS "total_constructor_points"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
GROUP  BY r."year", cs."constructor_id"
ORDER  BY r."year", "total_constructor_points" DESC
LIMIT 20;
```

```sql
-- Description: 7) Retrieve the constructor with the highest points per year (plus its short name)
SELECT t."year",
       c."name",
       t."total_constructor_points"
FROM  (
        SELECT r."year",
               cs."constructor_id",
               SUM(cs."points") AS "total_constructor_points"
        FROM   "constructor_standings" AS cs
        JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
        GROUP  BY r."year", cs."constructor_id"
      ) AS t
JOIN   "constructors_ext" AS c ON c."constructor_id" = t."constructor_id"
JOIN  (
        SELECT r."year",
               MAX(SUM(cs."points")) AS "max_pts"
        FROM   "constructor_standings" AS cs
        JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
        GROUP  BY r."year"
      ) AS m
      ON m."year" = t."year"
     AND m."max_pts" = t."total_constructor_points"
ORDER BY t."year"
LIMIT 20;
```

```sql
-- Description: 8) Combine both champions (driver & constructor) for every year
SELECT d_w."year",
       d_w."full_name"                 AS "top_driver",
       d_w."total_driver_points",
       c_w."name"                      AS "top_constructor",
       c_w."total_constructor_points"
FROM (
        /* driver champions */
        SELECT t."year",
               d."full_name",
               t."total_driver_points"
        FROM  (
                SELECT r."year",
                       ds."driver_id",
                       SUM(ds."points") AS "total_driver_points"
                FROM   "driver_standings" AS ds
                JOIN   "races"            AS r ON r."race_id" = ds."race_id"
                GROUP  BY r."year", ds."driver_id"
              ) AS t
        JOIN   "drivers_ext" AS d ON d."driver_id" = t."driver_id"
        JOIN  (
                SELECT r."year",
                       MAX(SUM(ds."points")) AS "max_pts"
                FROM   "driver_standings" AS ds
                JOIN   "races"            AS r ON r."race_id" = ds."race_id"
                GROUP  BY r."year"
              ) AS m
              ON m."year" = t."year"
             AND m."max_pts" = t."total_driver_points"
     ) AS d_w
JOIN (
        /* constructor champions */
        SELECT t."year",
               c."name",
               t."total_constructor_points"
        FROM  (
                SELECT r."year",
                       cs."constructor_id",
                       SUM(cs."points") AS "total_constructor_points"
                FROM   "constructor_standings" AS cs
                JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
                GROUP  BY r."year", cs."constructor_id"
              ) AS t
        JOIN   "constructors_ext" AS c ON c."constructor_id" = t."constructor_id"
        JOIN  (
                SELECT r."year",
                       MAX(SUM(cs."points")) AS "max_pts"
                FROM   "constructor_standings" AS cs
                JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
                GROUP  BY r."year"
              ) AS m
              ON m."year" = t."year"
             AND m."max_pts" = t."total_constructor_points"
     ) AS c_w
  ON c_w."year" = d_w."year"
ORDER BY d_w."year"
LIMIT 20;
```
