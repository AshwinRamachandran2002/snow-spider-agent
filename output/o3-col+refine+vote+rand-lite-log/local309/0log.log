```sql
-- Description:  “Thinking-process in comments”
-- Goal:  per season, list the driver (full name) with the most points and the constructor with the most points.
-- Steps
-- ① driver_year_pts  : total points each driver scored in a season          (driver_standings  ↔ races)
-- ② driver_champs    : keep only the rows whose total equals the seasonal maximum
-- ③ constr_year_pts  : total points each constructor scored in a season    (constructor_standings ↔ races)
-- ④ constr_champs    : keep only the rows whose total equals the seasonal maximum
-- ⑤ Final SELECT     : join the champ-CTEs on “year”, add names from drivers_ext / constructors_ext,
--                      return year, driver name & pts, constructor name & pts, ordered chronologically
WITH driver_year_pts AS (
    SELECT r."year",
           ds."driver_id",
           SUM(ds."points") AS total_driver_points
    FROM   "driver_standings" AS ds
    JOIN   "races"            AS r ON r."race_id" = ds."race_id"
    GROUP  BY r."year", ds."driver_id"
),
driver_champs AS (
    SELECT dyp.*
    FROM   driver_year_pts AS dyp
    JOIN  (
            SELECT "year",
                   MAX(total_driver_points) AS max_pts
            FROM   driver_year_pts
            GROUP  BY "year"
          ) AS mx
      ON  mx."year"   = dyp."year"
     AND mx."max_pts" = dyp.total_driver_points
),
constr_year_pts AS (
    SELECT r."year",
           cs."constructor_id",
           SUM(cs."points") AS total_constructor_points
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
    GROUP  BY r."year", cs."constructor_id"
),
constr_champs AS (
    SELECT cyp.*
    FROM   constr_year_pts AS cyp
    JOIN  (
            SELECT "year",
                   MAX(total_constructor_points) AS max_pts
            FROM   constr_year_pts
            GROUP  BY "year"
          ) AS mx
      ON  mx."year"   = cyp."year"
     AND mx."max_pts" = cyp.total_constructor_points
)
SELECT dc."year",
       de."full_name"              AS top_driver,
       dc.total_driver_points      AS driver_points,
       ce."name"                   AS top_constructor,
       cc.total_constructor_points AS constructor_points
FROM   driver_champs       AS dc
JOIN   "drivers_ext"       AS de ON de."driver_id" = dc."driver_id"
JOIN   constr_champs       AS cc ON cc."year"      = dc."year"
JOIN   "constructors_ext"  AS ce ON ce."constructor_id" = cc."constructor_id"
ORDER  BY dc."year"
LIMIT 20;
```
