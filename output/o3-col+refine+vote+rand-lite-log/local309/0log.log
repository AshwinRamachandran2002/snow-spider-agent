--Description: 7) For every season, return the constructor that scored the most points
WITH constructor_year_pts AS (
    SELECT r."year",
           cs."constructor_id",
           SUM(cs."points") AS total_constructor_points
    FROM   "constructor_standings" AS cs
    JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
    GROUP  BY r."year", cs."constructor_id"
)
SELECT cyp."year",
       ce."name",
       cyp.total_constructor_points
FROM   constructor_year_pts AS cyp
JOIN   "constructors_ext"   AS ce ON ce."constructor_id" = cyp."constructor_id"
JOIN  (
        SELECT "year",
               MAX(total_constructor_points) AS max_pts
        FROM   constructor_year_pts
        GROUP  BY "year"
      ) AS mx
   ON mx."year"   = cyp."year"
  AND mx."max_pts" = cyp.total_constructor_points
ORDER BY cyp."year"
LIMIT 20
