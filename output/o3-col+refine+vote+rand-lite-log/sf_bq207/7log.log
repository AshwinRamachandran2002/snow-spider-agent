4",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  },\n  {\n    "code": "B23Q11/00",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  }\n]', 'cpc': '[\n  {\n    "code": "B08B15/04",\n    "first": true,\n    "inventive": true,\n    "tree": []\n  },\n  {\n    "code": "B23Q11/0046",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  }\n]', 'fi': '[]', 'fterm': '[]', 'locarno': '[]', 'citation': '[]', 'parent': '[]', 'child': '[]', 'entity_status': '', 'art_unit': ''}, {'publication_number': 'AT-E208695-T1', 'application_number': 'AT-96119677-T', 'country_code': 'AT', 'kind_code': 'T1', 'application_kind': 'T', 'application_number_formatted': 'AT96119677T', 'pct_number': '', 'family_id': '7781268', 'spif_publication_number': '', 'spif_application_number': '', 'title_localized': '[\n  {\n    "language": "de",\n    "text": "Verfahren zur trocknung und konditionierung von expandierbaren styrolpolymerisaten und vorrichtung zur durchfürung des verfahrens",\n    "truncated": false\n  }\n]', 'abstract_localized': '[\n  {\n    "language": "en",\n    "text": "The two-stage process is for drying and conditioning expandable styrene polymers (EPS) obtained by suspension polymerisation in presence of blowing agent, followed by separation on a centrifuge to give EPS with a residual moisture content of ca. 2% and an average particle diameter of 0.1-3.0 mm. The process comprises : (a) passing the EPS (1) through a drier (2) with a first gas stream (3) with a temperature of 20-40 degrees C, a gas/EPS ratio of 1.3-1.9 kg/kg and a residence time of 0.05-0.2 minutes then separating the EPS from the gas, and (b) contacting the EPS in a second drier (7) with a second gas stream (8) at 20-40 degrees C, with a residence time of 240-480 minutes from product inlet to outlet and a gas/EPS ratio of 0.15-0.6 kg/kg, and with the gas flow in the same and/or opposite direction to the product flow, the gas being divided into different streams (9), fed into the EPS at different levels one above the other and re-dissipitated between these levels. Also claimed is an apparatus for t his process.",\n    "truncated": false\n  }\n]', 'claims_localized': '[]', 'claims_localized_html': '[]', 'description_localized': '[]', 'description_localized_html': '[]', 'publication_date': 20011115, 'filing_date': 19961209, 'grant_date': 20011115, 'priority_date': 19951227, 'priority_claim': '[\n  {\n    "application_number": "DE-19548515-A",\n    "category": "",\n    "filing_date": 19951227,\n    "npl_text": "",\n    "publication_number": "",\n    "type": ""\n  }\n]', 'inventor': '[\n  "HAMANN, BERND, DR.",\n  "BAGERITZ, HANS",\n  "KLODT, ROLF-DIETER, DR.",\n  "BOGER, JUERGEN",\n  "WINZHEIMER, BODO",\n  "LEHMANN, REINHARD"\n]', 'inventor_harmonized': '[\n  {\n    "country_code": "DE",\n    "name": "HAMANN BERND DR"\n  },\n  {\n    "country_code": "DE",\n    "name": "BAGERITZ HANS"\n  },\n  {\n    "country_code": "DE",\n    "name": "KLODT ROLF-DIETER DR"\n  },\n  {\n    "country_code": "DE",\n    "name": "BOGER JUERGEN"\n  },\n  {\n    "country_code": "DE",\n    "name": "WINZHEIMER BODO"\n  },\n  {\n    "country_code": "DE",\n    "name": "LEHMANN REINHARD"\n  }\n]', 'assignee': '[\n  "Buna Sow Leuna Olefinverb Gmbh"\n]', 'assignee_harmonized': '[\n  {\n    "country_code": "DE",\n    "name": "BUNA SOW LEUNA OLEFINVERB GMBH"\n  }\n]', 'examiner': '[]', 'uspc': '[]', 'ipc': '[\n  {\n    "code": "B29B13/06",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  },\n  {\n    "code": "C08J9/22",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  },\n  {\n    "code": "C08L25/04",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  },\n  {\n    "code": "F26B17/10",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  },\n  {\n    "code": "F26B17/14",\n    "first": false,\n    "inventive": true,\n    "tree": []\n  }\n]', 'cpc': '[\n  {\n    "code": "C08J9/22",\n    "first": true,\n    "inventive": true,\