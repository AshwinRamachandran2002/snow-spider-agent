```sql
--Description: Add a join to PATENTS.PUBLICATIONS to see publication / application / dates (still exploratory)  
SELECT p."publication_number",
       p."application_number",
       p."publication_date",
       pcs."claim_no",
       pcs."word_ct"
FROM   PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_CLAIMS_STATS  pcs
JOIN   PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH                m
         ON pcs."pat_no" = m."pat_no"
JOIN   PATENTS_USPTO.PATENTS.PUBLICATIONS                 p
         ON p."publication_number" = m."publication_number"
WHERE  pcs."ind_flg" = '1'
LIMIT  20;
```

```sql
--Description: For each appl_id, find the earliest publication date (quick check – 20 rows)  
SELECT p."application_number"     AS "app_no",
       MIN(p."publication_date")  AS "earliest_pub_date"
FROM   PATENTS_USPTO.PATENTS.PUBLICATIONS p
GROUP  BY p."application_number"
LIMIT  20;
```

```sql
--Description: Combine everything and keep only the *earliest* publication for each application; preview 20 rows  
SELECT pub."publication_number",
       pub."application_number",
       pcs."claim_no",
       pcs."word_ct"
FROM   PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_CLAIMS_STATS pcs
JOIN   PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH               m
         ON pcs."pat_no" = m."pat_no"
JOIN   PATENTS_USPTO.PATENTS.PUBLICATIONS                pub
         ON pub."publication_number" = m."publication_number"
JOIN  (
        SELECT "application_number",
               MIN("publication_date") AS "earliest_pub_date"
        FROM   PATENTS_USPTO.PATENTS.PUBLICATIONS
        GROUP  BY "application_number"
      ) early
         ON early."application_number" = pub."application_number"
        AND early."earliest_pub_date"  = pub."publication_date"
WHERE  pcs."ind_flg" = '1'
LIMIT  20;
```

```sql
--Description: Same as above but order by descending word count to spot the biggest claims (top 20 preview)  
SELECT pub."publication_number",
       pub."application_number",
       pcs."claim_no",
       pcs."word_ct"
FROM   PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_CLAIMS_STATS pcs
JOIN   PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH               m
         ON pcs."pat_no" = m."pat_no"
JOIN   PATENTS_USPTO.PATENTS.PUBLICATIONS                pub
         ON pub."publication_number" = m."publication_number"
JOIN  (
        SELECT "application_number",
               MIN("publication_date") AS "earliest_pub_date"
        FROM   PATENTS_USPTO.PATENTS.PUBLICATIONS
        GROUP  BY "application_number"
      ) early
         ON early."application_number" = pub."application_number"
        AND early."earliest_pub_date"  = pub."publication_date"
WHERE  pcs."ind_flg" = '1'
ORDER  BY TRY_TO_NUMBER(pcs."word_ct") DESC
LIMIT  20;
```

```sql
--Description: Final production query – top 100 earliest publications with the largest independent-claim word counts  
SELECT pub."publication_number",
       pub."application_number",
       pcs."claim_no",
       pcs."word_ct"
FROM   PATENTS_USPTO.USPTO_OCE_CLAIMS.PATENT_CLAIMS_STATS pcs
JOIN   PATENTS_USPTO.USPTO_OCE_CLAIMS.MATCH               m
         ON pcs."pat_no" = m."pat_no"
JOIN   PATENTS_USPTO.PATENTS.PUBLICATIONS                pub
         ON pub."publication_number" = m."publication_number"
JOIN  (
        SELECT "application_number",
               MIN("publication_date") AS "earliest_pub_date"
        FROM   PATENTS_USPTO.PATENTS.PUBLICATIONS
        GROUP  BY "application_number"
      ) early
         ON early."application_number" = pub."application_number"
        AND early."earliest_pub_date"  = pub."publication_date"
WHERE  pcs."ind_flg" = '1'
ORDER  BY TRY_TO_NUMBER(pcs."word_ct") DESC
LIMIT  100;
```
