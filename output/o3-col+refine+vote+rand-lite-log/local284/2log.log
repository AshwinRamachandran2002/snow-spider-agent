```sql
-- Description: Derive the sample standard deviation of the loss rates
SELECT SQRT( AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                 *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
           ) AS "std_dev_loss_rate"
FROM   "veg_loss_rate_df";
```

```sql
-- Description: Count of items whose loss rate is more than 1 SD below the average
SELECT COUNT(*) AS "cnt_below_1SD"
FROM   "veg_loss_rate_df",
       (SELECT AVG("loss_rate_%")                                            AS avg_loss,
               SQRT(AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                         *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
                  )                                                          AS std_dev
        FROM   "veg_loss_rate_df") stats
WHERE  "veg_loss_rate_df"."loss_rate_%" < stats.avg_loss - stats.std_dev;
```

```sql
-- Description: Count of items whose loss rate lies within ±1 SD of the average
SELECT COUNT(*) AS "cnt_within_1SD"
FROM   "veg_loss_rate_df",
       (SELECT AVG("loss_rate_%")                                            AS avg_loss,
               SQRT(AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                         *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
                  )                                                          AS std_dev
        FROM   "veg_loss_rate_df") stats
WHERE  "veg_loss_rate_df"."loss_rate_%" BETWEEN
       stats.avg_loss - stats.std_dev AND stats.avg_loss + stats.std_dev;
```

```sql
-- Description: Count of items whose loss rate is more than 1 SD above the average
SELECT COUNT(*) AS "cnt_above_1SD"
FROM   "veg_loss_rate_df",
       (SELECT AVG("loss_rate_%")                                            AS avg_loss,
               SQRT(AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                         *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
                  )                                                          AS std_dev
        FROM   "veg_loss_rate_df") stats
WHERE  "veg_loss_rate_df"."loss_rate_%" > stats.avg_loss + stats.std_dev;
```

```sql
-- Description: One-shot summary – classify each item and show counts per deviation band
WITH stats AS (
       SELECT AVG("loss_rate_%")                                             AS avg_loss,
              SQRT(AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                        *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
                 )                                                           AS std_dev
       FROM   "veg_loss_rate_df"
), classified AS (
       SELECT "item_code",
              "item_name",
              "loss_rate_%"                                                  AS loss_rate,
              CASE
                   WHEN "loss_rate_%" <  (SELECT avg_loss FROM stats) - (SELECT std_dev FROM stats)
                        THEN 'Below 1 SD'
                   WHEN "loss_rate_%" >  (SELECT avg_loss FROM stats) + (SELECT std_dev FROM stats)
                        THEN 'Above 1 SD'
                   ELSE 'Within 1 SD'
              END                                                            AS deviation_band
       FROM   "veg_loss_rate_df"
)
SELECT deviation_band,
       COUNT(*)                                                              AS items_count
FROM   classified
GROUP  BY deviation_band;
```
