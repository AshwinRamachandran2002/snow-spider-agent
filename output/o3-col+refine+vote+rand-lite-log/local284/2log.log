Query:
-- Description: Count of items whose loss rate is more than 1 SD below the average
SELECT COUNT(*) AS "cnt_below_1SD"
FROM   "veg_loss_rate_df",
       (SELECT AVG("loss_rate_%")                                            AS avg_loss,
               SQRT(AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                         *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
                  )                                                          AS std_dev
        FROM   "veg_loss_rate_df") stats
WHERE  "veg_loss_rate_df"."loss_rate_%" < stats.avg_loss - stats.std_dev;
Answer:
cnt_below_1SD
35
Query:
-- Description: Count of items whose loss rate lies within ±1 SD of the average
SELECT COUNT(*) AS "cnt_within_1SD"
FROM   "veg_loss_rate_df",
       (SELECT AVG("loss_rate_%")                                            AS avg_loss,
               SQRT(AVG( ("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df"))
                         *("loss_rate_%" - (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")) )
                  )                                                          AS std_dev
        FROM   "veg_loss_rate_df") stats
WHERE  "veg_loss_rate_df"."loss_rate_%" BETWEEN
       stats.avg_loss - stats.std_dev AND stats.avg_loss + stats.std_dev;
