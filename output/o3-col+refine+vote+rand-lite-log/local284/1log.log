Query:
--Description: Break down counts of below / within / above one-std-dev by vegetable category
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                           AS avg_loss,
        SQRT( AVG("loss_rate_%" * "loss_rate_%") -
              AVG("loss_rate_%") * AVG("loss_rate_%") )              AS std_loss
    FROM "veg_loss_rate_df"
)
SELECT
    c."category_name",
    SUM(CASE WHEN v."loss_rate_%" <  stats.avg_loss                     THEN 1 ELSE 0 END) AS below_avg,
    SUM(CASE WHEN v."loss_rate_%" BETWEEN stats.avg_loss - stats.std_loss
                                   AND     stats.avg_loss + stats.std_loss THEN 1 ELSE 0 END) AS within_one_std,
    SUM(CASE WHEN v."loss_rate_%" >  stats.avg_loss                     THEN 1 ELSE 0 END) AS above_avg
FROM "veg_loss_rate_df" AS v
JOIN "veg_cat"           AS c  ON v."item_code" = c."item_code"
CROSS JOIN stats
GROUP BY c."category_name"
LIMIT 20
