--Description: Show 20 items whose loss-rate falls WITHIN one standard deviation of the mean (typical items)
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                           AS avg_loss,
        SQRT( AVG("loss_rate_%" * "loss_rate_%") -
              AVG("loss_rate_%") * AVG("loss_rate_%") )              AS std_loss
    FROM "veg_loss_rate_df"
)
SELECT
    v."item_code",
    v."item_name",
    v."loss_rate_%"
FROM "veg_loss_rate_df" AS v
CROSS JOIN stats
WHERE v."loss_rate_%" BETWEEN stats.avg_loss - stats.std_loss
                       AND     stats.avg_loss + stats.std_loss
ORDER BY v."loss_rate_%"
LIMIT 20
