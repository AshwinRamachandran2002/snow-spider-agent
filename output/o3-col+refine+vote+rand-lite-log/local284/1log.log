```sql
--Description: Compute the overall average loss-rate (avg_loss) and its sample standard deviation (std_loss)  
WITH stats AS (
    SELECT 
        AVG("loss_rate_%")              AS avg_loss
    FROM "veg_loss_rate_df"
)
SELECT 
    stats.avg_loss,
    SQRT(AVG( ("loss_rate_%" - stats.avg_loss) * ("loss_rate_%" - stats.avg_loss) )) AS std_loss
FROM "veg_loss_rate_df", stats;
```

```sql
--Description: Count how many items are BELOW, ABOVE and WITHIN one standard deviation of the average loss-rate  
WITH stats AS (
    SELECT 
        AVG("loss_rate_%")                                             AS avg_loss,
        SQRT(AVG( ("loss_rate_%" - AVG("loss_rate_%"))*
                  ("loss_rate_%" - AVG("loss_rate_%")) ))              AS std_loss
    FROM "veg_loss_rate_df"
)
SELECT
    SUM(CASE WHEN v."loss_rate_%" <  stats.avg_loss                             THEN 1 ELSE 0 END) AS below_avg,
    SUM(CASE WHEN v."loss_rate_%" >  stats.avg_loss                             THEN 1 ELSE 0 END) AS above_avg,
    SUM(CASE WHEN v."loss_rate_%" BETWEEN stats.avg_loss - stats.std_loss 
                                   AND     stats.avg_loss + stats.std_loss      THEN 1 ELSE 0 END) AS within_one_std
FROM "veg_loss_rate_df"  AS v,
     stats;
```

```sql
--Description: List the 20 items that sit BELOW the average loss-rate (most efficient)  
WITH stats AS (
    SELECT AVG("loss_rate_%") AS avg_loss FROM "veg_loss_rate_df"
)
SELECT 
    "item_code",
    "item_name",
    "loss_rate_%"
FROM "veg_loss_rate_df", stats
WHERE "loss_rate_%" < stats.avg_loss
ORDER BY "loss_rate_%" ASC
LIMIT 20;
```

```sql
--Description: List the 20 items that sit ABOVE the average loss-rate (least efficient)  
WITH stats AS (
    SELECT AVG("loss_rate_%") AS avg_loss FROM "veg_loss_rate_df"
)
SELECT 
    "item_code",
    "item_name",
    "loss_rate_%"
FROM "veg_loss_rate_df", stats
WHERE "loss_rate_%" > stats.avg_loss
ORDER BY "loss_rate_%" DESC
LIMIT 20;
```

```sql
--Description: Show 20 items whose loss-rate falls WITHIN one standard deviation of the mean (typical items)  
WITH stats AS (
    SELECT 
        AVG("loss_rate_%") AS avg_loss,
        SQRT(AVG( ("loss_rate_%" - AVG("loss_rate_%"))*
                  ("loss_rate_%" - AVG("loss_rate_%")) )) AS std_loss
    FROM "veg_loss_rate_df"
)
SELECT 
    "item_code",
    "item_name",
    "loss_rate_%"
FROM "veg_loss_rate_df", stats
WHERE "loss_rate_%" BETWEEN stats.avg_loss - stats.std_loss
                     AND     stats.avg_loss + stats.std_loss
ORDER BY "loss_rate_%" 
LIMIT 20;
```

```sql
--Description: Break down the counts of below/within/above one-std-dev by high-level vegetable category  
WITH stats AS (
    SELECT 
        AVG("loss_rate_%") AS avg_loss,
        SQRT(AVG( ("loss_rate_%" - AVG("loss_rate_%"))*
                  ("loss_rate_%" - AVG("loss_rate_%")) )) AS std_loss
    FROM "veg_loss_rate_df"
)
SELECT 
    c."category_name",
    SUM(CASE WHEN v."loss_rate_%" <  stats.avg_loss THEN 1 ELSE 0 END)                                AS below_avg,
    SUM(CASE WHEN v."loss_rate_%" BETWEEN stats.avg_loss - stats.std_loss
                                   AND     stats.avg_loss + stats.std_loss THEN 1 ELSE 0 END)         AS within_one_std,
    SUM(CASE WHEN v."loss_rate_%" >  stats.avg_loss THEN 1 ELSE 0 END)                                AS above_avg
FROM "veg_loss_rate_df" AS v
JOIN "veg_cat"          AS c  ON v."item_code" = c."item_code"
CROSS JOIN stats
GROUP BY c."category_name"
LIMIT 20;
```
