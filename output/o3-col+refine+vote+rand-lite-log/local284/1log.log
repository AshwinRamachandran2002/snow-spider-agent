```sql
--Description / Thinking process:
-- Goal: summarise vegetable loss-rate performance: average loss-rate (μ),
--       its standard deviation (σ) and counts of items that are
--       1) below μ, 2) above μ, 3) within ±1 σ of μ.
--
-- Step-1: Compute μ = AVG(loss_rate_%).
-- Step-2: Compute σ without nesting aggregates by using:
--            Var(X)=E[X²] − (E[X])²      ⇒ σ = √Var(X)
--         where E[X]  = AVG(loss_rate_%)
--               E[X²] = AVG(loss_rate_% * loss_rate_%)
-- Step-3: With μ & σ (CTE stats) classify each item and count.
WITH stats AS (
    SELECT
        AVG("loss_rate_%")                                             AS avg_loss,
        SQRT( AVG("loss_rate_%" * "loss_rate_%") -
              AVG("loss_rate_%") * AVG("loss_rate_%") )               AS std_loss
    FROM "veg_loss_rate_df"
)
SELECT
    SUM(CASE WHEN v."loss_rate_%" <  s.avg_loss                     THEN 1 ELSE 0 END) AS below_avg,
    SUM(CASE WHEN v."loss_rate_%" BETWEEN s.avg_loss - s.std_loss
                                   AND     s.avg_loss + s.std_loss  THEN 1 ELSE 0 END) AS within_one_std,
    SUM(CASE WHEN v."loss_rate_%" >  s.avg_loss                     THEN 1 ELSE 0 END) AS above_avg
FROM "veg_loss_rate_df" AS v
CROSS JOIN stats AS s;
```
