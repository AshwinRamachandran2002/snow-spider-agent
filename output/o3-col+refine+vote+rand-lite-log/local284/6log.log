Query:
--Description: Count how many items fall below one standard deviation under the mean  
SELECT COUNT(*) AS cnt_below_one_std
FROM   veg_loss_rate_df
WHERE  "loss_rate_%" < (
        SELECT AVG("loss_rate_%") - 
               SQRT(AVG(("loss_rate_%")*("loss_rate_%")) - AVG("loss_rate_%")*AVG("loss_rate_%"))
        FROM   veg_loss_rate_df
      );
Answer:
