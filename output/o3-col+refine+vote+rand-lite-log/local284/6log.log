Query:
--Description: Calculate the population standard deviation of loss rates  
SELECT SQRT( AVG(("loss_rate_%")*("loss_rate_%"))
           - AVG("loss_rate_%")*AVG("loss_rate_%") )  AS stddev_loss_rate
FROM   veg_loss_rate_df;
