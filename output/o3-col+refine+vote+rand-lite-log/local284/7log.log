--Description: 5) Items whose loss-rate falls WITHIN one standard deviation of the mean.
WITH base AS (                               -- overall mean (µ)
    SELECT AVG("loss_rate_%") AS mu
    FROM   "veg_loss_rate_df"
), stats AS (                                -- standard deviation (σ)
    SELECT base.mu,
           sqrt(AVG(POWER(v."loss_rate_%" - base.mu, 2))) AS sd
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN base
)
SELECT DISTINCT
       v."item_code",
       v."item_name",
       v."loss_rate_%"
FROM   "veg_loss_rate_df" v
CROSS  JOIN stats
WHERE  v."loss_rate_%" BETWEEN stats.mu - stats.sd AND stats.mu + stats.sd
ORDER  BY v."loss_rate_%"
LIMIT  20
