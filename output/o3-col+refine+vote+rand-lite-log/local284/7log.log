```sql
-- 2) What is the simple average (mean) loss rate across ALL items?
SELECT AVG("loss_rate_%") AS "avg_loss_rate_%"
FROM   "veg_loss_rate_df"
LIMIT  20;
```

```sql
-- 3) Compute variance and standard deviation of the loss rate column  
--    (SQLite has a √ function, so we can derive stdev from the variance)
WITH base AS (
    SELECT AVG("loss_rate_%") AS avg_loss_rate
    FROM   "veg_loss_rate_df"
), var_calc AS (
    SELECT AVG(POWER(v."loss_rate_%" - b.avg_loss_rate, 2)) AS variance,
           b.avg_loss_rate
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN base b
)
SELECT avg_loss_rate               AS "avg_loss_rate_%",
       sqrt(variance)              AS "stdev_loss_rate_%"
FROM   var_calc
LIMIT  20;
```

```sql
-- 4) List all items whose loss rate is BELOW (mean – 1 SD)
WITH stats AS (
    SELECT (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")               AS mu,
           (SELECT sqrt(AVG(POWER("loss_rate_%" - mu, 2))) FROM "veg_loss_rate_df") AS sd
)
SELECT DISTINCT v."item_code",
       v."item_name",
       v."loss_rate_%"
FROM   "veg_loss_rate_df" v
CROSS  JOIN stats s
WHERE  v."loss_rate_%" < s.mu - s.sd
ORDER  BY v."loss_rate_%"
LIMIT  20;
```

```sql
-- 5) List all items whose loss rate is WITHIN ±1 SD of the mean
WITH stats AS (
    SELECT (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")               AS mu,
           (SELECT sqrt(AVG(POWER("loss_rate_%" - mu, 2))) FROM "veg_loss_rate_df") AS sd
)
SELECT DISTINCT v."item_code",
       v."item_name",
       v."loss_rate_%"
FROM   "veg_loss_rate_df" v
CROSS  JOIN stats s
WHERE  v."loss_rate_%" BETWEEN s.mu - s.sd AND s.mu + s.sd
ORDER  BY v."loss_rate_%"
LIMIT  20;
```

```sql
-- 6) List all items whose loss rate is ABOVE (mean + 1 SD)
WITH stats AS (
    SELECT (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")               AS mu,
           (SELECT sqrt(AVG(POWER("loss_rate_%" - mu, 2))) FROM "veg_loss_rate_df") AS sd
)
SELECT DISTINCT v."item_code",
       v."item_name",
       v."loss_rate_%"
FROM   "veg_loss_rate_df" v
CROSS  JOIN stats s
WHERE  v."loss_rate_%" > s.mu + s.sd
ORDER  BY v."loss_rate_%"
LIMIT  20;
```

```sql
-- 7) Roll-up counts of items falling BELOW, WITHIN, or ABOVE one standard deviation
WITH stats AS (
    SELECT (SELECT AVG("loss_rate_%") FROM "veg_loss_rate_df")               AS mu,
           (SELECT sqrt(AVG(POWER("loss_rate_%" - mu, 2))) FROM "veg_loss_rate_df") AS sd
), flagged AS (
    SELECT CASE
              WHEN v."loss_rate_%" <  mu - sd THEN 'Below 1 SD'
              WHEN v."loss_rate_%" >  mu + sd THEN 'Above 1 SD'
              ELSE                            'Within ±1 SD'
           END                              AS loss_band
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN stats
)
SELECT loss_band,
       COUNT(*)        AS items_cnt
FROM   flagged
GROUP  BY loss_band
LIMIT  20;
```

```sql
-- 8) One-liner summary: average, stdev, and the three band counts together
WITH base AS (
    SELECT AVG("loss_rate_%")                                   AS mu
    FROM   "veg_loss_rate_df"
), stats AS (
    SELECT mu,
           sqrt(AVG(POWER("loss_rate_%" - mu, 2)))              AS sd
    FROM   "veg_loss_rate_df", base
), banded AS (
    SELECT CASE
              WHEN "loss_rate_%" <  mu - sd THEN 'Below'
              WHEN "loss_rate_%" >  mu + sd THEN 'Above'
              ELSE                             'Within'
           END                                    AS band
    FROM   "veg_loss_rate_df", stats
)
SELECT ROUND(mu, 2)        AS "avg_loss_rate_%",
       ROUND(sd, 2)        AS "stdev_loss_rate_%",
       SUM(CASE WHEN band = 'Below'  THEN 1 ELSE 0 END) AS "items_below_1_SD",
       SUM(CASE WHEN band = 'Within' THEN 1 ELSE 0 END) AS "items_within_±1_SD",
       SUM(CASE WHEN band = 'Above'  THEN 1 ELSE 0 END) AS "items_above_1_SD"
FROM   stats, banded
LIMIT  20;
```
