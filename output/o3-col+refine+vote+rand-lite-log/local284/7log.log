Query:
--Description: 7) Roll-up counts of items that are BELOW, WITHIN, or ABOVE one standard deviation of the mean.
WITH base AS (
    SELECT AVG("loss_rate_%") AS mu
    FROM   "veg_loss_rate_df"
), stats AS (
    SELECT base.mu,
           sqrt(AVG(POWER(v."loss_rate_%" - base.mu, 2))) AS sd
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN base
), flagged AS (
    SELECT CASE
               WHEN v."loss_rate_%" <  s.mu - s.sd THEN 'Below 1 SD'
               WHEN v."loss_rate_%" >  s.mu + s.sd THEN 'Above 1 SD'
               ELSE                               'Within ±1 SD'
           END AS loss_band
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN stats s
)
SELECT loss_band,
       COUNT(*) AS items_cnt
FROM   flagged
GROUP  BY loss_band
LIMIT  20
