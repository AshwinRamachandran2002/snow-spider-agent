```sql
--Description: Compute the overall mean (µ) of the “loss_rate_%”, derive the standard deviation (σ),
--             label every item as ‘Below 1 SD’, ‘Within ±1 SD’, or ‘Above 1 SD’, then return
--             µ, σ and the count of items in each band—all in a single result-set.
WITH base AS (                              -- µ
    SELECT AVG("loss_rate_%") AS mu
    FROM   "veg_loss_rate_df"
), stats AS (                               -- σ using µ
    SELECT base.mu,
           sqrt(AVG(POWER(v."loss_rate_%" - base.mu, 2))) AS sd
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN base
), banded AS (                              -- classify each item
    SELECT CASE
               WHEN v."loss_rate_%" <  s.mu - s.sd THEN 'Below 1 SD'
               WHEN v."loss_rate_%" >  s.mu + s.sd THEN 'Above 1 SD'
               ELSE                               'Within ±1 SD'
           END AS band
    FROM   "veg_loss_rate_df" v
    CROSS  JOIN stats s
)
SELECT ROUND(s.mu, 2) AS "average_loss_rate_%",
       ROUND(s.sd, 2) AS "stdev_loss_rate_%",
       SUM(CASE WHEN band = 'Below 1 SD'   THEN 1 ELSE 0 END) AS "items_below_1_SD",
       SUM(CASE WHEN band = 'Within ±1 SD' THEN 1 ELSE 0 END) AS "items_within_±1_SD",
       SUM(CASE WHEN band = 'Above 1 SD'   THEN 1 ELSE 0 END) AS "items_above_1_SD"
FROM   stats s, banded;
```
