--Description: ⑦ (Optional extra) List only those items that are ABOVE one σ for a deeper dive  
WITH stats AS (  
    SELECT AVG("loss_rate_%")                                   AS mean_lr,  
           SQRT(AVG("loss_rate_%"*"loss_rate_%")   
                - AVG("loss_rate_%")*AVG("loss_rate_%"))        AS sd_lr  
    FROM "veg_loss_rate_df"  
)  
SELECT DISTINCT "item_code", "item_name", "loss_rate_%"  
FROM "veg_loss_rate_df", stats  
WHERE "loss_rate_%" > stats.mean_lr + stats.sd_lr  
LIMIT 20;
