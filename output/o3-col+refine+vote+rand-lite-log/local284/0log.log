```sql
--Description: ③ What is the average loss-rate (%) for all items?  
SELECT AVG("loss_rate_%") AS avg_loss_rate_pct  
FROM "veg_loss_rate_df";
```

```sql
--Description: ④ Get mean, variance and standard-deviation of the loss-rates  
SELECT  
       AVG("loss_rate_%")                                                    AS mean_loss_rate_pct,  
       AVG("loss_rate_%" * "loss_rate_%")   
         - AVG("loss_rate_%") * AVG("loss_rate_%")                           AS variance_loss_rate,  
       SQRT( AVG("loss_rate_%" * "loss_rate_%")   
             - AVG("loss_rate_%") * AVG("loss_rate_%") )                     AS stddev_loss_rate_pct  
FROM "veg_loss_rate_df";
```

```sql
--Description: ⑤ Show each item and tag it as BELOW / WITHIN / ABOVE one σ from the mean  
WITH stats AS (  
    SELECT AVG("loss_rate_%")                                   AS mean_lr,  
           SQRT(AVG("loss_rate_%"*"loss_rate_%")   
                - AVG("loss_rate_%")*AVG("loss_rate_%"))        AS sd_lr  
    FROM "veg_loss_rate_df"  
)  
SELECT v."item_code",  
       v."item_name",  
       v."loss_rate_%",  
       CASE  
           WHEN v."loss_rate_%" <  stats.mean_lr - stats.sd_lr THEN 'Below 1 SD'  
           WHEN v."loss_rate_%" >  stats.mean_lr + stats.sd_lr THEN 'Above 1 SD'  
           ELSE 'Within 1 SD'  
       END AS deviation_band  
FROM "veg_loss_rate_df" AS v, stats  
LIMIT 20;
```

```sql
--Description: ⑥ Final summary – count of items that fall below, above, or within ±1σ of the mean  
WITH stats AS (  
    SELECT AVG("loss_rate_%")                                   AS mean_lr,  
           SQRT(AVG("loss_rate_%"*"loss_rate_%")   
                - AVG("loss_rate_%")*AVG("loss_rate_%"))        AS sd_lr  
    FROM "veg_loss_rate_df"  
), labelled AS (  
    SELECT CASE  
             WHEN v."loss_rate_%" <  stats.mean_lr - stats.sd_lr THEN 'Below 1 SD'  
             WHEN v."loss_rate_%" >  stats.mean_lr + stats.sd_lr THEN 'Above 1 SD'  
             ELSE 'Within 1 SD'  
           END AS deviation_band  
    FROM "veg_loss_rate_df" AS v, stats  
)  
SELECT deviation_band, COUNT(*) AS item_count  
FROM labelled  
GROUP BY deviation_band;
```

```sql
--Description: ⑦ (Optional extra) List only those items that are ABOVE one σ for a deeper dive  
WITH stats AS (  
    SELECT AVG("loss_rate_%")                                   AS mean_lr,  
           SQRT(AVG("loss_rate_%"*"loss_rate_%")   
                - AVG("loss_rate_%")*AVG("loss_rate_%"))        AS sd_lr  
    FROM "veg_loss_rate_df"  
)  
SELECT DISTINCT "item_code", "item_name", "loss_rate_%"  
FROM "veg_loss_rate_df", stats  
WHERE "loss_rate_%" > stats.mean_lr + stats.sd_lr  
LIMIT 20;
```
