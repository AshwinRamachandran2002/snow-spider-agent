Query:
--Description: ⑤ Show each item and tag it as BELOW / WITHIN / ABOVE one σ from the mean  
WITH stats AS (  
    SELECT AVG("loss_rate_%")                                   AS mean_lr,  
           SQRT(AVG("loss_rate_%"*"loss_rate_%")   
                - AVG("loss_rate_%")*AVG("loss_rate_%"))        AS sd_lr  
    FROM "veg_loss_rate_df"  
)  
SELECT v."item_code",  
       v."item_name",  
       v."loss_rate_%",  
       CASE  
           WHEN v."loss_rate_%" <  stats.mean_lr - stats.sd_lr THEN 'Below 1 SD'  
           WHEN v."loss_rate_%" >  stats.mean_lr + stats.sd_lr THEN 'Above 1 SD'  
           ELSE 'Within 1 SD'  
       END AS deviation_band  
FROM "veg_loss_rate_df" AS v, stats  
LIMIT 20;
