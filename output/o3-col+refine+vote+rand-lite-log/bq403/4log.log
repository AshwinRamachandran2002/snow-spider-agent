```sql
--Description (thinking process):
--Problem ➜ A wildcard scan of the Form-990 “regular” tables from 2012-2017
--fails because the 2012 table stores tax_pd as STRING while every later
--table stores it as INT64.  BigQuery cannot union columns of different
--types in a single wildcard reference.
--
--Solution strategy in ONE query:
-- 1. Pull 2012 explicitly (no cast needed, tax_pd already STRING).
-- 2. Pull 2013-2017 with a wildcard and CAST their INT64 tax_pd to STRING,
--    then take the first four characters to yield the filing year.
-- 3. UNION ALL the two result sets inside a CTE called base.
-- 4. From that unified set, compute per-year medians for revenue and
--    functional expenses using APPROX_QUANTILES(...,2)[OFFSET(1)].
-- 5. Return one row per year, ordered chronologically.
--
--This single statement avoids the type clash and produces the desired
--year-level medians for Form-990 (regular) filers.

WITH base AS (
  /* ---- 2012 table (tax_pd is STRING) ---- */
  SELECT
    '2012'           AS filing_year,
    totrevenue       AS totrevenue,
    totfuncexpns     AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_2012`

  UNION ALL

  /* ---- 2013-2017 tables (tax_pd is INT64 → CAST to STRING) ---- */
  SELECT
    SUBSTR(CAST(tax_pd AS STRING),1,4) AS filing_year,
    totrevenue,
    totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'
)

SELECT
  filing_year,
  APPROX_QUANTILES(totrevenue,   2)[OFFSET(1)] AS median_revenue,
  APPROX_QUANTILES(totfuncexpns, 2)[OFFSET(1)] AS median_expenses
FROM base
GROUP BY filing_year
ORDER BY filing_year;
```
