```sql
--Description: Compute median total revenue and expenses for Form-990-EZ
--returns (2012-2017) while handling the tax_pd type mismatch exactly as we
--did for the “regular” 990 tables.  We pull 2012 explicitly (tax_pd is
--STRING) and use a wildcard for 2013-2017 (tax_pd is INT64), then UNION the
--two parts and aggregate.
WITH base AS (
  /* ---- 2012 EZ table (tax_pd is STRING) ---- */
  SELECT
    '2012'                      AS filing_year,
    totrevnue                   AS totrevenue,
    totexpns                    AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_2012`

  UNION ALL

  /* ---- 2013-2017 EZ tables (tax_pd is INT64 → CAST to STRING) ---- */
  SELECT
    SUBSTR(CAST(tax_pd AS STRING),1,4) AS filing_year,
    totrevnue                           AS totrevenue,
    totexpns                            AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'
)
SELECT
  filing_year,
  APPROX_QUANTILES(totrevenue ,2)[OFFSET(1)] AS median_revenue,
  APPROX_QUANTILES(totfuncexpns,2)[OFFSET(1)] AS median_expenses
FROM base
GROUP BY filing_year
ORDER BY filing_year
LIMIT 20;
```

```sql
--Description: Median total revenue and expenses for Form-990-PF filers
--(private foundations).  The PF tables use a consistent schema across years,
--so a single wildcard scan works without special handling.
SELECT
  filing_year,
  APPROX_QUANTILES(totrevenue ,2)[OFFSET(1)] AS median_revenue,
  APPROX_QUANTILES(totfuncexpns,2)[OFFSET(1)] AS median_expenses
FROM (
  SELECT
    CAST(tax_yr AS STRING)      AS filing_year,
    totrcptperbks               AS totrevenue,
    totexpnspbks                AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_pf_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
)
GROUP BY filing_year
ORDER BY filing_year
LIMIT 20;
```

```sql
--Description: Build a unified 2012-2017 panel (regular, EZ, PF) of revenue
--and expenses while working around type clashes in the regular & EZ 2012
--tables.  Each form/year segment is UNIONed separately; result limited to
--20 rows for inspection.
SELECT
  filing_year,
  totrevenue,
  totfuncexpns
FROM (
  /* ---- regular 990, 2012 ---- */
  SELECT '2012', totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_2012`

  UNION ALL
  /* ---- regular 990, 2013-2017 ---- */
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4), totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'

  UNION ALL
  /* ---- EZ 990, 2012 ---- */
  SELECT '2012', totrevnue, totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_2012`

  UNION ALL
  /* ---- EZ 990, 2013-2017 ---- */
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4), totrevnue, totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'

  UNION ALL
  /* ---- PF 990, 2012-2017 ---- */
  SELECT CAST(tax_yr AS STRING), totrcptperbks, totexpnspbks
  FROM `bigquery-public-data.irs_990.irs_990_pf_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
)
LIMIT 20;
```

```sql
--Description: From the unified panel (built with the same UNION logic as in
--#8 but without the LIMIT), calculate the median revenue and expenses for
--each year 2012-2017.
WITH unified AS (
  /* identical UNION to #8 but without the LIMIT clause */
  SELECT '2012' AS filing_year, totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_2012`
  UNION ALL
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4), totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'
  UNION ALL
  SELECT '2012', totrevnue, totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_2012`
  UNION ALL
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4), totrevnue, totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'
  UNION ALL
  SELECT CAST(tax_yr AS STRING), totrcptperbks, totexpnspbks
  FROM `bigquery-public-data.irs_990.irs_990_pf_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
)
SELECT
  filing_year,
  APPROX_QUANTILES(totrevenue ,2)[OFFSET(1)] AS median_revenue,
  APPROX_QUANTILES(totfuncexpns,2)[OFFSET(1)] AS median_expenses
FROM unified
GROUP BY filing_year
ORDER BY filing_year
LIMIT 20;
```

```sql
--Description: Identify the three years (2012-2017) with the smallest absolute
--gap between the median revenue and median expenses, using the year-level
--medians derived in the previous query (now without its LIMIT).
WITH unified AS (
  /* same UNION of the three form types, no LIMIT */
  SELECT '2012' AS filing_year, totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_2012`
  UNION ALL
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4), totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'
  UNION ALL
  SELECT '2012', totrevnue, totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_2012`
  UNION ALL
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4), totrevnue, totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'
  UNION ALL
  SELECT CAST(tax_yr AS STRING), totrcptperbks, totexpnspbks
  FROM `bigquery-public-data.irs_990.irs_990_pf_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
),
year_medians AS (
  SELECT
    filing_year,
    APPROX_QUANTILES(totrevenue ,2)[OFFSET(1)] AS median_revenue,
    APPROX_QUANTILES(totfuncexpns,2)[OFFSET(1)] AS median_expenses
  FROM unified
  GROUP BY filing_year
)
SELECT
  filing_year                       AS year,
  ABS(median_revenue - median_expenses) AS median_gap
FROM year_medians
ORDER BY median_gap
LIMIT 20;
```
