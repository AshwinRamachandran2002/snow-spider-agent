```sql
--Description:
--Objective ⟶ Find the three calendar years (2012-2017) whose median
--total revenue is closest to their median total expenses across ALL filers
--of IRS-990 returns (regular 990, 990-EZ, 990-PF).
--
--Key hurdles:
--  • In the 2012 “regular” and “EZ” tables the date field (tax_pd) is
--    STRING, whereas in later yearly tables it is INT64.  A wildcard scan
--    therefore needs explicit CASTing, or we must separate 2012.
--  • All UNION branches must expose identical column names/types.
--
--Single-query strategy:
--  1. Build a CTE (unified) that UNIONs every filing:
--       – Regular Form 990: 2012 table explicitly, 2013-2017 via wildcard
--         with CAST(tax_pd AS STRING).
--       – Form 990-EZ: same pattern.
--       – Form 990-PF: schema already consistent; no special casting.
--  2. In a second CTE (year_medians) compute per-year medians for revenue and
--     expenses using APPROX_QUANTILES(…,2)[OFFSET(1)].
--  3. Select the three years with the smallest absolute gap between those
--     two medians.
--Return columns: year, median_gap.

WITH unified AS (
  /* ---------- Form 990 (regular) ---------- */
  SELECT '2012' AS filing_year, totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_2012`
  UNION ALL
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4) AS filing_year,
         totrevenue, totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'

  /* ---------- Form 990-EZ ---------- */
  UNION ALL
  SELECT '2012' AS filing_year, totrevnue AS totrevenue, totexpns AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_2012`
  UNION ALL
  SELECT SUBSTR(CAST(tax_pd AS STRING),1,4) AS filing_year,
         totrevnue AS totrevenue, totexpns AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_*`
  WHERE _TABLE_SUFFIX BETWEEN '2013' AND '2017'

  /* ---------- Form 990-PF ---------- */
  UNION ALL
  SELECT CAST(tax_yr AS STRING) AS filing_year,
         totrcptperbks AS totrevenue,
         totexpnspbks  AS totfuncexpns
  FROM `bigquery-public-data.irs_990.irs_990_pf_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
),
year_medians AS (
  SELECT
    filing_year,
    APPROX_QUANTILES(totrevenue  ,2)[OFFSET(1)] AS median_revenue,
    APPROX_QUANTILES(totfuncexpns,2)[OFFSET(1)] AS median_expenses
  FROM unified
  GROUP BY filing_year
)
SELECT
  filing_year AS year,
  ABS(median_revenue - median_expenses) AS median_gap
FROM year_medians
ORDER BY median_gap
LIMIT 3;
```
