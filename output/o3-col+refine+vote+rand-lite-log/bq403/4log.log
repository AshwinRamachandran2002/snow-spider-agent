```sql
-- 10) Final answer: 3 smallest absolute gaps between the two medians
SELECT filing_year          AS year,
       ABS(median_revenue - median_expenses) AS median_gap
FROM (
  -- reuse query #9 but without LIMIT
  SELECT filing_year,
         APPROX_QUANTILES(totrevenue , 2)[OFFSET(1)]  AS median_revenue,
         APPROX_QUANTILES(totfuncexpns, 2)[OFFSET(1)] AS median_expenses
  FROM (
    SELECT SUBSTR(CAST(`tax_pd` AS STRING),1,4) AS filing_year,
           `totrevenue`, `totfuncexpns`
    FROM `bigquery-public-data.irs_990.irs_990_*`
    WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
    UNION ALL
    SELECT SUBSTR(CAST(`tax_pd` AS STRING),1,4),
           `totrevnue`, `totexpns`
    FROM `bigquery-public-data.irs_990.irs_990_ez_*`
    WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'
    UNION ALL
    SELECT CAST(`tax_yr` AS STRING),
           `totrcptperbks`, `totexpnspbks`
    FROM `bigquery-public-data.irs_990.irs_990_pf_*`
    WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017`
  )
  GROUP BY filing_year
)
ORDER BY median_gap
LIMIT 20;
```

