```sql
/* 3 calendar years (2012-2017) with the smallest gap between
   median revenue and median expenses across all 990 filing types */
WITH filings AS (
  /* ---------- “regular” 990 returns ---------- */
  SELECT
    CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64)           AS yr,
    totrevenue                                                  AS rev,
    totfuncexpns                                                AS exp
  FROM `bigquery-public-data.irs_990.irs_990_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'

  UNION ALL

  /* ---------- 990-EZ returns ------------------ */
  SELECT
    CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64)           AS yr,
    totrevnue                                                   AS rev,
    totexpns                                                    AS exp
  FROM `bigquery-public-data.irs_990.irs_990_ez_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'

  UNION ALL

  /* ---------- 990-PF returns ------------------ */
  SELECT
    tax_yr                                                      AS yr,
    totrcptperbks                                               AS rev,
    totexpnspbks                                                AS exp
  FROM `bigquery-public-data.irs_990.irs_990_pf_*`
  WHERE _TABLE_SUFFIX BETWEEN '2012' AND '2017'          -- PF tables exist through 2016
)
SELECT
  yr,
  APPROX_QUANTILES(rev, 2)[OFFSET(1)] AS median_revenue,
  APPROX_QUANTILES(exp, 2)[OFFSET(1)] AS median_expenses,
  ABS(
    APPROX_QUANTILES(rev, 2)[OFFSET(1)] -
    APPROX_QUANTILES(exp, 2)[OFFSET(1)]
  )                                  AS abs_difference
FROM filings
WHERE yr BETWEEN 2012 AND 2017
GROUP BY yr
ORDER BY abs_difference
LIMIT 3;
```
