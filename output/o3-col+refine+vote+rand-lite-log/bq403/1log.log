Query:
--Description: Fix #5 – compute 2013 medians.  Alias revenue/expense columns as rev / exp, then use them.
WITH yr2013 AS (
  SELECT totrevenue      AS rev,
         totfuncexpns    AS exp
  FROM `bigquery-public-data.irs_990.irs_990_2013`
  UNION ALL
  SELECT totrevnue       AS rev,
         totexpns        AS exp
  FROM `bigquery-public-data.irs_990.irs_990_ez_2013`
  UNION ALL
  SELECT totrcptperbks   AS rev,
         totexpnspbks    AS exp
  FROM `bigquery-public-data.irs_990.irs_990_pf_2013`
)
SELECT
  APPROX_QUANTILES(rev, 2)[OFFSET(1)] AS median_rev,
  APPROX_QUANTILES(exp, 2)[OFFSET(1)] AS median_exp,
  ABS(
    APPROX_QUANTILES(rev, 2)[OFFSET(1)] -
    APPROX_QUANTILES(exp, 2)[OFFSET(1)]
  ) AS abs_diff_2013
FROM yr2013
