  FROM `bigquery-public-data.irs_990.irs_990_2012`
  UNION ALL
  SELECT 2012 , totrevnue , totexpns
  FROM `bigquery-public-data.irs_990.irs_990_ez_2012`
  UNION ALL
  SELECT 2012 , totrcptperbks , totexpnspbks
  FROM `bigquery-public-data.irs_990.irs_990_pf_2012`
)
SELECT
  APPROX_QUANTILES(rev ,2)[OFFSET(1)]  AS median_rev ,
  APPROX_QUANTILES(exp ,2)[OFFSET(1)]  AS median_exp ,
  ABS(APPROX_QUANTILES(rev ,2)[OFFSET(1)]
