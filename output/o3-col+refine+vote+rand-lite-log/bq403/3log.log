Query:
--Description: 6) Combine all six “full” 990 tables (2012-2017), compute the
--              median revenue & median functional expenses for each year,
--              then list the three years having the smallest absolute gap.
SELECT
  year,
  med_rev,
  med_exp,
  ABS(med_rev - med_exp) AS abs_diff_rev_exp
FROM (
  SELECT
    year,
    APPROX_QUANTILES(totrevenue   ,2)[OFFSET(1)] AS med_rev,
    APPROX_QUANTILES(totfuncexpns,2)[OFFSET(1)] AS med_exp
  FROM (
    -- 2012
    SELECT CAST(SUBSTR(tax_pd,1,4) AS INT64) AS year,
           totrevenue,
           totfuncexpns
    FROM   `bigquery-public-data.irs_990.irs_990_2012`
    UNION ALL
    -- 2013
    SELECT CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64),
           totrevenue,
           totfuncexpns
    FROM   `bigquery-public-data.irs_990.irs_990_2013`
    UNION ALL
    -- 2014
    SELECT CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64),
           totrevenue,
           totfuncexpns
    FROM   `bigquery-public-data.irs_990.irs_990_2014`
    UNION ALL
    -- 2015
    SELECT CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64),
           totrevenue,
           totfuncexpns
    FROM   `bigquery-public-data.irs_990.irs_990_2015`
    UNION ALL
    -- 2016
    SELECT CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64),
           totrevenue,
           totfuncexpns
    FROM   `bigquery-public-data.irs_990.irs_990_2016`
    UNION ALL
    -- 2017
    SELECT CAST(SUBSTR(CAST(tax_pd AS STRING),1,4) AS INT64),
           totrevenue,
           totfuncexpns
    FROM   `bigquery-public-data.irs_990.irs_990_2017`
  )
  WHERE totrevenue IS NOT NULL
    AND totfuncexpns IS NOT NULL
  GROUP BY year
)
ORDER BY abs_diff_rev_exp
LIMIT 3;
