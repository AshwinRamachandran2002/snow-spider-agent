--Description: 8) Aggregate across all targeted grants to tally occurrences of every 4-digit IPC code
SELECT
    SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",
    COUNT(*) AS "ipc4_occurrences"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."ipc") f
WHERE t."country_code"     = 'US'
  AND t."kind_code"        = 'B2'
  AND t."application_kind" = 'A'
  AND t."grant_date" BETWEEN 20220601 AND 20220831
GROUP BY "ipc4"
ORDER BY "ipc4_occurrences" DESC
LIMIT 20
