--Description: 10) Final query – returns the most common 4-digit IPC code among U.S. B2 utility patents granted Jun-Aug 2022
SELECT
    SUBSTR(f.value:"code"::STRING, 1, 4) AS "most_common_ipc4",
    COUNT(*) AS "frequency"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."ipc") f
WHERE t."country_code"     = 'US'
  AND t."kind_code"        = 'B2'
  AND t."application_kind" = 'A'
  AND t."grant_date" BETWEEN 20220601 AND 20220831
GROUP BY "most_common_ipc4"
ORDER BY "frequency" DESC
LIMIT 1
