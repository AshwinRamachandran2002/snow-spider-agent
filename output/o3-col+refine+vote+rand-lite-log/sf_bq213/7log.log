```sql
--Description: 1) Inspect a random sample of publications that were granted between June 1 and Aug 31 2022 (any country, any kind)  
SELECT *  
FROM PATENTS.PATENTS.PUBLICATIONS t  
WHERE t."grant_date" BETWEEN 20220601 AND 20220831  
LIMIT 20;
```

```sql
--Description: 2) Narrow the sample to U.S. publications only (country_code = 'US') in the same grant-date window  
SELECT t."publication_number", t."country_code", t."kind_code", t."application_kind",  
       t."grant_date", t."ipc"  
FROM PATENTS.PATENTS.PUBLICATIONS t  
WHERE t."country_code" = 'US'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
LIMIT 20;
```

```sql
--Description: 3) Further restrict to U.S. utility patent GRANTS with kind_code = 'B2' (typical for granted utility patents)  
SELECT t."publication_number", t."kind_code", t."application_kind",  
       t."grant_date", t."ipc"  
FROM PATENTS.PATENTS.PUBLICATIONS t  
WHERE t."country_code" = 'US'  
  AND t."kind_code" = 'B2'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
  AND t."application_kind" = 'A'      -- ‘A’ = utility patent application/grant  
LIMIT 20;
```

```sql
--Description: 4) Take one of the returned publications and look inside its full IPC array to learn the nested structure  
SELECT f.value  
FROM PATENTS.PATENTS.PUBLICATIONS t,  
     LATERAL FLATTEN(input => t."ipc") f  
WHERE t."publication_number" = 'US-XXXXXXX-B2'   -- replace with an actual pub number from Query 3 result  
LIMIT 20;
```

```sql
--Description: 5) For the filtered U.S. B2 grants, flatten the IPC array and list each IPC code element  
SELECT t."publication_number",  
       f.value:"code"::STRING AS "ipc_code_full"  
FROM PATENTS.PATENTS.PUBLICATIONS t,  
     LATERAL FLATTEN(input => t."ipc") f  
WHERE t."country_code" = 'US'  
  AND t."kind_code" = 'B2'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
  AND t."application_kind" = 'A'  
LIMIT 20;
```

```sql
--Description: 6) Extract the first 4 characters of every IPC code (the 4-digit IPC level) for a quick look  
SELECT t."publication_number",  
       SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4"  
FROM PATENTS.PATENTS.PUBLICATIONS t,  
     LATERAL FLATTEN(input => t."ipc") f  
WHERE t."country_code" = 'US'  
  AND t."kind_code" = 'B2'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
  AND t."application_kind" = 'A'  
LIMIT 20;
```

```sql
--Description: 7) Count how many distinct 4-digit IPC codes each publication carries (optional diagnostics)  
SELECT t."publication_number",  
       COUNT(DISTINCT SUBSTR(f.value:"code"::STRING, 1, 4)) AS "distinct_ipc4_cnt"  
FROM PATENTS.PATENTS.PUBLICATIONS t,  
     LATERAL FLATTEN(input => t."ipc") f  
WHERE t."country_code" = 'US'  
  AND t."kind_code" = 'B2'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
  AND t."application_kind" = 'A'  
GROUP BY t."publication_number"  
LIMIT 20;
```

```sql
--Description: 8) Aggregate across all targeted grants to tally occurrences of every 4-digit IPC code  
SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",  
       COUNT(*) AS "ipc4_occurrences"  
FROM PATENTS.PATENTS.PUBLICATIONS t,  
     LATERAL FLATTEN(input => t."ipc") f  
WHERE t."country_code" = 'US'  
  AND t."kind_code" = 'B2'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
  AND t."application_kind" = 'A'  
GROUP BY "ipc4"  
ORDER BY "ipc4_occurrences" DESC  
LIMIT 20;
```

```sql
--Description: 9) Verify that the top result truly is the single most common code by limiting to the winner only (sub-query)  
SELECT top_ipc."ipc4", top_ipc."ipc4_occurrences"  
FROM (  
    SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4",  
           COUNT(*) AS "ipc4_occurrences"  
    FROM PATENTS.PATENTS.PUBLICATIONS t,  
         LATERAL FLATTEN(input => t."ipc") f  
    WHERE t."country_code" = 'US'  
      AND t."kind_code" = 'B2'  
      AND t."grant_date" BETWEEN 20220601 AND 20220831  
      AND t."application_kind" = 'A'  
    GROUP BY "ipc4"  
    ORDER BY "ipc4_occurrences" DESC  
    LIMIT 1  
) AS top_ipc;
```

```sql
--Description: 10) Final answer query – returns the most common 4-digit IPC code among U.S. B2 utility patents granted Jun-Aug 2022  
SELECT SUBSTR(f.value:"code"::STRING, 1, 4) AS "most_common_ipc4",  
       COUNT(*) AS "frequency"  
FROM PATENTS.PATENTS.PUBLICATIONS t,  
     LATERAL FLATTEN(input => t."ipc") f  
WHERE t."country_code" = 'US'  
  AND t."kind_code" = 'B2'  
  AND t."grant_date" BETWEEN 20220601 AND 20220831  
  AND t."application_kind" = 'A'  
GROUP BY "most_common_ipc4"  
ORDER BY "frequency" DESC  
LIMIT 1;
```
