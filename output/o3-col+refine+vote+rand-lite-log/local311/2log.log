Query:
-- Description: Pick, for each constructor in every year, the best-scoring driver (highest driver-standings points) at the season-final race.
SELECT fr.year,
       res.constructor_id,
       MAX(ds.points) AS best_driver_points
FROM driver_standings AS ds
JOIN (
      SELECT r.year, r.race_id
      FROM races AS r
      JOIN (
            SELECT year, MAX(round) AS max_round
            FROM races
            GROUP BY year
      ) AS f
        ON r.year = f.year
       AND r.round = f.max_round
) AS fr
  ON ds.race_id = fr.race_id
JOIN results AS res
  ON ds.race_id = res.race_id
 AND ds.driver_id = res.driver_id
GROUP BY fr.year, res.constructor_id
ORDER BY fr.year, best_driver_points DESC
LIMIT 20;
