Query:
-- Description: List the race_id (and round) of the season-final race for each year.
SELECT r.year,
       r.race_id,
       r.round
FROM races AS r
JOIN (
      SELECT year, MAX(round) AS max_round
      FROM races
      GROUP BY year
) AS f
  ON r.year = f.year
 AND r.round = f.max_round
ORDER BY r.year
LIMIT 20;
