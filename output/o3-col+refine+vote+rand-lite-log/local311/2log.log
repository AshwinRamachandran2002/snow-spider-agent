```sql
-- Description: Preview the sequence of races (year-round-name) to understand which race is the season-final in every year.
SELECT year, race_id, round, name
FROM races
ORDER BY year, round
LIMIT 20;
```

```sql
-- Description: For every season, find the highest round number – this marks the last (championship-deciding) race of that year.
SELECT year, MAX(round) AS max_round
FROM races
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
-- Description: List the race_id (and round) of the season-final race for each year.
SELECT r.year,
       r.race_id,
       r.round
FROM races AS r
JOIN (
      SELECT year, MAX(round) AS max_round
      FROM races
      GROUP BY year
) AS f
  ON r.year = f.year
 AND r.round = f.max_round
ORDER BY r.year
LIMIT 20;
```

```sql
-- Description: Show constructor points scored at the season-final race (these rows hold the full-season constructor totals).
SELECT fr.year,
       cs.constructor_id,
       cs.points
FROM constructor_standings AS cs
JOIN (
      SELECT r.year, r.race_id
      FROM races AS r
      JOIN (
            SELECT year, MAX(round) AS max_round
            FROM races
            GROUP BY year
      ) AS f
        ON r.year = f.year
       AND r.round = f.max_round
) AS fr
  ON cs.race_id = fr.race_id
ORDER BY fr.year, cs.points DESC
LIMIT 20;
```

```sql
-- Description: For every driver who took part in the season-final, attach the constructor they drove for and show their driver-standings points.
SELECT fr.year,
       ds.driver_id,
       res.constructor_id,
       ds.points
FROM driver_standings AS ds
JOIN (
      SELECT r.year, r.race_id
      FROM races AS r
      JOIN (
            SELECT year, MAX(round) AS max_round
            FROM races
            GROUP BY year
      ) AS f
        ON r.year = f.year
       AND r.round = f.max_round
) AS fr
  ON ds.race_id = fr.race_id
JOIN results AS res
  ON ds.race_id = res.race_id
 AND ds.driver_id = res.driver_id
LIMIT 20;
```

```sql
-- Description: Pick, for each constructor in every year, the best-scoring driver (highest driver-standings points) at the season-final race.
SELECT fr.year,
       res.constructor_id,
       MAX(ds.points) AS best_driver_points
FROM driver_standings AS ds
JOIN (
      SELECT r.year, r.race_id
      FROM races AS r
      JOIN (
            SELECT year, MAX(round) AS max_round
            FROM races
            GROUP BY year
      ) AS f
        ON r.year = f.year
       AND r.round = f.max_round
) AS fr
  ON ds.race_id = fr.race_id
JOIN results AS res
  ON ds.race_id = res.race_id
 AND ds.driver_id = res.driver_id
GROUP BY fr.year, res.constructor_id
ORDER BY fr.year, best_driver_points DESC
LIMIT 20;
```

```sql
-- Description: Combine team points and best driver points to get a “combined points” figure for each constructor in every season.
SELECT t.year,
       t.constructor_id,
       t.points + d.best_driver_points AS combined_points
FROM (
      SELECT fr.year,
             cs.constructor_id,
             cs.points
      FROM constructor_standings AS cs
      JOIN (
            SELECT r.year, r.race_id
            FROM races AS r
            JOIN (
                  SELECT year, MAX(round) AS max_round
                  FROM races
                  GROUP BY year
            ) AS f
              ON r.year = f.year
             AND r.round = f.max_round
      ) AS fr
        ON cs.race_id = fr.race_id
) AS t
JOIN (
      SELECT fr.year,
             res.constructor_id,
             MAX(ds.points) AS best_driver_points
      FROM driver_standings AS ds
      JOIN (
            SELECT r.year, r.race_id
            FROM races AS r
            JOIN (
                  SELECT year, MAX(round) AS max_round
                  FROM races
                  GROUP BY year
            ) AS f
              ON r.year = f.year
             AND r.round = f.max_round
      ) AS fr
        ON ds.race_id = fr.race_id
      JOIN results AS res
        ON ds.race_id = res.race_id
       AND ds.driver_id = res.driver_id
      GROUP BY fr.year, res.constructor_id
) AS d
  ON t.year = d.year
 AND t.constructor_id = d.constructor_id
ORDER BY combined_points DESC
LIMIT 20;
```

```sql
-- Description: Retrieve the three highest “combined points” records ever, showing the constructor name, season and total points achieved.
SELECT c.name              AS constructor_name,
       combined.year,
       combined.combined_points
FROM (
      SELECT t.year,
             t.constructor_id,
             t.points + d.best_driver_points AS combined_points
      FROM (
            SELECT fr.year,
                   cs.constructor_id,
                   cs.points
            FROM constructor_standings AS cs
            JOIN (
                  SELECT r.year, r.race_id
                  FROM races AS r
                  JOIN (
                        SELECT year, MAX(round) AS max_round
                        FROM races
                        GROUP BY year
                  ) AS f
                    ON r.year = f.year
                   AND r.round = f.max_round
            ) AS fr
              ON cs.race_id = fr.race_id
      ) AS t
      JOIN (
            SELECT fr.year,
                   res.constructor_id,
                   MAX(ds.points) AS best_driver_points
            FROM driver_standings AS ds
            JOIN (
                  SELECT r.year, r.race_id
                  FROM races AS r
                  JOIN (
                        SELECT year, MAX(round) AS max_round
                        FROM races
                        GROUP BY year
                  ) AS f
                    ON r.year = f.year
                   AND r.round = f.max_round
            ) AS fr
              ON ds.race_id = fr.race_id
            JOIN results AS res
              ON ds.race_id = res.race_id
             AND ds.driver_id = res.driver_id
            GROUP BY fr.year, res.constructor_id
      ) AS d
        ON t.year = d.year
       AND t.constructor_id = d.constructor_id
) AS combined
JOIN constructors AS c
  ON c.constructor_id = combined.constructor_id
ORDER BY combined.combined_points DESC
LIMIT 3;
```
