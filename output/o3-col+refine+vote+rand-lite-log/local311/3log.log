--Description: Merge constructor’s own points with their best driver’s points, calculate combined total per season.
SELECT cp."year",
       cp."constructor_id",
       c."name"                                        AS constructor_name,
       cp."final_constructor_points",
       bd."best_driver_points",
       (cp."final_constructor_points" + bd."best_driver_points") AS combined_points
FROM (
        -- final constructor points (query #4)
        SELECT r."year",
               cs."constructor_id",
               cs."points" AS final_constructor_points
        FROM   "constructor_standings" cs
        JOIN   "races"                r ON r."race_id" = cs."race_id"
        WHERE  (r."year", r."round") IN (
                 SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
               )
     ) AS cp
JOIN (
        -- best driver points (query #8)
        SELECT cd."year",
               cd."constructor_id",
               MAX(cd."best_driver_points") AS best_driver_points
        FROM   (
                 SELECT cd1."year",
                        cd1."constructor_id",
                        cd1."best_driver_points"
                 FROM (
                        SELECT fd."year",
                               fd."constructor_id",
                               fd."driver_id",
                               fd."final_driver_points" AS best_driver_points
                        FROM (
                               -- reuse same subquery from #7
                               SELECT fd2."year",
                                      res."constructor_id",
                                      fd2."driver_id",
                                      fd2."final_driver_points"
                               FROM (
                                      SELECT r."year",
                                             ds."driver_id",
                                             ds."points" AS final_driver_points,
                                             ds."race_id"
                                      FROM   "driver_standings" ds
                                      JOIN   "races"            r ON r."race_id" = ds."race_id"
                                      WHERE  (r."year", r."round") IN (
                                               SELECT r3."year", MAX(r3."round") FROM "races" r3 GROUP BY r3."year"
                                             )
                                    ) AS fd2
                               JOIN "results" AS res ON res."race_id" = fd2."race_id"
                                                    AND res."driver_id" = fd2."driver_id"
                             ) AS fd
                      ) AS cd1
              ) AS cd
        GROUP BY cd."year", cd."constructor_id"
     ) AS bd
     ON  cp."year"           = bd."year"
     AND cp."constructor_id" = bd."constructor_id"
JOIN "constructors" AS c ON c."constructor_id" = cp."constructor_id"
LIMIT 20;
