--Description: Combine previous two queries to map final driver points to their constructor in that season’s last race.
SELECT fd."year",
       res."constructor_id",
       fd."driver_id",
       fd."final_driver_points"
FROM (
        SELECT r."year",
               ds."driver_id",
               ds."points" AS final_driver_points,
               ds."race_id"
        FROM   "driver_standings" ds
        JOIN   "races"            r  ON r."race_id" = ds."race_id"
        WHERE  (r."year", r."round") IN (
                 SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
               )
     ) AS fd
JOIN "results" AS res ON res."race_id" = fd."race_id"
                     AND res."driver_id" = fd."driver_id"
LIMIT 20;
