```sql
--Description: Preview constructor standings together with the race’s season year.
SELECT cs."constructor_standings_id",
       cs."constructor_id",
       c."name"                           AS constructor_name,
       r."year",
       cs."points",
       cs."position"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r  ON r."race_id"        = cs."race_id"
JOIN   "constructors"          AS c  ON c."constructor_id" = cs."constructor_id"
LIMIT 20;
```

```sql
--Description: Preview driver standings together with the race’s season year.
SELECT ds."driver_standings_id",
       ds."driver_id",
       d."forename" || ' ' || d."surname" AS driver_name,
       r."year",
       ds."points",
       ds."position"
FROM   "driver_standings" AS ds
JOIN   "drivers"          AS d  ON d."driver_id" = ds."driver_id"
JOIN   "races"            AS r  ON r."race_id"   = ds."race_id"
LIMIT 20;
```

```sql
--Description: Find the last (max round) race_id of every year – these correspond to the final standings of a season.
SELECT r1."year",
       MAX(r1."round")      AS last_round,
       MAX(r1."race_id")    AS last_race_id         -- (safe while sample DB has increasing ids)
FROM   "races" AS r1
GROUP  BY r1."year"
LIMIT 20;
```

```sql
--Description: Final constructor points by season (only the last race of each year).
SELECT r."year",
       cs."constructor_id",
       c."name"                    AS constructor_name,
       cs."points"                 AS final_constructor_points
FROM   "constructor_standings" AS cs
JOIN   "races"                AS r  ON r."race_id" = cs."race_id"
JOIN   "constructors"         AS c  ON c."constructor_id" = cs."constructor_id"
WHERE  (r."year", r."round") IN (
         SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
       )
LIMIT 20;
```

```sql
--Description: Identify each driver’s constructor (team) in the final race of every season.
SELECT r."year",
       res."constructor_id",
       res."driver_id"
FROM   "results"  AS res
JOIN   "races"    AS r  ON r."race_id" = res."race_id"
WHERE  (r."year", r."round") IN (
         SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
       )
LIMIT 20;
```

```sql
--Description: Final driver points for drivers (only their standings after last race of each season).
SELECT r."year",
       ds."driver_id",
       ds."points" AS final_driver_points
FROM   "driver_standings" AS ds
JOIN   "races"            AS r  ON r."race_id" = ds."race_id"
WHERE  (r."year", r."round") IN (
         SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
       )
LIMIT 20;
```

```sql
--Description: Combine previous two queries to map final driver points to their constructor in that season’s last race.
SELECT fd."year",
       res."constructor_id",
       fd."driver_id",
       fd."final_driver_points"
FROM (
        SELECT r."year",
               ds."driver_id",
               ds."points" AS final_driver_points,
               ds."race_id"
        FROM   "driver_standings" ds
        JOIN   "races"            r  ON r."race_id" = ds."race_id"
        WHERE  (r."year", r."round") IN (
                 SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
               )
     ) AS fd
JOIN "results" AS res ON res."race_id" = fd."race_id"
                     AND res."driver_id" = fd."driver_id"
LIMIT 20;
```

```sql
--Description: For every constructor-year, keep the best (maximum-point) driver’s total.
SELECT cd."year",
       cd."constructor_id",
       MAX(cd."final_driver_points") AS best_driver_points
FROM (
        SELECT fd."year",
               fd."constructor_id",
               fd."driver_id",
               fd."final_driver_points"
        FROM (
               -- the combined query written above
               SELECT fd2."year",
                      res."constructor_id",
                      fd2."driver_id",
                      fd2."final_driver_points"
               FROM (
                      SELECT r."year",
                             ds."driver_id",
                             ds."points" AS final_driver_points,
                             ds."race_id"
                      FROM   "driver_standings" ds
                      JOIN   "races"            r  ON r."race_id" = ds."race_id"
                      WHERE  (r."year", r."round") IN (
                                SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
                              )
                    ) AS fd2
               JOIN "results" AS res ON res."race_id" = fd2."race_id"
                                    AND res."driver_id" = fd2."driver_id"
            ) AS fd
     ) AS cd
GROUP BY cd."year", cd."constructor_id"
LIMIT 20;
```

```sql
--Description: Merge constructor’s own points with their best driver’s points, calculate combined total per season.
SELECT cp."year",
       cp."constructor_id",
       c."name"                                        AS constructor_name,
       cp."final_constructor_points",
       bd."best_driver_points",
       (cp."final_constructor_points" + bd."best_driver_points") AS combined_points
FROM (
        -- final constructor points (query #4)
        SELECT r."year",
               cs."constructor_id",
               cs."points" AS final_constructor_points
        FROM   "constructor_standings" cs
        JOIN   "races"                r ON r."race_id" = cs."race_id"
        WHERE  (r."year", r."round") IN (
                 SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
               )
     ) AS cp
JOIN (
        -- best driver points (query #8)
        SELECT cd."year",
               cd."constructor_id",
               MAX(cd."best_driver_points") AS best_driver_points
        FROM   (
                 SELECT cd1."year",
                        cd1."constructor_id",
                        cd1."best_driver_points"
                 FROM (
                        SELECT fd."year",
                               fd."constructor_id",
                               fd."driver_id",
                               fd."final_driver_points" AS best_driver_points
                        FROM (
                               -- reuse same subquery from #7
                               SELECT fd2."year",
                                      res."constructor_id",
                                      fd2."driver_id",
                                      fd2."final_driver_points"
                               FROM (
                                      SELECT r."year",
                                             ds."driver_id",
                                             ds."points" AS final_driver_points,
                                             ds."race_id"
                                      FROM   "driver_standings" ds
                                      JOIN   "races"            r ON r."race_id" = ds."race_id"
                                      WHERE  (r."year", r."round") IN (
                                               SELECT r3."year", MAX(r3."round") FROM "races" r3 GROUP BY r3."year"
                                             )
                                    ) AS fd2
                               JOIN "results" AS res ON res."race_id" = fd2."race_id"
                                                    AND res."driver_id" = fd2."driver_id"
                             ) AS fd
                      ) AS cd1
              ) AS cd
        GROUP BY cd."year", cd."constructor_id"
     ) AS bd
     ON  cp."year"           = bd."year"
     AND cp."constructor_id" = bd."constructor_id"
JOIN "constructors" AS c ON c."constructor_id" = cp."constructor_id"
LIMIT 20;
```

```sql
--Description: Return the top-3 constructor-year combinations with the highest combined points (final answer).
SELECT final."constructor_name",
       final."year",
       final."combined_points"
FROM (
       -- the combined points query (#9) without the LIMIT
       SELECT cp."year",
              cp."constructor_id",
              c."name" AS constructor_name,
              (cp."final_constructor_points" + bd."best_driver_points") AS combined_points
       FROM (
              SELECT r."year",
                     cs."constructor_id",
                     cs."points" AS final_constructor_points
              FROM   "constructor_standings" cs
              JOIN   "races"                r ON r."race_id" = cs."race_id"
              WHERE  (r."year", r."round") IN (
                       SELECT r2."year", MAX(r2."round") FROM "races" r2 GROUP BY r2."year"
                     )
            ) AS cp
       JOIN (
              SELECT cd."year",
                     cd."constructor_id",
                     MAX(cd."best_driver_points") AS best_driver_points
              FROM (
                     SELECT fd."year",
                            res."constructor_id",
                            fd."driver_id",
                            fd."final_driver_points" AS best_driver_points
                     FROM (
                            SELECT r."year",
                                   ds."driver_id",
                                   ds."points" AS final_driver_points,
                                   ds."race_id"
                            FROM   "driver_standings" ds
                            JOIN   "races"            r ON r."race_id" = ds."race_id"
                            WHERE  (r."year", r."round") IN (
                                     SELECT r3."year", MAX(r3."round") FROM "races" r3 GROUP BY r3."year"
                                   )
                          ) AS fd
                     JOIN "results" AS res ON res."race_id" = fd."race_id"
                                          AND res."driver_id" = fd."driver_id"
                   ) AS cd
              GROUP BY cd."year", cd."constructor_id"
            ) AS bd
            ON  cp."year"           = bd."year"
            AND cp."constructor_id" = bd."constructor_id"
       JOIN "constructors" AS c ON c."constructor_id" = cp."constructor_id"
     ) AS final
ORDER BY final."combined_points" DESC
LIMIT 3;
```
