```sql
-- 1. See which season-years exist in the data
SELECT DISTINCT "year"
FROM "races"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 2. For every season, find the last (highest) round number
SELECT "year", MAX("round") AS "final_round"
FROM "races"
GROUP BY "year"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 3. Turn those rounds into the concrete race_id of the season-final race
SELECT r."year",
       r."round",
       r."race_id",
       r."name"        AS "grand_prix"
FROM   "races" AS r
JOIN   (SELECT "year", MAX("round") AS "final_round"
        FROM   "races"
        GROUP  BY "year") AS f
  ON   r."year"  = f."year"
 AND  r."round" = f."final_round"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 4. Constructor-standing points at the 2009 season finale
SELECT cs."points",
       c."name" AS "constructor",
       cs."race_id"
FROM   "constructor_standings" AS cs
JOIN   "constructors"          AS c  USING ("constructor_id")
WHERE  cs."race_id" = 18        -- 2009 final race (from query-3)
ORDER BY cs."points" DESC
LIMIT 20;
```

```sql
-- 5. Driver-standing points at that same race,
--    together with the constructor each driver raced for
SELECT ds."points",
       d."forename"||' '||d."surname" AS "driver",
       c."name"                       AS "constructor",
       ds."race_id"
FROM   "driver_standings" AS ds
JOIN   "results"          AS r  ON  r."race_id"   = ds."race_id"
                               AND r."driver_id" = ds."driver_id"
JOIN   "constructors"     AS c  USING ("constructor_id")
JOIN   "drivers"          AS d  USING ("driver_id")
WHERE  ds."race_id" = 18            -- 2009 finale
ORDER  BY ds."points" DESC
LIMIT 20;
```

```sql
-- 6. For 2009: combine each constructor’s team-points with
--    the points of its best driver
WITH finale AS (                -- season-final race for 2009
       SELECT "race_id" FROM "races"
       WHERE  "year" = 2009
       ORDER  BY "round" DESC LIMIT 1)
SELECT  c."name"                             AS "constructor",
        2009                                 AS "year",
        cs."points"                          AS "team_pts",
        MAX(ds."points")                     AS "best_driver_pts",
        cs."points" + MAX(ds."points")       AS "combined_pts"
FROM    "constructor_standings" AS cs
JOIN    "constructors"          AS c  USING ("constructor_id")
JOIN    finale                  AS f  ON cs."race_id" = f."race_id"
JOIN    "results"               AS r  ON r."race_id"      = cs."race_id"
                                      AND r."constructor_id" = cs."constructor_id"
JOIN    "driver_standings"      AS ds ON ds."race_id"   = r."race_id"
                                      AND ds."driver_id" = r."driver_id"
GROUP BY cs."constructor_id"
ORDER  BY "combined_pts" DESC
LIMIT 20;
```

```sql
-- 7. Repeat the same calculation for the 2010 season (as a spot-check)
WITH finale AS (
       SELECT "race_id" FROM "races"
       WHERE  "year" = 2010
       ORDER  BY "round" DESC LIMIT 1)
SELECT  c."name" AS "constructor",
        2010     AS "year",
        cs."points"                  AS "team_pts",
        MAX(ds."points")             AS "best_driver_pts",
        cs."points" + MAX(ds."points") AS "combined_pts"
FROM    "constructor_standings" AS cs
JOIN    "constructors"          AS c  USING ("constructor_id")
JOIN    finale                  AS f  ON cs."race_id" = f."race_id"
JOIN    "results"               AS r  ON r."race_id"      = cs."race_id"
                                      AND r."constructor_id" = cs."constructor_id"
JOIN    "driver_standings"      AS ds ON ds."race_id"   = r."race_id"
                                      AND ds."driver_id" = r."driver_id"
GROUP BY cs."constructor_id"
ORDER  BY "combined_pts" DESC
LIMIT 20;
```

```sql
-- 8. General CTE: calculate every (year, constructor) combined total
WITH season_finale AS (
     SELECT r1."year",
            r1."race_id"
     FROM   "races" AS r1
     JOIN  (SELECT "year", MAX("round") AS final_round
            FROM   "races"
            GROUP  BY "year") AS f
          ON r1."year"  = f."year"
         AND r1."round" = f."final_round")
SELECT  sf."year",
        c."constructor_id",
        c."name"                      AS "constructor",
        cs."points"                   AS "team_pts",
        MAX(ds."points")              AS "best_driver_pts",
        cs."points" + MAX(ds."points") AS "combined_pts"
FROM    season_finale           AS sf
JOIN    "constructor_standings" AS cs ON cs."race_id"      = sf."race_id"
JOIN    "constructors"          AS c  USING ("constructor_id")
JOIN    "results"               AS r  ON r."race_id"      = cs."race_id"
                                      AND r."constructor_id" = cs."constructor_id"
JOIN    "driver_standings"      AS ds ON ds."race_id"   = r."race_id"
                                      AND ds."driver_id" = r."driver_id"
GROUP BY sf."year", cs."constructor_id"
LIMIT 20;
```

```sql
-- 9. Rank every constructor-season by combined points (highest first)
WITH season_combined AS (
     /* same body as query-8 */
     SELECT  sf."year",
             c."name"        AS "constructor",
             cs."points"     AS "team_pts",
             MAX(ds."points") AS "best_driver_pts",
             cs."points" + MAX(ds."points") AS "combined_pts"
     FROM   (SELECT r1."year", r1."race_id"
             FROM   "races" AS r1
             JOIN  (SELECT "year", MAX("round") AS final_round
                    FROM   "races"
                    GROUP  BY "year") AS f
               ON  r1."year"  = f."year"
              AND  r1."round" = f."final_round")  AS sf
     JOIN    "constructor_standings" AS cs ON cs."race_id"      = sf."race_id"
     JOIN    "constructors"          AS c  USING ("constructor_id")
     JOIN    "results"               AS r  ON r."race_id"      = cs."race_id"
                                           AND r."constructor_id" = cs."constructor_id"
     JOIN    "driver_standings"      AS ds ON ds."race_id"   = r."race_id"
                                           AND ds."driver_id" = r."driver_id"
     GROUP BY sf."year", c."name", cs."points")
SELECT *
FROM   season_combined
ORDER  BY "combined_pts" DESC
LIMIT 10;
```

```sql
-- 10. Finally, extract the TOP-3 constructor-year pairs with the
--     highest combined points
WITH season_combined AS (
     SELECT  sf."year",
             c."name"                                         AS "constructor",
             cs."points"                                      AS "team_pts",
             MAX(ds."points")                                 AS "best_driver_pts",
             cs."points" + MAX(ds."points")                   AS "combined_pts"
     FROM   (SELECT r1."year", r1."race_id"
             FROM   "races" AS r1
             JOIN  (SELECT "year", MAX("round") AS final_round
                    FROM   "races"
                    GROUP  BY "year") AS f
               ON  r1."year"  = f."year"
              AND  r1."round" = f."final_round")  AS sf
     JOIN    "constructor_standings" AS cs ON cs."race_id"      = sf."race_id"
     JOIN    "constructors"          AS c  USING ("constructor_id")
     JOIN    "results"               AS r  ON r."race_id"      = cs."race_id"
                                           AND r."constructor_id" = cs."constructor_id"
     JOIN    "driver_standings"      AS ds ON ds."race_id"   = r."race_id"
                                           AND ds."driver_id" = r."driver_id"
     GROUP BY sf."year", c."name", cs."points")
SELECT  "constructor",
        "year",
        "combined_pts"
FROM    season_combined
ORDER  BY "combined_pts" DESC
LIMIT 3;
```
