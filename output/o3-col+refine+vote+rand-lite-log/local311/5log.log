-- 3. Turn those rounds into the concrete race_id of the season-final race
SELECT r."year",
       r."round",
       r."race_id",
       r."name"        AS "grand_prix"
FROM   "races" AS r
JOIN   (SELECT "year", MAX("round") AS "final_round"
        FROM   "races"
        GROUP  BY "year") AS f
  ON   r."year"  = f."year"
 AND  r."round" = f."final_round"
ORDER BY r."year"
LIMIT 20;
