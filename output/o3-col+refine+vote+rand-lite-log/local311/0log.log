```sql
--Description: 1) Find, for every season, the race_id of the last (highest-round) Grand Prix.  
SELECT r.year,
       MAX(r.round)                       AS last_round,
       MAX(r.race_id)                     AS last_race_id   -- (1 race per year has the max round)
FROM   races AS r
GROUP  BY r.year
ORDER  BY r.year
LIMIT 20;
```

```sql
--Description: 2) Show the constructor championship points that each team had **in those last races**.  
--   (= final season totals for the team)  
SELECT cs.race_id,
       r.year,
       cs.constructor_id,
       cs.points                          AS team_points
FROM   constructor_standings AS cs
JOIN   races                 AS r  ON r.race_id = cs.race_id
JOIN ( SELECT MAX(race_id) AS last_race_id, year
       FROM   races
       GROUP  BY year) AS f            ON f.last_race_id = cs.race_id
LIMIT 20;
```

```sql
--Description: 3) Link every driver’s final-race standing to the constructor that
--   driver represented in that race (via the “results” table).  
SELECT ds.race_id,
       r.year,
       res.constructor_id,
       ds.driver_id,
       ds.points                          AS driver_points
FROM   driver_standings  AS ds
JOIN   races             AS r    ON r.race_id = ds.race_id
JOIN ( SELECT MAX(race_id) AS last_race_id, year
       FROM   races
       GROUP  BY year) AS f              ON f.last_race_id = ds.race_id
JOIN   results           AS res  ON res.race_id  = ds.race_id
                                   AND res.driver_id = ds.driver_id
LIMIT 20;
```

```sql
--Description: 4) For every (year, constructor) pair, keep **only the best-scoring driver**
--   by taking the MAX driver_points.  
SELECT year,
       constructor_id,
       MAX(driver_points)                AS best_driver_pts
FROM ( /* previous query ‑ #3 */ )
GROUP BY year, constructor_id
LIMIT 20;
```

```sql
--Description: 5) Combine the team points (query-#2) with the best-driver
--   points (query-#4) for the same (year, constructor).  
SELECT t.year,
       t.constructor_id,
       t.team_points,
       d.best_driver_pts,
       t.team_points + d.best_driver_pts AS combined_pts
FROM ( /* query-#2 */ )  AS t
JOIN ( /* query-#4 */ )  AS d  USING (year, constructor_id)
LIMIT 20;
```

```sql
--Description: 6) Bring in the constructor names.  
SELECT c.name                          AS constructor_name,
       x.year,
       x.team_points,
       x.best_driver_pts,
       x.combined_pts
FROM ( /* query-#5 */ ) AS x
JOIN   constructors     AS c  ON c.constructor_id = x.constructor_id
LIMIT 20;
```

```sql
--Description: 7) Rank all (constructor, year) combinations by the combined
--   points calculated above and keep the overall Top-3.  
SELECT constructor_name,
       year,
       combined_pts
FROM ( /* query-#6 */ )
ORDER BY combined_pts DESC
LIMIT 3;
```

```sql
--Description: 8) (Optional check) Show the exact margin between the 3rd and 4th
--   best seasons to verify the Top-3 cut-off.  
SELECT constructor_name,
       year,
       combined_pts
FROM ( /* query-#6 */ )
ORDER BY combined_pts DESC
LIMIT 4;
```

```sql
--Description: 9) Display the Top-3 together with the individual components
--   (team points vs. best-driver points) for complete clarity.  
SELECT constructor_name,
       year,
       team_points,
       best_driver_pts,
       combined_pts
FROM ( /* query-#6 */ )
ORDER BY combined_pts DESC
LIMIT 3;
```

```sql
--Description: 10) If you need the **constructor_ref** instead of the long name
--   for downstream processing, retrieve it here.  
SELECT c.constructor_ref,
       z.year,
       z.combined_pts
FROM   constructors AS c
JOIN ( /* query-#5 */ ) AS z
  ON  c.constructor_id = z.constructor_id
ORDER BY z.combined_pts DESC
LIMIT 3;
```

The final answer (Top-3 strongest seasons measured by “team points + best driver points”) will be returned by queries 7 or 9.
