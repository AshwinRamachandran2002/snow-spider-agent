```sql
--Description: 9) Display the Top-3 seasons together with the separate components
--               (team points vs. best-driver points) for clarity.
WITH final_races AS (
        SELECT MAX(race_id) AS last_race_id, year
        FROM   races
        GROUP  BY year
),
team_points AS (
        SELECT r.year,
               cs.constructor_id,
               cs.points AS team_points
        FROM   final_races AS f
        JOIN   races       AS r  ON r.race_id = f.last_race_id
        JOIN   constructor_standings AS cs ON cs.race_id = r.race_id
),
best_driver AS (
        SELECT   s.year,
                 s.constructor_id,
                 MAX(s.driver_points) AS best_driver_pts
        FROM (
              SELECT r.year,
                     res.constructor_id,
                     ds.points AS driver_points
              FROM   final_races AS f
              JOIN   races        AS r   ON r.race_id = f.last_race_id
              JOIN   driver_standings AS ds ON ds.race_id = r.race_id
              JOIN   results      AS res ON res.race_id  = ds.race_id
                                           AND res.driver_id = ds.driver_id
            ) AS s
        GROUP BY s.year, s.constructor_id
),
combined AS (
        SELECT  t.year,
                t.constructor_id,
                t.team_points,
                d.best_driver_pts,
                t.team_points + d.best_driver_pts AS combined_pts
        FROM    team_points AS t
        JOIN    best_driver AS d USING (year, constructor_id)
),
ranked AS (
        SELECT *,
               RANK() OVER (ORDER BY combined_pts DESC) AS rk
        FROM   combined
)
SELECT c.name AS constructor_name,
       r.year,
       r.team_points,
       r.best_driver_pts,
       r.combined_pts
FROM   ranked        AS r
JOIN   constructors  AS c ON c.constructor_id = r.constructor_id
WHERE  r.rk <= 3
ORDER  BY r.combined_pts DESC;
```

```sql
--Description: 10) Retrieve constructor_ref (short identifier) for the Top-3 combined-points
--                seasons, useful for downstream processing.
WITH final_races AS (
        SELECT MAX(race_id) AS last_race_id, year
        FROM   races
        GROUP  BY year
),
team_points AS (
        SELECT r.year,
               cs.constructor_id,
               cs.points AS team_points
        FROM   final_races AS f
        JOIN   races       AS r  ON r.race_id = f.last_race_id
        JOIN   constructor_standings AS cs ON cs.race_id = r.race_id
),
best_driver AS (
        SELECT   s.year,
                 s.constructor_id,
                 MAX(s.driver_points) AS best_driver_pts
        FROM (
              SELECT r.year,
                     res.constructor_id,
                     ds.points AS driver_points
              FROM   final_races AS f
              JOIN   races        AS r   ON r.race_id = f.last_race_id
              JOIN   driver_standings AS ds ON ds.race_id = r.race_id
              JOIN   results      AS res ON res.race_id  = ds.race_id
                                           AND res.driver_id = ds.driver_id
            ) AS s
        GROUP BY s.year, s.constructor_id
),
combined AS (
        SELECT  t.year,
                t.constructor_id,
                t.team_points + d.best_driver_pts AS combined_pts
        FROM    team_points AS t
        JOIN    best_driver AS d USING (year, constructor_id)
),
top3 AS (
        SELECT *
        FROM   combined
        ORDER  BY combined_pts DESC
        LIMIT 3
)
SELECT c.constructor_ref,
       t.year,
       t.combined_pts
FROM   top3         AS t
JOIN   constructors AS c ON c.constructor_id = t.constructor_id
ORDER  BY t.combined_pts DESC;
```
