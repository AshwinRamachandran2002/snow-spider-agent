```sql
--Description: Goal → For every (year, constructor) pair, keep the SINGLE highest-scoring
--               driver at the end of the season (best_driver_pts).
--               Logic inside one statement:
--               1. A sub-query (f) finds the last race of each season (max race_id per year).
--               2. Join that to driver_standings (ds) and results (res) to know, in that
--                  final race, how many season points each driver had and which constructor
--                  they drove for.
--               3. Aggregate with MAX(driver_points) to retain only the best driver per
--                  (year, constructor).
--               4. LIMIT 20 shows a preview.
SELECT   sub.year,
         sub.constructor_id,
         MAX(sub.driver_points) AS best_driver_pts
FROM   (
        SELECT r.year,
               res.constructor_id,
               ds.points AS driver_points
        FROM   (SELECT MAX(race_id) AS last_race_id, year
                FROM   races
                GROUP  BY year)          AS f
        JOIN   races             AS r   ON r.race_id  = f.last_race_id
        JOIN   driver_standings  AS ds  ON ds.race_id = r.race_id
        JOIN   results           AS res ON res.race_id  = ds.race_id
                                        AND res.driver_id = ds.driver_id
      ) AS sub
GROUP BY sub.year, sub.constructor_id
LIMIT 20;
```
