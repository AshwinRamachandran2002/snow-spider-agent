```sql
--Description: 5) Combine the team’s final-season constructor-standing points with its
--               best driver’s points for the same (year, constructor).
WITH final_races AS (                         -- last race of every season
        SELECT MAX(race_id) AS last_race_id, year
        FROM   races
        GROUP  BY year
),
team_points AS (                              -- constructor standings in that race
        SELECT r.year,
               cs.constructor_id,
               cs.points AS team_points
        FROM   final_races         AS f
        JOIN   races               AS r   ON r.race_id = f.last_race_id
        JOIN   constructor_standings AS cs ON cs.race_id = r.race_id
),
best_driver AS (                              -- highest-scoring driver per team
        SELECT   s.year,
                 s.constructor_id,
                 MAX(s.driver_points) AS best_driver_pts
        FROM   (
                SELECT r.year,
                       res.constructor_id,
                       ds.points AS driver_points
                FROM   final_races       AS f
                JOIN   races             AS r   ON r.race_id = f.last_race_id
                JOIN   driver_standings  AS ds  ON ds.race_id = r.race_id
                JOIN   results           AS res ON res.race_id  = ds.race_id
                                                AND res.driver_id = ds.driver_id
              ) AS s
        GROUP BY s.year, s.constructor_id
)
SELECT  t.year,
        t.constructor_id,
        t.team_points,
        d.best_driver_pts,
        t.team_points + d.best_driver_pts AS combined_pts
FROM    team_points  AS t
JOIN    best_driver  AS d USING (year, constructor_id)
LIMIT   20;
```

```sql
--Description: 6) Add the human-readable constructor name to the combined-points data.
WITH final_races AS (
        SELECT MAX(race_id) AS last_race_id, year
        FROM   races
        GROUP  BY year
),
team_points AS (
        SELECT r.year,
               cs.constructor_id,
               cs.points AS team_points
        FROM   final_races AS f
        JOIN   races       AS r  ON r.race_id = f.last_race_id
        JOIN   constructor_standings AS cs ON cs.race_id = r.race_id
),
best_driver AS (
        SELECT   s.year,
                 s.constructor_id,
                 MAX(s.driver_points) AS best_driver_pts
        FROM (
              SELECT r.year,
                     res.constructor_id,
                     ds.points AS driver_points
              FROM   final_races AS f
              JOIN   races        AS r   ON r.race_id = f.last_race_id
              JOIN   driver_standings AS ds ON ds.race_id = r.race_id
              JOIN   results      AS res ON res.race_id  = ds.race_id
                                           AND res.driver_id = ds.driver_id
            ) AS s
        GROUP BY s.year, s.constructor_id
),
combined AS (
        SELECT  t.year,
                t.constructor_id,
                t.team_points,
                d.best_driver_pts,
                t.team_points + d.best_driver_pts AS combined_pts
        FROM    team_points AS t
        JOIN    best_driver AS d USING (year, constructor_id)
)
SELECT  c.name AS constructor_name,
        x.year,
        x.team_points,
        x.best_driver_pts,
        x.combined_pts
FROM    combined     AS x
JOIN    constructors AS c ON c.constructor_id = x.constructor_id
LIMIT   20;
```

```sql
--Description: 7) Rank every (constructor, year) by the combined points and return the Top-3.
WITH final_races AS (
        SELECT MAX(race_id) AS last_race_id, year
        FROM   races
        GROUP  BY year
),
team_points AS (
        SELECT r.year,
               cs.constructor_id,
               cs.points AS team_points
        FROM   final_races AS f
        JOIN   races       AS r  ON r.race_id = f.last_race_id
        JOIN   constructor_standings AS cs ON cs.race_id = r.race_id
),
best_driver AS (
        SELECT   s.year,
                 s.constructor_id,
                 MAX(s.driver_points) AS best_driver_pts
        FROM (
              SELECT r.year,
                     res.constructor_id,
                     ds.points AS driver_points
              FROM   final_races AS f
              JOIN   races        AS r   ON r.race_id = f.last_race_id
              JOIN   driver_standings AS ds ON ds.race_id = r.race_id
              JOIN   results      AS res ON res.race_id  = ds.race_id
                                           AND res.driver_id = ds.driver_id
            ) AS s
        GROUP BY s.year, s.constructor_id
),
combined AS (
        SELECT  t.year,
                t.constructor_id,
                t.team_points + d.best_driver_pts AS combined_pts
        FROM    team_points AS t
        JOIN    best_driver AS d USING (year, constructor_id)
)
SELECT c.name AS constructor_name,
       cb.year,
       cb.combined_pts
FROM   combined     AS cb
JOIN   constructors AS c ON c.constructor_id = cb.constructor_id
ORDER  BY cb.combined_pts DESC
LIMIT 3;
```

