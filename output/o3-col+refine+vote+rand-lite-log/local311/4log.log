```sql
--Description: 1) Peek at the driver standings together with the season (year) they belong to.  
SELECT DISTINCT ds."driver_standings_id",
       ds."race_id",
       r."year",
       ds."driver_id",
       ds."points"
FROM "driver_standings" AS ds
JOIN "races" AS r
     ON r."race_id" = ds."race_id"
LIMIT 20;
```

```sql
--Description: 2) Peek at the constructor standings together with the season (year) they belong to.  
SELECT DISTINCT cs."constructor_standings_id",
       cs."race_id",
       r."year",
       cs."constructor_id",
       cs."points"
FROM "constructor_standings" AS cs
JOIN "races" AS r
     ON r."race_id" = cs."race_id"
LIMIT 20;
```

```sql
--Description: 3) For each season list the highest round number – that round is the last Grand Prix of the year.  
SELECT DISTINCT r."year",
       MAX(r."round") AS "last_round"
FROM "races" AS r
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
--Description: 4) Retrieve the race_id of the last Grand Prix of each season.  
SELECT DISTINCT r."year",
       r."race_id",
       r."round"
FROM "races" AS r
JOIN (
        SELECT "year", MAX("round") AS "last_round"
        FROM "races"
        GROUP BY "year"
     ) AS x
     ON x."year" = r."year"
    AND x."last_round" = r."round"
ORDER BY r."year"
LIMIT 20;
```

```sql
--Description: 5) Show every driver’s final-season points (driver standings in the last race of the year).  
SELECT DISTINCT r."year",
       ds."driver_id",
       ds."points"
FROM "driver_standings"  AS ds
JOIN (
        SELECT "year", MAX("round") AS "last_round"
        FROM "races"
        GROUP BY "year"
     )                       AS x
     ON 1 = 1
JOIN "races" AS r
     ON r."year"  = x."year"
    AND r."round" = x."last_round"
    AND r."race_id" = ds."race_id"
ORDER BY r."year",
         ds."points" DESC
LIMIT 20;
```

```sql
--Description: 6) Attach every driver (in the final race) to the constructor they raced for that season, using team_driver_ranks.  
SELECT DISTINCT dpts."year",
       dpts."driver_id",
       tdr."constructor_id",
       dpts."points" AS "driver_points"
FROM (
        SELECT r."year",
               ds."driver_id",
               ds."points"
        FROM "driver_standings" AS ds
        JOIN (
                SELECT "year", MAX("round") AS "last_round"
                FROM "races"
                GROUP BY "year"
             ) AS x
             ON 1 = 1
        JOIN "races" AS r
             ON r."year"  = x."year"
            AND r."round" = x."last_round"
            AND r."race_id" = ds."race_id"
     ) AS dpts
JOIN "team_driver_ranks" AS tdr
     ON tdr."year"      = dpts."year"
    AND tdr."driver_id" = dpts."driver_id"
LIMIT 20;
```

```sql
--Description: 7) For every constructor-season, keep only that constructor’s best (highest-scoring) driver and show his points.  
SELECT DISTINCT tmp."year",
       tmp."constructor_id",
       MAX(tmp."driver_points") AS "best_driver_points"
FROM (
        SELECT dpts."year",
               dpts."driver_id",
               dpts."points"  AS "driver_points",
               tdr."constructor_id"
        FROM (
                SELECT r."year",
                       ds."driver_id",
                       ds."points"
                FROM "driver_standings" AS ds
                JOIN (
                        SELECT "year", MAX("round") AS "last_round"
                        FROM "races"
                        GROUP BY "year"
                     ) AS x
                     ON 1 = 1
                JOIN "races" AS r
                     ON r."year"  = x."year"
                    AND r."round" = x."last_round"
                    AND r."race_id" = ds."race_id"
             ) AS dpts
        JOIN "team_driver_ranks" AS tdr
             ON tdr."year"      = dpts."year"
            AND tdr."driver_id" = dpts."driver_id"
     ) AS tmp
GROUP BY tmp."year", tmp."constructor_id"
LIMIT 20;
```

```sql
--Description: 8) Grab each constructor’s final-season constructor points (constructor standings in last race of year).  
SELECT DISTINCT r."year",
       cs."constructor_id",
       cs."points" AS "constructor_points"
FROM "constructor_standings" AS cs
JOIN (
        SELECT "year", MAX("round") AS "last_round"
        FROM "races"
        GROUP BY "year"
     ) AS x
     ON 1 = 1
JOIN "races" AS r
     ON r."year"  = x."year"
    AND r."round" = x."last_round"
    AND r."race_id" = cs."race_id"
LIMIT 20;
```

```sql
--Description: 9) Compute the combined score (best driver + constructor points) for every constructor-season.  
SELECT DISTINCT bp."year",
       bp."constructor_id",
       bp."best_driver_points" + cp."constructor_points" AS "combined_points"
FROM (
        /* best driver points per constructor-season (query 7) */
        SELECT tmp."year",
               tmp."constructor_id",
               MAX(tmp."driver_points") AS "best_driver_points"
        FROM (
                SELECT dpts."year",
                       dpts."driver_id",
                       dpts."points"  AS "driver_points",
                       tdr."constructor_id"
                FROM (
                        SELECT r."year",
                               ds."driver_id",
                               ds."points"
                        FROM "driver_standings" AS ds
                        JOIN (
                                SELECT "year", MAX("round") AS "last_round"
                                FROM "races"
                                GROUP BY "year"
                             ) AS x
                             ON 1 = 1
                        JOIN "races" AS r
                             ON r."year"  = x."year"
                            AND r."round" = x."last_round"
                            AND r."race_id" = ds."race_id"
                     ) AS dpts
                JOIN "team_driver_ranks" AS tdr
                     ON tdr."year"      = dpts."year"
                    AND tdr."driver_id" = dpts."driver_id"
             ) AS tmp
        GROUP BY tmp."year", tmp."constructor_id"
     ) AS bp
JOIN (
        /* constructor points per season (query 8) */
        SELECT r."year",
               cs."constructor_id",
               cs."points" AS "constructor_points"
        FROM "constructor_standings" AS cs
        JOIN (
                SELECT "year", MAX("round") AS "last_round"
                FROM "races"
                GROUP BY "year"
             ) AS x
             ON 1 = 1
        JOIN "races" AS r
             ON r."year"  = x."year"
            AND r."round" = x."last_round"
            AND r."race_id" = cs."race_id"
     ) AS cp
     ON cp."year"          = bp."year"
    AND cp."constructor_id" = bp."constructor_id"
LIMIT 20;
```

```sql
--Description: 10) Rank constructors across all seasons by their combined score and show the overall top-3 (constructor, year, score).  
SELECT DISTINCT c."name"               AS "constructor_name",
       t3."year",
       t3."combined_points"
FROM (
        SELECT bp."year",
               bp."constructor_id",
               bp."combined_points"
        FROM (
                /* query 9 without LIMIT */
                SELECT bp2."year",
                       bp2."constructor_id",
                       bp2."best_driver_points" + cp2."constructor_points" AS "combined_points"
                FROM (
                        /* best driver points (query 7 without LIMIT) */
                        SELECT tmp."year",
                               tmp."constructor_id",
                               MAX(tmp."driver_points") AS "best_driver_points"
                        FROM (
                                SELECT dpts."year",
                                       dpts."driver_id",
                                       dpts."points"  AS "driver_points",
                                       tdr."constructor_id"
                                FROM (
                                        SELECT r."year",
                                               ds."driver_id",
                                               ds."points"
                                        FROM "driver_standings" AS ds
                                        JOIN (
                                                SELECT "year", MAX("round") AS "last_round"
                                                FROM "races"
                                                GROUP BY "year"
                                             ) AS x
                                             ON 1 = 1
                                        JOIN "races" AS r
                                             ON r."year"  = x."year"
                                            AND r."round" = x."last_round"
                                            AND r."race_id" = ds."race_id"
                                     ) AS dpts
                                JOIN "team_driver_ranks" AS tdr
                                     ON tdr."year"      = dpts."year"
                                    AND tdr."driver_id" = dpts."driver_id"
                             ) AS tmp
                        GROUP BY tmp."year", tmp."constructor_id"
                     ) AS bp2
                JOIN (
                        /* constructor points (query 8 without LIMIT) */
                        SELECT r."year",
                               cs."constructor_id",
                               cs."points" AS "constructor_points"
                        FROM "constructor_standings" AS cs
                        JOIN (
                                SELECT "year", MAX("round") AS "last_round"
                                FROM "races"
                                GROUP BY "year"
                             ) AS x
                             ON 1 = 1
                        JOIN "races" AS r
                             ON r."year"  = x."year"
                            AND r."round" = x."last_round"
                            AND r."race_id" = cs."race_id"
                     ) AS cp2
                     ON cp2."year"          = bp2."year"
                    AND cp2."constructor_id" = bp2."constructor_id"
             ) AS bp
     ) AS t3
JOIN "constructors" AS c
     ON c."constructor_id" = t3."constructor_id"
ORDER BY t3."combined_points" DESC
LIMIT 20;
```
