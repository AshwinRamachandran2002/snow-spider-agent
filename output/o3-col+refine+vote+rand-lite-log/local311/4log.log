--Description: 6) Attach every driver (in the final race) to the constructor they raced for that season, using team_driver_ranks.  
SELECT DISTINCT dpts."year",
       dpts."driver_id",
       tdr."constructor_id",
       dpts."points" AS "driver_points"
FROM (
        SELECT r."year",
               ds."driver_id",
               ds."points"
        FROM "driver_standings" AS ds
        JOIN (
                SELECT "year", MAX("round") AS "last_round"
                FROM "races"
                GROUP BY "year"
             ) AS x
             ON 1 = 1
        JOIN "races" AS r
             ON r."year"  = x."year"
            AND r."round" = x."last_round"
            AND r."race_id" = ds."race_id"
     ) AS dpts
JOIN "team_driver_ranks" AS tdr
     ON tdr."year"      = dpts."year"
    AND tdr."driver_id" = dpts."driver_id"
LIMIT 20;
