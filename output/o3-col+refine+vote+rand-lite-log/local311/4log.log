--Description: 10) Rank constructors across all seasons by their combined score and show the overall top-3 (constructor, year, score).  
SELECT DISTINCT c."name"               AS "constructor_name",
       t3."year",
       t3."combined_points"
FROM (
        SELECT bp."year",
               bp."constructor_id",
               bp."combined_points"
        FROM (
                /* query 9 without LIMIT */
                SELECT bp2."year",
                       bp2."constructor_id",
                       bp2."best_driver_points" + cp2."constructor_points" AS "combined_points"
                FROM (
                        /* best driver points (query 7 without LIMIT) */
                        SELECT tmp."year",
                               tmp."constructor_id",
                               MAX(tmp."driver_points") AS "best_driver_points"
                        FROM (
                                SELECT dpts."year",
                                       dpts."driver_id",
                                       dpts."points"  AS "driver_points",
                                       tdr."constructor_id"
                                FROM (
                                        SELECT r."year",
                                               ds."driver_id",
                                               ds."points"
                                        FROM "driver_standings" AS ds
                                        JOIN (
                                                SELECT "year", MAX("round") AS "last_round"
                                                FROM "races"
                                                GROUP BY "year"
                                             ) AS x
                                             ON 1 = 1
                                        JOIN "races" AS r
                                             ON r."year"  = x."year"
                                            AND r."round" = x."last_round"
                                            AND r."race_id" = ds."race_id"
                                     ) AS dpts
                                JOIN "team_driver_ranks" AS tdr
                                     ON tdr."year"      = dpts."year"
                                    AND tdr."driver_id" = dpts."driver_id"
                             ) AS tmp
                        GROUP BY tmp."year", tmp."constructor_id"
                     ) AS bp2
                JOIN (
                        /* constructor points (query 8 without LIMIT) */
                        SELECT r."year",
                               cs."constructor_id",
                               cs."points" AS "constructor_points"
                        FROM "constructor_standings" AS cs
                        JOIN (
                                SELECT "year", MAX("round") AS "last_round"
                                FROM "races"
                                GROUP BY "year"
                             ) AS x
                             ON 1 = 1
                        JOIN "races" AS r
                             ON r."year"  = x."year"
                            AND r."round" = x."last_round"
                            AND r."race_id" = cs."race_id"
                     ) AS cp2
                     ON cp2."year"          = bp2."year"
                    AND cp2."constructor_id" = bp2."constructor_id"
             ) AS bp
     ) AS t3
JOIN "constructors" AS c
     ON c."constructor_id" = t3."constructor_id"
ORDER BY t3."combined_points" DESC
LIMIT 20;
