Query:
-- Description: 9) Extract the overall TOP-3 combined totals (constructor-year pairs)
WITH best_driver AS (
     SELECT sub."year",
            sub."constructor_id",
            MAX(sub."driver_points") AS "best_driver_points"
     FROM (
           SELECT r."year",
                  res."constructor_id",
                  ds."points" AS "driver_points"
           FROM   "driver_standings" AS ds
           JOIN   "results"          AS res ON res."race_id"   = ds."race_id"
                                           AND res."driver_id"= ds."driver_id"
           JOIN   "races"            AS r   ON r."race_id"     = ds."race_id"
           WHERE  r."round" = (
                   SELECT MAX(r2."round")
                   FROM   "races" AS r2
                   WHERE  r2."year" = r."year"
                  )
     ) AS sub
     GROUP BY sub."year", sub."constructor_id"
),
constructor_totals AS (
     SELECT r."year",
            cs."constructor_id",
            cs."points" AS "constructor_points"
     FROM   "constructor_standings" AS cs
     JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
     WHERE  r."round" = (
             SELECT MAX(r2."round")
             FROM   "races" AS r2
             WHERE  r2."year" = r."year"
            )
),
combo AS (
     SELECT bd."year",
            bd."constructor_id",
            (bd."best_driver_points" + ct."constructor_points") AS "combined_points"
     FROM   best_driver        AS bd
     JOIN   constructor_totals AS ct
            ON ct."year"           = bd."year"
           AND ct."constructor_id" = bd."constructor_id"
)
SELECT c."name"  AS "constructor_name",
       combo."year",
       combo."combined_points"
FROM   combo
JOIN   "constructors" AS c ON c."constructor_id" = combo."constructor_id"
ORDER BY combo."combined_points" DESC
LIMIT 3;
