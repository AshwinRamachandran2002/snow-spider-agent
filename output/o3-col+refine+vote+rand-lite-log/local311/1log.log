```sql
-- Description: 1) List every season (year) that exists in the database
SELECT DISTINCT "year"
FROM "seasons"
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: 2) For every season, find the final round number (last GP of the year)
SELECT r."year",
       MAX(r."round") AS "final_round"
FROM "races" AS r
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- Description: 3) Verify which race-ids correspond to those final rounds
SELECT r."race_id",
       r."year",
       r."round",
       r."name"
FROM "races" AS r
JOIN (
      SELECT "year", MAX("round") AS "final_round"
      FROM "races"
      GROUP BY "year"
) AS x
ON  r."year"  = x."year"
AND r."round" = x."final_round"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- Description: 4) Show driver-standings (season totals) for the final race of each year
SELECT ds."race_id",
       r."year",
       ds."driver_id",
       ds."points" AS "driver_points",
       ds."position"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
JOIN (
      SELECT "year", MAX("round") AS "final_round"
      FROM   "races"
      GROUP BY "year"
) AS x
ON  x."year"       = r."year"
AND x."final_round"= r."round"
LIMIT 20;
```

```sql
-- Description: 5) Attach a constructor to every driver (using the Result from the same race)
SELECT ds."race_id",
       r."year",
       res."constructor_id",
       ds."driver_id",
       ds."points" AS "driver_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r   ON r."race_id"     = ds."race_id"
JOIN   "results"          AS res ON res."race_id"   = ds."race_id"
                                 AND res."driver_id"= ds."driver_id"
WHERE  r."round" = (
        SELECT MAX(r2."round")
        FROM   "races" AS r2
        WHERE  r2."year" = r."year"
       )
LIMIT 20;
```

```sql
-- Description: 6) For each constructor-season, keep ONLY its single best-scoring driver
SELECT sub."year",
       sub."constructor_id",
       MAX(sub."driver_points") AS "best_driver_points"
FROM (
      SELECT r."year",
             res."constructor_id",
             ds."driver_points"
      FROM (
            SELECT ds."race_id",
                   ds."driver_id",
                   ds."points" AS "driver_points"
            FROM   "driver_standings" AS ds
      ) AS ds
      JOIN   "results" AS res ON res."race_id"   = ds."race_id"
                              AND res."driver_id"= ds."driver_id"
      JOIN   "races"   AS r   ON r."race_id"     = ds."race_id"
      WHERE  r."round" = (
              SELECT MAX(r2."round")
              FROM   "races" AS r2
              WHERE  r2."year" = r."year"
             )
) AS sub
GROUP BY sub."year", sub."constructor_id"
LIMIT 20;
```

```sql
-- Description: 7) Pull constructor-standings (season totals) at the same final races
SELECT r."year",
       cs."constructor_id",
       cs."points" AS "constructor_points"
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
WHERE  r."round" = (
        SELECT MAX(r2."round")
        FROM   "races" AS r2
        WHERE  r2."year" = r."year"
       )
LIMIT 20;
```

```sql
-- Description: 8) Combine best-driver points with constructor points for every constructor-season
WITH best_driver AS (
     SELECT sub."year",
            sub."constructor_id",
            MAX(sub."driver_points") AS "best_driver_points"
     FROM (
           SELECT r."year",
                  res."constructor_id",
                  ds."points" AS "driver_points"
           FROM   "driver_standings" AS ds
           JOIN   "results"          AS res ON res."race_id"   = ds."race_id"
                                           AND res."driver_id"= ds."driver_id"
           JOIN   "races"            AS r   ON r."race_id"     = ds."race_id"
           WHERE  r."round" = (
                   SELECT MAX(r2."round")
                   FROM   "races" AS r2
                   WHERE  r2."year" = r."year"
                  )
     ) AS sub
     GROUP BY sub."year", sub."constructor_id"
),
constructor_totals AS (
     SELECT r."year",
            cs."constructor_id",
            cs."points" AS "constructor_points"
     FROM   "constructor_standings" AS cs
     JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
     WHERE  r."round" = (
             SELECT MAX(r2."round")
             FROM   "races" AS r2
             WHERE  r2."year" = r."year"
            )
)
SELECT bd."year",
       bd."constructor_id",
       bd."best_driver_points",
       ct."constructor_points",
       (bd."best_driver_points" + ct."constructor_points") AS "combined_points"
FROM   best_driver        AS bd
JOIN   constructor_totals AS ct
       ON ct."year"           = bd."year"
      AND ct."constructor_id" = bd."constructor_id"
ORDER BY "combined_points" DESC
LIMIT 20;
```

```sql
-- Description: 9) Extract the overall TOP-3 combined totals (constructor-year pairs)
WITH best_driver AS (
     SELECT sub."year",
            sub."constructor_id",
            MAX(sub."driver_points") AS "best_driver_points"
     FROM (
           SELECT r."year",
                  res."constructor_id",
                  ds."points" AS "driver_points"
           FROM   "driver_standings" AS ds
           JOIN   "results"          AS res ON res."race_id"   = ds."race_id"
                                           AND res."driver_id"= ds."driver_id"
           JOIN   "races"            AS r   ON r."race_id"     = ds."race_id"
           WHERE  r."round" = (
                   SELECT MAX(r2."round")
                   FROM   "races" AS r2
                   WHERE  r2."year" = r."year"
                  )
     ) AS sub
     GROUP BY sub."year", sub."constructor_id"
),
constructor_totals AS (
     SELECT r."year",
            cs."constructor_id",
            cs."points" AS "constructor_points"
     FROM   "constructor_standings" AS cs
     JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
     WHERE  r."round" = (
             SELECT MAX(r2."round")
             FROM   "races" AS r2
             WHERE  r2."year" = r."year"
            )
),
combo AS (
     SELECT bd."year",
            bd."constructor_id",
            (bd."best_driver_points" + ct."constructor_points") AS "combined_points"
     FROM   best_driver        AS bd
     JOIN   constructor_totals AS ct
            ON ct."year"           = bd."year"
           AND ct."constructor_id" = bd."constructor_id"
)
SELECT c."name"  AS "constructor_name",
       combo."year",
       combo."combined_points"
FROM   combo
JOIN   "constructors" AS c ON c."constructor_id" = combo."constructor_id"
ORDER BY combo."combined_points" DESC
LIMIT 3;
```

```sql
-- Description: 10) Show all years in which each of those TOP-3 constructors hit that combined total
WITH top3 AS (
     /* query 9 reproduced to isolate the same TOP-3 rows */
     WITH best_driver AS (
          SELECT sub."year",
                 sub."constructor_id",
                 MAX(sub."driver_points") AS "best_driver_points"
          FROM (
                SELECT r."year",
                       res."constructor_id",
                       ds."points" AS "driver_points"
                FROM   "driver_standings" AS ds
                JOIN   "results"          AS res ON res."race_id"   = ds."race_id"
                                                AND res."driver_id"= ds."driver_id"
                JOIN   "races"            AS r   ON r."race_id"     = ds."race_id"
                WHERE  r."round" = (
                        SELECT MAX(r2."round")
                        FROM   "races" AS r2
                        WHERE  r2."year" = r."year"
                       )
          ) AS sub
          GROUP BY sub."year", sub."constructor_id"
     ),
     constructor_totals AS (
          SELECT r."year",
                 cs."constructor_id",
                 cs."points" AS "constructor_points"
          FROM   "constructor_standings" AS cs
          JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
          WHERE  r."round" = (
                  SELECT MAX(r2."round")
                  FROM   "races" AS r2
                  WHERE  r2."year" = r."year"
                 )
     ),
     combo AS (
          SELECT bd."year",
                 bd."constructor_id",
                 (bd."best_driver_points" + ct."constructor_points") AS "combined_points"
          FROM   best_driver        AS bd
          JOIN   constructor_totals AS ct
                 ON ct."year"           = bd."year"
                AND ct."constructor_id" = bd."constructor_id"
          ORDER BY (bd."best_driver_points" + ct."constructor_points") DESC
     )
     SELECT *
     FROM   combo
     ORDER BY combo."combined_points" DESC
     LIMIT 3
)
SELECT c."name"  AS "constructor_name",
       t3."year",
       t3."combined_points"
FROM   top3            AS t3
JOIN   "constructors"  AS c  ON c."constructor_id" = t3."constructor_id"
ORDER BY t3."combined_points" DESC,
         t3."year"
LIMIT 20;
```
