Query:
-- Description: 6) For each constructor-season, keep ONLY its single best-scoring driver
SELECT sub."year",
       sub."constructor_id",
       MAX(sub."driver_points") AS "best_driver_points"
FROM (
      SELECT r."year",
             res."constructor_id",
             ds."driver_points"
      FROM (
            SELECT ds."race_id",
                   ds."driver_id",
                   ds."points" AS "driver_points"
            FROM   "driver_standings" AS ds
      ) AS ds
      JOIN   "results" AS res ON res."race_id"   = ds."race_id"
                              AND res."driver_id"= ds."driver_id"
      JOIN   "races"   AS r   ON r."race_id"     = ds."race_id"
      WHERE  r."round" = (
              SELECT MAX(r2."round")
              FROM   "races" AS r2
              WHERE  r2."year" = r."year"
             )
) AS sub
GROUP BY sub."year", sub."constructor_id"
LIMIT 20;
