Query:
-- Description: 10) Show all years in which each of those TOP-3 constructors hit that combined total
WITH top3 AS (
     /* query 9 reproduced to isolate the same TOP-3 rows */
     WITH best_driver AS (
          SELECT sub."year",
                 sub."constructor_id",
                 MAX(sub."driver_points") AS "best_driver_points"
          FROM (
                SELECT r."year",
                       res."constructor_id",
                       ds."points" AS "driver_points"
                FROM   "driver_standings" AS ds
                JOIN   "results"          AS res ON res."race_id"   = ds."race_id"
                                                AND res."driver_id"= ds."driver_id"
                JOIN   "races"            AS r   ON r."race_id"     = ds."race_id"
                WHERE  r."round" = (
                        SELECT MAX(r2."round")
                        FROM   "races" AS r2
                        WHERE  r2."year" = r."year"
                       )
          ) AS sub
          GROUP BY sub."year", sub."constructor_id"
     ),
     constructor_totals AS (
          SELECT r."year",
                 cs."constructor_id",
                 cs."points" AS "constructor_points"
          FROM   "constructor_standings" AS cs
          JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
          WHERE  r."round" = (
                  SELECT MAX(r2."round")
                  FROM   "races" AS r2
                  WHERE  r2."year" = r."year"
                 )
     ),
     combo AS (
          SELECT bd."year",
                 bd."constructor_id",
                 (bd."best_driver_points" + ct."constructor_points") AS "combined_points"
          FROM   best_driver        AS bd
          JOIN   constructor_totals AS ct
                 ON ct."year"           = bd."year"
                AND ct."constructor_id" = bd."constructor_id"
          ORDER BY (bd."best_driver_points" + ct."constructor_points") DESC
     )
     SELECT *
     FROM   combo
     ORDER BY combo."combined_points" DESC
     LIMIT 3
)
SELECT c."name"  AS "constructor_name",
       t3."year",
       t3."combined_points"
FROM   top3            AS t3
JOIN   "constructors"  AS c  ON c."constructor_id" = t3."constructor_id"
ORDER BY t3."combined_points" DESC,
         t3."year"
LIMIT 20;
