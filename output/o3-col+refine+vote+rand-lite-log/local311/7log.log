Query:
--Description: Combine team points and best driver points for every constructor & year
SELECT c.year,
       c.constructor_id,
       c.constructor_points,
       d.best_driver_points,
       (c.constructor_points + d.best_driver_points) AS combined_points
FROM (
  SELECT r.year, cs.constructor_id, cs.points AS constructor_points
  FROM constructor_standings AS cs
  JOIN (
    SELECT r.year, r.race_id 
    FROM races AS r
    JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
      ON r.year = fr.year AND r.round = fr.max_round
  ) AS r 
    ON cs.race_id = r.race_id
) AS c
JOIN (
  SELECT year, constructor_id, MAX(points) AS best_driver_points
  FROM (
    SELECT r.year, res.constructor_id, ds.points
    FROM driver_standings AS ds
    JOIN (
      SELECT r.year, r.race_id 
      FROM races AS r
      JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
        ON r.year = fr.year AND r.round = fr.max_round
    ) AS r 
      ON ds.race_id = r.race_id
    JOIN results AS res
      ON res.race_id = ds.race_id 
     AND res.driver_id = ds.driver_id
  ) AS tmp
  GROUP BY year, constructor_id
) AS d
  ON c.year = d.year 
 AND c.constructor_id = d.constructor_id
ORDER BY combined_points DESC 
LIMIT 20;
