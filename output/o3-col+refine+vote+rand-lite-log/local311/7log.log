Query:
--Description: Constructor-standing points at each season’s final race
SELECT r.year, cs.constructor_id, cs.points 
FROM constructor_standings AS cs
JOIN (
  SELECT r.year, r.race_id 
  FROM races AS r
  JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
  ON r.year = fr.year AND r.round = fr.max_round
) AS r 
ON cs.race_id = r.race_id
ORDER BY r.year DESC, cs.points DESC 
LIMIT 20;
