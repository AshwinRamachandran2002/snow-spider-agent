Query:
--Description: Determine the last (highest-round) race of every year
SELECT r.year, r.race_id, r.round 
FROM races AS r
JOIN (
  SELECT year, MAX(round) AS max_round 
  FROM races 
  GROUP BY year
) AS fr 
ON r.year = fr.year 
AND r.round = fr.max_round
ORDER BY r.year DESC 
LIMIT 20;
