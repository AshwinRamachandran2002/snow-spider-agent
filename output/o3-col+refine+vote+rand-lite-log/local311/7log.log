```sql
--Description: Preview years, rounds and race IDs in the races table (first 20 rows)
SELECT year, round, race_id, name 
FROM races 
ORDER BY year, round 
LIMIT 20;
```

```sql
--Description: Determine the last (highest-round) race of every year
SELECT r.year, r.race_id, r.round 
FROM races AS r
JOIN (
  SELECT year, MAX(round) AS max_round 
  FROM races 
  GROUP BY year
) AS fr 
ON r.year = fr.year 
AND r.round = fr.max_round
ORDER BY r.year DESC 
LIMIT 20;
```

```sql
--Description: Constructor-standing points at each season’s final race
SELECT r.year, cs.constructor_id, cs.points 
FROM constructor_standings AS cs
JOIN (
  SELECT r.year, r.race_id 
  FROM races AS r
  JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
  ON r.year = fr.year AND r.round = fr.max_round
) AS r 
ON cs.race_id = r.race_id
ORDER BY r.year DESC, cs.points DESC 
LIMIT 20;
```

```sql
--Description: Driver-standing points linked to a constructor (via results) at the final race
SELECT r.year, ds.driver_id, res.constructor_id, ds.points
FROM driver_standings AS ds
JOIN (
  SELECT r.year, r.race_id 
  FROM races AS r
  JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
  ON r.year = fr.year AND r.round = fr.max_round
) AS r 
ON ds.race_id = r.race_id
JOIN results AS res
  ON res.race_id = ds.race_id 
 AND res.driver_id = ds.driver_id
ORDER BY r.year DESC, ds.points DESC 
LIMIT 20;
```

```sql
--Description: Best (maximum) driver points per constructor for every year
SELECT year, constructor_id, MAX(points) AS best_driver_points
FROM (
  SELECT r.year, res.constructor_id, ds.points
  FROM driver_standings AS ds
  JOIN (
    SELECT r.year, r.race_id 
    FROM races AS r
    JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
      ON r.year = fr.year AND r.round = fr.max_round
  ) AS r 
    ON ds.race_id = r.race_id
  JOIN results AS res
    ON res.race_id = ds.race_id 
   AND res.driver_id = ds.driver_id
) AS t
GROUP BY year, constructor_id
ORDER BY year DESC, best_driver_points DESC 
LIMIT 20;
```

```sql
--Description: Combine team points and best driver points for every constructor & year
SELECT c.year,
       c.constructor_id,
       c.constructor_points,
       d.best_driver_points,
       (c.constructor_points + d.best_driver_points) AS combined_points
FROM (
  SELECT r.year, cs.constructor_id, cs.points AS constructor_points
  FROM constructor_standings AS cs
  JOIN (
    SELECT r.year, r.race_id 
    FROM races AS r
    JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
      ON r.year = fr.year AND r.round = fr.max_round
  ) AS r 
    ON cs.race_id = r.race_id
) AS c
JOIN (
  SELECT year, constructor_id, MAX(points) AS best_driver_points
  FROM (
    SELECT r.year, res.constructor_id, ds.points
    FROM driver_standings AS ds
    JOIN (
      SELECT r.year, r.race_id 
      FROM races AS r
      JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
        ON r.year = fr.year AND r.round = fr.max_round
    ) AS r 
      ON ds.race_id = r.race_id
    JOIN results AS res
      ON res.race_id = ds.race_id 
     AND res.driver_id = ds.driver_id
  ) AS tmp
  GROUP BY year, constructor_id
) AS d
  ON c.year = d.year 
 AND c.constructor_id = d.constructor_id
ORDER BY combined_points DESC 
LIMIT 20;
```

```sql
--Description: Top-3 combined totals (team + best driver) across all seasons
SELECT year, constructor_id, combined_points
FROM (
  SELECT c.year,
         c.constructor_id,
         (c.constructor_points + d.best_driver_points) AS combined_points
  FROM (
    SELECT r.year, cs.constructor_id, cs.points AS constructor_points
    FROM constructor_standings AS cs
    JOIN (
      SELECT r.year, r.race_id 
      FROM races AS r
      JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
        ON r.year = fr.year AND r.round = fr.max_round
    ) AS r 
      ON cs.race_id = r.race_id
  ) AS c
  JOIN (
    SELECT year, constructor_id, MAX(points) AS best_driver_points
    FROM (
      SELECT r.year, res.constructor_id, ds.points
      FROM driver_standings AS ds
      JOIN (
        SELECT r.year, r.race_id 
        FROM races AS r
        JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
          ON r.year = fr.year AND r.round = fr.max_round
      ) AS r 
        ON ds.race_id = r.race_id
      JOIN results AS res
        ON res.race_id = ds.race_id 
       AND res.driver_id = ds.driver_id
    ) AS s
    GROUP BY year, constructor_id
  ) AS d
    ON c.year = d.year 
   AND c.constructor_id = d.constructor_id
) AS combined
ORDER BY combined_points DESC 
LIMIT 3;
```

```sql
--Description: Add constructor names to the top-3 combined points results
SELECT co.name               AS constructor,
       combined.year,
       combined.combined_points
FROM (
  SELECT year, constructor_id, combined_points
  FROM (
    SELECT c.year,
           c.constructor_id,
           (c.constructor_points + d.best_driver_points) AS combined_points
    FROM (
      SELECT r.year, cs.constructor_id, cs.points AS constructor_points
      FROM constructor_standings AS cs
      JOIN (
        SELECT r.year, r.race_id 
        FROM races AS r
        JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
          ON r.year = fr.year AND r.round = fr.max_round
      ) AS r 
        ON cs.race_id = r.race_id
    ) AS c
    JOIN (
      SELECT year, constructor_id, MAX(points) AS best_driver_points
      FROM (
        SELECT r.year, res.constructor_id, ds.points
        FROM driver_standings AS ds
        JOIN (
          SELECT r.year, r.race_id 
          FROM races AS r
          JOIN (SELECT year, MAX(round) AS max_round FROM races GROUP BY year) AS fr
            ON r.year = fr.year AND r.round = fr.max_round
        ) AS r 
          ON ds.race_id = r.race_id
        JOIN results AS res
          ON res.race_id = ds.race_id 
         AND res.driver_id = ds.driver_id
      ) AS t
      GROUP BY year, constructor_id
    ) AS d
      ON c.year = d.year 
     AND c.constructor_id = d.constructor_id
  ) AS combined
  ORDER BY combined_points DESC 
  LIMIT 3
) AS combined
JOIN constructors AS co 
  ON co.constructor_id = combined.constructor_id;
```
