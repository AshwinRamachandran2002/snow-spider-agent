```sql
-- 1. Distinct championship years available
SELECT DISTINCT r."year"
FROM "races" AS r
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 2. How many rounds per season – helps identify the last (final) race of each year
SELECT r."year",
       COUNT(*) AS total_rounds,
       MAX(r."round") AS max_round
FROM "races" AS r
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 3. Race-ids of the final (max_round) Grand Prix of every season
SELECT r."year",
       r."round",
       r."race_id"
FROM   "races"     AS r
JOIN  (
        SELECT "year", MAX("round") AS max_round
        FROM   "races"
        GROUP  BY "year"
      )            AS f
      ON  f."year" = r."year" AND f.max_round = r."round"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 4. Driver-standings of one final race (e.g. 2009) with the constructor
SELECT ds."driver_id",
       d."surname",
       ds."points"          AS driver_pts,
       res."constructor_id"
FROM   "driver_standings"  AS ds
JOIN   "results"           AS res ON res."race_id" = ds."race_id"
                                   AND res."driver_id" = ds."driver_id"
JOIN   "drivers"           AS d   ON d."driver_id"   = ds."driver_id"
WHERE  ds."race_id" = 1     -- (final race_id for 2009 from query-3)
ORDER BY ds."points" DESC
LIMIT 20;
```

```sql
-- 5. Best (maximum) driver points per constructor & year
SELECT r."year",
       res."constructor_id",
       MAX(ds."points")     AS max_driver_pts
FROM   "driver_standings"  AS ds
JOIN   "results"           AS res ON res."race_id" = ds."race_id"
                                   AND res."driver_id" = ds."driver_id"
JOIN   "races"             AS r   ON r."race_id"  = ds."race_id"
JOIN  (
        SELECT "year", MAX("round") AS max_round
        FROM   "races"
        GROUP  BY "year"
      )                    AS f    ON f."year" = r."year" AND f.max_round = r."round"
GROUP  BY r."year", res."constructor_id"
ORDER BY r."year", max_driver_pts DESC
LIMIT 20;
```

```sql
-- 6. Constructor-standings (team points) for the final race of each season
SELECT r."year",
       cs."constructor_id",
       cs."points"         AS team_pts
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r  ON r."race_id" = cs."race_id"
JOIN  (
        SELECT "year", MAX("round") AS max_round
        FROM   "races"
        GROUP  BY "year"
      )                       AS f   ON f."year" = r."year" AND f.max_round = r."round"
ORDER BY r."year", team_pts DESC
LIMIT 20;
```

```sql
-- 7. Combine best driver points & team points → combined points per constructor-season
SELECT m."year",
       m."constructor_id",
       m.max_driver_pts,
       cs.team_pts,
       (m.max_driver_pts + cs.team_pts) AS combined_pts
FROM  (
        -- sub-query from step-5
        SELECT r."year",
               res."constructor_id",
               MAX(ds."points") AS max_driver_pts
        FROM   "driver_standings"  AS ds
        JOIN   "results"           AS res ON res."race_id" = ds."race_id"
                                           AND res."driver_id" = ds."driver_id"
        JOIN   "races"             AS r   ON r."race_id"  = ds."race_id"
        JOIN  (
                SELECT "year", MAX("round") AS max_round
                FROM   "races"
                GROUP  BY "year"
              )                AS f        ON f."year" = r."year" AND f.max_round = r."round"
        GROUP  BY r."year", res."constructor_id"
      )                       AS m
JOIN  (
        -- sub-query from step-6
        SELECT r."year",
               cs."constructor_id",
               cs."points" AS team_pts
        FROM   "constructor_standings" AS cs
        JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
        JOIN  (
                SELECT "year", MAX("round") AS max_round
                FROM   "races"
                GROUP  BY "year"
              )                   AS f ON f."year" = r."year" AND f.max_round = r."round"
      )                       AS cs
      ON  cs."year" = m."year" AND cs."constructor_id" = m."constructor_id"
ORDER BY combined_pts DESC
LIMIT 20;
```

```sql
-- 8. Top-3 highest combined points, showing constructor name & season achieved
SELECT c."name"             AS constructor,
       t."year",
       t.combined_pts
FROM (
        /* query-7 but without LIMIT and ordered for top-3 */
        SELECT m."year",
               m."constructor_id",
               (m.max_driver_pts + cs.team_pts) AS combined_pts
        FROM  (
                SELECT r."year",
                       res."constructor_id",
                       MAX(ds."points") AS max_driver_pts
                FROM   "driver_standings"  AS ds
                JOIN   "results"           AS res ON res."race_id" = ds."race_id"
                                                   AND res."driver_id" = ds."driver_id"
                JOIN   "races"             AS r   ON r."race_id"  = ds."race_id"
                JOIN  (
                        SELECT "year", MAX("round") AS max_round
                        FROM   "races"
                        GROUP  BY "year"
                      )                AS f        ON f."year" = r."year" AND f.max_round = r."round"
                GROUP  BY r."year", res."constructor_id"
              )                     AS m
        JOIN  (
                SELECT r."year",
                       cs."constructor_id",
                       cs."points" AS team_pts
                FROM   "constructor_standings" AS cs
                JOIN   "races"                 AS r ON r."race_id" = cs."race_id"
                JOIN  (
                        SELECT "year", MAX("round") AS max_round
                        FROM   "races"
                        GROUP  BY "year"
                      )                   AS f ON f."year" = r."year" AND f.max_round = r."round"
              )                     AS cs
              ON  cs."year" = m."year" AND cs."constructor_id" = m."constructor_id"
        ORDER BY combined_pts DESC
        LIMIT 3
     ) AS t
JOIN "constructors" AS c ON c."constructor_id" = t."constructor_id";
```

These eight queries progressively:

1. List seasons available.
2. Determine the number of rounds per season to locate final races.
3. Retrieve race_ids of those finals.
4. Illustrate linking driver-standings to a constructor in the final race.
5. Derive each constructor’s best driver points per season.
6. Pull team (constructor) points for the same finals.
7. Combine both values to produce “combined points” per constructor-season.
8. Return the top-3 highest such totals, giving the constructor and the year in which each peak was reached.
