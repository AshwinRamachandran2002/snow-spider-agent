Query:
-- 6. Constructor-standings (team points) for the final race of each season
SELECT r."year",
       cs."constructor_id",
       cs."points"         AS team_pts
FROM   "constructor_standings" AS cs
JOIN   "races"                 AS r  ON r."race_id" = cs."race_id"
JOIN  (
        SELECT "year", MAX("round") AS max_round
        FROM   "races"
        GROUP  BY "year"
      )                       AS f   ON f."year" = r."year" AND f.max_round = r."round"
ORDER BY r."year", team_pts DESC
LIMIT 20;
