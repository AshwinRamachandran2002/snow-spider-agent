```sql
WITH income_delta AS (   -- compute 2015-to-2018 ZIP-level median-income change
    SELECT
        z18."geo_id",
        CAST(z18."median_household_income" AS FLOAT)
        - CAST(z15."median_household_income" AS FLOAT)  AS "median_income_diff"
    FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"  z18
    JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"  z15
      USING ("geo_id")
)

SELECT
    s."state",
    SUM(0.38 * z17."employed_wholesale_trade")                  AS "vulnerable_wholesale_trade",
    SUM(0.41 * z17."employed_manufacturing")                    AS "vulnerable_manufacturing",
    SUM(0.38 * z17."employed_wholesale_trade"
      + 0.41 * z17."employed_manufacturing")                    AS "vulnerable_total"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"  z17
JOIN income_delta                                                USING ("geo_id")   -- ensures ZIPs have income data for both years
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"  s
  ON s."fips" = TO_NUMBER(SUBSTR(z17."geo_id",1,2))             -- map ZIP → state
GROUP BY s."state"
ORDER BY "vulnerable_total" DESC NULLS LAST;
```
