```sql
--Description: 1) Look at ZIP-code–level 2015 ACS figures to confirm
--   the presence of median–income data we will need.  
SELECT 
  "geo_id",
  "median_household_income"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
LIMIT 20;
```

```sql
--Description: 2) Inspect the same field for the 2018 5-year file.  
SELECT 
  "geo_id",
  "median_household_income"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
LIMIT 20;
```

```sql
--Description: 3) Check how many ZIPs appear in BOTH years
--   (helps assure a clean income-change join).  
SELECT COUNT(*) AS "zip_in_both_years"
FROM (
  SELECT "geo_id"
  FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"
  INTERSECT
  SELECT "geo_id"
  FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"
) q;
```

```sql
--Description: 4) Preview median-income CHANGE (2018 – 2015)  
--   for a handful of ZIP codes.  
SELECT 
  a."geo_id",
  a."median_household_income"  AS "mhi_2015",
  b."median_household_income"  AS "mhi_2018",
  (b."median_household_income" - a."median_household_income") AS "mhi_change"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"  a
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"  b
  USING ("geo_id")
LIMIT 20;
```

```sql
--Description: 5) Look at 2017 ZIP-code employment counts that will be
--   used to calculate “vulnerable” workers.  
SELECT 
  "geo_id",
  "employed_wholesale_trade",
  "employed_manufacturing"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"
LIMIT 20;
```

```sql
--Description: 6) Compute vulnerable counts (38 % wholesale, 41 % mfg)
--   for a small sample of ZIPs.  
SELECT 
  "geo_id",
  ROUND(0.38 * "employed_wholesale_trade", 1) AS "vuln_wholesale",
  ROUND(0.41 * "employed_manufacturing", 1)   AS "vuln_mfg",
  ROUND(0.38 * "employed_wholesale_trade" + 0.41 * "employed_manufacturing", 1)
       AS "vuln_total"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"
LIMIT 20;
```

```sql
--Description: 7) Join ZIP-code employment to STATE FIPS (first two
--   digits of ZIP) to be able to roll results up by state.  
SELECT 
  s."state",
  z."geo_id",
  z."employed_wholesale_trade",
  z."employed_manufacturing"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"   z
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"                  s
  ON s."fips" = TO_NUMBER(SUBSTR(z."geo_id", 1, 2))
LIMIT 20;
```

```sql
--Description: 8) Aggregate 2017 vulnerable workers by state, showing
--   wholesale and manufacturing separately.  
SELECT
  s."state",
  SUM(0.38 * z."employed_wholesale_trade")      AS "vuln_wholesale_trade",
  SUM(0.41 * z."employed_manufacturing")        AS "vuln_manufacturing"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"  z
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"                 s
  ON s."fips" = TO_NUMBER(SUBSTR(z."geo_id", 1, 2))
GROUP BY s."state"
LIMIT 20;
```

```sql
--Description: 9) Combine the two vulnerable-worker sums into a single
--   total per state, ordering from largest to smallest.  
SELECT
  s."state",
  SUM(0.38 * z."employed_wholesale_trade")      AS "vuln_wholesale_trade",
  SUM(0.41 * z."employed_manufacturing")        AS "vuln_manufacturing",
  SUM(0.38 * z."employed_wholesale_trade" 
      + 0.41 * z."employed_manufacturing")      AS "vuln_total"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"  z
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"                 s
  ON s."fips" = TO_NUMBER(SUBSTR(z."geo_id", 1, 2))
GROUP BY s."state"
ORDER BY "vuln_total" DESC
LIMIT 20;
```

```sql
--Description: 10) (Final) Put everything together – restrict to ZIPs
--   whose median-income ROSE from 2015-2018, then sum vulnerable
--   workers by state and list all states in descending order.  
SELECT
  s."state",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade"))   AS "vulnerable_wholesale_trade",
  ROUND(SUM(0.41 * z17."employed_manufacturing"))     AS "vulnerable_manufacturing",
  ROUND(SUM(0.38 * z17."employed_wholesale_trade" 
            + 0.41 * z17."employed_manufacturing"))   AS "vulnerable_total"
FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR"   z17
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR"   z15
  USING ("geo_id")
JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR"   z18
  USING ("geo_id")
JOIN "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"                   s
  ON s."fips" = TO_NUMBER(SUBSTR(z17."geo_id", 1, 2))
WHERE z18."median_household_income" > z15."median_household_income"
GROUP BY s."state"
ORDER BY "vulnerable_total" DESC;
```
