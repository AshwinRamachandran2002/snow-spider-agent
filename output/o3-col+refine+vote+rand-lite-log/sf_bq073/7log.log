```sql
--Description: Calculate vulnerable counts from county-aggregated employment and rank states by total vulnerable (top 20)  
WITH state_emp AS (
  SELECT f."state",
         SUM(c."employed_wholesale_trade") AS "wholesale",
         SUM(c."employed_manufacturing")   AS "manufacturing"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."COUNTY_2017_5YR" c
  JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS" f
    ON f."fips" = TRY_CAST(SUBSTR(c."geo_id",1,2) AS NUMBER)
  GROUP BY f."state"
)
SELECT "state",
       ROUND("wholesale"    * 0.38, 0) AS "vulnerable_wholesale",
       ROUND("manufacturing"* 0.41, 0) AS "vulnerable_manufacturing",
       ROUND("wholesale" * 0.38 + "manufacturing" * 0.41, 0) AS "total_vulnerable"
FROM state_emp
ORDER BY "total_vulnerable" DESC
LIMIT 20;
```
