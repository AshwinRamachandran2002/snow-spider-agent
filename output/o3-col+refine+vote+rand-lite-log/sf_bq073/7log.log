```sql
--Description: Compute vulnerable worker counts for each state (wholesale ×38%, manufacturing ×41%) – sample  
SELECT f."state",
       ROUND(s."employed_wholesale_trade" * 0.38, 0)   AS "vulnerable_wholesale",
       ROUND(s."employed_manufacturing"   * 0.41, 0)   AS "vulnerable_manufacturing",
       ROUND(s."employed_wholesale_trade" * 0.38 
           + s."employed_manufacturing"   * 0.41, 0)   AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR" s
JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS" f
  ON f."fips" = TRY_CAST(s."geo_id" AS NUMBER)
LIMIT 20;
```

```sql
--Description: Combine vulnerable-worker counts with average ZIP-level income change for each state (top 20)  
WITH income_change AS (
  SELECT f."state",
         AVG(z18."median_household_income" - z15."median_household_income") AS "avg_income_diff"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
  JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    ON z18."geo_id" = z15."geo_id"
  JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS" f
    ON f."fips" = TRY_CAST(SUBSTR(z18."geo_id",1,2) AS NUMBER)
  GROUP BY f."state"
)
SELECT v."state",
       v."vulnerable_wholesale",
       v."vulnerable_manufacturing",
       v."total_vulnerable",
       i."avg_income_diff"
FROM (
  SELECT f."state",
         ROUND(s."employed_wholesale_trade" * 0.38, 0) AS "vulnerable_wholesale",
         ROUND(s."employed_manufacturing"   * 0.41, 0) AS "vulnerable_manufacturing",
         ROUND(s."employed_wholesale_trade" * 0.38 
             + s."employed_manufacturing"   * 0.41, 0) AS "total_vulnerable"
  FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."STATE_2017_1YR" s
  JOIN CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS" f
    ON f."fips" = TRY_CAST(s."geo_id" AS NUMBER)
) v
JOIN income_change i
  ON v."state" = i."state"
ORDER BY v."total_vulnerable" DESC
LIMIT 20;
```

