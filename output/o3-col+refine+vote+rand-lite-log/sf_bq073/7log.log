```sql
/*--------------------------------------------------------------------
  Using ZIP-level changes in median household income (2015 → 2018) and
  2017 ACS state-level employment counts, compute for every state whose
  average ZIP-code income FELL over the period

      • vulnerable wholesale-trade workers  = 38 % of 2017 jobs
      • vulnerable manufacturing workers   = 41 % of 2017 jobs
      • total vulnerable workers           = sum of the two.

  Results are returned in descending order of total vulnerable workers.
--------------------------------------------------------------------*/
WITH
/* 2015 ZIP-code median household income */
zip_2015 AS (
    SELECT
        "geo_id",
        "median_household_income"      AS "mhi_2015"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2015_5YR
),

/* 2018 ZIP-code median household income */
zip_2018 AS (
    SELECT
        "geo_id",
        "median_household_income"      AS "mhi_2018"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.ZIP_CODES_2018_5YR
),

/* Difference 2018 – 2015, keeping ZIPs present in both years            */
zip_diff AS (
    SELECT
        z18."geo_id",
        z18."mhi_2018" - z15."mhi_2015"                    AS "income_diff",
        CAST(LEFT(z18."geo_id",2) AS INT)                  AS "state_fips"
    FROM zip_2018 z18
    JOIN zip_2015 z15
      ON z18."geo_id" = z15."geo_id"
    WHERE z18."mhi_2018" IS NOT NULL
      AND z15."mhi_2015" IS NOT NULL
),

/* Average ZIP-level income change per state – keep only states where it fell */
state_income_change AS (
    SELECT
        "state_fips",
        AVG("income_diff") AS "avg_income_diff"
    FROM zip_diff
    GROUP BY "state_fips"
    HAVING AVG("income_diff") < 0              -- income declined
),

/* 2017 ACS employment counts by state */
state_emp AS (
    SELECT
        CAST("geo_id" AS INT)                  AS "state_fips",
        "employed_wholesale_trade",
        "employed_manufacturing"
    FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS.STATE_2017_1YR
),

/* Combine income-decline states with employment and compute vulnerabilities */
vulnerable AS (
    SELECT
        f."state",
        ROUND(e."employed_wholesale_trade" * 0.38, 0)      AS "vulnerable_wholesale_trade",
        ROUND(e."employed_manufacturing"   * 0.41, 0)      AS "vulnerable_manufacturing",
        ROUND(e."employed_wholesale_trade" * 0.38
            + e."employed_manufacturing"   * 0.41, 0)      AS "total_vulnerable_workers"
    FROM state_emp               e
    JOIN state_income_change     i  ON i."state_fips" = e."state_fips"
    JOIN CYCLISTIC.STATE_FIPS    f  ON f."fips"       = e."state_fips"
)

/* Final ordered output */
SELECT
    "state",
    "vulnerable_wholesale_trade",
    "vulnerable_manufacturing",
    "total_vulnerable_workers"
FROM vulnerable
ORDER BY "total_vulnerable_workers" DESC NULLS LAST;
