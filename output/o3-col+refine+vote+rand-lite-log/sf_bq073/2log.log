```sql
--Description: Compute vulnerable-worker counts (38 % wholesale, 41 % manufacturing) and list states in descending order (top 20).
SELECT 
       f."state",
       ROUND(0.38 * s."employed_wholesale_trade", 0)        AS "vulnerable_wholesale_trade",
       ROUND(0.41 * s."employed_manufacturing",      0)     AS "vulnerable_manufacturing",
       ROUND(0.38 * s."employed_wholesale_trade"
           + 0.41 * s."employed_manufacturing",      0)     AS "total_vulnerable_workers"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."STATE_2017_1YR" s
JOIN   "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS"             f
       ON TO_NUMBER(s."geo_id") = f."fips"
ORDER BY "total_vulnerable_workers" DESC
LIMIT 20;
```

```sql
--Description: Compare 2015-vs-2018 ZIP-code median household income (sample join on geo_id, first 20 rows).
SELECT 
       a."geo_id",
       a."median_household_income" AS "income_2015",
       b."median_household_income" AS "income_2018",
       (b."median_household_income" - a."median_household_income") AS "income_difference"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" a
JOIN   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" b
       ON a."geo_id" = b."geo_id"
LIMIT 20;
```

```sql
--Description: Identify ZIP-codes whose real median income declined between 2015-2018 (sample 20 rows).
SELECT *
FROM (
      SELECT 
            a."geo_id",
            b."median_household_income" - a."median_household_income" AS "income_diff"
      FROM "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" a
      JOIN "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" b
            ON a."geo_id" = b."geo_id"
) d
WHERE d."income_diff" < 0
LIMIT 20;
```

```sql
--Description: Combine vulnerable-worker totals (2017) with ZIP-code income-decline flag to begin state aggregation (sample 20).
SELECT 
       f."state",
       COUNT(DISTINCT z17."geo_id")                            AS "zip_cnt_decline",
       SUM(0.38 * z17."employed_wholesale_trade" 
         + 0.41 * z17."employed_manufacturing")                AS "vulnerable_workers_in_declining_zips"
FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2017_5YR" z17
JOIN   (
        SELECT a."geo_id"
        FROM   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2015_5YR" a
        JOIN   "CENSUS_BUREAU_ACS_2"."CENSUS_BUREAU_ACS"."ZIP_CODES_2018_5YR" b
               ON a."geo_id" = b."geo_id"
        WHERE  b."median_household_income" < a."median_household_income"
) declining USING ("geo_id")
JOIN   "CENSUS_BUREAU_ACS_2"."CYCLISTIC"."STATE_FIPS" f
       ON TO_NUMBER(LEFT(z17."geo_id", 2)) = f."fips"
GROUP BY f."state"
ORDER BY "vulnerable_workers_in_declining_zips" DESC
LIMIT 20;
```
