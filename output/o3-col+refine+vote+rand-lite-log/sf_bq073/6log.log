/* State–level count of “vulnerable” workers
   – 38 % of 2017 wholesale-trade workers
   – 41 % of 2017 manufacturing workers
   – only ZIP codes whose median household income fell
     between the 2015 and 2018 ACS 5-year files                       */

WITH income_change AS (      -- 1. 2015 → 2018 ZIP-level income change
    SELECT  z15.geo_id AS zip,
            COALESCE(z18.median_household_income, 0)
          - COALESCE(z15.median_household_income, 0)  AS income_delta
    FROM   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" z15
    JOIN   CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" z18
           ON z15.geo_id = z18.geo_id
),
zip_vulnerable AS (          -- 2. 2017 ZIP-level vulnerable-worker counts
    SELECT  z17.geo_id                                     AS zip,
            0.38 * COALESCE(z17.employed_wholesale_trade,0) AS vuln_wholesale,
            0.41 * COALESCE(z17.employed_manufacturing,0)   AS vuln_manufacturing
    FROM    CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
),
zips_to_use AS (             -- 3. ZIPs whose median income declined
    SELECT  v.*
    FROM    zip_vulnerable v
    JOIN    income_change d  ON v.zip = d.zip
    WHERE   d.income_delta < 0
),
state_totals AS (            -- 4. Roll up to states via leading two ZIP digits → FIPS
    SELECT  s.state,
            SUM(v.vuln_wholesale)     AS vulnerable_wholesale_trade_workers,
            SUM(v.vuln_manufacturing) AS vulnerable_manufacturing_workers,
            SUM(v.vuln_wholesale + v.vuln_manufacturing) AS total_vulnerable_workers
    FROM    zips_to_use v
    JOIN    CENSUS_BUREAU_ACS_2.CYCLISTIC.STATE_FIPS s
           ON TO_NUMBER(SUBSTR(v.zip, 1, 2)) = s.fips
    GROUP BY s.state
)
SELECT  state,
        vulnerable_wholesale_trade_workers,
        vulnerable_manufacturing_workers,
        total_vulnerable_workers
FROM    state_totals
ORDER BY total_vulnerable_workers DESC NULLS LAST;
