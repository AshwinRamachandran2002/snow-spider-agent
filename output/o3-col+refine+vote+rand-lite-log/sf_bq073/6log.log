```sql
--Description: Compute the median-income change (2018 – 2015) for a handful
--of ZIP codes so we can later flag those with declining incomes.
SELECT a."geo_id",
       a."median_household_income"     AS "mhi_2015",
       b."median_household_income"     AS "mhi_2018",
       b."median_household_income" - a."median_household_income" AS "mhi_change"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
  ON a."geo_id" = b."geo_id"
LIMIT 20;
```

```sql
--Description: Identify ZIP codes whose median household income fell between
--2015 and 2018 (negative change).
SELECT a."geo_id"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
  ON a."geo_id" = b."geo_id"
WHERE b."median_household_income" < a."median_household_income"
LIMIT 20;
```

```sql
--Description: For the ZIP codes with falling incomes, calculate the number
--of “vulnerable” workers in 2017 (38 % of wholesale-trade, 41 % of manufacturing).
SELECT z17."geo_id",
       ROUND(z17."employed_wholesale_trade" * 0.38, 2)   AS "vuln_wholesale",
       ROUND(z17."employed_manufacturing"    * 0.41, 2)   AS "vuln_mfg"
FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
JOIN (
      SELECT a."geo_id"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
      JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
        ON a."geo_id" = b."geo_id"
      WHERE b."median_household_income" < a."median_household_income"
     ) dec
  ON z17."geo_id" = dec."geo_id"
LIMIT 20;
```

```sql
--Description: Attach each ZIP to its state via the first two digits of ZIP,
--then aggregate vulnerable workers across all declining-income ZIPs by state.
SELECT sf."state",
       SUM(ROUND(z17."employed_wholesale_trade" * 0.38, 2)) AS "vuln_wholesale",
       SUM(ROUND(z17."employed_manufacturing"    * 0.41, 2)) AS "vuln_mfg"
FROM CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                sf
JOIN (
      SELECT z17.*,
             TO_NUMBER(SUBSTR(z17."geo_id", 1, 2)) AS "state_fips"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
      JOIN (
            SELECT a."geo_id"
            FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
            JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
              ON a."geo_id" = b."geo_id"
            WHERE b."median_household_income" < a."median_household_income"
           ) dec
        ON z17."geo_id" = dec."geo_id"
     ) z
  ON z."state_fips" = sf."fips"
GROUP BY sf."state"
LIMIT 20;
```

```sql
--Description: Add a total-vulnerable column and rank states (showing the
--top 20 by total vulnerable workers).
SELECT sf."state",
       SUM(ROUND(z17."employed_wholesale_trade" * 0.38, 2)) AS "vuln_wholesale",
       SUM(ROUND(z17."employed_manufacturing"    * 0.41, 2)) AS "vuln_mfg",
       SUM(ROUND(z17."employed_wholesale_trade" * 0.38, 2) +
           ROUND(z17."employed_manufacturing"    * 0.41, 2)) AS "total_vulnerable"
FROM CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                sf
JOIN (
      SELECT z17.*,
             TO_NUMBER(SUBSTR(z17."geo_id", 1, 2)) AS "state_fips"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
      JOIN (
            SELECT a."geo_id"
            FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
            JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
              ON a."geo_id" = b."geo_id"
            WHERE b."median_household_income" < a."median_household_income"
           ) dec
        ON z17."geo_id" = dec."geo_id"
     ) z
  ON z."state_fips" = sf."fips"
GROUP BY sf."state"
ORDER BY "total_vulnerable" DESC
LIMIT 20;
```

```sql
--Description: Final report – every state, ordered by the combined total of
--vulnerable workers (wholesale + manufacturing).
SELECT sf."state"                               AS "state_name",
       SUM(ROUND(z17."employed_wholesale_trade" * 0.38, 2)) AS "vulnerable_wholesale_trade_workers",
       SUM(ROUND(z17."employed_manufacturing"    * 0.41, 2)) AS "vulnerable_manufacturing_workers",
       SUM(ROUND(z17."employed_wholesale_trade" * 0.38, 2) +
           ROUND(z17."employed_manufacturing"    * 0.41, 2)) AS "total_vulnerable_workers"
FROM CENSUS_BUREAU_ACS_2.CYCLISTIC."STATE_FIPS"                sf
JOIN (
      SELECT z17.*,
             TO_NUMBER(SUBSTR(z17."geo_id", 1, 2)) AS "state_fips"
      FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2017_5YR" z17
      JOIN (
            SELECT a."geo_id"
            FROM CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2015_5YR" a
            JOIN CENSUS_BUREAU_ACS_2.CENSUS_BUREAU_ACS."ZIP_CODES_2018_5YR" b
              ON a."geo_id" = b."geo_id"
            WHERE b."median_household_income" < a."median_household_income"
           ) dec
        ON z17."geo_id" = dec."geo_id"
     ) z
  ON z."state_fips" = sf."fips"
GROUP BY sf."state"
ORDER BY "total_vulnerable_workers" DESC;
```
