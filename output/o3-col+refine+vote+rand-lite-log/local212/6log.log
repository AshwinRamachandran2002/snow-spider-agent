```sql
-- Description: 6) Build a sub-query with the daily counts and then compute each driver’s
--               average deliveries per day.
SELECT  dd."driver_id",
        AVG(dd."daily_deliveries") AS "avg_daily_deliveries"
FROM   (
        SELECT  d."driver_id",
                o."order_created_year",
                o."order_created_month",
                o."order_created_day",
                COUNT(*) AS "daily_deliveries"
        FROM    "deliveries" AS d
        JOIN    "orders"     AS o
                ON d."delivery_order_id" = o."order_id"
        WHERE   o."order_status" = 'DELIVERED'
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS dd
GROUP BY dd."driver_id"
LIMIT 20;
```

```sql
