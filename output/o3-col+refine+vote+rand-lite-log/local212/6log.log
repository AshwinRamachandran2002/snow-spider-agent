```sql
--Description: Driver 1234 was absent, so first identify a driver that actually has at least
--one FINISHED order, then show that driver’s daily-delivery history.  
--The CTE “top_driver” selects the driver with the most FINISHED deliveries; the main
--query aggregates that driver’s deliveries by calendar day and lists them chronologically.
WITH top_driver AS (
    SELECT d."driver_id"
    FROM   "deliveries" AS d
    JOIN   "orders"     AS o
           ON d."delivery_order_id" = o."delivery_order_id"
    WHERE  o."order_status" = 'FINISHED'
           AND d."driver_id" IS NOT NULL
           AND d."driver_id" <> ''
    GROUP  BY d."driver_id"
    ORDER  BY COUNT(*) DESC
    LIMIT 1
)
SELECT  d."driver_id",
        o."order_created_year",
        o."order_created_month",
        o."order_created_day",
        COUNT(*) AS "daily_deliveries"
FROM    "deliveries" AS d
JOIN    "orders"     AS o
        ON d."delivery_order_id" = o."delivery_order_id"
JOIN    top_driver      td
        ON d."driver_id" = td."driver_id"
WHERE   o."order_status" = 'FINISHED'
GROUP BY o."order_created_year",
         o."order_created_month",
         o."order_created_day"
ORDER BY o."order_created_year",
         o."order_created_month",
         o."order_created_day";
