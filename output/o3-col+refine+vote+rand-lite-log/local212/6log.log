--Description: 7) FINAL ANSWER – top five drivers with the highest average number of deliveries
--per day, using the corrected join, ‘FINISHED’ status, and excluding blank / NULL ids.
SELECT  dd."driver_id",
        AVG(dd."daily_deliveries") AS "avg_daily_deliveries"
FROM (
        SELECT  d."driver_id",
                o."order_created_year",
                o."order_created_month",
                o."order_created_day",
                COUNT(*) AS "daily_deliveries"
        FROM    "deliveries" AS d
        JOIN    "orders"     AS o
               ON d."delivery_order_id" = o."delivery_order_id"
        WHERE   o."order_status" = 'FINISHED'
          AND   d."driver_id" IS NOT NULL
          AND   d."driver_id" <> ''
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
     ) AS dd
GROUP BY dd."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
```
