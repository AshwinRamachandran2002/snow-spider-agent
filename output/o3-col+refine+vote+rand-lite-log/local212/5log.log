```sql
-- Description: 1) Look at a few rows of the “deliveries” table to understand its basic columns.
SELECT * 
FROM "deliveries" 
LIMIT 20;
```

```sql
-- Description: 2) Inspect a few rows of “orders”, focusing on the date-related columns that will let us build a calendar day.
SELECT "order_id",
       "delivery_order_id",
       "order_created_day",
       "order_created_month",
       "order_created_year",
       "order_status"
FROM "orders"
LIMIT 20;
```

```sql
-- Description: 3) Join “deliveries” with “orders” to see how a delivery row lines up with its order’s
-- calendar fields.  This confirms the join key and that we can work with day / month / year.
SELECT d."delivery_id",
       d."driver_id",
       o."delivery_order_id",
       o."order_created_day",
       o."order_created_month",
       o."order_created_year",
       d."delivery_status"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."delivery_order_id" = d."delivery_order_id"
LIMIT 20;
```

```sql
-- Description: 4) Count how many deliveries each driver performs on each individual calendar day
-- (only counting rows whose delivery_status = 'DELIVERED').
SELECT   d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day",
         COUNT(*) AS "daily_deliveries"
FROM     "deliveries" AS d
JOIN     "orders"     AS o
         ON o."delivery_order_id" = d."delivery_order_id"
WHERE    d."delivery_status" = 'DELIVERED'
GROUP BY d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
-- Description: 5) From the previous daily counts, compute each driver’s average number of
-- deliveries per day.  Order descending to see the top performers.
SELECT   sub."driver_id",
         AVG(sub."daily_deliveries") AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."delivery_order_id" = d."delivery_order_id"
        WHERE    d."delivery_status" = 'DELIVERED'
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS sub
GROUP BY sub."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 20;
```

```sql
-- Description: 6) FINAL ANSWER – return the 5 delivery drivers with the highest average
-- number of daily deliveries.
SELECT   sub."driver_id",
         ROUND(AVG(sub."daily_deliveries"), 2) AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."delivery_order_id" = d."delivery_order_id"
        WHERE    d."delivery_status" = 'DELIVERED'
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS sub
GROUP BY sub."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
```
