Query:
-- Description: 5) From the previous daily counts, compute each driver’s average number of
-- deliveries per day.  Order descending to see the top performers.
SELECT   sub."driver_id",
         AVG(sub."daily_deliveries") AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."delivery_order_id" = d."delivery_order_id"
        WHERE    d."delivery_status" = 'DELIVERED'
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS sub
GROUP BY sub."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 20;
