```sql
--Description: 1) Inspect some driver IDs that appear in the deliveries table
SELECT DISTINCT "driver_id"
FROM "deliveries"
LIMIT 20;
```

```sql
--Description: 2) Look at a few delivered orders together with their calendar fields (day / month / year)
SELECT DISTINCT "order_id",
       "order_created_day",
       "order_created_month",
       "order_created_year",
       "order_moment_delivered"
FROM "orders"
WHERE "order_status" = 'DELIVERED'
LIMIT 20;
```

```sql
--Description: 3) Join deliveries → orders to see which driver delivered on which calendar day
SELECT DISTINCT d."driver_id",
       o."order_created_day",
       o."order_created_month",
       o."order_created_year"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."order_status" = 'DELIVERED'
LIMIT 20;
```

```sql
--Description: 4) Total number of delivered orders per driver
SELECT DISTINCT d."driver_id",
       COUNT(*) AS "total_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."order_status" = 'DELIVERED'
GROUP  BY d."driver_id"
ORDER  BY "total_deliveries" DESC
LIMIT 20;
```

```sql
--Description: 5) Number of deliveries each driver performed per calendar day
SELECT DISTINCT d."driver_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day",
       COUNT(*) AS "daily_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."order_status" = 'DELIVERED'
GROUP  BY d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
--Description: 6) For each driver, count the number of different calendar days on which he/she delivered
SELECT DISTINCT d."driver_id",
       COUNT(DISTINCT printf('%04d-%02d-%02d',
                             o."order_created_year",
                             o."order_created_month",
                             o."order_created_day"))    AS "active_days"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."order_status" = 'DELIVERED'
GROUP  BY d."driver_id"
LIMIT 20;
```

```sql
--Description: 7) Combine total deliveries and active days to compute average daily deliveries per driver
SELECT DISTINCT totals."driver_id",
       totals."total_deliveries",
       days."active_days",
       ROUND(1.0 * totals."total_deliveries" / days."active_days", 2) AS "avg_daily_deliveries"
FROM  (
        SELECT d."driver_id", COUNT(*) AS "total_deliveries"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  o."order_status" = 'DELIVERED'
        GROUP  BY d."driver_id"
      ) AS totals
JOIN  (
        SELECT d."driver_id",
               COUNT(DISTINCT printf('%04d-%02d-%02d',
                                     o."order_created_year",
                                     o."order_created_month",
                                     o."order_created_day")) AS "active_days"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  o."order_status" = 'DELIVERED'
        GROUP  BY d."driver_id"
      ) AS days
ON totals."driver_id" = days."driver_id"
LIMIT 20;
```

```sql
--Description: 8) Retrieve the five drivers with the highest average number of daily deliveries
SELECT DISTINCT totals."driver_id",
       ROUND(1.0 * totals."total_deliveries" / days."active_days", 2) AS "avg_daily_deliveries"
FROM  (
        SELECT d."driver_id", COUNT(*) AS "total_deliveries"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  o."order_status" = 'DELIVERED'
        GROUP  BY d."driver_id"
      ) AS totals
JOIN  (
        SELECT d."driver_id",
               COUNT(DISTINCT printf('%04d-%02d-%02d',
                                     o."order_created_year",
                                     o."order_created_month",
                                     o."order_created_day")) AS "active_days"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  o."order_status" = 'DELIVERED'
        GROUP  BY d."driver_id"
      ) AS days
ON totals."driver_id" = days."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
```

(The last query returns the final answer: the 5 drivers who exhibit the highest average number of daily deliveries.)
