Query:
--Description: Final result – the 5 drivers with the highest average
--number of daily deliveries (includes their modal/type information).
SELECT r.driver_id,
       r.avg_daily_deliveries,
       d.driver_modal,
       d.driver_type
FROM  (
        SELECT sub.driver_id,
               AVG(sub.daily_deliveries) AS avg_daily_deliveries
        FROM (
                SELECT dl.driver_id,
                       o.order_created_year,
                       o.order_created_month,
                       o.order_created_day,
                       COUNT(*) AS daily_deliveries
                FROM   deliveries AS dl
                JOIN   orders      AS o
                       ON o.order_id = dl.delivery_order_id
                GROUP  BY dl.driver_id,
                          o.order_created_year,
                          o.order_created_month,
                          o.order_created_day
             ) AS sub
        GROUP BY sub.driver_id
        ORDER BY avg_daily_deliveries DESC
        LIMIT 5
      ) AS r
LEFT  JOIN drivers AS d
       ON d.driver_id = r.driver_id;
