```sql
--Description: Inspect a handful of rows from the “deliveries” table to be sure  
--we really have delivery_id, driver_id and the link-key delivery_order_id.
SELECT delivery_id,
       delivery_order_id,
       driver_id,
       delivery_status
FROM   deliveries
LIMIT 20;
```

```sql
--Description: Check which distinct drivers have at least one delivery registered.
SELECT DISTINCT driver_id
FROM   deliveries
LIMIT 20;
```

```sql
--Description: Look up some basic information about those drivers.
SELECT DISTINCT d.driver_id,
                d.driver_modal,
                d.driver_type
FROM   drivers AS d
JOIN   deliveries AS dl
       ON d.driver_id = dl.driver_id
LIMIT 20;
```

```sql
--Description: Confirm that the key deliveries.delivery_order_id really
--matches orders.order_id and that we have creation-date information there.
SELECT dl.driver_id,
       dl.delivery_order_id,
       o.order_id,
       o.order_created_day,
       o.order_created_month,
       o.order_created_year,
       o.order_status
FROM   deliveries AS dl
JOIN   orders      AS o
       ON o.order_id = dl.delivery_order_id
LIMIT 20;
```

```sql
--Description: Count how many deliveries each driver completed on each calendar day.
SELECT dl.driver_id,
       o.order_created_year      AS yr,
       o.order_created_month     AS mon,
       o.order_created_day       AS dy,
       COUNT(*)                  AS daily_deliveries
FROM   deliveries AS dl
JOIN   orders      AS o
       ON o.order_id = dl.delivery_order_id
GROUP  BY dl.driver_id,
          o.order_created_year,
          o.order_created_month,
          o.order_created_day
LIMIT 20;
```

```sql
--Description: Compute every driver’s average number of daily deliveries
--(i.e., mean of the daily counts obtained above).
SELECT sub.driver_id,
       AVG(sub.daily_deliveries) AS avg_daily_deliveries
FROM (
        SELECT dl.driver_id,
               o.order_created_year,
               o.order_created_month,
               o.order_created_day,
               COUNT(*) AS daily_deliveries
        FROM   deliveries AS dl
        JOIN   orders      AS o
               ON o.order_id = dl.delivery_order_id
        GROUP  BY dl.driver_id,
                  o.order_created_year,
                  o.order_created_month,
                  o.order_created_day
     ) AS sub
GROUP BY sub.driver_id
LIMIT 20;
```

```sql
--Description: Final result – the 5 drivers with the highest average
--number of daily deliveries (includes their modal/type information).
SELECT r.driver_id,
       r.avg_daily_deliveries,
       d.driver_modal,
       d.driver_type
FROM  (
        SELECT sub.driver_id,
               AVG(sub.daily_deliveries) AS avg_daily_deliveries
        FROM (
                SELECT dl.driver_id,
                       o.order_created_year,
                       o.order_created_month,
                       o.order_created_day,
                       COUNT(*) AS daily_deliveries
                FROM   deliveries AS dl
                JOIN   orders      AS o
                       ON o.order_id = dl.delivery_order_id
                GROUP  BY dl.driver_id,
                          o.order_created_year,
                          o.order_created_month,
                          o.order_created_day
             ) AS sub
        GROUP BY sub.driver_id
        ORDER BY avg_daily_deliveries DESC
        LIMIT 5
      ) AS r
LEFT  JOIN drivers AS d
       ON d.driver_id = r.driver_id;
```

