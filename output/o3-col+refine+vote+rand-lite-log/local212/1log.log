Below is a step-by-step exploration (≤ 10 queries) that ends with the list of the five drivers that have the highest average number of daily deliveries.

```sql
-- 1️⃣  Description: Inspect the variety of drivers that actually appear in the
--     deliveries table (only first 20 distinct IDs shown).
SELECT DISTINCT d."driver_id"
FROM "deliveries" AS d
LIMIT 20;
```

```sql
-- 2️⃣  Description: Take one driver as an example and see which orders belong
--     to that driver (joining deliveries → orders through delivery_order_id).
SELECT DISTINCT d."driver_id",
       o."order_id",
       o."order_created_day",
       o."order_created_month",
       o."order_created_year"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
LIMIT 20;
```

```sql
-- 3️⃣  Description: Look at the distinct calendar days that exist in orders,
--     to be sure we can aggregate on day/month/year.
SELECT DISTINCT o."order_created_day",
       o."order_created_month",
       o."order_created_year"
FROM   "orders" AS o
LIMIT 20;
```

```sql
-- 4️⃣  Description: Count how many deliveries a **single** driver makes
--     each calendar day (example driver = 1st one found, change as needed).
SELECT   d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day",
         COUNT(*) AS "daily_deliveries"
FROM     "deliveries" AS d
JOIN     "orders"     AS o
         ON o."order_id" = d."delivery_order_id"
WHERE    d."driver_id" = (SELECT DISTINCT "driver_id" FROM "deliveries" LIMIT 1)
GROUP BY d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
-- 5️⃣  Description: Do the same daily-count aggregation for **all** drivers.
SELECT   d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day",
         COUNT(*) AS "daily_deliveries"
FROM     "deliveries" AS d
JOIN     "orders"     AS o
         ON o."order_id" = d."delivery_order_id"
GROUP BY d."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
-- 6️⃣  Description: Use the previous sub-query and compute each driver’s
--     average number of daily deliveries.
SELECT   t."driver_id",
         AVG(t."daily_deliveries") AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."order_id" = d."delivery_order_id"
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS t
GROUP BY t."driver_id"
LIMIT 20;
```

```sql
-- 7️⃣  Description: Order the drivers by that average, highest first, and
--     restrict to the top five.
SELECT   t."driver_id",
         ROUND(AVG(t."daily_deliveries"), 2) AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."order_id" = d."delivery_order_id"
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS t
GROUP BY t."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
```

```sql
-- 8️⃣  Description: For completeness, pull the modal/type of those top drivers.
SELECT   dv."driver_id",
         dv."driver_modal",
         dv."driver_type"
FROM     "drivers" AS dv
WHERE    dv."driver_id" IN (
            SELECT   t."driver_id"
            FROM   (
                    SELECT   d."driver_id",
                             o."order_created_year",
                             o."order_created_month",
                             o."order_created_day",
                             COUNT(*) AS "daily_deliveries"
                    FROM     "deliveries" AS d
                    JOIN     "orders"     AS o
                             ON o."order_id" = d."delivery_order_id"
                    GROUP BY d."driver_id",
                             o."order_created_year",
                             o."order_created_month",
                             o."order_created_day"
                   ) AS t
            GROUP BY t."driver_id"
            ORDER BY AVG(t."daily_deliveries") DESC
            LIMIT 5
         )
LIMIT 20;
```

```sql
-- 9️⃣  Description (final answer): Combine the average and driver attributes
--     into a single result showing the five best performers.
SELECT   r."driver_id",
         dv."driver_modal",
         dv."driver_type",
         r."avg_daily_deliveries"
FROM   (
        SELECT   t."driver_id",
                 ROUND(AVG(t."daily_deliveries"), 2) AS "avg_daily_deliveries"
        FROM   (
                SELECT   d."driver_id",
                         o."order_created_year",
                         o."order_created_month",
                         o."order_created_day",
                         COUNT(*) AS "daily_deliveries"
                FROM     "deliveries" AS d
                JOIN     "orders"     AS o
                         ON o."order_id" = d."delivery_order_id"
                GROUP BY d."driver_id",
                         o."order_created_year",
                         o."order_created_month",
                         o."order_created_day"
               ) AS t
        GROUP BY t."driver_id"
        ORDER BY "avg_daily_deliveries" DESC
        LIMIT 5
       ) AS r
LEFT JOIN "drivers" AS dv
       ON dv."driver_id" = r."driver_id";
```

