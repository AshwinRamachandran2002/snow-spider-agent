Query:
-- 8️⃣  Description: For completeness, pull the modal/type of those top drivers.
SELECT   dv."driver_id",
         dv."driver_modal",
         dv."driver_type"
FROM     "drivers" AS dv
WHERE    dv."driver_id" IN (
            SELECT   t."driver_id"
            FROM   (
                    SELECT   d."driver_id",
                             o."order_created_year",
                             o."order_created_month",
                             o."order_created_day",
                             COUNT(*) AS "daily_deliveries"
                    FROM     "deliveries" AS d
                    JOIN     "orders"     AS o
                             ON o."order_id" = d."delivery_order_id"
                    GROUP BY d."driver_id",
                             o."order_created_year",
                             o."order_created_month",
                             o."order_created_day"
                   ) AS t
            GROUP BY t."driver_id"
            ORDER BY AVG(t."daily_deliveries") DESC
            LIMIT 5
         )
LIMIT 20;
