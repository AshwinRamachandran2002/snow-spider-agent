Query:
-- 7️⃣  Description: Order the drivers by that average, highest first, and
--     restrict to the top five.
SELECT   t."driver_id",
         ROUND(AVG(t."daily_deliveries"), 2) AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."order_id" = d."delivery_order_id"
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS t
GROUP BY t."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
