Query:
-- 6️⃣  Description: Use the previous sub-query and compute each driver’s
--     average number of daily deliveries.
SELECT   t."driver_id",
         AVG(t."daily_deliveries") AS "avg_daily_deliveries"
FROM   (
        SELECT   d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day",
                 COUNT(*) AS "daily_deliveries"
        FROM     "deliveries" AS d
        JOIN     "orders"     AS o
                 ON o."order_id" = d."delivery_order_id"
        GROUP BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
       ) AS t
GROUP BY t."driver_id"
LIMIT 20;
