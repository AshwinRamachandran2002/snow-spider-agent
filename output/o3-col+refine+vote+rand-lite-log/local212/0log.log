```sql
--Description: 1) Peek at some drivers to know their IDs and types.
SELECT DISTINCT d."driver_id", d."driver_modal", d."driver_type"
FROM "drivers" AS d
LIMIT 20;
```

```sql
--Description: 2) Inspect a handful of deliveries to see the link between delivery, order and driver.
SELECT DISTINCT dl."delivery_id",
       dl."delivery_order_id",
       dl."driver_id",
       dl."delivery_status"
FROM "deliveries" AS dl
LIMIT 20;
```

```sql
--Description: 3) Join deliveries with orders to bring the calendar fields that will let us slice “per-day”.
SELECT DISTINCT dl."driver_id",
       o."order_created_day",
       o."order_created_month",
       o."order_created_year",
       dl."delivery_status"
FROM "deliveries"  AS dl
JOIN "orders"      AS o ON o."order_id" = dl."delivery_order_id"
WHERE dl."delivery_status" = 'DELIVERED'
LIMIT 20;
```

```sql
--Description: 4) Count how many deliveries each driver performed on every calendar day.
SELECT dl."driver_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day",
       COUNT(*) AS "daily_deliveries"
FROM "deliveries"  AS dl
JOIN "orders"      AS o ON o."order_id" = dl."delivery_order_id"
WHERE dl."delivery_status" = 'DELIVERED'
GROUP BY dl."driver_id",
         o."order_created_year",
         o."order_created_month",
         o."order_created_day"
LIMIT 20;
```

```sql
--Description: 5) For every driver, compute the average number of deliveries per day.
SELECT driver_id,
       AVG(daily_deliveries) AS avg_daily_deliveries
FROM (
        SELECT dl."driver_id"                       AS driver_id,
               o."order_created_year"               AS yr,
               o."order_created_month"              AS mn,
               o."order_created_day"                AS dy,
               COUNT(*)                             AS daily_deliveries
        FROM "deliveries"  AS dl
        JOIN "orders"      AS o ON o."order_id" = dl."delivery_order_id"
        WHERE dl."delivery_status" = 'DELIVERED'
        GROUP BY dl."driver_id", yr, mn, dy
     )
GROUP BY driver_id
LIMIT 20;
```

```sql
--Description: 6) FINAL – five drivers with the highest average daily deliveries.
SELECT driver_id,
       ROUND(AVG(daily_deliveries), 2) AS avg_daily_deliveries
FROM (
        SELECT dl."driver_id"                       AS driver_id,
               o."order_created_year"               AS yr,
               o."order_created_month"              AS mn,
               o."order_created_day"                AS dy,
               COUNT(*)                             AS daily_deliveries
        FROM "deliveries"  AS dl
        JOIN "orders"      AS o ON o."order_id" = dl."delivery_order_id"
        WHERE dl."delivery_status" = 'DELIVERED'
        GROUP BY dl."driver_id", yr, mn, dy
     )
GROUP BY driver_id
ORDER BY avg_daily_deliveries DESC
LIMIT 5;
```
