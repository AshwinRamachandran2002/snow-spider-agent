Below are a sequence of exploratory → analytical SQL statements (max 10) that gradually lead to the final result “5 delivery drivers with the highest average number of daily deliveries”.  
All queries are written for SQLite; each one is preceded by a brief description.

```sql
-- 1) Look at the different statuses that appear in the deliveries table
SELECT DISTINCT d."delivery_status"
FROM "deliveries" AS d
LIMIT 20;
```

```sql
-- 2) Check a small sample linking a delivery to its driver
SELECT DISTINCT d."delivery_id",
       d."driver_id",
       dr."driver_modal",
       dr."driver_type"
FROM "deliveries" AS d
JOIN "drivers"  AS dr
     ON d."driver_id" = dr."driver_id"
LIMIT 20;
```

```sql
-- 3) Inspect the delivered orders’ timestamps so we know which date field to use
SELECT DISTINCT o."order_id",
       o."order_moment_delivered"
FROM "orders" AS o
WHERE o."order_moment_delivered" IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Join deliveries→orders and list a few DELIVERED rows with dates
SELECT DISTINCT d."delivery_id",
       d."driver_id",
       date(o."order_moment_delivered") AS "delivered_date"
FROM "deliveries" AS d
JOIN "orders"     AS o
     ON d."delivery_order_id" = o."delivery_order_id"
WHERE d."delivery_status" = 'DELIVERED'
  AND o."order_moment_delivered" IS NOT NULL
LIMIT 20;
```

```sql
-- 5) Count deliveries per driver per day (limited preview)
SELECT DISTINCT d."driver_id",
       date(o."order_moment_delivered")  AS "delivered_date",
       COUNT(*)                          AS "daily_deliveries"
FROM "deliveries" AS d
JOIN "orders"     AS o
     ON d."delivery_order_id" = o."delivery_order_id"
WHERE d."delivery_status" = 'DELIVERED'
  AND o."order_moment_delivered" IS NOT NULL
GROUP BY d."driver_id", date(o."order_moment_delivered")
LIMIT 20;
```

```sql
-- 6) Compute the average daily deliveries for every driver (preview)
SELECT DISTINCT d."driver_id",
       ROUND(AVG(cnt."daily_deliveries"), 2) AS "avg_daily_deliveries"
FROM (
        SELECT d2."driver_id",
               date(o2."order_moment_delivered") AS "day",
               COUNT(*) AS "daily_deliveries"
        FROM "deliveries" AS d2
        JOIN "orders"     AS o2
             ON d2."delivery_order_id" = o2."delivery_order_id"
        WHERE d2."delivery_status" = 'DELIVERED'
          AND o2."order_moment_delivered" IS NOT NULL
        GROUP BY d2."driver_id", date(o2."order_moment_delivered")
     ) AS cnt
JOIN "deliveries" AS d
     ON d."driver_id" = cnt."driver_id"
GROUP BY d."driver_id"
LIMIT 20;
```

```sql
-- 7) FINAL ANSWER: top-5 drivers with the highest average number of daily deliveries
SELECT DISTINCT cnt."driver_id",
       ROUND(AVG(cnt."daily_deliveries"), 2) AS "avg_daily_deliveries"
FROM (
        SELECT d."driver_id",
               date(o."order_moment_delivered") AS "day",
               COUNT(*) AS "daily_deliveries"
        FROM "deliveries" AS d
        JOIN "orders"     AS o
             ON d."delivery_order_id" = o."delivery_order_id"
        WHERE d."delivery_status" = 'DELIVERED'
          AND o."order_moment_delivered" IS NOT NULL
        GROUP BY d."driver_id", date(o."order_moment_delivered")
     ) AS cnt
GROUP BY cnt."driver_id"
ORDER BY "avg_daily_deliveries" DESC
LIMIT 5;
```

These seven queries (all `SELECT` only) progress from simple inspection to computing and selecting the 5 drivers who, on average, complete the most deliveries per day.
