Query:
-- Description: 6) Final answer – five drivers with the highest average number of daily deliveries
SELECT TOP5."driver_id",
       ROUND(TOP5."avg_deliveries_per_day", 2) AS "avg_daily_deliveries"
FROM (
        SELECT driver_daily."driver_id",
               AVG(driver_daily."daily_deliveries") AS "avg_deliveries_per_day"
        FROM (
                SELECT d."driver_id",
                       o."order_created_year",
                       o."order_created_month",
                       o."order_created_day",
                       COUNT(*) AS "daily_deliveries"
                FROM   "deliveries" AS d
                JOIN   "orders"     AS o
                       ON o."order_id" = d."delivery_order_id"
                GROUP  BY d."driver_id",
                         o."order_created_year",
                         o."order_created_month",
                         o."order_created_day"
             ) AS driver_daily
        GROUP BY driver_daily."driver_id"
     ) AS TOP5
ORDER BY TOP5."avg_deliveries_per_day" DESC
LIMIT 5;
