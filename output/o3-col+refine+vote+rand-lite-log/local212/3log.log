2025-05-05 04:46:09 - Thread-3900 (execute) - INFO - [Exploration]
```sql
-- Description: 1) Quick look at distinct driver ids that appear in the deliveries table
SELECT DISTINCT "driver_id"
FROM "deliveries"
LIMIT 20;
```

```sql
-- Description: 2) Total number of deliveries completed by each driver (top-20)
SELECT d."driver_id",
       COUNT(*) AS "total_deliveries"
FROM   "deliveries" AS d
GROUP  BY d."driver_id"
ORDER  BY "total_deliveries" DESC
LIMIT 20;
```

```sql
-- Description: 3) Join deliveries ↔ orders just to inspect the day / month / year columns that are already split out in “orders”
SELECT d."driver_id",
       o."order_created_day",
       o."order_created_month",
       o."order_created_year",
       o."order_status"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
LIMIT 20;
```

```sql
-- Description: 4) Count how many deliveries each driver makes per calendar day
SELECT d."driver_id",
       o."order_created_year",
       o."order_created_month",
       o."order_created_day",
       COUNT(*) AS "daily_deliveries"
FROM   "deliveries" AS d
JOIN   "orders"     AS o
       ON o."order_id" = d."delivery_order_id"
GROUP  BY d."driver_id",
          o."order_created_year",
          o."order_created_month",
          o."order_created_day"
ORDER  BY "daily_deliveries" DESC
LIMIT 20;
```

```sql
-- Description: 5) Average (mean) number of deliveries each driver makes per active day
--         (active day = at least one delivery on that date)
SELECT driver_daily."driver_id",
       AVG(driver_daily."daily_deliveries") AS "avg_deliveries_per_day"
FROM (
        SELECT d."driver_id",
               o."order_created_year",
               o."order_created_month",
               o."order_created_day",
               COUNT(*) AS "daily_deliveries"
        FROM   "deliveries" AS d
        JOIN   "orders"     AS o
               ON o."order_id" = d."delivery_order_id"
        GROUP  BY d."driver_id",
                 o."order_created_year",
                 o."order_created_month",
                 o."order_created_day"
     ) AS driver_daily
GROUP BY driver_daily."driver_id"
ORDER BY "avg_deliveries_per_day" DESC
LIMIT 20;
```

```sql
-- Description: 6) Final answer – five drivers with the highest average number of daily deliveries
SELECT TOP5."driver_id",
       ROUND(TOP5."avg_deliveries_per_day", 2) AS "avg_daily_deliveries"
FROM (
        SELECT driver_daily."driver_id",
               AVG(driver_daily."daily_deliveries") AS "avg_deliveries_per_day"
        FROM (
                SELECT d."driver_id",
                       o."order_created_year",
                       o."order_created_month",
                       o."order_created_day",
                       COUNT(*) AS "daily_deliveries"
                FROM   "deliveries" AS d
                JOIN   "orders"     AS o
                       ON o."order_id" = d."delivery_order_id"
                GROUP  BY d."driver_id",
                         o."order_created_year",
                         o."order_created_month",
                         o."order_created_day"
             ) AS driver_daily
        GROUP BY driver_daily."driver_id"
     ) AS TOP5
ORDER BY TOP5."avg_deliveries_per_day" DESC
LIMIT 5;
```

(Only six exploratory SQL statements were necessary to progress from simple inspection to the final query that returns the five delivery drivers with the highest average number of daily deliveries.)
