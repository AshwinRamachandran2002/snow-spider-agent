Query:
--Description: (8) Compute synthetic publication month/day for every document.
--No alias-in-WHERE problems here – just ranking docs within (journal, year)
--and turning the percent-rank into month/day integers (1–12, 1–28).
WITH ranked_docs AS (
  SELECT
    doc_id,
    journal,
    year,
    first_page,
    PERCENT_RANK() OVER (
      PARTITION BY journal, year
      ORDER BY SAFE_CAST(first_page AS INT64)
    ) AS pr
  FROM `bigquery-public-data.ebi_chembl.docs_30`
  WHERE year IS NOT NULL
)
SELECT
  doc_id,
  journal,
  year,
  1 + CAST(FLOOR(pr * 11) AS INT64)          AS pub_month,
  1 + MOD(CAST(FLOOR(pr * 308) AS INT64),28) AS pub_day
FROM ranked_docs
LIMIT 20
