```sql
-- 4.  For each (assay, standard_type) keep only those with < 5 total qualifying activities
SELECT  assay_id,
        standard_type,
        COUNT(*) AS n_act
FROM   (
        SELECT a.activity_id, a.assay_id, a.standard_type
        FROM   `bigquery-public-data.ebi_chembl.activities_30` AS a
        JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
          ON   a.molregno = cp.molregno
        WHERE  pchembl_value > 10
          AND  a.standard_value IS NOT NULL
          AND  a.potential_duplicate < 2
          AND  CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
       )
GROUP  BY assay_id, standard_type
HAVING COUNT(*) < 5
LIMIT 20;
