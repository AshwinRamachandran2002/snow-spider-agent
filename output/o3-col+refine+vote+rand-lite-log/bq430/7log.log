--Description: (6) Generate distinct pairs of different molecules inside each good assay/type,
--             correcting cp join with SAFE_CAST in the good_acts CTE.
WITH good_acts AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    a.standard_value,
    a.standard_relation
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON a.molregno = SAFE_CAST(cp.molregno AS INT64)
  WHERE a.pchembl_value > 10
    AND a.standard_value IS NOT NULL
    AND a.potential_duplicate < 2
    AND CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
),
good_assays AS (
  SELECT assay_id, standard_type
  FROM  good_acts
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
)
SELECT DISTINCT
  g1.activity_id AS act_id_1,
  g2.activity_id AS act_id_2,
  g1.assay_id,
  g1.standard_type
FROM  good_acts AS g1
JOIN  good_acts AS g2
  ON  g1.assay_id      = g2.assay_id
  AND g1.standard_type = g2.standard_type
  AND g1.molregno     <> g2.molregno
JOIN  good_assays AS ga
  ON  g1.assay_id      = ga.assay_id
  AND g1.standard_type = ga.standard_type
LIMIT 20
