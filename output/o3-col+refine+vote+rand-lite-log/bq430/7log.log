--Description: (7) Add heavy-atom counts & canonical SMILES to each activity pair,
--             fixing cp1/cp2 joins with SAFE_CAST on their molregno strings.
WITH pairs AS (
  SELECT DISTINCT
    g1.activity_id AS act_id_1,
    g2.activity_id AS act_id_2,
    g1.molregno    AS mol1,
    g2.molregno    AS mol2,
    g1.assay_id,
    g1.standard_type,
    g1.standard_value     AS sv1,
    g2.standard_value     AS sv2,
    g1.standard_relation  AS rel1,
    g2.standard_relation  AS rel2
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS g1
  JOIN `bigquery-public-data.ebi_chembl.activities_30` AS g2
    ON g1.assay_id      = g2.assay_id
   AND g1.standard_type = g2.standard_type
   AND g1.molregno     <> g2.molregno
  WHERE g1.pchembl_value > 10
    AND g2.pchembl_value > 10
    AND g1.standard_value IS NOT NULL
    AND g2.standard_value IS NOT NULL
    AND g1.potential_duplicate < 2
    AND g2.potential_duplicate < 2
),
add_props AS (
  SELECT
    p.*,
    CAST(cp1.heavy_atoms AS INT64) AS ha1,
    CAST(cp2.heavy_atoms AS INT64) AS ha2,
    cs1.canonical_smiles           AS smi1,
    cs2.canonical_smiles           AS smi2
  FROM  pairs AS p
  JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp1
    ON  p.mol1 = SAFE_CAST(cp1.molregno AS INT64)
  JOIN  `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp2
    ON  p.mol2 = SAFE_CAST(cp2.molregno AS INT64)
  JOIN  `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs1
    ON  p.mol1 = SAFE_CAST(cs1.molregno AS INT64)
  JOIN  `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs2
    ON  p.mol2 = SAFE_CAST(cs2.molregno AS INT64)
  WHERE ha1 BETWEEN 10 AND 15
    AND ha2 BETWEEN 10 AND 15
)
SELECT *
FROM   add_props
LIMIT 20;
```

```sql
--Description: (8) Compute synthetic publication month/day per document (no molregno joins to fix).
WITH ranked_docs AS (
  SELECT
    doc_id,
    journal,
    year,
    first_page,
    PERCENT_RANK() OVER (
      PARTITION BY journal, year
      ORDER BY SAFE_CAST(first_page AS INT64)
    ) AS pr
  FROM `bigquery-public-data.ebi_chembl.docs_30`
  WHERE year IS NOT NULL
)
SELECT
  doc_id,
  journal,
  year,
  1 + CAST(FLOOR(pr * 11) AS INT64)                     AS pub_month,
  1 + MOD(CAST(FLOOR(pr * 308) AS INT64), 28)           AS pub_day
FROM ranked_docs
LIMIT 20;
```

```sql
--Description: (9) Attach the computed publication date to each activity (no molregno joins to fix).
WITH doc_dates AS (
  SELECT
    doc_id,
    year,
    1 + CAST(FLOOR(pr * 11)  AS INT64) AS pub_month,
    1 + MOD(CAST(FLOOR(pr * 308) AS INT64), 28) AS pub_day
  FROM (
    SELECT
      doc_id,
      year,
      PERCENT_RANK() OVER (
        PARTITION BY journal, year
        ORDER BY SAFE_CAST(first_page AS INT64)
      ) AS pr
    FROM `bigquery-public-data.ebi_chembl.docs_30`
    WHERE year IS NOT NULL
  )
)
SELECT
  a.activity_id,
  a.doc_id,
  CONCAT(
    CAST(d.year AS STRING), '-',
    LPAD(CAST(d.pub_month AS STRING), 2, '0'), '-',
    LPAD(CAST(d.pub_day   AS STRING), 2, '0')
  ) AS pub_date
FROM `bigquery-public-data.ebi_chembl.activities_30` AS a
JOIN doc_dates AS d
  ON a.doc_id = d.doc_id
LIMIT 20;
```

```sql
--Description: (10) Final result – create molecule-pair metrics & UUIDs.  
--             SAFE_CAST is applied on every join that touches cp or cs tables.
WITH good_pairs AS (
  SELECT DISTINCT
    LEAST(g1.activity_id,  g2.activity_id) AS act_low,
    GREATEST(g1.activity_id, g2.activity_id) AS act_high,
    g1.assay_id,
    g1.standard_type,
    g1.standard_value  AS sv_low,
    g2.standard_value  AS sv_high,
    g1.standard_relation AS rel_low,
    g2.standard_relation AS rel_high,
    g1.molregno        AS mol_low,
    g2.molregno        AS mol_high
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS g1
  JOIN `bigquery-public-data.ebi_chembl.activities_30` AS g2
    ON g1.assay_id      = g2.assay_id
   AND g1.standard_type = g2.standard_type
   AND g1.molregno     <> g2.molregno
  WHERE g1.pchembl_value > 10
    AND g2.pchembl_value > 10
    AND g1.standard_value IS NOT NULL
    AND g2.standard_value IS NOT NULL
    AND g1.potential_duplicate < 2
    AND g2.potential_duplicate < 2
),
add_cheminfo AS (
  SELECT
    p.*,
    CAST(cp1.heavy_atoms AS INT64) AS ha1,
    CAST(cp2.heavy_atoms AS INT64) AS ha2,
    cs1.canonical_smiles           AS smi1,
    cs2.canonical_smiles           AS smi2,
    a1.doc_id                      AS doc1,
    a2.doc_id                      AS doc2
  FROM good_pairs AS p
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp1
    ON p.mol_low  = SAFE_CAST(cp1.molregno AS INT64)
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp2
    ON p.mol_high = SAFE_CAST(cp2.molregno AS INT64)
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs1
    ON p.mol_low  = SAFE_CAST(cs1.molregno AS INT64)
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs2
    ON p.mol_high = SAFE_CAST(cs2.molregno AS INT64)
  JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a1
    ON p.act_low  = a1.activity_id
  JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a2
    ON p.act_high = a2.activity_id
  WHERE ha1 BETWEEN 10 AND 15
    AND ha2 BETWEEN 10 AND 15
),
doc_dates AS (
  SELECT
    doc_id,
    CONCAT(
      CAST(year AS STRING), '-',
      LPAD(CAST(1 + CAST(FLOOR(pr * 11) AS INT64) AS STRING), 2, '0'), '-',
      LPAD(CAST(1 + MOD(CAST(FLOOR(pr * 308) AS INT64), 28) AS STRING), 2, '0')
    ) AS pub_date
  FROM (
    SELECT
      doc_id,
      year,
      PERCENT_RANK() OVER (
        PARTITION BY journal, year
        ORDER BY SAFE_CAST(first_page AS INT64)
      ) AS pr
    FROM `bigquery-public-data.ebi_chembl.docs_30`
    WHERE year IS NOT NULL
  )
)
SELECT
  act_low  AS activity_id_1,
  act_high AS activity_id_2,
  assay_id,
  standard_type,
  GREATEST(ha1, ha2)                         AS max_heavy_atoms,
  CASE
    WHEN sv_low > sv_high THEN 'decrease'
    WHEN sv_low < sv_high THEN 'increase'
    ELSE 'no-change'
  END                                        AS change_class,
  GREATEST(doc1, doc2)                       AS max_doc_id,
  MAX(pub_date)                              AS latest_pub_date,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(act_low, act_high)))) AS mmp_delta_uuid,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(smi1,  smi2 ))))      AS molpair_uuid
FROM add_cheminfo
LEFT JOIN doc_dates ON doc1 = doc_dates.doc_id
LEFT JOIN doc_dates AS d2 ON doc2 = d2.doc_id
GROUP BY
  activity_id_1,
  activity_id_2,
  assay_id,
  standard_type,
  max_heavy_atoms,
  change_class,
  max_doc_id,
  mmp_delta_uuid,
  molpair_uuid
LIMIT 20;
```
