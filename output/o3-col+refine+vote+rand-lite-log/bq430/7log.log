```sql
--Description: We need activities that satisfy all downstream constraints:
--  • pChEMBL > 10 (high potency/affinity)
--  • molecule has 10-15 heavy atoms (small-to-medium size)
--  • non-null STANDARD_VALUE so the value can be compared
--  • fewer than 2 potential_duplicate (potential_duplicate < 2)
-- The difficulty that broke the last query was a data-type mismatch on MOLREGNO:
--   ‑ activities_30.molregno  : INT64
--   ‑ compound_properties_29.molregno : STRING
-- Solution: cast the STRING to INT64 in the join with SAFE_CAST. 
-- We also cast HEAVY_ATOMS to INT64 so we can apply the numeric filter.
-- This single query returns a distilled sample (LIMIT 20) that will feed
-- later pair-generation logic once confirmed correct.
SELECT DISTINCT
       a.activity_id,
       a.assay_id,
       a.molregno,
       a.standard_type,
       a.standard_value,
       a.standard_relation,
       a.potential_duplicate,
       CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
  ON   a.molregno = SAFE_CAST(cp.molregno AS INT64)             -- resolve INT64 vs STRING
WHERE  a.pchembl_value > 10                                     -- potency filter
  AND  CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15          -- size filter
  AND  a.standard_value IS NOT NULL                             -- need numeric comparison
  AND  a.potential_duplicate < 2                                -- unique enough
LIMIT 20;
