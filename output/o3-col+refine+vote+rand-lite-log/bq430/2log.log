--Description: Pull all qualifying rows (row-level filters) that are in an assay/standard_type
--             bucket with <5 such rows.  All joins have corrected casting for molregno.
WITH qual AS (
  SELECT a.*
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
    ON a.molregno = CAST(p.molregno AS INT64)
