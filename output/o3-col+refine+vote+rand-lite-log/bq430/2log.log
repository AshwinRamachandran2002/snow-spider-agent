```sql
-- 7. For every ASSAY / STANDARD_TYPE pair, how many such qualifying rows exist?
SELECT assay_id,
       standard_type,
       COUNT(*) AS n_qualifying_rows
FROM (
      SELECT a.assay_id, a.standard_type
      FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
      JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
      USING  (molregno)
      WHERE  SAFE_CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
        AND  a.standard_value IS NOT NULL
        AND  a.pchembl_value  > 10
        AND  a.potential_duplicate < 2
     )
GROUP BY assay_id, standard_type
HAVING COUNT(*) < 5
LIMIT 20;
```

```sql
-- 8. Pull out all activity rows that meet every row-level condition
--    *and* belong to an assay/standard_type with <5 such rows (from step-7)
WITH qual AS (
      SELECT a.*
      FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
      JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
      USING  (molregno)
      WHERE  SAFE_CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
        AND  a.standard_value IS NOT NULL
        AND  a.pchembl_value  > 10
        AND  a.potential_duplicate < 2
), small_assay AS (
      SELECT assay_id, standard_type
      FROM   qual
      GROUP  BY assay_id, standard_type
      HAVING COUNT(*) < 5
)
SELECT q.*
FROM   qual AS q
JOIN   small_assay AS s
USING  (assay_id, standard_type)
LIMIT 20;
```

```sql
-- 9. Enumerate all *pairs* of DIFFERENT molecules inside each small assay / std_type bucket
--    (pre-compute change classification for the pair)
WITH base AS (   -- reuse step-8
      SELECT q.*,
             SAFE_CAST(p.heavy_atoms AS INT64) AS heavy_atoms
      FROM  (
             SELECT a.*
             FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
             JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
             USING  (molregno)
             WHERE  SAFE_CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
               AND  a.standard_value IS NOT NULL
               AND  a.pchembl_value  > 10
               AND  a.potential_duplicate < 2
            ) AS q
      JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
      USING  (molregno)
),
small_assay AS (
      SELECT assay_id, standard_type
      FROM   base
      GROUP  BY assay_id, standard_type
      HAVING COUNT(*) < 5
),
filtered AS (
      SELECT b.*
      FROM   base AS b
      JOIN   small_assay AS s
      USING  (assay_id, standard_type)
)
SELECT f1.activity_id  AS act_id_1,
       f2.activity_id  AS act_id_2,
       f1.standard_value AS val_1,
       f2.standard_value AS val_2,
       CASE
          WHEN f1.standard_value > f2.standard_value THEN 'decrease'
          WHEN f1.standard_value < f2.standard_value THEN 'increase'
          ELSE 'no-change'
       END AS change_class
FROM   filtered AS f1
JOIN   filtered AS f2
  ON   f1.assay_id       = f2.assay_id
 AND   f1.standard_type  = f2.standard_type
 AND   f1.molregno      <> f2.molregno
 AND   f1.activity_id   <  f2.activity_id      -- avoid self / duplicate pairs
LIMIT 20;
```

```sql
-- 10. FINAL: produce required report for every qualifying pair
WITH base AS (
      SELECT a.*,
             SAFE_CAST(p.heavy_atoms AS INT64) AS heavy_atoms,
             d.journal,
             COALESCE(d.year, 1970)                   AS pub_year,
             SAFE_CAST(d.first_page AS INT64)         AS first_page,
             d.doc_id
      FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
      JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
      USING  (molregno)
      JOIN   `bigquery-public-data.ebi_chembl.docs_29`                AS d
      ON     CAST(a.doc_id AS INT64) = d.doc_id
      WHERE  SAFE_CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
        AND  a.standard_value IS NOT NULL
        AND  a.pchembl_value  > 10
        AND  a.potential_duplicate < 2
),
small_assay AS (
      SELECT assay_id, standard_type
      FROM   base
      GROUP  BY assay_id, standard_type
      HAVING COUNT(*) < 5
),
filtered AS (
      SELECT b.*
      FROM   base AS b
      JOIN   small_assay AS s
      USING  (assay_id, standard_type)
),
pairwise AS (
      SELECT f1.activity_id   AS activity_id_1,
             f2.activity_id   AS activity_id_2,
             f1.canonical_smiles AS smiles_1,
             f2.canonical_smiles AS smiles_2,
             GREATEST(f1.heavy_atoms, f2.heavy_atoms)              AS max_heavy_atoms,
             GREATEST(CAST(f1.doc_id AS INT64),
                      CAST(f2.doc_id AS INT64))                    AS max_doc_id,
             CASE
               WHEN f1.standard_value > f2.standard_value THEN 'decrease'
               WHEN f1.standard_value < f2.standard_value THEN 'increase'
               ELSE 'no-change'
             END                                                  AS change_class,
             -- publication date for the later document
             (SELECT FORMAT_DATE('%F', DATE(
                         pub_year,
                         1 + FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, pub_year
                                                        ORDER BY first_page)*11),
                         1 + MOD(FLOOR(PERCENT_RANK() OVER (PARTITION BY journal, pub_year
                                                             ORDER BY first_page)*308), 28)
                   )
              ) FROM UNNEST([STRUCT(f1.journal AS journal,
                                     f1.pub_year AS pub_year,
                                     f1.first_page AS first_page)]) -- dummy SELECT to re-use formula
             AS latest_publication_date,
             TO_HEX(MD5( TO_JSON_STRING(STRUCT(f1.activity_id, f2.activity_id)) ))   AS mmp_delta_uuid,
             TO_HEX(MD5( TO_JSON_STRING(STRUCT(f1.canonical_smiles, f2.canonical_smiles)) )) AS smiles_pair_uuid
      FROM   filtered AS f1
      JOIN   filtered AS f2
        ON   f1.assay_id       = f2.assay_id
       AND   f1.standard_type  = f2.standard_type
       AND   f1.molregno      <> f2.molregno
       AND   f1.activity_id   <  f2.activity_id
)
SELECT *
FROM   pairwise
LIMIT 20;
```
