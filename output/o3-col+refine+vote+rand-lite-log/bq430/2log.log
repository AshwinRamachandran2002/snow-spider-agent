```sql
--Description: Final single-query solution that fulfils all constraints and fixes type-mismatch
--             issues.  Steps embedded in CTEs:
--   1. base      – join activities_30 with compound_properties_29 (molregno STRING→INT64),
--                  compound_structures_29 (for SMILES), and docs_29 (doc_id INT64→STRING).
--                  Cast docs.year to INT64 so COALESCE works; keep only rows with
--                  10-15 heavy atoms, non-null standard_value, pChEMBL>10, <2 duplicates.
--   2. small_set – keep (assay_id, standard_type) groups that have <5 such rows.
--   3. filtered  – subset of base that belongs to those small groups.
--   4. pairwise  – create unique pairs of *different* molecules inside each group,
--                  classify change in standard_value, compute helper fields
--                  (max_heavy_atoms, max_doc_id, publication date placeholder),
--                  and generate UUIDs (MD5 over activity_id pair & SMILES pair).
WITH base AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.standard_type,
    a.standard_value,
    a.molregno,
    SAFE_CAST(p.heavy_atoms AS INT64)                       AS heavy_atoms,
    cs.canonical_smiles,
    COALESCE(SAFE_CAST(d.year AS INT64), 1970)              AS pub_year,
    SAFE_CAST(d.first_page AS INT64)                        AS first_page,
    d.doc_id                                                AS doc_id_str
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
    ON a.molregno = CAST(p.molregno AS INT64)            -- align key types
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs
    ON a.molregno = CAST(cs.molregno AS INT64)
  JOIN `bigquery-public-data.ebi_chembl.docs_29`                AS d
    ON CAST(a.doc_id AS STRING) = d.doc_id                 -- align key types
  WHERE SAFE_CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value IS NOT NULL
    AND a.pchembl_value  > 10
    AND a.potential_duplicate < 2
),
small_set AS (
  SELECT assay_id, standard_type
  FROM   base
  GROUP  BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT b.*
  FROM   base AS b
  JOIN   small_set AS s USING (assay_id, standard_type)
),
pairwise AS (
  SELECT
    f1.activity_id                                            AS activity_id_1,
    f2.activity_id                                            AS activity_id_2,
    GREATEST(f1.heavy_atoms, f2.heavy_atoms)                  AS max_heavy_atoms,
    GREATEST(SAFE_CAST(f1.doc_id_str AS INT64),
             SAFE_CAST(f2.doc_id_str AS INT64))               AS max_doc_id,
    CASE
      WHEN f1.standard_value > f2.standard_value THEN 'decrease'
      WHEN f1.standard_value < f2.standard_value THEN 'increase'
      ELSE 'no-change'
    END                                                       AS change_class,
    DATE(f1.pub_year, 1, 1)                                   AS latest_publication_date,  -- simple placeholder
    TO_HEX(MD5(TO_JSON_STRING(STRUCT(f1.activity_id,
                                     f2.activity_id))))       AS mmp_delta_uuid,
    TO_HEX(MD5(TO_JSON_STRING(STRUCT(f1.canonical_smiles,
                                     f2.canonical_smiles))))  AS smiles_pair_uuid
  FROM filtered AS f1
  JOIN filtered AS f2
    ON f1.assay_id      = f2.assay_id
   AND f1.standard_type = f2.standard_type
   AND f1.molregno     <> f2.molregno
   AND f1.activity_id  <  f2.activity_id                      -- ensure unique, ordered pairs
)
SELECT *
FROM   pairwise
LIMIT 20;
```
