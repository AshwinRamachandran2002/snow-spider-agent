  d.pub_year,
  d.pub_month,
  d.pub_day,
  d.doc_id AS latest_doc_id,
  CASE
    WHEN p.val1 = p.val2 THEN 'no-change'
    WHEN p.val1 < p.val2 THEN 'increase'
    ELSE                    'decrease'
  END AS change_class
FROM pairs      AS p
LEFT JOIN doc_dates AS d
  ON CAST(p.assay_id AS STRING) = d.doc_id   -- simple placeholder link
