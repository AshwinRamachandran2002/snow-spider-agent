    h1.standard_relation AS rel1,
    h2.standard_relation AS rel2,
    GREATEST(h1.heavy_atoms, h2.heavy_atoms) AS max_heavy_atoms,
    TO_HEX(MD5(TO_JSON_STRING(STRUCT(h1.activity_id, h2.activity_id)))) AS mmp_delta_uuid,
    TO_HEX(MD5(TO_JSON_STRING(STRUCT(sm1.canonical_smiles, sm2.canonical_smiles)))) AS smiles_pair_uuid
  FROM hit AS h1
  JOIN hit AS h2
    ON h1.assay_id      = h2.assay_id
   AND h1.standard_type = h2.standard_type
   AND h1.molregno      <> h2.molregno
   AND h1.molregno      <  h2.molregno
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS sm1
