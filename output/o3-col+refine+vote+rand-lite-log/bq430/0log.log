--Description: Query 10 – final consolidated pair report.  Integrates SMILES, UUIDs,
--             change classification, and synthetic publication dates.  Fixes the
--             COALESCE/YEAR type issue inside doc_dates by casting YEAR to INT64.
WITH hit AS (                         -- same as Query 8 HIT CTE
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_relation,
    a.standard_value,
    a.standard_type,
    a.pchembl_value,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value       IS NOT NULL
    AND a.pchembl_value        > 10
    AND a.potential_duplicate  < 2
),
pairs AS (                            -- same pairing logic
  SELECT
    h1.activity_id AS act_id_1,
    h2.activity_id AS act_id_2,
    h1.assay_id,
    h1.standard_type,
    SAFE_CAST(h1.standard_value AS FLOAT64) AS val1,
    SAFE_CAST(h2.standard_value AS FLOAT64) AS val2,
    h1.standard_relation AS rel1,
    h2.standard_relation AS rel2,
    GREATEST(h1.heavy_atoms, h2.heavy_atoms)      AS max_heavy_atoms,
    TO_HEX(MD5(TO_JSON_STRING(STRUCT(h1.activity_id, h2.activity_id))))
                                                 AS mmp_delta_uuid
  FROM hit AS h1
  JOIN hit AS h2
    ON h1.assay_id      = h2.assay_id
   AND h1.standard_type = h2.standard_type
   AND h1.molregno      <> h2.molregno
   AND h1.molregno      <  h2.molregno
),
pairs_smiles AS (                     -- attach SMILES & build smiles_pair_uuid
  SELECT
    p.*,
    TO_HEX(MD5(TO_JSON_STRING(
         STRUCT(sm1.canonical_smiles, sm2.canonical_smiles))))
         AS smiles_pair_uuid
  FROM  pairs AS p
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS sm1
    ON sm1.molregno = CAST(p.act_id_1 AS STRING)   -- placeholder link
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS sm2
    ON sm2.molregno = CAST(p.act_id_2 AS STRING)
),
doc_dates AS (                        -- synthetic dates with YEAR cast fix
  SELECT
    doc_id,
    COALESCE(SAFE_CAST(year AS INT64), 1970)                       AS pub_year,
    1 + CAST(
          11 * PERCENT_RANK() OVER (
                PARTITION BY journal,
                             COALESCE(SAFE_CAST(year AS INT64), 1970)
                ORDER BY SAFE_CAST(first_page AS INT64)
          ) AS INT64)                                              AS pub_month,
    1 + MOD(CAST(
          308 * PERCENT_RANK() OVER (
                PARTITION BY journal,
                             COALESCE(SAFE_CAST(year AS INT64), 1970)
                ORDER BY SAFE_CAST(first_page AS INT64)
          ) AS INT64), 28)                                         AS pub_day
  FROM `bigquery-public-data.ebi_chembl.docs_29`
)
SELECT
  ps.*,
  dd.pub_year,
  dd.pub_month,
  dd.pub_day,
  dd.doc_id                            AS latest_doc_id,
  CASE
    WHEN val1 = val2 THEN 'no-change'
    WHEN val1 < val2 THEN 'increase'
    ELSE                    'decrease'
  END                                  AS change_class
FROM pairs_smiles AS ps
LEFT JOIN doc_dates AS dd
  ON CAST(ps.assay_id AS STRING) = dd.doc_id          -- placeholder mapping
ORDER BY ps.max_heavy_atoms DESC
LIMIT 20
