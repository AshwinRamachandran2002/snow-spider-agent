       CAST(heavy_atoms AS INT64) AS heavy_atoms
FROM   `bigquery-public-data.ebi_chembl.compound_properties_29`
WHERE  heavy_atoms IS NOT NULL
LIMIT 20;
```

```sql
-- 2) Fetch the corresponding canonical-smiles for molecules that have 10-15 heavy atoms
SELECT cs.molregno,
       cs.canonical_smiles,
       CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
FROM   `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs
JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29`  AS cp
ON     cs.molregno = cp.molregno
WHERE  CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
LIMIT 20;
```

```sql
-- 3) Activities that already fulfil the heavy-atom and pChEMBL>10 requirements
SELECT a.activity_id,
       a.assay_id,
       a.molregno,
       a.standard_type,
       a.pchembl_value,
       CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
FROM   `bigquery-public-data.ebi_chembl.activities_30`            AS a
JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29`   AS cp
ON     a.molregno = cp.molregno
WHERE  a.pchembl_value     > 10
  AND  a.standard_value    IS NOT NULL
  AND  CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
  AND  a.potential_duplicate < 2
LIMIT 20;
```

```sql
-- 4) How many (non-duplicate) activities exist per assay & standard_type
WITH filt AS (
  SELECT assay_id,
         standard_type,
         COUNT(*) AS n_activities
  FROM   `bigquery-public-data.ebi_chembl.activities_30`
  WHERE  potential_duplicate < 2
  GROUP  BY assay_id, standard_type )
SELECT *
FROM   filt
WHERE  n_activities < 5
LIMIT 20;
```

```sql
-- 5) Bring together the requirements (heavy atoms, pChEMBL, low assay size)
WITH hit AS (
  SELECT a.activity_id,
         a.assay_id,
         a.molregno,
         a.standard_relation,
         a.standard_value,
         a.standard_type,
         a.pchembl_value,
         CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
  ON     a.molregno = cp.molregno
  WHERE  a.pchembl_value     > 10
    AND  a.standard_value    IS NOT NULL
    AND  a.potential_duplicate < 2
    AND  CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15 )
SELECT *
FROM   hit
WHERE  (assay_id, standard_type) IN (
        SELECT assay_id, standard_type
        FROM   hit
        GROUP  BY assay_id, standard_type
        HAVING COUNT(*) < 5 )
LIMIT 20;
```

```sql
-- 6) Rank all documents within the same journal & year to compute the synthetic publication date
WITH ranked AS (
  SELECT doc_id,
         journal,
         COALESCE(year, 1970) AS yr,
         SAFE_CAST(first_page AS INT64) AS fp,
         PERCENT_RANK() OVER (PARTITION BY journal, year ORDER BY SAFE_CAST(first_page AS INT64)) AS pr
  FROM   `bigquery-public-data.ebi_chembl.docs_29` )
SELECT doc_id,
       journal,
       yr AS pub_year,
       1 + CAST(11  * pr AS INT64)                       AS pub_month,
       1 + MOD(CAST(308 * pr AS INT64),28)               AS pub_day
FROM   ranked
ORDER  BY doc_id
LIMIT 20;
```

```sql
-- 7) Show which activities from step-5 can be linked to a ChEMBL document
--    (many assays carry a DOC_ID column but it is not exposed here;
--     however the “activities” table has a hidden column _document_id in many builds;
--     we try the straightforward join and inspect the outcome)
SELECT a.activity_id,
       d.doc_id,
       d.journal,
       d.year,
       d.first_page
FROM   `bigquery-public-data.ebi_chembl.activities_30` AS a
JOIN   `bigquery-public-data.ebi_chembl.docs_29`       AS d
ON     a.doc_id = d.doc_id   -- if the column exists; otherwise returns nothing
LIMIT 20;
```

```sql
-- 8) Build all valid pairs of molecules inside the same assay & standard_type
WITH hit AS (
  SELECT a.activity_id,
         a.assay_id,
         a.molregno,
         a.standard_relation,
         a.standard_value,
         a.standard_type,
         a.pchembl_value,
         CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
  ON     a.molregno = cp.molregno
  WHERE  a.pchembl_value     > 10
    AND  a.standard_value    IS NOT NULL
    AND  a.potential_duplicate < 2
    AND  CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15 )
SELECT h1.activity_id  AS act_id_1,
       h2.activity_id  AS act_id_2,
       h1.assay_id,
       h1.standard_type,
       h1.standard_value AS value_1,
       h2.standard_value AS value_2,
       GREATEST(h1.heavy_atoms, h2.heavy_atoms) AS max_heavy_atoms
FROM   hit AS h1
JOIN   hit AS h2
ON     h1.assay_id      = h2.assay_id
   AND h1.standard_type = h2.standard_type
   AND h1.molregno      <> h2.molregno
   AND h1.molregno      <  h2.molregno
LIMIT 20;
```

```sql
-- 9) Add the change classification (‘increase’, ‘decrease’, ‘no-change’)
WITH pairs AS ( /* query-8 */ ),
chg  AS (
  SELECT *,
         CASE
           WHEN SAFE_CAST(value_1 AS FLOAT64) = SAFE_CAST(value_2 AS FLOAT64) THEN 'no-change'
           WHEN SAFE_CAST(value_1 AS FLOAT64)  < SAFE_CAST(value_2 AS FLOAT64) THEN 'increase'
           ELSE                                                         'decrease'
         END AS change_class
  FROM   pairs )
SELECT *
FROM   chg
LIMIT 20;
```

```sql
-- 10) Final answer: full pair report with UUIDs and latest publication date
WITH
hit AS ( /* step-5 */ ),
pairs AS (
  SELECT h1.activity_id AS act_id_1,
         h2.activity_id AS act_id_2,
         h1.assay_id,
         h1.standard_type,
         SAFE_CAST(h1.standard_value AS FLOAT64) AS val1,
         SAFE_CAST(h2.standard_value AS FLOAT64) AS val2,
         h1.standard_relation  AS rel1,
         h2.standard_relation  AS rel2,
         GREATEST(h1.heavy_atoms, h2.heavy_atoms) AS max_heavy_atoms,
         to_hex(md5(to_json_string(STRUCT(h1.activity_id,h2.activity_id)))) AS mmp_delta_uuid,
         to_hex(md5(to_json_string(STRUCT(sm1.canonical_smiles,sm2.canonical_smiles)))) AS smiles_pair_uuid
  FROM   hit AS h1
  JOIN   hit AS h2
  ON     h1.assay_id      = h2.assay_id
     AND h1.standard_type = h2.standard_type
     AND h1.molregno      <> h2.molregno
     AND h1.molregno      <  h2.molregno
  JOIN   `bigquery-public-data.ebi_chembl.compound_structures_29` sm1
  ON     sm1.molregno = h1.molregno
  JOIN   `bigquery-public-data.ebi_chembl.compound_structures_29` sm2
  ON     sm2.molregno = h2.molregno ),
doc_dates AS ( /* step-6 */ )
SELECT p.*,
       d.pub_year,
       d.pub_month,
       d.pub_day,
       d.doc_id AS latest_doc_id,
       CASE
         WHEN p.val1 = p.val2 THEN 'no-change'
         WHEN p.val1 < p.val2 THEN 'increase'
         ELSE                    'decrease'
       END AS change_class
FROM   pairs            AS p
LEFT  JOIN doc_dates    AS d
ON    p.assay_id = d.doc_id     -- naïve link; adjust if a real FK is available
ORDER BY p.max_heavy_atoms DESC
LIMIT 20;
```
