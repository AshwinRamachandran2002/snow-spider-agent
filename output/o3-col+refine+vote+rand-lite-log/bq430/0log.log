```sql
--Description:  Fix the COALESCE type-mismatch by converting docs_29.year (STRING) to
--              INT64 with SAFE_CAST.  Default missing years to 1970, then rank articles
--              within each (journal, pub_year) group by FIRST_PAGE to compute a percent
--              rank (pr).  Finally transform pr into the synthetic publication month
--              (1-12) and day (1-28) as per the specification and show a 20-row sample.
WITH ranked AS (
  SELECT
    doc_id,
    journal,
    COALESCE(SAFE_CAST(year AS INT64), 1970)             AS pub_year,
    SAFE_CAST(first_page AS INT64)                       AS fp,
    PERCENT_RANK() OVER (
      PARTITION BY journal,
                   COALESCE(SAFE_CAST(year AS INT64), 1970)
      ORDER BY SAFE_CAST(first_page AS INT64)
    )                                                    AS pr
  FROM `bigquery-public-data.ebi_chembl.docs_29`
)
SELECT
  doc_id,
  journal,
  pub_year,
  1 + CAST(11 * pr AS INT64)                             AS pub_month,
  1 + MOD(CAST(308 * pr AS INT64), 28)                   AS pub_day
FROM ranked
ORDER BY doc_id
LIMIT 20;
