WITH hit AS (                         -- identical sub-query used in Query 8
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_relation,
    a.standard_value,
    a.standard_type,
    a.pchembl_value,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value       IS NOT NULL
    AND a.pchembl_value        > 10
    AND a.potential_duplicate  < 2
),
pairs AS (                            -- same pairing logic as Query 8
  SELECT
    h1.activity_id AS act_id_1,
    h2.activity_id AS act_id_2,
    h1.assay_id,
    h1.standard_type,
    SAFE_CAST(h1.standard_value AS FLOAT64) AS value_1,
    SAFE_CAST(h2.standard_value AS FLOAT64) AS value_2
  FROM hit AS h1
