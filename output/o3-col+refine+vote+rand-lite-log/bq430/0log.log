Query:
--Description: Query 9 – classify each pair from Query 8 as ‘increase’, ‘decrease’,
--             or ‘no-change’.  Ensures numeric comparison by casting STANDARD_VALUEs
--             to FLOAT64; inherits the same hit/pair logic and type-casting fixes.
WITH hit AS (                         -- identical to Query 8 HIT CTE
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_relation,
    a.standard_value,
    a.standard_type,
    a.pchembl_value,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value       IS NOT NULL
    AND a.pchembl_value        > 10
    AND a.potential_duplicate  < 2
),
pairs AS (                            -- same pairing as Query 8
  SELECT
    h1.activity_id AS act_id_1,
    h2.activity_id AS act_id_2,
    h1.assay_id,
    h1.standard_type,
    SAFE_CAST(h1.standard_value AS FLOAT64) AS value_1,
    SAFE_CAST(h2.standard_value AS FLOAT64) AS value_2
  FROM hit AS h1
  JOIN hit AS h2
    ON h1.assay_id      = h2.assay_id
   AND h1.standard_type = h2.standard_type
   AND h1.molregno      <> h2.molregno
   AND h1.molregno      <  h2.molregno
),
chg AS (
  SELECT
    *,
    CASE
      WHEN value_1 = value_2 THEN 'no-change'
      WHEN value_1 < value_2 THEN 'increase'
      ELSE                       'decrease'
    END AS change_class
  FROM pairs
)
SELECT *
FROM  chg
LIMIT 20
