  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value        IS NOT NULL
    AND a.pchembl_value         > 10
    AND a.potential_duplicate   < 2
),
pairs AS (
  SELECT
    h1.activity_id AS act_id_1,
    h2.activity_id AS act_id_2,
    h1.assay_id,
    h1.standard_type,
    h1.standard_value AS value_1,
    h2.standard_value AS value_2,
    GREATEST(h1.heavy_atoms, h2.heavy_atoms) AS max_heavy_atoms
