--             Finally, create the Cartesian pairing (h1 vs h2) restricted to
--             different molecules, ordered to avoid duplicates (h1.molregno < h2.molregno).
WITH hit AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_relation,
    a.standard_value,
    a.standard_type,
    a.pchembl_value,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
