--Description: Query 6 – rank documents within each (journal, year) group to derive a
--             synthetic month/day using the provided percent-rank algorithm.
WITH ranked AS (
  SELECT
    doc_id,
    journal,
    COALESCE(year, 1970)                            AS pub_year,
    SAFE_CAST(first_page AS INT64)                  AS fp,
    PERCENT_RANK() OVER (
      PARTITION BY journal, year
      ORDER BY SAFE_CAST(first_page AS INT64)
    )                                               AS pr
  FROM `bigquery-public-data.ebi_chembl.docs_29`
)
SELECT
  doc_id,
  journal,
  pub_year,
  1 + CAST(11  * pr AS INT64)                       AS pub_month,
  1 + MOD(CAST(308 * pr AS INT64), 28)              AS pub_day
FROM ranked
ORDER BY doc_id
LIMIT 20;
```

