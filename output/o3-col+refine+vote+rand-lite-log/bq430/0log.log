--Description: Query 8 – create all valid activity-pairs in the same assay & standard_type.
--             Fixes molregno type mismatch by CASTing to STRING when joining to
--             compound_properties_29 and prevents reversed duplicates by enforcing
--             h1.molregno < h2.molregno.
WITH hit AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_relation,
    a.standard_value,
    a.standard_type,
    a.pchembl_value,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON CAST(a.molregno AS STRING) = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value       IS NOT NULL
    AND a.pchembl_value        > 10
    AND a.potential_duplicate  < 2
),
pairs AS (
  SELECT
    h1.activity_id AS act_id_1,
    h2.activity_id AS act_id_2,
    h1.assay_id,
    h1.standard_type,
    h1.standard_value AS value_1,
    h2.standard_value AS value_2,
    GREATEST(h1.heavy_atoms, h2.heavy_atoms) AS max_heavy_atoms
  FROM hit AS h1
  JOIN hit AS h2
    ON h1.assay_id      = h2.assay_id
   AND h1.standard_type = h2.standard_type
   AND h1.molregno      <> h2.molregno
   AND h1.molregno      <  h2.molregno
)
SELECT *
FROM  pairs
LIMIT 20
