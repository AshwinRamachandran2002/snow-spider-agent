doc_dates AS (                        -- synthetic dates with YEAR cast fix
  SELECT
    doc_id,
    COALESCE(SAFE_CAST(year AS INT64), 1970)                       AS pub_year,
    1 + CAST(
          11 * PERCENT_RANK() OVER (
                PARTITION BY journal,
                             COALESCE(SAFE_CAST(year AS INT64), 1970)
                ORDER BY SAFE_CAST(first_page AS INT64)
          ) AS INT64)                                              AS pub_month,
    1 + MOD(CAST(
          308 * PERCENT_RANK() OVER (
                PARTITION BY journal,
                             COALESCE(SAFE_CAST(year AS INT64), 1970)
                ORDER BY SAFE_CAST(first_page AS INT64)
          ) AS INT64), 28)                                         AS pub_day
  FROM `bigquery-public-data.ebi_chembl.docs_29`
)
SELECT
  ps.*,
  dd.pub_year,
  dd.pub_month,
  dd.pub_day,
  dd.doc_id                            AS latest_doc_id,
  CASE
    WHEN val1 = val2 THEN 'no-change'
    WHEN val1 < val2 THEN 'increase'
    ELSE                    'decrease'
  END                                  AS change_class
FROM pairs_smiles AS ps
LEFT JOIN doc_dates AS dd
  ON CAST(ps.assay_id AS STRING) = dd.doc_id          -- placeholder mapping
ORDER BY ps.max_heavy_atoms DESC
LIMIT 20;
