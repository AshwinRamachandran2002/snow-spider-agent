/* ---------------------------------------------------------------------------
   Pairs of different molecules measured in the same assay / standard_type that

     • have pChEMBL > 10, 10-15 heavy atoms, non-NULL standard_value,
       potential_duplicate < 2
     • come from an assay / standard_type that has < 5 such qualifying
       activities
     • are classified as increase / decrease / no-change in standard_value
     • bring back auxiliary information that is requested
---------------------------------------------------------------------------- */

/* ---------- 1.  Synthetic publication-date for every document ------------ */
WITH docs_w_rank AS (
  SELECT
    doc_id,                                   -- INT64
    COALESCE(year, 1970)                AS yr,
    journal,
    SAFE_CAST(first_page AS INT64)      AS first_pg,
    PERCENT_RANK() OVER (
        PARTITION BY journal, year
        ORDER BY SAFE_CAST(first_page AS INT64)
    )                                   AS pr
  FROM `bigquery-public-data.ebi_chembl.docs_29`
),
docs_dates AS (                               -- final calendar date
  SELECT
    doc_id,
    DATE(
      yr,
