```sql
-- 6. Count how many qualifying activities (10-15 heavy atoms, pChEMBL>10,
--    non-NULL standard_value) each assay/standard_type pair contains.
--    We only keep those with < 5 rows to satisfy the task requirement.
SELECT a.assay_id,
       a.standard_type,
       COUNT(*) AS n_activities
FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
       ON a.molregno = cp.molregno
WHERE  a.pchembl_value > 10
  AND  a.standard_value IS NOT NULL
  AND  SAFE_CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
GROUP  BY a.assay_id, a.standard_type
HAVING COUNT(*) < 5
LIMIT 20;
```

```sql
-- 7. Pull back the individual qualifying activity rows, additionally
--    excluding cases with ≥2 duplicate flags (potential_duplicate < 2)
SELECT a.activity_id,
       a.assay_id,
       a.molregno,
       a.standard_relation,
       CAST(a.standard_value AS FLOAT64)   AS standard_value,
       a.standard_type,
       a.pchembl_value,
       CAST(cp.heavy_atoms AS INT64)       AS heavy_atoms
FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
       ON a.molregno = cp.molregno
JOIN (
      /* list from step-6 */
      SELECT assay_id, standard_type
      FROM (
            SELECT a.assay_id,
                   a.standard_type,
                   COUNT(*) AS n_activities
            FROM   `bigquery-public-data.ebi_chembl.activities_30` AS a
            JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
                   ON a.molregno = cp.molregno
            WHERE  a.pchembl_value > 10
              AND  a.standard_value IS NOT NULL
              AND  SAFE_CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
            GROUP  BY a.assay_id, a.standard_type
            HAVING COUNT(*) < 5
      )
) AS smallsets
       ON a.assay_id     = smallsets.assay_id
      AND a.standard_type = smallsets.standard_type
WHERE  a.pchembl_value > 10
  AND  a.standard_value IS NOT NULL
  AND  SAFE_CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
  AND  a.potential_duplicate < 2
LIMIT 20;
```

```sql
-- 8. Generate all unordered pairs of *different* molecules that belong
--    to the same assay & standard_type set selected above.
--    Also classify the change in standard_value (increase/decrease/no-change)
WITH qualified AS (
  SELECT a.activity_id,
         a.assay_id,
         a.molregno,
         a.standard_relation,
         CAST(a.standard_value AS FLOAT64)   AS sv,
         a.standard_type
  FROM   `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN   `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
         ON a.molregno = cp.molregno
  WHERE  a.pchembl_value > 10
    AND  a.standard_value IS NOT NULL
    AND  SAFE_CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND  a.potential_duplicate < 2
)
SELECT q1.activity_id AS act_id_1,
       q2.activity_id AS act_id_2,
       q1.sv          AS sv_1,
       q2.sv          AS sv_2,
       CASE
         WHEN q1.standard_relation = '=' AND q2.standard_relation = '=' AND q1.sv = q2.sv
              THEN 'no-change'
         WHEN q1.sv > q2.sv THEN 'decrease'
         WHEN q1.sv < q2.sv THEN 'increase'
         ELSE 'undetermined'
       END            AS change_class
FROM   qualified AS q1
JOIN   qualified AS q2
       ON q1.assay_id      = q2.assay_id
      AND q1.standard_type = q2.standard_type
      AND q1.molregno     <> q2.molregno
      AND q1.activity_id  <  q2.activity_id      -- avoid duplicates
LIMIT 20;
```

