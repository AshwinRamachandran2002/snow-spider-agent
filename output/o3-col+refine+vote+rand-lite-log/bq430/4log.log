Query:
--Description:  (Corrected version of SQL #6)
--  Count qualifying activities (10–15 heavy atoms, pChEMBL > 10, non-NULL
--  standard_value) per assay / standard_type.  Use CAST on molregno so the
--  join to compound_properties_29 works and filter to < 5 rows per group.
SELECT
  a.assay_id,
  a.standard_type,
  COUNT(*) AS n_activities
FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
     ON CAST(a.molregno AS STRING) = cp.molregno
WHERE a.pchembl_value > 10
  AND a.standard_value IS NOT NULL
  AND SAFE_CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
GROUP BY a.assay_id, a.standard_type
HAVING COUNT(*) < 5
LIMIT 20
