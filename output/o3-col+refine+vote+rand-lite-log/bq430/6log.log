--Description: 5) Pick one small assay (≤ 4 rows meeting the filters) and list all of its activities,
--              including potential_duplicate flag. Same JOIN fix as above.
WITH small_assay AS (
  SELECT assay_id
  FROM (
    SELECT
      act.assay_id,
      act.standard_type,
      COUNT(*) AS cnt
    FROM `bigquery-public-data.ebi_chembl.activities_30` AS act
    JOIN (
      SELECT CAST(molregno AS INT64) AS molregno
      FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
      WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
    ) AS hvy
    USING (molregno)
    WHERE act.pchembl_value > 10
      AND act.standard_value IS NOT NULL
    GROUP BY act.assay_id, act.standard_type
    HAVING cnt < 5
    LIMIT 1
  )
)
SELECT
  activity_id,
  assay_id,
  molregno,
  standard_relation,
  standard_value,
  standard_type,
  potential_duplicate
FROM `bigquery-public-data.ebi_chembl.activities_30`
WHERE assay_id = (SELECT assay_id FROM small_assay)
LIMIT 20
