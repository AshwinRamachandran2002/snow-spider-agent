```sql
--Description: 7) Fetch publication metadata (journal, year, first_page) for qualifying activities.
--              Fix: cast STRING activity_id in `activities` to INT64 when joining with activities_30,
--              and cast doc_id to INT64 when comparing with docs_30 (INT64 primary key).
WITH qual AS (
  SELECT a30.activity_id
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS a30
  JOIN (
    SELECT CAST(molregno AS INT64) AS molregno
    FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
    WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
  ) AS hvy
  USING (molregno)
  WHERE a30.pchembl_value > 10
    AND a30.standard_value IS NOT NULL
  LIMIT 100
), act_docs AS (
  SELECT DISTINCT
    SAFE_CAST(ag.doc_id AS INT64) AS doc_id
  FROM qual
  JOIN `bigquery-public-data.ebi_chembl.activities` AS ag
    ON SAFE_CAST(ag.activity_id AS INT64) = qual.activity_id
  WHERE ag.doc_id IS NOT NULL
)
SELECT
  d.doc_id,
  d.journal,
  d.year,
  d.first_page
FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
JOIN act_docs USING (doc_id)
LIMIT 20;
