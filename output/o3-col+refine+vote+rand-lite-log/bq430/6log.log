```sql
--Description: 4)  Count how many activity rows exist for every (assay_id, standard_type) combination after
--                applying the heavy-atom + pChEMBL + value filters.  We need <5 per assay later.
SELECT
  assay_id,
  standard_type,
  COUNT(*) AS n_activities
FROM `bigquery-public-data.ebi_chembl.activities_30`
WHERE pchembl_value > 10
  AND standard_value IS NOT NULL
  AND molregno IN (
      SELECT molregno
      FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
      WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
  )
GROUP BY assay_id, standard_type
HAVING n_activities < 5
LIMIT 20;
