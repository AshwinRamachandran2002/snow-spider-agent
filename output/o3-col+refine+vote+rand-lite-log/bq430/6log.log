Query:
--Description: 9) Build activity pairs after fixing STRING→INT64 for molregno join.  (No change
--              needed for activity_id types because all come from activities_30 which is INT64.)
WITH base AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    CAST(a.standard_value AS FLOAT64) AS std_val,
    a.standard_relation,
    a.standard_type,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS a
  JOIN (
    SELECT
      CAST(molregno AS INT64) AS molregno,
      heavy_atoms
    FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
  ) AS cp
  ON a.molregno = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value IS NOT NULL
    AND a.pchembl_value  > 10
    AND a.potential_duplicate < 2
), small AS (
  SELECT assay_id, standard_type
  FROM base
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
), filt AS (
  SELECT b.*
  FROM base AS b
  JOIN small AS s
    ON b.assay_id      = s.assay_id
   AND b.standard_type = s.standard_type
)
SELECT
  f1.activity_id AS act_id_1,
  f2.activity_id AS act_id_2,
  f1.assay_id,
  f1.standard_type,
  f1.std_val     AS value_1,
  f2.std_val     AS value_2,
  CASE
    WHEN f1.std_val < f2.std_val THEN 'increase'
    WHEN f1.std_val > f2.std_val THEN 'decrease'
    ELSE 'no-change'
  END AS change_class,
  GREATEST(f1.heavy_atoms, f2.heavy_atoms) AS max_heavy_atoms
FROM filt AS f1
JOIN filt AS f2
  ON f1.assay_id      = f2.assay_id
 AND f1.standard_type = f2.standard_type
 AND f1.activity_id  < f2.activity_id   -- avoid duplicates/self-join
 AND f1.molregno     <> f2.molregno
LIMIT 20
