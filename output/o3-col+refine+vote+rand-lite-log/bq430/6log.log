```sql
--Description: 4) Count rows per (assay_id, standard_type) after applying heavy-atom (10-15),
--              pChEMBL > 10 and non-null standard_value filters. 
--              Fix: use a JOIN instead of IN so the STRING molregno from compound_properties_29
--              is CAST to INT64 before joining to activities_30.
SELECT
  act.assay_id,
  act.standard_type,
  COUNT(*) AS n_activities
FROM `bigquery-public-data.ebi_chembl.activities_30` AS act
JOIN (
  SELECT CAST(molregno AS INT64) AS molregno
  FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
  WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
) AS hvy
USING (molregno)
WHERE act.pchembl_value > 10
  AND act.standard_value IS NOT NULL
GROUP BY act.assay_id, act.standard_type
HAVING n_activities < 5
LIMIT 20;
```

```sql
--Description: 5) Pick one small assay (≤ 4 rows meeting the filters) and list all of its activities,
--              including potential_duplicate flag. Same JOIN fix as above.
WITH small_assay AS (
  SELECT assay_id
  FROM (
    SELECT
      act.assay_id,
      act.standard_type,
      COUNT(*) AS cnt
    FROM `bigquery-public-data.ebi_chembl.activities_30` AS act
    JOIN (
      SELECT CAST(molregno AS INT64) AS molregno
      FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
      WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
    ) AS hvy
    USING (molregno)
    WHERE act.pchembl_value > 10
      AND act.standard_value IS NOT NULL
    GROUP BY act.assay_id, act.standard_type
    HAVING cnt < 5
    LIMIT 1
  )
)
SELECT
  activity_id,
  assay_id,
  molregno,
  standard_relation,
  standard_value,
  standard_type,
  potential_duplicate
FROM `bigquery-public-data.ebi_chembl.activities_30`
WHERE assay_id = (SELECT assay_id FROM small_assay)
LIMIT 20;
```

```sql
--Description: 6) Find the document IDs for a handful of qualifying activity rows by joining the generic
