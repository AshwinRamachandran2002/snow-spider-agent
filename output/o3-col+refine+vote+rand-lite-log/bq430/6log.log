--Description: 10) Generate UUIDs for a chosen pair; fix molregno join by casting STRING molregno in
--              compound_structures_29 to INT64 to match activities_30.molregno (INT64).
WITH chosen_pair AS (
  SELECT 586440 AS act_id_1, 566679 AS act_id_2   -- example IDs from query 5/9
)
SELECT
  p.act_id_1,
  p.act_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(p.act_id_1, p.act_id_2)))) AS mmp_delta_uuid_act,
  cs1.canonical_smiles AS smiles_1,
  cs2.canonical_smiles AS smiles_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(cs1.canonical_smiles, cs2.canonical_smiles))))
      AS mmp_delta_uuid_smiles
FROM chosen_pair AS p
JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a1
  ON a1.activity_id = p.act_id_1
JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a2
  ON a2.activity_id = p.act_id_2
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs1
  ON CAST(cs1.molregno AS INT64) = a1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs2
  ON CAST(cs2.molregno AS INT64) = a2.molregno
LIMIT 20;
```
