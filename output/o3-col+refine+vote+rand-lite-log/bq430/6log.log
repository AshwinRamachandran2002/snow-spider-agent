```sql
--Description: 5)  Pick one such small assay (<=4 rows) and list all its activities to see possible molecule
--                pairs as well as the potential_duplicate flag.
SELECT
  activity_id,
  assay_id,
  molregno,
  standard_relation,
  standard_value,
  standard_type,
  potential_duplicate
FROM `bigquery-public-data.ebi_chembl.activities_30`
WHERE assay_id = (
    SELECT assay_id
    FROM (
        SELECT assay_id, standard_type, COUNT(*) AS cnt
        FROM `bigquery-public-data.ebi_chembl.activities_30`
        WHERE pchembl_value > 10
          AND standard_value IS NOT NULL
          AND molregno IN (
              SELECT molregno
              FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
              WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
          )
        GROUP BY assay_id, standard_type
        HAVING cnt < 5
        LIMIT 1
    )
)
LIMIT 20;
```

```sql
--Description: 6)  For those activities, fetch the document ID that generated them.  The activities table
--                itself does not hold a doc_id, so we probe the generic `activities` mirror to locate it.
--                (Some rows overlap by `activity_id`.)
SELECT
  a30.activity_id,
  a.activity_id AS activity_id_in_generic,
  a.assay_id,
  a.doc_id
FROM `bigquery-public-data.ebi_chembl.activities_30`  AS a30
JOIN `bigquery-public-data.ebi_chembl.activities`     AS a
USING (activity_id)
WHERE a30.activity_id IN (
    SELECT activity_id
    FROM `bigquery-public-data.ebi_chembl.activities_30`
    WHERE pchembl_value > 10
      AND standard_value IS NOT NULL
      AND molregno IN (
          SELECT molregno
          FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
          WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
      )
    LIMIT 20
)
LIMIT 20;
```

```sql
--Description: 7)  Look up the publication metadata (journal, year, first_page) for those document IDs in
--                the integer-typed `docs_30` table, so that we can later synthesise the date.
SELECT
  d.doc_id,
  d.journal,
  d.year,
  d.first_page
FROM `bigquery-public-data.ebi_chembl.docs_30` AS d
WHERE d.doc_id IN (
    SELECT DISTINCT CAST(doc_id AS INT64)
    FROM `bigquery-public-data.ebi_chembl.activities`
    WHERE activity_id IN (
        SELECT activity_id
        FROM `bigquery-public-data.ebi_chembl.activities_30`
        WHERE pchembl_value > 10
          AND standard_value IS NOT NULL
          AND molregno IN (
              SELECT molregno
              FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
              WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
          )
        LIMIT 100
    )
)
LIMIT 20;
```

```sql
--Description: 8)  Compute the percent-rank within each (journal, year) group for documents so we can later
--                turn that into synthetic month/day.  This shows the window logic works.
SELECT
  doc_id,
  journal,
  year,
  first_page,
  PERCENT_RANK() OVER (
      PARTITION BY journal, year
      ORDER BY SAFE_CAST(first_page AS INT64)
  ) AS pct_rank
FROM `bigquery-public-data.ebi_chembl.docs_30`
WHERE journal IS NOT NULL
  AND year IS NOT NULL
  AND first_page IS NOT NULL
LIMIT 20;
```

```sql
--Description: 9)  Bring everything together: two different activities from the same (assay_id,
--                standard_type), meeting all numerical criteria, heavy-atom rule, duplicate filter,
--                and show the “classification” of change based on standard_value ordering.
--                (Result limited to 20 pairs.)
WITH base AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    CAST(a.standard_value AS FLOAT64) AS std_val,
    a.standard_relation,
    a.standard_type,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS cp
    ON a.molregno = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value IS NOT NULL
    AND a.pchembl_value > 10
    AND a.potential_duplicate < 2
),
small_assays AS (
  SELECT assay_id, standard_type
  FROM base
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT b.*
  FROM base AS b
  JOIN small_assays AS s
    ON b.assay_id = s.assay_id
   AND b.standard_type = s.standard_type
),
pairs AS (
  SELECT
    f1.activity_id  AS act_id_1,
    f2.activity_id  AS act_id_2,
    f1.assay_id,
    f1.standard_type,
    f1.std_val      AS value_1,
    f2.std_val      AS value_2,
    CASE
      WHEN f1.std_val < f2.std_val THEN 'increase'
      WHEN f1.std_val > f2.std_val THEN 'decrease'
      ELSE 'no-change'
    END AS change_class,
    GREATEST(f1.heavy_atoms, f2.heavy_atoms) AS max_heavy_atoms
  FROM filtered AS f1
  JOIN filtered AS f2
    ON f1.assay_id = f2.assay_id
   AND f1.standard_type = f2.standard_type
   AND f1.activity_id < f2.activity_id            -- different molecules/pair ordering
   AND f1.molregno  <> f2.molregno
)
SELECT * FROM pairs
LIMIT 20;
```

```sql
--Description: 10)  For one of the returned pairs, generate the UUIDs requested from activity IDs and from
--                 canonical SMILES, using the MD5-over-JSON recipe.
SELECT
  act_id_1,
  act_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(act_id_1, act_id_2))))              AS mmp_delta_uuid_act,
  cs1.canonical_smiles  AS smiles_1,
  cs2.canonical_smiles  AS smiles_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(cs1.canonical_smiles,
                                    cs2.canonical_smiles))))           AS mmp_delta_uuid_smiles
FROM (
  SELECT *
  FROM UNNEST([
      STRUCT('123456' AS act_id_1, '123457' AS act_id_2)   -- replace with real IDs from query 9
  ])
) AS p
JOIN `bigquery-public-data.ebi_chembl.activities_30`          AS a1 ON a1.activity_id = p.act_id_1
JOIN `bigquery-public-data.ebi_chembl.activities_30`          AS a2 ON a2.activity_id = p.act_id_2
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs1 ON cs1.molregno = a1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs2 ON cs2.molregno = a2.molregno
LIMIT 20;
```
