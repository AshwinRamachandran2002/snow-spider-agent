```sql
--Description: 7) Fetch publication metadata (journal, year, first_page) for those doc_ids (STRING)
--              that also exist in docs_29 (string ids) and docs_30 (int ids).  First cast to INT64
--              only where possible.
SELECT
  d.doc_id,
  d.journal,
  d.year,
  d.first_page
FROM `bigquery-public-data.ebi_chembl.docs_29` AS d
WHERE d.doc_id IN (
    SELECT DISTINCT ag.doc_id
    FROM (
      SELECT a30.activity_id
      FROM `bigquery-public-data.ebi_chembl.activities_30` AS a30
      JOIN (
        SELECT CAST(molregno AS INT64) AS molregno
        FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
        WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
      ) AS hvy
      USING (molregno)
      WHERE a30.pchembl_value > 10
        AND a30.standard_value IS NOT NULL
      LIMIT 100
    ) AS q
    JOIN `bigquery-public-data.ebi_chembl.activities` AS ag
    USING (activity_id)
)
LIMIT 20;
