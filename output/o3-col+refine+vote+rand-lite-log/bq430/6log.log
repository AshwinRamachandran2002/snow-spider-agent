```sql
--Description: 9) Final pair-building query rewritten to CAST cp.molregno (STRING) to INT64 when joining
--              to activities_30, preventing type mismatch.
WITH base AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    CAST(a.standard_value AS FLOAT64) AS std_val,
    a.standard_relation,
    a.standard_type,
    CAST(cp.heavy_atoms AS INT64) AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_30`          AS a
  JOIN (
    SELECT CAST(molregno AS INT64) AS molregno,
           heavy_atoms
    FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
  ) AS cp
    ON a.molregno = cp.molregno
  WHERE CAST(cp.heavy_atoms AS INT64) BETWEEN 10 AND 15
    AND a.standard_value IS NOT NULL
    AND a.pchembl_value > 10
    AND a.potential_duplicate < 2
),
small_assays AS (
  SELECT assay_id, standard_type
  FROM base
  GROUP BY assay_id, standard_type
  HAVING COUNT(*) < 5
),
filtered AS (
  SELECT b.*
  FROM base AS b
  JOIN small_assays AS s
    ON b.assay_id      = s.assay_id
   AND b.standard_type = s.standard_type
),
pairs AS (
  SELECT
    f1.activity_id AS act_id_1,
    f2.activity_id AS act_id_2,
    f1.assay_id,
    f1.standard_type,
    f1.std_val     AS value_1,
    f2.std_val     AS value_2,
    CASE
      WHEN f1.std_val < f2.std_val THEN 'increase'
      WHEN f1.std_val > f2.std_val THEN 'decrease'
      ELSE 'no-change'
    END AS change_class,
    GREATEST(f1.heavy_atoms, f2.heavy_atoms) AS max_heavy_atoms
  FROM filtered AS f1
  JOIN filtered AS f2
    ON f1.assay_id      = f2.assay_id
   AND f1.standard_type = f2.standard_type
   AND f1.activity_id  < f2.activity_id
   AND f1.molregno     <> f2.molregno
)
SELECT * FROM pairs
LIMIT 20;
```

```sql
--Description: 10) Generate UUIDs for one returned pair; molregno join now uses CAST on cp table
--              to avoid STRING vs INT64 issues.
WITH chosen_pair AS (
  SELECT act_id_1, act_id_2
  FROM (
    SELECT * FROM UNNEST([
      STRUCT(<ACT1> AS act_id_1, <ACT2> AS act_id_2)  -- Replace with real IDs from query 9
    ])
  )
)
SELECT
  p.act_id_1,
  p.act_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(p.act_id_1, p.act_id_2)))) AS mmp_delta_uuid_act,
  cs1.canonical_smiles AS smiles_1,
  cs2.canonical_smiles AS smiles_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(cs1.canonical_smiles, cs2.canonical_smiles))))
      AS mmp_delta_uuid_smiles
FROM chosen_pair AS p
JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a1 ON a1.activity_id = p.act_id_1
JOIN `bigquery-public-data.ebi_chembl.activities_30` AS a2 ON a2.activity_id = p.act_id_2
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs1
     ON cs1.molregno = a1.molregno
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS cs2
     ON cs2.molregno = a2.molregno
LIMIT 20;
```
