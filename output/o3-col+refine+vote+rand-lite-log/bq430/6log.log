```sql
--Description:  We need to fetch the document IDs linked to a handful of qualifying activities.
--              Challenge: activities_30.activity_id is INT64, while activities.activity_id is STRING.
--              Plan:
--              1)  Produce a small (≤20) sample list of INT64 activity_id values that pass
--                  all criteria (compound heavy atoms 10–15, pChEMBL > 10, non-null standard_value).
--                  This uses an INNER JOIN that casts compound_properties_29.molregno (STRING) to INT64.
--              2)  LEFT JOIN activities_30 with the generic activities table, casting the STRING
--                  activities.activity_id to INT64 so the join keys align.
--              3)  Return the activity_id, assay_id, and associated doc_id.
WITH sample_ids AS (
  SELECT act.activity_id
  FROM `bigquery-public-data.ebi_chembl.activities_30` AS act
  JOIN (
    SELECT CAST(molregno AS INT64) AS molregno
    FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
    WHERE CAST(heavy_atoms AS INT64) BETWEEN 10 AND 15
  ) AS hvy
  USING (molregno)
  WHERE act.pchembl_value > 10
    AND act.standard_value IS NOT NULL
  LIMIT 20
)
SELECT
  a30.activity_id,
  a30.assay_id,
  ag.doc_id
FROM `bigquery-public-data.ebi_chembl.activities_30` AS a30
LEFT JOIN `bigquery-public-data.ebi_chembl.activities` AS ag
  ON SAFE_CAST(ag.activity_id AS INT64) = a30.activity_id
WHERE a30.activity_id IN (SELECT activity_id FROM sample_ids)
LIMIT 20;
