```sql
--Description: Generate UUIDs for each valid molecule-pair (same assay & standard
--             type, different molregno) together with the maximum heavy-atom
--             count across the pair.  The filtered set obeys every quality rule
--             (10–15 heavy atoms, pChEMBL > 10, non-null standard_value,
--             potential_duplicate < 2).  Column lists are kept minimal so no
--             ambiguity arises in the self-join.
WITH filt AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    CAST(p.heavy_atoms AS INT64) AS heavy_atoms,
    s.canonical_smiles
  FROM `bigquery-public-data.ebi_chembl.activities_29`  AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
    ON a.molregno = p.molregno
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS s
    ON a.molregno = s.molregno
  WHERE CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15         -- heavy atoms 10-15
    AND SAFE_CAST(a.pchembl_value AS FLOAT64) > 10             -- pChEMBL > 10
    AND a.standard_value IS NOT NULL                           -- non-null value
    AND SAFE_CAST(a.potential_duplicate AS INT64) < 2          -- <2 duplicates
)
SELECT
  f1.activity_id                                                        AS act_id_1,
  f2.activity_id                                                        AS act_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(f1.activity_id, f2.activity_id))))   AS uuid_by_act,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(f1.canonical_smiles, f2.canonical_smiles))))
                                                                         AS uuid_by_smiles,
  GREATEST(f1.heavy_atoms, f2.heavy_atoms)                               AS max_heavy_atoms
FROM filt AS f1
JOIN filt AS f2
  ON  f1.assay_id      = f2.assay_id
  AND f1.standard_type = f2.standard_type
  AND f1.molregno      <> f2.molregno
LIMIT 20;
