Query:
--Description: 3) Sample activities (activities_29) that have a numeric
--             pChEMBL value (castable to FLOAT64) over 10 and non-null
--             standard_value.
SELECT
  `activity_id`,
  `assay_id`,
  `molregno`,
  `standard_type`,
  `standard_relation`,
  CAST(`standard_value` AS FLOAT64) AS standard_value,
  CAST(`pchembl_value` AS FLOAT64)  AS pchembl_val
FROM `bigquery-public-data.ebi_chembl.activities_29`
