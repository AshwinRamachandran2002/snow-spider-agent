--Description: 
-- Build a filtered activity list that meets every requirement from the task:
--   • compound has 10–15 heavy atoms
--   • pChEMBL value > 10
--   • non-null standard_value
--   • potential_duplicate < 2
-- We join activities_29 to compound_properties_29 for heavy_atoms (numeric) and
-- keep only the minimal columns we need so column names are unique (prevents the
-- “ambiguous name” error we hit before).  
-- Next we self-join this filtered set on (assay_id, standard_type) while
-- insisting the two rows come from different molecules (molregno ≠).  
-- Finally we classify how the standard_value changes between the two molecules
-- (‘increase’, ‘decrease’, ‘no-change’) exactly as specified.
-- Only 20 sample rows are returned.
WITH filt AS (
  SELECT
    a.activity_id,
    a.assay_id,
    a.molregno,
    a.standard_type,
    a.standard_relation,
    CAST(a.standard_value AS FLOAT64) AS val
  FROM `bigquery-public-data.ebi_chembl.activities_29` AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
    ON a.molregno = p.molregno
  WHERE CAST(p.heavy_atoms AS INT64) BETWEEN 10 AND 15           -- heavy atoms 10-15
    AND SAFE_CAST(a.pchembl_value AS FLOAT64) > 10               -- pChEMBL > 10
    AND a.standard_value IS NOT NULL                            -- non-null standard_value
    AND SAFE_CAST(a.potential_duplicate AS INT64) < 2           -- <2 duplicates
)
SELECT
  f1.activity_id                    AS act1,
  f2.activity_id                    AS act2,
  f1.val                            AS v1,
  f2.val                            AS v2,
  CASE
    WHEN f1.val = f2.val AND f1.standard_relation = '=' AND f2.standard_relation = '='
      THEN 'no-change'
    WHEN f1.val > f2.val THEN 'decrease'
    WHEN f1.val < f2.val THEN 'increase'
    ELSE 'unclear'
  END AS delta_class
FROM filt AS f1
JOIN filt AS f2
  ON  f1.assay_id      = f2.assay_id
  AND f1.standard_type = f2.standard_type
  AND f1.molregno      <> f2.molregno
LIMIT 20;
