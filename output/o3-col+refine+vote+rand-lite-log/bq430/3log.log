Query:
--Description: 2) Inspect a handful of compounds that have between 10-15 heavy
--             atoms and collect their molregno and canonical SMILES.
SELECT
  p.`molregno`,
  p.`heavy_atoms`,
  s.`canonical_smiles`
FROM `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS s
ON p.`molregno` = s.`molregno`
WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
LIMIT 20;
