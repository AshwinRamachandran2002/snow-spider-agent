Query:
--Description: 1) Look at the heavy-atom distribution for compounds that exist
--             in the compound_properties_29 table.
SELECT DISTINCT
  CAST(`heavy_atoms` AS INT64) AS heavy_atoms,
  COUNT(*) AS n_compounds
FROM `bigquery-public-data.ebi_chembl.compound_properties_29`
GROUP BY heavy_atoms
ORDER BY heavy_atoms
LIMIT 20;
