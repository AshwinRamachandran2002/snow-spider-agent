```sql
--Description: 3) Sample activities (activities_29) that have a numeric
--             pChEMBL value (castable to FLOAT64) over 10 and non-null
--             standard_value.
SELECT
  `activity_id`,
  `assay_id`,
  `molregno`,
  `standard_type`,
  `standard_relation`,
  CAST(`standard_value` AS FLOAT64) AS standard_value,
  CAST(`pchembl_value` AS FLOAT64)  AS pchembl_val
FROM `bigquery-public-data.ebi_chembl.activities_29`
WHERE SAFE_CAST(`pchembl_value` AS FLOAT64) > 10
  AND `standard_value` IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Join the <10-15 heavy-atom> compounds with the activities_29
--             table and keep only those with pChEMBL > 10.
SELECT
  a.`activity_id`,
  a.`assay_id`,
  a.`molregno`,
  a.`standard_type`,
  a.`standard_relation`,
  CAST(a.`standard_value` AS FLOAT64) AS standard_value,
  CAST(a.`pchembl_value` AS FLOAT64)  AS pchembl_val,
  CAST(p.`heavy_atoms` AS INT64)      AS heavy_atoms
FROM `bigquery-public-data.ebi_chembl.activities_29`  AS a
JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
ON a.`molregno` = p.`molregno`
WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
  AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
  AND a.`standard_value` IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5) For every assay & standard_type combination, count how many
--             qualifying activities we have (should be <5 according to
--             the problem statement).
WITH qual AS (
  SELECT
    `assay_id`,
    `standard_type`,
    `activity_id`
  FROM `bigquery-public-data.ebi_chembl.activities_29`
  WHERE SAFE_CAST(`pchembl_value` AS FLOAT64) > 10
    AND `standard_value` IS NOT NULL
)
SELECT
  `assay_id`,
  `standard_type`,
  COUNT(DISTINCT `activity_id`) AS n_acts
FROM qual
GROUP BY assay_id, standard_type
HAVING n_acts < 5
LIMIT 20;
```

```sql
--Description: 6) Add the duplicate check (potential_duplicate < 2) and bring
--             in heavy-atom filter at the same time.
WITH base AS (
  SELECT
    a.`activity_id`,
    a.`assay_id`,
    a.`molregno`,
    a.`standard_type`,
    a.`standard_relation`,
    CAST(a.`standard_value` AS FLOAT64) AS standard_value,
    CAST(a.`pchembl_value` AS FLOAT64)  AS pchembl_val,
    CAST(p.`heavy_atoms`  AS INT64)     AS heavy_atoms
  FROM `bigquery-public-data.ebi_chembl.activities_29`  AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
  ON a.`molregno` = p.`molregno`
  WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
    AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
    AND a.`standard_value` IS NOT NULL
    AND SAFE_CAST(a.`potential_duplicate` AS INT64) < 2
)
SELECT *
FROM base
LIMIT 20;
```

```sql
--Description: 7) Identify assays/standard_type that still satisfy the
--             “<5 activities” rule after all filters.
WITH base AS (
  SELECT
    a.`activity_id`,
    a.`assay_id`,
    a.`molregno`,
    a.`standard_type`
  FROM `bigquery-public-data.ebi_chembl.activities_29`  AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
  ON a.`molregno` = p.`molregno`
  WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
    AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
    AND a.`standard_value` IS NOT NULL
    AND SAFE_CAST(a.`potential_duplicate` AS INT64) < 2
)
SELECT
  `assay_id`,
  `standard_type`,
  COUNT(DISTINCT `activity_id`) n_ok
FROM base
GROUP BY assay_id, standard_type
HAVING n_ok < 5
LIMIT 20;
```

```sql
--Description: 8) Produce all ordered pairs of DIFFERENT molecules within the
--             same (assay_id, standard_type) that satisfy the filter.
WITH filt AS (
  SELECT
    a.`activity_id`,
    a.`assay_id`,
    a.`molregno`,
    a.`standard_type`,
    a.`standard_relation`,
    CAST(a.`standard_value` AS FLOAT64) AS val,
    CAST(p.`heavy_atoms`  AS INT64)     AS heavy_atoms,
    s.`canonical_smiles`
  FROM `bigquery-public-data.ebi_chembl.activities_29`  AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
       ON a.`molregno` = p.`molregno`
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS s
       ON a.`molregno` = s.`molregno`
  WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
    AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
    AND a.`standard_value` IS NOT NULL
    AND SAFE_CAST(a.`potential_duplicate` AS INT64) < 2
)
SELECT
  f1.`activity_id` AS act1,
  f2.`activity_id` AS act2,
  f1.`assay_id`,
  f1.`standard_type`,
  f1.`val` AS val1,
  f2.`val` AS val2,
  f1.`canonical_smiles` AS smi1,
  f2.`canonical_smiles` AS smi2
FROM filt AS f1
JOIN filt AS f2
  ON f1.`assay_id`      = f2.`assay_id`
 AND f1.`standard_type` = f2.`standard_type`
 AND f1.`molregno`      <> f2.`molregno`
LIMIT 20;
```

```sql
--Description: 9) Classify the change ('increase', 'decrease', 'no-change')
--             between the paired standard values.
WITH pairs AS (
  -- reuse query (8) above but shorten
  SELECT
    f1.`activity_id` act1,
    f2.`activity_id` act2,
    f1.`val`  AS v1,
    f2.`val`  AS v2,
    f1.`standard_relation` AS r1,
    f2.`standard_relation` AS r2
  FROM (
    SELECT *
    FROM `bigquery-public-data.ebi_chembl.activities_29` AS a
    JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
      ON a.`molregno` = p.`molregno`
    WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
      AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
      AND a.`standard_value` IS NOT NULL
      AND SAFE_CAST(a.`potential_duplicate` AS INT64) < 2
  ) AS f1
  JOIN (
    SELECT *
    FROM `bigquery-public-data.ebi_chembl.activities_29` AS a
    JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
      ON a.`molregno` = p.`molregno`
    WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
      AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
      AND a.`standard_value` IS NOT NULL
      AND SAFE_CAST(a.`potential_duplicate` AS INT64) < 2
  ) AS f2
  ON f1.`assay_id` = f2.`assay_id`
 AND f1.`standard_type` = f2.`standard_type`
 AND f1.`molregno` <> f2.`molregno`
)
SELECT
  act1,
  act2,
  v1,
  v2,
  CASE
    WHEN v1 = v2 AND r1 = '=' AND r2 = '=' THEN 'no-change'
    WHEN v1  > v2                              THEN 'decrease'
    WHEN v1  < v2                              THEN 'increase'
    ELSE 'unclear'
  END AS delta_class
FROM pairs
LIMIT 20;
```

```sql
--Description: 10) Generate the UUIDs for each paired activity_id and canonical
--              SMILES; also show the maximum heavy-atom count in the pair.
WITH filt AS (
  SELECT
    a.`activity_id`,
    a.`assay_id`,
    a.`molregno`,
    a.`standard_type`,
    CAST(p.`heavy_atoms` AS INT64) AS heavy_atoms,
    s.`canonical_smiles`
  FROM `bigquery-public-data.ebi_chembl.activities_29`  AS a
  JOIN `bigquery-public-data.ebi_chembl.compound_properties_29` AS p
       ON a.`molregno` = p.`molregno`
  JOIN `bigquery-public-data.ebi_chembl.compound_structures_29` AS s
       ON a.`molregno` = s.`molregno`
  WHERE CAST(p.`heavy_atoms` AS INT64) BETWEEN 10 AND 15
    AND SAFE_CAST(a.`pchembl_value` AS FLOAT64) > 10
    AND a.`standard_value` IS NOT NULL
    AND SAFE_CAST(a.`potential_duplicate` AS INT64) < 2
)
SELECT
  f1.`activity_id` AS act_id_1,
  f2.`activity_id` AS act_id_2,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(f1.`activity_id`, f2.`activity_id`))))   AS uuid_by_act,
  TO_HEX(MD5(TO_JSON_STRING(STRUCT(f1.`canonical_smiles`, f2.`canonical_smiles`)))) AS uuid_by_smiles,
  GREATEST(f1.`heavy_atoms`, f2.`heavy_atoms`) AS max_heavy_atoms
FROM filt AS f1
JOIN filt AS f2
  ON f1.`assay_id` = f2.`assay_id`
 AND f1.`standard_type` = f2.`standard_type`
 AND f1.`molregno` <> f2.`molregno`
LIMIT 20;
```
