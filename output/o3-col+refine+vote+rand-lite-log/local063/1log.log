```sql
-- 1.  Look-up the United States in “countries” to obtain its country_id
SELECT DISTINCT country_name, country_id
FROM   countries
WHERE  country_name LIKE '%United States%'
LIMIT 20;
```

```sql
-- 2.  Check the calendar-quarter codes we are interested in (Q4-2019 & Q4-2020)
SELECT DISTINCT calendar_quarter_desc,
                calendar_quarter_id,
                calendar_year
FROM   times
WHERE  calendar_year IN (2019, 2020)
  AND  calendar_month_number BETWEEN 10 AND 12          -- Q4 months
ORDER  BY calendar_quarter_id
LIMIT 20;
```

```sql
-- 3.  Sample U.S. customers to verify the link between customers and countries
SELECT DISTINCT cust_id,
                cust_city,
                country_id
FROM   customers
WHERE  country_id = (SELECT country_id
                     FROM   countries
                     WHERE  country_name LIKE '%United States%'
                     LIMIT 1)
LIMIT 20;
```

```sql
-- 4.  City-level sales in Q4-2019 with promo_id = 999 (U.S. only)
SELECT   c.cust_city                AS city,
         SUM(s.amount_sold)         AS sales_q4_2019
FROM     sales      AS s
JOIN     customers  AS c ON s.cust_id = c.cust_id
JOIN     times      AS t ON s.time_id = t.time_id
WHERE    c.country_id = (SELECT country_id
                         FROM   countries
                         WHERE  country_name LIKE '%United States%'
                         LIMIT 1)
  AND    s.promo_id  = 999
  AND    t.calendar_quarter_id = 1772                  -- Q4-2019
GROUP BY c.cust_city
LIMIT 20;
```

```sql
-- 5.  City-level sales in Q4-2020 with promo_id = 999 (U.S. only)
SELECT   c.cust_city                AS city,
         SUM(s.amount_sold)         AS sales_q4_2020
FROM     sales      AS s
JOIN     customers  AS c ON s.cust_id = c.cust_id
JOIN     times      AS t ON s.time_id = t.time_id
WHERE    c.country_id = (SELECT country_id
                         FROM   countries
                         WHERE  country_name LIKE '%United States%'
                         LIMIT 1)
  AND    s.promo_id  = 999
  AND    t.calendar_quarter_id = 1776                  -- Q4-2020
GROUP BY c.cust_city
LIMIT 20;
```

```sql
-- 6.  Cities whose promo-999 sales grew by at least 20 %
SELECT   a.city,
         a.sales_q4_2019,
         b.sales_q4_2020,
         ROUND( (b.sales_q4_2020 - a.sales_q4_2019)*1.0 / a.sales_q4_2019 , 3) AS growth_rate
FROM    (SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_q4_2019
         FROM   sales s
         JOIN   customers c ON s.cust_id = c.cust_id
         JOIN   times     t ON s.time_id = t.time_id
         WHERE  c.country_id = (SELECT country_id
                                 FROM   countries
                                 WHERE  country_name LIKE '%United States%'
                                 LIMIT 1)
           AND  s.promo_id  = 999
           AND  t.calendar_quarter_id = 1772
         GROUP  BY c.cust_city)  AS a
JOIN    (SELECT c.cust_city AS city, SUM(s.amount_sold) AS sales_q4_2020
         FROM   sales s
         JOIN   customers c ON s.cust_id = c.cust_id
         JOIN   times     t ON s.time_id = t.time_id
         WHERE  c.country_id = (SELECT country_id
                                 FROM   countries
                                 WHERE  country_name LIKE '%United States%'
                                 LIMIT 1)
           AND  s.promo_id  = 999
           AND  t.calendar_quarter_id = 1776
         GROUP  BY c.cust_city)  AS b
ON      a.city = b.city
WHERE   b.sales_q4_2020 >= 1.2 * a.sales_q4_2019
LIMIT 20;
```

```sql
-- 7.  Product-level totals in Q4-2019 for the “qualifying” growth cities
WITH growth_cities AS (
       SELECT a.city
       FROM   ( /* same subquery as step 6 */ ) a
       JOIN   ( /* same subquery as step 6 */ ) b
       ON     a.city = b.city
       WHERE  b.sales_q4_2020 >= 1.2 * a.sales_q4_2019
)
SELECT   s.prod_id,
         SUM(s.amount_sold) AS prod_sales_q4_2019
FROM     sales      AS s
JOIN     customers  AS c ON s.cust_id = c.cust_id
JOIN     times      AS t ON s.time_id = t.time_id
JOIN     growth_cities g ON g.city = c.cust_city
WHERE    s.promo_id = 999
  AND    t.calendar_quarter_id = 1772
GROUP BY s.prod_id
ORDER BY prod_sales_q4_2019 DESC
LIMIT 20;
```

```sql
-- 8.  Product-level totals in Q4-2020 for the same cities
WITH growth_cities AS (
       SELECT a.city
       FROM   ( /* subquery as step 6 */ ) a
       JOIN   ( /* subquery as step 6 */ ) b
       ON     a.city = b.city
       WHERE  b.sales_q4_2020 >= 1.2 * a.sales_q4_2019
)
SELECT   s.prod_id,
         SUM(s.amount_sold) AS prod_sales_q4_2020
FROM     sales      AS s
JOIN     customers  AS c ON s.cust_id = c.cust_id
JOIN     times      AS t ON s.time_id = t.time_id
JOIN     growth_cities g ON g.city = c.cust_city
WHERE    s.promo_id = 999
  AND    t.calendar_quarter_id = 1776
GROUP BY s.prod_id
ORDER BY prod_sales_q4_2020 DESC
LIMIT 20;
```

```sql
-- 9.  Compute each product’s share (%) of total promo-999 sales in both quarters
WITH growth_cities AS ( /* same definition as above */ ),
     q4_2019 AS (
       SELECT s.prod_id, SUM(s.amount_sold) AS amt_2019
       FROM   sales s
       JOIN   customers c ON s.cust_id = c.cust_id
       JOIN   times     t ON s.time_id = t.time_id
       JOIN   growth_cities g ON g.city = c.cust_city
       WHERE  s.promo_id = 999
         AND  t.calendar_quarter_id = 1772
       GROUP  BY s.prod_id ),
     q4_2020 AS (
       SELECT s.prod_id, SUM(s.amount_sold) AS amt_2020
       FROM   sales s
       JOIN   customers c ON s.cust_id = c.cust_id
       JOIN   times     t ON s.time_id = t.time_id
       JOIN   growth_cities g ON g.city = c.cust_city
       WHERE  s.promo_id = 999
         AND  t.calendar_quarter_id = 1776
       GROUP  BY s.prod_id ),
     totals AS (
       SELECT SUM(amt_2019) AS total_2019 FROM q4_2019
       UNION ALL
       SELECT SUM(amt_2020) FROM q4_2020 )
SELECT  q19.prod_id,
        q19.amt_2019,
        q20.amt_2020,
        ROUND( q19.amt_2019 * 100.0 / (SELECT total_2019 FROM totals LIMIT 1) , 2) AS share_2019_pct,
        ROUND( q20.amt_2020 * 100.0 / (SELECT total_2019 FROM totals LIMIT 1 OFFSET 1) , 2) AS share_2020_pct,
        ROUND( ( q20.amt_2020 * 100.0 / (SELECT total_2019 FROM totals LIMIT 1 OFFSET 1) )
             - ( q19.amt_2019 * 100.0 / (SELECT total_2019 FROM totals LIMIT 1) ), 2) AS pct_point_change
FROM    q4_2019 q19
JOIN    q4_2020 q20 USING (prod_id)
ORDER  BY ABS(pct_point_change) ASC
LIMIT 20;
```

```sql
-- 10.  Among the products in the top 20 % of total sales, return the one with the smallest share-change
WITH growth_cities AS ( /* same as before */ ),
     all_sales AS (
       SELECT s.prod_id,
              SUM( CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END ) AS amt_2019,
              SUM( CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END ) AS amt_2020
       FROM   sales s
       JOIN   customers c ON s.cust_id = c.cust_id
       JOIN   times     t ON s.time_id = t.time_id
       JOIN   growth_cities g ON g.city = c.cust_city
       WHERE  s.promo_id IN (999)
         AND  t.calendar_quarter_id IN (1772, 1776)
       GROUP  BY s.prod_id ),
     ranked AS (
       SELECT prod_id,
              (amt_2019 + amt_2020) AS total_amt,
              NTILE(5) OVER (ORDER BY (amt_2019 + amt_2020) DESC) AS quintile
       FROM   all_sales ),
     top20  AS (
       SELECT prod_id
       FROM   ranked
       WHERE  quintile = 1)                               -- top 20 %
SELECT  p.prod_id,
        p.prod_name,
        a.amt_2019,
        a.amt_2020,
        ROUND( a.amt_2019 * 100.0 / SUM(a.amt_2019) OVER (), 2 ) AS share_2019_pct,
        ROUND( a.amt_2020 * 100.0 / SUM(a.amt_2020) OVER (), 2 ) AS share_2020_pct,
        ROUND( (a.amt_2020 * 100.0 / SUM(a.amt_2020) OVER ())
             - (a.amt_2019 * 100.0 / SUM(a.amt_2019) OVER ()), 2) AS pct_point_change
FROM    all_sales a
JOIN    products  p ON p.prod_id = a.prod_id
WHERE   a.prod_id IN (SELECT prod_id FROM top20)
ORDER  BY ABS(pct_point_change) ASC
LIMIT 1;
```
