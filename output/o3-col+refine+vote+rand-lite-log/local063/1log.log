--Description:  #8 – Product-level totals in Q4-2020 (calendar_quarter_id 1776) for the
--U.S. cities whose promo-999 sales grew by ≥20 % from Q4-2019 to Q4-2020.
WITH
q4_2019 AS (                           -- city totals, Q4-2019
    SELECT c.cust_city AS city,
           SUM(s.amount_sold) AS amt_2019
    FROM   sales      s
    JOIN   customers  c ON s.cust_id = c.cust_id
    JOIN   times      t ON s.time_id = t.time_id
    WHERE  c.country_id = 52790                -- United States
      AND  s.promo_id  = 999
      AND  t.calendar_quarter_id = 1772        -- Q4-2019
    GROUP  BY c.cust_city
),
q4_2020 AS (                           -- city totals, Q4-2020
    SELECT c.cust_city AS city,
           SUM(s.amount_sold) AS amt_2020
    FROM   sales      s
    JOIN   customers  c ON s.cust_id = c.cust_id
    JOIN   times      t ON s.time_id = t.time_id
    WHERE  c.country_id = 52790
      AND  s.promo_id  = 999
      AND  t.calendar_quarter_id = 1776        -- Q4-2020
    GROUP  BY c.cust_city
),
growth_cities AS (                     -- cities with ≥20 % growth
    SELECT q4_2019.city
    FROM   q4_2019
    JOIN   q4_2020 USING (city)
    WHERE  q4_2020.amt_2020 >= 1.20 * q4_2019.amt_2019
)
SELECT s.prod_id,
       SUM(s.amount_sold) AS prod_sales_q4_2020
FROM   sales      s
JOIN   customers  c ON s.cust_id = c.cust_id
JOIN   times      t ON s.time_id = t.time_id
JOIN   growth_cities g ON g.city = c.cust_city
WHERE  s.promo_id = 999
  AND  t.calendar_quarter_id = 1776              -- Q4-2020
GROUP BY s.prod_id
ORDER BY prod_sales_q4_2020 DESC
LIMIT 20
