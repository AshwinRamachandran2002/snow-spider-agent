--Description:  #9 – For every product sold under promo-999 in the growth cities,
--compute its share (%) of total promo-999 sales in Q4-2019 and Q4-2020 and the
--percentage-point change between the two quarters.
WITH
q4_2019 AS (                           -- see previous block for definition details
    SELECT c.cust_city AS city,
           SUM(s.amount_sold) AS amt_2019
    FROM   sales s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times t      ON s.time_id = t.time_id
    WHERE  c.country_id = 52790
      AND  s.promo_id  = 999
      AND  t.calendar_quarter_id = 1772
    GROUP  BY c.cust_city
),
q4_2020 AS (
    SELECT c.cust_city AS city,
           SUM(s.amount_sold) AS amt_2020
    FROM   sales s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times t      ON s.time_id = t.time_id
    WHERE  c.country_id = 52790
      AND  s.promo_id  = 999
      AND  t.calendar_quarter_id = 1776
    GROUP  BY c.cust_city
),
growth_cities AS (
    SELECT q4_2019.city
    FROM   q4_2019
    JOIN   q4_2020 USING (city)
    WHERE  q4_2020.amt_2020 >= 1.20 * q4_2019.amt_2019
),
prod_qtr AS (                          -- product totals per quarter
    SELECT s.prod_id,
           t.calendar_quarter_id AS qid,
           SUM(s.amount_sold)    AS amt
    FROM   sales s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
      AND  c.country_id = 52790
      AND  c.cust_city IN (SELECT city FROM growth_cities)
    GROUP  BY s.prod_id, t.calendar_quarter_id
),
totals AS (                            -- quarter grand totals
    SELECT qid, SUM(amt) AS total_amt
    FROM   prod_qtr
    GROUP  BY qid
),
shares AS (                            -- sales & shares per product
    SELECT pq.prod_id,
           SUM(CASE WHEN qid = 1772 THEN amt END) AS amt_2019,
           SUM(CASE WHEN qid = 1776 THEN amt END) AS amt_2020,
           100.0 * SUM(CASE WHEN qid = 1772 THEN amt END) /
                   (SELECT total_amt FROM totals WHERE qid = 1772) AS share_2019_pct,
           100.0 * SUM(CASE WHEN qid = 1776 THEN amt END) /
                   (SELECT total_amt FROM totals WHERE qid = 1776) AS share_2020_pct,
           100.0 * SUM(CASE WHEN qid = 1776 THEN amt END) /
                   (SELECT total_amt FROM totals WHERE qid = 1776) -
           100.0 * SUM(CASE WHEN qid = 1772 THEN amt END) /
                   (SELECT total_amt FROM totals WHERE qid = 1772)   AS pct_point_change
    FROM   prod_qtr pq
    GROUP  BY pq.prod_id
)
SELECT *
FROM   shares
ORDER  BY ABS(pct_point_change) ASC
LIMIT 20
