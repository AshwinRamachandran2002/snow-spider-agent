```sql
--Description:  Find the U.S. product (promo_id = 999) that, among those in the
--top-20 % of combined Q4-2019 & Q4-2020 sales **and** sold only in cities whose
--promo-999 sales rose ≥20 %, shows the smallest percentage-point change in share
--of total promo-999 sales between the two quarters.

WITH
us_customers AS (        -- U.S. customers
    SELECT cust_id, cust_city
    FROM   customers
    WHERE  country_id = 52790                       -- United States
),
city_qtr AS (           -- City-level promo-999 sales for both quarters
    SELECT c.cust_city           AS city,
           t.calendar_quarter_id AS qid,
           SUM(s.amount_sold)    AS amt
    FROM   sales  s
    JOIN   us_customers c ON s.cust_id = c.cust_id
    JOIN   times t        ON s.time_id  = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)     -- Q4-2019 & Q4-2020
    GROUP  BY c.cust_city, t.calendar_quarter_id
),
growth_cities AS (      -- Cities whose 2020 ≥ 1.2 × 2019
    SELECT city
    FROM   city_qtr
    GROUP  BY city
    HAVING SUM(CASE WHEN qid = 1776 THEN amt END) >=
           1.20 * SUM(CASE WHEN qid = 1772 THEN amt END)
),
prod_qtr AS (           -- Product sales in those growth cities
    SELECT s.prod_id,
           t.calendar_quarter_id AS qid,
           SUM(s.amount_sold)    AS amt
    FROM   sales  s
    JOIN   customers c ON s.cust_id = c.cust_id
    JOIN   times     t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
      AND  c.country_id = 52790
      AND  c.cust_city IN (SELECT city FROM growth_cities)
    GROUP  BY s.prod_id, t.calendar_quarter_id
),
qtr_totals AS (         -- Total promo-999 sales per quarter (growth cities)
    SELECT qid, SUM(amt) AS total_amt
    FROM   prod_qtr
    GROUP  BY qid
),
prod_shares AS (        -- Each product’s sales & share in both quarters
    SELECT pq.prod_id,
           SUM(CASE WHEN qid = 1772 THEN amt END) AS amt_2019,
           SUM(CASE WHEN qid = 1776 THEN amt END) AS amt_2020,
           100.0 * SUM(CASE WHEN qid = 1772 THEN amt END) /
                   (SELECT total_amt FROM qtr_totals WHERE qid = 1772) AS share_2019,
           100.0 * SUM(CASE WHEN qid = 1776 THEN amt END) /
                   (SELECT total_amt FROM qtr_totals WHERE qid = 1776) AS share_2020
    FROM   prod_qtr pq
    GROUP  BY pq.prod_id
),
ranked AS (             -- Rank by combined sales; compute share change
    SELECT ps.*,
           (amt_2019 + amt_2020) AS total_amt,
           NTILE(5) OVER (ORDER BY (amt_2019 + amt_2020) DESC) AS quintile,
           share_2020 - share_2019 AS pct_point_change
    FROM   prod_shares ps
)
SELECT   r.prod_id,
         p.prod_name,
