Query:
--Description: For each U-S city, compare its total Q4-2019 vs Q4-2020 sales and compute % increase
WITH q19 AS (
      SELECT c.cust_city               AS city ,
             SUM(s.amount_sold)        AS sales_2019
      FROM   sales  s
      JOIN   customers c ON c.cust_id = s.cust_id
      JOIN   times t      ON t.time_id = s.time_id
      WHERE  c.country_id IN ( SELECT country_id
                                FROM countries
                                WHERE country_name LIKE 'United States%' )
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1772
      GROUP BY c.cust_city ),
q20 AS (
      SELECT c.cust_city               AS city ,
             SUM(s.amount_sold)        AS sales_2020
      FROM   sales  s
      JOIN   customers c ON c.cust_id = s.cust_id
      JOIN   times t      ON t.time_id = s.time_id
      WHERE  c.country_id IN ( SELECT country_id
                                FROM countries
                                WHERE country_name LIKE 'United States%' )
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1776
      GROUP BY c.cust_city )
SELECT q19.city ,
       q19.sales_2019 ,
       q20.sales_2020 ,
       ROUND( (q20.sales_2020 - q19.sales_2019)*1.0 / q19.sales_2019 , 3 ) AS pct_increase
FROM   q19
JOIN   q20 ON q20.city = q19.city
WHERE  q20.sales_2020 >= 1.2 * q19.sales_2019     -- ≥ 20 % growth
LIMIT 20;
