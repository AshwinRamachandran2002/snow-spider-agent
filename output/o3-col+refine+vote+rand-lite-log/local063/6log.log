```sql
--Description: Aggregate Q4-2019 sales (promo 999) by U-S city & product
SELECT   c.cust_city ,
         s.prod_id ,
         SUM(s.amount_sold) AS sales_2019
FROM     sales      AS s
JOIN     customers  AS c ON c.cust_id = s.cust_id
JOIN     times      AS t ON t.time_id = s.time_id
WHERE    c.country_id IN ( SELECT country_id
                            FROM countries
                            WHERE country_name LIKE 'United States%' )
  AND    s.promo_id = 999
  AND    t.calendar_quarter_id = 1772
GROUP BY c.cust_city , s.prod_id
LIMIT 20;
```

```sql
--Description: Aggregate Q4-2020 sales (promo 999) by U-S city & product
SELECT   c.cust_city ,
         s.prod_id ,
         SUM(s.amount_sold) AS sales_2020
FROM     sales      AS s
JOIN     customers  AS c ON c.cust_id = s.cust_id
JOIN     times      AS t ON t.time_id = s.time_id
WHERE    c.country_id IN ( SELECT country_id
                            FROM countries
                            WHERE country_name LIKE 'United States%' )
  AND    s.promo_id = 999
  AND    t.calendar_quarter_id = 1776
GROUP BY c.cust_city , s.prod_id
LIMIT 20;
```

```sql
--Description: For each U-S city, compare its total Q4-2019 vs Q4-2020 sales and compute % increase
WITH q19 AS (
      SELECT c.cust_city               AS city ,
             SUM(s.amount_sold)        AS sales_2019
      FROM   sales  s
      JOIN   customers c ON c.cust_id = s.cust_id
      JOIN   times t      ON t.time_id = s.time_id
      WHERE  c.country_id IN ( SELECT country_id
                                FROM countries
                                WHERE country_name LIKE 'United States%' )
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1772
      GROUP BY c.cust_city ),
q20 AS (
      SELECT c.cust_city               AS city ,
             SUM(s.amount_sold)        AS sales_2020
      FROM   sales  s
      JOIN   customers c ON c.cust_id = s.cust_id
      JOIN   times t      ON t.time_id = s.time_id
      WHERE  c.country_id IN ( SELECT country_id
                                FROM countries
                                WHERE country_name LIKE 'United States%' )
        AND  s.promo_id = 999
        AND  t.calendar_quarter_id = 1776
      GROUP BY c.cust_city )
SELECT q19.city ,
       q19.sales_2019 ,
       q20.sales_2020 ,
       ROUND( (q20.sales_2020 - q19.sales_2019)*1.0 / q19.sales_2019 , 3 ) AS pct_increase
FROM   q19
JOIN   q20 ON q20.city = q19.city
WHERE  q20.sales_2020 >= 1.2 * q19.sales_2019     -- ≥ 20 % growth
LIMIT 20;
```

```sql
--Description: For the growth-qualified cities, calculate each product’s share of total sales in Q4-2019
WITH growth_cities AS (
      SELECT q19.city
      FROM (
            SELECT c.cust_city AS city , SUM(s.amount_sold) AS sales_2019
            FROM sales s
            JOIN customers c ON c.cust_id = s.cust_id
            JOIN times t      ON t.time_id = s.time_id
            WHERE c.country_id IN ( SELECT country_id
                                    FROM countries
                                    WHERE country_name LIKE 'United States%' )
              AND s.promo_id = 999
              AND t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
           )  q19
      JOIN (
            SELECT c.cust_city AS city , SUM(s.amount_sold) AS sales_2020
            FROM sales s
            JOIN customers c ON c.cust_id = s.cust_id
            JOIN times t      ON t.time_id = s.time_id
            WHERE c.country_id IN ( SELECT country_id
                                    FROM countries
                                    WHERE country_name LIKE 'United States%' )
              AND s.promo_id = 999
              AND t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
           )  q20 ON q19.city = q20.city
      WHERE q20.sales_2020 >= 1.2 * q19.sales_2019
),
q19_prod AS (
      SELECT s.prod_id ,
             SUM(s.amount_sold) AS amt_2019
      FROM   sales s
      JOIN   customers c ON c.cust_id = s.cust_id
      JOIN   times t      ON t.time_id = s.time_id
      WHERE  s.promo_id = 999
        AND  t.calendar_quarter_id = 1772
        AND  c.cust_city IN ( SELECT city FROM growth_cities )
      GROUP BY s.prod_id
),
t19 AS ( SELECT SUM(amt_2019) AS tot_2019 FROM q19_prod )
SELECT q19_prod.prod_id ,
       q19_prod.amt_2019 ,
       ROUND( q19_prod.amt_2019 * 1.0 / t19.tot_2019 , 3 ) AS share_2019
FROM   q19_prod , t19
ORDER BY share_2019 DESC
LIMIT 20;
```

```sql
--Description: Analogous shares for Q4-2020 so the %-point change per top-selling product can be compared
WITH growth_cities AS (
      SELECT q19.city
      FROM (
            SELECT c.cust_city AS city , SUM(s.amount_sold) AS sales_2019
            FROM sales s
            JOIN customers c ON c.cust_id = s.cust_id
            JOIN times t      ON t.time_id = s.time_id
            WHERE c.country_id IN ( SELECT country_id
                                    FROM countries
                                    WHERE country_name LIKE 'United States%' )
              AND s.promo_id = 999
              AND t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
           )  q19
      JOIN (
            SELECT c.cust_city AS city , SUM(s.amount_sold) AS sales_2020
            FROM sales s
            JOIN customers c ON c.cust_id = s.cust_id
            JOIN times t      ON t.time_id = s.time_id
            WHERE c.country_id IN ( SELECT country_id
                                    FROM countries
                                    WHERE country_name LIKE 'United States%' )
              AND s.promo_id = 999
              AND t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
           )  q20 ON q19.city = q20.city
      WHERE q20.sales_2020 >= 1.2 * q19.sales_2019
),
q20_prod AS (
      SELECT s.prod_id ,
             SUM(s.amount_sold) AS amt_2020
      FROM   sales s
      JOIN   customers c ON c.cust_id = s.cust_id
      JOIN   times t      ON t.time_id = s.time_id
      WHERE  s.promo_id = 999
        AND  t.calendar_quarter_id = 1776
        AND  c.cust_city IN ( SELECT city FROM growth_cities )
      GROUP BY s.prod_id
),
t20 AS ( SELECT SUM(amt_2020) AS tot_2020 FROM q20_prod )
SELECT q20_prod.prod_id ,
       q20_prod.amt_2020 ,
       ROUND( q20_prod.amt_2020 * 1.0 / t20.tot_2020 , 3 ) AS share_2020
FROM   q20_prod , t20
ORDER BY share_2020 DESC
LIMIT 20;
```
