```sql
--Description:  Objective ─ identify products sold under promo_id = 999 to U.S. customers
--               during Q4-2019 (calendar_quarter_id 1772) and Q4-2020 (calendar_quarter_id 1776),
--               then list the ones that fall in the TOP-20 % by combined revenue across
--               those two quarters.  Steps embedded as CTEs:
--  1) us_country   – fetch country_id for “United States …” dynamically.
--  2) prod_total   – aggregate amount_sold for every product over both quarters.
--  3) ranked       – rank products by combined sales and split them into five equal
--                    buckets with NTILE(5); quintile = 1 corresponds to the top 20 %.
--  4) final list   – return the products whose quintile = 1, ordered by total sales.
WITH us_country AS (
    SELECT country_id
    FROM   countries
    WHERE  country_name LIKE 'United States%'
),
prod_total AS (
    SELECT s.prod_id,
           SUM(s.amount_sold) AS two_qtr_sales
    FROM   sales      AS s
    JOIN   customers  AS c ON c.cust_id = s.cust_id
    JOIN   times      AS t ON t.time_id = s.time_id
    WHERE  s.promo_id            = 999
      AND  c.country_id          = (SELECT country_id FROM us_country)
      AND  t.calendar_quarter_id IN (1772, 1776)     -- Q4-2019 & Q4-2020
    GROUP  BY s.prod_id
),
ranked AS (
    SELECT prod_id,
           two_qtr_sales,
           NTILE(5) OVER (ORDER BY two_qtr_sales DESC) AS quintile
    FROM   prod_total
)
SELECT r.prod_id,
       p.prod_name,
       ROUND(r.two_qtr_sales, 2) AS total_sales_q4_2019_2020
FROM   ranked   AS r
JOIN   products AS p ON p.prod_id = r.prod_id
WHERE  r.quintile = 1                -- top 20 %
ORDER  BY r.two_qtr_sales DESC
LIMIT 20;
```
