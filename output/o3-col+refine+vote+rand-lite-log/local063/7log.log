--Description: 9)  Compute each product’s share (%) of total promo-999 sales for Q4-2019 (1772)
--               and Q4-2020 (1776) for all U.S. customers.
WITH us_country AS (
    SELECT country_id
    FROM   countries
    WHERE  country_name LIKE 'United States%'
),
prod_qtr AS (                         -- sales per product & quarter
    SELECT s.prod_id,
           t.calendar_quarter_id,
           SUM(s.amount_sold) AS prod_qtr_sales
    FROM   sales      AS s
    JOIN   customers  AS c ON c.cust_id = s.cust_id
    JOIN   times      AS t ON t.time_id = s.time_id
    WHERE  s.promo_id            = 999
      AND  c.country_id          = (SELECT country_id FROM us_country)
      AND  t.calendar_quarter_id IN (1772,1776)          -- Q4-2019 & Q4-2020
    GROUP  BY s.prod_id, t.calendar_quarter_id
),
total_qtr AS (                        -- total sales each quarter
    SELECT calendar_quarter_id,
           SUM(prod_qtr_sales) AS qtr_total_sales
    FROM   prod_qtr
    GROUP  BY calendar_quarter_id
)
SELECT  p.prod_id,
        pq.calendar_quarter_id,
        ROUND(100.0 * pq.prod_qtr_sales / tq.qtr_total_sales, 2) AS prod_qtr_pct
FROM    prod_qtr  AS pq
JOIN    total_qtr AS tq USING (calendar_quarter_id)
JOIN    products  AS p  ON p.prod_id = pq.prod_id
ORDER   BY pq.calendar_quarter_id, prod_qtr_pct DESC
