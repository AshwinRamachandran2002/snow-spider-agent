Query:
--Description: 10)  Among products in the TOP-20 % by combined promo-999 revenue across Q4-2019
--                and Q4-2020 (U.S. customers), return the one whose share of total sales
--                changed the least (smallest absolute percentage-point change).
WITH us_country AS (
    SELECT country_id
    FROM   countries
    WHERE  country_name LIKE 'United States%'
),
sales_filt AS (                       -- promo-999 sales, Q4-2019 & Q4-2020, U.S.
    SELECT s.prod_id,
           t.calendar_quarter_id,
           s.amount_sold
    FROM   sales      AS s
    JOIN   customers  AS c ON c.cust_id = s.cust_id
    JOIN   times      AS t ON t.time_id = s.time_id
    WHERE  s.promo_id            = 999
      AND  c.country_id          = (SELECT country_id FROM us_country)
      AND  t.calendar_quarter_id IN (1772,1776)
),
prod_qtr AS (                         -- sales per product & quarter
    SELECT prod_id,
           calendar_quarter_id,
           SUM(amount_sold) AS prod_sales
    FROM   sales_filt
    GROUP  BY prod_id, calendar_quarter_id
),
tot_qtr AS (                          -- total sales per quarter
    SELECT calendar_quarter_id,
           SUM(prod_sales) AS qtr_sales
    FROM   prod_qtr
    GROUP  BY calendar_quarter_id
),
prod_share AS (                       -- % share per product & quarter
    SELECT p.prod_id,
           p.calendar_quarter_id,
           100.0 * p.prod_sales / t.qtr_sales AS pct_share
    FROM   prod_qtr p
    JOIN   tot_qtr  t USING (calendar_quarter_id)
),
delta AS (                            -- share change 2020Q4 − 2019Q4
    SELECT a.prod_id,
           (b.pct_share - a.pct_share) AS pct_point_change
    FROM   prod_share a
    JOIN   prod_share b
           ON  a.prod_id = b.prod_id
           AND a.calendar_quarter_id = 1772
           AND b.calendar_quarter_id = 1776
),
comb_sales AS (                       -- combined revenue both quarters
    SELECT prod_id,
           SUM(prod_sales) AS two_qtr_sales
    FROM   prod_qtr
    GROUP  BY prod_id
),
top20 AS (                            -- products in top 20 % by revenue
    SELECT prod_id,
           two_qtr_sales,
           NTILE(5) OVER (ORDER BY two_qtr_sales DESC) AS quintile
    FROM   comb_sales
),
answer AS (                           -- pick product with smallest |Δshare|
    SELECT t.prod_id,
           d.pct_point_change
    FROM   top20 t
    JOIN   delta d USING (prod_id)
    WHERE  t.quintile = 1
    ORDER  BY ABS(d.pct_point_change)
    LIMIT 1
)
SELECT a.prod_id,
       p.prod_name,
       ROUND(a.pct_point_change,2) AS pct_point_change
FROM   answer   a
JOIN   products p USING (prod_id)
