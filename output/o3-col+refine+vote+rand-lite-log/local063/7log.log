```sql
--Description: 1)  Check how calendar quarter IDs map to calendar years and months
SELECT DISTINCT "calendar_quarter_id",
                "calendar_quarter_desc",
                "calendar_year"
FROM "times"
WHERE "calendar_quarter_id" IN (1772,1776)
LIMIT 20;
```

```sql
--Description: 2)  Get the country_id that corresponds to the United States
SELECT DISTINCT "country_id","country_name"
FROM "countries"
WHERE "country_name" LIKE '%United States%'
LIMIT 20;
```

```sql
--Description: 3)  List a few U.S. customers (needed to tie sales rows to the United States)
SELECT DISTINCT "cust_id","cust_city","cust_state_province","country_id"
FROM "customers"
WHERE "country_id" = 52776      -- (replace with value returned by query #2)
LIMIT 20;
```

```sql
--Description: 4)  Pull raw sales rows that are (a) promo_id = 999 and (b) tied to U.S. customers
SELECT s."prod_id",
       s."cust_id",
       s."time_id",
       s."quantity_sold",
       s."amount_sold"
FROM   "sales"  AS s
JOIN   "customers" AS c
       ON c."cust_id" = s."cust_id"
WHERE  s."promo_id" = 999
  AND  c."country_id" = 52776                           -- U.S. country_id
LIMIT 20;
```

```sql
--Description: 5)  Aggregate those raw rows to city + quarter level for the two quarters of interest
SELECT   c."cust_city",
         t."calendar_quarter_id",
         SUM(s."amount_sold")  AS "city_qtr_sales"
FROM     "sales"      AS s
JOIN     "customers"  AS c  ON c."cust_id" = s."cust_id"
JOIN     "times"      AS t  ON t."time_id" = s."time_id"
WHERE    s."promo_id" = 999
  AND    c."country_id" = 52776
  AND    t."calendar_quarter_id" IN (1772,1776)
GROUP BY c."cust_city",
         t."calendar_quarter_id"
LIMIT 20;
```

```sql
--Description: 6)  Identify cities whose Q4-2020 sales ≥ 120% of their Q4-2019 sales
WITH city_qtr AS (
   SELECT c."cust_city",
          t."calendar_quarter_id",
          SUM(s."amount_sold") AS city_qtr_sales
   FROM   "sales"      AS s
   JOIN   "customers"  AS c  ON c."cust_id" = s."cust_id"
   JOIN   "times"      AS t  ON t."time_id" = s."time_id"
   WHERE  s."promo_id" = 999
     AND  c."country_id" = 52776
     AND  t."calendar_quarter_id" IN (1772,1776)
   GROUP  BY c."cust_city", t."calendar_quarter_id"
)
SELECT a."cust_city"
FROM   city_qtr AS a
JOIN   city_qtr AS b
       ON  a."cust_city" = b."cust_city"
       AND a."calendar_quarter_id" = 1772
       AND b."calendar_quarter_id" = 1776
WHERE  b."city_qtr_sales" >= 1.2 * a."city_qtr_sales"
LIMIT 20;
```

```sql
--Description: 7)  Compute product-level total sales for each quarter within the “qualified” cities
WITH good_cities AS (                                     
   -- reuse query #6
   WITH city_qtr AS (
      SELECT c."cust_city",
             t."calendar_quarter_id",
             SUM(s."amount_sold") AS city_qtr_sales
      FROM   "sales"      AS s
      JOIN   "customers"  AS c  ON c."cust_id" = s."cust_id"
      JOIN   "times"      AS t  ON t."time_id" = s."time_id"
      WHERE  s."promo_id" = 999
        AND  c."country_id" = 52776
        AND  t."calendar_quarter_id" IN (1772,1776)
      GROUP  BY c."cust_city", t."calendar_quarter_id"
   )
   SELECT a."cust_city"
   FROM   city_qtr AS a
   JOIN   city_qtr AS b
          ON  a."cust_city" = b."cust_city"
          AND a."calendar_quarter_id" = 1772
          AND b."calendar_quarter_id" = 1776
   WHERE  b."city_qtr_sales" >= 1.2 * a."city_qtr_sales"
)
SELECT   s."prod_id",
         t."calendar_quarter_id",
         SUM(s."amount_sold") AS prod_qtr_sales
FROM     "sales" AS s
JOIN     "customers" AS c  ON c."cust_id" = s."cust_id"
JOIN     "times"     AS t  ON t."time_id" = s."time_id"
WHERE    s."promo_id" = 999
  AND    c."country_id" = 52776
  AND    c."cust_city" IN (SELECT "cust_city" FROM good_cities)
  AND    t."calendar_quarter_id" IN (1772,1776)
GROUP BY s."prod_id", t."calendar_quarter_id"
LIMIT 20;
```

```sql
--Description: 8)  Work out which products fall in the top 20 % by combined sales (Q4-19 + Q4-20)
WITH prod_total AS (
   -- reuse CTE from query #7
   WITH good_cities AS ( ... )                             -- same sub-query as above
   SELECT s."prod_id",
          SUM(s."amount_sold") AS two_qtr_sales
   FROM   "sales" AS s
   JOIN   "customers" AS c  ON c."cust_id" = s."cust_id"
   JOIN   "times"     AS t  ON t."time_id" = s."time_id"
   WHERE  s."promo_id" = 999
     AND  c."country_id" = 52776
     AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
     AND  t."calendar_quarter_id" IN (1772,1776)
   GROUP BY s."prod_id"
)
SELECT p1."prod_id", p1."two_qtr_sales"
FROM   prod_total AS p1
WHERE  p1."two_qtr_sales" >= (
       SELECT PERCENTILE_CONT(0.80) WITHIN GROUP (ORDER BY "two_qtr_sales")
       FROM   prod_total)
LIMIT 20;
```

```sql
--Description: 9)  Compute each product’s share (%) of total promo-999 sales for each quarter
WITH good_cities AS ( ... ),                               -- same as before
     prod_qtr AS (
        SELECT s."prod_id",
               t."calendar_quarter_id",
               SUM(s."amount_sold") AS prod_qtr_sales
        FROM   "sales" AS s
        JOIN   "customers" AS c ON c."cust_id" = s."cust_id"
        JOIN   "times"     AS t ON t."time_id" = s."time_id"
        WHERE  s."promo_id" = 999
          AND  c."country_id" = 52776
          AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
          AND  t."calendar_quarter_id" IN (1772,1776)
        GROUP BY s."prod_id", t."calendar_quarter_id"
     ),
     total_qtr AS (
        SELECT t."calendar_quarter_id",
               SUM(s."amount_sold") AS qtr_total_sales
        FROM   "sales" AS s
        JOIN   "customers" AS c ON c."cust_id" = s."cust_id"
        JOIN   "times"     AS t ON t."time_id" = s."time_id"
        WHERE  s."promo_id" = 999
          AND  c."country_id" = 52776
          AND  c."cust_city" IN (SELECT "cust_city" FROM good_cities)
          AND  t."calendar_quarter_id" IN (1772,1776)
        GROUP BY t."calendar_quarter_id"
     )
SELECT  pq."prod_id",
        pq."calendar_quarter_id",
        100.0 * pq."prod_qtr_sales" / tq."qtr_total_sales" AS prod_qtr_pct
FROM    prod_qtr  AS pq
JOIN    total_qtr AS tq
        ON tq."calendar_quarter_id" = pq."calendar_quarter_id"
LIMIT 20;
```

```sql
--Description: 10)  Final answer – among top-20 % products, pick the one with the smallest
--                 change in share (%) between Q4-19 and Q4-20
WITH good_cities AS ( ... ),                               -- same as before
     prod_qtr AS ( ... ),                                  -- same as query #9
     total_qtr AS ( ... ),                                 -- same as query #9
     prod_pct AS (
        SELECT  pq."prod_id",
                pq."calendar_quarter_id",
                100.0 * pq."prod_qtr_sales" / tq."qtr_total_sales" AS prod_qtr_pct
        FROM    prod_qtr  AS pq
        JOIN    total_qtr AS tq
               ON tq."calendar_quarter_id" = pq."calendar_quarter_id"
     ),
     prod_delta AS (
        SELECT  a."prod_id",
                b."prod_qtr_pct" - a."prod_qtr_pct"  AS pct_point_change
        FROM    prod_pct AS a
        JOIN    prod_pct AS b
               ON  a."prod_id" = b."prod_id"
               AND a."calendar_quarter_id" = 1772
               AND b."calendar_quarter_id" = 1776
     ),
     top20 AS (
        SELECT p1."prod_id"
        FROM   (
               SELECT "prod_id",
                      SUM("prod_qtr_sales") AS two_qtr_sales
               FROM   prod_qtr
               GROUP  BY "prod_id"
        ) AS p1
        WHERE p1."two_qtr_sales" >= (
              SELECT PERCENTILE_CONT(0.80) WITHIN GROUP (ORDER BY two_qtr_sales)
              FROM   (
                     SELECT "prod_id",
                            SUM("prod_qtr_sales") AS two_qtr_sales
                     FROM   prod_qtr
                     GROUP  BY "prod_id"
              )
        )
     )
SELECT d."prod_id",
       d."pct_point_change"
FROM   prod_delta AS d
WHERE  d."prod_id" IN (SELECT "prod_id" FROM top20)
ORDER  BY ABS(d."pct_point_change") ASC            -- smallest absolute change
LIMIT 1;
```
