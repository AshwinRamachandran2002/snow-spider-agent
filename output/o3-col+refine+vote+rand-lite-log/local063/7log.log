```sql
--Description:  End-to-end answer in one statement.
--  • us_country   – fetch the UNITED STATES country_id dynamically.
--  • city_qtr     – promo-999 sales by U.S. city for Q4-2019 (1772) & Q4-2020 (1776).
--  • grow_cities  – cities whose 2020Q4 sales ≥120 % of 2019Q4 (≥20 % growth).
--  • filt_sales   – promo-999 sales restricted to those cities & the two quarters.
--  • prod_qtr     – per-product sales per quarter.
--  • tot_qtr      – total sales (all products) per quarter (for market-share calc.).
--  • prod_share   – each product’s % share of total sales per quarter.
--  • delta        – percentage-point change in share (2020Q4 − 2019Q4).
--  • comb_sales   – combined sales (2019Q4 + 2020Q4) per product.
--  • top20        – products in the top 20 % by combined sales (NTILE(5)=1).
--  • answer       – among those, choose the product with the smallest |Δshare|.
WITH us_country AS (
    SELECT country_id
    FROM   countries
    WHERE  country_name LIKE 'United States%'
),
city_qtr AS (
    SELECT c.cust_city,
           t.calendar_quarter_id,
           SUM(s.amount_sold) AS city_sales
    FROM   sales      AS s
    JOIN   customers  AS c ON c.cust_id = s.cust_id
    JOIN   times      AS t ON t.time_id = s.time_id
    WHERE  s.promo_id            = 999
      AND  c.country_id          = (SELECT country_id FROM us_country)
      AND  t.calendar_quarter_id IN (1772,1776)           -- Q4-2019 & Q4-2020
    GROUP  BY c.cust_city, t.calendar_quarter_id
),
grow_cities AS (
    SELECT a.cust_city
    FROM   city_qtr a
    JOIN   city_qtr b
           ON  a.cust_city           = b.cust_city
           AND a.calendar_quarter_id = 1772
           AND b.calendar_quarter_id = 1776
    WHERE  b.city_sales >= 1.2 * a.city_sales             -- ≥20 % growth
),
filt_sales AS (
    SELECT s.prod_id,
           t.calendar_quarter_id,
           s.amount_sold
    FROM   sales     AS s
    JOIN   customers AS c ON c.cust_id = s.cust_id
    JOIN   times     AS t ON t.time_id = s.time_id
    WHERE  s.promo_id            = 999
      AND  c.country_id          = (SELECT country_id FROM us_country)
      AND  c.cust_city IN (SELECT cust_city FROM grow_cities)
      AND  t.calendar_quarter_id IN (1772,1776)
),
prod_qtr AS (
    SELECT prod_id,
           calendar_quarter_id,
           SUM(amount_sold) AS prod_sales
    FROM   filt_sales
    GROUP  BY prod_id, calendar_quarter_id
),
tot_qtr AS (
    SELECT calendar_quarter_id,
           SUM(prod_sales) AS qtr_sales
    FROM   prod_qtr
    GROUP  BY calendar_quarter_id
),
prod_share AS (
    SELECT p.prod_id,
           p.calendar_quarter_id,
           100.0 * p.prod_sales / t.qtr_sales AS pct_share
    FROM   prod_qtr p
    JOIN   tot_qtr  t USING (calendar_quarter_id)
),
delta AS (
    SELECT a.prod_id,
           (b.pct_share - a.pct_share) AS pct_point_change
    FROM   prod_share a
    JOIN   prod_share b
           ON  a.prod_id = b.prod_id
           AND a.calendar_quarter_id = 1772
           AND b.calendar_quarter_id = 1776
),
comb_sales AS (
    SELECT prod_id,
           SUM(prod_sales) AS two_qtr_sales
    FROM   prod_qtr
    GROUP  BY prod_id
),
top20 AS (
    SELECT prod_id,
           two_qtr_sales,
           NTILE(5) OVER (ORDER BY two_qtr_sales DESC) AS quintile
    FROM   comb_sales
),
answer AS (
    SELECT t.prod_id,
           d.pct_point_change
    FROM   top20 t
    JOIN   delta d USING (prod_id)
    WHERE  t.quintile = 1                                -- top 20 %
    ORDER  BY ABS(d.pct_point_change)                    -- smallest |Δshare|
    LIMIT 1
)
SELECT a.prod_id,
       p.prod_name,
       ROUND(a.pct_point_change,2) AS pct_point_change
FROM   answer a
JOIN   products p USING (prod_id);
