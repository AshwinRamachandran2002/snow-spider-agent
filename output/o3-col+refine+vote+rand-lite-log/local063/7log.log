```sql
--Description:  Answer in one shot.
--Inside the query:
-- 1) city_qtr    – promo-999 sales for every U.S. city in Q4-2019 (1772) & Q4-2020 (1776).
-- 2) good_cities – cities whose Q4-2020 ≥120 % of their Q4-2019 sales (≥20 % growth).
-- 3) sales_filt  – promo-999 sales restricted to those cities & the two quarters.
-- 4) prod_qtr    – per-product sales for each quarter.
-- 5) total_qtr   – total sales of all products for each quarter (needed for %-share).
-- 6) prod_share  – each product’s share (%) of total sales per quarter.
-- 7) prod_delta  – percentage-point change in share (2020Q4 − 2019Q4).
-- 8) prod_total  – combined sales (both quarters) per product.
-- 9) ranked      – assign products to 5 equal buckets by combined sales (quintiles).
--10) final_sel   – within top quintile (top 20 %), return product with smallest |Δshare|.
WITH city_qtr AS (
    SELECT c.cust_city,
           t.calendar_quarter_id,
           SUM(s.amount_sold) AS city_qtr_sales
    FROM   sales      AS s
    JOIN   customers  AS c ON c.cust_id = s.cust_id
    JOIN   times      AS t ON t.time_id = s.time_id
    WHERE  s.promo_id = 999
      AND  c.country_id = 52790                  -- United States of America
      AND  t.calendar_quarter_id IN (1772,1776)  -- Q4-2019 & Q4-2020
    GROUP  BY c.cust_city, t.calendar_quarter_id
),
good_cities AS (
    SELECT a.cust_city
    FROM   city_qtr a
    JOIN   city_qtr b
           ON  a.cust_city           = b.cust_city
           AND a.calendar_quarter_id = 1772
           AND b.calendar_quarter_id = 1776
    WHERE  b.city_qtr_sales >= 1.2 * a.city_qtr_sales
),
sales_filt AS (
    SELECT s.prod_id,
           t.calendar_quarter_id,
           s.amount_sold
    FROM   sales     AS s
    JOIN   customers AS c ON c.cust_id = s.cust_id
    JOIN   times     AS t ON t.time_id = s.time_id
    WHERE  s.promo_id = 999
      AND  c.country_id = 52790
      AND  c.cust_city IN (SELECT cust_city FROM good_cities)
      AND  t.calendar_quarter_id IN (1772,1776)
),
prod_qtr AS (
    SELECT prod_id,
           calendar_quarter_id,
           SUM(amount_sold) AS prod_qtr_sales
    FROM   sales_filt
    GROUP  BY prod_id, calendar_quarter_id
),
total_qtr AS (
    SELECT calendar_quarter_id,
           SUM(prod_qtr_sales) AS qtr_total_sales
    FROM   prod_qtr
    GROUP  BY calendar_quarter_id
),
prod_share AS (
    SELECT p.prod_id,
           p.calendar_quarter_id,
           100.0 * p.prod_qtr_sales / t.qtr_total_sales AS pct_share
    FROM   prod_qtr  p
    JOIN   total_qtr t ON t.calendar_quarter_id = p.calendar_quarter_id
),
prod_delta AS (
    SELECT a.prod_id,
           (b.pct_share - a.pct_share) AS pct_point_change
    FROM   prod_share a
    JOIN   prod_share b
           ON  a.prod_id = b.prod_id
           AND a.calendar_quarter_id = 1772
           AND b.calendar_quarter_id = 1776
),
prod_total AS (
    SELECT prod_id,
           SUM(prod_qtr_sales) AS two_qtr_sales
    FROM   prod_qtr
    GROUP  BY prod_id
),
ranked AS (
    SELECT pt.prod_id,
           pt.two_qtr_sales,
           pd.pct_point_change,
           ROW_NUMBER() OVER (ORDER BY pt.two_qtr_sales DESC) AS rn,
           COUNT(*) OVER () AS total_cnt
    FROM   prod_total pt
    JOIN   prod_delta pd ON pd.prod_id = pt.prod_id
),
final_sel AS (
    SELECT *
    FROM   ranked
    WHERE  rn <= (total_cnt + 4)/5     -- top 20 % (ceiling(total_cnt/5))
    ORDER  BY ABS(pct_point_change)    -- smallest absolute change first
    LIMIT 1
)
SELECT f.prod_id,
       p.prod_name,
       ROUND(f.pct_point_change,2) AS pct_point_change
FROM   final_sel f
JOIN   products p ON p.prod_id = f.prod_id;
