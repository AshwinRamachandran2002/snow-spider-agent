WITH us_country AS (                     -- United States country_id
    SELECT country_id
    FROM   countries
    WHERE  country_name LIKE 'United States%'
),

/* 1)  Promo-999 sales for Q4-2019 (1772) & Q4-2020 (1776) – U.S. only */
sales_base AS (
    SELECT s.prod_id,
           s.cust_id,
           s.amount_sold,
           t.calendar_quarter_id,
           c.cust_city
    FROM   sales      AS s
    JOIN   customers  AS c ON c.cust_id = s.cust_id
    JOIN   times      AS t ON t.time_id  = s.time_id
    WHERE  s.promo_id            = 999
      AND  c.country_id          = (SELECT country_id FROM us_country)
      AND  t.calendar_quarter_id IN (1772,1776)
),

/* 2)  City-level totals for each quarter */
city_qtr AS (
    SELECT cust_city,
           calendar_quarter_id,
           SUM(amount_sold) AS city_sales
    FROM   sales_base
    GROUP  BY cust_city, calendar_quarter_id
),

/* 3)  Sales 2019-Q4 vs 2020-Q4 for every city               */
city_growth AS (
    SELECT cust_city,
           SUM(CASE WHEN calendar_quarter_id = 1772 THEN city_sales ELSE 0 END) AS sales_2019,
           SUM(CASE WHEN calendar_quarter_id = 1776 THEN city_sales ELSE 0 END) AS sales_2020
    FROM   city_qtr
    GROUP  BY cust_city
),

/* 4)  Cities whose 2020-Q4 sales ≥ 120 % of 2019-Q4 sales   */
/*     (if no 2019 sales but some 2020 sales, they qualify)  */
good_cities AS (
    SELECT cust_city
    FROM   city_growth
    WHERE  (sales_2019 > 0  AND sales_2020 >= 1.2 * sales_2019)
       OR  (sales_2019 = 0 AND sales_2020  > 0)
),

/* 5)  Keep only sales from “good” cities                    */
sales_good AS (
    SELECT *
    FROM   sales_base
    WHERE  cust_city IN (SELECT cust_city FROM good_cities)
),

/* 6)  Product totals per quarter                           */
prod_qtr AS (
    SELECT prod_id,
           calendar_quarter_id,
           SUM(amount_sold) AS prod_sales
    FROM   sales_good
    GROUP  BY prod_id, calendar_quarter_id
),

/* 7)  Quarter-wide totals                                  */
tot_qtr AS (
    SELECT calendar_quarter_id,
           SUM(prod_sales) AS qtr_sales
    FROM   prod_qtr
    GROUP  BY calendar_quarter_id
),

/* 8)  Product share (%) in each quarter                    */
prod_share AS (
    SELECT p.prod_id,
           p.calendar_quarter_id,
           100.0 * p.prod_sales / t.qtr_sales AS pct_share
    FROM   prod_qtr p
    JOIN   tot_qtr  t USING (calendar_quarter_id)
),

/* 9)  Percentage-point change between 2020-Q4 and 2019-Q4   */
/*     (missing quarter treated as 0)                       */
delta AS (
    SELECT prod_id,
           SUM(CASE
                   WHEN calendar_quarter_id = 1776 THEN  pct_share
                   WHEN calendar_quarter_id = 1772 THEN -pct_share
               END) AS pct_point_change
    FROM   prod_share
    GROUP  BY prod_id
),

/* 10) Combined revenue (both quarters)                     */
comb_sales AS (
    SELECT prod_id,
           SUM(prod_sales) AS two_qtr_sales
    FROM   prod_qtr
    GROUP  BY prod_id
),

/* 11) Identify top 20 % of products by combined revenue    */
ranked AS (
    SELECT prod_id,
           two_qtr_sales,
           NTILE(5) OVER (ORDER BY two_qtr_sales DESC) AS quintile
    FROM   comb_sales
),

/* 12) Product in top quintile with smallest |Δ share|      */
answer AS (
    SELECT r.prod_id,
           d.pct_point_change
    FROM   ranked r
    JOIN   delta  d USING (prod_id)
    WHERE  r.quintile = 1
    ORDER  BY ABS(d.pct_point_change)
    LIMIT 1
)

/* 13) Final result                                         */
SELECT a.prod_id,
       p.prod_name,
       ROUND(a.pct_point_change, 4) AS pct_point_change
FROM   answer   a
JOIN   products p ON p.prod_id = a.prod_id;
```
