-- Description: 7) List every product sold in those “growth” cities during the two quarters, with its total sales.  
WITH growth_cities AS (
    SELECT city_sales_20.cust_city
    FROM  (
            SELECT c.cust_city, SUM(s.amount_sold) AS total_sales
            FROM   sales AS s
            JOIN   customers AS c ON s.cust_id = c.cust_id
            JOIN   countries AS co ON c.country_id = co.country_id
            JOIN   times AS t ON s.time_id = t.time_id
            WHERE  s.promo_id = 999
              AND  co.country_name LIKE '%United%States%'
              AND  t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
          ) AS city_sales_20
    JOIN  (
            SELECT c.cust_city, SUM(s.amount_sold) AS total_sales
            FROM   sales AS s
            JOIN   customers AS c ON s.cust_id = c.cust_id
            JOIN   countries AS co ON c.country_id = co.country_id
            JOIN   times AS t ON s.time_id = t.time_id
            WHERE  s.promo_id = 999
              AND  co.country_name LIKE '%United%States%'
              AND  t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
          ) AS city_sales_19
    ON city_sales_20.cust_city = city_sales_19.cust_city
    WHERE (CAST(city_sales_20.total_sales AS REAL)
/ NULLIF(city_sales_19.total_sales,0) - 1) >= 0.20
)
SELECT   s.prod_id,
         t.calendar_quarter_id,
         SUM(s.amount_sold) AS total_sales
FROM     sales AS s
JOIN     customers AS c ON s.cust_id = c.cust_id
JOIN     times     AS t ON s.time_id = t.time_id
WHERE    s.promo_id = 999
  AND    c.cust_city IN (SELECT cust_city FROM growth_cities)
  AND    t.calendar_quarter_id IN (1772, 1776)
GROUP BY s.prod_id, t.calendar_quarter_id
LIMIT 20;
