-- Description: 8) Compute each product’s share of total sales in the two quarters (within growth cities).  
WITH growth_cities AS (
    SELECT cust_city
    FROM   (
        /* same sub-query logic as in step 6, shortened here */
        SELECT c.cust_city,
               SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS s20,
               SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS s19
        FROM   sales AS s
        JOIN   customers AS c ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  s.promo_id = 999
          AND  co.country_name LIKE '%United%States%'
          AND  t.calendar_quarter_id IN (1772, 1776)
        GROUP BY c.cust_city
        HAVING (CAST(s20 AS REAL) / NULLIF(s19,0) - 1) >= 0.20
    )
)
, sales_qtr AS (
    SELECT s.prod_id,
           t.calendar_quarter_id,
           SUM(s.amount_sold) AS prod_sales
    FROM   sales AS s
    JOIN   customers AS c ON s.cust_id = c.cust_id
    JOIN   times     AS t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  c.cust_city IN (SELECT cust_city FROM growth_cities)
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP BY s.prod_id, t.calendar_quarter_id
)
, total_qtr AS (
    SELECT calendar_quarter_id,
           SUM(prod_sales) AS total_sales
    FROM   sales_qtr
    GROUP BY calendar_quarter_id
)
SELECT sq.prod_id,
       sq.calendar_quarter_id,
       sq.prod_sales,
       ROUND( (CAST(sq.prod_sales AS REAL) / tq.total_sales) * 100, 2) AS pct_of_total
FROM   sales_qtr AS sq
JOIN   total_qtr AS tq USING (calendar_quarter_id)
ORDER  BY sq.prod_id, sq.calendar_quarter_id
LIMIT 20;
