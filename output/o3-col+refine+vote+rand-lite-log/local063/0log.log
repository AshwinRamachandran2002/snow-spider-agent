```sql
-- Description: 1) Find how the United States is recorded in the “countries” table.  
SELECT DISTINCT country_id, country_iso_code, country_name
FROM countries
WHERE country_name LIKE '%United%States%'
LIMIT 20;
```

```sql
-- Description: 2) Inspect a few U.S.-based customers (so we can later join to sales).  
SELECT DISTINCT c.cust_id, c.cust_city, c.cust_state_province, c.country_id
FROM customers AS c
JOIN countries  AS co ON c.country_id = co.country_id
WHERE co.country_name LIKE '%United%States%'
LIMIT 20;
```

```sql
-- Description: 3) Look at sample sales rows that use promo_id = 999 and belong to U.S. customers.  
SELECT s.*
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
WHERE  s.promo_id = 999
  AND  co.country_name LIKE '%United%States%'
LIMIT 20;
```

```sql
-- Description: 4) Check the calendar_quarter_id values for 2019-Q4 (should be 1772) and 2020-Q4 (1776).  
SELECT DISTINCT calendar_quarter_desc, calendar_quarter_id
FROM   times
WHERE  calendar_year IN (2019, 2020)
  AND  calendar_quarter_number = 4
LIMIT 20;
```

```sql
-- Description: 5) Aggregate total amount_sold by city and quarter for U.S. sales with promo_id = 999.  
SELECT   c.cust_city,
         t.calendar_quarter_id,
         SUM(s.amount_sold) AS total_sales
FROM     sales      AS s
JOIN     customers  AS c  ON s.cust_id = c.cust_id
JOIN     countries  AS co ON c.country_id = co.country_id
JOIN     times      AS t  ON s.time_id   = t.time_id
WHERE    s.promo_id = 999
  AND    co.country_name LIKE '%United%States%'
  AND    t.calendar_quarter_id IN (1772, 1776)
GROUP BY c.cust_city, t.calendar_quarter_id
LIMIT 20;
```

```sql
-- Description: 6) For the same scope, compute the % increase from 2019-Q4 to 2020-Q4 by city.  
SELECT   city_sales_20.cust_city,
         city_sales_19.total_sales  AS sales_2019Q4,
         city_sales_20.total_sales  AS sales_2020Q4,
         (CAST(city_sales_20.total_sales AS REAL) 
          / NULLIF(city_sales_19.total_sales,0) - 1) * 100 AS pct_increase
FROM  (
        SELECT c.cust_city, SUM(s.amount_sold) AS total_sales
        FROM   sales AS s
        JOIN   customers AS c ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  s.promo_id = 999
          AND  co.country_name LIKE '%United%States%'
          AND  t.calendar_quarter_id = 1776
        GROUP BY c.cust_city
      ) AS city_sales_20
JOIN  (
        SELECT c.cust_city, SUM(s.amount_sold) AS total_sales
        FROM   sales AS s
        JOIN   customers AS c ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  s.promo_id = 999
          AND  co.country_name LIKE '%United%States%'
          AND  t.calendar_quarter_id = 1772
        GROUP BY c.cust_city
      ) AS city_sales_19
ON city_sales_20.cust_city = city_sales_19.cust_city
WHERE (CAST(city_sales_20.total_sales AS REAL) 
       / NULLIF(city_sales_19.total_sales,0) - 1) >= 0.20
LIMIT 20;
```

```sql
-- Description: 7) List every product sold in those “growth” cities during the two quarters, with its total sales.  
WITH growth_cities AS (
    SELECT city_sales_20.cust_city
    FROM  (
            SELECT c.cust_city, SUM(s.amount_sold) AS total_sales
            FROM   sales AS s
            JOIN   customers AS c ON s.cust_id = c.cust_id
            JOIN   countries AS co ON c.country_id = co.country_id
            JOIN   times AS t ON s.time_id = t.time_id
            WHERE  s.promo_id = 999
              AND  co.country_name LIKE '%United%States%'
              AND  t.calendar_quarter_id = 1776
            GROUP BY c.cust_city
          ) AS city_sales_20
    JOIN  (
            SELECT c.cust_city, SUM(s.amount_sold) AS total_sales
            FROM   sales AS s
            JOIN   customers AS c ON s.cust_id = c.cust_id
            JOIN   countries AS co ON c.country_id = co.country_id
            JOIN   times AS t ON s.time_id = t.time_id
            WHERE  s.promo_id = 999
              AND  co.country_name LIKE '%United%States%'
              AND  t.calendar_quarter_id = 1772
            GROUP BY c.cust_city
          ) AS city_sales_19
    ON city_sales_20.cust_city = city_sales_19.cust_city
    WHERE (CAST(city_sales_20.total_sales AS REAL)
/ NULLIF(city_sales_19.total_sales,0) - 1) >= 0.20
)
SELECT   s.prod_id,
         t.calendar_quarter_id,
         SUM(s.amount_sold) AS total_sales
FROM     sales AS s
JOIN     customers AS c ON s.cust_id = c.cust_id
JOIN     times     AS t ON s.time_id = t.time_id
WHERE    s.promo_id = 999
  AND    c.cust_city IN (SELECT cust_city FROM growth_cities)
  AND    t.calendar_quarter_id IN (1772, 1776)
GROUP BY s.prod_id, t.calendar_quarter_id
LIMIT 20;
```

```sql
-- Description: 8) Compute each product’s share of total sales in the two quarters (within growth cities).  
WITH growth_cities AS (
    SELECT cust_city
    FROM   (
        /* same sub-query logic as in step 6, shortened here */
        SELECT c.cust_city,
               SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS s20,
               SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS s19
        FROM   sales AS s
        JOIN   customers AS c ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  s.promo_id = 999
          AND  co.country_name LIKE '%United%States%'
          AND  t.calendar_quarter_id IN (1772, 1776)
        GROUP BY c.cust_city
        HAVING (CAST(s20 AS REAL) / NULLIF(s19,0) - 1) >= 0.20
    )
)
, sales_qtr AS (
    SELECT s.prod_id,
           t.calendar_quarter_id,
           SUM(s.amount_sold) AS prod_sales
    FROM   sales AS s
    JOIN   customers AS c ON s.cust_id = c.cust_id
    JOIN   times     AS t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  c.cust_city IN (SELECT cust_city FROM growth_cities)
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP BY s.prod_id, t.calendar_quarter_id
)
, total_qtr AS (
    SELECT calendar_quarter_id,
           SUM(prod_sales) AS total_sales
    FROM   sales_qtr
    GROUP BY calendar_quarter_id
)
SELECT sq.prod_id,
       sq.calendar_quarter_id,
       sq.prod_sales,
       ROUND( (CAST(sq.prod_sales AS REAL) / tq.total_sales) * 100, 2) AS pct_of_total
FROM   sales_qtr AS sq
JOIN   total_qtr AS tq USING (calendar_quarter_id)
ORDER  BY sq.prod_id, sq.calendar_quarter_id
LIMIT 20;
```

```sql
-- Description: 9) Rank products by combined sales across both quarters and keep top 20% (within growth cities).  
WITH growth_cities AS ( /* same as previous CTE */ 
    SELECT cust_city
    FROM   (
        SELECT c.cust_city,
               SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS s20,
               SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS s19
        FROM   sales AS s
        JOIN   customers AS c ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  s.promo_id = 999
          AND  co.country_name LIKE '%United%States%'
          AND  t.calendar_quarter_id IN (1772, 1776)
        GROUP BY c.cust_city
        HAVING (CAST(s20 AS REAL) / NULLIF(s19,0) - 1) >= 0.20
    )
)
, prod_tot AS (
    SELECT s.prod_id,
           SUM(s.amount_sold) AS grand_total
    FROM   sales AS s
    JOIN   customers AS c ON s.cust_id = c.cust_id
    JOIN   times     AS t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  c.cust_city IN (SELECT cust_city FROM growth_cities)
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP BY s.prod_id
)
SELECT *
FROM   prod_tot
WHERE  grand_total >= (
        SELECT PERCENTILE_CONT(0.8) WITHIN GROUP (ORDER BY grand_total)
        FROM prod_tot
      )     -- top 20%
ORDER  BY grand_total DESC
LIMIT 20;
```

```sql
-- Description: 10) For those top-20% products, return the one whose share of total sales changed the least (absolute %-point difference).  
WITH growth_cities AS ( /* as before */ 
    SELECT cust_city
    FROM   (
        SELECT c.cust_city,
               SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) AS s20,
               SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END) AS s19
        FROM   sales AS s
        JOIN   customers AS c ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times AS t ON s.time_id = t.time_id
        WHERE  s.promo_id = 999
          AND  co.country_name LIKE '%United%States%'
          AND  t.calendar_quarter_id IN (1772, 1776)
        GROUP BY c.cust_city
        HAVING (CAST(s20 AS REAL) / NULLIF(s19,0) - 1) >= 0.20
    )
)
, prod_tot AS (       -- same as step 9
    SELECT s.prod_id,
           SUM(s.amount_sold) AS grand_total
    FROM   sales AS s
    JOIN   customers AS c ON s.cust_id = c.cust_id
    JOIN   times     AS t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  c.cust_city IN (SELECT cust_city FROM growth_cities)
      AND  t.calendar_quarter_id IN (1772, 1776)
    GROUP BY s.prod_id
)
, top20 AS (
    SELECT prod_id
    FROM   prod_tot
    WHERE  grand_total >= (
        SELECT PERCENTILE_CONT(0.8) WITHIN GROUP (ORDER BY grand_total)
        FROM prod_tot
    )
)
, sales_qtr AS (
    SELECT s.prod_id,
           t.calendar_quarter_id,
           SUM(s.amount_sold) AS prod_sales
    FROM   sales AS s
    JOIN   customers AS c ON s.cust_id = c.cust_id
    JOIN   times     AS t ON s.time_id = t.time_id
    WHERE  s.promo_id = 999
      AND  c.cust_city IN (SELECT cust_city FROM growth_cities)
      AND  t.calendar_quarter_id IN (1772, 1776)
      AND  s.prod_id IN (SELECT prod_id FROM top20)
    GROUP BY s.prod_id, t.calendar_quarter_id
)
, total_qtr AS (
    SELECT calendar_quarter_id,
           SUM(prod_sales) AS total_sales
    FROM   sales_qtr
    GROUP BY calendar_quarter_id
)
, share_qtr AS (
    SELECT sq.prod_id,
           sq.calendar_quarter_id,
           (CAST(sq.prod_sales AS REAL) / tq.total_sales) * 100 AS pct_share
    FROM   sales_qtr AS sq
    JOIN   total_qtr AS tq USING (calendar_quarter_id)
)
SELECT   s19.prod_id,
         ROUND(s19.pct_share,2) AS share_2019Q4,
         ROUND(s20.pct_share,2) AS share_2020Q4,
         ROUND(ABS(s20.pct_share - s19.pct_share),2) AS pct_point_change
FROM     share_qtr AS s19
JOIN     share_qtr AS s20
       ON s19.prod_id = s20.prod_id
      AND s19.calendar_quarter_id = 1772
      AND s20.calendar_quarter_id = 1776
ORDER BY pct_point_change ASC
LIMIT 20;
```

These 10 progressively richer SQL queries let you drill down from basic country/customer identification to the final product whose share of total sales changed the least, exactly following the problem statement.
