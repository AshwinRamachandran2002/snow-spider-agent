--Description / Thinking process:
-- • growth_cities  : U.S. cities whose promo-999 sales grew ≥20 % from 2019-Q4 (1772) to 2020-Q4 (1776).
-- • sales_scope    : all promo-999 sales in those cities for the two quarters.
-- • prod_tot       : each product’s combined sales across both quarters.
-- • ranked / top20 : keep products in the TOP-20 % of grand_total (rank via window fn).
-- • prod_qtr       : product sales per quarter (only top-20 % products).
-- • total_qtr      : total sales for each quarter (denominator for share).
-- • share_qtr      : each product’s % share of total sales in each quarter.
-- • diffs          : calculate absolute %-point change of share between 2019-Q4 and 2020-Q4.
-- • final SELECT   : return the product with the SMALLEST change in share.
WITH growth_cities AS (
    SELECT c.cust_city
    FROM   sales      s
    JOIN   customers  c  ON s.cust_id   = c.cust_id
    JOIN   countries  co ON c.country_id = co.country_id
    JOIN   times      t  ON s.time_id   = t.time_id
    WHERE  s.promo_id              = 999
      AND  co.country_name         = 'United States of America'
      AND  t.calendar_quarter_id  IN (1772,1776)
    GROUP BY c.cust_city
    HAVING (SUM(CASE WHEN t.calendar_quarter_id = 1776 THEN s.amount_sold END) * 1.0 /
            NULLIF(SUM(CASE WHEN t.calendar_quarter_id = 1772 THEN s.amount_sold END),0) - 1) >= 0.20
),
sales_scope AS (
    SELECT s.prod_id,
           s.amount_sold,
           t.calendar_quarter_id
    FROM   sales      s
    JOIN   customers  c  ON s.cust_id = c.cust_id
    JOIN   countries  co ON c.country_id = co.country_id
    JOIN   times      t  ON s.time_id  = t.time_id
    WHERE  s.promo_id              = 999
      AND  co.country_name         = 'United States of America'
      AND  t.calendar_quarter_id  IN (1772,1776)
      AND  c.cust_city            IN (SELECT cust_city FROM growth_cities)
),
prod_tot AS (
    SELECT prod_id,
           SUM(amount_sold) AS grand_total
    FROM   sales_scope
    GROUP BY prod_id
),
ranked AS (
    SELECT prod_id,
           grand_total,
           ROW_NUMBER() OVER (ORDER BY grand_total DESC) AS rn,
           COUNT(*)   OVER ()                            AS cnt
    FROM   prod_tot
),
top20 AS (
    SELECT prod_id
    FROM   ranked
    WHERE  rn <= cnt * 0.20          -- top 20 %
),
prod_qtr AS (
    SELECT prod_id,
           calendar_quarter_id,
           SUM(amount_sold) AS qtr_sales
    FROM   sales_scope
    WHERE  prod_id IN (SELECT prod_id FROM top20)
    GROUP BY prod_id, calendar_quarter_id
),
total_qtr AS (
    SELECT calendar_quarter_id,
           SUM(qtr_sales) AS total_sales
    FROM   prod_qtr
    GROUP BY calendar_quarter_id
),
share_qtr AS (
    SELECT pq.prod_id,
           pq.calendar_quarter_id,
           pq.qtr_sales * 100.0 / tq.total_sales AS pct_share
    FROM   prod_qtr pq
    JOIN   total_qtr tq USING (calendar_quarter_id)
),
diffs AS (
    SELECT s19.prod_id,
           s19.pct_share AS share_2019,
           s20.pct_share AS share_2020,
           ABS(s20.pct_share - s19.pct_share) AS pct_pt_change
    FROM   share_qtr s19
    JOIN   share_qtr s20
           ON s19.prod_id = s20.prod_id
          AND s19.calendar_quarter_id = 1772
          AND s20.calendar_quarter_id = 1776
)
SELECT prod_id,
       ROUND(share_2019,2)  AS share_2019Q4,
       ROUND(share_2020,2)  AS share_2020Q4,
       ROUND(pct_pt_change,2) AS pct_point_change
FROM   diffs
ORDER  BY pct_pt_change ASC
LIMIT 1;
