Query:
--Description: 9) Rank products (promo_id = 999, U-S growth-cities only) by their
--              combined sales across Q4-2019 & Q4-2020, then list those that fall
--              within the top 20 % of the ranking (grand-total shown).
WITH
-- total sales per (city, quarter)
city_tot AS (
  SELECT c.cust_city,
         t.calendar_quarter_id AS qid,
         SUM(s.amount_sold)    AS amt
  FROM   sales      AS s
  JOIN   customers  AS c  ON s.cust_id = c.cust_id
  JOIN   countries  AS co ON c.country_id = co.country_id
  JOIN   times      AS t  ON s.time_id   = t.time_id
  WHERE  co.country_iso_code = 'US'
    AND  s.promo_id = 999
    AND  t.calendar_quarter_id IN (1772,1776)
  GROUP  BY c.cust_city, t.calendar_quarter_id
),
-- cities whose 2020-Q4 ≥ 1.2 × 2019-Q4
growth_cities AS (
  SELECT a.cust_city
  FROM   city_tot a
  JOIN   city_tot b
         ON a.cust_city = b.cust_city
        AND a.qid = 1772
        AND b.qid = 1776
  WHERE  b.amt >= 1.2 * a.amt
),
-- product totals in those growth-cities
prod_qtr_sales AS (
  SELECT s.prod_id,
         SUM(s.amount_sold) AS amt
  FROM   sales      AS s
  JOIN   customers  AS c  ON s.cust_id = c.cust_id
  JOIN   growth_cities gc ON gc.cust_city = c.cust_city
  JOIN   times      AS t  ON s.time_id   = t.time_id
  WHERE  s.promo_id = 999
    AND  t.calendar_quarter_id IN (1772,1776)
  GROUP  BY s.prod_id
),
-- grand total per product (across both quarters)
prod_tot AS (
  SELECT prod_id,
         SUM(amt) AS grand_total
  FROM   prod_qtr_sales
  GROUP  BY prod_id
),
-- rank & count to identify top 20 %
ranked AS (
  SELECT prod_id,
         grand_total,
         ROW_NUMBER() OVER (ORDER BY grand_total DESC) AS rn,
         COUNT(*)  OVER ()                             AS cnt
  FROM   prod_tot
)
SELECT prod_id,
       grand_total
FROM   ranked
WHERE  rn <= CAST(cnt * 0.20 + 0.9999 AS INTEGER)   -- ceiling of 20 %
ORDER  BY grand_total DESC
LIMIT 20
