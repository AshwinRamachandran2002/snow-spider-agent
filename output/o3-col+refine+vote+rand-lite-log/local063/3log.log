```sql
-- 4) Look at sample sales that satisfy:  U-S customer  +  promo_id = 999
SELECT DISTINCT s.prod_id,
       s.cust_id,
       s.time_id,
       s.amount_sold
FROM   sales      AS s
JOIN   customers  AS c  ON s.cust_id = c.cust_id
JOIN   countries  AS co ON c.country_id = co.country_id
WHERE  co.country_iso_code IN ('US','USA')
  AND  s.promo_id = 999
LIMIT 20;
```

```sql
-- 5) Aggregate those sales by (city , quarter) for the two quarters
SELECT   c.cust_city,
         t.calendar_quarter_id,
         SUM(s.amount_sold)  AS city_quarter_sales
FROM     sales      AS s
JOIN     customers  AS c  ON s.cust_id = c.cust_id
JOIN     countries  AS co ON c.country_id = co.country_id
JOIN     times      AS t  ON s.time_id   = t.time_id
WHERE    co.country_iso_code IN ('US','USA')
  AND    s.promo_id = 999
  AND    t.calendar_quarter_id IN (1772,1776)
GROUP BY c.cust_city,
         t.calendar_quarter_id
LIMIT 20;
```

```sql
-- 6) Keep only those cities whose Q4-2020 sales ≥ 120 % of Q4-2019 sales
WITH city_tot AS (
    SELECT c.cust_city,
           t.calendar_quarter_id  AS qid,
           SUM(s.amount_sold)     AS amt
    FROM   sales      AS s
    JOIN   customers  AS c  ON s.cust_id = c.cust_id
    JOIN   countries  AS co ON c.country_id = co.country_id
    JOIN   times      AS t  ON s.time_id   = t.time_id
    WHERE  co.country_iso_code IN ('US','USA')
      AND  s.promo_id = 999
      AND  t.calendar_quarter_id IN (1772,1776)
    GROUP  BY c.cust_city, t.calendar_quarter_id
)
SELECT a.cust_city
FROM   city_tot  AS a
JOIN   city_tot  AS b
       ON a.cust_city = b.cust_city
      AND a.qid = 1772              -- Q4-2019
      AND b.qid = 1776              -- Q4-2020
WHERE  b.amt >= 1.2 * a.amt         -- ≥ 20 % increase
LIMIT 20;
```

```sql
-- 7) For those “growth” cities, total product sales per quarter
WITH growth_cities AS (
    -- reuse previous CTE
    WITH city_tot AS (
        SELECT c.cust_city, t.calendar_quarter_id AS qid, SUM(s.amount_sold) AS amt
        FROM   sales AS s
        JOIN   customers AS c  ON s.cust_id = c.cust_id
        JOIN   countries AS co ON c.country_id = co.country_id
        JOIN   times     AS t  ON s.time_id   = t.time_id
        WHERE  co.country_iso_code IN ('US','USA')
          AND  s.promo_id = 999
          AND  t.calendar_quarter_id IN (1772,1776)
        GROUP  BY c.cust_city, t.calendar_quarter_id
    )
    SELECT DISTINCT a.cust_city
    FROM   city_tot AS a
    JOIN   city_tot AS b
           ON a.cust_city = b.cust_city
          AND a.qid = 1772
          AND b.qid = 1776
    WHERE  b.amt >= 1.2 * a.amt
)
SELECT   s.prod_id,
         t.calendar_quarter_id,
         SUM(s.amount_sold) AS prod_quarter_sales
FROM     sales     AS s
JOIN     customers AS c  ON s.cust_id = c.cust_id
JOIN     growth_cities gc ON gc.cust_city = c.cust_city
JOIN     times     AS t  ON s.time_id = t.time_id
WHERE    s.promo_id = 999
  AND    t.calendar_quarter_id IN (1772,1776)
GROUP BY s.prod_id, t.calendar_quarter_id
LIMIT 20;
```

```sql
-- 8) Compute each product’s share of total sales for each quarter
WITH prod_qtr_sales AS (
    -- same content as previous query without LIMIT
    SELECT   s.prod_id,
             t.calendar_quarter_id AS qid,
             SUM(s.amount_sold)    AS amt
    FROM     sales     AS s
    JOIN     customers AS c  ON s.cust_id = c.cust_id
    JOIN     (<same growth_cities CTE>) AS gc ON gc.cust_city = c.cust_city
    JOIN     times     AS t  ON s.time_id = t.time_id
    WHERE    s.promo_id = 999
      AND    t.calendar_quarter_id IN (1772,1776)
    GROUP BY s.prod_id, t.calendar_quarter_id
),
totals AS (
    SELECT qid, SUM(amt) AS qtr_total
    FROM   prod_qtr_sales
    GROUP  BY qid
)
SELECT p.prod_id,
       p.qid,
       ROUND(100.0 * p.amt / t.qtr_total, 2) AS pct_share
FROM   prod_qtr_sales AS p
JOIN   totals        AS t ON p.qid = t.qid
LIMIT 20;
```

```sql
-- 9) Rank products by their combined sales (both quarters) and keep top 20 %
WITH prod_tot AS (
    SELECT   prod_id, SUM(amt) AS grand_total
    FROM     (<prod_qtr_sales from previous CTE>)
    GROUP BY prod_id
),
ranked AS (
    SELECT prod_id,
           grand_total,
           RANK() OVER (ORDER BY grand_total DESC)  AS rnk,
           COUNT(*) OVER ()                         AS cnt
    FROM   prod_tot
)
SELECT prod_id,
       grand_total
FROM   ranked
WHERE  rnk <= CEIL(0.20 * cnt)     -- top 20 %
ORDER  BY grand_total DESC
LIMIT 20;
```

```sql
-- 10) Among those top-20 % products, find the one with the smallest change in share
WITH prod_qtr_sales AS ( /* same as used earlier */ ),
totals AS ( SELECT qid, SUM(amt) AS qtr_total
            FROM prod_qtr_sales GROUP BY qid ),
shares AS (
    SELECT p.prod_id,
           p.qid,
           1.0 * p.amt / t.qtr_total  AS share
    FROM   prod_qtr_sales AS p
    JOIN   totals        AS t ON p.qid = t.qid
),
pivot AS (
    SELECT  s2019.prod_id,
            s2019.share AS share_2019,
            s2020.share AS share_2020,
            ABS(s2020.share - s2019.share) AS delta
    FROM    shares AS s2019
    JOIN    shares AS s2020
            ON s2019.prod_id = s2020.prod_id
           AND s2019.qid = 1772
           AND s2020.qid = 1776
),
top20 AS ( /* same as ranked query above */ )
SELECT  p.prod_id,
        p.share_2019,
        p.share_2020,
        ROUND(100.0 * p.delta, 4) AS pct_point_change
FROM    pivot AS p
JOIN    top20 AS t20 ON t20.prod_id = p.prod_id
ORDER BY p.delta ASC
LIMIT 20;
```
