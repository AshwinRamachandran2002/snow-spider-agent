```sql
-- 1. Check which Mondays are in our dataset around the target date
SELECT DISTINCT week_date
FROM cleaned_weekly_sales
WHERE week_date BETWEEN '2020-03-01' AND '2020-10-01'
ORDER BY week_date
LIMIT 20;
```

```sql
-- 2. Overall sales 12-weeks BEFORE vs 12-weeks AFTER 15-Jun-2020
WITH
before AS (
  SELECT SUM(sales) AS sales_before
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-03-23' AND '2020-06-07'   -- 12 Mondays
),
after AS (
  SELECT SUM(sales) AS sales_after
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-06-22' AND '2020-09-07'   -- 12 Mondays
)
SELECT *
FROM before, after
LIMIT 20;
```

```sql
-- 3. Region-level sales BEFORE vs AFTER and % change
WITH
before AS (
  SELECT region, SUM(sales) AS sales_before
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP BY region
),
after AS (
  SELECT region, SUM(sales) AS sales_after
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP BY region
)
SELECT b.region,
       b.sales_before,
       a.sales_after,
       ROUND( (a.sales_after - b.sales_before)*1.0 / b.sales_before * 100, 2) AS pct_change
FROM before b
JOIN after  a USING (region)
ORDER BY pct_change
LIMIT 20;
```

