-- 3. Region-level sales BEFORE vs AFTER and % change
WITH
before AS (
  SELECT region, SUM(sales) AS sales_before
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP BY region
),
after AS (
  SELECT region, SUM(sales) AS sales_after
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP BY region
)
SELECT b.region,
       b.sales_before,
       a.sales_after,
       ROUND( (a.sales_after - b.sales_before)*1.0 / b.sales_before * 100, 2) AS pct_change
FROM before b
JOIN after  a USING (region)
ORDER BY pct_change
LIMIT 20;
