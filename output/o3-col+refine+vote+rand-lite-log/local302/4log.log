Query:
--Description:  Corrected version of SQL #9 ― identifies which attribute type
--              (region, platform, age_band, demographic, customer_type) suffered
--              the lowest (most-negative) average % change in sales between the
--              12 weeks BEFORE (2020-03-23→2020-06-07) and AFTER
--              (2020-06-22→2020-09-07) 15-Jun-2020.
--              The earlier error came from grouping by an alias
--              (attribute_type) that did not yet exist; here we avoid that by
--              building the five averages explicitly, then ordering them.

WITH
--------------------------------------------------------------------
--  BASE DATA (needed only once)
--------------------------------------------------------------------
base AS (
  SELECT week_date,
         region,
         platform,
         age_band,
         demographic,
         customer_type,
         sales
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-09-07'
),
--------------------------------------------------------------------
--  BEFORE / AFTER TOTALS FOR EVERY ATTRIBUTE VALUE
--------------------------------------------------------------------
before_tot AS (
  SELECT region, platform, age_band, demographic, customer_type,
         SUM(sales) AS sales_before
  FROM   base
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP  BY region, platform, age_band, demographic, customer_type
),
after_tot AS (
  SELECT region, platform, age_band, demographic, customer_type,
         SUM(sales) AS sales_after
  FROM   base
  WHERE  week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP  BY region, platform, age_band, demographic, customer_type
),
--------------------------------------------------------------------
--  % CHANGE FOR EVERY COMBINATION OF ATTRIBUTES
--------------------------------------------------------------------
change AS (
  SELECT b.region,
         b.platform,
         b.age_band,
         b.demographic,
         b.customer_type,
         100.0 * (a.sales_after - b.sales_before) / b.sales_before AS pct_change
  FROM   before_tot b
  JOIN   after_tot  a
         USING (region, platform, age_band, demographic, customer_type)
),
--------------------------------------------------------------------
--  AVERAGE % CHANGE INSIDE EACH ATTRIBUTE TYPE
--------------------------------------------------------------------
avg_changes AS (
    /* region */
    SELECT 'region'        AS attribute_type,
           AVG(pct_change) AS avg_pct_change
    FROM   (
             SELECT region, AVG(pct_change) AS pct_change
             FROM   change
             GROUP  BY region
           )

    UNION ALL

    /* platform */
    SELECT 'platform',
           AVG(pct_change)
    FROM   (
             SELECT platform, AVG(pct_change) AS pct_change
             FROM   change
             GROUP  BY platform
           )

    UNION ALL

    /* age_band */
    SELECT 'age_band',
           AVG(pct_change)
    FROM   (
             SELECT age_band, AVG(pct_change) AS pct_change
             FROM   change
             GROUP  BY age_band
           )

    UNION ALL

    /* demographic */
    SELECT 'demographic',
           AVG(pct_change)
    FROM   (
             SELECT demographic, AVG(pct_change) AS pct_change
             FROM   change
             GROUP  BY demographic
           )

    UNION ALL

    /* customer_type */
    SELECT 'customer_type',
           AVG(pct_change)
    FROM   (
             SELECT customer_type, AVG(pct_change) AS pct_change
             FROM   change
             GROUP  BY customer_type
           )
)

SELECT attribute_type,
       ROUND(avg_pct_change, 2) AS avg_pct_change
FROM   avg_changes
ORDER  BY avg_pct_change     -- most-negative first
LIMIT 20
