```sql
-- 8. Average % change ACROSS values for EACH attribute type
WITH
base AS (
  SELECT week_date,
         region,
         platform,
         age_band,
         demographic,
         customer_type,
         sales
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-03-23' AND '2020-09-07'
),
before AS (
  SELECT region, platform, age_band, demographic, customer_type, SUM(sales) AS sales_before
  FROM base
  WHERE week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP BY region, platform, age_band, demographic, customer_type
),
after AS (
  SELECT region, platform, age_band, demographic, customer_type, SUM(sales) AS sales_after
  FROM base
  WHERE week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP BY region, platform, age_band, demographic, customer_type
),
change AS (
  SELECT b.region, b.platform, b.age_band, b.demographic, b.customer_type,
         (a.sales_after - b.sales_before)*1.0 / b.sales_before * 100 AS pct_change
  FROM before b
  JOIN after  a USING (region, platform, age_band, demographic, customer_type)
)
SELECT 'region'        AS attribute_type, ROUND(AVG(pct_change),2) AS avg_pct_change FROM change GROUP BY attribute_type
UNION ALL
SELECT 'platform',      ROUND(AVG(pct_change),2) FROM change GROUP BY attribute_type
UNION ALL
SELECT 'age_band',      ROUND(AVG(pct_change),2) FROM change GROUP BY attribute_type
UNION ALL
SELECT 'demographic',   ROUND(AVG(pct_change),2) FROM change GROUP BY attribute_type
UNION ALL
SELECT 'customer_type', ROUND(AVG(pct_change),2) FROM change GROUP BY attribute_type
LIMIT 20;
```

```sql
-- 9. Identify the attribute type with the WORST (most negative) average % change
WITH
base AS (
  SELECT week_date,
         region,
         platform,
         age_band,
         demographic,
         customer_type,
         sales
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-03-23' AND '2020-09-07'
),
before AS (
  SELECT region, platform, age_band, demographic, customer_type, SUM(sales) AS sales_before
  FROM base
  WHERE week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP BY region, platform, age_band, demographic, customer_type
),
after AS (
  SELECT region, platform, age_band, demographic, customer_type, SUM(sales) AS sales_after
  FROM base
  WHERE week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP BY region, platform, age_band, demographic, customer_type
),
change AS (
  SELECT b.region, b.platform, b.age_band, b.demographic, b.customer_type,
         (a.sales_after - b.sales_before)*1.0 / b.sales_before * 100 AS pct_change
  FROM before b
  JOIN after  a USING (region, platform, age_band, demographic, customer_type)
),
avg_change AS (
  SELECT 'region'        AS attribute_type, AVG(pct_change) AS avg_pct_change FROM change GROUP BY attribute_type
  UNION ALL
  SELECT 'platform',      AVG(pct_change) FROM change GROUP BY attribute_type
  UNION ALL
  SELECT 'age_band',      AVG(pct_change) FROM change GROUP BY attribute_type
  UNION ALL
  SELECT 'demographic',   AVG(pct_change) FROM change GROUP BY attribute_type
  UNION ALL
  SELECT 'customer_type', AVG(pct_change) FROM change GROUP BY attribute_type
)
SELECT attribute_type,
       ROUND(avg_pct_change,2) AS avg_pct_change
FROM   avg_change
ORDER BY avg_pct_change           -- most negative will appear first
LIMIT 20;
```

Running query #9 returns the attribute type whose average percentage change is the lowest (i.e., the highest negative impact) along with its average % change across all of its values.
