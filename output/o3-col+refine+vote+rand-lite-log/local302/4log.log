--Description (thinking process):
-- 1. Define the 12-week “before” window (2020-03-23 → 2020-06-07) and the
--    12-week “after” window (2020-06-22 → 2020-09-07) around 15-Jun-2020.
-- 2. For each attribute type (region, platform, age_band, demographic,
--    customer_type) aggregate total sales in the BEFORE and AFTER windows.
-- 3. For every attribute value compute
--        pct_change = 100 * (after − before) / before
-- 4. Take the average pct_change for all values within each attribute type.
-- 5. Return the five attribute types with their average % change, ordering
--    from the most-negative (largest drop in sales) to the most-positive.
WITH
--------------------------------------------------------------------
--  REGION
--------------------------------------------------------------------
before_region AS (
  SELECT region, SUM(sales) AS sales_before
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP  BY region
),
after_region AS (
  SELECT region, SUM(sales) AS sales_after
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP  BY region
),
pct_region AS (
  SELECT 100.0 * (ar.sales_after - br.sales_before) / br.sales_before AS pct_change
  FROM   after_region ar
  JOIN   before_region br USING (region)
),
--------------------------------------------------------------------
--  PLATFORM
--------------------------------------------------------------------
before_platform AS (
  SELECT platform, SUM(sales) AS sales_before
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP  BY platform
),
after_platform AS (
  SELECT platform, SUM(sales) AS sales_after
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP  BY platform
),
pct_platform AS (
  SELECT 100.0 * (ap.sales_after - bp.sales_before) / bp.sales_before AS pct_change
  FROM   after_platform ap
  JOIN   before_platform bp USING (platform)
),
--------------------------------------------------------------------
--  AGE BAND
--------------------------------------------------------------------
before_age AS (
  SELECT age_band, SUM(sales) AS sales_before
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP  BY age_band
),
after_age AS (
  SELECT age_band, SUM(sales) AS sales_after
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP  BY age_band
),
pct_age AS (
  SELECT 100.0 * (aa.sales_after - ba.sales_before) / ba.sales_before AS pct_change
  FROM   after_age aa
  JOIN   before_age ba USING (age_band)
),
--------------------------------------------------------------------
--  DEMOGRAPHIC
--------------------------------------------------------------------
before_demo AS (
  SELECT demographic, SUM(sales) AS sales_before
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP  BY demographic
),
after_demo AS (
  SELECT demographic, SUM(sales) AS sales_after
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP  BY demographic
),
pct_demo AS (
  SELECT 100.0 * (ad.sales_after - bd.sales_before) / bd.sales_before AS pct_change
  FROM   after_demo ad
  JOIN   before_demo bd USING (demographic)
),
--------------------------------------------------------------------
--  CUSTOMER TYPE
--------------------------------------------------------------------
before_cust AS (
  SELECT customer_type, SUM(sales) AS sales_before
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-07'
  GROUP  BY customer_type
),
after_cust AS (
  SELECT customer_type, SUM(sales) AS sales_after
  FROM   cleaned_weekly_sales
  WHERE  week_date BETWEEN '2020-06-22' AND '2020-09-07'
  GROUP  BY customer_type
),
pct_cust AS (
  SELECT 100.0 * (ac.sales_after - bc.sales_before) / bc.sales_before AS pct_change
  FROM   after_cust ac
  JOIN   before_cust bc USING (customer_type)
),
--------------------------------------------------------------------
--  AVERAGE %-CHANGE FOR EACH ATTRIBUTE TYPE
--------------------------------------------------------------------
avg_changes AS (
  SELECT 'region'        AS attribute_type, AVG(pct_change) AS avg_pct_change FROM pct_region
  UNION ALL
  SELECT 'platform',      AVG(pct_change) FROM pct_platform
  UNION ALL
  SELECT 'age_band',      AVG(pct_change) FROM pct_age
  UNION ALL
  SELECT 'demographic',   AVG(pct_change) FROM pct_demo
  UNION ALL
  SELECT 'customer_type', AVG(pct_change) FROM pct_cust
)
SELECT attribute_type,
       ROUND(avg_pct_change, 2) AS avg_pct_change
FROM   avg_changes
ORDER  BY avg_pct_change            -- most-negative first
LIMIT 20;
