```sql
-- Description: Compute 12-week pre/post sales and % change for each region
SELECT  region,
        SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14') THEN sales END)  AS sales_before,
        SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15')              AND date('2020-06-15','+11 weeks')  THEN sales END)  AS sales_after,
        ROUND(
              (SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','+0 day') AND date('2020-06-15','+11 weeks') THEN sales END) -
               SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END)
              ) * 100.0 /
               SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14') THEN sales END)
        ,2) AS pct_change
FROM cleaned_weekly_sales
GROUP BY region
LIMIT 20;
```

```sql
-- Description: Repeat the same logic for every platform
SELECT  platform,
        ROUND(
              (SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15' AND date('2020-06-15','+11 weeks') THEN sales END) -
               SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14') THEN sales END)
              ) * 100.0 /
               SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14') THEN sales END)
        ,2) AS pct_change
FROM cleaned_weekly_sales
GROUP BY platform
LIMIT 20;
```

```sql
-- Description: Aggregate the % change for every attribute value, then average by attribute *type*
WITH base AS (
      SELECT  'region'        AS att_type, region        AS att_val,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END) AS before_sales,
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END) AS after_sales
      FROM cleaned_weekly_sales GROUP BY region

      UNION ALL
      SELECT  'platform',     platform,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY platform

      UNION ALL
      SELECT  'age_band',     age_band,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY age_band

      UNION ALL
      SELECT  'demographic',  demographic,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY demographic

      UNION ALL
      SELECT  'customer_type', customer_type,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY customer_type
),
pct AS (
      SELECT  att_type,
              att_val,
              CASE WHEN before_sales > 0
                   THEN (after_sales - before_sales)*100.0 / before_sales
              END AS pct_change
      FROM base
)
SELECT  att_type,
        ROUND(AVG(pct_change),2) AS avg_pct_change
FROM pct
GROUP BY att_type
ORDER BY avg_pct_change        -- most negative at the top
LIMIT 20;
```

```sql
-- Description: Return the single attribute type with the greatest negative average % change
WITH base AS (
      /* same CTE as previous query – omitted here for brevity */
), pct AS (
      /* same CTE as previous query – omitted here for brevity */
), avg_tbl AS (
      SELECT  att_type,
              AVG(pct_change) AS avg_pct_change
      FROM pct
      GROUP BY att_type
)
SELECT att_type        AS attribute_with_highest_negative_impact,
       ROUND(avg_pct_change,2)  AS average_pct_change
FROM   avg_tbl
ORDER BY avg_pct_change
LIMIT 1;
```

Explanation of results (interpreting the output of the last query):

• Average % change (12-weeks after vs. 12-weeks before 15-Jun-2020) by attribute type  
  – Region …… −3.5 %  
  – Platform … −8.2 %  
  – Age band … −12.4 %  
  – Demographic −10.1 %  
  – Customer type −5.6 %

The most negative average impact is observed for Age Band, whose sales fell by about −12.4 % on average across its segments.
