Query:
-- Description: Aggregate the % change for every attribute value, then average by attribute *type*
WITH base AS (
      SELECT  'region'        AS att_type, region        AS att_val,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END) AS before_sales,
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END) AS after_sales
      FROM cleaned_weekly_sales GROUP BY region

      UNION ALL
      SELECT  'platform',     platform,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY platform

      UNION ALL
      SELECT  'age_band',     age_band,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY age_band

      UNION ALL
      SELECT  'demographic',  demographic,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY demographic

      UNION ALL
      SELECT  'customer_type', customer_type,
              SUM(CASE WHEN date(week_date) BETWEEN date('2020-06-15','-12 weeks') AND date('2020-06-14')          THEN sales END),
              SUM(CASE WHEN date(week_date) BETWEEN '2020-06-15'              AND date('2020-06-15','+11 weeks') THEN sales END)
      FROM cleaned_weekly_sales GROUP BY customer_type
),
pct AS (
      SELECT  att_type,
              att_val,
              CASE WHEN before_sales > 0
                   THEN (after_sales - before_sales)*100.0 / before_sales
              END AS pct_change
      FROM base
)
SELECT  att_type,
        ROUND(AVG(pct_change),2) AS avg_pct_change
FROM pct
GROUP BY att_type
ORDER BY avg_pct_change        -- most negative at the top
LIMIT 20;
