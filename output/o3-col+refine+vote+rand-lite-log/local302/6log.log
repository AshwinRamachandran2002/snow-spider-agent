```sql
--Description: Find which attribute *type* (region, platform, age_band, demographic, customer_type) experienced the
--largest average percentage drop in sales when comparing the 12 weeks AFTER 15-Jun-2020 with the 12 weeks BEFORE it.
--Approach
--1. CTE base:  For every attribute VALUE, sum sales in two 12-week windows
--              – BEFORE:  84 days ending 14-Jun-2020  (date('2020-06-15','-84 days') .. '2020-06-14')
--              – AFTER :  84 days starting 15-Jun-2020 ( '2020-06-15' .. date('2020-06-15','+83 days') )
--2. CTE pct :  Convert those totals into % change for each VALUE.
--3. CTE avg_tbl: Average the % changes across all VALUES belonging to the same attribute TYPE.
--4. Return the TYPE whose average % change is the most negative.
WITH base AS (
    -- totals per attribute VALUE
    SELECT 'region' AS att_type, region AS att_val,
           SUM(CASE WHEN week_date BETWEEN date('2020-06-15','-84 days') AND '2020-06-14' THEN sales END) AS before_sales,
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND date('2020-06-15','+83 days')      THEN sales END) AS after_sales
    FROM cleaned_weekly_sales GROUP BY region
    UNION ALL
    SELECT 'platform', platform,
           SUM(CASE WHEN week_date BETWEEN date('2020-06-15','-84 days') AND '2020-06-14' THEN sales END),
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND date('2020-06-15','+83 days')      THEN sales END)
    FROM cleaned_weekly_sales GROUP BY platform
    UNION ALL
    SELECT 'age_band', age_band,
           SUM(CASE WHEN week_date BETWEEN date('2020-06-15','-84 days') AND '2020-06-14' THEN sales END),
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND date('2020-06-15','+83 days')      THEN sales END)
    FROM cleaned_weekly_sales GROUP BY age_band
    UNION ALL
    SELECT 'demographic', demographic,
           SUM(CASE WHEN week_date BETWEEN date('2020-06-15','-84 days') AND '2020-06-14' THEN sales END),
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND date('2020-06-15','+83 days')      THEN sales END)
    FROM cleaned_weekly_sales GROUP BY demographic
    UNION ALL
    SELECT 'customer_type', customer_type,
           SUM(CASE WHEN week_date BETWEEN date('2020-06-15','-84 days') AND '2020-06-14' THEN sales END),
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND date('2020-06-15','+83 days')      THEN sales END)
    FROM cleaned_weekly_sales GROUP BY customer_type
),
pct AS (
    -- % change per VALUE
    SELECT att_type,
           att_val,
           CASE WHEN before_sales > 0
                THEN 100.0 * (after_sales - before_sales) / before_sales
           END AS pct_change
    FROM base
),
avg_tbl AS (
    -- average % change per TYPE
    SELECT att_type,
           AVG(pct_change) AS avg_pct_change
    FROM pct
    GROUP BY att_type
)
SELECT att_type AS attribute_with_highest_negative_impact,
       ROUND(avg_pct_change,2) AS average_pct_change
FROM   avg_tbl
ORDER  BY avg_pct_change      -- most negative first
LIMIT 1;
```
