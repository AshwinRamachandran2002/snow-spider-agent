```sql
-- 8.  Region-level sales totals for the 12 weeks AFTER 15-Jun-2020
SELECT
       "region",
       SUM("sales")      AS sales_after
FROM   "cleaned_weekly_sales"
WHERE  "week_date" >= '2020-06-15'
  AND  "week_date" <= '2020-08-31'            -- 11 Mondays after + pivot week
GROUP  BY "region"
LIMIT 20;
```

```sql
-- 9.  Region-level percentage change between the two periods
WITH before AS (
        SELECT "region", SUM("sales") AS sales_before
        FROM   "cleaned_weekly_sales"
        WHERE  "week_date" >= '2020-03-23'
          AND  "week_date" <  '2020-06-15'
        GROUP  BY "region"),
     after  AS (
        SELECT "region", SUM("sales") AS sales_after
        FROM   "cleaned_weekly_sales"
        WHERE  "week_date" >= '2020-06-15'
          AND  "week_date" <= '2020-08-31'
        GROUP  BY "region")
SELECT a."region",
       ROUND(100.0*(a.sales_after - b.sales_before)/b.sales_before,2) AS pct_change
FROM   after a
JOIN   before b USING ("region")
ORDER  BY pct_change
LIMIT 20;
```

```sql
-- 10.  Repeat the logic for all five attribute types and take the
--      average %-change for each attribute type
WITH params(attr_col) AS (
  VALUES ('region'), ('platform'), ('age_band'),
         ('demographic'), ('customer_type')
),
before AS (
  SELECT *,
         CASE WHEN attr = 'region'        THEN "region"
              WHEN attr = 'platform'      THEN "platform"
              WHEN attr = 'age_band'      THEN "age_band"
              WHEN attr = 'demographic'   THEN "demographic"
              ELSE                             "customer_type"
         END AS attribute_value
  FROM (
        SELECT 'region'      AS attr, * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'platform',      * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'age_band',      * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'demographic',   * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'customer_type', * FROM "cleaned_weekly_sales"
       )
  WHERE "week_date" >= '2020-03-23' AND "week_date" < '2020-06-15'
),
after AS (
  SELECT *,
         CASE WHEN attr = 'region'        THEN "region"
              WHEN attr = 'platform'      THEN "platform"
              WHEN attr = 'age_band'      THEN "age_band"
              WHEN attr = 'demographic'   THEN "demographic"
              ELSE                             "customer_type"
         END AS attribute_value
  FROM (
        SELECT 'region'      AS attr, * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'platform',      * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'age_band',      * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'demographic',   * FROM "cleaned_weekly_sales"
        UNION ALL SELECT 'customer_type', * FROM "cleaned_weekly_sales"
       )
  WHERE "week_date" >= '2020-06-15' AND "week_date" <= '2020-08-31'
),
before_sum AS (
  SELECT attr, attribute_value, SUM("sales") AS sales_before
  FROM   before
  GROUP  BY attr, attribute_value
),
after_sum AS (
  SELECT attr, attribute_value, SUM("sales") AS sales_after
  FROM   after
  GROUP  BY attr, attribute_value
)
SELECT  b.attr                     AS attribute_type,
        ROUND(AVG(100.0*(a.sales_after - b.sales_before)/b.sales_before),2)
                                       AS avg_pct_change
FROM    before_sum b
JOIN    after_sum  a
        ON a.attr = b.attr AND a.attribute_value = b.attribute_value
GROUP   BY b.attr
ORDER   BY avg_pct_change;
```

