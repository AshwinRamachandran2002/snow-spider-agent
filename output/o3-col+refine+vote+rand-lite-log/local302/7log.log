-- 9.  Region-level percentage change between the two periods
WITH before AS (
        SELECT "region", SUM("sales") AS sales_before
        FROM   "cleaned_weekly_sales"
        WHERE  "week_date" >= '2020-03-23'
          AND  "week_date" <  '2020-06-15'
        GROUP  BY "region"),
     after  AS (
        SELECT "region", SUM("sales") AS sales_after
        FROM   "cleaned_weekly_sales"
        WHERE  "week_date" >= '2020-06-15'
          AND  "week_date" <= '2020-08-31'
        GROUP  BY "region")
SELECT a."region",
       ROUND(100.0*(a.sales_after - b.sales_before)/b.sales_before,2) AS pct_change
FROM   after a
JOIN   before b USING ("region")
ORDER  BY pct_change
LIMIT 20;
