```sql
-- 7. 12-week PRE vs POST sales by region
SELECT region,
       SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-07' THEN sales END) AS pre_sales,
       SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-08-31' THEN sales END) AS post_sales
FROM cleaned_weekly_sales
WHERE week_date BETWEEN '2020-03-23' AND '2020-08-31'
GROUP BY region
LIMIT 20;
```

```sql
-- 8. Region-level percentage change in the two windows
SELECT region,
       ROUND(100.0 * (post_sales - pre_sales) / pre_sales, 2) AS pct_change
FROM (
      SELECT region,
             SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-07' THEN sales END) AS pre_sales,
             SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-08-31' THEN sales END) AS post_sales
      FROM cleaned_weekly_sales
      WHERE week_date BETWEEN '2020-03-23' AND '2020-08-31'
      GROUP BY region
) r
LIMIT 20;
```

```sql
-- 9. Generic helper: produce pct-change for ANY attribute column
--    (here shown for platform as an example)
SELECT platform,
       ROUND(100.0 * (post_sales - pre_sales) / pre_sales, 2) AS pct_change
FROM (
      SELECT platform,
             SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-07' THEN sales END) AS pre_sales,
             SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-08-31' THEN sales END) AS post_sales
      FROM cleaned_weekly_sales
      WHERE week_date BETWEEN '2020-03-23' AND '2020-08-31'
      GROUP BY platform
) p
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER:
--     Average pct-change for every attribute type and
--     the one with the greatest negative impact on sales
WITH
pre_post AS (
  SELECT
    region,
    platform,
    age_band,
    demographic,
    customer_type,
    SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-07' THEN sales END) AS pre_sales,
    SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-08-31' THEN sales END) AS post_sales
  FROM cleaned_weekly_sales
  WHERE week_date BETWEEN '2020-03-23' AND '2020-08-31'
  GROUP BY region, platform, age_band, demographic, customer_type
),

pct_changes AS (
  SELECT
    region,
    platform,
    age_band,
    demographic,
    customer_type,
    100.0 * (post_sales - pre_sales) / pre_sales AS pct_change
  FROM pre_post
)

SELECT 'region'         AS attribute_type, ROUND(AVG(pct_change),2) AS avg_pct_change FROM pct_changes GROUP BY attribute_type
UNION ALL
SELECT 'platform'       AS attribute_type, ROUND(AVG(pct_change),2) FROM pct_changes GROUP BY attribute_type
UNION ALL
SELECT 'age_band'       AS attribute_type, ROUND(AVG(pct_change),2) FROM pct_changes GROUP BY attribute_type
UNION ALL
SELECT 'demographic'    AS attribute_type, ROUND(AVG(pct_change),2) FROM pct_changes GROUP BY attribute_type
UNION ALL
SELECT 'customer_type'  AS attribute_type, ROUND(AVG(pct_change),2) FROM pct_changes GROUP BY attribute_type
ORDER BY avg_pct_change  -- ascending so the most negative value is on top
LIMIT 20;
```
