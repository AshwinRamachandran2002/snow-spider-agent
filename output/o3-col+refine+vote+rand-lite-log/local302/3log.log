Query:
-- 7️⃣ Description:  Calculate the average % change in SALES when comparing the
--    12 weeks BEFORE 15-Jun-2020 (23-Mar-2020 → 08-Jun-2020) with the 12 weeks
--    AFTER (15-Jun-2020 → 07-Sep-2020) for each requested attribute type.
--    The query returns one row per attribute-type with its average % change.
WITH
before AS (
    SELECT region,
           platform,
           age_band,
           demographic,
           customer_type,
           SUM(sales)   AS sales_before
    FROM   cleaned_weekly_sales
    WHERE  week_date BETWEEN '2020-03-23' AND '2020-06-08'
    GROUP  BY region, platform, age_band, demographic, customer_type
),
after AS (
    SELECT region,
           platform,
           age_band,
           demographic,
           customer_type,
           SUM(sales)   AS sales_after
    FROM   cleaned_weekly_sales
    WHERE  week_date BETWEEN '2020-06-15' AND '2020-09-07'
    GROUP  BY region, platform, age_band, demographic, customer_type
),
data AS (                            -- emulate a FULL OUTER JOIN in SQLite
    SELECT b.region,
           b.platform,
           b.age_band,
           b.demographic,
           b.customer_type,
           b.sales_before,
           COALESCE(a.sales_after,0) AS sales_after
    FROM   before b
    LEFT   JOIN after a
           USING (region, platform, age_band, demographic, customer_type)
    UNION ALL
    SELECT a.region,
           a.platform,
           a.age_band,
           a.demographic,
           a.customer_type,
           COALESCE(b.sales_before,0) AS sales_before,
           a.sales_after
    FROM   after a
    LEFT   JOIN before b
           USING (region, platform, age_band, demographic, customer_type)
    WHERE  b.sales_before IS NULL
),
-- % change per individual attribute value  (= (after-before)/before × 100)
r_pct  AS (SELECT region        AS attr, (sales_after - sales_before)*1.0/sales_before*100 AS pct FROM data WHERE sales_before>0),
p_pct  AS (SELECT platform      AS attr, (sales_after - sales_before)*1.0/sales_before*100 AS pct FROM data WHERE sales_before>0),
a_pct  AS (SELECT age_band      AS attr, (sales_after - sales_before)*1.0/sales_before*100 AS pct FROM data WHERE sales_before>0),
d_pct  AS (SELECT demographic   AS attr, (sales_after - sales_before)*1.0/sales_before*100 AS pct FROM data WHERE sales_before>0),
c_pct  AS (SELECT customer_type AS attr, (sales_after - sales_before)*1.0/sales_before*100 AS pct FROM data WHERE sales_before>0)
SELECT 'region'        AS attribute_type, AVG(pct) AS avg_pct_change FROM r_pct
UNION ALL
SELECT 'platform'      AS attribute_type, AVG(pct) FROM p_pct
UNION ALL
SELECT 'age_band'      AS attribute_type, AVG(pct) FROM a_pct
UNION ALL
SELECT 'demographic'   AS attribute_type, AVG(pct) FROM d_pct
UNION ALL
SELECT 'customer_type' AS attribute_type, AVG(pct) FROM c_pct
LIMIT 20;
