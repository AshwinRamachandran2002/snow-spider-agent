--Description: Calculate the % change in sales for each Platform 
--for the same 24-week window.
WITH base AS (
    SELECT  "platform",
            "sales",
            CASE 
                WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-08' THEN 'before'
                WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-07' THEN 'after'
            END AS period
    FROM    "cleaned_weekly_sales"
    WHERE   "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
)
SELECT  "platform",
        ROUND( (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
                SUM(CASE WHEN period='before' THEN sales END) - 1) * 100 , 2) 
        AS pct_change_sales
FROM    base
GROUP BY "platform"
LIMIT 20;
