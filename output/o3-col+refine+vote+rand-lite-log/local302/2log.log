```sql
--Description: Calculate the % change in sales for each Region 
--(12 weeks before vs. 12 weeks after 15-Jun-2020).
WITH base AS (
    SELECT  "region",
            "sales",
            CASE 
                WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-08' THEN 'before'
                WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-07' THEN 'after'
            END AS period
    FROM    "cleaned_weekly_sales"
    WHERE   "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
)
SELECT  "region",
        ROUND( (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
                SUM(CASE WHEN period='before' THEN sales END) - 1) * 100 , 2) 
        AS pct_change_sales
FROM    base
GROUP BY "region"
LIMIT 20;
```

```sql
--Description: Calculate the % change in sales for each Platform 
--for the same 24-week window.
WITH base AS (
    SELECT  "platform",
            "sales",
            CASE 
                WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-08' THEN 'before'
                WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-07' THEN 'after'
            END AS period
    FROM    "cleaned_weekly_sales"
    WHERE   "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
)
SELECT  "platform",
        ROUND( (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
                SUM(CASE WHEN period='before' THEN sales END) - 1) * 100 , 2) 
        AS pct_change_sales
FROM    base
GROUP BY "platform"
LIMIT 20;
```

```sql
--Description: Compute the average % change in sales for each attribute type
--(region, platform, age_band, demographic, customer_type).
WITH windowed AS (
    SELECT  "week_date",
            "region",
            "platform",
            "age_band",
            "demographic",
            "customer_type",
            "sales",
            CASE 
                WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-08' THEN 'before'
                WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-07' THEN 'after'
            END AS period
    FROM    "cleaned_weekly_sales"
    WHERE   "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
), 
calc AS (
    -- Region-level
    SELECT 'region' AS attr_type,
           "region" AS attr_value,
           (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100 AS pct_change
    FROM windowed GROUP BY "region"

    UNION ALL
    -- Platform-level
    SELECT 'platform', "platform",
           (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "platform"

    UNION ALL
    -- Age-band-level
    SELECT 'age_band', "age_band",
           (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "age_band"

    UNION ALL
    -- Demographic-level
    SELECT 'demographic', "demographic",
           (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "demographic"

    UNION ALL
    -- Customer-type-level
    SELECT 'customer_type', "customer_type",
           (SUM(CASE WHEN period='after'  THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "customer_type"
),
avg_change AS (
    SELECT  attr_type,
            AVG(pct_change) AS avg_pct_change
    FROM    calc
    GROUP BY attr_type
)
SELECT * FROM avg_change
ORDER BY avg_pct_change
LIMIT 20;
```

```sql
--Description: Identify the single attribute type that shows 
--the largest average decline (most negative % change) in sales.
WITH windowed AS (
    SELECT  "week_date","region","platform","age_band","demographic","customer_type","sales",
            CASE 
                WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-08' THEN 'before'
                WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-07' THEN 'after'
            END AS period
    FROM "cleaned_weekly_sales"
    WHERE "week_date" BETWEEN '2020-03-23' AND '2020-09-07'
), 
calc AS (
    SELECT 'region'        AS attr_type, "region"        AS attr_value, 
           (SUM(CASE WHEN period='after' THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100 AS pct_change
    FROM windowed GROUP BY "region"
    UNION ALL
    SELECT 'platform',     "platform", 
           (SUM(CASE WHEN period='after' THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "platform"
    UNION ALL
    SELECT 'age_band',     "age_band", 
           (SUM(CASE WHEN period='after' THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "age_band"
    UNION ALL
    SELECT 'demographic',  "demographic", 
           (SUM(CASE WHEN period='after' THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "demographic"
    UNION ALL
    SELECT 'customer_type',"customer_type", 
           (SUM(CASE WHEN period='after' THEN sales END)*1.0 /
            SUM(CASE WHEN period='before' THEN sales END) - 1) * 100
    FROM windowed GROUP BY "customer_type"
), 
avg_change AS (
    SELECT attr_type, AVG(pct_change) AS avg_pct_change
    FROM   calc
    GROUP  BY attr_type
)
SELECT  attr_type                AS highest_negative_impact_attr,
        ROUND(avg_pct_change,2)  AS avg_pct_change_sales
FROM    avg_change
ORDER BY avg_pct_change ASC   -- most negative first
LIMIT 1;
```
