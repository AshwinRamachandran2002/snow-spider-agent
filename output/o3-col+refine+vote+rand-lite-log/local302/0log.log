```sql
--Description: Collect the average % change for all five attribute types and identify which had the worst (most negative) average impact
WITH attr_changes AS (
     SELECT 'Region'      AS attr_type, AVG( (after_sales - before_sales) * 100.0 / before_sales ) AS avg_pct
     FROM  (SELECT "region" AS g,
                   SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END)  AS before_sales,
                   SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END)  AS after_sales
            FROM  cleaned_weekly_sales
            WHERE "calendar_year" = 2020
            GROUP BY "region")
     UNION ALL
     SELECT 'Platform',   AVG( (after_sales - before_sales) * 100.0 / before_sales )
     FROM  (SELECT "platform" AS g,
                   SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END),
                   SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END)
            FROM  cleaned_weekly_sales
            WHERE "calendar_year" = 2020
            GROUP BY "platform")
     UNION ALL
     SELECT 'Age Band',
            AVG( (after_sales - before_sales) * 100.0 / before_sales )
     FROM  (SELECT "age_band" AS g,
                   SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END),
                   SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END)
            FROM  cleaned_weekly_sales
            WHERE "calendar_year" = 2020
            GROUP BY "age_band")
     UNION ALL
     SELECT 'Demographic',
            AVG( (after_sales - before_sales) * 100.0 / before_sales )
     FROM  (SELECT "demographic" AS g,
                   SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END),
                   SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END)
            FROM  cleaned_weekly_sales
            WHERE "calendar_year" = 2020
            GROUP BY "demographic")
     UNION ALL
     SELECT 'Customer Type',
            AVG( (after_sales - before_sales) * 100.0 / before_sales )
     FROM  (SELECT "customer_type" AS g,
                   SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END),
                   SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END)
            FROM  cleaned_weekly_sales
            WHERE "calendar_year" = 2020
            GROUP BY "customer_type")
)
SELECT  attr_type,
        ROUND(avg_pct,2) AS "average_%_change",
        CASE WHEN avg_pct = (SELECT MIN(avg_pct) FROM attr_changes)
             THEN '<< Worst Impact'
        END AS flag
FROM    attr_changes
ORDER BY avg_pct
LIMIT 20;
