```sql
--Description: Compare sales for the 12 weeks BEFORE (2020-03-23→2020-06-14) and AFTER
--             (2020-06-15→2020-09-06) 15-Jun-2020, compute the % change for every
--             value of each attribute type (Region, Platform, Age Band, Demographic,
--             Customer Type), then average those % changes per attribute type and flag
--             the one with the worst (most-negative) impact.
WITH sales_window AS (            -- keep only the rows we need
    SELECT *
    FROM   cleaned_weekly_sales
    WHERE  calendar_year = 2020
      AND  week_date BETWEEN '2020-03-23' AND '2020-09-06'
),
/* sales totals for each attribute VALUE */
region_val AS (
    SELECT 'Region'  AS attr_type,
           region    AS attr_value,
           SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-14' THEN sales END) AS before_sales,
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-09-06' THEN sales END) AS after_sales
    FROM   sales_window
    GROUP  BY region
),
platform_val AS (
    SELECT 'Platform', platform,
           SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-14' THEN sales END) AS before_sales,
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-09-06' THEN sales END) AS after_sales
    FROM   sales_window
    GROUP  BY platform
),
age_val AS (
    SELECT 'Age Band', age_band,
           SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-14' THEN sales END) AS before_sales,
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-09-06' THEN sales END) AS after_sales
    FROM   sales_window
    GROUP  BY age_band
),
demo_val AS (
    SELECT 'Demographic', demographic,
           SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-14' THEN sales END) AS before_sales,
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-09-06' THEN sales END) AS after_sales
    FROM   sales_window
    GROUP  BY demographic
),
cust_val AS (
    SELECT 'Customer Type', customer_type,
           SUM(CASE WHEN week_date BETWEEN '2020-03-23' AND '2020-06-14' THEN sales END) AS before_sales,
           SUM(CASE WHEN week_date BETWEEN '2020-06-15' AND '2020-09-06' THEN sales END) AS after_sales
    FROM   sales_window
    GROUP  BY customer_type
),
/* combine all attribute values */
all_val AS (
    SELECT * FROM region_val
    UNION ALL SELECT * FROM platform_val
    UNION ALL SELECT * FROM age_val
    UNION ALL SELECT * FROM demo_val
    UNION ALL SELECT * FROM cust_val
),
/* average % change per attribute TYPE */
attr_changes AS (
    SELECT attr_type,
           AVG( (after_sales - before_sales) * 100.0 / before_sales ) AS avg_pct_change
    FROM   all_val
    GROUP  BY attr_type
)
SELECT attr_type,
       ROUND(avg_pct_change, 2) AS average_pct_change,
       CASE
           WHEN avg_pct_change = (SELECT MIN(avg_pct_change) FROM attr_changes)
           THEN '<< Worst Impact'
       END AS flag
FROM   attr_changes
ORDER  BY avg_pct_change;
