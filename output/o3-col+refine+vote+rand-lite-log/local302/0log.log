```sql
--Description: We want the average % change in sales for each of five attribute
--             types when comparing 12 weeks BEFORE (2020-03-23→2020-06-14)
--             and 12 weeks AFTER (2020-06-15→2020-09-06) 15-Jun-2020.  
--             Steps inside this single query:  
--   1.  For every value of each attribute, sum sales in the two windows.  
--   2.  Compute its % change: (after-before)/before*100.  
--   3.  For each attribute type, take the average of those % changes => avg_pct.  
--   4.  UNION ALL the five attribute-type result sets.  
--   5.  Flag the attribute type with the most-negative avg_pct (worst impact).  
WITH attr_changes AS (  
    /* ---------- Region ---------- */  
    SELECT 'Region' AS attr_type,  
           AVG((after_sales - before_sales) * 100.0 / before_sales) AS avg_pct  
    FROM (  
        SELECT "region",  
               SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END) AS before_sales,  
               SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END) AS after_sales  
        FROM   cleaned_weekly_sales  
        WHERE  "calendar_year" = 2020  
        GROUP  BY "region"  
    )  
  
    UNION ALL  
  
    /* ---------- Platform ---------- */  
    SELECT 'Platform',  
           AVG((after_sales - before_sales) * 100.0 / before_sales)  
    FROM (  
        SELECT "platform",  
               SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END) AS before_sales,  
               SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END) AS after_sales  
        FROM   cleaned_weekly_sales  
        WHERE  "calendar_year" = 2020  
        GROUP  BY "platform"  
    )  
  
    UNION ALL  
  
    /* ---------- Age Band ---------- */  
    SELECT 'Age Band',  
           AVG((after_sales - before_sales) * 100.0 / before_sales)  
    FROM (  
        SELECT "age_band",  
               SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END) AS before_sales,  
               SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END) AS after_sales  
        FROM   cleaned_weekly_sales  
        WHERE  "calendar_year" = 2020  
        GROUP  BY "age_band"  
    )  
  
    UNION ALL  
  
    /* ---------- Demographic ---------- */  
    SELECT 'Demographic',  
           AVG((after_sales - before_sales) * 100.0 / before_sales)  
    FROM (  
        SELECT "demographic",  
               SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END) AS before_sales,  
               SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END) AS after_sales  
        FROM   cleaned_weekly_sales  
        WHERE  "calendar_year" = 2020  
        GROUP  BY "demographic"  
    )  
  
    UNION ALL  
  
    /* ---------- Customer Type ---------- */  
    SELECT 'Customer Type',  
           AVG((after_sales - before_sales) * 100.0 / before_sales)  
    FROM (  
        SELECT "customer_type",  
               SUM(CASE WHEN "week_date" BETWEEN '2020-03-23' AND '2020-06-14' THEN "sales" END) AS before_sales,  
               SUM(CASE WHEN "week_date" BETWEEN '2020-06-15' AND '2020-09-06' THEN "sales" END) AS after_sales  
        FROM   cleaned_weekly_sales  
        WHERE  "calendar_year" = 2020  
        GROUP  BY "customer_type"  
    )  
)  
SELECT attr_type,  
       ROUND(avg_pct, 2) AS average_%_change,  
       CASE WHEN avg_pct = (SELECT MIN(avg_pct) FROM attr_changes)  
            THEN '<< Worst Impact' END AS flag  
FROM   attr_changes  
ORDER BY avg_pct;  
