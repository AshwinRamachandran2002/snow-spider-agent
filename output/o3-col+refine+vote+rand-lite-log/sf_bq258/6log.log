```sql
--Description: 1)  Look at the different order “status” values that appear in the ORDERS table.
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT 20;
```

```sql
--Description: 2)  Check which “status” values appear in the ORDER_ITEMS table.
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 3)  Sample the raw timestamps for completed orders that have already been delivered.
SELECT "order_id",
       "status",
       "created_at",
       "delivered_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "status" = 'Complete'
  AND "delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4)  Bring together ORDERS and ORDER_ITEMS to see matching “Complete” rows before 2022.
SELECT oi."id"          AS "order_item_id",
       oi."order_id",
       o."status",
       o."delivered_at",
       oi."sale_price"
FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
      ON oi."order_id" = o."order_id"
WHERE o."status" = 'Complete'
  AND o."delivered_at" < 1640995200000000   -- 2022-01-01 in µs
LIMIT 20;
```

```sql
--Description: 5)  Attach product information (category, cost) to the completed & delivered order items.
SELECT oi."order_id",
       p."category",
       p."cost"          AS "product_cost",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON oi."product_id" = p."id"
WHERE o."status"      = 'Complete'
  AND o."delivered_at" < 1640995200000000
LIMIT 20;
```

```sql
--Description: 6)  Aggregate revenue by product category and by month (raw timestamp kept).
SELECT p."category",
       o."delivered_at",
       SUM(oi."sale_price") AS "monthly_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o  ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON oi."product_id" = p."id"
WHERE o."status"      = 'Complete'
  AND o."delivered_at" < 1640995200000000
GROUP BY p."category", o."delivered_at"
LIMIT 20;
```

```sql
--Description: 7)  Add total number of completed orders per category & month (one row per order counted once).
SELECT p."category",
       o."delivered_at",
       COUNT(DISTINCT oi."order_id") AS "num_completed_orders",
       SUM(oi."sale_price")          AS "revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p ON oi."product_id" = p."id"
WHERE o."status" = 'Complete'
  AND o."delivered_at" < 1640995200000000
GROUP BY p."category", o."delivered_at"
LIMIT 20;
```

```sql
--Description: 8)  Pull monthly totals along with summed product “cost” to prepare for profit analysis.
SELECT p."category",
       o."delivered_at",
       SUM(oi."sale_price")          AS "revenue",
       SUM(p."cost")                 AS "total_cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p ON oi."product_id" = p."id"
WHERE o."status" = 'Complete'
  AND o."delivered_at" < 1640995200000000
GROUP BY p."category", o."delivered_at"
LIMIT 20;
```

```sql
--Description: 9)  Compute profit (revenue – cost) and profit-to-cost ratio for each category/month.
SELECT p."category",
       o."delivered_at",
       SUM(oi."sale_price")          AS "revenue",
       SUM(p."cost")                 AS "total_cost",
       SUM(oi."sale_price") - SUM(p."cost") AS "profit",
       (SUM(oi."sale_price") - SUM(p."cost")) / NULLIF(SUM(p."cost"),0)  AS "profit_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p ON oi."product_id" = p."id"
WHERE o."status" = 'Complete'
  AND o."delivered_at" < 1640995200000000
GROUP BY p."category", o."delivered_at"
LIMIT 20;
```

```sql
--Description: 10)  Show month-over-month percentage growth for both revenue and completed orders.
SELECT p."category",
       o."delivered_at",
       SUM(oi."sale_price")                     AS "revenue",
       COUNT(DISTINCT oi."order_id")            AS "completed_orders",
       LAG(SUM(oi."sale_price"))  OVER (PARTITION BY p."category" ORDER BY o."delivered_at") AS "prev_month_revenue",
       LAG(COUNT(DISTINCT oi."order_id")) OVER (PARTITION BY p."category" ORDER BY o."delivered_at") AS "prev_month_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p ON oi."product_id" = p."id"
WHERE o."status" = 'Complete'
  AND o."delivered_at" < 1640995200000000
GROUP BY p."category", o."delivered_at"
ORDER BY p."category", o."delivered_at"
LIMIT 20;
```
