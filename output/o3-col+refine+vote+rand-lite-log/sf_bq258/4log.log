```sql
--Description: Inspect the different order item statuses that exist in the data  
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: Inspect the different order-level statuses in the ORDERS table  
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
LIMIT 20;
```

```sql
--Description: Look at a handful of “Complete” order-items that already have a non-NULL "delivered_at" timestamp  
SELECT "id",
       "order_id",
       "user_id",
       "product_id",
       "inventory_item_id",
       "sale_price",
       "delivered_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
WHERE "status" = 'Complete'
  AND "delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
--Description: List the distinct product categories available in the catalogue  
SELECT DISTINCT "category"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"
LIMIT 20;
```

```sql
--Description: Join order-items (only “Complete”) to products to see category, sale price, and delivered timestamp samples  
SELECT oi."order_id",
       pr."category",
       oi."sale_price",
       oi."delivered_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     pr
       ON pr."id" = oi."product_id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Bring in inventory cost to compare cost vs. sale price for a sample of completed order-items  
SELECT oi."order_id",
       oi."product_id",
       ii."cost"               AS "unit_cost",
       oi."sale_price"         AS "unit_revenue",
       oi."delivered_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"      oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"  ii
       ON ii."id" = oi."inventory_item_id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Quick monthly-level revenue snapshot (without date conversion) using the first eight digits of the micro-second timestamp as YYYYMMDD for illustration  
SELECT SUBSTR(TO_VARCHAR(oi."delivered_at"), 1, 6)      AS "yyyymm",
       pr."category",
       SUM(oi."sale_price")                              AS "revenue",
       COUNT(*)                                          AS "completed_orders"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     pr
       ON pr."id" = oi."product_id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000        -- 2022-01-01 00:00:00 in µs
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: Same monthly snapshot but adding cost and profit figures (revenue ‑ cost) for completed orders before 2022  
SELECT SUBSTR(TO_VARCHAR(oi."delivered_at"), 1, 6)      AS "yyyymm",
       pr."category",
       SUM(oi."sale_price")                              AS "revenue",
       SUM(ii."cost")                                    AS "total_cost",
       SUM(oi."sale_price") - SUM(ii."cost")            AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
       ON ii."id" = oi."inventory_item_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"        pr
       ON pr."id" = oi."product_id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" IS NOT NULL
  AND  oi."delivered_at" < 1640995200000000
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: Preview the relationship between distribution centers and product categories for items that were shipped  
SELECT DISTINCT dc."name"                    AS "distribution_center",
       pr."category"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."DISTRIBUTION_CENTERS" dc
       ON dc."id" = ii."product_distribution_center_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"             pr
       ON pr."id" = ii."product_id"
LIMIT 20;
```

```sql
--Description: Inspect a few user demographics tied to completed orders before 2022 (joining order-items to users)  
SELECT u."gender",
       u."age",
       u."country",
       oi."sale_price",
       oi."delivered_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
       ON u."id" = oi."user_id"
WHERE  oi."status" = 'Complete'
  AND  oi."delivered_at" < 1640995200000000
LIMIT 20;
```

These exploratory queries step from simple inspections (statuses, categories) to increasingly complex joins and aggregations that mirror the calculations required for the final monthly category report.
