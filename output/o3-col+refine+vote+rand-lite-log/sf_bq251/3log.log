Query:
--Description: Final concise answer – cleaned GitHub repo URLs of the top-3 downloaded projects
SELECT 
  REGEXP_REPLACE(
      f.value::STRING,
      '(/issues.*|/pull.*|/blob.*|/tree.*)$',
      '',
      1,            -- start position
      0,            -- replace all
      'i'           -- case-insensitive
  ) AS "github_repo_clean"
FROM (
    /* packages ranked by downloads with latest metadata */
    SELECT 
      m."name",
      dwn."download_cnt",
      m."project_urls",
      ROW_NUMBER() OVER (ORDER BY dwn."download_cnt" DESC) AS overall_rank
    FROM (
        SELECT *
        FROM (
            SELECT
              "name",
              "version",
              "upload_time",
              "project_urls",
              ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
            FROM PYPI.PYPI.DISTRIBUTION_METADATA
        ) 
        WHERE rn = 1
    ) m
    JOIN (
        SELECT 
          "project",
          COUNT(*) AS "download_cnt"
        FROM PYPI.PYPI.FILE_DOWNLOADS
        GROUP BY "project"
    ) dwn
    ON m."name" = dwn."project"
) ranked,
LATERAL FLATTEN(input => ranked."project_urls") f
WHERE ranked.overall_rank <= 3
  AND f.value::STRING ILIKE '%github.com%'
LIMIT 20
