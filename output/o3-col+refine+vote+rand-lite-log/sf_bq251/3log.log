```sql
-- Description: Clean the GitHub URLs by trimming common unnecessary sub-paths
SELECT DISTINCT
  REGEXP_REPLACE( f.value::STRING,
                  '(?i)(/issues.*|/pull.*|/blob.*|/tree.*)$', 
                  '' ) AS "github_repo_clean"
FROM PYPI.PYPI.DISTRIBUTION_METADATA d,
     LATERAL FLATTEN(input => d."project_urls") f
WHERE f.value::STRING ILIKE '%github.com%'
LIMIT 20;
```

```sql
-- Description: Rank packages with cleaned GitHub URLs by total download count
SELECT 
  TOP3."github_repo_clean"
FROM (
  SELECT 
    cleaned."github_repo_clean",
    agg."download_cnt",
    ROW_NUMBER() OVER (ORDER BY agg."download_cnt" DESC) AS rnk
  FROM (
      /* step that derives cleaned GitHub URL for each package */ 
      SELECT 
        d."name",
        REGEXP_REPLACE( f.value::STRING,
                        '(?i)(/issues.*|/pull.*|/blob.*|/tree.*)$', 
                        '' ) AS "github_repo_clean"
      FROM PYPI.PYPI.DISTRIBUTION_METADATA d,
           LATERAL FLATTEN(input => d."project_urls") f
      WHERE f.value::STRING ILIKE '%github.com%'
        AND d."upload_time" = (
              SELECT MAX("upload_time") 
              FROM PYPI.PYPI.DISTRIBUTION_METADATA 
              WHERE "name" = d."name"
            )
      QUALIFY ROW_NUMBER() OVER (PARTITION BY d."name" ORDER BY d."upload_time" DESC) = 1
  ) cleaned
  JOIN (
      SELECT 
        "project" AS "name",
        COUNT(*) AS "download_cnt"
      FROM PYPI.PYPI.FILE_DOWNLOADS
      GROUP BY "project"
  ) agg
  ON cleaned."name" = agg."name"
) TOP3
WHERE TOP3.rnk <= 3
LIMIT 20;
```

```sql
-- Description: Final concise answer – just cleaned GitHub repo URLs of top-3
SELECT 
  REGEXP_REPLACE( f.value::STRING,
                  '(?i)(/issues.*|/pull.*|/blob.*|/tree.*)$', 
                  '' ) AS "github_repo_clean"
FROM (
    /* packages ranked by downloads with latest metadata */
    SELECT 
      m."name",
      dwn."download_cnt",
      m."project_urls",
      ROW_NUMBER() OVER (ORDER BY dwn."download_cnt" DESC) AS overall_rank
    FROM (
        SELECT *
        FROM (
            SELECT
              "name",
              "version",
              "upload_time",
              "project_urls",
              ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
            FROM PYPI.PYPI.DISTRIBUTION_METADATA
        ) 
        WHERE rn = 1
    ) m
    JOIN (
        SELECT 
          "project",
          COUNT(*) AS "download_cnt"
        FROM PYPI.PYPI.FILE_DOWNLOADS
        GROUP BY "project"
    ) dwn
    ON m."name" = dwn."project"
) ranked,
LATERAL FLATTEN(input => ranked."project_urls") f
WHERE ranked.overall_rank <= 3
  AND f.value::STRING ILIKE '%github.com%'
LIMIT 20;
```
