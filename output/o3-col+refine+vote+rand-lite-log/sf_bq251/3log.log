Query:
--Description: Rank packages with cleaned GitHub URLs by total download count
SELECT 
  TOP3."github_repo_clean"
FROM (
  SELECT 
    cleaned."github_repo_clean",
    agg."download_cnt",
    ROW_NUMBER() OVER (ORDER BY agg."download_cnt" DESC) AS rnk
  FROM (
      /* step that derives cleaned GitHub URL for each package */ 
      SELECT 
        d."name",
        REGEXP_REPLACE(
            f.value::STRING,
            '(/issues.*|/pull.*|/blob.*|/tree.*)$',
            '',
            1,          -- start position
            0,          -- replace all
            'i'         -- case-insensitive
        ) AS "github_repo_clean"
      FROM PYPI.PYPI.DISTRIBUTION_METADATA d,
           LATERAL FLATTEN(input => d."project_urls") f
      WHERE f.value::STRING ILIKE '%github.com%'
        AND d."upload_time" = (
              SELECT MAX("upload_time") 
              FROM PYPI.PYPI.DISTRIBUTION_METADATA 
              WHERE "name" = d."name"
            )
      QUALIFY ROW_NUMBER() OVER (PARTITION BY d."name" ORDER BY d."upload_time" DESC) = 1
  ) cleaned
  JOIN (
      SELECT 
        "project" AS "name",
        COUNT(*) AS "download_cnt"
      FROM PYPI.PYPI.FILE_DOWNLOADS
      GROUP BY "project"
  ) agg
  ON cleaned."name" = agg."name"
) TOP3
WHERE TOP3.rnk <= 3
LIMIT 20
