  jm."name",
  jm."download_cnt",
  f.value::STRING AS "gh_link_raw"
FROM (
  /* most-recent metadata + download counts */
  SELECT 
    m."name",
    m."project_urls",
    dwn."download_cnt"
  FROM (
    SELECT *
    FROM (
      SELECT
        "name",
        "version",
        "upload_time",
        "project_urls",
        ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
      FROM PYPI.PYPI.DISTRIBUTION_METADATA
    ) 
    WHERE rn = 1
  ) m
  JOIN (
    SELECT 
      "project",
      COUNT(*) AS "download_cnt"
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
  ) dwn
  ON m."name" = dwn."project"
) jm, LATERAL FLATTEN(input => jm."project_urls") f
WHERE f.value::STRING ILIKE '%github.com%'
LIMIT 20;
