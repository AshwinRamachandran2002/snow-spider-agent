Query:
-- Description: Join most-recent metadata with download counts
SELECT 
  m."name",
  m."version",
  dwn."download_cnt",
  m."project_urls"
FROM (
  SELECT *
  FROM (
    SELECT
      "name",
      "version",
      "upload_time",
      "project_urls",
      ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
  ) 
  WHERE rn = 1
) m
JOIN (
  SELECT 
    "project",
    COUNT(*) AS "download_cnt"
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
) dwn
ON m."name" = dwn."project"
ORDER BY dwn."download_cnt" DESC
LIMIT 20;
