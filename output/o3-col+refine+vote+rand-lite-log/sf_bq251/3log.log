-- extract GitHub links from project_urls, and clean each link by removing
-- trailing “/issues…”, “/pull…”, “/blob…”, or “/tree…”.
WITH downloads AS (                               -- total downloads per project
    SELECT "project" AS "name",
           COUNT(*)        AS download_cnt
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
),
latest_meta AS (                                  -- newest metadata per project
    SELECT "name",
           "project_urls",
           ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
),
top3 AS (                                         -- keep only top-3 packages
    SELECT d."name",
           lm."project_urls"
    FROM downloads d
    JOIN latest_meta lm
      ON d."name" = lm."name" AND lm.rn = 1
    QUALIFY ROW_NUMBER() OVER (ORDER BY d.download_cnt DESC) <= 3
)
SELECT DISTINCT
       REGEXP_REPLACE(
           f.value::STRING,
           '(/issues.*|/pull.*|/blob.*|/tree.*)$',
           '',
           1,                -- start position
           0,                -- replace all occurrences
           'i'               -- case-insensitive
       ) AS "github_repo_clean"
FROM top3,
     LATERAL FLATTEN(input => top3."project_urls") f
WHERE f.value::STRING ILIKE '%github.com%';
