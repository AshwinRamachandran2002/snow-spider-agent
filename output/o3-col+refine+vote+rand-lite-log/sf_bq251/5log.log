```sql
--Description: Combine latest-version metadata with cleaned GitHub URLs (one row per package/version)
WITH latest AS (
  SELECT
    dm.*
  FROM (
    SELECT
      "name",
      "version",
      "upload_time",
      ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
  ) dm
  WHERE rn = 1
)
SELECT DISTINCT
  l."name",
  REGEXP_REPLACE(
      LOWER(f.value::STRING),
      '/(issues|pull|blob|tree).*$', 
      ''
  ) AS "github_repo_clean"
FROM latest l,
     LATERAL FLATTEN(input => l."project_urls") f
WHERE f.value::STRING ILIKE '%github.com%'
LIMIT 20;
```

```sql
