```sql
--Description: Extract & clean the base GitHub repository URL (remove routes like issues, pull, blob, tree, etc.)
SELECT DISTINCT
  dm."name",
  REGEXP_REPLACE(
      LOWER(f.value::STRING),
      '/(issues|pull|blob|tree).*$',        -- remove unwanted suffixes
      ''
  ) AS "github_repo_clean"
FROM PYPI.PYPI.DISTRIBUTION_METADATA dm,
     LATERAL FLATTEN(input => dm."project_urls") f
WHERE f.value::STRING ILIKE '%github.com%'
LIMIT 20;
```

