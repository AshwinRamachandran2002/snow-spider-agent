Query:
--Description: Show the top-10 most-downloaded projects along with their cleaned GitHub repository URLs
WITH latest AS (                             -- newest distribution per package
  SELECT *
  FROM (
    SELECT
      dm.*,
      ROW_NUMBER() OVER (PARTITION BY dm."name"
                         ORDER BY dm."upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA dm
  ) s
  WHERE rn = 1
),
clean_urls AS (                              -- GitHub links (clean)
  SELECT DISTINCT
         l."name",
         REGEXP_REPLACE(
             LOWER(f.value::STRING),
             '/(issues|pull|blob|tree).*$', 
             ''
         ) AS "github_repo_clean"
  FROM latest l,
       LATERAL FLATTEN(input => l."project_urls") f
  WHERE f.value::STRING ILIKE '%github.com%'
),
downloads AS (                               -- download totals
  SELECT
    "project" AS "name",
    COUNT(*)  AS "download_cnt"
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
),
ranked AS (                                  -- rank by downloads
  SELECT
    cu."github_repo_clean",
    d."download_cnt",
    ROW_NUMBER() OVER (ORDER BY d."download_cnt" DESC) AS rnk
  FROM clean_urls cu
  JOIN downloads d
    ON cu."name" = d."name"
)
SELECT
  "github_repo_clean"
FROM ranked
WHERE rnk <= 10
LIMIT 20
