--Description: Retrieve only the cleaned GitHub URLs for the top-3 most-downloaded packages
WITH latest AS (                             -- latest release
  SELECT *
  FROM (
    SELECT
      dm.*,
      ROW_NUMBER() OVER (PARTITION BY dm."name"
                         ORDER BY dm."upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA dm
  ) s
  WHERE rn = 1
),
clean_urls AS (                              -- GitHub repos cleaned
  SELECT DISTINCT
         l."name",
         REGEXP_REPLACE(
             LOWER(f.value::STRING),
             '/(issues|pull|blob|tree).*$', 
             ''
         ) AS "github_repo_clean"
  FROM latest l,
       LATERAL FLATTEN(input => l."project_urls") f
  WHERE f.value::STRING ILIKE '%github.com%'
),
downloads AS (                               -- counts
  SELECT
    "project" AS "name",
    COUNT(*)  AS "download_cnt"
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
)
SELECT
  cu."github_repo_clean"
FROM clean_urls cu
JOIN downloads  d
  ON cu."name" = d."name"
ORDER BY d."download_cnt" DESC
LIMIT 3
