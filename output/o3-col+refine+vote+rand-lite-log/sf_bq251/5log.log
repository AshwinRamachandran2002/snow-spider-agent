```sql
--Description:
-- Goal: obtain the cleaned GitHub repository URLs for the three MOST-DOWNLOADED
--       PyPI projects (based on FILE_DOWNLOADS) that also expose a GitHub URL
--       in the metadata of their MOST-RECENT distribution.
--
-- Thinking process (inline):
--   • latest      : for every project, pick the newest row by upload_time
--   • clean_urls  : explode project_urls, keep only GitHub links, strip paths
--                   such as /issues, /pull, /blob, /tree to leave base repo URL
--   • downloads   : count total download events per project in FILE_DOWNLOADS
--   • final join  : intersect clean_urls with downloads, order by count, pick 3

WITH latest AS (                              -- newest release per package
    SELECT *
    FROM (
        SELECT
            dm.*,
            ROW_NUMBER() OVER (
                PARTITION BY dm."name"
                ORDER BY dm."upload_time" DESC
            ) AS rn
        FROM PYPI.PYPI.DISTRIBUTION_METADATA dm
    ) s
    WHERE rn = 1
),
clean_urls AS (                               -- extract & sanitize GitHub links
    SELECT DISTINCT
           l."name",
           REGEXP_REPLACE(
               LOWER(url.value::STRING),
               '/(issues|pull|blob|tree).*$',   -- remove noisy suffixes
               ''
           ) AS "github_repo_clean"
    FROM latest l,
         LATERAL FLATTEN(input => l."project_urls") url
    WHERE url.value::STRING ILIKE '%github.com%'
),
downloads AS (                                -- total downloads per project
    SELECT
        "project" AS "name",
        COUNT(*)  AS "download_cnt"
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
)
SELECT
    cu."github_repo_clean"
FROM clean_urls cu
JOIN downloads  d
  ON cu."name" = d."name"
ORDER BY d."download_cnt" DESC
LIMIT 3;
```
