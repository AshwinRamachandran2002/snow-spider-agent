FROM PYPI.PYPI.FILE_DOWNLOADS
GROUP BY "project"
ORDER BY "download_cnt" DESC
LIMIT 20;
```

```sql
--Description: Join latest-version metadata (with GitHub URLs) to download counts
WITH latest AS (
  SELECT
    dm.*
  FROM (
    SELECT
      "name",
      "version",
      "upload_time",
      ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
  ) dm
  WHERE rn = 1
),
clean_urls AS (
  SELECT DISTINCT
    l."name",
    REGEXP_REPLACE(
        LOWER(f.value::STRING),
        '/(issues|pull|blob|tree).*$', 
        ''
    ) AS "github_repo_clean"
  FROM latest l,
       LATERAL FLATTEN(input => l."project_urls") f
  WHERE f.value::STRING ILIKE '%github.com%'
)
SELECT
  cu."name",
  fd."download_cnt",
  cu."github_repo_clean"
FROM clean_urls cu
JOIN (
  SELECT
    "project" AS "name",
    COUNT(*) AS "download_cnt"
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
) fd
  ON cu."name" = fd."name"
ORDER BY fd."download_cnt" DESC
LIMIT 20;
```

```sql
--Description: Show the top 10 most-downloaded projects along with their cleaned GitHub repository URLs
WITH ranked AS (
  /* reuse previous join logic */
  WITH latest AS (
    SELECT
      dm.*
    FROM (
      SELECT
        "name",
        "version",
        "upload_time",
        ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
      FROM PYPI.PYPI.DISTRIBUTION_METADATA
    ) dm
    WHERE rn = 1
  ),
  clean_urls AS (
    SELECT DISTINCT
      l."name",
      REGEXP_REPLACE(
          LOWER(f.value::STRING),
          '/(issues|pull|blob|tree).*$', 
          ''
      ) AS "github_repo_clean"
    FROM latest l,
         LATERAL FLATTEN(input => l."project_urls") f
    WHERE f.value::STRING ILIKE '%github.com%'
  ),
  downloads AS (
    SELECT
      "project" AS "name",
      COUNT(*) AS "download_cnt"
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
  )
  SELECT
    cu."github_repo_clean",
    d."download_cnt",
    ROW_NUMBER() OVER (ORDER BY d."download_cnt" DESC) AS rnk
  FROM clean_urls cu
  JOIN downloads d
    ON cu."name" = d."name"
)
SELECT
  "github_repo_clean"
FROM ranked
WHERE rnk <= 10
LIMIT 20;
```

