Query:
--Description: Join newest-version metadata (with cleaned GitHub URLs) to download counts
WITH latest AS (                             -- newest release per package
  SELECT *
  FROM (
    SELECT
      dm.*,                                   -- keep all columns incl. project_urls
      ROW_NUMBER() OVER (PARTITION BY dm."name"
                         ORDER BY dm."upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA dm
  ) s
  WHERE rn = 1
),
clean_urls AS (                              -- extract & clean GitHub links
  SELECT DISTINCT
         l."name",
         REGEXP_REPLACE(
             LOWER(f.value::STRING),
             '/(issues|pull|blob|tree).*$',   -- strip unwanted suffixes
             ''
         ) AS "github_repo_clean"
  FROM latest l,
       LATERAL FLATTEN(input => l."project_urls") f
  WHERE f.value::STRING ILIKE '%github.com%'
)
SELECT
  cu."name",
  d."download_cnt",
  cu."github_repo_clean"
FROM clean_urls cu
JOIN (
  SELECT
    "project" AS "name",
    COUNT(*)  AS "download_cnt"
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
) d
  ON cu."name" = d."name"
ORDER BY d."download_cnt" DESC
LIMIT 20
