```sql
--Description: Identify the three most-downloaded PyPI projects that expose a GitHub
--             repository link.  Steps inside the CTEs:
--               • github_pkgs : keep only the latest metadata row for each package and
--                 pull one GitHub URL (either from home_page or from project_urls).
--               • downloads   : count total file downloads per project.
--               • The main SELECT joins those CTEs, cleans each GitHub URL down to the
--                 root repository (strips /issues, /pull, /blob, /tree and anything
--                 that follows), ranks by download count, and finally returns just the
--                 cleaned URLs for the top three packages.

WITH github_pkgs AS (   -- latest version rows + a GitHub URL
    SELECT DISTINCT * FROM (
        /* GitHub URL found in home_page ---------------------------------- */
        SELECT
            d."name",
            d."home_page" AS github_url
        FROM (
            SELECT *,
                   ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
            FROM PYPI.PYPI.DISTRIBUTION_METADATA
            WHERE "home_page" ILIKE '%github.com%'
        ) d
        WHERE rn = 1

        UNION ALL

        /* GitHub URL extracted from project_urls ------------------------- */
        SELECT
            d."name",
            REGEXP_SUBSTR(f.value::STRING, 'https?://[^"]+') AS github_url
        FROM (
            SELECT *,
                   ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
            FROM PYPI.PYPI.DISTRIBUTION_METADATA
        ) d,
        LATERAL FLATTEN(INPUT => PARSE_JSON(d."project_urls")) f
        WHERE rn = 1
          AND f.value::STRING ILIKE '%github.com%'
    )
),
downloads AS (           -- total download counts per project
    SELECT
        "project" AS name,
        COUNT(*)  AS download_cnt
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
)
SELECT cleaned_github_repo_url
FROM (
    SELECT
        REGEXP_REPLACE(g.github_url,
                       '/(issues|pull|blob|tree)(/.*)?$',
                       '')                    AS cleaned_github_repo_url,
        d.download_cnt
    FROM github_pkgs g
    JOIN downloads d
      ON d.name = g."name"
    ORDER BY d.download_cnt DESC
    LIMIT 3                                   -- top-3 by downloads
) t;
