```sql
WITH latest AS (   -- newest version of every package
    SELECT
        "name",
        "home_page",
        "project_urls",
        ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
),
latest_only AS (
    SELECT "name","home_page","project_urls"
    FROM   latest
    WHERE  rn = 1
),
-- GitHub URLs coming from the home_page field
home_urls AS (
    SELECT
        "name",
        REGEXP_SUBSTR("home_page",
                      'https?://github\.com/[^/]+/[^/]+')            AS repo_url
    FROM latest_only
    WHERE "home_page" ILIKE '%github.com%'
),
-- GitHub URLs coming from the project_urls JSON field
proj_urls AS (
    SELECT
        l."name",
        REGEXP_SUBSTR(v.value::STRING,
                      'https?://github\.com/[^/]+/[^/]+')            AS repo_url
    FROM   latest_only l,
           LATERAL FLATTEN(INPUT => PARSE_JSON(l."project_urls")) v
    WHERE  v.value::STRING ILIKE '%github.com%'
),
-- union both sources and keep distinct cleaned repo URLs
github_repos AS (
    SELECT DISTINCT "name", repo_url
    FROM (
          SELECT * FROM home_urls
          UNION ALL
          SELECT * FROM proj_urls
    )
    WHERE repo_url IS NOT NULL
),
-- accumulate total download counts per project
downloads AS (
    SELECT
        "project"           AS name,
        COUNT(*)            AS download_cnt
    FROM PYPI.PYPI.FILE_DOWNLOADS
    GROUP BY "project"
),
-- join repos with their download counts
joined AS (
    SELECT
        g.name,
        g.repo_url,
        d.download_cnt,
        ROW_NUMBER() OVER (PARTITION BY g.name ORDER BY g.repo_url) AS repo_rank
    FROM github_repos g
    JOIN downloads   d ON d.name = g.name
)
-- top-3 most-downloaded packages that have a valid GitHub repo URL
SELECT repo_url
FROM   joined
WHERE  repo_rank = 1                -- one repo URL per package
ORDER BY download_cnt DESC NULLS LAST
LIMIT 3;
