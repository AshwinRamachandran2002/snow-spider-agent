```sql
--Description: Quick look at some package metadata columns
SELECT 
  "name",
  "version",
  "home_page",
  "project_urls",
  "upload_time"
FROM PYPI.PYPI.DISTRIBUTION_METADATA
LIMIT 20;
```

```sql
--Description: Show a few rows whose home_page already points at GitHub
SELECT 
  "name",
  "version",
  "home_page"
FROM PYPI.PYPI.DISTRIBUTION_METADATA
WHERE "home_page" ILIKE '%github.com%'
LIMIT 20;
```

```sql
--Description: Extract every URL inside project_urls (array-like text) & show those containing GitHub
SELECT 
  d."name",
  d."version",
  f.value::STRING AS "proj_url"
FROM PYPI.PYPI.DISTRIBUTION_METADATA d,
     LATERAL FLATTEN( INPUT => PARSE_JSON(d."project_urls") ) f
WHERE f.value::STRING ILIKE '%github.com%'
LIMIT 20;
```

```sql
--Description: Keep only the newest entry of each package (latest upload_time)
SELECT 
  *
FROM (
  SELECT *, 
         ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
  FROM PYPI.PYPI.DISTRIBUTION_METADATA
) 
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: Aggregate total download count per project
SELECT 
  "project",
  COUNT(*) AS "download_cnt"
FROM PYPI.PYPI.FILE_DOWNLOADS
GROUP BY "project"
ORDER BY "download_cnt" DESC
LIMIT 20;
```

```sql
--Description: Build a table of latest-version packages together with a single GitHub URL (home_page)
SELECT 
  d."name",
  d."version",
  d."home_page" AS "github_url"
FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
  FROM PYPI.PYPI.DISTRIBUTION_METADATA
  WHERE "home_page" ILIKE '%github.com%'
) d
WHERE d.rn = 1
LIMIT 20;
```

```sql
--Description: Same as above but pulling GitHub URL from project_urls where home_page lacked one
SELECT 
  d."name",
  d."version",
  REGEXP_SUBSTR(f.value::STRING, 'https?://[^"]+') AS "github_url"
FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
  FROM PYPI.PYPI.DISTRIBUTION_METADATA
) d,
LATERAL FLATTEN( INPUT => PARSE_JSON(d."project_urls") ) f
WHERE d.rn = 1
  AND f.value::STRING ILIKE '%github.com%'
LIMIT 20;
```

```sql
--Description: Union the two previous GitHub URL sources and de-duplicate
WITH home AS (
  SELECT 
    d."name",
    d."version",
    d."home_page" AS github_url
  FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
    WHERE "home_page" ILIKE '%github.com%'
  ) d
  WHERE rn = 1
), proj AS (
  SELECT 
    d."name",
    d."version",
    REGEXP_SUBSTR(f.value::STRING, 'https?://[^"]+') AS github_url
  FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
    FROM PYPI.PYPI.DISTRIBUTION_METADATA
  ) d,
  LATERAL FLATTEN( INPUT => PARSE_JSON(d."project_urls") ) f
  WHERE rn = 1
    AND f.value::STRING ILIKE '%github.com%'
)
SELECT DISTINCT *
FROM (SELECT * FROM home UNION ALL SELECT * FROM proj)
LIMIT 20;
```

```sql
--Description: Attach download counts to each package that has a GitHub URL
WITH github_pkgs AS (
  SELECT DISTINCT * 
  FROM (
    -- (same UNION as previous CTE) 
    (SELECT 
       d."name",
       d."version",
       d."home_page" AS github_url
     FROM (
       SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
       FROM PYPI.PYPI.DISTRIBUTION_METADATA
       WHERE "home_page" ILIKE '%github.com%'
     ) d
     WHERE rn = 1)
    UNION ALL
    (SELECT 
       d."name",
       d."version",
       REGEXP_SUBSTR(f.value::STRING, 'https?://[^"]+') AS github_url
     FROM (
       SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
       FROM PYPI.PYPI.DISTRIBUTION_METADATA
     ) d,
     LATERAL FLATTEN( INPUT => PARSE_JSON(d."project_urls") ) f
     WHERE rn = 1
       AND f.value::STRING ILIKE '%github.com%')
  )
), dl AS (
  SELECT 
    "project" AS name,
    COUNT(*) AS download_cnt
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
)
SELECT 
  g.github_url,
  dl.download_cnt
FROM github_pkgs g
JOIN dl
  ON dl.name = g."name"
ORDER BY dl.download_cnt DESC
LIMIT 20;
```

```sql
--Description: Produce the cleaned GitHub repo URLs for the 3 most-downloaded packages
WITH github_pkgs AS (
  SELECT DISTINCT * 
  FROM (
    (SELECT 
       d."name",
       d."version",
       d."home_page" AS github_url
     FROM (
       SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
       FROM PYPI.PYPI.DISTRIBUTION_METADATA
       WHERE "home_page" ILIKE '%github.com%'
     ) d
     WHERE rn = 1)
    UNION ALL
    (SELECT 
       d."name",
       d."version",
       REGEXP_SUBSTR(f.value::STRING, 'https?://[^"]+') AS github_url
     FROM (
       SELECT *, ROW_NUMBER() OVER (PARTITION BY "name" ORDER BY "upload_time" DESC) AS rn
       FROM PYPI.PYPI.DISTRIBUTION_METADATA
     ) d,
     LATERAL FLATTEN( INPUT => PARSE_JSON(d."project_urls") ) f
     WHERE rn = 1
       AND f.value::STRING ILIKE '%github.com%')
  )
), dl AS (
  SELECT 
    "project" AS name,
    COUNT(*) AS download_cnt
  FROM PYPI.PYPI.FILE_DOWNLOADS
  GROUP BY "project"
)
SELECT DISTINCT 
  REGEXP_REPLACE(g.github_url, '/(issues|pull|blob|tree)(/.*)?$', '') AS cleaned_github_repo_url
FROM github_pkgs g
JOIN dl
  ON dl.name = g."name"
ORDER BY dl.download_cnt DESC
LIMIT 3;
```
