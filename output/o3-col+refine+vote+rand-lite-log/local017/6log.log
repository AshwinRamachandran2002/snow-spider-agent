```sql
--Description: Count crashes for each (year, primary_collision_factor), rank the
--             causes by frequency inside every year, keep the top-two, build a
--             “signature” (cause1|cause2), and finally return the year(s) whose
--             signature is unique.  If the result set is empty, it means every
--             year shares the same two leading causes.
WITH counts AS (
    SELECT  ci."db_year"                          AS yr,
            COALESCE(co."primary_collision_factor",'(blank)') AS cause,
            COUNT(*)                              AS n
    FROM    "collisions"  AS co
    JOIN    "case_ids"    AS ci
           ON ci."case_id" = co."case_id"
    GROUP   BY yr, cause
),
ranked AS (
    SELECT  yr,
            cause,
            ROW_NUMBER() OVER (PARTITION BY yr ORDER BY n DESC) AS r
    FROM    counts
),
sig AS (                                           -- top-two causes per year
    SELECT  yr,
            GROUP_CONCAT(cause, '|') AS signature
    FROM    ranked
    WHERE   r <= 2
    GROUP   BY yr
),
sig_freq AS (                                      -- how many years share each signature
    SELECT  signature,
            COUNT(*) AS yrs_with_sig
    FROM    sig
    GROUP   BY signature
)
SELECT  s.yr  AS year_with_unique_top2
FROM    sig       AS s
JOIN    sig_freq  AS f ON f.signature = s.signature
WHERE   f.yrs_with_sig = 1;
```
