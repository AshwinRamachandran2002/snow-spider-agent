```sql
WITH baseline_factors AS (                       -- the two most frequent causes overall
    SELECT COALESCE(NULLIF(TRIM(col."primary_collision_factor"),''),'(blank)') AS factor
    FROM   "collisions" AS col
    GROUP  BY factor
    ORDER  BY COUNT(*) DESC
    LIMIT  2
),
year_factor AS (                                 -- cause counts per year
    SELECT c."db_year" AS year,
           COALESCE(NULLIF(TRIM(col."primary_collision_factor"),''),'(blank)') AS factor,
           COUNT(*) AS cnt
    FROM   "collisions" AS col
    JOIN   "case_ids"  AS c
           ON c."case_id" = col."case_id"
    GROUP  BY year, factor
),
ranked AS (                                      -- rank causes within each year
    SELECT year,
           factor,
           ROW_NUMBER() OVER (PARTITION BY year
                              ORDER BY cnt DESC, factor) AS rn
    FROM   year_factor
),
top_factors AS (                                 -- keep the two most common for each year
    SELECT year, factor
    FROM   ranked
    WHERE  rn <= 2
),
overlap AS (                                     -- compare to overall top-two set
    SELECT tf.year,
           SUM(CASE WHEN tf.factor IN (SELECT factor FROM baseline_factors)
                    THEN 1 ELSE 0 END) AS common_cnt
    FROM   top_factors AS tf
    GROUP  BY tf.year
)
SELECT year                                      -- years whose top-two differ
FROM   overlap
WHERE  common_cnt < 2
ORDER  BY year;
```
