```sql
--Description / Thinking process:
-- 1. Count, for every year and every primary_collision_factor, how many crashes occurred.
-- 2. Inside each year, rank those causes by descending count and keep only the two most frequent (rn<=2).
-- 3. Concatenate the two causes (in ranked order) into a single “signature” string for that year.
-- 4. Count how many different years share the same signature.
-- 5. Finally, return the year(s) whose signature is unique (appears only once).  
--    If the result set is empty, it means no year had a distinct pair of leading causes.
WITH year_cause_counts AS (
    SELECT  ci."db_year"                  AS year,
            co."primary_collision_factor" AS cause,
            COUNT(*)                      AS cnt
    FROM    "collisions"  AS co
    JOIN    "case_ids"    AS ci
           ON ci."case_id" = co."case_id"
    GROUP   BY year, cause
),
ranked_causes AS (
    SELECT  year,
            cause,
            ROW_NUMBER() OVER (PARTITION BY year ORDER BY cnt DESC) AS rn
    FROM    year_cause_counts
),
top2_per_year AS (
    SELECT  year,
            cause
    FROM    ranked_causes
    WHERE   rn <= 2                -- keep only the two most common causes
),
signature AS (
    SELECT  year,
            GROUP_CONCAT(cause, '|') AS sig
    FROM    top2_per_year
    GROUP   BY year
),
sig_counts AS (
    SELECT  sig,
            COUNT(*) AS yrs_with_sig
    FROM    signature
    GROUP   BY sig
)
SELECT  s.year,
        s.sig  AS top_two_causes,
        sc.yrs_with_sig
FROM    signature AS s
JOIN    sig_counts AS sc
       ON s.sig = sc.sig
WHERE   sc.yrs_with_sig = 1;
```
