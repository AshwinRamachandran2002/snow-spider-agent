```sql
WITH year_factor AS (                 -- injury-cause counts per year
    SELECT  c."db_year"                     AS year,
            COALESCE(NULLIF(TRIM(col."primary_collision_factor"),''),'(blank)') 
                                             AS factor,
            COUNT(*)                        AS cnt
    FROM    "collisions" AS col
    JOIN    "case_ids"   AS c
           ON c."case_id" = col."case_id"
    GROUP BY year, factor
),
ranked AS (                           -- rank causes by frequency within each year
    SELECT  year,
            factor,
            ROW_NUMBER() OVER (PARTITION BY year 
                                ORDER BY cnt DESC, factor) AS rn
    FROM    year_factor
),
top_factors AS (                      -- keep the two most common causes per year
    SELECT  year,
            factor
    FROM    ranked
    WHERE   rn <= 2
),
year_pairs AS (                       -- canonical (alphabetically ordered) pair string
    SELECT  year,
            CASE
                WHEN COUNT(*) = 1 THEN MIN(factor)
                ELSE
                    CASE WHEN MIN(factor) < MAX(factor)
                         THEN MIN(factor) || '|' || MAX(factor)
                         ELSE MAX(factor) || '|' || MIN(factor)
                    END
            END AS top_two
    FROM    top_factors
    GROUP BY year
),
pair_freq AS (                        -- frequency of each pair across all years
    SELECT  top_two,
            COUNT(*) AS yrs
    FROM    year_pairs
    GROUP BY top_two
)
SELECT  yp.year                        -- years whose top-two pair is unique
FROM    year_pairs AS yp
JOIN    pair_freq  AS pf
       ON yp.top_two = pf.top_two
WHERE   pf.yrs = 1
ORDER BY yp.year;
```
