Below are step-by-step discovery queries that show how we can isolate the year whose two most common accident causes differed from the rest of the years in the data set.

```sql
--Description: 1)  List all years that appear in the database
SELECT DISTINCT "db_year"
FROM "case_ids"
ORDER BY "db_year"
LIMIT 20;
```

```sql
--Description: 2)  See the possible values that appear in the collision–cause field
SELECT DISTINCT "primary_collision_factor"
FROM "collisions"
LIMIT 20;
```

```sql
--Description: 3)  Count, for every (year, cause) pair, how many collisions occurred
SELECT  c."db_year",
        col."primary_collision_factor",
        COUNT(*) AS cnt
FROM   "collisions" AS col
JOIN   "case_ids"  AS c
       ON c."case_id" = col."case_id"
GROUP  BY c."db_year", col."primary_collision_factor"
ORDER  BY c."db_year", cnt DESC
LIMIT 20;
```

```sql
--Description: 4)  Rank causes within every year and keep the two largest
WITH year_factor AS (
     SELECT c."db_year"      AS year,
            col."primary_collision_factor" AS factor,
            COUNT(*)        AS cnt
     FROM   "collisions" AS col
     JOIN   "case_ids"  AS c
            ON c."case_id" = col."case_id"
     GROUP  BY year, factor
),
ranked AS (
     SELECT year,
            factor,
            cnt,
            ROW_NUMBER() OVER (PARTITION BY year ORDER BY cnt DESC) AS rn
     FROM   year_factor
)
SELECT year, factor, cnt
FROM   ranked
WHERE  rn <= 2
ORDER  BY year, rn;
```

```sql
--Description: 5)  For every year, concatenate its top two causes so we can compare years easily
WITH year_factor AS (
     SELECT c."db_year" AS year,
            col."primary_collision_factor" AS factor,
            COUNT(*) AS cnt
     FROM   "collisions" AS col
     JOIN   "case_ids"  AS c
            ON c."case_id" = col."case_id"
     GROUP  BY year, factor
),
ranked AS (
     SELECT year,
            factor,
            ROW_NUMBER() OVER (PARTITION BY year ORDER BY cnt DESC) AS rn
     FROM   year_factor
),
top2 AS (
     SELECT year,
            GROUP_CONCAT(factor, '|') AS top_two
     FROM   ranked
     WHERE  rn <= 2
     GROUP  BY year
)
SELECT *
FROM   top2
ORDER  BY year;
```

```sql
--Description: 6)  Find the year(s) whose top-two-cause combination occurs only once (i.e., different from all others)
WITH year_factor AS (
     SELECT c."db_year" AS year,
            col."primary_collision_factor" AS factor,
            COUNT(*) AS cnt
     FROM   "collisions" AS col
     JOIN   "case_ids"  AS c
            ON c."case_id" = col."case_id"
     GROUP  BY year, factor
),
ranked AS (
     SELECT year,
            factor,
            ROW_NUMBER() OVER (PARTITION BY year ORDER BY cnt DESC) AS rn
     FROM   year_factor
),
top2 AS (
     SELECT year,
            GROUP_CONCAT(factor, '|') AS top_two
     FROM   ranked
     WHERE  rn <= 2
     GROUP  BY year
),
pair_occurrences AS (
     SELECT top_two,
            COUNT(*) AS how_many_years
     FROM   top2
     GROUP  BY top_two
)
SELECT t.year
FROM   top2            AS t
JOIN   pair_occurrences AS p
       ON p.top_two = t.top_two
WHERE  p.how_many_years = 1;
```

