Query:
--Description: 5)  For every year, concatenate its top two causes so we can compare years easily
WITH year_factor AS (
     SELECT c."db_year" AS year,
            col."primary_collision_factor" AS factor,
            COUNT(*) AS cnt
     FROM   "collisions" AS col
     JOIN   "case_ids"  AS c
            ON c."case_id" = col."case_id"
     GROUP  BY year, factor
),
ranked AS (
     SELECT year,
            factor,
            ROW_NUMBER() OVER (PARTITION BY year ORDER BY cnt DESC) AS rn
     FROM   year_factor
),
top2 AS (
     SELECT year,
            GROUP_CONCAT(factor, '|') AS top_two
     FROM   ranked
     WHERE  rn <= 2
     GROUP  BY year
)
SELECT *
FROM   top2
ORDER  BY year;
Answer:
