```sql
--Description:  Count crashes by (year, primary_collision_factor); rank causes
--              within each year; keep only the two most frequent causes;
--              concatenate them (rank order preserved) to create a signature;
--              and show, for every year, that signature plus how many other
--              years share the same signature.  This lets you see at a glance
--              whether a year’s two leading causes are unique (share_cnt = 1)
--              or identical to other years.
WITH cause_totals AS (                           -- count per (year, cause)
    SELECT ci."db_year"                  AS yr,
           co."primary_collision_factor" AS cause,
           COUNT(*)                      AS n
    FROM   "collisions"  AS co
    JOIN   "case_ids"    AS ci
           ON ci."case_id" = co."case_id"
    GROUP  BY yr, cause
),
ranked AS (                                      -- rank by frequency
    SELECT yr,
           cause,
           ROW_NUMBER() OVER (PARTITION BY yr ORDER BY n DESC) AS r
    FROM   cause_totals
),
top2 AS (                                        -- keep top-two per year
    SELECT yr,
           GROUP_CONCAT(cause, '|') AS sig
    FROM   ranked
    WHERE  r <= 2
    GROUP  BY yr
),
sig_freq AS (                                    -- how many years share sig
    SELECT sig,
           COUNT(*) AS share_cnt
    FROM   top2
    GROUP  BY sig
)
SELECT t.yr            AS year,
       t.sig           AS top_two_causes,
       s.share_cnt     AS years_sharing_signature
FROM   top2     AS t
JOIN   sig_freq AS s  ON s.sig = t.sig
ORDER  BY t.yr;
```
