```sql
-- 1. See which years are available in the data
SELECT DISTINCT ci."db_year"
FROM "case_ids" AS ci
LIMIT 20;
```

```sql
-- 2. List some distinct “cause” labels that appear in the collisions table
SELECT DISTINCT c."pcf_violation_category"
FROM "collisions" AS c
WHERE c."pcf_violation_category" IS NOT NULL
LIMIT 20;
```

```sql
-- 3. Count the most frequent causes over the whole data set
SELECT c."pcf_violation_category",
       COUNT(*) AS "total_crashes"
FROM   "collisions" AS c
WHERE  c."pcf_violation_category" IS NOT NULL
GROUP  BY c."pcf_violation_category"
ORDER  BY "total_crashes" DESC
LIMIT 20;
```

```sql
-- 4. Count causes for each year
SELECT ci."db_year",
       c."pcf_violation_category",
       COUNT(*) AS "yearly_crashes"
FROM   "collisions" AS c
JOIN   "case_ids"  AS ci
       ON ci."case_id" = c."case_id"
WHERE  c."pcf_violation_category" IS NOT NULL
GROUP  BY ci."db_year", c."pcf_violation_category"
ORDER  BY ci."db_year", "yearly_crashes" DESC
LIMIT 20;
```

```sql
-- 5. Extract the overall TOP-2 causes in the whole data set
WITH overall AS (
  SELECT c."pcf_violation_category",
         COUNT(*) AS cnt
  FROM   "collisions" AS c
  WHERE  c."pcf_violation_category" IS NOT NULL
  GROUP  BY c."pcf_violation_category"
  ORDER  BY cnt DESC
  LIMIT 2
)
SELECT * FROM overall;
```

```sql
-- 6. For every year, rank causes by frequency, keeping only the TOP-2 of each year
WITH yearly AS (
  SELECT ci."db_year"               AS yr,
         c."pcf_violation_category" AS cause,
         COUNT(*)                   AS cnt
  FROM   "collisions" AS c
  JOIN   "case_ids"  AS ci
         ON ci."case_id" = c."case_id"
  WHERE  c."pcf_violation_category" IS NOT NULL
  GROUP  BY yr, cause
),
ranked AS (
  SELECT yr,
         cause,
         cnt,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY cnt DESC) AS rn
  FROM   yearly
)
SELECT yr, cause, cnt
FROM   ranked
WHERE  rn <= 2
ORDER  BY yr, rn
LIMIT 20;
```

```sql
-- 7. Identify the year(s) whose TOP-2 causes differ from the overall TOP-2
WITH overall_top2 AS (
  SELECT c."pcf_violation_category" AS cause
  FROM   "collisions" AS c
  WHERE  c."pcf_violation_category" IS NOT NULL
  GROUP  BY cause
  ORDER  BY COUNT(*) DESC
  LIMIT 2
),
yearly AS (
  SELECT ci."db_year"               AS yr,
         c."pcf_violation_category" AS cause,
         COUNT(*)                   AS cnt
  FROM   "collisions" AS c
  JOIN   "case_ids"  AS ci
         ON ci."case_id" = c."case_id"
  WHERE  c."pcf_violation_category" IS NOT NULL
  GROUP  BY yr, cause
),
ranked AS (
  SELECT yr,
         cause,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY cnt DESC) AS rn
  FROM   yearly
),
top2_per_year AS (
  SELECT yr, cause
  FROM   ranked
  WHERE  rn <= 2
)
SELECT DISTINCT yr AS "year_with_different_top2"
FROM   top2_per_year
WHERE  cause NOT IN (SELECT cause FROM overall_top2)
ORDER  BY yr
LIMIT 20;
```

The final query (Query 7) returns exactly the year(s) in which the two most common causes of traffic accidents were different from the leading two causes observed in all the other years.
