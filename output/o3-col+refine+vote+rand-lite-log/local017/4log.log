Query:
-- 6. For every year, rank causes by frequency, keeping only the TOP-2 of each year
WITH yearly AS (
  SELECT ci."db_year"               AS yr,
         c."pcf_violation_category" AS cause,
         COUNT(*)                   AS cnt
  FROM   "collisions" AS c
  JOIN   "case_ids"  AS ci
         ON ci."case_id" = c."case_id"
  WHERE  c."pcf_violation_category" IS NOT NULL
  GROUP  BY yr, cause
),
ranked AS (
  SELECT yr,
         cause,
         cnt,
         ROW_NUMBER() OVER (PARTITION BY yr ORDER BY cnt DESC) AS rn
  FROM   yearly
)
SELECT yr, cause, cnt
FROM   ranked
WHERE  rn <= 2
ORDER  BY yr, rn
LIMIT 20;
