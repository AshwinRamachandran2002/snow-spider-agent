--             order).  This uses an intermediate ORDER BY on (db_year, rn)
--             before GROUP_CONCAT to guarantee the 1→2 ordering.
WITH ranked AS (
    SELECT  ci."db_year",
            c."primary_collision_factor",
            ROW_NUMBER() OVER (
                 PARTITION BY ci."db_year"
                 ORDER BY COUNT(*) DESC
            ) AS rn
    FROM    "collisions" AS c
    JOIN    "case_ids"   AS ci
           ON ci."case_id" = c."case_id"
    GROUP BY ci."db_year", c."primary_collision_factor"
),
top2 AS (
    SELECT  "db_year",
            "primary_collision_factor",
            rn
    FROM    ranked
    WHERE   rn <= 2
)
