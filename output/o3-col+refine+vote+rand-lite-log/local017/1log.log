```sql
--Description: For every calendar year, display the ordered pair formed by its
--             two most frequent “primary_collision_factor” values.  
--             This lets us visually check whether any year has a pair that
--             differs from the others, without applying filters that might
--             remove all rows.  Steps: (1) rank causes within each year by
--             frequency, (2) keep the top-2 per year, (3) concatenate them
--             (in rank order) into a “signature” string, and (4) show the
--             signature for each year.
WITH ranked AS (
    SELECT  ci."db_year",
            c."primary_collision_factor",
            ROW_NUMBER() OVER (
                PARTITION BY ci."db_year"
                ORDER BY COUNT(*) DESC
            ) AS rn
    FROM    "collisions" AS c
    JOIN    "case_ids"   AS ci
           ON ci."case_id" = c."case_id"
    GROUP BY ci."db_year", c."primary_collision_factor"
),
top2 AS (
    SELECT  "db_year",
            "primary_collision_factor",
            rn
    FROM    ranked
    WHERE   rn <= 2                       -- keep only the two most common
),
signature AS (
    SELECT  "db_year",
            GROUP_CONCAT("primary_collision_factor", ' | ') AS top2_signature
    FROM   (SELECT * FROM top2 ORDER BY "db_year", rn)       -- ensure order 1→2
    GROUP  BY "db_year"
)
SELECT  "db_year",
        top2_signature
FROM    signature
ORDER BY "db_year";
```
