ORDER BY ci."db_year", "cnt" DESC
LIMIT 20;
```

```sql
-- 4) Example: the two most frequent causes for the year 2020 only
SELECT  c."primary_collision_factor",
        COUNT(*) AS "cnt"
FROM    "collisions"  AS c
JOIN    "case_ids"    AS ci
       ON ci."case_id" = c."case_id"
WHERE   ci."db_year" = 2020
GROUP BY c."primary_collision_factor"
ORDER BY "cnt" DESC
LIMIT 2;
```

```sql
-- 5) Rank every cause inside every year and keep the two most common per-year
SELECT  "db_year",
        "primary_collision_factor",
        "cnt"
FROM   (
          SELECT ci."db_year",
                 c."primary_collision_factor",
                 COUNT(*)                             AS "cnt",
                 ROW_NUMBER() OVER (
                       PARTITION BY ci."db_year"
                       ORDER BY COUNT(*) DESC)        AS "rn"
          FROM   "collisions"  AS c
          JOIN   "case_ids"    AS ci
                 ON ci."case_id" = c."case_id"
          GROUP  BY ci."db_year", c."primary_collision_factor"
       )
WHERE   "rn" <= 2
ORDER BY "db_year", "rn"
LIMIT 20;
```

```sql
-- 6) The globally most frequent two causes over the whole data set
SELECT  "primary_collision_factor",
        COUNT(*) AS "cnt"
FROM    "collisions"
GROUP BY "primary_collision_factor"
ORDER BY "cnt" DESC
LIMIT 2;
```

```sql
-- 7) Per-year top-2 causes, but show only those years whose top-2 are *not* both in the global top-2 set
WITH overall_top AS (
       SELECT "primary_collision_factor"
       FROM   "collisions"
       GROUP  BY "primary_collision_factor"
       ORDER  BY COUNT(*) DESC
       LIMIT 2
),
yearly_top AS (
       SELECT "db_year",
              "primary_collision_factor"
       FROM  (
                SELECT ci."db_year",
                       c."primary_collision_factor",
                       ROW_NUMBER() OVER (
                            PARTITION BY ci."db_year"
                            ORDER BY COUNT(*) DESC) AS "rn"
                FROM   "collisions"  AS c
                JOIN   "case_ids"    AS ci
                       ON ci."case_id" = c."case_id"
                GROUP  BY ci."db_year", c."primary_collision_factor"
             )
       WHERE "rn" <= 2
)
SELECT DISTINCT "db_year"
FROM   yearly_top
WHERE  "primary_collision_factor" NOT IN (
       SELECT "primary_collision_factor" FROM overall_top)
LIMIT 20;
```

```sql
-- 8) Build a “signature” of the two leading causes for every year
SELECT  "db_year",
        GROUP_CONCAT("primary_collision_factor", '|') AS "top_2_signature"
FROM   (
          SELECT ci."db_year",
                 c."primary_collision_factor",
                 ROW_NUMBER() OVER (
                       PARTITION BY ci."db_year"
                       ORDER BY COUNT(*) DESC)       AS "rn"
          FROM   "collisions"  AS c
          JOIN   "case_ids"    AS ci
                 ON ci."case_id" = c."case_id"
          GROUP  BY ci."db_year", c."primary_collision_factor"
       )
WHERE   "rn" <= 2
GROUP BY "db_year"
ORDER BY "db_year"
LIMIT 20;
```

```sql
-- 9) Find which signature occurs the most often across years
WITH yearly_sig AS (
       SELECT  "db_year",
               GROUP_CONCAT("primary_collision_factor", '|') AS "sig"
       FROM   (
                SELECT ci."db_year",
                       c."primary_collision_factor",
                       ROW_NUMBER() OVER (
                             PARTITION BY ci."db_year"
                             ORDER BY COUNT(*) DESC) AS "rn"
                FROM   "collisions"  AS c
                JOIN   "case_ids"    AS ci
                       ON ci."case_id" = c."case_id"
                GROUP  BY ci."db_year", c."primary_collision_factor"
              )
       WHERE  "rn" <= 2
       GROUP  BY "db_year"
),
most_common AS (
       SELECT  "sig"
       FROM    yearly_sig
       GROUP   BY "sig"
       ORDER   BY COUNT(*) DESC
       LIMIT 1
)
SELECT  ys."db_year"
FROM    yearly_sig AS ys
WHERE   ys."sig" NOT IN (SELECT "sig" FROM most_common)
LIMIT 20;
```

```sql
-- 10) Final answer: the calendar year(s) whose two most common causes differ from those of every other year
WITH yearly_sig AS (
       SELECT  "db_year",
               GROUP_CONCAT("primary_collision_factor", '|') AS "sig"
       FROM   (
                SELECT ci."db_year",
                       c."primary_collision_factor",
                       ROW_NUMBER() OVER (
                             PARTITION BY ci."db_year"
                             ORDER BY COUNT(*) DESC) AS "rn"
                FROM   "collisions"  AS c
                JOIN   "case_ids"    AS ci
                       ON ci."case_id" = c."case_id"
                GROUP  BY ci."db_year", c."primary_collision_factor"
              )
       WHERE  "rn" <= 2
       GROUP  BY "db_year"
),
sig_popularity AS (
       SELECT  "sig",
               COUNT(*) AS "years_with_this_sig"
       FROM    yearly_sig
       GROUP   BY "sig"
)
SELECT  ys."db_year"
FROM    yearly_sig  AS ys
JOIN    sig_popularity AS sp
       ON ys."sig" = sp."sig"
WHERE   sp."years_with_this_sig" = 1
LIMIT 20;
```

Each query builds on the previous ones, ending with the last query that directly returns “the year(s) in which the two most common causes of traffic accidents were different from those in all other years.”
