```sql
--Description:  Identify the calendar year (or years) whose pair of top-two
--              “primary_collision_factor” values is unique—i.e., a pair that
--              no other year shares.  Logic:
--              1.  Count collisions per cause within each year and rank them.
--              2.  Keep only the two highest-ranked causes per year (rn ≤ 2).
--              3.  Build an ordered signature string ‘cause1 | cause2’ for
--                 every year (ordering enforced by rn).
--              4.  Count how many years possess each signature.
--              5.  Return the year(s) whose signature occurs exactly once.
WITH ranked AS (            -- Step 1 & 2: rank causes inside each year
    SELECT  ci."db_year",
            c."primary_collision_factor",
            ROW_NUMBER() OVER (
                PARTITION BY ci."db_year"
                ORDER BY COUNT(*) DESC
            ) AS rn
    FROM    "collisions" AS c
    JOIN    "case_ids"   AS ci
           ON ci."case_id" = c."case_id"
    GROUP  BY ci."db_year", c."primary_collision_factor"
),
top2 AS (                   -- keep only rn = 1 or 2
    SELECT  "db_year",
            "primary_collision_factor",
            rn
    FROM    ranked
    WHERE   rn <= 2
),
yearly_sig AS (             -- Step 3: build ordered signature per year
    SELECT  "db_year",
            GROUP_CONCAT("primary_collision_factor", ' | ') AS sig
    FROM   (SELECT * FROM top2 ORDER BY "db_year", rn)   -- enforce order
    GROUP  BY "db_year"
),
sig_stats AS (              -- Step 4: how many years share each signature?
    SELECT  sig,
            COUNT(*) AS yrs_with_sig
    FROM    yearly_sig
    GROUP   BY sig
)
SELECT  ys."db_year"        -- Step 5: the unique year(s), if any
FROM    yearly_sig  AS ys
JOIN    sig_stats  AS ss  ON ys.sig = ss.sig
WHERE   ss.yrs_with_sig = 1
ORDER  BY ys."db_year";
