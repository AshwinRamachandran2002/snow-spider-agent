```sql
--Description:  For every calendar year, return the single most frequent
--              “primary_collision_factor” (i.e., the leading cause of crashes)
--              together with the number of collisions it accounts for.
--              Steps:
--              1)  Count collisions per (year, cause).
--              2)  Rank causes inside each year by that count.
--              3)  Keep only the #1 (rn = 1) cause for every year.
WITH cause_counts AS (                    -- step 1: tally collisions per cause/year
    SELECT  ci."db_year",
            c."primary_collision_factor" AS cause,
            COUNT(*)                     AS cnt
    FROM    "collisions" AS c
    JOIN    "case_ids"  AS ci
           ON ci."case_id" = c."case_id"
    GROUP  BY ci."db_year", c."primary_collision_factor"
),
ranked AS (                               -- step 2: rank causes within each year
    SELECT  db_year,
            cause,
            cnt,
            ROW_NUMBER() OVER (
                 PARTITION BY db_year
                 ORDER BY cnt DESC
            ) AS rn
    FROM    cause_counts
)
SELECT  db_year,
        cause      AS top_cause,
        cnt        AS collision_count
FROM    ranked
WHERE   rn = 1                            -- step 3: keep only the #1 cause
ORDER  BY db_year;
```
