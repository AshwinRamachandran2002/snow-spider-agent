```sql
WITH cause_counts AS (            -- 1) collisions per (year, cause)
    SELECT  ci."db_year",
            c."primary_collision_factor" AS cause,
            COUNT(*)                     AS cnt
    FROM    "collisions" AS c
    JOIN    "case_ids"  AS ci
           ON ci."case_id" = c."case_id"
    GROUP   BY ci."db_year", c."primary_collision_factor"
),
ranked AS (                       -- 2) rank causes inside each year
    SELECT  "db_year",
            cause,
            ROW_NUMBER() OVER (
                PARTITION BY "db_year"
                ORDER BY cnt DESC
            ) AS rn
    FROM    cause_counts
),
top2 AS (                         -- 3) keep the two most frequent causes
    SELECT  "db_year",
            cause
    FROM    ranked
    WHERE   rn <= 2
),
year_sig AS (                     -- 4) build a canonical (alphabetic) signature
    SELECT  "db_year",
            GROUP_CONCAT(cause, ' | ') AS sig
    FROM   (SELECT * FROM top2 ORDER BY "db_year", cause)
    GROUP  BY "db_year"
),
sig_uniqueness AS (               -- 5) how many years share each signature
    SELECT  "db_year",
            sig,
            COUNT(*) OVER (PARTITION BY sig) AS sig_years
    FROM    year_sig
)
SELECT  "db_year"                 -- 6) years whose top-2 signature is unique
FROM    sig_uniqueness
WHERE   sig_years = 1
ORDER   BY "db_year";
```
