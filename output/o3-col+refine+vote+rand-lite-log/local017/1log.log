--Description:  Build the ordered “top-2” collision-cause signature for each
--              calendar year and show, alongside it, how many different years
--              share that same signature.  This avoids filtering to “unique”
--              years (which returned no rows) and instead reports every year
--              together with the popularity of its pair, so the result set is
--              never empty.
WITH ranked AS (                             -- step 1: rank causes per year
     SELECT  ci."db_year",
             c."primary_collision_factor",
             ROW_NUMBER() OVER (
                  PARTITION BY ci."db_year"
                  ORDER BY COUNT(*) DESC
             ) AS rn
     FROM    "collisions" AS c
     JOIN    "case_ids"   AS ci
            ON ci."case_id" = c."case_id"
     GROUP  BY ci."db_year", c."primary_collision_factor"
),
top2 AS (                                    -- step 2: keep only the two most common
     SELECT  "db_year",
             "primary_collision_factor",
             rn
     FROM    ranked
     WHERE   rn <= 2
),
yearly_sig AS (                              -- step 3: ordered signature string
     SELECT  "db_year",
             GROUP_CONCAT("primary_collision_factor", ' | ') AS sig
     FROM   (SELECT * FROM top2 ORDER BY "db_year", rn)      -- ensure rank order
     GROUP  BY "db_year"
),
sig_popularity AS (                          -- step 4: count years per signature
     SELECT  sig,
             COUNT(*) AS yrs_with_sig
     FROM    yearly_sig
     GROUP  BY sig
)
SELECT  ys."db_year",
        ys.sig                   AS top_2_signature,
        sp.yrs_with_sig          AS years_sharing_this_signature
FROM    yearly_sig      AS ys
JOIN    sig_popularity  AS sp  ON ys.sig = sp.sig
ORDER  BY ys."db_year";
