```sql
--Description: Determine which calendar year(s) have a unique pair of top-two
--             “primary_collision_factor” values (i.e., their two most frequent
--             crash causes are different from the top-two pair seen in every
--             other year).  Steps:
--             1) Rank causes within each year by frequency and keep the top-2.
--             2) Build a signature string for each year by concatenating its
--                two leading causes in rank order.
--             3) Count how many years share each signature.
--             4) Return the year(s) whose signature occurs exactly once.
WITH ranked AS (
    SELECT  ci."db_year",
            c."primary_collision_factor",
            ROW_NUMBER() OVER (
                PARTITION BY ci."db_year"
                ORDER BY COUNT(*) DESC
            ) AS rn
    FROM    "collisions" AS c
    JOIN    "case_ids"   AS ci
           ON ci."case_id" = c."case_id"
    GROUP BY ci."db_year", c."primary_collision_factor"
),
top2 AS (
    SELECT  "db_year",
            "primary_collision_factor"
    FROM    ranked
    WHERE   rn <= 2
),
signature AS (
    SELECT  "db_year",
            GROUP_CONCAT("primary_collision_factor", ' | ') AS sig
    FROM    top2
    GROUP   BY "db_year"
),
sig_stats AS (
    SELECT  sig,
            COUNT(*) AS yrs_with_sig
    FROM    signature
    GROUP   BY sig
)
SELECT  s."db_year"
FROM    signature AS s
JOIN    sig_stats AS ss
      ON s.sig = ss.sig
WHERE   ss.yrs_with_sig = 1
ORDER BY s."db_year";
```
