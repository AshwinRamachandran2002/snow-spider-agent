```sql
--Description:
--Goal: Show every calendar year’s Top-2 collision causes, indicate whether that
--pair differs from the dataset’s most common Top-2 combination, and thereby
--reveal if *any* year is an outlier.
--Logic
-- 1. ranked_causes ─ count collisions per cause within each year and rank them.
-- 2. pairs         ─ keep rank 1 & 2, producing one row (top_1, top_2) per year.
-- 3. usual_pair    ─ the Top-2 pair that appears in the greatest number of years.
-- 4. Final SELECT  ─ list every year, its Top-2 causes, and a flag
--                    differs_from_usual (1 = different pair, 0 = same).
WITH ranked_causes AS (
    SELECT  c."db_year",
            col."primary_collision_factor",
            COUNT(*)                                   AS crash_count,
            RANK() OVER (PARTITION BY c."db_year"
                         ORDER BY COUNT(*) DESC)       AS rk
    FROM    "collisions" AS col
    JOIN    "case_ids"   AS c
           ON col."case_id" = c."case_id"
    GROUP   BY c."db_year", col."primary_collision_factor"
),
pairs AS (
    SELECT  db_year,
            MAX(CASE WHEN rk = 1 THEN primary_collision_factor END) AS top_1,
            MAX(CASE WHEN rk = 2 THEN primary_collision_factor END) AS top_2
    FROM    ranked_causes
    WHERE   rk <= 2
    GROUP   BY db_year
),
usual_pair AS (
    SELECT  top_1, top_2
    FROM    pairs
    GROUP   BY top_1, top_2
    ORDER   BY COUNT(*) DESC
    LIMIT   1
)
SELECT  p.db_year,
        p.top_1,
        p.top_2,
        CASE WHEN p.top_1 = u.top_1 AND p.top_2 = u.top_2 THEN 0 ELSE 1 END AS differs_from_usual
FROM    pairs AS p
CROSS   JOIN usual_pair AS u
ORDER   BY p.db_year;
