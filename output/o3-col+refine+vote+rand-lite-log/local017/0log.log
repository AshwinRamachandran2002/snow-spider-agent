```sql
/*  Year(s) whose two most frequent “primary_collision_factor” values
    (the Top-2 causes) differ from the pair that is most common across
    all calendar years.                                              */

WITH cause_totals AS (                           -- crashes per cause & year
    SELECT  c."db_year",
            col."primary_collision_factor" AS cause,
            COUNT(*)                       AS crashes
    FROM    "collisions"  AS col
    JOIN    "case_ids"    AS c
           ON c."case_id" = col."case_id"
    GROUP   BY c."db_year", col."primary_collision_factor"
),
top2_per_year AS (                               -- keep the Top-2 for each year
    SELECT  db_year,
            cause,
            ROW_NUMBER() OVER (PARTITION BY db_year
                               ORDER BY crashes DESC, cause) AS rn
    FROM    cause_totals
),
pairs AS (                                       -- one row per year, 2 causes
    SELECT  db_year,
            MAX(CASE WHEN rn = 1 THEN cause END) AS c1,
            MAX(CASE WHEN rn = 2 THEN cause END) AS c2
    FROM    top2_per_year
    WHERE   rn <= 2
    GROUP   BY db_year
),
sorted_pairs AS (                                -- sort the two causes so that
    SELECT  db_year,                             --   order does not matter
            CASE WHEN c2 IS NULL OR c1 <= c2 THEN c1 ELSE c2 END AS a,
            CASE WHEN c2 IS NULL OR c1 <= c2 THEN c2 ELSE c1 END AS b
    FROM    pairs
),
most_common_pair AS (                            -- pair that appears most often
    SELECT  a, b
    FROM    sorted_pairs
    GROUP   BY a, b
    ORDER   BY COUNT(*) DESC
    LIMIT 1
)
SELECT  sp.db_year
FROM    sorted_pairs AS sp
LEFT    JOIN most_common_pair AS mc
           ON sp.a = mc.a
          AND ( (sp.b IS mc.b) OR (sp.b IS NULL AND mc.b IS NULL) )
WHERE   mc.a IS NULL                 -- years whose pair is different
ORDER   BY sp.db_year;
```
