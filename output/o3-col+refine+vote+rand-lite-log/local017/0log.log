--Description:
--Question: “In which year were the two most common causes of traffic accidents
--different from those in other years?”
--Thinking process
-- 1. Rank the causes within each calendar year (ranked_causes).
-- 2. Collapse to a single row per year containing its Top-2 causes (pairs).
-- 3. Identify the Top-2 combination that occurs in the greatest number of
--    years (usual_pair).
-- 4. Return the years whose Top-2 pair differs from that usual pair.
--    If the query returns no rows, it means every year shares the same Top-2
--    causes, so there is **no** year with a different pair.
WITH ranked_causes AS (
    SELECT  c."db_year",
            col."primary_collision_factor",
            COUNT(*)                                   AS crashes,
            RANK() OVER (PARTITION BY c."db_year"
                         ORDER BY COUNT(*) DESC)       AS rk
    FROM    "collisions" AS col
    JOIN    "case_ids"   AS c
           ON col."case_id" = c."case_id"
    GROUP   BY c."db_year", col."primary_collision_factor"
),
pairs AS (
    SELECT  db_year,
            MAX(CASE WHEN rk = 1 THEN primary_collision_factor END) AS top_1,
            MAX(CASE WHEN rk = 2 THEN primary_collision_factor END) AS top_2
    FROM    ranked_causes
    WHERE   rk <= 2
    GROUP   BY db_year
),
usual_pair AS (
    SELECT  top_1, top_2
    FROM    pairs
    GROUP   BY top_1, top_2
    ORDER   BY COUNT(*) DESC
    LIMIT   1                   -- the pair that dominates the most years
)
SELECT  p.db_year
FROM    pairs AS p
CROSS   JOIN usual_pair AS u
WHERE   p.top_1 <> u.top_1 OR p.top_2 <> u.top_2
ORDER   BY p.db_year;
