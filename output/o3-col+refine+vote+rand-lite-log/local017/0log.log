```sql
--Description (thinking process inside):
-- Goal: find the calendar year whose TOP-2 collision causes differ from the
--       most common TOP-2 pattern that appears in the other years.
-- Steps
--   1) ranked_causes  – for every year, rank causes by frequency.
--   2) pairs          – keep only rank 1 & 2, turning them into one row per year.
--   3) usual_pair     – determine the (top1, top2) pair that occurs in the
--                       greatest number of years (= the “usual” pair).
--   4) final SELECT   – list years whose pair ≠ usual pair.
WITH ranked_causes AS (
    SELECT  c."db_year",
            col."primary_collision_factor",
            COUNT(*)                                       AS crashes,
            RANK() OVER (PARTITION BY c."db_year"
                         ORDER BY COUNT(*) DESC)           AS rk
    FROM    "collisions"  AS col
    JOIN    "case_ids"    AS c
           ON col."case_id" = c."case_id"
    GROUP   BY c."db_year", col."primary_collision_factor"
),
pairs AS (
    SELECT  db_year,
            MAX(CASE WHEN rk = 1 THEN primary_collision_factor END) AS top1,
            MAX(CASE WHEN rk = 2 THEN primary_collision_factor END) AS top2
    FROM    ranked_causes
    WHERE   rk <= 2
    GROUP   BY db_year
),
usual_pair AS (
    SELECT  top1, top2
    FROM    pairs
    GROUP   BY top1, top2
    ORDER   BY COUNT(*) DESC
    LIMIT   1                       -- the pair that dominates most years
)
SELECT  p.db_year
FROM    pairs AS p
CROSS   JOIN usual_pair AS u
WHERE   (p.top1 <> u.top1 OR p.top2 <> u.top2)
ORDER   BY p.db_year;
```
