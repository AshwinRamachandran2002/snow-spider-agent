```sql
--Description (thinking process):
--  Objective: return every year whose TWO most-frequent collision–cause
--             categories differ from the pair that appears most often
--             across all years.
--
--  Inner logic, built step-by-step inside one SQL:
--    a)  Join collisions with case_ids to attach each crash to its year.
--    b)  For every (year, cause) combination, count collisions.
--    c)  Within each year, RANK the causes by count and keep rank ≤ 2
--        (the “Top-2” causes for that year).
--    d)  GROUP_CONCAT those two causes into a single string (top2_pair)
--        per year.
--    e)  From the set of top2_pair values, find the one occurring in the
--        greatest number of years (the modal pair).
--    f)  Finally, list the years whose top2_pair ≠ that modal pair.
SELECT   yr_pairs."db_year"
FROM   (
        /* ---- build each year’s Top-2 pair ---- */
        SELECT   ci."db_year",
                 GROUP_CONCAT(rk."pcf_violation_category", ' | ') AS "top2_pair"
        FROM   (
                /* rank causes inside each year */
                SELECT   ci."db_year",
                         co."pcf_violation_category",
                         RANK() OVER (PARTITION BY ci."db_year"
                                      ORDER BY COUNT(*) DESC) AS rk_num
                FROM     "collisions" AS co
                JOIN     "case_ids"   AS ci USING ("case_id")
                WHERE    co."pcf_violation_category" IS NOT NULL
                GROUP BY ci."db_year", co."pcf_violation_category"
              ) AS rk
        WHERE  rk.rk_num <= 2
        GROUP BY ci."db_year"
      ) AS yr_pairs
/* ---- exclude the modal Top-2 pair ---- */
WHERE yr_pairs."top2_pair" <> (
        SELECT   modal."top2_pair"
        FROM   (
                SELECT   top2_pair, COUNT(*) AS yrs
                FROM   (
                        SELECT   ci."db_year",
                                 GROUP_CONCAT(rk2."pcf_violation_category", ' | ') AS top2_pair
                        FROM   (
                                /* same ranking step reused */
                                SELECT   ci."db_year",
                                         co."pcf_violation_category",
                                         RANK() OVER (PARTITION BY ci."db_year"
                                                      ORDER BY COUNT(*) DESC) AS rk_num
                                FROM     "collisions" AS co
                                JOIN     "case_ids"   AS ci USING ("case_id")
                                WHERE    co."pcf_violation_category" IS NOT NULL
                                GROUP BY ci."db_year", co."pcf_violation_category"
                              ) AS rk2
                        WHERE rk2.rk_num <= 2
                        GROUP BY ci."db_year"
                      )
                GROUP BY top2_pair
                ORDER BY yrs DESC
                LIMIT 1               -- modal pair
              ) AS modal
      )
ORDER BY yr_pairs."db_year";
