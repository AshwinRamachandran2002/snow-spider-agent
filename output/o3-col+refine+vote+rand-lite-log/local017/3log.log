--Description: List the year(s) whose TOP-2 collision-cause categories differ
--             from the pair that appears in the greatest number of years.
--             The query fixes earlier alias-scope errors by always referring
--             to columns that exist in the current SELECT level.
WITH ranked AS (               -- Step-1: rank causes inside each year
    SELECT   ci."db_year",
             co."pcf_violation_category",
             COUNT(*) AS cnt,
             RANK() OVER (PARTITION BY ci."db_year"
                          ORDER BY COUNT(*) DESC) AS rk
    FROM     "collisions"  AS co
    JOIN     "case_ids"    AS ci USING ("case_id")
    WHERE    co."pcf_violation_category" IS NOT NULL
    GROUP BY ci."db_year", co."pcf_violation_category"
),
year_pairs AS (                -- Step-2: keep Top-2 and build a pair string
    SELECT   r."db_year",
             GROUP_CONCAT(r."pcf_violation_category", ' | ') AS top2_pair
    FROM     ranked AS r
    WHERE    r.rk <= 2
    GROUP BY r."db_year"
),
modal_pair AS (                -- Step-3: find the “usual” pair (appears most years)
    SELECT   yp.top2_pair
    FROM     year_pairs AS yp
    GROUP BY yp.top2_pair
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
-- Step-4: return the exceptional years
SELECT   yp."db_year"
FROM     year_pairs AS yp
WHERE    yp.top2_pair NOT IN (SELECT mp.top2_pair FROM modal_pair AS mp)
ORDER BY yp."db_year";
