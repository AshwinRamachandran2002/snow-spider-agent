```sql
--Description (thinking process):
--  Objective: Find the year(s) whose TWO most-frequent collision-cause
--             categories differ from the pair that shows up in the
--             greatest number of other years.
--
--  Steps wrapped in one query:
--    1. ranked   : For each (year, pcf_violation_category) count collisions
--                  and rank the categories within the year.
--    2. year_pairs: Keep only rank ≤ 2, then GROUP_CONCAT the two categories
--                  (ordered by rank) into a single string (top2_pair) per year.
--    3. modal_pair: Determine the most common top2_pair across all years
--                  (i.e., the “usual” pair) by counting how many years each
--                  pair appears in; take the top one.
--    4. Final SELECT lists the years whose top2_pair ≠ the modal pair.
WITH ranked AS (
    SELECT   ci."db_year",
             co."pcf_violation_category",
             COUNT(*)                                                  AS cnt,
             RANK() OVER (PARTITION BY ci."db_year"
                          ORDER BY COUNT(*) DESC)                      AS rk
    FROM     "collisions" AS co
    JOIN     "case_ids"   AS ci USING ("case_id")
    WHERE    co."pcf_violation_category" IS NOT NULL
    GROUP BY ci."db_year", co."pcf_violation_category"
),
year_pairs AS (
    SELECT   "db_year",
             GROUP_CONCAT("pcf_violation_category", ' | ') AS top2_pair
    FROM     ranked
    WHERE    rk <= 2
    GROUP BY "db_year"
),
modal_pair AS (
    SELECT   top2_pair
    FROM     year_pairs
    GROUP BY top2_pair
    ORDER BY COUNT(*) DESC   -- most years having that pair
    LIMIT 1
)
SELECT   "db_year"
FROM     year_pairs
WHERE    top2_pair NOT IN (SELECT top2_pair FROM modal_pair)
ORDER BY "db_year";
```
