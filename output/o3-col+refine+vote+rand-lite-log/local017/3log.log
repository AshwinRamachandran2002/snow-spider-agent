```sql
-- 9. Finally, list any year whose TOP-2 pair is NOT the usual one
SELECT   yr_pairs."db_year"
FROM   (
        SELECT ci."db_year",
               GROUP_CONCAT(co."pcf_violation_category", ' | ') AS "top2_pair"
        FROM   (
                SELECT ci."db_year",
                       co."pcf_violation_category",
                       RANK() OVER (PARTITION BY ci."db_year"
                                    ORDER BY COUNT(*) DESC) AS "rk"
                FROM   "collisions" AS co
                JOIN   "case_ids"  AS ci USING ("case_id")
                WHERE  co."pcf_violation_category" IS NOT NULL
                GROUP  BY ci."db_year", co."pcf_violation_category"
              ) AS ranked
        WHERE  ranked."rk" <= 2
        GROUP BY ci."db_year"
      ) AS yr_pairs
WHERE  yr_pairs."top2_pair" NOT IN (
       /* sub-query that returns the single most common pair */
       SELECT "top2_pair"
       FROM   (
               SELECT   "top2_pair",
                        COUNT(*) AS "year_occurrences"
               FROM   (
                       SELECT ci."db_year",
                              GROUP_CONCAT(co."pcf_violation_category", ' | ') AS "top2_pair"
                       FROM   (
                               SELECT ci."db_year",
                                      co."pcf_violation_category",
                                      RANK() OVER (PARTITION BY ci."db_year"
                                                   ORDER BY COUNT(*) DESC) AS "rk"
                               FROM   "collisions" AS co
                               JOIN   "case_ids"  AS ci USING ("case_id")
                               WHERE  co."pcf_violation_category" IS NOT NULL
                               GROUP  BY ci."db_year", co."pcf_violation_category"
                              ) AS ranked
                       WHERE  ranked."rk" <= 2
                       GROUP BY ci."db_year"
                     )
               GROUP BY "top2_pair"
               ORDER BY "year_occurrences" DESC
               LIMIT 1
             )
)
ORDER BY yr_pairs."db_year";
