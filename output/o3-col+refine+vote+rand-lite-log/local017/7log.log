),
top2 AS (                              -- keep the top-2 causes per year
    SELECT "db_year",
           GROUP_CONCAT(cause, ', ') AS top_two_causes
    FROM   ranked
    WHERE  rk <= 2
    GROUP  BY "db_year"
),
pair_freq AS (                         -- count years sharing each pair
    SELECT top_two_causes,
           COUNT(*) AS yrs_with_pair
    FROM   top2
    GROUP  BY top_two_causes
)
SELECT t."db_year",
       t.top_two_causes,
       p.yrs_with_pair                 -- =1 would indicate a unique year
