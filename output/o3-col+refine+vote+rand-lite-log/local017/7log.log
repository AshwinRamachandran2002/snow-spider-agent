```sql
-- 7) Years whose top-two-cause pair is NOT the most common pair
SELECT db_year
FROM   (
        SELECT db_year,
               GROUP_CONCAT(primary_collision_factor, ', ') AS top_two_causes
        FROM   (
                SELECT ci."db_year" AS db_year,
                       c."primary_collision_factor",
                       COUNT(*) AS collisions_count,
                       ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                                           ORDER BY COUNT(*) DESC) AS rk
                FROM   "collisions" AS c
                JOIN   "case_ids"   AS ci
                       ON ci."case_id" = c."case_id"
                GROUP  BY ci."db_year", c."primary_collision_factor"
               )
        WHERE  rk <= 2
        GROUP  BY db_year
       ) per_year
WHERE  top_two_causes NOT IN (
       /* find the single most common pair (largest count) */
       SELECT top_two_causes
       FROM   (
               SELECT top_two_causes,
                      COUNT(*) AS yrs
               FROM   (
                       SELECT db_year,
                              GROUP_CONCAT(primary_collision_factor, ', ') AS top_two_causes
                       FROM   (
                               SELECT ci."db_year" AS db_year,
                                      c."primary_collision_factor",
                                      COUNT(*) AS cnt,
                                      ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                                                          ORDER BY COUNT(*) DESC) AS rk
                               FROM   "collisions" AS c
                               JOIN   "case_ids"   AS ci
                                      ON ci."case_id" = c."case_id"
                               GROUP  BY ci."db_year", c."primary_collision_factor"
                              )
                       WHERE  rk <= 2
                       GROUP  BY db_year
                      )
               GROUP  BY top_two_causes
               ORDER  BY yrs DESC
               LIMIT 1
              )
      )
ORDER  BY db_year
LIMIT 20;
```

```sql
-- 8) Show those “outlier” years together with their unique top-two causes
SELECT per_year.db_year,
       per_year.top_two_causes
FROM   (
        SELECT db_year,
               GROUP_CONCAT(primary_collision_factor, ', ') AS top_two_causes
        FROM   (
                SELECT ci."db_year" AS db_year,
                       c."primary_collision_factor",
                       COUNT(*) AS collisions_count,
                       ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                                           ORDER BY COUNT(*) DESC) AS rk
                FROM   "collisions" AS c
                JOIN   "case_ids"   AS ci
                       ON ci."case_id" = c."case_id"
                GROUP  BY ci."db_year", c."primary_collision_factor"
               )
        WHERE  rk <= 2
        GROUP  BY db_year
       ) per_year
JOIN   (
        /* pairs that occur in ONLY ONE year */
        SELECT top_two_causes
        FROM   (
                SELECT top_two_causes,
                       COUNT(*) AS cnt
                FROM   (
                        SELECT db_year,
                               GROUP_CONCAT(primary_collision_factor, ', ') AS top_two_causes
                        FROM   (
                                SELECT ci."db_year" AS db_year,
                                       c."primary_collision_factor",
                                       COUNT(*) AS ccount,
                                       ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                                                           ORDER BY COUNT(*) DESC) AS rk
                                FROM   "collisions" AS c
                                JOIN   "case_ids"   AS ci
                                       ON ci."case_id" = c."case_id"
                                GROUP  BY ci."db_year", c."primary_collision_factor"
                               )
                        WHERE  rk <= 2
                        GROUP  BY db_year
                       )
                GROUP  BY top_two_causes
               )
        WHERE cnt = 1
       ) uniq
       ON per_year.top_two_causes = uniq.top_two_causes
ORDER  BY per_year.db_year
LIMIT 20;
```
