```sql
WITH ranked_causes AS (
    SELECT
        ci."db_year",
        c."primary_collision_factor",
        COUNT(*) AS collisions_count,
        ROW_NUMBER() OVER (
            PARTITION BY ci."db_year"
            ORDER BY COUNT(*) DESC
        ) AS rk
    FROM "collisions" AS c
    JOIN "case_ids" AS ci
         ON ci."case_id" = c."case_id"
    GROUP BY ci."db_year", c."primary_collision_factor"
),
top_two AS (
    /* keep only the two most frequent causes of each year */
    SELECT
        db_year,
        primary_collision_factor,
        collisions_count
    FROM ranked_causes
    WHERE rk <= 2
),
pair_per_year AS (
    /* concatenate the (ordered) two causes into a single string per year */
    SELECT
        db_year,
        (
            SELECT GROUP_CONCAT(primary_collision_factor, ', ')
            FROM top_two t2
            WHERE t2.db_year = t1.db_year
            ORDER BY collisions_count DESC
        ) AS top_two_causes
    FROM top_two t1
    GROUP BY db_year
),
pair_frequency AS (
    /* how many years share each particular pair of causes? */
    SELECT
        top_two_causes,
        COUNT(*) AS years_with_this_pair
    FROM pair_per_year
    GROUP BY top_two_causes
)
SELECT
    p.db_year
FROM pair_per_year AS p
JOIN pair_frequency AS f
      ON f.top_two_causes = p.top_two_causes
WHERE f.years_with_this_pair = 1   -- pairs that appear in exactly one year
ORDER BY p.db_year;
```
