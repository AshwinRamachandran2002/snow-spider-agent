```sql
--Description: Identify “outlier” years—those whose two most common
--             primary_collision_factor values form a pair that occurs
--             in exactly ONE year.  The query builds three CTEs:
--   1) top_causes → ranks causes inside each year.
--   2) per_year   → keeps the top-2 causes per year and concatenates them.
--   3) pair_freq  → counts how many different years share each two-cause pair.
--   Finally, we select the years whose pair appears only once (cnt = 1).

WITH top_causes AS (
    SELECT ci."db_year",
           c."primary_collision_factor" AS cause,
           COUNT(*)                     AS cnt,
           ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                              ORDER BY COUNT(*) DESC) AS rk
    FROM   "collisions"  c
    JOIN   "case_ids"    ci ON ci."case_id" = c."case_id"
    GROUP  BY ci."db_year", c."primary_collision_factor"
),
per_year AS (
    SELECT "db_year",
           GROUP_CONCAT(cause, ', ') AS top_two_causes
    FROM   top_causes
    WHERE  rk <= 2
    GROUP  BY "db_year"
),
pair_freq AS (
    SELECT top_two_causes,
           COUNT(*) AS cnt
    FROM   per_year
    GROUP  BY top_two_causes
)
SELECT p."db_year",
       p.top_two_causes
FROM   per_year  AS p
JOIN   pair_freq AS f ON p.top_two_causes = f.top_two_causes
WHERE  f.cnt = 1
ORDER  BY p."db_year";
```
