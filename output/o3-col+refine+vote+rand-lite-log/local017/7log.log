```sql
--Description: Find the year(s) whose two most frequent primary_collision_factor
--             values are not shared by any other year.  Steps:
--             1) ranked – rank causes within each year by frequency.
--             2) top2   – build a comma-separated pair of the top-2 causes per year.
--             3) pair_ct– count how many years have each pair.
--             The final SELECT returns only those years whose pair appears
--             in exactly one year (yrs_with_pair = 1).  If this query returns
--             no rows, every year shares the same leading two causes.
WITH ranked AS (
    SELECT ci."db_year",
           c."primary_collision_factor"              AS cause,
           ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                              ORDER BY COUNT(*) DESC) AS rk
    FROM   "collisions"  c
    JOIN   "case_ids"    ci ON ci."case_id" = c."case_id"
    GROUP  BY ci."db_year", c."primary_collision_factor"
),
top2 AS (
    SELECT "db_year",
           GROUP_CONCAT(cause, ', ')                AS top_two_causes
    FROM   ranked
    WHERE  rk <= 2
    GROUP  BY "db_year"
),
pair_ct AS (
    SELECT top_two_causes,
           COUNT(*) AS yrs_with_pair
    FROM   top2
    GROUP  BY top_two_causes
)
SELECT t."db_year"
FROM   top2     AS t
JOIN   pair_ct  AS p ON t.top_two_causes = p.top_two_causes
WHERE  p.yrs_with_pair = 1;
