--             Running this shows that every available year (2018, 2020, 2021)
--             shares the same pair “…vehicle code violation, unknown…”, so no
--             outlier year exists—the top-two causes are identical across years.
WITH ranked AS (                       -- rank causes inside each year
    SELECT ci."db_year",
           c."primary_collision_factor"            AS cause,
           ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                              ORDER BY COUNT(*) DESC) AS rk
    FROM   "collisions"  c
