```sql
--Description / Thinking process:
-- Show, for every year, what its TWO most frequent primary_collision_factor values are,
-- and how many different years share the same pair.  This is simpler than the earlier
-- “unique-pair” filter and will always return rows, letting us see whether any year has
-- a pair that differs from all others (yrs_with_pair = 1).

WITH top_causes AS (      -- rank causes inside each year
    SELECT ci."db_year",
           c."primary_collision_factor" AS cause,
           COUNT(*)                     AS cnt,
           ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                              ORDER BY COUNT(*) DESC) AS rk
    FROM   "collisions"  c
    JOIN   "case_ids"    ci ON ci."case_id" = c."case_id"
    GROUP  BY ci."db_year", c."primary_collision_factor"
),
per_year AS (             -- keep the top-2 causes per year
    SELECT "db_year",
           GROUP_CONCAT(cause, ', ') AS top_two_causes
    FROM   top_causes
    WHERE  rk <= 2
    GROUP  BY "db_year"
),
pair_freq AS (            -- how many years share each pair?
    SELECT top_two_causes,
           COUNT(*) AS yrs_with_pair
    FROM   per_year
    GROUP  BY top_two_causes
)
SELECT p."db_year",
       p.top_two_causes,
       f.yrs_with_pair
FROM   per_year  p
JOIN   pair_freq f ON p.top_two_causes = f.top_two_causes
ORDER  BY p."db_year";
```
