```sql
--Description: Identify any “outlier” year whose two most common
--             primary_collision_factor values form a pair that appears
--             in no other year.  Steps:
--             1) top_causes – rank causes by frequency within each year.
--             2) per_year   – keep only the top-2 causes per year and
--                             concatenate them into one string.
--             3) pair_freq  – count how many different years share
--                             each two-cause pair.
--             The final SELECT returns only those years whose pair
--             occurs in exactly one year (cnt = 1).  If the result
--             set is empty, it means every year shares the same pair.
WITH top_causes AS (
    SELECT  ci."db_year",
            c."primary_collision_factor"               AS cause,
            ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                               ORDER BY COUNT(*) DESC) AS rk
    FROM    "collisions"  c
    JOIN    "case_ids"    ci ON ci."case_id" = c."case_id"
    GROUP   BY ci."db_year", c."primary_collision_factor"
),
per_year AS (
    SELECT  "db_year",
            GROUP_CONCAT(cause, ', ') AS top_two_causes
    FROM    top_causes
    WHERE   rk <= 2                          -- keep only ranks 1 and 2
    GROUP   BY "db_year"
),
