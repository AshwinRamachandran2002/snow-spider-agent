```sql
-- 4) The TWO most common causes in every year (row-number window function)
SELECT db_year,
       primary_collision_factor,
       collisions_count
FROM   (
        SELECT ci."db_year"                       AS db_year,
               c."primary_collision_factor",
               COUNT(*)                           AS collisions_count,
               ROW_NUMBER() OVER (PARTITION BY ci."db_year"
                                   ORDER BY COUNT(*) DESC) AS rk
        FROM   "collisions" AS c
        JOIN   "case_ids"   AS ci
               ON ci."case_id" = c."case_id"
        GROUP  BY ci."db_year", c."primary_collision_factor"
       )
WHERE  rk <= 2
ORDER  BY db_year, rk
LIMIT 20;
