```sql
--Description: 1) List all years available in the data set (table case_ids).
SELECT DISTINCT ci."db_year"
FROM "case_ids" AS ci
ORDER BY ci."db_year"
LIMIT 20;
```

```sql
--Description: 2) Inspect the different violation categories that appear as the primary cause of collisions.
SELECT DISTINCT c."pcf_violation_category"
FROM "collisions" AS c
WHERE c."pcf_violation_category" IS NOT NULL
ORDER BY c."pcf_violation_category"
LIMIT 20;
```

```sql
--Description: 3) Find the overall twenty most common violation categories (all years combined).
SELECT c."pcf_violation_category",
       COUNT(*) AS collisions_cnt
FROM "collisions" AS c
WHERE c."pcf_violation_category" IS NOT NULL
GROUP BY c."pcf_violation_category"
ORDER BY collisions_cnt DESC
LIMIT 20;
```

```sql
--Description: 4) Count, for every year & violation category, how many collisions occurred.
SELECT ci."db_year",
       c."pcf_violation_category",
       COUNT(*) AS collisions_cnt
FROM "collisions"  AS c
JOIN "case_ids"    AS ci  ON ci."case_id" = c."case_id"
WHERE c."pcf_violation_category" IS NOT NULL
GROUP BY ci."db_year", c."pcf_violation_category"
ORDER BY ci."db_year", collisions_cnt DESC
LIMIT 20;
```

```sql
--Description: 5) Use a window-function to keep only the two most frequent categories per year.
SELECT *
FROM (
        SELECT ci."db_year",
               c."pcf_violation_category",
               COUNT(*)                                     AS collisions_cnt,
               ROW_NUMBER() OVER (
                     PARTITION BY ci."db_year"
                     ORDER BY COUNT(*) DESC
               )                                            AS rn
        FROM "collisions"  AS c
        JOIN "case_ids"    AS ci ON ci."case_id" = c."case_id"
        WHERE c."pcf_violation_category" IS NOT NULL
        GROUP BY ci."db_year", c."pcf_violation_category"
) AS ranked
WHERE rn <= 2
ORDER BY "db_year", rn
LIMIT 20;
```

```sql
--Description: 6) For every year, concatenate the two leading categories into a single string.
SELECT yr_top."db_year",
       GROUP_CONCAT(yr_top."pcf_violation_category", ' | ') AS top2_categories
FROM (
        SELECT ci."db_year",
               c."pcf_violation_category",
               ROW_NUMBER() OVER (
                     PARTITION BY ci."db_year"
                     ORDER BY COUNT(*) DESC
               ) AS rn
        FROM "collisions"  AS c
        JOIN "case_ids"    AS ci ON ci."case_id" = c."case_id"
        WHERE c."pcf_violation_category" IS NOT NULL
        GROUP BY ci."db_year", c."pcf_violation_category"
) AS yr_top
WHERE yr_top.rn <= 2
GROUP BY yr_top."db_year"
ORDER BY yr_top."db_year"
LIMIT 20;
```

```sql
--Description: 7) Count how often each top-2 combination appears across years.
SELECT top2_categories,
       COUNT(*) AS years_with_this_pair
FROM (
       SELECT yr_top."db_year",
              GROUP_CONCAT(yr_top."pcf_violation_category", ' | ') AS top2_categories
       FROM (
              SELECT ci."db_year",
                     c."pcf_violation_category",
                     ROW_NUMBER() OVER (
                          PARTITION BY ci."db_year"
                          ORDER BY COUNT(*) DESC
                     ) AS rn
              FROM "collisions"  AS c
              JOIN "case_ids"    AS ci ON ci."case_id" = c."case_id"
              WHERE c."pcf_violation_category" IS NOT NULL
              GROUP BY ci."db_year", c."pcf_violation_category"
       ) AS yr_top
       WHERE yr_top.rn <= 2
       GROUP BY yr_top."db_year"
) AS pairs
GROUP BY top2_categories
ORDER BY years_with_this_pair DESC
LIMIT 20;
```

```sql
--Description: 8) Identify the year(s) whose pair of leading causes occurs only once (i.e., different from all others).
SELECT pairs."db_year"
FROM (
        SELECT yr_top."db_year",
               GROUP_CONCAT(yr_top."pcf_violation_category", ' | ') AS top2_categories
        FROM (
                SELECT ci."db_year",
                       c."pcf_violation_category",
                       ROW_NUMBER() OVER (
                             PARTITION BY ci."db_year"
                             ORDER BY COUNT(*) DESC
                       ) AS rn
                FROM "collisions"  AS c
                JOIN "case_ids"    AS ci ON ci."case_id" = c."case_id"
                WHERE c."pcf_violation_category" IS NOT NULL
                GROUP BY ci."db_year", c."pcf_violation_category"
        ) AS yr_top
        WHERE yr_top.rn <= 2
        GROUP BY yr_top."db_year"
) AS pairs
GROUP BY pairs."top2_categories"
HAVING COUNT(*) = 1
LIMIT 20;
```

```sql
--Description: 9) Show the two leading categories for the (unique) year(s) found in query 8.
SELECT yr_top."db_year",
       yr_top."pcf_violation_category",
       yr_top."collisions_cnt"
FROM (
        SELECT ci."db_year",
               c."pcf_violation_category",
               COUNT(*)                                     AS collisions_cnt,
               ROW_NUMBER() OVER (
                     PARTITION BY ci."db_year"
                     ORDER BY COUNT(*) DESC
               )                                            AS rn
        FROM "collisions"  AS c
        JOIN "case_ids"    AS ci ON ci."case_id" = c."case_id"
        WHERE c."pcf_violation_category" IS NOT NULL
        GROUP BY ci."db_year", c."pcf_violation_category"
) AS yr_top
WHERE yr_top.rn <= 2
  AND yr_top."db_year" IN (      -- yearly list returned by query 8
       SELECT pairs."db_year"
       FROM (
              SELECT yr_top."db_year",
                     GROUP_CONCAT(yr_top."pcf_violation_category", ' | ') AS top2_categories
              FROM (
                     SELECT ci."db_year",
                            c."pcf_violation_category",
                            ROW_NUMBER() OVER (
                                  PARTITION BY ci."db_year"
                                  ORDER BY COUNT(*) DESC
                            ) AS rn
                     FROM "collisions"  AS c
                     JOIN "case_ids"    AS ci ON ci."case_id" = c."case_id"
                     WHERE c."pcf_violation_category" IS NOT NULL
                     GROUP BY ci."db_year", c."pcf_violation_category"
              ) AS yr_top
              WHERE yr_top.rn <= 2
              GROUP BY yr_top."db_year"
       ) AS pairs
       GROUP BY pairs."top2_categories"
       HAVING COUNT(*) = 1
   )
ORDER BY yr_top."db_year", yr_top."collisions_cnt" DESC
LIMIT 20;
```

