```sql
/*  Longest gap (in days) between the first visit and the last-recorded event
    for any user whose last-recorded event occurred during a mobile session.   */

WITH
-- every session: who, when, and whether it was on mobile
visits AS (
  SELECT
    fullVisitorId,
    visitStartTime,           -- session start (epoch-seconds)
    device.isMobile           AS is_mobile
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),

-- first transaction time (session start + hit offset) for each buyer
first_tx AS (
  SELECT
    fullVisitorId,
    MIN(visitStartTime + CAST(hit.time / 1000 AS INT64)) AS first_tx_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
       UNNEST(hits) AS hit
  WHERE hit.transaction.transactionId IS NOT NULL
  GROUP BY fullVisitorId
),

-- earliest and latest sessions for each user (regardless of device),
-- plus their first-transaction timestamp (if any)
first_last AS (
  SELECT
    v.fullVisitorId,
    MIN(v.visitStartTime) AS first_visit_ts,
    MAX(v.visitStartTime) AS last_visit_ts,
    ft.first_tx_ts
  FROM visits          AS v
  LEFT JOIN first_tx   AS ft USING (fullVisitorId)
  GROUP BY v.fullVisitorId, ft.first_tx_ts
),

-- the epoch-time of the last recorded event for each user
last_event AS (
  SELECT
    fullVisitorId,
    first_visit_ts,
    GREATEST(last_visit_ts, COALESCE(first_tx_ts, 0)) AS last_event_ts
  FROM first_last
),

-- keep only those users whose last recorded event happened 
-- in a session that was on a mobile device
mobile_last_event AS (
  SELECT
    le.*
  FROM last_event AS le
  JOIN visits     AS v
    ON  v.fullVisitorId  = le.fullVisitorId
    AND v.visitStartTime = le.last_visit_ts   -- session of the last event
  WHERE v.is_mobile = TRUE                    -- that session was mobile
)

-- final answer: maximum number of days between first visit and last event
SELECT
  MAX(
    DATE_DIFF(
      DATE(TIMESTAMP_SECONDS(last_event_ts)),
      DATE(TIMESTAMP_SECONDS(first_visit_ts)),
      DAY
    )
  ) AS max_days_between
FROM mobile_last_event;
