--Description: 1) Take a quick look at some session–level fields that will be
--needed (user id, visit time, device flag, and whether the session contained
--a transaction).
SELECT
  fullVisitorId,
  visitNumber,
  visitStartTime,
  DATETIME(TIMESTAMP_SECONDS(visitStartTime))   AS visit_datetime,
  device.isMobile                               AS is_mobile,
  totals.transactions                           AS session_transactions
