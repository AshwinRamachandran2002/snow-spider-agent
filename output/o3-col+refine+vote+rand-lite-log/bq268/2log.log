--each user we hold all three timestamps.
SELECT
  v.fullVisitorId,
  first_visit_ts,
  last_visit_ts,
  t.first_transaction_ts
FROM (
  SELECT
    fullVisitorId,
    MIN(visitStartTime) AS first_visit_ts,
    MAX(visitStartTime) AS last_visit_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
) AS v
LEFT JOIN (
  SELECT
    fullVisitorId,
    MIN(visitStartTime + CAST(hit.time / 1000 AS INT64)) AS first_transaction_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
       UNNEST(hits) AS hit
  WHERE hit.transaction.transactionId IS NOT NULL
  GROUP BY fullVisitorId
) AS t
USING (fullVisitorId)
