```sql
--Description: 6) Compute, for every user, the epoch-seconds of the very first
--session and the very last session (regardless of device).  This is the “visit”
--part of the eventual calculation.
SELECT
  fullVisitorId,
  MIN(visitStartTime) AS first_visit_ts,
  MAX(visitStartTime) AS last_visit_ts
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
--Description: 7) Find, for every user that has ever purchased, the epoch
--seconds of his / her first transaction (the minimum of every hit that carries
--a transaction-id).
SELECT
  fullVisitorId,
  MIN(visitStartTime + INT64(hit.time/1000)) AS first_transaction_ts
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
     UNNEST(hits) AS hit
WHERE hit.transaction.transactionId IS NOT NULL
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
--Description: 8) Join the previous two sub-results so that for each user we
--have: first_visit_ts, last_visit_ts, and (if it exists) first_transaction_ts.
SELECT
  v.fullVisitorId,
  first_visit_ts,
  last_visit_ts,
  t.first_transaction_ts
FROM (
  SELECT fullVisitorId,
         MIN(visitStartTime) AS first_visit_ts,
         MAX(visitStartTime) AS last_visit_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId) AS v
LEFT JOIN (
  SELECT
    fullVisitorId,
    MIN(visitStartTime + INT64(hit.time/1000)) AS first_transaction_ts
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
       UNNEST(hits) AS hit
  WHERE hit.transaction.transactionId IS NOT NULL
  GROUP BY fullVisitorId) AS t
USING (fullVisitorId)
LIMIT 20;
```

```sql
--Description: 9) For each user, decide which time-stamp is the “last recorded
--event”: it is the later of (last visit) or (first transaction).  Keep only
--those users whose *last recorded event* happened in a session that is flagged
--as mobile.  Show the gap in whole days.
WITH
  visits AS (
    SELECT
      fullVisitorId,
      visitStartTime,
      device.isMobile
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  ),
  first_tx AS (
    SELECT
      fullVisitorId,
      MIN(visitStartTime + INT64(hit.time/1000)) AS first_tx_ts
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
         UNNEST(hits) AS hit
    WHERE hit.transaction.transactionId IS NOT NULL
    GROUP BY fullVisitorId
  ),
  first_last AS (
    SELECT
      v.fullVisitorId,
      MIN(v.visitStartTime)                                   AS first_visit_ts,
      MAX(v.visitStartTime)                                   AS last_visit_ts,
      ft.first_tx_ts
    FROM visits AS v
    LEFT JOIN first_tx  AS ft USING (fullVisitorId)
    GROUP BY v.fullVisitorId, ft.first_tx_ts
  ),
  last_event AS (
    SELECT
      f.fullVisitorId,
      f.first_visit_ts,
      -- choose the later of the two candidates
      GREATEST(f.last_visit_ts, COALESCE(f.first_tx_ts,0))    AS last_event_ts
    FROM first_last AS f
  )
SELECT
  l.fullVisitorId,
  DATE_DIFF(DATE(TIMESTAMP_SECONDS(l.last_event_ts)),
            DATE(TIMESTAMP_SECONDS(l.first_visit_ts)), DAY)   AS days_between
FROM last_event AS l
JOIN visits AS v
  ON v.fullVisitorId   = l.fullVisitorId
 AND v.visitStartTime  = l.last_event_ts           -- the session of the last event
WHERE v.isMobile = TRUE
ORDER BY days_between DESC
LIMIT 20;
```

```sql
--Description: 10) Produce the single longest observed gap (in days) between
--first visit and last recorded event for a user whose last event occurred on a
--mobile device.  This is the final answer query (no extra columns, one row).
WITH
  visits AS (
    SELECT
      fullVisitorId,
      visitStartTime,
      device.isMobile
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  ),
  first_tx AS (
    SELECT
      fullVisitorId,
      MIN(visitStartTime + INT64(hit.time/1000)) AS first_tx_ts
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
         UNNEST(hits) AS hit
    WHERE hit.transaction.transactionId IS NOT NULL
    GROUP BY fullVisitorId
  ),
  first_last AS (
    SELECT
      v.fullVisitorId,
      MIN(v.visitStartTime)                                   AS first_visit_ts,
      MAX(v.visitStartTime)                                   AS last_visit_ts,
      ft.first_tx_ts
    FROM visits AS v
    LEFT JOIN first_tx  AS ft USING (fullVisitorId)
    GROUP BY v.fullVisitorId, ft.first_tx_ts
  ),
  last_event AS (
    SELECT
      f.fullVisitorId,
      f.first_visit_ts,
      GREATEST(f.last_visit_ts, COALESCE(f.first_tx_ts,0))    AS last_event_ts
    FROM first_last AS f
  ),
  last_mobile AS (
    SELECT
      l.fullVisitorId,
      l.first_visit_ts,
      l.last_event_ts
    FROM last_event AS l
    JOIN visits AS v
      ON v.fullVisitorId  = l.fullVisitorId
     AND v.visitStartTime = l.last_event_ts     -- ensure we look at that session
    WHERE v.isMobile = TRUE                     -- the last event is mobile
  )
SELECT
  MAX(DATE_DIFF(DATE(TIMESTAMP_SECONDS(last_event_ts)),
                DATE(TIMESTAMP_SECONDS(first_visit_ts)), DAY)) AS max_days_between
FROM last_mobile;
