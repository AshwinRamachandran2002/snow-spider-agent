```sql
-- Description: 6)  Build a per-user timeline: first visit date & last visit date across *all* tables
SELECT
  fullVisitorId,
  MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_visit_date,
  MAX(DATE(PARSE_DATE('%Y%m%d', date))) AS last_visit_date
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_*`
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- Description: 7)  Find every user’s first *transaction* date across all tables
SELECT
  fullVisitorId,
  MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_trans_date
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
  UNNEST(hits) AS h
WHERE
  h.transaction.transactionId IS NOT NULL
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- Description: 8)  Determine, for each user, the date of her “last event”  
--      (max visit OR first transaction – whichever is LATER)
WITH visits AS (
  SELECT
    fullVisitorId,
    MAX(DATE(PARSE_DATE('%Y%m%d', date))) AS last_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
first_tx AS (
  SELECT
    fullVisitorId,
    MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_trans_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
       UNNEST(hits) AS h
  WHERE h.transaction.transactionId IS NOT NULL
  GROUP BY fullVisitorId
)
SELECT
  v.fullVisitorId,
  v.last_visit_date,
  f.first_trans_date,
  GREATEST(v.last_visit_date, IFNULL(f.first_trans_date, DATE '1900-01-01')) AS last_event_date
FROM visits v
LEFT JOIN first_tx f USING (fullVisitorId)
LIMIT 20;
```

```sql
-- Description: 9)  Append the device category of that “last event”.   
--      Here we look at the session that *contains* the chosen last_event_date.
WITH last_evt AS (
  /* query from step 8 */
  SELECT
    v.fullVisitorId,
    GREATEST(v.last_visit_date,
             IFNULL(f.first_trans_date, DATE '1900-01-01')) AS last_event_date
  FROM (
    SELECT fullVisitorId, MAX(DATE(PARSE_DATE('%Y%m%d', date))) AS last_visit_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    GROUP BY fullVisitorId ) v
  LEFT JOIN (
    SELECT fullVisitorId, MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_trans_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
         UNNEST(hits) AS h
    WHERE h.transaction.transactionId IS NOT NULL
    GROUP BY fullVisitorId ) f
  USING (fullVisitorId)
)
SELECT
  l.fullVisitorId,
  l.last_event_date,
  ANY_VALUE(s.device.isMobile) AS is_mobile_last_event
FROM
  last_evt l
JOIN
  `bigquery-public-data.google_analytics_sample.ga_sessions_*`  s
ON
  s.fullVisitorId = l.fullVisitorId
  AND DATE(PARSE_DATE('%Y%m%d', s.date)) = l.last_event_date
GROUP BY l.fullVisitorId, l.last_event_date
LIMIT 20;
```

```sql
-- Description: 10)  Finally, get the day-difference between first visit and last event  
--      ONLY for users whose last event was on a mobile device, order by the longest span
WITH first_visit AS (
  SELECT
    fullVisitorId,
    MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
last_evt AS (
  /* step-9 logic condensed */
  SELECT
    l.fullVisitorId,
    l.last_event_date
  FROM (
    SELECT
      fullVisitorId,
      GREATEST(MAX(DATE(PARSE_DATE('%Y%m%d', date))),
               IFNULL((SELECT MIN(DATE(PARSE_DATE('%Y%m%d', date)))
                       FROM UNNEST(hits) h
                       WHERE h.transaction.transactionId IS NOT NULL), DATE '1900-01-01')) AS last_event_date,
      ANY_VALUE(ANY_VALUE(device.isMobile)) AS is_mobile -- collect any sample
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    GROUP BY fullVisitorId
  ) l
  WHERE is_mobile -- keep only users whose last event session is mobile
)
SELECT
  f.fullVisitorId,
  f.first_visit_date,
  l.last_event_date,
  DATE_DIFF(l.last_event_date, f.first_visit_date, DAY) AS days_between
FROM first_visit f
JOIN last_evt  l USING (fullVisitorId)
ORDER BY days_between DESC
LIMIT 20;
```
