Query:
-- Description: 5)  Using a two-year wildcard, gather every session’s basic facts (date string is handy)
SELECT
  _TABLE_SUFFIX                     AS tbl_day,
  fullVisitorId,
  DATE(PARSE_DATE('%Y%m%d', date))  AS session_date,
  visitStartTime,
  device.isMobile                   AS is_mobile
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE
  _TABLE_SUFFIX BETWEEN '20160101' AND '20171231'
LIMIT 20;
