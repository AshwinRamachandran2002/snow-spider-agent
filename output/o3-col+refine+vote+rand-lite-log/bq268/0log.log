Query:
-- Description: 3)  Peek inside the hits array to see how we recognise a transaction
SELECT
  fullVisitorId,
  h.transaction.transactionId        AS trans_id,
  h.transaction.transactionRevenue   AS trans_revenue,
  h.hitNumber,
  h.time
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`,
  UNNEST(hits) AS h
WHERE
  h.transaction.transactionId IS NOT NULL
LIMIT 20;
