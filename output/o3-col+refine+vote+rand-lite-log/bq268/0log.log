Query:
-- Description: 1)  Look at a handful of sessions in one day-table to remind ourselves of the columns
SELECT
  fullVisitorId,
  visitNumber,
  date,
  visitStartTime,
  device.isMobile AS is_mobile,
  totals.transactions,
  totals.transactionRevenue
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
LIMIT 20;
