Query:
-- Description: 4)  For one day, return the *first* transaction moment per user (epoch seconds)
SELECT
  fullVisitorId,
  MIN(visitStartTime + h.time) AS first_trans_ts
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`,
  UNNEST(hits) AS h
WHERE
  h.transaction.transactionId IS NOT NULL
GROUP BY fullVisitorId
LIMIT 20;
