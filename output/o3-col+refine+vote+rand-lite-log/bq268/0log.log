-- Description: 9)  Append the device category of that “last event”.   
--      Here we look at the session that *contains* the chosen last_event_date.
WITH last_evt AS (
  /* query from step 8 */
  SELECT
    v.fullVisitorId,
    GREATEST(v.last_visit_date,
             IFNULL(f.first_trans_date, DATE '1900-01-01')) AS last_event_date
  FROM (
    SELECT fullVisitorId, MAX(DATE(PARSE_DATE('%Y%m%d', date))) AS last_visit_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    GROUP BY fullVisitorId ) v
  LEFT JOIN (
    SELECT fullVisitorId, MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_trans_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
         UNNEST(hits) AS h
    WHERE h.transaction.transactionId IS NOT NULL
    GROUP BY fullVisitorId ) f
  USING (fullVisitorId)
)
SELECT
  l.fullVisitorId,
  l.last_event_date,
  ANY_VALUE(s.device.isMobile) AS is_mobile_last_event
FROM
  last_evt l
JOIN
  `bigquery-public-data.google_analytics_sample.ga_sessions_*`  s
ON
  s.fullVisitorId = l.fullVisitorId
  AND DATE(PARSE_DATE('%Y%m%d', s.date)) = l.last_event_date
GROUP BY l.fullVisitorId, l.last_event_date
LIMIT 20;
