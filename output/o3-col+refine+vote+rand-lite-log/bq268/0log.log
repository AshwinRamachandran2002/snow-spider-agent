Query:
-- Description: 6)  Build a per-user timeline: first visit date & last visit date across *all* tables
SELECT
  fullVisitorId,
  MIN(DATE(PARSE_DATE('%Y%m%d', date))) AS first_visit_date,
  MAX(DATE(PARSE_DATE('%Y%m%d', date))) AS last_visit_date
FROM
  `bigquery-public-data.google_analytics_sample.ga_sessions_*`
GROUP BY fullVisitorId
LIMIT 20;
