--Description:  Calculate, for every visitor, the number of days between her very first
--              session and her “last recorded event”.  The last recorded event is the
--              later of (a) the visitor’s last session date and (b) her first-ever
--              transaction date.  Keep only those visitors whose session(s) on that
--              last-event date were performed on a mobile device, then list the
--              visitors with the longest spans.
--
--              CTE steps implemented in-line:
--              1. sessions   – one row per session with flags: is_mobile & has_transaction.
--              2. per_user   – derive first_visit, last_visit, first_transaction dates.
--              3. last_event – choose the later of last_visit vs first_transaction.
--              4. mobile_evt – verify at least one mobile session on last_event date.
--              5. final      – compute span, filter to mobile visitors, show longest.
WITH sessions AS (                 -- every session (all daily tables)
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', date))               AS session_date,
    device.isMobile                                AS is_mobile,
    EXISTS (                                       -- does this session include a transaction?
      SELECT 1
      FROM UNNEST(hits) h
      WHERE h.transaction.transactionId IS NOT NULL
    )                                              AS has_transaction
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),

per_user AS (                     -- milestone dates per visitor
  SELECT
    fullVisitorId,
    MIN(session_date)                                AS first_visit_date,
    MAX(session_date)                                AS last_visit_date,
    MIN(IF(has_transaction, session_date, NULL))     AS first_trans_date
  FROM sessions
  GROUP BY fullVisitorId
),

last_event AS (                   -- determine visitor’s “last recorded event”
  SELECT
    fullVisitorId,
    first_visit_date,
    GREATEST(
      last_visit_date,
      IFNULL(first_trans_date, DATE '1900-01-01')
    ) AS last_event_date
  FROM per_user
),

mobile_evt AS (                   -- confirm at least one mobile session on last_event_date
  SELECT
    l.fullVisitorId,
    l.first_visit_date,
    l.last_event_date,
    MAX(CASE WHEN s.is_mobile THEN 1 ELSE 0 END) AS is_mobile_last_event
  FROM last_event l
  JOIN sessions s
    ON s.fullVisitorId = l.fullVisitorId
   AND s.session_date  = l.last_event_date
  GROUP BY l.fullVisitorId, l.first_visit_date, l.last_event_date
)

SELECT
  fullVisitorId,
  first_visit_date,
  last_event_date,
  DATE_DIFF(last_event_date, first_visit_date, DAY) AS days_between
FROM mobile_evt
WHERE is_mobile_last_event = 1                     -- keep only mobile last events
ORDER BY days_between DESC
LIMIT 20;
