```sql
--Description:  Find, for every visitor, the number of days between
--              her very first session and her “last recorded event”.
--              “Last recorded event” = later of
--                 (a) last session date
--                 (b) first-ever transaction date
--              Keep only visitors whose session(s) on that last-event
--              date were made from a mobile device and list the
--              longest spans.
--              (The thinking path is implemented as consecutive CTEs.)
WITH
/*-----------------------------------------------------------
  1. sessions – one row per session with two flags:
       is_mobile          : TRUE/FALSE
       has_transaction    : does this session include any txn?
-----------------------------------------------------------*/
sessions AS (
  SELECT
    fullVisitorId,
    DATE(PARSE_DATE('%Y%m%d', date)) AS session_date,
    device.isMobile                  AS is_mobile,
    EXISTS (
      SELECT 1
      FROM UNNEST(hits) h
      WHERE h.transaction.transactionId IS NOT NULL
    )                                AS has_transaction
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
),
/*-----------------------------------------------------------
  2. per_user – milestone dates for each visitor
-----------------------------------------------------------*/
per_user AS (
  SELECT
    fullVisitorId,
    MIN(session_date)                                            AS first_visit_date,
    MAX(session_date)                                            AS last_visit_date,
    MIN(IF(has_transaction, session_date, NULL))                 AS first_trans_date
  FROM sessions
  GROUP BY fullVisitorId
),
/*-----------------------------------------------------------
  3. last_evt – decide the “last recorded event” date
-----------------------------------------------------------*/
last_evt AS (
  SELECT
    fullVisitorId,
    first_visit_date,
    GREATEST(last_visit_date,
             IFNULL(first_trans_date, DATE '1900-01-01'))        AS last_event_date
  FROM per_user
),
/*-----------------------------------------------------------
  4. mobile_check – confirm the last-event date had a mobile session
-----------------------------------------------------------*/
mobile_check AS (
  SELECT
    l.fullVisitorId,
    l.first_visit_date,
    l.last_event_date,
    BOOL_OR(s.is_mobile) AS is_mobile_last_event
  FROM last_evt l
  JOIN sessions s
    ON s.fullVisitorId = l.fullVisitorId
   AND s.session_date  = l.last_event_date
  GROUP BY l.fullVisitorId, l.first_visit_date, l.last_event_date
)
/*-----------------------------------------------------------
  5. final – compute span & order by longest
-----------------------------------------------------------*/
SELECT
  fullVisitorId,
  first_visit_date,
  last_event_date,
  DATE_DIFF(last_event_date, first_visit_date, DAY) AS days_between
FROM mobile_check
WHERE is_mobile_last_event = TRUE
ORDER BY days_between DESC
LIMIT 20;
