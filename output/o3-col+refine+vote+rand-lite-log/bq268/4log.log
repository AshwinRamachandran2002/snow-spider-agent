--Description / Thinking process:
-- 1) We are interested in TWO daily tables (20170127 and 20170125).
-- 2) Inside EACH table we have to aggregate first, otherwise BigQuery
--    complains that fullVisitorId is neither grouped nor aggregated.
-- 3) For every user (fullVisitorId) we want:
--      • first_visit_date  ........  MIN(date)
--      • first_transaction_date ... MIN(date) where transactions > 0
-- 4) Once each table has been summarised (GROUP BY fullVisitorId),
--    we UNION ALL the two result sets so we keep users that appear
--    in either day.  We wrap all of that in a sub-query so we can
--    put a LIMIT at the very end just for inspection.
SELECT *
FROM (
    /*  --- summarise 2017-01-27 --- */
    SELECT
        fullVisitorId,
        MIN(date) AS first_visit_date,
        MIN(IF(totals.transactions > 0, date, NULL)) AS first_transaction_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
    GROUP BY fullVisitorId

    UNION ALL

    /*  --- summarise 2017-01-25 --- */
    SELECT
        fullVisitorId,
        MIN(date) AS first_visit_date,
        MIN(IF(totals.transactions > 0, date, NULL)) AS first_transaction_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_20170125`
    GROUP BY fullVisitorId
)
LIMIT 20;
