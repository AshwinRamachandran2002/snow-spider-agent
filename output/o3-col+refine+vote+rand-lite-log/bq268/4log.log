```sql
-- 7.  Combine the two sub-queries (first visit & first transaction)
--     and also keep the device flag that belongs to the chosen
--     “last recorded event”.
WITH visits AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_visit_date,
    MAX(date) AS last_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
transactions AS (
  SELECT
    fullVisitorId,
    MIN(date) AS first_transaction_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
  GROUP BY fullVisitorId
),
chosen_event AS (
  SELECT
    v.fullVisitorId,
    v.first_visit_date,
    -- if a transaction exists take its date,
    -- otherwise take the last visit date
    COALESCE(t.first_transaction_date, v.last_visit_date) AS last_event_date
  FROM visits v
  LEFT JOIN transactions t
  USING (fullVisitorId)
)
SELECT * FROM chosen_event
LIMIT 20;
```

```sql
-- 8.  Attach the device.isMobile flag that corresponds to
--     each user’s chosen last_event_date session.
WITH chosen_event AS (
  -- identical CTE from query 7
  SELECT
    v.fullVisitorId,
    v.first_visit_date,
    COALESCE(t.first_transaction_date, v.last_visit_date) AS last_event_date
  FROM (
    SELECT fullVisitorId, MIN(date) AS first_visit_date, MAX(date) AS last_visit_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    GROUP BY fullVisitorId
  ) v
  LEFT JOIN (
    SELECT fullVisitorId, MIN(date) AS first_transaction_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE totals.transactions > 0
    GROUP BY fullVisitorId
  ) t
  USING (fullVisitorId)
)
SELECT
  e.fullVisitorId,
  e.first_visit_date,
  e.last_event_date,
  ANY_VALUE(s.device.isMobile) AS last_event_is_mobile          -- should be TRUE
FROM chosen_event  e
JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
  ON  s.fullVisitorId = e.fullVisitorId
  AND s.date          = e.last_event_date
GROUP BY e.fullVisitorId, e.first_visit_date, e.last_event_date
LIMIT 20;
```

```sql
-- 9.  Compute the number of days between first visit and the
--     qualifying last event (mobile only); order by the gap.
WITH chosen_event AS (
  SELECT
    v.fullVisitorId,
    v.first_visit_date,
    COALESCE(t.first_transaction_date, v.last_visit_date) AS last_event_date
  FROM (
    SELECT fullVisitorId, MIN(date) AS first_visit_date, MAX(date) AS last_visit_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    GROUP BY fullVisitorId
  ) v
  LEFT JOIN (
    SELECT fullVisitorId, MIN(date) AS first_transaction_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE totals.transactions > 0
    GROUP BY fullVisitorId
  ) t
  USING (fullVisitorId)
),
mobile_last AS (
  SELECT
    e.*,
    ANY_VALUE(s.device.isMobile) AS last_event_is_mobile
  FROM chosen_event  e
  JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
    ON  s.fullVisitorId = e.fullVisitorId
    AND s.date          = e.last_event_date
  GROUP BY e.fullVisitorId, e.first_visit_date, e.last_event_date
)
SELECT
  fullVisitorId,
  first_visit_date,
  last_event_date,
  DATE_DIFF(PARSE_DATE('%Y%m%d', last_event_date),
            PARSE_DATE('%Y%m%d', first_visit_date),
            DAY) AS days_between
FROM mobile_last
WHERE last_event_is_mobile = TRUE
ORDER BY days_between DESC
LIMIT 20;
```

```sql
-- 10.  FINAL ANSWER: the user(s) with the longest gap (in days)
--      between the very first visit and the qualifying last
--      recorded event that happened on a mobile device.
WITH chosen_event AS (
  SELECT
    v.fullVisitorId,
    v.first_visit_date,
    COALESCE(t.first_transaction_date, v.last_visit_date) AS last_event_date
  FROM (
    SELECT fullVisitorId, MIN(date) AS first_visit_date, MAX(date) AS last_visit_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    GROUP BY fullVisitorId
  ) v
  LEFT JOIN (
    SELECT fullVisitorId, MIN(date) AS first_transaction_date
    FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
    WHERE totals.transactions > 0
    GROUP BY fullVisitorId
  ) t
  USING (fullVisitorId)
),
mobile_last AS (
  SELECT
    e.*,
    ANY_VALUE(s.device.isMobile) AS last_event_is_mobile
  FROM chosen_event  e
  JOIN `bigquery-public-data.google_analytics_sample.ga_sessions_*` AS s
    ON  s.fullVisitorId = e.fullVisitorId
    AND s.date          = e.last_event_date
  GROUP BY e.fullVisitorId, e.first_visit_date, e.last_event_date
),
gap AS (
  SELECT
    fullVisitorId,
    first_visit_date,
    last_event_date,
    DATE_DIFF(PARSE_DATE('%Y%m%d', last_event_date),
              PARSE_DATE('%Y%m%d', first_visit_date),
              DAY) AS days_between
  FROM mobile_last
  WHERE last_event_is_mobile = TRUE
)
SELECT *
FROM gap
WHERE days_between = (SELECT MAX(days_between) FROM gap)
LIMIT 20;
