Query:
--Description:  Query 5 – For every user across ALL ga_sessions_* tables,
--              return the earliest date we ever saw them (first_visit_date)
--              and the latest date we saw them (last_visit_date).  Each table
--              is unioned automatically via the wildcard; we aggregate with
--              GROUP BY fullVisitorId so all columns in SELECT are either
--              grouped or aggregated.
SELECT
  fullVisitorId,
  MIN(date) AS first_visit_date,
  MAX(date) AS last_visit_date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
