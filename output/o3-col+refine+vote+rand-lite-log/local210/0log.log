```sql
--Description: 1) Look at the different possible order-status values.  
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--Description: 2) Check how many orders exist in each month of 2021, any status.  
SELECT "order_created_month",
       COUNT(*) AS "orders_total"
FROM "orders"
WHERE "order_created_year" = 2021
GROUP BY "order_created_month"
ORDER BY "order_created_month"
LIMIT 20;
```

```sql
--Description: 3) Count only FINISHED orders per month (all hubs grouped together).  
SELECT "order_created_month",
       COUNT(*) AS "orders_finished"
FROM "orders"
WHERE "order_status" = 'FINISHED'
  AND "order_created_year" = 2021
GROUP BY "order_created_month"
ORDER BY "order_created_month"
LIMIT 20;
```

```sql
--Description: 4) Join orders → stores → hubs to see how many FINISHED orders
-- each hub had in February (month = 2).  
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "feb_finished"
FROM   "orders"  o
JOIN   "stores"  s ON s."store_id" = o."store_id"
JOIN   "hubs"    h ON h."hub_id"   = s."hub_id"
WHERE  o."order_status"        = 'FINISHED'
  AND  o."order_created_year"  = 2021
  AND  o."order_created_month" = 2
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: 5) Same join, but for March (month = 3).  
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "mar_finished"
FROM   "orders"  o
JOIN   "stores"  s ON s."store_id" = o."store_id"
JOIN   "hubs"    h ON h."hub_id"   = s."hub_id"
WHERE  o."order_status"        = 'FINISHED'
  AND  o."order_created_year"  = 2021
  AND  o."order_created_month" = 3
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: 6) Put February and March together side-by-side for each hub.  
SELECT h."hub_id",
       h."hub_name",
       SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished",
       SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished"
FROM   "orders"  o
JOIN   "stores"  s ON s."store_id" = o."store_id"
JOIN   "hubs"    h ON h."hub_id"   = s."hub_id"
WHERE  o."order_status"       = 'FINISHED'
  AND  o."order_created_year" = 2021
  AND  o."order_created_month" IN (2,3)
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: 7) Calculate the percentage change from Feb ➜ Mar for each hub.  
SELECT sub."hub_id",
       sub."hub_name",
       sub."feb_finished",
       sub."mar_finished",
       ROUND(
         (sub."mar_finished" - sub."feb_finished") * 100.0 / sub."feb_finished",
         1
       ) AS "pct_change"
FROM (
      SELECT h."hub_id",
             h."hub_name",
             SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished",
             SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished"
      FROM   "orders"  o
      JOIN   "stores"  s ON s."store_id" = o."store_id"
      JOIN   "hubs"    h ON h."hub_id"   = s."hub_id"
      WHERE  o."order_status"       = 'FINISHED'
        AND  o."order_created_year" = 2021
        AND  o."order_created_month" IN (2,3)
      GROUP BY h."hub_id", h."hub_name"
) AS sub
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – hubs whose finished-order volume grew by more
--               than 20 % from February to March.  
SELECT sub."hub_id",
       sub."hub_name",
       sub."feb_finished",
       sub."mar_finished",
       ROUND(
         (sub."mar_finished" - sub."feb_finished") * 100.0 / sub."feb_finished",
         1
       ) AS "pct_change"
FROM (
      SELECT h."hub_id",
             h."hub_name",
             SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished",
             SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished"
      FROM   "orders"  o
      JOIN   "stores"  s ON s."store_id" = o."store_id"
      JOIN   "hubs"    h ON h."hub_id"   = s."hub_id"
      WHERE  o."order_status"       = 'FINISHED'
        AND  o."order_created_year" = 2021
        AND  o."order_created_month" IN (2,3)
      GROUP BY h."hub_id", h."hub_name"
) AS sub
WHERE sub."feb_finished" > 0                                -- avoid divide-by-zero
  AND (sub."mar_finished" - sub."feb_finished") * 1.0
      / sub."feb_finished" > 0.20                           -- > 20 % increase
ORDER BY "pct_change" DESC
LIMIT 20;
```
