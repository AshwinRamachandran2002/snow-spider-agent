```sql
--Description: Check the different status values orders can have.
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--Description: See the distinct month values recorded for order creation.
SELECT DISTINCT "order_created_month"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Quick look at finished orders that were created in February or March.
SELECT "order_id",
       "store_id",
       "order_created_month",
       "order_status"
FROM   "orders"
WHERE  "order_status" = 'FINISHED'
  AND  "order_created_month" IN (2,3)
LIMIT 20;
```

```sql
--Description: Map finished Feb/Mar orders to the hub they belong to (via stores).
SELECT o."order_id",
       o."order_created_month",
       s."hub_id"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" IN (2,3)
LIMIT 20;
```

```sql
--Description: Bring hub names into the previous mapping for easier reading.
SELECT o."order_id",
       o."order_created_month",
       h."hub_id",
       h."hub_name"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h
       ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" IN (2,3)
LIMIT 20;
```

```sql
--Description: Count how many finished orders each hub completed in February.
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "feb_finished_orders"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h
       ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 2
GROUP  BY h."hub_id",
          h."hub_name"
ORDER  BY "feb_finished_orders" DESC
LIMIT 20;
```

```sql
--Description: Count how many finished orders each hub completed in March.
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "mar_finished_orders"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h
       ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 3
GROUP  BY h."hub_id",
          h."hub_name"
ORDER  BY "mar_finished_orders" DESC
LIMIT 20;
```

```sql
--Description: Put February and March counts side-by-side for every hub.
SELECT h."hub_id",
       h."hub_name",
       SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished",
       SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h
       ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" IN (2,3)
GROUP  BY h."hub_id",
          h."hub_name"
LIMIT 20;
```

```sql
--Description: Identify hubs whose finished orders grew by more than 20% from February to March.
SELECT h."hub_id",
       h."hub_name",
       SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished",
       SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished",
       CASE
           WHEN SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) = 0
           THEN NULL
           ELSE CAST(SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS FLOAT) /
                SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) - 1
       END AS "pct_increase"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h
       ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" IN (2,3)
GROUP  BY h."hub_id",
          h."hub_name"
HAVING "pct_increase" > 0.20
LIMIT 20;
```
