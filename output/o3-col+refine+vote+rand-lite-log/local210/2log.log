-- Description: 7) Combine February and March counts side-by-side for each hub.  
SELECT  feb."hub_id",
        feb."feb_orders",
        mar."mar_orders"
FROM   (
        SELECT s."hub_id", COUNT(*) AS "feb_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP BY s."hub_id"
       ) AS feb
LEFT JOIN (
        SELECT s."hub_id", COUNT(*) AS "mar_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP BY s."hub_id"
       ) AS mar
ON feb."hub_id" = mar."hub_id"
LIMIT 20;
