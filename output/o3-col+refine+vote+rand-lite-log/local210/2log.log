```sql
-- Description: 2) Look at a few orders that are already finished to confirm the 
-- month recorded in the “order_created_month” column.  
SELECT "order_id",
       "order_status",
       "order_created_month",
       "order_created_year",
       "order_moment_finished"
FROM   "orders"
WHERE  "order_status" = 'FINISHED'
LIMIT 20;
```

```sql
-- Description: 3) Bring stores into the picture (to get hub_id) and show a sample
-- of finished orders created in February (month = 2).  
SELECT  o."order_id",
        o."order_created_month",
        s."hub_id"
FROM    "orders"  AS o
JOIN    "stores"  AS s ON s."store_id" = o."store_id"
WHERE   o."order_status" = 'FINISHED'
  AND   o."order_created_month" = 2
LIMIT 20;
```

```sql
-- Description: 4) Same sample but for March (month = 3).  
SELECT  o."order_id",
        o."order_created_month",
        s."hub_id"
FROM    "orders"  AS o
JOIN    "stores"  AS s ON s."store_id" = o."store_id"
WHERE   o."order_status" = 'FINISHED'
  AND   o."order_created_month" = 3
LIMIT 20;
```

```sql
-- Description: 5) Count finished orders per hub for February.  
SELECT  s."hub_id",
        COUNT(*) AS "feb_orders"
FROM    "orders" AS o
JOIN    "stores" AS s ON s."store_id" = o."store_id"
WHERE   o."order_status" = 'FINISHED'
  AND   o."order_created_month" = 2
GROUP BY s."hub_id"
LIMIT 20;
```

```sql
-- Description: 6) Count finished orders per hub for March.  
SELECT  s."hub_id",
        COUNT(*) AS "mar_orders"
FROM    "orders" AS o
JOIN    "stores" AS s ON s."store_id" = o."store_id"
WHERE   o."order_status" = 'FINISHED'
  AND   o."order_created_month" = 3
GROUP BY s."hub_id"
LIMIT 20;
```

```sql
-- Description: 7) Combine February and March counts side-by-side for each hub.  
SELECT  feb."hub_id",
        feb."feb_orders",
        mar."mar_orders"
FROM   (
        SELECT s."hub_id", COUNT(*) AS "feb_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP BY s."hub_id"
       ) AS feb
LEFT JOIN (
        SELECT s."hub_id", COUNT(*) AS "mar_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP BY s."hub_id"
       ) AS mar
ON feb."hub_id" = mar."hub_id"
LIMIT 20;
```

```sql
-- Description: 8) Add the percentage growth column and keep hubs that grew > 20%.  
SELECT  h."hub_name",
        COALESCE(feb."feb_orders",0)  AS "feb_orders",
        COALESCE(mar."mar_orders",0)  AS "mar_orders",
        ROUND(100.0 * (mar."mar_orders" - feb."feb_orders") / NULLIF(feb."feb_orders",0), 2)
               AS "pct_growth"
FROM   (
        SELECT s."hub_id", COUNT(*) AS "feb_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP BY s."hub_id"
       ) AS feb
JOIN   (
        SELECT s."hub_id", COUNT(*) AS "mar_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP BY s."hub_id"
       ) AS mar
ON  feb."hub_id" = mar."hub_id"
JOIN   "hubs" AS h ON h."hub_id" = feb."hub_id"
WHERE  (mar."mar_orders" - feb."feb_orders") > 0
  AND  100.0 * (mar."mar_orders" - feb."feb_orders") / feb."feb_orders" > 20
LIMIT 20;
```

```sql
-- Description: 9) Same as above, but pull just the hub names that satisfy the >20% rule.  
SELECT DISTINCT h."hub_name"
FROM  (
        SELECT s."hub_id", COUNT(*) AS "feb_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP BY s."hub_id"
      ) AS feb
JOIN  (
        SELECT s."hub_id", COUNT(*) AS "mar_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP BY s."hub_id"
      ) AS mar
ON   feb."hub_id" = mar."hub_id"
JOIN  "hubs" AS h ON h."hub_id" = feb."hub_id"
WHERE (mar."mar_orders" - feb."feb_orders") > 0
  AND 100.0 * (mar."mar_orders" - feb."feb_orders") / feb."feb_orders" > 20
LIMIT 20;
```

```sql
-- Description: 10) Simplest summary – hub_id and % growth (>20%) for reference.  
SELECT  feb."hub_id",
        ROUND(100.0 * (mar."mar_orders" - feb."feb_orders") / feb."feb_orders", 2) AS "pct_growth"
FROM   (
        SELECT s."hub_id", COUNT(*) AS "feb_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP BY s."hub_id"
       ) AS feb
JOIN   (
        SELECT s."hub_id", COUNT(*) AS "mar_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP BY s."hub_id"
       ) AS mar
ON  feb."hub_id" = mar."hub_id"
WHERE  (mar."mar_orders" - feb."feb_orders") > 0
  AND  100.0 * (mar."mar_orders" - feb."feb_orders") / feb."feb_orders" > 20
LIMIT 20;
```
