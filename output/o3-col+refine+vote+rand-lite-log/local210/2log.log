Query:
-- Description: 8) Add the percentage growth column and keep hubs that grew > 20%.  
SELECT  h."hub_name",
        COALESCE(feb."feb_orders",0)  AS "feb_orders",
        COALESCE(mar."mar_orders",0)  AS "mar_orders",
        ROUND(100.0 * (mar."mar_orders" - feb."feb_orders") / NULLIF(feb."feb_orders",0), 2)
               AS "pct_growth"
FROM   (
        SELECT s."hub_id", COUNT(*) AS "feb_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 2
        GROUP BY s."hub_id"
       ) AS feb
JOIN   (
        SELECT s."hub_id", COUNT(*) AS "mar_orders"
        FROM   "orders" AS o
        JOIN   "stores" AS s ON s."store_id" = o."store_id"
        WHERE  o."order_status" = 'FINISHED'
          AND  o."order_created_month" = 3
        GROUP BY s."hub_id"
       ) AS mar
ON  feb."hub_id" = mar."hub_id"
JOIN   "hubs" AS h ON h."hub_id" = feb."hub_id"
WHERE  (mar."mar_orders" - feb."feb_orders") > 0
  AND  100.0 * (mar."mar_orders" - feb."feb_orders") / feb."feb_orders" > 20
LIMIT 20;
