JOIN     mar  ON mar."hub_id" = feb."hub_id"
JOIN     "hubs" h ON h."hub_id" = feb."hub_id"
WHERE    feb."feb_orders" > 0
  AND    100.0 * (mar."mar_orders" - feb."feb_orders") / feb."feb_orders" > 20;
