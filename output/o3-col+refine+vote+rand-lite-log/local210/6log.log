Below are a set of exploratory-to-answer queries (≤10) that progressively discover the information needed and finally list the hubs whose amount of finished orders grew more than 20 % from February to March.

```sql
--Description: 1) See which statuses exist in the Orders table
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--Description: 2) Check which months appear in the Orders table
SELECT DISTINCT "order_created_month"
FROM "orders"
LIMIT 20;
```

```sql
--Description: 3) Count finished-orders per hub for February
SELECT  h."hub_id",
        h."hub_name",
        COUNT(DISTINCT o."order_id") AS "feb_finished_orders"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON o."store_id" = s."store_id"
JOIN   "hubs"    AS h ON s."hub_id"  = h."hub_id"
WHERE  o."order_created_month" = 2
  AND  o."order_status"        = 'FINISHED'
GROUP  BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: 4) Count finished-orders per hub for March
SELECT  h."hub_id",
        h."hub_name",
        COUNT(DISTINCT o."order_id") AS "mar_finished_orders"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON o."store_id" = s."store_id"
JOIN   "hubs"    AS h ON s."hub_id"  = h."hub_id"
WHERE  o."order_created_month" = 3
  AND  o."order_status"        = 'FINISHED'
GROUP  BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: 5) Put February and March counts side-by-side for each hub
SELECT  feb."hub_id",
        feb."hub_name",
        feb."feb_finished_orders",
        mar."mar_finished_orders"
FROM  ( SELECT h."hub_id", h."hub_name",
               COUNT(DISTINCT o."order_id") AS "feb_finished_orders"
        FROM   "orders" o
        JOIN   "stores" s ON o."store_id" = s."store_id"
        JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
        WHERE  o."order_created_month" = 2
          AND  o."order_status"        = 'FINISHED'
        GROUP  BY h."hub_id", h."hub_name"
      ) AS feb
JOIN  ( SELECT h."hub_id", h."hub_name",
               COUNT(DISTINCT o."order_id") AS "mar_finished_orders"
        FROM   "orders" o
        JOIN   "stores" s ON o."store_id" = s."store_id"
        JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
        WHERE  o."order_created_month" = 3
          AND  o."order_status"        = 'FINISHED'
        GROUP  BY h."hub_id", h."hub_name"
      ) AS mar
ON  feb."hub_id" = mar."hub_id"
LIMIT 20;
```

```sql
--Description: 6) Compute the percentage increase from February to March
SELECT  base."hub_id",
        base."hub_name",
        base."feb_finished_orders",
        base."mar_finished_orders",
        ROUND(
              (CAST(base."mar_finished_orders" AS REAL)
               - base."feb_finished_orders") * 100.0
              / base."feb_finished_orders", 2
        ) AS "perc_increase"
FROM   (
        SELECT  feb."hub_id",
                feb."hub_name",
                feb."feb_finished_orders",
                mar."mar_finished_orders"
        FROM    (SELECT h."hub_id", h."hub_name",
                        COUNT(DISTINCT o."order_id") AS "feb_finished_orders"
                 FROM   "orders" o
                 JOIN   "stores" s ON o."store_id" = s."store_id"
                 JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
                 WHERE  o."order_created_month" = 2
                   AND  o."order_status"        = 'FINISHED'
                 GROUP  BY h."hub_id", h."hub_name"
                ) AS feb
        JOIN    (SELECT h."hub_id", h."hub_name",
                        COUNT(DISTINCT o."order_id") AS "mar_finished_orders"
                 FROM   "orders" o
                 JOIN   "stores" s ON o."store_id" = s."store_id"
                 JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
                 WHERE  o."order_created_month" = 3
                   AND  o."order_status"        = 'FINISHED'
                 GROUP  BY h."hub_id", h."hub_name"
                ) AS mar
          ON feb."hub_id" = mar."hub_id"
) AS base
LIMIT 20;
```

```sql
--Description: 7) List hubs whose March total is >20 % higher than February
SELECT DISTINCT
       "hub_id",
       "hub_name"
FROM (
      SELECT  feb."hub_id",
              feb."hub_name",
              (CAST(mar."mar_finished_orders" AS REAL)
               - feb."feb_finished_orders") * 100.0
              / feb."feb_finished_orders"  AS "perc_increase"
      FROM  (SELECT h."hub_id", h."hub_name",
                    COUNT(DISTINCT o."order_id") AS "feb_finished_orders"
             FROM   "orders" o
             JOIN   "stores" s ON o."store_id" = s."store_id"
             JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
             WHERE  o."order_created_month" = 2
               AND  o."order_status"        = 'FINISHED'
             GROUP  BY h."hub_id", h."hub_name"
            ) AS feb
      JOIN (SELECT h."hub_id", h."hub_name",
                    COUNT(DISTINCT o."order_id") AS "mar_finished_orders"
            FROM   "orders" o
            JOIN   "stores" s ON o."store_id" = s."store_id"
            JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
            WHERE  o."order_created_month" = 3
              AND  o."order_status"        = 'FINISHED'
            GROUP  BY h."hub_id", h."hub_name"
           ) AS mar
        ON feb."hub_id" = mar."hub_id"
) 
WHERE  "perc_increase" > 20
  AND  "perc_increase" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 8) (Optional) Same computation but split by year, helpful if data spans several years
SELECT  base."hub_id",
        base."hub_name",
        base."year",
        base."feb_finished_orders",
        base."mar_finished_orders",
        ROUND(
               (base."mar_finished_orders" - base."feb_finished_orders") * 100.0
               / base."feb_finished_orders", 2
        ) AS "perc_increase"
FROM   (
        SELECT  feb."hub_id",
                feb."hub_name",
                feb."year",
                feb."feb_finished_orders",
                mar."mar_finished_orders"
        FROM  ( SELECT h."hub_id", h."hub_name",
                       o."order_created_year" AS "year",
                       COUNT(DISTINCT o."order_id") AS "feb_finished_orders"
                FROM   "orders" o
                JOIN   "stores" s ON o."store_id" = s."store_id"
                JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
                WHERE  o."order_created_month" = 2
                  AND  o."order_status"        = 'FINISHED'
                GROUP  BY h."hub_id", h."hub_name", o."order_created_year"
              ) AS feb
        JOIN ( SELECT h."hub_id", h."hub_name",
                      o."order_created_year" AS "year",
                      COUNT(DISTINCT o."order_id") AS "mar_finished_orders"
               FROM   "orders" o
               JOIN   "stores" s ON o."store_id" = s."store_id"
               JOIN   "hubs"   h ON s."hub_id"  = h."hub_id"
               WHERE  o."order_created_month" = 3
                 AND  o."order_status"        = 'FINISHED'
               GROUP  BY h."hub_id", h."hub_name", o."order_created_year"
             ) AS mar
          ON  feb."hub_id" = mar."hub_id"
          AND feb."year"   = mar."year"
      ) AS base
WHERE base."feb_finished_orders" > 0
  AND ((base."mar_finished_orders" - base."feb_finished_orders") * 100.0
       / base."feb_finished_orders") > 20
LIMIT 20;
```

