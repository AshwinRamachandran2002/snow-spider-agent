Query:
-- Description: 8. Calculate the percentage increase from February to March for each hub
SELECT   f."hub_id",
         f."feb_finished_orders",
         m."mar_finished_orders",
         ROUND((m."mar_finished_orders" - f."feb_finished_orders") * 1.0 / f."feb_finished_orders", 3) AS "growth_ratio"
FROM     (SELECT s."hub_id", COUNT(*) AS "feb_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 2
          GROUP BY s."hub_id") AS f
JOIN     (SELECT s."hub_id", COUNT(*) AS "mar_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 3
          GROUP BY s."hub_id") AS m
ON f."hub_id" = m."hub_id"
LIMIT 20;
