-- Description: 9. FINAL – hubs with >20 % increase in finished orders (growth_ratio > 0.20)
SELECT   h."hub_id",
         h."hub_name",
         g."feb_finished_orders",
         g."mar_finished_orders",
         ROUND((g."mar_finished_orders" - g."feb_finished_orders") * 1.0 / g."feb_finished_orders", 3) AS "growth_ratio"
FROM   (
         SELECT   f."hub_id",
                  f."feb_finished_orders",
                  m."mar_finished_orders"
         FROM     (SELECT s."hub_id", COUNT(*) AS "feb_finished_orders"
                   FROM   "orders" AS o
                   JOIN   "stores" AS s ON o."store_id" = s."store_id"
                   WHERE  o."order_status"       = 'FINISHED'
                     AND  o."order_created_month" = 2
                   GROUP BY s."hub_id") AS f
         JOIN     (SELECT s."hub_id", COUNT(*) AS "mar_finished_orders"
                   FROM   "orders" AS o
                   JOIN   "stores" AS s ON o."store_id" = s."store_id"
                   WHERE  o."order_status"       = 'FINISHED'
                     AND  o."order_created_month" = 3
                   GROUP BY s."hub_id") AS m
         ON f."hub_id" = m."hub_id"
       ) AS g
JOIN   "hubs" AS h ON g."hub_id" = h."hub_id"
WHERE  g."feb_finished_orders" > 0
  AND  (g."mar_finished_orders" - g."feb_finished_orders") * 1.0 / g."feb_finished_orders" > 0.20
LIMIT 20;
