-- Description: 7. Prepare February vs. March counts side-by-side for every hub
SELECT   feb."hub_id",
         feb."feb_finished_orders",
         mar."mar_finished_orders"
FROM     (SELECT s."hub_id",
                 COUNT(*) AS "feb_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 2
          GROUP BY s."hub_id") AS feb
LEFT JOIN
         (SELECT s."hub_id",
                 COUNT(*) AS "mar_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 3
          GROUP BY s."hub_id") AS mar
ON feb."hub_id" = mar."hub_id"
LIMIT 20;
