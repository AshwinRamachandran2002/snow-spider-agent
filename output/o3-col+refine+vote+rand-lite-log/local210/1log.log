```sql
-- Description: 4. Check how orders map to hubs through the stores table
SELECT o."order_id",
       o."store_id",
       s."hub_id",
       h."hub_name",
       o."order_created_month",
       o."order_status"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON o."store_id" = s."store_id"
JOIN   "hubs"    AS h ON s."hub_id"   = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
LIMIT 20;
```

```sql
-- Description: 5. Count February finished orders per hub
SELECT   s."hub_id",
         COUNT(*) AS "feb_finished_orders"
FROM     "orders" AS o
JOIN     "stores" AS s ON o."store_id" = s."store_id"
WHERE    o."order_status"       = 'FINISHED'
  AND    o."order_created_month" = 2
GROUP BY s."hub_id"
LIMIT 20;
```

```sql
-- Description: 6. Count March finished orders per hub
SELECT   s."hub_id",
         COUNT(*) AS "mar_finished_orders"
FROM     "orders" AS o
JOIN     "stores" AS s ON o."store_id" = s."store_id"
WHERE    o."order_status"       = 'FINISHED'
  AND    o."order_created_month" = 3
GROUP BY s."hub_id"
LIMIT 20;
```

```sql
-- Description: 7. Prepare February vs. March counts side-by-side for every hub
SELECT   feb."hub_id",
         feb."feb_finished_orders",
         mar."mar_finished_orders"
FROM     (SELECT s."hub_id",
                 COUNT(*) AS "feb_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 2
          GROUP BY s."hub_id") AS feb
LEFT JOIN
         (SELECT s."hub_id",
                 COUNT(*) AS "mar_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 3
          GROUP BY s."hub_id") AS mar
ON feb."hub_id" = mar."hub_id"
LIMIT 20;
```

```sql
-- Description: 8. Calculate the percentage increase from February to March for each hub
SELECT   f."hub_id",
         f."feb_finished_orders",
         m."mar_finished_orders",
         ROUND((m."mar_finished_orders" - f."feb_finished_orders") * 1.0 / f."feb_finished_orders", 3) AS "growth_ratio"
FROM     (SELECT s."hub_id", COUNT(*) AS "feb_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 2
          GROUP BY s."hub_id") AS f
JOIN     (SELECT s."hub_id", COUNT(*) AS "mar_finished_orders"
          FROM   "orders" AS o
          JOIN   "stores" AS s ON o."store_id" = s."store_id"
          WHERE  o."order_status"       = 'FINISHED'
            AND  o."order_created_month" = 3
          GROUP BY s."hub_id") AS m
ON f."hub_id" = m."hub_id"
LIMIT 20;
```

```sql
-- Description: 9. FINAL – hubs with >20 % increase in finished orders (growth_ratio > 0.20)
SELECT   h."hub_id",
         h."hub_name",
         g."feb_finished_orders",
         g."mar_finished_orders",
         ROUND((g."mar_finished_orders" - g."feb_finished_orders") * 1.0 / g."feb_finished_orders", 3) AS "growth_ratio"
FROM   (
         SELECT   f."hub_id",
                  f."feb_finished_orders",
                  m."mar_finished_orders"
         FROM     (SELECT s."hub_id", COUNT(*) AS "feb_finished_orders"
                   FROM   "orders" AS o
                   JOIN   "stores" AS s ON o."store_id" = s."store_id"
                   WHERE  o."order_status"       = 'FINISHED'
                     AND  o."order_created_month" = 2
                   GROUP BY s."hub_id") AS f
         JOIN     (SELECT s."hub_id", COUNT(*) AS "mar_finished_orders"
                   FROM   "orders" AS o
                   JOIN   "stores" AS s ON o."store_id" = s."store_id"
                   WHERE  o."order_status"       = 'FINISHED'
                     AND  o."order_created_month" = 3
                   GROUP BY s."hub_id") AS m
         ON f."hub_id" = m."hub_id"
       ) AS g
JOIN   "hubs" AS h ON g."hub_id" = h."hub_id"
WHERE  g."feb_finished_orders" > 0
  AND  (g."mar_finished_orders" - g."feb_finished_orders") * 1.0 / g."feb_finished_orders" > 0.20
LIMIT 20;
```
