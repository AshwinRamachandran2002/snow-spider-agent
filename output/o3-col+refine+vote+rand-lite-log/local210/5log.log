```sql
-- Description: See how stores are assigned to hubs (a‐to‐b relationship sample)
SELECT s."store_id",
       s."store_name",
       s."hub_id",
       h."hub_name"
FROM "stores" AS s
JOIN "hubs"  AS h ON h."hub_id" = s."hub_id"
LIMIT 20;
```

```sql
-- Description: Aggregate the number of FINISHED orders per hub for February (any year)
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "finished_orders_feb"
FROM   "orders" AS o
JOIN   "stores" AS s ON s."store_id" = o."store_id"
JOIN   "hubs"  AS h ON h."hub_id"  = s."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 2
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
-- Description: Aggregate the number of FINISHED orders per hub for March (any year)
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "finished_orders_mar"
FROM   "orders" AS o
JOIN   "stores" AS s ON s."store_id" = o."store_id"
JOIN   "hubs"  AS h ON h."hub_id"  = s."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 3
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
-- Description: Put February & March side-by-side per hub (only hubs that appear in both months)
WITH feb AS (
    SELECT s."hub_id", COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 2
    GROUP BY s."hub_id"
),
mar AS (
    SELECT s."hub_id", COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 3
    GROUP BY s."hub_id"
)
SELECT h."hub_id",
       h."hub_name",
       feb.cnt_feb,
       mar.cnt_mar
FROM   feb
JOIN   mar ON mar."hub_id" = feb."hub_id"
JOIN   "hubs" h ON h."hub_id" = feb."hub_id"
LIMIT 20;
```

```sql
-- Description: Add the percentage change from February to March
WITH feb AS (
    SELECT s."hub_id", COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 2
    GROUP BY s."hub_id"
),
mar AS (
    SELECT s."hub_id", COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 3
    GROUP BY s."hub_id"
)
SELECT h."hub_id",
       h."hub_name",
       feb.cnt_feb,
       mar.cnt_mar,
       ROUND( (mar.cnt_mar - feb.cnt_feb) * 100.0 / feb.cnt_feb, 2 ) AS pct_change
FROM   feb
JOIN   mar ON mar."hub_id" = feb."hub_id"
JOIN   "hubs" h ON h."hub_id" = feb."hub_id"
LIMIT 20;
```

```sql
-- Description: Show only the hubs whose March volume is more than 20 % larger than February
WITH feb AS (
    SELECT s."hub_id", COUNT(*) AS cnt_feb
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 2
    GROUP BY s."hub_id"
),
mar AS (
    SELECT s."hub_id", COUNT(*) AS cnt_mar
    FROM   "orders" o
    JOIN   "stores" s ON s."store_id" = o."store_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" = 3
    GROUP BY s."hub_id"
)
SELECT h."hub_id",
       h."hub_name",
       feb.cnt_feb,
       mar.cnt_mar,
       ROUND( (mar.cnt_mar - feb.cnt_feb) * 100.0 / feb.cnt_feb, 2 ) AS pct_change
FROM   feb
JOIN   mar ON mar."hub_id" = feb."hub_id"
JOIN   "hubs" h ON h."hub_id" = feb."hub_id"
WHERE  mar.cnt_mar > feb.cnt_feb        -- strictly greater
  AND  (mar.cnt_mar - feb.cnt_feb) * 1.0 / feb.cnt_feb > 0.20
LIMIT 20;
```

