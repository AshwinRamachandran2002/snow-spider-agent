JOIN    mar ON mar."hub_id" = feb."hub_id"
JOIN    "hubs" h ON h."hub_id" = feb."hub_id"
WHERE   mar.cnt_mar > feb.cnt_feb                     -- growth
  AND   (mar.cnt_mar - feb.cnt_feb) * 1.0 / feb.cnt_feb > 0.20   -- > 20 %
