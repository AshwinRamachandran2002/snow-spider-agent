```sql
--Description: Check which different status values exist in the orders table
SELECT DISTINCT "order_status"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Find which year/month combinations have FINISHED orders
SELECT DISTINCT "order_created_year",
                "order_created_month"
FROM   "orders"
WHERE  "order_status" = 'FINISHED'
ORDER BY "order_created_year", "order_created_month"
LIMIT 20;
```

```sql
--Description: Sample FINISHED orders from February linked to their hubs
SELECT o."order_id",
       o."order_created_year",
       o."order_created_month",
       s."hub_id",
       h."hub_name"
FROM   "orders"  AS o
JOIN   "stores"  AS s ON o."store_id" = s."store_id"
JOIN   "hubs"    AS h ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 2
LIMIT 20;
```

```sql
--Description: Count FINISHED orders by hub for February 2021
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "feb_finished_orders"
FROM   "orders" AS o
JOIN   "stores" AS s ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 2
  AND  o."order_created_year" = 2021
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: Count FINISHED orders by hub for March 2021
SELECT h."hub_id",
       h."hub_name",
       COUNT(*) AS "mar_finished_orders"
FROM   "orders" AS o
JOIN   "stores" AS s ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" = 3
  AND  o."order_created_year" = 2021
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: Show February & March FINISHED order counts together for each hub
SELECT h."hub_id",
       h."hub_name",
       SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished_orders",
       SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished_orders"
FROM   "orders" AS o
JOIN   "stores" AS s ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" IN (2,3)
  AND  o."order_created_year" = 2021
GROUP BY h."hub_id", h."hub_name"
LIMIT 20;
```

```sql
--Description: Calculate percentage change (Feb ➜ Mar) in FINISHED orders for each hub
SELECT hub_stats."hub_id",
       hub_stats."hub_name",
       hub_stats."feb_finished_orders",
       hub_stats."mar_finished_orders",
       CASE
           WHEN hub_stats."feb_finished_orders" = 0 THEN NULL
           ELSE ROUND( (hub_stats."mar_finished_orders" - hub_stats."feb_finished_orders")
                       * 100.0 / hub_stats."feb_finished_orders", 2)
       END AS "perc_change"
FROM (
    SELECT h."hub_id",
           h."hub_name",
           SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished_orders",
           SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished_orders"
    FROM   "orders" AS o
    JOIN   "stores" AS s ON o."store_id" = s."store_id"
    JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" IN (2,3)
      AND  o."order_created_year" = 2021
    GROUP BY h."hub_id", h."hub_name"
) AS hub_stats
LIMIT 20;
```

```sql
--Description: Hubs whose FINISHED orders increased by more than 20 % from Feb to Mar
SELECT hub_stats."hub_id",
       hub_stats."hub_name",
       hub_stats."feb_finished_orders",
       hub_stats."mar_finished_orders",
       ROUND( (hub_stats."mar_finished_orders" - hub_stats."feb_finished_orders")
             * 100.0 / hub_stats."feb_finished_orders", 2) AS "perc_change"
FROM (
    SELECT h."hub_id",
           h."hub_name",
           SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished_orders",
           SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished_orders"
    FROM   "orders" AS o
    JOIN   "stores" AS s ON o."store_id" = s."store_id"
    JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" IN (2,3)
      AND  o."order_created_year" = 2021
    GROUP BY h."hub_id", h."hub_name"
) AS hub_stats
WHERE hub_stats."feb_finished_orders" > 0
  AND hub_stats."mar_finished_orders" > hub_stats."feb_finished_orders" * 1.20
LIMIT 20;
```

```sql
--Description: Return only the hub names that meet the >20 % increase criterion
SELECT DISTINCT "hub_name"
FROM (
    SELECT h."hub_id",
           h."hub_name",
           SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished_orders",
           SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished_orders"
    FROM   "orders" AS o
    JOIN   "stores" AS s ON o."store_id" = s."store_id"
    JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" IN (2,3)
      AND  o."order_created_year" = 2021
    GROUP BY h."hub_id", h."hub_name"
) AS hub_stats
WHERE hub_stats."feb_finished_orders" > 0
  AND hub_stats."mar_finished_orders" > hub_stats."feb_finished_orders" * 1.20
LIMIT 20;
```

```sql
--Description: (Optional) Hubs with zero FINISHED orders in Feb but some in Mar
SELECT h."hub_id",
       h."hub_name",
       SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished_orders",
       SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished_orders"
FROM   "orders" AS o
JOIN   "stores" AS s ON o."store_id" = s."store_id"
JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
WHERE  o."order_status" = 'FINISHED'
  AND  o."order_created_month" IN (2,3)
  AND  o."order_created_year" = 2021
GROUP BY h."hub_id", h."hub_name"
HAVING SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) = 0
   AND SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) > 0
LIMIT 20;
```
