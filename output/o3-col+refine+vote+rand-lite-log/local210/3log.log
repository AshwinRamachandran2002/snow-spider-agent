Query:
--Description: Calculate percentage change (Feb ➜ Mar) in FINISHED orders for each hub
SELECT hub_stats."hub_id",
       hub_stats."hub_name",
       hub_stats."feb_finished_orders",
       hub_stats."mar_finished_orders",
       CASE
           WHEN hub_stats."feb_finished_orders" = 0 THEN NULL
           ELSE ROUND( (hub_stats."mar_finished_orders" - hub_stats."feb_finished_orders")
                       * 100.0 / hub_stats."feb_finished_orders", 2)
       END AS "perc_change"
FROM (
    SELECT h."hub_id",
           h."hub_name",
           SUM(CASE WHEN o."order_created_month" = 2 THEN 1 ELSE 0 END) AS "feb_finished_orders",
           SUM(CASE WHEN o."order_created_month" = 3 THEN 1 ELSE 0 END) AS "mar_finished_orders"
    FROM   "orders" AS o
    JOIN   "stores" AS s ON o."store_id" = s."store_id"
    JOIN   "hubs"   AS h ON s."hub_id" = h."hub_id"
    WHERE  o."order_status" = 'FINISHED'
      AND  o."order_created_month" IN (2,3)
      AND  o."order_created_year" = 2021
    GROUP BY h."hub_id", h."hub_name"
) AS hub_stats
LIMIT 20;
