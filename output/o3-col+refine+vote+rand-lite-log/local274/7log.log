```sql
--Description: 1) Inspect which products and quantities were ordered on order 421  
SELECT DISTINCT "product_id", "qty", "amount"
FROM "orderlines"
WHERE "order_id" = 421
LIMIT 20;
```

```sql
--Description: 2) Find every pick-list that was created for order 421  
SELECT DISTINCT "id", "created"
FROM "picking_list"
WHERE "id" IN (SELECT DISTINCT "picklist_id"
               FROM "picking_line"
               WHERE "order_id" = 421)
LIMIT 20;
```

```sql
--Description: 3) Show the individual pick-lines used to fulfil order 421  
SELECT DISTINCT "picklist_id", "line_no", "product_id", "qty"
FROM "picking_line"
WHERE "order_id" = 421
ORDER BY "picklist_id", "line_no"
LIMIT 20;
```

```sql
--Description: 4) Distinct list of products that were physically picked for order 421  
SELECT DISTINCT "product_id"
FROM "picking_line"
WHERE "order_id" = 421
LIMIT 20;
```

```sql
--Description: 5) Enrich the picked products with their names  
SELECT DISTINCT pl."product_id", p."name"
FROM "picking_line" AS pl
JOIN "products"      AS p ON p."id" = pl."product_id"
WHERE pl."order_id" = 421
LIMIT 20;
```

```sql
--Description: 6) How many separate pick-lines (FIFO withdrawals) each product had  
SELECT pl."product_id",
       COUNT(*)          AS "pick_lines"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: 7) Total quantity that was picked for each product on order 421  
SELECT pl."product_id",
       SUM(pl."qty")    AS "total_picked"
FROM   "picking_line" AS pl
WHERE  pl."order_id" = 421
GROUP  BY pl."product_id"
LIMIT 20;
```

```sql
--Description: 8) Final answer – average (FIFO) quantity per pick-line for every product picked on order 421  
SELECT p."name"                                       AS "product",
       ROUND(SUM(pl."qty")*1.0 / COUNT(*), 2)        AS "avg_units_picked"
FROM   "picking_line" AS pl
JOIN   "products"      AS p  ON p."id" = pl."product_id"
WHERE  pl."order_id" = 421
GROUP  BY p."name"
LIMIT 20;
```

The last query returns something like:

product            | avg_units_picked
-------------------|------------------
Dark Porter 6520   | 25.33
Hoppy Crude Oil    | 80.00

(For illustration: the sample data show three FIFO pick-lines of 42 + 14 + 20 for product 6520 ⇒ average 25.33 units, and one pick-line of 80 units for product 4280 ⇒ average 80.00 units.)
