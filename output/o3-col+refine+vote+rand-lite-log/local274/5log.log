--Description: 10) Cross-check the quantities that were originally ordered (orderlines) versus what was actually picked.
SELECT ol."product_id",
       pr."name",
       ol."qty"     AS ordered_qty,
       SUM(pl."qty") AS picked_qty
FROM   orderlines    AS ol
JOIN   products      AS pr ON pr."id" = ol."product_id"
LEFT JOIN picking_line AS pl
       ON pl."order_id" = ol."order_id"
      AND pl."product_id" = ol."product_id"
WHERE  ol."order_id" = 421
GROUP BY ol."product_id", pr."name", ol."qty"
LIMIT 20;
