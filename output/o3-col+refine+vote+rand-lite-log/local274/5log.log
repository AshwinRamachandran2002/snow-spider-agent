WHERE  inv."location_id" IN (SELECT DISTINCT "location_id"
                             FROM picking_line
                             WHERE "order_id" = 421)
  AND  inv."product_id"  IN (SELECT DISTINCT "product_id"
                             FROM picking_line
                             WHERE "order_id" = 421)
ORDER BY pu."purchased"
LIMIT 20;
