```sql
--Description: 2) Show the distinct product IDs that were picked for order 421.
SELECT DISTINCT "product_id"
FROM picking_line
WHERE "order_id" = 421
LIMIT 20;
```

```sql
--Description: 3) Get product names for the products picked in order 421.
SELECT DISTINCT pl."product_id",
                p."name"
FROM picking_line AS pl
JOIN products     AS p ON p."id" = pl."product_id"
WHERE pl."order_id" = 421
LIMIT 20;
```

```sql
--Description: 4) For each product picked for order 421, show total quantity, number of pick-lines and the average quantity per pick-line (i.e., average units picked).
SELECT pl."product_id",
       p."name",
       COUNT(*)                    AS lines_cnt,
       SUM(pl."qty")               AS total_qty,
       AVG(pl."qty")               AS avg_qty_per_line
FROM   picking_line AS pl
JOIN   products      AS p ON p."id" = pl."product_id"
WHERE  pl."order_id" = 421
GROUP BY pl."product_id", p."name"
LIMIT 20;
```

```sql
--Description: 5) Show the pick-list(s) (header) that contain picking lines for order 421 (needed for FIFO trace).
SELECT DISTINCT pl."picklist_id",
                pl."order_id",
                plist."created",
                plist."picker_emp_id"
FROM   picking_line AS pl
JOIN   picking_list AS plist ON plist."id" = pl."picklist_id"
WHERE  pl."order_id" = 421
LIMIT 20;
```

```sql
--Description: 6) Inspect the detailed pick-log steps for the pick-list(s) handling order 421 (to see actual FIFO order).
SELECT *
FROM   picking_log
WHERE  "picklist_id" IN (SELECT DISTINCT "picklist_id"
                         FROM picking_line
                         WHERE "order_id" = 421)
ORDER BY "log_time"
LIMIT 20;
```

```sql
--Description: 7) Look up the warehouse locations used for picking order 421.
SELECT DISTINCT pl."location_id",
                l."warehouse",
                l."aisle",
                l."position"
FROM   picking_line AS pl
JOIN   locations    AS l  ON l."id" = pl."location_id"
WHERE  pl."order_id" = 421
LIMIT 20;
```

```sql
--Description: 8) See what inventory lots (purchase batches) are stored at those locations, together with their purchase dates (for FIFO verification).
SELECT inv."id"        AS inventory_id,
       inv."location_id",
       inv."product_id",
       inv."qty",
       pu."purchased"  AS purchase_date,
       pu."qty"        AS purchased_qty
FROM   inventory AS inv
JOIN   purchases AS pu ON pu."id" = inv."purchase_id"
WHERE  inv."location_id" IN (SELECT DISTINCT "location_id"
                             FROM picking_line
                             WHERE "order_id" = 421)
  AND  inv."product_id"  IN (SELECT DISTINCT "product_id"
                             FROM picking_line
                             WHERE "order_id" = 421)
ORDER BY pu."purchased"
LIMIT 20;
```

```sql
--Description: 9) Check all purchase batches (company-wide) for the products picked in order 421, ordered by date to confirm FIFO availability.
SELECT pu."id"          AS purchase_id,
       pu."purchased",
       pu."product_id",
       pr."name"        AS product_name,
       pu."qty",
       pu."cost"
FROM   purchases  AS pu
JOIN   products   AS pr ON pr."id" = pu."product_id"
WHERE  pu."product_id" IN (SELECT DISTINCT "product_id"
                           FROM picking_line
                           WHERE "order_id" = 421)
ORDER BY pu."product_id", pu."purchased"
LIMIT 20;
```

```sql
--Description: 10) Cross-check the quantities that were originally ordered (orderlines) versus what was actually picked.
SELECT ol."product_id",
       pr."name",
       ol."qty"     AS ordered_qty,
       SUM(pl."qty") AS picked_qty
FROM   orderlines    AS ol
JOIN   products      AS pr ON pr."id" = ol."product_id"
LEFT JOIN picking_line AS pl
       ON pl."order_id" = ol."order_id"
      AND pl."product_id" = ol."product_id"
WHERE  ol."order_id" = 421
GROUP BY ol."product_id", pr."name", ol."qty"
LIMIT 20;
```
