```sql
--Description: List sessions that contain BOTH pages (simple INNER JOIN of the two preceding result sets)
SELECT DISTINCT fi.session
FROM form_log AS fi
JOIN form_log AS fc
  ON fi.session = fc.session
WHERE fi.path = '/regist/input'
  AND fc.path = '/regist/confirm'
LIMIT 20;
```

```sql
--Description: Show the earliest stamp of /regist/input and /regist/confirm for those sessions
SELECT
  session,
  MIN(CASE WHEN path = '/regist/input'   THEN stamp END) AS first_input,
  MIN(CASE WHEN path = '/regist/confirm' THEN stamp END) AS first_confirm
FROM form_log
WHERE path IN ('/regist/input', '/regist/confirm')
GROUP BY session
LIMIT 20;
```

```sql
--Description: Keep only sessions where first_input < first_confirm
SELECT
  session
FROM (
  SELECT
    session,
    MIN(CASE WHEN path = '/regist/input'   THEN stamp END) AS first_input,
    MIN(CASE WHEN path = '/regist/confirm' THEN stamp END) AS first_confirm
  FROM form_log
  WHERE path IN ('/regist/input', '/regist/confirm')
  GROUP BY session
) AS t
WHERE first_input IS NOT NULL
  AND first_confirm IS NOT NULL
  AND first_input < first_confirm
LIMIT 20;
```

```sql
--Description: Count how many unique sessions satisfy that order condition
SELECT COUNT(*) AS sessions_input_then_confirm
FROM (
  SELECT
    session
  FROM (
    SELECT
      session,
      MIN(CASE WHEN path = '/regist/input'   THEN stamp END) AS first_input,
      MIN(CASE WHEN path = '/regist/confirm' THEN stamp END) AS first_confirm
    FROM form_log
    WHERE path IN ('/regist/input', '/regist/confirm')
    GROUP BY session
  ) AS t
  WHERE first_input IS NOT NULL
    AND first_confirm IS NOT NULL
    AND first_input < first_confirm
) AS s;
```
