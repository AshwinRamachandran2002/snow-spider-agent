```sql
--Description: Look-up the Open-Images “cat” entry in the label dictionary
SELECT *
FROM `bigquery-public-data.open_images.dict`
WHERE label_display_name = 'Cat'
LIMIT 20;
```

```sql
--Description: Inspect some label annotations that mark an image as “cat”
SELECT *
FROM `bigquery-public-data.open_images.labels`
WHERE label_name = '/m/01yrx'     -- cat
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: List a few distinct image_ids that have a “cat” label with confidence = 1
SELECT DISTINCT image_id
FROM `bigquery-public-data.open_images.labels`
WHERE label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: Join those cat image_ids to the images table to see their original URLs
SELECT i.image_id,
       i.original_url
FROM  `bigquery-public-data.open_images.images` AS i
JOIN  `bigquery-public-data.open_images.labels` AS l
  ON  i.image_id = l.image_id
WHERE l.label_name = '/m/01yrx'
  AND l.confidence = 1
LIMIT 20;
```

```sql
--Description: Count how many DISTINCT original URLs belong to images labelled as cat
SELECT COUNT(DISTINCT i.original_url) AS cat_url_cnt
FROM  `bigquery-public-data.open_images.images`  AS i
JOIN  `bigquery-public-data.open_images.labels`  AS l
  ON  i.image_id = l.image_id
WHERE l.label_name = '/m/01yrx'
  AND l.confidence = 1;
```

```sql
--Description: Count the total number of DISTINCT original URLs in the whole images table
SELECT COUNT(DISTINCT original_url) AS total_url_cnt
FROM   `bigquery-public-data.open_images.images`;
```

```sql
--Description: Count DISTINCT original URLs that do NOT have the cat label at all
SELECT COUNT(DISTINCT i.original_url) AS other_url_cnt
FROM   `bigquery-public-data.open_images.images`  AS i
LEFT  JOIN (
       SELECT image_id
       FROM   `bigquery-public-data.open_images.labels`
       WHERE  label_name = '/m/01yrx'
     ) AS cat ON i.image_id = cat.image_id
WHERE  cat.image_id IS NULL;
```

```sql
--Description: Final answer – return both counts side-by-side
SELECT
  ( SELECT COUNT(DISTINCT i.original_url)
    FROM `bigquery-public-data.open_images.images` AS i
    JOIN `bigquery-public-data.open_images.labels` AS l
      ON i.image_id = l.image_id
    WHERE l.label_name = '/m/01yrx'
      AND l.confidence = 1
  ) AS cat_url_cnt,
  ( SELECT COUNT(DISTINCT i.original_url)
    FROM `bigquery-public-data.open_images.images` AS i
    LEFT JOIN (
        SELECT DISTINCT image_id
        FROM `bigquery-public-data.open_images.labels`
        WHERE label_name = '/m/01yrx'
    ) AS cat ON i.image_id = cat.image_id
    WHERE cat.image_id IS NULL
  ) AS other_url_cnt;
```

