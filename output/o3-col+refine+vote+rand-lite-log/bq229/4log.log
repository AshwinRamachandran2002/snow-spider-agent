```sql
--Description: 1) Look up the label code(s) whose human-readable name is exactly “Cat”.
SELECT
  label_name,
  label_display_name
FROM `bigquery-public-data.open_images.dict`
WHERE LOWER(label_display_name) = 'cat'
LIMIT 20;
```

```sql
--Description: 2) Verify that label '/m/01yrx' corresponds to “Cat”.
SELECT
  label_name,
  label_display_name
FROM `bigquery-public-data.open_images.dict`
WHERE label_name = '/m/01yrx'
LIMIT 20;
```

```sql
--Description: 3) Inspect a few bounding-box rows that are certainly “Cat” 
--(confidence = 1 and label '/m/01yrx').
SELECT
  image_id,
  confidence,
  x_min, x_max, y_min, y_max
FROM `bigquery-public-data.open_images.annotations_bbox`
WHERE label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: 4) Retrieve up to 20 distinct image_ids that contain at least one
--“Cat” bounding-box with confidence = 1.
SELECT DISTINCT
  image_id
FROM `bigquery-public-data.open_images.annotations_bbox`
WHERE label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: 5) Join those “Cat” image_ids to the images table to preview their URLs.
SELECT
  i.image_id,
  i.original_url
FROM (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS c
JOIN `bigquery-public-data.open_images.images` AS i
ON c.image_id = i.image_id
LIMIT 20;
```

```sql
--Description: 6) Count how many distinct image URLs are categorized as “Cat”.
SELECT
  COUNT(DISTINCT i.original_url) AS cat_image_url_cnt
FROM (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS c
JOIN `bigquery-public-data.open_images.images` AS i
ON c.image_id = i.image_id
LIMIT 20;
```

```sql
--Description: 7) Count the total number of distinct image URLs in the images table.
SELECT
  COUNT(DISTINCT original_url) AS total_image_url_cnt
FROM `bigquery-public-data.open_images.images`
LIMIT 20;
```

```sql
--Description: 8) Count how many distinct image URLs have NO “Cat” label at all.
SELECT
  COUNT(DISTINCT i.original_url) AS other_image_url_cnt
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS c
ON i.image_id = c.image_id
WHERE c.image_id IS NULL
LIMIT 20;
```

```sql
--Description: 9) Produce both numbers—“cat” vs “other”—in a single result.
SELECT
  SUM(CASE WHEN c.image_id IS NOT NULL THEN 1 ELSE 0 END)      AS cat_image_url_cnt,
  SUM(CASE WHEN c.image_id IS NULL THEN 1 ELSE 0 END)          AS other_image_url_cnt
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS c
ON i.image_id = c.image_id
LIMIT 20;
```
