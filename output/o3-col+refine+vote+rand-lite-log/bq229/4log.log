Query:
--Description: 6) Count how many distinct image URLs are categorized as “Cat”.
SELECT
  COUNT(DISTINCT i.original_url) AS cat_image_url_cnt
FROM (
  SELECT DISTINCT image_id
  FROM `bigquery-public-data.open_images.annotations_bbox`
  WHERE label_name = '/m/01yrx'
    AND confidence = 1
) AS c
JOIN `bigquery-public-data.open_images.images` AS i
ON c.image_id = i.image_id
LIMIT 20;
