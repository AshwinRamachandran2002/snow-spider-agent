Query:
--Description: 7) Derive the number of “other” (non-cat) URLs by subtracting cat URLs.
WITH cat_urls AS (
  SELECT DISTINCT
    i.original_url
  FROM
    `bigquery-public-data.open_images.images` AS i
  JOIN
    `bigquery-public-data.open_images.labels` AS l
  ON
    i.image_id = l.image_id
  WHERE
    l.label_name = '/m/01yrx'
    AND l.confidence = 1
)
SELECT
  (SELECT COUNT(*) FROM cat_urls)                             AS cat_url_cnt,
  (SELECT COUNT(DISTINCT original_url) FROM
          `bigquery-public-data.open_images.images`)          -
  (SELECT COUNT(*) FROM cat_urls)                             AS other_url_cnt;
Answer:
cat_url_cnt,other_url_cnt
40231,9138044
Query:
--Description: 8) Single query that outputs BOTH counts side-by-side using conditional aggregation.
SELECT
  COUNT(DISTINCT IF(l.label_name = '/m/01yrx' AND l.confidence = 1,
                    i.original_url,
                    NULL))                                    AS cat_url_cnt,
  COUNT(DISTINCT IF(l.label_name = '/m/01yrx' AND l.confidence = 1,
                    NULL,
                    i.original_url))                          AS other_url_cnt
FROM
  `bigquery-public-data.open_images.images` AS i
LEFT JOIN
  `bigquery-public-data.open_images.labels` AS l
ON
  i.image_id = l.image_id;
Answer:
cat_url_cnt,other_url_cnt
40231,9178273
