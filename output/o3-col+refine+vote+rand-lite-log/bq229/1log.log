Query:
--Description: 10) Final compact answer – a UNION query that explicitly lists the two categories.
WITH cat_images AS (
  SELECT DISTINCT
    image_id
  FROM
    `bigquery-public-data.open_images.labels`
  WHERE
    label_name = '/m/01yrx'
    AND confidence = 1
), image_urls AS (
  SELECT
    image_id,
    original_url
  FROM
    `bigquery-public-data.open_images.images`
)
SELECT
  'cat'   AS category,
  COUNT(DISTINCT original_url) AS distinct_url_cnt
FROM
  image_urls
WHERE
  image_id IN (SELECT image_id FROM cat_images)

UNION ALL

SELECT
  'other' AS category,
  COUNT(DISTINCT original_url) AS distinct_url_cnt
FROM
  image_urls
WHERE
  image_id NOT IN (SELECT image_id FROM cat_images);
