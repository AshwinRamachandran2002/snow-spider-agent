Query:
--Description: 5) Count distinct image URLs that are tagged as cats (confidence = 1).
SELECT
  COUNT(DISTINCT i.original_url) AS cat_url_cnt
FROM
  `bigquery-public-data.open_images.images` AS i
JOIN
  `bigquery-public-data.open_images.labels` AS l
ON
  i.image_id = l.image_id
WHERE
  l.label_name = '/m/01yrx'
  AND l.confidence = 1;
