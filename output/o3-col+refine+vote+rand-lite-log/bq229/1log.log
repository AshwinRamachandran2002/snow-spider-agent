```sql
--Description: 1) Look-up the Open-Images label id that corresponds to the word “cat”.
SELECT
  label_name,
  label_display_name
FROM
  `bigquery-public-data.open_images.dict`
WHERE
  LOWER(label_display_name) = 'cat'
LIMIT 20;
```

```sql
--Description: 2) Show some rows in the image-level labels table that carry the “cat” label 
--   (we already know from Query-1 that the id is “/m/01yrx”) and have confidence = 1.
SELECT DISTINCT
  image_id,
  source,
  confidence
FROM
  `bigquery-public-data.open_images.labels`
WHERE
  label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: 3) Sample 20 distinct image_ids that contain cats with confidence = 1.
SELECT DISTINCT
  image_id
FROM
  `bigquery-public-data.open_images.labels`
WHERE
  label_name = '/m/01yrx'
  AND confidence = 1
LIMIT 20;
```

```sql
--Description: 4) Join those cat image_ids to the “images” table to see their original URLs.
SELECT
  i.image_id,
  i.original_url
FROM
  `bigquery-public-data.open_images.images`      AS i
JOIN
  `bigquery-public-data.open_images.labels`      AS l
ON
  i.image_id = l.image_id
WHERE
  l.label_name = '/m/01yrx'
  AND l.confidence = 1
LIMIT 20;
```

```sql
--Description: 5) Count distinct image URLs that are tagged as cats (confidence = 1).
SELECT
  COUNT(DISTINCT i.original_url) AS cat_url_cnt
FROM
  `bigquery-public-data.open_images.images` AS i
JOIN
  `bigquery-public-data.open_images.labels` AS l
ON
  i.image_id = l.image_id
WHERE
  l.label_name = '/m/01yrx'
  AND l.confidence = 1;
```

```sql
--Description: 6) Count all distinct image URLs present in the whole images table.
SELECT
  COUNT(DISTINCT original_url) AS total_url_cnt
FROM
  `bigquery-public-data.open_images.images`;
```

```sql
--Description: 7) Derive the number of “other” (non-cat) URLs by subtracting cat URLs.
WITH cat_urls AS (
  SELECT DISTINCT
    i.original_url
  FROM
    `bigquery-public-data.open_images.images` AS i
  JOIN
    `bigquery-public-data.open_images.labels` AS l
  ON
    i.image_id = l.image_id
  WHERE
    l.label_name = '/m/01yrx'
    AND l.confidence = 1
)
SELECT
  (SELECT COUNT(*) FROM cat_urls)                             AS cat_url_cnt,
  (SELECT COUNT(DISTINCT original_url) FROM
          `bigquery-public-data.open_images.images`)          -
  (SELECT COUNT(*) FROM cat_urls)                             AS other_url_cnt;
```

```sql
--Description: 8) Single query that outputs BOTH counts side-by-side using conditional aggregation.
SELECT
  COUNT(DISTINCT IF(l.label_name = '/m/01yrx' AND l.confidence = 1,
                    i.original_url,
                    NULL))                                    AS cat_url_cnt,
  COUNT(DISTINCT IF(l.label_name = '/m/01yrx' AND l.confidence = 1,
                    NULL,
                    i.original_url))                          AS other_url_cnt
FROM
  `bigquery-public-data.open_images.images` AS i
LEFT JOIN
  `bigquery-public-data.open_images.labels` AS l
ON
  i.image_id = l.image_id;
```

```sql
--Description: 9) (Optional) Repeat the cat-count but using the bounding-box table 
--   (annotations_bbox) instead of the image-level labels.
SELECT
  COUNT(DISTINCT i.original_url) AS cat_url_cnt_bbox
FROM
  `bigquery-public-data.open_images.images`          AS i
JOIN
  `bigquery-public-data.open_images.annotations_bbox` AS b
ON
  i.image_id = b.image_id
WHERE
  b.label_name = '/m/01yrx'
  AND b.confidence = 1;
```

```sql
--Description: 10) Final compact answer – a UNION query that explicitly lists the two categories.
WITH cat_images AS (
  SELECT DISTINCT
    image_id
  FROM
    `bigquery-public-data.open_images.labels`
  WHERE
    label_name = '/m/01yrx'
    AND confidence = 1
), image_urls AS (
  SELECT
    image_id,
    original_url
  FROM
    `bigquery-public-data.open_images.images`
)
SELECT
  'cat'   AS category,
  COUNT(DISTINCT original_url) AS distinct_url_cnt
FROM
  image_urls
WHERE
  image_id IN (SELECT image_id FROM cat_images)

UNION ALL

SELECT
  'other' AS category,
  COUNT(DISTINCT original_url) AS distinct_url_cnt
FROM
  image_urls
WHERE
  image_id NOT IN (SELECT image_id FROM cat_images);
```
