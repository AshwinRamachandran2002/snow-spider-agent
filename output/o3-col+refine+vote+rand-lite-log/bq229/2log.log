Query:
-- Description: Produce both numbers (cat vs. other) in a single query.
SELECT
  COUNT(DISTINCT CASE WHEN c.image_id IS NOT NULL THEN i.original_url END) AS cat_url_count,
  COUNT(DISTINCT CASE WHEN c.image_id IS NULL  THEN i.original_url END) AS other_url_count
FROM `bigquery-public-data.open_images.images` AS i
LEFT JOIN (
    SELECT DISTINCT image_id
    FROM `bigquery-public-data.open_images.annotations_bbox`
    WHERE label_name = '/m/01yrx'
      AND confidence = 1.0
) AS c
ON i.image_id = c.image_id
LIMIT 20;
Answer:
cat_url_count,other_url_count
5481,9172794
Query:
-- Description: (Alternative) Compute the cat URL count using the labels table instead of bounding boxes.
SELECT COUNT(DISTINCT i.original_url) AS cat_url_count_using_labels_table
FROM `bigquery-public-data.open_images.images`  AS i
JOIN `bigquery-public-data.open_images.labels`  AS l
ON   i.image_id = l.image_id
WHERE l.label_name  = '/m/01yrx'
  AND l.confidence = 1.0
LIMIT 20;
