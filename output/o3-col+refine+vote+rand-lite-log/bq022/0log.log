```sql
-- 10. Description (Final answer): 
-- Calculate, for each of six equal-sized quantile groups (based on trip duration within 0-60 min),
--   • minimum and maximum trip duration in minutes (rounded),
--   • total number of trips,
--   • average fare.
WITH filtered AS (
  SELECT `trip_seconds`, `fare`
  FROM `bigquery-public-data`.`chicago_taxi_trips`.`taxi_trips`
  WHERE `trip_seconds` > 0
    AND `trip_seconds` <= 3600
),
bucketed AS (
  SELECT
    NTILE(6) OVER (ORDER BY `trip_seconds`)          AS quantile_group,
    `trip_seconds`,
    `fare`
  FROM filtered
)
SELECT
  quantile_group                                              AS quantile,
  ROUND(MIN(`trip_seconds`)/60.0)                             AS min_trip_minutes,
  ROUND(MAX(`trip_seconds`)/60.0)                             AS max_trip_minutes,
  COUNT(*)                                                    AS total_trips,
  ROUND(AVG(`fare`), 2)                                       AS avg_fare
FROM bucketed
GROUP BY quantile
ORDER BY quantile;
```
