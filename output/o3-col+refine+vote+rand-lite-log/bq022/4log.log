Query:
--Description: 7) Attach a hexile (1-6) to each qualifying trip using NTILE and show 20 sample rows.
WITH filtered AS (
  SELECT 
    unique_key,
    trip_seconds/60.0 AS duration_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
)
SELECT 
  unique_key,
  ROUND(duration_minutes,2) AS duration_minutes,
  fare,
  NTILE(6) OVER (ORDER BY duration_minutes) AS hexile
FROM filtered
LIMIT 20;
