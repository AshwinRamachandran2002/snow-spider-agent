```sql
--Description: 1) Peek at a few taxi–trip records to see the raw duration (trip_seconds) and fare columns.
SELECT 
  unique_key,
  trip_seconds,
  fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 2) Show 20 trips whose durations are between 0-60 minutes after converting seconds → minutes.
SELECT 
  unique_key,
  ROUND(trip_seconds/60.0,2) AS duration_minutes,
  fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
--Description: 3) See the different payment types that exist in the data.
SELECT DISTINCT payment_type
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 4) Sample 20 distinct taxi companies that appear in the data.
SELECT DISTINCT company
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 5) Give overall min / max trip_seconds for rides that are 0-60 minutes long.
SELECT 
  MIN(trip_seconds) AS min_trip_seconds,
  MAX(trip_seconds) AS max_trip_seconds
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600;
```

```sql
--Description: 6) Compute the six equal-sized quantile cut-points of trip duration (in minutes) for trips ≤60 min.
SELECT 
  APPROX_QUANTILES(trip_seconds/60.0, 6) AS six_quantile_boundaries
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds BETWEEN 1 AND 3600;
```

```sql
--Description: 7) Attach a hexile (1-6) to each qualifying trip using NTILE and show 20 sample rows.
WITH filtered AS (
  SELECT 
    unique_key,
    trip_seconds/60.0 AS duration_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600
)
SELECT 
  unique_key,
  ROUND(duration_minutes,2) AS duration_minutes,
  fare,
  NTILE(6) OVER (ORDER BY duration_minutes) AS hexile
FROM filtered
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – for each of the six equal quantile groups (hexiles) based on trip duration
--                 between 0-60 minutes, return the min / max duration (rounded), total trips, and avg fare.
WITH filtered AS (
  SELECT
    trip_seconds / 60.0 AS duration_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600          -- keep trips 0–60 minutes
),
labeled AS (
  SELECT
    duration_minutes,
    fare,
    NTILE(6) OVER (ORDER BY duration_minutes) AS hexile
  FROM filtered
)
SELECT
  hexile                                          AS quantile_group,
  ROUND(MIN(duration_minutes))                    AS min_duration_minutes,
  ROUND(MAX(duration_minutes))                    AS max_duration_minutes,
  COUNT(*)                                        AS total_trips,
  ROUND(AVG(fare), 2)                             AS avg_fare
FROM labeled
GROUP BY hexile
ORDER BY hexile;
```
