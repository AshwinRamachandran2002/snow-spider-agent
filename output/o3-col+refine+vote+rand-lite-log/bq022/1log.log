Table full name: bigquery-public-data.chicago_taxi_trips.taxi_trips
Column name: unique_key Type: STRING Description: Unique identifier for the trip.
Column name: taxi_id Type: STRING Description: A unique identifier for the taxi.
Column name: trip_start_timestamp Type: TIMESTAMP Description: When the trip started, rounded to the nearest 15 minutes.
Column name: trip_end_timestamp Type: TIMESTAMP Description: When the trip ended, rounded to the nearest 15 minutes.
Column name: trip_seconds Type: INT64 Description: Time of the trip in seconds.
Column name: trip_miles Type: FLOAT64 Description: Distance of the trip in miles.
Column name: pickup_census_tract Type: INT64 Description: The Census Tract where the trip began. For privacy, this Census Tract is not shown for some trips.
Column name: dropoff_census_tract Type: INT64 Description: The Census Tract where the trip ended. For privacy, this Census Tract is not shown for some trips.
Column name: pickup_community_area Type: INT64 Description: The Community Area where the trip began.
Column name: dropoff_community_area Type: INT64 Description: The Community Area where the trip ended.
Column name: fare Type: FLOAT64 Description: The fare for the trip.
Column name: tips Type: FLOAT64 Description: The tip for the trip. Cash tips generally will not be recorded.
Column name: tolls Type: FLOAT64 Description: The tolls for the trip.
Column name: extras Type: FLOAT64 Description: Extra charges for the trip.
Column name: trip_total Type: FLOAT64 Description: Total cost of the trip, the total of the fare, tips, tolls, and extras.
Column name: payment_type Type: STRING Description: Type of payment for the trip.
Column name: company Type: STRING Description: The taxi company.
Column name: pickup_latitude Type: FLOAT64 Description: The latitude of the center of the pickup census tract or the community area if the census tract has been hidden for privacy.
Column name: pickup_longitude Type: FLOAT64 Description: The longitude of the center of the pickup census tract or the community area if the census tract has been hidden for privacy.
Column name: pickup_location Type: STRING Description: The location of the center of the pickup census tract or the community area if the census tract has been hidden for privacy.
Column name: dropoff_latitude Type: FLOAT64 Description: The latitude of the center of the dropoff census tract or the community area if the census tract has been hidden for privacy.
Column name: dropoff_longitude Type: FLOAT64 Description: The longitude of the center of the dropoff census tract or the community area if the census tract has been hidden for privacy.
