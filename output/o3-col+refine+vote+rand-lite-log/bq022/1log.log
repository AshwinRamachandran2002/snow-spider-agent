Query:
--Description: FINAL – six equal-sized duration quantiles (0–60 min); report rounded
--min / max minutes, trip count, and average fare for each group, avoiding analytic
--functions in the aggregation layer.
WITH base AS (
  SELECT
    NTILE(6) OVER (ORDER BY trip_seconds) AS quantile,     -- create six buckets
    ROUND(trip_seconds / 60.0)            AS trip_minutes, -- seconds → whole minutes
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600                    -- 0–60 minutes only
)
SELECT
  quantile                  AS quantile_group,
  MIN(trip_minutes)         AS min_trip_minutes,
  MAX(trip_minutes)         AS max_trip_minutes,
  COUNT(*)                  AS total_trips,
  AVG(fare)                 AS average_fare
FROM base
GROUP BY quantile
ORDER BY quantile
Answer:
