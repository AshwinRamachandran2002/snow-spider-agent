```sql
--Description: THINKING PROCESS
--  • Goal: Six equal-sized quantile groups (NTILE(6)) based on trip duration.
--  • Scope: Trips lasting >0 and ≤60 minutes → trip_seconds BETWEEN 1 AND 3600.
--  • Convert seconds → minutes and ROUND to nearest whole for the final min/max.
--  • Use a CTE so we can first assign the NTILE (analytic function) and then
--    aggregate; analytic columns can’t appear directly in GROUP BY.
--  • Final SELECT: for each quantile give rounded min/max minutes, total trips,
--    and average fare.
WITH trips_quantiled AS (
  SELECT
    NTILE(6) OVER (ORDER BY trip_seconds) AS quantile,
    ROUND(trip_seconds / 60.0)            AS trip_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds BETWEEN 1 AND 3600      -- keep 0–60 minute trips
)
SELECT
  quantile                    AS quantile_group,
  MIN(trip_minutes)           AS min_trip_minutes,
  MAX(trip_minutes)           AS max_trip_minutes,
  COUNT(*)                    AS total_trips,
  AVG(fare)                   AS average_fare
FROM trips_quantiled
GROUP BY quantile
ORDER BY quantile;
