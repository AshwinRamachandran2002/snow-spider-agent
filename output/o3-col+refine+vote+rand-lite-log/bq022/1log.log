```sql
--Description: 1) Peek at a few trips to understand the core columns we’ll be using.
SELECT
  `trip_start_timestamp`,
  `trip_seconds`,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 2) See the variety of payment types that exist in the table.
SELECT DISTINCT
  `payment_type`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 3) Examine some distinct trip durations (in seconds) that fall inside our
--target 0–3 600-second window (0–60 minutes).
SELECT DISTINCT
  `trip_seconds`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 1 AND 3600
ORDER BY `trip_seconds`
LIMIT 20;
```

```sql
--Description: 4) Convert seconds to minutes (with one decimal place) for a sample of trips
--to confirm the calculation we will use later.
SELECT
  `trip_seconds`,
  ROUND(`trip_seconds`/60, 1) AS trip_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
--Description: 5) Assign each qualifying trip to one of six equal-sized quantile buckets
--using NTILE, then preview the result.
SELECT
  `trip_seconds`,
  ROUND(`trip_seconds`/60, 1) AS trip_minutes,
  NTILE(6) OVER (ORDER BY `trip_seconds`) AS quantile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 1 AND 3600
LIMIT 20;
```

```sql
--Description: 6) Aggregate (without rounding) to see the raw min / max seconds and average
--fare for each of the six quantiles.
SELECT
  NTILE(6) OVER (ORDER BY `trip_seconds`) AS quantile,
  MIN(`trip_seconds`) AS min_seconds,
  MAX(`trip_seconds`) AS max_seconds,
  COUNT(*)               AS trips,
  AVG(`fare`)            AS avg_fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 1 AND 3600
GROUP BY quantile
ORDER BY quantile
LIMIT 20;
```

```sql
--Description: 7) FINAL ANSWER – For trips lasting 0–60 minutes, put them into six equal
--quantile groups by duration and report the rounded min / max duration (minutes),
--trip count, and average fare for every group.
SELECT
  quantile                                        AS quantile_group,
  MIN(ROUND(trip_minutes)) AS min_trip_minutes,   -- rounded to nearest whole minute
  MAX(ROUND(trip_minutes)) AS max_trip_minutes,   -- rounded to nearest whole minute
  COUNT(*)                    AS total_trips,
  AVG(`fare`)                 AS average_fare
FROM (
  SELECT
    ROUND(`trip_seconds` / 60.0, 2) AS trip_minutes,
    `fare`,
    NTILE(6) OVER (ORDER BY `trip_seconds`) AS quantile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE `trip_seconds` BETWEEN 1 AND 3600          -- 0 < duration ≤ 60 minutes
)
GROUP BY quantile
ORDER BY quantile;
```

