--Description: 5) Assign each qualifying trip to one of six equal-sized quantile buckets
--using NTILE, then preview the result.
SELECT
  `trip_seconds`,
  ROUND(`trip_seconds`/60, 1) AS trip_minutes,
  NTILE(6) OVER (ORDER BY `trip_seconds`) AS quantile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE `trip_seconds` BETWEEN 1 AND 3600
LIMIT 20;
