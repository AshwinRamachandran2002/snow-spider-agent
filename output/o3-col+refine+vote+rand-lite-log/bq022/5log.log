```sql
--Description: Convert trip_seconds to minutes for trips that last 0–60 minutes
--             and preview a few of them.
SELECT
  unique_key,
  ROUND(trip_seconds/60.0, 2) AS duration_minutes,
  fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds > 0            -- positive trips
  AND trip_seconds <= 3600        -- ≤ 60 minutes
LIMIT 20;
```

```sql
--Description: Compute six-way (quintile-plus-one) break points for the 
--             0–60-minute trips, giving a sense of the range each group will cover.
SELECT
  APPROX_QUANTILES(trip_seconds/60.0, 6) AS six_quantile_edges
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds > 0
  AND trip_seconds <= 3600;
```

```sql
--Description: Assign every eligible trip to a 1–6 quantile bucket and
--             show a small sample to confirm the bucketing logic.
SELECT
  unique_key,
  ROUND(trip_seconds/60.0) AS duration_min_rounded,
  NTILE(6) OVER (ORDER BY trip_seconds/60.0) AS quantile_group
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds > 0
  AND trip_seconds <= 3600
LIMIT 20;
```

```sql
--Description: FINAL ANSWER ‑- For each of the six equal-sized quantile groups
--             (based on trip duration in minutes, 0–60 only), return:
--             • minimum rounded duration
--             • maximum rounded duration
--             • total number of trips
--             • average fare
SELECT
  quantile_group,
  MIN(ROUND(trip_seconds/60.0)) AS min_duration_minutes,
  MAX(ROUND(trip_seconds/60.0)) AS max_duration_minutes,
  COUNT(*)                     AS total_trips,
  AVG(fare)                    AS avg_fare
FROM (
  SELECT
    trip_seconds,
    fare,
    NTILE(6) OVER (ORDER BY trip_seconds/60.0) AS quantile_group
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds > 0
    AND trip_seconds <= 3600      -- keep trips of 0–60 minutes
)
GROUP BY quantile_group
ORDER BY quantile_group;
```
