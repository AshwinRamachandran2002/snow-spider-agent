Query:
--Description: Compute six-way (quintile-plus-one) break points for the 
--             0–60-minute trips, giving a sense of the range each group will cover.
SELECT
  APPROX_QUANTILES(trip_seconds/60.0, 6) AS six_quantile_edges
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds > 0
  AND trip_seconds <= 3600;
