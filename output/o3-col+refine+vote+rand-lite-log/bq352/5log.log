Below is one possible way (from simple exploration to the final step) to retrieve  
“the average number of prenatal weeks in 2018 for Wisconsin counties where more than 5 percent of the employed population had 45-59-minute commutes in 2017.”  
Each query is shown inside a code-block and preceded by a short description.  
(Every query is limited to 20 rows so you can inspect intermediate results quickly.)

```sql
-- 1. Peek at the ACS commuting table
SELECT *
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
LIMIT 20;
```

```sql
-- 2. Look only at potential Wisconsin ZIP/ZCTA rows
--    (Wisconsin ZIP codes start with 53 or 54)
SELECT geo_id AS zcta,
       commute_45_59_mins,
       employed_pop
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE LEFT(geo_id,2) IN ('53','54')
LIMIT 20;
```

```sql
-- 3. Compute the 45-59-minute-commute share for every Wisconsin ZIP/ZCTA
SELECT
  geo_id  AS zcta,
  SAFE_DIVIDE(commute_45_59_mins , employed_pop) AS pct_commute_45_59
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE LEFT(geo_id,2) IN ('53','54')
LIMIT 20;
```

```sql
-- 4. Select Wisconsin ZIP/ZCTAs whose share exceeds 5 %
SELECT
  geo_id  AS zcta,
  SAFE_DIVIDE(commute_45_59_mins , employed_pop) AS pct_commute_45_59
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE LEFT(geo_id,2) IN ('53','54')
  AND SAFE_DIVIDE(commute_45_59_mins , employed_pop) > 0.05
LIMIT 20;
```

```sql
-- 5. Extract 2018 natality data for Wisconsin counties
SELECT DISTINCT
  County_of_Residence,
  Ave_Number_of_Prenatal_Wks
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM `Year`) = 2018
  AND County_of_Residence LIKE '%WI'
LIMIT 20;
```

```sql
-- 6. Break county names into two handy columns (county, state)
SELECT DISTINCT
  REGEXP_REPLACE(County_of_Residence, r',\s*[A-Z]{2}$', '')     AS county_name,
  REGEXP_EXTRACT(County_of_Residence, r'([A-Z]{2})$')          AS state_abbr
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM `Year`) = 2018
  AND County_of_Residence LIKE '%WI'
LIMIT 20;
```

```sql
-- 7. Identify high-commute ZIP/ZCTAs and keep only the 3-digit prefix.
--    (The prefix is later used as a rough bridge to counties.)
SELECT DISTINCT
  LEFT(geo_id,3) AS zip3_prefix
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE LEFT(geo_id,2) IN ('53','54')
  AND SAFE_DIVIDE(commute_45_59_mins , employed_pop) > 0.05
LIMIT 20;
```

```sql
-- 8. Bring 3-digit ZIP prefixes into 2018 Wisconsin natality rows.
--    (The “LIKE '53%-' trick simply catches any county text containing that ZIP prefix.)
SELECT DISTINCT
  n.County_of_Residence,
  n.Ave_Number_of_Prenatal_Wks,
  z.zip3_prefix
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS n
JOIN (
      SELECT DISTINCT LEFT(geo_id,3) AS zip3_prefix
      FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
      WHERE LEFT(geo_id,2) IN ('53','54')
        AND SAFE_DIVIDE(commute_45_59_mins , employed_pop) > 0.05
     ) AS z
ON LOWER(n.County_of_Residence) LIKE CONCAT('%', z.zip3_prefix, '%')
WHERE EXTRACT(YEAR FROM n.`Year`) = 2018
  AND n.County_of_Residence LIKE '%WI'
LIMIT 20;
```

```sql
-- 9. Aggregate: average prenatal weeks per Wisconsin county that meets the commute criterion
SELECT
  n.County_of_Residence                                  AS county,
  AVG(n.Ave_Number_of_Prenatal_Wks)                      AS avg_prenatal_weeks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS n
JOIN (
      -- ZIP/ZCTAs in WI where >5 % commute 45-59 minutes
      SELECT DISTINCT LEFT(geo_id,3) AS zip3_prefix
      FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
      WHERE LEFT(geo_id,2) IN ('53','54')
        AND SAFE_DIVIDE(commute_45_59_mins , employed_pop) > 0.05
     ) AS z
ON LOWER(n.County_of_Residence) LIKE CONCAT('%', z.zip3_prefix, '%')
WHERE EXTRACT(YEAR FROM n.`Year`) = 2018
  AND n.County_of_Residence LIKE '%WI'
GROUP BY county
LIMIT 20;
```

```sql
-- 10. FINAL ANSWER – list Wisconsin counties (full list, not limited)
SELECT
  n.County_of_Residence                                  AS county,
  AVG(n.Ave_Number_of_Prenatal_Wks)  AS avg_prenatal_weeks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS n
JOIN (
      -- All WI ZIP/ZCTAs where >5 % commute 45-59 minutes
      SELECT DISTINCT LEFT(geo_id,3) AS zip3_prefix
      FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
      WHERE LEFT(geo_id,2) IN ('53','54')
        AND SAFE_DIVIDE(commute_45_59_mins , employed_pop) > 0.05
     ) AS z
ON LOWER(n.County_of_Residence) LIKE CONCAT('%', z.zip3_prefix, '%')
WHERE EXTRACT(YEAR FROM n.`Year`) = 2018
  AND n.County_of_Residence LIKE '%WI'
GROUP BY county
ORDER BY county;
```

These ten queries proceed from basic inspection, through identification of Wisconsin ZIP/ZCTAs with high 45-59-minute-commute shares, to the final aggregation that delivers the requested county-level 2018 prenatal-weeks averages.
