--Description:  Return the average number of prenatal weeks in 2018 for those
--Wisconsin counties whose work-force had a 5 %+ share of 45–59-minute commuters
--in 2017.  Because the ACS table is at ZIP-code (ZCTA) level, we flag the high-
--commute Wisconsin ZCTAs, then keep only the natality-table counties whose name
--contains the corresponding 3-digit county FIPS (characters 3-5 of the ZCTA).
WITH high_commute AS (                         -- ➊ ZCTAs with >5 % long commuters
  SELECT geo_id
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE SUBSTR(geo_id, 1, 2) = '55'           -- Wisconsin state code
  GROUP BY geo_id
  HAVING SAFE_DIVIDE(SUM(commute_45_59_mins),
                     SUM(employed_pop)) > 0.05
),
prenatal_2018 AS (                             -- ➋ Avg prenatal weeks for WI counties
  SELECT County_of_Residence,
         AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE Year = '2018-01-01'
    AND RIGHT(TRIM(County_of_Residence), 2) = 'WI'     -- Wisconsin counties
  GROUP BY County_of_Residence
)
SELECT p.County_of_Residence,
       p.avg_prenatal_wks_2018
FROM   prenatal_2018 AS p
WHERE EXISTS (                                     -- ➌ keep counties matched to a high-commute ZCTA
  SELECT 1
  FROM   high_commute AS h
  WHERE  STRPOS(LOWER(p.County_of_Residence),
                LOWER(SUBSTR(h.geo_id, 3, 3))) > 0
)
ORDER BY p.County_of_Residence;
