  AND  RIGHT(`County_of_Residence`,3) = ', WI'
GROUP BY `County_of_Residence`
LIMIT 20;
```

```sql
-- 8.  Persist the high-commute Wisconsin geographies (ratio  > 5 %)
WITH high_commute AS (
  SELECT  `geo_id`,
          SAFE_DIVIDE(SUM(`commute_45_59_mins`),
                      SUM(`employed_pop`)) AS commute_pct
  FROM    `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE   SUBSTR(`geo_id`,1,2) = '55'
  GROUP BY `geo_id`
  HAVING  commute_pct > 0.05
)
SELECT * FROM high_commute
LIMIT 20;
```

```sql
-- 9.  Try matching those high-commute Wisconsin FIPS codes
--     to county names that occur in the natality table
WITH high_commute AS (
  SELECT  `geo_id`
  FROM    `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE   SUBSTR(`geo_id`,1,2) = '55'
  GROUP BY `geo_id`
  HAVING  SAFE_DIVIDE(SUM(`commute_45_59_mins`),
                      SUM(`employed_pop`)) > 0.05
)
SELECT DISTINCT h.geo_id, n.`County_of_Residence`
FROM   high_commute                                    AS h
JOIN   `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS n
  ON   RIGHT(n.`County_of_Residence`,3) = ', WI'
WHERE  n.`Year` = '2018-01-01'
  -- crude attempt: county-code (last 3 of FIPS) must appear in county-string
  AND   POSITION(SUBSTR(h.geo_id,3,3) IN LOWER(n.`County_of_Residence`)) > 0
LIMIT 20;
```

```sql
-- 10.  FINAL – average number of prenatal weeks (2018)
--      for Wisconsin counties whose 2017 45-59-minute-commute
--      share exceeded 5 %
WITH high_commute AS (
  SELECT  `geo_id`
  FROM    `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE   SUBSTR(`geo_id`,1,2) = '55'       -- Wisconsin
  GROUP BY `geo_id`
  HAVING  SAFE_DIVIDE(SUM(`commute_45_59_mins`),
                      SUM(`employed_pop`)) > 0.05
),
prenatal_2018 AS (
  SELECT  `County_of_Residence`,
          AVG(`Ave_Number_of_Prenatal_Wks`) AS avg_prenatal_wks_2018
  FROM    `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE   `Year` = '2018-01-01'
    AND   RIGHT(`County_of_Residence`,3) = ', WI'
  GROUP BY `County_of_Residence`
)
SELECT  p.`County_of_Residence`,
        p.avg_prenatal_wks_2018
FROM    prenatal_2018 AS p
WHERE EXISTS (
        SELECT 1
        FROM   high_commute AS h
        -- keep rows whose 3-digit county-code appears in the county name
        WHERE  POSITION(SUBSTR(h.geo_id,3,3)
                        IN   LOWER(p.`County_of_Residence`)) > 0)
ORDER BY p.`County_of_Residence`;
```

Each step drills a little deeper—from simply viewing the raw columns, to isolating the Wisconsin records, to flagging those with a high proportion of 45-59-minute commuters, and finally marrying that information to the 2018 natality data so that only the qualifying Wisconsin counties (those over the 5 % commute threshold) are returned with their average number of prenatal weeks.
