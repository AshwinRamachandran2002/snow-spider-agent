--Description:  Final solution in one query.
-- 1. high_commute_fips – from 2017 ACS ZCTA data, keep Wisconsin ZCTAs whose share of
--    commuters travelling 45–59 minutes exceeds 5 %.  Extract the 3-digit county FIPS
--    (characters 3-5 of the ZCTA), yielding the list of “high-commute” counties.
-- 2. prenatal_2018 – compute each Wisconsin county’s average number of prenatal weeks
--    in 2018 (CDC WONDER natality data).
-- 3. The outer SELECT keeps only those counties whose name contains one of the high-
--    commute FIPS codes (text match via REGEXP_CONTAINS).  This provides the requested
--    counties together with their 2018 average prenatal-weeks figure.
WITH high_commute_fips AS (               /* 1. counties where >5 % commute 45-59 min */
  SELECT DISTINCT SUBSTR(geo_id, 3, 3) AS county_fips
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE SUBSTR(geo_id, 1, 2) = '55'      -- Wisconsin state FIPS
  GROUP BY geo_id
  HAVING SAFE_DIVIDE(SUM(commute_45_59_mins), SUM(employed_pop)) > 0.05
),
prenatal_2018 AS (                        /* 2. avg prenatal weeks per WI county */
  SELECT County_of_Residence,
         AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE Year = '2018-01-01'
