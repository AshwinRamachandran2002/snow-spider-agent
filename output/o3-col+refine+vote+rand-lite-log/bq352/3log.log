/*  Average prenatal-weeks (2018) for Wisconsin counties where
    more than 5 % of 2017 workers had 45–59-minute commutes           */

-- 1.  Identify Wisconsin counties whose 45-59-minute commuters
--     exceed 5 % of the employed population (ACS 2017, 5-yr)
WITH high_commute AS (
  SELECT
    geo_id                                    -- 5-digit state+county FIPS
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  WHERE SUBSTR(geo_id,1,2) = '55'            -- Wisconsin
    AND employed_pop > 0
    AND SAFE_DIVIDE(commute_45_59_mins,
                    employed_pop) > 0.05
),

-- 2.  Map those FIPS codes to county names (Geo boundaries table)
county_names AS (
  SELECT
    fips                     AS geo_id,
    TRIM(SPLIT(name, ',')[OFFSET(0)]) AS county_base_name   -- e.g. “Dane County”
  FROM `bigquery-public-data.geo_us_boundaries.counties`
  WHERE state_code = 'WI'
),

-- 3.  Keep only the high-commute Wisconsin counties
target_counties AS (
  SELECT DISTINCT
         cn.county_base_name
  FROM   high_commute hc
  JOIN   county_names cn
    USING (geo_id)
)

-- 4.  Average 2018 prenatal weeks for those counties
SELECT
  nat.County_of_Residence,
  AVG(nat.Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS nat
JOIN target_counties tc
  ON TRIM(SPLIT(nat.County_of_Residence, ',')[OFFSET(0)]) = tc.county_base_name
WHERE nat.Year = '2018-01-01'                      -- 2018 data
  AND RIGHT(TRIM(nat.County_of_Residence), 2) = 'WI'   -- Wisconsin rows
GROUP BY nat.County_of_Residence
ORDER BY nat.County_of_Residence;
