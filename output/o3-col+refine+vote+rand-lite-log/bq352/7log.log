--Description: FINAL – average prenatal weeks (2018) for counties in WI,  
--             shown only if the state-wide share of 45-59 min commuters in 2017 > 5 %.  
WITH wi_commute AS (  
  SELECT  
    100 * SUM(commute_45_59_mins) / SUM(employed_pop) AS pct_commute  
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`  
  WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999  
),  
wi_counties_2018 AS (  
  SELECT  
    County_of_Residence,  
    AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018  
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`  
  WHERE EXTRACT(YEAR FROM Year)=2018  
    AND County_of_Residence LIKE '%, WI'  
  GROUP BY County_of_Residence  
)  
SELECT  
  c.County_of_Residence,  
  c.avg_prenatal_wks_2018  
FROM wi_counties_2018 AS c  
JOIN wi_commute AS w  
ON w.pct_commute > 5   -- apply the “> 5 % commuting” rule  
ORDER BY c.avg_prenatal_wks_2018 DESC  
LIMIT 20;
