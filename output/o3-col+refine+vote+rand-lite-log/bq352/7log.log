```

```sql
--Description: Compute the share of workers who commute 45-59 minutes in every ZCTA  
SELECT  
  geo_id,  
  commute_45_59_mins / NULLIF(employed_pop,0) AS pct_commute_45_59  
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`  
LIMIT 20;
```

```sql
--Description: List ZCTAs that fall inside Wisconsin (ZIPs 53000-54999)   
SELECT  
  geo_id,  
  commute_45_59_mins / NULLIF(employed_pop,0) AS pct_commute_45_59  
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`  
WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999  
LIMIT 20;
```

```sql
--Description: Show Wisconsin ZCTAs where > 5 % of workers commute 45-59 mins  
SELECT  
  geo_id,  
  commute_45_59_mins,  
  employed_pop,  
  commute_45_59_mins / employed_pop AS pct_commute_45_59  
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`  
WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999  
  AND commute_45_59_mins / employed_pop > 0.05  
LIMIT 20;
```

```sql
--Description: Look at a few Wisconsin county rows in the natality table (any year)  
SELECT  
  Year,  
  County_of_Residence,  
  Ave_Number_of_Prenatal_Wks  
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`  
WHERE County_of_Residence LIKE '%, WI'  
LIMIT 20;
```

```sql
--Description: Distinct Wisconsin counties that have natality records in 2018  
SELECT DISTINCT County_of_Residence  
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`  
WHERE EXTRACT(YEAR FROM Year)=2018  
  AND County_of_Residence LIKE '%, WI'  
LIMIT 20;
```

```sql
--Description: Average number of prenatal weeks for every Wisconsin county in 2018  
SELECT  
  County_of_Residence,  
  AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018  
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`  
WHERE EXTRACT(YEAR FROM Year)=2018  
  AND County_of_Residence LIKE '%, WI'  
GROUP BY County_of_Residence  
ORDER BY avg_prenatal_wks_2018 DESC  
LIMIT 20;
```

```sql
--Description: Flag if Wisconsin (ZIP range 53000-54999) had > 5 % 45-59 min commuters in 2017  
SELECT  
  100 * SUM(commute_45_59_mins) / SUM(employed_pop) AS wi_pct_commute_45_59  
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`  
WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999  
LIMIT 20;
```

```sql
--Description: FINAL – average prenatal weeks (2018) for counties in WI,  
--             shown only if the state-wide share of 45-59 min commuters in 2017 > 5 %.  
WITH wi_commute AS (  
  SELECT  
    100 * SUM(commute_45_59_mins) / SUM(employed_pop) AS pct_commute  
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`  
  WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999  
),  
wi_counties_2018 AS (  
  SELECT  
    County_of_Residence,  
    AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018  
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`  
  WHERE EXTRACT(YEAR FROM Year)=2018  
    AND County_of_Residence LIKE '%, WI'  
  GROUP BY County_of_Residence  
)  
SELECT  
  c.County_of_Residence,  
  c.avg_prenatal_wks_2018  
FROM wi_counties_2018 AS c  
JOIN wi_commute AS w  
ON w.pct_commute > 5   -- apply the “> 5 % commuting” rule  
ORDER BY c.avg_prenatal_wks_2018 DESC  
LIMIT 20;
```

These queries progress from simple data exploration to the combined logic that fulfils the requirement:  
“List the average number of prenatal weeks in 2018 for counties in Wisconsin where more than 5 % of the employed population had commutes of 45-59 minutes in 2017.”
