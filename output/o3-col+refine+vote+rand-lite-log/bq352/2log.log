```sql
--Description: List the distinct Wisconsin county names that appear in the natality
--             table so we know the spelling of each “County, WI” record.
SELECT DISTINCT County_of_Residence
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE County_of_Residence LIKE '%, WI'
LIMIT 20;
```

```sql
--Description:  Generate the commute ratio (45–59 minutes / employed population)
--              for every ZCTA that lies in Wisconsin.  ZCTA FIPS begin with “55”.
SELECT
  geo_id                     AS zcta5,
  commute_45_59_mins,
  employed_pop,
  SAFE_DIVIDE(commute_45_59_mins, employed_pop) AS commute_ratio_45_59
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE geo_id LIKE '55%'            -- Wisconsin
  AND employed_pop IS NOT NULL
LIMIT 20;
```

```sql
--Description:  Roll the 2017 ZCTA records up to the county-FIPS level (state-code(55)
--              + county-code(3) = 5 digits) and keep only counties whose share of
--              45–59-minute commuters is > 5 %.
WITH county_level AS (
  SELECT
    SUBSTR(geo_id, 1, 5)                 AS county_fips,      -- 55XXX
    SUM(commute_45_59_mins)             AS commuters_45_59,
    SUM(employed_pop)                   AS total_employed,
    SAFE_DIVIDE(SUM(commute_45_59_mins),
                SUM(employed_pop))      AS commute_share
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE geo_id LIKE '55%'
  GROUP BY county_fips
)
SELECT *
FROM county_level
WHERE commute_share > 0.05
LIMIT 20;
```

```sql
--Description:  Show the 2018 natality records for Wisconsin so that we can see the
--              exact format of the `County_of_Residence` field we will later join on.
SELECT
  Year,
  County_of_Residence,
  Ave_Number_of_Prenatal_Wks
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Year = '2018-01-01'
  AND County_of_Residence LIKE '%, WI'
LIMIT 20;
```

```sql
--Description:  Build a helper table that converts the 55XXX county FIPS codes
--              produced above into the plain county name text that appears inside
--              the natality file (“Adams County, WI”, …).  This is done by string
--              manipulation on `County_of_Residence`.
WITH wisconsin_names AS (
  SELECT
    REGEXP_REPLACE(County_of_Residence,
                   r' County, WI$', '')                         AS county_name,
    County_of_Residence
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE County_of_Residence LIKE '%, WI'
  GROUP BY County_of_Residence
)
SELECT *
FROM wisconsin_names
LIMIT 20;
```

```sql
--Description:  Combine (1) the counties whose commute share exceeded 5 % in 2017
--              with (2) the natality data for 2018.  First map FIPS → name using
--              the official FIPS-county-name relation that is embedded in the
--              natality file itself.
WITH commute_hi AS (                              -- step (1)
  SELECT
    SUBSTR(geo_id, 1, 5)       AS county_fips,
    SAFE_DIVIDE(SUM(commute_45_59_mins),
                SUM(employed_pop)) AS commute_share
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE geo_id LIKE '55%'
  GROUP BY county_fips
  HAVING commute_share > 0.05
),
fips_to_name AS (                                -- step (2) helper
  SELECT DISTINCT
    county_fips,
    County_of_Residence
  FROM (
    SELECT
      -- FIPS is always the last 5 digits inside the bracketed string
      REGEXP_EXTRACT(County_of_Residence, r'\(([0-9]{5})\)') AS county_fips,
      County_of_Residence
    FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
    WHERE County_of_Residence LIKE '%, WI'
  )
  WHERE county_fips IS NOT NULL
)
SELECT *
FROM commute_hi AS c
JOIN fips_to_name AS n
USING (county_fips)
LIMIT 20;
```

```sql
--Description:  Final answer – average number of prenatal weeks in 2018 for every
--              Wisconsin county whose 2017 45–59-minute commute share exceeded 5 %.
WITH commute_hi AS (
  SELECT
    SUBSTR(geo_id, 1, 5) AS county_fips
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE geo_id LIKE '55%'
  GROUP BY county_fips
  HAVING SAFE_DIVIDE(SUM(commute_45_59_mins), SUM(employed_pop)) > 0.05
),
natality_2018 AS (
  SELECT
    Year,
    County_of_Residence,
    Ave_Number_of_Prenatal_Wks,
    REGEXP_EXTRACT(County_of_Residence, r'\(([0-9]{5})\)') AS county_fips
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE Year = '2018-01-01'
    AND County_of_Residence LIKE '%, WI'
    AND Ave_Number_of_Prenatal_Wks IS NOT NULL
)
SELECT
  n.County_of_Residence,
  ROUND(AVG(n.Ave_Number_of_Prenatal_Wks), 2) AS avg_prenatal_weeks_2018
FROM natality_2018 AS n
JOIN commute_hi  AS c
USING (county_fips)
GROUP BY County_of_Residence
ORDER BY avg_prenatal_weeks_2018 DESC
LIMIT 20;
```
