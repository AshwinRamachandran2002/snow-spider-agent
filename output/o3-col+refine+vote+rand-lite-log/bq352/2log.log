Query:
--Description:  Roll the 2017 ZCTA records up to the county-FIPS level (state-code(55)
--              + county-code(3) = 5 digits) and keep only counties whose share of
--              45–59-minute commuters is > 5 %.
WITH county_level AS (
  SELECT
    SUBSTR(geo_id, 1, 5)                 AS county_fips,      -- 55XXX
    SUM(commute_45_59_mins)             AS commuters_45_59,
    SUM(employed_pop)                   AS total_employed,
    SAFE_DIVIDE(SUM(commute_45_59_mins),
                SUM(employed_pop))      AS commute_share
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE geo_id LIKE '55%'
  GROUP BY county_fips
)
SELECT *
FROM county_level
WHERE commute_share > 0.05
LIMIT 20;
