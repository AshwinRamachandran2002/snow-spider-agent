--Description:  Generate the commute ratio (45–59 minutes / employed population)
--              for every ZCTA that lies in Wisconsin.  ZCTA FIPS begin with “55”.
SELECT
  geo_id                     AS zcta5,
  commute_45_59_mins,
  employed_pop,
  SAFE_DIVIDE(commute_45_59_mins, employed_pop) AS commute_ratio_45_59
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE geo_id LIKE '55%'            -- Wisconsin
  AND employed_pop IS NOT NULL
LIMIT 20;
