```sql
--Description: 1) Quick look at the ACS ZCTA table to understand the columns we will use
SELECT geo_id,
       commute_45_59_mins,
       employed_pop,
       ROUND(commute_45_59_mins / employed_pop, 4) AS pct_45_59_mins
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
LIMIT 20;
```

```sql
--Description: 2) Check how many Wisconsin-looking ZIP/ZCTA codes exist  
--   (Wisconsin ZIP codes begin with 53-54 → 53000-54999)
SELECT DISTINCT geo_id
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999
LIMIT 20;
```

```sql
--Description: 3) Calculate the 2017 Wisconsin-wide share of workers whose commute was 45-59 minutes
SELECT
  SUM(commute_45_59_mins)                  AS total_45_59_min_commuters,
  SUM(employed_pop)                        AS total_employed,
  ROUND(SUM(commute_45_59_mins) /
        SUM(employed_pop), 4)              AS wi_pct_45_59_mins
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999;
```

```sql
--Description: 4) Quick peek at the natality table to verify 2018 data for Wisconsin counties
SELECT Year,
       County_of_Residence,
       Ave_Number_of_Prenatal_Wks
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2018
  AND County_of_Residence LIKE '%, WI'
LIMIT 20;
```

```sql
--Description: 5) Compute the average prenatal weeks for each Wisconsin county in 2018
SELECT
  County_of_Residence,
  ROUND(AVG(Ave_Number_of_Prenatal_Wks), 2) AS avg_prenatal_wks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2018
  AND County_of_Residence LIKE '%, WI'
GROUP BY County_of_Residence
ORDER BY County_of_Residence
LIMIT 20;
```

```sql
--Description: 6) FINAL – list 2018 average prenatal weeks for Wisconsin counties, 
--               only if the 2017 ACS shows >5 % of workers commuting 45-59 min statewide
WITH wi_commute_ratio AS (
  SELECT
    SUM(commute_45_59_mins) / SUM(employed_pop) AS pct_45_59_mins
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE SAFE_CAST(geo_id AS INT64) BETWEEN 53000 AND 54999     -- Wisconsin ZCTAs
)
SELECT
  n.County_of_Residence,
  ROUND(AVG(n.Ave_Number_of_Prenatal_Wks), 2) AS avg_prenatal_wks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS n
JOIN wi_commute_ratio r
  ON r.pct_45_59_mins > 0.05                                   -- >5 % commuters criterion
WHERE EXTRACT(YEAR FROM n.Year) = 2018
  AND n.County_of_Residence LIKE '%, WI'
GROUP BY n.County_of_Residence
ORDER BY n.County_of_Residence
LIMIT 20;
```

(The sixth query will only return rows if Wisconsin’s 2017 ACS commuting share exceeds 5 %.  If the criterion is not met, the result set will be empty.)
