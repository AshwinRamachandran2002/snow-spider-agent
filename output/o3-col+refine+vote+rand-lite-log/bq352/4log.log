```sql
--Description: 
-- 🔟  Repairs the earlier grouping error by first aggregating commute counts
--      and employed population per Wisconsin ZCTA, then computing the share
--      of 45–59-minute commuters.  The statewide 2018 average prenatal weeks
--      is calculated separately and CROSS-JOINed for reference.
WITH commute_ok AS (
  SELECT
    geo_id                                   AS zcta,
    SUM(commute_45_59_mins)  AS tot_45_59,
    SUM(employed_pop)        AS tot_employed,
    SAFE_DIVIDE(SUM(commute_45_59_mins),
                SUM(employed_pop))           AS pct_comm_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999      -- Wisconsin ZIPs
        AND employed_pop > 0
  GROUP BY zcta
  HAVING pct_comm_45_59 > 0.05
),
wi_prenatal_2018 AS (
  SELECT
    AVG(Ave_Number_of_Prenatal_Wks) AS statewide_avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
    AND County_of_Residence LIKE '%, WI'
)
SELECT
  c.zcta,
  c.pct_comm_45_59,
  p.statewide_avg_prenatal_wks_2018
FROM commute_ok AS c
CROSS JOIN wi_prenatal_2018 AS p
ORDER BY c.pct_comm_45_59 DESC
LIMIT 100;
```
