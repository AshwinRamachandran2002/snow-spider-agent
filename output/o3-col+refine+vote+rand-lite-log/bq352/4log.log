  WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999    -- Wisconsin ZIPs
        AND employed_pop > 0
  GROUP BY zcta
  HAVING pct_comm_45_59 > 0.05
)
SELECT
  zcta,
  tot_45_59,
  tot_employed,
  pct_comm_45_59
FROM commute_ok
ORDER BY pct_comm_45_59 DESC
LIMIT 20;
