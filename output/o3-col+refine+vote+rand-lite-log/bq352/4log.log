Query:
--Description: 
-- 5️⃣  Aggregates at the ZCTA (ZIP Code Tabulation Area) level instead of the
--      non-existent `county_name`.  Filters Wisconsin ZCTAs via their 53-55
--      prefixes and retains only areas where more than 5 % of workers had
--      45-59-minute commutes in 2017.
WITH zcta_rollup AS (
  SELECT
    geo_id                                   AS zcta,
    SUM(commute_45_59_mins)                  AS tot_45_59,
    SUM(employed_pop)                        AS tot_employed,
    SAFE_DIVIDE(SUM(commute_45_59_mins),
                SUM(employed_pop))           AS pct_comm_45_59
  FROM  `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999        -- Wisconsin
  GROUP BY zcta
)
SELECT *
FROM   zcta_rollup
WHERE  pct_comm_45_59 > 0.05
ORDER  BY pct_comm_45_59 DESC
LIMIT 20
