2025-05-05 03:18:52 - Thread-1901 (execute) - INFO - [Exploration]
Below are up-to-10 exploratory SQLs that progressively examine the two provided tables and finish with a query that returns  

“the average number of prenatal weeks in 2018 for counties in Wisconsin where more than 5 % of the employed population had commutes of 45-59 minutes in 2017”.

Each query is wrapped in a single code block; a short description precedes it.

```sql
-- 1. Description:
--    Peek at a handful of rows in the ZCTA-level ACS table.
SELECT *
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
LIMIT 20;
```

```sql
-- 2. Description:
--    Show only Wisconsin-related ZCTAs (ZIP Code Tabulation Areas).
--    Wisconsin ZIP codes start with 53-, 54- or 55-.
SELECT geo_id, commute_45_59_mins, employed_pop
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999
LIMIT 20;
```

```sql
-- 3. Description:
--    Compute the share of workers whose commute is 45-59 minutes
--    for every Wisconsin ZCTA and keep those above the 5 % threshold.
SELECT
  geo_id,
  SAFE_DIVIDE(commute_45_59_mins , employed_pop) AS pct_comm_45_59
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999
  AND employed_pop > 0
  AND SAFE_DIVIDE(commute_45_59_mins , employed_pop) > 0.05
ORDER BY pct_comm_45_59 DESC
LIMIT 20;
```

```sql
-- 4. Description:
--    Investigate whether the ACS ZCTA table already carries a county name
--    (many ACS releases do).  If present it will make a county roll-up easy.
SELECT DISTINCT county_name
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE county_name IS NOT NULL
  AND LOWER(state_name)="wisconsin"
LIMIT 20;
```

```sql
-- 5. Description:
--    Aggregate Wisconsin ZCTAs to county level;
--    calculate the percentage of 45-59 minute commuters in 2017.
--    Only counties with > 5 % are kept.
WITH county_rollup AS (
  SELECT
    county_name,
    SUM(commute_45_59_mins)   AS tot_45_59,
    SUM(employed_pop)         AS tot_employed,
    SAFE_DIVIDE(SUM(commute_45_59_mins), SUM(employed_pop)) AS pct_comm_45_59
  FROM  `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE LOWER(state_name)="wisconsin"
  GROUP BY county_name
)
SELECT *
FROM   county_rollup
WHERE  pct_comm_45_59 > 0.05
ORDER  BY pct_comm_45_59 DESC
LIMIT 20;
```

```sql
-- 6. Description:
--    Display a sample of the natality table so we know how counties
--    are written and to confirm the 2018 year value.
SELECT *
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year)=2018
LIMIT 20;
```

```sql
-- 7. Description:
--    List DISTINCT Wisconsin counties that have natality data for 2018.
SELECT DISTINCT County_of_Residence
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year)=2018
  AND County_of_Residence LIKE '%, WI'
ORDER BY County_of_Residence
LIMIT 20;
```

```sql
-- 8. Description:
--    Marry the “qualifying” commute counties (>5 % long commuters)
--    to the natality table for 2018 in order to pull prenatal-week data.
WITH commute_ok AS (
  SELECT
      county_name,
      SAFE_DIVIDE(SUM(commute_45_59_mins), SUM(employed_pop)) AS pct_comm_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE LOWER(state_name)="wisconsin"
  GROUP BY county_name
  HAVING pct_comm_45_59 > 0.05
)
SELECT
    n.County_of_Residence,
    n.Ave_Number_of_Prenatal_Wks
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` AS n
JOIN commute_ok AS c
      ON LOWER(n.County_of_Residence) LIKE CONCAT(LOWER(c.county_name), '%')
WHERE EXTRACT(YEAR FROM n.Year)=2018
  AND n.County_of_Residence LIKE '%, WI'
ORDER BY n.County_of_Residence
LIMIT 20;
```

```sql
-- 9. Description:
--    Same as #8 but compute the *average* prenatal weeks for 2018
--    for each qualifying county (if multiple records exist).
WITH commute_ok AS (
  SELECT
      county_name,
      SAFE_DIVIDE(SUM(commute_45_59_mins), SUM(employed_pop)) AS pct_comm_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE LOWER(state_name)="wisconsin"
  GROUP BY county_name
  HAVING pct_comm_45_59 > 0.05
)
SELECT
    n.County_of_Residence,
    AVG(n.Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`  n
JOIN commute_ok  c
      ON LOWER(n.County_of_Residence) LIKE CONCAT(LOWER(c.county_name), '%')
WHERE EXTRACT(YEAR FROM n.Year)=2018
  AND n.County_of_Residence LIKE '%, WI'
GROUP BY n.County_of_Residence
ORDER BY n.County_of_Residence;
```

```sql
-- 10. Description (FINAL ANSWER):
--     Produce the requested list of Wisconsin counties whose
--     2017 long-commute share exceeded 5 %, together with their
--     2018 average number of prenatal weeks.
WITH commute_by_cty AS (
  SELECT
      county_name,
      SAFE_DIVIDE(SUM(commute_45_59_mins), SUM(employed_pop)) AS pct_comm_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE LOWER(state_name)="wisconsin"
  GROUP BY county_name
),
qualifying AS (
  SELECT county_name
  FROM   commute_by_cty
  WHERE  pct_comm_45_59 > 0.05
)
SELECT
    n.County_of_Residence           AS county,
    AVG(n.Ave_Number_of_Prenatal_Wks) AS avg_prenatal_weeks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` n
JOIN qualifying q
      ON LOWER(n.County_of_Residence) LIKE CONCAT(LOWER(q.county_name), '%')
WHERE EXTRACT(YEAR FROM n.Year) = 2018
  AND n.County_of_Residence LIKE '%, WI'
GROUP BY county
ORDER BY county;
```

The last query returns every Wisconsin county whose 2017 share of 45-59-minute commuters was above 5 %, together with its 2018 average number of prenatal-care weeks.
