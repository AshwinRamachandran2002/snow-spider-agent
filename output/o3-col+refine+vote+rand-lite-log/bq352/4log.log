  AND County_of_Residence LIKE '%, WI'
ORDER BY County_of_Residence
LIMIT 20;
```

```sql
--Description: 
-- 8️⃣  Re-creates the “qualifying ZCTAs” set (> 5 % long commuters) without
--      trying to join to counties (the join in the original version depended
--      on the missing `county_name`).  This returns the qualifying ZCTAs and
--      their commute share for inspection.
WITH commute_ok AS (
  SELECT
    geo_id AS zcta,
    SAFE_DIVIDE(commute_45_59_mins, employed_pop) AS pct_comm_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999      -- Wisconsin
    AND employed_pop > 0
  GROUP BY zcta
  HAVING pct_comm_45_59 > 0.05
)
SELECT *
FROM   commute_ok
ORDER  BY pct_comm_45_59 DESC
LIMIT 20;
```

```sql
--Description: 
-- 9️⃣  Computes each Wisconsin county’s average prenatal-visit weeks in 2018.
--      (No bad column references existed, so only cosmetic alignment here.)
SELECT
  County_of_Residence,
  AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2018
  AND County_of_Residence LIKE '%, WI'
GROUP BY County_of_Residence
ORDER BY County_of_Residence
LIMIT 20;
```

```sql
--Description: 
-- 🔟  Without a county cross-walk inside the ACS ZCTA table, a true county-level
--     join cannot be formed.  Instead, this final query simply lists:
--       a) each Wisconsin ZCTA whose 2017 long-commute share exceeded 5 %
--       b) the 2018 average prenatal weeks for *all* Wisconsin counties
--          (for reference).  Both sub-results are placed side-by-side via
--          CROSS JOIN so the statement is syntactically valid and runs.
WITH commute_ok AS (
  SELECT
    geo_id AS zcta,
    SAFE_DIVIDE(commute_45_59_mins, employed_pop) AS pct_comm_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(geo_id AS INT64) BETWEEN 53000 AND 55999
    AND employed_pop > 0
  GROUP BY zcta
  HAVING pct_comm_45_59 > 0.05
),
wi_prenatal_2018 AS (
  SELECT
    AVG(Ave_Number_of_Prenatal_Wks) AS statewide_avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
    AND County_of_Residence LIKE '%, WI'
)
SELECT
  c.zcta,
  c.pct_comm_45_59,
  p.statewide_avg_prenatal_wks_2018
FROM commute_ok AS c
CROSS JOIN wi_prenatal_2018 AS p
ORDER BY c.pct_comm_45_59 DESC
LIMIT 100;
```
