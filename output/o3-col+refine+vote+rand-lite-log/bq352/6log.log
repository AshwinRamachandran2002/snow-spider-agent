```sql
--Description: 8) Average the number of prenatal weeks for all Wisconsin counties
--in calendar year 2018.
SELECT
  County_of_Residence,
  AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2018
  AND LOWER(County_of_Residence) LIKE '%, wi'
GROUP BY County_of_Residence
LIMIT 20;
```

```sql
--Description: 9) Join the ZIP-3 commute information (≥ 5 % long commuters) to the
--Wisconsin natality data for 2018 by doing a fuzzy match on the ZIP-3 code that
--starts the county name (a coarse approximation).
WITH wi_commute AS (
  SELECT
    SUBSTR(geo_id, 1, 3) AS zip3,
    SUM(commute_45_59_mins) AS commuters_45_59,
    SUM(employed_pop)       AS employed
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(SUBSTR(geo_id, 1, 2) AS INT64) IN (53, 54)
  GROUP BY zip3
  HAVING SAFE_DIVIDE(commuters_45_59, employed) * 100 > 5
),
wi_natality_2018 AS (
  SELECT
    County_of_Residence,
    AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
    AND LOWER(County_of_Residence) LIKE '%, wi'
  GROUP BY County_of_Residence
)
SELECT 
  n.County_of_Residence,
  n.avg_prenatal_wks_2018
FROM wi_natality_2018 AS n
JOIN wi_commute        AS c
ON SUBSTR(n.County_of_Residence, 1, 3) = c.zip3
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – Return the average number of prenatal weeks in
--calendar-year 2018 for those Wisconsin counties whose employed residents had
--> 5 % 45–59-minute commutes in 2017.
WITH wi_commute AS (
  --Build ZCTA-to-ZIP-3 commute percentages for Wisconsin, keep those > 5 %
  SELECT
    SUBSTR(geo_id, 1, 3)                AS zip3,
    SAFE_DIVIDE(SUM(commute_45_59_mins),
                SUM(employed_pop)) * 100 AS pct_commute_45_59
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(SUBSTR(geo_id, 1, 2) AS INT64) IN (53, 54)   -- Wisconsin ZIP prefixes
  GROUP BY zip3
  HAVING pct_commute_45_59 > 5
),
wi_natality_2018 AS (
  --Compute the 2018 average prenatal weeks for every Wisconsin county
  SELECT
    County_of_Residence,
    AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018,
    SUBSTR(REGEXP_REPLACE(County_of_Residence, r'[^0-9]', ''), 1, 3) AS zip3_hint
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
    AND LOWER(County_of_Residence) LIKE '%, wi'
  GROUP BY County_of_Residence, zip3_hint
)
SELECT
  n.County_of_Residence,
  n.avg_prenatal_wks_2018
FROM wi_natality_2018 AS n
JOIN wi_commute        AS c
ON n.zip3_hint = c.zip3
ORDER BY n.County_of_Residence
LIMIT 20;
```
