```sql
/*  Average number of prenatal-care weeks (2018) for Wisconsin counties
    in which more than 5 % of 2017 workers had 45- to 59-minute commutes  */

WITH zcta_commute AS (          -- 1.  2017 commute data (ZIP-5)
  SELECT
    CAST(geo_id AS STRING)          AS zip5,
    commute_45_59_mins              AS commuters_45_59,
    employed_pop
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE SUBSTR(geo_id, 1, 2) IN ('53','54')          -- Wisconsin ZIP prefixes
),

zip_geom AS (                   -- 2.  Add ZIP-code geometries
  SELECT
    z.zip5,
    z.commuters_45_59,
    z.employed_pop,
    zc.geometry                     AS zip_geom
  FROM zcta_commute                     AS z
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` AS zc
    ON z.zip5 = zc.zip_code
),

zip_with_county AS (            -- 3.  Spatially assign ZIPs to WI counties
  SELECT
    zg.zip5,
    zg.commuters_45_59,
    zg.employed_pop,
    c.name                          AS county_name
  FROM zip_geom                            AS zg
  JOIN `bigquery-public-data.geo_us_boundaries.counties` AS c
    ON c.state_name = 'Wisconsin'
   AND ST_WITHIN(ST_CENTROID(zg.zip_geom), c.geometry)
),

county_commute_share AS (       -- 4.  % of workers with 45-59-min commutes
  SELECT
    county_name,
    SAFE_DIVIDE(SUM(commuters_45_59), SUM(employed_pop)) * 100
      AS pct_commute_45_59
  FROM zip_with_county
  GROUP BY county_name
  HAVING pct_commute_45_59 > 5                -- keep counties > 5 %
),

prenatal_2018 AS (              -- 5.  2018 average prenatal weeks (WI)
  SELECT
    REGEXP_REPLACE(County_of_Residence, r' County, WI$', '') AS county_name,
    AVG(Ave_Number_of_Prenatal_Wks)                          AS avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
    AND LOWER(County_of_Residence) LIKE '%, wi'
  GROUP BY county_name
)

-- 6.  Final result: counties meeting both criteria
SELECT
  p.county_name || ' County, WI'   AS county,
  p.avg_prenatal_wks_2018
FROM prenatal_2018           AS p
JOIN county_commute_share    AS c
  ON LOWER(p.county_name) = LOWER(c.county_name)
ORDER BY p.avg_prenatal_wks_2018 DESC;
```
