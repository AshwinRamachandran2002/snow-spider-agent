```sql
/*  Average number of prenatal-care weeks (2018) for Wisconsin counties
    in which more than 5 % of 2017 workers had 45- to 59-minute
    commutes.                                                      */

WITH zcta_commute AS (         -- 1.  2017 commute data by ZIP-5
  SELECT
    CAST(geo_id AS STRING)                AS zip5,
    commute_45_59_mins                    AS commuters_45_59,
    employed_pop                          AS employed_pop
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  -- Wisconsin ZIP codes all begin with 53* or 54*
  WHERE SAFE_CAST(SUBSTR(geo_id, 1, 2) AS INT64) IN (53, 54)
),

zip_to_county AS (            -- 2.  Attach county names to ZIPs
  SELECT
    z.zip5,
    z.commuters_45_59,
    z.employed_pop,
    b.county_name
  FROM zcta_commute AS z
  JOIN `bigquery-public-data.geo_us_boundaries.zip_codes` AS b
    ON z.zip5 = b.zip_code
  WHERE b.state_name = 'Wisconsin'
),

county_commute_share AS (     -- 3.  Commute share per county
  SELECT
    county_name,
    SUM(commuters_45_59)                        AS commuters_45_59,
    SUM(employed_pop)                           AS employed_pop,
    SAFE_DIVIDE(SUM(commuters_45_59),
                SUM(employed_pop)) * 100        AS pct_commute_45_59
  FROM zip_to_county
  GROUP BY county_name
  HAVING pct_commute_45_59 > 5                  -- only counties > 5 %
),

prenatal_2018 AS (            -- 4.  2018 prenatal weeks by county
  SELECT
    County_of_Residence,
    AVG(Ave_Number_of_Prenatal_Wks) AS avg_prenatal_wks_2018
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
    AND LOWER(County_of_Residence) LIKE '%, wi'  -- Wisconsin only
  GROUP BY County_of_Residence
)

-- 5.  Final list: Wisconsin counties satisfying both criteria
SELECT
  p.County_of_Residence                                  AS county,
  p.avg_prenatal_wks_2018
FROM prenatal_2018 AS p
JOIN county_commute_share AS c
  ON LOWER(p.County_of_Residence) LIKE CONCAT(LOWER(c.county_name), '%')
ORDER BY p.avg_prenatal_wks_2018 DESC;
```
