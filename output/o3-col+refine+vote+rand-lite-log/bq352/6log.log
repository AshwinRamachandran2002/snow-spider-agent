  geo_id,
  SAFE_DIVIDE(commute_45_59_mins, employed_pop) * 100 AS pct_commute_45_59
FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
WHERE CAST(SUBSTR(geo_id, 1, 2) AS INT64) IN (53, 54)
  AND SAFE_DIVIDE(commute_45_59_mins, employed_pop) * 100 > 5
ORDER BY pct_commute_45_59 DESC
LIMIT 20;
```

```sql
--Description: 6) Aggregate the ZCTA–level commute information up to ZIP-3 (first
--three digits) to obtain a broader geography we can later approximate to counties.
WITH wi_zcta AS (
  SELECT
    SUBSTR(geo_id, 1, 3) AS zip3,
    SUM(commute_45_59_mins)   AS commuters_45_59,
    SUM(employed_pop)         AS employed
  FROM `bigquery-public-data.census_bureau_acs.zcta5_2017_5yr`
  WHERE CAST(SUBSTR(geo_id, 1, 2) AS INT64) IN (53, 54)
  GROUP BY zip3
)
SELECT
  zip3,
  SAFE_DIVIDE(commuters_45_59, employed) * 100 AS pct_commute_45_59
FROM wi_zcta
ORDER BY pct_commute_45_59 DESC
LIMIT 20;
```

