/* --------------------------------------------------------------
   Relationship between county-level poverty (from prior-year ACS)
   and the percentage of births with NO maternal morbidity,
   for natality years 2016-2018.
-----------------------------------------------------------------*/
WITH
-- 1.  Natality data (keep only 2016-2018 records)
natality AS (
  SELECT
    EXTRACT(YEAR FROM Year)              AS birth_year,
    County_of_Residence_FIPS             AS county_fips,
    Maternal_Morbidity_YN,
    Births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
),

-- 2.  County-year % of births that had NO maternal morbidity
pct_no_morb AS (
  SELECT
    birth_year,
    county_fips,
    SAFE_DIVIDE(
      SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births END),
      SUM(Births)
    )                                        AS pct_no_morbidity
  FROM natality
  GROUP BY birth_year, county_fips
),

-- 3.  Pull the PRIOR-YEAR 5-yr ACS poverty data
poverty_prior_year AS (
  SELECT
    CAST(_TABLE_SUFFIX AS INT64)            AS acs_year,          -- 2015, 2016, 2017
    geo_id                                   AS county_fips,
    SAFE_DIVIDE(poverty,total_pop)           AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_*_5yr`
  WHERE _TABLE_SUFFIX IN ('2015','2016','2017')
),

-- 4.  Align ACS year to the *next* natality year
poverty_aligned AS (
  SELECT
    acs_year + 1                             AS birth_year,       -- 2015 ACS → 2016 births, etc.
    county_fips,
    poverty_rate
  FROM poverty_prior_year
)

-- 5.  Compute Pearson correlation for each natality year
SELECT
  birth_year,
  CORR(poverty_rate, pct_no_morbidity)       AS pearson_corr
FROM pct_no_morb
JOIN poverty_aligned USING (birth_year, county_fips)
GROUP BY birth_year
ORDER BY birth_year;
