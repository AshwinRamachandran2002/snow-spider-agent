Query:
--Description: Build county-level percentages of “no maternal morbidity” for 2016
--births and join to the poverty rate from the 2012-2016 ACS (county_2016_5yr).
SELECT
  n.County_of_Residence_FIPS                       AS county_fips,
  SUM(CASE WHEN n.Maternal_Morbidity_YN = 0 THEN n.Births END) AS births_no_morb,
  SUM(n.Births)                                    AS births_total,
  SAFE_DIVIDE(SUM(CASE WHEN n.Maternal_Morbidity_YN = 0 THEN n.Births END),
              SUM(n.Births))                       AS pct_no_morbidity,
  SAFE_DIVIDE(c16.poverty,c16.total_pop)           AS poverty_rate
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` n
JOIN `bigquery-public-data.census_bureau_acs.county_2016_5yr`           c16
  ON n.County_of_Residence_FIPS = c16.geo_id
WHERE EXTRACT(YEAR FROM n.Year) = 2016
GROUP BY county_fips, poverty_rate
LIMIT 20
