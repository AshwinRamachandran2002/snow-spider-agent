```sql
--Description:  Build county-level percentages of “no maternal morbidity” 
--for 2016 births and join to 2015 poverty rates so we can later correlate.
SELECT n.County_FIPS                       AS county_fips,
       SUM(CASE WHEN n.Maternal_Morbidity_YN = 0 THEN n.Births END) AS births_no_morb,
       SUM(n.Births)                         AS births_total,
       SAFE_DIVIDE(SUM(CASE WHEN n.Maternal_Morbidity_YN = 0 THEN n.Births END),
                   SUM(n.Births))            AS pct_no_morbidity,
       c15.poverty_rate
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` n
JOIN `bigquery-public-data.census_bureau_acs.county_2015_5yr`                c15
  ON n.County_FIPS = c15.geo_id
WHERE EXTRACT(YEAR FROM n.Year) = 2016
GROUP BY county_fips, poverty_rate
LIMIT 20;
```

```sql
--Description:  Compute the Pearson correlation coefficient for 2016 
--between poverty rate (2015 ACS) and % births with no maternal morbidity.
SELECT
  CORR(poverty_rate, pct_no_morbidity) AS corr_2016
FROM (
  SELECT n.County_FIPS AS county_fips,
         SAFE_DIVIDE(SUM(CASE WHEN n.Maternal_Morbidity_YN = 0 THEN n.Births END),
                     SUM(n.Births))                    AS pct_no_morbidity,
         c15.poverty / NULLIF(c15.total_pop,0)        AS poverty_rate
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` n
  JOIN `bigquery-public-data.census_bureau_acs.county_2015_5yr`            c15
    ON n.County_FIPS = c15.geo_id
  WHERE EXTRACT(YEAR FROM n.Year) = 2016
  GROUP BY county_fips, poverty_rate
);
```

```sql
--Description:  Repeat the same calculation for 2017 and 2018 in one shot, 
--pairing each natality year with the prior-year 5-year ACS file, and show
--all three correlation coefficients side-by-side.
WITH
  base AS (
    SELECT
      EXTRACT(YEAR FROM Year)            AS birth_year,
      County_FIPS                        AS county_fips,
      Maternal_Morbidity_YN,
      Births
    FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
    WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  ),
  pct AS (
    SELECT
      birth_year,
      county_fips,
      SAFE_DIVIDE(SUM(IF(Maternal_Morbidity_YN = 0, Births, 0)),
                  SUM(Births)) AS pct_no_morbidity
    FROM base
    GROUP BY birth_year, county_fips
  ),
  poverty AS (
    -- Stack the three poverty tables and tag each with the natality year
    SELECT '2016' AS birth_year, geo_id AS county_fips,
           poverty / NULLIF(total_pop,0) AS poverty_rate
    FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
    UNION ALL
    SELECT '2017', geo_id, poverty / NULLIF(total_pop,0)
    FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
    UNION ALL
    SELECT '2018', geo_id, poverty / NULLIF(total_pop,0)
    FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
  )
SELECT
  birth_year,
  CORR(poverty_rate, pct_no_morbidity) AS pearson_corr
FROM pct
JOIN poverty USING (birth_year, county_fips)
GROUP BY birth_year
ORDER BY birth_year;
```

```sql
--Description:  (Optional deeper dive)  Return the full county-level table that fed the
--correlations so analysts can spot outliers or create visualisations.
SELECT *
FROM (
  WITH
    base AS (
      SELECT
        EXTRACT(YEAR FROM Year) AS birth_year,
        County_FIPS            AS county_fips,
        Maternal_Morbidity_YN,
        Births
      FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
      WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
    ),
    pct AS (
      SELECT
        birth_year,
        county_fips,
        SAFE_DIVIDE(SUM(IF(Maternal_Morbidity_YN = 0, Births, 0)),
                    SUM(Births)) AS pct_no_morbidity
      FROM base
      GROUP BY birth_year, county_fips
    ),
    poverty AS (
      SELECT '2016' AS birth_year, geo_id AS county_fips,
             poverty / NULLIF(total_pop,0) AS poverty_rate
      FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
      UNION ALL
      SELECT '2017', geo_id, poverty / NULLIF(total_pop,0)
      FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
      UNION ALL
      SELECT '2018', geo_id, poverty / NULLIF(total_pop,0)
      FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
    )
  SELECT birth_year, county_fips, poverty_rate, pct_no_morbidity
  FROM pct
  JOIN poverty USING (birth_year, county_fips)
)
LIMIT 20;
```
