```sql
--Description:  Build county–level percentages of births with NO maternal morbidity (Maternal_Morbidity_YN = 1) for
--              2016-2018, join each birth year to the *prior-year* 5-year ACS poverty file, and return the
--              Pearson correlation between poverty rate and “no-morbidity birth” percentage for every year.
WITH births AS (
  SELECT
    EXTRACT(YEAR FROM Year)                     AS yr,
    CAST(County_of_Residence_FIPS AS INT64)     AS county_fips,
    SUM(Births)                                 AS total_births,
    SUM(CASE WHEN Maternal_Morbidity_YN = 1     -- “None checked”  →  no morbidity
             THEN Births END)                  AS no_mm_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  GROUP BY yr, county_fips
),
births_pct AS (
  SELECT
    yr,
    county_fips,
    SAFE_DIVIDE(no_mm_births, total_births) AS no_mm_pct
  FROM births
),
poverty AS (
  -- use the 5-year ACS file whose “label year” is one year BEFORE the birth year
  SELECT '2016' AS yr,
         CAST(geo_id AS INT64)                     AS county_fips,
         SAFE_DIVIDE(poverty, total_pop)           AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
  UNION ALL
  SELECT '2017',
         CAST(geo_id AS INT64),
         SAFE_DIVIDE(poverty, total_pop)
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  UNION ALL
  SELECT '2018',
         CAST(geo_id AS INT64),
         SAFE_DIVIDE(poverty, total_pop)
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT
  yr,
  CORR(no_mm_pct, poverty_rate) AS pearson_corr
FROM births_pct
JOIN poverty
USING (yr, county_fips)
GROUP BY yr
ORDER BY yr
LIMIT 20;
```
