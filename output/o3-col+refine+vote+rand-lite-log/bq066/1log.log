--Description: 8)  Pearson correlation for 2016 births vs. 2016 5-yr ACS poverty (correct fields & types)
SELECT
  CORR(no_mm_pct, poverty_rate) AS corr_2016
FROM (
  SELECT
    CAST(County_of_Residence_FIPS AS INT64)            AS county_fips,
    SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
                SUM(Births))                           AS no_mm_pct
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM `Year`) = 2016
  GROUP BY county_fips
) m
JOIN (
  SELECT
    CAST(geo_id AS INT64)                              AS county_fips,
