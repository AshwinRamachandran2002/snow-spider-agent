WHERE poverty IS NOT NULL
LIMIT 20;
```

```sql
--6---------------------------------------------------------------
--Description:  join 2016 birth percentages to 2015 poverty rates so we
--can inspect the paired values we’ll feed into CORR().
WITH pov AS (
  SELECT
    geo_id,
    SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  WHERE poverty IS NOT NULL AND total_pop IS NOT NULL
),
births AS (
  SELECT
    CONCAT(state_fips, county_fips) AS geo_id,
    SAFE_DIVIDE(SUM(IF(Maternal_Morbidity_YN = 0, Births, 0)), SUM(Births))
      AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM `Year`) = 2016
  GROUP BY geo_id
)
SELECT
  b.geo_id,
  b.pct_no_morbidity,
  p.poverty_rate
FROM births b
JOIN pov p
  USING (geo_id)
LIMIT 20;
```

