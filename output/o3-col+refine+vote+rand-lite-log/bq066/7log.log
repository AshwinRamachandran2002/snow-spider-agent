```sql
--2---------------------------------------------------------------
--Description:  births WITHOUT maternal morbidity (Maternal_Morbidity_YN = 0)
--for 2016 by county.  This gives us the numerator we will later divide
--by total births to get a percentage.
SELECT
  state_fips,
  county_fips,
  SUM(Births) AS births_no_morbidity_2016
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM `Year`) = 2016
  AND Maternal_Morbidity_YN = 0
GROUP BY state_fips, county_fips
LIMIT 20;
```

```sql
--3---------------------------------------------------------------
--Description:  total births in 2016 by county (denominator).
SELECT
  state_fips,
  county_fips,
  SUM(Births) AS total_births_2016
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM `Year`) = 2016
GROUP BY state_fips, county_fips
LIMIT 20;
```

```sql
--4---------------------------------------------------------------
--Description:  compute the 2016 percentage of births without maternal
--morbidity by county.
WITH total AS (
  SELECT state_fips, county_fips, SUM(Births) AS tot
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM `Year`) = 2016
  GROUP BY state_fips, county_fips
),
no_morb AS (
  SELECT state_fips, county_fips, SUM(Births) AS nomorb
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM `Year`) = 2016
    AND Maternal_Morbidity_YN = 0
  GROUP BY state_fips, county_fips
)
SELECT
  t.state_fips,
  t.county_fips,
  SAFE_DIVIDE(n.nomorb, t.tot) AS pct_no_morbidity_2016
FROM total t
JOIN no_morb n
  USING (state_fips, county_fips)
LIMIT 20;
```

```sql
--5---------------------------------------------------------------
--Description:  preview poverty counts & population from the 2016 ACS
--5-year county file (covers 2011-2015, i.e., the “previous year” for
--2016 natality).
SELECT
  geo_id,
  poverty,
  total_pop,
  SAFE_DIVIDE(poverty, total_pop) AS poverty_rate_2015
