```sql
--Description:  (4) Compute the 2016 percentage of births with NO maternal
--morbidity for each county, using ‘None checked’ as the indicator.
WITH total AS (
  SELECT `County_of_Residence_FIPS` AS county_fips,
         SUM(`Births`)              AS tot
  FROM   `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE  EXTRACT(YEAR FROM `Year`) = 2016
  GROUP  BY `County_of_Residence_FIPS`
),
no_morb AS (
  SELECT `County_of_Residence_FIPS` AS county_fips,
         SUM(`Births`)              AS nomorb
  FROM   `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE  EXTRACT(YEAR FROM `Year`) = 2016
     AND `Maternal_Morbidity_Desc`  = 'None checked'
  GROUP  BY `County_of_Residence_FIPS`
)
SELECT
  t.county_fips,
  SAFE_DIVIDE(n.nomorb, t.tot) AS pct_no_morbidity_2016
FROM total t
JOIN no_morb n USING (county_fips)
LIMIT 20;
