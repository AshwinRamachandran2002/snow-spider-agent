```sql
--Description:
-- Goal: calculate the Pearson correlation between (a) 2015‒vintage poverty
-- rate from the ACS 2016 5-year file and (b) the 2016 county-level
-- percentage of births that had NO maternal morbidity.
-- Reasoning inside the query:
--  1. In the natality table, filter Year = 2016 and compute, per county
--     FIPS, the share of births whose Maternal_Morbidity_Desc = 'None checked'.
--  2. In the ACS `county_2016_5yr` table, compute poverty_rate as
--     poverty / total_pop (those counts cover 2011-2015, i.e., data
--     “from the year before” the 2016 natality year).
--  3. Join the two subqueries on the identical 5-digit county FIPS code
--     (`geo_id` vs County_of_Residence_FIPS).
--  4. Feed the paired variables into BigQuery’s CORR() to obtain the
--     Pearson correlation coefficient.
WITH births AS (
  SELECT
    CAST(`County_of_Residence_FIPS` AS STRING) AS geo_id,
    SAFE_DIVIDE(
      SUM(CASE WHEN `Maternal_Morbidity_Desc` = 'None checked' THEN `Births` END),
      SUM(`Births`)
    ) AS pct_no_morbidity_2016
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM `Year`) = 2016
  GROUP BY geo_id
),
poverty AS (
  SELECT
    CAST(`geo_id` AS STRING)                       AS geo_id,
    SAFE_DIVIDE(`poverty`, `total_pop`)            AS poverty_rate_2015
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  WHERE `poverty` IS NOT NULL AND `total_pop` IS NOT NULL
)
SELECT
  CORR(poverty_rate_2015, pct_no_morbidity_2016) AS corr_2016
FROM births
JOIN poverty USING (geo_id);
```
