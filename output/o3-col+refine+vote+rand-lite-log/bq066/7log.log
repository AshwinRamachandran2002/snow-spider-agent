--Description:  (3) Total births in 2016 by county (denominator) using the
--single 5-digit county FIPS column present in the natality file.
SELECT
  `County_of_Residence_FIPS` AS county_fips,
  SUM(`Births`)              AS total_births_2016
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM `Year`) = 2016
GROUP BY `County_of_Residence_FIPS`
LIMIT 20
