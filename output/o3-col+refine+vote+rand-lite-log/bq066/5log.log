FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Maternal_Morbidity_YN = 0
LIMIT 20;
```

```sql
--Description: 5) Preview the 5-year ACS county file (2016 release) to confirm poverty & population fields.  
SELECT geo_id,
       poverty,
       total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
LIMIT 20;
```

```sql
--Description: 6) Preview the next 5-year ACS county file (2018 release) that will be paired to 2018 births.  
SELECT geo_id,
       poverty,
       total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
LIMIT 20;
```

```sql
--Description: 7) Aggregate 2016-2018 births with NO maternal morbidity to the county level.  
SELECT
  EXTRACT(YEAR FROM Year)                                  AS birth_year,
  County_FIPS                                              AS geo_id,
  SUM(Births)                                              AS births_no_morbidity
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Maternal_Morbidity_YN = 0
  AND EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
GROUP BY birth_year, geo_id
LIMIT 20;
```

```sql
--Description: 8) Build poverty-rate lookup tables for the “previous‐year” 5-year ACS releases.  
WITH poverty AS (
  SELECT 2016 AS census_year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`  -- if unavailable, fall back to _2016_5yr

  UNION ALL
  SELECT 2017 AS census_year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`

  UNION ALL
  SELECT 2018 AS census_year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`  -- if unavailable, fall back to _2018_5yr
)
SELECT * FROM poverty
LIMIT 20;
```

```sql
--Description: 9) Join poverty with natality counts and produce the Pearson correlation coefficient for each year.  
WITH natality AS (
  SELECT
    EXTRACT(YEAR FROM Year)         AS year,
    County_FIPS                     AS geo_id,
    SUM(Births)                     AS births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE Maternal_Morbidity_YN = 0
    AND EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  GROUP BY year, geo_id
),
poverty AS (
  SELECT 2016 AS year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`

  UNION ALL
  SELECT 2017 AS year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`

  UNION ALL
  SELECT 2018 AS year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
joined AS (
  SELECT n.year,
         n.geo_id,
         n.births_no_morbidity,
         p.poverty_rate
  FROM natality n
  JOIN poverty p
    ON n.year   = p.year
   AND n.geo_id = p.geo_id
)
SELECT
  year,
  CORR(poverty_rate, births_no_morbidity) AS pearson_correlation
FROM joined
GROUP BY year
ORDER BY year;
```

```sql
--Description: 10) (Optional validation) Show the paired poverty-rate & no-morbidity birth counts used in the correlation for a single sample year (e.g., 2018).  
WITH natality AS (
  SELECT
    County_FIPS AS geo_id,
    SUM(Births) AS births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE Maternal_Morbidity_YN = 0
    AND EXTRACT(YEAR FROM Year) = 2018
  GROUP BY geo_id
),
poverty AS (
  SELECT geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
)
SELECT n.geo_id,
       n.births_no_morbidity,
       p.poverty_rate
FROM natality n
JOIN poverty p
  ON n.geo_id = p.geo_id
LIMIT 20;
```
