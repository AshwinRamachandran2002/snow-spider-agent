Query:
--Description: 9) Join poverty with natality counts and compute the Pearson correlation coefficient for each year.
WITH natality AS (
  SELECT
    EXTRACT(YEAR FROM Year)     AS year,
    County_of_Residence_FIPS    AS geo_id,
    SUM(Births)                 AS births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE Maternal_Morbidity_YN = 0
    AND EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  GROUP BY year, geo_id
),
poverty AS (
  SELECT 2016 AS year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`

  UNION ALL
  SELECT 2017 AS year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`

  UNION ALL
  SELECT 2018 AS year, geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
),
joined AS (
  SELECT
    n.year,
    n.geo_id,
    n.births_no_morbidity,
    p.poverty_rate
  FROM natality n
  JOIN poverty p
    ON n.year   = p.year
   AND n.geo_id = p.geo_id
)
SELECT
  year,
  CORR(poverty_rate, births_no_morbidity) AS pearson_correlation
FROM joined
GROUP BY year
ORDER BY year
