Query:
--Description (thinking process):
--We simply want a side-by-side look at county-level poverty_rate (from the
--2017 ACS 5-year file) and the 2018 pct_no_morbidity for births.  Each metric
--is first aggregated to the county level, then joined on FIPS (`geo_id`);
--no nested aggregations occur, so this avoids earlier errors.

WITH births_2018 AS (
  SELECT
    County_of_Residence_FIPS AS geo_id,
    SAFE_DIVIDE(
      SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
      SUM(Births)
    ) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
  GROUP BY County_of_Residence_FIPS
),
poverty_2017 AS (
  SELECT
    geo_id,
    SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
)
SELECT
  p.geo_id,
  p.poverty_rate,
  b.pct_no_morbidity
FROM poverty_2017 p
JOIN births_2018 b USING (geo_id)
LIMIT 20
