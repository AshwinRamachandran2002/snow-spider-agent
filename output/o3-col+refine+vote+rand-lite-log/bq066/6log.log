Query:
--Description:  Preview 2015 ACS county-level poverty counts & total population
--and compute poverty rate to validate the data before correlations.
SELECT
  geo_id,
  poverty,
  total_pop,
  SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20
