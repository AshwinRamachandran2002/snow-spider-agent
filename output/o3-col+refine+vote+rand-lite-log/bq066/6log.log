```sql
--Description (thinking process):
--To measure the relationship we will ultimately need: 
--  1) total births per county, and 
--  2) births with *no* maternal morbidity (code 1 = “None checked”).  
--This query prepares those two figures for 2016 so that we can later
--compute the percentage and join with the 2015 ACS poverty data.
--It groups by the county FIPS column (`County_of_Residence_FIPS`, aliased
--to `geo_id`) and returns a small sample for validation.
SELECT
  County_of_Residence_FIPS AS geo_id,
  SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END) AS births_no_morbidity,
  SUM(Births)                                              AS births_total,
  SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
              SUM(Births))                                 AS pct_no_morbidity
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2016
GROUP BY geo_id
LIMIT 20;
```
