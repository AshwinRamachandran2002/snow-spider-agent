Query:
--Description:  Pearson correlation between 2015 county poverty rate and
--percentage of 2016 births with NO maternal morbidity.
WITH births_2016 AS (
  SELECT
    County_of_Residence_FIPS AS geo_id,
    SAFE_DIVIDE(
      SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
      SUM(Births)
    ) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY County_of_Residence_FIPS
),
poverty_2015 AS (
  SELECT
    geo_id,
    SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
)
SELECT CORR(poverty_rate, pct_no_morbidity) AS corr_2016
FROM poverty_2015 p
JOIN births_2016 b USING (geo_id)
LIMIT 20
