```sql
--Description: Check which numeric codes are used for “Maternal_Morbidity_YN”.
--We expect one code to mean “YES” (complication) and another to mean “NO”.
SELECT DISTINCT Maternal_Morbidity_YN
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
LIMIT 20;
```

```sql
--Description: Display a few rows where no maternal morbidity was reported
--(i.e. Maternal_Morbidity_YN = 2).  Confirms that births are reported at the county level
--and shows the county-FIPS column that will be used for joining.
SELECT Year,
       county_fips_code AS geo_id,
       Maternal_Morbidity_YN,
       Births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE Maternal_Morbidity_YN = 2
  AND EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
LIMIT 20;
```

```sql
--Description:  For 2016 births, calculate the percentage of deliveries
--that had NO maternal morbidity for every county.
WITH births_2016 AS (
  SELECT county_fips_code AS geo_id,
         SUM(CASE WHEN Maternal_Morbidity_YN = 2 THEN Births ELSE 0 END)   AS births_no_morbidity,
         SUM(Births)                                                      AS births_total
  FROM   `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE  EXTRACT(YEAR FROM Year) = 2016
  GROUP  BY county_fips_code
)
SELECT geo_id,
       births_no_morbidity,
       births_total,
       SAFE_DIVIDE(births_no_morbidity, births_total) AS pct_no_morbidity
FROM   births_2016
LIMIT 20;
```

```sql
--Description:  Preview poverty counts and total population from the
--previous-year (2015) 5-year ACS file at the county level; also compute the poverty rate.
SELECT geo_id,
       poverty,
       total_pop,
       SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
FROM   `bigquery-public-data.census_bureau_acs.county_2015_5yr`
LIMIT 20;
```

```sql
--Description:  Compute the Pearson correlation between county poverty rate
--(2015 ACS) and the percentage of 2016 births without maternal morbidity.
WITH births_2016 AS (
  SELECT county_fips_code AS geo_id,
         SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 2 THEN Births END),
                     SUM(Births))                                   AS pct_no_morbidity
  FROM   `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE  EXTRACT(YEAR FROM Year) = 2016
  GROUP  BY county_fips_code
),
poverty_2015 AS (
  SELECT geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM   `bigquery-public-data.census_bureau_acs.county_2015_5yr`
)
SELECT CORR(poverty_rate, pct_no_morbidity) AS corr_2016
FROM   poverty_2015  p
JOIN   births_2016  b USING (geo_id)
LIMIT 20;
```

