```sql
--Description (thinking process):
--Goal: return one tidy table (three rows) summarising the Pearson correlation
--between county-level poverty rates from the PRIOR-year 5-year ACS files and the
--percentage of births with NO maternal morbidity (Maternal_Morbidity_YN = 1)
--for each study year 2016-2018.
--
--Steps:
-- 1. For each natality year (2016-2018) aggregate births to county level and
--    compute pct_no_morbidity.
-- 2. For each corresponding PRIOR year (2015-2017) compute county poverty_rate
--    from the ACS 5-year table.
-- 3. Join the two already-aggregated tables on county FIPS (geo_id).
-- 4. Run CORR on the joined numeric columns; output one row per year.
--
--Doing the aggregation first avoids “aggregation of aggregations” errors.

WITH
/* ---------- 2016 births + 2015 poverty ---------- */
births16 AS (
  SELECT County_of_Residence_FIPS AS geo_id,
         SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
                     SUM(Births)) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY County_of_Residence_FIPS
),
poverty15 AS (
  SELECT geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2015_5yr`
),
joined16 AS (
  SELECT p.poverty_rate, b.pct_no_morbidity
  FROM poverty15 p
  JOIN births16  b USING (geo_id)
),

/* ---------- 2017 births + 2016 poverty ---------- */
births17 AS (
  SELECT County_of_Residence_FIPS AS geo_id,
         SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
                     SUM(Births)) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2017
  GROUP BY County_of_Residence_FIPS
),
poverty16 AS (
  SELECT geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
),
joined17 AS (
  SELECT p.poverty_rate, b.pct_no_morbidity
  FROM poverty16 p
  JOIN births17  b USING (geo_id)
),

/* ---------- 2018 births + 2017 poverty ---------- */
births18 AS (
  SELECT County_of_Residence_FIPS AS geo_id,
         SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END),
                     SUM(Births)) AS pct_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2018
  GROUP BY County_of_Residence_FIPS
),
poverty17 AS (
  SELECT geo_id,
         SAFE_DIVIDE(poverty, total_pop) AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`
),
joined18 AS (
  SELECT p.poverty_rate, b.pct_no_morbidity
  FROM poverty17 p
  JOIN births18  b USING (geo_id)
)

/* ---------- Final union of correlation coefficients ---------- */
SELECT '2016' AS year, CORR(poverty_rate, pct_no_morbidity) AS pearson_corr
FROM joined16
UNION ALL
SELECT '2017', CORR(poverty_rate, pct_no_morbidity)
FROM joined17
UNION ALL
SELECT '2018', CORR(poverty_rate, pct_no_morbidity)
FROM joined18;
```
