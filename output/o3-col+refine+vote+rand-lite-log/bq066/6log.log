),
corr_17 AS (
  SELECT '2017' AS yr,
         CORR(SAFE_DIVIDE(poverty, total_pop),
              SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 2 THEN Births END),
                           SUM(Births))) AS r
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`  c
  JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` n
    ON c.geo_id = n.county_fips_code
  WHERE EXTRACT(YEAR FROM n.Year) = 2017
),
corr_18 AS (
  SELECT '2018' AS yr,
         CORR(SAFE_DIVIDE(poverty, total_pop),
              SAFE_DIVIDE(SUM(CASE WHEN Maternal_Morbidity_YN = 2 THEN Births END),
                           SUM(Births))) AS r
  FROM `bigquery-public-data.census_bureau_acs.county_2017_5yr`  c
  JOIN `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity` n
    ON c.geo_id = n.county_fips_code
  WHERE EXTRACT(YEAR FROM n.Year) = 2018
)
SELECT *
FROM corr_16
UNION ALL
SELECT * FROM corr_17
UNION ALL
SELECT * FROM corr_18
LIMIT 20;
