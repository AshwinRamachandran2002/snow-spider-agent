Query:
--Description:  For 2016 births, calculate per-county percentage of deliveries
--with NO maternal morbidity (Maternal_Morbidity_YN = 1) using the county-FIPS
--column `County_of_Residence_FIPS`.
WITH births_2016 AS (
  SELECT
    County_of_Residence_FIPS AS geo_id,
    SUM(CASE WHEN Maternal_Morbidity_YN = 1 THEN Births END) AS births_no_morbidity,
    SUM(Births)                                              AS births_total
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY County_of_Residence_FIPS
)
SELECT
  geo_id,
  births_no_morbidity,
  births_total,
  SAFE_DIVIDE(births_no_morbidity, births_total) AS pct_no_morbidity
FROM births_2016
LIMIT 20
