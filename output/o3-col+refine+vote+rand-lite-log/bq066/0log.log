  (n.births_no_morbidity / n.total_births)            AS pct_no_morbidity,
  (c.poverty / c.total_pop)                           AS poverty_rate
FROM (
  SELECT
    County_of_Residence_FIPS                          AS county_fips,
    SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births END) AS births_no_morbidity,
    SUM(Births)                                               AS total_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY county_fips
) AS n
JOIN `bigquery-public-data.census_bureau_acs.county_2016_5yr` AS c
  ON c.geo_id = n.county_fips
LIMIT 20;
