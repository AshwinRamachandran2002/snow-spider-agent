```sql
/*  Pearson correlation between the county-level poverty rate
    (taken from the 5-year ACS file released the year BEFORE each
     birth cohort) and the share of births without maternal morbidity
     for cohorts 2016-2018.                                             */

WITH poverty AS (
  -- 5-year ACS poverty rate.  The table suffix holds the ACS release
  -- year; adding 1 gives the birth year whose analysis will use it.
  SELECT
    CAST(REGEXP_EXTRACT(_TABLE_SUFFIX , r'(\d{4})') AS INT64) + 1 AS birth_year,
    geo_id,
    poverty / NULLIF(total_pop,0)                    AS poverty_rate
  FROM `bigquery-public-data.census_bureau_acs.county_*_5yr`
  WHERE _TABLE_SUFFIX IN ('2015_5yr','2016_5yr','2017_5yr')   -- prev-year files for 2016-2018 births
    AND poverty     IS NOT NULL
    AND total_pop   IS NOT NULL
    AND total_pop  > 0
),
births AS (
  -- Aggregate births and isolate those with NO maternal morbidity
  SELECT
    EXTRACT(YEAR FROM Year)                          AS birth_year,
    County_of_Residence_FIPS                         AS geo_id,
    SUM(Births)                                      AS total_births,
    SUM(CASE WHEN Maternal_Morbidity_YN = 0 
             THEN Births END)                       AS births_no_morbidity
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  GROUP BY birth_year, geo_id
)

SELECT
  b.birth_year,
  -- Pearson correlation across counties for each cohort year
  CORR( b.births_no_morbidity / NULLIF(b.total_births,0),
        p.poverty_rate)                             AS pearson_r
FROM births  AS b
JOIN poverty AS p
  ON  p.birth_year = b.birth_year
  AND p.geo_id     = b.geo_id
WHERE b.total_births > 0
GROUP BY b.birth_year
ORDER BY b.birth_year;
```
