```sql
-- 3) Make sure we really have county FIPS-codes we can join on.
SELECT DISTINCT County_FIPS
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE County_FIPS IS NOT NULL
LIMIT 20;
```

```sql
-- 4) Aggregate birth counts by county for 2016 – separating births
--     with and without maternal morbidity so we can later build a share.
SELECT
  County_FIPS,
  SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births END)   AS births_no_morbidity,
  SUM(Births)                                                 AS total_births
FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
WHERE EXTRACT(YEAR FROM Year) = 2016
GROUP BY County_FIPS
LIMIT 20;
```

```sql
-- 5) Inspect 2016 5-year ACS county data (covers 2011-2015) – 
--     we need poverty counts and total population to compute a rate.
SELECT
  geo_id,
  poverty,
  total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
WHERE poverty IS NOT NULL
LIMIT 20;
```

```sql
-- 6) Inspect 2018 5-year ACS county data (covers 2013-2017) –
--     will be the “previous-year” poverty input for 2018 births.
SELECT
  geo_id,
  poverty,
  total_pop
FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
WHERE poverty IS NOT NULL
LIMIT 20;
```

```sql
-- 7) Build one working table (2016) that joins the natality statistics
--     with the poverty rate for each county.
SELECT
  n.County_FIPS                                       AS county_fips,
  (n.births_no_morbidity / n.total_births)            AS pct_no_morbidity,
  (c.poverty / c.total_pop)                           AS poverty_rate
FROM (
  SELECT
    County_FIPS,
    SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births END) AS births_no_morbidity,
    SUM(Births)                                               AS total_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) = 2016
  GROUP BY County_FIPS
) AS n
JOIN `bigquery-public-data.census_bureau_acs.county_2016_5yr` AS c
  ON c.geo_id = n.County_FIPS
LIMIT 20;
```

```sql
-- 8) Pearson correlation (county level) for births in 2016 vs poverty in 2015 ACS release.
SELECT
  CORR(poverty_rate , pct_no_morbidity) AS r_2016
FROM (
  SELECT
    n.County_FIPS,
    (n.births_no_morbidity / n.total_births)          AS pct_no_morbidity,
    (c.poverty / c.total_pop)                         AS poverty_rate
  FROM (
    SELECT
      County_FIPS,
      SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births END) AS births_no_morbidity,
      SUM(Births)                                               AS total_births
    FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
    WHERE EXTRACT(YEAR FROM Year) = 2016
    GROUP BY County_FIPS
  ) AS n
  JOIN `bigquery-public-data.census_bureau_acs.county_2016_5yr` AS c
    ON c.geo_id = n.County_FIPS
);
```

```sql
-- 9) Pearson correlation for 2017 births vs poverty from the 2016 5-year ACS file.
SELECT
  CORR(poverty_rate , pct_no_morbidity) AS r_2017
FROM (
  SELECT
    n.County_FIPS,
    (n.births_no_morbidity / n.total_births)          AS pct_no_morbidity,
    (c.poverty / c.total_pop)                         AS poverty_rate
  FROM (
    SELECT
      County_FIPS,
      SUM(CASE WHEN Maternal_Morbidity_YN = 0 THEN Births END) AS births_no_morbidity,
      SUM(Births)                                               AS total_births
    FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
    WHERE EXTRACT(YEAR FROM Year) = 2017
    GROUP BY County_FIPS
  ) AS n
  JOIN `bigquery-public-data.census_bureau_acs.county_2016_5yr` AS c
    ON c.geo_id = n.County_FIPS
);
```

```sql
-- 10) Final answer – correlations for 2016-2018, each using the 5-year ACS
--      file that was released the year before the births occurred.
WITH poverty_2016 AS (
  SELECT geo_id,
         (poverty / total_pop) AS pov_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2016_5yr`
  WHERE poverty IS NOT NULL AND total_pop > 0
),
poverty_2018 AS (
  SELECT geo_id,
         (poverty / total_pop) AS pov_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2018_5yr`
  WHERE poverty IS NOT NULL AND total_pop > 0
),
poverty_2019 AS (
  SELECT geo_id,
         (poverty / total_pop) AS pov_rate
  FROM `bigquery-public-data.census_bureau_acs.county_2019_5yr`
  WHERE poverty IS NOT NULL AND total_pop > 0
),
births AS (
  SELECT
    EXTRACT(YEAR FROM Year)                     AS yr,
    County_FIPS                                 AS fips,
    SUM(CASE WHEN Maternal_Morbidity_YN = 0
             THEN Births END)                  AS births_no_morbidity,
    SUM(Births)                                 AS total_births
  FROM `bigquery-public-data.sdoh_cdc_wonder_natality.county_natality_by_maternal_morbidity`
  WHERE EXTRACT(YEAR FROM Year) BETWEEN 2016 AND 2018
  GROUP BY yr, fips
)
SELECT
  yr,
  CORR(birth_share, pov_rate)                  AS pearson_r
FROM (
  SELECT
    b.yr,
    (b.births_no_morbidity / b.total_births)   AS birth_share,
    CASE
      WHEN b.yr = 2016 THEN p16.pov_rate
      WHEN b.yr = 2017 THEN p16.pov_rate  -- last ACS before 2017 births
      WHEN b.yr = 2018 THEN p18.pov_rate
    END                                         AS pov_rate
  FROM births AS b
  LEFT JOIN poverty_2016 p16 ON p16.geo_id = b.fips
  LEFT JOIN poverty_2018 p18 ON p18.geo_id = b.fips
  LEFT JOIN poverty_2019 p19 ON p19.geo_id = b.fips
)
GROUP BY yr
ORDER BY yr;
```
