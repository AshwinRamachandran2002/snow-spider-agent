```sql
-- 1. Inspect distinct customers appearing in payment records
SELECT DISTINCT "customer_id"
FROM "payment"
LIMIT 20;
```

```sql
-- 2. Look at some payments together with their dates and amounts
SELECT "payment_id", "customer_id", "amount", "payment_date"
FROM "payment"
ORDER BY "payment_date"
LIMIT 20;
```

```sql
-- 3. Trace a payment back to the rented film and its rating
SELECT p."payment_id",
       p."customer_id",
       p."payment_date",
       f."film_id",
       f."rating"
FROM   "payment"        AS p
JOIN   "rental"         AS r ON r."rental_id"   = p."rental_id"
JOIN   "inventory"      AS i ON i."inventory_id" = r."inventory_id"
JOIN   "film"           AS f ON f."film_id"      = i."film_id"
LIMIT 20;
```

```sql
-- 4. List all distinct film ratings that ever occur in rentals
SELECT DISTINCT f."rating"
FROM   "payment"  AS p
JOIN   "rental"   AS r ON r."rental_id"   = p."rental_id"
JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
JOIN   "film"     AS f ON f."film_id"      = i."film_id"
LIMIT 20;
```

```sql
-- 5. For every customer, find his/her first-ever payment and the rating of that film
SELECT first_pay."customer_id",
       f."rating",
       MIN(first_pay."payment_date") AS "first_payment_date"
FROM  (
        SELECT p."customer_id",
               p."payment_date",
               r."rental_id",
               i."film_id"
        FROM   "payment"  AS p
        JOIN   "rental"   AS r ON r."rental_id"   = p."rental_id"
        JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
      ) AS first_pay
JOIN "film" AS f ON f."film_id" = first_pay."film_id"
GROUP BY first_pay."customer_id"
LIMIT 20;
```

```sql
-- 6. Compute per-customer: total spent and total rentals
SELECT p."customer_id",
       SUM(p."amount")                     AS "total_spent",
       COUNT(DISTINCT p."rental_id")       AS "total_rentals"
FROM   "payment" AS p
GROUP  BY p."customer_id"
LIMIT 20;
```

```sql
-- 7. Combine “first-rating”, total spent, and total rentals for each customer
WITH first_movie AS (
        SELECT fp."customer_id",
               f."rating",
               MIN(fp."payment_date") AS "first_payment_date"
        FROM (
                SELECT p."customer_id",
                       p."payment_date",
                       i."film_id"
                FROM   "payment"  p
                JOIN   "rental"   r ON r."rental_id"   = p."rental_id"
                JOIN   "inventory" i ON i."inventory_id" = r."inventory_id"
        ) AS fp
        JOIN "film" f ON f."film_id" = fp."film_id"
        GROUP BY fp."customer_id"
),
customer_totals AS (
        SELECT p."customer_id",
               SUM(p."amount")               AS "total_spent",
               COUNT(DISTINCT p."rental_id") AS "total_rentals"
        FROM   "payment" p
        GROUP  BY p."customer_id"
)
SELECT fm."customer_id",
       fm."rating",
       ct."total_spent",
       (ct."total_rentals" - 1) AS "subsequent_rentals"
FROM   first_movie      AS fm
JOIN   customer_totals  AS ct USING ("customer_id")
LIMIT 20;
```

```sql
-- 8. Final answer: for every rating of the customers’ first movie,
--    give average total amount spent and average number of subsequent rentals
WITH first_movie AS (
        SELECT fp."customer_id",
               f."rating"
        FROM (
                SELECT p."customer_id",
                       p."payment_date",
                       i."film_id",
                       ROW_NUMBER() OVER (PARTITION BY p."customer_id"
                                          ORDER BY p."payment_date") AS rn
                FROM   "payment"  p
                JOIN   "rental"   r ON r."rental_id"   = p."rental_id"
                JOIN   "inventory" i ON i."inventory_id" = r."inventory_id"
        ) AS fp
        JOIN "film" f ON f."film_id" = fp."film_id"
        WHERE fp.rn = 1
),
customer_totals AS (
        SELECT p."customer_id",
               SUM(p."amount")               AS total_spent,
               COUNT(DISTINCT p."rental_id") AS total_rentals
        FROM   "payment" p
        GROUP  BY p."customer_id"
)
SELECT fm."rating"                                  AS "first_movie_rating",
       ROUND(AVG(ct."total_spent"), 2)              AS "avg_total_spent_per_customer",
       ROUND(AVG(ct."total_rentals" - 1), 2)        AS "avg_subsequent_rentals"
FROM   first_movie     fm
JOIN   customer_totals ct USING ("customer_id")
GROUP  BY fm."rating";
```
