```sql
--Description: 1) Quick look at some customer IDs that appear in the payment table  
SELECT DISTINCT "customer_id"
FROM "payment"
LIMIT 20;
```

```sql
--Description: 2) List the distinct film-rating values that exist in the catalogue  
SELECT DISTINCT "rating"
FROM "film"
LIMIT 20;
```

```sql
--Description: 3) See how a payment ties to the rented film (via rental → inventory → film) together with its rating  
SELECT DISTINCT p."payment_id",
                p."customer_id",
                p."payment_date",
                f."film_id",
                f."rating"
FROM "payment"  AS p
JOIN "rental"   AS r ON p."rental_id"  = r."rental_id"
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN "film"      AS f ON i."film_id"      = f."film_id"
LIMIT 20;
```

```sql
--Description: 4) For each customer, pull the earliest (first) payment date  
SELECT t."customer_id",
       MIN(t."payment_date") AS "first_payment_date"
FROM "payment" AS t
GROUP BY t."customer_id"
LIMIT 20;
```

```sql
--Description: 5) Attach the rating of the very first film rented by every customer  
WITH first_pay AS (
     SELECT p."customer_id",
            MIN(p."payment_date") AS "first_payment_date"
     FROM "payment" AS p
     GROUP BY p."customer_id"
)
SELECT DISTINCT fp."customer_id",
                fp."first_payment_date",
                f."rating"
FROM first_pay AS fp
JOIN "payment"  AS p ON p."customer_id" = fp."customer_id"
                    AND p."payment_date" = fp."first_payment_date"
JOIN "rental"   AS r ON p."rental_id"  = r."rental_id"
JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
JOIN "film"      AS f ON i."film_id"      = f."film_id"
LIMIT 20;
```

```sql
--Description: 6) Compute each customer’s total rental count and total money spent  
SELECT c."customer_id",
       COUNT(DISTINCT r."rental_id") AS "total_rentals",
       SUM(p."amount")               AS "total_amount"
FROM "customer" AS c
JOIN "rental"  AS r ON c."customer_id" = r."customer_id"
JOIN "payment" AS p ON r."rental_id"   = p."rental_id"
GROUP BY c."customer_id"
LIMIT 20;
```

```sql
--Description: 7) FINAL – For every rating of the first movie rented,
--                return  (a) average total amount each customer eventually spent
--                and (b) average number of subsequent rentals (total rentals – 1)  
WITH first_movie AS (
     SELECT p."customer_id",
            MIN(p."payment_date") AS "first_payment_date"
     FROM "payment" AS p
     GROUP BY p."customer_id"
),
first_rating AS (
     SELECT fp."customer_id",
            f."rating"
     FROM first_movie AS fp
     JOIN "payment"  AS p ON p."customer_id" = fp."customer_id"
                         AND p."payment_date" = fp."first_payment_date"
     JOIN "rental"   AS r ON p."rental_id"  = r."rental_id"
     JOIN "inventory" AS i ON r."inventory_id" = i."inventory_id"
     JOIN "film"      AS f ON i."film_id"      = f."film_id"
),
customer_stats AS (
     SELECT c."customer_id",
            COUNT(DISTINCT r."rental_id") AS "total_rentals",
            SUM(p."amount")               AS "total_amount"
     FROM "customer" AS c
     JOIN "rental"  AS r ON c."customer_id" = r."customer_id"
     JOIN "payment" AS p ON r."rental_id"   = p."rental_id"
     GROUP BY c."customer_id"
)
SELECT fr."rating",
       AVG(cs."total_amount")           AS "avg_total_spent_per_customer",
       AVG(cs."total_rentals" - 1)      AS "avg_subsequent_rentals"
FROM first_rating   AS fr
JOIN customer_stats AS cs ON fr."customer_id" = cs."customer_id"
GROUP BY fr."rating"
LIMIT 20;
```
