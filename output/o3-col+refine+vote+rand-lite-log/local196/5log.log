```sql
--Description: 1) Look at the different MPAA ratings that exist in the catalogue  
SELECT DISTINCT rating
FROM film
LIMIT 20;
```

```sql
--Description: 2) Quick glance at the first 20 payments that were made by customers  
SELECT payment_id,
       customer_id,
       amount,
       payment_date,
       rental_id
FROM payment
LIMIT 20;
```

```sql
--Description: 3) Trace a payment all the way to the film in order to see which rating was paid for  
SELECT DISTINCT p.payment_id,
       p.customer_id,
       f.film_id,
       f.rating
FROM payment   AS p
JOIN rental    AS r ON r.rental_id    = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id      = i.film_id
LIMIT 20;
```

```sql
--Description: 4) For every customer pick the very first payment they ever made (earliest payment_date)  
SELECT customer_id,
       payment_id,
       payment_date
FROM (
    SELECT p.*,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY payment_date) AS rn
    FROM payment AS p
) 
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 5) Add the film rating information to each customer’s first-ever payment  
SELECT fp.customer_id,
       f.rating,
       fp.payment_date
FROM (
    SELECT p.*,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY payment_date) AS rn
    FROM payment AS p
) AS fp
JOIN rental    AS r ON r.rental_id    = fp.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id      = i.film_id
WHERE fp.rn = 1
LIMIT 20;
```

```sql
--Description: 6) Compute how much each customer has spent in total and how many rentals they have made altogether  
SELECT customer_id,
       SUM(amount)                 AS total_spent,
       COUNT(DISTINCT rental_id)   AS total_rentals
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: 7) Combine the first-movie rating with every customer’s spending and rental counts  
WITH first_movie AS (
    SELECT fp.customer_id,
           f.rating
    FROM (
        SELECT p.*,
               ROW_NUMBER() OVER (PARTITION BY customer_id
                                  ORDER BY payment_date) AS rn
        FROM payment AS p
    ) AS fp
    JOIN rental    AS r ON r.rental_id    = fp.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id      = i.film_id
    WHERE fp.rn = 1
),
customer_stats AS (
    SELECT customer_id,
           SUM(amount)               AS total_spent,
           COUNT(DISTINCT rental_id) AS total_rentals
    FROM payment
    GROUP BY customer_id
)
SELECT fm.rating,
       cs.total_spent,
       (cs.total_rentals - 1) AS subsequent_rentals
FROM first_movie    AS fm
JOIN customer_stats AS cs USING (customer_id)
LIMIT 20;
```

```sql
--Description: 8) Same information as above but grouped by rating so that averages can be inspected  
WITH first_movie AS (
    SELECT fp.customer_id,
           f.rating
    FROM (
        SELECT p.*,
               ROW_NUMBER() OVER (PARTITION BY customer_id
                                  ORDER BY payment_date) AS rn
        FROM payment AS p
    ) AS fp
    JOIN rental    AS r ON r.rental_id    = fp.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id      = i.film_id
    WHERE fp.rn = 1
),
customer_stats AS (
    SELECT customer_id,
           SUM(amount)               AS total_spent,
           COUNT(DISTINCT rental_id) AS total_rentals
    FROM payment
    GROUP BY customer_id
),
combined AS (
    SELECT fm.rating,
           cs.total_spent,
           (cs.total_rentals - 1) AS subsequent_rentals
    FROM first_movie    AS fm
    JOIN customer_stats AS cs USING (customer_id)
)
SELECT rating,
       AVG(total_spent)       AS avg_total_amount_spent,
       AVG(subsequent_rentals) AS avg_subsequent_rentals
FROM combined
GROUP BY rating
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – exact requirements fulfilled without the LIMIT clause  
WITH first_payment AS (          -- first movie (earliest payment) per customer
    SELECT p.*,
           ROW_NUMBER() OVER (PARTITION BY customer_id
                              ORDER BY payment_date) AS rn
    FROM payment AS p
),
first_movie AS (
    SELECT fp.customer_id,
           f.rating
    FROM first_payment AS fp
    JOIN rental    AS r ON r.rental_id    = fp.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id      = i.film_id
    WHERE fp.rn = 1
),
customer_stats AS (              -- total money spent & rentals per customer
    SELECT customer_id,
           SUM(amount)               AS total_spent,
           COUNT(DISTINCT rental_id) AS total_rentals
    FROM payment
    GROUP BY customer_id
),
combined AS (
    SELECT fm.rating,
           cs.total_spent,
           (cs.total_rentals - 1) AS subsequent_rentals
    FROM first_movie    AS fm
    JOIN customer_stats AS cs USING (customer_id)
)
SELECT rating,
       AVG(total_spent)       AS avg_total_amount_spent,
       AVG(subsequent_rentals) AS avg_subsequent_rentals
FROM combined
GROUP BY rating
ORDER BY rating;
```
