Query:
-- 5) See how many customers have each rating as their very first rented movie
SELECT ffr."rating",
       COUNT(*) AS "num_customers"
FROM (
        SELECT p."customer_id", MIN(p."payment_date") AS first_pay_dt
        FROM   "payment" AS p
        GROUP  BY p."customer_id"
     ) AS firsts
JOIN "payment"   AS p  ON p."customer_id" = firsts."customer_id"
                     AND p."payment_date" = firsts.first_pay_dt
JOIN "rental"    AS r  ON r."rental_id"    = p."rental_id"
JOIN "inventory" AS i  ON i."inventory_id" = r."inventory_id"
JOIN "film"      AS ffr ON ffr."film_id"   = i."film_id"
GROUP BY ffr."rating"
LIMIT 20;
