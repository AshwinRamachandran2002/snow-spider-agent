Query:
-- 9) Finally, aggregate by first‐movie rating:
--    • average total money spent per customer
--    • average number of subsequent rentals (total rentals − 1)
SELECT fr."rating"                         AS "first_movie_rating",
       AVG(cts."total_spent")              AS "avg_total_spent_per_customer",
       AVG(ctr."total_rentals" - 1)        AS "avg_subsequent_rentals"
FROM  (
        -- first‐film rating per customer
        SELECT p."customer_id",
               f."rating"
        FROM (
                SELECT p.*,
                       ROW_NUMBER() OVER (PARTITION BY p."customer_id"
                                          ORDER BY p."payment_date") AS rn
                FROM   "payment" AS p
             ) AS p
        JOIN "rental"    AS r ON r."rental_id"    = p."rental_id"
        JOIN "inventory" AS i ON i."inventory_id" = r."inventory_id"
        JOIN "film"      AS f ON f."film_id"      = i."film_id"
        WHERE p.rn = 1
      ) AS fr
JOIN (
        -- total spent per customer
        SELECT "customer_id", SUM("amount") AS "total_spent"
        FROM   "payment"
        GROUP  BY "customer_id"
     ) AS cts ON cts."customer_id" = fr."customer_id"
JOIN (
        -- total rentals per customer
        SELECT "customer_id", COUNT(*) AS "total_rentals"
        FROM   "payment"
        GROUP  BY "customer_id"
     ) AS ctr ON ctr."customer_id" = fr."customer_id"
GROUP BY fr."rating"
LIMIT 20;
