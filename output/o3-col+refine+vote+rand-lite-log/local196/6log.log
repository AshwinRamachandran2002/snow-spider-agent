```sql
-- 1) Explore the possible rating values that exist in the catalogue of films
SELECT DISTINCT "rating"
FROM "film"
LIMIT 20;
```

```sql
-- 2) Look at some raw payment records per customer (amounts and timestamps)
SELECT "payment_id",
       "customer_id",
       "amount",
       "payment_date"
FROM   "payment"
ORDER BY "payment_date"
LIMIT 20;
```

```sql
-- 3) Check how a payment links all the way to a film and its rating
SELECT p."payment_id",
       p."customer_id",
       p."payment_date",
       f."film_id",
       f."title",
       f."rating"
FROM   "payment"   AS p
JOIN   "rental"    AS r  ON r."rental_id"    = p."rental_id"
JOIN   "inventory" AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film"      AS f  ON f."film_id"      = i."film_id"
ORDER BY p."payment_date"
LIMIT 20;
```

```sql
-- 4) For every customer, pull the FIRST payment they ever made together with the film rating
SELECT fp."customer_id",
       fp."payment_id",
       fp."payment_date",
       f."rating"
FROM  (
        SELECT p.*,
               ROW_NUMBER() OVER (PARTITION BY p."customer_id"
                                  ORDER BY p."payment_date") AS rn
        FROM   "payment" AS p
      ) AS fp
JOIN   "rental"    AS r ON r."rental_id"    = fp."rental_id"
JOIN   "inventory" AS i ON i."inventory_id" = r."inventory_id"
JOIN   "film"      AS f ON f."film_id"      = i."film_id"
WHERE  fp.rn = 1
LIMIT 20;
```

```sql
-- 5) See how many customers have each rating as their very first rented movie
SELECT ffr."rating",
       COUNT(*) AS "num_customers"
FROM (
        SELECT p."customer_id", MIN(p."payment_date") AS first_pay_dt
        FROM   "payment" AS p
        GROUP  BY p."customer_id"
     ) AS firsts
JOIN "payment"   AS p  ON p."customer_id" = firsts."customer_id"
                     AND p."payment_date" = firsts.first_pay_dt
JOIN "rental"    AS r  ON r."rental_id"    = p."rental_id"
JOIN "inventory" AS i  ON i."inventory_id" = r."inventory_id"
JOIN "film"      AS ffr ON ffr."film_id"   = i."film_id"
GROUP BY ffr."rating"
LIMIT 20;
```

```sql
-- 6) Compute total amount each customer has ever spent
SELECT "customer_id",
       SUM("amount") AS "total_spent"
FROM   "payment"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
-- 7) Count how many rentals (payments) each customer has made in total
SELECT "customer_id",
       COUNT(*) AS "total_rentals"
FROM   "payment"
GROUP  BY "customer_id"
LIMIT 20;
```

```sql
-- 8) Combine everything: rating of customer's FIRST film, total spent, total rentals
SELECT fr."rating",
       cts."total_spent",
       ctr."total_rentals"
FROM  (
        -- first‐film rating per customer
        SELECT p."customer_id",
               f."rating"
        FROM (
                SELECT p.*,
                       ROW_NUMBER() OVER (PARTITION BY p."customer_id"
                                          ORDER BY p."payment_date") AS rn
                FROM   "payment" AS p
             ) AS p
        JOIN "rental"    AS r ON r."rental_id"    = p."rental_id"
        JOIN "inventory" AS i ON i."inventory_id" = r."inventory_id"
        JOIN "film"      AS f ON f."film_id"      = i."film_id"
        WHERE p.rn = 1
      ) AS fr
JOIN (
        -- total spent per customer
        SELECT "customer_id", SUM("amount") AS "total_spent"
        FROM   "payment"
        GROUP  BY "customer_id"
     ) AS cts ON cts."customer_id" = fr."customer_id"
JOIN (
        -- total rentals per customer
        SELECT "customer_id", COUNT(*) AS "total_rentals"
        FROM   "payment"
        GROUP  BY "customer_id"
     ) AS ctr ON ctr."customer_id" = fr."customer_id"
LIMIT 20;
```

```sql
-- 9) Finally, aggregate by first‐movie rating:
--    • average total money spent per customer
--    • average number of subsequent rentals (total rentals − 1)
SELECT fr."rating"                         AS "first_movie_rating",
       AVG(cts."total_spent")              AS "avg_total_spent_per_customer",
       AVG(ctr."total_rentals" - 1)        AS "avg_subsequent_rentals"
FROM  (
        -- first‐film rating per customer
        SELECT p."customer_id",
               f."rating"
        FROM (
                SELECT p.*,
                       ROW_NUMBER() OVER (PARTITION BY p."customer_id"
                                          ORDER BY p."payment_date") AS rn
                FROM   "payment" AS p
             ) AS p
        JOIN "rental"    AS r ON r."rental_id"    = p."rental_id"
        JOIN "inventory" AS i ON i."inventory_id" = r."inventory_id"
        JOIN "film"      AS f ON f."film_id"      = i."film_id"
        WHERE p.rn = 1
      ) AS fr
JOIN (
        -- total spent per customer
        SELECT "customer_id", SUM("amount") AS "total_spent"
        FROM   "payment"
        GROUP  BY "customer_id"
     ) AS cts ON cts."customer_id" = fr."customer_id"
JOIN (
        -- total rentals per customer
        SELECT "customer_id", COUNT(*) AS "total_rentals"
        FROM   "payment"
        GROUP  BY "customer_id"
     ) AS ctr ON ctr."customer_id" = fr."customer_id"
GROUP BY fr."rating"
LIMIT 20;
```

```sql
-- 10) (Optional refinement) Order the summary by highest average spending
SELECT * 
FROM (
      -- same aggregation as #9
      SELECT fr."rating"                         AS "first_movie_rating",
             AVG(cts."total_spent")              AS "avg_total_spent_per_customer",
             AVG(ctr."total_rentals" - 1)        AS "avg_subsequent_rentals"
      FROM  (
              SELECT p."customer_id",
                     f."rating"
              FROM (
                      SELECT p.*,
                             ROW_NUMBER() OVER (PARTITION BY p."customer_id"
                                                ORDER BY p."payment_date") AS rn
                      FROM   "payment" AS p
                   ) AS p
              JOIN "rental"    AS r ON r."rental_id"    = p."rental_id"
              JOIN "inventory" AS i ON i."inventory_id" = r."inventory_id"
              JOIN "film"      AS f ON f."film_id"      = i."film_id"
              WHERE p.rn = 1
            ) AS fr
      JOIN (
              SELECT "customer_id", SUM("amount") AS "total_spent"
              FROM   "payment"
              GROUP  BY "customer_id"
           ) AS cts ON cts."customer_id" = fr."customer_id"
      JOIN (
              SELECT "customer_id", COUNT(*) AS "total_rentals"
              FROM   "payment"
              GROUP  BY "customer_id"
           ) AS ctr ON ctr."customer_id" = fr."customer_id"
      GROUP BY fr."rating"
) 
ORDER BY "avg_total_spent_per_customer" DESC
LIMIT 20;
```
