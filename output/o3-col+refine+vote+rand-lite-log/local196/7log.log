Query:
--Description: Aggregate to see the average spend and avg. subsequent rentals per rating (with LIMIT).
SELECT fr.rating,
       AVG(pa.total_amount)          AS avg_total_amount,
       AVG(pa.total_rentals - 1)     AS avg_subsequent_rentals
FROM (
        SELECT fp.customer_id,
               f.rating
        FROM (
                SELECT customer_id,
                       MIN(payment_date) AS first_payment_date
                FROM payment
                GROUP BY customer_id
             ) AS fp
        JOIN payment  AS p ON p.customer_id = fp.customer_id
                         AND p.payment_date = fp.first_payment_date
        JOIN rental   AS r ON p.rental_id   = r.rental_id
        JOIN inventory AS i ON r.inventory_id = i.inventory_id
        JOIN film      AS f ON i.film_id      = f.film_id
     ) AS fr
JOIN (
        SELECT customer_id,
               SUM(amount)              AS total_amount,
               COUNT(DISTINCT rental_id) AS total_rentals
        FROM payment
        GROUP BY customer_id
     ) AS pa
  ON fr.customer_id = pa.customer_id
GROUP BY fr.rating
LIMIT 20;
