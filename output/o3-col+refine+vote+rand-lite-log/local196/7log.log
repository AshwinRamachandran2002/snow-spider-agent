```sql
--Description: Explore the different film ratings that exist.
SELECT DISTINCT rating
FROM film
LIMIT 20;
```

```sql
--Description: Look at the earliest payment records (ordered by date) to see raw data.
SELECT payment_id,
       customer_id,
       rental_id,
       amount,
       payment_date
FROM payment
ORDER BY payment_date
LIMIT 20;
```

```sql
--Description: Verify the join-path from a payment to the film that was actually rented.
SELECT p.payment_id,
       p.customer_id,
       f.film_id,
       f.rating,
       p.payment_date
FROM payment  AS p
JOIN rental   AS r ON p.rental_id   = r.rental_id
JOIN inventory AS i ON r.inventory_id = i.inventory_id
JOIN film      AS f ON i.film_id      = f.film_id
LIMIT 20;
```

```sql
--Description: For every customer, fetch the timestamp of their very first payment.
SELECT customer_id,
       MIN(payment_date) AS first_payment_date
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: Retrieve the rating of the film linked to each customer’s very first payment.
SELECT fp.customer_id,
       f.rating,
       fp.first_payment_date
FROM (
        SELECT customer_id,
               MIN(payment_date) AS first_payment_date
        FROM payment
        GROUP BY customer_id
     )  AS fp
JOIN payment  AS p ON p.customer_id = fp.customer_id
                 AND p.payment_date = fp.first_payment_date
JOIN rental   AS r ON p.rental_id   = r.rental_id
JOIN inventory AS i ON r.inventory_id = i.inventory_id
JOIN film      AS f ON i.film_id      = f.film_id
LIMIT 20;
```

```sql
--Description: Compute every customer’s lifetime spending and total rental count.
SELECT customer_id,
       SUM(amount)              AS total_amount,
       COUNT(DISTINCT rental_id) AS total_rentals
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: Combine “first–film rating”, total amount, and (total rentals – 1) per customer.
SELECT fr.customer_id,
       fr.rating,
       pa.total_amount,
       pa.total_rentals - 1 AS subsequent_rentals
FROM (
        SELECT fp.customer_id,
               f.rating
        FROM (
                SELECT customer_id,
                       MIN(payment_date) AS first_payment_date
                FROM payment
                GROUP BY customer_id
             ) AS fp
        JOIN payment  AS p ON p.customer_id = fp.customer_id
                         AND p.payment_date = fp.first_payment_date
        JOIN rental   AS r ON p.rental_id   = r.rental_id
        JOIN inventory AS i ON r.inventory_id = i.inventory_id
        JOIN film      AS f ON i.film_id      = f.film_id
     ) AS fr
JOIN (
        SELECT customer_id,
               SUM(amount)              AS total_amount,
               COUNT(DISTINCT rental_id) AS total_rentals
        FROM payment
        GROUP BY customer_id
     ) AS pa
  ON fr.customer_id = pa.customer_id
LIMIT 20;
```

```sql
--Description: Aggregate to see the average spend and avg. subsequent rentals per rating (with LIMIT).
SELECT fr.rating,
       AVG(pa.total_amount)          AS avg_total_amount,
       AVG(pa.total_rentals - 1)     AS avg_subsequent_rentals
FROM (
        SELECT fp.customer_id,
               f.rating
        FROM (
                SELECT customer_id,
                       MIN(payment_date) AS first_payment_date
                FROM payment
                GROUP BY customer_id
             ) AS fp
        JOIN payment  AS p ON p.customer_id = fp.customer_id
                         AND p.payment_date = fp.first_payment_date
        JOIN rental   AS r ON p.rental_id   = r.rental_id
        JOIN inventory AS i ON r.inventory_id = i.inventory_id
        JOIN film      AS f ON i.film_id      = f.film_id
     ) AS fr
JOIN (
        SELECT customer_id,
               SUM(amount)              AS total_amount,
               COUNT(DISTINCT rental_id) AS total_rentals
        FROM payment
        GROUP BY customer_id
     ) AS pa
  ON fr.customer_id = pa.customer_id
GROUP BY fr.rating
LIMIT 20;
```

```sql
--Description: Count how many customers fall into each “first-movie rating” bucket.
SELECT fr.rating,
       COUNT(*) AS customers_in_group
FROM (
        SELECT fp.customer_id,
               f.rating
        FROM (
                SELECT customer_id,
                       MIN(payment_date) AS first_payment_date
                FROM payment
                GROUP BY customer_id
             ) AS fp
        JOIN payment  AS p ON p.customer_id = fp.customer_id
                         AND p.payment_date = fp.first_payment_date
        JOIN rental   AS r ON p.rental_id   = r.rental_id
        JOIN inventory AS i ON r.inventory_id = i.inventory_id
        JOIN film      AS f ON i.film_id      = f.film_id
     ) AS fr
GROUP BY fr.rating
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – average total spend and average number of subsequent rentals
--              for customers whose very first rental falls under each rating category.
SELECT fr.rating                                  AS first_movie_rating,
       ROUND(AVG(pa.total_amount), 2)             AS avg_total_amount_per_customer,
       ROUND(AVG(pa.total_rentals - 1), 2)        AS avg_subsequent_rentals_per_customer
FROM (
        SELECT fp.customer_id,
               f.rating
        FROM (
                SELECT customer_id,
                       MIN(payment_date) AS first_payment_date
                FROM payment
                GROUP BY customer_id
             ) AS fp
        JOIN payment  AS p ON p.customer_id = fp.customer_id
                         AND p.payment_date = fp.first_payment_date
        JOIN rental   AS r ON p.rental_id   = r.rental_id
        JOIN inventory AS i ON r.inventory_id = i.inventory_id
        JOIN film      AS f ON i.film_id      = f.film_id
     ) AS fr
JOIN (
        SELECT customer_id,
               SUM(amount)              AS total_amount,
               COUNT(DISTINCT rental_id) AS total_rentals
        FROM payment
        GROUP BY customer_id
     ) AS pa
  ON fr.customer_id = pa.customer_id
GROUP BY fr.rating;
```
