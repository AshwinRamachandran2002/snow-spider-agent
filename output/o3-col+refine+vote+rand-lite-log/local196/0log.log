```sql
--Description / Thinking process:
-- We need, for every MPAA rating that shows up as the FIRST movie a customer ever rented,
-- the following customer-level measures averaged across all customers whose first movie
-- has that rating:
--      • avg_total_amount_spent  = average of SUM(payment.amount) per customer
--      • avg_subsequent_rentals  = average of (COUNT(rental) − 1) per customer
--
-- Plan
-- 1. first_film CTE
--      • Join payment → rental → inventory → film to relate each payment to a film rating.
--      • Use MIN(payment_date) per customer to isolate the FIRST payment (i.e., the first rental)
--        and capture its rating.
-- 2. cust_totals CTE
--      • Aggregate all payments and rentals per customer to get total_amount_spent and
--        total_rentals (for later “− 1”).
-- 3. Final select
--      • Join the CTEs on customer_id.
--      • Group by the first-film rating and compute the requested averages.
WITH first_film AS (
    SELECT
        p.customer_id,
        f.rating,
        MIN(p.payment_date) AS first_payment_date
    FROM payment   AS p
    JOIN rental    AS r ON r.rental_id    = p.rental_id
    JOIN inventory AS i ON i.inventory_id = r.inventory_id
    JOIN film      AS f ON f.film_id      = i.film_id
    GROUP BY p.customer_id
),
cust_totals AS (
    SELECT
        p.customer_id,
        SUM(p.amount)      AS total_amount_spent,
        COUNT(r.rental_id) AS total_rentals
    FROM payment AS p
    JOIN rental  AS r ON r.rental_id = p.rental_id
    GROUP BY p.customer_id
)
SELECT
    ff.rating,
    AVG(ct.total_amount_spent) AS avg_total_amount_spent,
    AVG(ct.total_rentals - 1)  AS avg_subsequent_rentals
FROM first_film  AS ff
JOIN cust_totals AS ct
      ON ct.customer_id = ff.customer_id
GROUP BY ff.rating;
```
