```sql
--Description: 1) Get the list of distinct film ratings available in the catalogue
SELECT DISTINCT rating
FROM film
LIMIT 20;
```

```sql
--Description: 2) Check distinct customers that have made at least one payment (customer universe)
SELECT DISTINCT customer_id
FROM payment
LIMIT 20;
```

```sql
--Description: 3) Retrieve the earliest (first) payment date per customer to identify each customer’s first rental chronologically
SELECT DISTINCT customer_id,
       MIN(payment_date) AS first_payment_date            -- earliest payment per customer
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: 4) Show how a payment connects to a rental and an inventory item
SELECT DISTINCT p.payment_id,
       p.customer_id,
       p.payment_date,
       r.rental_id,
       r.inventory_id
FROM payment AS p
JOIN rental  AS r USING(rental_id)
LIMIT 20;
```

```sql
--Description: 5) Trace an inventory item all the way to the film and its rating
SELECT DISTINCT i.inventory_id,
       i.film_id,
       f.title,
       f.rating
FROM inventory AS i
JOIN film      AS f USING(film_id)
LIMIT 20;
```

```sql
--Description: 6) Combine the previous two joins to see the rating of the very first film a customer paid for
SELECT DISTINCT p.customer_id,
       p.payment_date,
       f.rating
FROM payment   AS p
JOIN rental    AS r USING(rental_id)
JOIN inventory AS i USING(inventory_id)
JOIN film      AS f USING(film_id)
ORDER BY p.customer_id, p.payment_date
LIMIT 20;
```

```sql
--Description: 7) Count total number of rentals per customer (needed later for “subsequent rentals” calculation)
SELECT DISTINCT customer_id,
       COUNT(*) AS total_rentals
FROM rental
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: 8) Calculate total amount each customer has ever paid (sum of payments)
SELECT DISTINCT customer_id,
       SUM(amount) AS total_amount_spent
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: 9) Preview, for a few customers, the rating of their first rented film, their total spend, and total rentals
WITH first_film AS (
    SELECT p.customer_id,
           f.rating,
           MIN(p.payment_date) AS first_payment_date
    FROM payment   AS p
    JOIN rental    AS r USING(rental_id)
    JOIN inventory AS i USING(inventory_id)
    JOIN film      AS f USING(film_id)
    GROUP BY p.customer_id
)
SELECT DISTINCT ff.customer_id,
       ff.rating,
       pa.total_amount_spent,
       (re.total_rentals - 1) AS subsequent_rentals
FROM first_film        AS ff
JOIN (
      SELECT customer_id, SUM(amount) AS total_amount_spent
      FROM payment
      GROUP BY customer_id
) pa USING(customer_id)
JOIN (
      SELECT customer_id, COUNT(*) AS total_rentals
      FROM rental
      GROUP BY customer_id
) re USING(customer_id)
LIMIT 20;
```

```sql
--Description: 10) Final aggregation prototype – average spend & average subsequent rentals per first-film rating
WITH first_film AS (
    SELECT p.customer_id,
           f.rating,
           MIN(p.payment_date) AS first_payment_date
    FROM payment   AS p
    JOIN rental    AS r USING(rental_id)
    JOIN inventory AS i USING(inventory_id)
    JOIN film      AS f USING(film_id)
    GROUP BY p.customer_id
),
cust_totals AS (
    SELECT customer_id,
           SUM(amount) AS total_amount_spent,
           COUNT(*)   AS total_rentals
    FROM payment
    JOIN rental USING(rental_id)
    GROUP BY customer_id
)
SELECT DISTINCT ff.rating,
       AVG(ct.total_amount_spent)        AS avg_total_amount_spent,
       AVG(ct.total_rentals - 1)         AS avg_subsequent_rentals
FROM first_film AS ff
JOIN cust_totals AS ct USING(customer_id)
GROUP BY ff.rating
LIMIT 20;
```
