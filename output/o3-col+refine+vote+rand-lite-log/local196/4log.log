--Description: For each customer display their very first payment (earliest payment_date) together with the film rating for that first rental  
SELECT first_pay.customer_id,
       first_pay.first_payment_date,
       f.rating
FROM (
      SELECT customer_id,
             MIN(payment_date) AS first_payment_date
      FROM payment
      GROUP BY customer_id
     ) AS first_pay
JOIN payment  AS p  ON p.customer_id = first_pay.customer_id
                   AND p.payment_date = first_pay.first_payment_date
JOIN rental   AS r  ON r.rental_id   = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id      = i.film_id
LIMIT 20;
