```sql
--Description: Look at a handful of payment records to understand the link-out columns we will need (customer_id, rental_id, amount, payment_date)  
SELECT *  
FROM payment  
LIMIT 20;
```

```sql
--Description: Inspect a few rental rows so we see how payment.rental_id joins to rental (especially inventory_id & staff_id)  
SELECT *  
FROM rental  
LIMIT 20;
```

```sql
--Description: Inspect some inventory rows; we need film_id living behind each inventory copy  
SELECT *  
FROM inventory  
LIMIT 20;
```

```sql
--Description: Inspect some film rows to confirm the rating values we will later group by  
SELECT film_id, title, rating  
FROM film  
LIMIT 20;
```

```sql
--Description: Verify what distinct rating categories actually exist in the film table  
SELECT DISTINCT rating  
FROM film  
LIMIT 20;
```

```sql
--Description: Bring everything together for a few rows – map payment → rental → inventory → film to see the rating that corresponds to each payment  
SELECT p.payment_id, p.customer_id, p.payment_date, p.amount,
       f.film_id, f.rating, f.title
FROM payment AS p
JOIN rental   AS r ON r.rental_id   = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id      = i.film_id
LIMIT 20;
```

```sql
--Description: For each customer display their very first payment (earliest payment_date) together with the film rating for that first rental  
SELECT first_pay.customer_id,
       first_pay.first_payment_date,
       f.rating
FROM (
      SELECT customer_id,
             MIN(payment_date) AS first_payment_date
      FROM payment
      GROUP BY customer_id
     ) AS first_pay
JOIN payment  AS p  ON p.customer_id = first_pay.customer_id
                   AND p.payment_date = first_pay.first_payment_date
JOIN rental   AS r  ON r.rental_id   = p.rental_id
JOIN inventory AS i ON i.inventory_id = r.inventory_id
JOIN film      AS f ON f.film_id      = i.film_id
LIMIT 20;
```

```sql
--Description: Count total number of rentals per customer so we can later subtract 1 to obtain “subsequent rentals”  
SELECT customer_id,
       COUNT(*) AS total_rentals
FROM rental
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: Show, for a sample of customers, the total amount they have spent (sum of payment.amount)  
SELECT customer_id,
       ROUND(SUM(amount), 2) AS total_spent
FROM payment
GROUP BY customer_id
LIMIT 20;
```

```sql
--Description: Pull everything together—to preview the exact figures we will need—for each customer: first-movie rating, total spent, and subsequent rentals  
SELECT first_info.customer_id,
       first_info.rating                                   AS first_movie_rating,
       spent.total_spent,
       rentals.total_rentals - 1                           AS subsequent_rentals
FROM (
      SELECT fp.customer_id,
             f.rating
      FROM (
            SELECT customer_id, MIN(payment_date) AS first_payment_date
            FROM payment
            GROUP BY customer_id
           ) AS fp
      JOIN payment  AS p  ON p.customer_id = fp.customer_id
                         AND p.payment_date = fp.first_payment_date
      JOIN rental   AS r  ON r.rental_id   = p.rental_id
      JOIN inventory AS i ON i.inventory_id = r.inventory_id
      JOIN film      AS f ON f.film_id      = i.film_id
     ) AS first_info
JOIN (
      SELECT customer_id, ROUND(SUM(amount), 2) AS total_spent
      FROM payment
      GROUP BY customer_id
     ) AS spent   ON spent.customer_id   = first_info.customer_id
JOIN (
      SELECT customer_id, COUNT(*) AS total_rentals
      FROM rental
      GROUP BY customer_id
     ) AS rentals ON rentals.customer_id = first_info.customer_id
LIMIT 20;
```

