-- Year-by-year average inpatient & outpatient cost for the single
-- provider with the highest TOTAL inpatient Medicare cost (2011-2015)

WITH
/* ---------------------------------------------------------------
   1)  Combine all available inpatient rows (2011, 2013-2015)
---------------------------------------------------------------- */
inpatient AS (
  SELECT
    _TABLE_SUFFIX               AS year,          -- e.g. '2011'
    provider_id,
    provider_name,
    average_medicare_payments * total_discharges AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_20*`
  WHERE _TABLE_SUFFIX IN ('2011','2013','2014','2015')
),

/* ---------------------------------------------------------------
   2)  Identify the provider with the largest TOTAL inpatient cost
---------------------------------------------------------------- */
top_provider AS (
  SELECT
    provider_id,
    ANY_VALUE(provider_name) AS provider_name
  FROM inpatient
  GROUP BY provider_id
  ORDER BY SUM(row_cost) DESC
  LIMIT 1
),

/* ---------------------------------------------------------------
   3)  Year-by-year average inpatient cost for the top provider
---------------------------------------------------------------- */
inpatient_yearly AS (
  SELECT
    CAST(year AS INT64)          AS year,
    AVG(row_cost)                AS avg_inpatient_cost
  FROM inpatient
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  GROUP BY year
),

/* ---------------------------------------------------------------
   4)  Combine all outpatient rows (2011-2015)
---------------------------------------------------------------- */
outpatient AS (
  SELECT
    _TABLE_SUFFIX                    AS year,
    provider_id,
    average_total_payments * outpatient_services AS row_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_20*`
  WHERE _TABLE_SUFFIX IN ('2011','2012','2013','2014','2015')
),

/* ---------------------------------------------------------------
   5)  Year-by-year average outpatient cost for the top provider
---------------------------------------------------------------- */
outpatient_yearly AS (
  SELECT
    CAST(year AS INT64)          AS year,
    AVG(row_cost)                AS avg_outpatient_cost
  FROM outpatient
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  GROUP BY year
)

/* ---------------------------------------------------------------
   6)  Merge the two yearly series (2011-2015)
---------------------------------------------------------------- */
SELECT
  y.year,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM UNNEST([2011,2012,2013,2014,2015]) AS y(year)
LEFT JOIN inpatient_yearly  AS i USING (year)
LEFT JOIN outpatient_yearly AS o USING (year)
ORDER BY y.year;
```
