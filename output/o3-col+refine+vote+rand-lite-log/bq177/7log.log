```sql
--Description: Compute each provider’s TOTAL inpatient Medicare cost from 2011-2015
--             (sum of row_inpatient_cost) and list the 20 largest.
WITH all_inpatient AS (
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  UNION ALL
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  UNION ALL
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
)
SELECT
  provider_id,
  ANY_VALUE(provider_name) AS provider_name,
  SUM(row_cost)           AS total_inpatient_cost
FROM all_inpatient
GROUP BY provider_id
ORDER BY total_inpatient_cost DESC
LIMIT 20;
```

```sql
--Description: Identify the single provider whose total inpatient cost is the highest.
WITH all_inpatient AS (
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  UNION ALL
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  UNION ALL
  SELECT provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
),
ranked AS (
  SELECT
    provider_id,
    ANY_VALUE(provider_name) AS provider_name,
    SUM(row_cost)           AS total_inpatient_cost,
    RANK() OVER(ORDER BY SUM(row_cost) DESC) AS rnk
  FROM all_inpatient
  GROUP BY provider_id
)
SELECT provider_id, provider_name, total_inpatient_cost
FROM ranked
WHERE rnk = 1
LIMIT 20;
```

```sql
--Description: For that top-spending provider, compute the YEARLY average inpatient
--             cost (average of row_inpatient_cost) from 2011-2015.
WITH top_provider AS (
  SELECT provider_id
  FROM (
    SELECT provider_id,
           RANK() OVER(ORDER BY SUM(total_discharges * average_medicare_payments) DESC) AS rnk
    FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
    GROUP BY provider_id
  ) WHERE rnk = 1
),
union_inpatient AS (
  SELECT 2011 AS yr, provider_id,
         total_discharges * average_medicare_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013, provider_id,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014, provider_id,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015, provider_id,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
)
SELECT
  yr AS year,
  AVG(row_cost) AS avg_inpatient_cost
FROM union_inpatient
GROUP BY yr
ORDER BY year
LIMIT 20;
```

```sql
--Description: For the same provider, compute the YEARLY average outpatient cost
--             (average of row_outpatient_cost) from 2011-2015.
WITH top_provider AS (
  SELECT provider_id
  FROM (
    SELECT provider_id,
           RANK() OVER(ORDER BY SUM(total_discharges * average_medicare_payments) DESC) AS rnk
    FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
    GROUP BY provider_id
  ) WHERE rnk = 1
),
union_outpatient AS (
  SELECT 2011 AS yr, provider_id,
         outpatient_services * average_total_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2012, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
)
SELECT
  yr  AS year,
  AVG(row_cost) AS avg_outpatient_cost
FROM union_outpatient
GROUP BY yr
ORDER BY year
LIMIT 20;
```

```sql
--Description: Present the final answer – yearly average inpatient and outpatient
--             costs for the top-spending provider during 2011-2015.
WITH top_provider AS (
  SELECT provider_id, provider_name
  FROM (
    SELECT provider_id,
           ANY_VALUE(provider_name) AS provider_name,
           RANK() OVER(ORDER BY SUM(total_discharges * average_medicare_payments) DESC) AS rnk
    FROM (
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
      UNION ALL
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
      UNION ALL
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
      UNION ALL
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
    )
    GROUP BY provider_id
  )
  WHERE rnk = 1
),
yearly_inpatient AS (
  SELECT 2011 AS year, AVG(total_discharges * average_medicare_payments) AS avg_inpatient_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
),
yearly_outpatient AS (
  SELECT 2011 AS year, AVG(outpatient_services * average_total_payments) AS avg_outpatient_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2012, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
)
SELECT
  tp.provider_name,
  yi.year,
  yi.avg_inpatient_cost,
  yo.avg_outpatient_cost
FROM yearly_inpatient yi
JOIN yearly_outpatient yo USING (year)
CROSS JOIN top_provider tp
ORDER BY yi.year
LIMIT 20;
```

These seven progressively more complex queries (all capped with `LIMIT 20`) start with simple data exploration, identify the provider with the highest total inpatient Medicare cost from 2011-2015, and finally yield that provider’s yearly average inpatient and outpatient costs for each calendar year in the period.
