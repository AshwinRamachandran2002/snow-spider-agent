```sql
--Description (thinking process embedded):
-- Goal:  Produce, in one query, the yearly average inpatient cost and average
--        outpatient cost for the single provider that incurred the greatest
--        TOTAL inpatient Medicare cost during 2011-2015.
--
-- Steps in this SINGLE query:
--  1. union_inpatient  – collect every inpatient row 2011, 2013-2015 and
--                        attach its row-level cost (avg_medicare × discharges).
--  2. top_provider     – rank providers by SUM(row_cost) and keep the #1
--                        (that turns out to be provider_id = 330101,
--                        NEW YORK-PRESBYTERIAN HOSPITAL).
--  3. inpatient_yearly – for that provider, compute the calendar-year average
--                        of row-level inpatient cost.
--  4. outpatient_yearly– same idea for outpatient tables 2011-2015
--                        (there is no inpatient table for 2012, but there IS
--                         an outpatient table, so 2012 will contain only the
--                         outpatient average).
--  5. Combine the two yearly sets with FULL OUTER JOIN so we keep every year
--     that appears on either side; finally attach provider_name and order
--     chronologically.
-- ---------------------------------------------------------------------------

WITH union_inpatient AS (
  -- every inpatient row with its row-level cost
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  UNION ALL
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  UNION ALL
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
),
top_provider AS (       -- provider with highest TOTAL inpatient cost
  SELECT provider_id,
         ANY_VALUE(provider_name) AS provider_name
  FROM union_inpatient
  GROUP BY provider_id
  ORDER BY SUM(row_cost) DESC
  LIMIT 1
),
inpatient_yearly AS (   -- yearly AVG inpatient cost for the top provider
  SELECT 2011 AS year,
         AVG(average_medicare_payments * total_discharges) AS avg_inpatient_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2013,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2014,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2015,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`, top_provider
  WHERE provider_id = top_provider.provider_id
),
outpatient_yearly AS (  -- yearly AVG outpatient cost for the top provider
  SELECT 2011 AS year,
         AVG(average_total_payments * outpatient_services) AS avg_outpatient_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2012,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2013,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2014,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`, top_provider
  WHERE provider_id = top_provider.provider_id

  UNION ALL
  SELECT 2015,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`, top_provider
  WHERE provider_id = top_provider.provider_id
)

SELECT
  COALESCE(i.year, o.year)           AS calendar_year,
  tp.provider_name,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM top_provider             AS tp
LEFT JOIN inpatient_yearly    AS i ON TRUE              -- attach inpatient rows
FULL JOIN outpatient_yearly   AS o ON o.year = i.year   -- merge yearly data
ORDER BY calendar_year;
```
