```sql
--Description:
--Single-query workflow (explanatory comments = thinking process):
-- 1. Build inpatient_all      – UNION ALL all inpatient tables that exist for 2011-2015
--                               and compute each row’s cost (avg_medicare_payments × discharges).
-- 2. Derive top_provider      – Aggregate inpatient_all by provider and keep the one with
--                               the greatest total cost (that is the hospital we need).
-- 3. Build inpatient_yearly   – For that provider, compute the calendar-year
--                               average of row-level inpatient cost.
-- 4. Build outpatient_all     – UNION ALL all outpatient tables 2011-2015 and compute
--                               each row’s cost (avg_total_payments × services).
-- 5. Build outpatient_yearly  – For the same provider, compute the calendar-year
--                               average of row-level outpatient cost.
-- 6. Final SELECT             – FULL OUTER JOIN the two yearly result sets so every
--                               year 2011-2015 appears with both averages (NULL where absent),
--                               and include provider_id and provider_name for clarity.

WITH inpatient_all AS (
  -- 2011
  SELECT 2011 AS yr,
         provider_id        AS pid,
         provider_name      AS pname,
         average_medicare_payments * total_discharges AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  -- 2013
  SELECT 2013,
         provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  UNION ALL
  -- 2014
  SELECT 2014,
         provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  UNION ALL
  -- 2015
  SELECT 2015,
         provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
),
top_provider AS (
  SELECT
    pid,
    ANY_VALUE(pname) AS provider_name
  FROM inpatient_all
  GROUP BY pid
  ORDER BY SUM(row_cost) DESC
  LIMIT 1            -- <-- the single highest-cost provider
),
inpatient_yearly AS (
  SELECT
    yr,
    AVG(row_cost) AS avg_inpatient_cost
  FROM inpatient_all
  WHERE pid = (SELECT pid FROM top_provider)
  GROUP BY yr
),
outpatient_all AS (
  -- 2011
  SELECT 2011 AS yr,
         provider_id AS pid,
         average_total_payments * outpatient_services AS row_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  UNION ALL
  -- 2012
  SELECT 2012,
         provider_id,
         average_total_payments * outpatient_services
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  UNION ALL
  -- 2013
  SELECT 2013,
         provider_id,
         average_total_payments * outpatient_services
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  UNION ALL
  -- 2014
  SELECT 2014,
         provider_id,
         average_total_payments * outpatient_services
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  UNION ALL
  -- 2015
  SELECT 2015,
         provider_id,
         average_total_payments * outpatient_services
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
),
outpatient_yearly AS (
  SELECT
    yr,
    AVG(row_cost) AS avg_outpatient_cost
  FROM outpatient_all
  WHERE pid = (SELECT pid FROM top_provider)
  GROUP BY yr
)
SELECT
  COALESCE(i.yr, o.yr)               AS calendar_year,
  tp.pid                              AS provider_id,
  tp.provider_name,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM top_provider AS tp
LEFT JOIN inpatient_yearly  AS i ON TRUE          -- attach inpatient rows
FULL JOIN outpatient_yearly AS o ON o.yr = i.yr   -- merge yearly data
ORDER BY calendar_year;
```
