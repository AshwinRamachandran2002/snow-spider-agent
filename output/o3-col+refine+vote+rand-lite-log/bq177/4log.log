Query:
--Description: Compute each provider’s TOTAL inpatient Medicare cost from 2011-2015
--and return the 20 highest.  This will identify the single top-cost provider.
WITH union_inpatient AS (
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  UNION ALL
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  UNION ALL
  SELECT provider_id,
         provider_name,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
)
SELECT
  provider_id,
  ANY_VALUE(provider_name) AS provider_name,
  SUM(row_cost)            AS total_inpatient_cost
FROM union_inpatient
GROUP BY provider_id
ORDER BY total_inpatient_cost DESC
LIMIT 20;
