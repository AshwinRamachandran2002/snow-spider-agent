```sql
--Description: Combine the yearly average inpatient & outpatient costs for the
--top-cost provider into one final table covering 2011-2015.
--Replace 'XXXXX' with the provider_id.
WITH inpt AS (
  SELECT 2011 AS yr, AVG(average_medicare_payments * total_discharges) AS avg_inpatient
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2013, AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2014, AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2015, AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = 'XXXXX'
),
outpt AS (
  SELECT 2011 AS yr, AVG(average_total_payments * outpatient_services) AS avg_outpatient
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2012, AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2013, AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2014, AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id = 'XXXXX'
  UNION ALL
  SELECT 2015, AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id = 'XXXXX'
)
SELECT
  COALESCE(inpt.yr, outpt.yr)     AS calendar_year,
  inpt.avg_inpatient              AS avg_inpatient_cost,
  outpt.avg_outpatient            AS avg_outpatient_cost
FROM inpt
FULL OUTER JOIN outpt
ON inpt.yr = outpt.yr
ORDER BY calendar_year
LIMIT 20;
```

