```sql
--Description: 8) For the same provider, compute YEARLY average outpatient
-- cost across 2011-2015 (note 2012 table exists for outpatient).
WITH target AS (            -- same provider_id as step 6
  SELECT 'XXXXXXXXX' AS provider_id
),
stacked AS (
  SELECT 2011 AS year, provider_id, outpatient_services, average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  UNION ALL
  SELECT 2012, provider_id, outpatient_services, average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  UNION ALL
  SELECT 2013, provider_id, outpatient_services, average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  UNION ALL
  SELECT 2014, provider_id, outpatient_services, average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  UNION ALL
  SELECT 2015, provider_id, outpatient_services, average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
)
SELECT year,
       AVG(average_total_payments * outpatient_services) AS avg_outpatient_cost
FROM stacked
JOIN target USING (provider_id)
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 9) Combine the inpatient & outpatient yearly averages for the
-- highest-cost provider into a single report (full 2011-2015 calendar span).
WITH provider AS (
  SELECT 'XXXXXXXXX' AS provider_id   -- fill in from step 5
),
inpatient AS (
  SELECT 2011 AS year, provider_id,
         AVG(average_medicare_payments * total_discharges) AS avg_inpatient_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2013, provider_id,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2014, provider_id,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2015, provider_id,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
),
outpatient AS (
  SELECT 2011 AS year, provider_id,
         AVG(average_total_payments * outpatient_services) AS avg_outpatient_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2012, provider_id,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2013, provider_id,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2014, provider_id,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
  UNION ALL
  SELECT 2015, provider_id,
         AVG(average_total_payments * outpatient_services)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id = (SELECT provider_id FROM provider) GROUP BY year, provider_id
)
SELECT
  COALESCE(i.year, o.year) AS year,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM inpatient AS i
FULL OUTER JOIN outpatient AS o USING (year)
ORDER BY year
LIMIT 20;
```

