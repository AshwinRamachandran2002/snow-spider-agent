  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = '330101'
  UNION ALL
  SELECT 2015 AS year,
         AVG(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = '330101'
),
/* ========== Outpatient yearly averages (row_cost = average_total_payments × outpatient_services) ========== */
outpatient AS (
  SELECT 2011 AS year,
         AVG(average_total_payments * outpatient_services) AS avg_outpatient_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id = '330101'
  UNION ALL
  SELECT 2012 AS year,
