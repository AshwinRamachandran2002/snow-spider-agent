```sql
--Description:  One self-contained query that
-- 1) UNION-ALLs the four available inpatient charge tables (2011, 2013-2015),
--    tagging each row with its year and computing its row-level inpatient cost.
-- 2) Sums those row-level costs per provider across all years and picks the
--    single provider with the largest cumulative inpatient spend (“top_provider”).
-- 3) Calculates, for that top provider,
--      • avg_inpatient_cost = AVG(average_medicare_payments × total_discharges)
--        per calendar year (from the UNION of inpatient tables).
--      • avg_outpatient_cost = AVG(average_total_payments × outpatient_services)
--        per calendar year (from the UNION of outpatient tables 2011-2015).
-- 4) FULL OUTER JOINs the two yearly aggregates so every year 2011-2015
--    appears even if one side is missing (e.g., no inpatient table for 2012).
WITH
/*-------------- 1) All inpatient rows with year & row-cost -------------------*/
inpatient_all AS (
  SELECT 2011 AS yr, provider_id, provider_name,
         total_discharges, average_medicare_payments,
         average_medicare_payments * total_discharges AS row_inp_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  SELECT 2013, provider_id, provider_name,
         total_discharges, average_medicare_payments,
