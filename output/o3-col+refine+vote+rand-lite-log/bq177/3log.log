--Description:
--Objective & thinking in one place
--  ①  Identify which provider generated the greatest TOTAL inpatient
--      cost across 2011-2015.  Cost per row = total_discharges *
--      average_medicare_payments.
--  ②  For that provider only, compute for every calendar year 2011-2015:
--        • avg_inpatient_cost   (average of those row-costs)
--        • avg_outpatient_cost  (average of outpatient row-costs where
--                                row-cost = outpatient_services *
--                                average_total_payments)
--  ③  Return a tidy table listing provider_id, provider_name, year,
--      avg_inpatient_cost, avg_outpatient_cost.  If the provider has no
--      records for a given setting in a year, the corresponding average
--      appears as NULL (hence explicit “years” CTE + LEFT JOINs).
--Design decisions
--  • yr carried as INT64 everywhere to avoid INT vs STRING join errors.
--  • UNION ALL used to merge yearly tables into *_all CTEs.
--  • top_provider selects only id/name (no grouping conflicts).
--  • CROSS JOIN with “years” guarantees every year 2011-2015 is shown.
WITH
/*──────────────────────────────────────────────────────────────────*/
inpatient_all AS (   -- union inpatient tables + row_cost
  SELECT 2011 AS yr, provider_id, provider_name,
         total_discharges * average_medicare_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  UNION ALL
  SELECT 2013, provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  UNION ALL
  SELECT 2014, provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  UNION ALL
  SELECT 2015, provider_id, provider_name,
         total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
),
/*──────────────────────────────────────────────────────────────────*/
top_provider AS (    -- provider with maximum total inpatient spend
  SELECT provider_id,
         ANY_VALUE(provider_name) AS provider_name
  FROM inpatient_all
  GROUP BY provider_id
  ORDER BY SUM(row_cost) DESC
  LIMIT 1
),
/*──────────────────────────────────────────────────────────────────*/
inpatient_yearly AS (  -- yearly average inpatient cost for that provider
  SELECT yr,
         AVG(row_cost) AS avg_inpatient_cost
  FROM inpatient_all
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  GROUP BY yr
),
/*──────────────────────────────────────────────────────────────────*/
outpatient_all AS (   -- union outpatient tables + row_cost
  SELECT 2011 AS yr, provider_id,
         outpatient_services * average_total_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  UNION ALL
  SELECT 2012, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  UNION ALL
  SELECT 2013, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  UNION ALL
  SELECT 2014, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  UNION ALL
  SELECT 2015, provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
),
/*──────────────────────────────────────────────────────────────────*/
outpatient_yearly AS ( -- yearly average outpatient cost for that provider
  SELECT yr,
         AVG(row_cost) AS avg_outpatient_cost
  FROM outpatient_all
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  GROUP BY yr
),
/*──────────────────────────────────────────────────────────────────*/
years AS (            -- ensure every calendar year 2011-2015 appears
  SELECT 2011 AS yr UNION ALL
  SELECT 2012 UNION ALL
  SELECT 2013 UNION ALL
  SELECT 2014 UNION ALL
  SELECT 2015
)
/*──────────────────────────── FINAL SELECT ─────────────────────────*/
SELECT
  tp.provider_id,
  tp.provider_name,
  y.yr AS calendar_year,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM years            AS y
CROSS JOIN top_provider tp
LEFT JOIN inpatient_yearly  i USING (yr)
LEFT JOIN outpatient_yearly o USING (yr)
ORDER BY calendar_year;
```
