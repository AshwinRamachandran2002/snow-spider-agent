```sql
--Description: 8) Join the two yearly results so we can see both inpatient and
--outpatient averages side-by-side for each calendar year.
WITH inpatient AS (
  SELECT 2011 AS yr, AVG(total_discharges * average_medicare_payments) AS avg_inpatient_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2013, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2014, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2015, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = 'XXXXXX'
),
outpatient AS (
  SELECT 2011 AS yr, AVG(outpatient_services * average_total_payments) AS avg_outpatient_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2012, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2013, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2014, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2015, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id = 'XXXXXX'
)
SELECT
  i.yr,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM inpatient AS i
LEFT JOIN outpatient AS o USING (yr)
ORDER BY yr
LIMIT 20;
```

```sql
--Description: 9) Final report – include provider identifiers together with the
--yearly average inpatient & outpatient costs.  (Keep LIMIT for safety.)
WITH top_provider AS (
  --find id/name of highest-cost inpatient provider
  SELECT
    provider_id,
    ANY_VALUE(provider_name) AS provider_name
  FROM (
    SELECT provider_id,
           provider_name,
           SUM(total_discharges * average_medicare_payments) AS total_cost
    FROM (
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
      UNION ALL
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
      UNION ALL
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
      UNION ALL
      SELECT provider_id, provider_name, total_discharges, average_medicare_payments
      FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
    )
    GROUP BY provider_id, provider_name
    ORDER BY total_cost DESC
    LIMIT 1
  )
),
inpatient_yearly AS (
  SELECT 2011 AS yr, AVG(total_discharges * average_medicare_payments) AS avg_inpatient_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015, AVG(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
),
outpatient_yearly AS (
  SELECT 2011 AS yr, AVG(outpatient_services * average_total_payments) AS avg_outpatient_cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2012, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015, AVG(outpatient_services * average_total_payments)
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id IN (SELECT provider_id FROM top_provider)
)
SELECT
  tp.provider_id,
  tp.provider_name,
  COALESCE(i.yr, o.yr) AS year,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM top_provider AS tp
LEFT JOIN inpatient_yearly AS i ON TRUE
LEFT JOIN outpatient_yearly AS o ON COALESCE(i.yr, o.yr) = o.yr
ORDER BY year
LIMIT 20;
```

