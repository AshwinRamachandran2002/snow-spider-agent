```sql
--Description: 5) For that top-cost provider (replace 'XXXXXX' with the provider_id
--returned by query 4), compute its YEARLY AVERAGE inpatient cost.
WITH inpatient_by_year AS (
  SELECT 2011 AS yr, total_discharges * average_medicare_payments AS row_cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2013, total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2014, total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = 'XXXXXX'
  UNION ALL
  SELECT 2015, total_discharges * average_medicare_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = 'XXXXXX'
)
SELECT
  yr,
  AVG(row_cost) AS avg_inpatient_cost
FROM inpatient_by_year
GROUP BY yr
ORDER BY yr
LIMIT 20;
```

