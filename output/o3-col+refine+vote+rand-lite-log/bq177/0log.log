Query:
-- Description: 6) Isolate the single provider with the highest 2011-2015
--                total inpatient cost.
WITH all_years AS (
  SELECT provider_id,
         SUM(average_medicare_payments * total_discharges) AS cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  GROUP BY provider_id
  UNION ALL
  SELECT provider_id,
         SUM(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  GROUP BY provider_id
  UNION ALL
  SELECT provider_id,
         SUM(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY provider_id
  UNION ALL
  SELECT provider_id,
         SUM(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  GROUP BY provider_id
),
ranked AS (
  SELECT
    provider_id,
    SUM(cost) AS grand_total,
    ROW_NUMBER() OVER (ORDER BY SUM(cost) DESC) AS rn
  FROM all_years
  GROUP BY provider_id
)
SELECT DISTINCT provider_id, grand_total
FROM ranked
WHERE rn = 1
LIMIT 20;
