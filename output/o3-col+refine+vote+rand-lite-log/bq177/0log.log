-- Description: 5) Aggregate 2011-2015 inpatient cost for every provider and
--                show the 20 costliest providers overall.
WITH all_years AS (
  SELECT provider_id, provider_name,
         SUM(average_medicare_payments * total_discharges) AS cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  GROUP BY provider_id, provider_name
  UNION ALL
  SELECT provider_id, provider_name,
         SUM(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  GROUP BY provider_id, provider_name
  UNION ALL
  SELECT provider_id, provider_name,
         SUM(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY provider_id, provider_name
  UNION ALL
  SELECT provider_id, provider_name,
         SUM(average_medicare_payments * total_discharges)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  GROUP BY provider_id, provider_name
)
SELECT
  provider_id,
  provider_name,
  SUM(cost) AS total_inpatient_cost_2011_2015
FROM all_years
GROUP BY provider_id, provider_name
ORDER BY total_inpatient_cost_2011_2015 DESC
