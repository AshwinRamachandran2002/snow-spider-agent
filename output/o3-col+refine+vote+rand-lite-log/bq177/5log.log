```sql
--Description / Thinking process:
--1. First, dynamically discover the single provider whose TOTAL inpatient cost (Σ average_medicare_payments×total_discharges)
--   is greatest across the four available inpatient years (2011, 2013, 2014, 2015).  Call this CTE top_provider.
--2. Next, build two long tables:
--      • inpatient_costs  – every discharge row for that provider, with its calendar year and the row-level cost.
--      • outpatient_costs – every outpatient row for that provider, with its calendar year and the row-level cost.
--3. Aggregate each table to get the *average* cost per calendar year.
--4. FULL OUTER JOIN the two summaries so every year 2011-2015 appears, even if the provider has
--   only inpatient (no 2012 table) or only outpatient rows.
--5. Return the provider_id (for clarity), year, average inpatient cost, and average outpatient cost, ordered by year.

WITH
-- Step 1: identify the provider with the highest total inpatient cost over 2011-2015
top_provider AS (
  SELECT provider_id
  FROM (
        SELECT provider_id, SUM(total_discharges * average_medicare_payments) AS cost
        FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
        GROUP BY provider_id
        UNION ALL
        SELECT provider_id, SUM(total_discharges * average_medicare_payments)
        FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
        GROUP BY provider_id
        UNION ALL
        SELECT provider_id, SUM(total_discharges * average_medicare_payments)
        FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
        GROUP BY provider_id
        UNION ALL
        SELECT provider_id, SUM(total_discharges * average_medicare_payments)
        FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
        GROUP BY provider_id
  )
  GROUP BY provider_id
  ORDER BY SUM(cost) DESC
  LIMIT 1
),
-- Step 2a: union all inpatient rows for that provider, tagging each with its year
inpatient_costs AS (
  SELECT 2011 AS year,
         provider_id,
         average_medicare_payments * total_discharges AS cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013,
         provider_id,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014,
         provider_id,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015,
         provider_id,
         average_medicare_payments * total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
),
-- Step 2b: union all outpatient rows for that provider, tagging each with its year
outpatient_costs AS (
  SELECT 2011 AS year,
         provider_id,
         outpatient_services * average_total_payments AS cost
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2011`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2012,
         provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2012`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2013,
         provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2013`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2014,
         provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2014`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
  UNION ALL
  SELECT 2015,
         provider_id,
         outpatient_services * average_total_payments
  FROM `bigquery-public-data.cms_medicare.outpatient_charges_2015`
  WHERE provider_id = (SELECT provider_id FROM top_provider)
),
-- Step 3: average cost per year for each modality
avg_inpatient AS (
  SELECT year,
         provider_id,
         AVG(cost) AS avg_inpatient_cost
  FROM inpatient_costs
  GROUP BY year, provider_id
),
avg_outpatient AS (
  SELECT year,
         provider_id,
         AVG(cost) AS avg_outpatient_cost
  FROM outpatient_costs
  GROUP BY year, provider_id
)
-- Step 4 & 5: bring them together
SELECT
  COALESCE(i.provider_id, o.provider_id) AS provider_id,
  COALESCE(i.year, o.year)               AS year,
  i.avg_inpatient_cost,
  o.avg_outpatient_cost
FROM avg_inpatient i
FULL OUTER JOIN avg_outpatient o
ON i.year = o.year
ORDER BY year;
```
