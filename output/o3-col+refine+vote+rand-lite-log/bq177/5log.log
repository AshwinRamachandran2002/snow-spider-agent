Query:
-- 4.  Sum those yearly totals to find the single provider with the HIGHEST 2011-2015 inpatient cost
WITH yearly AS (
  SELECT provider_id, provider_name, SUM(total_discharges * average_medicare_payments) AS cost
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2011`
  GROUP BY provider_id, provider_name
  UNION ALL
  SELECT provider_id, provider_name, SUM(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2013`
  GROUP BY provider_id, provider_name
  UNION ALL
  SELECT provider_id, provider_name, SUM(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY provider_id, provider_name
  UNION ALL
  SELECT provider_id, provider_name, SUM(total_discharges * average_medicare_payments)
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2015`
  GROUP BY provider_id, provider_name
)
SELECT 
  provider_id,
  provider_name,
  SUM(cost) AS total_2011_2015_inpatient_cost
FROM yearly
GROUP BY provider_id, provider_name
ORDER BY total_2011_2015_inpatient_cost DESC
