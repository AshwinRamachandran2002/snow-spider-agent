```sql
--Description: Quick look at the USERS table (first-20 records).
SELECT * 
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
LIMIT 20;
```

```sql
--Description: Pull DISTINCT users who registered in calendar-year 2019.
SELECT DISTINCT 
       "id",
       "email",
       "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799000000   -- 2019-01-01 through 2019-12-31 (µs)
LIMIT 20;
```

```sql
--Description: Preview ORDERS created inside 2019.
SELECT * 
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
--Description: Find 2019 ORDERS placed by 2019-registered USERS.
SELECT o."order_id",
       o."user_id",
       o."num_of_item",
       o."created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"  o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"   u
       ON o."user_id" = u."id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
  AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
--Description: Inspect ORDER_ITEMS that belong to those 2019 orders (with sale_price shown).
SELECT oi."order_id",
       oi."product_id",
       oi."sale_price",
       oi."status"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
WHERE  oi."order_id" IN (
          SELECT DISTINCT o."order_id"
          FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
          WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
       )
LIMIT 20;
```

```sql
--Description: Compute order-level value = SUM(num_of_item * sale_price) for each order.
SELECT 
       o."order_id",
       o."user_id",
       SUM(o."num_of_item" * oi."sale_price") AS "order_value"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
       ON o."order_id" = oi."order_id"
WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
GROUP BY o."order_id", o."user_id"
LIMIT 20;
```

```sql
--Description: Aggregate per-user totals and counts for 2019 (registered & purchased in 2019).
SELECT 
       t."user_id",
       SUM(t."order_value")            AS "total_value_2019",
       COUNT(*)                        AS "total_orders_2019"
FROM (
        SELECT o."order_id",
               o."user_id",
               SUM(o."num_of_item" * oi."sale_price") AS "order_value"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
               ON o."order_id" = oi."order_id"
        JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
               ON o."user_id" = u."id"
        WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
          AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
        GROUP BY o."order_id", o."user_id"
     ) t
GROUP BY t."user_id"
LIMIT 20;
```

```sql
--Description: Calculate average order value per user (2019 scope).
SELECT 
       agg."user_id",
       agg."total_value_2019" / NULLIF(agg."total_orders_2019",0) AS "avg_order_value_2019"
FROM (
        SELECT 
               t."user_id",
               SUM(t."order_value") AS "total_value_2019",
               COUNT(*)             AS "total_orders_2019"
        FROM (
                SELECT o."order_id",
                       o."user_id",
                       SUM(o."num_of_item" * oi."sale_price") AS "order_value"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
                JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                       ON o."order_id" = oi."order_id"
                JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
                       ON o."user_id" = u."id"
                WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
                  AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
                GROUP BY o."order_id", o."user_id"
             ) t
        GROUP BY t."user_id"
     ) agg
LIMIT 20;
```

```sql
--Description: Attach user emails to their average order value and rank the top-10.
SELECT 
       u."email",
       r."avg_order_value_2019"
FROM (
        SELECT 
               agg."user_id",
               agg."total_value_2019" / NULLIF(agg."total_orders_2019",0) AS "avg_order_value_2019"
        FROM (
                SELECT 
                       o."user_id",
                       SUM(o."num_of_item" * oi."sale_price") AS "total_value_2019",
                       COUNT(DISTINCT o."order_id")           AS "total_orders_2019"
                FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
                JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
                     ON o."order_id" = oi."order_id"
                JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
                     ON o."user_id" = u."id"
                WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
                  AND o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
                GROUP BY o."user_id"
             ) agg
     ) r
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
     ON r."user_id" = u."id"
ORDER BY r."avg_order_value_2019" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER QUERY – return the top-10 2019 users’ email addresses ranked by highest average order value.
SELECT 
       u."email"
FROM (
        SELECT 
               o."user_id",
               SUM(o."num_of_item" * oi."sale_price") / COUNT(DISTINCT o."order_id") AS "avg_order_value_2019"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
             ON o."order_id" = oi."order_id"
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
             ON o."user_id" = u."id"
        WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
          AND o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
        GROUP BY o."user_id"
        ORDER BY "avg_order_value_2019" DESC
        LIMIT 10
     ) top
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS" u
     ON top."user_id" = u."id";
```
