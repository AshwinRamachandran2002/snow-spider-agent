--Description: FINAL ANSWER QUERY – return the top-10 2019 users’ email addresses ranked by highest average order value.
SELECT 
       u."email"
FROM (
        SELECT 
               o."user_id",
               SUM(o."num_of_item" * oi."sale_price") / COUNT(DISTINCT o."order_id") AS "avg_order_value_2019"
