Query:
--Description: 8) Bring in the email addresses for those users and sort by average order value (descending)
SELECT
  u."email",
  AVG(oi."sale_price") * COUNT(*) / COUNT(DISTINCT o."order_id") AS "avg_order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"         u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
     ON oi."order_id" = o."order_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY u."email"
ORDER BY "avg_order_value" DESC
LIMIT 20;
