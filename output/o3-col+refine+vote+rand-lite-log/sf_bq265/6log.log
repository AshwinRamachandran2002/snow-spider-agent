```sql
--Description: 1) Inspect how user registration timestamps look like and locate values that belong to 2019
SELECT 
  "id",
  "email",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799999999     -- micro-seconds for 2019
LIMIT 20;
```

```sql
--Description: 2) Quickly verify that some of these 2019-registered users actually placed orders (any year)
SELECT DISTINCT 
  o."user_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"   u
     ON u."id" = o."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT 20;
```

```sql
--Description: 3) Check what an order record created in 2019 looks like (micro-seconds again)
SELECT 
  "order_id",
  "user_id",
  "num_of_item",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799999999     -- orders in 2019
LIMIT 20;
```

```sql
--Description: 4) Make sure there are ORDER_ITEMS attached to an order created in 2019
SELECT 
  oi."order_id",
  oi."product_id",
  oi."sale_price",
  oi."status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE oi."order_id" IN (
      SELECT "order_id"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      WHERE "created_at" BETWEEN 1546300800000000 AND 1577836799999999)
LIMIT 20;
```

```sql
--Description: 5) Compute total revenue (sum of sale_price) for every order created in 2019
SELECT 
  oi."order_id",
  SUM(oi."sale_price") AS "order_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
     ON o."order_id" = oi."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY oi."order_id"
LIMIT 20;
```

```sql
--Description: 6) Compute each user’s total 2019 revenue and order count, then derive average order value (AOV)
SELECT
  o."user_id",
  COUNT(DISTINCT o."order_id")                 AS "order_cnt",
  SUM(oi."sale_price")                         AS "total_revenue",
  SUM(oi."sale_price") / COUNT(DISTINCT o."order_id") AS "avg_order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
     ON oi."order_id" = o."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY o."user_id"
LIMIT 20;
```

```sql
--Description: 7) Restrict to users who BOTH registered in 2019 AND purchased in 2019
SELECT
  o."user_id",
  SUM(oi."sale_price") / COUNT(DISTINCT o."order_id") AS "avg_order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
     ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"        u
     ON u."id" = o."user_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799999999   -- purchase year
  AND u."created_at" BETWEEN 1546300800000000 AND 1577836799999999   -- registration year
GROUP BY o."user_id"
LIMIT 20;
```

```sql
--Description: 8) Bring in the email addresses for those users and sort by average order value (descending)
SELECT
  u."email",
  AVG(oi."sale_price") * COUNT(*) / COUNT(DISTINCT o."order_id") AS "avg_order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"         u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
     ON oi."order_id" = o."order_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY u."email"
ORDER BY "avg_order_value" DESC
LIMIT 20;
```

```sql
--Description: 9) Produce the exact AOV formula requested: (Σ item_count × sale_price) / number_of_orders
WITH order_revenue AS (
    SELECT 
      o."order_id",
      o."user_id",
      SUM(oi."sale_price") AS "order_rev"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
    GROUP BY o."order_id", o."user_id"
)
SELECT 
  u."email",
  SUM(r."order_rev") / COUNT(*) AS "avg_order_value"
FROM order_revenue  r
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
     ON u."id" = r."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY u."email"
ORDER BY "avg_order_value" DESC
LIMIT 20;
```

```sql
--Description: 10) Final query – top-10 emails of 2019 registrants ranked by highest AOV on 2019 purchases
WITH order_revenue AS (
    SELECT 
      o."order_id",
      o."user_id",
      SUM(oi."sale_price") AS "order_rev"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
         ON oi."order_id" = o."order_id"
    WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
    GROUP BY o."order_id", o."user_id"
),
user_aov AS (
    SELECT 
      r."user_id",
      SUM(r."order_rev") / COUNT(*) AS "avg_order_value"
    FROM order_revenue  r
    GROUP BY r."user_id"
)
SELECT 
  u."email",
  a."avg_order_value"
FROM user_aov  a
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
     ON u."id" = a."user_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
ORDER BY a."avg_order_value" DESC
LIMIT 10;
```
