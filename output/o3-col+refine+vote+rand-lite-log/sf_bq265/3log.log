```sql
--Description: Inspect a handful of users who registered in 2019 ( 2019-01-01 ≤ "created_at" < 2020-01-01)
SELECT 
  "id",
  "email",
  "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
--Description: Look at some orders placed in 2019 to confirm the raw numbers and the "num_of_item" column
SELECT 
  "order_id",
  "user_id",
  "status",
  "num_of_item",
  "created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
--Description: Join 2019 users to their 2019 orders (one row per order) to check counts quickly
SELECT 
  u."id"          AS "user_id",
  u."email",
  o."order_id",
  o."num_of_item",
  o."created_at"  AS "order_created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"  u
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
      ON o."user_id" = u."id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
--Description: Peek into ORDER_ITEMS for 2019 orders to verify "sale_price" values
SELECT 
  oi."order_id",
  oi."product_id",
  oi."sale_price",
  oi."created_at"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
WHERE oi."created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
--Description: Combine an order with its first line item to test the num_of_item × sale_price logic
SELECT 
  o."order_id",
  o."num_of_item",
  oi."sale_price",
  (o."num_of_item" * oi."sale_price") AS "calc_order_value"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      ON oi."order_id" = o."order_id"
WHERE o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
--Description: Compute each 2019 order’s value (num_of_item × any one line’s sale_price) for 2019-registered users
SELECT
  u."id"          AS "user_id",
  u."email",
  o."order_id",
  (o."num_of_item" * MIN(oi."sale_price")) AS "order_value"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
      ON o."user_id" = u."id"
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      ON oi."order_id" = o."order_id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
GROUP BY u."id", u."email", o."order_id", o."num_of_item"
LIMIT 20;
```

```sql
--Description: Aggregate to total order value & total order count for each eligible user
SELECT
  derived."user_id",
  derived."email",
  SUM(derived."order_value")  AS "total_value",
  COUNT(*)                    AS "total_orders"
FROM (
    SELECT
      u."id"          AS "user_id",
      u."email",
      o."order_id",
      (o."num_of_item" * MIN(oi."sale_price")) AS "order_value"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
          ON o."user_id" = u."id"
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
          ON oi."order_id" = o."order_id"
    WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
      AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
    GROUP BY u."id", u."email", o."order_id", o."num_of_item"
) derived
GROUP BY derived."user_id", derived."email"
LIMIT 20;
```

```sql
--Description: Compute each user’s average order value (total_value ÷ total_orders) and order by highest AOV
SELECT
  t."user_id",
  t."email",
  (t."total_value" / t."total_orders") AS "avg_order_value"
FROM (
  SELECT
    derived."user_id",
    derived."email",
    SUM(derived."order_value")  AS "total_value",
    COUNT(*)                    AS "total_orders"
  FROM (
      SELECT
        u."id"          AS "user_id",
        u."email",
        o."order_id",
        (o."num_of_item" * MIN(oi."sale_price")) AS "order_value"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
            ON o."user_id" = u."id"
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
            ON oi."order_id" = o."order_id"
      WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
        AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
      GROUP BY u."id", u."email", o."order_id", o."num_of_item"
  ) derived
  GROUP BY derived."user_id", derived."email"
) t
ORDER BY "avg_order_value" DESC
LIMIT 20;
```

```sql
--Description: Return the top-10 emails of 2019-registered users, ranked by the highest average order value
SELECT
  final."email"
FROM (
  SELECT
    t."user_id",
    t."email",
    (t."total_value" / t."total_orders") AS "avg_order_value",
    ROW_NUMBER() OVER (ORDER BY (t."total_value" / t."total_orders") DESC) AS "rn"
  FROM (
    SELECT
      derived."user_id",
      derived."email",
      SUM(derived."order_value")  AS "total_value",
      COUNT(*)                    AS "total_orders"
    FROM (
        SELECT
          u."id"          AS "user_id",
          u."email",
          o."order_id",
          (o."num_of_item" * MIN(oi."sale_price")) AS "order_value"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
              ON o."user_id" = u."id"
        JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
              ON oi."order_id" = o."order_id"
        WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
          AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
        GROUP BY u."id", u."email", o."order_id", o."num_of_item"
    ) derived
    GROUP BY derived."user_id", derived."email"
  ) t
) final
WHERE final."rn" <= 10
ORDER BY final."rn"
LIMIT 20;
```

