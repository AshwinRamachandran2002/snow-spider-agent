Query:
--Description: Compute each user’s average order value (total_value ÷ total_orders) and order by highest AOV
SELECT
  t."user_id",
  t."email",
  (t."total_value" / t."total_orders") AS "avg_order_value"
FROM (
  SELECT
    derived."user_id",
    derived."email",
    SUM(derived."order_value")  AS "total_value",
    COUNT(*)                    AS "total_orders"
  FROM (
      SELECT
        u."id"          AS "user_id",
        u."email",
        o."order_id",
        (o."num_of_item" * MIN(oi."sale_price")) AS "order_value"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"        u
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
            ON o."user_id" = u."id"
      JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
            ON oi."order_id" = o."order_id"
      WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
        AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
      GROUP BY u."id", u."email", o."order_id", o."num_of_item"
  ) derived
  GROUP BY derived."user_id", derived."email"
) t
ORDER BY "avg_order_value" DESC
LIMIT 20;
