```sql
--Description: Preview distinct users who registered during calendar year-2019  
SELECT DISTINCT 
       u."id",
       u."email",
       u."created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"  u
WHERE  u."created_at" BETWEEN 1546300800000000   -- 2019-01-01 00:00:00 (µs)
                          AND 1577836799000000   -- 2019-12-31 23:59:59 (µs)
LIMIT 20;
```

```sql
--Description: List distinct 2019 orders together with the customer who placed them  
SELECT DISTINCT
       o."order_id",
       o."user_id",
       o."num_of_item",
       o."created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
WHERE  o."created_at" BETWEEN 1546300800000000
                          AND 1577836799000000
LIMIT 20;
```

```sql
--Description: Join 2019-registered users with the orders they placed in 2019  
SELECT DISTINCT
       u."email",
       o."order_id",
       o."num_of_item",
       o."created_at" AS "order_created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"  u
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
       ON o."user_id" = u."id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
  AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
--Description: Inspect 2019 order-item lines to see sale prices  
SELECT DISTINCT
       oi."order_id",
       oi."product_id",
       oi."sale_price",
       oi."created_at" AS "order_item_created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
WHERE  oi."created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
--Description: Combine orders and their line items (2019 only) to calculate order-level value  
SELECT DISTINCT
       o."order_id",
       o."user_id",
       o."num_of_item",
       oi."sale_price",
       (o."num_of_item" * oi."sale_price") AS "order_value"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
       ON oi."order_id" = o."order_id"
WHERE  o."created_at"  BETWEEN 1546300800000000 AND 1577836799000000
  AND  oi."created_at" BETWEEN 1546300800000000 AND 1577836799000000
LIMIT 20;
```

```sql
--Description: Aggregate order value per order (handles cases with multiple line items)  
SELECT 
       o."order_id",
       o."user_id",
       SUM(o."num_of_item" * oi."sale_price") AS "total_order_value"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
       ON oi."order_id" = o."order_id"
WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
GROUP BY o."order_id", o."user_id"
LIMIT 20;
```

```sql
--Description: Compute each 2019 user’s average order value based on 2019 purchases  
SELECT
       u."id"                         AS "user_id",
       u."email",
       COUNT(DISTINCT o."order_id")   AS "num_orders_2019",
       SUM(o."num_of_item" * oi."sale_price") / NULLIF(COUNT(DISTINCT o."order_id"),0) 
                                       AS "avg_order_value_2019"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
       ON o."user_id" = u."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
       ON oi."order_id" = o."order_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000   -- user registered 2019
  AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000   -- order placed 2019
GROUP BY u."id", u."email"
LIMIT 20;
```

```sql
--Description: Filter to users with at least one 2019 purchase and order them by average value  
SELECT
       t."email",
       t."avg_order_value_2019"
FROM (
      SELECT
             u."email",
             SUM(o."num_of_item" * oi."sale_price") / NULLIF(COUNT(DISTINCT o."order_id"),0) 
                                                     AS "avg_order_value_2019"
      FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
             ON o."user_id" = u."id"
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
             ON oi."order_id" = o."order_id"
      WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
        AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
      GROUP BY u."email"
) t
ORDER BY t."avg_order_value_2019" DESC
LIMIT 20;
```

```sql
--Description: Same as above but showing only the top-10 email addresses (final answer format)  
SELECT
       t."email"
FROM (
      SELECT
             u."email",
             SUM(o."num_of_item" * oi."sale_price")
             / NULLIF(COUNT(DISTINCT o."order_id"),0) AS "avg_order_value_2019"
      FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."USERS"       u
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"      o
             ON o."user_id" = u."id"
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
             ON oi."order_id" = o."order_id"
      WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799000000
        AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799000000
      GROUP BY u."email"
      ORDER BY "avg_order_value_2019" DESC
      LIMIT 10
) t;
```

