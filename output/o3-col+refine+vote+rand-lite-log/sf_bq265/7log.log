Query:
--Description: Join 2019‐registered users with their 2019 orders
SELECT DISTINCT
       u."id"          AS "user_id",
       u."email",
       o."order_id",
       o."num_of_item",
       o."created_at"  AS "order_created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
       ON u."id" = o."user_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
  AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT  20;
