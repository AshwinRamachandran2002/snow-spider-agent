```sql
--Description: Preview users who registered during calendar year 2019
SELECT DISTINCT
       "id",
       "email",
       "created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
WHERE  "created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT  20;
```

```sql
--Description: Preview orders that were created during calendar year 2019
SELECT DISTINCT
       "order_id",
       "user_id",
       "created_at",
       "num_of_item",
       "status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE  "created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT  20;
```

```sql
--Description: Join 2019‐registered users with their 2019 orders
SELECT DISTINCT
       u."id"          AS "user_id",
       u."email",
       o."order_id",
       o."num_of_item",
       o."created_at"  AS "order_created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
       ON u."id" = o."user_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
  AND  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT  20;
```

```sql
--Description: Inspect order-item rows that were created during 2019
SELECT DISTINCT
       "id"          AS "order_item_id",
       "order_id",
       "product_id",
       "sale_price",
       "created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE  "created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT  20;
```

```sql
--Description: Combine 2019 orders with their order-items to see price vs. quantity
SELECT DISTINCT
       o."order_id",
       o."user_id",
       o."num_of_item",
       oi."sale_price",
       o."created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
       ON o."order_id" = oi."order_id"
WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
LIMIT  20;
```

```sql
--Description: Calculate value of each 2019 order (sum of its line-item sale prices)
SELECT
       o."order_id",
       o."user_id",
       SUM(oi."sale_price") AS "order_value"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
       ON o."order_id" = oi."order_id"
WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY o."order_id",
         o."user_id"
LIMIT  20;
```

```sql
--Description: Aggregate 2019 order counts and total spend for each user
SELECT
       t."user_id",
       COUNT(*)            AS "orders_2019",
       SUM(t."order_value") AS "total_value_2019"
FROM  (
       SELECT o."order_id",
              o."user_id",
              SUM(oi."sale_price") AS "order_value"
       FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
       JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
              ON o."order_id" = oi."order_id"
       WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
       GROUP BY o."order_id",
                o."user_id"
      ) t
GROUP BY t."user_id"
LIMIT  20;
```

```sql
--Description: Compute the average 2019 order value for users who also registered in 2019
SELECT
       u."email",
       ROUND(SUM(t."order_value")/COUNT(*), 2) AS "avg_order_value"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN  (
       SELECT o."order_id",
              o."user_id",
              SUM(oi."sale_price") AS "order_value"
       FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
       JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
              ON o."order_id" = oi."order_id"
       WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
       GROUP BY o."order_id",
                o."user_id"
      ) t
        ON u."id" = t."user_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
GROUP BY u."email"
ORDER BY "avg_order_value" DESC
LIMIT  20;
```

```sql
--Description: Retrieve the top-10 2019 users by highest average order value (emails only)
SELECT
       u."email"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN  (
       SELECT t."user_id",
              ROUND(SUM(t."order_value")/COUNT(*), 2) AS "avg_order_value"
       FROM (
             SELECT o."order_id",
                    o."user_id",
                    SUM(oi."sale_price") AS "order_value"
             FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
             JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                    ON o."order_id" = oi."order_id"
             WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
             GROUP BY o."order_id",
                      o."user_id"
            ) t
       GROUP BY t."user_id"
      ) uavg
        ON u."id" = uavg."user_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
ORDER BY uavg."avg_order_value" DESC
LIMIT  10;
```

```sql
--Description: Same top-10 list but also returning their computed average order value
SELECT
       u."email",
       uavg."avg_order_value"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN  (
       SELECT t."user_id",
              ROUND(SUM(t."order_value")/COUNT(*), 2) AS "avg_order_value"
       FROM (
             SELECT o."order_id",
                    o."user_id",
                    SUM(oi."sale_price") AS "order_value"
             FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
             JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                    ON o."order_id" = oi."order_id"
             WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
             GROUP BY o."order_id",
                      o."user_id"
            ) t
       GROUP BY t."user_id"
      ) uavg
        ON u."id" = uavg."user_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
ORDER BY uavg."avg_order_value" DESC
LIMIT  10;
```
