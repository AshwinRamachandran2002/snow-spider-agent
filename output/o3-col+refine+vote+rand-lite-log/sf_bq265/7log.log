FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
JOIN  (
       SELECT t."user_id",
              ROUND(SUM(t."order_value")/COUNT(*), 2) AS "avg_order_value"
       FROM (
             SELECT o."order_id",
                    o."user_id",
                    SUM(oi."sale_price") AS "order_value"
             FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
             JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
                    ON o."order_id" = oi."order_id"
             WHERE  o."created_at" BETWEEN 1546300800000000 AND 1577836799999999
             GROUP BY o."order_id",
                      o."user_id"
            ) t
       GROUP BY t."user_id"
      ) uavg
        ON u."id" = uavg."user_id"
WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836799999999
ORDER BY uavg."avg_order_value" DESC
LIMIT  10;
