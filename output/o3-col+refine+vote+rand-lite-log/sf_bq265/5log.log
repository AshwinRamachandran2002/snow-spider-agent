```sql
--Description: Preview customers that registered during calendar-year 2019  
SELECT "id",
       "email",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" BETWEEN 1546300800000000 AND 1577836800000000   -- 2019-01-01 to 2019-12-31 (µs)
LIMIT 20;
```

```sql
--Description: Look at orders placed in 2019 that finished with status 'Complete'  
SELECT "order_id",
       "user_id",
       "status",
       "num_of_item",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE "status" = 'Complete'
  AND "created_at" BETWEEN 1546300800000000 AND 1577836800000000
LIMIT 20;
```

```sql
--Description: Join 2019-registered users with their 2019 completed orders  
SELECT o."order_id",
       o."user_id",
       u."email",
       o."num_of_item",
       o."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS  u
     ON o."user_id" = u."id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
  AND o."status"   = 'Complete'
LIMIT 20;
```

```sql
--Description: Sample the order-item rows (with sale_price) belonging to 2019 orders  
SELECT "order_id",
       "user_id",
       "sale_price",
       "product_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE "order_id" IN (
      SELECT "order_id"
      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
      WHERE  "created_at" BETWEEN 1546300800000000 AND 1577836800000000
        AND  "status" = 'Complete')
LIMIT 20;
```

```sql
--Description: Compute a per-order value (num_of_item × sale_price) for the target cohort  
SELECT o."order_id",
       o."user_id",
       MAX(oi."sale_price")          AS "sale_price",      -- choose one sale_price per order
       o."num_of_item",
       o."num_of_item" * MAX(oi."sale_price") AS "order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS        u
     ON o."user_id" = u."id"
WHERE u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
  AND o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
  AND o."status" = 'Complete'
GROUP BY o."order_id", o."user_id", o."num_of_item"
LIMIT 20;
```

```sql
--Description: Aggregate to get each user’s total spend & average order value in 2019  
SELECT t."user_id",
       SUM(t."order_value")                    AS "total_value",
       COUNT(*)                                AS "total_orders",
       ROUND(SUM(t."order_value")/COUNT(*),2)  AS "avg_order_value"
FROM (
      SELECT o."order_id",
             o."user_id",
             o."num_of_item" * MAX(oi."sale_price") AS "order_value"
      FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS      o
      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
             ON o."order_id" = oi."order_id"
      JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS       u
             ON o."user_id" = u."id"
      WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
        AND  o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
        AND  o."status" = 'Complete'
      GROUP BY o."order_id", o."user_id", o."num_of_item"
) t
GROUP BY t."user_id"
LIMIT 20;
```

```sql
--Description: Final request – email addresses of the 10 users with the highest 2019 average order value  
WITH order_values AS (
     SELECT o."order_id",
            o."user_id",
            o."num_of_item" * MAX(oi."sale_price") AS "order_value"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS      o
     JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
            ON o."order_id" = oi."order_id"
     JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS       u
            ON o."user_id" = u."id"
     WHERE  u."created_at" BETWEEN 1546300800000000 AND 1577836800000000
       AND  o."created_at" BETWEEN 1546300800000000 AND 1577836800000000
       AND  o."status" = 'Complete'
     GROUP BY o."order_id", o."user_id", o."num_of_item"
), per_user AS (
     SELECT "user_id",
            SUM("order_value")                        AS "total_value",
            COUNT(*)                                  AS "total_orders",
            SUM("order_value") / COUNT(*)             AS "avg_order_value"
     FROM   order_values
     GROUP BY "user_id"
)
SELECT u."email",
       p."avg_order_value"
FROM   per_user                           p
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
       ON p."user_id" = u."id"
ORDER BY p."avg_order_value" DESC
LIMIT 10;
```
