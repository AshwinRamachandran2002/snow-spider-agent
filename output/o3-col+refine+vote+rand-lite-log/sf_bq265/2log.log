```sql
--Description: Quick look at raw user information
SELECT "id",
       "email",
       "created_at",
       "gender",
       "country"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
LIMIT 20;
```

```sql
--Description: Users who registered in calendar-year 2019
SELECT "id",
       "email",
       TO_TIMESTAMP("created_at"/1000000) AS "created_dt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE TO_TIMESTAMP("created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
--Description: Orders placed during calendar-year 2019
SELECT "order_id",
       "user_id",
       "num_of_item",
       "status",
       TO_TIMESTAMP("created_at"/1000000) AS "order_dt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE TO_TIMESTAMP("created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
--Description: Sample order items that belong to orders created in 2019
SELECT oi."order_id",
       oi."user_id",
       oi."product_id",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS           oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS                o
     ON o."order_id" = oi."order_id"
WHERE TO_TIMESTAMP(o."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
LIMIT 20;
```

```sql
--Description: Order-level revenue (sum of sale_price) for any orders
SELECT oi."order_id",
       SUM(oi."sale_price") AS "order_value"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
GROUP BY oi."order_id"
LIMIT 20;
```

```sql
--Description: Order-level revenue restricted to orders created in 2019
SELECT oi."order_id",
       SUM(oi."sale_price") AS "order_value_2019"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS           oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS                o
     ON o."order_id" = oi."order_id"
WHERE TO_TIMESTAMP(o."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY oi."order_id"
LIMIT 20;
```

```sql
--Description: Combine order counts and total revenue per user (2019 orders only)
SELECT o."user_id",
       COUNT(DISTINCT o."order_id")                AS "orders_2019",
       SUM(oi."sale_price")                        AS "total_revenue_2019"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS          o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS     oi
     ON oi."order_id" = o."order_id"
WHERE TO_TIMESTAMP(o."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY o."user_id"
LIMIT 20;
```

```sql
--Description: Bring in 2019-registered users to see who purchased in 2019
SELECT u."id"                         AS "user_id",
       u."email",
       COUNT(DISTINCT o."order_id")   AS "orders_2019",
       SUM(oi."sale_price")           AS "revenue_2019"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS            u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS           o
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
     ON oi."order_id" = o."order_id"
WHERE TO_TIMESTAMP(u."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
  AND TO_TIMESTAMP(o."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY u."id", u."email"
LIMIT 20;
```

```sql
--Description: Calculate each 2019 user’s average order value
SELECT u."id"                                                   AS "user_id",
       u."email",
       SUM(oi."sale_price") / COUNT(DISTINCT o."order_id")      AS "avg_order_value_2019"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS            u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS           o
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
     ON oi."order_id" = o."order_id"
WHERE TO_TIMESTAMP(u."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
  AND TO_TIMESTAMP(o."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY u."id", u."email"
LIMIT 20;
```

```sql
--Description: Top-10 2019 users by highest average order value (final answer template)
SELECT u."email"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS            u
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS           o
     ON o."user_id" = u."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
     ON oi."order_id" = o."order_id"
WHERE TO_TIMESTAMP(u."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
  AND TO_TIMESTAMP(o."created_at"/1000000) BETWEEN '2019-01-01' AND '2019-12-31'
GROUP BY u."id", u."email"
HAVING COUNT(DISTINCT o."order_id") > 0
ORDER BY SUM(oi."sale_price") / COUNT(DISTINCT o."order_id") DESC
LIMIT 10;
```
