Query:
--Description: (Corrected #8) Compute, for a sample of 20 rows, the integer years-elapsed between each
-- 31-Dec date on which a male Louisiana legislator was serving and that legislator’s very first
-- term-start.  Properly joins legislation_date_dim to legislators_terms via the date-range
-- condition “d.date BETWEEN lt.term_start AND lt.term_end”.
SELECT lt.id_bioguide,
       d.date AS dec31_date,
       CAST( (julianday(d.date) - julianday(f.first_term_start)) / 365.25 AS INTEGER ) AS years_elapsed
FROM legislation_date_dim AS d
JOIN legislators_terms  AS lt  ON d.date BETWEEN lt.term_start AND lt.term_end      -- ← key join
JOIN legislators        AS l   ON l.id_bioguide = lt.id_bioguide
JOIN (
        SELECT id_bioguide,
               MIN(term_start) AS first_term_start
        FROM legislators_terms
        GROUP BY id_bioguide
     ) AS f                ON f.id_bioguide = lt.id_bioguide
WHERE lt.state  = 'LA'
  AND l.gender  = 'M'
  AND substr(d.date, 6) = '12-31'                   -- keep only 31-Dec dates
LIMIT 20
