Query:
--Description: (Corrected #9 – FINAL ANSWER)  For every 31-Dec that falls strictly 30–49 years
-- after each male Louisiana legislator’s first term-start, count how many distinct such
-- legislators were still in office, grouping by the exact integer years_elapsed.
WITH first_terms AS (
    SELECT id_bioguide,
           MIN(term_start) AS first_term_start
    FROM legislators_terms
    GROUP BY id_bioguide
),
dec31_active AS (
    SELECT lt.id_bioguide,
           CAST( (julianday(d.date) - julianday(ft.first_term_start)) / 365.25 AS INTEGER ) AS years_elapsed
    FROM legislation_date_dim AS d
    JOIN legislators_terms   AS lt ON d.date BETWEEN lt.term_start AND lt.term_end   -- proper date join
    JOIN legislators         AS l  ON l.id_bioguide = lt.id_bioguide
    JOIN first_terms         AS ft ON ft.id_bioguide = lt.id_bioguide
    WHERE lt.state  = 'LA'
      AND l.gender  = 'M'
      AND substr(d.date, 6) = '12-31'                     -- only 31-Dec rows
)
SELECT years_elapsed,
       COUNT(DISTINCT id_bioguide) AS num_legislators_active
FROM dec31_active
WHERE years_elapsed > 30
  AND years_elapsed < 50
GROUP BY years_elapsed
ORDER BY years_elapsed
