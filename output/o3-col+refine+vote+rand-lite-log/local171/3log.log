```sql
--Description:
-- We want: for every male legislator from Louisiana (state = 'LA'), determine how many
-- distinct legislators were still serving on each 31-Dec that falls strictly
-- 30-49 years after their very first term-start.  Then group by the exact
-- integer “years elapsed” (31, 32, …, 49) and count those legislators.
--
-- Steps
-- 1. first_terms  : find each legislator’s earliest term_start.
-- 2. Use legislation_date_dim to supply every calendar date, filter to 31-Dec rows.
-- 3. Join date rows to legislators_terms to keep dates that lie inside a term.
-- 4. Keep only male legislators (gender='M') and state='LA'.
-- 5. Compute years_elapsed = integer floor of (date – first_term_start)/365.25.
-- 6. Restrict to 30 < years_elapsed < 50.
-- 7. Group by years_elapsed and count distinct legislators.

WITH first_terms AS (
    SELECT id_bioguide,
           MIN(term_start) AS first_term_start
    FROM legislators_terms
    GROUP BY id_bioguide
),
dec31_active AS (
    SELECT lt.id_bioguide,
           CAST((julianday(d.date) - julianday(ft.first_term_start)) / 365.25 AS INTEGER) AS years_elapsed
    FROM legislation_date_dim AS d
    JOIN legislators_terms   AS lt ON d.date BETWEEN lt.term_start AND lt.term_end
    JOIN legislators         AS l  ON l.id_bioguide = lt.id_bioguide
    JOIN first_terms         AS ft ON ft.id_bioguide = lt.id_bioguide
    WHERE lt.state  = 'LA'
      AND l.gender  = 'M'
      AND substr(d.date, 6) = '12-31'          -- keep only 31-Dec dates
)
SELECT years_elapsed,
       COUNT(DISTINCT id_bioguide) AS num_legislators_active
FROM dec31_active
WHERE years_elapsed > 30
  AND years_elapsed < 50
GROUP BY years_elapsed
ORDER BY years_elapsed;
```
