```sql
-- 1) Preview all distinct state codes that appear in legislators_terms
SELECT DISTINCT "state"
FROM "legislators_terms"
LIMIT 20;
```

```sql
-- 2) List distinct male legislators who have ever served from Louisiana (state = 'LA')
SELECT DISTINCT l."id_bioguide",
       l."full_name"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS t
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'M'
  AND  t."state" = 'LA'
LIMIT 20;
```

```sql
-- 3) Show all terms for those Louisiana male legislators to inspect their career ranges
SELECT t."id_bioguide",
       t."term_number",
       t."term_start",
       t."term_end",
       t."party"
FROM   "legislators_terms"  AS t
WHERE  t."id_bioguide" IN (
          SELECT l."id_bioguide"
          FROM   "legislators" AS l
          WHERE  l."gender" = 'M'
      )
  AND  t."state" = 'LA'
ORDER BY t."id_bioguide",
         t."term_start"
LIMIT 20;
```

```sql
-- 4) Find the first (earliest) term_start date for each Louisiana male legislator
SELECT t."id_bioguide",
       MIN(t."term_start") AS "first_term_start"
FROM   "legislators_terms"  AS t
JOIN   "legislators"        AS l
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'M'
  AND  t."state" = 'LA'
GROUP  BY t."id_bioguide"
LIMIT 20;
```

```sql
-- 5) Inspect December-31 rows available in legislation_date_dim
SELECT DISTINCT d."date"
FROM   "legislation_date_dim" AS d
WHERE  d."month_name" = 'December'
  AND  d."day_of_month" = 31
ORDER  BY d."date"
LIMIT 20;
```

```sql
-- 6) Verify that those December-31 dates fall inside at least one term of Louisiana male legislators
SELECT DISTINCT d."date",
       t."id_bioguide"
FROM   "legislation_date_dim" AS d
JOIN   "legislators_terms"    AS t
       ON d."date" BETWEEN t."term_start" AND t."term_end"
JOIN   "legislators"          AS l
       ON l."id_bioguide" = t."id_bioguide"
WHERE  d."month_name" = 'December'
  AND  d."day_of_month" = 31
  AND  l."gender" = 'M'
  AND  t."state" = 'LA'
LIMIT 20;
```

```sql
-- 7) Compute years elapsed since each legislator's first term for every qualifying December-31 date
SELECT t."id_bioguide",
       d."date"                          AS "dec31_date",
       CAST(substr(d."date",1,4) AS INT) -
       CAST(substr(f."first_term_start",1,4) AS INT) AS "years_elapsed"
FROM   "legislators_terms"    AS t
JOIN   (
         SELECT t2."id_bioguide",
                MIN(t2."term_start") AS "first_term_start"
         FROM   "legislators_terms" t2
         JOIN   "legislators" l2
                ON l2."id_bioguide" = t2."id_bioguide"
         WHERE  l2."gender" = 'M'
           AND  t2."state" = 'LA'
         GROUP BY t2."id_bioguide"
       )                      AS f
       ON f."id_bioguide" = t."id_bioguide"
JOIN   "legislation_date_dim" AS d
       ON d."date" BETWEEN t."term_start" AND t."term_end"
WHERE  d."month_name" = 'December'
  AND  d."day_of_month" = 31
  AND  CAST(substr(d."date",1,4) AS INT) -
      CAST(substr(f."first_term_start",1,4) AS INT) > 30
  AND  CAST(substr(d."date",1,4) AS INT) -
      CAST(substr(f."first_term_start",1,4) AS INT) < 50
LIMIT 20;
```

```sql
-- 8) Same as query 7 but keep only distinct (legislator, years_elapsed) pairs
SELECT DISTINCT t."id_bioguide",
       CAST(substr(d."date",1,4) AS INT) -
       CAST(substr(f."first_term_start",1,4) AS INT) AS "years_elapsed"
FROM   "legislators_terms"    AS t
JOIN   (
         SELECT t2."id_bioguide",
                MIN(t2."term_start") AS "first_term_start"
         FROM   "legislators_terms" t2
         JOIN   "legislators" l2
                ON l2."id_bioguide" = t2."id_bioguide"
         WHERE  l2."gender" = 'M'
           AND  t2."state" = 'LA'
         GROUP BY t2."id_bioguide"
       )                      AS f
       ON f."id_bioguide" = t."id_bioguide"
JOIN   "legislation_date_dim" AS d
       ON d."date" BETWEEN t."term_start" AND t."term_end"
WHERE  d."month_name" = 'December'
  AND  d."day_of_month" = 31
  AND  CAST(substr(d."date",1,4) AS INT) -
      CAST(substr(f."first_term_start",1,4) AS INT) > 30
  AND  CAST(substr(d."date",1,4) AS INT) -
      CAST(substr(f."first_term_start",1,4) AS INT) < 50
LIMIT 20;
```

```sql
-- 9) FINAL ANSWER:
--    Count how many distinct Louisiana male legislators were serving on
--    December 31 of every year that is >30 and <50 years after their first term,
--    and group by that exact years_elapsed value.
SELECT CAST(substr(d."date",1,4) AS INT) -
       CAST(substr(f."first_term_start",1,4) AS INT)    AS "years_elapsed",
       COUNT(DISTINCT t."id_bioguide")                  AS "num_legislators"
FROM   "legislators_terms"    AS t
JOIN   (
         SELECT t2."id_bioguide",
                MIN(t2."term_start") AS "first_term_start"
         FROM   "legislators_terms" t2
         JOIN   "legislators" l2
                ON l2."id_bioguide" = t2."id_bioguide"
         WHERE  l2."gender" = 'M'
           AND  t2."state" = 'LA'
         GROUP BY t2."id_bioguide"
       )                      AS f
       ON f."id_bioguide" = t."id_bioguide"
JOIN   "legislation_date_dim" AS d
       ON d."date" BETWEEN t."term_start" AND t."term_end"
WHERE  d."month_name" = 'December'
  AND  d."day_of_month" = 31
  AND  (CAST(substr(d."date",1,4) AS INT) -
        CAST(substr(f."first_term_start",1,4) AS INT)) > 30
  AND  (CAST(substr(d."date",1,4) AS INT) -
        CAST(substr(f."first_term_start",1,4) AS INT)) < 50
GROUP BY "years_elapsed"
ORDER BY "years_elapsed"
LIMIT 20;
```

```sql
-- 10) (Optional deeper dive) Show which legislators contribute to each years_elapsed bucket
SELECT CAST(substr(d."date",1,4) AS INT) -
       CAST(substr(f."first_term_start",1,4) AS INT) AS "years_elapsed",
       l."full_name",
       d."date" AS "dec31_date"
FROM   "legislators_terms"    AS t
JOIN   (
         SELECT t2."id_bioguide",
                MIN(t2."term_start") AS "first_term_start"
         FROM   "legislators_terms" t2
         JOIN   "legislators" l2
                ON l2."id_bioguide" = t2."id_bioguide"
         WHERE  l2."gender" = 'M'
           AND  t2."state" = 'LA'
         GROUP BY t2."id_bioguide"
       )                      AS f
       ON f."id_bioguide" = t."id_bioguide"
JOIN   "legislators"          AS l
       ON l."id_bioguide" = t."id_bioguide"
JOIN   "legislation_date_dim" AS d
       ON d."date" BETWEEN t."term_start" AND t."term_end"
WHERE  d."month_name" = 'December'
  AND  d."day_of_month" = 31
  AND  CAST(substr(d."date",1,4) AS INT) -
      CAST(substr(f."first_term_start",1,4) AS INT) > 30
  AND  CAST(substr(d."date",1,4) AS INT) -
      CAST(substr(f."first_term_start",1,4) AS INT) < 50
GROUP BY l."id_bioguide", "years_elapsed"
ORDER BY "years_elapsed", l."full_name"
LIMIT 20;
```
