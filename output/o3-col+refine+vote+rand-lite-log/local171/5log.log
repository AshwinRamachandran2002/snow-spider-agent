           FROM   "legislators"
           WHERE  "gender" = 'M')
ORDER BY lt."id_bioguide",
         lt."term_start"
LIMIT 20;
```

```sql
-- 4) First‐ever term_start for every male legislator from Louisiana
SELECT lt."id_bioguide",
       MIN(lt."term_start") AS "first_term_start"
FROM   "legislators_terms" AS lt
WHERE  lt."state" = 'LA'
  AND  lt."id_bioguide" IN (
           SELECT "id_bioguide"
           FROM   "legislators"
           WHERE  "gender" = 'M')
GROUP BY lt."id_bioguide"
LIMIT 20;
```

```sql
-- 5) All December-31 dates that exist in the calendar dimension
SELECT DISTINCT substr(d."date",1,4)  AS "yyyy",
       d."date"
FROM   "legislation_date_dim" AS d
WHERE  d."date" LIKE '%-12-31'
ORDER BY d."date"
LIMIT 20;
```

```sql
-- 6) Build (legislator × Dec-31 date) records WHEN the legislator
--    was actively serving on that December 31
SELECT lt."id_bioguide",
       d."date"  AS "dec31_date",
       lt."term_start",
       lt."term_end"
FROM   "legislators_terms"  AS lt
JOIN   "legislation_date_dim" AS d
       ON d."date" LIKE '%-12-31'
WHERE  lt."state"  = 'LA'
  AND  lt."id_bioguide" IN (
           SELECT "id_bioguide"
           FROM   "legislators"
           WHERE  "gender" = 'M')
  AND  lt."term_start" <= d."date"
  AND  lt."term_end"   >= d."date"
ORDER BY lt."id_bioguide",
         d."date"
LIMIT 20;
```

```sql
-- 7) Add “years since FIRST term” to every active-Dec-31 row
WITH first_term AS (
     SELECT lt."id_bioguide",
            MIN(lt."term_start") AS first_start
     FROM   "legislators_terms" AS lt
     WHERE  lt."state" = 'LA'
       AND  lt."id_bioguide" IN (
                SELECT "id_bioguide"
                FROM   "legislators"
                WHERE  "gender" = 'M')
     GROUP BY lt."id_bioguide"
)
SELECT a."id_bioguide",
       a."dec31_date",
       CAST(strftime('%Y',a."dec31_date") AS INTEGER)
       - CAST(substr(f.first_start,1,4)   AS INTEGER)  AS "years_elapsed"
FROM (
     SELECT lt."id_bioguide",
            d."date" AS dec31_date
     FROM   "legislators_terms" AS lt
     JOIN   "legislation_date_dim" AS d
            ON d."date" LIKE '%-12-31'
     WHERE  lt."state" = 'LA'
       AND  lt."id_bioguide" IN (
                SELECT "id_bioguide"
                FROM   "legislators"
                WHERE  "gender" = 'M')
       AND  lt."term_start" <= d."date"
       AND  lt."term_end"   >= d."date"
) AS a
JOIN first_term AS f
  ON a."id_bioguide" = f."id_bioguide"
ORDER BY a."id_bioguide",
         a."dec31_date"
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER
--    For each exact “years_elapsed” ( >30 and <50 ),
--    count DISTINCT male LA legislators serving on that Dec-31
WITH male_la AS (
     SELECT l."id_bioguide"
     FROM   "legislators" AS l
     WHERE  l."gender" = 'M'
),
first_term AS (
     SELECT lt."id_bioguide",
            MIN(lt."term_start") AS first_start
     FROM   "legislators_terms" AS lt
     JOIN   male_la            AS m  ON m."id_bioguide" = lt."id_bioguide"
     WHERE  lt."state" = 'LA'
     GROUP BY lt."id_bioguide"
),
dec31 AS (
     SELECT DISTINCT d."date",
            CAST(strftime('%Y',d."date") AS INTEGER) AS yr
     FROM   "legislation_date_dim" AS d
     WHERE  d."date" LIKE '%-12-31'
),
active AS (
     SELECT lt."id_bioguide",
            d.yr,
            f.first_start
     FROM   "legislators_terms" AS lt
     JOIN   dec31              AS d
            ON lt."term_start" <= d."date"
           AND lt."term_end"   >= d."date"
     JOIN   first_term         AS f
            ON f."id_bioguide" = lt."id_bioguide"
     WHERE  lt."state" = 'LA'
)
SELECT (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) AS "years_elapsed",
       COUNT(DISTINCT a."id_bioguide")                      AS "num_legislators"
FROM   active      AS a
JOIN   first_term  AS f  ON f."id_bioguide" = a."id_bioguide"
JOIN   dec31       AS d  ON d.yr           = a.yr
WHERE  (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) > 30
  AND  (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) < 50
GROUP BY "years_elapsed"
ORDER BY "years_elapsed"
LIMIT 20;
```

Each step progressively explores the needed pieces—Louisiana male legislators, their terms, December-31 calendar dates, computing years-elapsed—before the final query aggregates the count of distinct legislators for every “years since first term” (strictly > 30 and < 50), exactly as requested.
