JOIN   first_term  AS f  ON f."id_bioguide" = a."id_bioguide"
JOIN   dec31       AS d  ON d.yr           = a.yr
WHERE  (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) > 30
  AND  (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) < 50
GROUP BY "years_elapsed"
ORDER BY "years_elapsed"
LIMIT 20;
