-- 8) FINAL ANSWER
--    For each exact “years_elapsed” ( >30 and <50 ),
--    count DISTINCT male LA legislators serving on that Dec-31
WITH male_la AS (
     SELECT l."id_bioguide"
     FROM   "legislators" AS l
     WHERE  l."gender" = 'M'
),
first_term AS (
     SELECT lt."id_bioguide",
            MIN(lt."term_start") AS first_start
     FROM   "legislators_terms" AS lt
     JOIN   male_la            AS m  ON m."id_bioguide" = lt."id_bioguide"
     WHERE  lt."state" = 'LA'
     GROUP BY lt."id_bioguide"
),
dec31 AS (
     SELECT DISTINCT d."date",
            CAST(strftime('%Y',d."date") AS INTEGER) AS yr
     FROM   "legislation_date_dim" AS d
     WHERE  d."date" LIKE '%-12-31'
),
active AS (
     SELECT lt."id_bioguide",
            d.yr,
            f.first_start
     FROM   "legislators_terms" AS lt
     JOIN   dec31              AS d
            ON lt."term_start" <= d."date"
           AND lt."term_end"   >= d."date"
     JOIN   first_term         AS f
            ON f."id_bioguide" = lt."id_bioguide"
     WHERE  lt."state" = 'LA'
)
SELECT (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) AS "years_elapsed",
       COUNT(DISTINCT a."id_bioguide")                      AS "num_legislators"
FROM   active      AS a
JOIN   first_term  AS f  ON f."id_bioguide" = a."id_bioguide"
JOIN   dec31       AS d  ON d.yr           = a.yr
WHERE  (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) > 30
  AND  (d.yr - CAST(substr(f.first_start,1,4) AS INTEGER)) < 50
GROUP BY "years_elapsed"
ORDER BY "years_elapsed"
LIMIT 20;
