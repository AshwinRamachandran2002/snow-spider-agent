-- 7) Add “years since FIRST term” to every active-Dec-31 row
WITH first_term AS (
     SELECT lt."id_bioguide",
            MIN(lt."term_start") AS first_start
     FROM   "legislators_terms" AS lt
     WHERE  lt."state" = 'LA'
       AND  lt."id_bioguide" IN (
                SELECT "id_bioguide"
                FROM   "legislators"
                WHERE  "gender" = 'M')
     GROUP BY lt."id_bioguide"
)
SELECT a."id_bioguide",
       a."dec31_date",
       CAST(strftime('%Y',a."dec31_date") AS INTEGER)
       - CAST(substr(f.first_start,1,4)   AS INTEGER)  AS "years_elapsed"
FROM (
     SELECT lt."id_bioguide",
            d."date" AS dec31_date
     FROM   "legislators_terms" AS lt
     JOIN   "legislation_date_dim" AS d
            ON d."date" LIKE '%-12-31'
     WHERE  lt."state" = 'LA'
       AND  lt."id_bioguide" IN (
                SELECT "id_bioguide"
                FROM   "legislators"
                WHERE  "gender" = 'M')
       AND  lt."term_start" <= d."date"
       AND  lt."term_end"   >= d."date"
) AS a
JOIN first_term AS f
  ON a."id_bioguide" = f."id_bioguide"
ORDER BY a."id_bioguide",
         a."dec31_date"
LIMIT 20;
