Query:
--7. Add the number of whole years since each legislator’s first term to every matching Dec 31 date
SELECT lt."id_bioguide",
       d."date"                                             AS "dec31_date",
       CAST(substr(d."date",1,4) AS INT) -
       CAST(substr(f."first_term_start",1,4) AS INT)        AS "years_since_first"
FROM   "legislators_terms" AS lt
JOIN   "legislators"       AS l  ON l."id_bioguide" = lt."id_bioguide"
JOIN   (SELECT "id_bioguide",
              MIN("term_start") AS "first_term_start"
       FROM   "legislators_terms"
       GROUP BY "id_bioguide")        AS f
       ON f."id_bioguide" = lt."id_bioguide"
JOIN   "legislation_date_dim" AS d
       ON d."date" LIKE '%-12-31'
WHERE  l."gender" = 'M'
  AND  lt."state" = 'LA'
  AND  lt."term_start" <= d."date"
  AND  lt."term_end"   >= d."date"
LIMIT 20;
