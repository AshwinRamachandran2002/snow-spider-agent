```sql
--1. Preview the different gender values recorded for legislators
SELECT DISTINCT "gender"
FROM "legislators"
LIMIT 20;
```

```sql
--2. List male legislators who have at least one term for the state of Louisiana (LA)
SELECT DISTINCT l."id_bioguide",
                l."full_name"
FROM   "legislators"         AS l
JOIN   "legislators_terms"   AS t  ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'M'
  AND  t."state" = 'LA'
LIMIT 20;
```

```sql
--3. Inspect the term records that belong to the male Louisiana legislators
SELECT *
FROM   "legislators_terms"
WHERE  "id_bioguide" IN (
        SELECT l."id_bioguide"
        FROM   "legislators"       AS l
        JOIN   "legislators_terms" AS t
               ON l."id_bioguide" = t."id_bioguide"
        WHERE  l."gender" = 'M'
          AND  t."state"  = 'LA')
LIMIT 20;
```

```sql
--4. Find each male Louisiana legislator’s first-ever term start date
SELECT t."id_bioguide",
       MIN(t."term_start") AS "first_term_start"
FROM   "legislators_terms" AS t
JOIN   "legislators"       AS l
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'M'
  AND  t."state"  = 'LA'
GROUP BY t."id_bioguide"
LIMIT 20;
```

```sql
--5. Pull all calendar dates that are December 31 in the date dimension table
SELECT "date"
FROM   "legislation_date_dim"
WHERE  "date" LIKE '%-12-31'
LIMIT 20;
```

```sql
--6. Show every combination where a male Louisiana legislator was in office on a Dec 31 date
SELECT lt."id_bioguide",
       lt."term_start",
       lt."term_end",
       d."date"              AS "dec31_date"
FROM   "legislators_terms"   AS lt
JOIN   "legislators"         AS l  ON l."id_bioguide" = lt."id_bioguide"
JOIN   "legislation_date_dim" AS d ON d."date" LIKE '%-12-31'
WHERE  l."gender" = 'M'
  AND  lt."state" = 'LA'
  AND  lt."term_start" <= d."date"
  AND  lt."term_end"   >= d."date"
LIMIT 20;
```

```sql
--7. Add the number of whole years since each legislator’s first term to every matching Dec 31 date
SELECT lt."id_bioguide",
       d."date"                                             AS "dec31_date",
       CAST(substr(d."date",1,4) AS INT) -
       CAST(substr(f."first_term_start",1,4) AS INT)        AS "years_since_first"
FROM   "legislators_terms" AS lt
JOIN   "legislators"       AS l  ON l."id_bioguide" = lt."id_bioguide"
JOIN   (SELECT "id_bioguide",
              MIN("term_start") AS "first_term_start"
       FROM   "legislators_terms"
       GROUP BY "id_bioguide")        AS f
       ON f."id_bioguide" = lt."id_bioguide"
JOIN   "legislation_date_dim" AS d
       ON d."date" LIKE '%-12-31'
WHERE  l."gender" = 'M'
  AND  lt."state" = 'LA'
  AND  lt."term_start" <= d."date"
  AND  lt."term_end"   >= d."date"
LIMIT 20;
```

```sql
--8. Keep only the Dec 31 records that fall strictly >30 and <50 years after the first term
SELECT *
FROM (
      SELECT lt."id_bioguide",
             CAST(substr(d."date",1,4) AS INT) -
             CAST(substr(f."first_term_start",1,4) AS INT) AS "years_since_first"
      FROM   "legislators_terms" AS lt
      JOIN   "legislators"       AS l  ON l."id_bioguide" = lt."id_bioguide"
      JOIN   (SELECT "id_bioguide",
                     MIN("term_start") AS "first_term_start"
              FROM   "legislators_terms"
              GROUP BY "id_bioguide") AS f
              ON f."id_bioguide" = lt."id_bioguide"
      JOIN   "legislation_date_dim" AS d
              ON d."date" LIKE '%-12-31'
      WHERE  l."gender" = 'M'
        AND  lt."state" = 'LA'
        AND  lt."term_start" <= d."date"
        AND  lt."term_end"   >= d."date"
     ) AS sub
WHERE  sub."years_since_first" > 30
  AND  sub."years_since_first" < 50
LIMIT 20;
```

```sql
--9. Count how many distinct male Louisiana legislators were active on each qualifying Dec 31,
--   grouped by the exact number of years since their first term
SELECT sub."years_since_first"                                  AS "years_elapsed_since_first_term",
       COUNT(DISTINCT sub."id_bioguide")                        AS "distinct_legislators_active_on_dec_31"
FROM (
      SELECT lt."id_bioguide",
             CAST(substr(d."date",1,4) AS INT) -
             CAST(substr(f."first_term_start",1,4) AS INT) AS "years_since_first"
      FROM   "legislators_terms" AS lt
      JOIN   "legislators"       AS l  ON l."id_bioguide" = lt."id_bioguide"
      JOIN   (SELECT "id_bioguide",
                     MIN("term_start") AS "first_term_start"
              FROM   "legislators_terms"
              GROUP BY "id_bioguide") AS f
              ON f."id_bioguide" = lt."id_bioguide"
      JOIN   "legislation_date_dim" AS d
              ON d."date" LIKE '%-12-31'
      WHERE  l."gender" = 'M'
        AND  lt."state" = 'LA'
        AND  lt."term_start" <= d."date"
        AND  lt."term_end"   >= d."date"
     ) AS sub
WHERE  sub."years_since_first" > 30
  AND  sub."years_since_first" < 50
GROUP BY sub."years_since_first"
ORDER BY sub."years_since_first"
LIMIT 20;
```

```sql
--10. FINAL ANSWER (no LIMIT) – how many distinct male Louisiana legislators were
--    active on Dec 31 for each elapsed-year bucket (>30 & <50)
SELECT sub."years_since_first"                                  AS "years_elapsed_since_first_term",
       COUNT(DISTINCT sub."id_bioguide")                        AS "distinct_legislators_active_on_dec_31"
FROM (
      SELECT lt."id_bioguide",
             CAST(substr(d."date",1,4) AS INT) -
             CAST(substr(f."first_term_start",1,4) AS INT) AS "years_since_first"
      FROM   "legislators_terms" AS lt
      JOIN   "legislators"       AS l  ON l."id_bioguide" = lt."id_bioguide"
      JOIN   (SELECT "id_bioguide",
                     MIN("term_start") AS "first_term_start"
              FROM   "legislators_terms"
              GROUP BY "id_bioguide") AS f
              ON f."id_bioguide" = lt."id_bioguide"
      JOIN   "legislation_date_dim" AS d
              ON d."date" LIKE '%-12-31'
      WHERE  l."gender" = 'M'
        AND  lt."state" = 'LA'
        AND  lt."term_start" <= d."date"
        AND  lt."term_end"   >= d."date"
     ) AS sub
WHERE  sub."years_since_first" > 30
  AND  sub."years_since_first" < 50
GROUP BY sub."years_since_first"
ORDER BY sub."years_since_first";
```
