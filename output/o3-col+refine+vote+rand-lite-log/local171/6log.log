-- 7. Attach the first-term year to every (legislator, year) row
WITH first_term AS (
     SELECT t."id_bioguide",
            CAST(strftime('%Y', MIN(t."term_start")) AS INTEGER) AS "first_year"
     FROM   "legislators_terms" AS t
     GROUP  BY t."id_bioguide"
),
term_years AS (
     SELECT t."id_bioguide",
            y."yr",
            f."first_year"
     FROM   (
             /* reuse the recursive logic from Query 6 */
             WITH RECURSIVE rec AS (
                 SELECT t."id_bioguide",
                        CAST(strftime('%Y', t."term_start") AS INTEGER) AS "yr",
                        CAST(strftime('%Y', t."term_end")   AS INTEGER) AS "yr_end",
                        t."term_start",
                        t."term_end"
                 FROM   "legislators_terms" AS t
                 WHERE  t."state" = 'LA'
                 UNION ALL
                 SELECT "id_bioguide",
                        "yr" + 1,
                        "yr_end",
                        "term_start",
                        "term_end"
                 FROM   rec
                 WHERE  "yr" + 1 <= "yr_end"
             )
             SELECT "id_bioguide", "yr"
             FROM   rec
     ) AS y
     JOIN first_term AS f USING ("id_bioguide")
)
SELECT *
FROM   term_years
WHERE  ("yr" - "first_year") BETWEEN 31 AND 35     -- sanity check
LIMIT 20;
