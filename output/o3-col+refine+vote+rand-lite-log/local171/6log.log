-- 6. Build a recursive list of every calendar-year that each term covers
WITH RECURSIVE term_years AS (
    SELECT t."id_bioguide",
           CAST(strftime('%Y', t."term_start") AS INTEGER) AS "yr",
           CAST(strftime('%Y', t."term_end")   AS INTEGER) AS "yr_end",
           t."term_start",
           t."term_end"
    FROM   "legislators_terms" AS t
    WHERE  t."state" = 'LA'
    UNION ALL
    SELECT "id_bioguide",
           "yr" + 1,
           "yr_end",
           "term_start",
           "term_end"
    FROM   term_years
    WHERE  "yr" + 1 <= "yr_end"
)
SELECT *
FROM   term_years
WHERE  "yr" BETWEEN 1980 AND 1990       -- just a peek
LIMIT 20;
