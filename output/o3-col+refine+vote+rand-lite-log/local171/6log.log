```sql
--Description:  Determine, for every exact number of years (31–49) after a male Louisiana
--              legislator’s first term began, how many of those legislators were still
--              serving on December 31 of that year.
--  • male_la     : all legislators whose gender = 'M' and who have at least one term for LA.  
--  • first_term  : first year each of those legislators entered Congress.  
--  • term_years  : explode every Louisiana term into its individual calendar years (via recursion).  
--  • dec31_active: keep only (legislator, year) pairs where Dec-31 falls inside that term.  
--  • elapsed     : calculate years-elapsed since first term and retain 31 ≤ elapsed < 50.  
--  • Final SELECT: group by elapsed years and count distinct legislators.
WITH male_la AS (
    SELECT DISTINCT l."id_bioguide"
    FROM   "legislators"        AS l
    JOIN   "legislators_terms"  AS t  ON t."id_bioguide" = l."id_bioguide"
    WHERE  l."gender" = 'M'
      AND  t."state"  = 'LA'
),
first_term AS (
    SELECT t."id_bioguide",
           CAST(strftime('%Y', MIN(t."term_start")) AS INTEGER) AS first_year
    FROM   "legislators_terms" AS t
    JOIN   male_la             AS m USING ("id_bioguide")
    GROUP  BY t."id_bioguide"
),
RECURSIVE term_years AS (
    SELECT t."id_bioguide",
           CAST(strftime('%Y', t."term_start") AS INTEGER) AS yr,
           CAST(strftime('%Y', t."term_end")   AS INTEGER) AS yr_end,
           t."term_start",
           t."term_end"
    FROM   "legislators_terms" AS t
    JOIN   male_la             AS m USING ("id_bioguide")
    WHERE  t."state" = 'LA'
    UNION ALL
    SELECT "id_bioguide",
           yr + 1,
           yr_end,
           "term_start",
           "term_end"
    FROM   term_years
    WHERE  yr + 1 <= yr_end
),
dec31_active AS (
    SELECT ty."id_bioguide",
           ty.yr
    FROM   term_years AS ty
    WHERE  date(ty.yr || '-12-31') BETWEEN ty."term_start" AND ty."term_end"
),
elapsed AS (
    SELECT da."id_bioguide",
           da.yr,
           (da.yr - ft.first_year) AS yrs_elapsed
    FROM   dec31_active AS da
    JOIN   first_term    AS ft USING ("id_bioguide")
    WHERE  (da.yr - ft.first_year) > 30
      AND  (da.yr - ft.first_year) < 50
)
SELECT yrs_elapsed  AS years_since_first_term,
       COUNT(DISTINCT id_bioguide) AS num_legislators_active
FROM   elapsed
GROUP  BY yrs_elapsed
ORDER  BY yrs_elapsed;
```
