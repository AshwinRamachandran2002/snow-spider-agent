--Description:  #9  – For male Louisiana legislators, count how many were active on
--               December 31 of every calendar-year that is 31–49 years after their first term.
WITH RECURSIVE
    male_la AS (                       -- male legislators who served LA
        SELECT DISTINCT l."id_bioguide"
        FROM   "legislators"        AS l
        JOIN   "legislators_terms"  AS t  ON t."id_bioguide" = l."id_bioguide"
        WHERE  l."gender" = 'M'
          AND  t."state"  = 'LA'
    ),
    first_term AS (                   -- first year each of them started
        SELECT t."id_bioguide",
               CAST(strftime('%Y', MIN(t."term_start")) AS INTEGER) AS first_year
        FROM   "legislators_terms" AS t
        JOIN   male_la             AS m USING ("id_bioguide")
        GROUP  BY t."id_bioguide"
    ),
    term_years(id_bioguide, yr, yr_end, term_start, term_end) AS (  -- explode into calendar-years
        SELECT t."id_bioguide",
               CAST(strftime('%Y', t."term_start") AS INTEGER) AS yr,
               CAST(strftime('%Y', t."term_end")   AS INTEGER) AS yr_end,
               t."term_start",
               t."term_end"
        FROM   "legislators_terms" AS t
        JOIN   male_la             AS m USING ("id_bioguide")
        WHERE  t."state" = 'LA'
        UNION ALL
        SELECT id_bioguide,
               yr + 1,
               yr_end,
               term_start,
               term_end
        FROM   term_years
        WHERE  yr + 1 <= yr_end
    ),
    dec31_active AS (                 -- only rows where 31-Dec is inside the term
        SELECT ty."id_bioguide",
               ty.yr,
               ft.first_year,
               (ty.yr - ft.first_year) AS yrs_elapsed
        FROM   term_years  AS ty
        JOIN   first_term  AS ft USING ("id_bioguide")
        JOIN   "legislators" AS l  ON l."id_bioguide" = ty."id_bioguide"
        WHERE  l."gender" = 'M'
          AND  (ty.yr - ft.first_year) > 30
          AND  (ty.yr - ft.first_year) < 50
          AND  date(ty.yr || '-12-31') BETWEEN ty.term_start AND ty.term_end
    )
SELECT yrs_elapsed  AS years_since_first_term,
       COUNT(DISTINCT id_bioguide) AS num_legislators_active
FROM   dec31_active
GROUP  BY yrs_elapsed
ORDER  BY yrs_elapsed
