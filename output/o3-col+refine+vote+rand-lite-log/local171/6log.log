```sql
-- 8. Make sure the year’s DEC-31 actually lies inside the term-dates
WITH years AS (
     SELECT t."id_bioguide",
            CAST(strftime('%Y', t."term_start") AS INTEGER) AS "yr_start",
            CAST(strftime('%Y', t."term_end")   AS INTEGER) AS "yr_end",
            t."term_start",
            t."term_end"
     FROM   "legislators_terms" AS t
     WHERE  t."state" = 'LA'
),
RECURSIVE cal AS (
     SELECT "id_bioguide",
            "yr_start" AS "yr",
            "term_start",
            "term_end"
     FROM   years
     UNION ALL
     SELECT "id_bioguide",
            "yr" + 1,
            "term_start",
            "term_end"
     FROM   cal
     WHERE  "yr" + 1 <= CAST(strftime('%Y', "term_end") AS INTEGER)
),
dec31_in_term AS (
     SELECT c."id_bioguide",
            c."yr",
            date(c."yr" || '-12-31') AS "dec31",
            c."term_start",
            c."term_end"
     FROM   cal AS c
     WHERE  date(c."yr" || '-12-31') BETWEEN c."term_start" AND c."term_end"
)
SELECT *
FROM   dec31_in_term
LIMIT 20;
```

```sql
-- 9. Filter to Louisiana MALE legislators and keep years where
--    31 ≤ elapsed < 50, then count distinct legislators for each exact elapsed year
WITH first_term AS (
     SELECT t."id_bioguide",
            CAST(strftime('%Y', MIN(t."term_start")) AS INTEGER) AS "first_year"
     FROM   "legislators_terms" AS t
     GROUP  BY t."id_bioguide"
),
-- generate every year of every term for LA legislators
RECURSIVE term_years AS (
     SELECT t."id_bioguide",
            CAST(strftime('%Y', t."term_start") AS INTEGER) AS "yr",
            CAST(strftime('%Y', t."term_end")   AS INTEGER) AS "yr_end",
            t."term_start",
            t."term_end"
     FROM   "legislators_terms" AS t
     WHERE  t."state" = 'LA'
     UNION ALL
     SELECT "id_bioguide",
            "yr" + 1,
            "yr_end",
            "term_start",
            "term_end"
     FROM   term_years
     WHERE  "yr" + 1 <= "yr_end"
),
dec31_active AS (
     SELECT ty."id_bioguide",
            ty."yr",
            ft."first_year",
            ("yr" - ft."first_year") AS "yrs_elapsed"
     FROM   term_years  AS ty
     JOIN   first_term  AS ft
            ON ft."id_bioguide" = ty."id_bioguide"
     JOIN   "legislators" AS l
            ON l."id_bioguide" = ty."id_bioguide"
     WHERE  l."gender" = 'M'
       AND  ("yrs_elapsed" > 30 AND "yrs_elapsed" < 50)
       AND  date(ty."yr" || '-12-31') BETWEEN ty."term_start" AND ty."term_end"
)
SELECT "yrs_elapsed"                           AS "years_since_first_term",
       COUNT(DISTINCT "id_bioguide")           AS "num_legislators_active"
FROM   dec31_active
GROUP  BY "yrs_elapsed"
ORDER  BY "yrs_elapsed";
```

