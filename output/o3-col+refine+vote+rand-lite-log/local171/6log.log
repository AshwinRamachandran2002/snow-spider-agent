Query:
--Description:  #8  – Verify that December 31 of each calendar year truly lies inside the
--               Louisiana term-dates.  A single WITH RECURSIVE chain is used so SQLite
--               accepts the recursion.
WITH RECURSIVE
    years AS (           -- raw term boundaries (one row per term)
        SELECT "id_bioguide",
               CAST(strftime('%Y', "term_start") AS INTEGER) AS yr_start,
               CAST(strftime('%Y', "term_end")   AS INTEGER) AS yr_end,
               "term_start",
               "term_end"
        FROM   "legislators_terms"
        WHERE  "state" = 'LA'
    ),
    cal AS (             -- expand each term into its individual calendar-years
        SELECT "id_bioguide",
               yr_start AS yr,
               "term_start",
               "term_end"
        FROM   years
        UNION ALL
        SELECT "id_bioguide",
               yr + 1,
               "term_start",
               "term_end"
        FROM   cal
        WHERE  yr + 1 <= CAST(strftime('%Y', "term_end") AS INTEGER)
    ),
    dec31_in_term AS (   -- keep only the rows whose 31-Dec lies within the term
        SELECT c."id_bioguide",
               c.yr,
               date(c.yr || '-12-31') AS dec31,
               c."term_start",
               c."term_end"
        FROM   cal AS c
        WHERE  date(c.yr || '-12-31') BETWEEN c."term_start" AND c."term_end"
    )
SELECT *
FROM   dec31_in_term
LIMIT 20
