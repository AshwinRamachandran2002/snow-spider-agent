```sql
--Description: We need to know, for every male legislator from Louisiana (LA),
--             how many of them were still serving on 31-Dec of each calendar
--             year that falls 31-49 years after their very first term began.
--             Logical steps (all packed into CTEs):
--  1) male_la     – identify the Bioguide IDs of all male legislators who ever served LA.
--  2) first_term  – find the first year each of those legislators started serving.
--  3) term_years  – expand every LA term into its individual calendar-years via recursion.
--  4) dec31_in    – keep only those (legislator, year) rows where 31-Dec lies inside the term.
--  5) elapsed     – compute “yrs_elapsed = year − first_year” and keep 31 ≤ yrs_elapsed < 50.
--  6) Final SELECT groups by yrs_elapsed and counts distinct legislators.
WITH RECURSIVE
    male_la AS (
        SELECT DISTINCT l."id_bioguide"
        FROM   "legislators"        AS l
        JOIN   "legislators_terms"  AS t
               ON l."id_bioguide" = t."id_bioguide"
        WHERE  l."gender" = 'M'
          AND  t."state"  = 'LA'
    ),
    first_term AS (
        SELECT t."id_bioguide",
               CAST(strftime('%Y', MIN(t."term_start")) AS INTEGER) AS first_year
        FROM   "legislators_terms" AS t
        JOIN   male_la             AS m USING ("id_bioguide")
        GROUP  BY t."id_bioguide"
    ),
    term_years(id_bioguide, yr, yr_end, term_start, term_end) AS (
        SELECT t."id_bioguide",
               CAST(strftime('%Y', t."term_start") AS INTEGER) AS yr,
               CAST(strftime('%Y', t."term_end")   AS INTEGER) AS yr_end,
               t."term_start",
               t."term_end"
        FROM   "legislators_terms" AS t
        JOIN   male_la             AS m USING ("id_bioguide")
        WHERE  t."state" = 'LA'
        UNION ALL
        SELECT id_bioguide,
               yr + 1,
               yr_end,
               term_start,
               term_end
        FROM   term_years
        WHERE  yr + 1 <= yr_end
    ),
    dec31_in AS (
        SELECT ty.id_bioguide,
               ty.yr
        FROM   term_years AS ty
        WHERE  date(ty.yr || '-12-31') BETWEEN ty.term_start AND ty.term_end
    ),
    elapsed AS (
