--              legislator’s first term began, how many of those legislators were still
--              serving on December 31 of that year.  
--              CTE chain:  
--                1) male_la     – IDs of male legislators who have at least one Louisiana term.  
--                2) first_term  – the first calendar year each of those legislators started.  
--                3) term_years  – recursively expand every Louisiana term into its individual
--                                 calendar-years.  
--                4) dec31_active– keep only those (legislator, year) rows where 31-Dec lies
--                                 inside the term.  
--                5) elapsed     – compute years-elapsed since the first term and keep 31–49.  
--              Final SELECT returns one row per years-elapsed value with the count of distinct
--              legislators active at that mark.
WITH RECURSIVE
    male_la AS (
        SELECT DISTINCT l."id_bioguide"
        FROM   "legislators"        AS l
        JOIN   "legislators_terms"  AS t  ON t."id_bioguide" = l."id_bioguide"
        WHERE  l."gender" = 'M'
          AND  t."state"  = 'LA'
    ),
    first_term AS (
        SELECT t."id_bioguide",
               CAST(strftime('%Y', MIN(t."term_start")) AS INTEGER) AS first_year
        FROM   "legislators_terms" AS t
        JOIN   male_la             AS m USING ("id_bioguide")
        GROUP  BY t."id_bioguide"
    ),
    term_years(id_bioguide, yr, yr_end, term_start, term_end) AS (
        SELECT t."id_bioguide",
               CAST(strftime('%Y', t."term_start") AS INTEGER) AS yr,
               CAST(strftime('%Y', t."term_end")   AS INTEGER) AS yr_end,
               t."term_start",
               t."term_end"
        FROM   "legislators_terms" AS t
        JOIN   male_la             AS m USING ("id_bioguide")
        WHERE  t."state" = 'LA'
        UNION ALL
        SELECT id_bioguide,
               yr + 1,
               yr_end,
               term_start,
               term_end
        FROM   term_years
        WHERE  yr + 1 <= yr_end
    ),
    dec31_active AS (
        SELECT id_bioguide,
               yr
        FROM   term_years
        WHERE  date(yr || '-12-31') BETWEEN term_start AND term_end
    ),
    elapsed AS (
        SELECT d.id_bioguide,
               (d.yr - f.first_year) AS yrs_elapsed
        FROM   dec31_active AS d
        JOIN   first_term   AS f USING (id_bioguide)
        WHERE  (d.yr - f.first_year) BETWEEN 31 AND 49
    )
SELECT yrs_elapsed  AS years_since_first_term,
       COUNT(DISTINCT id_bioguide) AS num_legislators_active
FROM   elapsed
GROUP  BY yrs_elapsed
ORDER  BY yrs_elapsed;
