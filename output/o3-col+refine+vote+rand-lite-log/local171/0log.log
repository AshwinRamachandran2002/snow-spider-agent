```sql
--Description: 6  (Re-worked) –  Produce every male-Louisiana legislator/December-31 date that is
--                            31-49 years after his first term, but only when that anniversary
--                            can exist inside our calendar table (i.e., first_year ≥ calendar_start-49).
WITH cal_range AS (          -- discover earliest year we have in the calendar
    SELECT CAST(substr(MIN("date"),1,4) AS INTEGER) AS cal_start_year
    FROM   "legislation_date_dim"
),
first_terms AS (             -- first service year for each male LA legislator
    SELECT  l."id_bioguide",
            MIN( CAST(strftime('%Y', t."term_start") AS INTEGER) ) AS first_year
    FROM    "legislators"       AS l
    JOIN    "legislators_terms" AS t  ON t."id_bioguide" = l."id_bioguide"
    WHERE   l."gender" = 'M'
      AND   t."state"  = 'LA'
    GROUP BY l."id_bioguide"
),
valid_first AS (             -- keep those whose 31-49-year anniversaries are representable
    SELECT ft.*
    FROM   first_terms ft
    CROSS JOIN cal_range c
    WHERE  ft.first_year >= c.cal_start_year - 49
)
SELECT DISTINCT
       v."id_bioguide",
       d."date"                                          AS dec_31_date,
       CAST(substr(d."date",1,4) AS INTEGER) - v.first_year
                                                         AS elapsed_years
FROM   valid_first               AS v
JOIN   "legislators_terms"       AS lt
       ON lt."id_bioguide" = v."id_bioguide"
JOIN   "legislation_date_dim"    AS d
       ON d."month_name"  = 'December'
      AND d."day_of_month" = 31
      AND d."date" BETWEEN lt."term_start"
                       AND IFNULL(lt."term_end", '9999-12-31')
WHERE  (CAST(substr(d."date",1,4) AS INTEGER) - v.first_year) > 30
  AND  (CAST(substr(d."date",1,4) AS INTEGER) - v.first_year) < 50
LIMIT 20;
```

