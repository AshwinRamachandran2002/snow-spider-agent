FROM    "legislators"       AS l
JOIN    "legislators_terms" AS t  ON t."id_bioguide" = l."id_bioguide"
WHERE   l."gender" = 'M'
  AND   t."state"  = 'LA'
GROUP BY l."id_bioguide"
LIMIT 20;
```

```sql
--Description: 5)  Look at all 31-to-49-year anniversaries (Dec-31) for one sample legislator to be sure dates line up  
WITH first_term AS (
    SELECT l."id_bioguide",
           MIN( strftime('%Y', t."term_start") ) AS "first_year"
    FROM   "legislators"       AS l
    JOIN   "legislators_terms" AS t ON t."id_bioguide" = l."id_bioguide"
    WHERE  l."gender" = 'M'
      AND  t."state"  = 'LA'
    GROUP BY l."id_bioguide"
    LIMIT 1                       -- just grab one for inspection
)
SELECT  f."id_bioguide",
        d."date"                  AS "dec_31_date",
        (CAST(strftime('%Y', d."date") AS INTEGER) -
         CAST(f."first_year"       AS INTEGER))      AS "elapsed_years"
FROM    first_term               AS f
JOIN    "legislators_terms"      AS tt  ON tt."id_bioguide" = f."id_bioguide"
JOIN    "legislation_date_dim"   AS d   -- use the calendar table
      ON d."month_name" = 'December'
     AND d."day_of_month" = 31
     AND d."date" BETWEEN tt."term_start"
                      AND IFNULL(tt."term_end", '9999-12-31')
WHERE   (CAST(strftime('%Y', d."date") AS INTEGER) -
         CAST(f."first_year"       AS INTEGER))  > 30
  AND   (CAST(strftime('%Y', d."date") AS INTEGER) -
         CAST(f."first_year"       AS INTEGER))  < 50
ORDER BY d."date"
LIMIT 20;
```

```sql
--Description: 6)  Produce every male Louisiana legislator-year (Dec-31) that falls 31-49 years after his very first term  
WITH first_terms AS (
    SELECT  l."id_bioguide",
            MIN( strftime('%Y', t."term_start") ) AS "first_year"
    FROM    "legislators"       AS l
    JOIN    "legislators_terms" AS t
           ON t."id_bioguide" = l."id_bioguide"
    WHERE   l."gender" = 'M'
      AND   t."state"  = 'LA'
    GROUP BY l."id_bioguide"
)
SELECT DISTINCT
       ft."id_bioguide",
       d."date"                       AS "dec_31_date",
       (CAST(strftime('%Y', d."date") AS INTEGER) -
        CAST(ft."first_year"          AS INTEGER)) AS "elapsed_years"
FROM   first_terms              AS ft
JOIN   "legislators_terms"      AS lt
       ON lt."id_bioguide" = ft."id_bioguide"
JOIN   "legislation_date_dim"   AS d
       ON d."month_name"    = 'December'
      AND d."day_of_month" = 31
      AND d."date" BETWEEN lt."term_start"
                       AND IFNULL(lt."term_end", '9999-12-31')
WHERE  (CAST(strftime('%Y', d."date") AS INTEGER) -
        CAST(ft."first_year"          AS INTEGER))  > 30
  AND  (CAST(strftime('%Y', d."date") AS INTEGER) -
        CAST(ft."first_year"          AS INTEGER))  < 50
LIMIT 20;
```

```sql
--Description: 7)  FINAL ANSWER – for each exact elapsed-year (31 … 49) count how many distinct male Louisiana legislators were active on 31-Dec of that year  
WITH first_terms AS (
    SELECT  l."id_bioguide",
            MIN( strftime('%Y', t."term_start") ) AS "first_year"
    FROM    "legislators"       AS l
    JOIN    "legislators_terms" AS t
           ON t."id_bioguide" = l."id_bioguide"
    WHERE   l."gender" = 'M'
      AND   t."state"  = 'LA'
    GROUP BY l."id_bioguide"
),
active_dec31 AS (
    SELECT DISTINCT
           ft."id_bioguide",
           (CAST(strftime('%Y', d."date") AS INTEGER) -
            CAST(ft."first_year"          AS INTEGER)) AS "elapsed_years"
    FROM   first_terms              AS ft
    JOIN   "legislators_terms"      AS lt
           ON lt."id_bioguide" = ft."id_bioguide"
    JOIN   "legislation_date_dim"   AS d
           ON d."month_name"    = 'December'
          AND d."day_of_month" = 31
          AND d."date" BETWEEN lt."term_start"
                           AND IFNULL(lt."term_end", '9999-12-31')
    WHERE  (CAST(strftime('%Y', d."date") AS INTEGER) -
            CAST(ft."first_year"          AS INTEGER))  > 30
      AND  (CAST(strftime('%Y', d."date") AS INTEGER) -
            CAST(ft."first_year"          AS INTEGER))  < 50
)
SELECT  "elapsed_years",
        COUNT(DISTINCT "id_bioguide") AS "num_legislators_active"
FROM    active_dec31
GROUP BY "elapsed_years"
ORDER BY "elapsed_years";
```
