```sql
-- 3. Description: Find bioguide IDs of all male legislators whose home-state is Louisiana (LA)
SELECT DISTINCT l.id_bioguide
FROM legislators         AS l
JOIN legislators_terms   AS t  ON t.id_bioguide = l.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
LIMIT 20;
```

```sql
-- 4. Description: Show the names and first/last term dates for those Louisiana male legislators
SELECT DISTINCT l.full_name,
       t.term_start,
       t.term_end
FROM legislators         AS l
JOIN legislators_terms   AS t  ON t.id_bioguide = l.id_bioguide
WHERE l.gender = 'M'
  AND t.state  = 'LA'
LIMIT 20;
```

```sql
-- 5. Description: For each Louisiana male legislator, determine the first term’s start date
SELECT id_bioguide,
       MIN(term_start)  AS first_term_start
FROM legislators_terms
WHERE id_bioguide IN
      (SELECT l.id_bioguide
       FROM legislators AS l
       WHERE l.gender = 'M')
  AND state = 'LA'
GROUP BY id_bioguide
LIMIT 20;
```

```sql
-- 6. Description: Show every recorded term together with the year-portion of its start & end dates
SELECT id_bioguide,
       term_start,
       term_end,
       SUBSTR(term_start,1,4) AS start_year,
       SUBSTR(term_end,1,4)   AS end_year
FROM legislators_terms
WHERE id_bioguide IN
      (SELECT l.id_bioguide
       FROM legislators AS l
       WHERE l.gender = 'M')
  AND state = 'LA'
LIMIT 20;
```

```sql
-- 7. Description: Final result – how many distinct Louisiana male legislators
--                 were still in office on each Dec-31 occurring
--                 31-49 years ( >30 and <50 ) after their first term began,
--                 grouped by the exact years-since-first-term value
WITH male_la AS (
    SELECT l.id_bioguide
    FROM legislators AS l
    WHERE l.gender = 'M'
), la_terms AS (
    SELECT t.*
    FROM legislators_terms AS t
    JOIN male_la          AS m ON m.id_bioguide = t.id_bioguide
    WHERE t.state = 'LA'
), first_start AS (
    SELECT id_bioguide,
           MIN(term_start) AS first_start
    FROM la_terms
    GROUP BY id_bioguide
), yrs AS (                         -- generate every year 31-49 after first term
    SELECT id_bioguide,
           CAST(SUBSTR(first_start,1,4) AS INT) + 31 AS yr,
           CAST(SUBSTR(first_start,1,4) AS INT)      AS base_yr
    FROM first_start
    UNION ALL
    SELECT id_bioguide,
           yr + 1,
           base_yr
    FROM yrs
    WHERE yr < base_yr + 49
), active AS (                      -- keep only years where Dec-31 falls inside a term
    SELECT y.id_bioguide,
           y.yr,
           y.yr - y.base_yr AS years_since_first
    FROM yrs AS y
    JOIN la_terms AS t
      ON t.id_bioguide = y.id_bioguide
     AND DATE(y.yr || '-12-31') BETWEEN DATE(t.term_start) AND DATE(t.term_end)
)
SELECT years_since_first,
       COUNT(DISTINCT id_bioguide) AS num_legislators
FROM active
GROUP BY years_since_first
ORDER BY years_since_first
LIMIT 20;
```

