--Description:  Corrected prototype query: compute, for the “Intimates” category (the highest-purchased one),
--              the average number of minutes between a product-page view and the very next event
--              in the same session.  We extract the product_id from each “/product/<id>” URI, join to
--              PRODUCTS to ensure the view belongs to the Intimates category, capture the next-event
--              timestamp with LEAD, calculate the gap in minutes, and finally average those gaps.
SELECT
    AVG( (next_event_time - current_event_time) / 60000000.0 ) AS "avg_minutes_spent"
FROM (
    SELECT
        e."session_id",
        e."created_at"                                                    AS current_event_time,
        LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                   ORDER BY e."created_at")               AS next_event_time
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"   e
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
           ON p."id" = TRY_TO_NUMBER(SPLIT_PART(e."uri", '/', 3))
          AND p."category" = 'Intimates'          -- top-purchased category
    WHERE  e."event_type" = 'product'
) t
WHERE next_event_time IS NOT NULL;
