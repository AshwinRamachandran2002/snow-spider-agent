```sql
--Description: Prototype of the final aggregation: compute, within each session, the time difference (in minutes)
--             between a product-page view event and the following event.  Restricted to the top category only.
--             (Replace <TOP_CATEGORY> with the actual category string obtained earlier.)
SELECT
  AVG( (next_event_time - current_event_time) / 60000000.0 )  AS "avg_minutes_spent"
FROM (
      SELECT
        "session_id",
        "created_at"                         AS current_event_time,
        LEAD("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at") 
                                             AS next_event_time
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"
      WHERE "uri" ILIKE '%/product%'
        AND "uri" ILIKE '%' || '<TOP_CATEGORY>' || '%'
     ) t
WHERE next_event_time IS NOT NULL
LIMIT 20;
```
