```sql
--Description:  One-shot query that answers the whole task in four steps:
--              1️⃣  top_category  – find the product category with the largest number of purchased order-items.  
--              2️⃣  product_views – grab all EVENTS of type = 'product', extract the <product_id> from the URI,
--                  join to PRODUCTS, and keep only rows that belong to the top category found in step 1.  
--                  For every view we also collect the timestamp of the next event in the same session (LEAD).  
--              3️⃣  durations     – calculate, for each view, the gap to the next event in minutes.  
--              4️⃣  final SELECT  – average those gaps to obtain the required “average time on product page”
--                  for the highest-purchased category.
WITH top_category AS (   -- step 1
    SELECT p."category"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
           ON p."id" = oi."product_id"
    GROUP  BY p."category"
    ORDER  BY COUNT(*) DESC
    LIMIT  1
),
product_views AS (       -- step 2
    SELECT
        e."session_id",
        e."created_at"                                                    AS current_event_time,
        LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                   ORDER BY e."created_at")               AS next_event_time
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"   e
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS" p
           ON p."id" = TRY_TO_NUMBER(SPLIT_PART(e."uri", '/', 3))
    JOIN   top_category tc
           ON p."category" = tc."category"
    WHERE  e."event_type" = 'product'
),
durations AS (           -- step 3
    SELECT
        (next_event_time - current_event_time) / 60000000.0  AS minutes_on_page
    FROM   product_views
    WHERE  next_event_time IS NOT NULL       -- ignore the last event in a session
)
-- step 4
SELECT
    AVG(minutes_on_page) AS "avg_minutes_spent_on_top_category_product_page"
FROM durations;
```
