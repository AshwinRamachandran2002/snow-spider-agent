--Description: We know that product-page view events have event_type = 'product' and the URI looks like '/product/<product_id>'.
--             The goal is to confirm that such events actually exist for the top-purchased category “Intimates”.
--             1.  Extract the numeric product_id from each URI with REGEXP_REPLACE, then TRY_TO_NUMBER to avoid errors.
--             2.  Join that extracted id to PRODUCTS and keep only rows where PRODUCTS.category = 'Intimates'.
--             3.  Return a 20-row sample of matching events to verify data presence.
SELECT
    e."session_id",
    e."user_id",
    e."uri",
    e."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."EVENTS"    e
JOIN LATERAL (
        SELECT TRY_TO_NUMBER(REGEXP_REPLACE(e."uri", '^.*/', '')) AS "product_id"
     ) AS x
     ON TRUE
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"  p
     ON p."id" = x."product_id"
    AND p."category" = 'Intimates'
WHERE e."event_type" = 'product'
LIMIT 20;
