```

```sql
--Description: 5) Find examples of EVENTS rows that look like product-page views.  A quick fuzzy search on “uri”  
SELECT "id",
       "session_id",
       "created_at",
       "event_type",
       "uri"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "uri" ILIKE '%product%'
LIMIT 20;
```

```sql
--Description: 6) For one sample session, display the ordered timeline of events to understand how to measure page-view dwell time  
SELECT "session_id",
       "sequence_number",
       "created_at",
       "event_type",
       "uri"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "session_id" = (
        SELECT "session_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
        WHERE "uri" ILIKE '%product%'
        LIMIT 1
      )
ORDER BY "created_at"
LIMIT 20;
```

```sql
--Description: 7) Calculate, per product-page view, the minutes until the NEXT event in the same session   
SELECT e1."id"                              AS "view_event_id",
       e1."session_id",
       e1."uri",
       (e2."created_at" - e1."created_at")/60000000.0  AS "minutes_on_page"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS  e1
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS  e2
  ON e1."session_id" = e2."session_id"
 AND e2."created_at"  > e1."created_at"
WHERE e1."uri" ILIKE '%product%'
QUALIFY ROW_NUMBER() OVER (PARTITION BY e1."id" ORDER BY e2."created_at") = 1
LIMIT 20;
```

```sql
--Description: 8) Attach the product SKU found in the URI (assuming pattern ‘/products/<sku>’) and join to PRODUCTS to get the category  
SELECT REGEXP_SUBSTR(e."uri", '/products/([A-Z0-9]+)', 1, 1, 'e', 1) AS "sku",
       e."session_id",
       e."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS  e
WHERE e."uri" ILIKE '%/products/%'
LIMIT 20;
```

```sql
--Description: 9) Combine steps: derive per-view dwell time, map to product category, keep only the category with the highest purchase quantity (identified in query 2)  
WITH top_cat AS (      -- category that sold the most order-items
     SELECT p."category"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
     JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
       ON p."id" = oi."product_id"
     GROUP BY p."category"
     ORDER BY COUNT(*) DESC
     LIMIT 1
),
views AS (             -- dwell time for every product-page view
     SELECT REGEXP_SUBSTR(e1."uri", '/products/([A-Z0-9]+)', 1, 1, 'e', 1) AS "sku",
            (e2."created_at" - e1."created_at")/60000000.0                 AS "minutes_on_page"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS  e1
     JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS  e2
       ON e1."session_id" = e2."session_id"
      AND e2."created_at"  > e1."created_at"
     WHERE e1."uri" ILIKE '%/products/%'
     QUALIFY ROW_NUMBER() OVER (PARTITION BY e1."id" ORDER BY e2."created_at") = 1
),
views_cat AS (
     SELECT v."minutes_on_page",
            p."category"
     FROM   views v
     JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
       ON   p."sku" = v."sku"
)
SELECT AVG("minutes_on_page") AS "avg_minutes_on_page_top_category"
FROM   views_cat
WHERE  "category" = (SELECT "category" FROM top_cat)
LIMIT 20;
```

