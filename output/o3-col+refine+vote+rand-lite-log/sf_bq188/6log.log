Query:
--Description: Re-calculate the average minutes between a product-page view (event_type = 'product') 
--             and the very next event in the same session, using the corrected filter and top category name
WITH top_category_products AS (     -- product ids in the Intimates category
     SELECT "id" AS "product_id"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
     WHERE "category" = 'Intimates'
),
product_views AS (                  -- all product-page events
     SELECT e."session_id",
            e."created_at" AS "view_ts",
            LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                       ORDER BY e."created_at") AS "next_ts"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
     WHERE e."event_type" = 'product'
),
view_durations AS (                 -- compute minutes between consecutive events
     SELECT ("next_ts" - "view_ts")/60000000.0 AS "minutes_spent"
     FROM product_views
     WHERE "next_ts" IS NOT NULL
)
SELECT AVG("minutes_spent") AS "avg_minutes_per_product_page"
FROM view_durations
