```sql
--Description: Inspect a few records from ORDER_ITEMS to understand the basic columns involved in quantity-related analysis  
SELECT "id",
       "order_id",
       "product_id",
       "user_id",
       "status",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: Find the distinct values that appear in the status column (e.g. Complete, Shipped, Cancelled …)  
SELECT DISTINCT "status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
LIMIT 20;
```

```sql
--Description: Count how many line-items were purchased per product_id (using only rows that look finished/‘complete’)  
SELECT "product_id",
       COUNT(*) AS "purchase_qty"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
WHERE "status" ILIKE '%Complete%'          -- fuzzy to catch variants such as ‘complete’, ‘Completed’
GROUP BY "product_id"
ORDER BY "purchase_qty" DESC
LIMIT 20;
```

```sql
--Description: Join the per-product counts to PRODUCTS so we can see the category for those top-selling products  
WITH top_products AS (
     SELECT "product_id",
            COUNT(*) AS "purchase_qty"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS
     WHERE "status" ILIKE '%Complete%'
     GROUP BY "product_id"
)
SELECT p."category",
       SUM(tp."purchase_qty") AS "total_qty"
FROM top_products tp
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
     ON p."id" = tp."product_id"
GROUP BY p."category"
ORDER BY "total_qty" DESC
LIMIT 20;
```

```sql
--Description: Preview a handful of EVENTS rows to see what an event session looks like  
SELECT "id",
       "session_id",
       "event_type",
       "uri",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
--Description: List every distinct event_type that exists in EVENTS so we know which ones might be “product-view” events  
SELECT DISTINCT "event_type"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
LIMIT 20;
```

```sql
--Description: Look at URIs that contain the word “product” (or similar) to find patterns for product page visits  
SELECT DISTINCT "uri"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "uri" ILIKE '%product%'
LIMIT 20;
```

```sql
--Description: For a suspected product page event_type (replace 'view' with whatever you find), show sample rows ordered by session/time  
SELECT "session_id",
       "event_type",
       "uri",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "event_type" ILIKE '%view%'          -- adjust after observing step 6
  AND "uri"      ILIKE '%product%'
ORDER BY "session_id",
         "created_at"
LIMIT 20;
```

```sql
--Description: Collect all PRODUCT ids that belong to the single highest-selling category (we’ll discover that category in step-4)  
/*  Replace 'Accessories' with the actual top category name you observe */
SELECT "id" AS "product_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
WHERE "category" = 'Accessories'
LIMIT 20;
```

```sql
--Description: Calculate average minutes between a product-page view and the very next event within the same session  
/* Replace 'Accessories' (if needed) and the precise view event_type you found earlier */
WITH top_category_products AS (
     SELECT "id" AS "product_id"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
     WHERE "category" = 'Accessories'
),
product_views AS (
     SELECT e."session_id",
            e."created_at"      AS "view_ts",
            LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                       ORDER BY e."created_at") AS "next_ts"
     FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
     WHERE e."event_type" ILIKE '%view%'   -- product-view events
       AND e."uri"      ILIKE '%product%'
),
view_durations AS (
     SELECT "session_id",
            ("next_ts" - "view_ts")/60000000.0 AS "minutes_spent"   -- μs → minutes
     FROM product_views
     WHERE "next_ts" IS NOT NULL
)
SELECT AVG("minutes_spent") AS "avg_minutes_per_product_page"
FROM view_durations;
```
