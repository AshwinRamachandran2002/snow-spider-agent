Query:
--Description: Convert the previous difference into minutes for rapid inspection
SELECT  "view_event_id",
        "session_id",
        ("next_event_time" - "view_time") / 60000000  AS "minutes_on_page"   -- 1 minute = 60*1,000,000 µs
FROM   (
        SELECT  e."id"           AS "view_event_id",
                e."session_id",
                e."created_at"   AS "view_time",
                LEAD(e."created_at") 
                  OVER (PARTITION BY e."session_id" 
                        ORDER BY e."created_at")       AS "next_event_time"
        FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
        WHERE   e."uri" ILIKE '%product%'
       ) t
WHERE  "next_event_time" IS NOT NULL
LIMIT 20;
