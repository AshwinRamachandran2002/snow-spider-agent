```

```sql
--Description: Retrieve a few product-page view events together with session and time information
SELECT "id",
       "session_id",
       "user_id",
       "uri",
       "created_at"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS"
WHERE  "uri" ILIKE '%product%'
ORDER  BY "created_at"
LIMIT 20;
```

```sql
--Description: For each product-page view, show the timestamp of the very next event in the same session
SELECT  e."id"                                         AS "view_event_id",
        e."session_id",
        e."uri"                                        AS "product_uri",
        e."created_at"                                 AS "view_time",
        LEAD(e."created_at") 
          OVER (PARTITION BY e."session_id" 
                ORDER BY e."created_at")               AS "next_event_time"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
WHERE   e."uri" ILIKE '%product%'
LIMIT 20;
```

```sql
--Description: Convert the previous difference into minutes for rapid inspection
SELECT  "view_event_id",
        "session_id",
        ("next_event_time" - "view_time") / 60000000  AS "minutes_on_page"   -- 1 minute = 60*1,000,000 µs
FROM   (
        SELECT  e."id"           AS "view_event_id",
                e."session_id",
                e."created_at"   AS "view_time",
                LEAD(e."created_at") 
                  OVER (PARTITION BY e."session_id" 
                        ORDER BY e."created_at")       AS "next_event_time"
        FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
        WHERE   e."uri" ILIKE '%product%'
       ) t
WHERE  "next_event_time" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Attach the product_id to each view by extracting the numeric id from the URI (common pattern ‘/products/12345’)
SELECT  e."session_id",
        REGEXP_SUBSTR(e."uri", '/products/([0-9]+)', 1, 1, 'e', 1)::NUMBER AS "product_id",
        e."created_at"                                                    AS "view_time"
FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
WHERE   e."uri" ILIKE '%/products/%'
AND     REGEXP_SUBSTR(e."uri", '/products/([0-9]+)', 1, 1, 'e', 1) IS NOT NULL
LIMIT 20;
```

```sql
--Description: Combine the above view-duration calculation with product information to obtain average minutes spent per category
WITH page_views AS (
      SELECT  e."session_id",
              REGEXP_SUBSTR(e."uri", '/products/([0-9]+)', 1, 1, 'e', 1)::NUMBER AS "product_id",
              e."created_at"                                                     AS "view_time",
              LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                         ORDER BY e."created_at")                 AS "next_event_time"
      FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
      WHERE   e."uri" ILIKE '%/products/%'
),
view_durations AS (
      SELECT  pv."product_id",
              ("next_event_time" - "view_time") / 60000000  AS "minutes_on_page"
      FROM    page_views  pv
      WHERE   pv."next_event_time" IS NOT NULL
)
SELECT  p."category",
        AVG(vd."minutes_on_page") AS "avg_minutes_spent"
FROM    view_durations vd
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
        ON p."id" = vd."product_id"
GROUP   BY p."category"
ORDER   BY AVG(vd."minutes_on_page") DESC
LIMIT 20;
```

```sql
--Description: Using the category with the most purchased items (determined earlier), get its final average time-on-page
WITH top_category AS (
      SELECT p."category"
      FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
      JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"      p
             ON p."id" = oi."product_id"
      GROUP  BY p."category"
      ORDER  BY COUNT(oi."id") DESC
      LIMIT 1
),
page_views AS (
      SELECT  e."session_id",
              REGEXP_SUBSTR(e."uri", '/products/([0-9]+)', 1, 1, 'e', 1)::NUMBER AS "product_id",
              e."created_at"                                                     AS "view_time",
              LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                         ORDER BY e."created_at")                 AS "next_event_time"
      FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
      WHERE   e."uri" ILIKE '%/products/%'
),
view_durations AS (
      SELECT  pv."product_id",
              ("next_event_time" - "view_time") / 60000000  AS "minutes_on_page"
      FROM    page_views  pv
      WHERE   pv."next_event_time" IS NOT NULL
)
SELECT  tc."category",
        AVG(vd."minutes_on_page") AS "average_minutes_per_product_view"
FROM    view_durations vd
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
        ON p."id" = vd."product_id"
JOIN    top_category tc
        ON p."category" = tc."category"
GROUP  BY tc."category"
LIMIT 20;
```
