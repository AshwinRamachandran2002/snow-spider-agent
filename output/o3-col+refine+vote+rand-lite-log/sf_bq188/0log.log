              REGEXP_SUBSTR(e."uri", '/product/([0-9]+)', 1, 1, 'e', 1)::NUMBER AS "product_id",
              e."created_at"                                                     AS "view_time",
              LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                         ORDER BY e."created_at")                 AS "next_event_time"
      FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
      WHERE   e."uri" ILIKE '%/product/%'            -- singular form
),
view_durations AS (
      SELECT  pv."product_id",
              ("next_event_time" - "view_time") / 60000000  AS "minutes_on_page"
      FROM    page_views  pv
      WHERE   pv."next_event_time" IS NOT NULL
)
SELECT  p."category",
        AVG(vd."minutes_on_page") AS "avg_minutes_spent"
FROM    view_durations vd
JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
        ON p."id" = vd."product_id"
GROUP   BY p."category"
ORDER   BY AVG(vd."minutes_on_page") DESC
LIMIT 20
