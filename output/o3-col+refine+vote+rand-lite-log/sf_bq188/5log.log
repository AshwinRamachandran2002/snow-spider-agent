```sql
--Description: 1) List a sample of all distinct product categories that exist in the catalogue
SELECT DISTINCT "category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
LIMIT 20;
```

```sql
--Description: 2) Count how many order-items (i.e. quantity) were sold per category  
SELECT p."category",
       COUNT(oi."id") AS "total_quantity"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
GROUP BY p."category"
ORDER BY "total_quantity" DESC
LIMIT 20;
```

```sql
--Description: 3) Identify the single category with the highest purchase quantity
SELECT p."category",
       COUNT(oi."id") AS "total_quantity"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
GROUP BY p."category"
ORDER BY "total_quantity" DESC
LIMIT 1;
```

```sql
--Description: 4) Show a sample list of product-ids that belong to that top-selling category
SELECT DISTINCT p."id"  AS "product_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
WHERE p."category" = (
        SELECT p2."category"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p2
        JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi2
              ON p2."id" = oi2."product_id"
        GROUP BY p2."category"
        ORDER BY COUNT(oi2."id") DESC
        LIMIT 1
     )
LIMIT 20;
```

```sql
--Description: 5) Look at a few EVENT rows whose URI seems to reference product pages  
SELECT "id",
       "session_id",
       "user_id",
       "created_at",
       "uri"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "uri" ILIKE '%product%'
LIMIT 20;
```

```sql
--Description: 6) From those URIs, extract (regex) the numeric product-id mentioned in the path
SELECT "id",
       REGEXP_SUBSTR("uri", '/([0-9]+)', 1, 1, 'e')        AS "product_id_from_uri",
       "created_at",
       "session_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE "uri" ILIKE '%product%'
LIMIT 20;
```

```sql
--Description: 7) Keep only product-page events whose product belongs to the top category
SELECT e."id",
       e."session_id",
       e."user_id",
       e."created_at",
       pid."product_id"
FROM (
        SELECT "id",
               "session_id",
               "user_id",
               "created_at",
               REGEXP_SUBSTR("uri", '/([0-9]+)', 1, 1, 'e') AS "product_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
        WHERE "uri" ILIKE '%product%'
     )  e
JOIN (
        SELECT DISTINCT p."id" AS "product_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
        WHERE p."category" = (
                SELECT p2."category"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p2
                JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi2
                      ON p2."id" = oi2."product_id"
                GROUP BY p2."category"
                ORDER BY COUNT(oi2."id") DESC
                LIMIT 1
             )
     ) pid
      ON e."product_id" = pid."product_id"
LIMIT 20;
```

```sql
--Description: 8) For product-page events, calculate minutes until the very next event in the same session
SELECT "session_id",
       "product_id",
       "created_at",
       (LEAD("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at")
        - "created_at")/60000000  AS "minutes_until_next_event"
FROM (
        SELECT "session_id",
               REGEXP_SUBSTR("uri", '/([0-9]+)', 1, 1, 'e') AS "product_id",
               "created_at"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
        WHERE "uri" ILIKE '%product%'
     )
LIMIT 20;
```

```sql
--Description: 9) Compute the average time (in minutes) users spend per product-page visit for the top category
SELECT AVG("minutes_until_next_event") AS "avg_minutes_spent"
FROM (
        SELECT "session_id",
               REGEXP_SUBSTR("uri", '/([0-9]+)', 1, 1, 'e') AS "product_id",
               (LEAD("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at")
                - "created_at")/60000000  AS "minutes_until_next_event"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
        WHERE "uri" ILIKE '%product%'
     ) e
JOIN (
        SELECT DISTINCT p."id" AS "product_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
        WHERE p."category" = (
                SELECT p2."category"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p2
                JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi2
                      ON p2."id" = oi2."product_id"
                GROUP BY p2."category"
                ORDER BY COUNT(oi2."id") DESC
                LIMIT 1
             )
     ) tc
      ON e."product_id" = tc."product_id"
WHERE e."minutes_until_next_event" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 10) (Optional deeper check) Inspect the distribution of those time-differences to understand spread
SELECT ROUND("minutes_until_next_event") AS "minutes_bucket",
       COUNT(*)                         AS "num_visits"
FROM (
        SELECT "session_id",
               (LEAD("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at")
                - "created_at")/60000000  AS "minutes_until_next_event"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
        WHERE "uri" ILIKE '%product%'
     ) e
WHERE "minutes_until_next_event" IS NOT NULL
GROUP BY ROUND("minutes_until_next_event")
ORDER BY "minutes_bucket"
LIMIT 20;
```
