Query:
--Description: 9) Compute the average time (in minutes) users spend per product-page visit for the top category
SELECT AVG("minutes_until_next_event") AS "avg_minutes_spent"
FROM (
        SELECT "session_id",
               REGEXP_SUBSTR("uri", '/([0-9]+)', 1, 1, 'e') AS "product_id",
               (LEAD("created_at") OVER (PARTITION BY "session_id" ORDER BY "created_at")
                - "created_at")/60000000  AS "minutes_until_next_event"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
        WHERE "uri" ILIKE '%product%'
     ) e
JOIN (
        SELECT DISTINCT p."id" AS "product_id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
        WHERE p."category" = (
                SELECT p2."category"
                FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p2
                JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi2
                      ON p2."id" = oi2."product_id"
                GROUP BY p2."category"
                ORDER BY COUNT(oi2."id") DESC
                LIMIT 1
             )
     ) tc
      ON e."product_id" = tc."product_id"
WHERE e."minutes_until_next_event" IS NOT NULL
LIMIT 20;
