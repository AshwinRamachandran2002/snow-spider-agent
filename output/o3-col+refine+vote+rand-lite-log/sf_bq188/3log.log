```sql
-- Description: Calculate the average minutes users spend on each product page
--              (based on the time between a product-view event and the very next
--              event in the same session), aggregated by product category.
--              Fixed the URI pattern from "/products/" to "/product/".

WITH event_times AS (
    SELECT
        TRY_TO_NUMBER( SPLIT_PART(e."uri", '/product/', 2) )                                     AS "product_id",
        ( LEAD(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at")
          - e."created_at" ) / 60000000.0                                                       AS "minutes_on_page"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
    WHERE e."uri" ILIKE '%/product/%'
)
SELECT
    p."category",
    AVG(et."minutes_on_page")                                                                   AS "avg_minutes_on_page"
FROM event_times                           et
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS p
  ON et."product_id" = p."id"
WHERE et."minutes_on_page" IS NOT NULL
GROUP BY p."category"
ORDER BY "avg_minutes_on_page" DESC
LIMIT 20;
```
