LIMIT 20;
```

```sql
-- Description: Compute the minutes spent on a product page (difference to next event in same session)
SELECT  e."session_id",
        e."user_id",
        e."uri"               AS "product_uri",
        e."created_at"        AS "page_view_time",
        LEAD(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at")      AS "next_event_time",
        ( LEAD(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at")
          - e."created_at") / 60000000.0                                                     AS "minutes_on_page"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
WHERE   e."uri" ILIKE '%product%'
ORDER BY "minutes_on_page" DESC NULLS LAST
LIMIT 20;
```

```sql
-- Description: Examine the actual URI patterns to understand how product IDs are embedded
SELECT DISTINCT "uri"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS
WHERE  "uri" ILIKE '%product%'
LIMIT 20;
```

```sql
-- Description: Try to pull out numeric product IDs from the product page URIs
SELECT  e."uri",
        TRY_TO_NUMBER( SPLIT_PART(e."uri", '/products/', 2) ) AS "product_id"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
WHERE   e."uri" ILIKE '%/products/%'
LIMIT 20;
```

```sql
-- Description: Sample calculation of average minutes spent on product pages, grouped by product category
WITH event_times AS (
     SELECT  TRY_TO_NUMBER( SPLIT_PART(e."uri", '/products/', 2) ) AS "product_id",
             ( LEAD(e."created_at") OVER (PARTITION BY e."session_id" ORDER BY e."created_at")
               - e."created_at") / 60000000.0                     AS "minutes_on_page"
     FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.EVENTS e
     WHERE   e."uri" ILIKE '%/products/%'
)
SELECT  p."category",
        AVG(et."minutes_on_page") AS "avg_minutes_on_page"
FROM    event_times                         et
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS  p  ON et."product_id" = p."id"
WHERE   et."minutes_on_page" IS NOT NULL
GROUP BY p."category"
ORDER BY "avg_minutes_on_page" DESC
LIMIT 20;
```
