-- 7. Description: Peek at events whose URI appears to reference product pages.  
SELECT "session_id",
       "created_at",
       "uri",
       "event_type"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS"
WHERE  "uri" ILIKE '%/product%'            -- fuzzy pattern for product pages
