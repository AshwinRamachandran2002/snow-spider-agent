--Description: Corrected version of SQL-9.  We treat rows with event_type = 'product' as the page-view signal
--             (instead of searching for “view”).  For every such view we grab the next event in the same
--             session and compute minutes spent on the product page.
WITH product_views AS (
    SELECT  "session_id",
            "created_at" AS "view_time",
            "uri",
            LEAD("created_at") OVER (PARTITION BY "session_id"
                                     ORDER BY "created_at") AS "next_time"
    FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS"
    WHERE   "event_type" = 'product'                        -- product page views
)
SELECT  "session_id",
        "uri",
        ("next_time" - "view_time") / 60000000.0 AS "minutes_on_page"
FROM    product_views
WHERE   "next_time" IS NOT NULL
LIMIT 20
