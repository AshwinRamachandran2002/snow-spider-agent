```sql
--Description: End-to-end query to answer the task.  
--1) biggest_category: find the category with the most “Complete” order-item rows.  
--2) page_durations: for every product-page view event (event_type = 'product') obtain the next event in the same session, convert the time gap from microseconds to minutes, and capture the product_id parsed from the URI.  
--3) Final SELECT: keep only page views whose product is in the top-selling category and return the average minutes users spend on those pages.  
WITH biggest_category AS (                              -- 1️⃣ top-selling category
    SELECT  p."category"
    FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
    JOIN    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"     p
           ON p."id" = oi."product_id"
    WHERE   oi."status" = 'Complete'
    GROUP BY p."category"
    ORDER BY COUNT(*) DESC
    LIMIT 1
),
page_durations AS (                                     -- 2️⃣ minutes per product view
    WITH views AS (
        SELECT  e."session_id",
                e."created_at"                                          AS "view_time",
                LEAD(e."created_at") OVER (PARTITION BY e."session_id"
                                            ORDER BY e."created_at")    AS "next_time",
                TO_NUMBER(REGEXP_SUBSTR(e."uri", '[0-9]+'))             AS "product_id"
        FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS" e
        WHERE   e."event_type" = 'product'                              -- product-page views
    )
    SELECT  "product_id",
            ("next_time" - "view_time") / 60000000.0 AS "minutes_on_page"
    FROM    views
    WHERE   "next_time" IS NOT NULL
)
SELECT  bc."category"                         AS "top_category",
        AVG(pd."minutes_on_page")             AS "avg_minutes_per_product_page_visit"
FROM          page_durations                pd
JOIN          "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
              ON p."id" = pd."product_id"
JOIN          biggest_category              bc
              ON p."category" = bc."category"
GROUP BY       bc."category";
