```sql
-- 9. Description: For every product-page view, find the next event in the same session
--    and calculate elapsed minutes; meant for later averaging by product/category.
WITH product_views AS (
    SELECT  "session_id",
            "created_at" AS "view_time",
            "uri",
            LEAD("created_at") OVER (PARTITION BY "session_id"
                                     ORDER BY "created_at") AS "next_time"
    FROM    "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS"
    WHERE   "uri" ILIKE '%/product%'      -- product pages
)
SELECT  "session_id",
        "uri",
        ("next_time" - "view_time") / 60000000.0 AS "minutes_on_page"
FROM    product_views
WHERE   "next_time" IS NOT NULL
LIMIT 20;
```

```sql
--10. Description: Bring everything together.
--    1) Identify the top-selling category (cte biggest_category),
--    2) Parse product_id from the product page URI,
--    3) Join to PRODUCTS to keep only page-views for that winning category,
--    4) Compute the average minutes spent on those product pages.
WITH biggest_category AS (                                  -- step-1
    SELECT p."category"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS" oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"    p
           ON p."id" = oi."product_id"
    WHERE  oi."status" = 'Complete'
    GROUP  BY p."category"
    ORDER  BY COUNT(*) DESC
    LIMIT  1
),
page_durations AS (                                         -- steps-2 & 3
    WITH views AS (
        SELECT "session_id",
               "created_at"                                AS "view_time",
               "uri",
               LEAD("created_at") OVER (PARTITION BY "session_id"
                                        ORDER BY "created_at") AS "next_time"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."EVENTS"
        WHERE  "uri" ILIKE '%/product%'                    -- product page
    )
    SELECT v."session_id",
           v."uri",
           ("next_time" - "view_time") / 60000000.0        AS "minutes_on_page",
           TO_NUMBER(REGEXP_SUBSTR(v."uri", '[0-9]+'))     AS "product_id"
    FROM   views v
    WHERE  v."next_time" IS NOT NULL
)
SELECT bc."category"                                        AS "top_category",
       AVG(pd."minutes_on_page")                           AS "avg_minutes_per_product_page_visit"
FROM         page_durations               pd
JOIN         "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
             ON p."id" = pd."product_id"
CROSS JOIN    biggest_category             bc
WHERE        p."category" = bc."category"                   -- keep views for top category
LIMIT 20;
```
