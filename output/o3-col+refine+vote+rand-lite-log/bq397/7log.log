--Description: 1) Quick preview – look at the first 20 rows of the `rev_transactions` table
SELECT *
FROM `data-to-insights.ecommerce.rev_transactions`
LIMIT 20;
```

```sql
--Description: 2) Show every distinct `channelGrouping` that appears in the revenue table
SELECT DISTINCT channelGrouping
FROM `data-to-insights.ecommerce.rev_transactions`
ORDER BY channelGrouping;
```

```sql
--Description: 3) Check how many different countries exist for one sample channel (e.g. ‘Organic Search’)
SELECT DISTINCT geoNetwork_country
FROM `data-to-insights.ecommerce.rev_transactions`
WHERE channelGrouping = 'Organic Search'
ORDER BY geoNetwork_country
LIMIT 20;
```

```sql
--Description: 4) Remove exact-duplicate rows (SELECT DISTINCT)  
--   and count total transactions by channel & country
SELECT
  channelGrouping,
  geoNetwork_country  AS country,
  SUM(totals_transactions) AS total_transactions
FROM (
  SELECT DISTINCT *
  FROM `data-to-insights.ecommerce.rev_transactions`
)
WHERE totals_transactions IS NOT NULL
GROUP BY channelGrouping, country
ORDER BY total_transactions DESC
LIMIT 20;
```

```sql
--Description: 5) For each channel, count how many different countries recorded transactions
WITH clean AS (
  SELECT DISTINCT *
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
)
SELECT
  channelGrouping,
  COUNT(DISTINCT geoNetwork_country) AS country_count
FROM clean
GROUP BY channelGrouping
ORDER BY country_count DESC;
```

```sql
--Description: 6) Keep only those channels that have transactions coming from >1 country
WITH clean AS (
  SELECT DISTINCT *
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
),
countries_per_channel AS (
  SELECT channelGrouping
  FROM clean
  GROUP BY channelGrouping
  HAVING COUNT(DISTINCT geoNetwork_country) > 1
)
SELECT *
FROM countries_per_channel;
```

```sql
--Description: 7) For channels with >1 country, aggregate the sum of transactions by channel & country
WITH clean AS (
  SELECT DISTINCT *
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
),
multi_country_channels AS (
  SELECT channelGrouping
  FROM clean
  GROUP BY channelGrouping
  HAVING COUNT(DISTINCT geoNetwork_country) > 1
)
SELECT
  c.channelGrouping,
  c.geoNetwork_country AS country,
  SUM(c.totals_transactions) AS total_transactions
FROM clean c
JOIN multi_country_channels m
USING(channelGrouping)
GROUP BY c.channelGrouping, c.geoNetwork_country
ORDER BY c.channelGrouping, total_transactions DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – for each eligible channelGrouping, pick the country 
--   with the largest sum of transactions and report both the country and the sum
WITH clean AS (
  SELECT DISTINCT
         channelGrouping,
         geoNetwork_country AS country,
         totals_transactions
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
),
multi_country_channels AS (
  SELECT channelGrouping
  FROM clean
  GROUP BY channelGrouping
  HAVING COUNT(DISTINCT country) > 1
),
tx_per_channel_country AS (
  SELECT
    channelGrouping,
    country,
    SUM(totals_transactions) AS total_transactions
  FROM clean
  WHERE channelGrouping IN (SELECT channelGrouping FROM multi_country_channels)
  GROUP BY channelGrouping, country
),
ranked AS (
  SELECT
    channelGrouping,
    country,
    total_transactions,
    ROW_NUMBER() OVER (PARTITION BY channelGrouping ORDER BY total_transactions DESC) AS rnk
  FROM tx_per_channel_country
)
SELECT
  channelGrouping,
  country,
  total_transactions
FROM ranked
WHERE rnk = 1
ORDER BY channelGrouping;
```

These eight queries progress from simple inspection to the final result that lists every `channelGrouping` drawing transactions from more than one country, together with the country contributing the highest number of transactions and that summed total.
