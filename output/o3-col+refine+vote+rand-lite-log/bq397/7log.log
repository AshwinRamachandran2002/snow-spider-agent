Direct,Mexico,30
Direct,Taiwan,28
Query:
--Description: 8) FINAL ANSWER – for each eligible channelGrouping, pick the country 
--   with the largest sum of transactions and report both the country and the sum
WITH clean AS (
  SELECT DISTINCT
         channelGrouping,
         geoNetwork_country AS country,
         totals_transactions
  FROM `data-to-insights.ecommerce.rev_transactions`
  WHERE totals_transactions IS NOT NULL
),
multi_country_channels AS (
  SELECT channelGrouping
  FROM clean
  GROUP BY channelGrouping
  HAVING COUNT(DISTINCT country) > 1
),
tx_per_channel_country AS (
  SELECT
    channelGrouping,
    country,
    SUM(totals_transactions) AS total_transactions
  FROM clean
  WHERE channelGrouping IN (SELECT channelGrouping FROM multi_country_channels)
  GROUP BY channelGrouping, country
),
ranked AS (
  SELECT
    channelGrouping,
    country,
    total_transactions,
    ROW_NUMBER() OVER (PARTITION BY channelGrouping ORDER BY total_transactions DESC) AS rnk
  FROM tx_per_channel_country
)
SELECT
  channelGrouping,
  country,
  total_transactions
FROM ranked
WHERE rnk = 1
ORDER BY channelGrouping;
