```sql
--Description: Aggregate the total confirmed COVID-19 cases on 20-Apr-2020 for the seven target countries. 
SELECT
  country_region,
  SUM(confirmed) AS confirmed_cases
FROM `bigquery-public-data.covid19_jhu_csse.summary`
WHERE date = '2020-04-20'
  AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
GROUP BY country_region
LIMIT 20;
```

```sql
--Description: Inspect how “Population, total” is stored for one country (United States) in the World-Bank health table. 
SELECT
  country_name,
  indicator_name,
  year,
  value
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE country_name = 'United States'
  AND indicator_name = 'Population, total'
ORDER BY year DESC
LIMIT 20;
```

```sql
--Description: Peek at 2020 population values for the whole list of countries. 
SELECT
  country_name,
  year,
  value AS pop_2020
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE indicator_name = 'Population, total'
  AND year = 2020
  AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran')
LIMIT 20;
```

```sql
--Description: Sum (in case of duplicates) the 2020 population values per country. 
SELECT
  country_name,
  SUM(value) AS population_2020
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE indicator_name = 'Population, total'
  AND year = 2020
  AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran')
GROUP BY country_name
LIMIT 20;
```

```sql
--Description: Produce the final table – confirmed cases (20-Apr-2020), 2020 population, and cases-per-100k. 
WITH cases AS (
  SELECT
    country_region,
    SUM(confirmed) AS confirmed_cases
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE date = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
),
pop AS (
  SELECT
    country_name,
    SUM(value) AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE indicator_name = 'Population, total'
    AND year = 2020
    AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_name
)
SELECT
  -- harmonise country keys
  CASE
    WHEN cases.country_region = 'US' THEN 'United States'
    ELSE cases.country_region
  END                                           AS country,
  confirmed_cases,
  population_2020,
  ROUND( confirmed_cases * 100000.0 / population_2020 , 2) AS cases_per_100k
FROM cases
JOIN pop
ON ( (cases.country_region = 'US' AND pop.country_name = 'United States')
     OR (cases.country_region = pop.country_name) )
LIMIT 20;
```

```sql
--Description: (Optional) Show both tables together row-by-row before the final calculation for debugging. 
SELECT
  c.country_region,
  p.country_name,
  c.confirmed,
  p.value AS pop_value
FROM `bigquery-public-data.covid19_jhu_csse.summary`            AS c
JOIN `bigquery-public-data.world_bank_health_population.health_nutrition_population` AS p
ON 1=1
WHERE c.date = '2020-04-20'
  AND c.country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  AND p.indicator_name = 'Population, total'
  AND p.year = 2020
  AND (
        (c.country_region = 'US'      AND p.country_name = 'United States') OR
        (c.country_region = p.country_name)
      )
LIMIT 20;
```

```sql
--Description: Verify there are no duplicate 2020 population rows per country that could inflate totals. 
SELECT
  country_name,
  COUNT(*) AS row_cnt
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE indicator_name = 'Population, total'
  AND year = 2020
  AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran')
GROUP BY country_name
LIMIT 20;
```

```sql
--Description: Inspect the “confirmed_cases” wide table to confirm the _4_20_20 field’s values for our countries. 
SELECT
  country_or_region,
  _4_20_20 AS confirmed_on_4_20_20
FROM `bigquery-public-data.covid19_jhu_csse.confirmed_cases`
WHERE country_or_region IN ('US','France','China','Italy','Spain','Germany','Iran')
LIMIT 20;
```

```sql
--Description: Cross-check JHU summary total vs. the wide-format table for a single country (Italy). 
SELECT
  'summary_table' AS source,
  SUM(confirmed) AS cases
FROM `bigquery-public-data.covid19_jhu_csse.summary`
WHERE date = '2020-04-20' AND country_region = 'Italy'

UNION ALL

SELECT
  'wide_table'    AS source,
  SAFE_CAST(_4_20_20 AS INT64) AS cases
FROM `bigquery-public-data.covid19_jhu_csse.confirmed_cases`
WHERE country_or_region = 'Italy'
LIMIT 20;
```
