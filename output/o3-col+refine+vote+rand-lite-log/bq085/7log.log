Query:
--Description: Produce the final table – confirmed cases (20-Apr-2020), 2020 population, and cases-per-100k. 
WITH cases AS (
  SELECT
    country_region,
    SUM(confirmed) AS confirmed_cases
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE date = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
),
pop AS (
  SELECT
    country_name,
    SUM(value) AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE indicator_name = 'Population, total'
    AND year = 2020
    AND country_name IN ('United States','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_name
)
SELECT
  -- harmonise country keys
  CASE
    WHEN cases.country_region = 'US' THEN 'United States'
    ELSE cases.country_region
  END                                           AS country,
  confirmed_cases,
  population_2020,
  ROUND( confirmed_cases * 100000.0 / population_2020 , 2) AS cases_per_100k
FROM cases
JOIN pop
ON ( (cases.country_region = 'US' AND pop.country_name = 'United States')
     OR (cases.country_region = pop.country_name) )
LIMIT 20;
Answer:
country,confirmed_cases,population_2020,cases_per_100k
