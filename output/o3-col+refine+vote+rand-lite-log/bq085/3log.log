```sql
-- 9. Description: Join the confirmed-case totals with the 2020 populations and
--    calculate cases per 100,000 inhabitants.  
WITH cases AS (
  SELECT `country_or_region`                AS country,
         SUM(CAST(`_4_20_20` AS INT64))     AS confirmed
  FROM `bigquery-public-data.covid19_jhu_csse.confirmed_cases`
  WHERE `country_or_region` IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country
),
pops AS (
  SELECT CASE
           WHEN `country` = 'United States'        THEN 'US'
           WHEN `country` = 'France'               THEN 'France'
           WHEN `country` = 'China'                THEN 'China'
           WHEN `country` = 'Italy'                THEN 'Italy'
           WHEN `country` = 'Spain'                THEN 'Spain'
           WHEN `country` = 'Germany'              THEN 'Germany'
           WHEN `country` = 'Iran, Islamic Rep.'   THEN 'Iran'
         END AS country,
         SUM(`2020`) AS population_2020
  FROM `bigquery-public-data.world_bank_global_population.population_by_country`
  WHERE `country` IN ('United States','France','China','Italy','Spain','Germany','Iran, Islamic Rep.')
  GROUP BY country
)
SELECT c.country,
       c.confirmed,
       p.population_2020,
       ROUND(c.confirmed / p.population_2020 * 100000, 2) AS cases_per_100k
FROM cases AS c
JOIN pops  AS p
USING (country)
LIMIT 20;
