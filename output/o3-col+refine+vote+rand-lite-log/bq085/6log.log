```

```sql
--Description: 6) Use the narrow “summary” table and sum over provinces to get each country’s cases on 20-Apr-2020
SELECT country_region AS country,
       SUM(confirmed)  AS confirmed_2020_04_20
FROM   `bigquery-public-data.covid19_jhu_csse.summary`
WHERE  date = '2020-04-20'
  AND  country_region IN ('US', 'France', 'China', 'Italy', 
                          'Spain', 'Germany', 'Iran')
GROUP  BY country_region
LIMIT 20;
```

```sql
--Description: 7) Bring together (a) summed cases from the summary table and (b) 2020 population, resolving name differences
WITH cases AS (
  SELECT CASE WHEN country_region = 'US' THEN 'United States'
              ELSE country_region END AS country,
         SUM(confirmed) AS confirmed_2020_04_20
  FROM   `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE  date = '2020-04-20'
    AND  country_region IN ('US', 'France', 'China', 'Italy', 
                            'Spain', 'Germany', 'Iran')
  GROUP  BY country
), pop AS (
  SELECT CASE WHEN country = 'Iran, Islamic Rep.' THEN 'Iran'
              ELSE country END AS country,
         SUM(`2020`) AS population_2020
  FROM   `bigquery-public-data.world_bank_global_population.population_by_country`
  WHERE  country IN ('United States', 'France', 'China', 'Italy', 
                     'Spain', 'Germany', 'Iran, Islamic Rep.')
  GROUP  BY country
)
SELECT c.country,
       c.confirmed_2020_04_20,
       p.population_2020,
       ROUND(c.confirmed_2020_04_20 / p.population_2020 * 100000, 2) AS cases_per_100k
FROM   cases AS c
JOIN   pop   AS p
USING (country)
LIMIT 20;
```

```sql
