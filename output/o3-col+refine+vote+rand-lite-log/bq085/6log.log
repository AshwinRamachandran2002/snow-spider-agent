```sql
--Description: We need (a) total confirmed COVID-19 cases on 2020-04-20 for seven countries
--            and (b) their 2020 population in order to compute cases per 100 000 people.
--            1) “bigquery-public-data.covid19_jhu_csse.summary” lists daily cases; aggregate
--               on 2020-04-20 and translate the code “US” → “United States”.
--            2) “bigquery-public-data.world_bank_health_population.health_nutrition_population”
--               stores one row per (country, indicator, year); pick 2020 rows where
--               indicator_name = “Population, total”, translating “Iran, Islamic Rep.” → “Iran”.
--            3) Join the two CTEs on the harmonised country name and calculate
--               (confirmed / population) * 100 000.
WITH cases AS (
  SELECT
    CASE WHEN country_region = 'US' THEN 'United States'
         ELSE country_region
    END                       AS country,
    SUM(confirmed)            AS confirmed_2020_04_20
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE date = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country
),
pop AS (
  SELECT
    CASE WHEN country_name = 'Iran, Islamic Rep.' THEN 'Iran'
         ELSE country_name
    END                       AS country,
    SUM(value)                AS population_2020
  FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
  WHERE indicator_name = 'Population, total'
    AND year = 2020
    AND country_name IN ('United States','France','China','Italy',
                         'Spain','Germany','Iran, Islamic Rep.')
  GROUP BY country
)
SELECT
  c.country,
  c.confirmed_2020_04_20,
  p.population_2020,
  ROUND(c.confirmed_2020_04_20 / p.population_2020 * 100000, 2) AS cases_per_100k
FROM cases AS c
JOIN pop   AS p
USING (country)
ORDER BY confirmed_2020_04_20 DESC;
