```sql
--Description (thinking process embedded):
-- We need 2020 population totals for seven countries.  
-- 1) The “population_by_country” table does not have a `year_2020` column, so we switch
--    to the World-Bank “health_nutrition_population” table, which stores each year’s
--    value in rows and identifies population with indicator_name = 'Population, total'.  
-- 2) Filter rows for year = 2020 and our seven countries, then SUM(value) because some
--    countries can have multiple administrative rows (e.g., aggregates).  
-- 3) Rename the result as population_2020.
SELECT
  country_name AS country,
  SUM(value)   AS population_2020
FROM `bigquery-public-data.world_bank_health_population.health_nutrition_population`
WHERE indicator_name = 'Population, total'
  AND year = 2020
  AND country_name IN ('United States',
                       'France',
                       'China',
                       'Italy',
                       'Spain',
                       'Germany',
                       'Iran, Islamic Rep.')
GROUP BY country_name;
```
