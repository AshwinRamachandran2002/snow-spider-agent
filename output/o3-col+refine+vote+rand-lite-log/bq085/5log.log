```sql
--Description: Final result – join case counts and 2020 populations, then compute cases per 100,000 people
WITH case_counts AS (
  SELECT country_region,
         SUM(confirmed) AS total_cases
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE `date` = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
),
pop_2020 AS (
  SELECT country,
         `2020` AS population_2020
  FROM `bigquery-public-data.world_bank_global_population.population_by_country`
  WHERE country IN ('United States',
                    'France',
                    'China',
                    'Italy',
                    'Spain',
                    'Germany',
                    'Iran, Islamic Rep.')
)
SELECT 
  c.country_region,
  c.total_cases,
  p.population_2020,
  ROUND( (c.total_cases / p.population_2020) * 100000 , 2 ) AS cases_per_100k
FROM case_counts AS c
JOIN pop_2020 AS p
  ON ( (c.country_region = 'US'    AND p.country = 'United States') OR
       (c.country_region = 'Iran'  AND p.country = 'Iran, Islamic Rep.') OR
       (c.country_region <> 'US'   AND c.country_region <> 'Iran' AND c.country_region = p.country) )
LIMIT 20;
```

