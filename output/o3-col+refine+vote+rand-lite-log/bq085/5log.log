```sql
--Description (thinking process in-line):
-- Goal: For the seven countries, get confirmed-case totals on 2020-04-20,
--       join them to 2020 population totals, and compute cases per 100 000 people.
-- 1) case_counts CTE: sum confirmed cases on the target date for each country.
-- 2) pop_2020 CTE: pull the 2020 population column (year_2020) for the same countries
--    noting the two name mismatches: ‘US’ → ‘United States’ and
--    ‘Iran’ → ‘Iran, Islamic Rep.’ in the World-Bank table.
-- 3) Final SELECT joins both CTEs, reconciles the name mismatches,
--    and calculates cases_per_100k = (cases / population) * 100 000.

WITH case_counts AS (
  SELECT
    country_region,
    SUM(confirmed) AS total_cases
  FROM `bigquery-public-data.covid19_jhu_csse.summary`
  WHERE `date` = '2020-04-20'
    AND country_region IN ('US','France','China','Italy','Spain','Germany','Iran')
  GROUP BY country_region
),
pop_2020 AS (
  SELECT
    country,
    `year_2020` AS population_2020
  FROM `bigquery-public-data.world_bank_global_population.population_by_country`
  WHERE country IN ('United States',
                    'France',
                    'China',
                    'Italy',
                    'Spain',
                    'Germany',
                    'Iran, Islamic Rep.')
)
SELECT
  CASE
    WHEN c.country_region = 'US'   THEN 'United States'
    WHEN c.country_region = 'Iran' THEN 'Iran'
    ELSE c.country_region
  END                             AS country,
  c.total_cases,
  p.population_2020,
  ROUND( (c.total_cases / p.population_2020) * 100000, 2) AS cases_per_100k
FROM case_counts AS c
JOIN pop_2020  AS p
  ON ( (c.country_region = 'US'   AND p.country = 'United States')
    OR (c.country_region = 'Iran' AND p.country = 'Iran, Islamic Rep.')
    OR (c.country_region NOT IN ('US','Iran') AND c.country_region = p.country) );
```
