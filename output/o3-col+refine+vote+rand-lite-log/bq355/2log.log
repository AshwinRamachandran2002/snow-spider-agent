```sql
--Description: 1)  Find all OMOP concepts whose RxNorm code is 35208 (the RxCUI for quinapril).
SELECT *
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE concept_code = '35208'
LIMIT 20;
```

```sql
--Description: 2)  A broader look – any concepts whose name mentions “quinapril”.
SELECT *
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE LOWER(concept_name) LIKE '%quinapril%'
LIMIT 20;
```

```sql
--Description: 3)  Pick the concept_id that exactly matches RxCUI 35208 and list (sample of) all its descendants
--                (the row where ancestor = descendant is included, so it covers the ingredient itself
--                plus all brand / dose / combo descendants = “related medications”).
SELECT ca.ancestor_concept_id    AS quinapril_ancestor,
       ca.descendant_concept_id  AS quinapril_related_concept
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
       ON ca.ancestor_concept_id = c.concept_id
WHERE  c.concept_code = '35208'
LIMIT 20;
```

```sql
--Description: 4)  Show the names of some quinapril-related concepts obtained above.
SELECT cr.quinapril_related_concept,
       con.concept_name
FROM (
      SELECT ca.descendant_concept_id AS quinapril_related_concept
      FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
      JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
             ON ca.ancestor_concept_id = c.concept_id
      WHERE  c.concept_code = '35208'
      LIMIT 200        -- pull a bigger sample of descendants
     )  AS cr
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept` con
     ON con.concept_id = cr.quinapril_related_concept
LIMIT 20;
```

```sql
--Description: 5)  Inspect sample drug_era rows in which the person was exposed to quinapril
--                (either the ingredient itself or any descendant concept).
SELECT de.person_id,
       de.drug_concept_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
JOIN (
      SELECT ca.descendant_concept_id AS quinapril_related_concept
      FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
      JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
             ON ca.ancestor_concept_id = c.concept_id
      WHERE  c.concept_code = '35208'
     ) q
     ON de.drug_concept_id = q.quinapril_related_concept
LIMIT 20;
```

```sql
--Description: 6)  Show a few distinct participant IDs who have ever taken any quinapril-related drug.
SELECT DISTINCT de.person_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
JOIN (
      SELECT ca.descendant_concept_id AS quinapril_related_concept
      FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
      JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
             ON ca.ancestor_concept_id = c.concept_id
      WHERE  c.concept_code = '35208'
     ) q
     ON de.drug_concept_id = q.quinapril_related_concept
LIMIT 20;
```

```sql
--Description: 7)  Count of unique participants who have a drug_era for any quinapril-related drug.
SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
JOIN (
      SELECT ca.descendant_concept_id AS quinapril_related_concept
      FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
      JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
             ON ca.ancestor_concept_id = c.concept_id
      WHERE  c.concept_code = '35208'
     ) q
     ON de.drug_concept_id = q.quinapril_related_concept
LIMIT 20;
```

```sql
--Description: 8)  Total number of distinct participants appearing in drug_era (our study population).
SELECT COUNT(DISTINCT person_id) AS total_participants
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
LIMIT 20;
```

```sql
--Description: 9)  Compute percentage of participants who used quinapril (or related drugs).
WITH
q_users AS (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT ca.descendant_concept_id AS quinapril_related_concept
        FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
               ON ca.ancestor_concept_id = c.concept_id
        WHERE  c.concept_code = '35208'
       ) q
       ON de.drug_concept_id = q.quinapril_related_concept
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT 
  q_users.quinapril_users,
  tot.total_participants,
  ROUND(100.0 * q_users.quinapril_users / tot.total_participants, 2) AS pct_using_quinapril
FROM q_users, tot
LIMIT 20;
```

```sql
--Description: 10)  Final step – percentage of participants NOT using quinapril or any related medication.
WITH
q_users AS (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT ca.descendant_concept_id AS quinapril_related_concept
        FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
               ON ca.ancestor_concept_id = c.concept_id
        WHERE  c.concept_code = '35208'
       ) q
       ON de.drug_concept_id = q.quinapril_related_concept
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT 
  (tot.total_participants - q_users.quinapril_users)           AS participants_not_using_quinapril,
  tot.total_participants                                       AS total_participants,
  ROUND(100.0 * (tot.total_participants - q_users.quinapril_users) 
               / tot.total_participants, 2)                    AS pct_not_using_quinapril
FROM q_users, tot
LIMIT 20;
```
