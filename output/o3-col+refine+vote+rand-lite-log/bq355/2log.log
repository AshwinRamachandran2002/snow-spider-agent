Query:
--Description: 9)  Compute percentage of participants who used quinapril (or related drugs).
WITH
q_users AS (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT ca.descendant_concept_id AS quinapril_related_concept
        FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
               ON ca.ancestor_concept_id = c.concept_id
        WHERE  c.concept_code = '35208'
       ) q
       ON de.drug_concept_id = q.quinapril_related_concept
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT 
  q_users.quinapril_users,
  tot.total_participants,
  ROUND(100.0 * q_users.quinapril_users / tot.total_participants, 2) AS pct_using_quinapril
FROM q_users, tot
LIMIT 20;
Answer:
quinapril_users,total_participants,pct_using_quinapril
229876,2052681,11.2
Query:
--Description: 10)  Final step – percentage of participants NOT using quinapril or any related medication.
WITH
q_users AS (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT ca.descendant_concept_id AS quinapril_related_concept
        FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` c
               ON ca.ancestor_concept_id = c.concept_id
        WHERE  c.concept_code = '35208'
       ) q
       ON de.drug_concept_id = q.quinapril_related_concept
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT 
  (tot.total_participants - q_users.quinapril_users)           AS participants_not_using_quinapril,
  tot.total_participants                                       AS total_participants,
  ROUND(100.0 * (tot.total_participants - q_users.quinapril_users) 
               / tot.total_participants, 2)                    AS pct_not_using_quinapril
FROM q_users, tot
LIMIT 20;
Answer:
participants_not_using_quinapril,total_participants,pct_not_using_quinapril
