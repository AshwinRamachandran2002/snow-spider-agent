```sql
--Description: 7) Calculate the percentage of participants NOT using Quinapril or any related medication  
SELECT
  100.0 * (tot.total_participants - q.quinapril_users) / tot.total_participants
      AS pct_not_using_quinapril
FROM ( SELECT COUNT(DISTINCT person_id) AS total_participants
       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` ) tot
CROSS JOIN
     ( SELECT COUNT(DISTINCT person_id) AS quinapril_users
       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
       WHERE drug_concept_id IN (
               SELECT DISTINCT drug_concept_id
               FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_strength`
               WHERE ingredient_concept_id =
                     ( SELECT concept_id
                       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
                       WHERE concept_code = '35208'
                       LIMIT 1 )
             )
     ) q
LIMIT 20;
```

