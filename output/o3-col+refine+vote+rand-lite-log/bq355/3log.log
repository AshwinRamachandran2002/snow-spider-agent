```sql
--Description:  Identify the top 20 medications in the Quinapril family,
--              ranked by the number of unique participants who used each one.
--              THINKING PROCESS:
--              1)  We know from earlier steps that Quinapril’s OMOP concept_id 
--                  is 1331235 (RxNorm 35208).
--              2)  concept_ancestor tells us all descendant_concept_id values 
--                  that “roll up” to that ancestor—these include every strength,
--                  formulation, brand, and combination containing Quinapril.
--              3)  drug_era contains one row per person per drug exposure era,
--                  making it ideal for counting unique users (DISTINCT person_id).
--              4)  We join drug_era to the descendant list, group by each 
--                  drug_concept_id, count DISTINCT users, and then attach the 
--                  human-readable name from the concept table.
--              5)  Finally, we order by the user count in descending order and
--                  limit to 20 rows to satisfy the “sample” requirement.
WITH quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id = 1331235          -- Quinapril (RxNorm 35208)
)
SELECT
  de.drug_concept_id,
  c.concept_name,
  COUNT(DISTINCT de.person_id) AS user_count
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
JOIN
  quinapril_desc AS q
ON
  de.drug_concept_id = q.descendant_concept_id
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept` AS c
ON
  c.concept_id = de.drug_concept_id
GROUP BY
  de.drug_concept_id,
  c.concept_name
ORDER BY
  user_count DESC
LIMIT 20;
```
