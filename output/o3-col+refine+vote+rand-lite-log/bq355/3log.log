--             Quinapril (concept_id = 1331235).  This helps verify the size of
--             the “related medications” set.
SELECT
  COUNT(DISTINCT descendant_concept_id) AS num_related_concepts
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
WHERE
  ancestor_concept_id = 1331235
LIMIT 20
Answer:
num_related_concepts
1465
Query:
--Description: 4) Inspect a sample of drug_exposure rows whose drug_concept_id
--             belongs to the Quinapril descendant set (ancestor concept_id =
--             1331235).  Shows person_id, drug_concept_id, and drug_source_value
--             to validate the mapping.
WITH quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id = 1331235
)
SELECT
  de.person_id,
  de.drug_concept_id,
  de.drug_source_value
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_exposure` AS de
JOIN
  quinapril_desc AS q
ON
  de.drug_concept_id = q.descendant_concept_id
LIMIT 20
