```sql
--Description: 8) Produce the final percentage of participants that did NOT use
--              quinapril (or related meds).  The calculation is:
--                 100 * (1 - users / total)
WITH quinapril_users AS (
  SELECT
    COUNT(DISTINCT de.person_id) AS n_users
  FROM
    `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN
    ( SELECT descendant_concept_id
      FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
      WHERE ancestor_concept_id = 35208_CONCEPT_ID ) q
  ON q.descendant_concept_id = de.drug_concept_id
),
total_people AS (
  SELECT COUNT(DISTINCT person_id) AS n_total
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT
  ROUND( 100 * (1 - n_users / n_total), 2 ) AS pct_without_quinapril
FROM
  quinapril_users, total_people
LIMIT 20;      -- single-row final answer
```

