Query:
--Description: 6) Count the number of unique participants who have a drug_era
--             record for Quinapril or any related medication (descendants of
--             concept_id 1331235).  Returns one row with the user count.
WITH quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id = 1331235
)
SELECT
  COUNT(DISTINCT de.person_id) AS quinapril_users
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
JOIN
  quinapril_desc AS q
ON
  de.drug_concept_id = q.descendant_concept_id
LIMIT 20
Answer:
quinapril_users
229876
Query:
--Description: 7) Count the total number of unique participants present in
--             drug_era (study population denominator).  Returns one row.
SELECT
  COUNT(DISTINCT person_id) AS total_participants
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
LIMIT 20
Answer:
total_participants
2052681
Query:
--Description: 8) Compute the percentage of participants who did NOT use
--             Quinapril or any related medication.  Uses counts from the
--             previous two queries.  Returns a single percentage value.
WITH quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id = 1331235
),
quinapril_users AS (
  SELECT COUNT(DISTINCT person_id) AS n_users
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
  WHERE drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc)
),
total_people AS (
  SELECT COUNT(DISTINCT person_id) AS n_total
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT
  ROUND(100 * (1 - n_users / n_total), 2) AS pct_without_quinapril
FROM
  quinapril_users, total_people
LIMIT 20
Answer:
pct_without_quinapril
88.8
Query:
--Description: 9) Show the first 20 Quinapril-related medications (concept_id +
--             name) that actually appear in drug_era.  Confirms descendant
--             concepts are represented in the data.
WITH quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id = 1331235
),
era_desc AS (
  SELECT DISTINCT drug_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
  WHERE drug_concept_id IN (SELECT descendant_concept_id FROM quinapril_desc)
)
SELECT
  e.drug_concept_id,
  c.concept_name
FROM
  era_desc AS e
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept` AS c
ON
  c.concept_id = e.drug_concept_id
LIMIT 20
Answer:
drug_concept_id,concept_name
1331235,quinapril
Query:
--Description: 10) List the top 20 Quinapril-related medications ranked by the
--              number of unique users.  Helps understand which specific
--              descendants are most common.
WITH quinapril_desc AS (
  SELECT descendant_concept_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor`
  WHERE ancestor_concept_id = 1331235
)
SELECT
  de.drug_concept_id,
  c.concept_name,
  COUNT(DISTINCT de.person_id) AS users
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
JOIN
  quinapril_desc AS q
ON
  de.drug_concept_id = q.descendant_concept_id
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept` AS c
ON
  c.concept_id = de.drug_concept_id
GROUP BY
  de.drug_concept_id,
  c.concept_name
ORDER BY
  users DESC
LIMIT 20
Answer:
drug_concept_id,concept_name,users
1331235,quinapril,229876
