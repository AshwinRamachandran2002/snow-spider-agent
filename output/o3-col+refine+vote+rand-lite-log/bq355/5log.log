```sql
-- 7) Percentage of participants who did NOT use quinapril or its related medications
WITH
total AS (
  SELECT COUNT(DISTINCT person_id) AS n_total
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
),
users AS (
  SELECT COUNT(DISTINCT person_id) AS n_quin
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
  WHERE drug_concept_id IN (
        SELECT DISTINCT ca.descendant_concept_id
        FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN (
              SELECT concept_id
              FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
              WHERE LOWER(concept_name) LIKE '%quinapril%' OR concept_code = '35208'
        ) q
        ON ca.ancestor_concept_id = q.concept_id
  )
)
SELECT
  100.0 * (t.n_total - u.n_quin) / t.n_total AS pct_not_using_quinapril
FROM total t
JOIN users u ON TRUE
LIMIT 20;
```

