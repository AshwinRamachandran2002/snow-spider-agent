Query:
-- Description: 10)  Finally, calculate the percentage of participants NOT using 
--                   Quinapril or any related medication.
WITH
users AS (
  SELECT DISTINCT de.person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT DISTINCT descendant_concept_id AS drug_concept_id
        FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN (
              SELECT concept_id
              FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
              WHERE concept_code = '35208' OR LOWER(concept_name) LIKE '%quinapril%'
             ) q
        ON ca.ancestor_concept_id = q.concept_id
       ) quin
  ON de.drug_concept_id = quin.drug_concept_id
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS n_total
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT
  n_total - (SELECT COUNT(*) FROM users)        AS n_not_using_quinapril ,
  n_total                                       AS n_total_participants ,
  100.0 * (n_total - (SELECT COUNT(*) FROM users)) / n_total AS pct_not_using_quinapril
FROM tot
LIMIT 20;
