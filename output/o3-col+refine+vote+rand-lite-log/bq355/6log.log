-- Description: 3)  Find every descendant drug_concept_id that rolls up to ANY Quinapril concept_id 
--                  (includes combinations, different strengths, etc.).
SELECT DISTINCT ca.descendant_concept_id
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
JOIN (
      SELECT concept_id                      -- the Quinapril “ancestor(s)” collected above
      FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
      WHERE concept_code = '35208' OR LOWER(concept_name) LIKE '%quinapril%'
     ) q
ON ca.ancestor_concept_id = q.concept_id
LIMIT 20;
