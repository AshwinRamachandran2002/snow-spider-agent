```sql
-- Description: 6)  Show a sample of participants (person_id) who have at least one drug_era record 
--                  for any of those Quinapril-related concept_ids.
SELECT DISTINCT de.person_id , de.drug_concept_id
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`  de
JOIN (
      SELECT DISTINCT descendant_concept_id AS drug_concept_id
      FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
      JOIN (
            SELECT concept_id
            FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
            WHERE concept_code = '35208' OR LOWER(concept_name) LIKE '%quinapril%'
           ) q
      ON ca.ancestor_concept_id = q.concept_id
     ) quin
ON de.drug_concept_id = quin.drug_concept_id
LIMIT 20;
```

```sql
-- Description: 7)  Count the number of unique participants who used Quinapril or any related drug.
SELECT COUNT(DISTINCT de.person_id) AS n_quinapril_users
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
JOIN (
      SELECT DISTINCT descendant_concept_id AS drug_concept_id
      FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
      JOIN (
            SELECT concept_id
            FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
            WHERE concept_code = '35208' OR LOWER(concept_name) LIKE '%quinapril%'
           ) q
      ON ca.ancestor_concept_id = q.concept_id
     ) quin
ON de.drug_concept_id = quin.drug_concept_id;
```

```sql
-- Description: 8)  Determine the total number of distinct participants captured in the entire 
--                  drug_era table (the denominator for our percentage).
SELECT COUNT(DISTINCT person_id) AS n_total_participants
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`;
```

```sql
-- Description: 9)  Compute the percentage of participants who used Quinapril or related medications.
WITH
users AS (
  SELECT DISTINCT de.person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT DISTINCT descendant_concept_id AS drug_concept_id
        FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN (
              SELECT concept_id
              FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
              WHERE concept_code = '35208' OR LOWER(concept_name) LIKE '%quinapril%'
             ) q
        ON ca.ancestor_concept_id = q.concept_id
       ) quin
  ON de.drug_concept_id = quin.drug_concept_id
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS n_total
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT 
  (SELECT COUNT(*) FROM users) AS n_quinapril_users ,
  n_total ,
  100.0 * (SELECT COUNT(*) FROM users) / n_total AS pct_using_quinapril
FROM tot
LIMIT 20;
```

```sql
-- Description: 10)  Finally, calculate the percentage of participants NOT using 
--                   Quinapril or any related medication.
WITH
users AS (
  SELECT DISTINCT de.person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` de
  JOIN (
        SELECT DISTINCT descendant_concept_id AS drug_concept_id
        FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` ca
        JOIN (
              SELECT concept_id
              FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
              WHERE concept_code = '35208' OR LOWER(concept_name) LIKE '%quinapril%'
             ) q
        ON ca.ancestor_concept_id = q.concept_id
       ) quin
  ON de.drug_concept_id = quin.drug_concept_id
),
tot AS (
  SELECT COUNT(DISTINCT person_id) AS n_total
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT
  n_total - (SELECT COUNT(*) FROM users)        AS n_not_using_quinapril ,
  n_total                                       AS n_total_participants ,
  100.0 * (n_total - (SELECT COUNT(*) FROM users)) / n_total AS pct_not_using_quinapril
FROM tot
LIMIT 20;
```
