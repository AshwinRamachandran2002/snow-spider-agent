Query:
--Description: Compute the total number of distinct participants represented in the synthetic drug_era table.
SELECT
  COUNT(DISTINCT person_id) AS total_participants
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
Answer:
