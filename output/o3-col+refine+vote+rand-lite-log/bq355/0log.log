```sql
-- 1. Find the OMOP concept_id that corresponds to Quinapril (RxCUI = 35208)
SELECT
  concept_id,
  concept_name,
  concept_code
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE concept_code = '35208'
LIMIT 20;
```

```sql
-- 2. Double-check by searching for the string “quinapril” in all concept names
SELECT DISTINCT
  concept_id,
  concept_name,
  concept_code
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE LOWER(concept_name) LIKE '%quinapril%'
LIMIT 20;
```

```sql
-- 3. List every descendant (i.e., related branded forms, combos, etc.)
--    of the Quinapril ingredient concept_id using the concept_ancestor table
SELECT
  ca.descendant_concept_id
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
WHERE ca.ancestor_concept_id = 35208     -- ← replace with concept_id returned in query #1
LIMIT 20;
```

```sql
-- 4. Attach human-readable names to the first few descendant concept_ids
SELECT
  ca.descendant_concept_id,
  c.concept_name
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept`           AS c
  ON ca.descendant_concept_id = c.concept_id
WHERE ca.ancestor_concept_id = 35208
LIMIT 20;
```

```sql
-- 5. Peek at drug_era rows that involve any of those descendant concept_ids
SELECT
  de.person_id,
  de.drug_concept_id
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
  ON de.drug_concept_id = ca.descendant_concept_id
WHERE ca.ancestor_concept_id = 35208
LIMIT 20;
```

```sql
-- 6. Count distinct participants who ever had a Quinapril-related drug_era
SELECT
  COUNT(DISTINCT de.person_id) AS quinapril_users
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
  ON de.drug_concept_id = ca.descendant_concept_id
WHERE ca.ancestor_concept_id = 35208
LIMIT 20;
```

```sql
-- 7. Compute the total number of distinct participants in the synthetic cohort
SELECT
  COUNT(DISTINCT person_id) AS total_participants
FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
LIMIT 20;
```

```sql
-- 8. Bring the two counts together to see users vs. non-users
SELECT
  tot.total_participants,
  use.quinapril_users,
  (tot.total_participants - use.quinapril_users) AS non_users
FROM (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
) AS tot
CROSS JOIN (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
    ON de.drug_concept_id = ca.descendant_concept_id
  WHERE ca.ancestor_concept_id = 35208
) AS use
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER:  percentage of participants who did NOT use Quinapril
SELECT
  ROUND( (tot.total_participants - use.quinapril_users)
         / tot.total_participants * 100 , 2)  AS pct_not_using_quinapril
FROM (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
) AS tot
CROSS JOIN (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
    ON de.drug_concept_id = ca.descendant_concept_id
  WHERE ca.ancestor_concept_id = 35208
) AS use
LIMIT 20;
```

Each query progressively inspects the data, narrows down Quinapril-related concept_ids, counts users, and finally calculates the percentage of participants who did NOT use Quinapril or any related medications.
