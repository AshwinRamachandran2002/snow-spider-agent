Query:
--Description: Combine total participants with Quinapril users (ancestor 1331235) to get counts of users and non-users.
SELECT
  tot.total_participants,
  use.quinapril_users,
  (tot.total_participants - use.quinapril_users) AS non_users
FROM (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
) AS tot
CROSS JOIN (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
    ON de.drug_concept_id = ca.descendant_concept_id
  WHERE ca.ancestor_concept_id = 1331235
) AS use
Answer:
total_participants,quinapril_users,non_users
2052681,229876,1822805
Query:
--Description: Final calculation—percentage of participants who did NOT use any Quinapril-related medication (ancestor 1331235).
SELECT
  ROUND((tot.total_participants - use.quinapril_users) / tot.total_participants * 100, 2)
    AS pct_not_using_quinapril
FROM (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
) AS tot
CROSS JOIN (
  SELECT COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
    ON de.drug_concept_id = ca.descendant_concept_id
  WHERE ca.ancestor_concept_id = 1331235
) AS use
