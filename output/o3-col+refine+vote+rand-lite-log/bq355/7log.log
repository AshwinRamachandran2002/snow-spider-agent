```sql
--Description:  Calculate the share of participants who did NOT use Quinapril or
--              any related drug.  We 1) count all distinct persons appearing
--              in drug_era (denominator); 2) count the distinct persons whose
--              drug_era record maps (through concept_ancestor) to the Quinapril
--              ingredient concept_id 1331235 (numerator = users); 3) derive the
--              percentage of non-users.  LIMIT 1 because the query returns a
--              single summary row.
WITH users AS (
  SELECT DISTINCT de.person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`       AS de
  JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
    ON ca.descendant_concept_id = de.drug_concept_id
   AND ca.ancestor_concept_id   = 1331235        -- Quinapril ingredient
),
all_participants AS (
  SELECT DISTINCT person_id
  FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
)
SELECT
  COUNT(*)                                 AS total_participants,
  (SELECT COUNT(*) FROM users)             AS quinapril_users,
  COUNT(*) - (SELECT COUNT(*) FROM users)  AS non_users,
  ROUND( (COUNT(*) - (SELECT COUNT(*) FROM users)) * 100.0 / COUNT(*), 2 )
                                            AS pct_not_using_quinapril
FROM all_participants
LIMIT 1;
```
