--Description: 1) Look-up the OMOP concept that corresponds to the Quinapril
--   RxCUI 35208.  We’ll need the concept_id that represents the ingredient.
SELECT
  concept_id,
  concept_name,
  concept_code
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE
  concept_code = '35208'
LIMIT 20;
```

```sql
--Description: 2) Show the first 20 descendant concepts of the Quinapril
--   ingredient.  These are all clinical drugs, packs, etc. that
--   contain Quinapril and will be considered “related medications”.
SELECT
  ca.descendant_concept_id,
  c.concept_name
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept`        AS c
  ON c.concept_id = ca.descendant_concept_id
WHERE
  ca.ancestor_concept_id = 35208        -- <<-replace by concept_id returned in Q1 if different
ORDER BY
  ca.descendant_concept_id
LIMIT 20;
```

```sql
--Description: 3) Another way to find related drugs is through the
--   drug_strength table: pull the first 20 drug_concept_id that list
--   Quinapril (ingredient_concept_id = 35208) as an ingredient.
SELECT
  ds.drug_concept_id,
  c.concept_name
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_strength` AS ds
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept`       AS c
  ON c.concept_id = ds.drug_concept_id
WHERE
  ds.ingredient_concept_id = 35208
LIMIT 20;
```

```sql
--Description: 4) Preview (any) drug_era records for patients who took
--   Quinapril or its descendants.  Shows 20 example rows.
SELECT DISTINCT
  de.person_id,
  de.drug_concept_id
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
  ON ca.descendant_concept_id = de.drug_concept_id
WHERE
  ca.ancestor_concept_id = 35208
ORDER BY
  de.person_id
LIMIT 20;
```

```sql
--Description: 5) Preview a list (20 ids) of ALL participants that have
--   *any* drug_era record.  This will become the denominator.
SELECT DISTINCT
  person_id
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
ORDER BY
  person_id
LIMIT 20;
```

```sql
--Description: 6) Total number of distinct participants with at least one
--   drug_era record (denominator).
SELECT
  COUNT(DISTINCT person_id) AS total_participants
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
LIMIT 20;
```

```sql
--Description: 7) Count of distinct participants who used Quinapril or a
--   related medication (numerator for “users”).
SELECT
  COUNT(DISTINCT de.person_id) AS quinapril_users
FROM
  `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`       AS de
JOIN
  `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
  ON ca.descendant_concept_id = de.drug_concept_id
WHERE
  ca.ancestor_concept_id = 35208
LIMIT 20;
```

```sql
--Description: 8) Compute the percentage of participants NOT using
--   Quinapril or related drugs.
SELECT
  ( 1 - SAFE_DIVIDE(q_users, total) ) * 100 AS pct_not_using_quinapril
FROM (
  SELECT
    (SELECT COUNT(DISTINCT de.person_id)
       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
       JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
         ON ca.descendant_concept_id = de.drug_concept_id
      WHERE ca.ancestor_concept_id = 35208)     AS q_users,
    (SELECT COUNT(DISTINCT person_id)
       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`) AS total
)                                         
LIMIT 20;
```

```sql
--Description: 9) Show both counts side-by-side for clarity (users vs.
--   non-users) before converting to a percentage.
SELECT
  total_participants,
  quinapril_users,
  total_participants - quinapril_users AS non_users
FROM (
  SELECT
    COUNT(DISTINCT person_id) AS total_participants
  FROM
    `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era`
),
(
  SELECT
    COUNT(DISTINCT de.person_id) AS quinapril_users
  FROM
    `bigquery-public-data.cms_synthetic_patient_data_omop.drug_era` AS de
  JOIN
    `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
    ON ca.descendant_concept_id = de.drug_concept_id
  WHERE
    ca.ancestor_concept_id = 35208
)
LIMIT 20;
```

```sql
--Description: 10) Cross-check using dose_era instead of drug_era to make
--   sure the percentage looks similar.  (Optional validation.)
SELECT
  ( 1 - SAFE_DIVIDE(q_users, total) ) * 100 AS pct_not_using_quinapril_by_dose_era
FROM (
  SELECT
    (SELECT COUNT(DISTINCT de.person_id)
       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.dose_era` AS de
       JOIN `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` AS ca
         ON ca.descendant_concept_id = de.drug_concept_id
      WHERE ca.ancestor_concept_id = 35208)     AS q_users,
    (SELECT COUNT(DISTINCT person_id)
       FROM `bigquery-public-data.cms_synthetic_patient_data_omop.dose_era`) AS total
)
LIMIT 20;
```

