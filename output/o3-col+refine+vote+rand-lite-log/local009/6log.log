Query:
--Description: 5) Convert degrees to radians and compute great-circle distance (Haversine) for every such flight.  
WITH abakan_routes AS (
    SELECT
           f."flight_id",
           -- degrees → radians
           (CAST(substr(dep."coordinates", 2,
                        instr(dep."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS dep_lon,
           (CAST(substr(dep."coordinates",
                        instr(dep."coordinates", ',') + 1,
                        length(dep."coordinates") - instr(dep."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS dep_lat,
           (CAST(substr(arr."coordinates", 2,
                        instr(arr."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS arr_lon,
           (CAST(substr(arr."coordinates",
                        instr(arr."coordinates", ',') + 1,
                        length(arr."coordinates") - instr(arr."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS arr_lat
    FROM   "flights"        AS f
    JOIN   "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
    WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                     FROM "airports_data" AS a
                                     WHERE json_extract(a."city", '$.en') = 'Abakan'
                                        OR json_extract(a."city", '$.ru') = 'Абакан')
        OR f."arrival_airport"   IN (SELECT a."airport_code"
                                     FROM "airports_data" AS a
                                     WHERE json_extract(a."city", '$.en') = 'Abakan'
                                        OR json_extract(a."city", '$.ru') = 'Абакан')
)
SELECT
       flight_id,
       6371 * acos( cos(dep_lat) * cos(arr_lat) * cos(arr_lon - dep_lon)
                  + sin(dep_lat) * sin(arr_lat) )  AS distance_km
FROM   abakan_routes
LIMIT 20;
