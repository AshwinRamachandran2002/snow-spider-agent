```sql
--Description: 1) Find airport codes that serve the city “Abakan”.
SELECT DISTINCT
       a."airport_code",
       a."airport_name",
       a."city",
       a."coordinates"
FROM   "airports_data" AS a
WHERE  json_extract(a."city", '$.en') = 'Abakan'
   OR  json_extract(a."city", '$.ru') = 'Абакан'
LIMIT 20;
```

```sql
--Description: 2) List a few flights where Abakan’s airport is the point of departure or destination.  
SELECT DISTINCT
       f."flight_id",
       f."flight_no",
       f."departure_airport",
       f."arrival_airport"
FROM   "flights" AS f
WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                 FROM "airports_data" AS a
                                 WHERE json_extract(a."city", '$.en') = 'Abakan'
                                    OR json_extract(a."city", '$.ru') = 'Абакан')
    OR f."arrival_airport"   IN (SELECT a."airport_code"
                                 FROM "airports_data" AS a
                                 WHERE json_extract(a."city", '$.en') = 'Abakan'
                                    OR json_extract(a."city", '$.ru') = 'Абакан')
LIMIT 20;
```

```sql
--Description: 3) Bring in coordinates (lon & lat) of both departure and arrival airports for those flights.  
SELECT
       f."flight_id",
       f."departure_airport",
       dep."coordinates"  AS dep_coord,
       f."arrival_airport",
       arr."coordinates"  AS arr_coord
FROM   "flights"        AS f
JOIN   "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
JOIN   "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                 FROM "airports_data" AS a
                                 WHERE json_extract(a."city", '$.en') = 'Abakan'
                                    OR json_extract(a."city", '$.ru') = 'Абакан')
    OR f."arrival_airport"   IN (SELECT a."airport_code"
                                 FROM "airports_data" AS a
                                 WHERE json_extract(a."city", '$.en') = 'Abakan'
                                    OR json_extract(a."city", '$.ru') = 'Абакан')
LIMIT 20;
```

```sql
--Description: 4) Split point strings “(lon,lat)” into decimal numbers (in degrees).  
SELECT
       f."flight_id",
       CAST(substr(dep."coordinates",
                   2,
                   instr(dep."coordinates", ',') - 2) AS REAL)                AS dep_lon_deg,
       CAST(substr(dep."coordinates",
                   instr(dep."coordinates", ',') + 1,
                   length(dep."coordinates") - instr(dep."coordinates", ',') - 1) AS REAL) AS dep_lat_deg,
       CAST(substr(arr."coordinates",
                   2,
                   instr(arr."coordinates", ',') - 2) AS REAL)                AS arr_lon_deg,
       CAST(substr(arr."coordinates",
                   instr(arr."coordinates", ',') + 1,
                   length(arr."coordinates") - instr(arr."coordinates", ',') - 1) AS REAL) AS arr_lat_deg
FROM   "flights"        AS f
JOIN   "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
JOIN   "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                 FROM "airports_data" AS a
                                 WHERE json_extract(a."city", '$.en') = 'Abakan'
                                    OR json_extract(a."city", '$.ru') = 'Абакан')
    OR f."arrival_airport"   IN (SELECT a."airport_code"
                                 FROM "airports_data" AS a
                                 WHERE json_extract(a."city", '$.en') = 'Abakan'
                                    OR json_extract(a."city", '$.ru') = 'Абакан')
LIMIT 20;
```

```sql
--Description: 5) Convert degrees to radians and compute great-circle distance (Haversine) for every such flight.  
WITH abakan_routes AS (
    SELECT
           f."flight_id",
           -- degrees → radians
           (CAST(substr(dep."coordinates", 2,
                        instr(dep."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS dep_lon,
           (CAST(substr(dep."coordinates",
                        instr(dep."coordinates", ',') + 1,
                        length(dep."coordinates") - instr(dep."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS dep_lat,
           (CAST(substr(arr."coordinates", 2,
                        instr(arr."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS arr_lon,
           (CAST(substr(arr."coordinates",
                        instr(arr."coordinates", ',') + 1,
                        length(arr."coordinates") - instr(arr."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS arr_lat
    FROM   "flights"        AS f
    JOIN   "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
    WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                     FROM "airports_data" AS a
                                     WHERE json_extract(a."city", '$.en') = 'Abakan'
                                        OR json_extract(a."city", '$.ru') = 'Абакан')
        OR f."arrival_airport"   IN (SELECT a."airport_code"
                                     FROM "airports_data" AS a
                                     WHERE json_extract(a."city", '$.en') = 'Abakan'
                                        OR json_extract(a."city", '$.ru') = 'Абакан')
)
SELECT
       flight_id,
       6371 * acos( cos(dep_lat) * cos(arr_lat) * cos(arr_lon - dep_lon)
                  + sin(dep_lat) * sin(arr_lat) )  AS distance_km
FROM   abakan_routes
LIMIT 20;
```

```sql
--Description: 6) Find the maximum distance among all Abakan-related flights.  
WITH abakan_routes AS (
    SELECT
           f."flight_id",
           (CAST(substr(dep."coordinates", 2,
                        instr(dep."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS dep_lon,
           (CAST(substr(dep."coordinates",
                        instr(dep."coordinates", ',') + 1,
                        length(dep."coordinates") - instr(dep."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS dep_lat,
           (CAST(substr(arr."coordinates", 2,
                        instr(arr."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS arr_lon,
           (CAST(substr(arr."coordinates",
                        instr(arr."coordinates", ',') + 1,
                        length(arr."coordinates") - instr(arr."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS arr_lat
    FROM   "flights"        AS f
    JOIN   "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
    WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                     FROM "airports_data" AS a
                                     WHERE json_extract(a."city", '$.en') = 'Abakan'
                                        OR json_extract(a."city", '$.ru') = 'Абакан')
        OR f."arrival_airport"   IN (SELECT a."airport_code"
                                     FROM "airports_data" AS a
                                     WHERE json_extract(a."city", '$.en') = 'Abakan'
                                        OR json_extract(a."city", '$.ru') = 'Абакан')
)
SELECT MAX(6371 * acos( cos(dep_lat) * cos(arr_lat) * cos(arr_lon - dep_lon)
                      + sin(dep_lat) * sin(arr_lat) ))  AS max_distance_km
FROM   abakan_routes;
```

```sql
--Description: 7) Final answer – the distance (km) of the longest route that starts or ends in Abakan.  
SELECT ROUND(
       (SELECT MAX(6371 * acos( cos(dep_lat) * cos(arr_lat) * cos(arr_lon - dep_lon)
                             + sin(dep_lat) * sin(arr_lat) ))
        FROM (
              SELECT
                     (CAST(substr(dep."coordinates", 2,
                                  instr(dep."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS dep_lon,
                     (CAST(substr(dep."coordinates",
                                  instr(dep."coordinates", ',') + 1,
                                  length(dep."coordinates") - instr(dep."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS dep_lat,
                     (CAST(substr(arr."coordinates", 2,
                                  instr(arr."coordinates", ',') - 2) AS REAL) * 0.017453292519943) AS arr_lon,
                     (CAST(substr(arr."coordinates",
                                  instr(arr."coordinates", ',') + 1,
                                  length(arr."coordinates") - instr(arr."coordinates", ',') - 1) AS REAL) * 0.017453292519943) AS arr_lat
              FROM   "flights"        AS f
              JOIN   "airports_data"  AS dep ON dep."airport_code" = f."departure_airport"
              JOIN   "airports_data"  AS arr ON arr."airport_code" = f."arrival_airport"
              WHERE  f."departure_airport" IN (SELECT a."airport_code"
                                               FROM "airports_data" AS a
                                               WHERE json_extract(a."city", '$.en') = 'Abakan'
                                                  OR json_extract(a."city", '$.ru') = 'Абакан')
                  OR f."arrival_airport"   IN (SELECT a."airport_code"
                                               FROM "airports_data" AS a
                                               WHERE json_extract(a."city", '$.en') = 'Abakan'
                                                  OR json_extract(a."city", '$.ru') = 'Абакан')
        )), 1) AS "Longest_Abakan_Route_km";
```
