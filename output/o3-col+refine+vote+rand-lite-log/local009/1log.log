           ELSE f."departure_airport"
       END                                                AS counterpart_airport,
       ROUND(
             2 * 6371 * ASIN(
                   SQRT(
                         POWER( SIN( RADIANS( ( y(arr."coordinates") - y(dep."coordinates") ) / 2 ) ), 2 )
                       + COS( RADIANS( y(dep."coordinates") ) )
                       * COS( RADIANS( y(arr."coordinates") ) )
                       * POWER( SIN( RADIANS( ( x(arr."coordinates") - x(dep."coordinates") ) / 2 ) ), 2 )
                   )
             ), 2
       )                                                AS distance_km
FROM   "flights" AS f
JOIN   "airports_data" AS dep ON dep."airport_code" = f."departure_airport"
JOIN   "airports_data" AS arr ON arr."airport_code" = f."arrival_airport"
WHERE  dep."airport_code" = 'ABA' OR arr."airport_code" = 'ABA'
LIMIT 20;
