```sql
--Description: Compute the longest (great-circle) distance, in kilometres, of any flight whose
--             departure- or arrival-airport is Abakan (“ABA”).
--             1) airport_coords  : turn the point text “(lon,lat)” into numeric lon/lat columns.
--             2) abakan_flights  : all rows in flights where ABA is either end.
--             3) distance_calc   : join the two airports of every such flight, convert their
--                                  coordinates to radians (deg × π/180) and apply the
--                                  Haversine formula (2·R·asin(…); R = 6 371 km).
--             4) final SELECT    : pick the maximum distance, rounded to the nearest kilometre.
WITH airport_coords AS (
        SELECT
               a."airport_code",
               CAST(SUBSTR(c, 1, INSTR(c, ',') - 1) AS REAL) AS lon_deg,
               CAST(SUBSTR(c, INSTR(c, ',') + 1)   AS REAL) AS lat_deg
        FROM (
                SELECT
                       "airport_code",
                       REPLACE(REPLACE("coordinates", '(', ''), ')', '') AS c
                FROM   "airports_data"
        ) AS a
),
abakan_flights AS (
        SELECT "flight_id", "departure_airport", "arrival_airport"
        FROM   "flights"
        WHERE  'ABA' IN ("departure_airport", "arrival_airport")
),
distance_calc AS (
        SELECT
               af."flight_id",
               /* convert degrees to radians on the fly (π/180 = 0.01745…) */
               2 * 6371 *
               ASIN(
                    SQRT(
                          POWER(SIN( (ac2.lat_deg - ac1.lat_deg) * 0.017453292519943295 / 2 ), 2) +
                          COS(ac1.lat_deg * 0.017453292519943295) *
                          COS(ac2.lat_deg * 0.017453292519943295) *
                          POWER(SIN( (ac2.lon_deg - ac1.lon_deg) * 0.017453292519943295 / 2 ), 2)
                    )
               ) AS distance_km
        FROM   abakan_flights  af
        JOIN   airport_coords  ac1 ON ac1."airport_code" = af."departure_airport"
        JOIN   airport_coords  ac2 ON ac2."airport_code" = af."arrival_airport"
)
SELECT ROUND(MAX(distance_km), 0) AS longest_abakan_route_km
FROM   distance_calc;
```
