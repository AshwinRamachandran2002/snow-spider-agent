```sql
--Description: 1) Find the airport code(s) that correspond to Abakan
SELECT DISTINCT 
       ad.airport_code,
       ad.airport_name->>'en'  AS airport_en_name,
       ad.city->>'en'          AS city_en_name,
       ad.coordinates
FROM   airports_data AS ad
WHERE  ad.airport_name->>'en' LIKE '%Abakan%'
    OR ad.city->>'en'         LIKE '%Abakan%'
LIMIT 20;
```

```sql
--Description: 2) Look at flights whose departure airport is Abakan
SELECT DISTINCT
       f.flight_id,
       f.departure_airport,
       f.arrival_airport,
       f.scheduled_departure
FROM   flights AS f
WHERE  f.departure_airport = 'ABA'
LIMIT 20;
```

```sql
--Description: 3) Look at flights whose arrival airport is Abakan
SELECT DISTINCT
       f.flight_id,
       f.departure_airport,
       f.arrival_airport,
       f.scheduled_departure
FROM   flights AS f
WHERE  f.arrival_airport = 'ABA'
LIMIT 20;
```

```sql
--Description: 4) Collect every unique route where Abakan is either departure or arrival
SELECT DISTINCT
       CASE WHEN f.departure_airport = 'ABA' THEN f.arrival_airport
            ELSE f.departure_airport
       END                                     AS other_airport,
       f.departure_airport,
       f.arrival_airport
FROM   flights AS f
WHERE  f.departure_airport = 'ABA'
    OR f.arrival_airport   = 'ABA'
LIMIT 20;
```

```sql
--Description: 5) Bring coordinates of Abakan (alias a) and the opposite airport (alias b)
SELECT DISTINCT
       a.airport_code       AS abakan_code,
       b.airport_code       AS other_code,
       a.coordinates        AS abakan_coord,
       b.coordinates        AS other_coord
FROM   (
        SELECT DISTINCT airport_code, coordinates
        FROM   airports_data
        WHERE  airport_code = 'ABA'
       )                     AS a
JOIN   airports_data         AS b
       ON b.airport_code IN (
            SELECT DISTINCT
                   CASE WHEN f.departure_airport = 'ABA' THEN f.arrival_airport
                        ELSE f.departure_airport
                   END
            FROM   flights AS f
            WHERE  f.departure_airport = 'ABA'
               OR  f.arrival_airport   = 'ABA'
       )
LIMIT 20;
```

```sql
--Description: 6) Parse longitude / latitude (as REAL) from the point text for Abakan
SELECT 
       a.airport_code,
       CAST( substr(a.coordinates,  2,
                    instr(a.coordinates, ',')-2 ) AS REAL) AS lon,
       CAST( rtrim(substr(a.coordinates,
                    instr(a.coordinates, ',')+1 ),
                    ')') AS REAL)                    AS lat
FROM   airports_data AS a
WHERE  a.airport_code = 'ABA'
LIMIT 20;
```

```sql
--Description: 7) Parse longitude / latitude for every airport that partners with Abakan routes
SELECT 
       b.airport_code,
       CAST( substr(b.coordinates,  2,
                    instr(b.coordinates, ',')-2 ) AS REAL) AS lon,
       CAST( rtrim(substr(b.coordinates,
                    instr(b.coordinates, ',')+1 ),
                    ')') AS REAL)                    AS lat
FROM   airports_data AS b
WHERE  b.airport_code IN (
         SELECT DISTINCT
                CASE WHEN f.departure_airport = 'ABA' THEN f.arrival_airport
                     ELSE f.departure_airport
                END
         FROM   flights AS f
         WHERE  f.departure_airport = 'ABA'
            OR  f.arrival_airport   = 'ABA'
       )
LIMIT 20;
```

```sql
--Description: 8) Calculate the great-circle distance (km) from Abakan to every partner airport
SELECT
       b.airport_code                                                  AS other_code,
       ROUND(
             6371 * acos(
                    cos(a.lat * pi() / 180)
                  * cos(b.lat * pi() / 180)
                  * cos( (b.lon - a.lon) * pi() / 180)
                  + sin(a.lat * pi() / 180)
                  * sin(b.lat * pi() / 180)
             )
       , 1)                                                            AS distance_km
FROM   (
        -- Abakan lon / lat
        SELECT 
               CAST( substr(coordinates, 2,
                             instr(coordinates, ',')-2 ) AS REAL) AS lon,
               CAST( rtrim(substr(coordinates,
                             instr(coordinates, ',')+1 ),
                             ')') AS REAL)                  AS lat
        FROM   airports_data
        WHERE  airport_code = 'ABA'
       ) AS a
CROSS JOIN (
        -- Partner airports lon / lat
        SELECT 
               airport_code,
               CAST( substr(coordinates, 2,
                             instr(coordinates, ',')-2 ) AS REAL) AS lon,
               CAST( rtrim(substr(coordinates,
                             instr(coordinates, ',')+1 ),
                             ')') AS REAL)                  AS lat
        FROM   airports_data
        WHERE  airport_code IN (
                 SELECT DISTINCT
                        CASE WHEN f.departure_airport = 'ABA' THEN f.arrival_airport
                             ELSE f.departure_airport
                        END
                 FROM   flights AS f
                 WHERE  f.departure_airport = 'ABA'
                    OR  f.arrival_airport   = 'ABA'
               )
       ) AS b
LIMIT 20;
```

```sql
--Description: 9) Order the routes by distance, show the longest one on top
SELECT 
       other_code,
       distance_km
FROM (
       -- same subquery as #8
       SELECT
              b.airport_code AS other_code,
              ROUND(
                    6371 * acos(
                           cos(a.lat * pi() / 180)
                         * cos(b.lat * pi() / 180)
                         * cos( (b.lon - a.lon) * pi() / 180)
                         + sin(a.lat * pi() / 180)
                         * sin(b.lat * pi() / 180)
                    )
              , 1) AS distance_km
       FROM   (
               SELECT 
                      CAST( substr(coordinates, 2,
                                    instr(coordinates, ',')-2 ) AS REAL) AS lon,
                      CAST( rtrim(substr(coordinates,
                                    instr(coordinates, ',')+1 ),
                                    ')') AS REAL)                  AS lat
               FROM   airports_data
               WHERE  airport_code = 'ABA'
              ) AS a
       CROSS JOIN (
               SELECT 
                      airport_code,
                      CAST( substr(coordinates, 2,
                                    instr(coordinates, ',')-2 ) AS REAL) AS lon,
                      CAST( rtrim(substr(coordinates,
                                    instr(coordinates, ',')+1 ),
                                    ')') AS REAL)                  AS lat
               FROM   airports_data
               WHERE  airport_code IN (
                        SELECT DISTINCT
                               CASE WHEN f.departure_airport = 'ABA' THEN f.arrival_airport
                                    ELSE f.departure_airport
                               END
                        FROM   flights AS f
                        WHERE  f.departure_airport = 'ABA'
                           OR  f.arrival_airport   = 'ABA'
                      )
              ) AS b
     )
ORDER BY distance_km DESC
LIMIT 20;
```

