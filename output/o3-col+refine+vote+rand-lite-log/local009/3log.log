Query:
--Description: 5) Fetch coordinates for Abakan and all opposite airports on its routes
SELECT DISTINCT
       a.airport_code AS abakan_code,
       b.airport_code AS other_code,
       a.coordinates  AS abakan_coord,
       b.coordinates  AS other_coord
FROM  (SELECT airport_code, coordinates
       FROM   airports_data
       WHERE  airport_code = 'ABA') AS a
JOIN  airports_data AS b
      ON b.airport_code IN (
           SELECT DISTINCT
                  CASE
                       WHEN departure_airport = 'ABA' THEN arrival_airport
                       ELSE departure_airport
                  END
           FROM   flights
           WHERE  departure_airport = 'ABA'
              OR  arrival_airport   = 'ABA'
      )
LIMIT 20
