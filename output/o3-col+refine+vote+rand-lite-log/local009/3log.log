```sql
--Description: To locate Abakan’s airport(s) we must look inside two JSON columns,
--“airport_name” and “city”, extracting their English values.  Because SQLite
--doesn’t support the Postgres “->>” operator, json_extract() is used instead.
--We search each extracted value for the substring “Abakan”; any match returns
--the airport code plus its English name, city, and coordinates (limited to 20).
SELECT DISTINCT
       airport_code,
       json_extract(airport_name, '$.en') AS airport_en_name,
       json_extract(city,        '$.en') AS city_en_name,
       coordinates
FROM   airports_data
WHERE  json_extract(airport_name, '$.en') LIKE '%Abakan%'
   OR  json_extract(city,        '$.en') LIKE '%Abakan%'
LIMIT 20;
```
