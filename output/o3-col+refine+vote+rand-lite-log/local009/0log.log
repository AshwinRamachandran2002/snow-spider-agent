--Description: 6) Aggregate by origin-destination pair for every Abakan-involving route and list them
--in descending order of distance (km).  Coordinates are parsed in CTE “coords”; then flights
--are joined twice (d = departure, a = arrival) and the spherical-law-of-cosines formula is applied.
WITH coords AS (
    SELECT
        airport_code,
        CAST(substr(coordinates, 2,
                    instr(coordinates, ',') - 2) AS REAL)            AS lon,
        CAST(substr(coordinates,
                    instr(coordinates, ',') + 1,
                    instr(coordinates, ')') - instr(coordinates, ',') - 1) AS REAL) AS lat,
        json_extract(city, '$.en')                                   AS city_en
    FROM airports_data
)
SELECT
       d.airport_code AS from_code,
       a.airport_code AS to_code,
       MAX(                     -- in case several flights fly the same route
           6371 * acos(
               cos((d.lat * 3.141592653589793)/180) *
               cos((a.lat * 3.141592653589793)/180) *
               cos((a.lon - d.lon) * 3.141592653589793/180) +
               sin((d.lat * 3.141592653589793)/180) *
               sin((a.lat * 3.141592653589793)/180)
           )
       ) AS distance_km
FROM flights AS f
JOIN coords AS d ON d.airport_code = f.departure_airport   -- departure coords
JOIN coords AS a ON a.airport_code = f.arrival_airport     -- arrival coords
WHERE d.city_en = 'Abakan'      -- Abakan is origin …
   OR a.city_en = 'Abakan'      -- … or destination
GROUP BY d.airport_code, a.airport_code
ORDER BY distance_km DESC
LIMIT 20
