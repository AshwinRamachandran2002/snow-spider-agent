```sql
--Description:  Compute the great-circle distance (km) for every route where Abakan
--              (airport code ‘ABA’) is either the origin or destination, then
--              return the longest one.
--  • routes   : all DISTINCT “other” airports paired with ABA in flights
--  • abakan   : longitude / latitude of Abakan parsed from the text “point”
--  • others   : coordinates of every paired airport, likewise parsed
--  • dist_calc: apply spherical law-of-cosines
--  • final    : pick MAX distance → longest Abakan route (rounded to 0.1 km)

WITH routes AS (
    SELECT DISTINCT
           CASE WHEN departure_airport = 'ABA'
                THEN arrival_airport
                ELSE departure_airport
           END AS other_code
    FROM flights
    WHERE departure_airport = 'ABA'
       OR arrival_airport   = 'ABA'
),
abakan AS (
    SELECT
        CAST(SUBSTR(coordinates, 2,
             INSTR(coordinates, ',') - 2) AS REAL)                  AS lon1,
        CAST(SUBSTR(coordinates,
             INSTR(coordinates, ',') + 1,
             INSTR(coordinates, ')') - INSTR(coordinates, ',') - 1) AS REAL) AS lat1
    FROM airports_data
    WHERE airport_code = 'ABA'
),
others AS (
    SELECT
        r.other_code,
        CAST(SUBSTR(o.coordinates, 2,
             INSTR(o.coordinates, ',') - 2) AS REAL)                  AS lon2,
        CAST(SUBSTR(o.coordinates,
             INSTR(o.coordinates, ',') + 1,
             INSTR(o.coordinates, ')') - INSTR(o.coordinates, ',') - 1) AS REAL) AS lat2
    FROM routes r
    JOIN airports_data o ON o.airport_code = r.other_code
),
dist_calc AS (
    SELECT
        other_code,
        6371 * ACOS(
            COS(lat1 * 3.141592653589793 / 180) *
            COS(lat2 * 3.141592653589793 / 180) *
            COS((lon2 - lon1) * 3.141592653589793 / 180) +
            SIN(lat1 * 3.141592653589793 / 180) *
            SIN(lat2 * 3.141592653589793 / 180)
        ) AS distance_km
    FROM abakan, others
)
SELECT ROUND(MAX(distance_km), 1) AS longest_abakan_route_km
FROM   dist_calc;
```
