Query:
--Description: Combine “vehicle” and “firearm” results for ages 12-18 in one table.
SELECT 
       d."Age" AS "Age_Years",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%' THEN 1 END)                                       AS "Total_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                                          AS "Black_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%' THEN 1 END)                                       AS "Total_Firearm_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                                          AS "Black_Firearm_Deaths"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
LEFT  JOIN DEATH.DEATH.RACE           r  ON r."Code" = d."Race"
WHERE  d."AgeType" = 1
  AND  d."Age" BETWEEN 12 AND 18
  AND (i."Description" ILIKE '%vehicle%' OR i."Description" ILIKE '%firearm%')
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
Answer:
Age_Years,Total_Vehicle_Deaths,Black_Vehicle_Deaths,Total_Firearm_Deaths,Black_Firearm_Deaths
12,60,16,39,7
13,71,12,71,15
14,93,20,105,27
15,133,23,164,58
16,262,42,246,109
17,341,43,341,167
18,494,65,495,238
Query:
--Description: Same combined query but rolled up to show a grand total across ages 12-18.
SELECT 
       '12-18'                                           AS "Age_Group",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%'  THEN 1 END)                     AS "Total_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                        AS "Black_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%'  THEN 1 END)                     AS "Total_Firearm_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                        AS "Black_Firearm_Deaths"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
LEFT  JOIN DEATH.DEATH.RACE           r  ON r."Code" = d."Race"
WHERE  d."AgeType" = 1
  AND  d."Age" BETWEEN 12 AND 18
  AND (i."Description" ILIKE '%vehicle%' OR i."Description" ILIKE '%firearm%')
LIMIT 20;
