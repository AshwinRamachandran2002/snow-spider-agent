```sql
--Description: Show 20 death-records tied to ICD-10 codes whose descriptions include “vehicle”.
SELECT DISTINCT 
       d."Id"                    AS "DeathRecordId",
       d."Age",
       d."AgeType",
       d."Race",
       e."Icd10Code"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
WHERE  i."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Show 20 death-records tied to ICD-10 codes whose descriptions include “firearm”.
SELECT DISTINCT 
       d."Id"                    AS "DeathRecordId",
       d."Age",
       d."AgeType",
       d."Race",
       e."Icd10Code"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
WHERE  i."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: Count total “vehicle” deaths and those with Black race for ages 12-18 (inclusive).
SELECT 
       d."Age"                                 AS "Age_Years",
       COUNT(*)                                AS "Total_Vehicle_Deaths",
       COUNT_IF(r."Description" ILIKE '%black%') AS "Black_Vehicle_Deaths"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
LEFT  JOIN DEATH.DEATH.RACE           r  ON r."Code" = d."Race"
WHERE  i."Description" ILIKE '%vehicle%'
  AND  d."AgeType" = 1                 -- age reported in years
  AND  d."Age" BETWEEN 12 AND 18
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
--Description: Count total “firearm” deaths and those with Black race for ages 12-18 (inclusive).
SELECT 
       d."Age"                                 AS "Age_Years",
       COUNT(*)                                AS "Total_Firearm_Deaths",
       COUNT_IF(r."Description" ILIKE '%black%') AS "Black_Firearm_Deaths"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
LEFT  JOIN DEATH.DEATH.RACE           r  ON r."Code" = d."Race"
WHERE  i."Description" ILIKE '%firearm%'
  AND  d."AgeType" = 1                 -- age reported in years
  AND  d."Age" BETWEEN 12 AND 18
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
--Description: Combine “vehicle” and “firearm” results for ages 12-18 in one table.
SELECT 
       d."Age" AS "Age_Years",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%' THEN 1 END)                                       AS "Total_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                                          AS "Black_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%' THEN 1 END)                                       AS "Total_Firearm_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                                          AS "Black_Firearm_Deaths"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
LEFT  JOIN DEATH.DEATH.RACE           r  ON r."Code" = d."Race"
WHERE  d."AgeType" = 1
  AND  d."Age" BETWEEN 12 AND 18
  AND (i."Description" ILIKE '%vehicle%' OR i."Description" ILIKE '%firearm%')
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
--Description: Same combined query but rolled up to show a grand total across ages 12-18.
SELECT 
       '12-18'                                           AS "Age_Group",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%'  THEN 1 END)                     AS "Total_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%vehicle%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                        AS "Black_Vehicle_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%'  THEN 1 END)                     AS "Total_Firearm_Deaths",
       SUM(CASE WHEN i."Description" ILIKE '%firearm%' 
                AND r."Description" ILIKE '%black%' THEN 1 END)                        AS "Black_Firearm_Deaths"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS e
JOIN   DEATH.DEATH.ICD10CODE          i  ON i."Code" = e."Icd10Code"
JOIN   DEATH.DEATH.DEATHRECORDS       d  ON d."Id"   = e."DeathRecordId"
LEFT  JOIN DEATH.DEATH.RACE           r  ON r."Code" = d."Race"
WHERE  d."AgeType" = 1
  AND  d."Age" BETWEEN 12 AND 18
  AND (i."Description" ILIKE '%vehicle%' OR i."Description" ILIKE '%firearm%')
LIMIT 20;
```
