```sql
-- 8) Aggregate counts (total & Black deaths) for VEHICLE-related deaths by single year of age (12-18)
SELECT 
       dr."Age",
       COUNT(*)                                                AS "TotalDeaths_Vehicle",
       SUM(CASE WHEN r."Description" ILIKE '%black%' THEN 1 END) AS "BlackDeaths_Vehicle"
FROM   (
         SELECT DISTINCT ea."DeathRecordId"
         FROM   DEATH.DEATH.ENTITYAXISCONDITIONS ea
         JOIN   DEATH.DEATH.ICD10CODE ic
                ON ea."Icd10Code" = ic."Code"
         WHERE  ic."Description" ILIKE '%vehicle%'
       ) veh
JOIN   DEATH.DEATH.DEATHRECORDS dr ON veh."DeathRecordId" = dr."Id"
JOIN   DEATH.DEATH.RACE           r ON dr."Race"           = r."Code"
WHERE  dr."AgeType" = 1
  AND  dr."Age" BETWEEN 12 AND 18
GROUP  BY dr."Age"
ORDER  BY dr."Age"
LIMIT 20;
```

```sql
-- 9) Aggregate counts (total & Black deaths) for FIREARM-related deaths by single year of age (12-18)
SELECT 
       dr."Age",
       COUNT(*)                                                AS "TotalDeaths_Firearm",
       SUM(CASE WHEN r."Description" ILIKE '%black%' THEN 1 END) AS "BlackDeaths_Firearm"
FROM   (
         SELECT DISTINCT ea."DeathRecordId"
         FROM   DEATH.DEATH.ENTITYAXISCONDITIONS ea
         JOIN   DEATH.DEATH.ICD10CODE ic
                ON ea."Icd10Code" = ic."Code"
         WHERE  ic."Description" ILIKE '%firearm%'
       ) fir
JOIN   DEATH.DEATH.DEATHRECORDS dr ON fir."DeathRecordId" = dr."Id"
JOIN   DEATH.DEATH.RACE           r ON dr."Race"           = r."Code"
WHERE  dr."AgeType" = 1
  AND  dr."Age" BETWEEN 12 AND 18
GROUP  BY dr."Age"
ORDER  BY dr."Age"
LIMIT 20;
```

```sql
-- 10) Single query that delivers, for each age 12-18, total & Black deaths for both categories
SELECT
       dr."Age",
       cat."Category",
       COUNT(*)                                                AS "TotalDeaths",
       SUM(CASE WHEN r."Description" ILIKE '%black%' THEN 1 END) AS "BlackDeaths"
FROM  (
        SELECT DISTINCT ea."DeathRecordId",
               'vehicle' AS "Category"
        FROM   DEATH.DEATH.ENTITYAXISCONDITIONS ea
        JOIN   DEATH.DEATH.ICD10CODE ic
               ON ea."Icd10Code" = ic."Code"
        WHERE  ic."Description" ILIKE '%vehicle%'
        UNION ALL
        SELECT DISTINCT ea."DeathRecordId",
               'firearm' AS "Category"
        FROM   DEATH.DEATH.ENTITYAXISCONDITIONS ea
        JOIN   DEATH.DEATH.ICD10CODE ic
               ON ea."Icd10Code" = ic."Code"
        WHERE  ic."Description" ILIKE '%firearm%'
      ) cat
JOIN  DEATH.DEATH.DEATHRECORDS dr ON cat."DeathRecordId" = dr."Id"
JOIN  DEATH.DEATH.RACE           r  ON dr."Race"         = r."Code"
WHERE dr."AgeType" = 1
  AND dr."Age" BETWEEN 12 AND 18
GROUP BY dr."Age", cat."Category"
ORDER BY dr."Age", cat."Category"
LIMIT 20;
```
