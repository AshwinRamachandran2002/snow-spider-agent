Query:
--Description: Total number of distinct 12-18-year-old deaths that involved at least one ICD-10 code whose description contains “vehicle”.
SELECT  COUNT(DISTINCT e."DeathRecordId") AS "vehicle_deaths_12_18"
FROM    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code" = e."Icd10Code"
JOIN    "DEATH"."DEATH"."DEATHRECORDS"         d   ON d."Id"   = e."DeathRecordId"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%vehicle%'
LIMIT 20;
Answer:
vehicle_deaths_12_18
1454
Query:
--Description: Total number of distinct 12-18-year-old deaths that involved at least one ICD-10 code whose description contains “firearm”.
SELECT  COUNT(DISTINCT e."DeathRecordId") AS "firearm_deaths_12_18"
FROM    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code" = e."Icd10Code"
JOIN    "DEATH"."DEATH"."DEATHRECORDS"         d   ON d."Id"   = e."DeathRecordId"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%firearm%'
LIMIT 20;
