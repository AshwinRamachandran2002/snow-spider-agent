firearm_deaths_12_18
1461
Query:
--Description: Vehicle-related deaths per single year of age (12-18), all races.
SELECT  d."Age",
        COUNT(DISTINCT d."Id") AS "vehicle_deaths"
FROM    "DEATH"."DEATH"."DEATHRECORDS"          d
JOIN    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e  ON e."DeathRecordId" = d."Id"
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code"        = e."Icd10Code"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%vehicle%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
Answer:
Age,vehicle_deaths
12,60
13,71
14,93
15,133
16,262
17,341
18,494
Query:
--Description: Vehicle-related deaths per single year of age (12-18) where the race description contains “black”.
SELECT  d."Age",
        COUNT(DISTINCT d."Id") AS "vehicle_deaths_black"
FROM    "DEATH"."DEATH"."DEATHRECORDS"          d
JOIN    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e  ON e."DeathRecordId" = d."Id"
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code"        = e."Icd10Code"
LEFT JOIN "DEATH"."DEATH"."RACE"               r   ON r."Code"          = d."Race"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%vehicle%'
  AND   r."Description" ILIKE '%black%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
Answer:
Age,vehicle_deaths_black
12,16
13,12
14,20
15,23
16,42
17,43
18,65
Query:
--Description: Combined view – for each age 12-18, show counts for all deaths vs. deaths among people whose race description contains “black,” separately for “vehicle” and “firearm” related ICD-10 codes.
SELECT  d."Age",
        SUM(CASE WHEN icd."Description" ILIKE '%vehicle%' THEN 1 END)                                            AS "vehicle_total",
        SUM(CASE WHEN icd."Description" ILIKE '%firearm%' THEN 1 END)                                            AS "firearm_total",
        SUM(CASE WHEN icd."Description" ILIKE '%vehicle%' AND r."Description" ILIKE '%black%'  THEN 1 END)       AS "vehicle_black",
        SUM(CASE WHEN icd."Description" ILIKE '%firearm%' AND r."Description" ILIKE '%black%'  THEN 1 END)       AS "firearm_black"
FROM    "DEATH"."DEATH"."DEATHRECORDS"          d
JOIN    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e   ON e."DeathRecordId" = d."Id"
JOIN    "DEATH"."DEATH"."ICD10CODE"             icd ON icd."Code"        = e."Icd10Code"
LEFT JOIN "DEATH"."DEATH"."RACE"                r   ON r."Code"          = d."Race"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
Answer:
Age,vehicle_total,firearm_total,vehicle_black,firearm_black
12,60,39,16,7
13,71,71,12,15
14,93,105,20,27
15,133,164,23,58
16,262,246,42,109
17,341,341,43,167
18,494,495,65,238
Task: Please provide, for each age from 12 through 18 (inclusive), the total number of deaths and the number of deaths among individuals identified as Black (based on race descriptions containing the word ‘black’), specifically for deaths associated with ICD-10 codes whose descriptions include the word ‘vehicle’ and for deaths associated with ICD-10 codes whose descriptions include the word ‘firearm.’ Use the EntityAxisConditions table to determine which ICD-10 codes were involved in each death, rather than joining ICD-10 code information directly on the death records.

