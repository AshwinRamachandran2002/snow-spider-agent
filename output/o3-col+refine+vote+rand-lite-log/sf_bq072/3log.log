```sql
--Description: Inspect a few death-record rows for ages 12-18, showing the various race code columns.
SELECT  "Id",
        "Age",
        "AgeType",
        "Race",
        "RaceRecode5",
        "RaceRecode3"
FROM    "DEATH"."DEATH"."DEATHRECORDS"
WHERE   "Age" BETWEEN 12 AND 18
  AND   "AgeType" = 1          -- 1 = Years (verify in AGETYPE table if necessary)
LIMIT 20;
```

```sql
--Description: Sample of ICD-10 codes recorded on entity-axis lines for deaths of 12-18-year-olds.
SELECT  e."DeathRecordId",
        e."Icd10Code"
FROM    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e
JOIN    "DEATH"."DEATH"."DEATHRECORDS"          d  ON d."Id" = e."DeathRecordId"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
LIMIT 20;
```

```sql
--Description: Total number of distinct 12-18-year-old deaths that involved at least one ICD-10 code whose description contains “vehicle”.
SELECT  COUNT(DISTINCT e."DeathRecordId") AS "vehicle_deaths_12_18"
FROM    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code" = e."Icd10Code"
JOIN    "DEATH"."DEATH"."DEATHRECORDS"         d   ON d."Id"   = e."DeathRecordId"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Total number of distinct 12-18-year-old deaths that involved at least one ICD-10 code whose description contains “firearm”.
SELECT  COUNT(DISTINCT e."DeathRecordId") AS "firearm_deaths_12_18"
FROM    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code" = e."Icd10Code"
JOIN    "DEATH"."DEATH"."DEATHRECORDS"         d   ON d."Id"   = e."DeathRecordId"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: Vehicle-related deaths per single year of age (12-18), all races.
SELECT  d."Age",
        COUNT(DISTINCT d."Id") AS "vehicle_deaths"
FROM    "DEATH"."DEATH"."DEATHRECORDS"          d
JOIN    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e  ON e."DeathRecordId" = d."Id"
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code"        = e."Icd10Code"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%vehicle%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
--Description: Vehicle-related deaths per single year of age (12-18) where the race description contains “black”.
SELECT  d."Age",
        COUNT(DISTINCT d."Id") AS "vehicle_deaths_black"
FROM    "DEATH"."DEATH"."DEATHRECORDS"          d
JOIN    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e  ON e."DeathRecordId" = d."Id"
JOIN    "DEATH"."DEATH"."ICD10CODE"            icd ON icd."Code"        = e."Icd10Code"
LEFT JOIN "DEATH"."DEATH"."RACE"               r   ON r."Code"          = d."Race"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
  AND   icd."Description" ILIKE '%vehicle%'
  AND   r."Description" ILIKE '%black%'
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```

```sql
--Description: Combined view – for each age 12-18, show counts for all deaths vs. deaths among people whose race description contains “black,” separately for “vehicle” and “firearm” related ICD-10 codes.
SELECT  d."Age",
        SUM(CASE WHEN icd."Description" ILIKE '%vehicle%' THEN 1 END)                                            AS "vehicle_total",
        SUM(CASE WHEN icd."Description" ILIKE '%firearm%' THEN 1 END)                                            AS "firearm_total",
        SUM(CASE WHEN icd."Description" ILIKE '%vehicle%' AND r."Description" ILIKE '%black%'  THEN 1 END)       AS "vehicle_black",
        SUM(CASE WHEN icd."Description" ILIKE '%firearm%' AND r."Description" ILIKE '%black%'  THEN 1 END)       AS "firearm_black"
FROM    "DEATH"."DEATH"."DEATHRECORDS"          d
JOIN    "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e   ON e."DeathRecordId" = d."Id"
JOIN    "DEATH"."DEATH"."ICD10CODE"             icd ON icd."Code"        = e."Icd10Code"
LEFT JOIN "DEATH"."DEATH"."RACE"                r   ON r."Code"          = d."Race"
WHERE   d."Age" BETWEEN 12 AND 18
  AND   d."AgeType" = 1
GROUP BY d."Age"
ORDER BY d."Age"
LIMIT 20;
```
