```sql
--Description: Sample entity-axis condition rows whose ICD-10 description contains “vehicle”
SELECT eac."DeathRecordId",
       eac."Icd10Code",
       icd."Description"
FROM DEATH.DEATH.ENTITYAXISCONDITIONS  eac
JOIN DEATH.DEATH.ICD10CODE             icd
     ON eac."Icd10Code" = icd."Code"
WHERE icd."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Sample entity-axis condition rows whose ICD-10 description contains “firearm”
SELECT eac."DeathRecordId",
       eac."Icd10Code",
       icd."Description"
FROM DEATH.DEATH.ENTITYAXISCONDITIONS  eac
JOIN DEATH.DEATH.ICD10CODE             icd
     ON eac."Icd10Code" = icd."Code"
WHERE icd."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: View a sample of deaths (ages 12-18) that involved “vehicle” ICD-10 codes
SELECT dr."Id",
       dr."Age",
       dr."Race",
       r."Description"  AS "RaceDescription",
       eac."Icd10Code",
       icd."Description" AS "IcdDescription"
FROM DEATH.DEATH.DEATHRECORDS         dr
JOIN DEATH.DEATH.ENTITYAXISCONDITIONS eac
     ON dr."Id" = eac."DeathRecordId"
JOIN DEATH.DEATH.ICD10CODE            icd
     ON eac."Icd10Code" = icd."Code"
LEFT JOIN DEATH.DEATH.RACE            r
     ON dr."Race" = r."Code"
WHERE dr."Age" BETWEEN 12 AND 18
  AND icd."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: View a sample of deaths (ages 12-18) that involved “firearm” ICD-10 codes
SELECT dr."Id",
       dr."Age",
       dr."Race",
       r."Description"  AS "RaceDescription",
       eac."Icd10Code",
       icd."Description" AS "IcdDescription"
FROM DEATH.DEATH.DEATHRECORDS         dr
JOIN DEATH.DEATH.ENTITYAXISCONDITIONS eac
     ON dr."Id" = eac."DeathRecordId"
JOIN DEATH.DEATH.ICD10CODE            icd
     ON eac."Icd10Code" = icd."Code"
LEFT JOIN DEATH.DEATH.RACE            r
     ON dr."Race" = r."Code"
WHERE dr."Age" BETWEEN 12 AND 18
  AND icd."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: Count total deaths and Black deaths by single year of age (12-18) for “vehicle” ICD-10 codes
SELECT dr."Age",
       COUNT(*)                                                      AS "TotalDeaths",
       SUM(CASE WHEN r."Description" ILIKE '%black%' THEN 1 ELSE 0 END) AS "BlackDeaths"
FROM DEATH.DEATH.DEATHRECORDS         dr
JOIN DEATH.DEATH.ENTITYAXISCONDITIONS eac
     ON dr."Id" = eac."DeathRecordId"
JOIN DEATH.DEATH.ICD10CODE            icd
     ON eac."Icd10Code" = icd."Code"
LEFT JOIN DEATH.DEATH.RACE            r
     ON dr."Race" = r."Code"
WHERE dr."Age" BETWEEN 12 AND 18
  AND icd."Description" ILIKE '%vehicle%'
GROUP BY dr."Age"
ORDER BY dr."Age"
LIMIT 20;
```

```sql
--Description: Count total deaths and Black deaths by single year of age (12-18) for “firearm” ICD-10 codes
SELECT dr."Age",
       COUNT(*)                                                      AS "TotalDeaths",
       SUM(CASE WHEN r."Description" ILIKE '%black%' THEN 1 ELSE 0 END) AS "BlackDeaths"
FROM DEATH.DEATH.DEATHRECORDS         dr
JOIN DEATH.DEATH.ENTITYAXISCONDITIONS eac
     ON dr."Id" = eac."DeathRecordId"
JOIN DEATH.DEATH.ICD10CODE            icd
     ON eac."Icd10Code" = icd."Code"
LEFT JOIN DEATH.DEATH.RACE            r
     ON dr."Race" = r."Code"
WHERE dr."Age" BETWEEN 12 AND 18
  AND icd."Description" ILIKE '%firearm%'
GROUP BY dr."Age"
ORDER BY dr."Age"
LIMIT 20;
```
