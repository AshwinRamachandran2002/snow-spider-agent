Query:
--Description: Count total deaths and Black deaths by single year of age (12-18) for “vehicle” ICD-10 codes
SELECT dr."Age",
       COUNT(*)                                                      AS "TotalDeaths",
       SUM(CASE WHEN r."Description" ILIKE '%black%' THEN 1 ELSE 0 END) AS "BlackDeaths"
FROM DEATH.DEATH.DEATHRECORDS         dr
JOIN DEATH.DEATH.ENTITYAXISCONDITIONS eac
     ON dr."Id" = eac."DeathRecordId"
JOIN DEATH.DEATH.ICD10CODE            icd
     ON eac."Icd10Code" = icd."Code"
LEFT JOIN DEATH.DEATH.RACE            r
     ON dr."Race" = r."Code"
WHERE dr."Age" BETWEEN 12 AND 18
  AND icd."Description" ILIKE '%vehicle%'
GROUP BY dr."Age"
ORDER BY dr."Age"
LIMIT 20;
