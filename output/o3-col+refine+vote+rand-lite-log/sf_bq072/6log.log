```sql
--Description: Preview death-record IDs for people aged 12-18 years (AgeType assumed ‘years’ = 1).
SELECT 
       "Id",
       "Age",
       "AgeType",
       "RaceRecode5"
FROM   DEATH.DEATH.DEATHRECORDS
WHERE  "AgeType" = 1
  AND  "Age" BETWEEN 12 AND 18
LIMIT 20;
```

```sql
--Description: Sample deaths (age 12-18) that involve an ICD-10 code with ‘vehicle’ in its description.
SELECT DISTINCT
       dr."Id",
       dr."Age",
       dr."RaceRecode5",
       eac."Icd10Code"
FROM   DEATH.DEATH.DEATHRECORDS        dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE            ic  ON eac."Icd10Code" = ic."Code"
WHERE  dr."AgeType" = 1
  AND  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Sample deaths (age 12-18) that involve an ICD-10 code with ‘firearm’ in its description.
SELECT DISTINCT
       dr."Id",
       dr."Age",
       dr."RaceRecode5",
       eac."Icd10Code"
FROM   DEATH.DEATH.DEATHRECORDS        dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE            ic  ON eac."Icd10Code" = ic."Code"
WHERE  dr."AgeType" = 1
  AND  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: Aggregate (per age) total deaths and Black deaths for ICD-10 descriptions containing ‘vehicle’.
SELECT 
       dr."Age",
       COUNT(*)                                                     AS "total_deaths",
       SUM(CASE WHEN rr."Description" ILIKE '%black%' THEN 1 ELSE 0 END) AS "black_deaths"
FROM   DEATH.DEATH.DEATHRECORDS        dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE            ic  ON eac."Icd10Code" = ic."Code"
LEFT  JOIN DEATH.DEATH.RACERECODE5      rr  ON dr."RaceRecode5" = rr."Code"
WHERE  dr."AgeType" = 1
  AND  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%vehicle%'
GROUP BY dr."Age"
ORDER BY dr."Age"
LIMIT 20;
```

```sql
--Description: Aggregate (per age) total deaths and Black deaths for ICD-10 descriptions containing ‘firearm’.
SELECT 
       dr."Age",
       COUNT(*)                                                     AS "total_deaths",
       SUM(CASE WHEN rr."Description" ILIKE '%black%' THEN 1 ELSE 0 END) AS "black_deaths"
FROM   DEATH.DEATH.DEATHRECORDS        dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac ON dr."Id" = eac."DeathRecordId"
JOIN   DEATH.DEATH.ICD10CODE            ic  ON eac."Icd10Code" = ic."Code"
LEFT  JOIN DEATH.DEATH.RACERECODE5      rr  ON dr."RaceRecode5" = rr."Code"
WHERE  dr."AgeType" = 1
  AND  dr."Age" BETWEEN 12 AND 18
  AND  ic."Description" ILIKE '%firearm%'
GROUP BY dr."Age"
ORDER BY dr."Age"
LIMIT 20;
```
