```

```sql
--Description: 2) Peek at ICD-10 codes whose descriptions mention “firearm”.
SELECT DISTINCT "Code", "Description"
FROM "DEATH"."DEATH"."ICD10CODE"
WHERE "Description" ILIKE '%firearm%'
LIMIT 20;
```

```sql
--Description: 3) Grab a few death-records that have at least one “vehicle” ICD-10 code on the Entity-Axis list.
SELECT DISTINCT e."DeathRecordId"
FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS"  e
JOIN "DEATH"."DEATH"."ICD10CODE"             i  ON e."Icd10Code" = i."Code"
WHERE i."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: 4) Inspect ages and race-recode5 values for those “vehicle” deaths (ages shown just to be sure 12-18 exist).
SELECT d."Id"           AS "DeathRecordId",
       d."Age",
       d."RaceRecode5"
FROM   "DEATH"."DEATH"."DEATHRECORDS"        d
JOIN  (SELECT DISTINCT e."DeathRecordId"
       FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
       JOIN "DEATH"."DEATH"."ICD10CODE"      i ON e."Icd10Code" = i."Code"
       WHERE i."Description" ILIKE '%vehicle%') v
       ON d."Id" = v."DeathRecordId"
WHERE  d."Age" BETWEEN 12 AND 18
LIMIT 20;
```

```sql
--Description: 5) List race-recode5 descriptions so we know which spell “Black”.
SELECT DISTINCT r5."Code", r5."Description"
FROM "DEATH"."DEATH"."RACERECODE5" r5
LIMIT 20;
```

```sql
--Description: 6) Total and Black-only death counts for “vehicle” ICD-10 codes by single year of age (12-18).
SELECT d."Age",
       COUNT(*)                                    AS "Vehicle_Total_Deaths",
       COUNT(CASE WHEN r5."Description" ILIKE '%black%' THEN 1 END)
                                                  AS "Vehicle_Black_Deaths"
FROM   "DEATH"."DEATH"."DEATHRECORDS"        d
JOIN   "DEATH"."DEATH"."RACERECODE5"         r5 ON d."RaceRecode5" = r5."Code"
JOIN  (SELECT DISTINCT e."DeathRecordId"
       FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
       JOIN "DEATH"."DEATH"."ICD10CODE"      i ON e."Icd10Code" = i."Code"
       WHERE i."Description" ILIKE '%vehicle%') v
       ON d."Id" = v."DeathRecordId"
WHERE  d."Age" BETWEEN 12 AND 18
GROUP  BY d."Age"
ORDER  BY d."Age"
LIMIT 20;
```

```sql
--Description: 7) Repeat the same aggregation for “firearm” ICD-10 codes.
SELECT d."Age",
       COUNT(*)                                    AS "Firearm_Total_Deaths",
       COUNT(CASE WHEN r5."Description" ILIKE '%black%' THEN 1 END)
                                                  AS "Firearm_Black_Deaths"
FROM   "DEATH"."DEATH"."DEATHRECORDS"        d
JOIN   "DEATH"."DEATH"."RACERECODE5"         r5 ON d."RaceRecode5" = r5."Code"
JOIN  (SELECT DISTINCT e."DeathRecordId"
       FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
       JOIN "DEATH"."DEATH"."ICD10CODE"      i ON e."Icd10Code" = i."Code"
       WHERE i."Description" ILIKE '%firearm%') f
       ON d."Id" = f."DeathRecordId"
WHERE  d."Age" BETWEEN 12 AND 18
GROUP  BY d."Age"
ORDER  BY d."Age"
LIMIT 20;
```

```sql
--Description: 8) Combine “vehicle” and “firearm” results into one table for quick comparison.
WITH vehicle AS (
    SELECT d."Age",
           COUNT(*) AS "Vehicle_Total",
           COUNT(CASE WHEN r5."Description" ILIKE '%black%' THEN 1 END) AS "Vehicle_Black"
    FROM   "DEATH"."DEATH"."DEATHRECORDS" d
    JOIN   "DEATH"."DEATH"."RACERECODE5"  r5 ON d."RaceRecode5" = r5."Code"
    JOIN  (SELECT DISTINCT e."DeathRecordId"
           FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
           JOIN "DEATH"."DEATH"."ICD10CODE" i ON e."Icd10Code" = i."Code"
           WHERE i."Description" ILIKE '%vehicle%') v
           ON d."Id" = v."DeathRecordId"
    WHERE  d."Age" BETWEEN 12 AND 18
    GROUP  BY d."Age"
),
firearm AS (
    SELECT d."Age",
           COUNT(*) AS "Firearm_Total",
           COUNT(CASE WHEN r5."Description" ILIKE '%black%' THEN 1 END) AS "Firearm_Black"
    FROM   "DEATH"."DEATH"."DEATHRECORDS" d
    JOIN   "DEATH"."DEATH"."RACERECODE5"  r5 ON d."RaceRecode5" = r5."Code"
    JOIN  (SELECT DISTINCT e."DeathRecordId"
           FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
           JOIN "DEATH"."DEATH"."ICD10CODE" i ON e."Icd10Code" = i."Code"
           WHERE i."Description" ILIKE '%firearm%') f
           ON d."Id" = f."DeathRecordId"
    WHERE  d."Age" BETWEEN 12 AND 18
    GROUP  BY d."Age"
)
SELECT COALESCE(v."Age", f."Age")                AS "Age",
       v."Vehicle_Total",  v."Vehicle_Black",
       f."Firearm_Total",  f."Firearm_Black"
FROM   vehicle v
FULL   OUTER JOIN firearm f
       ON v."Age" = f."Age"
ORDER  BY "Age"
LIMIT 20;
```

```sql
--Description: 9) (Optional) Verify that “RaceRecode5” really captures all “Black” deaths by listing any race records used in ages 12-18 whose description does NOT contain “black”.
SELECT DISTINCT r5."Code", r5."Description"
FROM   "DEATH"."DEATH"."DEATHRECORDS" d
JOIN   "DEATH"."DEATH"."RACERECODE5"  r5 ON d."RaceRecode5" = r5."Code"
WHERE  d."Age" BETWEEN 12 AND 18
  AND  r5."Description" NOT ILIKE '%black%'
LIMIT 20;
```

```sql
--Description: 10) (Final summary query) Generate the requested counts for every age 12-18 inclusive in a tidy result set.
SELECT a."Age",
       SUM(CASE WHEN a."CauseGroup" = 'Vehicle' THEN 1 ELSE 0 END)                     AS "Vehicle_Total_Deaths",
       SUM(CASE WHEN a."CauseGroup" = 'Vehicle' AND a."IsBlack" = 1 THEN 1 ELSE 0 END) AS "Vehicle_Black_Deaths",
       SUM(CASE WHEN a."CauseGroup" = 'Firearm' THEN 1 ELSE 0 END)                     AS "Firearm_Total_Deaths",
       SUM(CASE WHEN a."CauseGroup" = 'Firearm' AND a."IsBlack" = 1 THEN 1 ELSE 0 END) AS "Firearm_Black_Deaths"
FROM (
    SELECT d."Age",
           CASE WHEN v."DeathRecordId" IS NOT NULL THEN 'Vehicle' ELSE 'Firearm' END AS "CauseGroup",
           CASE WHEN r5."Description" ILIKE '%black%' THEN 1 ELSE 0 END              AS "IsBlack"
    FROM   "DEATH"."DEATH"."DEATHRECORDS" d
    JOIN   "DEATH"."DEATH"."RACERECODE5"  r5 ON d."RaceRecode5" = r5."Code"
    LEFT  JOIN ( -- vehicle deaths
                SELECT DISTINCT e."DeathRecordId"
                FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
                JOIN "DEATH"."DEATH"."ICD10CODE" i ON e."Icd10Code" = i."Code"
                WHERE i."Description" ILIKE '%vehicle%') v
           ON d."Id" = v."DeathRecordId"
    LEFT  JOIN ( -- firearm deaths
                SELECT DISTINCT e."DeathRecordId"
                FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
                JOIN "DEATH"."DEATH"."ICD10CODE" i ON e."Icd10Code" = i."Code"
                WHERE i."Description" ILIKE '%firearm%') f
           ON d."Id" = f."DeathRecordId"
    WHERE d."Age" BETWEEN 12 AND 18
      AND (v."DeathRecordId" IS NOT NULL OR f."DeathRecordId" IS NOT NULL)
) a
GROUP BY a."Age"
ORDER BY a."Age";
```
