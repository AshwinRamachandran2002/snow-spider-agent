--Description: 10) (Final summary query) Generate the requested counts for every age 12-18 inclusive in a tidy result set.
SELECT a."Age",
       SUM(CASE WHEN a."CauseGroup" = 'Vehicle' THEN 1 ELSE 0 END)                     AS "Vehicle_Total_Deaths",
       SUM(CASE WHEN a."CauseGroup" = 'Vehicle' AND a."IsBlack" = 1 THEN 1 ELSE 0 END) AS "Vehicle_Black_Deaths",
       SUM(CASE WHEN a."CauseGroup" = 'Firearm' THEN 1 ELSE 0 END)                     AS "Firearm_Total_Deaths",
       SUM(CASE WHEN a."CauseGroup" = 'Firearm' AND a."IsBlack" = 1 THEN 1 ELSE 0 END) AS "Firearm_Black_Deaths"
FROM (
    SELECT d."Age",
           CASE WHEN v."DeathRecordId" IS NOT NULL THEN 'Vehicle' ELSE 'Firearm' END AS "CauseGroup",
           CASE WHEN r5."Description" ILIKE '%black%' THEN 1 ELSE 0 END              AS "IsBlack"
    FROM   "DEATH"."DEATH"."DEATHRECORDS" d
    JOIN   "DEATH"."DEATH"."RACERECODE5"  r5 ON d."RaceRecode5" = r5."Code"
    LEFT  JOIN ( -- vehicle deaths
                SELECT DISTINCT e."DeathRecordId"
                FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
                JOIN "DEATH"."DEATH"."ICD10CODE" i ON e."Icd10Code" = i."Code"
                WHERE i."Description" ILIKE '%vehicle%') v
           ON d."Id" = v."DeathRecordId"
    LEFT  JOIN ( -- firearm deaths
                SELECT DISTINCT e."DeathRecordId"
                FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
                JOIN "DEATH"."DEATH"."ICD10CODE" i ON e."Icd10Code" = i."Code"
                WHERE i."Description" ILIKE '%firearm%') f
           ON d."Id" = f."DeathRecordId"
    WHERE d."Age" BETWEEN 12 AND 18
      AND (v."DeathRecordId" IS NOT NULL OR f."DeathRecordId" IS NOT NULL)
) a
GROUP BY a."Age"
ORDER BY a."Age";
