Query:
--Description: 4) Inspect ages and race-recode5 values for those “vehicle” deaths (ages shown just to be sure 12-18 exist).
SELECT d."Id"           AS "DeathRecordId",
       d."Age",
       d."RaceRecode5"
FROM   "DEATH"."DEATH"."DEATHRECORDS"        d
JOIN  (SELECT DISTINCT e."DeathRecordId"
       FROM "DEATH"."DEATH"."ENTITYAXISCONDITIONS" e
       JOIN "DEATH"."DEATH"."ICD10CODE"      i ON e."Icd10Code" = i."Code"
       WHERE i."Description" ILIKE '%vehicle%') v
       ON d."Id" = v."DeathRecordId"
WHERE  d."Age" BETWEEN 12 AND 18
LIMIT 20;
