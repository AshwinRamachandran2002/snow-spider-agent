Query:
--Description: For ages 12-18, count total deaths and deaths of Black individuals for ICD-10 descriptions containing “vehicle”.
WITH vehicle_deaths AS (
    SELECT DISTINCT dr."Id",
           dr."Age",
           dr."RaceRecode5"
    FROM   DEATH.DEATH.DEATHRECORDS      dr
    JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac
           ON eac."DeathRecordId" = dr."Id"
    JOIN   DEATH.DEATH.ICD10CODE         icd
           ON icd."Code" = eac."Icd10Code"
    WHERE  icd."Description" ILIKE '%vehicle%'
      AND  dr."Age" BETWEEN 12 AND 18
)
SELECT vd."Age",
       COUNT(*)                                                  AS "total_deaths_vehicle",
       COUNT_IF(rr5."Description" ILIKE '%black%')               AS "black_deaths_vehicle"
FROM   vehicle_deaths             vd
LEFT   JOIN DEATH.DEATH.RACERECODE5 rr5
       ON rr5."Code" = vd."RaceRecode5"
GROUP  BY vd."Age"
ORDER  BY vd."Age"
LIMIT 20;
Answer:
Age,total_deaths_vehicle,black_deaths_vehicle
12,60,16
13,72,12
14,93,20
15,133,23
16,262,42
17,341,43
18,494,65
Query:
--Description: For ages 12-18, count total deaths and deaths of Black individuals for ICD-10 descriptions containing “firearm”.
WITH firearm_deaths AS (
    SELECT DISTINCT dr."Id",
           dr."Age",
           dr."RaceRecode5"
    FROM   DEATH.DEATH.DEATHRECORDS      dr
    JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac
           ON eac."DeathRecordId" = dr."Id"
    JOIN   DEATH.DEATH.ICD10CODE         icd
           ON icd."Code" = eac."Icd10Code"
    WHERE  icd."Description" ILIKE '%firearm%'
      AND  dr."Age" BETWEEN 12 AND 18
)
SELECT fd."Age",
       COUNT(*)                                                  AS "total_deaths_firearm",
       COUNT_IF(rr5."Description" ILIKE '%black%')               AS "black_deaths_firearm"
FROM   firearm_deaths            fd
LEFT   JOIN DEATH.DEATH.RACERECODE5 rr5
       ON rr5."Code" = fd."RaceRecode5"
GROUP  BY fd."Age"
ORDER  BY fd."Age"
LIMIT 20;
