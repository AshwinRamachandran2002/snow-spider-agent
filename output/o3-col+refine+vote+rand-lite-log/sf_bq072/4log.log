       "Sequence"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS
LIMIT 20;
```

```sql
--Description: Join ENTITYAXISCONDITIONS to ICD10CODE to view sample “vehicle”-related conditions with their death record IDs.
SELECT eac."DeathRecordId",
       eac."Icd10Code",
       icd."Description"
FROM   DEATH.DEATH.ENTITYAXISCONDITIONS eac
JOIN   DEATH.DEATH.ICD10CODE        icd
       ON icd."Code" = eac."Icd10Code"
WHERE  icd."Description" ILIKE '%vehicle%'
LIMIT 20;
```

```sql
--Description: Add DEATHRECORDS to see ages and race-recodes for a few “vehicle” deaths.
SELECT dr."Id"                       AS "DeathRecordId",
       dr."Age",
       dr."RaceRecode5",
       icd."Description"             AS "Icd10_Description"
FROM   DEATH.DEATH.DEATHRECORDS      dr
JOIN   DEATH.DEATH.ENTITYAXISCONDITIONS eac
       ON eac."DeathRecordId" = dr."Id"
JOIN   DEATH.DEATH.ICD10CODE         icd
       ON icd."Code" = eac."Icd10Code"
WHERE  icd."Description" ILIKE '%vehicle%'
  AND  dr."Age" BETWEEN 12 AND 18
LIMIT 20;
```

```sql
--Description: Check distinct race descriptions that contain the word “black” in the RACE table.
SELECT DISTINCT "Code",
       "Description"
FROM   DEATH.DEATH.RACE
WHERE  "Description" ILIKE '%black%'
LIMIT 20;
```

