```sql
--Description: List all distinct insert dates for Chinese cities during July-2021
SELECT DISTINCT insert_date
FROM cities
WHERE lower(country_code_2) = 'cn'
  AND insert_date LIKE '2021-07-%'
ORDER BY insert_date
LIMIT 20;
```

```sql
--Description: Build a helper set that tags each July-2021 date with a group-id for its consecutive-day streak
WITH china_july AS (
  SELECT DISTINCT date(insert_date) AS dt
  FROM cities
  WHERE lower(country_code_2) = 'cn'
    AND insert_date LIKE '2021-07-%'
),
ordered AS (
  SELECT dt,
         ROW_NUMBER() OVER (ORDER BY dt) AS rn,
         julianday(dt)                 AS jd
  FROM china_july
)
SELECT dt,
       jd - rn AS grp                   -- same value ⇒ consecutive streak
FROM ordered
ORDER BY dt
LIMIT 20;
```

```sql
--Description: For every streak, show its start, end and length (in days)
WITH china_july AS (
  SELECT DISTINCT date(insert_date) AS dt
  FROM cities
  WHERE lower(country_code_2) = 'cn'
    AND insert_date LIKE '2021-07-%'
),
ordered AS (
  SELECT dt,
         ROW_NUMBER() OVER (ORDER BY dt) AS rn,
         julianday(dt)                 AS jd
  FROM china_july
),
grouped AS (
  SELECT dt,
         jd - rn AS grp
  FROM ordered
)
SELECT grp,
       MIN(dt) AS start_date,
       MAX(dt) AS end_date,
       COUNT(*) AS streak_len
FROM grouped
GROUP BY grp
ORDER BY streak_len
LIMIT 20;
```

```sql
--Description: Return the dates & one capital-cased city for BOTH the shortest and longest July-2021 streaks
WITH china_july AS (
  SELECT city_id,
         city_name,
         date(insert_date) AS dt
  FROM cities
  WHERE lower(country_code_2) = 'cn'
    AND insert_date LIKE '2021-07-%'
),
ordered AS (
  SELECT dt,
         ROW_NUMBER() OVER (ORDER BY dt) AS rn,
         julianday(dt)                 AS jd
  FROM (SELECT DISTINCT dt FROM china_july)
),
grouped AS (
  SELECT dt,
         jd - rn AS grp
  FROM ordered
),
streaks AS (
  SELECT grp, COUNT(*) AS streak_len
  FROM grouped
  GROUP BY grp
),
bounds AS (
  SELECT MIN(streak_len) AS min_len,
         MAX(streak_len) AS max_len
  FROM streaks
),
target_grps AS (
  SELECT grp
  FROM streaks, bounds
  WHERE streak_len = min_len
     OR streak_len = max_len
)
SELECT g.dt                                                         AS date,
       MIN(UPPER(SUBSTR(c.city_name,1,1)) || LOWER(SUBSTR(c.city_name,2))) AS city_name
FROM grouped     AS g
JOIN target_grps AS t ON g.grp = t.grp
JOIN china_july  AS c ON c.dt  = g.dt
GROUP BY g.dt
ORDER BY g.dt;
```
