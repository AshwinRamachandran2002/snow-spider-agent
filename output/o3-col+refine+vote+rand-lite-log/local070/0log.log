Query:
--Description: For every streak, show its start, end and length (in days)
WITH china_july AS (
  SELECT DISTINCT date(insert_date) AS dt
  FROM cities
  WHERE lower(country_code_2) = 'cn'
    AND insert_date LIKE '2021-07-%'
),
ordered AS (
  SELECT dt,
         ROW_NUMBER() OVER (ORDER BY dt) AS rn,
         julianday(dt)                 AS jd
  FROM china_july
),
grouped AS (
  SELECT dt,
         jd - rn AS grp
  FROM ordered
)
SELECT grp,
       MIN(dt) AS start_date,
       MAX(dt) AS end_date,
       COUNT(*) AS streak_len
FROM grouped
GROUP BY grp
ORDER BY streak_len
LIMIT 20;
