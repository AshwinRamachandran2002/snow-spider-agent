Query:
-- 8) Pull exactly one city per date for every date in both shortest & longest streaks  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), x AS (
    SELECT "insert_date",
           (JULIANDAY("insert_date") -
            ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
    FROM   d
), y AS (
    SELECT streak_id,
           COUNT(*) AS streak_len
    FROM   x
    GROUP  BY streak_id
), wanted_streaks AS (
    SELECT streak_id
    FROM   y
    WHERE  streak_len = (SELECT MIN(streak_len) FROM y)
       OR  streak_len = (SELECT MAX(streak_len) FROM y)
), dates_we_need AS (
    SELECT x."insert_date"
    FROM   x
    JOIN   wanted_streaks w USING (streak_id)
)
SELECT dwn."insert_date",
       UPPER(SUBSTR(c."city_name",1,1)) || LOWER(SUBSTR(c."city_name",2)) AS "city_name"
FROM   dates_we_need dwn
JOIN   "cities" c
  ON   c."insert_date"  = dwn."insert_date"
 AND   c."country_code_2" = 'cn'
GROUP  BY dwn."insert_date"          -- one city per date (any)
ORDER  BY dwn."insert_date"
LIMIT 20;
