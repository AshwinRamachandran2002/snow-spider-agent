```sql
-- 4) Number July-2021 dates consecutively so we can spot gaps  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
)
SELECT "insert_date",
       ROW_NUMBER()            OVER (ORDER BY "insert_date")          AS rn,
       JULIANDAY("insert_date")                                      AS jd
FROM   d
ORDER  BY "insert_date"
LIMIT 20;
```

```sql
-- 5) Build streak-id by subtracting row# from the Julian day number  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), x AS (
    SELECT "insert_date",
           JULIANDAY("insert_date")                    AS jd,
           ROW_NUMBER() OVER (ORDER BY "insert_date")  AS rn
    FROM   d
)
SELECT "insert_date",
       (jd - rn) AS streak_id          -- same value = same streak
FROM   x
ORDER  BY "insert_date"
LIMIT 20;
```

```sql
-- 6) Compute the length (days) of every consecutive-date streak  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), x AS (
    SELECT "insert_date",
           (JULIANDAY("insert_date") -
            ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
    FROM   d
), y AS (
    SELECT streak_id,
           COUNT(*) AS streak_len,
           MIN("insert_date") AS start_dt,
           MAX("insert_date") AS end_dt
    FROM   x
    GROUP  BY streak_id
)
SELECT *
FROM   y
ORDER  BY streak_len, start_dt
LIMIT 20;
```

```sql
-- 7) Identify the shortest & longest streak-ids  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), x AS (
    SELECT "insert_date",
           (JULIANDAY("insert_date") -
            ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
    FROM   d
), y AS (
    SELECT streak_id,
           COUNT(*) AS streak_len
    FROM   x
    GROUP  BY streak_id
), z AS (
    SELECT streak_id
    FROM   y
    WHERE  streak_len = (SELECT MIN(streak_len) FROM y)
       OR  streak_len = (SELECT MAX(streak_len) FROM y)
)
SELECT *
FROM   z
LIMIT 20;
```

```sql
-- 8) Pull exactly one city per date for every date in both shortest & longest streaks  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), x AS (
    SELECT "insert_date",
           (JULIANDAY("insert_date") -
            ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
    FROM   d
), y AS (
    SELECT streak_id,
           COUNT(*) AS streak_len
    FROM   x
    GROUP  BY streak_id
), wanted_streaks AS (
    SELECT streak_id
    FROM   y
    WHERE  streak_len = (SELECT MIN(streak_len) FROM y)
       OR  streak_len = (SELECT MAX(streak_len) FROM y)
), dates_we_need AS (
    SELECT x."insert_date"
    FROM   x
    JOIN   wanted_streaks w USING (streak_id)
)
SELECT dwn."insert_date",
       UPPER(SUBSTR(c."city_name",1,1)) || LOWER(SUBSTR(c."city_name",2)) AS "city_name"
FROM   dates_we_need dwn
JOIN   "cities" c
  ON   c."insert_date"  = dwn."insert_date"
 AND   c."country_code_2" = 'cn'
GROUP  BY dwn."insert_date"          -- one city per date (any)
ORDER  BY dwn."insert_date"
LIMIT 20;
```

```sql
-- 9) (Optional) Verify all dates returned truly belong to either the shortest or longest streak and are unique  
WITH answer AS (
    /* paste query #8 here without LIMIT to build full answer set */
    SELECT dwn."insert_date",
           UPPER(SUBSTR(c."city_name",1,1)) || LOWER(SUBSTR(c."city_name",2)) AS "city_name"
    FROM   (
        SELECT x."insert_date"
        FROM   (
            SELECT "insert_date",
                   (JULIANDAY("insert_date") -
                    ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
            FROM   (
                SELECT DISTINCT "insert_date"
                FROM   "cities"
                WHERE  "country_code_2" = 'cn'
                  AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
            )
        ) x
        JOIN (
            SELECT streak_id
            FROM   (
                SELECT streak_id, COUNT(*) AS streak_len
                FROM   (
                    SELECT "insert_date",
                           (JULIANDAY("insert_date") -
                            ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
                    FROM   (
                        SELECT DISTINCT "insert_date"
                        FROM   "cities"
                        WHERE  "country_code_2" = 'cn'
                          AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
                    )
                )
                GROUP  BY streak_id
            )
            WHERE  streak_len = (
                       SELECT MIN(streak_len) FROM (
                           SELECT COUNT(*) AS streak_len
                           FROM   (
                               SELECT "insert_date",
                                      (JULIANDAY("insert_date") -
                                       ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
                               FROM   (
                                   SELECT DISTINCT "insert_date"
                                   FROM   "cities"
                                   WHERE  "country_code_2" = 'cn'
                                     AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
                               )
                           )
                           GROUP  BY streak_id
                       )
                   )
               OR streak_len = (
                       SELECT MAX(streak_len) FROM (
                           SELECT COUNT(*) AS streak_len
                           FROM   (
                               SELECT "insert_date",
                                      (JULIANDAY("insert_date") -
                                       ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
                               FROM   (
                                   SELECT DISTINCT "insert_date"
                                   FROM   "cities"
                                   WHERE  "country_code_2" = 'cn'
                                     AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
                               )
                           )
                           GROUP  BY streak_id
                       )
                   )
        ) w USING (streak_id)
    ) dwn
    JOIN   "cities" c
      ON   c."insert_date"  = dwn."insert_date"
     AND   c."country_code_2" = 'cn'
    GROUP  BY dwn."insert_date"
)
SELECT *
FROM   answer
LIMIT 20;
```

```sql
-- 10) Final succinct query (no CTE nesting) that can be copied to get the full ordered answer set  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), seq AS (
    SELECT "insert_date",
           (JULIANDAY("insert_date") -
            ROW_NUMBER() OVER (ORDER BY "insert_date")) AS streak_id
    FROM   d
), streaks AS (
    SELECT streak_id,
           COUNT(*) AS streak_len
    FROM   seq
    GROUP  BY streak_id
), target AS (
    SELECT streak_id
    FROM   streaks
    WHERE  streak_len = (SELECT MIN(streak_len) FROM streaks)
       OR  streak_len = (SELECT MAX(streak_len) FROM streaks)
)
SELECT s."insert_date",
       UPPER(SUBSTR(c."city_name",1,1)) || LOWER(SUBSTR(c."city_name",2)) AS "city_name"
FROM   seq  s
JOIN   target t USING (streak_id)
JOIN   "cities" c
  ON   c."insert_date"   = s."insert_date"
 AND   c."country_code_2" = 'cn'
GROUP  BY s."insert_date"
ORDER  BY s."insert_date"
LIMIT 20;
```
