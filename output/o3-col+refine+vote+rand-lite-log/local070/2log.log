-- 5) Build streak-id by subtracting row# from the Julian day number  
WITH d AS (
    SELECT DISTINCT "insert_date"
    FROM   "cities"
    WHERE  "country_code_2" = 'cn'
      AND  "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
), x AS (
    SELECT "insert_date",
           JULIANDAY("insert_date")                    AS jd,
           ROW_NUMBER() OVER (ORDER BY "insert_date")  AS rn
    FROM   d
)
SELECT "insert_date",
       (jd - rn) AS streak_id          -- same value = same streak
FROM   x
ORDER  BY "insert_date"
LIMIT 20;
