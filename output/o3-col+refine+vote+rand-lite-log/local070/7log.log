  AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
GROUP BY "insert_date"
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 5. Number the July-2021 Chinese rows so we can detect consecutive-date streaks
SELECT "city_id",
       "city_name",
       "insert_date",
       ROW_NUMBER() OVER (ORDER BY "insert_date")            AS "rn",
       julianday("insert_date")                              AS "jd"
FROM "cities"
WHERE "country_code_2" = 'cn'
  AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 6. Assign each row to a “streak group” (rn – jd is constant inside a run of consecutive days)
SELECT "city_id",
       "city_name",
       "insert_date",
       (ROW_NUMBER() OVER (ORDER BY "insert_date") - julianday("insert_date")) AS "grp"
FROM "cities"
WHERE "country_code_2" = 'cn'
  AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
ORDER BY "insert_date"
LIMIT 20;
```

```sql
-- 7. Measure the length of every consecutive-date streak
WITH streaks AS (
  SELECT (ROW_NUMBER() OVER (ORDER BY "insert_date") - julianday("insert_date")) AS "grp"
  FROM "cities"
  WHERE "country_code_2" = 'cn'
    AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
)
SELECT "grp",
       COUNT(*) AS "streak_len"
FROM streaks
GROUP BY "grp"
ORDER BY "streak_len" DESC
LIMIT 20;
```

```sql
-- 8. Capture the shortest- and longest-length values so we can isolate those groups
WITH streaks AS (
  SELECT (ROW_NUMBER() OVER (ORDER BY "insert_date") - julianday("insert_date")) AS "grp"
  FROM "cities"
  WHERE "country_code_2" = 'cn'
    AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
lens AS (
  SELECT "grp", COUNT(*) AS "streak_len"
  FROM streaks
  GROUP BY "grp"
)
SELECT MIN("streak_len") AS "min_len",
       MAX("streak_len") AS "max_len"
FROM lens;
```

```sql
-- 9. FINAL ANSWER: list one record per date for the shortest and longest consecutive-date streaks,
--    formatting city names with leading capital letter only, ordered by date
WITH cn_july AS (
  SELECT "city_id",
         "city_name",
         "insert_date" AS "dt"
  FROM "cities"
  WHERE "country_code_2" = 'cn'
    AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
ordered AS (
  SELECT "city_id",
         "city_name",
         "dt",
         ROW_NUMBER() OVER (ORDER BY "dt")             AS "rn",
         julianday("dt")                               AS "jd"
  FROM cn_july
),
streaks AS (
  SELECT "city_id",
         "city_name",
         "dt",
         ("rn" - "jd") AS "grp"
  FROM ordered
),
lens AS (
  SELECT "grp",
         COUNT(*) AS "streak_len"
  FROM streaks
  GROUP BY "grp"
),
target_grps AS (
  SELECT "grp"
  FROM lens
  WHERE "streak_len" = (SELECT MIN("streak_len") FROM lens)
     OR "streak_len" = (SELECT MAX("streak_len") FROM lens)
)
SELECT DISTINCT
       "dt"                                                   AS "date",
       UPPER(SUBSTR("city_name",1,1)) || LOWER(SUBSTR("city_name",2)) AS "city_name"
FROM streaks
WHERE "grp" IN (SELECT "grp" FROM target_grps)
ORDER BY "dt";
```
