-- 6. Assign each row to a “streak group” (rn – jd is constant inside a run of consecutive days)
SELECT "city_id",
       "city_name",
       "insert_date",
       (ROW_NUMBER() OVER (ORDER BY "insert_date") - julianday("insert_date")) AS "grp"
FROM "cities"
WHERE "country_code_2" = 'cn'
  AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
ORDER BY "insert_date"
LIMIT 20;
