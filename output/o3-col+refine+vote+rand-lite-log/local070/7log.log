Query:
-- 8. Capture the shortest- and longest-length values so we can isolate those groups
WITH streaks AS (
  SELECT (ROW_NUMBER() OVER (ORDER BY "insert_date") - julianday("insert_date")) AS "grp"
  FROM "cities"
  WHERE "country_code_2" = 'cn'
    AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
),
lens AS (
  SELECT "grp", COUNT(*) AS "streak_len"
  FROM streaks
  GROUP BY "grp"
)
SELECT MIN("streak_len") AS "min_len",
       MAX("streak_len") AS "max_len"
FROM lens;
