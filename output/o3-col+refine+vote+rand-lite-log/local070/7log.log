-- 7. Measure the length of every consecutive-date streak
WITH streaks AS (
  SELECT (ROW_NUMBER() OVER (ORDER BY "insert_date") - julianday("insert_date")) AS "grp"
  FROM "cities"
  WHERE "country_code_2" = 'cn'
    AND "insert_date" BETWEEN '2021-07-01' AND '2021-07-31'
)
SELECT "grp",
       COUNT(*) AS "streak_len"
FROM streaks
GROUP BY "grp"
ORDER BY "streak_len" DESC
LIMIT 20;
