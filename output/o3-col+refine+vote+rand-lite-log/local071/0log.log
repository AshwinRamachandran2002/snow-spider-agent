Query:
--Description: 5) Build groups of consecutive days per country (the "rn-jd" trick).
WITH june AS (
  SELECT DISTINCT country_code_2,
         insert_date
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
ord AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)           AS rn,
         julianday(insert_date)                             AS jd
  FROM   june
),
grp AS (
  SELECT country_code_2,
         insert_date,
         rn - jd AS grp_id          -- constant inside a consecutive-day streak
  FROM   ord
)
SELECT country_code_2,
       grp_id,
       COUNT(*) AS streak_len
FROM   grp
GROUP  BY country_code_2, grp_id
ORDER  BY streak_len DESC
LIMIT  20;
