Below is a possible sequence of SQL statements (≤ 10) that progressively explores the data in cities for June-2022 and finally returns the 2-letter country codes whose cities show the longest streak of consecutive insert dates.  
Every query is limited to 20 rows so it can be run safely for a quick inspection.

```sql
--Description: 1) Check overall date range stored in "cities".
SELECT MIN(insert_date)  AS min_date,
       MAX(insert_date)  AS max_date
FROM   cities
LIMIT  20;
```

```sql
--Description: 2) Look at a few rows that were inserted in June-2022.
SELECT city_id,
       city_name,
       country_code_2,
       insert_date
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
LIMIT  20;
```

```sql
--Description: 3) How many city rows does each country have in June-2022?
SELECT country_code_2,
       COUNT(*) AS june_rows
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
GROUP  BY country_code_2
ORDER  BY june_rows DESC
LIMIT  20;
```

```sql
--Description: 4) Show distinct June-2022 dates per country, sorted.
SELECT country_code_2,
       insert_date
FROM   cities
WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
GROUP  BY country_code_2, insert_date
ORDER  BY country_code_2,
         insert_date
LIMIT  20;
```

```sql
--Description: 5) Build groups of consecutive days per country (the "rn-jd" trick).
WITH june AS (
  SELECT DISTINCT country_code_2,
         insert_date
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
ord AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)           AS rn,
         julianday(insert_date)                             AS jd
  FROM   june
),
grp AS (
  SELECT country_code_2,
         insert_date,
         rn - jd AS grp_id          -- constant inside a consecutive-day streak
  FROM   ord
)
SELECT country_code_2,
       grp_id,
       COUNT(*) AS streak_len
FROM   grp
GROUP  BY country_code_2, grp_id
ORDER  BY streak_len DESC
LIMIT  20;
```

```sql
--Description: 6) Get the longest streak length for each country in June-2022.
WITH june AS (
  SELECT DISTINCT country_code_2,
         insert_date
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
ord AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS rn,
         julianday(insert_date)                   AS jd
  FROM   june
),
grp AS (
  SELECT country_code_2,
         rn - jd AS grp_id
  FROM   ord
),
streaks AS (
  SELECT country_code_2,
         grp_id,
         COUNT(*) AS streak_len
  FROM   grp
  GROUP  BY country_code_2, grp_id
)
SELECT country_code_2,
       MAX(streak_len) AS longest_streak
FROM   streaks
GROUP  BY country_code_2
ORDER  BY longest_streak DESC
LIMIT  20;
```

```sql
--Description: 7) Find the maximum streak value across every country.
WITH june AS (
  SELECT DISTINCT country_code_2,
         insert_date
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
ord AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS rn,
         julianday(insert_date)                   AS jd
  FROM   june
),
grp AS (
  SELECT country_code_2,
         rn - jd AS grp_id
  FROM   ord
),
streaks AS (
  SELECT country_code_2,
         grp_id,
         COUNT(*) AS streak_len
  FROM   grp
  GROUP  BY country_code_2, grp_id
),
longest AS (
  SELECT country_code_2,
         MAX(streak_len) AS longest_streak
  FROM   streaks
  GROUP  BY country_code_2
)
SELECT MAX(longest_streak) AS max_streak_overall
FROM   longest
LIMIT  20;
```

```sql
--Description: 8) Return the 2-letter country codes whose longest streak
--               equals the overall maximum (i.e., the final answer).
WITH june AS (
  SELECT DISTINCT country_code_2,
         insert_date
  FROM   cities
  WHERE  insert_date BETWEEN '2022-06-01' AND '2022-06-30'
),
ord AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date) AS rn,
         julianday(insert_date)                   AS jd
  FROM   june
),
grp AS (
  SELECT country_code_2,
         rn - jd AS grp_id
  FROM   ord
),
streaks AS (
  SELECT country_code_2,
         grp_id,
         COUNT(*) AS streak_len
  FROM   grp
  GROUP  BY country_code_2, grp_id
),
longest AS (
  SELECT country_code_2,
         MAX(streak_len) AS longest_streak
  FROM   streaks
  GROUP  BY country_code_2
),
maxval AS (
  SELECT MAX(longest_streak) AS max_streak_overall
  FROM   longest
)
SELECT longest.country_code_2
FROM   longest
JOIN   maxval
  ON   longest.longest_streak = maxval.max_streak_overall
LIMIT  20;
```

