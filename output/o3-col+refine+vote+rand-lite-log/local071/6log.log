--Description: 5) Flag the place where the gap between two successive dates is NOT 1 day
--   (these mark the starts of new streaks)
SELECT country_code_2,
       insert_date,
       CASE
           WHEN julianday(insert_date) 
              - julianday(LAG(insert_date) OVER (PARTITION BY country_code_2
                                                 ORDER BY insert_date)) = 1 
           THEN 0 ELSE 1
       END AS new_streak_flag
FROM cities
WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
ORDER BY country_code_2,
         insert_date
LIMIT 20;
