         insert_date
LIMIT 20;
```

```sql
--Description: 4) For every city row in June-2022, attach the previous date for the same country
SELECT country_code_2,
       insert_date,
       LAG(insert_date) OVER (PARTITION BY country_code_2
                              ORDER BY insert_date) AS prev_date
FROM cities
WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
ORDER BY country_code_2,
         insert_date
LIMIT 20;
```

```sql
--Description: 5) Flag the place where the gap between two successive dates is NOT 1 day
--   (these mark the starts of new streaks)
SELECT country_code_2,
       insert_date,
       CASE
           WHEN julianday(insert_date) 
              - julianday(LAG(insert_date) OVER (PARTITION BY country_code_2
                                                 ORDER BY insert_date)) = 1 
           THEN 0 ELSE 1
       END AS new_streak_flag
FROM cities
WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
ORDER BY country_code_2,
         insert_date
LIMIT 20;
```

```sql
--Description: 6) Build a running sum of those flags to assign a unique streak-id
WITH june AS (
    SELECT country_code_2,
           insert_date,
           CASE
               WHEN julianday(insert_date) 
                    - julianday(LAG(insert_date) OVER (PARTITION BY country_code_2
                                                       ORDER BY insert_date)) = 1 
               THEN 0 ELSE 1
           END AS new_streak_flag
    FROM cities
    WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
)
SELECT country_code_2,
       insert_date,
       SUM(new_streak_flag) OVER (PARTITION BY country_code_2
                                  ORDER BY insert_date) AS streak_id
FROM june
ORDER BY country_code_2,
         insert_date
LIMIT 20;
```

```sql
--Description: 7) Count how many days are in every individual streak for each country
WITH june AS (
    SELECT country_code_2,
           insert_date,
           CASE
               WHEN julianday(insert_date) 
                    - julianday(LAG(insert_date) OVER (PARTITION BY country_code_2
                                                       ORDER BY insert_date)) = 1 
               THEN 0 ELSE 1
           END AS new_streak_flag
    FROM cities
    WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
), streaked AS (
    SELECT country_code_2,
           insert_date,
           SUM(new_streak_flag) OVER (PARTITION BY country_code_2
                                      ORDER BY insert_date) AS streak_id
    FROM june
)
SELECT country_code_2,
       streak_id,
       COUNT(*) AS streak_len
FROM streaked
GROUP BY country_code_2, streak_id
ORDER BY country_code_2,
         streak_len DESC
LIMIT 20;
```

```sql
--Description: 8) For every country, pick the longest streak length it achieved in June-2022
WITH june AS (
    SELECT country_code_2,
           insert_date,
           CASE
               WHEN julianday(insert_date) 
                    - julianday(LAG(insert_date) OVER (PARTITION BY country_code_2
                                                       ORDER BY insert_date)) = 1 
               THEN 0 ELSE 1
           END AS new_streak_flag
    FROM cities
    WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
), streaked AS (
    SELECT country_code_2,
           insert_date,
           SUM(new_streak_flag) OVER (PARTITION BY country_code_2
                                      ORDER BY insert_date) AS streak_id
    FROM june
), streak_lens AS (
    SELECT country_code_2,
           streak_id,
           COUNT(*) AS streak_len
    FROM streaked
    GROUP BY country_code_2, streak_id
)
SELECT country_code_2,
       MAX(streak_len) AS max_streak_len
FROM streak_lens
GROUP BY country_code_2
ORDER BY max_streak_len DESC,
         country_code_2
LIMIT 20;
```

```sql
--Description: 9) Finally, return the country codes whose longest streak equals the global maximum
WITH june AS (
    SELECT country_code_2,
           insert_date,
           CASE
               WHEN julianday(insert_date) 
                    - julianday(LAG(insert_date) OVER (PARTITION BY country_code_2
                                                       ORDER BY insert_date)) = 1 
               THEN 0 ELSE 1
           END AS new_streak_flag
    FROM cities
    WHERE insert_date BETWEEN '2022-06-01' AND '2022-06-30'
), streaked AS (
    SELECT country_code_2,
           insert_date,
           SUM(new_streak_flag) OVER (PARTITION BY country_code_2
                                      ORDER BY insert_date) AS streak_id
    FROM june
), streak_lens AS (
    SELECT country_code_2,
           streak_id,
           COUNT(*) AS streak_len
    FROM streaked
    GROUP BY country_code_2, streak_id
), best_per_country AS (
    SELECT country_code_2,
           MAX(streak_len) AS max_streak_len
    FROM streak_lens
    GROUP BY country_code_2
), global_max AS (
    SELECT MAX(max_streak_len) AS global_best
    FROM best_per_country
)
SELECT b.country_code_2
FROM best_per_country AS b,
     global_max         AS g
WHERE b.max_streak_len = g.global_best
ORDER BY b.country_code_2;
```

