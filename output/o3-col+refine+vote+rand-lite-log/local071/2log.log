```sql
--Description: 1)  Look at all distinct “insert_date” values recorded in June-2022 in the cities table
SELECT DISTINCT "insert_date"
FROM "cities"
WHERE "insert_date" LIKE '2022-06-%'
ORDER BY "insert_date"
LIMIT 20;
```

```sql
--Description: 2)  See which 2-letter country codes had at least one city record inserted in June-2022
SELECT DISTINCT "country_code_2"
FROM "cities"
WHERE "insert_date" LIKE '2022-06-%'
ORDER BY "country_code_2"
LIMIT 20;
```

```sql
--Description: 3)  For those June-2022 rows, check the raw rows (city, date, country) to spot any anomalies
SELECT "city_name",
       "country_code_2",
       "insert_date"
FROM   "cities"
WHERE  "insert_date" LIKE '2022-06-%'
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
--Description: 4)  Count how many June-2022 city rows each country contributed
SELECT   "country_code_2",
         COUNT(*) AS "cnt_rows_jun22"
FROM     "cities"
WHERE    "insert_date" LIKE '2022-06-%'
GROUP BY "country_code_2"
ORDER BY "cnt_rows_jun22" DESC
LIMIT 20;
```

```sql
--Description: 5)  For every June-2022 row, convert “insert_date” to a julianday so we can test day-by-day gaps
SELECT   "city_id",
         "country_code_2",
         "insert_date",
         julianday("insert_date") AS "jd"
FROM     "cities"
WHERE    "insert_date" LIKE '2022-06-%'
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
--Description: 6)  Within each country, give every row a running row_number to prepare for streak detection
SELECT   "city_id",
         "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                            ORDER BY "insert_date") AS "rn"
FROM     "cities"
WHERE    "insert_date" LIKE '2022-06-%'
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
--Description: 7)  Use the difference julianday(date) − row_number to form groups of consecutive dates
SELECT   "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                            ORDER BY "insert_date")                         AS "rn",
         julianday("insert_date")                                           AS "jd",
         julianday("insert_date") - ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                                                       ORDER BY "insert_date") AS "streak_grp"
FROM     "cities"
WHERE    "insert_date" LIKE '2022-06-%'
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
--Description: 8)  Aggregate by country & streak_grp to know the length of each consecutive-day streak
SELECT   "country_code_2",
         "streak_grp",
         COUNT(*) AS "streak_len"
FROM   (
        SELECT "country_code_2",
               julianday("insert_date") - 
               ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS "streak_grp"
        FROM   "cities"
        WHERE  "insert_date" LIKE '2022-06-%'
       ) AS t
GROUP BY "country_code_2", "streak_grp"
ORDER BY "streak_len" DESC
LIMIT 20;
```

```sql
--Description: 9)  For every country, keep only its single longest streak length in June-2022
WITH streaks AS (
  SELECT "country_code_2",
         COUNT(*) AS "streak_len"
  FROM (
        SELECT "country_code_2",
               julianday("insert_date") - 
               ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS "streak_grp"
        FROM   "cities"
        WHERE  "insert_date" LIKE '2022-06-%'
       )
  GROUP BY "country_code_2", "streak_grp"
)
SELECT "country_code_2",
       MAX("streak_len") AS "longest_streak"
FROM   streaks
GROUP BY "country_code_2"
ORDER BY "longest_streak" DESC
LIMIT 20;
```

```sql
--Description: 10)  Identify the country (or countries, if tied) that achieved the overall longest
WITH streaks AS (
  SELECT "country_code_2",
         COUNT(*) AS "streak_len"
  FROM (
        SELECT "country_code_2",
               julianday("insert_date") - 
               ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS "streak_grp"
        FROM   "cities"
        WHERE  "insert_date" LIKE '2022-06-%'
       )
  GROUP BY "country_code_2", "streak_grp"
), max_len AS (
  SELECT MAX("streak_len") AS "mx" FROM streaks
)
SELECT DISTINCT s."country_code_2"
FROM   streaks AS s
JOIN   max_len  AS m  ON s."streak_len" = m."mx";
```
