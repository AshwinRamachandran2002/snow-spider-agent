```sql
--Description: 6)  Produce one row per (country , date) for June-2022 to prepare for streak logic.  
SELECT DISTINCT 
       "country_code_2",
       substr("insert_date",1,10) AS "dt"
FROM   "cities"
WHERE  "insert_date" LIKE '2022-06%'
ORDER BY "country_code_2", "dt"
LIMIT 20;
```

```sql
--Description: 7)  Add a row number per country ordered by date; also store the numeric julian day.
SELECT  c."country_code_2",
        c."dt",
        ROW_NUMBER() OVER (PARTITION BY c."country_code_2" ORDER BY c."dt")         AS "rn",
        CAST(julianday(c."dt") AS INTEGER)                                           AS "jd"
FROM   (
        SELECT DISTINCT 
               "country_code_2",
               substr("insert_date",1,10) AS "dt"
        FROM   "cities"
        WHERE  "insert_date" LIKE '2022-06%'
       )  AS c
ORDER BY c."country_code_2", c."dt"
LIMIT 20;
```

```sql
--Description: 8)  Tag consecutive-date blocks via (jd – rn) trick and count their lengths.
WITH june AS (
     SELECT DISTINCT 
            "country_code_2",
            substr("insert_date",1,10) AS "dt"
     FROM   "cities"
     WHERE  "insert_date" LIKE '2022-06%'
),
seq AS (
     SELECT  
            "country_code_2",
            "dt",
            ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "dt") AS rn,
            CAST(julianday("dt") AS INTEGER)                                 AS jd
     FROM   june
)
SELECT  
        "country_code_2",
        (jd - rn)                          AS "block_key",
        COUNT(*)                           AS "streak_len"
FROM    seq
GROUP BY "country_code_2", "block_key"
ORDER BY "streak_len" DESC, "country_code_2"
LIMIT 20;
```

```sql
--Description: 9)  For each country, keep only its longest consecutive-day streak length.  
WITH june AS (
     SELECT DISTINCT "country_code_2",
                     substr("insert_date",1,10) AS "dt"
     FROM   "cities"
     WHERE  "insert_date" LIKE '2022-06%'
),
seq AS (
     SELECT  "country_code_2",
             ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "dt") AS rn,
             CAST(julianday("dt") AS INTEGER)                                 AS jd
     FROM    june
),
blocks AS (
     SELECT  "country_code_2",
             (jd - rn) AS block_key,
             COUNT(*)  AS streak_len
     FROM    seq
     GROUP BY "country_code_2", block_key
)
SELECT  "country_code_2",
        MAX(streak_len) AS longest_streak
FROM    blocks
GROUP BY "country_code_2"
ORDER BY longest_streak DESC, "country_code_2"
LIMIT 20;
```

```sql
--Description: 10)  Return the 2-letter country codes whose longest streak equals the overall maximum.  
WITH june AS (
     SELECT DISTINCT "country_code_2",
                     substr("insert_date",1,10) AS "dt"
     FROM   "cities"
     WHERE  "insert_date" LIKE '2022-06%'
),
seq AS (
     SELECT  "country_code_2",
             ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "dt") AS rn,
             CAST(julianday("dt") AS INTEGER)                                 AS jd
     FROM    june
),
blocks AS (
     SELECT  "country_code_2",
             (jd - rn) AS block_key,
             COUNT(*)  AS streak_len
     FROM    seq
     GROUP BY "country_code_2", block_key
),
country_max AS (
     SELECT  "country_code_2",
             MAX(streak_len) AS longest_streak
     FROM    blocks
     GROUP BY "country_code_2"
),
overall AS (
     SELECT MAX(longest_streak) AS max_streak FROM country_max
)
SELECT DISTINCT cm."country_code_2"
FROM   country_max  AS cm
JOIN   overall      AS o
       ON cm.longest_streak = o.max_streak
ORDER BY cm."country_code_2"
LIMIT 20;
```
