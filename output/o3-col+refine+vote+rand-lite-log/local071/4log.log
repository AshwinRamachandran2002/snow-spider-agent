Query:
-- Description: For every city-record in June 2022, assign a row number
-- (per country) ordered by date.  This is the first step toward detecting
-- consecutive-day streaks.
SELECT country_code_2,
       insert_date,
       ROW_NUMBER() OVER (
           PARTITION BY country_code_2
           ORDER BY insert_date
       ) AS rn
FROM cities
WHERE insert_date LIKE '2022-06-%'
ORDER BY country_code_2, insert_date
LIMIT 20;
