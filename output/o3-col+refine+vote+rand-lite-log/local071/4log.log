-- Description: Inspect a few sample rows of the “cities” table to confirm the presence and
-- format of the insert-date column we will analyse.
SELECT *
FROM cities
LIMIT 20;
```

```sql
-- Description: Check which (year-month) values exist in the insert_date column.
-- This helps verify that we indeed have data for 2022-06.
SELECT DISTINCT substr(insert_date, 1, 7) AS year_month
FROM cities
ORDER BY year_month
LIMIT 20;
```

```sql
-- Description: Look at all rows whose insert_date falls in June 2022.
SELECT city_id,
       city_name,
       country_code_2,
       insert_date
FROM cities
WHERE insert_date LIKE '2022-06-%'
ORDER BY country_code_2, insert_date
LIMIT 20;
```

```sql
-- Description: Count how many city-records each country inserted during June 2022.
SELECT country_code_2,
       COUNT(*) AS june_2022_rows
FROM cities
WHERE insert_date LIKE '2022-06-%'
GROUP BY country_code_2
ORDER BY june_2022_rows DESC
LIMIT 20;
```

```sql
-- Description: For every city-record in June 2022, assign a row number
-- (per country) ordered by date.  This is the first step toward detecting
-- consecutive-day streaks.
SELECT country_code_2,
       insert_date,
       ROW_NUMBER() OVER (
           PARTITION BY country_code_2
           ORDER BY insert_date
       ) AS rn
FROM cities
WHERE insert_date LIKE '2022-06-%'
ORDER BY country_code_2, insert_date
LIMIT 20;
```

```sql
-- Description: Add a “group_key” (= julianday(insert_date) − row_number) so that
-- consecutive calendar days share the same key inside each country.
SELECT country_code_2,
       insert_date,
       rn,
       julianday(insert_date) - rn AS group_key
FROM (
    SELECT country_code_2,
           insert_date,
           ROW_NUMBER() OVER (
               PARTITION BY country_code_2
               ORDER BY insert_date
           ) AS rn
    FROM cities
    WHERE insert_date LIKE '2022-06-%'
)
ORDER BY country_code_2, insert_date
LIMIT 20;
```

```sql
-- Description: Using the group_key, calculate the length of every consecutive
-- insert-date streak per country in June 2022.
SELECT country_code_2,
       group_key,
       COUNT(*) AS streak_len
FROM (
    SELECT country_code_2,
           julianday(insert_date) - ROW_NUMBER() OVER (
               PARTITION BY country_code_2
               ORDER BY insert_date
           ) AS group_key
    FROM cities
    WHERE insert_date LIKE '2022-06-%'
)
GROUP BY country_code_2, group_key
ORDER BY country_code_2, streak_len DESC
LIMIT 20;
```

```sql
-- Description: Determine the longest streak length that each country achieved
-- in June 2022.
SELECT country_code_2,
       MAX(streak_len) AS longest_streak
FROM (
    SELECT country_code_2,
           group_key,
           COUNT(*) AS streak_len
    FROM (
        SELECT country_code_2,
               julianday(insert_date) - ROW_NUMBER() OVER (
                   PARTITION BY country_code_2
                   ORDER BY insert_date
               ) AS group_key
        FROM cities
        WHERE insert_date LIKE '2022-06-%'
    )
    GROUP BY country_code_2, group_key
)
GROUP BY country_code_2
ORDER BY longest_streak DESC
LIMIT 20;
```

```sql
-- Description: Find the single (or multiple, in case of a tie) country code(s)
-- whose longest consecutive-day streak is the highest among all countries in
-- June 2022.
WITH streaks AS (
    SELECT country_code_2,
           MAX(streak_len) AS longest_streak
    FROM (
        SELECT country_code_2,
               group_key,
               COUNT(*) AS streak_len
        FROM (
            SELECT country_code_2,
                   julianday(insert_date) - ROW_NUMBER() OVER (
                       PARTITION BY country_code_2
                       ORDER BY insert_date
                   ) AS group_key
            FROM cities
            WHERE insert_date LIKE '2022-06-%'
        )
        GROUP BY country_code_2, group_key
    )
    GROUP BY country_code_2
)
SELECT country_code_2
FROM streaks
WHERE longest_streak = (SELECT MAX(longest_streak) FROM streaks);
```

```sql
-- Description: (Optional verification) Show the winning country(ies) together
-- with their longest streak length to confirm the result.
WITH streaks AS (
    SELECT country_code_2,
           MAX(streak_len) AS longest_streak
    FROM (
        SELECT country_code_2,
               group_key,
               COUNT(*) AS streak_len
        FROM (
            SELECT country_code_2,
                   julianday(insert_date) - ROW_NUMBER() OVER (
                       PARTITION BY country_code_2
                       ORDER BY insert_date
                   ) AS group_key
            FROM cities
            WHERE insert_date LIKE '2022-06-%'
        )
        GROUP BY country_code_2, group_key
    )
    GROUP BY country_code_2
)
SELECT *
FROM streaks
WHERE longest_streak = (SELECT MAX(longest_streak) FROM streaks);
```
