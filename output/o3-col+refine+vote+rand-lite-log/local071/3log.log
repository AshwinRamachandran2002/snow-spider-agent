Below are 10 exploratory-to-final SQL statements that walk through the logic of finding, for June 2022, the country (or countries) whose cities table shows the longest streak of consecutive “insert_date” values.  
(Every query is limited to 20 rows, except the final answer.)

```sql
-- 1. Description:  Peek at the distinct insert dates we actually have in June-2022.
SELECT DISTINCT "insert_date"
FROM "cities"
WHERE "insert_date" LIKE '2022-06%'
LIMIT 20;
```

```sql
-- 2. Description:  What two-letter country codes exist in the cities table?
SELECT DISTINCT "country_code_2"
FROM "cities"
LIMIT 20;
```

```sql
-- 3. Description:  Sample June-2022 rows with city name + country code.
SELECT "city_name",
       "country_code_2",
       "insert_date"
FROM "cities"
WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
LIMIT 20;
```

```sql
-- 4. Description:  Count how many cities were inserted per country per day in June-2022.
SELECT "country_code_2",
       "insert_date",
       COUNT(*) AS "city_cnt"
FROM "cities"
WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
GROUP BY "country_code_2", "insert_date"
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
-- 5. Description:  Add a row_number per country to help build streak keys.
SELECT "country_code_2",
       "insert_date",
       ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                          ORDER BY "insert_date") AS "rn"
FROM "cities"
WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
LIMIT 20;
```

```sql
-- 6. Description:  Show the derived “grp_key” (julianday-rn) that stays
--                  constant within a run of consecutive dates.
WITH c AS (
    SELECT "country_code_2",
           "insert_date",
           ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                              ORDER BY "insert_date") AS "rn"
    FROM "cities"
    WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
)
SELECT "country_code_2",
       "insert_date",
       "rn",
       julianday("insert_date") - "rn" AS "grp_key"
FROM c
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
-- 7. Description:  Length of each consecutive-date streak for every country.
WITH c AS (
    SELECT "country_code_2",
           "insert_date",
           ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                              ORDER BY "insert_date") AS "rn"
    FROM "cities"
    WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
)
SELECT "country_code_2",
       julianday("insert_date") - "rn"  AS "grp_key",
       COUNT(*)                         AS "streak_len"
FROM c
GROUP BY "country_code_2", "grp_key"
ORDER BY "streak_len" DESC
LIMIT 20;
```

```sql
-- 8. Description:  Maximum streak length per country in June-2022.
WITH c AS (
    SELECT "country_code_2",
           "insert_date",
           ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                              ORDER BY "insert_date") AS "rn"
    FROM "cities"
    WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), s AS (
    SELECT "country_code_2",
           julianday("insert_date") - "rn" AS "grp_key",
           COUNT(*) AS "streak_len"
    FROM c
    GROUP BY "country_code_2", "grp_key"
)
SELECT "country_code_2",
       MAX("streak_len") AS "max_streak"
FROM s
GROUP BY "country_code_2"
ORDER BY "max_streak" DESC
LIMIT 20;
```

```sql
-- 9. Description:  Overall longest streak length among all countries.
WITH max_streak_country AS (
    /* same sub-query as #8 */
    WITH c AS (
        SELECT "country_code_2",
               "insert_date",
               ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                                  ORDER BY "insert_date") AS "rn"
        FROM "cities"
        WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
    ), s AS (
        SELECT "country_code_2",
               julianday("insert_date") - "rn" AS "grp_key",
               COUNT(*) AS "streak_len"
        FROM c
        GROUP BY "country_code_2", "grp_key"
    )
    SELECT "country_code_2",
           MAX("streak_len") AS "max_streak"
    FROM s
    GROUP BY "country_code_2"
)
SELECT MAX("max_streak") AS "longest_streak"
FROM max_streak_country;
```

```sql
-- 10. Description (FINAL ANSWER):  2-letter country codes whose max streak
--                    equals the overall longest streak in June-2022.
WITH date_filtered AS (
    SELECT "country_code_2",
           "insert_date"
    FROM "cities"
    WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), rn_calc AS (
    SELECT "country_code_2",
           "insert_date",
           ROW_NUMBER() OVER (PARTITION BY "country_code_2"
                              ORDER BY "insert_date") AS "rn"
    FROM date_filtered
), streaks AS (
    SELECT "country_code_2",
           julianday("insert_date") - "rn" AS "grp_key"
    FROM rn_calc
), streak_len AS (
    SELECT "country_code_2",
           "grp_key",
           COUNT(*) AS "streak_length"
    FROM streaks
    GROUP BY "country_code_2", "grp_key"
), max_streak_country AS (
    SELECT "country_code_2",
           MAX("streak_length") AS "max_streak"
    FROM streak_len
    GROUP BY "country_code_2"
), overall_max AS (
    SELECT MAX("max_streak") AS "longest"
    FROM max_streak_country
)
SELECT "country_code_2"
FROM   max_streak_country
WHERE  "max_streak" = (SELECT "longest" FROM overall_max);
```
