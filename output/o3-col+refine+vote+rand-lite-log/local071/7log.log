--9. Description: For every country find the length of each consecutive streak in June-2022
WITH june AS (
  SELECT DISTINCT "country_code_2", "insert_date"
  FROM "cities"
  WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), ranked AS (
  SELECT "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS rn,
         julianday("insert_date") AS jd
  FROM june
), grouped AS (
  SELECT "country_code_2",
         jd - rn AS grp_id          --gap-aware id
  FROM ranked
)
SELECT "country_code_2",
       COUNT(*) AS streak_len
FROM grouped
GROUP BY "country_code_2", grp_id
ORDER BY "streak_len" DESC
LIMIT 20;
