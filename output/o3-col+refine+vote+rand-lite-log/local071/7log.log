--8. Description: Group dates into consecutive streak-ids using (julianday – row_number)
WITH june AS (
  SELECT DISTINCT "country_code_2", "insert_date"
  FROM "cities"
  WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), ranked AS (
  SELECT "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS rn,
         julianday("insert_date")                    AS jd
  FROM june
)
SELECT "country_code_2",
       "insert_date",
       rn,
       jd,
       jd - rn        AS grp_id   --same grp_id ⇒ consecutive streak
FROM ranked
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
