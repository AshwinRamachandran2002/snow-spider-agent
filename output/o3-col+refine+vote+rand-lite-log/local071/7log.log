```sql
--8. Description: Group dates into consecutive streak-ids using (julianday – row_number)
WITH june AS (
  SELECT DISTINCT "country_code_2", "insert_date"
  FROM "cities"
  WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), ranked AS (
  SELECT "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS rn,
         julianday("insert_date")                    AS jd
  FROM june
)
SELECT "country_code_2",
       "insert_date",
       rn,
       jd,
       jd - rn        AS grp_id   --same grp_id ⇒ consecutive streak
FROM ranked
ORDER BY "country_code_2", "insert_date"
LIMIT 20;
```

```sql
--9. Description: For every country find the length of each consecutive streak in June-2022
WITH june AS (
  SELECT DISTINCT "country_code_2", "insert_date"
  FROM "cities"
  WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), ranked AS (
  SELECT "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS rn,
         julianday("insert_date") AS jd
  FROM june
), grouped AS (
  SELECT "country_code_2",
         jd - rn AS grp_id          --gap-aware id
  FROM ranked
)
SELECT "country_code_2",
       COUNT(*) AS streak_len
FROM grouped
GROUP BY "country_code_2", grp_id
ORDER BY "streak_len" DESC
LIMIT 20;
```

```sql
--10. Description: Final answer – countries whose longest June-2022 streak(s) are the global maximum
WITH june AS (
  SELECT DISTINCT "country_code_2", "insert_date"
  FROM "cities"
  WHERE "insert_date" BETWEEN '2022-06-01' AND '2022-06-30'
), ranked AS (
  SELECT "country_code_2",
         "insert_date",
         ROW_NUMBER() OVER (PARTITION BY "country_code_2" ORDER BY "insert_date") AS rn,
         julianday("insert_date") AS jd
  FROM june
), grouped AS (
  SELECT "country_code_2",
         (jd - rn) AS grp_id
  FROM ranked
), streaks AS (
  SELECT "country_code_2",
         COUNT(*) AS streak_len
  FROM grouped
  GROUP BY "country_code_2", grp_id
), max_per_country AS (
  SELECT "country_code_2",
         MAX(streak_len) AS max_streak
  FROM streaks
  GROUP BY "country_code_2"
), overall_max AS (
  SELECT MAX(max_streak) AS overall_max_streak
  FROM max_per_country
)
SELECT DISTINCT m."country_code_2"
FROM max_per_country m, overall_max o
WHERE m.max_streak = o.overall_max_streak;
```
