--Description: 7) For each country, keep only its single longest June-2022 streak.  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
), streaks AS (
  SELECT country_code_2,
         (jd - rn)                AS streak_id
  FROM numbered
), streak_len AS (
  SELECT country_code_2,
         streak_id,
         COUNT(*) AS streak_len
  FROM streaks
  GROUP BY country_code_2,
           streak_id
)
SELECT country_code_2,
       MAX(streak_len) AS longest_streak
FROM streak_len
GROUP BY country_code_2
ORDER BY longest_streak DESC
LIMIT 20;
