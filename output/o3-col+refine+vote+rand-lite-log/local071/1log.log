Query:
--Description: 9) Finally, list those countries whose longest June-2022 streak equals the overall maximum (i.e., “countries with the longest streak”).  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
), streaks AS (
  SELECT country_code_2,
         (jd - rn)                AS streak_id
  FROM numbered
), streak_len AS (
  SELECT country_code_2,
         streak_id,
         COUNT(*) AS streak_len
  FROM streaks
  GROUP BY country_code_2,
           streak_id
), longest AS (
  SELECT country_code_2,
         MAX(streak_len) AS longest_streak
  FROM streak_len
  GROUP BY country_code_2
), max_val AS (
  SELECT MAX(longest_streak) AS max_streak
  FROM longest
)
SELECT DISTINCT l.country_code_2
FROM   longest AS l,
       max_val AS m
WHERE  l.longest_streak = m.max_streak
LIMIT 20;
