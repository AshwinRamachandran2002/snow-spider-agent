```sql
--Description: 1) Inspect all city–insert records that fall in June-2022.
SELECT *
FROM cities
WHERE insert_date LIKE '2022-06-%'
LIMIT 20;
```

```sql
--Description: 2) See which (⇢ DISTINCT) 2-letter country codes appear in June-2022.
SELECT DISTINCT country_code_2
FROM cities
WHERE insert_date LIKE '2022-06-%'
LIMIT 20;
```

```sql
--Description: 3) Count how many cities were inserted per country on each June-2022 day.  
SELECT insert_date,
       country_code_2,
       COUNT(*) AS cities_added
FROM cities
WHERE insert_date LIKE '2022-06-%'
GROUP BY country_code_2,
         insert_date
ORDER BY country_code_2,
         insert_date
LIMIT 20;
```

```sql
--Description: 4) For every country & June-2022 date, list the day-number (⇢ using ROW_NUMBER) to prepare for streak detection.  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
)
SELECT country_code_2,
       insert_date,
       ROW_NUMBER() OVER (PARTITION BY country_code_2
                          ORDER BY insert_date) AS rn
FROM june
ORDER BY country_code_2,
         insert_date
LIMIT 20;
```

```sql
--Description: 5) Build a “streak id” for consecutive days: julianday(date) – rn is constant inside each streak.  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
)
SELECT country_code_2,
       insert_date,
       rn,
       (jd - rn) AS streak_id      -- constant per consecutive run
FROM numbered
ORDER BY country_code_2,
         insert_date
LIMIT 20;
```

```sql
--Description: 6) Compute the length of every consecutive-day streak per country.  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
), streaks AS (
  SELECT country_code_2,
         (jd - rn)                AS streak_id
  FROM numbered
)
SELECT country_code_2,
       streak_id,
       COUNT(*)   AS streak_len
FROM streaks
GROUP BY country_code_2,
         streak_id
ORDER BY country_code_2,
         streak_len DESC
LIMIT 20;
```

```sql
--Description: 7) For each country, keep only its single longest June-2022 streak.  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
), streaks AS (
  SELECT country_code_2,
         (jd - rn)                AS streak_id
  FROM numbered
), streak_len AS (
  SELECT country_code_2,
         streak_id,
         COUNT(*) AS streak_len
  FROM streaks
  GROUP BY country_code_2,
           streak_id
)
SELECT country_code_2,
       MAX(streak_len) AS longest_streak
FROM streak_len
GROUP BY country_code_2
ORDER BY longest_streak DESC
LIMIT 20;
```

```sql
--Description: 8) Determine the maximum streak length that any country achieved in June-2022.  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
), streaks AS (
  SELECT country_code_2,
         (jd - rn)                AS streak_id
  FROM numbered
), streak_len AS (
  SELECT country_code_2,
         streak_id,
         COUNT(*) AS streak_len
  FROM streaks
  GROUP BY country_code_2,
           streak_id
), longest AS (
  SELECT country_code_2,
         MAX(streak_len) AS longest_streak
  FROM streak_len
  GROUP BY country_code_2
)
SELECT MAX(longest_streak) AS max_streak_overall
FROM longest;
```

```sql
--Description: 9) Finally, list those countries whose longest June-2022 streak equals the overall maximum (i.e., “countries with the longest streak”).  
WITH june AS (
  SELECT DISTINCT insert_date,
         country_code_2
  FROM cities
  WHERE insert_date LIKE '2022-06-%'
), numbered AS (
  SELECT country_code_2,
         insert_date,
         ROW_NUMBER() OVER (PARTITION BY country_code_2
                            ORDER BY insert_date)        AS rn,
         julianday(insert_date)                         AS jd
  FROM june
), streaks AS (
  SELECT country_code_2,
         (jd - rn)                AS streak_id
  FROM numbered
), streak_len AS (
  SELECT country_code_2,
         streak_id,
         COUNT(*) AS streak_len
  FROM streaks
  GROUP BY country_code_2,
           streak_id
), longest AS (
  SELECT country_code_2,
         MAX(streak_len) AS longest_streak
  FROM streak_len
  GROUP BY country_code_2
), max_val AS (
  SELECT MAX(longest_streak) AS max_streak
  FROM longest
)
SELECT DISTINCT l.country_code_2
FROM   longest AS l,
       max_val AS m
WHERE  l.longest_streak = m.max_streak
LIMIT 20;
```

