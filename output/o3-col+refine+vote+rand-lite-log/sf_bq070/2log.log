```sql
/*  Digital slide microscopy instances (SM + VOLUME) from TCGA-LUAD
    and TCGA-LUSC that
      • are JPEG/JPEG-2000 compressed,
      • were embedded in “Tissue freezing medium”,
      • contain either normal (17621005) or tumour (86049000) tissue.   */

WITH frozen_specimens AS (               -- 1. slides matching tissue & embedding constraints
    SELECT DISTINCT
           da."PatientID",
           da."UID"                                            AS "digital_slide_id",
           da."StudyInstanceUID"                               AS "case_id",
           TRY_PARSE_JSON(f.value):"SpecimenIdentifier"::STRING
                                                               AS "physical_slide_id",
           da."Columns"                                        AS "width",
           da."Rows"                                           AS "height",
           da."PixelSpacing"                                   AS "pixel_spacing",
           CASE
               WHEN f.value::STRING ILIKE '%86049000%' THEN 'tumor'
               WHEN f.value::STRING ILIKE '%17621005%' THEN 'normal'
           END                                                 AS "tissue_type"
    FROM   IDC.IDC_V17.DICOM_ALL  da,
           LATERAL FLATTEN(INPUT => da."SpecimenDescriptionSequence") f
    WHERE  f.value::STRING ILIKE '%tissue freezing medium%'
       AND ( f.value::STRING ILIKE '%86049000%'
          OR  f.value::STRING ILIKE '%17621005%' )
),
candidate_instances AS (               -- 2. SM VOLUME images in LUAD/LUSC collections
    SELECT
           dp."crdc_instance_uuid"                             AS "instance_id",
           dp."gcs_url",
           dp."collection_id",
           fs."digital_slide_id",
           fs."case_id",
           fs."physical_slide_id",
           fs."PatientID"                                      AS "patient_id",
           fs."width",
           fs."height",
           fs."pixel_spacing",
           fs."tissue_type",
           CASE
               WHEN dp."collection_id" = 'tcga_luad' THEN 'luad'
               WHEN dp."collection_id" = 'tcga_lusc' THEN 'lscc'
           END                                                 AS "cancer_subtype"
    FROM   frozen_specimens           fs
    JOIN   IDC.IDC_V17.DICOM_PIVOT    dp
           ON  dp."PatientID" = fs."PatientID"
           AND dp."Modality"  = 'SM'
           AND dp."ImageType" ILIKE '%VOLUME%'
           AND dp."collection_id" IN ('tcga_luad','tcga_lusc')
),
with_compression AS (                -- 3. add compression information, keep jpeg / jpeg2000
    SELECT
           ci.*,
           CASE
               WHEN dm."TransferSyntaxUID" IN (
                        '1.2.840.10008.1.2.4.50',
                        '1.2.840.10008.1.2.4.51',
                        '1.2.840.10008.1.2.4.57',
                        '1.2.840.10008.1.2.4.70' )            THEN 'jpeg'
               WHEN dm."TransferSyntaxUID" IN (
                        '1.2.840.10008.1.2.4.90',
                        '1.2.840.10008.1.2.4.91' )            THEN 'jpeg2000'
               ELSE                                             'other'
           END                                                 AS "compression_type"
    FROM   candidate_instances        ci
    JOIN   IDC.IDC_V17.DICOM_METADATA dm
           ON dm."SOPInstanceUID" = ci."digital_slide_id"
)
SELECT DISTINCT
       "digital_slide_id",
       "case_id",
       "physical_slide_id",
       "patient_id",
       "collection_id",
       "instance_id",
       "gcs_url",
       "width",
       "height",
       "pixel_spacing",
       "compression_type",
       "tissue_type",
       "cancer_subtype"
FROM   with_compression
WHERE  "compression_type" IN ('jpeg','jpeg2000')
ORDER  BY "instance_id" ASC;
```
