```sql
WITH eligible_instances AS (
    SELECT
        da."UID"                                                   AS "digital_slide_id",          -- DICOM SOPInstanceUID
        da."StudyInstanceUID"                                      AS "case_id",
        TRY_PARSE_JSON(spec.value):"SpecimenIdentifier"::STRING    AS "physical_slide_id",
        da."PatientID"                                             AS "patient_id",
        da."collection_id"                                         AS "collection_id",
        dp."crdc_instance_uuid"                                    AS "instance_id",
        dp."gcs_url"                                               AS "gcs_url",
        da."Columns"                                               AS "width",
        da."Rows"                                                  AS "height",
        da."PixelSpacing"                                          AS "pixel_spacing",
        /* map transfer-syntax to the three compression buckets                                    */
        CASE 
            WHEN dm."TransferSyntaxUID" IN (
                 '1.2.840.10008.1.2.4.50',   -- JPEG Baseline
                 '1.2.840.10008.1.2.4.51',   -- JPEG Extended
                 '1.2.840.10008.1.2.4.57',   -- JPEG Lossless
                 '1.2.840.10008.1.2.4.70'    -- JPEG Lossless, SV1
            ) THEN 'jpeg'
            WHEN dm."TransferSyntaxUID" IN (
                 '1.2.840.10008.1.2.4.90',   -- JPEG2000 lossless
                 '1.2.840.10008.1.2.4.91'    -- JPEG2000 lossy
            ) THEN 'jpeg2000'
            ELSE 'other'
        END                                                     AS "compression_type",
        /* derive tissue label from SNOMED codes inside the specimen JSON                           */
        CASE 
            WHEN spec.value::STRING ILIKE '%86049000%'  THEN 'tumor'
            WHEN spec.value::STRING ILIKE '%17621005%'  THEN 'normal'
        END                                                     AS "tissue_type",
        /* derive cancer subtype directly from collection id                                        */
        CASE 
            WHEN da."collection_id" = 'tcga_luad' THEN 'luad'
            WHEN da."collection_id" = 'tcga_lusc' THEN 'lscc'
        END                                                     AS "cancer_subtype"
    FROM  IDC.IDC_V17.DICOM_ALL     AS da
    /*–– obtain transfer-syntax to classify compression ––*/
    JOIN  IDC.IDC_V17.DICOM_METADATA AS dm
          ON dm."SOPInstanceUID" = da."UID"
    /*–– bring in per-instance GCS URL and UUID ––*/
    JOIN  IDC.IDC_V17.DICOM_PIVOT    AS dp
          ON  dp."PatientID"                   = da."PatientID"
          AND dp."max_TotalPixelMatrixColumns" = da."Columns"
          AND dp."max_TotalPixelMatrixRows"    = da."Rows"
          AND dp."Modality"                    = 'SM'
          AND dp."ImageType" ILIKE '%VOLUME%'
          AND dp."collection_id" IN ('tcga_luad','tcga_lusc')
    ,    LATERAL FLATTEN( INPUT => da."SpecimenDescriptionSequence" ) AS spec
    /*–– keep only slides prepared with Tissue freezing medium
          and containing the desired SNOMED tissue codes ––*/
    WHERE spec.value::STRING ILIKE '%tissue%freezing%medium%'
      AND ( spec.value::STRING ILIKE '%86049000%'  -- tumor
            OR spec.value::STRING ILIKE '%17621005%' )  -- normal
      /* exclude any compression outside JPEG / JPEG2000                                            */
      AND
      CASE 
          WHEN dm."TransferSyntaxUID" IN (
               '1.2.840.10008.1.2.4.50',
               '1.2.840.10008.1.2.4.51',
               '1.2.840.10008.1.2.4.57',
               '1.2.840.10008.1.2.4.70') THEN 'jpeg'
          WHEN dm."TransferSyntaxUID" IN (
               '1.2.840.10008.1.2.4.90',
               '1.2.840.10008.1.2.4.91') THEN 'jpeg2000'
          ELSE 'other'
      END <> 'other'
)
SELECT DISTINCT *
FROM   eligible_instances
ORDER  BY "instance_id" ASC;
```
