SELECT
       "PatientID",
       "collection_id",
       "crdc_instance_uuid" AS "instance_id",
       "gcs_url",
       "ImageType"
FROM   IDC.IDC_V17.DICOM_PIVOT
WHERE  "Modality"      = 'SM'
  AND  "collection_id" IN ('tcga_luad', 'tcga_lusc')
LIMIT 20;
