```sql
--Description: 8. Look for SNOMED codes 17621005 (normal) or 86049000 (tumor) in the specimen JSON
SELECT  
       DISTINCT a."PatientID",
       f.value::STRING AS "specimen_json"
FROM   IDC.IDC_V17.DICOM_ALL AS a,
