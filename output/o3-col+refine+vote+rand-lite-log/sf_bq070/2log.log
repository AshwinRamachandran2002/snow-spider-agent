    that
       • are JPEG/JPEG-2000 compressed,
       • were embedded in “Tissue freezing medium”,
       • contain only normal- or tumour-labelled tissue                       */

WITH frozen_specimens AS (                     /* 1. slides with desired specimen attributes */
    SELECT DISTINCT
           da."UID"                                              AS "digital_slide_id",
           da."StudyInstanceUID"                                 AS "case_id",
           TRY_PARSE_JSON(sf.value):"SpecimenIdentifier"::STRING AS "physical_slide_id",
           da."PatientID"                                        AS "patient_id",
           da."collection_id",
           da."Columns"                                          AS "width",
           da."Rows"                                             AS "height",
           da."PixelSpacing"                                     AS "pixel_spacing",
           CASE
               WHEN sf.value::STRING ILIKE '%86049000%'  THEN 'tumor'
               WHEN sf.value::STRING ILIKE '%17621005%'  THEN 'normal'
           END                                                   AS "tissue_type"
    FROM   IDC.IDC_V17.DICOM_ALL  da,
           LATERAL FLATTEN(INPUT => da."SpecimenDescriptionSequence") sf
    WHERE  sf.value::STRING ILIKE '%tissue freezing medium%'
       AND ( sf.value::STRING ILIKE '%86049000%'              -- tumour code
          OR  sf.value::STRING ILIKE '%17621005%' )           -- normal code
),
candidate_instances AS (                   /* 2. keep SM VOLUME instances in LUAD/LUSC  */
    SELECT DISTINCT
           fs.*,
           dp."crdc_instance_uuid"                          AS "instance_id",
           dp."gcs_url"
    FROM   frozen_specimens          fs
    JOIN   IDC.IDC_V17.DICOM_PIVOT   dp
           ON  dp."PatientID"      = fs."patient_id"
           AND dp."collection_id"  = fs."collection_id"
           AND dp."Modality"       = 'SM'
           AND dp."ImageType"      ILIKE '%VOLUME%'
           AND dp."collection_id" IN ('tcga_luad','tcga_lusc')
),
with_compression AS (                     /* 3. classify compression and filter          */
    SELECT
           ci.*,
           CASE
               WHEN dm."TransferSyntaxUID" IN (                 -- JPEG family
                        '1.2.840.10008.1.2.4.50',
                        '1.2.840.10008.1.2.4.51',
                        '1.2.840.10008.1.2.4.57',
                        '1.2.840.10008.1.2.4.70' ) THEN 'jpeg'
               WHEN dm."TransferSyntaxUID" IN (                 -- JPEG-2000 family
                        '1.2.840.10008.1.2.4.90',
                        '1.2.840.10008.1.2.4.91' ) THEN 'jpeg2000'
               ELSE                                              'other'
           END                                                 AS "compression_type"
    FROM   candidate_instances       ci
    JOIN   IDC.IDC_V17.DICOM_METADATA dm
           ON dm."SOPInstanceUID" = ci."digital_slide_id"
)
SELECT DISTINCT
       "digital_slide_id",
       "case_id",
       "physical_slide_id",
       "patient_id",
       "collection_id",
