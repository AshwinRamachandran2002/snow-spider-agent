       CASE                                            -- derive cancer subtype
           WHEN "collection_id" = 'tcga_luad' THEN 'luad'
           WHEN "collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                            AS "cancer_subtype"
FROM   with_compression
WHERE  "compression_type" IN ('jpeg','jpeg2000')
