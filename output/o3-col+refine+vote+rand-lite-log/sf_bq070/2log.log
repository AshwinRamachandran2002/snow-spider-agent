--Description:  Baseline sanity-check: confirm that Slide-Microscopy (SM) instances from
--              TCGA-LUAD / TCGA-LUSC present in the compact DICOM_PIVOT table
--              actually have matching records in the detailed DICOM_ALL table.
--              We therefore:
--                1) join PIVOT to ALL on the instance UUID,
--                2) keep ONLY the minimal constraints (Modality = 'SM' and collection_id in
--                   {'tcga_luad','tcga_lusc'}),
--                3) return a few core attributes—ImageType, dimensions, and CompressionCode—
--                   to observe real values that will guide later, more precise filters.
--              If this query returns rows, the join is correct; we can then refine criteria
--              (embedding medium wording, SNOMED codes, compression type, etc.) with confidence.
--              LIMIT 20 keeps the exploratory output small.

SELECT
       p."crdc_instance_uuid"  AS "instance_id",
       p."PatientID"           AS "patient_id",
       p."collection_id",
       p."ImageType",
       a."Rows"                AS "height",
       a."Columns"             AS "width",
       a."CompressionCode"
FROM   IDC.IDC_V17.DICOM_PIVOT  AS p
JOIN   IDC.IDC_V17.DICOM_ALL    AS a
  ON   p."crdc_instance_uuid" = a."UID"
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
LIMIT 20;
