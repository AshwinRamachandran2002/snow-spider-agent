--                • derive the tissue_type from SNOMED codes 17621005 (normal) or 86049000 (tumor),
--                • derive the cancer_subtype from the collection_id.
--              By omitting the VOLUME and CompressionCode constraints we can confirm whether qualifying
--              instances exist at all.  LIMIT 20 keeps the result manageable.

SELECT
       p."crdc_instance_uuid"          AS "instance_id",
       p."PatientID"                   AS "patient_id",
       p."collection_id",
       a."Rows"                        AS "height",
       a."Columns"                     AS "width",
       a."PixelSpacing",
       a."CompressionCode",
       CASE
            WHEN f.value::STRING ILIKE '%17621005%' THEN 'normal'
            WHEN f.value::STRING ILIKE '%86049000%' THEN 'tumor'
       END                             AS "tissue_type",
       CASE
            WHEN p."collection_id" = 'tcga_luad' THEN 'luad'
            WHEN p."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                             AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_PIVOT AS p
JOIN   IDC.IDC_V17.DICOM_ALL   AS a
  ON   p."crdc_instance_uuid" = a."UID"
JOIN   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND  f.value::STRING ILIKE '%tissue%freezing%medium%'
  AND (f.value::STRING ILIKE '%17621005%' OR f.value::STRING ILIKE '%86049000%')
ORDER BY "instance_id"
LIMIT 20
