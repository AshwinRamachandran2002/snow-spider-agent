WHERE  f.value::STRING ILIKE '%17621005%'
   OR  f.value::STRING ILIKE '%86049000%'
LIMIT 20;
```

```sql
--Description: 9. Combine DICOM_PIVOT and DICOM_ALL to assemble slide–level metadata for TCGA-LUAD/LUSC SM VOLUME images
SELECT 
       p."PatientID",
       p."collection_id",
       a."instance_hash"              AS "instance_id",
       p."gcs_url",
       a."Rows"                       AS "height",
       a."Columns"                    AS "width",
       a."PixelSpacing",
       a."CompressionCode",
       p."ImageType"
FROM   IDC.IDC_V17.DICOM_PIVOT AS p
JOIN   IDC.IDC_V17.DICOM_ALL   AS a
  ON   p."crdc_instance_uuid" = a."UID"
WHERE  p."Modality" = 'SM'
  AND  p."ImageType" ILIKE '%VOLUME%'
  AND  p."collection_id" IN ('tcga_luad','tcga_lusc')   -- adjust if actual IDs differ
  AND  a."CompressionCode" ILIKE '%jpeg%'
LIMIT 20;
```

```sql
--Description: 10. Prototype final extraction adding tissue_type/cancer_subtype determination filters
SELECT 
       p."crdc_instance_uuid"         AS "instance_id",
       p."PatientID"                  AS "patient_id",
       p."collection_id",
       a."Rows"                       AS "height",
       a."Columns"                    AS "width",
       a."PixelSpacing",
       a."CompressionCode",
       CASE 
            WHEN f.value::STRING ILIKE '%17621005%' THEN 'normal'
            WHEN f.value::STRING ILIKE '%86049000%' THEN 'tumor'
       END                            AS "tissue_type",
       CASE 
            WHEN p."collection_id" = 'tcga_luad' THEN 'luad'
            WHEN p."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                            AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_PIVOT AS p
JOIN   IDC.IDC_V17.DICOM_ALL   AS a
  ON   p."crdc_instance_uuid" = a."UID"
JOIN   LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality" = 'SM'
  AND  p."ImageType" ILIKE '%VOLUME%'
  AND  p."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  a."CompressionCode" ILIKE '%jpeg%'
  AND  f.value::STRING ILIKE '%tissue%freezing%medium%'
  AND (f.value::STRING ILIKE '%17621005%' OR f.value::STRING ILIKE '%86049000%')
ORDER BY "instance_id"
LIMIT 20;
```
