```sql
--Description: Earlier queries that required both the “Tissue freezing medium” phrase and the
--             SNOMED codes 17621005 / 86049000 returned no rows.  To discover whether the
--             tumor/normal SNOMED codes occur at all in TCGA-LUAD / TCGA-LUSC slide-microscopy
--             (SM) images, this diagnostic query:
--               • keeps the mandatory filters: Modality = ‘SM’ and collection_id ∈ {tcga_luad, tcga_lusc};
--               • flattens SpecimenDescriptionSequence for each instance;
--               • returns rows whose JSON contains either 17621005 (normal) or 86049000 (tumor);
--             The embedding-medium condition is dropped so we can first verify that these codes
--             are present.  Inspecting the resulting specimen_json will show the exact structure
--             and wording, guiding how to craft an accurate final filter.
--             LIMIT 20 keeps the output small for manual review.

SELECT
       p."crdc_instance_uuid" AS "instance_id",
       p."PatientID"          AS "patient_id",
       p."collection_id",
       f.value::STRING        AS "specimen_json"
FROM   IDC.IDC_V17.DICOM_PIVOT AS p
JOIN   IDC.IDC_V17.DICOM_ALL   AS a
  ON   p."crdc_instance_uuid" = a."UID",
     LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality"      = 'SM'
  AND  p."collection_id" IN ('tcga_luad', 'tcga_lusc')
  AND (f.value::STRING ILIKE '%17621005%' OR f.value::STRING ILIKE '%86049000%')
LIMIT 20;
