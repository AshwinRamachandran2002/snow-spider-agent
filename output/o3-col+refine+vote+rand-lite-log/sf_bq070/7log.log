FROM IDC.IDC_V17.DICOM_ALL
WHERE "collection_id" ILIKE '%tcga_lu%'
  AND "Type" = 'SM'
  AND "ImageType" ILIKE '%VOLUME%'
LIMIT 20;
```

```sql
