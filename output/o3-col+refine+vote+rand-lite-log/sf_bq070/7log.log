```sql
/*  ---------------------------------------------------------------------------
    Return SM-type slide microscopy “VOLUME” images from TCGA-LUAD/LUSC that
    – are JPEG/JPEG-2000 compressed,
    – have “Tissue freezing medium” as embedding medium,
    – describe either normal (17621005) or tumour (86049000) tissue.
    Required columns and labels are produced and rows are sorted
    by the DICOM instance UID (instance_id) in ascending order.
    --------------------------------------------------------------------------- */
WITH filtered_instances AS (           -- basic modality & compression filters
    SELECT
        da."UID"                                    AS instance_id,             -- DICOM instance UID
        da."idc_case_id"                            AS case_id,
        da."PatientID"                              AS patient_id,
        da."collection_id",
        dm."Rows"                                   AS height,
        dm."Columns"                                AS width,
        dm."PixelSpacing"                           AS pixel_spacing,
        dm."TransferSyntaxUID",                                             -- used to derive compression type
        da."SpecimenDescriptionSequence"            AS specimen_json
    FROM   IDC.IDC_V17.DICOM_ALL     da
    JOIN   IDC.IDC_V17.DICOM_METADATA dm
           ON dm."SOPInstanceUID" = da."UID"
    WHERE  da."collection_id" IN ('tcga_luad','tcga_lusc')        -- LUAD & LUSC only
      AND  UPPER(da."Type") = 'SM'                                -- slide microscopy images
      AND  da."ImageType" ILIKE '%VOLUME%'                        -- digital-slide images
      AND  dm."TransferSyntaxUID" IN (                            -- JPEG / JPEG-2000 UIDs
              '1.2.840.10008.1.2.4.50',  -- JPEG baseline
              '1.2.840.10008.1.2.4.51',  -- JPEG extended
              '1.2.840.10008.1.2.4.57',  -- JPEG lossless, non-hierarchical
              '1.2.840.10008.1.2.4.70',  -- JPEG lossless, hierarchical
              '1.2.840.10008.1.2.4.90',  -- JPEG-2000 lossless
              '1.2.840.10008.1.2.4.91'   -- JPEG-2000
           )
), with_embedding_medium AS (          -- keep only “Tissue freezing medium” slides
    SELECT  fi.*
    FROM    filtered_instances fi,
            LATERAL FLATTEN(INPUT => fi.specimen_json) s          -- one object per specimen
    WHERE   s.value::STRING ILIKE '%Tissue%freezing%medium%'
), with_tissue_code AS (               -- extract tissue-type code & specimen identifier
    SELECT DISTINCT
        wem.instance_id,
        wem.case_id,
        wem.patient_id,
        wem.collection_id,
        wem.height,
        wem.width,
        wem.pixel_spacing,
        wem."TransferSyntaxUID",
        wem.specimen_json,
        wem_spec.value:"SpecimenIdentifier"::STRING                    AS physical_slide_id,
        mod.value:"CodeValue"::STRING                                  AS code_val
    FROM   with_embedding_medium wem,
           LATERAL FLATTEN(INPUT => wem.specimen_json)                wem_spec,
           LATERAL FLATTEN(INPUT => wem_spec.value:"PrimaryAnatomicStructureSequence") pas,
           LATERAL FLATTEN(INPUT => pas.value:"PrimaryAnatomicStructureModifierSequence") mod
    WHERE  mod.value:"CodeValue"::STRING IN ('17621005','86049000')    -- normal / tumour
), labelled AS (                    -- final labelling & compression mapping
    SELECT
        instance_id,
        case_id,
        COALESCE(physical_slide_id,'')                       AS physical_slide_id,
        patient_id,
        collection_id,
        height,
        width,
        pixel_spacing,
        CASE
            WHEN "TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                         '1.2.840.10008.1.2.4.51',
                                         '1.2.840.10008.1.2.4.57',
                                         '1.2.840.10008.1.2.4.70') THEN 'jpeg'
            WHEN "TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                         '1.2.840.10008.1.2.4.91')      THEN 'jpeg2000'
            ELSE 'other'
        END                                                AS compression_type,
        CASE WHEN code_val = '17621005' THEN 'normal'
             ELSE                    'tumor'               END AS tissue_type,
        CASE WHEN collection_id = 'tcga_luad' THEN 'luad'
             ELSE                         'lscc'           END AS cancer_subtype
    FROM   with_tissue_code
)
SELECT
    ROW_NUMBER() OVER (ORDER BY instance_id)              AS digital_slide_id,
    case_id,
    physical_slide_id,
    patient_id,
    collection_id,
    instance_id,
    dp."gcs_url",             -- link to the actual DICOM object
    width,
    height,
    pixel_spacing,
    compression_type,
    tissue_type,
    cancer_subtype
FROM   labelled  l
LEFT   JOIN IDC.IDC_V17.DICOM_PIVOT dp
       ON  dp."PatientID"   = l.patient_id
       AND dp."collection_id" = l.collection_id
ORDER  BY instance_id ASC;
```
