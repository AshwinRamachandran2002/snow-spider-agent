/*-------------------------------------------------------------------------------
  SM slide-microscopy “VOLUME” images from TCGA-LUAD / TCGA-LUSC
  – JPEG / JPEG-2000 compressed
  – embedding medium = “Tissue freezing medium”
  – tissue code 17621005 (normal) or 86049000 (tumor)
  Returns requested metadata, labels and sorts by instance_id ASC
-------------------------------------------------------------------------------*/
WITH filtered_instances AS (          -- basic collection, modality & compression filter
    SELECT
        da."UID"                                   AS instance_id,
        da."idc_case_id"                           AS case_id,
        da."PatientID"                             AS patient_id,
        da."collection_id",                        -- quoted → lowercase column name
        dm."Rows"                                  AS height,
        dm."Columns"                               AS width,
        dm."PixelSpacing"                          AS pixel_spacing,
        dm."TransferSyntaxUID",
        da."SpecimenDescriptionSequence"           AS specimen_json
    FROM  IDC.IDC_V17.DICOM_ALL     da
    JOIN  IDC.IDC_V17.DICOM_METADATA dm
          ON dm."SOPInstanceUID" = da."UID"
    WHERE da."collection_id" IN ('tcga_luad','tcga_lusc')
      AND UPPER(da."Type") = 'SM'                              -- slide-microscopy
      AND da."ImageType"  ILIKE '%VOLUME%'                     -- digital-slide images
      AND dm."TransferSyntaxUID" IN (                          -- JPEG & JPEG-2000
             '1.2.840.10008.1.2.4.50','1.2.840.10008.1.2.4.51',
             '1.2.840.10008.1.2.4.57','1.2.840.10008.1.2.4.70',
             '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91')
), with_embedding_medium AS (         -- keep only “Tissue freezing medium”
    SELECT fi.*
    FROM   filtered_instances fi,
           LATERAL FLATTEN(INPUT => fi.specimen_json) f
    WHERE  f.value::STRING ILIKE '%Tissue%freezing%medium%'
), with_tissue_code AS (              -- extract tissue code & physical-slide id
    SELECT DISTINCT
        wem.instance_id,
        wem.case_id,
        wem.patient_id,
        wem."collection_id"                      AS collection_id,
        wem.height,
        wem.width,
        wem.pixel_spacing,
        wem."TransferSyntaxUID",
        wem.specimen_json,
        ws.value:"SpecimenIdentifier"::STRING    AS physical_slide_id,
        pm.value:"CodeValue"::STRING             AS code_val
    FROM   with_embedding_medium wem,
           LATERAL FLATTEN(INPUT => wem.specimen_json)                     ws,
           LATERAL FLATTEN(INPUT => ws.value:"PrimaryAnatomicStructureSequence") pas,
           LATERAL FLATTEN(INPUT => pas.value:"PrimaryAnatomicStructureModifierSequence") pm
    WHERE  pm.value:"CodeValue"::STRING IN ('17621005','86049000')
), labelled AS (                      -- add human-readable labels & compression type
    SELECT
        instance_id,
        case_id,
        COALESCE(physical_slide_id,'')                 AS physical_slide_id,
        patient_id,
        collection_id,
        height,
        width,
        pixel_spacing,
        CASE
            WHEN "TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.50',
                                         '1.2.840.10008.1.2.4.51',
                                         '1.2.840.10008.1.2.4.57',
                                         '1.2.840.10008.1.2.4.70')
                 THEN 'jpeg'
            WHEN "TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90',
                                         '1.2.840.10008.1.2.4.91')
                 THEN 'jpeg2000'
            ELSE 'other'
        END                                           AS compression_type,
        CASE WHEN code_val = '17621005' THEN 'normal'
             ELSE                      'tumor' END    AS tissue_type,
        CASE WHEN collection_id = 'tcga_luad' THEN 'luad'
             ELSE                               'lscc' END AS cancer_subtype
    FROM   with_tissue_code
)
SELECT
    ROW_NUMBER() OVER (ORDER BY instance_id)  AS digital_slide_id,
    case_id,
    physical_slide_id,
    patient_id,
    collection_id,
    instance_id,
    dp."gcs_url",
    width,
    height,
    pixel_spacing,
    compression_type,
    tissue_type,
    cancer_subtype
FROM   labelled l
LEFT   JOIN IDC.IDC_V17.DICOM_PIVOT dp
