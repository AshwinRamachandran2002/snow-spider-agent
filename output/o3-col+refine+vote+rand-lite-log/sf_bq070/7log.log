```sql
/*-----------------------------------------------------------------------------
  Digital slide-microscopy (“SM”) instances from the TCGA-LUAD and TCGA-LUSC
  collections that
      • are JPEG or JPEG-2000 compressed,
      • are digital-slide images (ImageType contains “VOLUME”),
      • were prepared with the embedding medium “Tissue freezing medium”,
      • describe either normal (SCT 17621005) or tumour (SCT 86049000) tissue.
  Returns requested slide-level metadata and labels, ordered by instance UID.
-----------------------------------------------------------------------------*/
WITH sm_volume AS (          /* 1. basic SM + VOLUME + collection filter        */
    SELECT
        da."UID"                  AS instance_id,
        da."idc_case_id"          AS case_id,
        da."PatientID"            AS patient_id,
        da."collection_id",
        da."SpecimenDescriptionSequence" AS spec_json,
        dm."Rows"                 AS height,
        dm."Columns"              AS width,
        dm."PixelSpacing"         AS pixel_spacing,
        dm."TransferSyntaxUID"    AS ts_uid
    FROM  IDC.IDC_V17.DICOM_ALL da
    JOIN  IDC.IDC_V17.DICOM_METADATA dm
          ON dm."SOPInstanceUID" = da."UID"
    WHERE da."collection_id" IN ('tcga_luad','tcga_lusc')
      AND UPPER(da."Type") = 'SM'
      AND da."ImageType" ILIKE '%VOLUME%'
), embedding_medium AS (      /* 2. keep only specimens mentioning freezing medium */
    SELECT sv.*
    FROM   sm_volume sv,
           LATERAL FLATTEN(INPUT => sv.spec_json) f
    WHERE  f.value::STRING ILIKE '%Tissue%freezing%medium%'
), tissue_code AS (           /* 3. extract tissue-type code + physical-slide id  */
    SELECT DISTINCT
        em.instance_id,
        em.case_id,
        em.patient_id,
        em.collection_id,
        em.height,
        em.width,
        em.pixel_spacing,
        em.ts_uid,
        s.value:"SpecimenIdentifier"::STRING         AS physical_slide_id,
        m.value:"CodeValue"::STRING                  AS code_val
    FROM   embedding_medium em,
           LATERAL FLATTEN(INPUT => em.spec_json)                    s,
           LATERAL FLATTEN(INPUT => s.value:"PrimaryAnatomicStructureSequence")  a,
           LATERAL FLATTEN(INPUT => a.value:"PrimaryAnatomicStructureModifierSequence") m
    WHERE  m.value:"CodeValue"::STRING IN ('17621005','86049000')
), labelled AS (              /* 4. derive human-readable fields & compression   */
    SELECT
        instance_id,
        case_id,
        COALESCE(physical_slide_id,'')              AS physical_slide_id,
        patient_id,
        collection_id,
        height,
        width,
        pixel_spacing,
        CASE
            WHEN ts_uid IN ('1.2.840.10008.1.2.4.50','1.2.840.10008.1.2.4.51',
                            '1.2.840.10008.1.2.4.57','1.2.840.10008.1.2.4.70') THEN 'jpeg'
            WHEN ts_uid IN ('1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91') THEN 'jpeg2000'
            ELSE 'other'
        END                                         AS compression_type,
        CASE WHEN code_val = '17621005' THEN 'normal' ELSE 'tumor'  END  AS tissue_type,
        CASE WHEN collection_id = 'tcga_luad' THEN 'luad' ELSE 'lscc' END AS cancer_subtype
    FROM tissue_code
    WHERE ts_uid IN ('1.2.840.10008.1.2.4.50','1.2.840.10008.1.2.4.51',
                     '1.2.840.10008.1.2.4.57','1.2.840.10008.1.2.4.70',
                     '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91')
), gcs_lookup AS (           /* 5. one representative gcs_url per instance UID   */
    SELECT
        "crdc_instance_uuid"   AS instance_id,
        "gcs_url"
    FROM  IDC.IDC_V17.DICOM_PIVOT
)
SELECT
    ROW_NUMBER() OVER (ORDER BY l.instance_id)   AS digital_slide_id,
    l.case_id,
    l.physical_slide_id,
    l.patient_id,
    l.collection_id,
    l.instance_id,
    g.gcs_url,
    l.width,
    l.height,
    l.pixel_spacing,
    l.compression_type,
    l.tissue_type,
    l.cancer_subtype
FROM labelled l
LEFT JOIN gcs_lookup g
       ON g.instance_id = l.instance_id
ORDER BY l.instance_id ASC;
