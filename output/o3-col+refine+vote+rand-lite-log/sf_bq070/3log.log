```sql
--Description: Join “dicom_all” with “dicom_pivot” to preview SM-modality, VOLUME-type candidate instances.
SELECT
       a."UID"               AS "instance_id",
       a."PatientID",
       a."collection_id",
       p."gcs_url",
       a."Rows"              AS "height",
       a."Columns"           AS "width",
       a."PixelSpacing"
FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
         ON a."UID" = p."crdc_instance_uuid"
WHERE  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  p."Modality" = 'SM'
  AND  a."ImageType" ILIKE '%VOLUME%'
LIMIT  20;
```

```sql
--Description: Display raw “SpecimenDescriptionSequence” JSON for TCGA-LUAD slides to locate embedding-medium information.
SELECT
       a."UID",
       a."SpecimenDescriptionSequence"
FROM   IDC.IDC_V17.DICOM_ALL a
WHERE  a."collection_id" = 'tcga_luad'
  AND  a."ImageType" ILIKE '%VOLUME%'
LIMIT  20;
```

```sql
--Description: Flatten the SpecimenDescriptionSequence and look for any records mentioning “Tissue freezing medium”.
SELECT
       a."UID",
       f.VALUE::VARIANT AS "specimen_block"
FROM   IDC.IDC_V17.DICOM_ALL a,
       LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  a."ImageType" ILIKE '%VOLUME%'
  AND  LOWER(f.VALUE::STRING) LIKE '%tissue%freezing%medium%'
LIMIT  20;
```

```sql
--Description: Assemble all requested metadata for SM digital slides that satisfy every study criterion.
SELECT
       a."UID"                                  AS "instance_id",
       a."idc_case_id"                          AS "case_id",
       COALESCE(spb.VALUE:"SlideIdentifier"::STRING,'')  AS "physical_slide_id",
       a."PatientID"                            AS "patient_id",
       a."collection_id",
       p."gcs_url",
       a."Columns"                              AS "width",
       a."Rows"                                 AS "height",
       a."PixelSpacing",
       CASE
           WHEN a."CompressionCode" ILIKE '%jpeg2000%' THEN 'jpeg2000'
           WHEN a."CompressionCode" ILIKE '%jpeg%'     THEN 'jpeg'
           ELSE 'other'
       END                                       AS "compression_type",
       CASE
           WHEN seg.VALUE::STRING ILIKE '%17621005%'  THEN 'normal'
           WHEN seg.VALUE::STRING ILIKE '%86049000%'  THEN 'tumor'
       END                                       AS "tissue_type",
       CASE
           WHEN a."collection_id" = 'tcga_luad' THEN 'luad'
           WHEN a."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                       AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
         ON a."UID" = p."crdc_instance_uuid"
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") spb
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") seg
WHERE  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  p."Modality" = 'SM'
  AND  a."ImageType" ILIKE '%VOLUME%'
  AND  LOWER(spb.VALUE::STRING) LIKE '%tissue%freezing%medium%'
  AND (seg.VALUE::STRING ILIKE '%17621005%' OR seg.VALUE::STRING ILIKE '%86049000%')
  AND  a."CompressionCode" ILIKE '%jpeg%'
ORDER BY "instance_id"
LIMIT  20;
```
