```sql
WITH sm_candidates AS (  -- 1) SM modality, VOLUME images, LUAD/LUSC only
    SELECT
        a."UID",                          -- instance UID
        a."InstanceNumber",
        a."idc_case_id",
        a."PatientID",
        a."collection_id",
        a."Rows",
        a."Columns",
        a."PixelSpacing",
        a."CompressionCode",
        a."SpecimenDescriptionSequence",
        p."gcs_url"
    FROM IDC.IDC_V17.DICOM_ALL  AS a
    JOIN IDC.IDC_V17.DICOM_PIVOT AS p
          ON p."crdc_instance_uuid" = a."UID"
    WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
      AND p."Modality" = 'SM'
      AND a."ImageType" ILIKE '%VOLUME%'
),
specimen_flat AS (        -- 2) explode SpecimenDescriptionSequence
    SELECT
        c.*,
        f.value::VARIANT  AS specimen_block
    FROM sm_candidates c,
         LATERAL FLATTEN(input => c."SpecimenDescriptionSequence") f
),
tissue_info AS (          -- 3) pull embedding medium + tissue-type codes
    SELECT
        s.*,
        emb.value::STRING                                AS embedding_medium,
        mod.value:"CodeValue"::STRING                    AS tissue_code,
        s.specimen_block:"SpecimenIdentifier"::STRING    AS physical_slide_id
    FROM specimen_flat      AS s
         , LATERAL FLATTEN(input => s.specimen_block:"SpecimenPreparationSequence") emb_step
         , LATERAL FLATTEN(input => emb_step.value:"EmbeddingMedia")                emb
         , LATERAL FLATTEN(input => s.specimen_block:"PrimaryAnatomicStructureSequence") pas
         , LATERAL FLATTEN(input => pas.value:"PrimaryAnatomicStructureModifierSequence") mod
)
SELECT
    TRY_TO_NUMBER("InstanceNumber")                       AS "digital_slide_id",
    "idc_case_id"                                         AS "case_id",
    "physical_slide_id"                                   AS "physical_slide_id",
    "PatientID"                                           AS "patient_id",
    "collection_id"                                       AS "collection_id",
    "UID"                                                 AS "instance_id",
    "gcs_url"                                             AS "gcs_url",
    "Columns"                                             AS "width",
    "Rows"                                                AS "height",
    "PixelSpacing"                                        AS "pixel_spacing",
    CASE
        WHEN LOWER("CompressionCode") LIKE '%jpeg2000%' OR LOWER("CompressionCode") LIKE '%j2k%' THEN 'jpeg2000'
        WHEN LOWER("CompressionCode") LIKE '%jpeg%'                                            THEN 'jpeg'
        ELSE 'other'
    END                                                   AS "compression_type",
    CASE tissue_code
        WHEN '17621005' THEN 'normal'
        WHEN '86049000' THEN 'tumor'
    END                                                   AS "tissue_type",
    CASE "collection_id"
        WHEN 'tcga_luad' THEN 'luad'
        WHEN 'tcga_lusc' THEN 'lscc'
    END                                                   AS "cancer_subtype"
FROM tissue_info
WHERE LOWER(embedding_medium) LIKE '%tissue%freezing%medium%'          -- Tissue freezing medium only
  AND tissue_code IN ('17621005','86049000')                           -- normal or tumor
  AND (LOWER("CompressionCode") LIKE '%jpeg%'
       OR LOWER("CompressionCode") LIKE '%j2k%'
       OR LOWER("CompressionCode") LIKE '%jpeg2000%')                 -- exclude “other”
ORDER BY "UID" ASC;
```
