    END                                      AS "tissue_type",
    CASE "collection_id"
        WHEN 'tcga_luad' THEN 'luad'
        WHEN 'tcga_lusc' THEN 'lscc'
    END                                      AS "cancer_subtype"
FROM   classified
WHERE  LOWER(prep_step_text) LIKE '%tissue%freezing%medium%'      -- required embedding medium
  AND  tissue_code IN ('17621005','86049000')                     -- normal / tumor
  AND  compression_type IN ('jpeg','jpeg2000')                    -- exclude “other”
ORDER BY "UID" ASC;
