/*  -------------------------------------------------------------------------
    TCGA-LUAD / TCGA-LUSC slide-microscopy (SM) images that
      • are tagged as VOLUME,
      • use JPEG or JPEG-2000 transfer syntaxes,
      • originate from specimens embedded in “Tissue freezing medium”,
      • are annotated as either normal (17621005) or tumor (86049000).
    ------------------------------------------------------------------------- */
WITH sm_candidates AS (         -- LUAD/LUSC, SM modality, VOLUME images
    SELECT
        a."UID",                               -- instance (DICOM) UID
        a."InstanceNumber",
        a."idc_case_id",
        a."PatientID",
        a."collection_id",
        a."Rows",
        a."Columns",
        a."PixelSpacing",
        a."SpecimenDescriptionSequence",
        p."gcs_url",
        p."ImageType"              AS "pivot_ImageType",
        m."TransferSyntaxUID"
    FROM  IDC.IDC_V17.DICOM_ALL      AS a
    JOIN  IDC.IDC_V17.DICOM_PIVOT    AS p
           ON p."crdc_instance_uuid" = a."UID"
    JOIN  IDC.IDC_V17.DICOM_METADATA AS m
           ON m."SOPInstanceUID"     = a."UID"
    WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
      AND p."Modality"      =  'SM'
      AND p."ImageType" ILIKE '%VOLUME%'              -- digital (volume) slides
),
specimen_flat AS (               -- explode SpecimenDescriptionSequence
    SELECT
        c.*,
        f.value::VARIANT  AS specimen_block
    FROM sm_candidates c,
         LATERAL FLATTEN(input => c."SpecimenDescriptionSequence") f
),
tissue_info AS (                 -- pull preparation text, tissue code, slide id
    SELECT
        s.*,
        prep_step.value::STRING                       AS prep_step_text,
        mod.value:"CodeValue"::STRING                 AS tissue_code,
        s.specimen_block:"SpecimenIdentifier"::STRING AS physical_slide_id
    FROM specimen_flat  AS s
         , LATERAL FLATTEN(input => s.specimen_block:"SpecimenPreparationSequence") prep_step
         , LATERAL FLATTEN(input => s.specimen_block:"PrimaryAnatomicStructureSequence") pas
         , LATERAL FLATTEN(input => pas.value:"PrimaryAnatomicStructureModifierSequence") mod
),
classified AS (                -- derive compression type from transfer syntax
    SELECT
        *,
        CASE
            WHEN "TransferSyntaxUID" IN ('1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91')
                 THEN 'jpeg2000'
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.5%'  -- JPEG baseline & lossless variants
                 THEN 'jpeg'
            ELSE 'other'
        END AS compression_type
    FROM tissue_info
)
SELECT
    TRY_TO_NUMBER("InstanceNumber")          AS "digital_slide_id",
    "idc_case_id"                            AS "case_id",
    physical_slide_id                        AS "physical_slide_id",
    "PatientID"                              AS "patient_id",
