```sql
--Description: Assemble the requested metadata for SM-modality instances that meet
--all study criteria, but relax the former VOLUME constraint (which eliminated all
--rows) while still enforcing the embedding-medium, compression, and tissue/tumor
--code requirements.
SELECT
       a."UID"                                 AS "instance_id",
       a."idc_case_id"                         AS "case_id",
       COALESCE(spb.VALUE:"SlideIdentifier"::STRING,'') AS "physical_slide_id",
       a."PatientID"                           AS "patient_id",
       a."collection_id",
       p."gcs_url",
       a."Columns"                             AS "width",
       a."Rows"                                AS "height",
       a."PixelSpacing",
       CASE
           WHEN a."CompressionCode" ILIKE '%jpeg2000%' THEN 'jpeg2000'
           WHEN a."CompressionCode" ILIKE '%jpeg%'     THEN 'jpeg'
           ELSE 'other'
       END                                      AS "compression_type",
       CASE
           WHEN seg.VALUE::STRING ILIKE '%17621005%'  THEN 'normal'
           WHEN seg.VALUE::STRING ILIKE '%86049000%'  THEN 'tumor'
       END                                      AS "tissue_type",
       CASE
           WHEN a."collection_id" = 'tcga_luad'  THEN 'luad'
           WHEN a."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                      AS "cancer_subtype"
FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
         ON a."UID" = p."crdc_instance_uuid"
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") spb
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") seg
WHERE  p."Modality" = 'SM'
  AND  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  LOWER(spb.VALUE::STRING) LIKE '%tissue%freezing%medium%'
  AND (seg.VALUE::STRING ILIKE '%17621005%' OR seg.VALUE::STRING ILIKE '%86049000%')
  AND  a."CompressionCode" ILIKE '%jpeg%'
ORDER BY "instance_id"
LIMIT  20;
```
