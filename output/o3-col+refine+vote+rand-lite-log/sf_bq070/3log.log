FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
         ON a."UID" = p."crdc_instance_uuid"
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") spb
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") seg
WHERE  p."Modality" = 'SM'
  AND  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  LOWER(spb.VALUE::STRING) LIKE '%tissue%freezing%medium%'
  AND (seg.VALUE::STRING ILIKE '%17621005%' OR seg.VALUE::STRING ILIKE '%86049000%')
  AND  a."CompressionCode" ILIKE '%jpeg%'
ORDER BY "instance_id"
LIMIT  20
