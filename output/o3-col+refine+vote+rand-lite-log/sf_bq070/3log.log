```sql
--Description:
--Determine whether *any* slide-microscopy (SM) instances in the TCGA-LUAD / TCGA-LUSC
--collections include the key phrase “Tissue freezing medium” somewhere inside the
--entire serialized SpecimenDescriptionSequence JSON.  All other constraints from the
--previous (empty) query—compression type, tissue codes, etc.—are removed so we can
--simply confirm that such rows exist.  If this returns data, we can then re-introduce
--incremental filters (compression, tissue code, etc.) in subsequent steps.
SELECT
       a."UID"                         AS "instance_id",
       a."PatientID",
       a."collection_id",
       p."gcs_url",
       a."CompressionCode",
       a."Rows"                        AS "height",
       a."Columns"                     AS "width",
       a."SpecimenDescriptionSequence"
FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
         ON a."UID" = p."crdc_instance_uuid"
WHERE  p."Modality" = 'SM'
  AND  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  a."SpecimenDescriptionSequence" ILIKE '%tissue%freezing%medium%'
LIMIT  20;
