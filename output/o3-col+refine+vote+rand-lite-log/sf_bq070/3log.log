Query:
--Description: Flatten the SpecimenDescriptionSequence for LUAD/LUSC cases and
--look for any element that mentions “Tissue freezing medium”, again without the
--prior VOLUME filter so we do not miss potential matches.
SELECT
       a."UID",
       f.VALUE::VARIANT AS "specimen_block"
FROM   IDC.IDC_V17.DICOM_ALL a,
       LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  LOWER(f.VALUE::STRING) LIKE '%tissue%freezing%medium%'
LIMIT  20
