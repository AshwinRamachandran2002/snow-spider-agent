```sql
--Description:
--Find slide-microscopy (SM) instances from the TCGA-LUAD and TCGA-LUSC
--collections whose SpecimenDescriptionSequence (first-level JSON elements)
--mentions the phrase “Tissue freezing medium”.  All other constraints
--(compression type, tissue/tumor codes, etc.) are removed so we can first
--confirm that such rows exist.
SELECT
       a."UID"                 AS "instance_id",
       a."PatientID",
       a."collection_id",
       p."gcs_url",
       a."CompressionCode",
       a."Rows"                AS "height",
       a."Columns"             AS "width",
       f.VALUE::STRING         AS "specimen_element"
FROM   IDC.IDC_V17.DICOM_ALL   a
JOIN   IDC.IDC_V17.DICOM_PIVOT p
         ON a."UID" = p."crdc_instance_uuid"
,      LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f
WHERE  p."Modality" = 'SM'
  AND  a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND  LOWER(f.VALUE::STRING) LIKE '%tissue%freezing%medium%'
LIMIT  20;
```
