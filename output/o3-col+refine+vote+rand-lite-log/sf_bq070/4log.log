/*--------------------------------------------------------------
  TCGA-LUAD & TCGA-LUSC slide-microscopy “VOLUME” images
  – JPEG or JPEG2000 compression
  – Embedding medium  contains “Tissue freezing medium”
  – Tissue coded as normal (17621005) or tumor (86049000)
----------------------------------------------------------------*/
WITH sm_src AS (      -- 1) find candidate instances
    SELECT
        a."UID"                          AS instance_id,          -- DICOM instance UUID
        a."SeriesInstanceUID"            AS digital_slide_id,     -- treat series as the digital slide
        a."StudyInstanceUID"             AS case_id,
        a."PatientID"                    AS patient_id,
        a."collection_id"                AS collection_id,
        a."Rows"                         AS height_px,
        a."Columns"                      AS width_px,
        a."PixelSpacing"                 AS pixel_spacing_var,
        COALESCE(p."gcs_url", '')        AS gcs_url,
        m."TransferSyntaxUID",
        sd.value:"SpecimenIdentifier"::STRING  AS physical_slide_id,
        sd.value::STRING                 AS sd_json               -- whole specimen-description JSON
    FROM IDC.IDC_V17."DICOM_ALL"      a
    JOIN IDC.IDC_V17."DICOM_METADATA" m
         ON m."UID" = a."UID"
    LEFT JOIN IDC.IDC_V17."DICOM_PIVOT" p
         ON p."crdc_instance_uuid" = a."UID"
    ,    LATERAL FLATTEN(input => a."ImageType")                        it      -- look for VOLUME
    ,    LATERAL FLATTEN(input => a."SpecimenDescriptionSequence")      sd      -- specimen data
    WHERE a."collection_name" IN ('TCGA-LUAD','TCGA-LUSC')
      AND it.value::STRING ILIKE '%VOLUME%'                                   -- digital slide images
      AND sd.value:"EmbeddingMedium"::STRING ILIKE '%Tissue freezing medium%' -- embedding method
      AND ( sd.value::STRING ILIKE '%"CodeValue":"86049000"%'                 -- tumor
         OR  sd.value::STRING ILIKE '%"CodeValue":"17621005"%' )              -- normal
)
, sm_clean AS (       -- 2) derive compression + labels
    SELECT DISTINCT
        digital_slide_id,
        case_id,
        physical_slide_id,
        patient_id,
        collection_id,
        instance_id,
        gcs_url,
        width_px,
        height_px,
        pixel_spacing_var::STRING                            AS pixel_spacing,
        CASE
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.9%' THEN 'jpeg2000'
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.5%' THEN 'jpeg'
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.7%' THEN 'jpeg'
            ELSE 'other'
        END                                                 AS compression_type,
        CASE
            WHEN sd_json ILIKE '%"CodeValue":"86049000"%' THEN 'tumor'
            ELSE                                             'normal'
        END                                                 AS tissue_type,
        CASE
            WHEN collection_id = 'tcga_luad' THEN 'luad'
            ELSE                              'lscc'
        END                                                 AS cancer_subtype
    FROM sm_src
)
SELECT
    digital_slide_id,          -- digital slide (SeriesInstanceUID)
    case_id,                   -- study / case ID
    physical_slide_id,         -- physical slide identifier
    patient_id,
    collection_id,
    instance_id,
    gcs_url,
    width_px   AS width,
    height_px  AS height,
    pixel_spacing,
    compression_type,
    tissue_type,
    cancer_subtype
FROM sm_clean
WHERE compression_type IN ('jpeg','jpeg2000')   -- exclude “other”
ORDER BY instance_id ASC;
```
