Query:
--Description: 9) Display a sample of slide-microscopy (SM) instances whose
--             ImageType includes the token “VOLUME” for TCGA-LUAD / TCGA-LUSC,
--             together with their GCS URL, dimensions, and pixel spacing.
--             (Uses a LEFT JOIN to DICOM_PIVOT because the UUID key may not
--             always have a matching row.)
SELECT
       a."UID"                            AS "instance_id",
       p."gcs_url",
       a."Rows"                           AS "height_px",
       a."Columns"                        AS "width_px",
       a."PixelSpacing"                   AS "pixel_spacing",
       a."collection_name",
       a."PatientID",
       a."StudyInstanceUID",
       a."SeriesInstanceUID"
FROM   IDC.IDC_V17."DICOM_ALL"  a
LEFT  JOIN IDC.IDC_V17."DICOM_PIVOT" p
       ON p."crdc_instance_uuid" = a."UID"
     , LATERAL FLATTEN(input => a."ImageType") it
WHERE  a."collection_name" IN ('TCGA-LUAD','TCGA-LUSC')
  AND  it.value::STRING ILIKE '%VOLUME%'
LIMIT  20
