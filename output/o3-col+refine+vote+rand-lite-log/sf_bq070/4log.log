WITH sm_src AS (           -- --- 1)  Filter only SM “VOLUME” instances from the two collections
    SELECT
        a."UID"                                   AS instance_id,        -- DICOM instance UUID
        a."SeriesInstanceUID"                     AS digital_slide_id,   -- treat series as the digital slide
        a."StudyInstanceUID"                      AS case_id,
        a."PatientID"                             AS patient_id,
        a."collection_id",
        a."collection_name",
        a."Rows"                                  AS height_px,
        a."Columns"                               AS width_px,
        a."PixelSpacing"                          AS pixel_spacing_var,  -- VARIANT, stringify later
        p."gcs_url",
        m."TransferSyntaxUID",
        sd.value:"SpecimenIdentifier"::STRING     AS physical_slide_id,
        mod.value:"CodeValue"::STRING             AS tissue_code        -- 17621005 = normal, 86049000 = tumor
    FROM IDC.IDC_V17."DICOM_ALL"  a
    JOIN IDC.IDC_V17."DICOM_METADATA" m
         ON m."UID" = a."UID"
    JOIN IDC.IDC_V17."DICOM_PIVOT"    p
         ON p."crdc_instance_uuid" = a."UID"
    ,    LATERAL FLATTEN ( input => a."ImageType")                                   it          -- to look for “VOLUME”
    ,    LATERAL FLATTEN ( input => a."SpecimenDescriptionSequence")                 sd          -- specimen-level data
    ,    LATERAL FLATTEN ( input => sd.value:"PrimaryAnatomicStructureSequence")     pas
    ,    LATERAL FLATTEN ( input => pas.value:"PrimaryAnatomicStructureModifierSequence") mod
    WHERE a."collection_name" IN ('TCGA-LUAD','TCGA-LUSC')
      AND it.value::STRING ILIKE '%VOLUME%'                                           -- digital slide images only
      AND sd.value:"EmbeddingMedium"::STRING = 'Tissue freezing medium'               -- required embedding method
      AND mod.value:"CodeValue"::STRING IN ('17621005','86049000')                    -- normal / tumor tissue
)
, sm_clean AS (         -- --- 2)  Classify compression; keep only JPEG/JPEG2000
    SELECT DISTINCT
        digital_slide_id,
        case_id,
        physical_slide_id,
        patient_id,
        collection_id,
        instance_id,
        gcs_url,
        width_px,
        height_px,
        sm_src.pixel_spacing_var::STRING                AS pixel_spacing,
        CASE
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.9%'  THEN 'jpeg2000'
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.5%'  THEN 'jpeg'
            WHEN "TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.7%'  THEN 'jpeg'
            ELSE 'other'
        END                                            AS compression_type,
        CASE                                            -- tissue_type label
            WHEN tissue_code = '17621005' THEN 'normal'
            ELSE                       'tumor'
        END                                            AS tissue_type,
        CASE                                            -- cancer_subtype label
            WHEN collection_id = 'tcga_luad' THEN 'luad'
            ELSE                                       'lscc'
        END                                            AS cancer_subtype
    FROM sm_src
)
SELECT
    digital_slide_id,          -- numeric / UUID identifier of the digital slide
    case_id,                   -- study-level ID
    physical_slide_id,         -- wet-lab slide identifier
    patient_id,
    collection_id,
    instance_id,
    gcs_url,
    width_px        AS width,
    height_px       AS height,
    pixel_spacing,
    compression_type,
    tissue_type,
    cancer_subtype
FROM   sm_clean
WHERE  compression_type <> 'other'          -- keep only JPEG or JPEG2000
ORDER  BY instance_id ASC;
