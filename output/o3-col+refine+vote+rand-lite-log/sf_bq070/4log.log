```sql
--Description:  Retrieve TCGA-LUAD and TCGA-LUSC instances whose ImageType
--              contains “VOLUME” and whose TransferSyntaxUID is any JPEG or
--              JPEG-2000 variant (UID root 1.2.840.10008.1.2.4.*).  For each
--              instance, also extract the EmbeddingMedium value (if present)
--              so we can inspect whether “Tissue freezing medium” ever occurs.
--              No EmbeddingMedium or tissue-type filters are applied yet—
--              this confirms that qualifying SM images exist before tightening
--              criteria further.
SELECT
       a."UID"                                         AS "instance_id",
       a."collection_name",
       m."TransferSyntaxUID",
       p."gcs_url",
       a."Rows"                                        AS "height_px",
       a."Columns"                                     AS "width_px",
       sp.value::VARIANT:"EmbeddingMedium"::STRING     AS "embedding_medium"
FROM   IDC.IDC_V17."DICOM_ALL"       a
JOIN   IDC.IDC_V17."DICOM_METADATA"  m  ON m."SOPInstanceUID"     = a."UID"
LEFT  JOIN IDC.IDC_V17."DICOM_PIVOT" p  ON p."crdc_instance_uuid" = a."UID"
     , LATERAL FLATTEN(input => a."ImageType") it
     , LATERAL FLATTEN(OUTER => TRUE, input => a."SpecimenDescriptionSequence") sp
WHERE  a."collection_name" IN ('TCGA-LUAD','TCGA-LUSC')
  AND  it.value::STRING ILIKE '%VOLUME%'
  AND  m."TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.%'
LIMIT 20;
```
