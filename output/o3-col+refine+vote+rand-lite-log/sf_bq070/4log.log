--Description: 10) Final candidate extraction: apply all required filters
--              (collection, VOLUME ImageType, JPEG/JPEG-2000 encoding,
--              tissue freezing medium, and tissue type) and gather the
--              requested metadata.  The join to DICOM_METADATA is fixed by
--              matching DICOM_ALL.UID to DICOM_METADATA.SOPInstanceUID.
SELECT
       a."SeriesInstanceUID"                         AS "digital_slide_id",
       a."StudyInstanceUID"                          AS "case_id",
       a."SeriesInstanceUID"                         AS "physical_slide_id",
       a."PatientID"                                 AS "patient_id",
       a."collection_name"                           AS "collection_id",
       a."UID"                                       AS "instance_id",
       p."gcs_url"                                   AS "gcs_url",
       a."Columns"                                   AS "width_px",
       a."Rows"                                      AS "height_px",
       a."PixelSpacing"                              AS "pixel_spacing",
       CASE
           WHEN m."TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.5%' THEN 'jpeg'
           WHEN m."TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.9%' THEN 'jpeg2000'
           ELSE 'other'
       END                                           AS "compression_type",
       CASE
           WHEN sp.value::VARIANT:"SpecimenUID"::STRING ILIKE '%86049000%' THEN 'tumor'
           WHEN sp.value::VARIANT:"SpecimenUID"::STRING ILIKE '%17621005%' THEN 'normal'
       END                                           AS "tissue_type",
       CASE
           WHEN a."collection_name" = 'TCGA-LUAD' THEN 'luad'
           ELSE                                        'lscc'
       END                                           AS "cancer_subtype"
FROM   IDC.IDC_V17."DICOM_ALL"       a
JOIN   IDC.IDC_V17."DICOM_METADATA"  m  ON m."SOPInstanceUID"     = a."UID"
LEFT  JOIN IDC.IDC_V17."DICOM_PIVOT" p  ON p."crdc_instance_uuid" = a."UID"
     , LATERAL FLATTEN(input => a."ImageType")                it
     , LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") sp
WHERE  a."collection_name" IN ('TCGA-LUAD','TCGA-LUSC')
  AND  it.value::STRING ILIKE '%VOLUME%'
  AND  (   m."TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.5%'   -- JPEG
       OR m."TransferSyntaxUID" LIKE '1.2.840.10008.1.2.4.9%')   -- JPEG-2000
  AND  sp.value::VARIANT:"EmbeddingMedium"::STRING ILIKE '%Tissue%freezing%medium%'
  AND  (   sp.value::VARIANT:"SpecimenUID"::STRING ILIKE '%17621005%'  -- normal
       OR sp.value::VARIANT:"SpecimenUID"::STRING ILIKE '%86049000%')  -- tumor
ORDER BY a."UID"
LIMIT  20
