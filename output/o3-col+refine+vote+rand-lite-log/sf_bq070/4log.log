```sql
--Description: Determine which compression encodings are used by slide-microscopy
--             instances (ImageType contains “VOLUME”) in the TCGA-LUAD and
--             TCGA-LUSC collections.  We join DICOM_ALL to DICOM_METADATA on
--             the per-instance SOPInstanceUID and list the distinct
--             TransferSyntaxUID values.  This confirms whether JPEG or
--             JPEG-2000 images actually exist before adding more restrictive
--             filters.
SELECT DISTINCT
       m."TransferSyntaxUID"
FROM   IDC.IDC_V17."DICOM_ALL"      a
JOIN   IDC.IDC_V17."DICOM_METADATA" m
       ON m."SOPInstanceUID" = a."UID"
     , LATERAL FLATTEN(input => a."ImageType") it
WHERE  a."collection_name" IN ('TCGA-LUAD', 'TCGA-LUSC')
  AND  it.value::STRING ILIKE '%VOLUME%'
LIMIT 20;
```
