            WHEN a."CompressionCode" ILIKE '%jpeg%'     THEN 'jpeg'
            ELSE 'other'
       END                                     AS "compression_type",
       CASE
            WHEN f_tissue.value:"CodeValue"::STRING = '17621005' THEN 'normal'
            WHEN f_tissue.value:"CodeValue"::STRING = '86049000' THEN 'tumor'
       END                                     AS "tissue_type",
       CASE
            WHEN a."collection_id" = 'tcga_luad'  THEN 'luad'
            WHEN a."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                     AS "cancer_subtype"
FROM IDC.IDC_V17.DICOM_ALL                                   a
JOIN IDC.IDC_V17.DICOM_PIVOT  p
     ON a."UID" = p."crdc_instance_uuid"
,    LATERAL FLATTEN (INPUT => a."ImageType")                              f_img
,    LATERAL FLATTEN (INPUT => a."SpecimenDescriptionSequence")            f_desc
,    LATERAL FLATTEN (INPUT => f_desc.value:"SpecimenPreparationSequence") f_prep
,    LATERAL FLATTEN (INPUT => f_desc.value:"PrimaryAnatomicStructureSequence")       f_anat
,    LATERAL FLATTEN (INPUT => f_anat.value:"PrimaryAnatomicStructureModifierSequence") f_tissue
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND f_img.value::STRING ILIKE '%volume%'
  AND a."CompressionCode" IS NOT NULL
  AND a."CompressionCode" NOT ILIKE '%other%'
  AND f_prep.value:"EmbeddingMedium"::STRING ILIKE '%tissue%freezing%medium%'
  AND f_tissue.value:"CodeValue"::STRING IN ('17621005','86049000')
ORDER BY a."UID"
LIMIT 20;
