       a."Columns"                              AS "width_px",
       a."Rows"                                 AS "height_px",
       ARRAY_TO_STRING(a."PixelSpacing", ',')   AS "pixel_spacing_mm",
       CASE 
            WHEN a."CompressionCode" ILIKE '%jpeg2000%' THEN 'jpeg2000'
            WHEN a."CompressionCode" ILIKE '%jpeg%'     THEN 'jpeg'
            ELSE 'other'
       END                                      AS "compression_type",
       CASE 
            WHEN f_tissue.value::STRING ILIKE '%17621005%' THEN 'normal'
            WHEN f_tissue.value::STRING ILIKE '%86049000%' THEN 'tumor'
       END                                      AS "tissue_type",
       CASE 
            WHEN a."collection_id" = 'tcga_luad' THEN 'luad'
            WHEN a."collection_id" = 'tcga_lusc' THEN 'lscc'
       END                                      AS "cancer_subtype"
FROM IDC.IDC_V17.DICOM_ALL  a
JOIN IDC.IDC_V17.DICOM_PIVOT p
     ON a."UID" = p."crdc_instance_uuid"
,    LATERAL FLATTEN (INPUT => a."ImageType")                       f_img
,    LATERAL FLATTEN (INPUT => a."SpecimenDescriptionSequence")     f_spec
,    LATERAL FLATTEN (INPUT => f_spec.value:"SpecimenPreparationSequence") f_prep
,    LATERAL FLATTEN (INPUT => f_spec.value:"SpecimenPreparationSequence") f_tissue
