```sql
--Description: Candidate final query assembling requested metadata for SM-VOLUME images  
SELECT
      a."InstanceNumber"                        AS "digital_slide_id",           -- unique within series
      a."StudyInstanceUID"                      AS "case_id",
      a."InstanceNumber"                        AS "physical_slide_id",          -- placeholder; adjust if better field found
      a."PatientID"                             AS "patient_id",
      a."collection_id"                         AS "collection_id",
      a."UID"                                   AS "instance_id",
      p."gcs_url"                               AS "gcs_url",
      a."Columns"                               AS "width_px",
      a."Rows"                                  AS "height_px",
      ARRAY_TO_STRING(a."PixelSpacing", ',')    AS "pixel_spacing_mm",
      CASE 
          WHEN a."CompressionCode" ILIKE '%jpeg2000%' THEN 'jpeg2000'
          WHEN a."CompressionCode" ILIKE '%jpeg%'     THEN 'jpeg'
          ELSE 'other'
      END                                       AS "compression_type",
      CASE 
          WHEN f_tissue.value::STRING ILIKE '%17621005%' THEN 'normal'
          WHEN f_tissue.value::STRING ILIKE '%86049000%' THEN 'tumor'
      END                                       AS "tissue_type",
      CASE 
          WHEN a."collection_id" ILIKE '%luad%' THEN 'luad'
          WHEN a."collection_id" ILIKE '%lusc%' THEN 'lscc'
      END                                       AS "cancer_subtype"
FROM IDC.IDC_V17.DICOM_ALL  a
JOIN IDC.IDC_V17.DICOM_PIVOT p
     ON a."UID" = p."crdc_instance_uuid"
,    LATERAL FLATTEN(input => a."ImageType") f_img
,    LATERAL FLATTEN(input => a."SpecimenDescriptionSequence") f_spec
,    LATERAL FLATTEN(input => f_spec.value:"SpecimenPreparationSequence") f_prep
,    LATERAL FLATTEN(input => f_spec.value:"SpecimenPreparationSequence") f_tissue      -- for tissue type codes
WHERE a."Type" = 'SM'
  AND f_img.value::STRING ILIKE '%volume%'
  AND a."CompressionCode" IS NOT NULL
  AND a."CompressionCode" NOT ILIKE '%other%'
  AND (a."collection_id" ILIKE '%luad%' OR a."collection_id" ILIKE '%lusc%')
  AND f_prep.value:"EmbeddingMedium"::STRING ILIKE '%tissue%freezing%medium%'
  AND (
          f_tissue.value::STRING ILIKE '%17621005%'   -- normal tissue code
       OR f_tissue.value::STRING ILIKE '%86049000%'   -- tumor tissue code
      )
ORDER BY a."UID"
LIMIT 20;
```
