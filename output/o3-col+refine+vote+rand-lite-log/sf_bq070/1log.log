Query:
--Description: 3) LUAD/LUSC instances whose ImageType contains “VOLUME”; no filter on Type (earlier ‘SM’ returned 0)
SELECT 
       a."UID",
       a."collection_id",
       a."Type",
       ARRAY_TO_STRING(a."ImageType", ',') AS "ImageType_concat"
FROM IDC.IDC_V17.DICOM_ALL  a,
     LATERAL FLATTEN (INPUT => a."ImageType") f
WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
  AND f.value::STRING ILIKE '%volume%'
LIMIT 20
