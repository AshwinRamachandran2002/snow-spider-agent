/*  TCGA-LUAD / TCGA-LUSC whole-slide (SM) microscopy “VOLUME” images
    – JPEG / JPEG-2000 only
    – tissue freezing medium embedding
    – tissue type normal (17621005) or tumour (86049000)
*/
WITH meta AS (                     -- basic filters, join META for SOP‐class & compression
    SELECT
        a."UID"                               AS sop_instance_uid,
        a."idc_case_id"                       AS case_id,
        a."PatientID"                         AS patient_id,
        a."collection_id",
        a."Rows"                              AS img_height,
        a."Columns"                           AS img_width,
        a."PixelSpacing"                      AS pixel_spacing_var,
        a."SpecimenDescriptionSequence"       AS specimen_seq,
        m."TransferSyntaxUID"                 AS ts_uid,
        CASE                                    /* classify compression               */
            WHEN m."TransferSyntaxUID" IN
                 ('1.2.840.10008.1.2.4.50','1.2.840.10008.1.2.4.51',
                  '1.2.840.10008.1.2.4.57','1.2.840.10008.1.2.4.70')  THEN 'jpeg'
            WHEN m."TransferSyntaxUID" IN
                 ('1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91')  THEN 'jpeg2000'
            ELSE                                                      'other'
        END                                    AS compression_type
    FROM IDC.IDC_V17.DICOM_ALL      a
    JOIN IDC.IDC_V17.DICOM_METADATA m
          ON a."UID" = m."UID"
    WHERE a."collection_id" IN ('tcga_luad','tcga_lusc')
      /* slide-microscopy SOP class (VL Whole Slide Microscopy Image) */
      AND (m."SOPClassUID"            = '1.2.840.10008.5.1.4.1.1.77.1.6'
           OR m."MediaStorageSOPClassUID" = '1.2.840.10008.5.1.4.1.1.77.1.6')
      /* accepted compressions only                                    */
      AND m."TransferSyntaxUID" IN
          ('1.2.840.10008.1.2.4.50','1.2.840.10008.1.2.4.51',
           '1.2.840.10008.1.2.4.57','1.2.840.10008.1.2.4.70',
           '1.2.840.10008.1.2.4.90','1.2.840.10008.1.2.4.91')
      /* image type must contain “VOLUME”                              */
      AND EXISTS (
            SELECT 1
            FROM LATERAL FLATTEN (INPUT => a."ImageType") f
            WHERE LOWER(f.value::STRING) = 'volume'
          )
      /* specimen: tissue freezing medium                              */
      AND a."SpecimenDescriptionSequence" IS NOT NULL
      AND a."SpecimenDescriptionSequence"::STRING ILIKE '%Tissue freezing medium%'
      /* specimen: normal or tumour tissue                             */
      AND (a."SpecimenDescriptionSequence"::STRING ILIKE '%"17621005"%'
           OR a."SpecimenDescriptionSequence"::STRING ILIKE '%"86049000"%')
),
labelled AS (                      -- derive labels and physical-slide id
    SELECT
        m.*,
        CASE
            WHEN m.specimen_seq::STRING ILIKE '%"17621005"%' THEN 'normal'
            WHEN m.specimen_seq::STRING ILIKE '%"86049000"%' THEN 'tumor'
        END                                       AS tissue_type,
        CASE
            WHEN m.collection_id = 'tcga_luad'  THEN 'luad'
            WHEN m.collection_id = 'tcga_lusc' THEN 'lscc'
        END                                       AS cancer_subtype,
        /* physical-slide identifier from SpecimenIdentifier */
        TRY_CAST( m.specimen_seq[0]:"SpecimenIdentifier"::STRING AS STRING )
                                                AS physical_slide_id
    FROM meta m
),
add_gcs AS (                       -- attach GCS url & instance UUID from pivot
    SELECT
        l.*,
        p."gcs_url",
        p."crdc_instance_uuid"                  AS instance_uuid
    FROM labelled l
    LEFT JOIN IDC.IDC_V17.DICOM_PIVOT p
           ON p."collection_id"               = l.collection_id
          AND p."PatientID"                   = l.patient_id
          AND p."max_TotalPixelMatrixRows"    = l.img_height
          AND p."max_TotalPixelMatrixColumns" = l.img_width
          AND LOWER(p."ImageType")            LIKE '%volume%'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY l.sop_instance_uid
                               ORDER BY p."gcs_url") = 1      -- pick single match
)
SELECT
    sop_instance_uid                       AS "digital_slide_id",
    case_id                                AS "case_id",
    physical_slide_id                      AS "physical_slide_id",
    patient_id                             AS "patient_id",
    collection_id                          AS "collection_id",
    instance_uuid                          AS "instance_id",
    gcs_url                                AS "gcs_url",
    img_width                              AS "width",
    img_height                             AS "height",
    ARRAY_TO_STRING(pixel_spacing_var, ',') AS "pixel_spacing",
    compression_type                       AS "compression_type",
    tissue_type                            AS "tissue_type",
    cancer_subtype                         AS "cancer_subtype"
FROM add_gcs
WHERE tissue_type IS NOT NULL             -- safety: keep only normal / tumour
ORDER BY instance_uuid ASC;
```
