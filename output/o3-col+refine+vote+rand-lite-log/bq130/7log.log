```sql
--Description: Determine how many times each U.S. state appeared in the daily “top-five
--new-case” list between 1 Mar 2020 and 31 May 2020, then rank the states by that
--frequency so we can see which state is 4th overall.
--Thinking process (inline comments):
-- 1) CTE daily … compute daily_new_cases for every state via LAG.
-- 2) CTE top5 … for every calendar date, rank states by daily_new_cases and keep the
--    five largest (rn ≤ 5).  That gives us one row per date-state that made the cut.
-- 3) CTE tallies … count how often each state shows up in top5.
-- 4) Final SELECT … add an overall_rank column so we know which state is 4th.
WITH daily AS (
  /* Step 1: daily new cases for each state */
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
top5 AS (
  /* Step 2: keep top-five states per date */
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      daily_new_cases,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM daily
  )
  WHERE rn <= 5
),
tallies AS (
  /* Step 3: count appearances */
  SELECT
    state_name,
    COUNT(*) AS appearances
  FROM top5
  GROUP BY state_name
)
/* Step 4: rank states by frequency */
SELECT
  state_name,
  appearances,
  ROW_NUMBER() OVER (ORDER BY appearances DESC) AS overall_rank
FROM tallies
ORDER BY overall_rank;
```
