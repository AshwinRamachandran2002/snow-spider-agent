```sql
--Description: 7) For that 4th-ranked state, compute county-level daily new cases (sample)  
SELECT
  c.date,
  c.state_name,
  c.county,
  c.confirmed_cases,
  c.confirmed_cases
  - LAG(c.confirmed_cases) OVER (PARTITION BY c.state_name, c.county ORDER BY c.date) AS daily_new_cases
FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
JOIN (
  SELECT state_name
  FROM (
    SELECT
      state_name,
      COUNT(*) AS appearances_in_top5,
      ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
    FROM (
      SELECT
        date,
        state_name,
        ROW_NUMBER() OVER (
          PARTITION BY date
          ORDER BY confirmed_cases
                   - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC
        ) AS rn
      FROM `bigquery-public-data.covid19_nyt.us_states`
      WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
    )
    WHERE rn <= 5
    GROUP BY state_name
  )
  WHERE overall_rank = 4
) AS fourth
ON c.state_name = fourth.state_name
WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
ORDER BY c.county, c.date
LIMIT 20;
