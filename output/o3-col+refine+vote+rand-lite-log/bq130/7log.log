    WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
  ),
  top5 AS (
    SELECT date, state_name
    FROM (
      SELECT
        date,
        state_name,
        daily_new_cases,
        ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
      FROM daily
    )
    WHERE rn <= 5
  ),
  tallies AS (
    SELECT state_name, COUNT(*) AS appearances FROM top5 GROUP BY state_name
  )
  SELECT state_name
  FROM (
    SELECT
      state_name,
      appearances,
      ROW_NUMBER() OVER (ORDER BY appearances DESC) AS rk
    FROM tallies
  )
  WHERE rk = 4
),
county_daily AS (   -- compute daily new cases for counties
  SELECT
    c.date,
    c.county,
    c.confirmed_cases
      - LAG(c.confirmed_cases) OVER (PARTITION BY c.county ORDER BY c.date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_counties` AS c
  JOIN fourth_state f ON c.state_name = f.state_name
  WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
    AND c.county IS NOT NULL
    AND c.county <> 'Unknown'
),
county_top5 AS (    -- daily top-five counties
  SELECT
    date,
    county
  FROM (
    SELECT
      date,
      county,
      daily_new_cases,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM county_daily
  )
  WHERE rn <= 5
),
tallies AS (        -- count appearances
  SELECT
    county,
    COUNT(*) AS appearances_in_state_top5
  FROM county_top5
  GROUP BY county
)
SELECT
  county,
  appearances_in_state_top5
FROM (
  SELECT
    county,
    appearances_in_state_top5,
    ROW_NUMBER() OVER (ORDER BY appearances_in_state_top5 DESC) AS county_rank
  FROM tallies
)
WHERE county_rank <= 5
ORDER BY county_rank
