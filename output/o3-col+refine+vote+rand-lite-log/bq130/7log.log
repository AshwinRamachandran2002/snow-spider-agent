--Description: 5) Count how many times each state appears in the daily top-five list  
WITH daily AS (  -- daily new cases for every state
  SELECT
    date,
    state_name,
    confirmed_cases
      - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
),
top5 AS (        -- keep the five highest-new-case states each day
  SELECT
    date,
    state_name
  FROM (
    SELECT
      date,
      state_name,
      daily_new_cases,
      ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
    FROM daily
  )
  WHERE rn <= 5
)
SELECT
  state_name,
  COUNT(*) AS appearances_in_top5
FROM top5
GROUP BY state_name
ORDER BY appearances_in_top5 DESC
LIMIT 20
