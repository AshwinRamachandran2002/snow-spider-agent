```sql
--Description: 4) Pick the DAILY top-five states by new cases (one row per date-rank combo)  
SELECT
  date,
  state_name,
  daily_new_cases
FROM (
  SELECT
    date,
    state_name,
    confirmed_cases
    - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases,
    ROW_NUMBER() OVER (
      PARTITION BY date
      ORDER BY confirmed_cases
               - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC
    ) AS rn
  FROM `bigquery-public-data.covid19_nyt.us_states`
  WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
)
WHERE rn <= 5
ORDER BY date, rn
LIMIT 20;
