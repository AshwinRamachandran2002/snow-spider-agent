    JOIN (
      SELECT state_name
      FROM (
        SELECT
          state_name,
          COUNT(*) AS appearances_in_top5,
          ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS overall_rank
        FROM (
          SELECT
            date,
            state_name,
            ROW_NUMBER() OVER (
              PARTITION BY date
              ORDER BY confirmed_cases
                       - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) DESC
            ) AS rn
          FROM `bigquery-public-data.covid19_nyt.us_states`
          WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
        )
        WHERE rn <= 5
        GROUP BY state_name
      )
      WHERE overall_rank = 4
    ) AS fourth
    ON c.state_name = fourth.state_name
    WHERE c.date BETWEEN '2020-03-01' AND '2020-05-31'
      AND c.county IS NOT NULL
      AND c.county <> 'Unknown'
  )
  WHERE rn <= 5
  GROUP BY county
)
WHERE county_rank <= 5
ORDER BY county_rank
LIMIT 20;
