--Description: Retrieve the top-5 states (by new cases) for every day in the
--             Mar-01–May-31 window.  No modification required—Alabama begins on
--             13-Mar, but that still falls inside the window.
SELECT
  `date`,
  `state_name`,
  daily_new_cases
FROM (
  SELECT
    `date`,
    `state_name`,
    daily_new_cases,
    ROW_NUMBER() OVER (PARTITION BY `date` ORDER BY daily_new_cases DESC) AS rn
  FROM (
    SELECT
      `date`,
      `state_name`,
      `confirmed_cases`
        - LAG(`confirmed_cases`) OVER (PARTITION BY `state_name` ORDER BY `date`) AS daily_new_cases
    FROM `bigquery-public-data.covid19_nyt.us_states`
    WHERE `date` BETWEEN '2020-03-01' AND '2020-05-31'
  )
)
WHERE rn <= 5
ORDER BY `date`, rn
LIMIT 20
