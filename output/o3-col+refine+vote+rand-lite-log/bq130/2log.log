```sql
--Description & Thinking process:
--  • Task: after identifying the 4th-ranked state (by frequency of appearing in
--    the daily top-5 new-case list), list a sample of its counties so we can
--    drill down to county-level analysis next.
--  • Steps:
--      1. Re-use the ranking logic to obtain the 4th-ranked state
--         (LIMIT 1 OFFSET 3).
--      2. Query `us_counties` and pull the DISTINCT county names for that state.
--      3. Limit to 20 rows for a quick preview.
SELECT DISTINCT
  county
FROM `bigquery-public-data.covid19_nyt.us_counties`
WHERE state_name = (
  SELECT
    state_name
  FROM (
    SELECT
      state_name,
      COUNT(*) AS times_in_daily_top5
    FROM (
      SELECT
        date,
        state_name,
        ROW_NUMBER() OVER (PARTITION BY date ORDER BY daily_new_cases DESC) AS rn
      FROM (
        SELECT
          date,
          state_name,
          confirmed_cases
            - LAG(confirmed_cases) OVER (PARTITION BY state_name ORDER BY date) AS daily_new_cases
        FROM `bigquery-public-data.covid19_nyt.us_states`
        WHERE date BETWEEN '2020-03-01' AND '2020-05-31'
      )
    )
    WHERE rn <= 5
    GROUP BY state_name
    ORDER BY times_in_daily_top5 DESC
  )
  LIMIT 1 OFFSET 3      -- 4th-ranked state
)
LIMIT 20;
```
