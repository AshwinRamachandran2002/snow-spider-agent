```sql
/*  Thinking process embedded in comments:

    1. Identify the drug with the largest total_claim_count in New York (NY).
       - Filter rows where nppes_provider_state = 'NY'.
       - Group by drug_name and order by the summed total_claim_count descending.
       - LIMIT 1 picks the single highest-volume drug (CTE: top_ny_drug).

    2. Using that drug, compute each state’s aggregate totals.
       - Join the full table to the CTE (implicit cross-join) so we can refer
         to the selected drug_name.
       - Filter on drug_name = top_ny_drug.drug_name.
       - Group by nppes_provider_state, summing total_claim_count & total_drug_cost.

    3. Sort by total_claims in descending order and keep only the top 5 states.

    This single query answers the task: “For the drug with the highest total
    number of prescriptions in NY during 2014, list the five states with the
    highest claim counts for that drug, including counts and costs.”
*/
WITH top_ny_drug AS (
  SELECT
    drug_name
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  WHERE nppes_provider_state = 'NY'
  GROUP BY drug_name
  ORDER BY SUM(total_claim_count) DESC   -- highest-volume drug in NY
  LIMIT 1
)
SELECT
  nppes_provider_state             AS state,
  SUM(total_claim_count)           AS total_claims,
  SUM(total_drug_cost)             AS total_drug_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`, top_ny_drug
WHERE drug_name = top_ny_drug.drug_name -- restrict to that single drug
GROUP BY state
ORDER BY total_claims DESC
LIMIT 5;
```
