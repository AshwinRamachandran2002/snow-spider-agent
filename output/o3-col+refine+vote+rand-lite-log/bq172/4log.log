```sql
--Description: 
--  • Find the drug with the highest total_claim_count written in New York (NY) in 2014 (CTE top_ny_drug).  
--  • Using that drug, aggregate nationwide totals by state, summing total_claim_count and total_drug_cost.  
--  • Return the five states with the largest claim counts for that drug.  
WITH top_ny_drug AS (
  SELECT
    drug_name
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  WHERE nppes_provider_state = 'NY'
  GROUP BY drug_name
  ORDER BY SUM(total_claim_count) DESC
  LIMIT 1
)
SELECT
  t.nppes_provider_state          AS state,
  SUM(t.total_claim_count)        AS total_claims,
  SUM(t.total_drug_cost)          AS total_drug_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014` AS t
JOIN top_ny_drug d
  ON t.drug_name = d.drug_name
GROUP BY state
ORDER BY total_claims DESC
LIMIT 5;
```
