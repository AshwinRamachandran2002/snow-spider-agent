Below are a series of BigQuery SQL statements that progress from simple data inspection toward deriving the requested result.

```sql
--Description: 1) Peek at 20 raw rows from the 2014 Part-D prescriber file  
SELECT *
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: 2) Get 20 distinct provider states appearing in the table  
SELECT DISTINCT nppes_provider_state
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: 3) Show 20 distinct drug names to understand value variety  
SELECT DISTINCT drug_name
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: 4) Inspect 20 New-York (NY) rows only  
SELECT nppes_provider_state,
       drug_name,
       total_claim_count,
       total_drug_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'NY'
LIMIT 20;
```

```sql
--Description: 5) Aggregate NY rows by drug, ordered by total claim counts (top 20)  
SELECT drug_name,
       SUM(total_claim_count) AS ny_total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'NY'
GROUP BY drug_name
ORDER BY ny_total_claims DESC
LIMIT 20;
```

```sql
--Description: 6) Find the single drug with the highest total claim count in NY  
SELECT drug_name,
       SUM(total_claim_count) AS ny_total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'NY'
GROUP BY drug_name
ORDER BY ny_total_claims DESC
LIMIT 1;
```

```sql
--Description: 7) For that drug, compute totals for every state (show 20)  
SELECT nppes_provider_state AS state,
       SUM(total_claim_count) AS total_claims,
       SUM(total_drug_cost)  AS total_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE drug_name = (
    SELECT drug_name                              -- the NY #1 drug
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    WHERE nppes_provider_state = 'NY'
    GROUP BY drug_name
    ORDER BY SUM(total_claim_count) DESC
    LIMIT 1
)
GROUP BY state
ORDER BY total_claims DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER — Top five states for that drug, with claim counts & costs  
SELECT nppes_provider_state AS state,
       SUM(total_claim_count) AS total_claims,
       SUM(total_drug_cost)  AS total_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE drug_name = (
    SELECT drug_name                              -- highest-claim drug in NY
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    WHERE nppes_provider_state = 'NY'
    GROUP BY drug_name
    ORDER BY SUM(total_claim_count) DESC
    LIMIT 1
)
GROUP BY state
ORDER BY total_claims DESC
LIMIT 5;
```
