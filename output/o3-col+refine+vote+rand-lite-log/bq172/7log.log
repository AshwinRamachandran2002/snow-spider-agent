FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014` AS p
JOIN ny_top_drug AS d
  ON p.drug_name = d.drug_name          -- restrict to NY’s #1 drug
GROUP BY state
ORDER BY total_claims DESC
LIMIT 5;
```
