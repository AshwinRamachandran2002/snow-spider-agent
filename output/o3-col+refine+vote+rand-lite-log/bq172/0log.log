```sql
--Description: 
-- • First, inside CTE ny_top_drug, we scan only New-York (NY) rows, sum total_claim_count
--   per drug, sort descending, and pick the single largest – this is the drug we care about.  
-- • Next, in the outer query we join the whole 2014 Part-D table with that CTE on drug_name,
--   thereby keeping rows ONLY for that one drug.  
-- • We then aggregate across states, summing total_claim_count and total_drug_cost.  
-- • Finally, we order states by the aggregated claim counts and show the five states
--   with the greatest totals (including NY itself if applicable).
WITH ny_top_drug AS (
  SELECT drug_name
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  WHERE nppes_provider_state = 'NY'
  GROUP BY drug_name
  ORDER BY SUM(total_claim_count) DESC
  LIMIT 1
)
SELECT
  t.nppes_provider_state AS state,
  SUM(t.total_claim_count) AS total_claims,
  SUM(t.total_drug_cost)   AS total_drug_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014` AS t
JOIN ny_top_drug d
  ON t.drug_name = d.drug_name
GROUP BY state
ORDER BY total_claims DESC
LIMIT 5;
```
