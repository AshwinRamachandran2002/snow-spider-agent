Query:
--Description: Dynamically calculate per-state totals for the drug that is #1 in New York (cross-join syntax spelled out)
WITH top_ny_drug AS (
  SELECT
    `drug_name`
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  WHERE `nppes_provider_state` = 'NY'
  GROUP BY `drug_name`
  ORDER BY SUM(`total_claim_count`) DESC
  LIMIT 1
)
SELECT
  p.`nppes_provider_state`,
  SUM(p.`total_claim_count`) AS state_total_claims,
  SUM(p.`total_drug_cost`)   AS state_total_cost
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014` AS p
CROSS JOIN top_ny_drug
WHERE p.`drug_name` = top_ny_drug.`drug_name`
GROUP BY p.`nppes_provider_state`
ORDER BY state_total_claims DESC
LIMIT 20
