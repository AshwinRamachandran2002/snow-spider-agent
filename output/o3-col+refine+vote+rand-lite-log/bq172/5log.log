        SUM(`total_drug_cost`)   AS ny_total_cost
FROM    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE   `nppes_provider_state` = 'NY'
GROUP BY `drug_name`
ORDER BY ny_total_claims DESC
LIMIT 10;
```

```sql
-- Description: Identify the single drug that has the highest total claims in New York (returns one row)
SELECT  `drug_name`,
        SUM(`total_claim_count`) AS ny_total_claims
FROM    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE   `nppes_provider_state` = 'NY'
GROUP BY `drug_name`
ORDER BY ny_total_claims DESC
LIMIT 1;
```

```sql
-- Description: For that #1 New York drug (replace ‹TOP_DRUG› with the value found above), 
-- get every state’s total claims and total cost, top 10 states by claims
SELECT  `nppes_provider_state`            AS state,
        SUM(`total_claim_count`)          AS state_total_claims,
        SUM(`total_drug_cost`)            AS state_total_cost
FROM    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE   `drug_name` = '‹TOP_DRUG›'
GROUP BY state
ORDER BY state_total_claims DESC
LIMIT 10;
```

```sql
-- Description: Same as above but restricted to the top 5 states, ready for the final answer
SELECT  `nppes_provider_state`            AS state,
        SUM(`total_claim_count`)          AS state_total_claims,
        SUM(`total_drug_cost`)            AS state_total_cost
FROM    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE   `drug_name` = '‹TOP_DRUG›'
GROUP BY state
ORDER BY state_total_claims DESC
LIMIT 5;
```

```sql
-- Description: Present New York’s own metrics for that drug to compare with other states
SELECT  'NY'                              AS state,
        SUM(`total_claim_count`)          AS ny_total_claims,
        SUM(`total_drug_cost`)            AS ny_total_cost
FROM    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE   `nppes_provider_state` = 'NY'
  AND   `drug_name` = '‹TOP_DRUG›';
```

```sql
-- Description: OPTIONAL – a compact single query that does everything: 
-- finds NY’s max-claim drug, then lists top-5 states for that drug
WITH ny_top_drug AS (
  SELECT `drug_name`
  FROM   `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  WHERE  `nppes_provider_state` = 'NY'
  GROUP  BY `drug_name`
  ORDER  BY SUM(`total_claim_count`) DESC
  LIMIT 1
)
SELECT  d.`nppes_provider_state`               AS state,
        SUM(d.`total_claim_count`)             AS state_total_claims,
        SUM(d.`total_drug_cost`)               AS state_total_cost
FROM    `bigquery-public-data.cms_medicare.part_d_prescriber_2014` AS d
JOIN    ny_top_drug t
ON      d.`drug_name` = t.`drug_name`
GROUP BY state
ORDER BY state_total_claims DESC
LIMIT 5;
```

```sql
-- Description: (For completeness) Show the drug name pulled in CTE
WITH ny_top_drug AS (
  SELECT `drug_name`
  FROM   `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  WHERE  `nppes_provider_state` = 'NY'
  GROUP  BY `drug_name`
  ORDER  BY SUM(`total_claim_count`) DESC
  LIMIT 1
)
SELECT * FROM ny_top_drug;
```
