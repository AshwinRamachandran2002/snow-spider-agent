--Description: 5.  Example join: overlap BRCA segments (one case) with chr1 cytobands, compute bp overlap  
SELECT c."case_barcode",
       b."cytoband_name",
       b."hg38_start",
       b."hg38_stop",
       s."start_pos",
       s."end_pos",
       s."copy_number",
       /* base-pair overlap length */
       GREATEST(0, LEAST(b."hg38_stop", s."end_pos") - GREATEST(b."hg38_start", s."start_pos")) AS "bp_overlap"
FROM (
      SELECT *
      FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
      WHERE "project_short_name" = 'TCGA-BRCA'
      QUALIFY ROW_NUMBER() OVER (PARTITION BY "project_short_name" ORDER BY "case_barcode") = 1  --pick one case
     ) c
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
  ON b."chromosome" = c."chromosome"
JOIN TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
  ON s."case_barcode" = c."case_barcode"
 AND s."chromosome"   = b."chromosome"
 AND GREATEST(b."hg38_start", s."start_pos") < LEAST(b."hg38_stop", s."end_pos")   --non-zero overlap
LIMIT 20;
