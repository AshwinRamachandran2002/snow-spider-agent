--Description: 6.  For that single case, compute the overlap-weighted average copy number per cytoband  
WITH seg AS (
  SELECT *
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "case_barcode" = (SELECT MIN("case_barcode")
                          FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
                          WHERE "project_short_name" = 'TCGA-BRCA')
),
ovl AS (
  SELECT b."cytoband_name",
         b."hg38_start",
         b."hg38_stop",
         s."copy_number",
         GREATEST(0, LEAST(b."hg38_stop", s."end_pos") - GREATEST(b."hg38_start", s."start_pos")) AS "bp_overlap"
  FROM seg s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
    ON b."chromosome" = s."chromosome"
   AND GREATEST(b."hg38_start", s."start_pos") < LEAST(b."hg38_stop", s."end_pos")
)
SELECT "cytoband_name",
       ROUND(SUM("bp_overlap" * "copy_number") / NULLIF(SUM("bp_overlap"),0)) AS "weighted_copy_number"
FROM ovl
GROUP BY "cytoband_name"
ORDER BY "cytoband_name"
LIMIT 20;
