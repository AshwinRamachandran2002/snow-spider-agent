--Description: 7.  Categorize the rounded copy number into CNV classes for that case  
WITH wcn AS (
  /* same CTE as query 6 but keeping rounded value */
  SELECT b."cytoband_name",
         ROUND(SUM(GREATEST(0, LEAST(b."hg38_stop", s."end_pos") -
                               GREATEST(b."hg38_start", s."start_pos")) *
                    s."copy_number") /
               NULLIF(SUM(GREATEST(0, LEAST(b."hg38_stop", s."end_pos") -
                               GREATEST(b."hg38_start", s."start_pos"))),0)) AS "round_cn"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
    ON b."chromosome" = s."chromosome"
 WHERE s."case_barcode" = (SELECT MIN("case_barcode")
                           FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
                           WHERE "project_short_name" = 'TCGA-BRCA')
   AND GREATEST(b."hg38_start", s."start_pos") < LEAST(b."hg38_stop", s."end_pos")
 GROUP BY b."cytoband_name"
)
SELECT "cytoband_name",
       "round_cn",
       CASE 
         WHEN "round_cn" = 0 THEN 'Homozygous Deletion'
         WHEN "round_cn" = 1 THEN 'Heterozygous Deletion'
         WHEN "round_cn" = 2 THEN 'Diploid'
         WHEN "round_cn" = 3 THEN 'Gain'
         WHEN "round_cn" > 3 THEN 'Amplification'
       END AS "cnv_class"
FROM wcn
ORDER BY "cytoband_name"
LIMIT 20;
