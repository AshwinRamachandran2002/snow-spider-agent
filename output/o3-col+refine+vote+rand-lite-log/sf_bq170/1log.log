         a."case_barcode",
         ROUND(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                               GREATEST(b."hg38_start", a."start_pos")) *
                    a."copy_number") /
               NULLIF(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                               GREATEST(b."hg38_start", a."start_pos"))),0)) AS "round_cn"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
    ON b."chromosome" = a."chromosome"
 WHERE a."project_short_name" = 'TCGA-BRCA'
   AND GREATEST(b."hg38_start", a."start_pos") < LEAST(b."hg38_stop", a."end_pos")
 GROUP BY b."cytoband_name", a."case_barcode"
),
classed AS (
 SELECT "cytoband_name",
        CASE 
          WHEN "round_cn" = 0 THEN 'HomDel'
          WHEN "round_cn" = 1 THEN 'HetDel'
          WHEN "round_cn" = 2 THEN 'Diploid'
          WHEN "round_cn" = 3 THEN 'Gain'
          ELSE 'Amplif'
        END AS "cnv_class"
 FROM per_case_band
