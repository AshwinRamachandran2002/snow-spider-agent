```sql
--Description: 4.  View cytoband intervals for chromosome 1 that we will later overlap with segments  
SELECT "cytoband_name",
       "chromosome",
       "hg38_start",
       "hg38_stop"
FROM TCGA_MITELMAN.PROD."CYTOBANDS_HG38"
WHERE "chromosome" = 'chr1'
ORDER BY "hg38_start"
LIMIT 20;
```

```sql
--Description: 5.  Example join: overlap BRCA segments (one case) with chr1 cytobands, compute bp overlap  
SELECT c."case_barcode",
       b."cytoband_name",
       b."hg38_start",
       b."hg38_stop",
       s."start_pos",
       s."end_pos",
       s."copy_number",
       /* base-pair overlap length */
       GREATEST(0, LEAST(b."hg38_stop", s."end_pos") - GREATEST(b."hg38_start", s."start_pos")) AS "bp_overlap"
FROM (
      SELECT *
      FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
      WHERE "project_short_name" = 'TCGA-BRCA'
      QUALIFY ROW_NUMBER() OVER (PARTITION BY "project_short_name" ORDER BY "case_barcode") = 1  --pick one case
     ) c
JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
  ON b."chromosome" = c."chromosome"
JOIN TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
  ON s."case_barcode" = c."case_barcode"
 AND s."chromosome"   = b."chromosome"
 AND GREATEST(b."hg38_start", s."start_pos") < LEAST(b."hg38_stop", s."end_pos")   --non-zero overlap
LIMIT 20;
```

```sql
--Description: 6.  For that single case, compute the overlap-weighted average copy number per cytoband  
WITH seg AS (
  SELECT *
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "case_barcode" = (SELECT MIN("case_barcode")
                          FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
                          WHERE "project_short_name" = 'TCGA-BRCA')
),
ovl AS (
  SELECT b."cytoband_name",
         b."hg38_start",
         b."hg38_stop",
         s."copy_number",
         GREATEST(0, LEAST(b."hg38_stop", s."end_pos") - GREATEST(b."hg38_start", s."start_pos")) AS "bp_overlap"
  FROM seg s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
    ON b."chromosome" = s."chromosome"
   AND GREATEST(b."hg38_start", s."start_pos") < LEAST(b."hg38_stop", s."end_pos")
)
SELECT "cytoband_name",
       ROUND(SUM("bp_overlap" * "copy_number") / NULLIF(SUM("bp_overlap"),0)) AS "weighted_copy_number"
FROM ovl
GROUP BY "cytoband_name"
ORDER BY "cytoband_name"
LIMIT 20;
```

```sql
--Description: 7.  Categorize the rounded copy number into CNV classes for that case  
WITH wcn AS (
  /* same CTE as query 6 but keeping rounded value */
  SELECT b."cytoband_name",
         ROUND(SUM(GREATEST(0, LEAST(b."hg38_stop", s."end_pos") -
                               GREATEST(b."hg38_start", s."start_pos")) *
                    s."copy_number") /
               NULLIF(SUM(GREATEST(0, LEAST(b."hg38_stop", s."end_pos") -
                               GREATEST(b."hg38_start", s."start_pos"))),0)) AS "round_cn"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
    ON b."chromosome" = s."chromosome"
 WHERE s."case_barcode" = (SELECT MIN("case_barcode")
                           FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
                           WHERE "project_short_name" = 'TCGA-BRCA')
   AND GREATEST(b."hg38_start", s."start_pos") < LEAST(b."hg38_stop", s."end_pos")
 GROUP BY b."cytoband_name"
)
SELECT "cytoband_name",
       "round_cn",
       CASE 
         WHEN "round_cn" = 0 THEN 'Homozygous Deletion'
         WHEN "round_cn" = 1 THEN 'Heterozygous Deletion'
         WHEN "round_cn" = 2 THEN 'Diploid'
         WHEN "round_cn" = 3 THEN 'Gain'
         WHEN "round_cn" > 3 THEN 'Amplification'
       END AS "cnv_class"
FROM wcn
ORDER BY "cytoband_name"
LIMIT 20;
```

```sql
--Description: 8.  For cytoband '1p36', count how many BRCA cases fall into each CNV class  
WITH per_case AS (
  SELECT s."case_barcode",
         ROUND(SUM(overlap_len * s."copy_number") / NULLIF(SUM(overlap_len),0)) AS "round_cn"
  FROM (
        SELECT a."case_barcode",
               a."chromosome",
               a."start_pos",
               a."end_pos",
               a."copy_number",
               GREATEST(0, LEAST(b."hg38_stop", a."end_pos") - GREATEST(b."hg38_start", a."start_pos")) AS overlap_len
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
          ON b."chromosome" = a."chromosome"
        WHERE a."project_short_name" = 'TCGA-BRCA'
          AND b."cytoband_name" = '1p36'
          AND GREATEST(b."hg38_start", a."start_pos") < LEAST(b."hg38_stop", a."end_pos")
       ) s
  GROUP BY s."case_barcode"
)
SELECT CASE 
         WHEN "round_cn" = 0 THEN 'HomDel'
         WHEN "round_cn" = 1 THEN 'HetDel'
         WHEN "round_cn" = 2 THEN 'Diploid'
         WHEN "round_cn" = 3 THEN 'Gain'
         ELSE 'Amplif'
       END AS "cnv_class",
       COUNT(*) AS "n_cases"
FROM per_case
GROUP BY "cnv_class"
ORDER BY "n_cases" DESC
LIMIT 20;
```

```sql
--Description: 9.  Compute CNV class frequencies for all cytobands (show first 20 cytobands)  
WITH per_case_band AS (
  SELECT b."cytoband_name",
         a."case_barcode",
         ROUND(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                               GREATEST(b."hg38_start", a."start_pos")) *
                    a."copy_number") /
               NULLIF(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                               GREATEST(b."hg38_start", a."start_pos"))),0)) AS "round_cn"
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
  JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
    ON b."chromosome" = a."chromosome"
 WHERE a."project_short_name" = 'TCGA-BRCA'
   AND GREATEST(b."hg38_start", a."start_pos") < LEAST(b."hg38_stop", a."end_pos")
 GROUP BY b."cytoband_name", a."case_barcode"
),
classed AS (
 SELECT "cytoband_name",
        CASE 
          WHEN "round_cn" = 0 THEN 'HomDel'
          WHEN "round_cn" = 1 THEN 'HetDel'
          WHEN "round_cn" = 2 THEN 'Diploid'
          WHEN "round_cn" = 3 THEN 'Gain'
          ELSE 'Amplif'
        END AS "cnv_class"
 FROM per_case_band
),
freq AS (
 SELECT "cytoband_name",
        "cnv_class",
        COUNT(*) AS "n_cases"
 FROM classed
 GROUP BY "cytoband_name", "cnv_class"
)
SELECT "cytoband_name",
       SUM(CASE WHEN "cnv_class"='HomDel'  THEN "n_cases" END) AS "homdel",
       SUM(CASE WHEN "cnv_class"='HetDel'  THEN "n_cases" END) AS "hetdel",
       SUM(CASE WHEN "cnv_class"='Diploid' THEN "n_cases" END) AS "diploid",
       SUM(CASE WHEN "cnv_class"='Gain'    THEN "n_cases" END) AS "gain",
       SUM(CASE WHEN "cnv_class"='Amplif'  THEN "n_cases" END) AS "amplif"
FROM freq
GROUP BY "cytoband_name"
ORDER BY "cytoband_name"
LIMIT 20;
```

```sql
--Description: 10.  Convert raw counts from query 9 into percentage of all BRCA cases for each class  
WITH total_cases AS (
  SELECT COUNT(DISTINCT "case_barcode") AS n_tot
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name" = 'TCGA-BRCA'
),
per_band_counts AS (  /* subquery from query 9 re-used */
  SELECT "cytoband_name",
         CASE 
           WHEN "round_cn" = 0 THEN 'HomDel'
           WHEN "round_cn" = 1 THEN 'HetDel'
           WHEN "round_cn" = 2 THEN 'Diploid'
           WHEN "round_cn" = 3 THEN 'Gain'
           ELSE 'Amplif'
         END AS "cnv_class"
  FROM (
        SELECT b."cytoband_name",
               a."case_barcode",
               ROUND(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                                     GREATEST(b."hg38_start", a."start_pos")) *
                          a."copy_number") /
                     NULLIF(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                                     GREATEST(b."hg38_start", a."start_pos"))),0)) AS "round_cn"
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
          ON b."chromosome" = a."chromosome"
        WHERE a."project_short_name" = 'TCGA-BRCA'
          AND GREATEST(b."hg38_start", a."start_pos") < LEAST(b."hg38_stop", a."end_pos")
        GROUP BY b."cytoband_name", a."case_barcode"
       )
),
band_class_freq AS (
 SELECT "cytoband_name",
        "cnv_class",
        COUNT(*) AS n_cases
 FROM per_band_counts
 GROUP BY "cytoband_name", "cnv_class"
)
SELECT f."cytoband_name",
       f."cnv_class",
       ROUND(100.0 * f.n_cases / t.n_tot, 2) AS "percent_of_cases"
FROM band_class_freq f
CROSS JOIN total_cases t
ORDER BY f."cytoband_name", f."cnv_class"
LIMIT 20;
```
