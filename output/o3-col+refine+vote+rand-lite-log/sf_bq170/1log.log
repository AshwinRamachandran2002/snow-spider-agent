--Description: 8.  For cytoband '1p36', count how many BRCA cases fall into each CNV class  
WITH per_case AS (
  SELECT s."case_barcode",
         ROUND(SUM(overlap_len * s."copy_number") / NULLIF(SUM(overlap_len),0)) AS "round_cn"
  FROM (
        SELECT a."case_barcode",
               a."chromosome",
               a."start_pos",
               a."end_pos",
               a."copy_number",
               GREATEST(0, LEAST(b."hg38_stop", a."end_pos") - GREATEST(b."hg38_start", a."start_pos")) AS overlap_len
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
          ON b."chromosome" = a."chromosome"
        WHERE a."project_short_name" = 'TCGA-BRCA'
          AND b."cytoband_name" = '1p36'
          AND GREATEST(b."hg38_start", a."start_pos") < LEAST(b."hg38_stop", a."end_pos")
       ) s
  GROUP BY s."case_barcode"
)
SELECT CASE 
         WHEN "round_cn" = 0 THEN 'HomDel'
         WHEN "round_cn" = 1 THEN 'HetDel'
         WHEN "round_cn" = 2 THEN 'Diploid'
         WHEN "round_cn" = 3 THEN 'Gain'
         ELSE 'Amplif'
       END AS "cnv_class",
       COUNT(*) AS "n_cases"
FROM per_case
GROUP BY "cnv_class"
ORDER BY "n_cases" DESC
LIMIT 20;
