--Description: 10.  Convert raw counts from query 9 into percentage of all BRCA cases for each class  
WITH total_cases AS (
  SELECT COUNT(DISTINCT "case_barcode") AS n_tot
  FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name" = 'TCGA-BRCA'
),
per_band_counts AS (  /* subquery from query 9 re-used */
  SELECT "cytoband_name",
         CASE 
           WHEN "round_cn" = 0 THEN 'HomDel'
           WHEN "round_cn" = 1 THEN 'HetDel'
           WHEN "round_cn" = 2 THEN 'Diploid'
           WHEN "round_cn" = 3 THEN 'Gain'
           ELSE 'Amplif'
         END AS "cnv_class"
  FROM (
        SELECT b."cytoband_name",
               a."case_barcode",
               ROUND(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                                     GREATEST(b."hg38_start", a."start_pos")) *
                          a."copy_number") /
                     NULLIF(SUM(GREATEST(0, LEAST(b."hg38_stop", a."end_pos") -
                                     GREATEST(b."hg38_start", a."start_pos"))),0)) AS "round_cn"
        FROM TCGA_MITELMAN.TCGA_VERSIONED."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" a
        JOIN TCGA_MITELMAN.PROD."CYTOBANDS_HG38" b
          ON b."chromosome" = a."chromosome"
        WHERE a."project_short_name" = 'TCGA-BRCA'
          AND GREATEST(b."hg38_start", a."start_pos") < LEAST(b."hg38_stop", a."end_pos")
        GROUP BY b."cytoband_name", a."case_barcode"
       )
),
band_class_freq AS (
 SELECT "cytoband_name",
        "cnv_class",
        COUNT(*) AS n_cases
 FROM per_band_counts
 GROUP BY "cytoband_name", "cnv_class"
)
SELECT f."cytoband_name",
       f."cnv_class",
       ROUND(100.0 * f.n_cases / t.n_tot, 2) AS "percent_of_cases"
FROM band_class_freq f
CROSS JOIN total_cases t
ORDER BY f."cytoband_name", f."cnv_class"
LIMIT 20;
