```sql
--Description: For every cytoband, compute the percentage of cases that fall into
--each CNV category.  (Here we LIMIT 20 cytobands to keep the preview short.)
WITH overlaps AS (
    /* identical overlaps CTE */
    SELECT
        c."cytoband_name",
        s."case_barcode",
        s."copy_number",
        GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) AS "ov"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" AS c
      ON c."chromosome" = s."chromosome"
    WHERE s."project_short_name" = 'TCGA-BRCA'
      AND GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) > 0
),
weighted AS (
    SELECT
        "cytoband_name",
        "case_barcode",
        ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
    FROM overlaps
    GROUP BY "cytoband_name", "case_barcode"
),
typed AS (
    SELECT
        "cytoband_name",
        CASE
          WHEN "rounded_cn" = 0 THEN 'Homozygous Deletion'
          WHEN "rounded_cn" = 1 THEN 'Heterozygous Deletion'
          WHEN "rounded_cn" = 2 THEN 'Diploid'
          WHEN "rounded_cn" = 3 THEN 'Gain'
          WHEN "rounded_cn" > 3 THEN 'Amplification'
        END AS "cnv_type"
    FROM weighted
),
totals AS (
    SELECT "cytoband_name",
           COUNT(DISTINCT "case_barcode") AS "n_cases"
    FROM weighted
    GROUP BY "cytoband_name"
),
freq AS (
    SELECT
        t."cytoband_name",
        ty."cnv_type",
        COUNT(*) AS "cases_in_type",
        t."n_cases",
        ROUND(100.0 * COUNT(*) / t."n_cases", 2) AS "pct_cases"
    FROM typed AS ty
    JOIN totals AS t
      ON t."cytoband_name" = ty."cytoband_name"
    GROUP BY t."cytoband_name", ty."cnv_type", t."n_cases"
)
SELECT *
FROM freq
ORDER BY "cytoband_name", "cnv_type"
LIMIT 20;
```

```sql
--Description: Identify the 20 cytobands with the highest amplification frequency
--in TCGA-BRCA Release 23 (use the frequency table above).
WITH overlaps AS (
    /* same overlaps calc */
    SELECT
        c."cytoband_name",
        s."case_barcode",
        s."copy_number",
        GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) AS "ov"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" AS c
      ON c."chromosome" = s."chromosome"
    WHERE s."project_short_name" = 'TCGA-BRCA'
      AND GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) > 0
),
weighted AS (
    SELECT
        "cytoband_name",
        "case_barcode",
        ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
    FROM overlaps
    GROUP BY "cytoband_name", "case_barcode"
),
typed AS (
    SELECT
        "cytoband_name",
        "case_barcode",
        CASE
          WHEN "rounded_cn" > 3 THEN 'Amplification' ELSE NULL END AS "amp_flag"
    FROM weighted
    WHERE "rounded_cn" > 3
),
amp_freq AS (
    SELECT
        "cytoband_name",
        COUNT(*) AS "amp_cases"
    FROM typed
    GROUP BY "cytoband_name"
),
total_cases AS (
    SELECT COUNT(DISTINCT "case_barcode") AS "tot"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
    WHERE "project_short_name" = 'TCGA-BRCA'
)
SELECT a."cytoband_name",
       a."amp_cases",
       t."tot"       AS "total_cases",
       ROUND(100.0 * a."amp_cases" / t."tot", 2) AS "amp_frequency_pct"
FROM amp_freq AS a, total_cases AS t
ORDER BY "amp_frequency_pct" DESC
LIMIT 20;
```
