--Description: Add CNV-type labels to the per-cytoband/per-case table produced above.
WITH overlaps AS (
    /* see previous query */
    SELECT
        c."cytoband_name",
        c."hg38_start",
        c."hg38_stop",
        s."case_barcode",
        s."copy_number",
        GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) AS "ov"
