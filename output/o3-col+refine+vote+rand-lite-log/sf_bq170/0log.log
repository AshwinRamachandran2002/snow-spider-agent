```sql
--Description: Pick one test case and one chromosome (chr17) and calculate, for each
--segment/cytoband pair, the base-pair overlap length.  This verifies the overlap formula.
WITH one_case AS (
    SELECT *
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "chromosome" = 'chr17'
      AND "case_barcode" = (
            SELECT MIN("case_barcode")
            FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
            WHERE "project_short_name" = 'TCGA-BRCA')
)
SELECT c."cytoband_name",
       c."hg38_start",
       c."hg38_stop",
       s."start_pos",
       s."end_pos",
       /* overlap in bp, forced to zero if negative */
       GREATEST(0,
         LEAST(c."hg38_stop", s."end_pos") -
         GREATEST(c."hg38_start", s."start_pos")) AS "overlap_bp",
       s."copy_number"
FROM one_case      AS s
JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" AS c
  ON c."chromosome" = s."chromosome"
WHERE c."chromosome" = 'chr17'
  AND GREATEST(0,
      LEAST(c."hg38_stop", s."end_pos") -
      GREATEST(c."hg38_start", s."start_pos")) > 0          -- keep only real overlaps
LIMIT 20;
```

```sql
--Description: For the same test case, aggregate to the cytoband level:
--length-weighted average copy-number per cytoband (rounded).  This mimics the
--calculation that will be repeated for every case.
WITH one_case AS (
    SELECT *
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
    WHERE "project_short_name" = 'TCGA-BRCA'
      AND "case_barcode" = (
            SELECT MIN("case_barcode")
            FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
            WHERE "project_short_name" = 'TCGA-BRCA')
),
overlaps AS (
    SELECT
        c."cytoband_name",
        c."hg38_start",
        c."hg38_stop",
        s."copy_number",
        GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) AS "ov"
    FROM one_case AS s
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" AS c
      ON c."chromosome" = s."chromosome"
    WHERE GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) > 0
)
SELECT "cytoband_name",
       "hg38_start",
       "hg38_stop",
       ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
FROM overlaps
GROUP BY "cytoband_name", "hg38_start", "hg38_stop"
ORDER BY "cytoband_name"
LIMIT 20;
```

```sql
--Description: Classify each cytoband for that test case into five CNV categories
--based on the rounded copy number just calculated.
WITH weighted AS (
    /* re-use the query above */
    WITH one_case AS (
        SELECT *
        FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
        WHERE "project_short_name" = 'TCGA-BRCA'
          AND "case_barcode" = (
                SELECT MIN("case_barcode")
                FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
                WHERE "project_short_name" = 'TCGA-BRCA')
    ),
    overlaps AS (
        SELECT
            c."cytoband_name",
            c."hg38_start",
            c."hg38_stop",
            s."copy_number",
            GREATEST(0,
              LEAST(c."hg38_stop", s."end_pos") -
              GREATEST(c."hg38_start", s."start_pos")) AS "ov"
        FROM one_case AS s
        JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" AS c
          ON c."chromosome" = s."chromosome"
        WHERE GREATEST(0,
              LEAST(c."hg38_stop", s."end_pos") -
              GREATEST(c."hg38_start", s."start_pos")) > 0
    )
    SELECT "cytoband_name",
           ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
    FROM overlaps
    GROUP BY "cytoband_name"
)
SELECT "cytoband_name",
       "rounded_cn",
       CASE
         WHEN "rounded_cn" = 0 THEN 'Homozygous Deletion'
         WHEN "rounded_cn" = 1 THEN 'Heterozygous Deletion'
         WHEN "rounded_cn" = 2 THEN 'Diploid'
         WHEN "rounded_cn" = 3 THEN 'Gain'
         WHEN "rounded_cn" > 3 THEN 'Amplification'
       END AS "cnv_type"
FROM weighted
LIMIT 20;
```

