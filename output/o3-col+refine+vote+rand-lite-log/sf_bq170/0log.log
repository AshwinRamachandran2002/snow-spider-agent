--Description: Do the weighted-copy-number & classification for *every* TCGA-BRCA
--case in Release 23 (still keeping only 20 rows so it remains lightweight here).
WITH overlaps AS (
    SELECT
        c."cytoband_name",
        c."hg38_start",
        c."hg38_stop",
        s."case_barcode",
        s."copy_number",
        GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) AS "ov"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" AS s
    JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" AS c
      ON c."chromosome" = s."chromosome"
    WHERE s."project_short_name" = 'TCGA-BRCA'
      AND GREATEST(0,
          LEAST(c."hg38_stop", s."end_pos") -
          GREATEST(c."hg38_start", s."start_pos")) > 0
),
weighted AS (
    SELECT
        "cytoband_name",
        "hg38_start",
        "hg38_stop",
        "case_barcode",
        ROUND(SUM("ov" * "copy_number") / NULLIF(SUM("ov"),0)) AS "rounded_cn"
    FROM overlaps
    GROUP BY "cytoband_name", "hg38_start", "hg38_stop", "case_barcode"
)
SELECT *
FROM weighted
LIMIT 20;
