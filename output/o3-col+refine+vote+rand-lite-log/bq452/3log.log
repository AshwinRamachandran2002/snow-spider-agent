Query:
--Description:  Join the variant calls with sample_info to map each sample to its
--              super-population, using the accessible dataset path.
SELECT
  c.`call_set_name` AS sample_id,
  si.`Super_Population`
FROM `genomics-public-data.1000_genomes.variants`      AS v,
     UNNEST(v.`call`)                                  AS c
JOIN `genomics-public-data.1000_genomes.sample_info`   AS si
  ON si.`Sample` = c.`call_set_name`
WHERE v.`reference_name` = '12'
LIMIT 20
