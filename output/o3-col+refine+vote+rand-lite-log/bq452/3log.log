Query:
--Description:  For a handful of chr-12 variants, count reference (allele 0) and
--              alternate (allele ≠0) alleles in cases (EAS) vs controls (non-EAS).
SELECT
  v.`start`,
  v.`end`,
  SUM(IF(si.`Super_Population` = 'EAS' AND g = 0, 1, 0)) AS eas_ref,
  SUM(IF(si.`Super_Population` = 'EAS' AND g <> 0, 1, 0)) AS eas_alt,
  SUM(IF(si.`Super_Population` <> 'EAS' AND g = 0, 1, 0)) AS oth_ref,
  SUM(IF(si.`Super_Population` <> 'EAS' AND g <> 0, 1, 0)) AS oth_alt
FROM `genomics-public-data.1000_genomes.variants`      AS v
CROSS JOIN UNNEST(v.`call`)                            AS c
JOIN `genomics-public-data.1000_genomes.sample_info`   AS si
  ON si.`Sample` = c.`call_set_name`
CROSS JOIN UNNEST(c.`genotype`)                        AS g
WHERE v.`reference_name` = '12'
GROUP BY v.`start`, v.`end`
LIMIT 20
