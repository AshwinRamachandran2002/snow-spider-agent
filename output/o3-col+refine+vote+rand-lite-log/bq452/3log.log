Query:
--Description:  Add a Yates-corrected χ² statistic for those variants (no
--              expected-count filtering yet) using the accessible tables.
SELECT
  vpos.*,
  n,
  (n * POW(ABS(a*d - b*c) - n/2.0, 2)) /
  ((a+b)*(c+d)*(a+c)*(b+d)) AS chi2_yates
FROM (
  SELECT
    v.`start`,
    v.`end`,
    SUM(IF(si.`Super_Population` = 'EAS' AND g = 0, 1, 0)) AS a,
    SUM(IF(si.`Super_Population` = 'EAS' AND g <> 0, 1, 0)) AS b,
    SUM(IF(si.`Super_Population` <> 'EAS' AND g = 0, 1, 0)) AS c,
    SUM(IF(si.`Super_Population` <> 'EAS' AND g <> 0, 1, 0)) AS d,
    COUNT(*) AS n
  FROM `genomics-public-data.1000_genomes.variants`    AS v
  CROSS JOIN UNNEST(v.`call`)                          AS c
  JOIN `genomics-public-data.1000_genomes.sample_info` AS si
    ON si.`Sample` = c.`call_set_name`
  CROSS JOIN UNNEST(c.`genotype`)                      AS g
  WHERE v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
) AS vpos
LIMIT 20
