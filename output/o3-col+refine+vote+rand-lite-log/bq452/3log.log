    SUM(IF(si.Super_Population = 'EAS' AND g != 0, 1, 0)) AS b, -- EAS alt
    SUM(IF(si.Super_Population != 'EAS' AND g = 0, 1, 0)) AS c, -- non-EAS ref
    SUM(IF(si.Super_Population != 'EAS' AND g != 0, 1, 0)) AS d -- non-EAS alt
