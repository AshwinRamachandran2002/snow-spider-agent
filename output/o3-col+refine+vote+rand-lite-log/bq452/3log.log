```sql
--Description:  Final answer – list chromosome-12 variants whose Yates-corrected
--              χ² statistic (EAS vs non-EAS) is at least 29.71679, showing the
--              start & end positions plus the χ² value.  The query:
--                1) tallies allele counts (a,b,c,d) for every variant (stats);
--                2) adds expected counts (exp);
--                3) keeps only tables with all expected cells ≥ 5 (filtered);
--                4) computes χ², applies the 29.71679 threshold, and orders by χ².
WITH stats AS (                               -- allele tallies
  SELECT
    v.`start`,
    v.`end`,
    SUM(IF(si.Super_Population = 'EAS' AND g = 0, 1, 0)) AS a,
    SUM(IF(si.Super_Population = 'EAS' AND g <> 0, 1, 0)) AS b,
    SUM(IF(si.Super_Population <> 'EAS' AND g = 0, 1, 0)) AS c,
    SUM(IF(si.Super_Population <> 'EAS' AND g <> 0, 1, 0)) AS d
  FROM `genomics-public-data.1000_genomes.variants`    AS v
  CROSS JOIN UNNEST(v.call)                            AS c
  JOIN `genomics-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype)                        AS g
  WHERE v.reference_name = '12'
    AND g <> -1                                        -- exclude missing alleles
  GROUP BY v.`start`, v.`end`
),
exp AS (                                 -- expected counts
  SELECT
    *,
    (a+b)*(a+c)/(a+b+c+d) AS exp_a,
    (a+b)*(b+d)/(a+b+c+d) AS exp_b,
    (c+d)*(a+c)/(a+b+c+d) AS exp_c,
    (c+d)*(b+d)/(a+b+c+d) AS exp_d
  FROM stats
),
filtered AS (                            -- retain only valid tables
  SELECT *
  FROM exp
  WHERE exp_a >= 5
    AND exp_b >= 5
    AND exp_c >= 5
    AND exp_d >= 5
)
SELECT
  `start`,
  `end`,
  ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0, 2) ) /
  ( (a+b)*(c+d)*(a+c)*(b+d) ) AS chi2_yates
FROM filtered
WHERE ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0, 2) ) /
      ( (a+b)*(c+d)*(a+c)*(b+d) ) >= 29.71679
ORDER BY chi2_yates DESC
LIMIT 20;
```
