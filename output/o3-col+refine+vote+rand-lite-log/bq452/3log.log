```sql
-- 1. Description: Inspect the distinct super-population codes available in the study.
SELECT DISTINCT `Super_Population`
FROM   `spider2-public-data.1000_genomes.sample_info`
LIMIT 20;
```

```sql
-- 2. Description: Count how many samples belong to each super-population.
SELECT `Super_Population`,
       COUNT(*) AS sample_cnt
FROM   `spider2-public-data.1000_genomes.sample_info`
GROUP  BY `Super_Population`
ORDER  BY sample_cnt DESC
LIMIT 20;
```

```sql
-- 3. Description: Look at a few variants that are located on chromosome 12.
SELECT  `reference_name`, `start`, `end`, `reference_bases`, `alternate_bases`
FROM    `spider2-public-data.1000_genomes.variants`
WHERE   `reference_name` = '12'
LIMIT   20;
```

```sql
-- 4. Description: Peek inside the “call” array for a single chromosome-12 variant
--                 to understand the fields we will use (sample name & genotype).
SELECT  v.`start`,
        c.`call_set_name`           AS sample_id,
        c.`genotype`                AS genotype_array
FROM    `spider2-public-data.1000_genomes.variants`  AS v,
        UNNEST(v.`call`)            AS c
WHERE   v.`reference_name` = '12'
LIMIT   20;
```

```sql
-- 5. Description: Join those calls to the sample_info table to obtain
--                 the super-population of each sample.
SELECT  c.`call_set_name`                   AS sample_id,
        si.`Super_Population`
FROM    `spider2-public-data.1000_genomes.variants` AS v,
        UNNEST(v.`call`)                   AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
  ON    si.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` = '12'
LIMIT   20;
```

```sql
-- 6. Description: Count reference (allele-index 0) and alternate (allele-index >0)
--                 alleles for EAS cases versus non-EAS controls, for a handful of
--                 chromosome-12 variants.
SELECT  v.`start`,
        v.`end`,
        SUM(IF(si.`Super_Population`='EAS' AND g=0, 1, 0)) AS eas_ref,
        SUM(IF(si.`Super_Population`='EAS' AND g>0, 1, 0)) AS eas_alt,
        SUM(IF(si.`Super_Population`!='EAS'AND g=0, 1, 0)) AS oth_ref,
        SUM(IF(si.`Super_Population`!='EAS'AND g>0, 1, 0)) AS oth_alt
FROM    `spider2-public-data.1000_genomes.variants` AS v
CROSS   JOIN UNNEST(v.`call`)                    AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
  ON    si.`Sample` = c.`call_set_name`
CROSS   JOIN UNNEST(c.`genotype`)               AS g        -- one row per allele
WHERE   v.`reference_name` = '12'
GROUP BY v.`start`, v.`end`
LIMIT   20;
```

```sql
-- 7. Description: For those same variants, add Yates-corrected χ² statistics
--                 (without yet filtering on the expected-count rule).
SELECT  vpos.*, 
        n,
        (n*POW(ABS(a*d - b*c) - n/2.0 ,2)) / ((a+b)*(c+d)*(a+c)*(b+d))  AS chi2_yates
FROM  (
        SELECT  v.`start`,
                v.`end`,
                SUM(IF(si.`Super_Population`='EAS' AND g=0, 1, 0)) AS a, --cases ref
                SUM(IF(si.`Super_Population`='EAS' AND g>0, 1, 0)) AS b, --cases alt
                SUM(IF(si.`Super_Population`!='EAS'AND g=0, 1, 0)) AS c, --ctrl ref
                SUM(IF(si.`Super_Population`!='EAS'AND g>0, 1, 0)) AS d, --ctrl alt
                COUNT(1)                                              AS n
        FROM    `spider2-public-data.1000_genomes.variants` AS v
        CROSS   JOIN UNNEST(v.`call`)                 AS c
        JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
          ON    si.`Sample` = c.`call_set_name`
        CROSS   JOIN UNNEST(c.`genotype`)            AS g
        WHERE   v.`reference_name` = '12'
        GROUP BY v.`start`, v.`end`
      ) vpos
LIMIT 20;
```

```sql
-- 8. Description: Add expected counts for each cell and keep only rows where
--                 every expected count is ≥ 5 (the rule requested).
WITH ct AS (
  SELECT  v.`start`,
          v.`end`,
          SUM(IF(si.`Super_Population`='EAS' AND g=0, 1, 0)) AS a,
          SUM(IF(si.`Super_Population`='EAS' AND g>0, 1, 0)) AS b,
          SUM(IF(si.`Super_Population`!='EAS'AND g=0, 1, 0)) AS c,
          SUM(IF(si.`Super_Population`!='EAS'AND g>0, 1, 0)) AS d
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  CROSS   JOIN UNNEST(v.`call`)                  AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
    ON    si.`Sample` = c.`call_set_name`
  CROSS   JOIN UNNEST(c.`genotype`)             AS g
  WHERE   v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
)
SELECT *,
       (a+b)*(a+c)/(a+b+c+d)   AS exp_a,
       (a+b)*(b+d)/(a+b+c+d)   AS exp_b,
       (c+d)*(a+c)/(a+b+c+d)   AS exp_c,
       (c+d)*(b+d)/(a+b+c+d)   AS exp_d
FROM   ct
WHERE  (a+b)*(a+c)/(a+b+c+d) >= 5
  AND  (a+b)*(b+d)/(a+b+c+d) >= 5
  AND  (c+d)*(a+c)/(a+b+c+d) >= 5
  AND  (c+d)*(b+d)/(a+b+c+d) >= 5
LIMIT 20;
```

```sql
-- 9. Description: Compute the Yates-corrected χ² on *all* chr-12 variants,
--                 keeping only those that satisfy the expected-count rule,
--                 and order by the statistic (largest first).
WITH stats AS (
  SELECT  v.`start`,
          v.`end`,
          SUM(IF(si.`Super_Population`='EAS' AND g=0, 1, 0)) AS a,
          SUM(IF(si.`Super_Population`='EAS' AND g>0, 1, 0)) AS b,
          SUM(IF(si.`Super_Population`!='EAS'AND g=0, 1, 0)) AS c,
          SUM(IF(si.`Super_Population`!='EAS'AND g>0, 1, 0)) AS d
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  CROSS   JOIN UNNEST(v.`call`)                    AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
    ON    si.`Sample` = c.`call_set_name`
  CROSS   JOIN UNNEST(c.`genotype`)               AS g
  WHERE   v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
),
filtered AS (
  SELECT *,
         (a+b)*(a+c)/(a+b+c+d) AS exp_a,
         (a+b)*(b+d)/(a+b+c+d) AS exp_b,
         (c+d)*(a+c)/(a+b+c+d) AS exp_c,
         (c+d)*(b+d)/(a+b+c+d) AS exp_d
  FROM   stats
  WHERE  (a+b)*(a+c)/(a+b+c+d) >= 5
    AND  (a+b)*(b+d)/(a+b+c+d) >= 5
    AND  (c+d)*(a+c)/(a+b+c+d) >= 5
    AND  (c+d)*(b+d)/(a+b+c+d) >= 5
)
SELECT  `start`,
        `end`,
        ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0 , 2) )
        / ( (a+b)*(c+d)*(a+c)*(b+d) )                         AS chi2_yates
FROM    filtered
ORDER BY chi2_yates DESC
LIMIT 20;
```

```sql
-- 10. Description: Final answer – chromosome-12 variants whose
--                  Yates-corrected χ² ≥ 29.71679, showing position & score.
WITH stats AS (
  SELECT  v.`start`,
          v.`end`,
          SUM(IF(si.`Super_Population`='EAS' AND g=0, 1, 0)) AS a,
          SUM(IF(si.`Super_Population`='EAS' AND g>0, 1, 0)) AS b,
          SUM(IF(si.`Super_Population`!='EAS'AND g=0, 1, 0)) AS c,
          SUM(IF(si.`Super_Population`!='EAS'AND g>0, 1, 0)) AS d
  FROM    `spider2-public-data.1000_genomes.variants` AS v
  CROSS   JOIN UNNEST(v.`call`)                    AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS si
    ON    si.`Sample` = c.`call_set_name`
  CROSS   JOIN UNNEST(c.`genotype`)               AS g
  WHERE   v.`reference_name` = '12'
  GROUP BY v.`start`, v.`end`
),
filtered AS (
  SELECT *,
         (a+b)*(a+c)/(a+b+c+d) AS exp_a,
         (a+b)*(b+d)/(a+b+c+d) AS exp_b,
         (c+d)*(a+c)/(a+b+c+d) AS exp_c,
         (c+d)*(b+d)/(a+b+c+d) AS exp_d
  FROM   stats
  WHERE  (a+b)*(a+c)/(a+b+c+d) >= 5
    AND  (a+b)*(b+d)/(a+b+c+d) >= 5
    AND  (c+d)*(a+c)/(a+b+c+d) >= 5
    AND  (c+d)*(b+d)/(a+b+c+d) >= 5
)
SELECT  `start`,
        `end`,
        ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0 , 2) )
        / ( (a+b)*(c+d)*(a+c)*(b+d) )          AS chi2_yates
FROM    filtered
WHERE   ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0 , 2) )
        / ( (a+b)*(c+d)*(a+c)*(b+d) )  >= 29.71679
ORDER BY chi2_yates DESC
LIMIT 20;
```
