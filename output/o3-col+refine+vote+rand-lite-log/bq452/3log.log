```sql
--Description:  To pinpoint chromosome-12 variants that show a strong difference
--              in allele frequencies between ‘cases’ (EAS super-population) and
--              all other individuals (‘controls’), this single query:
--              1) Explodes every allele of every genotype call on chr-12.
--              2) Tallies reference (allele = 0) and alternate (allele ≠ 0) counts
--                 separately for cases (EAS) and controls (non-EAS).
--              3) Keeps only variants whose four expected counts are each ≥ 5, as
--                 required for the chi-squared test’s validity.
--              4) Applies Yates’s continuity-corrected χ² formula.
--              5) Returns the variant positions whose χ² statistic is at least
--                 29.71679, ordered by that statistic.
WITH tallies AS (
  SELECT
      v.start,
      v.end,
      SUM(CASE WHEN si.Super_Population = 'EAS' AND g = 0 THEN 1 ELSE 0 END) a, --cases ref
      SUM(CASE WHEN si.Super_Population = 'EAS' AND g <> 0 THEN 1 ELSE 0 END) b, --cases alt
      SUM(CASE WHEN si.Super_Population <> 'EAS' AND g = 0 THEN 1 ELSE 0 END) c, --ctrls ref
      SUM(CASE WHEN si.Super_Population <> 'EAS' AND g <> 0 THEN 1 ELSE 0 END) d  --ctrls alt
  FROM `spider2-public-data.1000_genomes.variants`  AS v
  CROSS JOIN UNNEST(v.call)        AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS si
    ON si.Sample = c.call_set_name
  CROSS JOIN UNNEST(c.genotype)    AS g
  WHERE v.reference_name = '12'
    AND g <> -1                    -- ignore missing alleles
  GROUP BY v.start, v.end
),
filtered AS (
  SELECT *,
         (a+b)*(a+c)/(a+b+c+d) AS exp_a,
         (a+b)*(b+d)/(a+b+c+d) AS exp_b,
         (c+d)*(a+c)/(a+b+c+d) AS exp_c,
         (c+d)*(b+d)/(a+b+c+d) AS exp_d
  FROM tallies
  WHERE (a+b)*(a+c)/(a+b+c+d) >= 5
    AND (a+b)*(b+d)/(a+b+c+d) >= 5
    AND (c+d)*(a+c)/(a+b+c+d) >= 5
    AND (c+d)*(b+d)/(a+b+c+d) >= 5
)
SELECT
    start,
    end,
    ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0, 2) ) /
    ( (a+b)*(c+d)*(a+c)*(b+d) )          AS chi2_yates
FROM filtered
WHERE ( (a+b+c+d) * POW(ABS(a*d - b*c) - (a+b+c+d)/2.0, 2) ) /
      ( (a+b)*(c+d)*(a+c)*(b+d) ) >= 29.71679
ORDER BY chi2_yates DESC;
```
