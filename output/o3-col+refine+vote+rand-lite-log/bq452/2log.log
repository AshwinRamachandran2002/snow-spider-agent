```sql
-- 3. Explode the previous variant’s calls to see allele copies carried by each sample
SELECT
  c.call_set_name  AS sample,
  s.Super_Population,
  (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) AS ref_cnt,
  (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) AS alt_cnt
FROM `spider2-public-data.1000_genomes.variants`   AS v
JOIN UNNEST(v.call)                               AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
WHERE v.reference_name = '12'
  AND v.start = 12153500      --  use a start from query-2 result
LIMIT 20;
```

```sql
-- 4. Aggregate that single variant by super-population
SELECT
  v.start, v.end,
  s.Super_Population,
  SUM((SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a)) AS ref_alleles,
  SUM((SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a)) AS alt_alleles
FROM `spider2-public-data.1000_genomes.variants`   AS v
JOIN UNNEST(v.call)                               AS c
JOIN `spider2-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
WHERE v.reference_name = '12'
  AND v.start = 12153500
GROUP BY v.start, v.end, s.Super_Population
ORDER BY s.Super_Population
LIMIT 20;
```

```sql
-- 5. Produce allele counts (EAS vs Non-EAS) for every variant on chromosome-12
WITH allele_counts AS (
  SELECT
    v.start, v.end,
    SUM(CASE WHEN s.Super_Population = 'EAS' THEN
         (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_EAS,
    SUM(CASE WHEN s.Super_Population = 'EAS' THEN
         (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_EAS,
    SUM(CASE WHEN s.Super_Population != 'EAS' THEN
         (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_nonEAS,
    SUM(CASE WHEN s.Super_Population != 'EAS' THEN
         (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_nonEAS
  FROM `spider2-public-data.1000_genomes.variants`   AS v
  JOIN UNNEST(v.call)                               AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end
)
SELECT * FROM allele_counts
LIMIT 20;
```

```sql
-- 6. Add totals and expected counts with Yates continuity correction
WITH counts AS (
  SELECT *,
    (ref_EAS + alt_EAS)                          AS total_EAS,
    (ref_nonEAS + alt_nonEAS)                    AS total_nonEAS,
    (ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS) AS grand_total,
    (alt_EAS + alt_nonEAS)                       AS alt_total,
    (ref_EAS + ref_nonEAS)                       AS ref_total
  FROM (
    -- reuse CTE from query-5
    SELECT * FROM (
      SELECT
        v.start, v.end,
        SUM(CASE WHEN s.Super_Population = 'EAS' THEN
             (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_EAS,
        SUM(CASE WHEN s.Super_Population = 'EAS' THEN
             (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_EAS,
        SUM(CASE WHEN s.Super_Population != 'EAS' THEN
             (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_nonEAS,
        SUM(CASE WHEN s.Super_Population != 'EAS' THEN
             (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_nonEAS
      FROM `spider2-public-data.1000_genomes.variants` AS v
      JOIN UNNEST(v.call)                         AS c
      JOIN `spider2-public-data.1000_genomes.sample_info` AS s
        ON s.Sample = c.call_set_name
      WHERE v.reference_name = '12'
      GROUP BY v.start, v.end
    )
  )
)
SELECT
  start, end,
  ref_EAS, alt_EAS, ref_nonEAS, alt_nonEAS,
  alt_total * total_EAS  / grand_total AS exp_alt_EAS,
  alt_total * total_nonEAS / grand_total AS exp_alt_nonEAS
FROM counts
LIMIT 20;
```

```sql
-- 7. Calculate the chi-square statistic (with Yates correction) for all chr-12 variants
WITH stats AS (
  SELECT *,
    (ref_EAS + alt_EAS)                            AS total_EAS,
    (ref_nonEAS + alt_nonEAS)                      AS total_nonEAS,
    (ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS)  AS grand_total,
    (alt_EAS + alt_nonEAS)                         AS alt_total,
    (ref_EAS + ref_nonEAS)                         AS ref_total
  FROM (
    -- same aggregation as query-5
    SELECT
      v.start, v.end,
      SUM(CASE WHEN s.Super_Population = 'EAS' THEN
           (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_EAS,
      SUM(CASE WHEN s.Super_Population = 'EAS' THEN
           (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_EAS,
      SUM(CASE WHEN s.Super_Population != 'EAS' THEN
           (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_nonEAS,
      SUM(CASE WHEN s.Super_Population != 'EAS' THEN
           (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_nonEAS
    FROM `spider2-public-data.1000_genomes.variants` AS v
    JOIN UNNEST(v.call)                           AS c
    JOIN `spider2-public-data.1000_genomes.sample_info` AS s
      ON s.Sample = c.call_set_name
    WHERE v.reference_name = '12'
    GROUP BY v.start, v.end
  )
),
expected AS (
  SELECT *,
    alt_total * total_EAS      / grand_total AS exp_alt_EAS,
    alt_total * total_nonEAS   / grand_total AS exp_alt_nonEAS,
    ref_total * total_EAS      / grand_total AS exp_ref_EAS,
    ref_total * total_nonEAS   / grand_total AS exp_ref_nonEAS
  FROM stats
),
chi AS (
  SELECT *,
    -- Yates corrected χ²
    (
      POWER(ABS(alt_EAS     - exp_alt_EAS)  - 0.5, 2) / exp_alt_EAS  +
      POWER(ABS(alt_nonEAS  - exp_alt_nonEAS) - 0.5, 2) / exp_alt_nonEAS +
      POWER(ABS(ref_EAS     - exp_ref_EAS)  - 0.5, 2) / exp_ref_EAS  +
      POWER(ABS(ref_nonEAS  - exp_ref_nonEAS) - 0.5, 2) / exp_ref_nonEAS
    ) AS chi_sq
  FROM expected
  WHERE LEAST(exp_alt_EAS, exp_alt_nonEAS, exp_ref_EAS, exp_ref_nonEAS) >= 5
)
SELECT start, end, chi_sq
FROM chi
LIMIT 20;
```

```sql
-- 8. Filter variants whose chi-square is ≥ 29.71679 (Yates) on chromosome-12
WITH stats AS (
  SELECT
    v.start, v.end,
    SUM(CASE WHEN s.Super_Population = 'EAS' THEN
         (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_EAS,
    SUM(CASE WHEN s.Super_Population = 'EAS' THEN
         (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_EAS,
    SUM(CASE WHEN s.Super_Population != 'EAS' THEN
         (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a) END) AS ref_nonEAS,
    SUM(CASE WHEN s.Super_Population != 'EAS' THEN
         (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a) END) AS alt_nonEAS
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call)                           AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end
),
calc AS (
  SELECT *,
    (ref_EAS + alt_EAS)                           AS total_EAS,
    (ref_nonEAS + alt_nonEAS)                     AS total_nonEAS,
    (ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS) AS grand_total,
    (alt_EAS + alt_nonEAS)                        AS alt_total,
    (ref_EAS + ref_nonEAS)                        AS ref_total
  FROM stats
),
exp AS (
  SELECT *,
    alt_total * total_EAS    / grand_total AS eaE,
    alt_total * total_nonEAS / grand_total AS eaN,
    ref_total * total_EAS    / grand_total AS erE,
    ref_total * total_nonEAS / grand_total AS erN
  FROM calc
  WHERE LEAST(
          alt_total * total_EAS    / grand_total,
          alt_total * total_nonEAS / grand_total,
          ref_total * total_EAS    / grand_total,
          ref_total * total_nonEAS / grand_total
        ) >= 5
),
chi AS (
  SELECT
    start, end,
    (
      POWER(ABS(alt_EAS    - eaE) - 0.5, 2) / eaE +
      POWER(ABS(alt_nonEAS - eaN) - 0.5, 2) / eaN +
      POWER(ABS(ref_EAS    - erE) - 0.5, 2) / erE +
      POWER(ABS(ref_nonEAS - erN) - 0.5, 2) / erN
    ) AS chi_sq
  FROM exp
)
SELECT start, end, chi_sq
FROM chi
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 20;
```

```sql
-- 9. (Final answer) Top chromosome-12 variants whose corrected χ² ≥ 29.71679
WITH allele AS (
  SELECT
    v.start, v.end,
    SUM(CASE WHEN s.Super_Population = 'EAS'
             THEN (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a)
        END)                       AS alt_EAS,
    SUM(CASE WHEN s.Super_Population = 'EAS'
             THEN (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a)
        END)                       AS ref_EAS,
    SUM(CASE WHEN s.Super_Population != 'EAS'
             THEN (SELECT COUNTIF(a = 1) FROM UNNEST(c.genotype) AS a)
        END)                       AS alt_nonEAS,
    SUM(CASE WHEN s.Super_Population != 'EAS'
             THEN (SELECT COUNTIF(a = 0) FROM UNNEST(c.genotype) AS a)
        END)                       AS ref_nonEAS
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call) AS c
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.end
), stats AS (
  SELECT *,
    (ref_EAS + alt_EAS)                         AS tot_EAS,
    (ref_nonEAS + alt_nonEAS)                   AS tot_nonEAS,
    (ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS) AS grand,
    (alt_EAS + alt_nonEAS)                      AS alt_tot,
    (ref_EAS + ref_nonEAS)                      AS ref_tot
  FROM allele
), exp AS (
  SELECT *,
    alt_tot * tot_EAS    / grand AS eaE,
    alt_tot * tot_nonEAS / grand AS eaN,
    ref_tot * tot_EAS    / grand AS erE,
    ref_tot * tot_nonEAS / grand AS erN
  FROM stats
  WHERE LEAST(
          alt_tot * tot_EAS    / grand,
          alt_tot * tot_nonEAS / grand,
          ref_tot * tot_EAS    / grand,
          ref_tot * tot_nonEAS / grand
        ) >= 5
), chi AS (
  SELECT
    start, end,
    (
      POWER(ABS(alt_EAS    - eaE) - 0.5, 2) / eaE +
      POWER(ABS(alt_nonEAS - eaN) - 0.5, 2) / eaN +
      POWER(ABS(ref_EAS    - erE) - 0.5, 2) / erE +
      POWER(ABS(ref_nonEAS - erN) - 0.5, 2) / erN
    ) AS chi_sq
  FROM exp
)
SELECT start, end, chi_sq
FROM chi
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC
LIMIT 100;
```

