```sql
--Description: Aggregate alleles of a single chromosome-12 variant (the first one found)
--by super-population.  A CTE selects the first chr-12 start/`end`; that coordinate is
--used to join the full variants table, explode its calls, attach metadata, and sum
--reference vs. alternate allele counts per super-population.

WITH first_var AS (
  SELECT start, `end`
  FROM `genomics-public-data.1000_genomes.variants`
  WHERE reference_name = '12'
  LIMIT 1
)
SELECT
  v.start,
  v.`end`,
  s.Super_Population,
  SUM((SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g)) AS ref_alleles,
  SUM((SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g)) AS alt_alleles
FROM `genomics-public-data.1000_genomes.variants` AS v
JOIN first_var fv
  ON v.start = fv.start AND v.`end` = fv.`end`
JOIN UNNEST(v.call) AS c
LEFT JOIN `genomics-public-data.1000_genomes.sample_info` AS s
  ON s.Sample = c.call_set_name
GROUP BY v.start, v.`end`, s.Super_Population
ORDER BY s.Super_Population
LIMIT 20;
