--Description: Count how many chromosome-12 variants pass the χ² ≥ 29.71679 threshold.

WITH allele AS (
  SELECT
    v.start,
    v.`end`,
    SUM(CASE WHEN s.Super_Population = 'EAS'
             THEN (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g) END) AS alt_EAS,
    SUM(CASE WHEN s.Super_Population = 'EAS'
             THEN (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g) END) AS ref_EAS,
    SUM(CASE WHEN s.Super_Population <> 'EAS'
             THEN (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g) END) AS alt_nonEAS,
    SUM(CASE WHEN s.Super_Population <> 'EAS'
             THEN (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g) END) AS ref_nonEAS
  FROM `genomics-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call) AS c
  LEFT JOIN `genomics-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.`end`
), stats AS (
  SELECT *,
         (ref_EAS + alt_EAS)                           AS tot_EAS,
         (ref_nonEAS + alt_nonEAS)                     AS tot_nonEAS,
         (ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS) AS grand,
         (alt_EAS + alt_nonEAS)                        AS alt_tot,
         (ref_EAS + ref_nonEAS)                        AS ref_tot
  FROM allele
), exp AS (
  SELECT *,
         alt_tot * tot_EAS    / grand AS eaE,
         alt_tot * tot_nonEAS / grand AS eaN,
         ref_tot * tot_EAS    / grand AS erE,
         ref_tot * tot_nonEAS / grand AS erN
  FROM stats
  WHERE LEAST(eaE, eaN, erE, erN) >= 5
), chi AS (
  SELECT
    start,
    `end`,
    ( POWER(ABS(alt_EAS    - eaE) - 0.5, 2) / eaE +
      POWER(ABS(alt_nonEAS - eaN) - 0.5, 2) / eaN +
      POWER(ABS(ref_EAS    - erE) - 0.5, 2) / erE +
      POWER(ABS(ref_nonEAS - erN) - 0.5, 2) / erN ) AS chi_sq
  FROM exp
)
SELECT COUNT(*) AS variants_passing_threshold
FROM chi
WHERE chi_sq >= 29.71679;
