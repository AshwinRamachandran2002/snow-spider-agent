--Description: Add totals & expected counts (Yates) for chromosome-12 variants (public tables).
WITH counts AS (
  SELECT *,
         (ref_EAS + alt_EAS)                         AS total_EAS,
         (ref_nonEAS + alt_nonEAS)                   AS total_nonEAS,
         (ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS) AS grand_total,
         (alt_EAS + alt_nonEAS)                      AS alt_total,
         (ref_EAS + ref_nonEAS)                      AS ref_total
  FROM (
    -- reuse allele aggregation above
    SELECT
      v.start, v.`end`,
      SUM(CASE WHEN s.super_population = 'EAS'
               THEN (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g) END) AS ref_EAS,
      SUM(CASE WHEN s.super_population = 'EAS'
               THEN (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g) END) AS alt_EAS,
      SUM(CASE WHEN s.super_population <> 'EAS'
               THEN (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g) END) AS ref_nonEAS,
      SUM(CASE WHEN s.super_population <> 'EAS'
               THEN (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g) END) AS alt_nonEAS
    FROM `genomics-public-data.1000_genomes.variants` AS v
    JOIN UNNEST(v.call) AS c
    JOIN `genomics-public-data.1000_genomes.sample_info` AS s
      ON s.sample = c.call_set_name
    WHERE v.reference_name = '12'
    GROUP BY v.start, v.`end`
  )
)
SELECT
  start,
  `end`,
  ref_EAS, alt_EAS, ref_nonEAS, alt_nonEAS,
  alt_total * total_EAS    / grand_total AS exp_alt_EAS,
  alt_total * total_nonEAS / grand_total AS exp_alt_nonEAS
FROM counts
LIMIT 20;
