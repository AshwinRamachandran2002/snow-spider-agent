```sql
--Description: Compute Yates-corrected χ² for every chromosome-12 variant.
-- 1) Count reference (0) and alternate (1) allele copies carried by EAS cases
--    and non-EAS controls for each variant.
-- 2) Derive row/column totals and the four expected counts
--    (exp_alt_EAS, exp_alt_nonEAS, exp_ref_EAS, exp_ref_nonEAS).
-- 3) Keep variants whose expected counts are all ≥ 5.
-- 4) Apply Yates continuity correction and return the first 20 χ² values.

WITH allele_counts AS (      -- step 1: raw counts
  SELECT
    v.start,
    v.`end`,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g), 0)) AS ref_EAS,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g), 0)) AS alt_EAS,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g), 0)) AS ref_nonEAS,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g), 0)) AS alt_nonEAS
  FROM `genomics-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) AS c
  LEFT JOIN `genomics-public-data.1000_genomes.sample_info` s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.`end`
),
totals AS (                  -- step 2: totals & expected counts
  SELECT *,
         ref_EAS + alt_EAS                         AS tot_EAS,
         ref_nonEAS + alt_nonEAS                   AS tot_nonEAS,
         ref_EAS + alt_EAS + ref_nonEAS + alt_nonEAS AS grand,
         alt_EAS + alt_nonEAS                      AS alt_tot,
         ref_EAS + ref_nonEAS                      AS ref_tot,
         -- expected counts
         alt_tot * tot_EAS    / grand              AS exp_alt_EAS,
         alt_tot * tot_nonEAS / grand              AS exp_alt_nonEAS,
         ref_tot * tot_EAS    / grand              AS exp_ref_EAS,
         ref_tot * tot_nonEAS / grand              AS exp_ref_nonEAS
  FROM allele_counts
  WHERE LEAST(
          alt_tot * tot_EAS    / grand,
          alt_tot * tot_nonEAS / grand,
          ref_tot * tot_EAS    / grand,
          ref_tot * tot_nonEAS / grand
        ) >= 5                                   -- step 3: expected ≥ 5
)
SELECT
  start,
  `end`,
  -- step 4: Yates-corrected χ²
  (
    POWER(ABS(alt_EAS    - exp_alt_EAS)  - 0.5, 2) / exp_alt_EAS  +
    POWER(ABS(alt_nonEAS - exp_alt_nonEAS) - 0.5, 2) / exp_alt_nonEAS +
    POWER(ABS(ref_EAS    - exp_ref_EAS)  - 0.5, 2) / exp_ref_EAS  +
    POWER(ABS(ref_nonEAS - exp_ref_nonEAS) - 0.5, 2) / exp_ref_nonEAS
  ) AS chi_sq
FROM totals
LIMIT 20;
