--Description: Calculate Yates-corrected χ² for every chromosome-12 variant.
--1) Count reference (0) and alternate (1) alleles in EAS vs non-EAS samples.
--2) Derive totals, expected counts (exp_*).  Keep variants whose four expected
--   cells are all ≥ 5 (requirement for chi-square test).
--3) Compute the Yates-corrected χ² statistic and return the first 20 rows.

WITH stats AS (                 -- allele counts
  SELECT
    v.start,
    v.`end`,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g), 0)) AS ref_EAS,
    SUM(IF(s.Super_Population = 'EAS',
           (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g), 0)) AS alt_EAS,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) AS g), 0)) AS ref_nonEAS,
    SUM(IF(s.Super_Population <> 'EAS',
           (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) AS g), 0)) AS alt_nonEAS
  FROM `genomics-public-data.1000_genomes.variants` v
  JOIN UNNEST(v.call) AS c
  LEFT JOIN `genomics-public-data.1000_genomes.sample_info` s
    ON s.Sample = c.call_set_name
  WHERE v.reference_name = '12'
  GROUP BY v.start, v.`end`
),
tot AS (
