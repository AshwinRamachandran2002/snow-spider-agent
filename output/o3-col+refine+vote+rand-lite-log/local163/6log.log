```sql
-- 1) Distinct faculty ranks available in the table
SELECT DISTINCT "FacRank"
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 2) Quick look at faculty names and salaries
SELECT "FacFirstName",
       "FacLastName",
       "FacRank",
       "FacSalary"
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 3) Compute the average salary for each rank
SELECT "FacRank",
       AVG("FacSalary") AS "avg_salary"
FROM "university_faculty"
GROUP BY "FacRank"
LIMIT 20;
```

```sql
-- 4) For every faculty member, calculate the difference from their rank’s average
SELECT "FacNo",
       "FacFirstName",
       "FacLastName",
       "FacRank",
       "FacSalary",
       ABS("FacSalary" - AVG("FacSalary") OVER (PARTITION BY "FacRank")) AS "salary_diff"
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 5) Minimum salary-difference (closest to average) for each rank
SELECT "FacRank",
       MIN(ABS("FacSalary" - AVG("FacSalary") OVER (PARTITION BY "FacRank"))) AS "min_diff"
FROM "university_faculty"
GROUP BY "FacRank"
LIMIT 20;
```

```sql
-- 6) Identify the faculty member(s) whose salary difference equals the minimum for their rank
WITH diff_cte AS (
    SELECT "FacNo",
           "FacFirstName",
           "FacLastName",
           "FacRank",
           "FacSalary",
           ABS("FacSalary" - AVG("FacSalary") OVER (PARTITION BY "FacRank")) AS "salary_diff"
    FROM "university_faculty"
),
min_cte AS (
    SELECT "FacRank",
           MIN("salary_diff") AS "min_diff"
    FROM diff_cte
    GROUP BY "FacRank"
)
SELECT d."FacRank",
       d."FacFirstName",
       d."FacLastName",
       d."FacSalary"
FROM diff_cte AS d
JOIN min_cte AS m
  ON d."FacRank" = m."FacRank"
 AND d."salary_diff" = m."min_diff"
LIMIT 20;
```

