Query:
--Description:
-- Query 6 (corrected): identify the faculty member(s) whose salary is closest to the average salary of their own rank.
-- Steps:
--   1. rank_avg  – average salary by rank.
--   2. diffs     – absolute salary difference from the rank average for every faculty member.
--   3. rank_min  – minimum of those differences per rank.
--   4. final     – faculty whose difference equals that minimum.
WITH rank_avg AS (
    SELECT
        "FacRank",
        AVG("FacSalary") AS avg_salary
    FROM "university_faculty"
    GROUP BY "FacRank"
),
diffs AS (
    SELECT
        f."FacNo",
        f."FacFirstName",
        f."FacLastName",
        f."FacRank",
        f."FacSalary",
        ABS(f."FacSalary" - ra.avg_salary) AS salary_diff
    FROM "university_faculty" AS f
    JOIN rank_avg AS ra
      ON f."FacRank" = ra."FacRank"
),
rank_min AS (
    SELECT
        "FacRank",
        MIN(salary_diff) AS min_diff
    FROM diffs
    GROUP BY "FacRank"
)
SELECT
    d."FacRank",
    d."FacFirstName",
    d."FacLastName",
    d."FacSalary"
FROM diffs AS d
JOIN rank_min AS rm
  ON d."FacRank" = rm."FacRank"
 AND d.salary_diff = rm.min_diff
LIMIT 20
Answer:
FacRank,FacFirstName,FacLastName,FacSalary
ASSC,JULIA,MILLS,75000
ASSC,LEONARD,FIBON,70000
ASST,CRISTOPHER,COLAN,40000
PROF,JANE,SMITH,110000
