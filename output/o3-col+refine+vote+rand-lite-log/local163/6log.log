        f."FacNo",
        f."FacFirstName",
        f."FacLastName",
        f."FacRank",
        f."FacSalary",
        ABS(f."FacSalary" - ra.avg_salary) AS salary_diff
    FROM "university_faculty" AS f
    JOIN rank_avg AS ra
      ON f."FacRank" = ra."FacRank"
),
rank_min AS (
    SELECT
        "FacRank",
        MIN(salary_diff) AS min_diff
    FROM diffs
    GROUP BY "FacRank"
)
SELECT
    d."FacRank",
    d."FacFirstName",
    d."FacLastName",
    d."FacSalary"
