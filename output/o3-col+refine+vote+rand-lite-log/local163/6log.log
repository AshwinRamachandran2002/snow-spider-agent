```sql
--Description:
-- Goal: identify the university faculty member(s) whose salary is closest to the average salary of their own rank.
-- Step 1 (rank_avg):   Compute the average salary for each rank (ASST, ASSC, PROF).
-- Step 2 (diffs):      For every faculty member, calculate the absolute difference between their salary and
--                      the average salary of their rank.
-- Step 3 (rank_min):   For each rank, find the minimum of those differences – i.e., the smallest gap to the
--                      rank’s average.
-- Step 4 (final sel.): Return the faculty whose salary-difference equals that minimum, showing their rank,
--                      first name, last name, and salary.
WITH rank_avg AS (
    SELECT
        "FacRank",
        AVG("FacSalary") AS avg_salary
    FROM "university_faculty"
    GROUP BY "FacRank"
),
diffs AS (
    SELECT
        f."FacRank",
        f."FacFirstName",
        f."FacLastName",
        f."FacSalary",
        ABS(f."FacSalary" - ra.avg_salary) AS diff_to_avg
    FROM "university_faculty" AS f
    JOIN rank_avg AS ra
      ON f."FacRank" = ra."FacRank"
),
rank_min AS (
    SELECT
        "FacRank",
        MIN(diff_to_avg) AS min_diff
    FROM diffs
    GROUP BY "FacRank"
)
SELECT
    d."FacRank",
    d."FacFirstName",
    d."FacLastName",
    d."FacSalary"
FROM diffs AS d
JOIN rank_min AS rm
  ON d."FacRank" = rm."FacRank"
 AND d.diff_to_avg = rm.min_diff
ORDER BY d."FacRank";
```
