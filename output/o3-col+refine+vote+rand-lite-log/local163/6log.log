    FROM "university_faculty"
),
min_cte AS (
    SELECT "FacRank",
           MIN("salary_diff") AS "min_diff"
    FROM diff_cte
    GROUP BY "FacRank"
)
SELECT d."FacRank",
       d."FacFirstName",
       d."FacLastName",
       d."FacSalary"
FROM diff_cte AS d
JOIN min_cte AS m
  ON d."FacRank" = m."FacRank"
 AND d."salary_diff" = m."min_diff";
```

