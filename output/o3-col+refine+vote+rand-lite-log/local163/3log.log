-- 8) Description: Order the above result alphabetically by rank then last name (optional refinement).
SELECT DISTINCT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
    ON uf."FacRank" = avg_rank."FacRank"
JOIN (
    SELECT "FacRank",
           MIN(ABS("FacSalary" - avg_salary)) AS "min_diff"
    FROM "university_faculty"
    JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM "university_faculty"
        GROUP BY "FacRank"
    ) AS a
    USING ("FacRank")
    GROUP BY "FacRank"
) AS mindiff
    USING ("FacRank")
WHERE ABS(uf."FacSalary" - avg_rank."avg_salary") = mindiff."min_diff"
ORDER BY uf."FacRank", uf."FacLastName"
LIMIT 20;
