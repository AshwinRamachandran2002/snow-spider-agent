```sql
-- 1) Description: View the different faculty ranks available.
SELECT DISTINCT "FacRank"
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 2) Description: List a sample of faculty members with their first name, last name, rank, and salary.
SELECT DISTINCT "FacFirstName",
       "FacLastName",
       "FacRank",
       "FacSalary"
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 3) Description: Find the average salary for each rank.
SELECT DISTINCT "FacRank",
       AVG("FacSalary") AS "avg_salary"
FROM "university_faculty"
GROUP BY "FacRank"
LIMIT 20;
```

```sql
-- 4) Description: Combine every faculty member’s salary with the average salary of their rank.
SELECT DISTINCT uf."FacFirstName",
       uf."FacLastName",
       uf."FacRank",
       uf."FacSalary",
       avg_rank."avg_salary"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
ON uf."FacRank" = avg_rank."FacRank"
LIMIT 20;
```

```sql
-- 5) Description: Calculate each faculty member’s absolute difference 
--                 between their salary and the average for their rank.
SELECT DISTINCT uf."FacFirstName",
       uf."FacLastName",
       uf."FacRank",
       uf."FacSalary",
       ABS(uf."FacSalary" - avg_rank."avg_salary") AS "diff_from_avg"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
ON uf."FacRank" = avg_rank."FacRank"
LIMIT 20;
```

```sql
-- 6) Description: For each rank, determine the minimum salary difference 
--                 from the average (closest-to-average value).
SELECT DISTINCT uf."FacRank",
       MIN(ABS(uf."FacSalary" - avg_rank."avg_salary")) AS "min_diff"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
ON uf."FacRank" = avg_rank."FacRank"
GROUP BY uf."FacRank"
LIMIT 20;
```

```sql
-- 7) Description: Bring together the minimum difference per rank with the faculty
--                 details to identify who is closest to the average salary.
SELECT DISTINCT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM "university_faculty" AS uf
JOIN (
    -- sub-query to compute average salary per rank
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
    ON uf."FacRank" = avg_rank."FacRank"
JOIN (
    -- sub-query to get the minimum difference per rank
    SELECT "FacRank",
           MIN(ABS("FacSalary" - avg_salary)) AS "min_diff"
    FROM "university_faculty"
    JOIN (
        SELECT "FacRank" AS r,
               AVG("FacSalary") AS avg_salary
        FROM "university_faculty"
        GROUP BY "FacRank"
    ) AS a
    ON "FacRank" = a.r
    GROUP BY "FacRank"
) AS mindiff
    ON uf."FacRank" = mindiff."FacRank"
   AND ABS(uf."FacSalary" - avg_rank."avg_salary") = mindiff."min_diff"
LIMIT 20;
```

```sql
-- 8) Description: Order the above result alphabetically by rank then last name (optional refinement).
SELECT DISTINCT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
    ON uf."FacRank" = avg_rank."FacRank"
JOIN (
    SELECT "FacRank",
           MIN(ABS("FacSalary" - avg_salary)) AS "min_diff"
    FROM "university_faculty"
    JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM "university_faculty"
        GROUP BY "FacRank"
    ) AS a
    USING ("FacRank")
    GROUP BY "FacRank"
) AS mindiff
    USING ("FacRank")
WHERE ABS(uf."FacSalary" - avg_rank."avg_salary") = mindiff."min_diff"
ORDER BY uf."FacRank", uf."FacLastName"
LIMIT 20;
```

```sql
-- 9) Description: If you only need the final answer (ranks, names, salaries) without LIMIT.
SELECT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
    ON uf."FacRank" = avg_rank."FacRank"
JOIN (
    SELECT "FacRank",
           MIN(ABS("FacSalary" - avg_salary)) AS "min_diff"
    FROM "university_faculty"
    JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM "university_faculty"
        GROUP BY "FacRank"
    ) AS a
    USING ("FacRank")
    GROUP BY "FacRank"
) AS mindiff
    USING ("FacRank")
WHERE ABS(uf."FacSalary" - avg_rank."avg_salary") = mindiff."min_diff";
```

