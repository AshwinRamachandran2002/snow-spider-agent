Query:
-- 6) Description: For each rank, determine the minimum salary difference 
--                 from the average (closest-to-average value).
SELECT DISTINCT uf."FacRank",
       MIN(ABS(uf."FacSalary" - avg_rank."avg_salary")) AS "min_diff"
FROM "university_faculty" AS uf
JOIN (
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
ON uf."FacRank" = avg_rank."FacRank"
GROUP BY uf."FacRank"
LIMIT 20;
Answer:
FacRank,min_diff
ASSC,2500.0
ASST,3333.3333333333358
PROF,11666.666666666672
Query:
-- 7) Description: Bring together the minimum difference per rank with the faculty
--                 details to identify who is closest to the average salary.
SELECT DISTINCT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM "university_faculty" AS uf
JOIN (
    -- sub-query to compute average salary per rank
    SELECT "FacRank",
           AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS avg_rank
    ON uf."FacRank" = avg_rank."FacRank"
JOIN (
    -- sub-query to get the minimum difference per rank
    SELECT "FacRank",
           MIN(ABS("FacSalary" - avg_salary)) AS "min_diff"
    FROM "university_faculty"
    JOIN (
        SELECT "FacRank" AS r,
               AVG("FacSalary") AS avg_salary
        FROM "university_faculty"
        GROUP BY "FacRank"
    ) AS a
    ON "FacRank" = a.r
    GROUP BY "FacRank"
) AS mindiff
    ON uf."FacRank" = mindiff."FacRank"
   AND ABS(uf."FacSalary" - avg_rank."avg_salary") = mindiff."min_diff"
LIMIT 20;
Answer:
FacRank,FacFirstName,FacLastName,FacSalary
ASSC,JULIA,MILLS,75000
ASSC,LEONARD,FIBON,70000
ASST,CRISTOPHER,COLAN,40000
PROF,JANE,SMITH,110000
