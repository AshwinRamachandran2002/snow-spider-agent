```

```sql
-- Description: For every faculty member, compute how far their salary is from the average of their rank.
SELECT FacRank,
       FacFirstName,
       FacLastName,
       FacSalary,
       ABS(FacSalary - AVG(FacSalary) OVER (PARTITION BY FacRank)) AS diff_from_avg
FROM university_faculty
ORDER BY diff_from_avg ASC, FacRank
LIMIT 20;
```

```sql
-- Description: Determine the minimum (closest-to-average) salary difference within each rank.
SELECT FacRank,
       MIN(ABS(FacSalary - AVG(FacSalary) OVER (PARTITION BY FacRank))) AS min_diff_from_avg
FROM university_faculty
GROUP BY FacRank
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – list the faculty members whose salaries are the closest to 
--              the average salary for their respective ranks.
WITH diffs AS (   -- compute every faculty member’s distance from the average of their rank
    SELECT FacRank,
           FacFirstName,
           FacLastName,
           FacSalary,
           ABS(FacSalary - AVG(FacSalary) OVER (PARTITION BY FacRank)) AS diff_from_avg
    FROM university_faculty
),
mins AS (         -- keep the minimum distance for each rank
    SELECT FacRank,
           MIN(diff_from_avg) AS min_diff
    FROM diffs
    GROUP BY FacRank
)
SELECT d.FacRank   AS rank,
       d.FacFirstName AS first_name,
       d.FacLastName  AS last_name,
       d.FacSalary    AS salary
FROM   diffs d
JOIN   mins  m
  ON   d.FacRank = m.FacRank
 AND   d.diff_from_avg = m.min_diff
ORDER BY d.FacRank
LIMIT 20;
```
