Query:
--Description: Returns every faculty member whose salary is closest to the average salary of
--             their rank.  A first CTE (diffs) computes each person’s absolute distance from
--             their rank’s average using a window‐function; a second CTE (mins) finds, per
--             rank, the minimum of those distances; the final SELECT keeps only the rows
--             whose distance equals that minimum (ties allowed), yielding rank, first name,
--             last name, and salary.
WITH diffs AS (
    SELECT
        FacRank,
        FacFirstName,
        FacLastName,
        FacSalary,
        ABS(FacSalary - AVG(FacSalary) OVER (PARTITION BY FacRank)) AS diff_from_avg
    FROM university_faculty
),
mins AS (
    SELECT
        FacRank,
        MIN(diff_from_avg) AS min_diff
    FROM diffs
    GROUP BY FacRank
)
SELECT
    d.FacRank      AS rank,
    d.FacFirstName AS first_name,
    d.FacLastName  AS last_name,
    d.FacSalary    AS salary
FROM diffs d
JOIN mins  m
  ON d.FacRank = m.FacRank
 AND d.diff_from_avg = m.min_diff
ORDER BY d.FacRank
LIMIT 20
Answer:
rank,first_name,last_name,salary
ASSC,JULIA,MILLS,75000
ASSC,LEONARD,FIBON,70000
