```sql
--Description: Identify, for each faculty rank, the faculty member(s) whose salary is
--             closest to the average salary of that rank.
--             1) diff_cte  : compute every faculty member’s absolute difference from the 
--                rank-average using a window function.
--             2) min_cte   : capture, per rank, the minimum of those differences.
--             3) final SELECT joins the two CTEs so we keep only those faculty whose
--                difference equals the minimum for their rank (there can be ties).
WITH diff_cte AS (
    SELECT
        FacRank,
        FacFirstName,
        FacLastName,
        FacSalary,
        ABS(FacSalary - AVG(FacSalary) OVER (PARTITION BY FacRank)) AS diff_from_avg
    FROM university_faculty
),
min_cte AS (
    SELECT
        FacRank,
        MIN(diff_from_avg) AS min_diff
    FROM diff_cte
    GROUP BY FacRank
)
SELECT
    d.FacRank  AS rank,
    d.FacFirstName AS first_name,
    d.FacLastName  AS last_name,
    d.FacSalary    AS salary
FROM diff_cte d
JOIN min_cte  m
  ON d.FacRank = m.FacRank
 AND d.diff_from_avg = m.min_diff
ORDER BY d.FacRank
LIMIT 20;
```
