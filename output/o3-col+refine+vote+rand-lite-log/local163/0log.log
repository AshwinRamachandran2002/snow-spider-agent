```sql
-- 1. Peek at a few rows to understand university_faculty structure
SELECT * 
FROM "university_faculty"
LIMIT 20;
```

```sql
-- 2. See all distinct faculty ranks
SELECT DISTINCT "FacRank"
FROM "university_faculty";
```

```sql
-- 3. Compute the average salary for every rank
SELECT 
    "FacRank",
    AVG("FacSalary") AS "avg_salary"
FROM "university_faculty"
GROUP BY "FacRank";
```

```sql
-- 4. List each faculty member together with his/her rank’s average salary
SELECT 
    f."FacRank",
    f."FacFirstName",
    f."FacLastName",
    f."FacSalary",
    a."avg_salary"
FROM "university_faculty" AS f
JOIN (
    SELECT "FacRank", AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS a
  ON f."FacRank" = a."FacRank"
LIMIT 20;
```

```sql
-- 5. Add an absolute-difference column to measure how close each salary is to the average
SELECT 
    f."FacRank",
    f."FacFirstName",
    f."FacLastName",
    f."FacSalary",
    ABS(f."FacSalary" - a."avg_salary") AS "diff_from_avg"
FROM "university_faculty" AS f
JOIN (
    SELECT "FacRank", AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
) AS a
  ON f."FacRank" = a."FacRank"
ORDER BY f."FacRank", "diff_from_avg"
LIMIT 20;
```

```sql
-- 6. For each rank, find the minimum difference-to-average
SELECT 
    "FacRank",
    MIN(ABS("FacSalary" - "avg_salary")) AS "min_diff"
FROM (
    SELECT 
        f."FacRank",
        f."FacSalary",
        a."avg_salary"
    FROM "university_faculty" AS f
    JOIN (
        SELECT "FacRank", AVG("FacSalary") AS "avg_salary"
        FROM "university_faculty"
        GROUP BY "FacRank"
    ) AS a
      ON f."FacRank" = a."FacRank"
)
GROUP BY "FacRank";
```

```sql
-- 7. FINAL ANSWER – faculty whose salaries are closest to their rank’s average
WITH avg_rank AS (
    SELECT "FacRank", AVG("FacSalary") AS "avg_salary"
    FROM "university_faculty"
    GROUP BY "FacRank"
),
diff_rank AS (
    SELECT 
        f."FacRank",
        f."FacFirstName",
        f."FacLastName",
        f."FacSalary",
        ABS(f."FacSalary" - a."avg_salary") AS "diff"
    FROM "university_faculty" AS f
    JOIN avg_rank AS a
      ON f."FacRank" = a."FacRank"
),
min_diff AS (
    SELECT "FacRank", MIN("diff") AS "min_diff"
    FROM diff_rank
    GROUP BY "FacRank"
)
SELECT 
    d."FacRank"  AS "Rank",
    d."FacFirstName" AS "FirstName",
    d."FacLastName"  AS "LastName",
    d."FacSalary"    AS "Salary"
FROM diff_rank AS d
JOIN min_diff AS m
  ON d."FacRank" = m."FacRank"
 AND d."diff"     = m."min_diff"
ORDER BY d."FacRank";
```

The last query returns the faculty members whose salaries are closest to (i.e., have the minimum absolute distance from) the average salary of their respective academic ranks, displaying their rank, first name, last name, and salary.
