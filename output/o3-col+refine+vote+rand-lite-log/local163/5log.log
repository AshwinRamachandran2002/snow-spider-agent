Query:
--Description: 6) Combine steps 4 & 5 to select the faculty whose salaries 
--               are closest to the average for their rank
SELECT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM  "university_faculty" AS uf
JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP BY "FacRank"
     ) AS av
  ON uf."FacRank" = av."FacRank"
JOIN (
        SELECT d."FacRank",
               MIN(d."diff_from_avg") AS "min_diff"
        FROM (
                SELECT uf2."FacRank",
                       ABS(uf2."FacSalary" - av2."avg_salary") AS "diff_from_avg"
                FROM  "university_faculty" AS uf2
                JOIN (
                        SELECT "FacRank",
                               AVG("FacSalary") AS "avg_salary"
                        FROM   "university_faculty"
                        GROUP BY "FacRank"
                     ) AS av2
                  ON uf2."FacRank" = av2."FacRank"
             ) AS d
        GROUP BY d."FacRank"
     ) AS md
  ON uf."FacRank" = md."FacRank"
WHERE ABS(uf."FacSalary" - av."avg_salary") = md."min_diff"
LIMIT 20;
Answer:
FacRank,FacFirstName,FacLastName,FacSalary
