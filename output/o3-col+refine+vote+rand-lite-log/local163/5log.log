Query:
--Description: 5) Find the minimum salary-to-average difference for each rank
SELECT d."FacRank",
       MIN(d."diff_from_avg") AS "min_diff"
FROM (
        SELECT uf."FacRank",
               ABS(uf."FacSalary" - av."avg_salary") AS "diff_from_avg"
        FROM  "university_faculty" AS uf
        JOIN (
                SELECT "FacRank",
                       AVG("FacSalary") AS "avg_salary"
                FROM   "university_faculty"
                GROUP BY "FacRank"
             ) AS av
          ON uf."FacRank" = av."FacRank"
     ) AS d
GROUP BY d."FacRank"
LIMIT 20;
