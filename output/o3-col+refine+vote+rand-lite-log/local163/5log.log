```sql
--Description: 1) Check the different faculty ranks that exist
SELECT DISTINCT "FacRank"
FROM "university_faculty"
LIMIT 20;
```

```sql
--Description: 2) Look at a sample of the salary values for context
SELECT "FacFirstName",
       "FacLastName",
       "FacRank",
       "FacSalary"
FROM "university_faculty"
LIMIT 20;
```

```sql
--Description: 3) Calculate the average salary for each rank
SELECT "FacRank",
       AVG("FacSalary") AS "avg_salary"
FROM "university_faculty"
GROUP BY "FacRank"
LIMIT 20;
```

```sql
--Description: 4) For every faculty member, compute the absolute difference 
--               between their salary and their rank’s average salary
SELECT uf."FacFirstName",
       uf."FacLastName",
       uf."FacRank",
       uf."FacSalary",
       ABS(uf."FacSalary" - av."avg_salary") AS "diff_from_avg"
FROM  "university_faculty" AS uf
JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP BY "FacRank"
     ) AS av
  ON uf."FacRank" = av."FacRank"
LIMIT 20;
```

```sql
--Description: 5) Find the minimum salary-to-average difference for each rank
SELECT d."FacRank",
       MIN(d."diff_from_avg") AS "min_diff"
FROM (
        SELECT uf."FacRank",
               ABS(uf."FacSalary" - av."avg_salary") AS "diff_from_avg"
        FROM  "university_faculty" AS uf
        JOIN (
                SELECT "FacRank",
                       AVG("FacSalary") AS "avg_salary"
                FROM   "university_faculty"
                GROUP BY "FacRank"
             ) AS av
          ON uf."FacRank" = av."FacRank"
     ) AS d
GROUP BY d."FacRank"
LIMIT 20;
```

```sql
--Description: 6) Combine steps 4 & 5 to select the faculty whose salaries 
--               are closest to the average for their rank
SELECT uf."FacRank",
       uf."FacFirstName",
       uf."FacLastName",
       uf."FacSalary"
FROM  "university_faculty" AS uf
JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP BY "FacRank"
     ) AS av
  ON uf."FacRank" = av."FacRank"
JOIN (
        SELECT d."FacRank",
               MIN(d."diff_from_avg") AS "min_diff"
        FROM (
                SELECT uf2."FacRank",
                       ABS(uf2."FacSalary" - av2."avg_salary") AS "diff_from_avg"
                FROM  "university_faculty" AS uf2
                JOIN (
                        SELECT "FacRank",
                               AVG("FacSalary") AS "avg_salary"
                        FROM   "university_faculty"
                        GROUP BY "FacRank"
                     ) AS av2
                  ON uf2."FacRank" = av2."FacRank"
             ) AS d
        GROUP BY d."FacRank"
     ) AS md
  ON uf."FacRank" = md."FacRank"
WHERE ABS(uf."FacSalary" - av."avg_salary") = md."min_diff"
LIMIT 20;
```

```sql
--Description: 7) Same as query 6 but without LIMIT: final answer listing all 
--               faculty members (could be ties) whose salaries are closest 
--               to their rank’s average
SELECT uf."FacRank"  AS "Rank",
       uf."FacFirstName" AS "FirstName",
       uf."FacLastName"  AS "LastName",
       uf."FacSalary"    AS "Salary"
FROM  "university_faculty" AS uf
JOIN (
        SELECT "FacRank",
               AVG("FacSalary") AS "avg_salary"
        FROM   "university_faculty"
        GROUP BY "FacRank"
     ) AS av
  ON uf."FacRank" = av."FacRank"
JOIN (
        SELECT d."FacRank",
               MIN(d."diff_from_avg") AS "min_diff"
        FROM (
                SELECT uf2."FacRank",
                       ABS(uf2."FacSalary" - av2."avg_salary") AS "diff_from_avg"
                FROM  "university_faculty" AS uf2
                JOIN (
                        SELECT "FacRank",
                               AVG("FacSalary") AS "avg_salary"
                        FROM   "university_faculty"
                        GROUP BY "FacRank"
                     ) AS av2
                  ON uf2."FacRank" = av2."FacRank"
             ) AS d
        GROUP BY d."FacRank"
     ) AS md
  ON uf."FacRank" = md."FacRank"
WHERE ABS(uf."FacSalary" - av."avg_salary") = md."min_diff";
```
