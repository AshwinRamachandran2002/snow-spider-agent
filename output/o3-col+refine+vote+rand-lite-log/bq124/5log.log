Query:
--Description: 8) Combine (5) & (7) to see patients with qualifying diagnoses *and* ≥7 active meds.
WITH dx_patients AS (
  SELECT DISTINCT
    c.patient.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.claim` c,
  UNNEST(c.diagnosis)  AS d
  WHERE d.diagnosis.reference.conditionId IN (
        SELECT id
        FROM `bigquery-public-data.fhir_synthea.condition`,
        UNNEST(code.coding) AS cc
        WHERE LOWER(cc.display) LIKE '%diabetes%'
           OR LOWER(cc.display) LIKE '%hypertension%')
),
med_patients AS (
  SELECT
    subject.patientId                         AS patient_id,
    COUNT(DISTINCT medication.codeableConcept.text) AS med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING med_cnt >= 7
)
SELECT *
FROM dx_patients
JOIN med_patients USING (patient_id)
LIMIT 20;
