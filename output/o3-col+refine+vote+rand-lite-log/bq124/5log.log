--Description: 7) Count distinct active medications per patient.
SELECT
  subject.patientId                         AS patient_id,
  COUNT(DISTINCT medication.codeableConcept.text) AS active_med_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY patient_id
HAVING active_med_cnt >= 7
LIMIT 20;
