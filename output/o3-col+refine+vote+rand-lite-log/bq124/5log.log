--Description: 2) Look for any Diabetes-related conditions and grab their ids & SNOMED / ICD codes.
SELECT DISTINCT
  id              AS condition_id,
  c.code          AS code,
  c.display       AS display
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
WHERE LOWER(c.display) LIKE '%diabetes%'
   OR LOWER(c.display) LIKE '%type 2 diabetes%'
LIMIT 20;
