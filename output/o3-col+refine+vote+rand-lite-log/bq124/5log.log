Below is an incremental exploration (≤ 10 queries, each limited to 20 rows) that moves from inspecting key columns to a final query that returns the requested patient count.

```sql
--Description: 1) Peek at the Condition table to confirm useful columns exist.
SELECT
  id,
  clinicalStatus,
  code.text   AS condition_text,
  code.coding AS coding_array
FROM `bigquery-public-data.fhir_synthea.condition`
LIMIT 20;
```

```sql
--Description: 2) Look for any Diabetes-related conditions and grab their ids & SNOMED / ICD codes.
SELECT DISTINCT
  id              AS condition_id,
  c.code          AS code,
  c.display       AS display
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
WHERE LOWER(c.display) LIKE '%diabetes%'
   OR LOWER(c.display) LIKE '%type 2 diabetes%'
LIMIT 20;
```

```sql
--Description: 3) Do the same for Hypertension.
SELECT DISTINCT
  id              AS condition_id,
  c.code          AS code,
  c.display       AS display
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
WHERE LOWER(c.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
--Description: 4) Inspect how diagnosis in the Claim table references Condition resources.
SELECT
  id                         AS claim_id,
  patient.patientId          AS patient_id,
  d.sequence,
  d.diagnosis.reference.*    -- includes conditionId
FROM `bigquery-public-data.fhir_synthea.claim`,
UNNEST(diagnosis) AS d
WHERE d.diagnosis.reference.conditionId IS NOT NULL
LIMIT 20;
```

```sql
--Description: 5) Obtain all patientIds whose claims reference either Diabetes or Hypertension conditions.
WITH dx AS (
  SELECT id
  FROM `bigquery-public-data.fhir_synthea.condition`,
  UNNEST(code.coding) AS c
  WHERE LOWER(c.display) LIKE '%diabetes%' OR LOWER(c.display) LIKE '%hypertension%'
)
SELECT DISTINCT
  c.patient.patientId AS patient_id
FROM `bigquery-public-data.fhir_synthea.claim`  c,
UNNEST(c.diagnosis) AS d
WHERE d.diagnosis.reference.conditionId IN (SELECT id FROM dx)
LIMIT 20;
```

```sql
--Description: 6) Preview Medication-Request rows that are actively prescribed.
SELECT
  id                  AS medreq_id,
  subject.patientId   AS patient_id,
  status,
  medication.codeableConcept.text      AS med_name,
  medication.codeableConcept.coding    AS med_coding
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
LIMIT 20;
```

```sql
--Description: 7) Count distinct active medications per patient.
SELECT
  subject.patientId                         AS patient_id,
  COUNT(DISTINCT medication.codeableConcept.text) AS active_med_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY patient_id
HAVING active_med_cnt >= 7
LIMIT 20;
```

```sql
--Description: 8) Combine (5) & (7) to see patients with qualifying diagnoses *and* ≥7 active meds.
WITH dx_patients AS (
  SELECT DISTINCT
    c.patient.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.claim` c,
  UNNEST(c.diagnosis)  AS d
  WHERE d.diagnosis.reference.conditionId IN (
        SELECT id
        FROM `bigquery-public-data.fhir_synthea.condition`,
        UNNEST(code.coding) AS cc
        WHERE LOWER(cc.display) LIKE '%diabetes%'
           OR LOWER(cc.display) LIKE '%hypertension%')
),
med_patients AS (
  SELECT
    subject.patientId                         AS patient_id,
    COUNT(DISTINCT medication.codeableConcept.text) AS med_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING med_cnt >= 7
)
SELECT *
FROM dx_patients
JOIN med_patients USING (patient_id)
LIMIT 20;
```

```sql
--Description: 9) Bring in the Patient table to exclude deceased individuals (no deceased.dateTime recorded).
SELECT
  p.id AS patient_id,
  p.deceased.dateTime AS deceased_dt
FROM `bigquery-public-data.fhir_synthea.patient` p
LIMIT 20;
```

```sql
--Description: 10 ‑ FINAL) Count alive patients who satisfy all three criteria.
WITH diabetic_or_htn AS (
  SELECT DISTINCT
    c.patient.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.claim` c,
  UNNEST(c.diagnosis)  AS d
  WHERE d.diagnosis.reference.conditionId IN (
        SELECT id
        FROM `bigquery-public-data.fhir_synthea.condition`,
        UNNEST(code.coding) AS cc
        WHERE LOWER(cc.display) LIKE '%diabetes%'
           OR LOWER(cc.display) LIKE '%hypertension%')
),
polypharmacy AS (
  SELECT
    subject.patientId   AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
),
alive AS (
  SELECT id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`
  WHERE deceased.dateTime IS NULL
)
SELECT COUNT(DISTINCT a.patient_id) AS alive_diab_htn_poly_count
FROM alive              a
JOIN diabetic_or_htn    d  USING (patient_id)
JOIN polypharmacy       m  USING (patient_id);
```
