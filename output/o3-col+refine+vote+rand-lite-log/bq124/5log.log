--Description: 10 ‑ FINAL) Count alive patients who satisfy all three criteria.
WITH diabetic_or_htn AS (
  SELECT DISTINCT
    c.patient.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.claim` c,
  UNNEST(c.diagnosis)  AS d
  WHERE d.diagnosis.reference.conditionId IN (
        SELECT id
        FROM `bigquery-public-data.fhir_synthea.condition`,
        UNNEST(code.coding) AS cc
        WHERE LOWER(cc.display) LIKE '%diabetes%'
           OR LOWER(cc.display) LIKE '%hypertension%')
),
polypharmacy AS (
  SELECT
    subject.patientId   AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
),
alive AS (
  SELECT id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`
  WHERE deceased.dateTime IS NULL
)
SELECT COUNT(DISTINCT a.patient_id) AS alive_diab_htn_poly_count
FROM alive              a
JOIN diabetic_or_htn    d  USING (patient_id)
JOIN polypharmacy       m  USING (patient_id);
