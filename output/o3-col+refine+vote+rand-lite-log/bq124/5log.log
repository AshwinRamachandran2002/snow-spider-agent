Query:
--Description: 5) Obtain all patientIds whose claims reference either Diabetes or Hypertension conditions.
WITH dx AS (
  SELECT id
  FROM `bigquery-public-data.fhir_synthea.condition`,
  UNNEST(code.coding) AS c
  WHERE LOWER(c.display) LIKE '%diabetes%' OR LOWER(c.display) LIKE '%hypertension%'
)
SELECT DISTINCT
  c.patient.patientId AS patient_id
FROM `bigquery-public-data.fhir_synthea.claim`  c,
UNNEST(c.diagnosis) AS d
WHERE d.diagnosis.reference.conditionId IN (SELECT id FROM dx)
LIMIT 20;
