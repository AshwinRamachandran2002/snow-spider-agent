```sql
-- 1. Peek at a few Condition records to see how the diagnosis text is stored
SELECT
  subject.patientId,
  code.text AS condition_text
FROM `bigquery-public-data.fhir_synthea.condition`
LIMIT 20;
```

```sql
-- 2. Diabetes cases: patients whose Condition text contains “diab”
SELECT DISTINCT
  subject.patientId
FROM `bigquery-public-data.fhir_synthea.condition`
WHERE LOWER(code.text) LIKE '%diab%'
LIMIT 20;
```

```sql
-- 3. Hypertension cases: patients whose Condition text contains “hypert”
SELECT DISTINCT
  subject.patientId
FROM `bigquery-public-data.fhir_synthea.condition`
WHERE LOWER(code.text) LIKE '%hypert%'
LIMIT 20;
```

```sql
-- 4. Union of Diabetes OR Hypertension patients
SELECT DISTINCT
  subject.patientId
FROM `bigquery-public-data.fhir_synthea.condition`
WHERE LOWER(code.text) LIKE '%diab%' OR LOWER(code.text) LIKE '%hypert%'
LIMIT 20;
```

```sql
-- 5. Inspect Medication Request rows that are currently “active”
SELECT
  id AS med_req_id,
  subject.patientId,
  medication.codeableConcept.text AS medication_text,
  status
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
LIMIT 20;
```

```sql
-- 6. Distinct active medications per patient
SELECT
  subject.patientId,
  COUNT(DISTINCT medication.codeableConcept.text) AS distinct_active_meds
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY subject.patientId
HAVING distinct_active_meds >= 7
LIMIT 20;
```

```sql
-- 7. Combine the diagnosis filter (Diabetes OR Hypertension) 
--    with patients having ≥7 distinct active medications
WITH dx AS (
  SELECT DISTINCT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.condition`
  WHERE LOWER(code.text) LIKE '%diab%' OR LOWER(code.text) LIKE '%hypert%'
),
polypharm AS (
  SELECT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
)
SELECT DISTINCT patientId
FROM dx
JOIN polypharm
USING (patientId)
LIMIT 20;
```

```sql
-- 8. Final count of individuals who (a) are alive (no deceased information available 
--    in the allowed tables, so we implicitly assume they are alive), 
--    (b) have Diabetes or Hypertension, and (c) have ≥7 distinct active medications
WITH dx AS (
  SELECT DISTINCT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.condition`
  WHERE LOWER(code.text) LIKE '%diab%' OR LOWER(code.text) LIKE '%hypert%'
),
polypharm AS (
  SELECT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
)
SELECT COUNT(DISTINCT patientId) AS alive_diab_or_htn_with_7plus_meds
FROM dx
JOIN polypharm
USING (patientId);
```

```sql
-- 9. (Optional sanity-check) List a few of those qualifying patients with a sample of their meds
WITH qualified AS (
  -- use the same logic as Step 8
  WITH dx AS (
    SELECT DISTINCT subject.patientId
    FROM `bigquery-public-data.fhir_synthea.condition`
    WHERE LOWER(code.text) LIKE '%diab%' OR LOWER(code.text) LIKE '%hypert%'
  ),
  polypharm AS (
    SELECT subject.patientId
    FROM `bigquery-public-data.fhir_synthea.medication_request`
    WHERE status = 'active'
    GROUP BY subject.patientId
    HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
  )
  SELECT DISTINCT patientId
  FROM dx JOIN polypharm USING (patientId)
)
SELECT
  m.subject.patientId,
  m.medication.codeableConcept.text AS medication_text
FROM `bigquery-public-data.fhir_synthea.medication_request` AS m
JOIN qualified q
  ON q.patientId = m.subject.patientId
WHERE m.status = 'active'
LIMIT 20;
```

```sql
-- 10. Produce the exact list (distinct) of patients that satisfy all criteria
WITH dx AS (
  SELECT DISTINCT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.condition`
  WHERE LOWER(code.text) LIKE '%diab%' OR LOWER(code.text) LIKE '%hypert%'
),
polypharm AS (
  SELECT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
)
SELECT DISTINCT patientId
FROM dx
JOIN polypharm
USING (patientId)
LIMIT 20;
```
