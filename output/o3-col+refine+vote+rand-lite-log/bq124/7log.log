-- 9. (Optional sanity-check) List a few of those qualifying patients with a sample of their meds
WITH qualified AS (
  -- use the same logic as Step 8
  WITH dx AS (
    SELECT DISTINCT subject.patientId
    FROM `bigquery-public-data.fhir_synthea.condition`
    WHERE LOWER(code.text) LIKE '%diab%' OR LOWER(code.text) LIKE '%hypert%'
  ),
  polypharm AS (
    SELECT subject.patientId
    FROM `bigquery-public-data.fhir_synthea.medication_request`
    WHERE status = 'active'
    GROUP BY subject.patientId
    HAVING COUNT(DISTINCT medication.codeableConcept.text) >= 7
  )
  SELECT DISTINCT patientId
  FROM dx JOIN polypharm USING (patientId)
)
