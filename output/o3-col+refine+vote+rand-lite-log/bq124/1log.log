```

```sql
--Description: 2)  Look at some condition concepts that mention hypertension
SELECT DISTINCT LOWER(coding.display) AS htn_display
FROM `bigquery-public-data.fhir_synthea.condition`,
     UNNEST(code.coding) AS coding
WHERE LOWER(coding.display) LIKE '%hypertens%'
LIMIT 20;
```

```sql
--Description: 3)  List a sample of patientIds that carry either a diabetes or hypertension diagnosis
SELECT DISTINCT subject.patientId
FROM `bigquery-public-data.fhir_synthea.condition`,
     UNNEST(code.coding) AS coding
WHERE LOWER(coding.display) LIKE '%diabet%' 
   OR LOWER(coding.display) LIKE '%hypertens%'
LIMIT 20;
```

```sql
--Description: 4)  Inspect a few currently-active medication requests
SELECT subject.patientId,
       medication.codeableConcept.text AS med_text,
       medication.codeableConcept.coding[OFFSET(0)].display AS med_display,
       status
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
LIMIT 20;
```

```sql
--Description: 5)  Find distinct active medication names that appear in the data set
SELECT DISTINCT COALESCE(medication.codeableConcept.text,
                         medication.codeableConcept.coding[OFFSET(0)].display) AS active_med_name
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
LIMIT 20;
```

```sql
--Description: 6)  Count how many distinct active medications each patient is taking
SELECT subject.patientId,
       COUNT(DISTINCT COALESCE(medication.codeableConcept.text,
                               medication.codeableConcept.coding[OFFSET(0)].display)) AS distinct_active_meds
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY subject.patientId
LIMIT 20;
```

```sql
--Description: 7)  Patients who are on at least seven distinct active medications
SELECT subject.patientId
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY subject.patientId
HAVING COUNT(DISTINCT COALESCE(medication.codeableConcept.text,
                               medication.codeableConcept.coding[OFFSET(0)].display)) >= 7
LIMIT 20;
```

```sql
--Description: 8)  Patients with diabetes or hypertension *and* at least seven active medications
WITH condition_patients AS (
  SELECT DISTINCT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.condition`,
       UNNEST(code.coding) AS coding
  WHERE LOWER(coding.display) LIKE '%diabet%' 
     OR LOWER(coding.display) LIKE '%hypertens%'
),
polypharm_patients AS (
  SELECT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT COALESCE(medication.codeableConcept.text,
                                 medication.codeableConcept.coding[OFFSET(0)].display)) >= 7
)
SELECT cp.patientId
FROM condition_patients cp
JOIN polypharm_patients pp
ON cp.patientId = pp.patientId
LIMIT 20;
```

```sql
--Description: 9)  Final count of living patients (no deceased date recorded in any resource shown) 
--                 with diabetes OR hypertension AND ≥7 active medications
WITH condition_patients AS (
  SELECT DISTINCT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.condition`,
       UNNEST(code.coding) AS coding
  WHERE LOWER(coding.display) LIKE '%diabet%' 
     OR LOWER(coding.display) LIKE '%hypertens%'
),
polypharm_patients AS (
  SELECT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT COALESCE(medication.codeableConcept.text,
                                 medication.codeableConcept.coding[OFFSET(0)].display)) >= 7
)
SELECT COUNT(*) AS num_alive_diab_or_htn_polypharm_patients
FROM condition_patients cp
JOIN polypharm_patients pp
ON cp.patientId = pp.patientId;
```
