Query:
--Description: 8)  Patients with diabetes or hypertension *and* at least seven active medications
WITH condition_patients AS (
  SELECT DISTINCT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.condition`,
       UNNEST(code.coding) AS coding
  WHERE LOWER(coding.display) LIKE '%diabet%' 
     OR LOWER(coding.display) LIKE '%hypertens%'
),
polypharm_patients AS (
  SELECT subject.patientId
  FROM `bigquery-public-data.fhir_synthea.medication_request`
  WHERE status = 'active'
  GROUP BY subject.patientId
  HAVING COUNT(DISTINCT COALESCE(medication.codeableConcept.text,
                                 medication.codeableConcept.coding[OFFSET(0)].display)) >= 7
)
SELECT cp.patientId
FROM condition_patients cp
JOIN polypharm_patients pp
ON cp.patientId = pp.patientId
LIMIT 20;
