```sql
--Description: 1)  Look at some condition concepts that mention diabetes
SELECT DISTINCT LOWER(coding.display) AS diabetes_display
FROM `bigquery-public-data.fhir_synthea.condition`,
     UNNEST(code.coding) AS coding
