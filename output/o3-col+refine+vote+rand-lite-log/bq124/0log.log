```sql
--Description: 1)  Peek into the Patient table and confirm where a possible death date is stored.  
SELECT
  id                         AS patient_id,
  deceased__dateTime         -- this column is NULL when the individual is still alive
FROM `bigquery-public-data.fhir_synthea.patient`
LIMIT 20;
```

```sql
--Description: 2)  Show some patients that DO have a recorded death-date (for comparison).  
SELECT
  id  AS patient_id,
  deceased__dateTime
FROM `bigquery-public-data.fhir_synthea.patient`
WHERE deceased__dateTime IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3)  Inspect the Condition table structure and verify that every record
--still keeps the link back to the patient through subject.patientId.  
SELECT
  id                              AS condition_id,
  subject.patientId               AS patient_id,
  code.text                       AS condition_text,
  clinicalStatus
FROM `bigquery-public-data.fhir_synthea.condition`
LIMIT 20;
```

```sql
--Description: 4)  Retrieve only those condition records that look like Diabetes or Hypertension.  
SELECT
  subject.patientId   AS patient_id,
  code.text           AS condition_text
FROM `bigquery-public-data.fhir_synthea.condition`
WHERE LOWER(code.text) LIKE '%diabetes%'
   OR LOWER(code.text) LIKE '%hypertension%'
LIMIT 20;
```

```sql
--Description: 5)  Count how many distinct patients have at least one Diabetes or Hypertension diagnosis.  
SELECT
  COUNT(DISTINCT subject.patientId) AS pts_with_diab_or_htn
FROM `bigquery-public-data.fhir_synthea.condition`
WHERE LOWER(code.text) LIKE '%diabetes%'
   OR LOWER(code.text) LIKE '%hypertension%';
```

```sql
--Description: 6)  Take a look at active MedicationRequest records to understand the medication-related fields.  
SELECT
  id                                           AS med_request_id,
  subject.patientId                            AS patient_id,
  status,
  medication.codeableConcept.coding[OFFSET(0)].code   AS med_code,
  medication.codeableConcept.text                     AS med_text
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
LIMIT 20;
```

```sql
--Description: 7)  For every patient, compute how many DISTINCT active medications are currently ordered.  
SELECT
  subject.patientId                                                 AS patient_id,
  COUNT(DISTINCT medication.codeableConcept.coding[OFFSET(0)].code) AS n_active_meds
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY patient_id
LIMIT 20;
```

```sql
--Description: 8)  Identify the subset of patients that have seven or more distinct active medications.  
SELECT
  subject.patientId                                                 AS patient_id,
  COUNT(DISTINCT medication.codeableConcept.coding[OFFSET(0)].code) AS n_active_meds
FROM `bigquery-public-data.fhir_synthea.medication_request`
WHERE status = 'active'
GROUP BY patient_id
HAVING n_active_meds >= 7
LIMIT 20;
```

```sql
--Description: 9)  Build the complete patient list that satisfies ALL three requirements
--   1) alive (no deceased__dateTime)   
--   2) Diabetes OR Hypertension diagnosis   
--   3) at least seven distinct active medications  
SELECT
  p.id AS patient_id
FROM  `bigquery-public-data.fhir_synthea.patient`              AS p
JOIN (
        -- patients with Diabetes or Hypertension
        SELECT DISTINCT subject.patientId AS patient_id
        FROM   `bigquery-public-data.fhir_synthea.condition`
        WHERE  LOWER(code.text) LIKE '%diabetes%'
           OR  LOWER(code.text) LIKE '%hypertension%'
     )                                                          AS dx
  ON p.id = dx.patient_id
JOIN (
        -- patients with ≥ 7 active medications
        SELECT
          subject.patientId                                                 AS patient_id,
          COUNT(DISTINCT medication.codeableConcept.coding[OFFSET(0)].code) AS n_active_meds
        FROM `bigquery-public-data.fhir_synthea.medication_request`
        WHERE status = 'active'
        GROUP BY patient_id
        HAVING n_active_meds >= 7
     )                                                          AS meds
  ON p.id = meds.patient_id
WHERE p.deceased__dateTime IS NULL
LIMIT 20;
```

```sql
--Description: 10)  Final answer – how many unique individuals meet all three criteria.  
SELECT
  COUNT(DISTINCT p.id) AS alive_diab_or_htn_with_7plus_active_meds
FROM  `bigquery-public-data.fhir_synthea.patient`              AS p
JOIN (
        SELECT DISTINCT subject.patientId AS patient_id
        FROM   `bigquery-public-data.fhir_synthea.condition`
        WHERE  LOWER(code.text) LIKE '%diabetes%'
           OR  LOWER(code.text) LIKE '%hypertension%'
     )                                                          AS dx
  ON p.id = dx.patient_id
JOIN (
        SELECT
          subject.patientId                                                 AS patient_id
        FROM `bigquery-public-data.fhir_synthea.medication_request`
        WHERE status = 'active'
        GROUP BY patient_id
        HAVING COUNT(DISTINCT medication.codeableConcept.coding[OFFSET(0)].code) >= 7
     )                                                          AS meds
  ON p.id = meds.patient_id
WHERE p.deceased__dateTime IS NULL;
```
