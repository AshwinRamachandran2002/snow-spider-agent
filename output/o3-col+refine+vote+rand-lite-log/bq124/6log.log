```sql
-- 1. Quick look at a few condition records and their codes
SELECT
  id,
  code.text  AS condition_text,
  c.code     AS coding_code,
  c.display  AS coding_display
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
LIMIT 20;
```

```sql
-- 2. Retrieve conditions whose text or coding display mentions Diabetes or Hypertension
SELECT DISTINCT
  id,
  code.text               AS condition_text,
  LOWER(c.display)        AS coding_display
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
WHERE LOWER(code.text)     LIKE '%diabetes%'
   OR LOWER(code.text)     LIKE '%hypertension%'
   OR LOWER(c.display)     LIKE '%diabetes%'
   OR LOWER(c.display)     LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 3. Pull the same Diabetes / Hypertension conditions together with any subject information
-- (if the column `subject.patientId` exists; adjust if the actual name differs)
SELECT
  id                       AS condition_id,
  subject.patientId        AS patient_id,
  code.text                AS condition_text
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
WHERE LOWER(code.text)     LIKE '%diabetes%'
   OR LOWER(code.text)     LIKE '%hypertension%'
   OR LOWER(c.display)     LIKE '%diabetes%'
   OR LOWER(c.display)     LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 4. Count distinct patients that have Diabetes or Hypertension diagnoses
SELECT
  COUNT(DISTINCT subject.patientId) AS patients_with_target_dx
FROM `bigquery-public-data.fhir_synthea.condition`,
UNNEST(code.coding) AS c
WHERE (LOWER(code.text) LIKE '%diabetes%' OR LOWER(code.text) LIKE '%hypertension%'
       OR LOWER(c.display) LIKE '%diabetes%' OR LOWER(c.display) LIKE '%hypertension%');
```

```sql
-- 5. Inspect medication-request records in ‘active’ status
SELECT
  id                      AS med_request_id,
  subject.patientId       AS patient_id,
  status,
  mr.code                 AS rxnorm_code,
  mr.display              AS medication_name
FROM `bigquery-public-data.fhir_synthea.medication_request`,
UNNEST(medication.codeableConcept.coding) AS mr
WHERE status = 'active'
LIMIT 20;
```

```sql
-- 6. Count how many distinct active medications each patient currently has
SELECT
  subject.patientId                    AS patient_id,
  COUNT(DISTINCT mr.code)              AS active_rx_count
FROM `bigquery-public-data.fhir_synthea.medication_request`,
UNNEST(medication.codeableConcept.coding) AS mr
WHERE status = 'active'
GROUP BY patient_id
HAVING active_rx_count >= 7
LIMIT 20;
```

```sql
-- 7. Identify patients with ≥7 distinct active medications (list of patient_ids)
SELECT DISTINCT
  subject.patientId AS patient_id
FROM `bigquery-public-data.fhir_synthea.medication_request`,
UNNEST(medication.codeableConcept.coding) AS mr
WHERE status = 'active'
GROUP BY patient_id
HAVING COUNT(DISTINCT mr.code) >= 7
LIMIT 20;
```

```sql
-- 8. Combine diagnosis and medication criteria: patients with Diabetes/Hypertension AND ≥7 active meds
WITH target_dx AS (
  SELECT DISTINCT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition`,
  UNNEST(code.coding) AS c
  WHERE LOWER(code.text) LIKE '%diabetes%'     OR LOWER(code.text) LIKE '%hypertension%'
     OR LOWER(c.display) LIKE '%diabetes%'     OR LOWER(c.display) LIKE '%hypertension%'
),
polypharm AS (
  SELECT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request`,
  UNNEST(medication.codeableConcept.coding) AS mr
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT mr.code) >= 7
)
SELECT DISTINCT patient_id
FROM target_dx
JOIN polypharm USING (patient_id)
LIMIT 20;
```

```sql
-- 9. Count those patients (pre-filtering out any with a recorded date of death)
WITH target_dx AS (
  SELECT DISTINCT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition`,
  UNNEST(code.coding) AS c
  WHERE LOWER(code.text) LIKE '%diabetes%'     OR LOWER(code.text) LIKE '%hypertension%'
     OR LOWER(c.display) LIKE '%diabetes%'     OR LOWER(c.display) LIKE '%hypertension%'
),
polypharm AS (
  SELECT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request`,
  UNNEST(medication.codeableConcept.coding) AS mr
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT mr.code) >= 7
)
SELECT COUNT(DISTINCT patient_id) AS pts_dx_and_polypharm
FROM target_dx
JOIN polypharm USING (patient_id);
```

```sql
-- 10. (Optional) If the Patient table were available we would exclude deaths.
-- This example assumes a table `bigquery-public-data.fhir_synthea.patient` with field `deceased.dateTime`.
-- Adjust or remove if that table/field is not present in the environment.
WITH target_dx AS (
  SELECT DISTINCT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition`,
  UNNEST(code.coding) AS c
  WHERE LOWER(code.text) LIKE '%diabetes%'     OR LOWER(code.text) LIKE '%hypertension%'
     OR LOWER(c.display) LIKE '%diabetes%'     OR LOWER(c.display) LIKE '%hypertension%'
),
polypharm AS (
  SELECT subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request`,
  UNNEST(medication.codeableConcept.coding) AS mr
  WHERE status = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT mr.code) >= 7
),
alive AS (
  SELECT id AS patient_id
  FROM `bigquery-public-data.fhir_synthea.patient`
  WHERE deceased.dateTime IS NULL
)
SELECT COUNT(DISTINCT p.patient_id) AS final_alive_patients
FROM target_dx   t
JOIN polypharm   p  USING (patient_id)
JOIN alive       a  USING (patient_id);
```
