```sql
--Description:  
--We want the count of patients who satisfy ALL three criteria:  
--  (A) have at least one Condition that mentions “diabetes” OR “hypertension”;  
--  (B) have ≥ 7 distinct active medications (Medication Request status = 'active');  
--  (C) are still alive, defined here as never having a “deceased.dateTime” entry
--      inside any Claim.patient record.  Because the deceased element is not part
--      of the declared STRUCT, we stringify the STRUCT then use JSON_VALUE to look
--      for "$.deceased.dateTime".  If that expression always returns NULL, the
--      patient is considered alive.
--
--The query builds three CTE cohorts (dx, rx, alive) and intersects them, finally
--counting distinct patient IDs.

WITH dx AS (        -- Patients diagnosed with diabetes or hypertension
  SELECT DISTINCT subj.patientId
  FROM `bigquery-public-data.fhir_synthea.condition` AS cond
  JOIN UNNEST([cond.subject])                   AS subj
  CROSS JOIN UNNEST(cond.code.coding)           AS cod
  WHERE LOWER(cond.code.text) LIKE '%diabetes%'
     OR LOWER(cond.code.text) LIKE '%hypertension%'
     OR LOWER(cod.display)    LIKE '%diabetes%'
     OR LOWER(cod.display)    LIKE '%hypertension%'
),
rx AS (        -- Patients with ≥ 7 distinct active medications
  SELECT patient_id
  FROM (
    SELECT
      mr.subject.patientId        AS patient_id,
      COUNT(DISTINCT med.code)    AS med_cnt
    FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
    CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS med
    WHERE mr.status = 'active'
    GROUP BY patient_id
  )
  WHERE med_cnt >= 7
),
alive AS (     -- Patients with NO deceased.dateTime recorded in any claim
  SELECT patient.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.claim`
  GROUP BY patient.patientId
  HAVING MAX(JSON_VALUE(TO_JSON_STRING(patient), '$.deceased.dateTime')) IS NULL
)
SELECT
  COUNT(DISTINCT dx.patientId) AS alive_diab_or_htn_with7plus_active_meds
FROM dx
JOIN rx    ON dx.patientId = rx.patient_id
JOIN alive ON dx.patientId = alive.patient_id;
