2025-05-05 03:27:56 - Thread-2069 (execute) - INFO - [Exploration]
Below is a step-by-step exploration that starts very simply and gradually adds the additional pieces that are needed to answer  

“Among all patients, how many individuals remain alive (i.e., with no recorded deceased.dateTime), have a diagnosis of either Diabetes or Hypertension, and are prescribed at least seven distinct active medications?”

(Each query is limited to 20 rows so it can be inspected quickly.)

```sql
-- 1) Peek at the “condition” table – look at the coded diagnosis text
SELECT
  c.code.text   AS condition_text,
  c.code.coding AS coding_array
FROM `bigquery-public-data.fhir_synthea.condition` AS c
LIMIT 20;
```

```sql
-- 2) Which diagnosis rows contain the words “diabetes” or “hypertension”?
SELECT
  c.code.text,
  cc.display,
  cc.code,
  cc.system
FROM `bigquery-public-data.fhir_synthea.condition` AS c
CROSS JOIN UNNEST(c.code.coding) AS cc
WHERE LOWER(c.code.text)     LIKE '%diabetes%'
   OR LOWER(c.code.text)     LIKE '%hypertension%'
   OR LOWER(cc.display)      LIKE '%diabetes%'
   OR LOWER(cc.display)      LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 3) Identify the patients (subject.patientId) who have Diabetes or Hypertension
SELECT DISTINCT
  subj.patientId
FROM `bigquery-public-data.fhir_synthea.condition` AS c
CROSS JOIN UNNEST(c.code.coding) AS cc
JOIN UNNEST([c.subject]) AS subj     -- the subject STRUCT contains patientId
WHERE (LOWER(c.code.text) LIKE '%diabetes%'
        OR LOWER(c.code.text) LIKE '%hypertension%'
        OR LOWER(cc.display)  LIKE '%diabetes%'
        OR LOWER(cc.display)  LIKE '%hypertension%')
LIMIT 20;
```

```sql
-- 4) Inspect the “medication_request” table – confirm the status values
SELECT
  DISTINCT status
FROM `bigquery-public-data.fhir_synthea.medication_request`
LIMIT 20;
```

```sql
-- 5) Look at the medication names & codes for active prescriptions
SELECT
  mr.id,
  mr.subject.patientId,
  mr.status,
  mc.display,
  mc.code
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
WHERE mr.status = 'active'
LIMIT 20;
```

```sql
-- 6) For every patient, count how many distinct active medications they have
SELECT
  mr.subject.patientId      AS patient_id,
  COUNT(DISTINCT mc.code)   AS active_med_count
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
WHERE mr.status = 'active'
GROUP BY patient_id
LIMIT 20;
```

```sql
-- 7) Filter to patients with 7+ active medications
SELECT
  patient_id
FROM (
  SELECT
    mr.subject.patientId     AS patient_id,
    COUNT(DISTINCT mc.code)  AS active_med_count
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
  WHERE mr.status = 'active'
  GROUP BY patient_id
)
WHERE active_med_count >= 7
LIMIT 20;
```

```sql
-- 8) Combine: patients who BOTH (a) have Diabetes/Hypertension AND (b) ≥7 active meds
WITH dx AS (        -- Diabetes / Hypertension patients
  SELECT DISTINCT subj.patientId
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  JOIN UNNEST([c.subject]) AS subj
  WHERE (LOWER(c.code.text) LIKE '%diabetes%'
         OR LOWER(c.code.text) LIKE '%hypertension%'
         OR LOWER(cc.display)  LIKE '%diabetes%'
         OR LOWER(cc.display)  LIKE '%hypertension%')
),
rx AS (             -- ≥7 active medications
  SELECT patient_id
  FROM (
    SELECT
      mr.subject.patientId  AS patient_id,
      COUNT(DISTINCT mc.code) AS med_cnt
    FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
    CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
    WHERE mr.status = 'active'
    GROUP BY patient_id
  )
  WHERE med_cnt >= 7
)
SELECT DISTINCT dx.patientId
FROM dx
JOIN rx
ON dx.patientId = rx.patient_id
LIMIT 20;
```

```sql
-- 9) (Optional) Check if any of these patients have a deceased.dateTime recorded in CLAIMs
SELECT
  c.patient.patientId,
  MAX(IFNULL(c.patient.deceased, '')) AS any_deceased_field   -- field may not exist; adjust if present
FROM `bigquery-public-data.fhir_synthea.claim` AS c
WHERE c.patient.patientId IN (
  -- list of candidate patient IDs from previous query
  SELECT DISTINCT dx.patientId
  FROM (
     SELECT DISTINCT subj.patientId   -- same definition as CTE dx in query 8
     FROM `bigquery-public-data.fhir_synthea.condition` AS cond
     CROSS JOIN UNNEST(cond.code.coding) AS cc
     JOIN UNNEST([cond.subject]) AS subj
     WHERE (LOWER(cond.code.text) LIKE '%diabetes%'
            OR LOWER(cond.code.text) LIKE '%hypertension%'
            OR LOWER(cc.display)    LIKE '%diabetes%'
            OR LOWER(cc.display)    LIKE '%hypertension%')
  ) AS dx
)
GROUP BY c.patient.patientId
LIMIT 20;
```

```sql
-- 10) FINAL answer: count of ALIVE patients
-- (Assumes a patient is “alive” if no deceased.dateTime exists in any CLAIM row)
WITH dx AS (                      -- Diabetes / Hypertension patients
  SELECT DISTINCT subj.patientId
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  JOIN UNNEST([c.subject]) AS subj
  WHERE (LOWER(c.code.text) LIKE '%diabetes%'
         OR LOWER(c.code.text) LIKE '%hypertension%'
         OR LOWER(cc.display)  LIKE '%diabetes%'
         OR LOWER(cc.display)  LIKE '%hypertension%')
),
rx AS (                            -- ≥7 active medications per patient
  SELECT patient_id
  FROM (
    SELECT
      mr.subject.patientId  AS patient_id,
      COUNT(DISTINCT mc.code) AS med_cnt
    FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
    CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mc
    WHERE mr.status = 'active'
    GROUP BY patient_id
  )
  WHERE med_cnt >= 7
),
alive AS (                         -- patients with NO deceased.dateTime in claims
  SELECT
    cl.patient.patientId
  FROM `bigquery-public-data.fhir_synthea.claim` AS cl
  GROUP BY cl.patient.patientId
  HAVING MAX(IFNULL(cl.patient.deceased, '')) = ''
)
SELECT COUNT(DISTINCT a.patientId) AS alive_dx_rx_patient_cnt
FROM alive  AS a
JOIN dx     AS d  ON a.patientId = d.patientId
JOIN rx     AS r  ON a.patientId = r.patient_id;
```

These ten queries progress from basic inspection to the fully-formed query that returns the desired count of living patients who carry a diagnosis of Diabetes or Hypertension and have at least seven distinct active medications.
