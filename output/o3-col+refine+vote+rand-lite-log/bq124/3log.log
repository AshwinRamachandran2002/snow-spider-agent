```sql
--Description:  Build three cohorts and count living patients (no death-related conditions)
--who (a) have ≥7 distinct active medications and (b) carry a diagnosis of Diabetes,
--Hypertension, or both.  The query:
--   1) cond_flags  – sets 0/1 flags per patient for diabetes / hypertension diagnoses.
--   2) deaths      – lists patient IDs whose Condition text includes “death / dead / deceased”.
--   3) polypharm   – keeps patients with seven or more DISTINCT active medication codes.
--   4) Final step  – joins cond_flags with polypharm, excludes deaths, classifies each
--                    patient into Diabetes-only, Hypertension-only, or Both, and counts them.
WITH cond_flags AS (
  SELECT
    c.subject.patientId AS patient_id,
    MAX(CASE WHEN LOWER(cc.display) LIKE '%diabetes%'     THEN 1 ELSE 0 END) AS is_diabetes,
    MAX(CASE WHEN LOWER(cc.display) LIKE '%hypertension%' THEN 1 ELSE 0 END) AS is_htn
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%diabetes%'
     OR LOWER(cc.display) LIKE '%hypertension%'
  GROUP BY patient_id
),
deaths AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%death%'
     OR LOWER(cc.display) LIKE '%dead%'
     OR LOWER(cc.display) LIKE '%deceased%'
),
polypharm AS (
  SELECT
    mr.subject.patientId AS patient_id,
    COUNT(DISTINCT mrc.code) AS active_rx_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mrc
  WHERE mr.status = 'active'
  GROUP BY patient_id
  HAVING active_rx_cnt >= 7
)
SELECT
  CASE
    WHEN is_diabetes = 1 AND is_htn = 1 THEN 'Both'
    WHEN is_diabetes = 1                THEN 'Diabetes-only'
    ELSE                                      'Hypertension-only'
  END AS dx_group,
  COUNT(DISTINCT cf.patient_id) AS patient_cnt
FROM cond_flags AS cf
JOIN polypharm  AS p USING (patient_id)
WHERE cf.patient_id NOT IN (SELECT patient_id FROM deaths)
GROUP BY dx_group;
```
