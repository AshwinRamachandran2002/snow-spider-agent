```sql
-- 1) Look at how Diabetes or Hypertension appear in the Condition resource
SELECT
  c.subject.patientId,
  cc.code,
  cc.display
FROM `bigquery-public-data.fhir_synthea.condition` AS c,
     UNNEST(c.code.coding) AS cc
WHERE LOWER(cc.display) LIKE '%diabetes%'
   OR LOWER(cc.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 2) Inspect “active” MedicationRequest records and the medication codes they carry
SELECT
  mr.subject.patientId,
  mrc.code,
  mrc.display,
  mr.status
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
     UNNEST(mr.medication.codeableConcept.coding) AS mrc
WHERE mr.status = 'active'
LIMIT 20;
```

```sql
-- 3) Pull all distinct patient IDs that have at least one Diabetes or Hypertension diagnosis
SELECT DISTINCT
  c.subject.patientId AS patient_id
FROM `bigquery-public-data.fhir_synthea.condition` AS c,
     UNNEST(c.code.coding) AS cc
WHERE LOWER(cc.display) LIKE '%diabetes%'
   OR LOWER(cc.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 4) Derive, for every patient, the number of *distinct* active medications
SELECT
  mr.subject.patientId        AS patient_id,
  COUNT(DISTINCT mrc.code)    AS active_rx_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
     UNNEST(mr.medication.codeableConcept.coding) AS mrc
WHERE mr.status = 'active'
GROUP BY patient_id
HAVING active_rx_cnt >= 7
LIMIT 20;
```

```sql
-- 5) Identify patients who have any condition that looks like death / deceased
SELECT DISTINCT
  c.subject.patientId AS deceased_patient_id
FROM `bigquery-public-data.fhir_synthea.condition` AS c,
     UNNEST(c.code.coding) AS cc
WHERE LOWER(cc.display) LIKE '%death%'
   OR LOWER(cc.display) LIKE '%dead%'
   OR LOWER(cc.display) LIKE '%deceased%'
LIMIT 20;
```

```sql
-- 6) Combine the “alive” filter with the diagnosis filter (Diabetes OR Hypertension)
WITH dx AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%diabetes%'
     OR LOWER(cc.display) LIKE '%hypertension%'
),
deaths AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%death%'
     OR LOWER(cc.display) LIKE '%dead%'
     OR LOWER(cc.display) LIKE '%deceased%'
)
SELECT *
FROM dx
WHERE patient_id NOT IN (SELECT patient_id FROM deaths)
LIMIT 20;
```

```sql
-- 7) Join the “alive & diabetic/hypertensive” cohort with the ≥7-active-medication cohort
WITH dx AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%diabetes%'
     OR LOWER(cc.display) LIKE '%hypertension%'
),
deaths AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%death%'
     OR LOWER(cc.display) LIKE '%dead%'
     OR LOWER(cc.display) LIKE '%deceased%'
),
polypharm AS (
  SELECT
    mr.subject.patientId      AS patient_id,
    COUNT(DISTINCT mrc.code)  AS active_rx_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS mrc
  WHERE mr.status = 'active'
  GROUP BY patient_id
  HAVING active_rx_cnt >= 7
)
SELECT *
FROM dx
JOIN polypharm USING(patient_id)
WHERE patient_id NOT IN (SELECT patient_id FROM deaths)
LIMIT 20;
```

```sql
-- 8) Count how many individuals satisfy *all* criteria
WITH dx AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%diabetes%'
     OR LOWER(cc.display) LIKE '%hypertension%'
),
deaths AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c,
       UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%death%'
     OR LOWER(cc.display) LIKE '%dead%'
     OR LOWER(cc.display) LIKE '%deceased%'
),
polypharm AS (
  SELECT
    mr.subject.patientId      AS patient_id,
    COUNT(DISTINCT mrc.code)  AS active_rx_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr,
       UNNEST(mr.medication.codeableConcept.coding) AS mrc
  WHERE mr.status = 'active'
  GROUP BY patient_id
  HAVING active_rx_cnt >= 7
)
SELECT COUNT(DISTINCT patient_id) AS alive_diab_or_htn_polypharm_cnt
