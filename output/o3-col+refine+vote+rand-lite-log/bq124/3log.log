```sql
--Description:  Count how many living patients (i.e., no death-related conditions) have
--               • a diagnosis of Diabetes or Hypertension, and
--               • at least seven distinct *active* medications.
--               The CTEs build diagnosis flags (cond_flags), identify poly-pharmacy
--               patients (polypharm), and capture any death hints (deaths).  
--               The final SELECT returns the overall patient count plus a breakdown
--               of Diabetes-only, Hypertension-only, and Both.
WITH cond_flags AS (
  SELECT
    c.subject.patientId                                         AS patient_id,
    BOOL_OR(LOWER(cc.display) LIKE '%diabetes%')     AS is_diabetes,
    BOOL_OR(LOWER(cc.display) LIKE '%hypertension%') AS is_htn
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%diabetes%'
     OR LOWER(cc.display) LIKE '%hypertension%'
  GROUP BY patient_id
),
polypharm AS (
  SELECT
    mr.subject.patientId              AS patient_id,
    COUNT(DISTINCT mrc.code)          AS active_rx_cnt
  FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
  CROSS JOIN UNNEST(mr.medication.codeableConcept.coding) AS mrc
  WHERE mr.status = 'active'
  GROUP BY patient_id
  HAVING active_rx_cnt >= 7
),
deaths AS (
  SELECT DISTINCT c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` AS c
  CROSS JOIN UNNEST(c.code.coding) AS cc
  WHERE LOWER(cc.display) LIKE '%death%'
     OR LOWER(cc.display) LIKE '%dead%'
     OR LOWER(cc.display) LIKE '%deceased%'
)
SELECT
  COUNT(DISTINCT cf.patient_id) AS total_alive_dxhx_polypharm,
  SUM(CASE WHEN  is_diabetes AND  is_htn THEN 1 ELSE 0 END) AS both_cnt,
  SUM(CASE WHEN  is_diabetes AND NOT is_htn THEN 1 ELSE 0 END) AS diabetes_only_cnt,
  SUM(CASE WHEN  is_htn      AND NOT is_diabetes THEN 1 ELSE 0 END) AS htn_only_cnt
FROM cond_flags  AS cf
JOIN polypharm   AS p  USING (patient_id)
WHERE cf.patient_id NOT IN (SELECT patient_id FROM deaths);
```
