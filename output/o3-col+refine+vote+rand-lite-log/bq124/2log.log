```sql
-- 2) Peek at a few Condition rows whose diagnostic name mentions hypertension
SELECT 
  c.subject.patientId, 
  c.code.text, 
  cod.display AS coding_display
FROM `bigquery-public-data.fhir_synthea.condition` AS c
CROSS JOIN UNNEST(c.code.coding) AS cod
WHERE LOWER(c.code.text) LIKE '%hypertension%'
   OR LOWER(cod.display)  LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 3) List every patient that has ≥1 diagnosis of diabetes OR hypertension
SELECT DISTINCT
  c.subject.patientId AS patient_id
FROM `bigquery-public-data.fhir_synthea.condition` AS c
CROSS JOIN UNNEST(c.code.coding) AS cod
WHERE LOWER(c.code.text) LIKE '%diabetes%'      OR LOWER(cod.display) LIKE '%diabetes%'
   OR LOWER(c.code.text) LIKE '%hypertension%'  OR LOWER(cod.display) LIKE '%hypertension%'
LIMIT 20;
```

```sql
-- 4) Inspect how active MedicationRequest rows look (status = 'active')
SELECT 
  mr.subject.patientId, 
  mr.medication.codeableConcept.text  AS med_text,
  mr.status
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
WHERE LOWER(mr.status) = 'active'
LIMIT 20;
```

```sql
-- 5) Count how many different active medications each patient is currently prescribed
SELECT
  mr.subject.patientId           AS patient_id,
  COUNT(DISTINCT mr.medication.codeableConcept.text) AS active_med_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
WHERE LOWER(mr.status) = 'active'
GROUP BY patient_id
HAVING active_med_cnt >= 1
LIMIT 20;
```

```sql
-- 6) Identify patients with at least 7 distinct active medications
SELECT
  mr.subject.patientId           AS patient_id,
  COUNT(DISTINCT mr.medication.codeableConcept.text) AS active_med_cnt
FROM `bigquery-public-data.fhir_synthea.medication_request` AS mr
WHERE LOWER(mr.status) = 'active'
GROUP BY patient_id
HAVING active_med_cnt >= 7
LIMIT 20;
```

```sql
-- 7) Unite both criteria: (a) diabetes OR hypertension diagnosis and (b) ≥7 active medications
SELECT DISTINCT
  med.patient_id
FROM (
  /* patients with ≥7 active meds */
  SELECT
    mr.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  WHERE LOWER(mr.status) = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT mr.medication.codeableConcept.text) >= 7
) AS med
JOIN (
  /* patients diagnosed with diabetes OR hypertension */
  SELECT DISTINCT
    c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` c
  CROSS JOIN UNNEST(c.code.coding) AS cod
  WHERE LOWER(c.code.text) LIKE '%diabetes%'      OR LOWER(cod.display) LIKE '%diabetes%'
     OR LOWER(c.code.text) LIKE '%hypertension%'  OR LOWER(cod.display) LIKE '%hypertension%'
) AS diag
USING (patient_id)
LIMIT 20;
```

```sql
-- 8) Final answer: total number of living* patients meeting all criteria
-- (*The dataset provided does not include a Patient table with deceased.dateTime,
--    so “living” is approximated as “present in the data with no known death record”.)
SELECT 
  COUNT(DISTINCT med.patient_id) AS total_alive_with_diag_and_7_active_meds
FROM (
  /* patients with ≥7 active meds */
  SELECT
    mr.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.medication_request` mr
  WHERE LOWER(mr.status) = 'active'
  GROUP BY patient_id
  HAVING COUNT(DISTINCT mr.medication.codeableConcept.text) >= 7
) AS med
JOIN (
  /* patients diagnosed with diabetes OR hypertension */
  SELECT DISTINCT
    c.subject.patientId AS patient_id
  FROM `bigquery-public-data.fhir_synthea.condition` c
  CROSS JOIN UNNEST(c.code.coding) AS cod
  WHERE LOWER(c.code.text) LIKE '%diabetes%'      OR LOWER(cod.display) LIKE '%diabetes%'
     OR LOWER(c.code.text) LIKE '%hypertension%'  OR LOWER(cod.display) LIKE '%hypertension%'
) AS diag
USING (patient_id);
```

