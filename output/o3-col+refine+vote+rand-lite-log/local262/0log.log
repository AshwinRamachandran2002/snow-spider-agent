-- 8. Combine the two counts and keep only the problems where
--    nb_stack_better > nb_in_solution
SELECT c.name
FROM (
      SELECT name,
             COUNT(*) AS nb_stack_better
      FROM (
            SELECT s.name, s.version, s.step
            FROM   model_score AS s
            JOIN   (
                    SELECT name, version, step, MAX(test_score) AS max_non_stack_test
                    FROM model_score
                    WHERE model <> 'Stack'
                    GROUP BY name, version, step
                   ) AS n
              ON s.name    = n.name
             AND s.version = n.version
             AND s.step    = n.step
            WHERE s.model  = 'Stack'
              AND s.test_score > n.max_non_stack_test
           )
      GROUP BY name
     ) AS c
JOIN  (
       SELECT name,
              COUNT(*) AS nb_in_solution
       FROM   solution
       GROUP BY name
      ) AS sol
ON   c.name = sol.name
WHERE c.nb_stack_better > sol.nb_in_solution
LIMIT 20;
