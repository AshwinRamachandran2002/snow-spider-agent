```sql
-- 1. See which problems have model scores recorded
SELECT DISTINCT name FROM model_score LIMIT 20;
```

```sql
-- 2. Inspect every model name that appears in the model_score table
SELECT DISTINCT model FROM model_score LIMIT 20;
```

```sql
-- 3. Look at “Stack” models only, together with their step / version / test score
SELECT name, version, step, test_score
FROM model_score
WHERE model = 'Stack'
LIMIT 20;
```

```sql
-- 4. For the same rows, compute the best non-“Stack” test score (max) per name / version / step
SELECT ms.name,
       ms.version,
       ms.step,
       MAX(ms.test_score) AS max_non_stack_test
FROM model_score AS ms
WHERE ms.model <> 'Stack'
GROUP BY ms.name, ms.version, ms.step
LIMIT 20;
```

```sql
-- 5. Join the previous two result sets to keep only situations where
--    the Stack test score beats every non-Stack model for that step
SELECT s.name,
       s.version,
       s.step,
       s.test_score           AS stack_test,
       n.max_non_stack_test
FROM   model_score AS s
JOIN   (
        SELECT name, version, step, MAX(test_score) AS max_non_stack_test
        FROM model_score
        WHERE model <> 'Stack'
        GROUP BY name, version, step
       ) AS n
ON  s.name    = n.name
AND s.version = n.version
AND s.step    = n.step
WHERE s.model = 'Stack'
  AND s.test_score > n.max_non_stack_test
LIMIT 20;
```

```sql
-- 6. Count, per problem, how many (name, version, step) rows satisfy the condition above
SELECT name,
       COUNT(*) AS nb_stack_better
FROM (
      SELECT s.name, s.version, s.step
      FROM   model_score AS s
      JOIN   (
              SELECT name, version, step, MAX(test_score) AS max_non_stack_test
              FROM model_score
              WHERE model <> 'Stack'
              GROUP BY name, version, step
             ) AS n
      ON  s.name    = n.name
      AND s.version = n.version
      AND s.step    = n.step
      WHERE s.model = 'Stack'
        AND s.test_score > n.max_non_stack_test
     )
GROUP BY name
LIMIT 20;
```

```sql
-- 7. Compute, for each problem, how many rows it has in the solution table
SELECT name,
       COUNT(*) AS nb_in_solution
FROM   solution
GROUP BY name
LIMIT 20;
```

```sql
-- 8. Combine the two counts and keep only the problems where
--    nb_stack_better > nb_in_solution
SELECT c.name
FROM (
      SELECT name,
             COUNT(*) AS nb_stack_better
      FROM (
            SELECT s.name, s.version, s.step
            FROM   model_score AS s
            JOIN   (
                    SELECT name, version, step, MAX(test_score) AS max_non_stack_test
                    FROM model_score
                    WHERE model <> 'Stack'
                    GROUP BY name, version, step
                   ) AS n
              ON s.name    = n.name
             AND s.version = n.version
             AND s.step    = n.step
            WHERE s.model  = 'Stack'
              AND s.test_score > n.max_non_stack_test
           )
      GROUP BY name
     ) AS c
JOIN  (
       SELECT name,
              COUNT(*) AS nb_in_solution
       FROM   solution
       GROUP BY name
      ) AS sol
ON   c.name = sol.name
WHERE c.nb_stack_better > sol.nb_in_solution
LIMIT 20;
```

