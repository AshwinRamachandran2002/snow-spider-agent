Query:
-- 5. Join the previous two result sets to keep only situations where
--    the Stack test score beats every non-Stack model for that step
SELECT s.name,
       s.version,
       s.step,
       s.test_score           AS stack_test,
       n.max_non_stack_test
FROM   model_score AS s
JOIN   (
        SELECT name, version, step, MAX(test_score) AS max_non_stack_test
        FROM model_score
        WHERE model <> 'Stack'
        GROUP BY name, version, step
       ) AS n
ON  s.name    = n.name
AND s.version = n.version
AND s.step    = n.step
WHERE s.model = 'Stack'
  AND s.test_score > n.max_non_stack_test
LIMIT 20;
