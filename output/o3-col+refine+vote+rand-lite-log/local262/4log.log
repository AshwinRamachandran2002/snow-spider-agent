```sql
-- 6) Compare both scores: keep only the steps where the “Stack” model wins
WITH stack AS (
      SELECT "name","version","step",MAX("test_score") AS stack_test_score
      FROM   "model_score"
      WHERE  LOWER("model") LIKE '%stack%'
      GROUP  BY "name","version","step"),
nonstack AS (
      SELECT "name","version","step",MAX("test_score") AS nonstack_max_score
      FROM   "model_score"
      WHERE  LOWER("model") NOT LIKE '%stack%'
      GROUP  BY "name","version","step")
SELECT  s."name",
        s."version",
        s."step",
        s.stack_test_score,
        n.nonstack_max_score
FROM    stack AS s
LEFT JOIN nonstack AS n
       ON s."name"    = n."name"
      AND s."version" = n."version"
      AND s."step"    = n."step"
WHERE   (n.nonstack_max_score IS NULL)   -- no other model
    OR (s.stack_test_score > n.nonstack_max_score)
LIMIT 20;
```

```sql
-- 7) Count, for every problem, how many (version,step) combinations
--    satisfy the previous “Stack wins” condition
WITH stack AS (
      SELECT "name","version","step",MAX("test_score") AS stack_test_score
      FROM   "model_score"
      WHERE  LOWER("model") LIKE '%stack%'
      GROUP  BY "name","version","step"),
nonstack AS (
      SELECT "name","version","step",MAX("test_score") AS nonstack_max_score
      FROM   "model_score"
      WHERE  LOWER("model") NOT LIKE '%stack%'
      GROUP  BY "name","version","step"),
stack_wins AS (
      SELECT  s."name","version","step"
      FROM    stack AS s
      LEFT JOIN nonstack AS n
             ON s."name"    = n."name"
            AND s."version" = n."version"
            AND s."step"    = n."step"
      WHERE   (n.nonstack_max_score IS NULL)
          OR (s.stack_test_score > n.nonstack_max_score))
SELECT   "name",
         COUNT(*) AS nb_steps_where_stack_wins
FROM     stack_wins
GROUP BY "name"
LIMIT 20;
```

```sql
-- 8) Bring together the two counts: solution-rows vs. winning-steps
WITH nb_solution AS (
      SELECT "name", COUNT(*) AS nb_solution_rows
      FROM   "solution"
      GROUP  BY "name"),
nb_stack_wins AS (
      WITH stack AS (
            SELECT "name","version","step",MAX("test_score") AS stack_test_score
            FROM   "model_score"
            WHERE  LOWER("model") LIKE '%stack%'
            GROUP  BY "name","version","step"),
      nonstack AS (
            SELECT "name","version","step",MAX("test_score") AS nonstack_max_score
            FROM   "model_score"
            WHERE  LOWER("model") NOT LIKE '%stack%'
            GROUP  BY "name","version","step"),
      stack_wins AS (
            SELECT  s."name","version","step"
            FROM    stack AS s
            LEFT JOIN nonstack AS n
                   ON s."name"    = n."name"
                  AND s."version" = n."version"
                  AND s."step"    = n."step"
            WHERE   (n.nonstack_max_score IS NULL)
                OR (s.stack_test_score > n.nonstack_max_score))
      SELECT  "name",
              COUNT(*) AS nb_steps_where_stack_wins
      FROM    stack_wins
      GROUP BY "name")
SELECT  s."name",
        sw.nb_steps_where_stack_wins,
        s.nb_solution_rows
FROM    nb_solution  AS s
JOIN    nb_stack_wins AS sw USING ("name")
LIMIT 20;
```

```sql
-- 9) FINAL ANSWER: problems where Stack wins in more steps (1,2,3)
--    than they have total rows in the solution table
WITH nb_solution AS (
      SELECT "name", COUNT(*) AS nb_solution_rows
      FROM   "solution"
      GROUP  BY "name"),
nb_stack_wins AS (
      WITH stack AS (
            SELECT "name","version","step",MAX("test_score") AS stack_test_score
            FROM   "model_score"
            WHERE  LOWER("model") LIKE '%stack%'
            GROUP  BY "name","version","step"),
      nonstack AS (
            SELECT "name","version","step",MAX("test_score") AS nonstack_max_score
            FROM   "model_score"
            WHERE  LOWER("model") NOT LIKE '%stack%'
            GROUP  BY "name","version","step"),
      stack_wins AS (
            SELECT  s."name","version","step"
            FROM    stack AS s
            LEFT JOIN nonstack AS n
                   ON s."name"    = n."name"
                  AND s."version" = n."version"
                  AND s."step"    = n."step"
            WHERE   (n.nonstack_max_score IS NULL)
                OR (s.stack_test_score > n.nonstack_max_score))
      SELECT  "name",
              COUNT(*) AS nb_steps_where_stack_wins
      FROM    stack_wins
      GROUP BY "name")
SELECT DISTINCT s."name"
FROM   nb_solution  AS s
JOIN   nb_stack_wins AS sw USING ("name")
WHERE  sw.nb_steps_where_stack_wins > s.nb_solution_rows;
