              MAX("test_score") AS nonstack_test
       FROM   "model_score"
       WHERE  LOWER("model") NOT LIKE '%stack%'
       GROUP  BY "name", "version", "step"
),
stack_wins AS (
       SELECT s."name", s."version", s."step"
       FROM   stack     AS s
       LEFT JOIN nonstack AS n
              ON  s."name"    = n."name"
              AND s."version" = n."version"
              AND s."step"    = n."step"
       WHERE  n.nonstack_test IS NULL
