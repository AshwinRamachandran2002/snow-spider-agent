```sql
--Description: We need the problems that (a) have more (version,step) pairs where 
--the Stack model beats every non-Stack model than (b) the total number of rows 
--they possess in the solution table. 
--Steps inside this single CTE-based query:
-- 1. “stack”:   best Stack test_score for each (name,version,step).
-- 2. “nonstack”: best non-Stack test_score for the same granularity.
-- 3. “stack_wins”: keep (name,version,step) where Stack wins or is alone.
-- 4. “nb_stack_wins”: count such winning (version,step) per problem.
-- 5. “nb_solution_rows”: count how many rows each problem has in solution.
-- 6. Final SELECT: return problems whose win-count > solution-row-count.

WITH stack AS (
     SELECT "name", "version", "step",
            MAX("test_score") AS stack_test
     FROM   "model_score"
     WHERE  LOWER("model") LIKE '%stack%'
     GROUP  BY "name", "version", "step"
),
nonstack AS (
     SELECT "name", "version", "step",
            MAX("test_score") AS nonstack_test
     FROM   "model_score"
     WHERE  LOWER("model") NOT LIKE '%stack%'
     GROUP  BY "name", "version", "step"
),
stack_wins AS (
     SELECT s."name", s."version", s."step"
     FROM   stack s
     LEFT JOIN nonstack n
            ON  s."name"    = n."name"
            AND s."version" = n."version"
            AND s."step"    = n."step"
     WHERE  n.nonstack_test IS NULL           -- no competitor
        OR  s.stack_test > n.nonstack_test    -- Stack is better
),
nb_stack_wins AS (
     SELECT "name",
            COUNT(*) AS wins
     FROM   stack_wins
     GROUP  BY "name"
),
nb_solution_rows AS (
     SELECT "name",
            COUNT(*) AS sol_rows
     FROM   "solution"
     GROUP  BY "name"
)
SELECT sw."name"
FROM   nb_stack_wins    sw
JOIN   nb_solution_rows sr USING ("name")
WHERE  sw.wins > sr.sol_rows;
```
