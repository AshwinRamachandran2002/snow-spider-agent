-- 6) Compare both scores: keep only the steps where the “Stack” model wins
WITH stack AS (
      SELECT "name","version","step",MAX("test_score") AS stack_test_score
      FROM   "model_score"
      WHERE  LOWER("model") LIKE '%stack%'
      GROUP  BY "name","version","step"),
nonstack AS (
      SELECT "name","version","step",MAX("test_score") AS nonstack_max_score
      FROM   "model_score"
      WHERE  LOWER("model") NOT LIKE '%stack%'
      GROUP  BY "name","version","step")
SELECT  s."name",
        s."version",
        s."step",
        s.stack_test_score,
        n.nonstack_max_score
FROM    stack AS s
LEFT JOIN nonstack AS n
       ON s."name"    = n."name"
      AND s."version" = n."version"
      AND s."step"    = n."step"
WHERE   (n.nonstack_max_score IS NULL)   -- no other model
    OR (s.stack_test_score > n.nonstack_max_score)
LIMIT 20;
