 (SELECT name, version, step, test_score AS stack_test_score
  FROM model_score
  WHERE lower(model) LIKE '%stack%') AS s
JOIN
 (SELECT name, version, step, MAX(test_score) AS max_nonstack_test_score
  FROM model_score
  WHERE lower(model) NOT LIKE '%stack%'
  GROUP BY name, version, step) AS n
ON s.name = n.name AND s.version = n.version AND s.step = n.step
WHERE s.stack_test_score > n.max_nonstack_test_score
LIMIT 20;
