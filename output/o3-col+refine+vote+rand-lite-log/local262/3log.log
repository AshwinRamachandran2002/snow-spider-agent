```sql
--Description: Inspect the first 20 rows of the model_score table to see model names and associated scores.
SELECT name, version, step, model, train_score, test_score
FROM model_score
LIMIT 20;
```

```sql
--Description: List every distinct model identifier that appears in model_score.
SELECT DISTINCT model
FROM model_score
LIMIT 20;
```

```sql
--Description: List distinct model identifiers whose name suggests they are stacking models.
SELECT DISTINCT model
FROM model_score
WHERE lower(model) LIKE '%stack%'
LIMIT 20;
```

```sql
--Description: Pull the test scores of Stack models for every problem / version / step.
SELECT name, version, step, test_score AS stack_test_score
FROM model_score
WHERE lower(model) LIKE '%stack%'
LIMIT 20;
```

```sql
--Description: For each problem / version / step, get the best NON-Stack test score.
SELECT name, version, step, MAX(test_score) AS max_nonstack_test_score
FROM model_score
WHERE lower(model) NOT LIKE '%stack%'
GROUP BY name, version, step
LIMIT 20;
```

```sql
--Description: Keep only (problem, version, step) triples where the Stack model beats all non-Stack models.
SELECT s.name, s.version, s.step
FROM
 (SELECT name, version, step, test_score AS stack_test_score
  FROM model_score
  WHERE lower(model) LIKE '%stack%') AS s
JOIN
 (SELECT name, version, step, MAX(test_score) AS max_nonstack_test_score
  FROM model_score
  WHERE lower(model) NOT LIKE '%stack%'
  GROUP BY name, version, step) AS n
ON s.name = n.name AND s.version = n.version AND s.step = n.step
WHERE s.stack_test_score > n.max_nonstack_test_score
LIMIT 20;
```

```sql
--Description: Count, for each problem, how many (version, step) pairs (steps 1-3) satisfy the “Stack-better” rule.
SELECT name, COUNT(*) AS cnt_stack_better
FROM
 (SELECT s.name, s.version, s.step
  FROM
   (SELECT name, version, step, test_score AS stack_test_score
    FROM model_score
    WHERE lower(model) LIKE '%stack%') AS s
  JOIN
   (SELECT name, version, step, MAX(test_score) AS max_nonstack_test_score
    FROM model_score
    WHERE lower(model) NOT LIKE '%stack%'
    GROUP BY name, version, step) AS n
  ON s.name = n.name AND s.version = n.version AND s.step = n.step
  WHERE s.stack_test_score > n.max_nonstack_test_score
    AND s.step IN (1, 2, 3)
 ) 
GROUP BY name
LIMIT 20;
```

```sql
--Description: Count how many rows each problem has in the solution table (i.e., number of versions logged).
SELECT name, COUNT(*) AS cnt_solution_rows
FROM solution
GROUP BY name
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – problems for which the number of “Stack-better” (step 1-3) occurrences exceeds their total rows in solution.
SELECT sb.name
FROM
 (
  SELECT name, COUNT(*) AS cnt_stack_better
  FROM
   (SELECT s.name, s.version, s.step
    FROM
     (SELECT name, version, step, test_score AS stack_test_score
      FROM model_score
      WHERE lower(model) LIKE '%stack%') AS s
    JOIN
     (SELECT name, version, step, MAX(test_score) AS max_nonstack_test_score
      FROM model_score
      WHERE lower(model) NOT LIKE '%stack%'
      GROUP BY name, version, step) AS n
    ON s.name = n.name AND s.version = n.version AND s.step = n.step
    WHERE s.stack_test_score > n.max_nonstack_test_score
      AND s.step IN (1, 2, 3)
   )
  GROUP BY name
 ) AS sb
JOIN
 (
  SELECT name, COUNT(*) AS cnt_solution_rows
  FROM solution
  GROUP BY name
 ) AS sol
ON sb.name = sol.name
WHERE sb.cnt_stack_better > sol.cnt_solution_rows
LIMIT 20;
```
