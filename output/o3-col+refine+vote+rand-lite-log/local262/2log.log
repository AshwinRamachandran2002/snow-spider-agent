-- 8) Count, for every problem, how many such Stack-winning steps exist
SELECT name,
       COUNT(*) AS stack_win_count
FROM   (
        /* sub-query 7 reproduced */
        SELECT a.name,
               a.version,
               a.step
        FROM   (
                SELECT name,
                       version,
                       step,
                       test_score AS stack_test
                FROM   model_score
                WHERE  model LIKE '%Stack%'
               ) AS a
        JOIN   (
                SELECT name,
                       version,
                       step,
                       MAX(test_score) AS max_nonstack_test
                FROM   model_score
                WHERE  model NOT LIKE '%Stack%'
                GROUP  BY name,
                          version,
                          step
               ) AS b
        ON     a.name    = b.name
        AND    a.version = b.version
        AND    a.step    = b.step
        WHERE  a.stack_test > b.max_nonstack_test
       ) t
GROUP  BY name
LIMIT 20;
