```sql
-- 6) Fetch the “Stack” test score for every problem / version / step
SELECT name,
       version,
       step,
       test_score AS stack_test
FROM   model_score
WHERE  model LIKE '%Stack%'
LIMIT 20;
```

```sql
-- 7) Steps (problem / version / step) where the Stack model beats the best non-Stack model
SELECT a.name,
       a.version,
       a.step
FROM   (
        SELECT name,
               version,
               step,
               test_score AS stack_test
        FROM   model_score
        WHERE  model LIKE '%Stack%'
       ) AS a
JOIN   (
        SELECT name,
               version,
               step,
               MAX(test_score) AS max_nonstack_test
        FROM   model_score
        WHERE  model NOT LIKE '%Stack%'
        GROUP  BY name,
                  version,
                  step
       ) AS b
ON     a.name    = b.name
AND    a.version = b.version
AND    a.step    = b.step
WHERE  a.stack_test > b.max_nonstack_test
LIMIT 20;
```

```sql
-- 8) Count, for every problem, how many such Stack-winning steps exist
SELECT name,
       COUNT(*) AS stack_win_count
FROM   (
        /* sub-query 7 reproduced */
        SELECT a.name,
               a.version,
               a.step
        FROM   (
                SELECT name,
                       version,
                       step,
                       test_score AS stack_test
                FROM   model_score
                WHERE  model LIKE '%Stack%'
               ) AS a
        JOIN   (
                SELECT name,
                       version,
                       step,
                       MAX(test_score) AS max_nonstack_test
                FROM   model_score
                WHERE  model NOT LIKE '%Stack%'
                GROUP  BY name,
                          version,
                          step
               ) AS b
        ON     a.name    = b.name
        AND    a.version = b.version
        AND    a.step    = b.step
        WHERE  a.stack_test > b.max_nonstack_test
       ) t
GROUP  BY name
LIMIT 20;
```

```sql
-- 9) How many rows each problem has in the solution table (across all versions)
SELECT name,
       COUNT(*) AS solution_count
FROM   solution
GROUP  BY name
LIMIT 20;
```

```sql
-- 10) Final answer – problems whose Stack-winning-step count exceeds their total occurrences in the solution table
SELECT w.name
FROM   (
        /* result of query 8 */
        SELECT name,
               COUNT(*) AS stack_win_count
        FROM   (
                SELECT a.name,
                       a.version,
                       a.step
                FROM   (
                        SELECT name,
                               version,
                               step,
                               test_score AS stack_test
                        FROM   model_score
                        WHERE  model LIKE '%Stack%'
                       ) AS a
                JOIN   (
                        SELECT name,
                               version,
                               step,
                               MAX(test_score) AS max_nonstack_test
                        FROM   model_score
                        WHERE  model NOT LIKE '%Stack%'
                        GROUP  BY name,
                                  version,
                                  step
                       ) AS b
                ON     a.name    = b.name
                AND    a.version = b.version
                AND    a.step    = b.step
                WHERE  a.stack_test > b.max_nonstack_test
               ) tmp
        GROUP  BY name
       ) AS w
JOIN   (
        /* result of query 9 */
        SELECT name,
               COUNT(*) AS solution_count
        FROM   solution
        GROUP  BY name
       ) AS s
ON     w.name = s.name
WHERE  w.stack_win_count > s.solution_count;
```
