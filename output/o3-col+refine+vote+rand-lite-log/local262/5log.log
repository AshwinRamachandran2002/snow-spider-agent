-- 9. Count, across steps 1-3, how many times Stack outperforms all non-Stacks
WITH stack_only AS (
     SELECT "name","version","step",MAX("test_score") AS stack_test
     FROM   "model_score"
     WHERE  LOWER("model") LIKE '%stack%'
     GROUP  BY "name","version","step"
),
non_stack AS (
     SELECT "name","version","step",MAX("test_score") AS max_non_stack
     FROM   "model_score"
     WHERE  LOWER("model") NOT LIKE '%stack%'
     GROUP  BY "name","version","step"
),
better AS (
     SELECT n."name"
     FROM   non_stack AS n
     JOIN   stack_only AS s
            USING ("name","version","step")
     WHERE  n.max_non_stack < s.stack_test
       AND  n."step" IN (1,2,3)
)
SELECT "name",
       COUNT(*) AS nb_better_steps
FROM   better
GROUP  BY "name";
