```sql
-- 1. Distinct problem names that have any model evaluation records
SELECT DISTINCT "name"
FROM "model_score"
LIMIT 20;
```

```sql
-- 2. List every distinct model identifier to spot how “Stack” models are written
SELECT DISTINCT "model"
FROM "model_score"
LIMIT 20;
```

```sql
-- 3. Check which models contain the word “Stack” (any-case)  
SELECT DISTINCT "model"
FROM "model_score"
WHERE LOWER("model") LIKE '%stack%'
LIMIT 20;
```

```sql
-- 4. Look at one problem (“iris” shown in samples) to compare Stack vs. non-Stack scores
SELECT "version",
       "step",
       "model",
       "test_score"
FROM   "model_score"
WHERE  "name" = 'iris'
ORDER  BY "version", "step", "model"
LIMIT 20;
```

```sql
-- 5. For every (name,version,step) keep the BEST non-Stack test score
WITH non_stack AS (
     SELECT "name",
            "version",
            "step",
            MAX("test_score") AS max_non_stack
     FROM   "model_score"
     WHERE  LOWER("model") NOT LIKE '%stack%'
     GROUP  BY "name","version","step"
)
SELECT *
FROM   non_stack
LIMIT 20;
```

```sql
-- 6. BEST Stack test score for the same (name,version,step)
WITH stack_only AS (
     SELECT "name",
            "version",
            "step",
            MAX("test_score") AS stack_test
     FROM   "model_score"
     WHERE  LOWER("model") LIKE '%stack%'
     GROUP  BY "name","version","step"
)
SELECT *
FROM   stack_only
LIMIT 20;
```

```sql
-- 7. Steps where the Stack score beats every non-Stack score
WITH stack_only AS (
     SELECT "name","version","step",MAX("test_score") AS stack_test
     FROM   "model_score"
     WHERE  LOWER("model") LIKE '%stack%'
     GROUP  BY "name","version","step"
),
non_stack AS (
     SELECT "name","version","step",MAX("test_score") AS max_non_stack
     FROM   "model_score"
     WHERE  LOWER("model") NOT LIKE '%stack%'
     GROUP  BY "name","version","step"
)
SELECT n."name",
       n."version",
       n."step",
       n.max_non_stack,
       s.stack_test
FROM   non_stack AS n
JOIN   stack_only AS s
       USING ("name","version","step")
WHERE  n.max_non_stack < s.stack_test
LIMIT 20;
```

```sql
-- 8. How many times each problem appears in the solution table
SELECT "name",
       COUNT(*) AS nb_in_solution
FROM   "solution"
GROUP  BY "name";
```

```sql
-- 9. Count, across steps 1-3, how many times Stack outperforms all non-Stacks
WITH stack_only AS (
     SELECT "name","version","step",MAX("test_score") AS stack_test
     FROM   "model_score"
     WHERE  LOWER("model") LIKE '%stack%'
     GROUP  BY "name","version","step"
),
non_stack AS (
     SELECT "name","version","step",MAX("test_score") AS max_non_stack
     FROM   "model_score"
     WHERE  LOWER("model") NOT LIKE '%stack%'
     GROUP  BY "name","version","step"
),
better AS (
     SELECT n."name"
     FROM   non_stack AS n
     JOIN   stack_only AS s
            USING ("name","version","step")
     WHERE  n.max_non_stack < s.stack_test
       AND  n."step" IN (1,2,3)
)
SELECT "name",
       COUNT(*) AS nb_better_steps
FROM   better
GROUP  BY "name";
```

```sql
-- 10. FINAL ANSWER: problems where nb_better_steps > nb_in_solution
WITH stack_only AS (
     SELECT "name","version","step",MAX("test_score") AS stack_test
     FROM   "model_score"
     WHERE  LOWER("model") LIKE '%stack%'
     GROUP  BY "name","version","step"
),
non_stack AS (
     SELECT "name","version","step",MAX("test_score") AS max_non_stack
     FROM   "model_score"
     WHERE  LOWER("model") NOT LIKE '%stack%'
     GROUP  BY "name","version","step"
),
better AS (
     SELECT n."name","version","step"
     FROM   non_stack AS n
     JOIN   stack_only AS s
            USING ("name","version","step")
     WHERE  n.max_non_stack < s.stack_test
       AND  n."step" IN (1,2,3)
),
cnt_better AS (
     SELECT "name",COUNT(*) AS nb_better_steps
     FROM   better
     GROUP  BY "name"
),
cnt_solution AS (
     SELECT "name",COUNT(*) AS nb_in_solution
     FROM   "solution"
     GROUP  BY "name"
)
SELECT DISTINCT c."name"
FROM   cnt_better  AS c
JOIN   cnt_solution AS s
       USING ("name")
WHERE  c.nb_better_steps > s.nb_in_solution;
```
