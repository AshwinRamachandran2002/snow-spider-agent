```sql
-- 7. Count, for every problem, how many (version,step) pairs have
--    stack_test_score > non_stack_best
WITH stack AS (
        SELECT  ms."name", ms."version", ms."step",
                MAX(ms."test_score") AS stack_test_score
        FROM    "model_score" AS ms
        WHERE   ms."model" LIKE '%Stack%'
          AND   ms."step" IN (1,2,3)
        GROUP BY ms."name", ms."version", ms."step"
),
nonstack AS (
        SELECT  ms."name", ms."version", ms."step",
                MAX(ms."test_score") AS non_stack_best
        FROM    "model_score" AS ms
        WHERE   ms."model" NOT LIKE '%Stack%'
          AND   ms."step" IN (1,2,3)
        GROUP BY ms."name", ms."version", ms."step"
),
wins AS (
        SELECT  s."name", s."version", s."step"
        FROM    stack AS s
        JOIN    nonstack AS n
               ON s."name"    = n."name"
              AND s."version" = n."version"
              AND s."step"    = n."step"
        WHERE   s.stack_test_score > n.non_stack_best
)
SELECT  w."name",
        COUNT(*)                           AS "nb_stack_wins",
        solcnt.nb_solution_rows
FROM    wins AS w
JOIN   (
        SELECT "name", COUNT(*) AS nb_solution_rows
        FROM   "solution"
        GROUP  BY "name"
       ) AS solcnt
  ON w."name" = solcnt."name"
GROUP  BY w."name"
HAVING COUNT(*) > solcnt.nb_solution_rows
LIMIT 20;
```

The last query identifies the problems whose number of (version, step) wins by a “Stack” model is greater than their total row count in the solution table, exactly answering the question.
