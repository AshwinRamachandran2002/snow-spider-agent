```sql
--Description: 1) See which problems are present in the “solution” table (one row per problem & version)
SELECT DISTINCT "name", "version"
FROM   "solution"
LIMIT 20;
```

```sql
--Description: 2) Inspect every different model name that appears in “model_score”
SELECT DISTINCT "model"
FROM   "model_score"
LIMIT 20;
```

```sql
--Description: 3) List only the models whose label contains the word “Stack” so we know how they are written
SELECT DISTINCT "model"
FROM   "model_score"
WHERE  "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
--Description: 4) Look at all scores, separating the Stack models from the non-Stack models – useful for eye-checking
SELECT   ms."name",
         ms."version",
         ms."step",
         ms."model",
         ms."test_score",
         CASE WHEN ms."model" LIKE '%Stack%' THEN 1 ELSE 0 END AS "is_stack"
FROM     "model_score" AS ms
ORDER BY ms."name", ms."version", ms."step", "is_stack" DESC
LIMIT 20;
```

```sql
--Description: 5) For every problem / version / step, get the best Stack test-score and the best non-Stack test-score
SELECT   tmp."name",
         tmp."version",
         tmp."step",
         MAX(CASE WHEN "is_stack" = 1 THEN "test_score" END) AS "stack_best",
         MAX(CASE WHEN "is_stack" = 0 THEN "test_score" END) AS "non_stack_best"
FROM    (
        SELECT "name",
               "version",
               "step",
               "test_score",
               CASE WHEN "model" LIKE '%Stack%' THEN 1 ELSE 0 END AS "is_stack"
        FROM   "model_score"
        WHERE  "step" IN (1,2,3)
       ) AS tmp
GROUP BY tmp."name", tmp."version", tmp."step"
LIMIT 20;
```

```sql
--Description: 6) Keep only (problem,version,step) rows where the Stack score is strictly higher than every non-Stack score
WITH bests AS (
     SELECT   tmp."name",
              tmp."version",
              tmp."step",
              MAX(CASE WHEN "is_stack" = 1 THEN "test_score" END) AS "stack_best",
              MAX(CASE WHEN "is_stack" = 0 THEN "test_score" END) AS "non_stack_best"
     FROM    (
             SELECT "name",
                    "version",
                    "step",
                    "test_score",
                    CASE WHEN "model" LIKE '%Stack%' THEN 1 ELSE 0 END AS "is_stack"
             FROM   "model_score"
             WHERE  "step" IN (1,2,3)
            ) AS tmp
     GROUP BY tmp."name", tmp."version", tmp."step"
)
SELECT *
FROM   bests
WHERE  "stack_best" IS NOT NULL            -- at least one Stack model
  AND  ("non_stack_best" IS NULL            -- or no non-Stack model exists
        OR "stack_best" > "non_stack_best")
LIMIT 20;
```

```sql
--Description: 7) Count how many (problem,version,step) combos satisfy the superiority condition for each problem
WITH winner AS (
     -- same CTE as query 6
     SELECT   tmp."name",
              tmp."version",
              tmp."step",
              MAX(CASE WHEN "is_stack" = 1 THEN "test_score" END) AS "stack_best",
              MAX(CASE WHEN "is_stack" = 0 THEN "test_score" END) AS "non_stack_best"
     FROM    (
             SELECT "name",
                    "version",
                    "step",
                    "test_score",
                    CASE WHEN "model" LIKE '%Stack%' THEN 1 ELSE 0 END AS "is_stack"
             FROM   "model_score"
             WHERE  "step" IN (1,2,3)
            ) AS tmp
     GROUP BY tmp."name", tmp."version", tmp."step"
     HAVING  "stack_best" IS NOT NULL
        AND ("non_stack_best" IS NULL OR "stack_best" > "non_stack_best")
)
SELECT   "name",
         COUNT(*) AS "nb_superior_steps"
FROM     winner
GROUP BY "name"
LIMIT 20;
```

```sql
--Description: 8) Count how many rows each problem has in the “solution” table (i.e., total occurrences)
SELECT   "name",
         COUNT(*) AS "nb_solution_rows"
FROM     "solution"
GROUP BY "name"
LIMIT 20;
```

```sql
--Description: 9) Compare both counts and keep the problems whose Stack-wins (across steps 1-3) exceed the solution-rows count
WITH winner AS (
     SELECT   tmp."name",
              tmp."version",
              tmp."step",
              MAX(CASE WHEN "is_stack" = 1 THEN "test_score" END) AS "stack_best",
              MAX(CASE WHEN "is_stack" = 0 THEN "test_score" END) AS "non_stack_best"
     FROM    (
             SELECT "name",
                    "version",
                    "step",
                    "test_score",
                    CASE WHEN "model" LIKE '%Stack%' THEN 1 ELSE 0 END AS "is_stack"
             FROM   "model_score"
             WHERE  "step" IN (1,2,3)
            ) AS tmp
     GROUP BY tmp."name", tmp."version", tmp."step"
     HAVING  "stack_best" IS NOT NULL
        AND ("non_stack_best" IS NULL OR "stack_best" > "non_stack_best")
),
stack_wins AS (
     SELECT "name", COUNT(*) AS "nb_superior_steps"
     FROM   winner
     GROUP BY "name"
),
solution_rows AS (
     SELECT "name", COUNT(*) AS "nb_solution_rows"
     FROM   "solution"
     GROUP BY "name"
)
SELECT sw."name"
FROM   stack_wins     AS sw
JOIN   solution_rows AS sr USING ("name")
WHERE  sw."nb_superior_steps" > sr."nb_solution_rows"
LIMIT 20;
```

