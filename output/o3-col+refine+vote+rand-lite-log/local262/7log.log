--Description: 7) Count how many (problem,version,step) combos satisfy the superiority condition for each problem
WITH winner AS (
     -- same CTE as query 6
     SELECT   tmp."name",
              tmp."version",
              tmp."step",
              MAX(CASE WHEN "is_stack" = 1 THEN "test_score" END) AS "stack_best",
              MAX(CASE WHEN "is_stack" = 0 THEN "test_score" END) AS "non_stack_best"
     FROM    (
             SELECT "name",
