```sql
--Description: 5)  For every problem-version-step, collect the best “Stack” test score and the best non-“Stack” test score.
WITH per_step AS (
    SELECT name,
           version,
           step,
           MAX(CASE WHEN model LIKE '%Stack%' THEN test_score END)  AS stack_score,
           MAX(CASE WHEN model NOT LIKE '%Stack%' THEN test_score END) AS nonstack_max
    FROM model_score
    GROUP BY name, version, step
)
SELECT *
FROM per_step
LIMIT 20;
```

```sql
--Description: 6)  Keep only those steps where the best “Stack” score beats the best non-“Stack” score.
WITH per_step AS (
    SELECT name,
           version,
           step,
           MAX(CASE WHEN model LIKE '%Stack%' THEN test_score END)  AS stack_score,
           MAX(CASE WHEN model NOT LIKE '%Stack%' THEN test_score END) AS nonstack_max
    FROM model_score
    GROUP BY name, version, step
)
SELECT name,
       version,
       step
FROM per_step
WHERE stack_score IS NOT NULL
  AND nonstack_max IS NOT NULL
  AND stack_score > nonstack_max
LIMIT 20;
```

```sql
--Description: 7)  Count, per problem, how many steps (across steps 1-3) satisfy that “Stack” > max(non-“Stack”).
WITH per_step AS (
    SELECT name,
           version,
           step,
           MAX(CASE WHEN model LIKE '%Stack%' THEN test_score END)  AS stack_score,
           MAX(CASE WHEN model NOT LIKE '%Stack%' THEN test_score END) AS nonstack_max
    FROM model_score
    GROUP BY name, version, step
),
better_steps AS (
    SELECT name, version, step
    FROM per_step
    WHERE stack_score IS NOT NULL
      AND nonstack_max IS NOT NULL
      AND stack_score > nonstack_max
)
SELECT name,
       COUNT(*) AS better_stack_steps
FROM better_steps
GROUP BY name
LIMIT 20;
```

```sql
--Description: 8)  Final answer – problems whose count of “better Stack” steps exceeds their total solution rows.
WITH per_step AS (
    SELECT name,
           version,
           step,
           MAX(CASE WHEN model LIKE '%Stack%' THEN test_score END)  AS stack_score,
           MAX(CASE WHEN model NOT LIKE '%Stack%' THEN test_score END) AS nonstack_max
    FROM model_score
    GROUP BY name, version, step
),
better_steps AS (
    SELECT name, version, step
    FROM per_step
    WHERE stack_score IS NOT NULL
      AND nonstack_max IS NOT NULL
      AND stack_score > nonstack_max
),
stack_count AS (
    SELECT name,
           COUNT(*) AS better_stack_steps
    FROM better_steps
    GROUP BY name
),
solution_count AS (
    SELECT name,
           COUNT(*) AS solution_rows
    FROM solution
    GROUP BY name
)
SELECT sc.name
FROM stack_count AS sc
JOIN solution_count AS s
  ON sc.name = s.name
WHERE sc.better_stack_steps > s.solution_rows
LIMIT 20;
```
