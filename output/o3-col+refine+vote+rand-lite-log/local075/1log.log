--Description: 7) “Left-in-Cart” count per product.
--   For every (visit_id , product) that had an Add-to-Cart (event_type = 2, desired pages),
--   we keep it ONLY IF that same visit never shows any Purchase event (event_type = 3)
--   for any page.  Then count those surviving visits for every product.
SELECT   ph."product_id",
         COUNT(DISTINCT e."visit_id") AS "left_in_cart_count"
FROM     "shopping_cart_events"          AS e
JOIN     "shopping_cart_page_hierarchy"  AS ph
       ON e."page_id" = ph."page_id"
WHERE    e."event_type" = 2                    -- Add-to-Cart
  AND    e."page_id" NOT IN (1,2,12,13)        -- ignore generic pages
  AND    NOT EXISTS (                          -- eliminate visits with any purchase
           SELECT 1
           FROM   "shopping_cart_events" p
           WHERE  p."visit_id"   = e."visit_id"
             AND  p."event_type" = 3           -- Purchase
         )
GROUP BY ph."product_id"
LIMIT 20
