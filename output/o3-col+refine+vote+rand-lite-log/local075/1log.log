--              1) Four CTEs aggregate each metric, excluding the generic pages (1,2,12,13).  
--              2) all_products is the UNION of every product_id that appears in any metric, 
--                 giving a master list (the “outer” side of a full outer join).  
--              3) LEFT JOIN each metric back to that list and COALESCE NULLs to 0, 
--                 yielding one row per product with all four counts.  
--              4) LIMIT 20 for inspection.
WITH
views AS (
  SELECT ph."product_id", COUNT(*) AS views
  FROM   "shopping_cart_events" e
  JOIN   "shopping_cart_page_hierarchy" ph ON e."page_id" = ph."page_id"
  WHERE  e."event_type" = 1
    AND  e."page_id" NOT IN (1,2,12,13)
  GROUP BY ph."product_id"
),
