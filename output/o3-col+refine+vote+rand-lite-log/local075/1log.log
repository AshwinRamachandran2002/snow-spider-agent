```sql
--Description: 7) “Left-in-Cart” count per product.
--   For every (visit_id , product) that had an Add-to-Cart (event_type = 2, desired pages),
--   we keep it ONLY IF that same visit never shows any Purchase event (event_type = 3)
--   for any page.  Then count those surviving visits for every product.
SELECT   ph."product_id",
         COUNT(DISTINCT e."visit_id") AS "left_in_cart_count"
FROM     "shopping_cart_events"          AS e
JOIN     "shopping_cart_page_hierarchy"  AS ph
       ON e."page_id" = ph."page_id"
WHERE    e."event_type" = 2                    -- Add-to-Cart
  AND    e."page_id" NOT IN (1,2,12,13)        -- ignore generic pages
  AND    NOT EXISTS (                          -- eliminate visits with any purchase
           SELECT 1
           FROM   "shopping_cart_events" p
           WHERE  p."visit_id"   = e."visit_id"
             AND  p."event_type" = 3           -- Purchase
         )
GROUP BY ph."product_id"
LIMIT 20;
```

```sql
--Description: 8) Final consolidation: views, add-to-carts, left-in-carts and purchases per product.
--              Uses separate sub-queries for each metric then FULL OUTER-style assembly via UNION.
WITH
views AS (
  SELECT ph."product_id", COUNT(*) AS views
  FROM   "shopping_cart_events"  e
  JOIN   "shopping_cart_page_hierarchy" ph ON e."page_id" = ph."page_id"
  WHERE  e."event_type" = 1
    AND  e."page_id" NOT IN (1,2,12,13)
  GROUP  BY ph."product_id"
),
adds AS (
  SELECT ph."product_id", COUNT(*) AS add_to_cart
  FROM   "shopping_cart_events"  e
  JOIN   "shopping_cart_page_hierarchy" ph ON e."page_id" = ph."page_id"
  WHERE  e."event_type" = 2
    AND  e."page_id" NOT IN (1,2,12,13)
  GROUP  BY ph."product_id"
),
purch AS (
  /* might be empty — handled later with COALESCE */
  SELECT ph."product_id", COUNT(*) AS purchases
  FROM   "shopping_cart_events"  e
  JOIN   "shopping_cart_page_hierarchy" ph ON e."page_id" = ph."page_id"
  WHERE  e."event_type" = 3
    AND  e."page_id" NOT IN (1,2,12,13)
  GROUP  BY ph."product_id"
),
left_cart AS (
  SELECT ph."product_id",
         COUNT(DISTINCT e."visit_id") AS left_in_cart
  FROM   "shopping_cart_events"  e
  JOIN   "shopping_cart_page_hierarchy" ph ON e."page_id" = ph."page_id"
  WHERE  e."event_type" = 2
    AND  e."page_id" NOT IN (1,2,12,13)
    AND  NOT EXISTS (
           SELECT 1
           FROM   "shopping_cart_events" p
           WHERE  p."visit_id" = e."visit_id"
             AND  p."event_type" = 3
         )
  GROUP  BY ph."product_id"
)
SELECT   COALESCE(v."product_id", a."product_id", l."product_id", p."product_id") AS "product_id",
         COALESCE(v.views,        0) AS views,
         COALESCE(a.add_to_cart,  0) AS add_to_cart,
         COALESCE(l.left_in_cart, 0) AS left_in_cart,
         COALESCE(p.purchases,    0) AS purchases
FROM     views       v
FULL JOIN adds       a ON a."product_id" = v."product_id"
FULL JOIN left_cart  l ON l."product_id" = COALESCE(v."product_id", a."product_id")
FULL JOIN purch      p ON p."product_id" = COALESCE(v."product_id", a."product_id", l."product_id")
ORDER BY "product_id"
LIMIT 20;
```
