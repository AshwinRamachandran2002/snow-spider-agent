```sql
--Description: 7) Derive visits where a product was added to the cart BUT never purchased
--   (i.e. “left in cart”) and count those visits per product
SELECT  t."product_id",
        COUNT(*) AS "left_in_cart_count"
FROM   (
        -- All (visit, product) combinations that had an Add-to-Cart
        SELECT DISTINCT e."visit_id", ph."product_id"
        FROM   "shopping_cart_events"  e
        JOIN   "shopping_cart_page_hierarchy" ph
               ON e."page_id" = ph."page_id"
        WHERE  e."event_type" = 2
          AND  e."page_id" NOT IN (1,2,12,13)

        EXCEPT
      
        -- Remove the (visit, product) combinations that eventually had a Purchase
        SELECT DISTINCT e."visit_id", ph."product_id"
        FROM   "shopping_cart_events"  e
        JOIN   "shopping_cart_page_hierarchy" ph
               ON e."page_id" = ph."page_id"
        WHERE  e."event_type" = 3
          AND  e."page_id" NOT IN (1,2,12,13)
      )  AS t
GROUP BY t."product_id"
LIMIT 20;
```

```sql
--Description: 8) Consolidate everything into one final summary table for each product
SELECT   v."product_id",
         COALESCE(v."view_count",0)          AS "views",
         COALESCE(a."add_to_cart_count",0)   AS "add_to_cart",
         COALESCE(l."left_in_cart_count",0)  AS "left_in_cart",
         COALESCE(p."purchase_count",0)      AS "purchases"
FROM     ( /* views  */
          SELECT ph."product_id", COUNT(*) AS "view_count"
          FROM   "shopping_cart_events"  e
          JOIN   "shopping_cart_page_hierarchy" ph
                 ON e."page_id" = ph."page_id"
          WHERE  e."event_type" = 1
            AND  e."page_id" NOT IN (1,2,12,13)
          GROUP BY ph."product_id"
         ) v
LEFT JOIN
         ( /* add-to-cart */
          SELECT ph."product_id", COUNT(*) AS "add_to_cart_count"
          FROM   "shopping_cart_events"  e
          JOIN   "shopping_cart_page_hierarchy" ph
                 ON e."page_id" = ph."page_id"
          WHERE  e."event_type" = 2
            AND  e."page_id" NOT IN (1,2,12,13)
          GROUP BY ph."product_id"
         ) a  ON v."product_id" = a."product_id"
LEFT JOIN
         ( /* purchases */
          SELECT ph."product_id", COUNT(*) AS "purchase_count"
          FROM   "shopping_cart_events"  e
          JOIN   "shopping_cart_page_hierarchy" ph
                 ON e."page_id" = ph."page_id"
          WHERE  e."event_type" = 3
            AND  e."page_id" NOT IN (1,2,12,13)
          GROUP BY ph."product_id"
         ) p  ON v."product_id" = p."product_id"
LEFT JOIN
         ( /* left-in-cart */
          SELECT  t."product_id", COUNT(*) AS "left_in_cart_count"
          FROM   (
                   SELECT DISTINCT e."visit_id", ph."product_id"
                   FROM   "shopping_cart_events"  e
                   JOIN   "shopping_cart_page_hierarchy" ph
                          ON e."page_id" = ph."page_id"
                   WHERE  e."event_type" = 2
                     AND  e."page_id" NOT IN (1,2,12,13)
                   EXCEPT
                   SELECT DISTINCT e."visit_id", ph."product_id"
                   FROM   "shopping_cart_events"  e
                   JOIN   "shopping_cart_page_hierarchy" ph
                          ON e."page_id" = ph."page_id"
                   WHERE  e."event_type" = 3
                     AND  e."page_id" NOT IN (1,2,12,13)
                 ) AS t
          GROUP BY t."product_id"
         ) l  ON v."product_id" = l."product_id"
LIMIT 20;
```
