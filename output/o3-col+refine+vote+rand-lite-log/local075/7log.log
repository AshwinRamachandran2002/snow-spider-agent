GROUP  BY ph."product_id"
LIMIT 20;
```

```sql
--Description: number of “Add-to-Cart” actions (event_type = 2) for every product_id
SELECT DISTINCT ph."product_id",
                COUNT(*) AS "add_to_cart_count"
FROM   "shopping_cart_events"         ev
JOIN   "shopping_cart_page_hierarchy" ph
       ON ev."page_id" = ph."page_id"
WHERE  ev."event_type" = 2
  AND  ev."page_id"   NOT IN (1,2,12,13)
GROUP  BY ph."product_id"
LIMIT 20;
```

```sql
--Description: number of purchase events (event_type = 3) for every product_id
SELECT DISTINCT ph."product_id",
                COUNT(*) AS "purchase_count"
FROM   "shopping_cart_events"         ev
JOIN   "shopping_cart_page_hierarchy" ph
       ON ev."page_id" = ph."page_id"
WHERE  ev."event_type" = 3
  AND  ev."page_id"   NOT IN (1,2,12,13)
GROUP  BY ph."product_id"
LIMIT 20;
```

```sql
--Description: join the three previous aggregations so we can see
--             views, adds, and purchases side-by-side for each product
SELECT DISTINCT v."product_id",
                v."view_count",
                a."add_to_cart_count",
                p."purchase_count"
FROM   (SELECT ph."product_id", COUNT(*) AS "view_count"
        FROM   "shopping_cart_events" ev
        JOIN   "shopping_cart_page_hierarchy" ph
               ON ev."page_id" = ph."page_id"
        WHERE  ev."event_type" = 1
          AND  ev."page_id"   NOT IN (1,2,12,13)
        GROUP  BY ph."product_id") v
LEFT  JOIN
       (SELECT ph."product_id", COUNT(*) AS "add_to_cart_count"
        FROM   "shopping_cart_events" ev
        JOIN   "shopping_cart_page_hierarchy" ph
               ON ev."page_id" = ph."page_id"
        WHERE  ev."event_type" = 2
          AND  ev."page_id"   NOT IN (1,2,12,13)
        GROUP  BY ph."product_id") a
       ON v."product_id" = a."product_id"
LEFT  JOIN
       (SELECT ph."product_id", COUNT(*) AS "purchase_count"
        FROM   "shopping_cart_events" ev
        JOIN   "shopping_cart_page_hierarchy" ph
               ON ev."page_id" = ph."page_id"
        WHERE  ev."event_type" = 3
          AND  ev."page_id"   NOT IN (1,2,12,13)
        GROUP  BY ph."product_id") p
       ON v."product_id" = p."product_id"
LIMIT 20;
```

```sql
--Description: final breakdown – adds minus purchases == items left in cart
SELECT DISTINCT combined."product_id",
                combined."view_count",
                combined."add_to_cart_count",
                combined."purchase_count",
                COALESCE(combined."add_to_cart_count",0)
              - COALESCE(combined."purchase_count",0) AS "left_in_cart"
FROM   (
        SELECT v."product_id",
               v."view_count",
               COALESCE(a."add_to_cart_count",0) AS "add_to_cart_count",
               COALESCE(p."purchase_count",0)    AS "purchase_count"
        FROM   (SELECT ph."product_id", COUNT(*) AS "view_count"
                FROM   "shopping_cart_events" ev
                JOIN   "shopping_cart_page_hierarchy" ph
                       ON ev."page_id" = ph."page_id"
                WHERE  ev."event_type" = 1
                  AND  ev."page_id"   NOT IN (1,2,12,13)
                GROUP  BY ph."product_id") v
        LEFT  JOIN
               (SELECT ph."product_id", COUNT(*) AS "add_to_cart_count"
                FROM   "shopping_cart_events" ev
                JOIN   "shopping_cart_page_hierarchy" ph
                       ON ev."page_id" = ph."page_id"
                WHERE  ev."event_type" = 2
                  AND  ev."page_id"   NOT IN (1,2,12,13)
                GROUP  BY ph."product_id") a
               ON v."product_id" = a."product_id"
        LEFT  JOIN
               (SELECT ph."product_id", COUNT(*) AS "purchase_count"
                FROM   "shopping_cart_events" ev
                JOIN   "shopping_cart_page_hierarchy" ph
                       ON ev."page_id" = ph."page_id"
                WHERE  ev."event_type" = 3
                  AND  ev."page_id"   NOT IN (1,2,12,13)
                GROUP  BY ph."product_id") p
               ON v."product_id" = p."product_id"
       ) combined
LIMIT 20;
```

These seven queries (from quick inspection of codes 1-3 to the fully joined final calculation) gradually build up to the requested breakdown—view counts, add-to-cart counts, purchase counts, and the number of items left sitting in carts—while always excluding pages with IDs 1, 2, 12, and 13.
