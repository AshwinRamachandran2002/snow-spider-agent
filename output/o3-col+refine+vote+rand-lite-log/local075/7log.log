Query:
--Description: Final breakdown per product – how many items were left in cart
--             (adds minus purchases).  Purchases are counted across all pages so
--             the subtraction is always safe (NULLs handled with COALESCE).
SELECT combined."product_id",
       combined."view_count",
       combined."add_to_cart_count",
       combined."purchase_count",
       combined."add_to_cart_count" - combined."purchase_count" AS "left_in_cart"
FROM  (
        SELECT v."product_id",
               v."view_count",
               COALESCE(a."add_to_cart_count",0) AS "add_to_cart_count",
               COALESCE(p."purchase_count",0)    AS "purchase_count"
        FROM (
                SELECT ph."product_id", COUNT(*) AS "view_count"
                FROM   "shopping_cart_events"         ev
                JOIN   "shopping_cart_page_hierarchy" ph
                       ON ev."page_id" = ph."page_id"
                WHERE  ev."event_type" = 1
                  AND  ev."page_id"   NOT IN (1,2,12,13)
                GROUP  BY ph."product_id"
        ) v
        LEFT JOIN (
                SELECT ph."product_id", COUNT(*) AS "add_to_cart_count"
                FROM   "shopping_cart_events"         ev
                JOIN   "shopping_cart_page_hierarchy" ph
                       ON ev."page_id" = ph."page_id"
                WHERE  ev."event_type" = 2
                  AND  ev."page_id"   NOT IN (1,2,12,13)
                GROUP  BY ph."product_id"
        ) a ON v."product_id" = a."product_id"
        LEFT JOIN (
                -- purchase counts with no exclusions
                SELECT ph."product_id", COUNT(*) AS "purchase_count"
                FROM   "shopping_cart_events"         ev
                JOIN   "shopping_cart_page_hierarchy" ph
                       ON ev."page_id" = ph."page_id"
                WHERE  ev."event_type" = 3
                GROUP  BY ph."product_id"
        ) p ON v."product_id" = p."product_id"
) combined
LIMIT 20
