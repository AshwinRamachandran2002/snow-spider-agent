```sql
--Description: Bring all three aggregations together (views, add-to-cart, purchases)  
--to calculate the number of items left in cart.  
--Only Page-View (1) and Add-to-Cart (2) events keep the generic page exclusion,  
--while Purchase events (3) are counted with NO page-id filter (because they live  
--on pages 12/13).  Any product_id that has no matching purchase rows will show  
--NULL from the LEFT JOIN, which we treat as zero via IFNULL().
SELECT
       v."product_id",
       v."views",
       a."adds_to_cart",
       IFNULL(p."purchases",0)            AS "purchases",
       (a."adds_to_cart" - IFNULL(p."purchases",0)) AS "left_in_cart"
FROM   ( /* PAGE VIEWS ---------------------------------------------------- */
         SELECT h."product_id", COUNT(*) AS "views"
         FROM   "shopping_cart_events" AS e
         JOIN   "shopping_cart_page_hierarchy" AS h
                ON e."page_id" = h."page_id"
         WHERE  e."event_type" = 1
           AND  e."page_id" NOT IN (1,2,12,13)
         GROUP BY h."product_id"
       ) AS v
LEFT JOIN
       ( /* ADD-TO-CART ---------------------------------------------------- */
         SELECT h."product_id", COUNT(*) AS "adds_to_cart"
         FROM   "shopping_cart_events" AS e
         JOIN   "shopping_cart_page_hierarchy" AS h
                ON e."page_id" = h."page_id"
         WHERE  e."event_type" = 2
           AND  e."page_id" NOT IN (1,2,12,13)
         GROUP BY h."product_id"
       ) AS a
  ON v."product_id" = a."product_id"
LEFT JOIN
       ( /* PURCHASES (no page filter) ------------------------------------ */
         SELECT h."product_id", COUNT(*) AS "purchases"
         FROM   "shopping_cart_events" AS e
         JOIN   "shopping_cart_page_hierarchy" AS h
                ON e."page_id" = h."page_id"
         WHERE  e."event_type" = 3
         GROUP  BY h."product_id"
       ) AS p
  ON v."product_id" = p."product_id"
LIMIT 20;
```

