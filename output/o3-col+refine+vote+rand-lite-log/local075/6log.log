```sql
-- Description: see which pages really represent shoppable products (filtering out 1,2,12,13)
SELECT DISTINCT "page_id",
                "product_id"
FROM "shopping_cart_page_hierarchy"
WHERE "page_id" NOT IN (1,2,12,13)
LIMIT 20;
```

```sql
-- Description: sample of raw events already joined to the product catalogue (excluded pages removed)
SELECT  e."visit_id",
        e."page_id",
        p."product_id",
        e."event_type",
        e."event_time"
FROM    "shopping_cart_events"            AS e
JOIN    "shopping_cart_page_hierarchy"    AS p
           ON e."page_id" = p."page_id"
WHERE   e."page_id" NOT IN (1,2,12,13)
LIMIT 20;
```

```sql
-- Description: simple grouped counts – how many events of each type per product
SELECT  p."product_id",
        e."event_type",
        COUNT(*) AS "event_cnt"
FROM    "shopping_cart_events"            AS e
JOIN    "shopping_cart_page_hierarchy"    AS p
           ON e."page_id" = p."page_id"
WHERE   e."page_id" NOT IN (1,2,12,13)
GROUP BY p."product_id",
         e."event_type"
LIMIT 20;
```

```sql
-- Description: pivot the previous result – counts of views, add-to-cart and purchases for each product
SELECT  p."product_id",
        SUM(CASE WHEN e."event_type" = 1 THEN 1 ELSE 0 END) AS "views",
        SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END) AS "add_to_cart",
        SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "purchases"
FROM    "shopping_cart_events"            AS e
JOIN    "shopping_cart_page_hierarchy"    AS p
           ON e."page_id" = p."page_id"
WHERE   e."page_id" NOT IN (1,2,12,13)
GROUP BY p."product_id"
LIMIT 20;
```

```sql
-- Description: final breakdown – also derive “left in cart” (add-to-cart minus actual purchases)
SELECT  p."product_id",
        SUM(CASE WHEN e."event_type" = 1 THEN 1 ELSE 0 END) AS "views",
        SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END) AS "add_to_cart",
        SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) AS "purchases",
        ( SUM(CASE WHEN e."event_type" = 2 THEN 1 ELSE 0 END)
        - SUM(CASE WHEN e."event_type" = 3 THEN 1 ELSE 0 END) )           AS "left_in_cart"
FROM    "shopping_cart_events"            AS e
JOIN    "shopping_cart_page_hierarchy"    AS p
           ON e."page_id" = p."page_id"
WHERE   e."page_id" NOT IN (1,2,12,13)
GROUP BY p."product_id"
LIMIT 20;
```
