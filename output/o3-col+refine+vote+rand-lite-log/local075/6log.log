Query:
-- Description: simple grouped counts – how many events of each type per product
SELECT  p."product_id",
        e."event_type",
        COUNT(*) AS "event_cnt"
FROM    "shopping_cart_events"            AS e
JOIN    "shopping_cart_page_hierarchy"    AS p
           ON e."page_id" = p."page_id"
WHERE   e."page_id" NOT IN (1,2,12,13)
GROUP BY p."product_id",
         e."event_type"
LIMIT 20;
