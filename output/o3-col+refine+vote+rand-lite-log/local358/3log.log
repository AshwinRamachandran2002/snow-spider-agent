Query:
-- Description: If you prefer to anchor the age calculation on a fixed date (e.g. 2017-01-01) instead of 'now'
SELECT
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END AS "age_band_fixed_2017_01_01",
  COUNT(*) AS "users"
FROM (
  SELECT
    CAST( '2017' - substr("birth_date",1,4)
          - ('01-01' < substr("birth_date",6,5)) AS INTEGER) AS age
  FROM "mst_users"
)
GROUP BY "age_band_fixed_2017_01_01";
Answer:
age_band_fixed_2017_01_01,users
20s,88
30s,24
40s,24
50s,56
others,128
