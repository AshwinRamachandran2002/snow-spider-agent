```sql
-- Description: Check the columns available in the master user table and preview a few rows
SELECT DISTINCT "user_id", "birth_date"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Look at the range of birth years to understand possible ages
SELECT
  MIN(substr("birth_date", 1, 4))  AS "oldest_birth_year",
  MAX(substr("birth_date", 1, 4))  AS "youngest_birth_year"
FROM "mst_users";
```

```sql
-- Description: Calculate each user’s (integer) age today for a sanity-check sample
SELECT
  "user_id",
  CAST( strftime('%Y','now') - substr("birth_date",1,4)
        - (strftime('%m-%d','now') < substr("birth_date",6,5)) AS INTEGER) AS "age_now"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Assign every user to an age-bucket (20s, 30s, 40s, 50s, others) and list a few
SELECT
  "user_id",
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END AS "age_band"
FROM (
  SELECT
    "user_id",
    CAST( strftime('%Y','now') - substr("birth_date",1,4)
          - (strftime('%m-%d','now') < substr("birth_date",6,5)) AS INTEGER) AS age
  FROM "mst_users"
)
LIMIT 20;
```

```sql
-- Description: Count users in each age band (core query without LIMIT because we want all bands)
SELECT
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END AS "age_band",
  COUNT(*) AS "users"
FROM (
  SELECT
    CAST( strftime('%Y','now') - substr("birth_date",1,4)
          - (strftime('%m-%d','now') < substr("birth_date",6,5)) AS INTEGER) AS age
  FROM "mst_users"
)
GROUP BY "age_band"
ORDER BY
  CASE "age_band"
    WHEN '20s' THEN 1
    WHEN '30s' THEN 2
    WHEN '40s' THEN 3
    WHEN '50s' THEN 4
    ELSE 5
  END;
```

```sql
-- Description: Same as previous, but show the SQL-only final answer format expected
SELECT
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END AS "age_band",
  COUNT(*) AS "users_cnt"
FROM (
  SELECT
    CAST( strftime('%Y','now') - substr("birth_date",1,4)
          - (strftime('%m-%d','now') < substr("birth_date",6,5)) AS INTEGER) AS age
  FROM "mst_users"
)
GROUP BY "age_band";
```

```sql
-- Description: If you prefer to anchor the age calculation on a fixed date (e.g. 2017-01-01) instead of 'now'
SELECT
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END AS "age_band_fixed_2017_01_01",
  COUNT(*) AS "users"
FROM (
  SELECT
    CAST( '2017' - substr("birth_date",1,4)
          - ('01-01' < substr("birth_date",6,5)) AS INTEGER) AS age
  FROM "mst_users"
)
GROUP BY "age_band_fixed_2017_01_01";
```

The fifth (or sixth) query gives the required counts of users in each age category.
