-- Description: Calculate each user’s (integer) age today for a sanity-check sample
SELECT
  "user_id",
  CAST( strftime('%Y','now') - substr("birth_date",1,4)
        - (strftime('%m-%d','now') < substr("birth_date",6,5)) AS INTEGER) AS "age_now"
FROM "mst_users"
LIMIT 20;
