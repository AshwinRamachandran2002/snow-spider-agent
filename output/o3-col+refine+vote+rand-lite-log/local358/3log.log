-- Description: Look at the range of birth years to understand possible ages
SELECT
  MIN(substr("birth_date", 1, 4))  AS "oldest_birth_year",
  MAX(substr("birth_date", 1, 4))  AS "youngest_birth_year"
FROM "mst_users";
