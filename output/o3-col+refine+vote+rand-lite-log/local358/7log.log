FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Grab just the birth-year part so we can later turn it into an age.
SELECT DISTINCT SUBSTR("birth_date",1,4)   AS "birth_year"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Compute every user’s age as of today (using SQLite’s date('now')).
SELECT "user_id",
       (CAST(strftime('%Y','now') AS INTEGER)
        - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS "age_now"
FROM   "mst_users"
LIMIT 20;
```

```sql
-- Description: Turn each user’s age into a textual age-group label.
SELECT "user_id",
       CASE
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 20 AND 29 THEN '20s'
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 30 AND 39 THEN '30s'
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 40 AND 49 THEN '40s'
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 50 AND 59 THEN '50s'
         ELSE 'others'
       END AS "age_group"
FROM   "mst_users"
LIMIT 20;
```

```sql
-- Description: Distinct list of the generated age-group labels, just to verify the categories we will count.
SELECT DISTINCT
       CASE
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 20 AND 29 THEN '20s'
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 30 AND 39 THEN '30s'
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 40 AND 49 THEN '40s'
         WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 50 AND 59 THEN '50s'
         ELSE 'others'
       END AS "age_group"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Final answer – number of users that fall into each required age-group.
SELECT
       CASE
         WHEN age BETWEEN 20 AND 29 THEN '20s'
         WHEN age BETWEEN 30 AND 39 THEN '30s'
         WHEN age BETWEEN 40 AND 49 THEN '40s'
         WHEN age BETWEEN 50 AND 59 THEN '50s'
         ELSE 'others'
       END AS "age_group",
       COUNT(*)                         AS "user_count"
FROM (
        SELECT (CAST(strftime('%Y','now') AS INTEGER)
               - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS age
        FROM   "mst_users"
     ) AS t
GROUP BY "age_group"
LIMIT 20;
```

```sql
-- Description: If you also wish to see the age-group break-down by gender (bonus drill-down).
SELECT
       CASE
         WHEN age BETWEEN 20 AND 29 THEN '20s'
         WHEN age BETWEEN 30 AND 39 THEN '30s'
         WHEN age BETWEEN 40 AND 49 THEN '40s'
         WHEN age BETWEEN 50 AND 59 THEN '50s'
         ELSE 'others'
       END                AS "age_group",
       "sex",
       COUNT(*)           AS "user_count"
FROM (
        SELECT "sex",
               (CAST(strftime('%Y','now') AS INTEGER)
               - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS age
        FROM   "mst_users"
     ) AS t
GROUP BY "age_group","sex"
LIMIT 20;
```

```sql
-- Description: Show average (mean) age inside each of our buckets, to gauge how “young/old” users are within them.
SELECT
       age_group,
       AVG(age * 1.0) AS "avg_age"
FROM (
        SELECT
               (CAST(strftime('%Y','now') AS INTEGER)
               - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS age,
               CASE
                 WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 20 AND 29 THEN '20s'
                 WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 30 AND 39 THEN '30s'
                 WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 40 AND 49 THEN '40s'
                 WHEN (CAST(strftime('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) BETWEEN 50 AND 59 THEN '50s'
                 ELSE 'others'
               END AS age_group
        FROM "mst_users"
     )
GROUP BY age_group
LIMIT 20;
```

```sql
-- Description: (Extra) Display every user that fell into “others” so you can inspect edge-cases such as teenagers or 60+.
SELECT "user_id",
       "birth_date",
       (CAST(strftime('%Y','now') AS INTEGER)
        - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS age_now
FROM   "mst_users"
WHERE  (CAST(strftime('%Y','now') AS INTEGER)
       - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) NOT BETWEEN 20 AND 59
LIMIT 20;
```
