Query:
-- Description: Compute every user’s age as of today (using SQLite’s date('now')).
SELECT "user_id",
       (CAST(strftime('%Y','now') AS INTEGER)
        - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS "age_now"
FROM   "mst_users"
LIMIT 20;
