```sql
-- Description: Inspect basic user information (user_id & birth_date) from the master table  
SELECT "user_id","birth_date"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Check the variety of birth‐years that exist in the data  
SELECT DISTINCT strftime('%Y',"birth_date") AS "birth_year"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Display each user’s current age (calculated on-the-fly)  
SELECT 
  "user_id",
  /* age = current year – birth year – (has birthday passed this year?) */
  CAST(strftime('%Y','now') AS INTEGER) 
  - CAST(strftime('%Y',"birth_date") AS INTEGER) 
  - CASE WHEN strftime('%m-%d','now') < strftime('%m-%d',"birth_date")
         THEN 1 ELSE 0 END        AS "age"
FROM "mst_users"
LIMIT 20;
```

```sql
-- Description: Add a decade label (“20s”, “30s”, … “others”) to every user  
SELECT
  "user_id",
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END AS "age_category"
FROM (
  SELECT 
    "user_id",
    CAST(strftime('%Y','now') AS INTEGER) 
    - CAST(strftime('%Y',"birth_date") AS INTEGER) 
    - CASE WHEN strftime('%m-%d','now') < strftime('%m-%d',"birth_date")
           THEN 1 ELSE 0 END AS age
  FROM "mst_users"
) 
LIMIT 20;
```

```sql
-- Description: Count how many users fall into each age bracket (20s / 30s / 40s / 50s / others)  
SELECT
  CASE
    WHEN age BETWEEN 20 AND 29 THEN '20s'
    WHEN age BETWEEN 30 AND 39 THEN '30s'
    WHEN age BETWEEN 40 AND 49 THEN '40s'
    WHEN age BETWEEN 50 AND 59 THEN '50s'
    ELSE 'others'
  END                   AS "age_category",
  COUNT(*)              AS "num_users"
FROM (
  SELECT 
    "user_id",
    CAST(strftime('%Y','now') AS INTEGER) 
    - CAST(strftime('%Y',"birth_date") AS INTEGER) 
    - CASE WHEN strftime('%m-%d','now') < strftime('%m-%d',"birth_date")
           THEN 1 ELSE 0 END AS age
  FROM "mst_users"
)
GROUP BY "age_category"
ORDER BY "age_category"
LIMIT 20;
```

```sql
-- Description: (Optional) List the users who don’t fall in their 20s–50s (i.e., “others”)  
SELECT "user_id","birth_date"
FROM "mst_users"
WHERE (
  CAST(strftime('%Y','now') AS INTEGER) 
  - CAST(strftime('%Y',"birth_date") AS INTEGER) 
  - CASE WHEN strftime('%m-%d','now') < strftime('%m-%d',"birth_date")
         THEN 1 ELSE 0 END
) NOT BETWEEN 20 AND 59
LIMIT 20;
```

These six SELECT statements let you explore the raw data, compute each user’s current age, categorize that age, and finally answer the question by returning the count of users in each requested age group.
