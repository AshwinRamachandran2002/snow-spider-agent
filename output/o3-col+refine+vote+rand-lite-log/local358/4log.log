Query:
--Description: ④ Calculate each user’s age (year‐precision, based on current year).
SELECT
  "user_id",
  (CAST(STRFTIME('%Y','now') AS INTEGER) - CAST(SUBSTR("birth_date",1,4) AS INTEGER)) AS "age"
FROM "mst_users"
LIMIT 20;
