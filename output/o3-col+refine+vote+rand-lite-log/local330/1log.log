Query:
--Description: ④ Pick the landing page of every session (row having the earliest stamp in that session)
SELECT al."session",
       al."path"  AS landing_path,
       al."stamp" AS landing_stamp
FROM "activity_log" AS al
JOIN (SELECT "session", MIN("stamp") AS first_stamp
      FROM "activity_log"
      GROUP BY "session") AS f
  ON al."session" = f."session" 
 AND al."stamp"   = f."first_stamp"
LIMIT 20;
