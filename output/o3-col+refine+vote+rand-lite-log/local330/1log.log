```sql
--Description: ① Quick look at activity_log – who saw what & when
SELECT * 
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: ② List all distinct page paths that ever appeared
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: ③ List distinct session IDs we are going to analyse
SELECT DISTINCT "session"
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: ④ Pick the landing page of every session (row having the earliest stamp in that session)
SELECT al."session",
       al."path"  AS landing_path,
       al."stamp" AS landing_stamp
FROM "activity_log" AS al
JOIN (SELECT "session", MIN("stamp") AS first_stamp
      FROM "activity_log"
      GROUP BY "session") AS f
  ON al."session" = f."session" 
 AND al."stamp"   = f."first_stamp"
LIMIT 20;
```

```sql
--Description: ⑤ Pick the exit page of every session (row having the latest stamp in that session)
SELECT al."session",
       al."path"  AS exit_path,
       al."stamp" AS exit_stamp
FROM "activity_log" AS al
JOIN (SELECT "session", MAX("stamp") AS last_stamp
      FROM "activity_log"
      GROUP BY "session") AS l
  ON al."session" = l."session" 
 AND al."stamp"   = l."last_stamp"
LIMIT 20;
```

```sql
--Description: ⑥ Combine landing & exit pages → one row per session-page pair
SELECT *
FROM (
     /* landing pages */
     SELECT al."session", al."path"
     FROM "activity_log" AS al
     JOIN (SELECT "session", MIN("stamp") AS first_stamp
           FROM "activity_log"
           GROUP BY "session") AS f
       ON al."session" = f."session"
      AND al."stamp"   = f."first_stamp"
     UNION              -- avoid duplicates when a page is both landing & exit
     /* exit pages */
     SELECT al."session", al."path"
     FROM "activity_log" AS al
     JOIN (SELECT "session", MAX("stamp") AS last_stamp
           FROM "activity_log"
           GROUP BY "session") AS l
       ON al."session" = l."session"
      AND al."stamp"   = l."last_stamp"
) AS le
LIMIT 20;
```

```sql
--Description: ⑦ Count unique sessions per page where the page is landing or exit
SELECT le."path",
       COUNT(DISTINCT le."session") AS session_cnt
FROM (
     SELECT al."session", al."path"
     FROM "activity_log" AS al
     JOIN (SELECT "session", MIN("stamp") AS first_stamp
           FROM "activity_log"
           GROUP BY "session") AS f
       ON al."session" = f."session"
      AND al."stamp"   = f."first_stamp"
     UNION
     SELECT al."session", al."path"
     FROM "activity_log" AS al
     JOIN (SELECT "session", MAX("stamp") AS last_stamp
           FROM "activity_log"
           GROUP BY "session") AS l
       ON al."session" = l."session"
      AND al."stamp"   = l."last_stamp"
) AS le
GROUP BY le."path"
ORDER BY session_cnt DESC
LIMIT 20;
```

```sql
--Description: ⑧ (optional check) Show pages that served BOTH landing & exit in the same session
SELECT t1."session", t1."path"
FROM (
      SELECT al."session", al."path"
      FROM "activity_log" AS al
      JOIN (SELECT "session", MIN("stamp") AS first_stamp
            FROM "activity_log"
            GROUP BY "session") AS f
        ON al."session" = f."session"
       AND al."stamp"   = f."first_stamp"
) AS t1
JOIN (
      SELECT al."session", al."path"
      FROM "activity_log" AS al
      JOIN (SELECT "session", MAX("stamp") AS last_stamp
            FROM "activity_log"
            GROUP BY "session") AS l
        ON al."session" = l."session"
       AND al."stamp"   = l."last_stamp"
) AS t2
  ON t1."session" = t2."session"
 AND t1."path"    = t2."path"
LIMIT 20;
```

```sql
--Description: ⑨ (optional) Show the sessions count for top 20 pages only landing pages (for comparison)
SELECT al."path",
       COUNT(DISTINCT al."session") AS landing_sessions
FROM "activity_log" AS al
JOIN (SELECT "session", MIN("stamp") AS first_stamp
      FROM "activity_log"
      GROUP BY "session") AS f
  ON al."session" = f."session"
 AND al."stamp"   = f."first_stamp"
GROUP BY al."path"
ORDER BY landing_sessions DESC
LIMIT 20;
```

```sql
--Description: ⑩ FINAL answer – already given in query⑦ (unique sessions per page where page is landing OR exit)
SELECT le."path",
       COUNT(DISTINCT le."session") AS landing_or_exit_sessions
FROM (
     SELECT al."session", al."path"
     FROM "activity_log" AS al
     JOIN (SELECT "session", MIN("stamp") AS first_stamp
           FROM "activity_log"
           GROUP BY "session") AS f
       ON al."session" = f."session"
      AND al."stamp"   = f."first_stamp"
     UNION
     SELECT al."session", al."path"
     FROM "activity_log" AS al
     JOIN (SELECT "session", MAX("stamp") AS last_stamp
           FROM "activity_log"
           GROUP BY "session") AS l
       ON al."session" = l."session"
      AND al."stamp"   = l."last_stamp"
) AS le
GROUP BY le."path"
ORDER BY landing_or_exit_sessions DESC
LIMIT 20;
```
