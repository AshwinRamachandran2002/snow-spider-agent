Query:
-- Description: Count distinct sessions for which each page is a landing page
SELECT lp."landing_page" AS "page",
       COUNT(DISTINCT lp."session") AS "landing_sessions"
FROM (
      SELECT a."session", a."path" AS "landing_page"
      FROM "activity_log" AS a
      JOIN (
            SELECT "session", MIN("stamp") AS "first_stamp"
            FROM "activity_log"
            GROUP BY "session"
           ) AS b
        ON a."session" = b."session"
       AND a."stamp"   = b."first_stamp"
     ) AS lp
GROUP BY lp."landing_page"
ORDER BY "landing_sessions" DESC
LIMIT 20;
