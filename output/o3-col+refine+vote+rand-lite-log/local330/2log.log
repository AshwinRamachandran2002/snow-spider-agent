Query:
-- Description: Combine landing & exit information; each session counted once per page even if both landing & exit
SELECT "page",
       COUNT(DISTINCT "session") AS "total_sessions"
FROM (
      /* pages that are landing or exit for the session */
      SELECT a."session",
             a."path" AS "page"
      FROM "activity_log" AS a
      JOIN (
            SELECT "session",
                   MIN("stamp") AS "first_stamp",
                   MAX("stamp") AS "last_stamp"
            FROM "activity_log"
            GROUP BY "session"
           ) AS b
        ON a."session" = b."session"
       AND (a."stamp" = b."first_stamp" OR a."stamp" = b."last_stamp")
     ) AS t
GROUP BY "page"
ORDER BY "total_sessions" DESC
LIMIT 20;
