Query:
-- Description: Get landing pages for each session
SELECT a."session",
       a."path"   AS "landing_page"
FROM "activity_log" AS a
JOIN (
      SELECT "session", MIN("stamp") AS "first_stamp"
      FROM "activity_log"
      GROUP BY "session"
     ) AS b
  ON a."session" = b."session" 
 AND a."stamp"   = b."first_stamp"
LIMIT 20;
