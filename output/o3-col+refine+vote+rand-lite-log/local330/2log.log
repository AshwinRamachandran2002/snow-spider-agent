```sql
-- Description: Inspect raw rows in activity_log to grasp available columns & timestamps
SELECT * 
FROM "activity_log" 
LIMIT 20;
```

```sql
-- Description: List the distinct page paths that appear in activity_log
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
-- Description: Find, for every session, the earliest (landing) and latest (exit) timestamp
SELECT "session",
       MIN("stamp") AS "first_stamp",
       MAX("stamp") AS "last_stamp"
FROM "activity_log"
GROUP BY "session"
LIMIT 20;
```

```sql
-- Description: Get landing pages for each session
SELECT a."session",
       a."path"   AS "landing_page"
FROM "activity_log" AS a
JOIN (
      SELECT "session", MIN("stamp") AS "first_stamp"
      FROM "activity_log"
      GROUP BY "session"
     ) AS b
  ON a."session" = b."session" 
 AND a."stamp"   = b."first_stamp"
LIMIT 20;
```

```sql
-- Description: Get exit pages for each session
SELECT a."session",
       a."path"   AS "exit_page"
FROM "activity_log" AS a
JOIN (
      SELECT "session", MAX("stamp") AS "last_stamp"
      FROM "activity_log"
      GROUP BY "session"
     ) AS b
  ON a."session" = b."session" 
 AND a."stamp"   = b."last_stamp"
LIMIT 20;
```

```sql
-- Description: Count distinct sessions for which each page is a landing page
SELECT lp."landing_page" AS "page",
       COUNT(DISTINCT lp."session") AS "landing_sessions"
FROM (
      SELECT a."session", a."path" AS "landing_page"
      FROM "activity_log" AS a
      JOIN (
            SELECT "session", MIN("stamp") AS "first_stamp"
            FROM "activity_log"
            GROUP BY "session"
           ) AS b
        ON a."session" = b."session"
       AND a."stamp"   = b."first_stamp"
     ) AS lp
GROUP BY lp."landing_page"
ORDER BY "landing_sessions" DESC
LIMIT 20;
```

```sql
-- Description: Count distinct sessions for which each page is an exit page
SELECT ep."exit_page" AS "page",
       COUNT(DISTINCT ep."session") AS "exit_sessions"
FROM (
      SELECT a."session", a."path" AS "exit_page"
      FROM "activity_log" AS a
      JOIN (
            SELECT "session", MAX("stamp") AS "last_stamp"
            FROM "activity_log"
            GROUP BY "session"
           ) AS b
        ON a."session" = b."session"
       AND a."stamp"   = b."last_stamp"
     ) AS ep
GROUP BY ep."exit_page"
ORDER BY "exit_sessions" DESC
LIMIT 20;
```

```sql
-- Description: Combine landing & exit information; each session counted once per page even if both landing & exit
SELECT "page",
       COUNT(DISTINCT "session") AS "total_sessions"
FROM (
      /* pages that are landing or exit for the session */
      SELECT a."session",
             a."path" AS "page"
      FROM "activity_log" AS a
      JOIN (
            SELECT "session",
                   MIN("stamp") AS "first_stamp",
                   MAX("stamp") AS "last_stamp"
            FROM "activity_log"
            GROUP BY "session"
           ) AS b
        ON a."session" = b."session"
       AND (a."stamp" = b."first_stamp" OR a."stamp" = b."last_stamp")
     ) AS t
GROUP BY "page"
ORDER BY "total_sessions" DESC
LIMIT 20;
```

```sql
-- Description: (Optional) Show the page(s) with the highest combined landing/exit session count
SELECT "page", "total_sessions"
FROM (
      SELECT "page",
             COUNT(DISTINCT "session") AS "total_sessions"
      FROM (
            SELECT a."session", a."path" AS "page"
            FROM "activity_log" AS a
            JOIN (
                  SELECT "session",
                         MIN("stamp") AS "first_stamp",
                         MAX("stamp") AS "last_stamp"
                  FROM "activity_log"
                  GROUP BY "session"
                 ) AS b
              ON a."session" = b."session"
             AND (a."stamp" = b."first_stamp" OR a."stamp" = b."last_stamp")
          ) AS y
      GROUP BY "page"
     )
ORDER BY "total_sessions" DESC
LIMIT 20;
```
