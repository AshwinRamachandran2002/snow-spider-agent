Query:
--Description: Same idea as above but with a CTE and IN() to catch landing & exit in one join.
WITH first_last AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM "activity_log"
  GROUP BY "session"
),
boundary AS (
  SELECT a."session", a."path"
  FROM   "activity_log" AS a
  JOIN   first_last     AS fl
    ON   a."session" = fl."session"
   AND   a."stamp"  IN (fl."first_stamp", fl."last_stamp")
)
SELECT
  "path",
  COUNT(DISTINCT "session") AS "unique_sessions"
FROM boundary
GROUP BY "path"
ORDER BY "unique_sessions" DESC, "path"
LIMIT 20;
