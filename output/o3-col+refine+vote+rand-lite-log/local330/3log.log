```sql
--Description: Quick look at the raw activity log.
SELECT *
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: List of distinct session IDs that appear in the activity log.
SELECT DISTINCT "session"
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: List of distinct page paths that appear in the activity log.
SELECT DISTINCT "path"
FROM "activity_log"
LIMIT 20;
```

```sql
--Description: For every session, pick its earliest (landing) and latest (exit) timestamps.
SELECT
  "session",
  MIN("stamp") AS "first_stamp",
  MAX("stamp") AS "last_stamp"
FROM "activity_log"
GROUP BY "session"
LIMIT 20;
```

```sql
--Description: Retrieve the actual landing page for each session.
SELECT a."session",
       a."path"  AS "landing_page"
FROM "activity_log" AS a
JOIN (
  SELECT "session", MIN("stamp") AS "first_stamp"
  FROM "activity_log"
  GROUP BY "session"
) AS f
ON  a."session" = f."session"
AND a."stamp"   = f."first_stamp"
LIMIT 20;
```

```sql
--Description: Retrieve the actual exit page for each session.
SELECT a."session",
       a."path"  AS "exit_page"
FROM "activity_log" AS a
JOIN (
  SELECT "session", MAX("stamp") AS "last_stamp"
  FROM "activity_log"
  GROUP BY "session"
) AS l
ON  a."session" = l."session"
AND a."stamp"   = l."last_stamp"
LIMIT 20;
```

```sql
--Description: Combine landing-page and exit-page pairs (one row per session-page pair).
SELECT "session", "path"
FROM (
  -- landing side
  SELECT a."session", a."path"
  FROM "activity_log" AS a
  JOIN (SELECT "session", MIN("stamp") AS "first_stamp"
        FROM "activity_log"
        GROUP BY "session") AS f
    ON a."session" = f."session"
   AND a."stamp"   = f."first_stamp"
  UNION
  -- exit side
  SELECT a."session", a."path"
  FROM "activity_log" AS a
  JOIN (SELECT "session", MAX("stamp") AS "last_stamp"
        FROM "activity_log"
        GROUP BY "session") AS l
    ON a."session" = l."session"
   AND a."stamp"   = l."last_stamp"
)
LIMIT 20;
```

```sql
--Description: Count unique sessions per page based on landing OR exit status.
SELECT
  "path",
  COUNT(DISTINCT "session") AS "unique_sessions"
FROM (
  SELECT a."session", a."path"
  FROM "activity_log" AS a
  JOIN (SELECT "session", MIN("stamp") AS "first_stamp"
        FROM "activity_log"
        GROUP BY "session") AS f
    ON a."session" = f."session"
   AND a."stamp"   = f."first_stamp"
  UNION
  SELECT a."session", a."path"
  FROM "activity_log" AS a
  JOIN (SELECT "session", MAX("stamp") AS "last_stamp"
        FROM "activity_log"
        GROUP BY "session") AS l
    ON a."session" = l."session"
   AND a."stamp"   = l."last_stamp"
) AS t
GROUP BY "path"
ORDER BY "unique_sessions" DESC, "path"
LIMIT 20;
```

```sql
--Description: Same idea as above but with a CTE and IN() to catch landing & exit in one join.
WITH first_last AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM "activity_log"
  GROUP BY "session"
),
boundary AS (
  SELECT a."session", a."path"
  FROM   "activity_log" AS a
  JOIN   first_last     AS fl
    ON   a."session" = fl."session"
   AND   a."stamp"  IN (fl."first_stamp", fl."last_stamp")
)
SELECT
  "path",
  COUNT(DISTINCT "session") AS "unique_sessions"
FROM boundary
GROUP BY "path"
ORDER BY "unique_sessions" DESC, "path"
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – total # of unique sessions for each page when it
--appears as a landing, exit, or both (session counted once per page).
WITH first_last AS (
  SELECT "session",
         MIN("stamp") AS "first_stamp",
         MAX("stamp") AS "last_stamp"
  FROM "activity_log"
  GROUP BY "session"
),
landing AS (
  SELECT a."session", a."path"
  FROM   "activity_log" AS a
  JOIN   first_last     AS fl
    ON   a."session" = fl."session"
   AND   a."stamp"   = fl."first_stamp"
),
exit AS (
  SELECT a."session", a."path"
  FROM   "activity_log" AS a
  JOIN   first_last     AS fl
    ON   a."session" = fl."session"
   AND   a."stamp"   = fl."last_stamp"
),
combined AS (
  SELECT "session", "path" FROM landing
  UNION
  SELECT "session", "path" FROM exit
)
SELECT
  "path",
  COUNT(DISTINCT "session") AS "total_unique_sessions"
FROM combined
GROUP BY "path"
ORDER BY "total_unique_sessions" DESC, "path"
LIMIT 20;
```
