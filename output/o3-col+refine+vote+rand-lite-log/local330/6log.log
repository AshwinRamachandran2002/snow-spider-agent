--Description: ② Look at the sequence of pages visited inside one sample session (ordered by time).
SELECT "session",
       "stamp",
       "path"
FROM   "activity_log"
WHERE  "session" = (SELECT DISTINCT "session" FROM "activity_log" LIMIT 1)
ORDER  BY "stamp"
LIMIT 20;
