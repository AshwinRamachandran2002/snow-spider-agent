```sql
--Description: ② Look at the sequence of pages visited inside one sample session (ordered by time).
SELECT "session",
       "stamp",
       "path"
FROM   "activity_log"
WHERE  "session" = (SELECT DISTINCT "session" FROM "activity_log" LIMIT 1)
ORDER  BY "stamp"
LIMIT 20;
```

```sql
--Description: ③ Pick the first (landing) page of every session.
SELECT DISTINCT al."session",
       (SELECT "path"
        FROM   "activity_log" AS x
        WHERE  x."session" = al."session"
        ORDER  BY x."stamp" ASC
        LIMIT 1) AS "landing_page"
FROM   "activity_log" AS al
LIMIT 20;
```

```sql
--Description: ④ Pick the last (exit) page of every session.
SELECT DISTINCT al."session",
       (SELECT "path"
        FROM   "activity_log" AS x
        WHERE  x."session" = al."session"
        ORDER  BY x."stamp" DESC
        LIMIT 1) AS "exit_page"
FROM   "activity_log" AS al
LIMIT 20;
```

```sql
--Description: ⑤ See both landing & exit pages side-by-side for each session.
SELECT DISTINCT s."session",
       l."landing_page",
       e."exit_page"
FROM  (SELECT DISTINCT "session" FROM "activity_log") AS s
LEFT  JOIN ( /* landing */ 
       SELECT al."session",
              (SELECT "path" FROM "activity_log" AS x
               WHERE x."session" = al."session"
               ORDER BY x."stamp" ASC LIMIT 1) AS "landing_page"
       FROM   "activity_log" AS al) AS l  ON s."session" = l."session"
LEFT  JOIN ( /* exit */
       SELECT al."session",
              (SELECT "path" FROM "activity_log" AS x
               WHERE x."session" = al."session"
               ORDER BY x."stamp" DESC LIMIT 1) AS "exit_page"
       FROM   "activity_log" AS al) AS e  ON s."session" = e."session"
LIMIT 20;
```

```sql
--Description: ⑥ For sessions where landing and exit are the same page, list them.
SELECT DISTINCT "session",
       "landing_page" AS "same_page"
FROM (
      SELECT al."session",
             (SELECT "path" FROM "activity_log" AS x
              WHERE x."session" = al."session"
              ORDER BY x."stamp" ASC  LIMIT 1) AS "landing_page",
             (SELECT "path" FROM "activity_log" AS x
              WHERE x."session" = al."session"
              ORDER BY x."stamp" DESC LIMIT 1) AS "exit_page"
      FROM   "activity_log" AS al
) 
WHERE "landing_page" = "exit_page"
LIMIT 20;
```

```sql
--Description: ⑦ FINAL ANSWER – count distinct sessions in which each page
--             is a landing page or an exit page (counted once per session).
SELECT "page",
       COUNT(DISTINCT "session") AS "unique_sessions"
FROM (
      /* landing pages */
      SELECT DISTINCT al1."session",
             (SELECT "path" FROM "activity_log" AS x
              WHERE x."session" = al1."session"
              ORDER BY x."stamp" ASC LIMIT 1) AS "page"
      FROM   "activity_log" AS al1
      
      UNION ALL
      
      /* exit pages */
      SELECT DISTINCT al2."session",
             (SELECT "path" FROM "activity_log" AS x
              WHERE x."session" = al2."session"
              ORDER BY x."stamp" DESC LIMIT 1) AS "page"
      FROM   "activity_log" AS al2
) AS ue
GROUP BY "page"
ORDER BY "unique_sessions" DESC, "page" ASC
LIMIT 20;
```
