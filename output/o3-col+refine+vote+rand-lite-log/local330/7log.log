Query:
-- Description: FINAL ANSWER – count how many unique sessions each page appears in
SELECT se."path"                       AS "page_path",
       COUNT(DISTINCT se."session")    AS "unique_sessions"
FROM (
    -- landing + exit distinct combinations
    SELECT DISTINCT l."session", l.landing_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a2."path"
                FROM "activity_log" AS a2
                WHERE a2."session" = a."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS landing_path
        FROM "activity_log" AS a
    ) AS l

    UNION

    SELECT DISTINCT e."session", e.exit_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a3."path"
                FROM "activity_log" AS a3
                WHERE a3."session" = a."session"
                ORDER BY a3."stamp" DESC
                LIMIT 1) AS exit_path
        FROM "activity_log" AS a
    ) AS e
) AS se
GROUP BY se."path"
ORDER BY "unique_sessions" DESC, se."path"
LIMIT 20;
