```sql
-- Description: Inspect the raw activity_log table to understand key columns we will use
SELECT *
FROM "activity_log"
LIMIT 20;
```

```sql
-- Description: For every session, fetch the first visited page (landing page)
SELECT a."session",
       MIN(a."stamp")                AS first_stamp,
       (SELECT a2."path"
        FROM "activity_log" AS a2
        WHERE a2."session" = a."session"
        ORDER BY a2."stamp" ASC
        LIMIT 1)                     AS landing_path
FROM "activity_log" AS a
GROUP BY a."session"
LIMIT 20;
```

```sql
-- Description: For every session, fetch the last visited page (exit page)
SELECT a."session",
       MAX(a."stamp")                AS last_stamp,
       (SELECT a3."path"
        FROM "activity_log" AS a3
        WHERE a3."session" = a."session"
        ORDER BY a3."stamp" DESC
        LIMIT 1)                     AS exit_path
FROM "activity_log" AS a
GROUP BY a."session"
LIMIT 20;
```

```sql
-- Description: Collect one row per (session, landing_path) only
SELECT DISTINCT l."session",
       l.landing_path AS "path"
FROM (
    SELECT a."session",
           (SELECT a2."path"
            FROM "activity_log" AS a2
            WHERE a2."session" = a."session"
            ORDER BY a2."stamp" ASC
            LIMIT 1) AS landing_path
    FROM "activity_log" AS a
) AS l
LIMIT 20;
```

```sql
-- Description: Collect one row per (session, exit_path) only
SELECT DISTINCT e."session",
       e.exit_path AS "path"
FROM (
    SELECT a."session",
           (SELECT a3."path"
            FROM "activity_log" AS a3
            WHERE a3."session" = a."session"
            ORDER BY a3."stamp" DESC
            LIMIT 1) AS exit_path
    FROM "activity_log" AS a
) AS e
LIMIT 20;
```

```sql
-- Description: Combine landing and exit data; keep a unique (session, path) pair
SELECT DISTINCT se."session",
       se."path"
FROM (
    -- landing
    SELECT l."session", l.landing_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a2."path"
                FROM "activity_log" AS a2
                WHERE a2."session" = a."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS landing_path
        FROM "activity_log" AS a
    ) AS l
    UNION
    -- exit
    SELECT e."session", e.exit_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a3."path"
                FROM "activity_log" AS a3
                WHERE a3."session" = a."session"
                ORDER BY a3."stamp" DESC
                LIMIT 1) AS exit_path
        FROM "activity_log" AS a
    ) AS e
) AS se
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – count how many unique sessions each page appears in
SELECT se."path"                       AS "page_path",
       COUNT(DISTINCT se."session")    AS "unique_sessions"
FROM (
    -- landing + exit distinct combinations
    SELECT DISTINCT l."session", l.landing_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a2."path"
                FROM "activity_log" AS a2
                WHERE a2."session" = a."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS landing_path
        FROM "activity_log" AS a
    ) AS l

    UNION

    SELECT DISTINCT e."session", e.exit_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a3."path"
                FROM "activity_log" AS a3
                WHERE a3."session" = a."session"
                ORDER BY a3."stamp" DESC
                LIMIT 1) AS exit_path
        FROM "activity_log" AS a
    ) AS e
) AS se
GROUP BY se."path"
ORDER BY "unique_sessions" DESC, se."path"
LIMIT 20;
```
