Query:
-- Description: Combine landing and exit data; keep a unique (session, path) pair
SELECT DISTINCT se."session",
       se."path"
FROM (
    -- landing
    SELECT l."session", l.landing_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a2."path"
                FROM "activity_log" AS a2
                WHERE a2."session" = a."session"
                ORDER BY a2."stamp" ASC
                LIMIT 1) AS landing_path
        FROM "activity_log" AS a
    ) AS l
    UNION
    -- exit
    SELECT e."session", e.exit_path AS "path"
    FROM (
        SELECT a."session",
               (SELECT a3."path"
                FROM "activity_log" AS a3
                WHERE a3."session" = a."session"
                ORDER BY a3."stamp" DESC
                LIMIT 1) AS exit_path
        FROM "activity_log" AS a
    ) AS e
) AS se
LIMIT 20;
