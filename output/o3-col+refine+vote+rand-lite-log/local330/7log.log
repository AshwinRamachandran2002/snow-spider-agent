Query:
-- Description: For every session, fetch the first visited page (landing page)
SELECT a."session",
       MIN(a."stamp")                AS first_stamp,
       (SELECT a2."path"
        FROM "activity_log" AS a2
        WHERE a2."session" = a."session"
        ORDER BY a2."stamp" ASC
        LIMIT 1)                     AS landing_path
FROM "activity_log" AS a
GROUP BY a."session"
LIMIT 20;
