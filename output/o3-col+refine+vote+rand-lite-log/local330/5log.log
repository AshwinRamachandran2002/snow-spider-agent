Query:
-- 7) Count how many unique sessions each path appears in
WITH landing AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MIN("stamp") AS first_stamp
           FROM   "activity_log"
           GROUP  BY "session") f
      ON  al."session" = f."session"
     AND al."stamp"   = f."first_stamp"
),
exit AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MAX("stamp") AS last_stamp
           FROM   "activity_log"
           GROUP  BY "session") e
      ON  al."session" = e."session"
     AND al."stamp"   = e."last_stamp"
),
landing_exit AS (
    SELECT * FROM landing
    UNION
    SELECT * FROM exit
)
SELECT "path",
       COUNT(DISTINCT "session") AS "unique_sessions"
FROM   landing_exit
GROUP  BY "path"
ORDER  BY "unique_sessions" DESC
LIMIT 20;
