Query:
-- 6) Combine landing and exit pages for every session (avoid duplicates via UNION)
WITH landing AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MIN("stamp") AS first_stamp
           FROM   "activity_log"
           GROUP  BY "session") f
      ON  al."session" = f."session"
     AND al."stamp"   = f."first_stamp"
),
exit AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MAX("stamp") AS last_stamp
           FROM   "activity_log"
           GROUP  BY "session") e
      ON  al."session" = e."session"
     AND al."stamp"   = e."last_stamp"
)
SELECT *
FROM   landing
UNION
SELECT *
FROM   exit
LIMIT 20;
