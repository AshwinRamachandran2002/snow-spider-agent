       al."path"  AS "landing_path"
FROM   "activity_log"          AS al
JOIN  (SELECT "session",
              MIN("stamp") AS first_stamp
       FROM   "activity_log"
       GROUP  BY "session")    AS t
  ON   al."session" = t."session"
 AND  al."stamp"   = t."first_stamp"
