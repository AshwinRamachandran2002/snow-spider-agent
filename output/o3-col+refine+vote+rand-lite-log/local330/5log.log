```sql
-- 1) Preview the raw activity log data
SELECT * 
FROM "activity_log" 
LIMIT 20;
```

```sql
-- 2) See how the same session moves across pages by timestamp
SELECT "session",
       "stamp",
       "path"
FROM   "activity_log"
ORDER  BY "session",
          "stamp"
LIMIT 20;
```

```sql
-- 3) Count how many distinct sessions exist in the log
SELECT COUNT(DISTINCT "session") AS "session_cnt"
FROM   "activity_log"
LIMIT 20;
```

```sql
-- 4) Identify every landing page (first page in each session)
SELECT al."session",
       al."path"  AS "landing_path"
FROM   "activity_log"          AS al
JOIN  (SELECT "session",
              MIN("stamp") AS first_stamp
       FROM   "activity_log"
       GROUP  BY "session")    AS t
  ON   al."session" = t."session"
 AND  al."stamp"   = t."first_stamp"
LIMIT 20;
```

```sql
-- 5) Identify every exit page (last page in each session)
SELECT al."session",
       al."path"  AS "exit_path"
FROM   "activity_log"          AS al
JOIN  (SELECT "session",
              MAX("stamp") AS last_stamp
       FROM   "activity_log"
       GROUP  BY "session")    AS t
  ON   al."session" = t."session"
 AND  al."stamp"   = t."last_stamp"
LIMIT 20;
```

```sql
-- 6) Combine landing and exit pages for every session (avoid duplicates via UNION)
WITH landing AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MIN("stamp") AS first_stamp
           FROM   "activity_log"
           GROUP  BY "session") f
      ON  al."session" = f."session"
     AND al."stamp"   = f."first_stamp"
),
exit AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MAX("stamp") AS last_stamp
           FROM   "activity_log"
           GROUP  BY "session") e
      ON  al."session" = e."session"
     AND al."stamp"   = e."last_stamp"
)
SELECT *
FROM   landing
UNION
SELECT *
FROM   exit
LIMIT 20;
```

```sql
-- 7) Count how many unique sessions each path appears in
WITH landing AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MIN("stamp") AS first_stamp
           FROM   "activity_log"
           GROUP  BY "session") f
      ON  al."session" = f."session"
     AND al."stamp"   = f."first_stamp"
),
exit AS (
    SELECT al."session",
           al."path"
    FROM   "activity_log" al
    JOIN  (SELECT "session",
                  MAX("stamp") AS last_stamp
           FROM   "activity_log"
           GROUP  BY "session") e
      ON  al."session" = e."session"
     AND al."stamp"   = e."last_stamp"
),
landing_exit AS (
    SELECT * FROM landing
    UNION
    SELECT * FROM exit
)
SELECT "path",
       COUNT(DISTINCT "session") AS "unique_sessions"
FROM   landing_exit
GROUP  BY "path"
ORDER  BY "unique_sessions" DESC
LIMIT 20;
```

