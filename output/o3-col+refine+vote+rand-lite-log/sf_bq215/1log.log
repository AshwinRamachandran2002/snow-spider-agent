```sql
--Description:  Retrieve, for the patent “US-9166782-B2”, the 4-digit IPC codes of every cited patent  
--that actually has IPC information, and count how often each IPC-4 class appears among its backward citations.
WITH cited_pubs AS (                      -- step-1: list cited publication numbers
    SELECT
        f.value:"publication_number"::STRING   AS "cited_pub"
    FROM
        PATENTS.PATENTS.PUBLICATIONS p,
        LATERAL FLATTEN(input => p."citation") f
    WHERE
        p."publication_number" = 'US-9166782-B2'
        AND f.value:"publication_number" IS NOT NULL
), ipc4_codes AS (                        -- step-2: fetch IPC-4 codes for cited patents that have IPC data
    SELECT
        SUBSTR(ip.value:"code"::STRING, 1, 4)  AS "ipc4"
    FROM
        cited_pubs c
        JOIN PATENTS.PATENTS.PUBLICATIONS cp
             ON cp."publication_number" = c."cited_pub"
             AND cp."ipc" <> '[]',              -- ensure IPC data exist
        LATERAL FLATTEN(input => cp."ipc") ip
)
SELECT
    'US-9166782-B2'        AS "citing_pub",
    "ipc4",
    COUNT(*)               AS "occurrences"
FROM
    ipc4_codes
GROUP BY
    "ipc4"
ORDER BY
    "occurrences" DESC
LIMIT 20;
```
