```sql
--Description: 3) Check which of those U.S. patents (2015-2018) actually contain backward-citation data
SELECT 
    "publication_number",
    "grant_date",
    "citation"
FROM 
    PATENTS.PATENTS.PUBLICATIONS
WHERE 
    "country_code" = 'US'
    AND "kind_code" = 'B2'
    AND "grant_date" BETWEEN 20150101 AND 20181231
    AND "citation" <> '[]'
LIMIT 20;
```

```sql
--Description: 4) Inspect the structure of a single citation array element
SELECT 
    t."publication_number"                      AS "citing_pub",
    f.value                                     AS "raw_cited_variant"
FROM 
    PATENTS.PATENTS.PUBLICATIONS  t,
    LATERAL FLATTEN(input => t."citation") f
WHERE 
    t."citation" <> '[]'
LIMIT 20;
```

```sql
--Description: 5) Extract the cited publication number from the citation object
SELECT 
    t."publication_number"                                    AS "citing_pub",
    f.value:"publication_number"::STRING                      AS "cited_pub"
FROM 
    PATENTS.PATENTS.PUBLICATIONS  t,
    LATERAL FLATTEN(input => t."citation") f
WHERE 
    t."citation" <> '[]'
    AND f.value:"publication_number" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 6) For each cited patent, list its IPC codes at the 4-digit level
SELECT  
    cp."publication_number"                                   AS "cited_pub",
    SUBSTR(ip.value:"code"::STRING, 1, 4)                     AS "ipc4"
FROM  
    PATENTS.PATENTS.PUBLICATIONS  cp,
    LATERAL FLATTEN(input => cp."ipc") ip
WHERE  
    cp."publication_number" IN (
        -- a handful of cited publications to sample
        'US-7650331-B1','US-7650332-B1','US-9201234-B2'
    )
LIMIT 20;
```

```sql
--Description: 7) Combine a small cohort: link one citing patent to all IPC-4 codes of its cited patents
WITH sample AS (
    SELECT  
        t."publication_number"          AS "citing_pub",
        f.value:"publication_number"::STRING   AS "cited_pub"
    FROM  
        PATENTS.PATENTS.PUBLICATIONS t,
        LATERAL FLATTEN(input => t."citation") f
    WHERE  
        t."publication_number" = 'US-9201234-B2'      -- example citing patent
        AND f.value:"publication_number" IS NOT NULL
), ipc_codes AS (
    SELECT  
        s."citing_pub",
        SUBSTR(ip.value:"code"::STRING,1,4) AS "ipc4"
    FROM  
        sample s
        JOIN PATENTS.PATENTS.PUBLICATIONS cp
              ON cp."publication_number" = s."cited_pub",
        LATERAL FLATTEN(input => cp."ipc") ip
)
SELECT 
    "citing_pub",
    "ipc4",
    COUNT(*)                                AS "occurrences"
FROM 
    ipc_codes
GROUP BY 
    "citing_pub","ipc4"
LIMIT 20;
```

```sql
--Description: 8) Calculate originality for a small set of citing patents (limit 20) within 2015-2018
WITH citing AS (
    SELECT 
        "publication_number"
    FROM 
        PATENTS.PATENTS.PUBLICATIONS
    WHERE 
        "country_code" = 'US'
        AND "kind_code" = 'B2'
        AND "grant_date" BETWEEN 20150101 AND 20181231
        AND "citation" <> '[]'
    LIMIT 20
), cites AS (
    SELECT  
        t."publication_number"                          AS "citing_pub",
        f.value:"publication_number"::STRING            AS "cited_pub"
    FROM  
        PATENTS.PATENTS.PUBLICATIONS t
        JOIN citing c ON c."publication_number" = t."publication_number",
        LATERAL FLATTEN(input => t."citation") f
    WHERE  
        f.value:"publication_number" IS NOT NULL
), ipc4s AS (
    SELECT  
        s."citing_pub",
        SUBSTR(ip.value:"code"::STRING,1,4) AS "ipc4"
    FROM  
        cites s
        JOIN PATENTS.PATENTS.PUBLICATIONS cp
              ON cp."publication_number" = s."cited_pub",
        LATERAL FLATTEN(input => cp."ipc") ip
), counts AS (
    SELECT  
        "citing_pub",
        "ipc4",
        COUNT(*) AS n_k
    FROM  
        ipc4s
    GROUP BY  
        "citing_pub","ipc4"
), totals AS (
    SELECT  
        "citing_pub",
        SUM(n_k)                                   AS N,
        SUM(n_k*n_k)                               AS sum_sq
    FROM  
        counts
    GROUP BY  
        "citing_pub"
)
SELECT  
    "citing_pub",
    1 - (sum_sq::FLOAT / (N*N))                   AS "originality"
FROM  
    totals
ORDER BY  
    "originality" DESC
LIMIT 20;
```

