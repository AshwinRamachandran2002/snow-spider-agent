```sql
--Description:  For a known U.S. patent with backward citations (“US-9166782-B2”), list all 4-digit IPC codes
--of the patents it cites and count how often each IPC-4 class occurs.  This validates that IPC data are
--available and illustrates their distribution, a prerequisite for originality calculations.

WITH cited_pats AS (                         -- Step 1: collect cited publication numbers
    SELECT
        fl.value:"publication_number"::STRING AS cited_pub
    FROM
        PATENTS.PATENTS.PUBLICATIONS  src,
        LATERAL FLATTEN(input => src."citation") fl
    WHERE
        src."publication_number" = 'US-9166782-B2'
        AND fl.value:"publication_number" IS NOT NULL
), ipc4_codes AS (                           -- Step 2: extract IPC-4 codes of each cited patent
    SELECT
        SUBSTR(ip.value:"code"::STRING, 1, 4) AS ipc4
    FROM
        cited_pats cp
        JOIN PATENTS.PATENTS.PUBLICATIONS pub
              ON pub."publication_number" = cp.cited_pub,
        LATERAL FLATTEN(input => pub."ipc") ip
)
SELECT
    ipc4,
    COUNT(*) AS occurrences
FROM
    ipc4_codes
GROUP BY
    ipc4
ORDER BY
    occurrences DESC
LIMIT 20;
```
