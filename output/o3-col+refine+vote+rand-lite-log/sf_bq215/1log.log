```sql
--Description:  Compute the originality score for a single U.S. patent (“US-9166782-B2” ‑ granted 2015) to
--verify the entire calculation pipeline before scaling to all patents.
--Logic
-- 1. citing_cte  :  Flatten the focal patent’s “citation” array to list every cited publication number.
-- 2. ipc_cte     :  For each cited publication, flatten its “ipc” array and extract the first 4 characters
--                   (“ipc4”) of every IPC code.
-- 3. freq_cte    :  Count how many times each distinct ipc4 appears among the backward citations.
-- 4. orig_cte    :  Aggregate to obtain:
--                     N       = total number of ipc4 occurrences
--                     sum_sq  = Σ(n_k²) where n_k is the count per ipc4 class
--                   Originality = 1 – (sum_sq / N²)
--The final SELECT shows the calculated originality score for “US-9166782-B2”.
WITH citing_cte AS (          -- step-1: list cited patents
    SELECT
        src."publication_number"                       AS "citing_pub",
        cit.value:"publication_number"::STRING         AS "cited_pub"
    FROM
        PATENTS.PATENTS.PUBLICATIONS src,
        LATERAL FLATTEN(input => src."citation") cit
    WHERE
        src."publication_number" = 'US-9166782-B2'
        AND cit.value:"publication_number" IS NOT NULL
),
ipc_cte AS (                  -- step-2: gather IPC-4 codes of cited patents
    SELECT
        c."citing_pub",
        SUBSTR(ip.value:"code"::STRING, 1, 4)          AS "ipc4"
    FROM
        citing_cte c
        JOIN PATENTS.PATENTS.PUBLICATIONS cp
              ON cp."publication_number" = c."cited_pub",
        LATERAL FLATTEN(input => cp."ipc") ip
),
freq_cte AS (                 -- step-3: count occurrences per ipc4
    SELECT
        "citing_pub",
        "ipc4",
        COUNT(*) AS n_k
    FROM
        ipc_cte
    GROUP BY
        "citing_pub", "ipc4"
),
orig_cte AS (                 -- step-4: calculate N, Σ(n_k²), and originality
    SELECT
        "citing_pub",
        SUM(n_k)                 AS N,
        SUM(n_k * n_k)           AS sum_sq
    FROM
        freq_cte
    GROUP BY
        "citing_pub"
)
SELECT
    "citing_pub"                                AS "publication_number",
    1 - (sum_sq::FLOAT / (N * N))               AS "originality_score"
FROM
    orig_cte
LIMIT 1;
