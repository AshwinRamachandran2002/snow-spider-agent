--Description: 7) For the same 100-patent sample, aggregate per citing patent: total IPC4 occurrences (N) and sum of squared counts (Σ n_i²).
WITH ipc_counts AS (
  SELECT 
    cp."citing_pub",
    SUBSTR(f_ipc.value:"code"::STRING,1,4) AS "ipc4"
  FROM (
      SELECT 
        p."publication_number"               AS "citing_pub",
        c.value:"publication_number"::STRING AS "cited_pub"
      FROM PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."citation") c
      WHERE p."country_code" = 'US'
        AND p."kind_code"    = 'B2'
        AND p."grant_date"  BETWEEN 20150101 AND 20181231
        AND c.value:"publication_number" IS NOT NULL
      LIMIT 100
  ) cp
  JOIN PATENTS.PATENTS.PUBLICATIONS cited
    ON cited."publication_number" = cp."cited_pub",
  LATERAL FLATTEN(input => cited."ipc") f_ipc
), per_class AS (
  SELECT 
    "citing_pub",
    "ipc4",
    COUNT(*) AS "n_i"
  FROM ipc_counts
  GROUP BY "citing_pub","ipc4"
), agg AS (
  SELECT 
    "citing_pub",
    SUM(POWER("n_i",2)) AS "sum_sq",
    SUM("n_i")          AS "N"
  FROM per_class
  GROUP BY "citing_pub"
)
SELECT * FROM agg
LIMIT 20
