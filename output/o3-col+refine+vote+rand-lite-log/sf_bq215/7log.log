```sql
--Description: Compute the originality score for the patent US-8967144-B2.  
--Steps: (1) list all its backward citations, (2) obtain the 4-digit IPC codes of each cited patent,  
--(3) count occurrences per IPC4 (n_i), (4) calculate total N and Σ n_i², then  
--(5) output originality = 1 − Σ n_i² / N².
WITH cited_pairs AS (           --step 1: cited publication numbers
    SELECT
        c.value:"publication_number"::STRING AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") c
    WHERE p."publication_number" = 'US-8967144-B2'
      AND c.value:"publication_number" IS NOT NULL
), ipc_exploded AS (            --step 2: IPC4 codes of cited publications
    SELECT
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4"
    FROM cited_pairs cp
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = cp."cited_pub",
    LATERAL FLATTEN(input => cited."ipc") f
), per_class AS (               --step 3: count occurrences per IPC4
    SELECT
        "ipc4",
        COUNT(*) AS "n_i"
    FROM ipc_exploded
    GROUP BY "ipc4"
), summary AS (                 --step 4: totals
    SELECT
        SUM("n_i")            AS "N",
        SUM(POWER("n_i",2))   AS "sum_sq"
    FROM per_class
)
SELECT
    'US-8967144-B2'                            AS "publication_number",
    1 - ("sum_sq" / POWER("N",2))              AS "originality"
FROM summary;
