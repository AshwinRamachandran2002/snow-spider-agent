```sql
--Description: 9) Compute originality for ALL US-B2 patents granted 2015-2018 (full corpus).  
--Steps mirror the 1 000-sample query but without LIMIT on citing patents; list top-20 scores.
WITH cited_pairs AS (                   --explode backward citations
    SELECT
        p."publication_number"                       AS "citing_pub",
        c.value:"publication_number"::STRING         AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") c
    WHERE p."country_code" = 'US'
      AND p."kind_code"    = 'B2'
      AND p."grant_date"  BETWEEN 20150101 AND 20181231
      AND c.value:"publication_number" IS NOT NULL
), ipc_exploded AS (                    --flatten IPC of cited pubs to 4-digit codes
    SELECT
        cp."citing_pub",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4"
    FROM cited_pairs cp
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = cp."cited_pub",
    LATERAL FLATTEN(input => cited."ipc") f
), per_class AS (                       --n_i per IPC4
    SELECT
        "citing_pub",
        "ipc4",
        COUNT(*) AS "n_i"
    FROM ipc_exploded
    GROUP BY "citing_pub", "ipc4"
), per_patent AS (                      --N and Σ n_i², keep patents with IPC data
    SELECT
        "citing_pub"                    AS "publication_number",
        SUM("n_i")            AS "N",
        SUM(POWER("n_i", 2))  AS "sum_sq"
    FROM per_class
    GROUP BY "citing_pub"
    HAVING SUM("n_i") > 0
)
SELECT
    "publication_number",
    1 - ("sum_sq" / POWER("N", 2))      AS "originality"
FROM per_patent
ORDER BY "originality" DESC
LIMIT 20;
```

