```sql
--Description: 6) For each citing patent, count occurrences of each IPC4 appearing in its backward citations (sample of 20 citing patents).
WITH ipc_counts AS (
  SELECT 
    cp."citing_pub",
    SUBSTR(f_ipc.value:"code"::STRING,1,4) AS "ipc4"
  FROM (
      SELECT 
        p."publication_number" AS "citing_pub",
        c.value:"publication_number"::STRING AS "cited_pub"
      FROM PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."citation") c
      WHERE p."country_code" = 'US'
        AND p."kind_code"    = 'B2'
        AND p."grant_date" BETWEEN 20150101 AND 20181231
        AND c.value:"publication_number" IS NOT NULL
      LIMIT 100
  ) cp
  JOIN PATENTS.PATENTS.PUBLICATIONS cited
    ON cited."publication_number" = cp."cited_pub",
  LATERAL FLATTEN(input => cited."ipc") f_ipc
)
SELECT 
  "citing_pub",
  "ipc4",
  COUNT(*) AS "n_i"
FROM ipc_counts
GROUP BY "citing_pub","ipc4"
LIMIT 20;
```

```sql
--Description: 7) Aggregate per citing patent: total IPC4 occurrences (N) and sum of squared counts (Σ n_i²).  
WITH ipc_counts AS (  --same CTE as in query 6 but no LIMIT for full accuracy; keep small sample here
  SELECT 
    cp."citing_pub",
    SUBSTR(f_ipc.value:"code"::STRING,1,4) AS "ipc4"
  FROM (
      SELECT 
        p."publication_number" AS "citing_pub",
        c.value:"publication_number"::STRING AS "cited_pub"
      FROM PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."citation") c
      WHERE p."country_code" = 'US'
        AND p."kind_code"    = 'B2'
        AND p."grant_date" BETWEEN 20150101 AND 20181231
        AND c.value:"publication_number" IS NOT NULL
      LIMIT 100
  ) cp
  JOIN PATENTS.PATENTS.PUBLICATIONS cited
    ON cited."publication_number" = cp."cited_pub",
  LATERAL FLATTEN(input => cited."ipc") f_ipc
), stats AS (
  SELECT 
    "citing_pub",
    COUNT(*)                                AS "N",
    SUM(POWER(COUNT(*),2)) OVER (PARTITION BY "citing_pub","ipc4")   --inner aggregation
  FROM ipc_counts
  GROUP BY "citing_pub","ipc4"
), agg AS (
  SELECT 
    "citing_pub",
    SUM(POWER("n_i",2)) AS "sum_sq",
    SUM("n_i")          AS "N"
  FROM (
      SELECT 
        "citing_pub",
        "ipc4",
        COUNT(*) AS "n_i"
      FROM ipc_counts
      GROUP BY "citing_pub","ipc4"
  )
  GROUP BY "citing_pub"
)
SELECT * FROM agg
LIMIT 20;
```

```sql
--Description: 8) Compute the *originality* score per citing patent (sample) = 1 - Σ n_i² / N².
WITH ipc_counts AS (
  SELECT 
    cp."citing_pub",
    SUBSTR(f_ipc.value:"code"::STRING,1,4) AS "ipc4"
  FROM (
      SELECT 
        p."publication_number" AS "citing_pub",
        c.value:"publication_number"::STRING AS "cited_pub"
      FROM PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."citation") c
      WHERE p."country_code" = 'US'
        AND p."kind_code"    = 'B2'
        AND p."grant_date" BETWEEN 20150101 AND 20181231
        AND c.value:"publication_number" IS NOT NULL
      LIMIT 100
  ) cp
  JOIN PATENTS.PATENTS.PUBLICATIONS cited
    ON cited."publication_number" = cp."cited_pub",
  LATERAL FLATTEN(input => cited."ipc") f_ipc
), per_class AS (
  SELECT 
    "citing_pub",
    "ipc4",
    COUNT(*) AS "n_i"
  FROM ipc_counts
  GROUP BY "citing_pub","ipc4"
), per_patent AS (
  SELECT 
    "citing_pub",
    SUM(POWER("n_i",2)) AS "sum_sq",
    SUM("n_i")          AS "N"
  FROM per_class
  GROUP BY "citing_pub"
)
SELECT 
  "citing_pub"                                 AS "publication_number",
  1 - ("sum_sq" / POWER("N",2))                AS "originality"
FROM per_patent
ORDER BY "originality" DESC
LIMIT 20;
```

