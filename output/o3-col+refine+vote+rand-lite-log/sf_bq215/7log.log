--Description: Build originality scores for the first 1 000 US-B2 patents granted 2015-2018.  
--We: (1) take those patents, (2) explode their backward citations, (3) join cited publications and
--     flatten their IPC codes to 4-digit level, (4) count occurrences per IPC4 (n_i), and
--     (5) compute originality = 1 − Σ n_i² ⁄ N². Finally return the 20 highest-scoring patents.
WITH first_citing AS (                          --step 1: 1 000 candidate patents
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'US'
      AND "kind_code"    = 'B2'
      AND "grant_date"  BETWEEN 20150101 AND 20181231
    LIMIT 1000
),
cited_pairs AS (                                --step 2: explode citations of those patents
    SELECT
        p."publication_number"                       AS "citing_pub",
        c.value:"publication_number"::STRING         AS "cited_pub"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    JOIN first_citing fc
      ON fc."publication_number" = p."publication_number",
    LATERAL FLATTEN(input => p."citation") c
    WHERE c.value:"publication_number" IS NOT NULL
),
ipc_exploded AS (                                --step 3: IPC4 codes of cited publications
    SELECT
        cp."citing_pub",
        SUBSTR(f.value:"code"::STRING, 1, 4) AS "ipc4"
    FROM cited_pairs cp
    JOIN PATENTS.PATENTS.PUBLICATIONS cited
      ON cited."publication_number" = cp."cited_pub",
    LATERAL FLATTEN(input => cited."ipc") f
),
per_class AS (                                   --step 4: counts per IPC4
    SELECT
        "citing_pub",
        "ipc4",
        COUNT(*) AS "n_i"
    FROM ipc_exploded
    GROUP BY "citing_pub", "ipc4"
),
per_patent AS (                                  --step 5: N and Σ n_i²
    SELECT
        "citing_pub"                     AS "publication_number",
        SUM("n_i")            AS "N",
        SUM(POWER("n_i", 2))  AS "sum_sq"
    FROM per_class
    GROUP BY "citing_pub"
    HAVING SUM("n_i") > 0
)
SELECT
    "publication_number",
    1 - ("sum_sq" / POWER("N", 2))       AS "originality"
FROM per_patent
ORDER BY "originality" DESC
LIMIT 20;
