         LATERAL FLATTEN(input => p."ipc") ipc_u
    GROUP BY 
        c."citing_pub",
        SUBSTR(ipc_u.value:"code"::STRING, 0, 4)
),
totals AS (
    SELECT 
        "citing_pub",
        SUM("n_k")          AS "n_total",
        SUM(POWER("n_k",2)) AS "sum_sq"
    FROM ipc_counts
    GROUP BY "citing_pub"
    HAVING SUM("n_k") > 0
)
SELECT 
    "citing_pub"                         AS "publication_number",
    1 - ("sum_sq" / POWER("n_total",2))  AS "originality_score"
FROM totals
LIMIT 20;
