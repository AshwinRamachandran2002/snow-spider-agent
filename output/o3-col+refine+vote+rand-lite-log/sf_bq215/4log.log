    FROM (
        SELECT 
            t."publication_number"                      AS "citing_pub",
            f.value:"publication_number"::STRING        AS "cited_pub"
        FROM PATENTS.PATENTS.PUBLICATIONS t,
             LATERAL FLATTEN(input => t."citation") f
        WHERE t."country_code" = 'US'
          AND t."kind_code"   = 'B2'
          AND t."grant_date" BETWEEN 20150101 AND 20181231
          AND f.value:"publication_number" IS NOT NULL
        LIMIT 1000
    ) cp
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = cp."cited_pub"
      AND p."ipc" IS NOT NULL,
         LATERAL FLATTEN(input => p."ipc") ipc_u
    GROUP BY 
        cp."citing_pub",
        SUBSTR(ipc_u.value:"code"::STRING, 1, 4)
), totals AS (
    SELECT 
        "citing_pub",
        SUM("n_k")          AS "n_total",
        SUM(POWER("n_k",2)) AS "sum_sq"
    FROM ipc_counts
    GROUP BY "citing_pub"
    HAVING SUM("n_k") > 0          -- avoid divide-by-zero
)
SELECT 
    "citing_pub"                        AS "publication_number",
    1 - ("sum_sq" / POWER("n_total",2)) AS "originality_score"
FROM totals
ORDER BY "originality_score" DESC
LIMIT 20
