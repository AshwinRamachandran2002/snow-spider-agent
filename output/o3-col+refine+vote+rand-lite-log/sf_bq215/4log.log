        "citing_pub"                          AS "publication_number",
        SUM("n_k")                            AS "n_total",
        SUM(POWER("n_k", 2))                  AS "sum_sq"
    FROM ipc_counts
    GROUP BY "citing_pub"
    HAVING SUM("n_k") > 0
)
SELECT  
    "publication_number",
    1 - ("sum_sq" / POWER("n_total", 2))      AS "originality_score"
FROM stats
ORDER BY "originality_score" DESC NULLS LAST
LIMIT 1;
