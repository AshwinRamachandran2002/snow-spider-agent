--Description: Find cited publication numbers that actually exist in the PUBLICATIONS table and possess IPC data, then list a few of their IPC codes.
WITH cited_pubs AS (                                                               -- collect cited publication numbers
    SELECT DISTINCT 
           f.value:"publication_number"::STRING AS cited_pub
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f
    WHERE f.value:"publication_number" IS NOT NULL
    LIMIT 10000
), cited_with_ipc AS (                                                             -- keep only those that match PUBLICATIONS rows with non-null IPC
    SELECT p."publication_number"
    FROM cited_pubs c
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = c.cited_pub
    WHERE p."ipc" IS NOT NULL
    LIMIT 20
)
SELECT 
    p."publication_number",
    ipc_f.value:"code"::STRING AS "ipc_code"
FROM PATENTS.PATENTS.PUBLICATIONS p,
     LATERAL FLATTEN(input => p."ipc") ipc_f
WHERE p."publication_number" IN (SELECT "publication_number" FROM cited_with_ipc)
LIMIT 20;
