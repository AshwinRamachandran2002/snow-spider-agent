```sql
--Description: Pick one US-B2 patent (2015-2018) that cites at least one publication containing IPC data,
--             then count the occurrences of each 4-digit IPC code among all its cited publications.
WITH first_patent AS (                                                           -- find a suitable citing patent
    SELECT DISTINCT
           t."publication_number" AS citing_pub
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."citation") f,
         PATENTS.PATENTS.PUBLICATIONS p
    WHERE t."country_code" = 'US'
      AND t."kind_code"    = 'B2'
      AND t."grant_date" BETWEEN 20150101 AND 20181231
      AND f.value:"publication_number"::STRING = p."publication_number"
      AND p."ipc" IS NOT NULL                                -- at least one cited doc has IPC
    LIMIT 1                                                  -- keep the first match
), ipc_counts AS (                                                           -- gather IPC codes for that patent’s citations
    SELECT
        fp.citing_pub,
        SUBSTR(ipc_u.value:"code"::STRING, 1, 4) AS ipc4
    FROM first_patent fp
    JOIN PATENTS.PATENTS.PUBLICATIONS t
      ON t."publication_number" = fp.citing_pub,
         LATERAL FLATTEN(input => t."citation") f
    JOIN PATENTS.PATENTS.PUBLICATIONS p
      ON p."publication_number" = f.value:"publication_number"::STRING
     AND p."ipc" IS NOT NULL,
         LATERAL FLATTEN(input => p."ipc") ipc_u
)
SELECT
    citing_pub,
    ipc4,
    COUNT(*) AS cnt
FROM ipc_counts
GROUP BY citing_pub, ipc4
ORDER BY cnt DESC
LIMIT 20;
