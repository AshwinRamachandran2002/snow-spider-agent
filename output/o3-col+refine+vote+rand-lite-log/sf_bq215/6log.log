```sql
--Description: Inspect IPC codes for two cited publications we know exist (“US-6574629-B1” and “US-5895932-A”)  
--             to confirm the IPC array structure and truncate each code to its 4-digit prefix.
SELECT
    cp."publication_number"                                AS "cited_pub",
    SUBSTR(ip.value:"code"::STRING, 1, 4)                  AS "ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS  cp,
     LATERAL FLATTEN(input => cp."ipc") ip
WHERE cp."publication_number" IN ('US-6574629-B1', 'US-5895932-A')
  AND ip.value:"code" IS NOT NULL
LIMIT 20;
```

```sql
--Description: For the focal patent “US-9362717-B2”, count occurrences of every distinct 4-digit IPC class
--             across all of its backward citations (needed to build the originality index).
WITH cited AS (
    SELECT
        TRIM(f.value:"publication_number"::STRING) AS cited_pub
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."publication_number" = 'US-9362717-B2'
      AND TRIM(f.value:"publication_number"::STRING) <> ''
), ipc_counts AS (
    SELECT
        SUBSTR(ip.value:"code"::STRING, 1, 4)       AS ipc4,
        COUNT(*)                                    AS ipc4_count
    FROM cited c
    JOIN PATENTS.PATENTS.PUBLICATIONS cp
      ON cp."publication_number" = c.cited_pub
    , LATERAL FLATTEN(input => cp."ipc") ip
    WHERE ip.value:"code" IS NOT NULL
    GROUP BY SUBSTR(ip.value:"code"::STRING, 1, 4)
)
SELECT *
FROM ipc_counts
ORDER BY ipc4_count DESC
LIMIT 20;
```

```sql
--Description: Compute the originality score for the single patent “US-9362717-B2”.
--             Originality = 1 − Σ(share²) where share = n_ipc / total across all IPC classes in citations.
WITH cited AS (
    SELECT
        TRIM(f.value:"publication_number"::STRING) AS cited_pub
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."citation") f
    WHERE p."publication_number" = 'US-9362717-B2'
      AND TRIM(f.value:"publication_number"::STRING) <> ''
), ipc_counts AS (
    SELECT
        SUBSTR(ip.value:"code"::STRING, 1, 4) AS ipc4,
        COUNT(*)                              AS n_ipc
    FROM cited c
    JOIN PATENTS.PATENTS.PUBLICATIONS cp
      ON cp."publication_number" = c.cited_pub
    , LATERAL FLATTEN(input => cp."ipc") ip
    WHERE ip.value:"code" IS NOT NULL
    GROUP BY SUBSTR(ip.value:"code"::STRING, 1, 4)
), tot AS (
    SELECT SUM(n_ipc) AS total FROM ipc_counts
)
SELECT
    1 - SUM(POWER(n_ipc, 2)) / (SELECT POWER(total, 2) FROM tot) AS "originality"
FROM ipc_counts;
```

