--Description: Inspect IPC codes for two cited publications we know exist (“US-6574629-B1” and “US-5895932-A”)  
--             to confirm the IPC array structure and truncate each code to its 4-digit prefix.
SELECT
    cp."publication_number"                                AS "cited_pub",
    SUBSTR(ip.value:"code"::STRING, 1, 4)                  AS "ipc4"
FROM PATENTS.PATENTS.PUBLICATIONS  cp,
     LATERAL FLATTEN(input => cp."ipc") ip
WHERE cp."publication_number" IN ('US-6574629-B1', 'US-5895932-A')
  AND ip.value:"code" IS NOT NULL
LIMIT 20
