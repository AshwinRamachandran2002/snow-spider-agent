--Description: Search the PUBLICATIONS table for any records whose publication_number
--             contains either digit string “5231049” (first citation of US-9362717-B2)
--             or “5895932” (another citation).  For each match, flatten its IPC array
--             and return distinct 4-digit IPC prefixes so we can confirm IPC data are
--             available and discover the exact stored identifiers.
SELECT DISTINCT
       p."publication_number"                       AS "cited_pub",
       SUBSTR(ip.value:"code"::STRING, 1, 4)        AS "ipc4"
FROM   PATENTS.PATENTS.PUBLICATIONS  p,
       LATERAL FLATTEN(input => p."ipc") ip
WHERE ( p."publication_number" ILIKE '%5231049%'
        OR p."publication_number" ILIKE '%5895932%' )
  AND  ip.value:"code" IS NOT NULL
LIMIT 20;
```
