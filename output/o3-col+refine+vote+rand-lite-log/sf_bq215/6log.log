--Description:  The prior lookup assumed the exact identifiers “US-6574629-B1” and “US-5895932-A”.
--              Those patents might be stored with different kind-code suffixes (e.g., “B2”, “A1”)
--              or even without any suffix at all.  To locate the correct rows first, perform a
--              wildcard search for the unique digit strings “6574629” and “5895932” anywhere
--              inside the publication_number.  This will reveal the precise identifiers present
--              in the table, which we can then use for IPC extraction.
SELECT
    "publication_number"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "publication_number" ILIKE '%6574629%'
   OR "publication_number" ILIKE '%5895932%'
LIMIT 20;
