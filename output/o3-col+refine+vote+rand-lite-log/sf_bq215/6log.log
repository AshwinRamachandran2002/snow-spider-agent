```sql
--Description: Compute originality score for that one focal patent: 1 − Σ(share²)
WITH cited AS (
  SELECT f.value:"publication_number"::STRING AS cited_pub
  FROM PATENTS.PATENTS.PUBLICATIONS p,
       LATERAL FLATTEN(input => p."citation") f
  WHERE p."publication_number" = 'US-9483724-B2'
),
ipc_counts AS (
  SELECT 
    SUBSTR(ip.value:"code"::STRING,1,4) AS ipc4,
    COUNT(*)                             AS n_ipc
  FROM cited c
  JOIN PATENTS.PATENTS.PUBLICATIONS cp
    ON cp."publication_number" = c.cited_pub
  , LATERAL FLATTEN(input => cp."ipc") ip
  WHERE ip.value:"code" IS NOT NULL
  GROUP BY SUBSTR(ip.value:"code"::STRING,1,4)
),
tot AS (
  SELECT SUM(n_ipc) AS total FROM ipc_counts
)
SELECT 
  1 - SUM(POWER(n_ipc,2)) / (SELECT POWER(total,2) FROM tot)  AS "originality"
FROM ipc_counts;
```

