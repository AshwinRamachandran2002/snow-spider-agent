```sql
--Description: Compute originality for every eligible US-B2 patent granted 2015-2018 and list the top 20 highest scores
WITH focal AS (
  SELECT "publication_number"
  FROM PATENTS.PATENTS.PUBLICATIONS
  WHERE "country_code" = 'US'
    AND "kind_code"   = 'B2'
    AND "grant_date" BETWEEN 20150101 AND 20181231
),
citations AS (
  SELECT 
    fp."publication_number"                              AS focal_pub,
    cf.value:"publication_number"::STRING                AS cited_pub
  FROM focal fp,
       LATERAL FLATTEN(input => fp."citation") cf
),
ipc_counts AS (
  SELECT 
    c.focal_pub,
    SUBSTR(ip.value:"code"::STRING,1,4)  AS ipc4,
    COUNT(*)                             AS n_ipc
  FROM citations c
  JOIN PATENTS.PATENTS.PUBLICATIONS cp
    ON cp."publication_number" = c.cited_pub
  , LATERAL FLATTEN(input => cp."ipc") ip
  WHERE ip.value:"code" IS NOT NULL
  GROUP BY c.focal_pub, SUBSTR(ip.value:"code"::STRING,1,4)
),
totals AS (
  SELECT focal_pub, SUM(n_ipc) AS tot FROM ipc_counts GROUP BY focal_pub
),
orig AS (
  SELECT 
    i.focal_pub,
    1 - SUM(POWER(i.n_ipc,2)) / ANY_VALUE(POWER(t.tot,2)) AS originality
  FROM ipc_counts i
  JOIN totals t ON t.focal_pub = i.focal_pub
  GROUP BY i.focal_pub
)
SELECT 
  "focal_pub"            AS "publication_number",
  "originality"
FROM orig
ORDER BY "originality" DESC
LIMIT 20;
```

