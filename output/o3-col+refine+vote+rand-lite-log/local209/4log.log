Query:
--Description: Final answer – store name, total orders, delivered orders, and the delivered/total ratio.
SELECT  s."store_id",
        s."store_name",
        totals."total_orders",
        delivered."delivered_orders",
        CAST(delivered."delivered_orders" AS REAL) / totals."total_orders"
        AS "delivered_ratio"
FROM   (SELECT   o."store_id",
                 COUNT(*) AS "total_orders"
        FROM     "orders" AS o
        GROUP BY o."store_id"
        ORDER BY "total_orders" DESC
        LIMIT    1)                        AS totals
JOIN    (SELECT   o."store_id",
                   COUNT(*) AS "delivered_orders"
         FROM     "orders"     AS o
         JOIN     "deliveries" AS d
               ON o."delivery_order_id" = d."delivery_order_id"
         WHERE    d."delivery_status" = 'DELIVERED'
         GROUP BY o."store_id")         AS delivered
       ON totals."store_id" = delivered."store_id"
JOIN    "stores" AS s
       ON s."store_id" = totals."store_id"
LIMIT   20;
Answer:
store_id,store_name,total_orders,delivered_orders,delivered_ratio
