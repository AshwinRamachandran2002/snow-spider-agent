```sql
--Description: Quick look at existing stores (id & name).
SELECT DISTINCT "store_id",
       "store_name"
FROM   "stores"
LIMIT  20;
```

```sql
--Description: Find how many orders each store has (top-20 by volume).
SELECT   "store_id",
         COUNT(*) AS "total_orders"
FROM     "orders"
GROUP BY "store_id"
ORDER BY "total_orders" DESC
LIMIT    20;
```

```sql
--Description: Same ranking as above, now showing the store names.
SELECT   s."store_id",
         s."store_name",
         COUNT(o."order_id") AS "total_orders"
FROM     "orders" AS o
JOIN     "stores" AS s
       ON o."store_id" = s."store_id"
GROUP BY s."store_id",
         s."store_name"
ORDER BY "total_orders" DESC
LIMIT    20;
```

```sql
--Description: Isolate the store_id with the single largest number of orders.
SELECT "store_id"
FROM   (SELECT   o."store_id",
                 COUNT(*) AS "total_orders"
        FROM     "orders" AS o
        GROUP BY o."store_id"
        ORDER BY "total_orders" DESC
        LIMIT    1)
LIMIT 20;
```

```sql
--Description: Sample 20 orders that belong to that top-volume store.
SELECT DISTINCT *
FROM   "orders" AS o
WHERE  o."store_id" = (SELECT o2."store_id"
                       FROM   "orders" AS o2
                       GROUP  BY o2."store_id"
                       ORDER  BY COUNT(*) DESC
                       LIMIT  1)
LIMIT  20;
```

```sql
--Description: Show 20 delivered-order IDs for that store (joined with deliveries table).
SELECT DISTINCT o."order_id"
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."store_id"       = (SELECT o2."store_id"
                             FROM   "orders" AS o2
                             GROUP  BY o2."store_id"
                             ORDER  BY COUNT(*) DESC
                             LIMIT  1)
  AND  d."delivery_status" = 'DELIVERED'
LIMIT  20;
```

```sql
--Description: Count how many of that store’s orders are actually marked DELIVERED.
SELECT COUNT(*) AS "delivered_orders"
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."store_id"       = (SELECT o2."store_id"
                             FROM   "orders" AS o2
                             GROUP  BY o2."store_id"
                             ORDER  BY COUNT(*) DESC
                             LIMIT  1)
  AND  d."delivery_status" = 'DELIVERED'
LIMIT  20;
```

```sql
--Description: Total number of orders for that same store (regardless of delivery status).
SELECT COUNT(*) AS "total_orders"
FROM   "orders" AS o
WHERE  o."store_id" = (SELECT o2."store_id"
                       FROM   "orders" AS o2
                       GROUP  BY o2."store_id"
                       ORDER  BY COUNT(*) DESC
                       LIMIT  1)
LIMIT  20;
```

```sql
--Description: Compute the delivered-to-total ratio for that top store.
SELECT (1.0 * delivered."delivered_orders") / total."total_orders"
       AS "delivered_ratio"
FROM   (SELECT COUNT(*) AS "delivered_orders"
        FROM   "orders"     AS o
        JOIN   "deliveries" AS d
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  o."store_id"       = (SELECT o2."store_id"
                                     FROM   "orders" AS o2
                                     GROUP  BY o2."store_id"
                                     ORDER  BY COUNT(*) DESC
                                     LIMIT  1)
          AND  d."delivery_status" = 'DELIVERED') AS delivered,
       (SELECT COUNT(*) AS "total_orders"
        FROM   "orders" AS o
        WHERE  o."store_id" = (SELECT o2."store_id"
                               FROM   "orders" AS o2
                               GROUP  BY o2."store_id"
                               ORDER  BY COUNT(*) DESC
                               LIMIT  1))               AS total
LIMIT  20;
```

```sql
--Description: Final answer – store name, total orders, delivered orders, and the delivered/total ratio.
SELECT  s."store_id",
        s."store_name",
        totals."total_orders",
        delivered."delivered_orders",
        CAST(delivered."delivered_orders" AS REAL) / totals."total_orders"
        AS "delivered_ratio"
FROM   (SELECT   o."store_id",
                 COUNT(*) AS "total_orders"
        FROM     "orders" AS o
        GROUP BY o."store_id"
        ORDER BY "total_orders" DESC
        LIMIT    1)                        AS totals
JOIN    (SELECT   o."store_id",
                   COUNT(*) AS "delivered_orders"
         FROM     "orders"     AS o
         JOIN     "deliveries" AS d
               ON o."delivery_order_id" = d."delivery_order_id"
         WHERE    d."delivery_status" = 'DELIVERED'
         GROUP BY o."store_id")         AS delivered
       ON totals."store_id" = delivered."store_id"
JOIN    "stores" AS s
       ON s."store_id" = totals."store_id"
LIMIT   20;
```
