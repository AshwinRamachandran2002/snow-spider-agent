Query:
--Description: Compute the delivered-to-total ratio for that top store.
SELECT (1.0 * delivered."delivered_orders") / total."total_orders"
       AS "delivered_ratio"
FROM   (SELECT COUNT(*) AS "delivered_orders"
        FROM   "orders"     AS o
        JOIN   "deliveries" AS d
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  o."store_id"       = (SELECT o2."store_id"
                                     FROM   "orders" AS o2
                                     GROUP  BY o2."store_id"
                                     ORDER  BY COUNT(*) DESC
                                     LIMIT  1)
          AND  d."delivery_status" = 'DELIVERED') AS delivered,
       (SELECT COUNT(*) AS "total_orders"
        FROM   "orders" AS o
        WHERE  o."store_id" = (SELECT o2."store_id"
                               FROM   "orders" AS o2
                               GROUP  BY o2."store_id"
                               ORDER  BY COUNT(*) DESC
                               LIMIT  1))               AS total
LIMIT  20;
