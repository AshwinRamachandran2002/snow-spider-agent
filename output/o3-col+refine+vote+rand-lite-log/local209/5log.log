```sql
--Description: Preview a few orders together with their store names
SELECT o."order_id",
       o."store_id",
       s."store_name"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
LIMIT 20;
```

```sql
--Description: Get the 20 stores with most orders (descending)
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS "total_orders"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
GROUP  BY o."store_id"
ORDER  BY "total_orders" DESC
LIMIT 20;
```

```sql
--Description: Identify the store_id that has the single highest order count
SELECT o."store_id"
FROM   "orders" AS o
GROUP  BY o."store_id"
ORDER  BY COUNT(*) DESC
LIMIT 1;
```

```sql
--Description: Show 20 sample orders that belong to the store with the highest order count
SELECT o."order_id",
       o."delivery_order_id",
       o."order_status"
FROM   "orders" AS o
WHERE  o."store_id" = (
        SELECT o2."store_id"
        FROM   "orders" AS o2
        GROUP  BY o2."store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1
       )
LIMIT 20;
```

```sql
--Description: Count how many orders of that top store have a matching record in deliveries
SELECT COUNT(*) AS "orders_with_delivery_record"
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."store_id" = (
        SELECT o2."store_id"
        FROM   "orders" AS o2
        GROUP  BY o2."store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1
       );
```

```sql
--Description: Count how many of those deliveries are actually marked as 'DELIVERED'
SELECT COUNT(*) AS "delivered_orders"
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON o."delivery_order_id" = d."delivery_order_id"
WHERE  o."store_id" = (
        SELECT o2."store_id"
        FROM   "orders" AS o2
        GROUP  BY o2."store_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 1
       )
  AND  d."delivery_status" = 'DELIVERED';
```

```sql
--Description: Final answer – show the store with the highest order count and the
--             ratio (delivered / total) of its orders
SELECT total."store_id",
       s."store_name",
       total."total_orders",
       COALESCE(deliv."delivered_orders", 0) AS "delivered_orders",
       ROUND(
         COALESCE(deliv."delivered_orders", 0) * 1.0 / total."total_orders",
         4
       ) AS "delivered_ratio"
FROM  (
        SELECT o."store_id",
               COUNT(*) AS "total_orders"
        FROM   "orders" AS o
        GROUP  BY o."store_id"
        ORDER  BY "total_orders" DESC
        LIMIT 1
      ) AS total
LEFT JOIN (
        SELECT o."store_id",
               COUNT(*) AS "delivered_orders"
        FROM   "orders"     AS o
        JOIN   "deliveries" AS d
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  d."delivery_status" = 'DELIVERED'
        GROUP  BY o."store_id"
      ) AS deliv
      ON total."store_id" = deliv."store_id"
JOIN  "stores" AS s
      ON total."store_id" = s."store_id"
LIMIT 1;
```

