        SELECT o."store_id",
               COUNT(*) AS "total_orders"
        FROM   "orders" AS o
        GROUP  BY o."store_id"
        ORDER  BY "total_orders" DESC
        LIMIT 1
      ) AS total
LEFT JOIN (
        SELECT o."store_id",
               COUNT(*) AS "delivered_orders"
        FROM   "orders"     AS o
        JOIN   "deliveries" AS d
               ON o."delivery_order_id" = d."delivery_order_id"
        WHERE  d."delivery_status" = 'DELIVERED'
        GROUP  BY o."store_id"
      ) AS deliv
      ON total."store_id" = deliv."store_id"
JOIN  "stores" AS s
      ON total."store_id" = s."store_id"
LIMIT 1;
