-- Description / Thinking process:
-- Step-1: Rank stores by total orders to find the top store (store_counts CTE, keeping only 1 row).
-- Step-2: Join that top store back to orders and (left) to deliveries.
-- Step-3: Count total orders, count only those with delivery_status = 'DELIVERED',
--         and compute the delivered-to-total ratio.
WITH store_counts AS (
    SELECT s."store_id",
           s."store_name",
           COUNT(*) AS total_orders
    FROM   "orders" AS o
    JOIN   "stores" AS s ON o."store_id" = s."store_id"
    GROUP  BY s."store_id", s."store_name"
    ORDER  BY total_orders DESC
    LIMIT  1                       -- top store only
)
SELECT sc."store_id",
       sc."store_name",
       sc.total_orders,
       SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       ROUND(1.0 * SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END)
                  / sc.total_orders, 4)                                   AS delivered_ratio
FROM   store_counts  AS sc
JOIN   "orders"      AS o ON o."store_id" = sc."store_id"
LEFT   JOIN "deliveries" AS d ON o."delivery_order_id" = d."delivery_order_id"
