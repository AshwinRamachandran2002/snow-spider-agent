```sql
-- Description: Check how many orders each store has to spot the most-ordered store
SELECT "store_id",
       COUNT(*) AS total_orders
FROM "orders"
GROUP BY "store_id"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Add the store name to the previous count to clearly see the leader
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS total_orders
FROM "orders" AS o
JOIN "stores" AS s
  ON o."store_id" = s."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Peek at deliveries that are already marked DELIVERED
SELECT DISTINCT "delivery_order_id"
FROM "deliveries"
WHERE "delivery_status" = 'DELIVERED'
LIMIT 20;
```

```sql
-- Description: For every store, count total orders vs. delivered orders
SELECT s."store_id",
       s."store_name",
       COUNT(*)                                                   AS total_orders,
       SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 END) AS delivered_orders,
       ROUND(1.0 * SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 END)
             / COUNT(*), 4)                                       AS delivered_ratio
FROM "orders"      AS o
JOIN "stores"      AS s ON o."store_id" = s."store_id"
LEFT JOIN "deliveries" AS d ON o."delivery_order_id" = d."delivery_order_id"
GROUP BY s."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Focus on the single top-ranked store (replace 9999 with real store_id from previous result)
