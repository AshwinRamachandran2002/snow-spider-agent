Query:
-- Description: For every store, count total orders vs. delivered orders
SELECT s."store_id",
       s."store_name",
       COUNT(*)                                                   AS total_orders,
       SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 END) AS delivered_orders,
       ROUND(1.0 * SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 END)
             / COUNT(*), 4)                                       AS delivered_ratio
FROM "orders"      AS o
JOIN "stores"      AS s ON o."store_id" = s."store_id"
LEFT JOIN "deliveries" AS d ON o."delivery_order_id" = d."delivery_order_id"
GROUP BY s."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
