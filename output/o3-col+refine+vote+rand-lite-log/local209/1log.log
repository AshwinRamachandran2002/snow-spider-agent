Query:
--Description: List distinct delivery_status values for orders of the store with the highest number of orders
WITH store_counts AS (
    SELECT o."store_id"
    FROM   "orders" AS o
    GROUP  BY o."store_id"
    ORDER  BY COUNT(*) DESC
    LIMIT  1                 -- top store only
)
SELECT DISTINCT d."delivery_status"
FROM   "orders"     AS o
JOIN   store_counts AS sc ON o."store_id" = sc."store_id"
LEFT   JOIN "deliveries" AS d ON o."delivery_order_id" = d."delivery_order_id"
