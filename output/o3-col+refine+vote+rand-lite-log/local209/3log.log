--Description: Count how many of store_id = 53 (“PAPA SUCIS”, the store with most orders) have a matching delivery row marked as ‘DELIVERED’.
SELECT COUNT(*) AS delivered_orders
FROM   "orders"     AS o
JOIN   "deliveries" AS d
       ON d."delivery_order_id" = o."delivery_order_id"
WHERE  o."store_id"        = 53
  AND  d."delivery_status" = 'DELIVERED'
