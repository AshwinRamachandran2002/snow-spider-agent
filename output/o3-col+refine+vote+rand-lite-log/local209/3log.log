```sql
--Description / Thinking process:
--Step-1: For every store, count how many orders it has in the orders table (store_order_counts).
--Step-2: Pick the single store with the greatest number of orders (top_store).
--Step-3: Join all orders of that store to the deliveries table (LEFT JOIN so we keep orders that never reached deliveries).
--Step-4: In the final aggregation count:
--        • total_orders  – all orders for the top store
--        • delivered_orders – those whose corresponding delivery row shows delivery_status = 'DELIVERED'
--        • delivered_ratio  – delivered_orders / total_orders (rounded to 4 decimals).
WITH store_order_counts AS (
    SELECT "store_id",
           COUNT(*) AS total_orders
    FROM   "orders"
    GROUP  BY "store_id"
),
top_store AS (
    SELECT soc."store_id", soc.total_orders, s."store_name"
    FROM   store_order_counts soc
    JOIN   "stores" s ON s."store_id" = soc."store_id"
    ORDER  BY soc.total_orders DESC
    LIMIT  1                -- keep only the store with the most orders
)
SELECT ts."store_id",
       ts."store_name",
       ts.total_orders,
       SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       ROUND(1.0 * SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END)
                 / ts.total_orders, 4)                                     AS delivered_ratio
FROM   top_store ts
JOIN   "orders"    o ON o."store_id" = ts."store_id"
LEFT   JOIN "deliveries" d ON d."delivery_order_id" = o."delivery_order_id"
GROUP  BY ts."store_id", ts."store_name", ts.total_orders;
```
