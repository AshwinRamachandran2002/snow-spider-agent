Query:
--Description: Compute total orders, delivered orders, and their ratio for the store with the highest volume of orders (determined dynamically in CTE top_store).
WITH top_store AS (
    SELECT o."store_id"
    FROM   "orders" AS o
    GROUP  BY o."store_id"
    ORDER  BY COUNT(*) DESC
    LIMIT  1                       -- keep only the #1 store
)
SELECT s."store_name",
       COUNT(*)                                            AS total_orders,
       SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       ROUND(
           1.0 * SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) / COUNT(*),
           4
       )                                                   AS delivered_ratio
FROM   "orders"     AS o
JOIN   top_store    AS ts ON ts."store_id" = o."store_id"
JOIN   "stores"     AS s  ON s."store_id"  = o."store_id"
LEFT   JOIN "deliveries" AS d ON d."delivery_order_id" = o."delivery_order_id"
GROUP  BY s."store_name"
Answer:
store_name,total_orders,delivered_orders,delivered_ratio
