FROM "orders"
LIMIT 20;
```

```sql
--Description: Count of total orders per store_id
SELECT "store_id",
       COUNT(*) AS total_orders
FROM "orders"
GROUP BY "store_id"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
--Description: Same aggregation, but attaching the human-readable store_name
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS total_orders
FROM "orders" AS o
JOIN "stores" AS s
  ON o."store_id" = s."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
--Description: Identify the single store with the highest number of orders
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS total_orders
FROM "orders" AS o
JOIN "stores" AS s
  ON o."store_id" = s."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 1;
```

```sql
--Description: For that top store (replace :top_store_id with the id returned above), list all its orders
SELECT "order_id", "delivery_order_id", "order_status"
FROM "orders"
WHERE "store_id" = :top_store_id
LIMIT 20;
```

```sql
--Description: Count how many of that store’s orders appear in deliveries with status = 'DELIVERED'
SELECT COUNT(*) AS delivered_orders
FROM "orders"  AS o
JOIN "deliveries" AS d
  ON o."delivery_order_id" = d."delivery_order_id"
WHERE o."store_id" = :top_store_id
  AND d."delivery_status" = 'DELIVERED';
```

```sql
--Description: Final ratio of delivered / total orders for the highest-volume store
WITH top_store AS (
    SELECT o."store_id"
    FROM "orders" AS o
    GROUP BY o."store_id"
    ORDER BY COUNT(*) DESC
    LIMIT 1
)
SELECT s."store_name",
       COUNT(*)                                            AS total_orders,
       SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       ROUND(1.0 * SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) /
                  COUNT(*), 4)                              AS delivered_ratio
FROM   "orders"     AS o
JOIN   top_store    AS ts ON o."store_id" = ts."store_id"
JOIN   "stores"     AS s  ON o."store_id" = s."store_id"
LEFT JOIN "deliveries" AS d ON o."delivery_order_id" = d."delivery_order_id"
GROUP  BY s."store_name"
LIMIT 1;
```
