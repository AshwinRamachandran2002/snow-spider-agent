```sql
-- Description: See which store-ids exist in the orders table.
SELECT DISTINCT store_id
FROM orders
LIMIT 20;
```

```sql
-- Description: Match those store-ids with their names.
SELECT DISTINCT o.store_id,
       s.store_name
FROM orders AS o
JOIN stores AS s
  ON s.store_id = o.store_id
LIMIT 20;
```

```sql
-- Description: Count the number of orders each store received.
SELECT o.store_id,
       s.store_name,
       COUNT(*) AS total_orders
FROM orders AS o
JOIN stores AS s
  ON s.store_id = o.store_id
GROUP BY o.store_id,
         s.store_name
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: For every store, count how many of its orders have a matching row in deliveries.
SELECT o.store_id,
       s.store_name,
       COUNT(*)                                   AS total_orders,
       SUM(CASE WHEN d.delivery_order_id IS NOT NULL THEN 1 ELSE 0 END) AS orders_with_delivery
FROM orders      AS o
JOIN stores      AS s  ON s.store_id = o.store_id
LEFT JOIN deliveries AS d  ON d.delivery_order_id = o.delivery_order_id
GROUP BY o.store_id,
         s.store_name
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Restrict the previous query to deliveries whose status is ‘DELIVERED’.
SELECT o.store_id,
       s.store_name,
       COUNT(*)                                   AS total_orders,
       SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders
FROM orders      AS o
JOIN stores      AS s  ON s.store_id = o.store_id
LEFT JOIN deliveries AS d
       ON d.delivery_order_id = o.delivery_order_id
      AND d.delivery_status   = 'DELIVERED'
GROUP BY o.store_id,
         s.store_name
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Compute, for each store, the ratio of ‘DELIVERED’ orders to total orders.
SELECT o.store_id,
       s.store_name,
       COUNT(*)                                                   AS total_orders,
       SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       CAST(SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS FLOAT)
       / COUNT(*)                                                 AS delivered_ratio
FROM orders      AS o
JOIN stores      AS s  ON s.store_id = o.store_id
LEFT JOIN deliveries AS d
       ON d.delivery_order_id = o.delivery_order_id
      AND d.delivery_status   = 'DELIVERED'
GROUP BY o.store_id,
         s.store_name
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Identify the single store with the most orders (ties broken arbitrarily).
WITH store_totals AS (
    SELECT o.store_id,
           COUNT(*) AS total_orders
    FROM orders AS o
    GROUP BY o.store_id
),
top_store AS (
    SELECT store_id
    FROM store_totals
    ORDER BY total_orders DESC
    LIMIT 1
)
SELECT s.store_name,
       st.total_orders,
       SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       CAST(SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS FLOAT)
       / st.total_orders                                                AS delivered_ratio
FROM orders      AS o
JOIN top_store   AS ts ON ts.store_id = o.store_id
JOIN store_totals AS st ON st.store_id = o.store_id
JOIN stores       AS s  ON s.store_id = o.store_id
LEFT JOIN deliveries AS d
       ON d.delivery_order_id = o.delivery_order_id
      AND d.delivery_status   = 'DELIVERED'
GROUP BY s.store_name,
         st.total_orders
LIMIT 20;
```

```sql
-- Description: Same as the previous query but shows both the store_id and an exact ratio.
WITH store_totals AS (
    SELECT o.store_id,
           COUNT(*) AS total_orders
    FROM orders AS o
    GROUP BY o.store_id
),
top_store AS (
    SELECT store_id
    FROM store_totals
    ORDER BY total_orders DESC
    LIMIT 1
)
SELECT o.store_id,
       s.store_name,
       st.total_orders,
       SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders,
       ROUND(CAST(SUM(CASE WHEN d.delivery_status = 'DELIVERED' THEN 1 ELSE 0 END) AS FLOAT)
             / st.total_orders, 4) AS delivered_ratio
FROM orders      AS o
JOIN top_store   AS ts ON ts.store_id = o.store_id
JOIN store_totals AS st ON st.store_id = o.store_id
JOIN stores       AS s  ON s.store_id = o.store_id
LEFT JOIN deliveries AS d
       ON d.delivery_order_id = o.delivery_order_id
      AND d.delivery_status   = 'DELIVERED'
GROUP BY o.store_id,
         s.store_name,
         st.total_orders
LIMIT 20;
```
