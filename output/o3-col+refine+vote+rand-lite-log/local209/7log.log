-- Description: Count how many orders of the busiest store (store_id = 53) were actually delivered (status = 'DELIVERED')
SELECT COUNT(DISTINCT o."order_id") AS delivered_orders
FROM   "orders"     AS o
JOIN   "deliveries" AS d  ON d."delivery_order_id" = o."delivery_order_id"
WHERE  o."store_id" = 53
  AND  d."delivery_status" = 'DELIVERED'
