Query:
-- Description: Join the previous result with "stores" to know the store names
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS total_orders
FROM "orders" AS o
JOIN "stores" AS s ON s."store_id" = o."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
