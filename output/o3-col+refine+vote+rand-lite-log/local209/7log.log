```sql
-- Description: Preview a few orders to see available "store_id"s
SELECT "order_id", "store_id", "order_status"
FROM "orders"
LIMIT 20;
```

```sql
-- Description: Count how many orders each store has and show the 20 busiest stores
SELECT "store_id", COUNT(*) AS total_orders
FROM "orders"
GROUP BY "store_id"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Join the previous result with "stores" to know the store names
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS total_orders
FROM "orders" AS o
JOIN "stores" AS s ON s."store_id" = o."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
-- Description: Retrieve the single store that has the highest number of orders
SELECT o."store_id",
       s."store_name",
       COUNT(*) AS total_orders
FROM "orders" AS o
JOIN "stores" AS s ON s."store_id" = o."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 1;
```

```sql
-- Description: Show 20 sample orders from that top-volume store (replace :top_store_id after seeing the result above)
SELECT "order_id", "store_id", "delivery_order_id", "order_status"
FROM "orders"
WHERE "store_id" = :top_store_id
LIMIT 20;
```

```sql
-- Description: Check which of those orders appear in "deliveries" with status = 'DELIVERED'
SELECT d."delivery_order_id", d."delivery_status"
FROM "deliveries" AS d
JOIN "orders"   AS o ON o."delivery_order_id" = d."delivery_order_id"
WHERE o."store_id" = :top_store_id
  AND d."delivery_status" = 'DELIVERED'
LIMIT 20;
```

```sql
-- Description: Count how many orders of the top store were actually delivered (status = 'DELIVERED')
SELECT COUNT(DISTINCT o."order_id") AS delivered_orders
FROM "orders"     AS o
JOIN "deliveries" AS d ON d."delivery_order_id" = o."delivery_order_id"
WHERE o."store_id" = :top_store_id
  AND d."delivery_status" = 'DELIVERED';
```

```sql
-- Description: Count the total number of orders for the top store (denominator for the ratio)
SELECT COUNT(*) AS total_orders
FROM "orders"
WHERE "store_id" = :top_store_id;
```

```sql
-- Description: Compute the ratio of delivered orders to total orders for the top store
SELECT delivered_cnt * 1.0 / total_cnt AS delivered_ratio
FROM (
    SELECT COUNT(DISTINCT o."order_id") AS delivered_cnt
    FROM "orders"     AS o
    JOIN "deliveries" AS d ON d."delivery_order_id" = o."delivery_order_id"
    WHERE o."store_id" = :top_store_id
      AND d."delivery_status" = 'DELIVERED'
) AS delivered,
(
    SELECT COUNT(*) AS total_cnt
    FROM "orders"
    WHERE "store_id" = :top_store_id
) AS total;
```

```sql
-- Description: Show the final answer (store with most orders, total orders, delivered orders, delivered/total ratio)
SELECT s."store_name",
       counts.total_orders,
       counts.delivered_orders,
       ROUND(counts.delivered_orders * 1.0 / counts.total_orders, 4) AS delivered_ratio
FROM (
    SELECT o."store_id",
           COUNT(*)                                   AS total_orders,
           SUM(CASE WHEN d."delivery_status" = 'DELIVERED' THEN 1 ELSE 0 END) AS delivered_orders
    FROM "orders"     AS o
    LEFT JOIN "deliveries" AS d
           ON d."delivery_order_id" = o."delivery_order_id"
    GROUP BY o."store_id"
    ORDER BY total_orders DESC
    LIMIT 1
) AS counts
JOIN "stores" AS s ON s."store_id" = counts."store_id";
```
