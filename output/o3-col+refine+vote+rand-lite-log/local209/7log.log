Query:
-- Description: Compute the ratio of delivered orders to total orders for the busiest store (store_id = 53)
SELECT delivered_cnt * 1.0 / total_cnt AS delivered_ratio
FROM (
        SELECT COUNT(DISTINCT o."order_id") AS delivered_cnt
        FROM   "orders"     AS o
        JOIN   "deliveries" AS d  ON d."delivery_order_id" = o."delivery_order_id"
        WHERE  o."store_id" = 53
          AND  d."delivery_status" = 'DELIVERED'
     ) AS delivered,
     (
        SELECT COUNT(*) AS total_cnt
        FROM   "orders"
        WHERE  "store_id" = 53
     ) AS total
Answer:
