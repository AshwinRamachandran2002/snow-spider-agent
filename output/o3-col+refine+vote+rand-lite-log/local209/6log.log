```sql
--Description: 1) Quick look at distinct store IDs that have at least one order
SELECT DISTINCT o."store_id"
FROM "orders" AS o
LIMIT 20;
```

```sql
--Description: 2) Same list but already coupled with store names for an easier read
SELECT DISTINCT o."store_id",
       s."store_name"
FROM   "orders" AS o
JOIN   "stores" AS s
       ON o."store_id" = s."store_id"
LIMIT 20;
```

```sql
--Description: 3) Count of total orders per store (top-20 by volume)
SELECT   o."store_id",
         COUNT(*) AS total_orders
FROM     "orders" AS o
GROUP BY o."store_id"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
--Description: 4) Same aggregation but with the store name included
SELECT   o."store_id",
         s."store_name",
         COUNT(*) AS total_orders
FROM     "orders" AS o
JOIN     "stores" AS s
         ON o."store_id" = s."store_id"
GROUP BY o."store_id", s."store_name"
ORDER BY total_orders DESC
LIMIT 20;
```

```sql
--Description: 5) Inspect the variety of delivery statuses we have
SELECT DISTINCT d."delivery_status"
FROM   "deliveries" AS d
LIMIT 20;
```

```sql
--Description: 6) For each store, how many of its orders appear in deliveries with status 'DELIVERED'
SELECT   o."store_id",
         COUNT(*) AS delivered_orders
FROM     "orders"     AS o
JOIN     "deliveries" AS d
         ON o."delivery_order_id" = d."delivery_order_id"
WHERE    d."delivery_status" = 'DELIVERED'
GROUP BY o."store_id"
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
--Description: 7) Combine total orders and delivered orders for each store
SELECT   t."store_id",
         t.total_orders,
         IFNULL(d.delivered_orders, 0) AS delivered_orders
FROM    ( SELECT o."store_id",
                 COUNT(*) AS total_orders
          FROM   "orders" AS o
          GROUP  BY o."store_id"
        ) AS t
LEFT JOIN
        ( SELECT   o."store_id",
                   COUNT(*) AS delivered_orders
          FROM     "orders"     AS o
          JOIN     "deliveries" AS d
                   ON o."delivery_order_id" = d."delivery_order_id"
          WHERE    d."delivery_status" = 'DELIVERED'
          GROUP BY o."store_id"
        ) AS d
        ON t."store_id" = d."store_id"
ORDER BY t.total_orders DESC
LIMIT 20;
```

```sql
--Description: 8) Show the calculated delivered-to-total ratio for each store
SELECT   z."store_id",
         s."store_name",
         z.total_orders,
         z.delivered_orders,
         ROUND(1.0 * z.delivered_orders / z.total_orders, 4) AS delivered_ratio
FROM    ( /* sub-query from step 7 */ 
          SELECT   t."store_id",
                   t.total_orders,
                   IFNULL(d.delivered_orders, 0) AS delivered_orders
          FROM    ( SELECT o."store_id",
                           COUNT(*) AS total_orders
                    FROM   "orders" AS o
                    GROUP  BY o."store_id"
                  ) AS t
          LEFT JOIN
                  ( SELECT   o."store_id",
                             COUNT(*) AS delivered_orders
                    FROM     "orders"     AS o
                    JOIN     "deliveries" AS d
                             ON o."delivery_order_id" = d."delivery_order_id"
                    WHERE    d."delivery_status" = 'DELIVERED'
                    GROUP BY o."store_id"
                  ) AS d
                  ON t."store_id" = d."store_id"
        ) AS z
JOIN     "stores" AS s
         ON z."store_id" = s."store_id"
ORDER BY z.total_orders DESC
LIMIT 20;
```

```sql
--Description: 9) Identify just the single store with the highest number of orders
SELECT   z."store_id",
         s."store_name",
         z.total_orders
FROM    ( SELECT   o."store_id",
                   COUNT(*) AS total_orders
          FROM     "orders" AS o
          GROUP BY o."store_id"
          ORDER BY total_orders DESC
          LIMIT 1
        ) AS z
JOIN     "stores" AS s
         ON z."store_id" = s."store_id"
LIMIT 20;
```

```sql
--Description: 10) For that most-ordered store, present delivered, total and the ratio
SELECT   z."store_id",
         s."store_name",
         z.total_orders,
         z.delivered_orders,
         ROUND(1.0 * z.delivered_orders / z.total_orders, 4) AS delivered_ratio
FROM    ( /* re-use computation but filter to the #1 store */
          SELECT   t."store_id",
                   t.total_orders,
                   IFNULL(d.delivered_orders, 0) AS delivered_orders
          FROM    ( SELECT o."store_id",
                           COUNT(*) AS total_orders
                    FROM   "orders" AS o
                    GROUP  BY o."store_id"
                    ORDER BY total_orders DESC
                    LIMIT 1
                  ) AS t
          LEFT JOIN
                  ( SELECT   o."store_id",
                             COUNT(*) AS delivered_orders
                    FROM     "orders"     AS o
                    JOIN     "deliveries" AS d
                             ON o."delivery_order_id" = d."delivery_order_id"
                    WHERE    d."delivery_status" = 'DELIVERED'
                    GROUP BY o."store_id"
                  ) AS d
                  ON t."store_id" = d."store_id"
        ) AS z
JOIN     "stores" AS s
         ON z."store_id" = s."store_id"
LIMIT 20;
```
