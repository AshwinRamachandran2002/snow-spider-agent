Query:
-- Description: Combine total and delivered counts to compute the ratio
SELECT
       delivered."delivered_orders",
       totals."total_orders",
       ROUND( CAST(delivered."delivered_orders" AS REAL) /
              totals."total_orders", 4) AS "delivered_ratio"
FROM (
       SELECT COUNT(*) AS "delivered_orders"
       FROM   "deliveries" AS d
       JOIN   "orders"     AS o  ON o."delivery_order_id" = d."delivery_order_id"
       WHERE  d."delivery_status" = 'DELIVERED'
       AND    o."store_id" = (
                SELECT s."store_id"
                FROM   "orders" AS o2
                JOIN   "stores" AS s ON s."store_id" = o2."store_id"
                GROUP  BY s."store_id"
                ORDER  BY COUNT(o2."order_id") DESC
                LIMIT 1
              )
     ) AS delivered
CROSS JOIN (
       SELECT COUNT(*) AS "total_orders"
       FROM   "orders"
       WHERE  "store_id" = (
                SELECT s."store_id"
                FROM   "orders" AS o2
                JOIN   "stores" AS s ON s."store_id" = o2."store_id"
                GROUP  BY s."store_id"
                ORDER  BY COUNT(o2."order_id") DESC
                LIMIT 1
              )
     ) AS totals;
Answer:
delivered_orders,total_orders,delivered_ratio
