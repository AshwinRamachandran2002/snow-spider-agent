FROM `bigquery-public-data.london_crime.crime_by_lsoa`
ORDER BY `borough`
LIMIT 20;
```

```sql
--Description: Verify the exact spelling of “Westminster” in the borough column.
SELECT DISTINCT `borough`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE LOWER(`borough`) LIKE '%westminster%'
LIMIT 20;
```

```sql
--Description: Quick sanity-check of “Other Theft” records for Westminster in a single year (2010).
SELECT *
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE `borough` = 'Westminster'
  AND `major_category` = 'Theft and Handling'
  AND `minor_category` = 'Other Theft'
  AND `year` = 2010
LIMIT 20;
```

```sql
--Description: Final answer – total number of “Other Theft” incidents within “Theft and Handling”
--             for each calendar year in the Westminster borough.
SELECT
  `year`,
  SUM(`value`) AS total_other_theft_incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE `borough` = 'Westminster'
  AND `major_category` = 'Theft and Handling'
  AND `minor_category` = 'Other Theft'
GROUP BY `year`
ORDER BY `year`
LIMIT 20;
```
