```sql
--Description: 1) Quick look-up of all borough names to confirm ‘Westminster’ exists  
SELECT DISTINCT `borough`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
LIMIT 20;
```

```sql
--Description: 2) List every major crime category to see the exact spelling of “Theft and Handling”  
SELECT DISTINCT `major_category`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
LIMIT 20;
```

```sql
--Description: 3) Show every minor category that sits inside the “Theft and Handling” major category  
SELECT DISTINCT `minor_category`
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE major_category = 'Theft and Handling'
LIMIT 20;
```

```sql
--Description: 4) Sample rows for Westminster where the minor category is “Other Theft” to verify data looks right  
SELECT *
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND minor_category = 'Other Theft'
LIMIT 20;
```

```sql
--Description: 5) Year-by-year total of all “Other Theft” incidents in Westminster (ignores major_category check)  
SELECT
  year,
  SUM(value) AS total_other_theft
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 6) Year-by-year total for the whole “Theft and Handling” major category in Westminster (all its sub-types)  
SELECT
  year,
  SUM(value) AS total_theft_and_handling
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 7) Break the “Theft and Handling” family down by each minor category for Westminster, so we can spot “Other Theft” in context  
SELECT
  year,
  minor_category,
  SUM(value) AS incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
GROUP BY year, minor_category
ORDER BY year, minor_category
LIMIT 20;
```

```sql
--Description: 8) Same as #5 but explicitly checks both major & minor categories for maximum safety  
SELECT
  year,
  SUM(value) AS other_theft_incidents
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 9) Use a CTE to isolate Westminster + Other Theft first, then aggregate; stylistically different from #8  
WITH westminster_other_theft AS (
  SELECT year, value
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE borough = 'Westminster'
    AND major_category = 'Theft and Handling'
    AND minor_category = 'Other Theft'
)
SELECT
  year,
  SUM(value) AS total_other_theft
FROM westminster_other_theft
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – total number of “Other Theft” incidents within “Theft and Handling” for each year in Westminster  
SELECT
  year,
  SUM(value) AS total_other_theft_westminster
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year
ORDER BY year
LIMIT 20;
```
