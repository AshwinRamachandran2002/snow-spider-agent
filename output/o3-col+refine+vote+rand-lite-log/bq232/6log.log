Query:
--Description: 9) Use a CTE to isolate Westminster + Other Theft first, then aggregate; stylistically different from #8  
WITH westminster_other_theft AS (
  SELECT year, value
  FROM `bigquery-public-data.london_crime.crime_by_lsoa`
  WHERE borough = 'Westminster'
    AND major_category = 'Theft and Handling'
    AND minor_category = 'Other Theft'
)
SELECT
  year,
  SUM(value) AS total_other_theft
FROM westminster_other_theft
GROUP BY year
ORDER BY year
LIMIT 20;
Answer:
year,total_other_theft
2008,16501
2009,16045
2010,15906
2011,17872
2012,19556
2013,16620
2014,13790
2015,13570
2016,12172
