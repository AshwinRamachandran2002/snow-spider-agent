```sql
--Description: 6) Aggregate monthly numbers per year for the target slice
SELECT year,
       month,
       SUM(value) AS monthly_other_theft
FROM `bigquery-public-data.london_crime.crime_by_lsoa`
WHERE borough        = 'Westminster'
  AND major_category = 'Theft and Handling'
  AND minor_category = 'Other Theft'
GROUP BY year, month
ORDER BY year, month
LIMIT 20;
```

