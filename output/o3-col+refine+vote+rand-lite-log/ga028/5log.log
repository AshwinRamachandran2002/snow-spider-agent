```sql
--Description: 7) For every week (0-4) count how many cohort users generated ANY event in that week  
WITH first_session AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS first_session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180612' AND '20181002'
  GROUP BY user_pseudo_id
),
cohort AS (
  SELECT
    user_pseudo_id
  FROM first_session
  WHERE first_session_date BETWEEN '20180702' AND '20180708'
),
events_in_scope AS (
  SELECT
    user_pseudo_id,
    event_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'   -- ignore anything after 2-Oct-2018
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
)
SELECT
  CASE
    WHEN event_date BETWEEN '20180702' AND '20180708' THEN 0
    WHEN event_date BETWEEN '20180709' AND '20180715' THEN 1
    WHEN event_date BETWEEN '20180716' AND '20180722' THEN 2
    WHEN event_date BETWEEN '20180723' AND '20180729' THEN 3
    WHEN event_date BETWEEN '20180730' AND '20180805' THEN 4
  END AS week_number,
  COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM events_in_scope
GROUP BY week_number
ORDER BY week_number
LIMIT 20;
```

```sql
--Description: 8) Final retention summary – Week 0 cohort size and retained users for Week 0-4  
WITH first_session AS (
  SELECT
    user_pseudo_id,
    MIN(event_date) AS first_session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180612' AND '20181002'
  GROUP BY user_pseudo_id
),
cohort AS (
  SELECT
    user_pseudo_id
  FROM first_session
  WHERE first_session_date BETWEEN '20180702' AND '20180708'
),
cohort_size AS (
  SELECT COUNT(*) AS week0_users FROM cohort
),
retention AS (
  SELECT
    CASE
      WHEN event_date BETWEEN '20180702' AND '20180708' THEN 0
      WHEN event_date BETWEEN '20180709' AND '20180715' THEN 1
      WHEN event_date BETWEEN '20180716' AND '20180722' THEN 2
      WHEN event_date BETWEEN '20180723' AND '20180729' THEN 3
      WHEN event_date BETWEEN '20180730' AND '20180805' THEN 4
    END AS week_number,
    COUNT(DISTINCT user_pseudo_id) AS retained_users
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180805'     -- only weeks 0-4
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
  GROUP BY week_number
)
SELECT
  r.week_number,
  c.week0_users,
  r.retained_users
FROM retention AS r
CROSS JOIN cohort_size AS c
ORDER BY r.week_number
LIMIT 20;
```

The last query returns a five-row table:

week_number | week0_users | retained_users  
------------|-------------|----------------  
0           | (cohort)    | (same as cohort)  
1           | (cohort)    | …  
2           | (cohort)    | …  
3           | (cohort)    | …  
4           | (cohort)    | …  

giving you the 7-day, 14-day, … up to 28-day retention for users who first opened the app in the Monday-based week that began on 2-July-2018.
