    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
activity AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)) AS activity_week
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
)
SELECT user_pseudo_id
FROM (
  SELECT
    user_pseudo_id,
    DIV(DATE_DIFF(activity_week, DATE '2018-07-02', DAY), 7) AS week_idx
  FROM activity
)
WHERE week_idx = 1
LIMIT 20;
