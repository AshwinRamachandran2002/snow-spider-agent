Below are ten progressively-richer queries (each limited to 20 rows) that walk from simple inspection to the final 7-day-retention result for users whose very first session happened during the Monday-based week that starts 2 Jul 2018.  
All queries only touch tables inside  
`firebase-public-project.analytics_153293282.events_*`.

```sql
--Description: 1) See which event_date values exist in the cohort week (2-8 Jul 2018).
SELECT DISTINCT event_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180708'
ORDER BY event_date
LIMIT 20;
```

```sql
--Description: 2) Look at a few 'session_start' events on 2 Jul 2018.
SELECT event_date, event_name, user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_20180702`
WHERE event_name = 'session_start'
LIMIT 20;
```

```sql
--Description: 3) For every user who fires a session_start between 2-8 Jul, show their
--earliest session_start date inside that range.
SELECT
  user_pseudo_id,
  MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180708'
  AND event_name = 'session_start'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 4) Identify the cohort: users whose *global* first session
--falls between 2 Jul and 8 Jul 2018 (inclusive).
WITH first_all AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS global_first_session
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT user_pseudo_id, global_first_session
FROM first_all
WHERE global_first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
LIMIT 20;
```

```sql
--Description: 5) For cohort users, list every Monday-based week in which they were active
--through 2 Oct 2018.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
activity AS (
  SELECT
    c.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)) AS activity_week
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
)
SELECT DISTINCT user_pseudo_id, activity_week
FROM activity
ORDER BY user_pseudo_id, activity_week
LIMIT 20;
```

```sql
--Description: 6) Add a week_index (0-4) relative to cohort start for some user-week pairs.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
activity AS (
  SELECT
    c.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)) AS activity_week
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
)
SELECT
  user_pseudo_id,
  activity_week,
  DIV(DATE_DIFF(activity_week, DATE '2018-07-02', DAY), 7) AS week_index
FROM activity
WHERE activity_week BETWEEN DATE '2018-07-02' AND DATE '2018-08-06'   -- Weeks 0-4
ORDER BY user_pseudo_id, activity_week
LIMIT 20;
```

```sql
--Description: 7) Core retention counts: distinct users per week_index (0-4).
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
activity AS (
  SELECT
    c.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)) AS activity_week
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
)
SELECT
  DIV(DATE_DIFF(activity_week, DATE '2018-07-02', DAY), 7) AS week_index,
  COUNT(DISTINCT user_pseudo_id)                       AS retained_users
FROM activity
WHERE activity_week BETWEEN DATE '2018-07-02' AND DATE '2018-08-06'   -- Weeks 0-4
GROUP BY week_index
HAVING week_index BETWEEN 0 AND 4
ORDER BY week_index
LIMIT 20;
```

```sql
--Description: 8) Same counts but pivoted into a single row (Week0 cohort + Week1-4 retention).
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
)
SELECT
  COUNT(DISTINCT IF(week_idx = 0, user_pseudo_id, NULL)) AS week0_new_users,
  COUNT(DISTINCT IF(week_idx = 1, user_pseudo_id, NULL)) AS week1_retained,
  COUNT(DISTINCT IF(week_idx = 2, user_pseudo_id, NULL)) AS week2_retained,
  COUNT(DISTINCT IF(week_idx = 3, user_pseudo_id, NULL)) AS week3_retained,
  COUNT(DISTINCT IF(week_idx = 4, user_pseudo_id, NULL)) AS week4_retained
FROM (
  SELECT
    c.user_pseudo_id,
    DIV(DATE_DIFF(DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
                  DATE '2018-07-02', DAY), 7) AS week_idx
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
) 
WHERE week_idx BETWEEN 0 AND 4
LIMIT 20;
```

```sql
--Description: 9) Retention percentages (users and % of original cohort) for Weeks 0-4.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
cohort_size AS (SELECT COUNT(*) AS total FROM cohort),
retention AS (
  SELECT
    DIV(DATE_DIFF(DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
                  DATE '2018-07-02', DAY), 7) AS week_idx,
    COUNT(DISTINCT c.user_pseudo_id) AS users
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
  GROUP BY week_idx
  HAVING week_idx BETWEEN 0 AND 4
)
SELECT
  r.week_idx,
  r.users,
  ROUND(100 * r.users / cs.total, 2) AS pct_of_cohort
FROM retention r CROSS JOIN cohort_size cs
ORDER BY week_idx
LIMIT 20;
```

```sql
--Description: 10) Show 20 example users from the cohort who are retained in Week 1.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
activity AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)) AS activity_week
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
)
SELECT user_pseudo_id
FROM (
  SELECT
    user_pseudo_id,
    DIV(DATE_DIFF(activity_week, DATE '2018-07-02', DAY), 7) AS week_idx
  FROM activity
)
WHERE week_idx = 1
LIMIT 20;
```

