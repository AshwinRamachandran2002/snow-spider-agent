Query:
--Description: 9) Retention percentages (users and % of original cohort) for Weeks 0-4.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT user_pseudo_id,
           MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session BETWEEN DATE '2018-07-02' AND DATE '2018-07-08'
),
cohort_size AS (SELECT COUNT(*) AS total FROM cohort),
retention AS (
  SELECT
    DIV(DATE_DIFF(DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
                  DATE '2018-07-02', DAY), 7) AS week_idx,
    COUNT(DISTINCT c.user_pseudo_id) AS users
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
  GROUP BY week_idx
  HAVING week_idx BETWEEN 0 AND 4
)
SELECT
  r.week_idx,
  r.users,
  ROUND(100 * r.users / cs.total, 2) AS pct_of_cohort
FROM retention r CROSS JOIN cohort_size cs
ORDER BY week_idx
LIMIT 20;
