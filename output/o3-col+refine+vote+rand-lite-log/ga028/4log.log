  COUNT(DISTINCT IF(wk_start = DATE '2018-07-02', user_pseudo_id, NULL)) AS week0_new_users ,
  COUNT(DISTINCT IF(wk_start = DATE '2018-07-09', user_pseudo_id, NULL)) AS week1_retained_users ,
