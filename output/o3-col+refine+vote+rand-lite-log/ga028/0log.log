--Description: Final 7-day retention table: cohort size (Week 0)
--and retained users for Weeks 0-4, Monday-based, limited to 20 rows.
WITH cohort AS (
  SELECT user_pseudo_id
  FROM (
    SELECT
      user_pseudo_id,
      MIN(event_date) AS first_session_date
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180601' AND '20181002'
      AND event_name = 'session_start'
    GROUP BY user_pseudo_id
  )
  WHERE first_session_date BETWEEN '20180702' AND '20180708'
),
events_with_week AS (
  SELECT
    c.user_pseudo_id,
    DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), DATE '2018-07-02', WEEK(MONDAY)) AS wk
  FROM cohort c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON  e.user_pseudo_id = c.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181002'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', e.event_date), DATE '2018-07-02', WEEK(MONDAY)) BETWEEN 0 AND 4
  GROUP BY c.user_pseudo_id, wk
),
weekly_retention AS (
  SELECT
    wk,
    COUNT(DISTINCT user_pseudo_id) AS retained_users
  FROM events_with_week
  GROUP BY wk
)
SELECT
  0                                         AS week_index,
  (SELECT COUNT(*) FROM cohort)             AS users
UNION ALL
SELECT
  wk                                        AS week_index,
  retained_users                            AS users
FROM weekly_retention
ORDER BY week_index
LIMIT 20;
