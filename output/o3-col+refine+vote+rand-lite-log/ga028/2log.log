```sql
--Description:
--Goal: produce 7-day-bucket retention for the cohort whose first-ever
--session_start happened in the Monday week beginning 2018-07-02, looking
--only at events up to (and including) the week that starts on 2018-10-01.
--
--Thinking process (embedded here so you see the reasoning that drove the SQL):
--1) Because we must reference _TABLE_SUFFIX we have to query the wildcard
--   pattern `events_*`, not an individual table.  _TABLE_SUFFIX gives us the
--   yyyymmdd string of each daily shard.
--2) We gather every session_start into a “sessions” CTE, turning the suffix
--   into proper DATE objects:  activity_date (exact day) and activity_week
--   (Monday-truncated week start).
--3) For each user we find their first ever session_start (first_session_date).
--4) We pick the cohort = users whose first_session_date falls between
--   2018-07-02 and 2018-07-08 (that’s Week-0 Monday-based window).
--5) Joining sessions back to this cohort lets us see every week they returned.
--6) We limit activity to weeks that start on or before 2018-10-01
--   (the table list we have ends with 20181003, so this meets the requirement).
--7) Finally, we aggregate distinct users by week_number (week diff from cohort),
--   then pivot into Week0 … Week4 columns alongside the Week-0 cohort size.
WITH sessions AS (
  SELECT
    user_pseudo_id,
    -- convert “20180702” → DATE
    PARSE_DATE('%Y%m%d', _TABLE_SUFFIX)                                   AS activity_date,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX), WEEK(MONDAY))         AS activity_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
        -- scan only shards that can matter (June-12 to Oct-02 as per prompt)
        AND _TABLE_SUFFIX BETWEEN '20180612' AND '20181002'
),
firsts AS (
  SELECT
    user_pseudo_id,
    MIN(activity_date) AS first_session_date
  FROM sessions
  GROUP BY user_pseudo_id
),
cohort AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(first_session_date, WEEK(MONDAY)) AS cohort_week
  FROM firsts
  WHERE first_session_date BETWEEN '2018-07-02' AND '2018-07-08'
),
activity AS (
  SELECT
    s.user_pseudo_id,
    cohort.cohort_week,
    s.activity_week
  FROM sessions AS s
  JOIN cohort USING(user_pseudo_id)
  WHERE s.activity_week <= '2018-10-01'  -- ignore events beyond Oct-02
),
retention AS (
  SELECT
    DATE_DIFF(activity_week, cohort_week, WEEK(MONDAY)) AS week_number,
    COUNT(DISTINCT user_pseudo_id)                      AS retained_users
  FROM activity
  GROUP BY week_number
)
SELECT
  (SELECT COUNT(*) FROM cohort)                                           AS week0_total_new_users,
  MAX(CASE WHEN week_number = 0 THEN retained_users END) AS week0,
  MAX(CASE WHEN week_number = 1 THEN retained_users END) AS week1,
  MAX(CASE WHEN week_number = 2 THEN retained_users END) AS week2,
  MAX(CASE WHEN week_number = 3 THEN retained_users END) AS week3,
  MAX(CASE WHEN week_number = 4 THEN retained_users END) AS week4
FROM retention
LIMIT 20;
```
