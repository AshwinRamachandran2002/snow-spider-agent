2025-05-05 04:45:49 - Thread-3868 (execute) - INFO - [Exploration]
Below are a series of exploratory–to–final SQL statements that can be run in order (or independently) to locate the first 10 alphabetically-sorted words that  

• are 4–5 characters long,  
• start with the letter “r” (case-sensitive), and  
• have at least one other anagram of the same length in the list.  

Each query is limited to 20 rows unless it is the final answer.

```sql
-- 1) Have a quick look at some words in the table
SELECT DISTINCT "words"
FROM "word_list"
LIMIT 20;
```

```sql
-- 2) Check the distribution of word-lengths
SELECT LENGTH("words")    AS "len",
       COUNT(*)           AS "cnt"
FROM   "word_list"
GROUP  BY LENGTH("words")
ORDER  BY "len"
LIMIT 20;
```

```sql
-- 3) Display words that are 4- or 5-letters long and start with ‘r’
SELECT DISTINCT "words"
FROM   "word_list"
WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
  AND  "words" LIKE 'r%'
ORDER  BY "words"
LIMIT 20;
```

```sql
-- 4) For each 4-/5-letter word, build a canonical “signature”
--    (sorted letters) to help detect anagrams.
SELECT "words",
       LENGTH("words") AS "len",
       (SELECT GROUP_CONCAT(ch, '')
        FROM  (
               SELECT SUBSTR("words",1,1) AS ch
               UNION ALL SELECT SUBSTR("words",2,1)
               UNION ALL SELECT SUBSTR("words",3,1)
               UNION ALL SELECT SUBSTR("words",4,1)
               UNION ALL SELECT CASE
                                 WHEN LENGTH("words") = 5
                                 THEN SUBSTR("words",5,1)
                                END
              ) AS x
        WHERE ch IS NOT NULL
        ORDER BY ch) AS "signature"
FROM   "word_list"
WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
LIMIT 20;
```

```sql
-- 5) Count how many words share the same signature
WITH sig AS (
  SELECT "words",
         (SELECT GROUP_CONCAT(ch,'')
          FROM  (
                 SELECT SUBSTR("words",1,1) AS ch
                 UNION ALL SELECT SUBSTR("words",2,1)
                 UNION ALL SELECT SUBSTR("words",3,1)
                 UNION ALL SELECT SUBSTR("words",4,1)
                 UNION ALL SELECT CASE
                                   WHEN LENGTH("words") = 5
                                   THEN SUBSTR("words",5,1)
                                  END
                ) t
          WHERE ch IS NOT NULL
          ORDER BY ch) AS signature
  FROM   "word_list"
  WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
)
SELECT signature,
       COUNT(*) AS anagram_cnt
FROM   sig
GROUP  BY signature
HAVING COUNT(*) > 1
ORDER  BY anagram_cnt DESC, signature
LIMIT 20;
```

```sql
-- 6) Show all 4-/5-letter words starting with ‘r’ that have ≥1 anagram
WITH sig AS (
  SELECT "words",
         (SELECT GROUP_CONCAT(ch,'')
          FROM  (
                 SELECT SUBSTR("words",1,1) AS ch
                 UNION ALL SELECT SUBSTR("words",2,1)
                 UNION ALL SELECT SUBSTR("words",3,1)
                 UNION ALL SELECT SUBSTR("words",4,1)
                 UNION ALL SELECT CASE
                                   WHEN LENGTH("words") = 5
                                   THEN SUBSTR("words",5,1)
                                  END
                ) t
          WHERE ch IS NOT NULL
          ORDER BY ch) AS signature
  FROM   "word_list"
  WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
)
SELECT  s1."words"                     AS word,
        (SELECT COUNT(*)
         FROM   sig s2
         WHERE  s2.signature = s1.signature) AS anagram_count
FROM   sig s1
WHERE  s1."words" LIKE 'r%'
  AND  (SELECT COUNT(*)
        FROM   sig s2
        WHERE  s2.signature = s1.signature) > 1
LIMIT 20;
```

```sql
-- 7) FINAL ANSWER:
--    First 10 qualifying words (alphabetical) with their anagram counts
WITH sig AS (
  SELECT "words",
         (SELECT GROUP_CONCAT(ch,'')
          FROM  (
                 SELECT SUBSTR("words",1,1) AS ch
                 UNION ALL SELECT SUBSTR("words",2,1)
                 UNION ALL SELECT SUBSTR("words",3,1)
                 UNION ALL SELECT SUBSTR("words",4,1)
                 UNION ALL SELECT CASE
                                   WHEN LENGTH("words") = 5
                                   THEN SUBSTR("words",5,1)
                                  END
                ) t
          WHERE ch IS NOT NULL
          ORDER BY ch) AS signature
  FROM   "word_list"
  WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
)
SELECT  s1."words"                       AS word,
        (SELECT COUNT(*)
         FROM   sig s2
         WHERE  s2.signature = s1.signature) AS anagram_count
FROM     sig s1
WHERE    s1."words" LIKE 'r%'
  AND    (SELECT COUNT(*)
          FROM   sig s2
          WHERE  s2.signature = s1.signature) > 1
GROUP BY word
ORDER BY word ASC           -- alphabetical
LIMIT 10;
```

Running the last query will output the required list of up to 10 words that satisfy all conditions, together with how many total anagrams (including the word itself) exist for each of them.
