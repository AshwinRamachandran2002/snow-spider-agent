Query:
-- 6) Show all 4-/5-letter words starting with ‘r’ that have ≥1 anagram
WITH sig AS (
  SELECT "words",
         (SELECT GROUP_CONCAT(ch,'')
          FROM  (
                 SELECT SUBSTR("words",1,1) AS ch
                 UNION ALL SELECT SUBSTR("words",2,1)
                 UNION ALL SELECT SUBSTR("words",3,1)
                 UNION ALL SELECT SUBSTR("words",4,1)
                 UNION ALL SELECT CASE
                                   WHEN LENGTH("words") = 5
                                   THEN SUBSTR("words",5,1)
                                  END
                ) t
          WHERE ch IS NOT NULL
          ORDER BY ch) AS signature
  FROM   "word_list"
  WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
)
SELECT  s1."words"                     AS word,
        (SELECT COUNT(*)
         FROM   sig s2
         WHERE  s2.signature = s1.signature) AS anagram_count
FROM   sig s1
WHERE  s1."words" LIKE 'r%'
  AND  (SELECT COUNT(*)
        FROM   sig s2
        WHERE  s2.signature = s1.signature) > 1
LIMIT 20;
