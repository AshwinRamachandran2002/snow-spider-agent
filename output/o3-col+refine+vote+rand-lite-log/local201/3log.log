Query:
-- 5) Count how many words share the same signature
WITH sig AS (
  SELECT "words",
         (SELECT GROUP_CONCAT(ch,'')
          FROM  (
                 SELECT SUBSTR("words",1,1) AS ch
                 UNION ALL SELECT SUBSTR("words",2,1)
                 UNION ALL SELECT SUBSTR("words",3,1)
                 UNION ALL SELECT SUBSTR("words",4,1)
                 UNION ALL SELECT CASE
                                   WHEN LENGTH("words") = 5
                                   THEN SUBSTR("words",5,1)
                                  END
                ) t
          WHERE ch IS NOT NULL
          ORDER BY ch) AS signature
  FROM   "word_list"
  WHERE  (LENGTH("words") = 4 OR LENGTH("words") = 5)
)
SELECT signature,
       COUNT(*) AS anagram_cnt
FROM   sig
GROUP  BY signature
HAVING COUNT(*) > 1
ORDER  BY anagram_cnt DESC, signature
LIMIT 20;
