-- 6. Count how many words share each signature (i.e., size of each anagram set)
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
),
signature AS (
  SELECT c.word,
         (SELECT group_concat(letter,'')
            FROM (SELECT letter
                  FROM chars c2
                  WHERE c2.word = c.word
                  ORDER BY letter) ) AS sig
  FROM chars c
  GROUP BY c.word
)
SELECT sig, COUNT(*) AS anagram_count
FROM signature
GROUP BY sig
HAVING anagram_count > 1
LIMIT 20;
