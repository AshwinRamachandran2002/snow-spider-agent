         (SELECT group_concat(letter,'')
            FROM (SELECT letter
                  FROM chars c2
                  WHERE c2.word = c.word
                  ORDER BY letter) ) AS sig
  FROM chars c
  GROUP BY c.word
),
sig_sizes AS (
  SELECT sig, COUNT(*) AS anagram_count
  FROM signature
  GROUP BY sig
  HAVING anagram_count > 1         -- keep only the signatures having ≥2 words
)
SELECT s.word,
       z.anagram_count
FROM signature AS s
JOIN sig_sizes AS z
  ON s.sig = z.sig
WHERE s.word LIKE 'r%'            -- starts with 'r'
  AND length(s.word) BETWEEN 4 AND 5
ORDER BY s.word
LIMIT 20;
