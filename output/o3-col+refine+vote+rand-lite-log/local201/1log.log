-- 4. Build a character-level table for every 4–5 letter word
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
)
SELECT word, letter
FROM chars
LIMIT 20;
