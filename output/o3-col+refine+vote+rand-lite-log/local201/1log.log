FROM "word_list"
LIMIT 20;
```

```sql
-- 2. Check how many words have 4–5 characters
SELECT DISTINCT "words"
FROM "word_list"
WHERE length("words") BETWEEN 4 AND 5
LIMIT 20;
```

```sql
-- 3. Filter those 4–5 letter words that start with lowercase 'r'
SELECT DISTINCT "words"
FROM "word_list"
WHERE length("words") BETWEEN 4 AND 5
  AND "words" LIKE 'r%'
ORDER BY "words"
LIMIT 20;
```

```sql
-- 4. Build a character-level table for every 4–5 letter word
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
)
SELECT word, letter
FROM chars
LIMIT 20;
```

```sql
-- 5. Compute a canonical “sorted-letters” signature for every 4–5 letter word
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
),
signature AS (
  SELECT c.word,
         (SELECT group_concat(letter,'')
            FROM (SELECT letter
                  FROM chars c2
                  WHERE c2.word = c.word
                  ORDER BY letter) ) AS sig
  FROM chars c
  GROUP BY c.word
)
SELECT word, sig
FROM signature
LIMIT 20;
```

```sql
-- 6. Count how many words share each signature (i.e., size of each anagram set)
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
),
signature AS (
  SELECT c.word,
         (SELECT group_concat(letter,'')
            FROM (SELECT letter
                  FROM chars c2
                  WHERE c2.word = c.word
                  ORDER BY letter) ) AS sig
  FROM chars c
  GROUP BY c.word
)
SELECT sig, COUNT(*) AS anagram_count
FROM signature
GROUP BY sig
HAVING anagram_count > 1
LIMIT 20;
```

```sql
-- 7. Attach those counts back to the individual words
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
),
signature AS (
  SELECT c.word,
         (SELECT group_concat(letter,'')
            FROM (SELECT letter
                  FROM chars c2
                  WHERE c2.word = c.word
                  ORDER BY letter) ) AS sig
  FROM chars c
  GROUP BY c.word
),
sig_sizes AS (
  SELECT sig, COUNT(*) AS anagram_count
  FROM signature
  GROUP BY sig
  HAVING anagram_count > 1         -- keep only the signatures having ≥2 words
)
SELECT s.word,
       z.anagram_count
FROM signature AS s
JOIN sig_sizes AS z
  ON s.sig = z.sig
WHERE s.word LIKE 'r%'            -- starts with 'r'
  AND length(s.word) BETWEEN 4 AND 5
ORDER BY s.word
LIMIT 20;
```

```sql
-- 8. Final answer: first 10 alphabetically that meet all conditions
WITH RECURSIVE
  chars(word,pos,letter) AS (
    SELECT "words", 1, substr("words",1,1)
    FROM "word_list"
    WHERE length("words") BETWEEN 4 AND 5
    UNION ALL
    SELECT word,
           pos+1,
           substr(word,pos+1,1)
    FROM chars
    WHERE pos+1 <= length(word)
),
signature AS (
  SELECT c.word,
         (SELECT group_concat(letter,'')
            FROM (SELECT letter
                  FROM chars c2
                  WHERE c2.word = c.word
                  ORDER BY letter) ) AS sig
  FROM chars c
  GROUP BY c.word
),
sig_sizes AS (
  SELECT sig, COUNT(*) AS anagram_count
  FROM signature
  GROUP BY sig
  HAVING anagram_count > 1
),
qualified AS (
  SELECT s.word,
         z.anagram_count
  FROM signature AS s
  JOIN sig_sizes  AS z
    ON s.sig = z.sig
  WHERE s.word LIKE 'r%'
    AND length(s.word) BETWEEN 4 AND 5
)
SELECT word, anagram_count
FROM qualified
ORDER BY word          -- alphabetically
LIMIT 10;              -- first 10 words
```

The last query will return the desired list of the first 10 qualifying
words (alphabetically) together with the number of anagrams each one has.
