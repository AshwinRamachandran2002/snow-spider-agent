-- 9) Final answer – the first 10 qualifying words (alphabetical order)
WITH RECURSIVE
  split(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM   word_list
    UNION ALL
        SELECT word,
               idx + 1,
               substr(word, idx + 1, 1)
        FROM   split
        WHERE  idx + 1 <= LENGTH(word)
),
sorted_words AS (
    SELECT  w.words                             AS word,
            (SELECT group_concat(ch,'')
             FROM   (SELECT ch
                     FROM   split s2
                     WHERE  s2.word = w.words
                     ORDER  BY ch)
            )                                   AS sorted_key
    FROM   word_list AS w
    GROUP  BY w.words
),
anagram_groups AS (
    SELECT  sorted_key,
            COUNT(*) AS anagram_count
    FROM    sorted_words
    GROUP   BY sorted_key
    HAVING  COUNT(*) > 1
),
target_words AS (
    SELECT sw.word,
           ag.anagram_count
    FROM   sorted_words   AS sw
    JOIN   anagram_groups AS ag
           ON sw.sorted_key = ag.sorted_key
    WHERE  LENGTH(sw.word) BETWEEN 4 AND 5
      AND  sw.word GLOB 'r*'
)
SELECT  word,
        anagram_count
FROM    target_words
ORDER   BY word ASC
LIMIT   10;
```
