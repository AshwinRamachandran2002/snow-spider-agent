```sql
-- 1) Quick look at the raw word list
SELECT words
FROM word_list
LIMIT 20;
```

```sql
-- 2) Words that are 4-5 characters long
SELECT DISTINCT words
FROM word_list
WHERE LENGTH(words) BETWEEN 4 AND 5
LIMIT 20;
```

```sql
-- 3) 4-5 character words that start with the letter “r”
SELECT DISTINCT words
FROM word_list
WHERE LENGTH(words) BETWEEN 4 AND 5
  AND words GLOB 'r*'
LIMIT 20;
```

```sql
-- 4) RECURSIVE CTE that splits every word into individual letters
WITH RECURSIVE
  split(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM   word_list
    UNION ALL
        SELECT word,
               idx + 1,
               substr(word, idx + 1, 1)
        FROM   split
        WHERE  idx + 1 <= LENGTH(word)
)
SELECT word, ch
FROM   split
LIMIT 20;
```

```sql
-- 5) Build a “sorted-key” (letters placed in alphabetical order) for each word
WITH RECURSIVE
  split(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM   word_list
    UNION ALL
        SELECT word,
               idx + 1,
               substr(word, idx + 1, 1)
        FROM   split
        WHERE  idx + 1 <= LENGTH(word)
),
sorted_words AS (
    SELECT  w.words                             AS word,
            (SELECT group_concat(ch,'')
             FROM   (SELECT ch
                     FROM   split s2
                     WHERE  s2.word = w.words
                     ORDER  BY ch)
            )                                   AS sorted_key
    FROM   word_list AS w
    GROUP  BY w.words
)
SELECT word, sorted_key
FROM   sorted_words
LIMIT 20;
```

```sql
-- 6) Find every anagram group (same sorted_key) having more than one member
WITH RECURSIVE
  split(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM   word_list
    UNION ALL
        SELECT word,
               idx + 1,
               substr(word, idx + 1, 1)
        FROM   split
        WHERE  idx + 1 <= LENGTH(word)
),
sorted_words AS (
    SELECT  w.words                             AS word,
            (SELECT group_concat(ch,'')
             FROM   (SELECT ch
                     FROM   split s2
                     WHERE  s2.word = w.words
                     ORDER  BY ch)
            )                                   AS sorted_key
    FROM   word_list AS w
    GROUP  BY w.words
),
anagram_groups AS (
    SELECT  sorted_key,
            COUNT(*) AS anagram_count
    FROM    sorted_words
    GROUP   BY sorted_key
    HAVING  COUNT(*) > 1
)
SELECT sorted_key, anagram_count
FROM   anagram_groups
LIMIT 20;
```

```sql
-- 7) Attach the anagram-count back to every word
WITH RECURSIVE
  split(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM   word_list
    UNION ALL
        SELECT word,
               idx + 1,
               substr(word, idx + 1, 1)
        FROM   split
        WHERE  idx + 1 <= LENGTH(word)
),
sorted_words AS (
    SELECT  w.words                             AS word,
            (SELECT group_concat(ch,'')
             FROM   (SELECT ch
                     FROM   split s2
                     WHERE  s2.word = w.words
                     ORDER  BY ch)
            )                                   AS sorted_key
    FROM   word_list AS w
    GROUP  BY w.words
),
anagram_groups AS (
    SELECT  sorted_key,
            COUNT(*) AS anagram_count
    FROM    sorted_words
    GROUP   BY sorted_key
    HAVING  COUNT(*) > 1
)
SELECT sw.word,
       ag.anagram_count
FROM   sorted_words   AS sw
JOIN   anagram_groups AS ag
       ON sw.sorted_key = ag.sorted_key
LIMIT 20;
```

```sql
-- 8) Restrict to 4-5 character words that begin with “r”
WITH RECURSIVE
  split(word, idx, ch) AS (
        SELECT words, 1, substr(words,1,1)
        FROM   word_list
    UNION ALL
        SELECT word,
               idx + 1,
               substr(word, idx + 1, 1)
        FROM   split
        WHERE  idx + 1 <= LENGTH(word)
),
sorted_words AS (
    SELECT  w.words                             AS word,
            (SELECT group_concat(ch,'')
             FROM   (SELECT ch
                     FROM   split s2
                     WHERE  s2.word = w.words
                     ORDER  BY ch)
            )                                   AS sorted_key
    FROM   word_list AS w
    GROUP  BY w.words
),
anagram_groups AS (
    SELECT  sorted_key,
            COUNT(*) AS anagram_count
    FROM    sorted_words
    GROUP   BY sorted_key
    HAVING  COUNT(*) > 1
),
target_words AS (
    SELECT sw.word,
           ag.anagram_count
    FROM   sorted_words   AS sw
    JOIN   anagram_groups AS ag
           ON sw.sorted_key = ag.sorted_key
    WHERE  LENGTH(sw.word) BETWEEN 4 AND 5
      AND  sw.word GLOB 'r*'
)
SELECT *
FROM   target_words
LIMIT 20;
```

