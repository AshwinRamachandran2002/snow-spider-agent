```sql
--Description: 1️⃣ Peek at a few raw words so we know what we are dealing with
SELECT DISTINCT words
FROM word_list
LIMIT 20;
```

```sql
--Description: 2️⃣  Only the words that (a) start with “r” (b) have 4–5 letters
SELECT DISTINCT words
FROM word_list
WHERE words GLOB 'r????'            -- 5-letter words that start with r
   OR words GLOB 'r???'             -- 4-letter words that start with r
LIMIT 20;
```

```sql
--Description: 3️⃣  Recursive splitter – break every 4–5 letter word into single characters
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
)
SELECT word,pos,ch
FROM letters
LIMIT 20;
```

```sql
--Description: 4️⃣  Build a “signature” = the letters of the word sorted alphabetically
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
), ordered AS (
    SELECT word,ch
    FROM letters
    ORDER BY word,ch              -- sort letters inside each word
)
SELECT word,
       group_concat(ch,'') AS signature   -- e.g. ‘care’ → ‘acer’
FROM ordered
GROUP BY word
LIMIT 20;
```

```sql
--Description: 5️⃣  Count how many words share the same signature ( = anagrams )
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
), ordered AS (
    SELECT word,ch
    FROM letters
    ORDER BY word,ch
), sig AS (
    SELECT word,
           group_concat(ch,'') AS signature
    FROM ordered
    GROUP BY word
)
SELECT signature,
       COUNT(*) AS anagrams_count
FROM sig
GROUP BY signature
HAVING COUNT(*)>1
LIMIT 20;
```

```sql
--Description: 6️⃣  Attach the anagram counts back to each word
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
), ordered AS (
    SELECT word,ch
    FROM letters
    ORDER BY word,ch
), sig AS (
    SELECT word,
           group_concat(ch,'') AS signature
    FROM ordered
    GROUP BY word
), grp AS (
    SELECT signature,
           COUNT(*) AS anagrams_count
    FROM sig
    GROUP BY signature
    HAVING COUNT(*)>1
)
SELECT s.word,
       g.anagrams_count
FROM sig AS s
JOIN grp AS g
  ON s.signature = g.signature
LIMIT 20;
```

```sql
--Description: 7️⃣  Restrict to 4- or 5-letter words that start with “r”
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
), ordered AS (
    SELECT word,ch
    FROM letters
    ORDER BY word,ch
), sig AS (
    SELECT word,
           group_concat(ch,'') AS signature
    FROM ordered
    GROUP BY word
), grp AS (
    SELECT signature,
           COUNT(*) AS anagrams_count
    FROM sig
    GROUP BY signature
    HAVING COUNT(*)>1
)
SELECT s.word,
       g.anagrams_count
FROM sig AS s
JOIN grp AS g
  ON s.signature = g.signature
WHERE s.word GLOB 'r???'     -- 4 letters
   OR s.word GLOB 'r????'    -- 5 letters
LIMIT 20;
```

```sql
--Description: 8️⃣  FINAL ► The first 10 qualifying words (alphabetical), with their anagram count
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
), ordered AS (
    SELECT word,ch
    FROM letters
    ORDER BY word,ch
), sig AS (
    SELECT word,
           group_concat(ch,'') AS signature
    FROM ordered
    GROUP BY word
), grp AS (
    SELECT signature,
           COUNT(*) AS anagrams_count
    FROM sig
    GROUP BY signature
    HAVING COUNT(*)>1
)
SELECT s.word,
       grp.anagrams_count
FROM   sig AS s
JOIN   grp
  ON   s.signature = grp.signature
WHERE (s.word GLOB 'r???' OR s.word GLOB 'r????')   -- starts with r, length 4–5
ORDER BY s.word
LIMIT 10;
```

