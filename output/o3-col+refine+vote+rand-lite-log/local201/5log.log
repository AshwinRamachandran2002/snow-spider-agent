Query:
--Description: 6️⃣  Attach the anagram counts back to each word
WITH RECURSIVE letters(word,pos,ch) AS (
    SELECT words,1,substr(words,1,1)
    FROM word_list
    WHERE LENGTH(words) BETWEEN 4 AND 5
    UNION ALL
    SELECT word,pos+1,substr(word,pos+1,1)
    FROM letters
    WHERE pos+1<=LENGTH(word)
), ordered AS (
    SELECT word,ch
    FROM letters
    ORDER BY word,ch
), sig AS (
    SELECT word,
           group_concat(ch,'') AS signature
    FROM ordered
    GROUP BY word
), grp AS (
    SELECT signature,
           COUNT(*) AS anagrams_count
    FROM sig
    GROUP BY signature
    HAVING COUNT(*)>1
)
SELECT s.word,
       g.anagrams_count
FROM sig AS s
JOIN grp AS g
  ON s.signature = g.signature
LIMIT 20;
