--Description: Sanity-check the result set for duplicates in the final list.
WITH final8 AS (
  /*  same CTE chain as previous query but limited to 8  */
  WITH latest AS (
    SELECT
      "Name",
      "Version"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) = 1
  ),
  pkg_proj AS (
    SELECT
      l."Name"       AS "Package",
      l."Version",
      p2p."ProjectName"
    FROM latest l
    JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
      ON l."Name" = p2p."Name"
      AND l."Version" = p2p."Version"
    WHERE p2p."ProjectType" = 'GITHUB'
  ),
  stars AS (
    SELECT 
      pp."Package",
      pp."Version",
      pr."StarsCount"
    FROM pkg_proj pp
    JOIN DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS pr
      ON pr."Type" = 'GITHUB'
     AND pr."Name" = pp."ProjectName"
  )
  SELECT 
    "Package",
    "Version"
  FROM stars
  ORDER BY "StarsCount" DESC
  LIMIT 8
)
SELECT 
  "Package",
  COUNT(*) AS "Row_Count"
FROM final8
GROUP BY "Package";
