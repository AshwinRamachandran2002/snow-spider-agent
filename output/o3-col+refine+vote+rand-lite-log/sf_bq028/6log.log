```sql
--Description: Look at a few NPM rows in PACKAGEVERSIONS to understand “VersionInfo”.
SELECT 
  "Name",
  "Version",
  "VersionInfo"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
--Description: Extract “IsRelease” and “Ordinal” from “VersionInfo” for NPM rows.
SELECT 
  "Name",
  "Version",
  "VersionInfo":"IsRelease"::BOOLEAN  AS "IsRelease",
  "VersionInfo":"Ordinal"::NUMBER     AS "Ordinal"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
--Description: How many distinct NPM package versions are marked as releases?
SELECT 
  COUNT(*) AS "Release_Version_Rows"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
  AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE;
```

```sql
--Description: Pick the latest release (highest “Ordinal”) for every NPM package.
SELECT
  "Name",
  "Version",
  "VersionInfo":"Ordinal"::NUMBER AS "Ordinal"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
  AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) = 1
LIMIT 20;
```

```sql
--Description: Inspect PACKAGEVERSIONTOPROJECT to see how NPM versions map to GitHub projects.
SELECT 
  "Name",
  "Version",
  "ProjectType",
  "ProjectName"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT
WHERE "System" = 'NPM'
  AND "ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
--Description: Join latest-release NPM packages with their GitHub project(s).
WITH latest AS (
  SELECT
    "Name",
    "Version"
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) = 1
)
SELECT 
  l."Name"           AS "Package",
  l."Version",
  p2p."ProjectName"
FROM latest l
JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
  ON l."Name" = p2p."Name"
    AND l."Version" = p2p."Version"
WHERE p2p."ProjectType" = 'GITHUB'
LIMIT 20;
```

```sql
--Description: Preview GitHub projects with their star counts.
SELECT 
  "Name"        AS "ProjectName",
  "StarsCount"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS
WHERE "Type" = 'GITHUB'
ORDER BY "StarsCount" DESC
LIMIT 20;
```

```sql
--Description: Combine latest-release NPM packages with GitHub star counts.
WITH latest AS (
  SELECT
    "Name",
    "Version"
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) = 1
),
pkg_proj AS (
  SELECT
    l."Name"       AS "Package",
    l."Version",
    p2p."ProjectName"
  FROM latest l
  JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
    ON l."Name" = p2p."Name"
    AND l."Version" = p2p."Version"
  WHERE p2p."ProjectType" = 'GITHUB'
)
SELECT 
  pp."Package",
  pp."Version",
  pr."StarsCount"
FROM pkg_proj pp
JOIN DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS pr
  ON pr."Type" = 'GITHUB'
 AND pr."Name" = pp."ProjectName"
ORDER BY pr."StarsCount" DESC
LIMIT 20;
```

```sql
--Description: Show the 8 most-starred latest-release NPM packages (final step).
WITH latest AS (
  SELECT
    "Name",
    "Version"
  FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
  WHERE "System" = 'NPM'
    AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
  QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) = 1
),
pkg_proj AS (
  SELECT
    l."Name"       AS "Package",
    l."Version",
    p2p."ProjectName"
  FROM latest l
  JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
    ON l."Name" = p2p."Name"
    AND l."Version" = p2p."Version"
  WHERE p2p."ProjectType" = 'GITHUB'
),
stars AS (
  SELECT 
    pp."Package",
    pp."Version",
    pr."StarsCount"
  FROM pkg_proj pp
  JOIN DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS pr
    ON pr."Type" = 'GITHUB'
   AND pr."Name" = pp."ProjectName"
)
SELECT 
  "Package",
  "Version",
  "StarsCount"
FROM stars
ORDER BY "StarsCount" DESC
LIMIT 8;
```

```sql
--Description: Sanity-check the result set for duplicates in the final list.
WITH final8 AS (
  /*  same CTE chain as previous query but limited to 8  */
  WITH latest AS (
    SELECT
      "Name",
      "Version"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "VersionInfo":"Ordinal"::NUMBER DESC) = 1
  ),
  pkg_proj AS (
    SELECT
      l."Name"       AS "Package",
      l."Version",
      p2p."ProjectName"
    FROM latest l
    JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
      ON l."Name" = p2p."Name"
      AND l."Version" = p2p."Version"
    WHERE p2p."ProjectType" = 'GITHUB'
  ),
  stars AS (
    SELECT 
      pp."Package",
      pp."Version",
      pr."StarsCount"
    FROM pkg_proj pp
    JOIN DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS pr
      ON pr."Type" = 'GITHUB'
     AND pr."Name" = pp."ProjectName"
  )
  SELECT 
    "Package",
    "Version"
  FROM stars
  ORDER BY "StarsCount" DESC
  LIMIT 8
)
SELECT 
  "Package",
  COUNT(*) AS "Row_Count"
FROM final8
GROUP BY "Package";
```
