```sql
--Description:
-- Objective: return the 8 most-starred NPM packages (only latest official release for each
-- package) together with their versions and GitHub star counts, without duplicates.
-- Thinking process embedded as CTE comments:
--
-- 1) latest_releases  – choose the most recent SnapshotAt row for every NPM package that is
--    marked as an official release (VersionInfo.IsRelease = TRUE).
-- 2) mapped_projects  – link those releases to their GitHub repositories via
--    PACKAGEVERSIONTOPROJECT (keep only rows where ProjectType = 'GITHUB').
-- 3) latest_repo_snap – for each GitHub repo, keep the latest PROJECTS snapshot so star
--    numbers are current.
-- 4) ranked_pkgs      – join everything, assign a rank (dense) by descending StarsCount so
--    we can cut to top 8, and also use ROW_NUMBER to eliminate packages that happen to map
--    to more than one repo (pick the repo with the most stars).
-- 5) Final SELECT     – return the top 8 distinct packages.
WITH latest_releases AS (
    SELECT
        pv."Name",
        pv."Version",
        pv."SnapshotAt"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS pv
    WHERE pv."System" = 'NPM'
      AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY pv."Name" ORDER BY pv."SnapshotAt" DESC) = 1
),
mapped_projects AS (
    SELECT
        lr."Name",
        lr."Version",
        p2p."ProjectName"
    FROM latest_releases lr
    JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
         ON p2p."System" = 'NPM'
        AND p2p."Name"   = lr."Name"
        AND p2p."Version"= lr."Version"
    WHERE p2p."ProjectType" = 'GITHUB'
),
latest_repo_snap AS (
    SELECT
        pr."Name"        AS "ProjectName",
        pr."StarsCount"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS pr
    WHERE pr."Type" = 'GITHUB'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY pr."Name" ORDER BY pr."SnapshotAt" DESC) = 1
),
ranked_pkgs AS (
    SELECT
        mp."Name"          AS "PackageName",
        mp."Version",
        rs."StarsCount",
        ROW_NUMBER() OVER (PARTITION BY mp."Name" ORDER BY rs."StarsCount" DESC)      AS rn_pkg,
        DENSE_RANK() OVER (ORDER BY rs."StarsCount" DESC)                             AS dr_all
    FROM mapped_projects mp
    JOIN latest_repo_snap rs
      ON rs."ProjectName" = mp."ProjectName"
)
SELECT
    "PackageName",
    "Version",
    "StarsCount"
FROM ranked_pkgs
WHERE rn_pkg = 1            -- one repo per package (the one with most stars)
  AND dr_all <= 8           -- top 8 packages overall
ORDER BY "StarsCount" DESC;
```
