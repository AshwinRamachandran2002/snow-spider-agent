Query:
--Description: 8) Final list – top 8 most-starred NPM packages (latest release) with their star counts
WITH latest_releases AS (
    SELECT *
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
),
project_map AS (
    SELECT 
      "Name",
      "Version",
      "ProjectName"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT
    WHERE "System"      = 'NPM'
      AND "ProjectType" = 'GITHUB'
),
latest_projects AS (
    SELECT *
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS
    WHERE "Type" = 'GITHUB'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
)
SELECT 
  lr."Name"              AS "PackageName",
  lr."Version",
  lp."StarsCount"
FROM latest_releases  lr
JOIN project_map      pm  ON lr."Name" = pm."Name" AND lr."Version" = pm."Version"
JOIN latest_projects  lp  ON lp."Name" = pm."ProjectName"
ORDER BY lp."StarsCount" DESC
LIMIT 8;
