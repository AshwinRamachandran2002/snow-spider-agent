  "Name",
  "Version",
  "VersionInfo":"IsRelease"::BOOLEAN  AS "IsRelease"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
LIMIT 20;
```

```sql
--Description: 3) Show only NPM package versions that are marked as official releases
SELECT 
  "Name",
  "Version",
  "VersionInfo":"IsRelease"::BOOLEAN AS "IsRelease"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
  AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
LIMIT 20;
```

```sql
--Description: 4) For every released NPM package, pick the row with the latest snapshot
SELECT 
  "Name",
  "Version",
  "SnapshotAt"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
WHERE "System" = 'NPM'
  AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
LIMIT 20;
```

```sql
--Description: 5) Map each latest-release NPM package to its GitHub project(s)
SELECT 
  pv."Name"                       AS "PackageName",
  pv."Version",
  p2p."ProjectName",
  p2p."ProjectType"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS        pv
JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
     ON  pv."System"      = p2p."System"
     AND pv."Name"        = p2p."Name"
     AND pv."Version"     = p2p."Version"
WHERE pv."System" = 'NPM'
  AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
  AND p2p."ProjectType" = 'GITHUB'
QUALIFY ROW_NUMBER() OVER (PARTITION BY pv."Name" ORDER BY pv."SnapshotAt" DESC) = 1
LIMIT 20;
```

```sql
--Description: 6) Keep only the most recent snapshot of every GitHub project so star counts are up-to-date
SELECT 
  "Name"         AS "ProjectName",
  "StarsCount",
  "SnapshotAt"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS
WHERE "Type" = 'GITHUB'
QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
LIMIT 20;
```

```sql
--Description: 7) Join latest package releases with their GitHub star counts
WITH latest_releases AS (
    SELECT *
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
),
project_map AS (
    SELECT 
      "Name",          -- package name
      "Version",
      "ProjectName"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT
    WHERE "System" = 'NPM'
      AND "ProjectType" = 'GITHUB'
)
SELECT 
  lr."Name"       AS "PackageName",
  lr."Version",
  pj."StarsCount"
FROM latest_releases          lr
JOIN project_map              pm  ON lr."Name" = pm."Name" AND lr."Version" = pm."Version"
JOIN DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS  pj  ON pj."Name" = pm."ProjectName"
WHERE pj."Type" = 'GITHUB'
QUALIFY ROW_NUMBER() OVER (PARTITION BY lr."Name" ORDER BY pj."StarsCount" DESC) = 1
ORDER BY pj."StarsCount" DESC
LIMIT 20;
```

```sql
--Description: 8) Final list – top 8 most-starred NPM packages (latest release) with their star counts
WITH latest_releases AS (
    SELECT *
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
    WHERE "System" = 'NPM'
      AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
),
project_map AS (
    SELECT 
      "Name",
      "Version",
      "ProjectName"
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT
    WHERE "System"      = 'NPM'
      AND "ProjectType" = 'GITHUB'
),
latest_projects AS (
    SELECT *
    FROM DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS
    WHERE "Type" = 'GITHUB'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
)
SELECT 
  lr."Name"              AS "PackageName",
  lr."Version",
  lp."StarsCount"
FROM latest_releases  lr
JOIN project_map      pm  ON lr."Name" = pm."Name" AND lr."Version" = pm."Version"
JOIN latest_projects  lp  ON lp."Name" = pm."ProjectName"
ORDER BY lp."StarsCount" DESC
LIMIT 8;
```

```sql
--Description: 9) Check if any of the selected packages are mapped to multiple GitHub projects
WITH top8 AS (
    /* reuse previous CTE but cut to 8 rows */
    WITH latest_releases AS (
        SELECT *
        FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS
        WHERE "System" = 'NPM'
          AND "VersionInfo":"IsRelease"::BOOLEAN = TRUE
        QUALIFY ROW_NUMBER() OVER (PARTITION BY "Name" ORDER BY "SnapshotAt" DESC) = 1
    )
    SELECT lr."Name"
    FROM latest_releases lr
    LIMIT 8
)
SELECT 
  pm."Name"        AS "PackageName",
  COUNT(DISTINCT pm."ProjectName") AS "GitHub_Projects"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT pm
JOIN top8 t ON pm."Name" = t."Name"
WHERE pm."System" = 'NPM'
GROUP BY pm."Name"
LIMIT 20;
```

```sql
--Description: 10) Inspect the star trend for one of the top packages across snapshots
SELECT
  pr."Name"       AS "ProjectName",
  pr."StarsCount",
  pr."SnapshotAt"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PROJECTS pr
WHERE pr."Type" = 'GITHUB'
  AND pr."Name" ILIKE '%<replace_with_top_package_name>%'
ORDER BY pr."SnapshotAt" DESC
LIMIT 20;
```
