Query:
--Description: 5) Map each latest-release NPM package to its GitHub project(s)
SELECT 
  pv."Name"                       AS "PackageName",
  pv."Version",
  p2p."ProjectName",
  p2p."ProjectType"
FROM DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONS        pv
JOIN DEPS_DEV_V1.DEPS_DEV_V1.PACKAGEVERSIONTOPROJECT p2p
     ON  pv."System"      = p2p."System"
     AND pv."Name"        = p2p."Name"
     AND pv."Version"     = p2p."Version"
WHERE pv."System" = 'NPM'
  AND pv."VersionInfo":"IsRelease"::BOOLEAN = TRUE
  AND p2p."ProjectType" = 'GITHUB'
QUALIFY ROW_NUMBER() OVER (PARTITION BY pv."Name" ORDER BY pv."SnapshotAt" DESC) = 1
LIMIT 20;
