            ELSE 'Other'
        END                                                          AS page_type
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102` AS t
        CROSS JOIN UNNEST(t.event_params) AS pt
        CROSS JOIN UNNEST(t.event_params) AS pl
