--1) raw      – one row per hit (event_timestamp) where we pull page_location and
--   page_title from event_params with MAX/IF logic.
--
--2) parsed   – strip protocol from page_location and SPLIT the remainder on ‘/’
--   yielding an array “seg” (path segments).  This lets us address the 4th/5th
--   positions as required by the business rules.
--
--3) classified – apply the classification rules using SAFE_OFFSET so we never
--   under- or overflow the array (avoids the earlier “Array index -1” error).
--   • PDP  = ≥5 segments  AND last segment has ‘+’  AND category keyword in 4th/5th.
--   • PLP  = ≥5 segments  AND no ‘+’ in 4th/5th   AND category keyword in 4th/5th.
--   • otherwise OTHER.
--
--Finally we SELECT DISTINCT page_title (as page_name) with its class, order
--alphabetically, and LIMIT 20 rows per instructions.
WITH raw AS (
  SELECT
    event_timestamp,
    MAX(IF(ep.key = 'page_location', ep.value.string_value, NULL)) AS page_location,
    MAX(IF(ep.key = 'page_title',    ep.value.string_value, NULL)) AS page_title
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210102`,
       UNNEST(event_params) AS ep
  WHERE user_pseudo_id = '1402138.5184246691'
  GROUP BY event_timestamp
),
parsed AS (
  SELECT
    page_title,
    page_location,
    SPLIT(REGEXP_REPLACE(page_location, r'^https?://', ''), '/') AS seg
  FROM raw
),
classified AS (
  SELECT
    DISTINCT page_title AS page_name,
    CASE
      WHEN ARRAY_LENGTH(seg) >= 5
           AND REGEXP_CONTAINS(seg[SAFE_OFFSET(ARRAY_LENGTH(seg)-1)], r'\+')
           AND (
                REGEXP_CONTAINS(LOWER(seg[SAFE_OFFSET(3)]), r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
             OR REGEXP_CONTAINS(LOWER(seg[SAFE_OFFSET(4)]), r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
           )
        THEN 'PDP'
      WHEN ARRAY_LENGTH(seg) >= 5
           AND NOT REGEXP_CONTAINS(seg[SAFE_OFFSET(3)], r'\+')
           AND NOT REGEXP_CONTAINS(seg[SAFE_OFFSET(4)], r'\+')
           AND (
                REGEXP_CONTAINS(LOWER(seg[SAFE_OFFSET(3)]), r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
             OR REGEXP_CONTAINS(LOWER(seg[SAFE_OFFSET(4)]), r'(accessories|apparel|brands|campus\ collection|drinkware|electronics|google\ redesign|lifestyle|nest|new\ 2015\ logo|notebooks\ journals|office|shop\ by\ brand|small\ goods|stationery|wearables)')
           )
        THEN 'PLP'
      ELSE 'OTHER'
    END AS page_class
  FROM parsed
)
SELECT *
FROM classified
ORDER BY page_name
LIMIT 20;
