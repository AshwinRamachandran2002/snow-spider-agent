Query:
-- 4) Turn those components into the requested rounded fractional parts
SELECT DISTINCT "player_id",
       ROUND(ABS(CAST(substr("final_game",1,4) AS INT) - CAST(substr("debut",1,4) AS INT)), 2)                 AS "yrs",
       ROUND(ABS(CAST(substr("final_game",6,2) AS INT) - CAST(substr("debut",6,2) AS INT)) / 12.0, 2)          AS "yrs_from_months",
       ROUND(ABS(CAST(substr("final_game",9,2) AS INT) - CAST(substr("debut",9,2) AS INT)) / 365.0, 2)         AS "yrs_from_days"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
