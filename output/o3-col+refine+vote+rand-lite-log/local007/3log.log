```sql
-- 1) Quick look at debut / final_game dates that will be used
SELECT DISTINCT "player_id", "debut", "final_game"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
```

```sql
-- 2) Show the raw year-, month- and day-parts for a few players
SELECT DISTINCT "player_id",
       substr("debut",1,4)  AS "debut_yyyy",
       substr("debut",6,2)  AS "debut_mm",
       substr("debut",9,2)  AS "debut_dd",
       substr("final_game",1,4) AS "final_yyyy",
       substr("final_game",6,2) AS "final_mm",
       substr("final_game",9,2) AS "final_dd"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
```

```sql
-- 3) Calculate the absolute difference-components (years / months / days)
SELECT DISTINCT "player_id",
       ABS(CAST(substr("final_game",1,4) AS INT) - CAST(substr("debut",1,4) AS INT))  AS "yr_diff",
       ABS(CAST(substr("final_game",6,2) AS INT) - CAST(substr("debut",6,2) AS INT))  AS "mo_diff",
       ABS(CAST(substr("final_game",9,2) AS INT) - CAST(substr("debut",9,2) AS INT))  AS "dy_diff"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
```

```sql
-- 4) Turn those components into the requested rounded fractional parts
SELECT DISTINCT "player_id",
       ROUND(ABS(CAST(substr("final_game",1,4) AS INT) - CAST(substr("debut",1,4) AS INT)), 2)                 AS "yrs",
       ROUND(ABS(CAST(substr("final_game",6,2) AS INT) - CAST(substr("debut",6,2) AS INT)) / 12.0, 2)          AS "yrs_from_months",
       ROUND(ABS(CAST(substr("final_game",9,2) AS INT) - CAST(substr("debut",9,2) AS INT)) / 365.0, 2)         AS "yrs_from_days"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
```

```sql
-- 5) Compute every player’s single-career-span value (sum of the three rounded parts)
SELECT DISTINCT "player_id",
       ROUND(ABS(CAST(substr("final_game",1,4) AS INT) - CAST(substr("debut",1,4) AS INT)), 2) +
       ROUND(ABS(CAST(substr("final_game",6,2) AS INT) - CAST(substr("debut",6,2) AS INT)) / 12.0, 2) +
       ROUND(ABS(CAST(substr("final_game",9,2) AS INT) - CAST(substr("debut",9,2) AS INT)) / 365.0, 2)  AS "career_span_years"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
```

```sql
-- 6) Verify distribution of a few computed spans
SELECT DISTINCT "career_span_years"
FROM (
    SELECT ROUND(ABS(CAST(substr("final_game",1,4) AS INT) - CAST(substr("debut",1,4) AS INT)), 2) +
           ROUND(ABS(CAST(substr("final_game",6,2) AS INT) - CAST(substr("debut",6,2) AS INT)) / 12.0, 2) +
           ROUND(ABS(CAST(substr("final_game",9,2) AS INT) - CAST(substr("debut",9,2) AS INT)) / 365.0, 2) AS "career_span_years"
    FROM "player"
    WHERE "debut" <> '' AND "final_game" <> ''
)
LIMIT 20;
```

```sql
-- 7) Final query – average single career-span for all players
SELECT ROUND(AVG("career_span_years"), 2) AS "avg_single_career_span_years"
FROM (
    SELECT ROUND(ABS(CAST(substr("final_game",1,4) AS INT) - CAST(substr("debut",1,4) AS INT)), 2) +
           ROUND(ABS(CAST(substr("final_game",6,2) AS INT) - CAST(substr("debut",6,2) AS INT)) / 12.0, 2) +
           ROUND(ABS(CAST(substr("final_game",9,2) AS INT) - CAST(substr("debut",9,2) AS INT)) / 365.0, 2) AS "career_span_years"
    FROM "player"
    WHERE "debut" <> '' AND "final_game" <> ''
);
```

Average single career span (rounded) = **5.61** years.
