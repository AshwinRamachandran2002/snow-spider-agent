-- 2) Show the raw year-, month- and day-parts for a few players
SELECT DISTINCT "player_id",
       substr("debut",1,4)  AS "debut_yyyy",
       substr("debut",6,2)  AS "debut_mm",
       substr("debut",9,2)  AS "debut_dd",
       substr("final_game",1,4) AS "final_yyyy",
       substr("final_game",6,2) AS "final_mm",
       substr("final_game",9,2) AS "final_dd"
FROM "player"
WHERE "debut" <> '' AND "final_game" <> ''
LIMIT 20;
