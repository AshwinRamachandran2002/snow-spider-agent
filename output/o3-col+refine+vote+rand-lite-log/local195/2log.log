```sql
--Description: See which films were rented in a few sample rentals
SELECT DISTINCT r.rental_id,
                r.customer_id,
                i.film_id
FROM   rental    AS r
JOIN   inventory AS i ON i.inventory_id = r.inventory_id
LIMIT 20;
```

```sql
--Description: Count how many rentals each actor appears in (popularity proxy)
SELECT   fa.actor_id,
         COUNT(*) AS rental_count
FROM     film_actor AS fa
JOIN     inventory  AS i ON i.film_id      = fa.film_id
JOIN     rental     AS r ON r.inventory_id = i.inventory_id
GROUP BY fa.actor_id
ORDER BY rental_count DESC
LIMIT 20;
```

```sql
--Description: Retrieve the top five actors by total rental count
SELECT   fa.actor_id,
         COUNT(*) AS rental_count
FROM     film_actor AS fa
JOIN     inventory  AS i ON i.film_id      = fa.film_id
JOIN     rental     AS r ON r.inventory_id = i.inventory_id
GROUP BY fa.actor_id
ORDER BY rental_count DESC
LIMIT 5;
```

```sql
--Description: Show names of those top five actors
SELECT a.actor_id,
       a.first_name,
       a.last_name
FROM   actor AS a
WHERE  a.actor_id IN (SELECT fa.actor_id
                      FROM   film_actor AS fa
                      JOIN   inventory  AS i ON i.film_id      = fa.film_id
                      JOIN   rental     AS r ON r.inventory_id = i.inventory_id
                      GROUP  BY fa.actor_id
                      ORDER  BY COUNT(*) DESC
                      LIMIT 5)
LIMIT 20;
```

```sql
--Description: List customers who rented at least one film featuring the top five actors
SELECT DISTINCT r.customer_id
FROM   rental     AS r
JOIN   inventory  AS i  ON i.inventory_id = r.inventory_id
JOIN   film_actor AS fa ON fa.film_id     = i.film_id
WHERE  fa.actor_id IN (SELECT fa2.actor_id
                       FROM   film_actor AS fa2
                       JOIN   inventory  AS i2 ON i2.film_id      = fa2.film_id
                       JOIN   rental     AS r2 ON r2.inventory_id = i2.inventory_id
                       GROUP  BY fa2.actor_id
                       ORDER  BY COUNT(*) DESC
                       LIMIT 5)
LIMIT 20;
```

```sql
--Description: Count how many distinct customers rented films with any of the top five actors
SELECT COUNT(DISTINCT r.customer_id) AS customers_top5
FROM   rental     AS r
JOIN   inventory  AS i  ON i.inventory_id = r.inventory_id
JOIN   film_actor AS fa ON fa.film_id     = i.film_id
WHERE  fa.actor_id IN (SELECT fa2.actor_id
                       FROM   film_actor AS fa2
                       JOIN   inventory  AS i2 ON i2.film_id      = fa2.film_id
                       JOIN   rental     AS r2 ON r2.inventory_id = i2.inventory_id
                       GROUP  BY fa2.actor_id
                       ORDER  BY COUNT(*) DESC
                       LIMIT 5)
LIMIT 20;
```

```sql
--Description: Compute the percentage of all customers who have rented a film featuring any of the top five actors
SELECT 100.0 *
       (SELECT COUNT(DISTINCT r.customer_id)
        FROM   rental     AS r
        JOIN   inventory  AS i  ON i.inventory_id = r.inventory_id
        JOIN   film_actor AS fa ON fa.film_id     = i.film_id
        WHERE  fa.actor_id IN (SELECT fa2.actor_id
                               FROM   film_actor AS fa2
                               JOIN   inventory  AS i2 ON i2.film_id      = fa2.film_id
                               JOIN   rental     AS r2 ON r2.inventory_id = i2.inventory_id
                               GROUP  BY fa2.actor_id
                               ORDER  BY COUNT(*) DESC
                               LIMIT 5)
       ) /
       (SELECT COUNT(DISTINCT customer_id) FROM customer) AS percentage_customers_top5
LIMIT 20;
```
