Query:
--Description: How many different films each actor appears in (top-20 by film count)
SELECT fa.actor_id,
       COUNT(DISTINCT fa.film_id) AS films_total
FROM   film_actor AS fa
GROUP  BY fa.actor_id
ORDER  BY films_total DESC
LIMIT  20;
