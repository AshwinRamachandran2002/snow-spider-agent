```sql
--Description: Preview a set of actors who actually appear in films
SELECT DISTINCT a.actor_id,
       a.first_name,
       a.last_name
FROM   actor AS a
JOIN   film_actor AS fa  ON fa.actor_id = a.actor_id
LIMIT  20;
```

```sql
--Description: How many different films each actor appears in (top-20 by film count)
SELECT fa.actor_id,
       COUNT(DISTINCT fa.film_id) AS films_total
FROM   film_actor AS fa
GROUP  BY fa.actor_id
ORDER  BY films_total DESC
LIMIT  20;
```

```sql
--Description: How many rental transactions every actor is involved in (top-20)
SELECT fa.actor_id,
       COUNT(r.rental_id) AS rental_cnt
FROM   film_actor AS fa
JOIN   inventory AS i ON i.film_id     = fa.film_id
JOIN   rental    AS r ON r.inventory_id = i.inventory_id
GROUP  BY fa.actor_id
ORDER  BY rental_cnt DESC
LIMIT  20;
```

```sql
--Description: Identify our five most-rented actors
SELECT fa.actor_id,
       COUNT(r.rental_id) AS rental_cnt
FROM   film_actor AS fa
JOIN   inventory AS i ON i.film_id     = fa.film_id
JOIN   rental    AS r ON r.inventory_id = i.inventory_id
GROUP  BY fa.actor_id
ORDER  BY rental_cnt DESC
LIMIT  5;
```

```sql
--Description: Show the names of those top-five actors
SELECT a.actor_id,
       a.first_name,
       a.last_name
FROM   actor AS a
WHERE  a.actor_id IN (   /* the five IDs from previous step            */
        SELECT fa.actor_id
        FROM   film_actor AS fa
        JOIN   inventory AS i ON i.film_id     = fa.film_id
        JOIN   rental    AS r ON r.inventory_id = i.inventory_id
        GROUP  BY fa.actor_id
        ORDER  BY COUNT(r.rental_id) DESC
        LIMIT  5)
LIMIT  20;
```

```sql
--Description: List a sample of customers who rented at least one film featuring any of those five actors
SELECT DISTINCT r.customer_id
FROM   rental    AS r
JOIN   inventory AS i  ON r.inventory_id = i.inventory_id
JOIN   film_actor AS fa ON fa.film_id    = i.film_id
WHERE  fa.actor_id IN (
        SELECT fa2.actor_id
        FROM   film_actor AS fa2
        JOIN   inventory  AS i2 ON i2.film_id      = fa2.film_id
        JOIN   rental     AS r2 ON r2.inventory_id = i2.inventory_id
        GROUP  BY fa2.actor_id
        ORDER  BY COUNT(r2.rental_id) DESC
        LIMIT  5 )
LIMIT  20;
```

```sql
--Description: Total number of distinct customers who rented films with the top-five actors
SELECT COUNT(DISTINCT r.customer_id) AS customers_top5
FROM   rental    AS r
JOIN   inventory AS i  ON r.inventory_id = i.inventory_id
JOIN   film_actor AS fa ON fa.film_id    = i.film_id
WHERE  fa.actor_id IN (
        SELECT fa2.actor_id
        FROM   film_actor AS fa2
        JOIN   inventory  AS i2 ON i2.film_id      = fa2.film_id
        JOIN   rental     AS r2 ON r2.inventory_id = i2.inventory_id
        GROUP  BY fa2.actor_id
        ORDER  BY COUNT(r2.rental_id) DESC
        LIMIT  5 );
```

```sql
--Description: Total number of customers in the entire database
SELECT COUNT(*) AS total_customers
FROM   customer;
```

```sql
--Description: Final percentage of customers who have rented at least one film featuring the top-five actors
SELECT ROUND(
       100.0 * (
           SELECT COUNT(DISTINCT r.customer_id)
           FROM   rental    AS r
           JOIN   inventory AS i  ON r.inventory_id = i.inventory_id
           JOIN   film_actor AS fa ON fa.film_id    = i.film_id
           WHERE  fa.actor_id IN (
                    SELECT fa2.actor_id
                    FROM   film_actor AS fa2
                    JOIN   inventory  AS i2 ON i2.film_id      = fa2.film_id
                    JOIN   rental     AS r2 ON r2.inventory_id = i2.inventory_id
                    GROUP  BY fa2.actor_id
                    ORDER  BY COUNT(r2.rental_id) DESC
                    LIMIT  5 )
       ) / (SELECT COUNT(*) FROM customer), 2)  AS percentage_customers_top5;
```
