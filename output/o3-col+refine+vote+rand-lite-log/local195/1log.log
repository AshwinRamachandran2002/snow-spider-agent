Query:
--Description: Identify our five most-rented actors
SELECT fa.actor_id,
       COUNT(r.rental_id) AS rental_cnt
FROM   film_actor AS fa
JOIN   inventory AS i ON i.film_id     = fa.film_id
JOIN   rental    AS r ON r.inventory_id = i.inventory_id
GROUP  BY fa.actor_id
ORDER  BY rental_cnt DESC
LIMIT  5;
Answer:
actor_id,rental_cnt
107,753
181,678
198,674
144,654
102,640
Query:
--Description: Show the names of those top-five actors
SELECT a.actor_id,
       a.first_name,
       a.last_name
FROM   actor AS a
WHERE  a.actor_id IN (   /* the five IDs from previous step            */
        SELECT fa.actor_id
        FROM   film_actor AS fa
        JOIN   inventory AS i ON i.film_id     = fa.film_id
        JOIN   rental    AS r ON r.inventory_id = i.inventory_id
        GROUP  BY fa.actor_id
        ORDER  BY COUNT(r.rental_id) DESC
        LIMIT  5)
LIMIT  20;
