```sql
--Description: View a sample of actors in the database
SELECT actor_id, first_name, last_name
FROM actor
LIMIT 20;
```

```sql
--Description: Inspect the actor-film relationship
SELECT DISTINCT actor_id, film_id
FROM film_actor
LIMIT 20;
```

```sql
--Description: Preview rental records together with the related film
SELECT r.rental_id,
       r.customer_id,
       i.film_id
FROM rental AS r
JOIN inventory AS i ON r.inventory_id = i.inventory_id
LIMIT 20;
```

```sql
--Description: Compute total rental counts for every actor
SELECT fa.actor_id,
       COUNT(*) AS rental_count
FROM film_actor AS fa
JOIN inventory  AS i ON fa.film_id   = i.film_id
JOIN rental     AS r ON i.inventory_id = r.inventory_id
GROUP BY fa.actor_id
ORDER BY rental_count DESC
LIMIT 20;
```

```sql
--Description: Identify the five most-rented actors
SELECT fa.actor_id,
       a.first_name,
       a.last_name,
       COUNT(*) AS rental_count
FROM film_actor AS fa
JOIN inventory  AS i ON fa.film_id   = i.film_id
JOIN rental     AS r ON i.inventory_id = r.inventory_id
JOIN actor      AS a ON fa.actor_id  = a.actor_id
GROUP BY fa.actor_id, a.first_name, a.last_name
ORDER BY rental_count DESC
LIMIT 5;
```

```sql
--Description: List distinct customers who rented films with any of the top-five actors
WITH top_actors AS (
  SELECT fa.actor_id
  FROM film_actor AS fa
  JOIN inventory AS i ON fa.film_id = i.film_id
  JOIN rental    AS r ON i.inventory_id = r.inventory_id
  GROUP BY fa.actor_id
  ORDER BY COUNT(*) DESC
  LIMIT 5
)
SELECT DISTINCT r.customer_id
FROM rental    AS r
JOIN inventory AS i  ON r.inventory_id = i.inventory_id
JOIN film_actor AS fa ON i.film_id      = fa.film_id
JOIN top_actors AS ta ON fa.actor_id    = ta.actor_id
LIMIT 20;
```

```sql
--Description: Count customers who rented films featuring any top-five actor
WITH top_actors AS (
  SELECT fa.actor_id
  FROM film_actor AS fa
  JOIN inventory AS i ON fa.film_id = i.film_id
  JOIN rental    AS r ON i.inventory_id = r.inventory_id
  GROUP BY fa.actor_id
  ORDER BY COUNT(*) DESC
  LIMIT 5
)
SELECT COUNT(DISTINCT r.customer_id) AS customers_top_actors
FROM rental    AS r
JOIN inventory AS i  ON r.inventory_id = i.inventory_id
JOIN film_actor AS fa ON i.film_id      = fa.film_id
JOIN top_actors AS ta ON fa.actor_id    = ta.actor_id
LIMIT 20;
```

```sql
--Description: Obtain the total number of customers in the database
SELECT COUNT(*) AS total_customers
FROM customer
LIMIT 20;
```

```sql
--Description: Calculate the percentage of customers who have rented films starring the top-five actors
WITH top_actors AS (
  SELECT fa.actor_id
  FROM film_actor AS fa
  JOIN inventory AS i ON fa.film_id = i.film_id
  JOIN rental    AS r ON i.inventory_id = r.inventory_id
  GROUP BY fa.actor_id
  ORDER BY COUNT(*) DESC
  LIMIT 5
),
customers_top AS (
  SELECT DISTINCT r.customer_id
  FROM rental    AS r
  JOIN inventory AS i  ON r.inventory_id = i.inventory_id
  JOIN film_actor AS fa ON i.film_id      = fa.film_id
  JOIN top_actors AS ta ON fa.actor_id    = ta.actor_id
)
SELECT (COUNT(*) * 100.0 / (SELECT COUNT(*) FROM customer)) AS percent_customers_top_actors
FROM customers_top
LIMIT 20;
```
