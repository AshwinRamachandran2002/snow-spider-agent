Query:
--Description: Count customers who rented films featuring any top-five actor
WITH top_actors AS (
  SELECT fa.actor_id
  FROM film_actor AS fa
  JOIN inventory AS i ON fa.film_id = i.film_id
  JOIN rental    AS r ON i.inventory_id = r.inventory_id
  GROUP BY fa.actor_id
  ORDER BY COUNT(*) DESC
  LIMIT 5
)
SELECT COUNT(DISTINCT r.customer_id) AS customers_top_actors
FROM rental    AS r
JOIN inventory AS i  ON r.inventory_id = i.inventory_id
JOIN film_actor AS fa ON i.film_id      = fa.film_id
JOIN top_actors AS ta ON fa.actor_id    = ta.actor_id
LIMIT 20;
