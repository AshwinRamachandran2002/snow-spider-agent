```sql
-- Description: For every actor, count how many rentals contain at least one of his / her films (top 20 by count).
SELECT fa."actor_id",
       COUNT(r."rental_id") AS rental_count
FROM "film_actor"  AS fa
JOIN "inventory"   AS i  ON i."film_id"     = fa."film_id"
JOIN "rental"      AS r  ON r."inventory_id"= i."inventory_id"
GROUP BY fa."actor_id"
ORDER BY rental_count DESC
LIMIT 20;
```

```sql
-- Description: Identify the current TOP-5 actors by rental volume.
SELECT fa."actor_id",
       COUNT(r."rental_id") AS rental_count
FROM "film_actor"  AS fa
JOIN "inventory"   AS i  ON i."film_id"     = fa."film_id"
JOIN "rental"      AS r  ON r."inventory_id"= i."inventory_id"
GROUP BY fa."actor_id"
ORDER BY rental_count DESC
LIMIT 5;
```

```sql
-- Description: Names of those TOP-5 actors together with their rental counts.
SELECT a."actor_id",
       a."first_name",
       a."last_name",
       t.rental_count
FROM "actor" AS a
JOIN (
       SELECT fa."actor_id",
              COUNT(r."rental_id") AS rental_count
       FROM   "film_actor"  AS fa
       JOIN   "inventory"   AS i  ON i."film_id"     = fa."film_id"
       JOIN   "rental"      AS r  ON r."inventory_id"= i."inventory_id"
       GROUP  BY fa."actor_id"
       ORDER  BY rental_count DESC
       LIMIT  5
     ) AS t
     ON a."actor_id" = t."actor_id"
ORDER BY t.rental_count DESC
LIMIT 20;
```

```sql
-- Description: Distinct customers who have rented *any* film featuring those TOP-5 actors (sample 20).
SELECT DISTINCT r."customer_id"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
WHERE  fa."actor_id" IN (
         SELECT fa2."actor_id"
         FROM   "film_actor"  AS fa2
         JOIN   "inventory"   AS i2 ON i2."film_id"     = fa2."film_id"
         JOIN   "rental"      AS r2 ON r2."inventory_id"= i2."inventory_id"
         GROUP  BY fa2."actor_id"
         ORDER  BY COUNT(r2."rental_id") DESC
         LIMIT  5
       )
LIMIT 20;
```

```sql
-- Description: Total number of distinct customers who have rented films with the TOP-5 actors.
SELECT COUNT(DISTINCT r."customer_id") AS customers_top5
FROM   "rental"      AS r
JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
WHERE  fa."actor_id" IN (
         SELECT fa2."actor_id"
         FROM   "film_actor"  AS fa2
         JOIN   "inventory"   AS i2 ON i2."film_id"     = fa2."film_id"
         JOIN   "rental"      AS r2 ON r2."inventory_id"= i2."inventory_id"
         GROUP  BY fa2."actor_id"
         ORDER  BY COUNT(r2."rental_id") DESC
         LIMIT  5
       )
LIMIT 20;
```

```sql
-- Description: Total number of customers in the database.
SELECT COUNT(DISTINCT "customer_id") AS total_customers
FROM   "customer"
LIMIT 20;
```

```sql
-- Description: Compute the percentage of customers who have rented at least one film featuring the TOP-5 actors.
SELECT
  100.0 *
  ( SELECT COUNT(DISTINCT r."customer_id")
    FROM   "rental"      AS r
    JOIN   "inventory"   AS i  ON i."inventory_id" = r."inventory_id"
    JOIN   "film_actor"  AS fa ON fa."film_id"     = i."film_id"
    WHERE  fa."actor_id" IN (
             SELECT fa2."actor_id"
             FROM   "film_actor"  AS fa2
             JOIN   "inventory"   AS i2 ON i2."film_id"     = fa2."film_id"
             JOIN   "rental"      AS r2 ON r2."inventory_id"= i2."inventory_id"
             GROUP  BY fa2."actor_id"
             ORDER  BY COUNT(r2."rental_id") DESC
             LIMIT  5
           )
  ) /
  ( SELECT COUNT(DISTINCT "customer_id") FROM "customer" )
  AS percentage_of_customers
LIMIT 20;
```
