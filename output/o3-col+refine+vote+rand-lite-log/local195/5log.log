JOIN   "film_actor"  AS fa USING ("film_id")
WHERE  fa."actor_id" IN (
        SELECT fa."actor_id"
        FROM   "film_actor" AS fa
        JOIN   "inventory"  AS i USING ("film_id")
        JOIN   "rental"     AS r USING ("inventory_id")
        GROUP  BY fa."actor_id"
