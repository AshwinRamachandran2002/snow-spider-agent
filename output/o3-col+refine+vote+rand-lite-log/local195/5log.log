```sql
--Description: 1) Take a quick look at the first 20 actors in the database
SELECT DISTINCT *
FROM "actor"
LIMIT 20;
```

```sql
--Description: 2) How many rentals can be attributed to every actor?
--   (film_actor → inventory → rental)
SELECT fa."actor_id",
       COUNT(*) AS "rental_count"
FROM   "film_actor"  AS fa
JOIN   "inventory"   AS i  USING ("film_id")
JOIN   "rental"      AS r  USING ("inventory_id")
GROUP  BY fa."actor_id"
ORDER  BY "rental_count" DESC
LIMIT 20;
```

```sql
--Description: 3) Retrieve the top-5 actors (most rentals) with their names
SELECT a."actor_id",
       a."first_name",
       a."last_name",
       x."rental_count"
FROM  (
        SELECT fa."actor_id",
               COUNT(*) AS "rental_count"
        FROM   "film_actor"  AS fa
        JOIN   "inventory"   AS i  USING ("film_id")
        JOIN   "rental"      AS r  USING ("inventory_id")
        GROUP  BY fa."actor_id"
        ORDER  BY "rental_count" DESC
        LIMIT 5
      )                       AS x
JOIN  "actor"                 AS a USING ("actor_id");
```

```sql
--Description: 4) List the films in which those top-5 actors appear
SELECT DISTINCT fa."film_id",
       f."title"
FROM   "film_actor" AS fa
JOIN   "film"       AS f  USING ("film_id")
WHERE  fa."actor_id" IN (
        SELECT fa."actor_id"
        FROM   "film_actor"  AS fa
        JOIN   "inventory"   AS i USING ("film_id")
        JOIN   "rental"      AS r USING ("inventory_id")
        GROUP  BY fa."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
      )
LIMIT 20;
```

```sql
--Description: 5) Which customers have rented at least one film featuring those top-5 actors?
SELECT DISTINCT r."customer_id"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  USING ("inventory_id")
JOIN   "film_actor"  AS fa USING ("film_id")
WHERE  fa."actor_id" IN (
        SELECT fa."actor_id"
        FROM   "film_actor" AS fa
        JOIN   "inventory"  AS i USING ("film_id")
        JOIN   "rental"     AS r USING ("inventory_id")
        GROUP  BY fa."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
      )
LIMIT 20;
```

```sql
--Description: 6) Count how many distinct customers are in the group above
SELECT COUNT(DISTINCT r."customer_id") AS "customers_top5_actors"
FROM   "rental"      AS r
JOIN   "inventory"   AS i  USING ("inventory_id")
JOIN   "film_actor"  AS fa USING ("film_id")
WHERE  fa."actor_id" IN (
        SELECT fa."actor_id"
        FROM   "film_actor" AS fa
        JOIN   "inventory"  AS i USING ("film_id")
        JOIN   "rental"     AS r USING ("inventory_id")
        GROUP  BY fa."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
      );
```

```sql
--Description: 7) Total number of customers in the database
SELECT COUNT(*) AS "total_customers"
FROM   "customer";
```

```sql
--Description: 8) Final percentage: customers that have rented films with the top-5 actors
SELECT ROUND(
         100.0 *
         (
           SELECT COUNT(DISTINCT r."customer_id")
           FROM   "rental"      AS r
           JOIN   "inventory"   AS i  USING ("inventory_id")
           JOIN   "film_actor"  AS fa USING ("film_id")
           WHERE  fa."actor_id" IN (
                   SELECT fa."actor_id"
                   FROM   "film_actor" AS fa
                   JOIN   "inventory"  AS i USING ("film_id")
                   JOIN   "rental"     AS r USING ("inventory_id")
                   GROUP  BY fa."actor_id"
                   ORDER  BY COUNT(*) DESC
                   LIMIT 5
                 )
         )
         /
         (SELECT COUNT(*) FROM "customer")
       , 2)  AS "percentage_customers_top5_actors";
```

```sql
--Description: 9) (Optional sanity check) Show the distribution of rental counts of those top-5 actors
SELECT a."first_name" || ' ' || a."last_name" AS "actor_name",
       COUNT(*)                                AS "total_rentals"
FROM   "film_actor"  AS fa
JOIN   "inventory"   AS i  USING ("film_id")
JOIN   "rental"      AS r  USING ("inventory_id")
JOIN   "actor"       AS a  USING ("actor_id")
WHERE  fa."actor_id" IN (
        SELECT fa."actor_id"
        FROM   "film_actor" AS fa
        JOIN   "inventory"  AS i USING ("film_id")
        JOIN   "rental"     AS r USING ("inventory_id")
        GROUP  BY fa."actor_id"
        ORDER  BY COUNT(*) DESC
        LIMIT 5
      )
GROUP  BY fa."actor_id"
ORDER  BY "total_rentals" DESC
LIMIT 20;
```

```sql
--Description: 10) (Optional) Identify any customer who has *never* rented a film with those top-5 actors
SELECT c."customer_id",
       c."first_name",
       c."last_name"
FROM   "customer" AS c
WHERE  c."customer_id" NOT IN (
        SELECT DISTINCT r."customer_id"
