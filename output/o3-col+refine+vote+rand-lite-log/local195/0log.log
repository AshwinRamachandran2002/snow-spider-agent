```sql
--Description: 
--Thought process:
--1. The previous error (“ambiguous column name: inventory_id”) happened because both tables in the JOIN
--   (rental AS r and inventory AS i) contain a column named inventory_id.
--2. To resolve this, each reference to inventory_id must be qualified with its table alias (r. or i.).
--3. We want to: (a) list rentals (r.rental_id), (b) show the specific copy rented (r.inventory_id),
--   and (c) identify which film that copy belongs to (i.film_id).
--4. DISTINCT removes duplicates; LIMIT 20 keeps the preview short.
SELECT DISTINCT
       r.rental_id,
       r.inventory_id,
       i.film_id
FROM rental   AS r
JOIN inventory AS i
  ON r.inventory_id = i.inventory_id
LIMIT 20;
