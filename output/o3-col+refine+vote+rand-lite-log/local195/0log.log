FROM film_actor
LIMIT 20;
```

```sql
--Description: 3) See how rentals link back to films in inventory (first 20 rows).
SELECT DISTINCT rental_id, inventory_id, film_id
FROM rental  AS r
JOIN inventory AS i ON i.inventory_id = r.inventory_id
LIMIT 20;
```

```sql
--Description: 4) Count total customers so we know the denominator.
SELECT COUNT(*) AS total_customers
FROM customer
LIMIT 20;
```

```sql
--Description: 5) Number of rentals generated by every actor, ordered by popularity.
SELECT fa.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       COUNT(r.rental_id)                AS rental_count
FROM film_actor  AS fa
JOIN actor       AS a ON a.actor_id = fa.actor_id
JOIN inventory   AS i ON i.film_id = fa.film_id
JOIN rental      AS r ON r.inventory_id = i.inventory_id
GROUP BY fa.actor_id
ORDER BY rental_count DESC
LIMIT 20;
```

```sql
--Description: 6) Identify the TOP-5 actors by rental activity.
SELECT fa.actor_id,
       a.first_name || ' ' || a.last_name AS actor_name,
       COUNT(r.rental_id)                AS rental_count
FROM film_actor  AS fa
JOIN actor       AS a ON a.actor_id = fa.actor_id
JOIN inventory   AS i ON i.film_id = fa.film_id
JOIN rental      AS r ON r.inventory_id = i.inventory_id
GROUP BY fa.actor_id
ORDER BY rental_count DESC
LIMIT 5;
```

```sql
--Description: 7) List customers who have rented at least one film featuring any of those TOP-5 actors (first 20 shown).
SELECT DISTINCT r.customer_id
FROM rental      AS r
JOIN inventory   AS i  ON i.inventory_id = r.inventory_id
JOIN film_actor  AS fa ON fa.film_id      = i.film_id
WHERE fa.actor_id IN (                             -- sub-query reproduces TOP-5 list
      SELECT fa2.actor_id
      FROM film_actor  AS fa2
      JOIN inventory   AS i2 ON i2.film_id      = fa2.film_id
      JOIN rental      AS r2 ON r2.inventory_id = i2.inventory_id
      GROUP BY fa2.actor_id
      ORDER BY COUNT(r2.rental_id) DESC
      LIMIT 5)
LIMIT 20;
```

```sql
--Description: 8) FINAL – Compute the percentage of customers who have rented films featuring any of the TOP-5 actors.
WITH top_actors AS (                -- step 1: find the five most-rented actors
     SELECT fa.actor_id
     FROM film_actor  AS fa
     JOIN inventory   AS i ON i.film_id      = fa.film_id
     JOIN rental      AS r ON r.inventory_id = i.inventory_id
     GROUP BY fa.actor_id
     ORDER BY COUNT(r.rental_id) DESC
     LIMIT 5
),
customers_top5 AS (                 -- step 2: customers who rented their films
     SELECT DISTINCT r.customer_id
     FROM rental      AS r
     JOIN inventory   AS i  ON i.inventory_id = r.inventory_id
     JOIN film_actor  AS fa ON fa.film_id      = i.film_id
     WHERE fa.actor_id IN (SELECT actor_id FROM top_actors)
)
SELECT ROUND(100.0 * (SELECT COUNT(*) FROM customers_top5)
                    / (SELECT COUNT(*) FROM customer), 2) 
       AS percentage_of_customers
LIMIT 20;
```
