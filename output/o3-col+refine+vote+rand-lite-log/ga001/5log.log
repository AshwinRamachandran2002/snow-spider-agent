Query:
--Description: 8) Inspect how the leading companion products distribute by calendar day (_TABLE_SUFFIX gives the day)
WITH tee_txns AS (
  SELECT DISTINCT `ecommerce`.`transaction_id` AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`items`) AS it
  WHERE `event_name` = 'purchase'
    AND LOWER(it.`item_name`) LIKE '%google%navy%speckled%tee%'
)
SELECT _TABLE_SUFFIX                          AS day,
       i.`item_name`,
       SUM(i.`quantity`)                      AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
JOIN tee_txns
  ON e.`ecommerce`.`transaction_id` = tee_txns.txn_id
CROSS JOIN UNNEST(e.`items`) AS i
WHERE e.`event_name` = 'purchase'
  AND LOWER(i.`item_name`) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY day, i.`item_name`
ORDER BY total_qty DESC
LIMIT 20;
