```sql
--Description: 6) For those transactions, show every other individual product that was bought
WITH tee_txns AS (
  SELECT DISTINCT `ecommerce`.`transaction_id` AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`items`) AS it
  WHERE `event_name` = 'purchase'
    AND LOWER(it.`item_name`) LIKE '%google%navy%speckled%tee%'
)
SELECT tee_txns.txn_id,
       i.`item_name`,
       i.`quantity`
FROM tee_txns
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  ON e.`ecommerce`.`transaction_id` = tee_txns.txn_id
CROSS JOIN UNNEST(e.`items`) AS i
WHERE e.`event_name` = 'purchase'
LIMIT 20;
```

```sql
--Description: 7) Aggregate total quantity of every other product appearing in those transactions
WITH tee_txns AS (
  SELECT DISTINCT `ecommerce`.`transaction_id` AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`items`) AS it
  WHERE `event_name` = 'purchase'
    AND LOWER(it.`item_name`) LIKE '%google%navy%speckled%tee%'
)
SELECT i.`item_name`,
       SUM(i.`quantity`) AS total_qty
FROM tee_txns
JOIN `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
  ON e.`ecommerce`.`transaction_id` = tee_txns.txn_id
CROSS JOIN UNNEST(e.`items`) AS i
WHERE e.`event_name` = 'purchase'
  AND LOWER(i.`item_name`) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY i.`item_name`
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
--Description: 8) Inspect how the leading companion products distribute by calendar day (_TABLE_SUFFIX gives the day)
WITH tee_txns AS (
  SELECT DISTINCT `ecommerce`.`transaction_id` AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`items`) AS it
  WHERE `event_name` = 'purchase'
    AND LOWER(it.`item_name`) LIKE '%google%navy%speckled%tee%'
)
SELECT _TABLE_SUFFIX                          AS day,
       i.`item_name`,
       SUM(i.`quantity`)                      AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
JOIN tee_txns
  ON e.`ecommerce`.`transaction_id` = tee_txns.txn_id
CROSS JOIN UNNEST(e.`items`) AS i
WHERE e.`event_name` = 'purchase'
  AND LOWER(i.`item_name`) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY day, i.`item_name`
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
--Description: 9) FINAL – product with the highest total quantity bought together with Google Navy Speckled Tee in Dec-2020
WITH tee_txns AS (
  SELECT DISTINCT `ecommerce`.`transaction_id` AS txn_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
       UNNEST(`items`) AS it
  WHERE `event_name` = 'purchase'
    AND LOWER(it.`item_name`) LIKE '%google%navy%speckled%tee%'
)
SELECT i.`item_name`,
       SUM(i.`quantity`) AS total_quantity_with_tee
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*` e
JOIN tee_txns
  ON e.`ecommerce`.`transaction_id` = tee_txns.txn_id
CROSS JOIN UNNEST(e.`items`) AS i
WHERE e.`event_name` = 'purchase'
  AND LOWER(i.`item_name`) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY i.`item_name`
ORDER BY total_quantity_with_tee DESC
LIMIT 20;
```
