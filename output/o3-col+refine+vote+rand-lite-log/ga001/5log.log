  ON e.`ecommerce`.`transaction_id` = tee_txns.txn_id
CROSS JOIN UNNEST(e.`items`) AS i
WHERE e.`event_name` = 'purchase'
  AND LOWER(i.`item_name`) NOT LIKE '%google%navy%speckled%tee%'
