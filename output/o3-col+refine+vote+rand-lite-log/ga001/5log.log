Query:
--Description: 3) Find which December 2020 daily tables contain a purchase for “Google Navy Speckled Tee”
SELECT DISTINCT _TABLE_SUFFIX AS table_suffix
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202012*`,
     UNNEST(`items`) AS i
WHERE `event_name` = 'purchase'
  AND LOWER(i.`item_name`) LIKE '%google%navy%speckled%tee%'
LIMIT 20;
