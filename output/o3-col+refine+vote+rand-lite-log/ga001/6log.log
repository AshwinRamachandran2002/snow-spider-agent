```sql
--Description: 1)  List all event types that happened in December-2020 so we know
--               which event records contain the ecommerce purchases.
SELECT DISTINCT event_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX LIKE '202012%'
LIMIT 20;
```

```sql
--Description: 2)  Take a first look at the structure of the ecommerce “purchase”
--               events and the items[] array (only a handful of rows).
SELECT
  event_timestamp,
  ecommerce.transaction_id,
  items
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
LIMIT 20;
```

```sql
--Description: 3)  Find the exact spelling of the T-shirt inside the items array
--               (expecting something like *Google Navy Speckled Tee*).
SELECT DISTINCT i.item_name
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND LOWER(i.item_name) LIKE '%navy%speckled%tee%'
LIMIT 20;
```

```sql
--Description: 4)  Pull all transactions (transaction_id) in December-2020 that
--               include the “Google Navy Speckled Tee”.
SELECT DISTINCT
  ecommerce.transaction_id
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
  AND i.item_name = 'Google Navy Speckled Tee'
LIMIT 20;
```

```sql
--Description: 5)  For those same transactions, list *all* products that were
--               bought (so we can later count how many of each were added).
SELECT
  ecommerce.transaction_id,
  i.item_name,
  i.quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
  AND ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
             UNNEST(items) AS j
        WHERE _TABLE_SUFFIX LIKE '202012%'
          AND event_name = 'purchase'
          AND j.item_name = 'Google Navy Speckled Tee')
LIMIT 20;
```

```sql
--Description: 6)  Aggregate total quantities of *all* items bought **together**
--               with the Google Navy Speckled Tee (excluding the Tee itself).
SELECT
  i.item_name,
  SUM(i.quantity) AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
  AND ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
             UNNEST(items) AS j
        WHERE _TABLE_SUFFIX LIKE '202012%'
          AND event_name = 'purchase'
          AND j.item_name = 'Google Navy Speckled Tee')
  AND i.item_name <> 'Google Navy Speckled Tee'
GROUP BY i.item_name
LIMIT 20;
```

```sql
--Description: 7)  Same as #6 but ordered so that the biggest companion product
--               bubbles to the top.
SELECT
  i.item_name,
  SUM(i.quantity) AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
  AND ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
             UNNEST(items) AS j
        WHERE _TABLE_SUFFIX LIKE '202012%'
          AND event_name = 'purchase'
          AND j.item_name = 'Google Navy Speckled Tee')
  AND i.item_name <> 'Google Navy Speckled Tee'
GROUP BY i.item_name
ORDER BY total_qty DESC
LIMIT 20;
```

```sql
--Description: 8)  Return only the product with the **highest** quantity purchased
--               alongside the Navy Speckled Tee.
SELECT
  i.item_name,
  SUM(i.quantity) AS total_qty
