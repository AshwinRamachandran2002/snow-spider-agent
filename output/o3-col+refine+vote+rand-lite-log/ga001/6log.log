Query:
--Description: 5)  For those same transactions, list *all* products that were
--               bought (so we can later count how many of each were added).
SELECT
  ecommerce.transaction_id,
  i.item_name,
  i.quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
  AND ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
             UNNEST(items) AS j
        WHERE _TABLE_SUFFIX LIKE '202012%'
          AND event_name = 'purchase'
          AND j.item_name = 'Google Navy Speckled Tee')
LIMIT 20;
