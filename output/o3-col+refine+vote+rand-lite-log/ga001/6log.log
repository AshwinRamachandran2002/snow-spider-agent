        WHERE _TABLE_SUFFIX LIKE '202012%'
          AND event_name = 'purchase'
          AND j.item_name = 'Google Navy Speckled Tee')
  AND i.item_name <> 'Google Navy Speckled Tee'
GROUP BY i.item_name
ORDER BY total_quantity_with_tee DESC
LIMIT 1;
