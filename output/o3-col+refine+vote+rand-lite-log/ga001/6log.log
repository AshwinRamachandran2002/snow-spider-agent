Query:
--Description: 7)  Same as #6 but ordered so that the biggest companion product
--               bubbles to the top.
SELECT
  i.item_name,
  SUM(i.quantity) AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
     UNNEST(items) AS i
WHERE _TABLE_SUFFIX LIKE '202012%'
  AND event_name = 'purchase'
  AND ecommerce.transaction_id IN (
        SELECT DISTINCT ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
             UNNEST(items) AS j
        WHERE _TABLE_SUFFIX LIKE '202012%'
          AND event_name = 'purchase'
          AND j.item_name = 'Google Navy Speckled Tee')
  AND i.item_name <> 'Google Navy Speckled Tee'
GROUP BY i.item_name
ORDER BY total_qty DESC
LIMIT 20;
