Query:
--Description: 6) Total quantity per product bought together with the Tee
SELECT
  item.item_name,
  SUM(item.quantity) AS total_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS t
CROSS JOIN UNNEST(t.items) AS item
WHERE t._TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND t.event_name = 'purchase'
  AND t.ecommerce.transaction_id IN (
        SELECT DISTINCT sub.ecommerce.transaction_id
        FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS sub
        CROSS JOIN UNNEST(sub.items) AS i
        WHERE sub._TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
          AND sub.event_name = 'purchase'
          AND LOWER(i.item_name) LIKE '%google%navy%speckled%tee%'
  )
  AND LOWER(item.item_name) NOT LIKE '%google%navy%speckled%tee%'
GROUP BY item.item_name
ORDER BY total_qty DESC
LIMIT 20
