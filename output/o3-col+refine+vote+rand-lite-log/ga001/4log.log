Query:
--Description: 9) Count how many Tee transactions each customer generated
SELECT
  t.user_pseudo_id,
  COUNT(DISTINCT t.ecommerce.transaction_id) AS tee_txns
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS t
CROSS JOIN UNNEST(t.items) AS item
WHERE t._TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND t.event_name = 'purchase'
  AND LOWER(item.item_name) LIKE '%google%navy%speckled%tee%'
GROUP BY t.user_pseudo_id
ORDER BY tee_txns DESC
LIMIT 20
