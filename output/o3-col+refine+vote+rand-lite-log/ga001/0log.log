--Description: 8)  Top transactions (by tee quantity) to see big orders that could influence co-purchase counts.  
SELECT e.`ecommerce`.transaction_id,
       SUM(CASE WHEN i.`item_name` = 'Google Navy Speckled Tee'
                THEN i.`quantity` ELSE 0 END) AS tee_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
GROUP BY e.`ecommerce`.transaction_id
HAVING tee_qty > 0
ORDER BY tee_qty DESC
LIMIT 20;
