```sql
--Description: 1)  Look at the kinds of events that happened in December-2020.  
SELECT DISTINCT `event_name`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
LIMIT 20;
```

```sql
--Description: 2)  Make sure we spelled the tee correctly – list every item name that contains the phrase.  
SELECT DISTINCT i.`item_name`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
CROSS JOIN UNNEST(`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND LOWER(i.`item_name`) LIKE '%google%navy%speckled%tee%'
LIMIT 20;
```

```sql
--Description: 3)  Sample purchase rows that contain the “Google Navy Speckled Tee”.  
SELECT e.`event_date`,
       e.`event_timestamp`,
       e.`event_name`,
       i.`item_name`,
       i.`quantity`,
       e.`user_pseudo_id`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`  AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND i.`item_name` = 'Google Navy Speckled Tee'
LIMIT 20;
```

```sql
--Description: 4)  For every purchase that included the tee, list **all** items that were bought in the same transaction.  
SELECT e.`ecommerce`.transaction_id          AS transaction_id,
       i.`item_name`,
       i.`quantity`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`  AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND EXISTS (SELECT 1 FROM UNNEST(e.`items`) it WHERE it.item_name = 'Google Navy Speckled Tee')
LIMIT 20;
```

```sql
--Description: 5)  Aggregate the quantity of every **other** product bought together with the tee in December-2020.  
SELECT i.`item_name`,
       SUM(i.`quantity`) AS total_quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND EXISTS (SELECT 1 FROM UNNEST(e.`items`) it WHERE it.item_name = 'Google Navy Speckled Tee')
  AND i.`item_name` <> 'Google Navy Speckled Tee'
GROUP BY i.`item_name`
ORDER BY total_quantity DESC
LIMIT 20;
```

```sql
--Description: 6)  Same as #5 but keep only the single product with the highest total quantity (the answer).  
SELECT i.`item_name`,
       SUM(i.`quantity`) AS total_quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND EXISTS (SELECT 1 FROM UNNEST(e.`items`) it WHERE it.item_name = 'Google Navy Speckled Tee')
  AND i.`item_name` <> 'Google Navy Speckled Tee'
GROUP BY i.`item_name`
ORDER BY total_quantity DESC
LIMIT 1;
```

```sql
--Description: 7)  Total quantity of “Google Navy Speckled Tee” itself purchased in December-2020 (context only).  
SELECT SUM(i.`quantity`) AS tee_total_quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND i.`item_name` = 'Google Navy Speckled Tee'
LIMIT 20;
```

```sql
--Description: 8)  Top transactions (by tee quantity) to see big orders that could influence co-purchase counts.  
SELECT e.`ecommerce`.transaction_id,
       SUM(CASE WHEN i.`item_name` = 'Google Navy Speckled Tee'
                THEN i.`quantity` ELSE 0 END) AS tee_qty
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
GROUP BY e.`ecommerce`.transaction_id
HAVING tee_qty > 0
ORDER BY tee_qty DESC
LIMIT 20;
```

```sql
--Description: 9)  For the five largest “tee” transactions, list the companion items & quantities.  
SELECT e.`ecommerce`.transaction_id,
       i.`item_name`,
       i.`quantity`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND e.`ecommerce`.transaction_id IN (
        SELECT t.transaction_id
        FROM (
              SELECT e2.`ecommerce`.transaction_id,
                     SUM(CASE WHEN it.`item_name` = 'Google Navy Speckled Tee'
                              THEN it.`quantity` ELSE 0 END) AS tee_qty
              FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e2
              CROSS JOIN UNNEST(e2.`items`) AS it
              WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
                AND e2.`event_name` = 'purchase'
              GROUP BY e2.`ecommerce`.transaction_id
              HAVING tee_qty > 0
              ORDER BY tee_qty DESC
              LIMIT 5
             ) AS t
      )
LIMIT 20;
```

```sql
--Description: 10)  (Optional wrap-up) Same aggregation as #6 but also show percentage share of all companion units.  
WITH base AS (
  SELECT i.`item_name`,
         SUM(i.`quantity`) AS qty
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
  CROSS JOIN UNNEST(e.`items`) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
    AND e.`event_name` = 'purchase'
    AND EXISTS (SELECT 1 FROM UNNEST(e.`items`) it WHERE it.item_name = 'Google Navy Speckled Tee')
    AND i.`item_name` <> 'Google Navy Speckled Tee'
  GROUP BY i.`item_name`
)
SELECT `item_name`,
       qty,
       ROUND(100 * qty / SUM(qty) OVER(), 2) AS pct_of_companion_units
FROM base
ORDER BY qty DESC
LIMIT 20;
```

