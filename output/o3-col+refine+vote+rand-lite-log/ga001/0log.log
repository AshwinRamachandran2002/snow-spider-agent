Query:
--Description: 9)  For the five largest “tee” transactions, list the companion items & quantities.  
SELECT e.`ecommerce`.transaction_id,
       i.`item_name`,
       i.`quantity`
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND e.`ecommerce`.transaction_id IN (
        SELECT t.transaction_id
        FROM (
              SELECT e2.`ecommerce`.transaction_id,
                     SUM(CASE WHEN it.`item_name` = 'Google Navy Speckled Tee'
                              THEN it.`quantity` ELSE 0 END) AS tee_qty
              FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e2
              CROSS JOIN UNNEST(e2.`items`) AS it
              WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
                AND e2.`event_name` = 'purchase'
              GROUP BY e2.`ecommerce`.transaction_id
              HAVING tee_qty > 0
              ORDER BY tee_qty DESC
              LIMIT 5
             ) AS t
      )
LIMIT 20;
