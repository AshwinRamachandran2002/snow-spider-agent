--Description: 5)  Aggregate the quantity of every **other** product bought together with the tee in December-2020.  
SELECT i.`item_name`,
       SUM(i.`quantity`) AS total_quantity
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*` AS e
CROSS JOIN UNNEST(e.`items`) AS i
WHERE _TABLE_SUFFIX BETWEEN '20201201' AND '20201231'
  AND e.`event_name` = 'purchase'
  AND EXISTS (SELECT 1 FROM UNNEST(e.`items`) it WHERE it.item_name = 'Google Navy Speckled Tee')
  AND i.`item_name` <> 'Google Navy Speckled Tee'
GROUP BY i.`item_name`
ORDER BY total_quantity DESC
LIMIT 20;
