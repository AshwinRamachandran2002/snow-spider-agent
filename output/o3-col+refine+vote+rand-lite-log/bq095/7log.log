```sql
-- 1. Preview a few aggregated known–drug entries to understand the useful columns
SELECT *
FROM `open-targets-prod.platform.knownDrugsAggregated`
LIMIT 20;
```

```sql
-- 2. Check if pancreatic endocrine carcinoma (EFO_0007416) occurs in the table
SELECT DISTINCT diseaseId, label, status
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416'
LIMIT 20;
```

```sql
-- 3. List the different clinical-trial statuses recorded for that disease
SELECT DISTINCT status
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416';
```

```sql
-- 4. Inspect the “Completed” trials only, to see the target and URL structure
SELECT drugId, prefName, approvedSymbol, status, urls
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416'
  AND LOWER(status) = 'completed'
LIMIT 20;
```

```sql
-- 5. Unnest the URLs for one completed entry to verify the JSON layout
SELECT drugId,
       approvedSymbol,
       url_item.element.niceName AS source,
       url_item.element.url       AS trial_url
FROM `open-targets-prod.platform.knownDrugsAggregated`,
     UNNEST(urls.list) AS url_item
WHERE diseaseId = 'EFO_0007416'
  AND LOWER(status) = 'completed'
LIMIT 20;
```

```sql
-- 6. Quickly preview the molecule table that contains the molecular-level drug names
SELECT id, name, isApproved, maximumClinicalTrialPhase
FROM `open-targets-prod.platform.molecule`
LIMIT 20;
```

```sql
-- 7. Join the two tables for our disease to pull the molecule’s canonical name
SELECT k.drugId,
       m.name              AS molecule_name,
       k.prefName          AS pref_name_in_knownDrugs,
       k.approvedSymbol    AS target_symbol,
       k.status
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
LIMIT 20;
```

```sql
-- 8. Gather all trial links for each completed drug/target pair
SELECT k.drugId,
       k.approvedSymbol,
       url_item.element.url AS trial_url
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k,
     UNNEST(k.urls.list)   AS url_item
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
ORDER BY k.drugId
LIMIT 50;
```

```sql
-- 9. Produce the final list of distinct drugs (molecular names), targets and links
SELECT DISTINCT
       m.name                      AS drug_name,
       k.approvedSymbol            AS target_approved_symbol,
       url_item.element.url        AS clinical_trial_url
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id
LEFT JOIN UNNEST(k.urls.list) AS url_item
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
ORDER BY drug_name;
```

```sql
-- 10. (Optional) Collapse multiple URLs per drug into a semicolon-separated string
SELECT
  m.name                   AS drug_name,
  k.approvedSymbol         AS target_approved_symbol,
  STRING_AGG(url_item.element.url, '; ') AS clinical_trial_urls
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id
LEFT JOIN UNNEST(k.urls.list) AS url_item
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
GROUP BY drug_name, target_approved_symbol
ORDER BY drug_name;
```
