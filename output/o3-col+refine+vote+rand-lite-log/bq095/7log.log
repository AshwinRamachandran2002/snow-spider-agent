--               2) UNNESTs `urls.list` to expose each ClinicalTrials.gov link;  
--               3) joins to `molecule` on drugId to obtain canonical drug names;  
--               4) concatenates all URLs per drug–target pair via STRING_AGG('; ');  
--               5) returns drug_name, target_approved_symbol, and the semicolon-separated URL list.  
SELECT
  m.name                                 AS drug_name,
  k.approvedSymbol                       AS target_approved_symbol,
  STRING_AGG(url_item.element.url, '; ') AS clinical_trial_urls
FROM `bigquery-public-data.open_targets_platform.knownDrugsAggregated` AS k
