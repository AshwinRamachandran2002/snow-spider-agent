```sql
-- Description: Retrieve trials that are explicitly marked as “Completed” for EFO_0007416
SELECT drugId,
       targetId,
       approvedSymbol,
       phase,
       status,
       urls
FROM `open-targets-prod.platform.knownDrugsAggregated`
WHERE diseaseId = 'EFO_0007416'
  AND LOWER(status) = 'completed'
LIMIT 20;
```

```sql
-- Description: Join with the molecule catalogue to obtain the drug’s preferred (display) name
SELECT k.drugId,
       m.name            AS drug_name,
       k.approvedSymbol  AS target_symbol,
       k.phase,
       k.status,
       k.urls
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
LIMIT 20;
```

```sql
-- Description: Unnest the `urls` struct to list individual clinical-trial links for each completed trial
SELECT k.drugId,
       m.name            AS drug_name,
       k.approvedSymbol  AS target_symbol,
       url_struct.element.url AS clinical_trial_url
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id,
UNNEST(k.urls.list) AS url_struct
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
LIMIT 20;
```

```sql
-- Description: Same as above but keep one row per drug-trial link (distinct) and show only those with valid HTTP(S) URLs
SELECT DISTINCT
       k.drugId,
       m.name            AS drug_name,
       k.approvedSymbol  AS target_symbol,
       url_struct.element.url AS clinical_trial_url
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id,
UNNEST(k.urls.list) AS url_struct
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
  AND LOWER(url_struct.element.url) LIKE 'http%'
LIMIT 20;
```

```sql
-- Description: In case multiple completed trials exist for the same drug, aggregate links into an array
SELECT
  k.drugId,
  m.name                           AS drug_name,
  k.approvedSymbol                 AS target_symbol,
  ARRAY_AGG(url_struct.element.url) AS clinical_trial_urls
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id,
UNNEST(k.urls.list) AS url_struct
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
GROUP BY k.drugId, m.name, k.approvedSymbol
LIMIT 20;
```

```sql
-- Description: Provide a compact final list (one row per drug) ready for reporting
SELECT
  m.name                          AS drug_name,
  k.approvedSymbol                AS target_symbol,
  STRING_AGG(url_struct.element.url, '; ') AS clinical_trial_links
FROM `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN `open-targets-prod.platform.molecule`             AS m
  ON k.drugId = m.id,
UNNEST(k.urls.list) AS url_struct
WHERE k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
GROUP BY m.name, k.approvedSymbol
LIMIT 20;
```

```sql
-- Description: (Optional) Verify whether each of the returned drugs is approved (isApproved flag in molecule table)
SELECT m.id            AS drugId,
       m.name          AS drug_name,
       m.isApproved,
       m.maximumClinicalTrialPhase
FROM `open-targets-prod.platform.molecule` AS m
WHERE m.id IN (
  SELECT DISTINCT drugId
  FROM `open-targets-prod.platform.knownDrugsAggregated`
  WHERE diseaseId = 'EFO_0007416'
    AND LOWER(status) = 'completed'
)
LIMIT 20;
```
