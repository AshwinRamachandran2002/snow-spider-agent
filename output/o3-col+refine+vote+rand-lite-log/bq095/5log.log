--             literal open.  By closing the separator with '; ' we can obtain a
--             valid query.  This single statement
--               • filters `knownDrugsAggregated` for diseaseId = 'EFO_0007416'
--                 and status = 'completed' (case-insensitive via LOWER),
--               • joins to `molecule` to show a readable drug name,
--               • UNNESTs the `urls.list` array (as url_struct) to expose each
--                 clinical-trial link (`url_struct.element.url`),
--               • concatenates all URLs per drug with STRING_AGG (separator '; '),
--               • groups by drug name and target-gene symbol so each drug appears
--                 once, and
--               • limits the preview to 20 rows.

SELECT
  m.name                             AS drug_name,
  k.approvedSymbol                   AS target_gene_symbol,
  STRING_AGG(url_struct.element.url, '; ') AS clinical_trial_links
FROM `bigquery-public-data.open_targets_platform.knownDrugsAggregated` AS k
JOIN `bigquery-public-data.open_targets_platform.molecule`             AS m
  ON k.drugId = m.id
CROSS JOIN UNNEST(k.urls.list) AS url_struct
WHERE LOWER(k.diseaseId) = 'efo_0007416'
  AND LOWER(k.status)    = 'completed'
GROUP BY m.name, k.approvedSymbol
LIMIT 20;
