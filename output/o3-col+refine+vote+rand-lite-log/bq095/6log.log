--Description: Summarise COMPLETED clinical-trial evidence for pancreatic endocrine carcinoma (EFO_0007416).
--             Approach
--             1. Use `knownDrugsAggregated` (alias k) – each row ties a drug (drugId) to a target and disease,
--                with an ARRAY of supporting trial URLs (`urls.list`) and a `status`.
--             2. Filter k → diseaseId = 'EFO_0007416'  AND  LOWER(status) = 'completed' to keep only finished trials.
--             3. Join the `molecule` table (alias m) on drugId to pull the canonical drug name.
--             4. UNNEST the ARRAY `k.urls.list` (alias u) so every ClinicalTrials.gov link becomes a row.
--             5. Collapse links per drug-target pair via STRING_AGG(DISTINCT u.element.url, '; ')
--                → creates `all_clinical_trial_urls`.
--             6. GROUP BY drug_name + target_approved_symbol so each output row is a concise summary.
--             7. LIMIT 20 keeps the preview manageable.
SELECT
  m.name                                   AS drug_name,
  k.approvedSymbol                         AS target_approved_symbol,
  STRING_AGG(DISTINCT u.element.url, '; ') AS all_clinical_trial_urls
FROM
  `bigquery-public-data.open_targets_platform.knownDrugsAggregated` AS k
JOIN
  `bigquery-public-data.open_targets_platform.molecule`             AS m
    ON m.id = k.drugId,
  UNNEST(k.urls.list) AS u
WHERE
  k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
GROUP BY
  drug_name,
  target_approved_symbol
LIMIT 20;
