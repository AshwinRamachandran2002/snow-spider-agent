--Description: Produce a summary of drugs with COMPLETED trials for pancreatic endocrine carcinoma (EFO_0007416).
--             Logic & thinking:
--               • Table `knownDrugsAggregated` (alias k) contains drug-disease trial evidence.
--               • Filter on diseaseId = 'EFO_0007416' and status = 'completed' (case-insensitive).
--               • Join to `molecule` (alias m) to fetch the canonical drug name.
--               • `k.urls.list` is an ARRAY; UNNEST (alias u) exposes each trial URL.
--               • STRING_AGG(DISTINCT u.element.url, '; ') collapses all unique links into a single field.
--               • GROUP BY drug_name and target_symbol so each row represents one drug-target pair.
SELECT
  m.name                                   AS drug_name,
  k.approvedSymbol                         AS target_symbol,
  STRING_AGG(DISTINCT u.element.url, '; ') AS clinical_trial_urls
FROM
  `bigquery-public-data.open_targets_platform.knownDrugsAggregated` AS k
JOIN
  `bigquery-public-data.open_targets_platform.molecule`             AS m
    ON k.drugId = m.id,
  UNNEST(k.urls.list) AS u
WHERE
  k.diseaseId = 'EFO_0007416'          -- pancreatic endocrine carcinoma
  AND LOWER(k.status) = 'completed'    -- only completed trials
GROUP BY
  drug_name,
  target_symbol;
