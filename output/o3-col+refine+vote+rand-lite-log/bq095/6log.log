```sql
--Description: 1) Look-up the formal entry of pancreatic endocrine carcinoma in the diseases catalogue  
SELECT `id`,
       `name`,
       `description`
FROM   `open-targets-prod.platform.diseases`
WHERE  `id` = 'EFO_0007416'
LIMIT 20;
```

```sql
--Description: 2) Glance at the overall structure of the known-drug evidence table  
SELECT *
FROM   `open-targets-prod.platform.knownDrugsAggregated`
LIMIT 20;
```

```sql
--Description: 3) Verify that we indeed have drug evidence rows for the disease of interest  
SELECT DISTINCT `diseaseId`,
                `label`,
                COUNT(*) AS n_rows
FROM   `open-targets-prod.platform.knownDrugsAggregated`
WHERE  `diseaseId` = 'EFO_0007416'
GROUP  BY 1,2
LIMIT 20;
```

```sql
--Description: 4) Inspect the different clinical-trial statuses reported for this disease  
SELECT DISTINCT `status`
FROM   `open-targets-prod.platform.knownDrugsAggregated`
WHERE  `diseaseId` = 'EFO_0007416'
LIMIT 20;
```

```sql
--Description: 5) List all drug entries whose trials are **Completed** for pancreatic endocrine carcinoma  
SELECT `drugId`,
       `prefName`          AS drug_name,
       `approvedSymbol`    AS target_symbol,
       `phase`,
       `status`
FROM   `open-targets-prod.platform.knownDrugsAggregated`
WHERE  `diseaseId` = 'EFO_0007416'
  AND  LOWER(`status`) = 'completed'
LIMIT 20;
```

```sql
--Description: 6) Bring in extra molecular detail from the molecule registry for those completed drugs  
SELECT k.`drugId`,
       m.`name`            AS molecule_name,
       k.`prefName`        AS prefName_in_evidence,
       m.`drugType`,
       m.`isApproved`,
       m.`maximumClinicalTrialPhase`
FROM   `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN   `open-targets-prod.platform.molecule`            AS m
       ON k.`drugId` = m.`id`
WHERE  k.`diseaseId` = 'EFO_0007416'
  AND  LOWER(k.`status`) = 'completed'
LIMIT 20;
```

```sql
--Description: 7) Extract the individual clinical-trial links that support those completed entries  
SELECT DISTINCT k.`drugId`,
                k.`prefName`        AS drug_name,
                k.`approvedSymbol`  AS target_symbol,
                u.element.url       AS clinical_trial_url
FROM   `open-targets-prod.platform.knownDrugsAggregated` AS k,
       UNNEST(k.`urls`.list)                              AS u
WHERE  k.`diseaseId` = 'EFO_0007416'
  AND  LOWER(k.`status`) = 'completed'
LIMIT 20;
```

```sql
--Description: 8) Sometimes multiple links are reported for every entry. Count how many links each drug has  
SELECT k.`drugId`,
       k.`prefName`                       AS drug_name,
       COUNT(u.element.url)               AS n_trial_links
FROM   `open-targets-prod.platform.knownDrugsAggregated` AS k,
       UNNEST(k.`urls`.list)                              AS u
WHERE  k.`diseaseId` = 'EFO_0007416'
  AND  LOWER(k.`status`) = 'completed'
GROUP  BY 1,2
LIMIT 20;
```

```sql
--Description: 9) Produce the final requested list: drug name, target symbol, and every supporting trial URL  
SELECT DISTINCT m.`name`                 AS drug_name,
                k.`approvedSymbol`       AS target_approved_symbol,
                u.element.url            AS clinical_trial_url
FROM   `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN   `open-targets-prod.platform.molecule`            AS m
       ON k.`drugId` = m.`id`,
       UNNEST(k.`urls`.list)                              AS u
WHERE  k.`diseaseId` = 'EFO_0007416'
  AND  LOWER(k.`status`) = 'completed'
ORDER  BY drug_name
LIMIT 20;
```

```sql
--Description: 10) (Optional) If you only need one row per drug, concatenate all URLs into a single field  
SELECT m.`name`                     AS drug_name,
       k.`approvedSymbol`           AS target_approved_symbol,
       STRING_AGG(u.element.url, '; ') AS all_clinical_trial_urls
FROM   `open-targets-prod.platform.knownDrugsAggregated` AS k
JOIN   `open-targets-prod.platform.molecule`            AS m
       ON k.`drugId` = m.`id`,
       UNNEST(k.`urls`.list)                              AS u
WHERE  k.`diseaseId` = 'EFO_0007416'
  AND  LOWER(k.`status`) = 'completed'
GROUP  BY 1,2
LIMIT 20;
```
