--Description: Summarise all drugs whose trials are COMPLETED for pancreatic endocrine carcinoma (EFO_0007416).  
--             Steps thought through:  
--               1. From knownDrugsAggregated (alias k) keep rows where  
--                  ‑ diseaseId = 'EFO_0007416'  
--                  ‑ LOWER(status) = 'completed'.  
--               2. Join molecule (alias m) on drugId to obtain the canonical drug name.  
--               3. UNNEST k.urls.list (alias u) to expose every ClinicalTrials.gov link.  
--               4. STRING_AGG(DISTINCT u.element.url, '; ') concatenates all unique links  
--                  for each drug–target pair into all_clinical_trial_urls.  
--               5. GROUP BY drug_name and target_approved_symbol so each output row gives  
--                  one concise drug–target summary.  LIMIT 20 rows for preview.
SELECT
  m.name                                   AS drug_name,
  k.approvedSymbol                         AS target_approved_symbol,
  STRING_AGG(DISTINCT u.element.url, '; ') AS all_clinical_trial_urls
FROM
  `bigquery-public-data.open_targets_platform.knownDrugsAggregated` AS k
JOIN
  `bigquery-public-data.open_targets_platform.molecule`             AS m
    ON k.drugId = m.id,
  UNNEST(k.urls.list) AS u
WHERE
  k.diseaseId = 'EFO_0007416'
  AND LOWER(k.status) = 'completed'
GROUP BY
  drug_name,
  target_approved_symbol
LIMIT 20;
