Query:
-- Description: Retrieve the maximum single-season value of Games Played (g) and the players who reached it.
SELECT DISTINCT b.player_id, b.g AS max_games
FROM batting AS b
WHERE b.g = (SELECT MAX(g) FROM batting)
LIMIT 20;
