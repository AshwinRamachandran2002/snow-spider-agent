```sql
-- Description: Add the given names for the Home-Run record holders.
SELECT DISTINCT p.name_given, b.hr AS max_hr
FROM batting AS b
JOIN player AS p ON p.player_id = b.player_id
WHERE b.hr = (SELECT MAX(hr) FROM batting)
LIMIT 20;
```

```sql
-- Description: One combined query: given names of record holders for G, R, H, HR with their values.
SELECT DISTINCT p.name_given,
       CASE
           WHEN b.g  = (SELECT MAX(g)  FROM batting) THEN b.g
           WHEN b.r  = (SELECT MAX(r)  FROM batting) THEN b.r
           WHEN b.h  = (SELECT MAX(h)  FROM batting) THEN b.h
           WHEN b.hr = (SELECT MAX(hr) FROM batting) THEN b.hr
       END AS record_value,
       CASE
           WHEN b.g  = (SELECT MAX(g)  FROM batting) THEN 'Games Played'
           WHEN b.r  = (SELECT MAX(r)  FROM batting) THEN 'Runs'
           WHEN b.h  = (SELECT MAX(h)  FROM batting) THEN 'Hits'
           WHEN b.hr = (SELECT MAX(hr) FROM batting) THEN 'Home Runs'
       END AS record_type
FROM batting AS b
JOIN player  AS p ON p.player_id = b.player_id
WHERE b.g  = (SELECT MAX(g)  FROM batting)
   OR b.r  = (SELECT MAX(r)  FROM batting)
   OR b.h  = (SELECT MAX(h)  FROM batting)
   OR b.hr = (SELECT MAX(hr) FROM batting)
LIMIT 20;
```
