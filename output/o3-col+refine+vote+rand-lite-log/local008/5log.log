```sql
-- Description: Retrieve the maximum single-season value of Games Played (g) and the players who reached it.
SELECT DISTINCT b.player_id, b.g AS max_games
FROM batting AS b
WHERE b.g = (SELECT MAX(g) FROM batting)
LIMIT 20;
```

```sql
-- Description: Show each player’s given name for the Games-Played record found above.
SELECT DISTINCT p.name_given, b.g AS max_games
FROM batting AS b
JOIN player  AS p ON p.player_id = b.player_id
WHERE b.g = (SELECT MAX(g) FROM batting)
LIMIT 20;
```

```sql
-- Description: Retrieve the maximum single-season Runs (r) and the players who reached it.
