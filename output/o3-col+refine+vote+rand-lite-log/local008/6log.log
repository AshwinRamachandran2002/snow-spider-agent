```sql
--Description: Show 20 distinct player-season batting rows with games, runs, hits and home runs.
SELECT DISTINCT player_id, year, g, r, h, hr
FROM batting
LIMIT 20;
```

```sql
--Description: List (up to) the 20 seasons with the most games played so we can see where the maximum lies.
SELECT DISTINCT player_id, year, g
FROM batting
ORDER BY g DESC
LIMIT 20;
```

```sql
--Description: Retrieve the single highest value ever recorded for Games Played.
SELECT MAX(g) AS max_games
FROM batting;
```

```sql
--Description: Pull the complete player-season row(s) that match the maximum Games Played value.
SELECT DISTINCT player_id, year, g
FROM batting
WHERE g = (SELECT MAX(g) FROM batting)
LIMIT 20;
```

```sql
--Description: Attach the given name of each player who owns the Games-Played record.
SELECT DISTINCT p.name_given, b.g AS games_played
FROM batting AS b
JOIN player  AS p ON p.player_id = b.player_id
WHERE b.g = (SELECT MAX(g) FROM batting)
LIMIT 20;
```

```sql
--Description: Determine the single-season record for Runs scored.
SELECT MAX(r) AS max_runs
FROM batting;
```

```sql
--Description: Show the player(s) (with given names) who scored that record number of Runs.
SELECT DISTINCT p.name_given, b.r AS runs_scored
FROM batting AS b
JOIN player  AS p ON p.player_id = b.player_id
WHERE b.r = (SELECT MAX(r) FROM batting)
LIMIT 20;
```

```sql
--Description: Find the player(s) who logged the highest single-season Hit total.
SELECT DISTINCT p.name_given, b.h AS hits_made
FROM batting AS b
JOIN player  AS p ON p.player_id = b.player_id
WHERE b.h = (SELECT MAX(h) FROM batting)
LIMIT 20;
```

```sql
--Description: Retrieve the player(s) who hold the single-season Home-Run record.
SELECT DISTINCT p.name_given, b.hr AS home_runs
FROM batting AS b
JOIN player  AS p ON p.player_id = b.player_id
WHERE b.hr = (SELECT MAX(hr) FROM batting)
LIMIT 20;
```

```sql
--Description: Combine all four record-holding metrics (Games, Runs, Hits, HR) in one result set.
WITH
g_max AS (
  SELECT 'Games Played' AS metric, p.name_given AS player, b.g AS value
  FROM batting b JOIN player p ON p.player_id = b.player_id
  WHERE b.g = (SELECT MAX(g) FROM batting)
),
r_max AS (
  SELECT 'Runs' AS metric, p.name_given, b.r
  FROM batting b JOIN player p ON p.player_id = b.player_id
  WHERE b.r = (SELECT MAX(r) FROM batting)
),
h_max AS (
  SELECT 'Hits' AS metric, p.name_given, b.h
  FROM batting b JOIN player p ON p.player_id = b.player_id
  WHERE b.h = (SELECT MAX(h) FROM batting)
),
hr_max AS (
  SELECT 'Home Runs' AS metric, p.name_given, b.hr
  FROM batting b JOIN player p ON p.player_id = b.player_id
  WHERE b.hr = (SELECT MAX(hr) FROM batting)
)
SELECT DISTINCT metric, player, value
FROM (
  SELECT * FROM g_max
  UNION ALL
  SELECT * FROM r_max
  UNION ALL
  SELECT * FROM h_max
  UNION ALL
  SELECT * FROM hr_max
)
LIMIT 20;
```
