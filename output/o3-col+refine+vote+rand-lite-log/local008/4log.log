) AS career_games
ORDER BY total_games DESC
LIMIT 20;
```

```sql
--Description: List the 20 players with the greatest career totals for Runs.
SELECT DISTINCT player_id, total_runs
FROM (
    SELECT player_id, SUM(r) AS total_runs
    FROM batting
