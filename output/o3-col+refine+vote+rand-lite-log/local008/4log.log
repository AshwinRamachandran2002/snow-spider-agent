JOIN player     AS p ON p.player_id = c.player_id
LIMIT 20;
```

```sql
--Description: Consolidate the record holders for most career Games, Runs, Hits, and Home Runs with their given names and record values.
WITH career_totals AS (
    SELECT player_id,
           SUM(g)  AS total_games,
           SUM(r)  AS total_runs,
           SUM(h)  AS total_hits,
           SUM(hr) AS total_hr
    FROM batting
    GROUP BY player_id
),
max_vals AS (
    SELECT MAX(total_games) AS max_games,
           MAX(total_runs)  AS max_runs,
           MAX(total_hits)  AS max_hits,
           MAX(total_hr)    AS max_hr
    FROM career_totals
)
SELECT DISTINCT 'Games Played' AS metric, p.name_given, c.total_games AS record_value
FROM career_totals AS c
JOIN max_vals      AS m ON c.total_games = m.max_games
JOIN player        AS p ON p.player_id   = c.player_id
UNION ALL
SELECT DISTINCT 'Runs',       p.name_given, c.total_runs
FROM career_totals AS c
JOIN max_vals      AS m ON c.total_runs  = m.max_runs
JOIN player        AS p ON p.player_id   = c.player_id
UNION ALL
SELECT DISTINCT 'Hits',       p.name_given, c.total_hits
FROM career_totals AS c
JOIN max_vals      AS m ON c.total_hits  = m.max_hits
JOIN player        AS p ON p.player_id   = c.player_id
UNION ALL
SELECT DISTINCT 'Home Runs',  p.name_given, c.total_hr
FROM career_totals AS c
JOIN max_vals      AS m ON c.total_hr    = m.max_hr
JOIN player        AS p ON p.player_id   = c.player_id
LIMIT 20;
```
