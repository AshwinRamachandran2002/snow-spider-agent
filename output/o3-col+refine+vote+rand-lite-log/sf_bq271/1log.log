```

```sql
--Description: Join ORDERS with ORDER_ITEMS (for 2021 orders) – quick preview.
SELECT 
    oi."id"            AS "order_item_id",
    o."order_id",
    o."created_at"     AS "order_created_at",
    oi."product_id",
    oi."inventory_item_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"        o
      ON o."order_id" = oi."order_id"
WHERE o."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Confirm which ORDER_ITEMS in the above step reference INVENTORY_ITEMS that were created in 2021.
SELECT 
    oi."id"                 AS "order_item_id",
    oi."inventory_item_id",
    inv."created_at"        AS "inventory_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"   oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" inv
      ON inv."id" = oi."inventory_item_id"
WHERE inv."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Bring USERS into the picture – check that purchaser registered in 2021.
SELECT 
    u."id"          AS "user_id",
    u."country",
    u."created_at"  AS "user_created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS" u
WHERE u."created_at" BETWEEN 1609459200000000 AND 1640995199000000
LIMIT 20;
```

```sql
--Description: Combine ORDERS (2021), USERS (2021), ORDER_ITEMS, INVENTORY_ITEMS (2021) and PRODUCTS – preview with profit components.
SELECT 
    o."order_id",
    u."country",
    p."department",
    p."category",
    p."retail_price",
    p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u   ON u."id"  = o."user_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" inv  ON inv."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p    ON p."id"  = oi."product_id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995199000000  -- order in 2021
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995199000000  -- user registered 2021
  AND inv."created_at" BETWEEN 1609459200000000 AND 1640995199000000 -- inventory item created 2021
LIMIT 20;
```

```sql
--Description: FINAL – generate the requested monthly 2021 report: orders, unique purchasers, and profit, grouped by users' country, product department, and product category.
WITH base AS (
    SELECT
        o."order_id",
        o."user_id",
        u."country",
        p."department",
        p."category",
        p."retail_price",
        p."cost",
        DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"            o
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"             u   ON u."id"  = o."user_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"       oi  ON oi."order_id" = o."order_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"   inv ON inv."id" = oi."inventory_item_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"          p   ON p."id"  = oi."product_id"
    WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995199000000  -- orders in 2021
      AND u."created_at"  BETWEEN 1609459200000000 AND 1640995199000000  -- users registered 2021
      AND inv."created_at" BETWEEN 1609459200000000 AND 1640995199000000 -- inventory items created 2021
)
SELECT
    "order_month",
    "country",
    "department",
    "category",
    COUNT(DISTINCT "order_id")                AS "num_orders",
    COUNT(DISTINCT "user_id")                 AS "unique_purchasers",
    SUM("retail_price" - "cost")              AS "profit"
FROM base
GROUP BY
    "order_month",
    "country",
    "department",
    "category"
ORDER BY
    "order_month",
    "country",
    "department",
    "category"
LIMIT 20;
```
