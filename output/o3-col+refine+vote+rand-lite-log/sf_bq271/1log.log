--Description: Combine ORDERS (2021), USERS (2021), ORDER_ITEMS, INVENTORY_ITEMS (2021) and PRODUCTS – preview with profit components.
SELECT 
    o."order_id",
    u."country",
    p."department",
    p."category",
    p."retail_price",
    p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"            u   ON u."id"  = o."user_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" inv  ON inv."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p    ON p."id"  = oi."product_id"
WHERE o."created_at"  BETWEEN 1609459200000000 AND 1640995199000000  -- order in 2021
  AND u."created_at"  BETWEEN 1609459200000000 AND 1640995199000000  -- user registered 2021
  AND inv."created_at" BETWEEN 1609459200000000 AND 1640995199000000 -- inventory item created 2021
LIMIT 20;
