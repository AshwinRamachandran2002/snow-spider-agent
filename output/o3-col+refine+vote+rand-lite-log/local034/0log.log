Below is a step-by-step set of exploratory SQL statements (each limited to 20 rows) that go from very simple inspection to the final calculation you asked for.

```sql
-- 1) Distinct kinds of payment methods recorded
SELECT DISTINCT payment_type
FROM olist_order_payments
LIMIT 20;
```

```sql
-- 2) Distinct product categories appearing in the catalogue
SELECT DISTINCT product_category_name
FROM olist_products
LIMIT 20;
```

```sql
-- 3) How many payments were made with each method overall?
SELECT payment_type,
       COUNT(*) AS num_payments
FROM olist_order_payments
GROUP BY payment_type
ORDER BY num_payments DESC
LIMIT 20;
```

```sql
-- 4) Quick look: categories represented in order items
SELECT DISTINCT p.product_category_name
FROM olist_order_items  AS oi
JOIN olist_products     AS p  ON p.product_id = oi.product_id
LIMIT 20;
```

```sql
-- 5) Payments broken down by (category, payment_type)
SELECT p.product_category_name,
       op.payment_type,
       COUNT(*) AS num_payments
FROM olist_order_items      AS oi
JOIN olist_products         AS p  ON p.product_id = oi.product_id
JOIN olist_order_payments   AS op ON op.order_id   = oi.order_id
GROUP BY p.product_category_name, op.payment_type
ORDER BY p.product_category_name, num_payments DESC
LIMIT 20;
```

```sql
-- 6) Identify the MOST preferred payment method per category
SELECT product_category_name,
       payment_type,
       num_payments
FROM (
        SELECT p.product_category_name,
               op.payment_type,
               COUNT(*) AS num_payments,
               ROW_NUMBER() OVER
                 (PARTITION BY p.product_category_name
                  ORDER BY COUNT(*) DESC) AS rn
        FROM olist_order_items    AS oi
        JOIN olist_products       AS p  ON p.product_id = oi.product_id
        JOIN olist_order_payments AS op ON op.order_id  = oi.order_id
        GROUP BY p.product_category_name, op.payment_type
) sub
WHERE rn = 1
ORDER BY product_category_name
LIMIT 20;
```

```sql
-- 7) Average of the TOTAL payments made with each category’s preferred method
SELECT AVG(num_payments) AS avg_preferred_payments
FROM (
        SELECT p.product_category_name,
               op.payment_type,
               COUNT(*) AS num_payments,
               ROW_NUMBER() OVER
                 (PARTITION BY p.product_category_name
                  ORDER BY COUNT(*) DESC) AS rn
        FROM olist_order_items    AS oi
        JOIN olist_products       AS p  ON p.product_id = oi.product_id
        JOIN olist_order_payments AS op ON op.order_id  = oi.order_id
        GROUP BY p.product_category_name, op.payment_type
) sub
WHERE rn = 1
LIMIT 20;
```

```sql
-- 8) (Optional) Total number of payments per category (all methods summed)
SELECT product_category_name,
       SUM(num_payments) AS total_payments
FROM (
        SELECT p.product_category_name,
               op.payment_type,
               COUNT(*) AS num_payments
        FROM olist_order_items    AS oi
        JOIN olist_products       AS p  ON p.product_id = oi.product_id
        JOIN olist_order_payments AS op ON op.order_id  = oi.order_id
        GROUP BY p.product_category_name, op.payment_type
) sub
GROUP BY product_category_name
ORDER BY total_payments DESC
LIMIT 20;
```

```sql
-- 9) Category names together with English translation (handy for reporting)
SELECT DISTINCT p.product_category_name,
                t.product_category_name_english
FROM olist_products                       AS p
LEFT JOIN product_category_name_translation AS t
       ON t.product_category_name = p.product_category_name
LIMIT 20;
```

These queries progressively reveal the data you need and culminate in statement 7, which returns the requested metric:  

