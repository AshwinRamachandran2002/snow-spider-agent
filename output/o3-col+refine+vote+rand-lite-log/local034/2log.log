```sql
-- Description: Confirm the link between orders and their product categories.
SELECT oi."order_id",
       p."product_category_name"
FROM "olist_order_items"        AS oi
JOIN "olist_products"           AS p ON oi."product_id" = p."product_id"
LIMIT 20;
```

```sql
-- Description: Bring together category and payment-method information for each order.
SELECT p."product_category_name",
       op."payment_type"
FROM "olist_order_items"        AS oi
JOIN "olist_products"           AS p  ON oi."product_id" = p."product_id"
JOIN "olist_order_payments"     AS op ON oi."order_id"   = op."order_id"
LIMIT 20;
```

```sql
-- Description: Count how many payments of every type occur inside every category.
SELECT p."product_category_name",
       op."payment_type",
       COUNT(*) AS "num_payments"
FROM "olist_order_items"        AS oi
JOIN "olist_products"           AS p  ON oi."product_id" = p."product_id"
JOIN "olist_order_payments"     AS op ON oi."order_id"   = op."order_id"
GROUP BY p."product_category_name", op."payment_type"
LIMIT 20;
```

```sql
-- Description: Use a window function to tag the top (most-used) payment method in each category.
SELECT *
FROM (
    SELECT p."product_category_name",
           op."payment_type",
           COUNT(*) AS "num_payments",
           ROW_NUMBER() OVER (PARTITION BY p."product_category_name"
                              ORDER BY COUNT(*) DESC) AS "rn"
    FROM "olist_order_items"    AS oi
    JOIN "olist_products"       AS p  ON oi."product_id" = p."product_id"
    JOIN "olist_order_payments" AS op ON oi."order_id"   = op."order_id"
    GROUP BY p."product_category_name", op."payment_type"
) sub
WHERE "rn" = 1
LIMIT 20;
```

```sql
-- Description: Retrieve the total number of payments made with the preferred method for each category.
SELECT "product_category_name",
       "num_payments"
FROM (
    SELECT p."product_category_name",
           op."payment_type",
           COUNT(*) AS "num_payments",
           ROW_NUMBER() OVER (PARTITION BY p."product_category_name"
                              ORDER BY COUNT(*) DESC) AS "rn"
    FROM "olist_order_items"    AS oi
    JOIN "olist_products"       AS p  ON oi."product_id" = p."product_id"
    JOIN "olist_order_payments" AS op ON oi."order_id"   = op."order_id"
    GROUP BY p."product_category_name", op."payment_type"
) sub
WHERE "rn" = 1
LIMIT 20;
```

```sql
-- Description: Calculate the average of those totals across all categories (final required metric).
SELECT AVG("num_payments") AS "avg_total_payments_of_top_method"
FROM (
    SELECT p."product_category_name",
           op."payment_type",
           COUNT(*) AS "num_payments",
           ROW_NUMBER() OVER (PARTITION BY p."product_category_name"
                              ORDER BY COUNT(*) DESC) AS "rn"
    FROM "olist_order_items"    AS oi
    JOIN "olist_products"       AS p  ON oi."product_id" = p."product_id"
    JOIN "olist_order_payments" AS op ON oi."order_id"   = op."order_id"
    GROUP BY p."product_category_name", op."payment_type"
) sub
WHERE "rn" = 1;
```
