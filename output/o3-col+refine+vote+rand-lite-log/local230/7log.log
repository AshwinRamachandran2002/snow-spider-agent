Query:
-- Description: Count how many qualifying >8-rated movies each director has within the top-3 genres
SELECT dm."name_id", COUNT(DISTINCT dm."movie_id") AS "dir_movie_count"
FROM "director_mapping" AS dm
WHERE dm."movie_id" IN (
        SELECT DISTINCT g."movie_id"
        FROM "ratings" AS r
        JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
        WHERE r."avg_rating" > 8
          AND g."genre" IN (
                SELECT g2."genre"
                FROM "ratings" AS r2
                JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
                WHERE r2."avg_rating" > 8
                GROUP BY g2."genre"
                ORDER BY COUNT(DISTINCT g2."movie_id") DESC
                LIMIT 3
          )
)
GROUP BY dm."name_id"
ORDER BY "dir_movie_count" DESC
LIMIT 20;
