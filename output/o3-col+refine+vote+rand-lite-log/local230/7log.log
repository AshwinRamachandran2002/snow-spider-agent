```sql
-- Description: Look at a sample of movies whose average rating is strictly above 8.0
SELECT DISTINCT r."movie_id", r."avg_rating" 
FROM "ratings" AS r
WHERE r."avg_rating" > 8
LIMIT 20;
```

```sql
-- Description: Inspect which genres those highly-rated movies belong to (one row per movie/genre pair)
SELECT DISTINCT r."movie_id", g."genre"
FROM "ratings"  AS r
JOIN "genre"    AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8
LIMIT 20;
```

```sql
-- Description: Count how many >8-rated movies each genre has, to spot the most common ones
SELECT g."genre", COUNT(DISTINCT g."movie_id") AS "high_rated_movies"
FROM "ratings" AS r
JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8
GROUP BY g."genre"
ORDER BY "high_rated_movies" DESC
LIMIT 20;
```

```sql
-- Description: Retrieve the (tentative) top-3 genres by movie count (>8 rating) for later filtering
SELECT g."genre"
FROM "ratings" AS r
JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8
GROUP BY g."genre"
ORDER BY COUNT(DISTINCT g."movie_id") DESC
LIMIT 3;
```

```sql
-- Description: List all movie IDs that (a) are rated >8 and (b) lie in ANY of the top-3 genres identified above
SELECT DISTINCT g."movie_id"
FROM "ratings" AS r
JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8
  AND g."genre" IN (
        SELECT g2."genre"
        FROM "ratings" AS r2
        JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
        WHERE r2."avg_rating" > 8
        GROUP BY g2."genre"
        ORDER BY COUNT(DISTINCT g2."movie_id") DESC
        LIMIT 3
  )
LIMIT 20;
```

```sql
-- Description: Map those filtered movies to their directors
SELECT DISTINCT dm."name_id", dm."movie_id"
FROM "director_mapping" AS dm
WHERE dm."movie_id" IN (
        SELECT DISTINCT g."movie_id"
        FROM "ratings" AS r
        JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
        WHERE r."avg_rating" > 8
          AND g."genre" IN (
                SELECT g2."genre"
                FROM "ratings" AS r2
                JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
                WHERE r2."avg_rating" > 8
                GROUP BY g2."genre"
                ORDER BY COUNT(DISTINCT g2."movie_id") DESC
                LIMIT 3
          )
)
LIMIT 20;
```

```sql
-- Description: Count how many qualifying >8-rated movies each director has within the top-3 genres
SELECT dm."name_id", COUNT(DISTINCT dm."movie_id") AS "dir_movie_count"
FROM "director_mapping" AS dm
WHERE dm."movie_id" IN (
        SELECT DISTINCT g."movie_id"
        FROM "ratings" AS r
        JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
        WHERE r."avg_rating" > 8
          AND g."genre" IN (
                SELECT g2."genre"
                FROM "ratings" AS r2
                JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
                WHERE r2."avg_rating" > 8
                GROUP BY g2."genre"
                ORDER BY COUNT(DISTINCT g2."movie_id") DESC
                LIMIT 3
          )
)
GROUP BY dm."name_id"
ORDER BY "dir_movie_count" DESC
LIMIT 20;
```

```sql
-- Description: Pick the top-4 directors (name-ids) with the highest counts from the previous result
SELECT dm."name_id"
FROM "director_mapping" AS dm
WHERE dm."name_id" IN (
        SELECT dm2."name_id"
        FROM "director_mapping" AS dm2
        WHERE dm2."movie_id" IN (
                SELECT DISTINCT g."movie_id"
                FROM "ratings" AS r
                JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
                WHERE r."avg_rating" > 8
                  AND g."genre" IN (
                        SELECT g2."genre"
                        FROM "ratings" AS r2
                        JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
                        WHERE r2."avg_rating" > 8
                        GROUP BY g2."genre"
                        ORDER BY COUNT(DISTINCT g2."movie_id") DESC
                        LIMIT 3
                  )
        )
        GROUP BY dm2."name_id"
        ORDER BY COUNT(DISTINCT dm2."movie_id") DESC
        LIMIT 4
)
LIMIT 20;
```

```sql
-- Description: Display those top-4 directors with their human-readable names and the number of >8 films they directed in the top-3 genres
SELECT n."name", x."dir_movie_count"
FROM (
        SELECT dm."name_id", COUNT(DISTINCT dm."movie_id") AS "dir_movie_count"
        FROM "director_mapping" AS dm
        WHERE dm."movie_id" IN (
                SELECT DISTINCT g."movie_id"
                FROM "ratings" AS r
                JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
                WHERE r."avg_rating" > 8
                  AND g."genre" IN (
                        SELECT g2."genre"
                        FROM "ratings" AS r2
                        JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
                        WHERE r2."avg_rating" > 8
                        GROUP BY g2."genre"
                        ORDER BY COUNT(DISTINCT g2."movie_id") DESC
                        LIMIT 3
                  )
        )
        GROUP BY dm."name_id"
        ORDER BY "dir_movie_count" DESC
        LIMIT 4
) AS x
JOIN "names" AS n ON n."id" = x."name_id"
ORDER BY x."dir_movie_count" DESC
LIMIT 20;
