-- Description: Pick the top-4 directors (name-ids) with the highest counts from the previous result
SELECT dm."name_id"
FROM "director_mapping" AS dm
WHERE dm."name_id" IN (
        SELECT dm2."name_id"
        FROM "director_mapping" AS dm2
        WHERE dm2."movie_id" IN (
                SELECT DISTINCT g."movie_id"
                FROM "ratings" AS r
                JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
                WHERE r."avg_rating" > 8
                  AND g."genre" IN (
                        SELECT g2."genre"
                        FROM "ratings" AS r2
                        JOIN "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
                        WHERE r2."avg_rating" > 8
                        GROUP BY g2."genre"
                        ORDER BY COUNT(DISTINCT g2."movie_id") DESC
                        LIMIT 3
                  )
        )
        GROUP BY dm2."name_id"
        ORDER BY COUNT(DISTINCT dm2."movie_id") DESC
