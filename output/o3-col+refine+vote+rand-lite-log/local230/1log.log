Query:
-- Description: Count how many movies (rated > 8) belong to each genre; order by that count (highest first).
SELECT g."genre",
       COUNT(DISTINCT g."movie_id") AS "high_rated_movie_cnt"
FROM   "genre"   AS g
JOIN   "ratings" AS r
  ON   g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY "high_rated_movie_cnt" DESC
LIMIT 20;
