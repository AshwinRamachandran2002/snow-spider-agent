```sql
-- Description: List every movie whose avg_rating is strictly above 8.0.
SELECT DISTINCT r."movie_id"
FROM "ratings" AS r
WHERE r."avg_rating" > 8
LIMIT 20;
```

```sql
-- Description: Count how many movies (rated > 8) belong to each genre; order by that count (highest first).
SELECT g."genre",
       COUNT(DISTINCT g."movie_id") AS "high_rated_movie_cnt"
FROM   "genre"   AS g
JOIN   "ratings" AS r
  ON   g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY "high_rated_movie_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Show just the top-3 genres with the most movies rated > 8.
SELECT g."genre",
       COUNT(DISTINCT g."movie_id") AS "high_rated_movie_cnt"
FROM   "genre"   AS g
JOIN   "ratings" AS r
  ON   g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY "high_rated_movie_cnt" DESC
LIMIT 3;
```

```sql
-- Description: Inspect how directors map to movie_id in the director_mapping table.
SELECT DISTINCT "movie_id", "name_id"
FROM   "director_mapping"
LIMIT 20;
```

```sql
-- Description: Join top-3 genres (derived in the sub-query) with director_mapping, keeping only movies rated > 8.
SELECT dm."name_id", dm."movie_id", g."genre"
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
           SELECT g2."genre"
           FROM   "genre"   AS g2
           JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
           WHERE  r2."avg_rating" > 8
           GROUP  BY g2."genre"
           ORDER  BY COUNT(DISTINCT g2."movie_id") DESC
           LIMIT 3
       )
LIMIT 20;
```

```sql
-- Description: Count, for each director (name_id), how many high-rated (> 8) movies they directed in those top-3 genres.
SELECT dm."name_id",
       COUNT(DISTINCT dm."movie_id") AS "high_rated_movie_cnt"
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
           SELECT g2."genre"
           FROM   "genre"   AS g2
           JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
           WHERE  r2."avg_rating" > 8
           GROUP  BY g2."genre"
           ORDER  BY COUNT(DISTINCT g2."movie_id") DESC
           LIMIT 3
       )
GROUP  BY dm."name_id"
ORDER  BY "high_rated_movie_cnt" DESC
LIMIT 20;
```

```sql
-- Description: Final answer – list the top-4 directors (by actual name) who have the most movies rated > 8 in those top-3 genres, with their counts.
SELECT n."name"          AS "director_name",
       x."high_rated_movie_cnt"
FROM (
    SELECT dm."name_id",
           COUNT(DISTINCT dm."movie_id") AS "high_rated_movie_cnt"
    FROM   "director_mapping" AS dm
    JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
    JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
    WHERE  r."avg_rating" > 8
      AND  g."genre" IN (  -- top-3 genres sub-query
              SELECT g2."genre"
              FROM   "genre"   AS g2
              JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
              WHERE  r2."avg_rating" > 8
              GROUP  BY g2."genre"
              ORDER  BY COUNT(DISTINCT g2."movie_id") DESC
              LIMIT 3
          )
    GROUP  BY dm."name_id"
    ORDER  BY "high_rated_movie_cnt" DESC
    LIMIT 4                      -- keep the top-4 directors
) AS x
JOIN "names" AS n ON n."id" = x."name_id";
```

These queries progress from inspecting the basic data to producing the final set of directors with their respective counts of movies rated above 8 within the three most-represented genres.
