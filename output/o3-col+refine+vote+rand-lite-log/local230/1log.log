Query:
-- Description: Count, for each director (name_id), how many high-rated (> 8) movies they directed in those top-3 genres.
SELECT dm."name_id",
       COUNT(DISTINCT dm."movie_id") AS "high_rated_movie_cnt"
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
           SELECT g2."genre"
           FROM   "genre"   AS g2
           JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
           WHERE  r2."avg_rating" > 8
           GROUP  BY g2."genre"
           ORDER  BY COUNT(DISTINCT g2."movie_id") DESC
           LIMIT 3
       )
GROUP  BY dm."name_id"
ORDER  BY "high_rated_movie_cnt" DESC
LIMIT 20;
