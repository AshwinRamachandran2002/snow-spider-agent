```sql
--Description: Inspect a few rows of the ratings table to see rating values. 
SELECT DISTINCT * 
FROM "ratings" 
LIMIT 20;
```

```sql
--Description: List movies whose average rating is strictly above 8.0.  
SELECT DISTINCT "movie_id", "avg_rating" 
FROM "ratings" 
WHERE "avg_rating" > 8.0 
LIMIT 20;
```

```sql
--Description: Join movies rated >8 with their genres to see what genres appear. 
SELECT DISTINCT r."movie_id", g."genre", r."avg_rating" 
FROM "ratings"  AS r
JOIN "genre"    AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8.0 
LIMIT 20;
```

```sql
--Description: Count how many >8-rated movies each genre has and order the genres by that count. 
SELECT g."genre", COUNT(*) AS "high_rated_movies" 
FROM "ratings" AS r
JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8.0
GROUP BY g."genre"
ORDER BY "high_rated_movies" DESC
LIMIT 20;
```

```sql
--Description: Retrieve the TOP 3 genres that contain the most movies rated above 8. 
SELECT g."genre"
FROM "ratings" AS r
JOIN "genre"   AS g ON g."movie_id" = r."movie_id"
WHERE r."avg_rating" > 8.0
GROUP BY g."genre"
ORDER BY COUNT(*) DESC
LIMIT 3;
```

```sql
--Description: Show director–movie pairs where the movie is rated >8 (unfiltered by genre yet). 
SELECT DISTINCT dm."name_id", dm."movie_id"
FROM "director_mapping" AS dm
JOIN "ratings"          AS r  ON r."movie_id"  = dm."movie_id"
WHERE r."avg_rating" > 8.0
LIMIT 20;
```

```sql
--Description: Add the genres and keep only records whose genre is one of the TOP-3 (via sub-query). 
SELECT DISTINCT dm."name_id", dm."movie_id", g."genre"
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r ON r."movie_id" = dm."movie_id"
JOIN   "genre"            AS g ON g."movie_id" = dm."movie_id"
WHERE  r."avg_rating" > 8.0
  AND  g."genre" IN (                             -- top-3 genres
        SELECT g2."genre"
        FROM   "ratings" AS r2
        JOIN   "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
        WHERE  r2."avg_rating" > 8.0
        GROUP  BY g2."genre"
        ORDER  BY COUNT(*) DESC
        LIMIT 3
      )
LIMIT 20;
```

```sql
--Description: Join director IDs with their real names for context. 
SELECT DISTINCT n."name", gdt."movie_id"
FROM (
        SELECT dm."name_id", dm."movie_id"
        FROM   "director_mapping" AS dm
        JOIN   "ratings"          AS r ON r."movie_id" = dm."movie_id"
        WHERE  r."avg_rating" > 8.0
     ) AS gdt
JOIN "names" AS n ON n."id" = gdt."name_id"
LIMIT 20;
```

```sql
--Description: Count, for each director, how many >8 movies exist within the TOP-3 genres. 
SELECT n."name"               AS "director_name",
       COUNT(DISTINCT dm."movie_id") AS "high_rated_movies_in_top_genres"
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r  ON r."movie_id" = dm."movie_id"
JOIN   "genre"            AS g  ON g."movie_id" = dm."movie_id"
JOIN   "names"            AS n  ON n."id"       = dm."name_id"
WHERE  r."avg_rating" > 8.0
  AND  g."genre" IN (
        SELECT g2."genre"
        FROM   "ratings" AS r2
        JOIN   "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
        WHERE  r2."avg_rating" > 8.0
        GROUP  BY g2."genre"
        ORDER  BY COUNT(*) DESC
        LIMIT 3
      )
GROUP BY n."name"
ORDER BY "high_rated_movies_in_top_genres" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – select the TOP 4 directors who directed the most films rated >8 within the TOP-3 genres. 
SELECT n."name"               AS "director_name",
       COUNT(DISTINCT dm."movie_id") AS "movies_above_8_in_top_genres"
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r  ON r."movie_id" = dm."movie_id"
JOIN   "genre"            AS g  ON g."movie_id" = dm."movie_id"
JOIN   "names"            AS n  ON n."id"       = dm."name_id"
WHERE  r."avg_rating" > 8.0
  AND  g."genre" IN (                                  -- 3 most common genres
        SELECT g2."genre"
        FROM   "ratings" AS r2
        JOIN   "genre"   AS g2 ON g2."movie_id" = r2."movie_id"
        WHERE  r2."avg_rating" > 8.0
        GROUP  BY g2."genre"
        ORDER  BY COUNT(*) DESC
        LIMIT 3
      )
GROUP BY n."name"
ORDER BY "movies_above_8_in_top_genres" DESC
LIMIT 4;
```
