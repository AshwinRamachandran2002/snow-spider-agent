WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY high_rated_movies DESC
LIMIT 20;
```

```sql
-- 4) Retrieve the TOP-3 genres with the most movies that are rated above 8
SELECT g."genre",
       COUNT(*) AS high_rated_movies
FROM   "genre" AS g
JOIN   "ratings" AS r
       ON g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY high_rated_movies DESC
LIMIT 3;
```

```sql
-- 5) Verify which movie IDs belong to those TOP-3 genres and are rated > 8
/* (Replace 'GenreA','GenreB','GenreC' with the three genres returned by query 4) */
SELECT g."movie_id",
       g."genre",
       r."avg_rating"
FROM   "genre"   AS g
JOIN   "ratings" AS r
       ON g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN ('GenreA','GenreB','GenreC')
LIMIT 20;
```

```sql
-- 6) Bring directors into the mix for those movies
SELECT dm."movie_id",
       dm."name_id",
       g."genre"
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN ('GenreA','GenreB','GenreC')
LIMIT 20;
```

```sql
-- 7) Count how many >8-rated movies in the TOP-3 genres each director has made
SELECT dm."name_id",
       COUNT(DISTINCT dm."movie_id") AS high_rated_movies
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN ('GenreA','GenreB','GenreC')
GROUP  BY dm."name_id"
ORDER  BY high_rated_movies DESC
LIMIT 20;
```

```sql
-- 8) Retrieve the TOP-4 directors with the most such movies
SELECT dm."name_id",
       COUNT(DISTINCT dm."movie_id") AS high_rated_movies
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN ('GenreA','GenreB','GenreC')
GROUP  BY dm."name_id"
ORDER  BY high_rated_movies DESC
LIMIT 4;
