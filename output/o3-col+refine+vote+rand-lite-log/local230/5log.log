```sql
--Description:
-- Find the four directors who have the largest number of movies rated above 8 **within the
-- three genres that themselves contain the most such high-rated films**.
-- Steps performed inside this single query:
--   1. Sub-query selects the top-3 genres that have the highest count of movies whose avg_rating > 8.
--   2. Main query filters ratings (>8) and genres to that list, joins director_mapping to
--      associate each qualifying movie with its director(s), and joins names to show human-readable
--      director names.
--   3. Group by director name, count distinct qualifying movies, order by that count, and
--      return the top-4 directors.
SELECT n."name"                                   AS director,
       COUNT(DISTINCT dm."movie_id")              AS high_rated_movie_count
FROM   "director_mapping" AS dm
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "names"            AS n  ON dm."name_id"  = n."id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
        -- top-3 genres with the most >8-rated movies
        SELECT g2."genre"
        FROM   "genre"   AS g2
        JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
        WHERE  r2."avg_rating" > 8
        GROUP  BY g2."genre"
        ORDER  BY COUNT(*) DESC
        LIMIT 3
      )
GROUP  BY n."name"
ORDER  BY high_rated_movie_count DESC
LIMIT 4;
```
