```sql
--Description: Map the IDs of the four top directors (derived dynamically) to their names.
WITH top_directors AS (
    SELECT dm."name_id"
    FROM   "director_mapping" AS dm
    JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
    JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
    WHERE  r."avg_rating" > 8
      AND  g."genre" IN (
            SELECT g2."genre"
            FROM   "genre" AS g2
            JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
            WHERE  r2."avg_rating" > 8
            GROUP  BY g2."genre"
            ORDER  BY COUNT(*) DESC
            LIMIT 3
          )
    GROUP  BY dm."name_id"
    ORDER  BY COUNT(DISTINCT dm."movie_id") DESC
    LIMIT 4
)
SELECT n."id",
       n."name"
FROM   top_directors td
JOIN   "names" n ON n."id" = td."name_id";
```

```sql
--Description: One-stop final answer – director names with count of their movies rated > 8 in
--             the three genres that dominate the > 8 ratings list.  Returns the top 4 directors.
SELECT n."name"                              AS director,
       COUNT(DISTINCT dm."movie_id")         AS movies_above_8_in_top_genres
FROM   "director_mapping" AS dm
JOIN   "genre"            AS g  ON dm."movie_id" = g."movie_id"
JOIN   "ratings"          AS r  ON dm."movie_id" = r."movie_id"
JOIN   "names"            AS n  ON dm."name_id" = n."id"
WHERE  r."avg_rating" > 8
  AND  g."genre" IN (
        SELECT g2."genre"
        FROM   "genre" AS g2
        JOIN   "ratings" AS r2 ON g2."movie_id" = r2."movie_id"
        WHERE  r2."avg_rating" > 8
        GROUP  BY g2."genre"
        ORDER  BY COUNT(*) DESC
        LIMIT 3
      )
GROUP  BY n."name"
ORDER  BY movies_above_8_in_top_genres DESC
LIMIT 4;
```
