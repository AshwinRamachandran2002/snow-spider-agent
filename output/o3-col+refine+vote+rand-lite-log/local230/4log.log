--Description: 5) Preview which directors worked on >8-rated movies that fall inside those Top-3 genres  
SELECT DISTINCT n."name" AS "director_name"
FROM   "names"            AS n
JOIN   "director_mapping" AS d ON n."id" = d."name_id"
JOIN   "ratings"          AS r ON d."movie_id" = r."movie_id"
