```sql
--Description: 1) Peek at movies that already have an average rating above 8.00  
SELECT m."title",
       r."avg_rating"
FROM   "movies" AS m
JOIN   "ratings" AS r
       ON m."id" = r."movie_id"
WHERE  r."avg_rating" > 8
LIMIT  20;
```

```sql
--Description: 2) Find the distinct genres to which those highly-rated movies belong  
SELECT DISTINCT g."genre"
FROM   "genre"  AS g
JOIN   "ratings" AS r
       ON g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
LIMIT  20;
```

```sql
--Description: 3) Count how many >8-rated movies each genre has  
SELECT g."genre",
       COUNT(*) AS "high_rated_movie_count"
FROM   "genre"  AS g
JOIN   "ratings" AS r
       ON g."movie_id" = r."movie_id"
WHERE  r."avg_rating" > 8
GROUP  BY g."genre"
ORDER  BY "high_rated_movie_count" DESC
LIMIT  20;
```

