Query:
-- 9. Attach the human-readable names for those TOP-4 directors
SELECT n.name, t.movie_cnt
FROM (
        SELECT d.name_id,
               COUNT(DISTINCT d.movie_id) AS movie_cnt
        FROM director_mapping AS d
        JOIN ratings  AS r ON d.movie_id = r.movie_id
        JOIN genre    AS g ON d.movie_id = g.movie_id
        WHERE r.avg_rating > 8
          AND g.genre IN (
                SELECT g2.genre
                FROM ratings AS r2
                JOIN genre   AS g2 ON r2.movie_id = g2.movie_id
                WHERE r2.avg_rating > 8
                GROUP BY g2.genre
                ORDER BY COUNT(*) DESC
                LIMIT 3)
        GROUP BY d.name_id
        ORDER BY movie_cnt DESC
        LIMIT 4
) AS t
JOIN names AS n ON n.id = t.name_id
ORDER BY t.movie_cnt DESC
LIMIT 20;
