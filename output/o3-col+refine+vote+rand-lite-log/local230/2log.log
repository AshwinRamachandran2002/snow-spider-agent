```sql
-- 1. Preview movies whose average rating is above 8
SELECT DISTINCT movie_id, avg_rating 
FROM ratings 
WHERE avg_rating > 8
LIMIT 20;
```

```sql
-- 2. Preview the genre assignments for those highly–rated movies
SELECT DISTINCT r.movie_id, g.genre 
FROM ratings AS r
JOIN genre  AS g ON r.movie_id = g.movie_id
WHERE r.avg_rating > 8
LIMIT 20;
```

```sql
-- 3. Count how many such > 8-rated movies each genre owns
SELECT g.genre, COUNT(*) AS movie_cnt
FROM ratings AS r
JOIN genre   AS g ON r.movie_id = g.movie_id
WHERE r.avg_rating > 8
GROUP BY g.genre
ORDER BY movie_cnt DESC
LIMIT 20;
```

```sql
-- 4. Show the TOP-3 genres with the most movies rated above 8
SELECT g.genre, COUNT(*) AS movie_cnt
FROM ratings AS r
JOIN genre   AS g ON r.movie_id = g.movie_id
WHERE r.avg_rating > 8
GROUP BY g.genre
ORDER BY movie_cnt DESC
LIMIT 3;
```

```sql
-- 5. List movies (one row each) that belong to any of the TOP-3 genres
SELECT DISTINCT g.movie_id, g.genre
FROM ratings AS r
JOIN genre   AS g ON r.movie_id = g.movie_id
WHERE r.avg_rating > 8
  AND g.genre IN (                       -- re-use the TOP-3 list
        SELECT g2.genre
        FROM ratings AS r2
        JOIN genre   AS g2 ON r2.movie_id = g2.movie_id
        WHERE r2.avg_rating > 8
        GROUP BY g2.genre
        ORDER BY COUNT(*) DESC
        LIMIT 3)
LIMIT 20;
```

```sql
-- 6. Connect those movies to their directors
SELECT DISTINCT d.movie_id, d.name_id
FROM director_mapping AS d
WHERE d.movie_id IN (
        SELECT DISTINCT g.movie_id
        FROM ratings AS r
        JOIN genre   AS g ON r.movie_id = g.movie_id
        WHERE r.avg_rating > 8
          AND g.genre IN (
                SELECT g2.genre
                FROM ratings AS r2
                JOIN genre   AS g2 ON r2.movie_id = g2.movie_id
                WHERE r2.avg_rating > 8
                GROUP BY g2.genre
                ORDER BY COUNT(*) DESC
                LIMIT 3))
LIMIT 20;
```

```sql
-- 7. Count how many > 8-rated TOP-3-genre movies each director has made
SELECT d.name_id,
       COUNT(DISTINCT d.movie_id) AS movie_cnt
FROM director_mapping AS d
JOIN ratings  AS r ON d.movie_id = r.movie_id
JOIN genre    AS g ON d.movie_id = g.movie_id
WHERE r.avg_rating > 8
  AND g.genre IN (
        SELECT g2.genre
        FROM ratings AS r2
        JOIN genre   AS g2 ON r2.movie_id = g2.movie_id
        WHERE r2.avg_rating > 8
        GROUP BY g2.genre
        ORDER BY COUNT(*) DESC
        LIMIT 3)
GROUP BY d.name_id
ORDER BY movie_cnt DESC
LIMIT 20;
```

```sql
-- 8. Pick the TOP-4 directors by that count (still only id’s)
SELECT name_id, movie_cnt
FROM (
        SELECT d.name_id,
               COUNT(DISTINCT d.movie_id) AS movie_cnt
        FROM director_mapping AS d
        JOIN ratings  AS r ON d.movie_id = r.movie_id
        JOIN genre    AS g ON d.movie_id = g.movie_id
        WHERE r.avg_rating > 8
          AND g.genre IN (
                SELECT g2.genre
                FROM ratings AS r2
                JOIN genre   AS g2 ON r2.movie_id = g2.movie_id
                WHERE r2.avg_rating > 8
                GROUP BY g2.genre
                ORDER BY COUNT(*) DESC
                LIMIT 3)
        GROUP BY d.name_id
        ORDER BY movie_cnt DESC
        LIMIT 4
) AS top4_directors
LIMIT 20;
```

```sql
-- 9. Attach the human-readable names for those TOP-4 directors
SELECT n.name, t.movie_cnt
FROM (
        SELECT d.name_id,
               COUNT(DISTINCT d.movie_id) AS movie_cnt
        FROM director_mapping AS d
        JOIN ratings  AS r ON d.movie_id = r.movie_id
        JOIN genre    AS g ON d.movie_id = g.movie_id
        WHERE r.avg_rating > 8
          AND g.genre IN (
                SELECT g2.genre
                FROM ratings AS r2
                JOIN genre   AS g2 ON r2.movie_id = g2.movie_id
                WHERE r2.avg_rating > 8
                GROUP BY g2.genre
                ORDER BY COUNT(*) DESC
                LIMIT 3)
        GROUP BY d.name_id
        ORDER BY movie_cnt DESC
        LIMIT 4
) AS t
JOIN names AS n ON n.id = t.name_id
ORDER BY t.movie_cnt DESC
LIMIT 20;
```

```sql
