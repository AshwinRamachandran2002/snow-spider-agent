```sql
-- 1) Preview a handful of movies and their ratings to understand “ratings” content
SELECT DISTINCT r."movie_id", r."avg_rating"
FROM "ratings" AS r
LIMIT 20;
```

```sql
-- 2) Inspect how a movie is connected to one or several genres
SELECT DISTINCT g."movie_id", g."genre"
FROM "genre" AS g
LIMIT 20;
```

```sql
-- 3) List every movie that is rated strictly above 8.0
SELECT DISTINCT r."movie_id"
FROM "ratings" AS r
WHERE r."avg_rating" > 8.0
LIMIT 20;
```

```sql
-- 4) Combine ratings with genres for movies whose average rating > 8.0
SELECT DISTINCT r."movie_id", g."genre"
FROM "ratings" AS r
JOIN "genre"  AS g
     ON r."movie_id" = g."movie_id"
WHERE r."avg_rating" > 8.0
LIMIT 20;
```

```sql
-- 5) Count how many high-rated (>8) movies belong to each genre
SELECT g."genre",
       COUNT(*) AS high_rated_cnt
FROM   "ratings" AS r
JOIN   "genre"   AS g
       ON r."movie_id" = g."movie_id"
WHERE  r."avg_rating" > 8.0
GROUP  BY g."genre"
ORDER  BY high_rated_cnt DESC
LIMIT 20;
```

```sql
-- 6) Retrieve the TOP 3 genres that have the greatest number of >8-rated films
SELECT g."genre",
       COUNT(*) AS high_rated_cnt
FROM   "ratings" AS r
JOIN   "genre"   AS g
       ON r."movie_id" = g."movie_id"
WHERE  r."avg_rating" > 8.0
GROUP  BY g."genre"
ORDER  BY high_rated_cnt DESC
LIMIT 3;
```

```sql
-- 7) Examine how movies relate to directors (movie_id ↔ director_mapping)
SELECT DISTINCT d."movie_id", d."name_id"
FROM "director_mapping" AS d
LIMIT 20;
```

```sql
-- 8) See how a name_id maps to an actual human-readable name
SELECT DISTINCT n."id", n."name"
FROM "names" AS n
LIMIT 20;
```

```sql
-- 9) Pull every (>8) movie that is in one of the TOP-3 genres and list its directors
WITH top_genres AS (
    SELECT g."genre"
    FROM   "ratings" AS r
    JOIN   "genre"   AS g
           ON r."movie_id" = g."movie_id"
    WHERE  r."avg_rating" > 8.0
    GROUP  BY g."genre"
    ORDER  BY COUNT(*) DESC
    LIMIT 3
)
SELECT DISTINCT r."movie_id",
       g."genre",
       d."name_id"
FROM   "ratings"          AS r
JOIN   "genre"            AS g  ON r."movie_id" = g."movie_id"
JOIN   top_genres         AS tg ON g."genre" = tg."genre"
JOIN   "director_mapping" AS d  ON r."movie_id" = d."movie_id"
WHERE  r."avg_rating" > 8.0
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER: Top-4 directors who have directed the most films rated >8.0 in the TOP-3 genres
WITH top_genres AS (
    SELECT g."genre"
    FROM   "ratings" AS r
    JOIN   "genre"   AS g
           ON r."movie_id" = g."movie_id"
    WHERE  r."avg_rating" > 8.0
    GROUP  BY g."genre"
    ORDER  BY COUNT(*) DESC
    LIMIT 3
),
high_rated_genre_movies AS (
    SELECT DISTINCT r."movie_id"
    FROM   "ratings" AS r
    JOIN   "genre"   AS g  ON r."movie_id" = g."movie_id"
    JOIN   top_genres tg   ON g."genre"  = tg."genre"
    WHERE  r."avg_rating" > 8.0
)
SELECT n."name"  AS director,
       COUNT(*)  AS high_rated_movie_count
FROM   high_rated_genre_movies  AS h
JOIN   "director_mapping"       AS d  ON h."movie_id" = d."movie_id"
JOIN   "names"                  AS n  ON d."name_id"  = n."id"
GROUP  BY n."name"
ORDER  BY high_rated_movie_count DESC
LIMIT 4;
```
