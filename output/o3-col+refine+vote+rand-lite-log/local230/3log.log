Query:
-- 9) Pull every (>8) movie that is in one of the TOP-3 genres and list its directors
WITH top_genres AS (
    SELECT g."genre"
    FROM   "ratings" AS r
    JOIN   "genre"   AS g
           ON r."movie_id" = g."movie_id"
    WHERE  r."avg_rating" > 8.0
    GROUP  BY g."genre"
    ORDER  BY COUNT(*) DESC
    LIMIT 3
)
SELECT DISTINCT r."movie_id",
       g."genre",
       d."name_id"
FROM   "ratings"          AS r
JOIN   "genre"            AS g  ON r."movie_id" = g."movie_id"
JOIN   top_genres         AS tg ON g."genre" = tg."genre"
JOIN   "director_mapping" AS d  ON r."movie_id" = d."movie_id"
WHERE  r."avg_rating" > 8.0
LIMIT 20;
