-- 5) Count how many high-rated (>8) movies belong to each genre
SELECT g."genre",
       COUNT(*) AS high_rated_cnt
FROM   "ratings" AS r
JOIN   "genre"   AS g
       ON r."movie_id" = g."movie_id"
WHERE  r."avg_rating" > 8.0
GROUP  BY g."genre"
ORDER  BY high_rated_cnt DESC
LIMIT 20;
