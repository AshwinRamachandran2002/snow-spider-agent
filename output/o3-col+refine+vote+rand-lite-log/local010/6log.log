```sql
--5. Show 20 individual flight legs together with calculated distance (km)  
WITH coords AS (
  SELECT "airport_code",
         CAST(SUBSTR("coordinates", 2, INSTR("coordinates", ',')-2) AS REAL) AS lon,
         CAST(SUBSTR(SUBSTR("coordinates", INSTR("coordinates", ',')+1),
                     1,
                     LENGTH(SUBSTR("coordinates", INSTR("coordinates", ',')+1))-1) AS REAL) AS lat
  FROM   "airports_data")
SELECT f."flight_no",
       (6371 * 2 * ASIN(
          SQRT(
            POWER(SIN(((c2.lat-c1.lat)*0.01745329252)/2),2) +
            COS(c1.lat*0.01745329252)*COS(c2.lat*0.01745329252) *
            POWER(SIN(((c2.lon-c1.lon)*0.01745329252)/2),2)
          )))                                          AS distance_km
FROM   "flights" AS f
JOIN   coords     AS c1 ON c1."airport_code" = f."departure_airport"
JOIN   coords     AS c2 ON c2."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
--6. Produce the averaged distance for every unordered city-pair (20 samples)  
WITH coords AS (
  SELECT "airport_code",
         CAST(SUBSTR("coordinates", 2, INSTR("coordinates", ',')-2) AS REAL) AS lon,
         CAST(SUBSTR(SUBSTR("coordinates", INSTR("coordinates", ',')+1),
                     1,
                     LENGTH(SUBSTR("coordinates", INSTR("coordinates", ',')+1))-1) AS REAL) AS lat,
         json_extract("city", '$.en')                                  AS city_en
  FROM   "airports_data"),
legs AS (
  SELECT json_extract(a1."city", '$.en') AS city1,
         json_extract(a2."city", '$.en') AS city2,
         (6371 * 2 * ASIN(
            SQRT(
              POWER(SIN(((c2.lat-c1.lat)*0.01745329252)/2),2) +
              COS(c1.lat*0.01745329252)*COS(c2.lat*0.01745329252) *
              POWER(SIN(((c2.lon-c1.lon)*0.01745329252)/2),2)
            ))) AS distance_km
  FROM   "flights"  AS f
  JOIN   coords     AS c1 ON c1."airport_code" = f."departure_airport"
  JOIN   coords     AS c2 ON c2."airport_code" = f."arrival_airport"
  JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
  JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport")
SELECT CASE WHEN city1 < city2 THEN city1 ELSE city2 END || ' — ' ||
       CASE WHEN city1 < city2 THEN city2 ELSE city1 END               AS city_pair,
       AVG(distance_km)                                               AS avg_distance
FROM   legs
GROUP  BY city_pair
LIMIT 20;
```

```sql
--7. Put every pair into the requested distance buckets and show 20 examples  
WITH coords AS (
  SELECT "airport_code",
         CAST(SUBSTR("coordinates", 2, INSTR("coordinates", ',')-2) AS REAL) AS lon,
         CAST(SUBSTR(SUBSTR("coordinates", INSTR("coordinates", ',')+1),
                     1,
                     LENGTH(SUBSTR("coordinates", INSTR("coordinates", ',')+1))-1) AS REAL) AS lat,
         json_extract("city", '$.en')                                  AS city_en
  FROM   "airports_data"),
pairs AS (
  SELECT CASE WHEN city1 < city2 THEN city1 ELSE city2 END ||
         ' — ' ||
         CASE WHEN city1 < city2 THEN city2 ELSE city1 END             AS city_pair,
         AVG(distance_km)                                             AS avg_distance
  FROM (
        SELECT json_extract(a1."city", '$.en')          AS city1,
               json_extract(a2."city", '$.en')          AS city2,
               (6371*2*ASIN(SQRT(
                 POWER(SIN(((c2.lat-c1.lat)*0.01745329252)/2),2)+
                 COS(c1.lat*0.01745329252)*COS(c2.lat*0.01745329252)*
                 POWER(SIN(((c2.lon-c1.lon)*0.01745329252)/2),2)))) AS distance_km
        FROM   "flights" AS f
        JOIN   coords    AS c1 ON c1."airport_code" = f."departure_airport"
        JOIN   coords    AS c2 ON c2."airport_code" = f."arrival_airport"
        JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
        JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
       )
  GROUP BY 1),
bucketed AS (
  SELECT city_pair,
         avg_distance,
         CASE
           WHEN avg_distance < 1000 THEN '0'
           WHEN avg_distance < 2000 THEN '1000'
           WHEN avg_distance < 3000 THEN '2000'
           WHEN avg_distance < 4000 THEN '3000'
           WHEN avg_distance < 5000 THEN '4000'
           WHEN avg_distance < 6000 THEN '5000'
           ELSE '6000+'
         END                                             AS distance_range
  FROM   pairs)
SELECT *
FROM   bucketed
LIMIT 20;
```

```sql
--8. Count how many city-pairs fall into each distance bucket  
WITH coords AS (
  SELECT "airport_code",
         CAST(SUBSTR("coordinates", 2, INSTR("coordinates", ',')-2) AS REAL) AS lon,
         CAST(SUBSTR(SUBSTR("coordinates", INSTR("coordinates", ',')+1),
                     1,
                     LENGTH(SUBSTR("coordinates", INSTR("coordinates", ',')+1))-1) AS REAL) AS lat,
         json_extract("city", '$.en')                                  AS city_en
  FROM   "airports_data"),
pairs AS (
  SELECT CASE WHEN city1 < city2 THEN city1 ELSE city2 END ||
         ' — ' ||
         CASE WHEN city1 < city2 THEN city2 ELSE city1 END             AS city_pair,
         AVG(distance_km)                                             AS avg_distance
  FROM (
        SELECT json_extract(a1."city", '$.en')          AS city1,
               json_extract(a2."city", '$.en')          AS city2,
               (6371*2*ASIN(SQRT(
                 POWER(SIN(((c2.lat-c1.lat)*0.01745329252)/2),2)+
                 COS(c1.lat*0.01745329252)*COS(c2.lat*0.01745329252)*
                 POWER(SIN(((c2.lon-c1.lon)*0.01745329252)/2),2)))) AS distance_km
        FROM   "flights" AS f
        JOIN   coords    AS c1 ON c1."airport_code" = f."departure_airport"
        JOIN   coords    AS c2 ON c2."airport_code" = f."arrival_airport"
        JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
        JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
       )
  GROUP BY 1),
bucketed AS (
  SELECT CASE
           WHEN avg_distance < 1000 THEN '0'
           WHEN avg_distance < 2000 THEN '1000'
           WHEN avg_distance < 3000 THEN '2000'
           WHEN avg_distance < 4000 THEN '3000'
           WHEN avg_distance < 5000 THEN '4000'
           WHEN avg_distance < 6000 THEN '5000'
           ELSE '6000+'
         END                                       AS distance_range,
         COUNT(*)                                  AS pair_cnt
  FROM   pairs
  GROUP  BY 1)
SELECT *
FROM   bucketed;
```

```sql
--9. Finally, ask for the smallest bucket size (the task’s answer)  
WITH coords AS (
  SELECT "airport_code",
         CAST(SUBSTR("coordinates", 2, INSTR("coordinates", ',')-2) AS REAL) AS lon,
         CAST(SUBSTR(SUBSTR("coordinates", INSTR("coordinates", ',')+1),
                     1,
                     LENGTH(SUBSTR("coordinates", INSTR("coordinates", ',')+1))-1) AS REAL) AS lat,
         json_extract("city", '$.en')                                  AS city_en
  FROM   "airports_data"),
pairs AS (
  SELECT CASE WHEN city1 < city2 THEN city1 ELSE city2 END ||
         ' — ' ||
         CASE WHEN city1 < city2 THEN city2 ELSE city1 END             AS city_pair,
         AVG(distance_km)                                             AS avg_distance
  FROM (
        SELECT json_extract(a1."city", '$.en')          AS city1,
               json_extract(a2."city", '$.en')          AS city2,
               (6371*2*ASIN(SQRT(
                 POWER(SIN(((c2.lat-c1.lat)*0.01745329252)/2),2)+
                 COS(c1.lat*0.01745329252)*COS(c2.lat*0.01745329252)*
                 POWER(SIN(((c2.lon-c1.lon)*0.01745329252)/2),2)))) AS distance_km
        FROM   "flights" AS f
        JOIN   coords    AS c1 ON c1."airport_code" = f."departure_airport"
        JOIN   coords    AS c2 ON c2."airport_code" = f."arrival_airport"
        JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
        JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport"
       )
  GROUP BY 1),
bucketed AS (
  SELECT CASE
           WHEN avg_distance < 1000 THEN '0'
           WHEN avg_distance < 2000 THEN '1000'
           WHEN avg_distance < 3000 THEN '2000'
           WHEN avg_distance < 4000 THEN '3000'
           WHEN avg_distance < 5000 THEN '4000'
           WHEN avg_distance < 6000 THEN '5000'
           ELSE '6000+'
         END                        AS distance_range,
         COUNT(*)                   AS pair_cnt
  FROM   pairs
  GROUP  BY 1)
SELECT MIN(pair_cnt) AS fewest_city_pairs
FROM   bucketed;
