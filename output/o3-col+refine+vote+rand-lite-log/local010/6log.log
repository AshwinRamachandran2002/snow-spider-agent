  SELECT "airport_code",
         CAST(SUBSTR("coordinates", 2, INSTR("coordinates", ',')-2) AS REAL) AS lon,
         CAST(SUBSTR(SUBSTR("coordinates", INSTR("coordinates", ',')+1),
                     1,
                     LENGTH(SUBSTR("coordinates", INSTR("coordinates", ',')+1))-1) AS REAL) AS lat,
         json_extract("city", '$.en')                                  AS city_en
  FROM   "airports_data"),
legs AS (
  SELECT json_extract(a1."city", '$.en') AS city1,
         json_extract(a2."city", '$.en') AS city2,
         (6371 * 2 * ASIN(
            SQRT(
              POWER(SIN(((c2.lat-c1.lat)*0.01745329252)/2),2) +
              COS(c1.lat*0.01745329252)*COS(c2.lat*0.01745329252) *
              POWER(SIN(((c2.lon-c1.lon)*0.01745329252)/2),2)
            ))) AS distance_km
  FROM   "flights"  AS f
  JOIN   coords     AS c1 ON c1."airport_code" = f."departure_airport"
  JOIN   coords     AS c2 ON c2."airport_code" = f."arrival_airport"
  JOIN   "airports_data" AS a1 ON a1."airport_code" = f."departure_airport"
  JOIN   "airports_data" AS a2 ON a2."airport_code" = f."arrival_airport")
SELECT CASE WHEN city1 < city2 THEN city1 ELSE city2 END || ' — ' ||
       CASE WHEN city1 < city2 THEN city2 ELSE city1 END               AS city_pair,
       AVG(distance_km)                                               AS avg_distance
FROM   legs
GROUP  BY city_pair
LIMIT 20;
