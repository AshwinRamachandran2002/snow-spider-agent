-- 5.  Calculate a great-circle distance for a sample of flights  
SELECT f."flight_id",
       json_extract(ad."city", '$.en') AS "dep_city",
       json_extract(aa."city", '$.en') AS "arr_city",
       6371 * acos(
           cos(radians( CAST(substr(ad."coordinates",
                                    instr(ad."coordinates", ',')+1,
                                    instr(ad."coordinates", ')') -
                                    instr(ad."coordinates", ',') - 1) AS REAL) ))
         * cos(radians( CAST(substr(aa."coordinates",
                                    instr(aa."coordinates", ',')+1,
                                    instr(aa."coordinates", ')') -
                                    instr(aa."coordinates", ',') - 1) AS REAL) ))
         * cos(radians( CAST(substr(aa."coordinates", 2,
                                    instr(aa."coordinates", ',')-2) AS REAL) )
               - radians( CAST(substr(ad."coordinates", 2,
                                      instr(ad."coordinates", ',')-2) AS REAL) ))
         + sin(radians( CAST(substr(ad."coordinates",
                                    instr(ad."coordinates", ',')+1,
                                    instr(ad."coordinates", ')') -
                                    instr(ad."coordinates", ',') - 1) AS REAL) ))
         * sin(radians( CAST(substr(aa."coordinates",
                                    instr(aa."coordinates", ',')+1,
                                    instr(aa."coordinates", ')') -
                                    instr(aa."coordinates", ',') - 1) AS REAL) ))
       ) AS "distance_km"
FROM   "flights"        AS f
JOIN   "airports_data"  AS ad  ON ad."airport_code" = f."departure_airport"
JOIN   "airports_data"  AS aa  ON aa."airport_code" = f."arrival_airport"
LIMIT 20;
