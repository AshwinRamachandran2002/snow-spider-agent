          /* same grouped-pair query as in step 8 */
          SELECT
            CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS "city_a",
            CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS "city_b",
            CASE WHEN AVG("distance_km") >= 6000
