```sql
-- 1.  Get a feeling for how the route information is stored  
SELECT DISTINCT "departure_airport", "arrival_airport"
FROM "flights"
LIMIT 20;
```

```sql
-- 2.  Look at an airport record together with its English city name & coordinates  
SELECT "airport_code",
       json_extract("city", '$.en')  AS "city_en",
       "coordinates"
FROM   "airports_data"
LIMIT 20;
```

```sql
-- 3.  Join a few flights with the two city names they connect  
SELECT f."flight_id",
       json_extract(ad."city", '$.en') AS "dep_city",
       json_extract(aa."city", '$.en') AS "arr_city"
FROM   "flights"        AS f
JOIN   "airports_data"  AS ad  ON ad."airport_code" = f."departure_airport"
JOIN   "airports_data"  AS aa  ON aa."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
-- 4.  Parse longitude / latitude from the “point” coordinate string  
SELECT "airport_code",
       CAST(substr("coordinates", 2,
                   instr("coordinates", ',')-2) AS REAL)                            AS "lon",
       CAST(substr("coordinates", instr("coordinates", ',')+1,
                   instr("coordinates", ')') - instr("coordinates", ',') - 1) AS REAL) AS "lat"
FROM   "airports_data"
LIMIT 20;
```

```sql
-- 5.  Calculate a great-circle distance for a sample of flights  
SELECT f."flight_id",
       json_extract(ad."city", '$.en') AS "dep_city",
       json_extract(aa."city", '$.en') AS "arr_city",
       6371 * acos(
           cos(radians( CAST(substr(ad."coordinates",
                                    instr(ad."coordinates", ',')+1,
                                    instr(ad."coordinates", ')') -
                                    instr(ad."coordinates", ',') - 1) AS REAL) ))
         * cos(radians( CAST(substr(aa."coordinates",
                                    instr(aa."coordinates", ',')+1,
                                    instr(aa."coordinates", ')') -
                                    instr(aa."coordinates", ',') - 1) AS REAL) ))
         * cos(radians( CAST(substr(aa."coordinates", 2,
                                    instr(aa."coordinates", ',')-2) AS REAL) )
               - radians( CAST(substr(ad."coordinates", 2,
                                      instr(ad."coordinates", ',')-2) AS REAL) ))
         + sin(radians( CAST(substr(ad."coordinates",
                                    instr(ad."coordinates", ',')+1,
                                    instr(ad."coordinates", ')') -
                                    instr(ad."coordinates", ',') - 1) AS REAL) ))
         * sin(radians( CAST(substr(aa."coordinates",
                                    instr(aa."coordinates", ',')+1,
                                    instr(aa."coordinates", ')') -
                                    instr(aa."coordinates", ',') - 1) AS REAL) ))
       ) AS "distance_km"
FROM   "flights"        AS f
JOIN   "airports_data"  AS ad  ON ad."airport_code" = f."departure_airport"
JOIN   "airports_data"  AS aa  ON aa."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
-- 6.  Build unordered city pairs and their average distance (first 20)  
SELECT
  CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS "city_a",
  CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS "city_b",
  AVG("distance_km")                    AS "avg_km"
FROM (
     SELECT
       json_extract(ad."city", '$.en')  AS c1,
       json_extract(aa."city", '$.en')  AS c2,
       6371 * acos(
           cos(radians( CAST(substr(ad."coordinates",
                                    instr(ad."coordinates", ',')+1,
                                    instr(ad."coordinates", ')') -
                                    instr(ad."coordinates", ',') - 1) AS REAL) ))
         * cos(radians( CAST(substr(aa."coordinates",
                                    instr(aa."coordinates", ',')+1,
                                    instr(aa."coordinates", ')') -
                                    instr(aa."coordinates", ',') - 1) AS REAL) ))
         * cos(radians( CAST(substr(aa."coordinates", 2,
                                    instr(aa."coordinates", ',')-2) AS REAL) )
               - radians( CAST(substr(ad."coordinates", 2,
                                      instr(ad."coordinates", ',')-2) AS REAL) ))
         + sin(radians( CAST(substr(ad."coordinates",
                                    instr(ad."coordinates", ',')+1,
                                    instr(ad."coordinates", ')') -
                                    instr(ad."coordinates", ',') - 1) AS REAL) ))
         * sin(radians( CAST(substr(aa."coordinates",
                                    instr(aa."coordinates", ',')+1,
                                    instr(aa."coordinates", ')') -
                                    instr(aa."coordinates", ',') - 1) AS REAL) ))
       ) AS "distance_km"
     FROM "flights"       AS f
     JOIN "airports_data" AS ad ON ad."airport_code" = f."departure_airport"
     JOIN "airports_data" AS aa ON aa."airport_code" = f."arrival_airport"
) AS d
GROUP BY 1,2
LIMIT 20;
```

```sql
-- 7.  Put each pair into a 1 000-km bucket (display 20 rows)  
SELECT "city_a",
       "city_b",
       CASE WHEN "avg_km" >= 6000
            THEN '6000+'
            ELSE printf('%d', (CAST("avg_km"/1000 AS INTEGER))*1000)
       END AS "distance_bucket"
FROM (
     -- re-use query 6 but without LIMIT
     SELECT
       CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS "city_a",
       CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS "city_b",
       AVG("distance_km") AS "avg_km"
     FROM (
          SELECT
            json_extract(ad."city", '$.en') AS c1,
            json_extract(aa."city", '$.en') AS c2,
            6371 * acos(
                cos(radians( CAST(substr(ad."coordinates",
                                         instr(ad."coordinates", ',')+1,
                                         instr(ad."coordinates", ')') -
                                         instr(ad."coordinates", ',') - 1) AS REAL) ))
              * cos(radians( CAST(substr(aa."coordinates",
                                         instr(aa."coordinates", ',')+1,
                                         instr(aa."coordinates", ')') -
                                         instr(aa."coordinates", ',') - 1) AS REAL) ))
              * cos(radians( CAST(substr(aa."coordinates", 2,
                                         instr(aa."coordinates", ',')-2) AS REAL) )
                    - radians( CAST(substr(ad."coordinates", 2,
                                           instr(ad."coordinates", ',')-2) AS REAL) ))
              + sin(radians( CAST(substr(ad."coordinates",
                                         instr(ad."coordinates", ',')+1,
                                         instr(ad."coordinates", ')') -
                                         instr(ad."coordinates", ',') - 1) AS REAL) ))
              * sin(radians( CAST(substr(aa."coordinates",
                                         instr(aa."coordinates", ',')+1,
                                         instr(aa."coordinates", ')') -
                                         instr(aa."coordinates", ',') - 1) AS REAL) ))
            ) AS "distance_km"
          FROM "flights"       AS f
          JOIN "airports_data" AS ad ON ad."airport_code" = f."departure_airport"
          JOIN "airports_data" AS aa ON aa."airport_code" = f."arrival_airport"
     ) AS raw
     GROUP BY 1,2
) AS pairs
LIMIT 20;
```

```sql
-- 8.  Count how many city pairs fall inside each distance bucket  
SELECT "distance_bucket", COUNT(*) AS "pair_cnt"
FROM (
     SELECT
       CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS "city_a",
       CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS "city_b",
       CASE WHEN AVG("distance_km") >= 6000
            THEN '6000+'
            ELSE printf('%d', (CAST(AVG("distance_km")/1000 AS INTEGER))*1000)
       END AS "distance_bucket"
     FROM (
          /* same raw distance sub-query as above */
          SELECT
            json_extract(ad."city", '$.en') AS c1,
            json_extract(aa."city", '$.en') AS c2,
            6371 * acos(
                cos(radians( CAST(substr(ad."coordinates",
                                         instr(ad."coordinates", ',')+1,
                                         instr(ad."coordinates", ')') -
                                         instr(ad."coordinates", ',') - 1) AS REAL) ))
              * cos(radians( CAST(substr(aa."coordinates",
                                         instr(aa."coordinates", ',')+1,
                                         instr(aa."coordinates", ')') -
                                         instr(aa."coordinates", ',') - 1) AS REAL) ))
              * cos(radians( CAST(substr(aa."coordinates", 2,
                                         instr(aa."coordinates", ',')-2) AS REAL) )
                    - radians( CAST(substr(ad."coordinates", 2,
                                           instr(ad."coordinates", ',')-2) AS REAL) ))
              + sin(radians( CAST(substr(ad."coordinates",
                                         instr(ad."coordinates", ',')+1,
                                         instr(ad."coordinates", ')') -
                                         instr(ad."coordinates", ',') - 1) AS REAL) ))
              * sin(radians( CAST(substr(aa."coordinates",
                                         instr(aa."coordinates", ',')+1,
                                         instr(aa."coordinates", ')') -
                                         instr(aa."coordinates", ',') - 1) AS REAL) ))
            ) AS "distance_km"
          FROM "flights"       AS f
          JOIN "airports_data" AS ad ON ad."airport_code" = f."departure_airport"
          JOIN "airports_data" AS aa ON aa."airport_code" = f."arrival_airport"
     ) AS raw
     GROUP BY 1,2
) AS buckets
GROUP BY "distance_bucket"
ORDER BY "pair_cnt"
LIMIT 20;
```

```sql
-- 9.  Finally: how many pairs are in the *least-populated* distance range?  
SELECT MIN("pair_cnt") AS "fewest_pairs"
FROM (
     SELECT "distance_bucket", COUNT(*) AS "pair_cnt"
     FROM (
          /* same grouped-pair query as in step 8 */
          SELECT
            CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS "city_a",
            CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS "city_b",
            CASE WHEN AVG("distance_km") >= 6000
                 THEN '6000+'
                 ELSE printf('%d', (CAST(AVG("distance_km")/1000 AS INTEGER))*1000)
            END AS "distance_bucket"
          FROM (
               SELECT
                 json_extract(ad."city", '$.en') AS c1,
                 json_extract(aa."city", '$.en') AS c2,
                 6371 * acos(
                     cos(radians( CAST(substr(ad."coordinates",
                                              instr(ad."coordinates", ',')+1,
                                              instr(ad."coordinates", ')') -
                                              instr(ad."coordinates", ',') - 1) AS REAL) ))
                   * cos(radians( CAST(substr(aa."coordinates",
                                              instr(aa."coordinates", ',')+1,
                                              instr(aa."coordinates", ')') -
                                              instr(aa."coordinates", ',') - 1) AS REAL) ))
                   * cos(radians( CAST(substr(aa."coordinates", 2,
                                              instr(aa."coordinates", ',')-2) AS REAL) )
                         - radians( CAST(substr(ad."coordinates", 2,
                                                instr(ad."coordinates", ',')-2) AS REAL) ))
                   + sin(radians( CAST(substr(ad."coordinates",
                                              instr(ad."coordinates", ',')+1,
                                              instr(ad."coordinates", ')') -
                                              instr(ad."coordinates", ',') - 1) AS REAL) ))
                   * sin(radians( CAST(substr(aa."coordinates",
                                              instr(aa."coordinates", ',')+1,
                                              instr(aa."coordinates", ')') -
                                              instr(aa."coordinates", ',') - 1) AS REAL) ))
                 ) AS "distance_km"
               FROM "flights"       AS f
               JOIN "airports_data" AS ad ON ad."airport_code" = f."departure_airport"
               JOIN "airports_data" AS aa ON aa."airport_code" = f."arrival_airport"
          ) AS raw
          GROUP BY 1,2
     ) AS bucketed
     GROUP BY "distance_bucket"
) AS mins;
```

These nine progressively more complex queries let you:

1. Inspect which airports are linked in the flights table.  
2. See how to extract city names & coordinates from airports_data.  
3. Confirm city names per flight.  
4. Parse numeric latitude/longitude values from the point text.  
5. Verify the great-circle distance formula on a handful of flights.  
6. Build unordered city-to-city pairs with their average kilometres.  
7. Slot every pair into 0-, 1 000-, 2 000-, … , 6 000 + km buckets.  
8. Count how many pairs land in each bucket.  
9. Return the smallest of those counts — i.e. “how many pairs are there in the distance range with the fewest unique city pairs?”.
