Query:
-- 6. Join flights to the two airports and show the two cities of each flight
WITH c AS (
  SELECT a."airport_code",
         json_extract(a."city", '$.en') AS city_en
  FROM   "airports_data" AS a)
SELECT DISTINCT f."flight_id",
       c1.city_en AS dep_city,
       c2.city_en AS arr_city
FROM   "flights"          AS f
JOIN   c                  AS c1 ON c1."airport_code" = f."departure_airport"
JOIN   c                  AS c2 ON c2."airport_code" = f."arrival_airport"
LIMIT 20;
