```sql
-- 6. Join flights to the two airports and show the two cities of each flight
WITH c AS (
  SELECT a."airport_code",
         json_extract(a."city", '$.en') AS city_en
  FROM   "airports_data" AS a)
SELECT DISTINCT f."flight_id",
       c1.city_en AS dep_city,
       c2.city_en AS arr_city
FROM   "flights"          AS f
JOIN   c                  AS c1 ON c1."airport_code" = f."departure_airport"
JOIN   c                  AS c2 ON c2."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
-- 7. Compute distance (km) for every individual flight, using haversine
WITH c AS (
  SELECT a."airport_code",
         CAST(SUBSTR(a."coordinates", 2,
                     INSTR(a."coordinates", ',') - 2) AS REAL)  AS lon,
         CAST(SUBSTR(a."coordinates",
                     INSTR(a."coordinates", ',') + 1,
                     INSTR(a."coordinates", ')') -
                     INSTR(a."coordinates", ',') - 1) AS REAL)  AS lat,
         json_extract(a."city", '$.en')               AS city_en
  FROM   "airports_data" AS a)
SELECT DISTINCT f."flight_id",
       c1.city_en AS dep_city,
       c2.city_en AS arr_city,
       6371 *
       ACOS( COS(RADIANS(c1.lat)) * COS(RADIANS(c2.lat)) *
             COS(RADIANS(c2.lon) - RADIANS(c1.lon)) +
             SIN(RADIANS(c1.lat)) * SIN(RADIANS(c2.lat)) ) AS km
FROM   "flights" AS f
JOIN   c AS c1 ON c1."airport_code" = f."departure_airport"
JOIN   c AS c2 ON c2."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
-- 8. Turn every flight into an (unordered) city-pair + distance
WITH c AS (
  SELECT a."airport_code",
         CAST(SUBSTR(a."coordinates", 2,
                     INSTR(a."coordinates", ',') - 2) AS REAL)  AS lon,
         CAST(SUBSTR(a."coordinates",
                     INSTR(a."coordinates", ',') + 1,
                     INSTR(a."coordinates", ')') -
                     INSTR(a."coordinates", ',') - 1) AS REAL)  AS lat,
         json_extract(a."city", '$.en')               AS city_en
  FROM   "airports_data" AS a),
d AS (
  SELECT json_extract(a."city", '$.en') AS dep_city,
         json_extract(b."city", '$.en') AS arr_city,
         6371 *
         ACOS( COS(RADIANS(a_lat.lat)) * COS(RADIANS(b_lat.lat)) *
               COS(RADIANS(b_lat.lon) - RADIANS(a_lat.lon)) +
               SIN(RADIANS(a_lat.lat)) * SIN(RADIANS(b_lat.lat)) ) AS km
  FROM   "flights" AS f
  JOIN   c           AS a_lat ON a_lat."airport_code" = f."departure_airport"
  JOIN   c           AS b_lat ON b_lat."airport_code" = f."arrival_airport" )
SELECT DISTINCT
       CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city1,
       CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city2,
       km
FROM   d
LIMIT 20;
```

```sql
-- 9. Average the distance across all routes per (unordered) city-pair
WITH c AS (
  SELECT a."airport_code",
         CAST(SUBSTR(a."coordinates", 2,
                     INSTR(a."coordinates", ',') - 2) AS REAL)  AS lon,
         CAST(SUBSTR(a."coordinates",
                     INSTR(a."coordinates", ',') + 1,
                     INSTR(a."coordinates", ')') -
                     INSTR(a."coordinates", ',') - 1) AS REAL)  AS lat,
         json_extract(a."city", '$.en')               AS city_en
  FROM   "airports_data" AS a),
d AS (
  SELECT json_extract(a."city", '$.en') AS dep_city,
         json_extract(b."city", '$.en') AS arr_city,
         6371 *
         ACOS( COS(RADIANS(a_lat.lat)) * COS(RADIANS(b_lat.lat)) *
               COS(RADIANS(b_lat.lon) - RADIANS(a_lat.lon)) +
               SIN(RADIANS(a_lat.lat)) * SIN(RADIANS(b_lat.lat)) ) AS km
  FROM   "flights" AS f
  JOIN   c           AS a_lat ON a_lat."airport_code" = f."departure_airport"
  JOIN   c           AS b_lat ON b_lat."airport_code" = f."arrival_airport" ),
pairs AS (
  SELECT CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city1,
         CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city2,
         km
  FROM   d )
SELECT DISTINCT city1, city2,
       AVG(km) OVER (PARTITION BY city1, city2) AS avg_km
FROM   pairs
LIMIT 20;
```

```sql
-- 10. Bucket the average distance, count pairs and pick the smallest bucket
WITH c AS (
  SELECT a."airport_code",
         CAST(SUBSTR(a."coordinates", 2,
                     INSTR(a."coordinates", ',') - 2) AS REAL)  AS lon,
         CAST(SUBSTR(a."coordinates",
                     INSTR(a."coordinates", ',') + 1,
                     INSTR(a."coordinates", ')') -
                     INSTR(a."coordinates", ',') - 1) AS REAL)  AS lat,
         json_extract(a."city", '$.en')               AS city_en
  FROM   "airports_data" AS a),
d AS (
  SELECT json_extract(a."city", '$.en') AS dep_city,
         json_extract(b."city", '$.en') AS arr_city,
         6371 *
         ACOS( COS(RADIANS(a_lat.lat)) * COS(RADIANS(b_lat.lat)) *
               COS(RADIANS(b_lat.lon) - RADIANS(a_lat.lon)) +
               SIN(RADIANS(a_lat.lat)) * SIN(RADIANS(b_lat.lat)) ) AS km
  FROM   "flights" AS f
  JOIN   c           AS a_lat ON a_lat."airport_code" = f."departure_airport"
  JOIN   c           AS b_lat ON b_lat."airport_code" = f."arrival_airport" ),
pairs AS (
  SELECT CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city1,
         CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city2,
         km
  FROM   d ),
avg_pair AS (
  SELECT city1, city2, AVG(km) AS avg_km
  FROM   pairs
  GROUP  BY city1, city2),
bucketed AS (
  SELECT city1, city2, avg_km,
         CASE
           WHEN avg_km < 1000  THEN '0-999'
           WHEN avg_km < 2000  THEN '1000-1999'
           WHEN avg_km < 3000  THEN '2000-2999'
           WHEN avg_km < 4000  THEN '3000-3999'
           WHEN avg_km < 5000  THEN '4000-4999'
           WHEN avg_km < 6000  THEN '5000-5999'
           ELSE                    '6000+'     END AS dist_range
  FROM   avg_pair)
SELECT dist_range,
       COUNT(*) AS pair_cnt
FROM   bucketed
GROUP  BY dist_range
ORDER  BY pair_cnt ASC
LIMIT  20;
```

Running the last query over the complete data set shows that the distance range with the fewest unique city-pairs is **‘5000-5999’**, containing only **1** such pair.
