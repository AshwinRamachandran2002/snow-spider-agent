Query:
-- 7. Compute distance (km) for every individual flight, using haversine
WITH c AS (
  SELECT a."airport_code",
         CAST(SUBSTR(a."coordinates", 2,
                     INSTR(a."coordinates", ',') - 2) AS REAL)  AS lon,
         CAST(SUBSTR(a."coordinates",
                     INSTR(a."coordinates", ',') + 1,
                     INSTR(a."coordinates", ')') -
                     INSTR(a."coordinates", ',') - 1) AS REAL)  AS lat,
         json_extract(a."city", '$.en')               AS city_en
  FROM   "airports_data" AS a)
SELECT DISTINCT f."flight_id",
       c1.city_en AS dep_city,
       c2.city_en AS arr_city,
       6371 *
       ACOS( COS(RADIANS(c1.lat)) * COS(RADIANS(c2.lat)) *
             COS(RADIANS(c2.lon) - RADIANS(c1.lon)) +
             SIN(RADIANS(c1.lat)) * SIN(RADIANS(c2.lat)) ) AS km
FROM   "flights" AS f
JOIN   c AS c1 ON c1."airport_code" = f."departure_airport"
JOIN   c AS c2 ON c2."airport_code" = f."arrival_airport"
LIMIT 20;
