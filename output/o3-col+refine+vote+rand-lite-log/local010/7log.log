```sql
--Description: join each flight with its departure and arrival airports,
--convert the POINT text to longitude/latitude once (same column aliases lon/lat),
--compute great-circle distance using the Haversine formula, collapse the two
--directions into a single alphabetically ordered city-pair (city_a, city_b),
--and finally average the distance for every unique pair.  LIMIT 20 just to
--preview the result.
WITH route_dist AS (
    SELECT
        CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
             THEN json_extract(dep.city,'$.en')
             ELSE json_extract(arr.city,'$.en') END AS city_a,
        CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
             THEN json_extract(arr.city,'$.en')
             ELSE json_extract(dep.city,'$.en') END AS city_b,
        ROUND(
            6371 * 2 * ASIN(
                SQRT(
                    POWER(SIN((radians(arr.lat) - radians(dep.lat)) / 2), 2) +
                    COS(radians(dep.lat)) * COS(radians(arr.lat)) *
                    POWER(SIN((radians(arr.lon) - radians(dep.lon)) / 2), 2)
                )
            ), 0
        ) AS dist_km
    FROM flights AS f
    JOIN (
        SELECT airport_code,
               city,
               CAST(SUBSTR(coordinates, 2, instr(coordinates, ',') - 2) AS REAL) AS lon,
               CAST(SUBSTR(coordinates, instr(coordinates, ',') + 1,
                            LENGTH(coordinates) - instr(coordinates, ',') - 1) AS REAL) AS lat
        FROM airports_data
    ) AS dep  ON dep.airport_code = f.departure_airport
    JOIN (
        SELECT airport_code,
               city,
               CAST(SUBSTR(coordinates, 2, instr(coordinates, ',') - 2) AS REAL) AS lon,
               CAST(SUBSTR(coordinates, instr(coordinates, ',') + 1,
                            LENGTH(coordinates) - instr(coordinates, ',') - 1) AS REAL) AS lat
        FROM airports_data
    ) AS arr  ON arr.airport_code = f.arrival_airport
)
SELECT city_a,
       city_b,
       AVG(dist_km) AS avg_dist
FROM   route_dist
GROUP  BY city_a, city_b
LIMIT 20;
```
