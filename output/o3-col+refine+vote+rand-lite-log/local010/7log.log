```sql
--Description: Step 7 – create each city-pair’s averaged distance (city_pairs)
--and bucket those averages into 0-999, 1000-1999, … , 6000+; finally count how
--many pairs fall in every bucket (LIMIT 20 just to inspect the result).
WITH route_dist AS (          -- distance for every individual flight
    SELECT
        CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
             THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city_a,
        CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
             THEN json_extract(arr.city,'$.en') ELSE json_extract(dep.city,'$.en') END AS city_b,
        ROUND(
            6371 * 2 * ASIN(
                SQRT(
                    POWER(SIN((radians(arr.lat) - radians(dep.lat))/2),2) +
                    COS(radians(dep.lat)) * COS(radians(arr.lat)) *
                    POWER(SIN((radians(arr.lon) - radians(dep.lon))/2),2)
                )
            ),0
        ) AS dist_km
    FROM flights AS f
    JOIN (
        SELECT airport_code,
               city,
               CAST(SUBSTR(coordinates,2, instr(coordinates,',' )-2) AS REAL) AS lon,
               CAST(SUBSTR(coordinates, instr(coordinates,',')+1,
                            LENGTH(coordinates)-instr(coordinates,',')-1) AS REAL) AS lat
        FROM airports_data
    ) AS dep ON dep.airport_code = f.departure_airport
    JOIN (
        SELECT airport_code,
               city,
               CAST(SUBSTR(coordinates,2, instr(coordinates,',' )-2) AS REAL) AS lon,
               CAST(SUBSTR(coordinates, instr(coordinates,',')+1,
                            LENGTH(coordinates)-instr(coordinates,',')-1) AS REAL) AS lat
        FROM airports_data
    ) AS arr ON arr.airport_code = f.arrival_airport
),
city_pairs AS (               -- average distance for each unordered city pair
    SELECT city_a,
           city_b,
           AVG(dist_km) AS avg_dist
    FROM   route_dist
    GROUP  BY city_a, city_b
)
SELECT CASE
         WHEN avg_dist < 1000 THEN '0-999'
         WHEN avg_dist < 2000 THEN '1000-1999'
         WHEN avg_dist < 3000 THEN '2000-2999'
         WHEN avg_dist < 4000 THEN '3000-3999'
         WHEN avg_dist < 5000 THEN '4000-4999'
         WHEN avg_dist < 6000 THEN '5000-5999'
         ELSE                     '6000+'
       END      AS dist_range,
       COUNT(*) AS pair_cnt
FROM   city_pairs
GROUP  BY dist_range
ORDER  BY dist_range
LIMIT 20;
```

