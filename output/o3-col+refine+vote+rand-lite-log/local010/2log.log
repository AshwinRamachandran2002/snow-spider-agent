```sql
-- Description: show all distinct city names (English) available in the airports list
SELECT DISTINCT
       city ->> 'en' AS city_en
FROM   airports_data
LIMIT 20;
```

```sql
-- Description: list a few flights together with the (English) names of their departure/arrival cities
SELECT f.flight_id,
       f.departure_airport,
       dep.city ->> 'en' AS dep_city,
       f.arrival_airport,
       arr.city ->> 'en' AS arr_city
FROM   flights        AS f
JOIN   airports_data  AS dep ON dep.airport_code = f.departure_airport
JOIN   airports_data  AS arr ON arr.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- Description: calculate the great-circle distance (km) for 20 sample flights
SELECT f.flight_id,
       dep.city ->> 'en' AS dep_city,
       arr.city ->> 'en' AS arr_city,
       6371 *
       acos(
            cos(radians(dep.coordinates[1])) *
            cos(radians(arr.coordinates[1])) *
            cos(radians(arr.coordinates[0]) - radians(dep.coordinates[0])) +
            sin(radians(dep.coordinates[1])) *
            sin(radians(arr.coordinates[1]))
       ) AS distance_km
FROM   flights        AS f
JOIN   airports_data  AS dep ON dep.airport_code = f.departure_airport
JOIN   airports_data  AS arr ON arr.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- Description: create a symmetric key (city1, city2) so a↔b and b↔a are the same pair
SELECT LEAST(dep.city ->> 'en', arr.city ->> 'en') AS city1,
       GREATEST(dep.city ->> 'en', arr.city ->> 'en') AS city2
FROM   flights        AS f
JOIN   airports_data  AS dep ON dep.airport_code = f.departure_airport
JOIN   airports_data  AS arr ON arr.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- Description: average distance for every unique (unordered) city pair
SELECT LEAST(dep.city ->> 'en', arr.city ->> 'en')  AS city1,
       GREATEST(dep.city ->> 'en', arr.city ->> 'en') AS city2,
       AVG(
           6371 *
           acos(
                cos(radians(dep.coordinates[1])) *
                cos(radians(arr.coordinates[1])) *
                cos(radians(arr.coordinates[0]) - radians(dep.coordinates[0])) +
                sin(radians(dep.coordinates[1])) *
                sin(radians(arr.coordinates[1]))
           )
       ) AS avg_distance_km
FROM   flights        AS f
JOIN   airports_data  AS dep ON dep.airport_code = f.departure_airport
JOIN   airports_data  AS arr ON arr.airport_code = f.arrival_airport
GROUP  BY city1, city2
LIMIT 20;
```

```sql
-- Description: attach each city pair to the required distance bucket
SELECT city1,
       city2,
       avg_distance_km,
       CASE
            WHEN avg_distance_km < 1000 THEN '0-999'
            WHEN avg_distance_km < 2000 THEN '1000-1999'
            WHEN avg_distance_km < 3000 THEN '2000-2999'
            WHEN avg_distance_km < 4000 THEN '3000-3999'
            WHEN avg_distance_km < 5000 THEN '4000-4999'
            WHEN avg_distance_km < 6000 THEN '5000-5999'
            ELSE '6000+'
       END AS distance_range
FROM (
      SELECT LEAST(dep.city ->> 'en', arr.city ->> 'en')  AS city1,
             GREATEST(dep.city ->> 'en', arr.city ->> 'en') AS city2,
             AVG(
                 6371 *
                 acos(
                      cos(radians(dep.coordinates[1])) *
                      cos(radians(arr.coordinates[1])) *
                      cos(radians(arr.coordinates[0]) - radians(dep.coordinates[0])) +
                      sin(radians(dep.coordinates[1])) *
                      sin(radians(arr.coordinates[1]))
                 )
             ) AS avg_distance_km
      FROM   flights        AS f
      JOIN   airports_data  AS dep ON dep.airport_code = f.departure_airport
      JOIN   airports_data  AS arr ON arr.airport_code = f.arrival_airport
      GROUP  BY city1, city2
) t
LIMIT 20;
```

