```sql
--Description: create a symmetric key (city1, city2) so A↔B and B↔A are the same pair (uses json_extract; no point-array syntax)
SELECT
       CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
            THEN json_extract(dep.city,'$.en')
            ELSE json_extract(arr.city,'$.en') END AS city1,
       CASE WHEN json_extract(dep.city,'$.en') > json_extract(arr.city,'$.en')
            THEN json_extract(dep.city,'$.en')
            ELSE json_extract(arr.city,'$.en') END AS city2
FROM   flights       AS f
JOIN   airports_data AS dep ON dep.airport_code = f.departure_airport
JOIN   airports_data AS arr ON arr.airport_code = f.arrival_airport
LIMIT 20;
