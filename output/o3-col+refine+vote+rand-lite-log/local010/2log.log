```sql
--Description: average distance (km) for every unique, unordered city pair – point text is parsed, radians via *π/180
WITH flight_dist AS (
  SELECT
        CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
             THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city1,
        CASE WHEN json_extract(dep.city,'$.en') > json_extract(arr.city,'$.en')
             THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city2,
        /* dep lon/lat */
        CAST(substr(dep.coordinates, 2,
             instr(dep.coordinates, ',') - 2) AS REAL) AS dep_lon,
        CAST(substr(dep.coordinates,
             instr(dep.coordinates, ',') + 1,
             length(dep.coordinates) - instr(dep.coordinates, ',') - 1) AS REAL) AS dep_lat,
        /* arr lon/lat */
        CAST(substr(arr.coordinates, 2,
             instr(arr.coordinates, ',') - 2) AS REAL) AS arr_lon,
        CAST(substr(arr.coordinates,
             instr(arr.coordinates, ',') + 1,
             length(arr.coordinates) - instr(arr.coordinates, ',') - 1) AS REAL) AS arr_lat
  FROM   flights       AS f
  JOIN   airports_data AS dep ON dep.airport_code = f.departure_airport
  JOIN   airports_data AS arr ON arr.airport_code = f.arrival_airport
)
SELECT
    city1,
    city2,
    AVG(
        6371.0 * acos(
            cos(dep_lat * 0.0174532925199433) *
            cos(arr_lat * 0.0174532925199433) *
            cos((arr_lon - dep_lon) * 0.0174532925199433) +
            sin(dep_lat * 0.0174532925199433) *
            sin(arr_lat * 0.0174532925199433)
        )
    ) AS avg_distance_km
FROM flight_dist
GROUP BY city1, city2
LIMIT 20;
```

```sql
--Description: attach each city pair to the required distance bucket (0-999, 1000-1999 … 6000+)
WITH pair_dist AS (
  SELECT
        CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
             THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city1,
        CASE WHEN json_extract(dep.city,'$.en') > json_extract(arr.city,'$.en')
             THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city2,
        6371.0 * acos(
            cos(dep_lat * 0.0174532925199433) *
            cos(arr_lat * 0.0174532925199433) *
            cos((arr_lon - dep_lon) * 0.0174532925199433) +
            sin(dep_lat * 0.0174532925199433) *
            sin(arr_lat * 0.0174532925199433)
        ) AS distance_km
  FROM (
        SELECT f.*,
               /* dep lon/lat */
               CAST(substr(dep.coordinates, 2,
                    instr(dep.coordinates, ',') - 2) AS REAL) AS dep_lon,
               CAST(substr(dep.coordinates,
                    instr(dep.coordinates, ',') + 1,
                    length(dep.coordinates) - instr(dep.coordinates, ',') - 1) AS REAL) AS dep_lat,
               /* arr lon/lat */
               CAST(substr(arr.coordinates, 2,
                    instr(arr.coordinates, ',') - 2) AS REAL) AS arr_lon,
               CAST(substr(arr.coordinates,
                    instr(arr.coordinates, ',') + 1,
                    length(arr.coordinates) - instr(arr.coordinates, ',') - 1) AS REAL) AS arr_lat,
               dep.city AS dep_city_json,
               arr.city AS arr_city_json
        FROM   flights       AS f
        JOIN   airports_data AS dep ON dep.airport_code = f.departure_airport
        JOIN   airports_data AS arr ON arr.airport_code = f.arrival_airport
  ) AS t
  CROSS JOIN json_each(dep_city_json)  /* dummy to use dep_city_json in outer SELECT */
  CROSS JOIN json_each(arr_city_json)  /* dummy to use arr_city_json */
)
SELECT
    city1,
    city2,
    AVG(distance_km) AS avg_distance_km,
    CASE
         WHEN AVG(distance_km) < 1000 THEN '0-999'
         WHEN AVG(distance_km) < 2000 THEN '1000-1999'
         WHEN AVG(distance_km) < 3000 THEN '2000-2999'
         WHEN AVG(distance_km) < 4000 THEN '3000-3999'
         WHEN AVG(distance_km) < 5000 THEN '4000-4999'
         WHEN AVG(distance_km) < 6000 THEN '5000-5999'
         ELSE '6000+'
    END AS distance_range
FROM pair_dist
GROUP BY city1, city2
LIMIT 20;
```

```sql
--Description: count how many unique city pairs fall into each distance bucket
WITH pair_avg AS (
  /* compute average distance per unordered pair */
  SELECT
        city1,
        city2,
        AVG(distance_km) AS avg_distance_km
  FROM (
       SELECT
           CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
                THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city1,
           CASE WHEN json_extract(dep.city,'$.en') > json_extract(arr.city,'$.en')
                THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city2,
           6371.0 * acos(
                cos(dep_lat * 0.0174532925199433) *
                cos(arr_lat * 0.0174532925199433) *
                cos((arr_lon - dep_lon) * 0.0174532925199433) +
                sin(dep_lat * 0.0174532925199433) *
                sin(arr_lat * 0.0174532925199433)
           ) AS distance_km
       FROM (
            SELECT f.*,
                   CAST(substr(dep.coordinates, 2,
                        instr(dep.coordinates, ',') - 2) AS REAL) AS dep_lon,
                   CAST(substr(dep.coordinates,
                        instr(dep.coordinates, ',') + 1,
                        length(dep.coordinates) - instr(dep.coordinates, ',') - 1) AS REAL) AS dep_lat,
                   CAST(substr(arr.coordinates, 2,
                        instr(arr.coordinates, ',') - 2) AS REAL) AS arr_lon,
                   CAST(substr(arr.coordinates,
                        instr(arr.coordinates, ',') + 1,
                        length(arr.coordinates) - instr(arr.coordinates, ',') - 1) AS REAL) AS arr_lat
            FROM   flights       AS f
            JOIN   airports_data AS dep ON dep.airport_code = f.departure_airport
            JOIN   airports_data AS arr ON arr.airport_code = f.arrival_airport
       )
  )
  GROUP BY city1, city2
)
SELECT
    CASE
         WHEN avg_distance_km < 1000 THEN '0-999'
         WHEN avg_distance_km < 2000 THEN '1000-1999'
         WHEN avg_distance_km < 3000 THEN '2000-2999'
         WHEN avg_distance_km < 4000 THEN '3000-3999'
         WHEN avg_distance_km < 5000 THEN '4000-4999'
         WHEN avg_distance_km < 6000 THEN '5000-5999'
         ELSE '6000+'
    END AS distance_range,
    COUNT(*) AS pair_cnt
FROM pair_avg
GROUP BY distance_range
ORDER BY distance_range;
```

```sql
--Description: fewest unique city pairs present in any of the defined distance buckets
WITH pair_avg AS (
  /* average distance per unordered pair */
  SELECT
        city1,
        city2,
        AVG(distance_km) AS avg_distance_km
  FROM (
       SELECT
           CASE WHEN json_extract(dep.city,'$.en') < json_extract(arr.city,'$.en')
                THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city1,
           CASE WHEN json_extract(dep.city,'$.en') > json_extract(arr.city,'$.en')
                THEN json_extract(dep.city,'$.en') ELSE json_extract(arr.city,'$.en') END AS city2,
           6371.0 * acos(
                cos(dep_lat * 0.0174532925199433) *
                cos(arr_lat * 0.0174532925199433) *
                cos((arr_lon - dep_lon) * 0.0174532925199433) +
                sin(dep_lat * 0.0174532925199433) *
                sin(arr_lat * 0.0174532925199433)
           ) AS distance_km
       FROM (
            SELECT f.*,
                   CAST(substr(dep.coordinates, 2,
                        instr(dep.coordinates, ',') - 2) AS REAL) AS dep_lon,
                   CAST(substr(dep.coordinates,
                        instr(dep.coordinates, ',') + 1,
                        length(dep.coordinates) - instr(dep.coordinates, ',') - 1) AS REAL) AS dep_lat,
                   CAST(substr(arr.coordinates, 2,
                        instr(arr.coordinates, ',') - 2) AS REAL) AS arr_lon,
                   CAST(substr(arr.coordinates,
                        instr(arr.coordinates, ',') + 1,
                        length(arr.coordinates) - instr(arr.coordinates, ',') - 1) AS REAL) AS arr_lat
            FROM   flights       AS f
            JOIN   airports_data AS dep ON dep.airport_code = f.departure_airport
            JOIN   airports_data AS arr ON arr.airport_code = f.arrival_airport
       )
  )
  GROUP BY city1, city2
),
bucket_counts AS (
  SELECT
      CASE
           WHEN avg_distance_km < 1000 THEN '0-999'
           WHEN avg_distance_km < 2000 THEN '1000-1999'
           WHEN avg_distance_km < 3000 THEN '2000-2999'
           WHEN avg_distance_km < 4000 THEN '3000-3999'
           WHEN avg_distance_km < 5000 THEN '4000-4999'
           WHEN avg_distance_km < 6000 THEN '5000-5999'
           ELSE '6000+'
      END AS distance_range,
      COUNT(*) AS pair_cnt
  FROM pair_avg
  GROUP BY distance_range
)
SELECT MIN(pair_cnt) AS fewest_pairs
FROM   bucket_counts;
```
