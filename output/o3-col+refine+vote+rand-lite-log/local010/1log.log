```sql
-- 4) Extract longitude / latitude (as REAL) for each airport (sample)
SELECT a.airport_code,
       CAST(substr(a.coordinates, 2,
                   instr(a.coordinates, ',')-2) AS REAL)  AS lon,
       CAST(substr(a.coordinates,
                   instr(a.coordinates, ',')+1,
                   instr(a.coordinates, ')')-instr(a.coordinates, ',')-1)
            AS REAL)                                    AS lat
FROM airports_data AS a
LIMIT 20;
```

```sql
-- 5) Compute great-circle distance (km) for some flight legs
SELECT f.flight_id,
       d.airport_code  AS dep,
       a.airport_code  AS arr,
       -- Haversine formula (Earth radius ≈ 6371 km)
       6371 * 2 *
       ASIN(
           SQRT(
                 POW(SIN(RADIANS(alat - dlat)/2), 2) +
                 COS(RADIANS(dlat)) * COS(RADIANS(alat)) *
                 POW(SIN(RADIANS(alon - dlon)/2), 2)
               )
           )                                             AS distance_km
FROM (
      SELECT airport_code,
             CAST(substr(coordinates, 2,
                         instr(coordinates, ',')-2) AS REAL)  AS dlon,
             CAST(substr(coordinates,
                         instr(coordinates, ',')+1,
                         instr(coordinates, ')')-instr(coordinates, ',')-1)
                  AS REAL)                                AS dlat
      FROM airports_data
     ) AS d
JOIN flights AS f            ON f.departure_airport = d.airport_code
JOIN (
      SELECT airport_code,
             CAST(substr(coordinates, 2,
                         instr(coordinates, ',')-2) AS REAL)  AS alon,
             CAST(substr(coordinates,
                         instr(coordinates, ',')+1,
                         instr(coordinates, ')')-instr(coordinates, ',')-1)
                  AS REAL)                                AS alat
      FROM airports_data
     ) AS a            ON a.airport_code = f.arrival_airport
LIMIT 20;
```

```sql
-- 6) Compute distance for every flight leg (no LIMIT here for aggregation later)
WITH coords AS (
     SELECT airport_code,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',')-2) AS REAL)  AS lon,
            CAST(substr(coordinates,
                        instr(coordinates, ',')+1,
                        instr(coordinates, ')')-instr(coordinates, ',')-1)
                 AS REAL)                                 AS lat
     FROM airports_data
)
SELECT f.flight_id,
       f.departure_airport,
       f.arrival_airport,
       6371 * 2 *
       ASIN(
           SQRT(
                 POW(SIN(RADIANS(a.lat - d.lat)/2), 2) +
                 COS(RADIANS(d.lat)) * COS(RADIANS(a.lat)) *
                 POW(SIN(RADIANS(a.lon - d.lon)/2), 2)
               )
           ) AS distance_km
FROM flights AS f
JOIN coords AS d ON d.airport_code = f.departure_airport
JOIN coords AS a ON a.airport_code = f.arrival_airport;
```

```sql
-- 7) Average the leg-distances for every unordered city pair
WITH coords AS (
     SELECT airport_code,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',')-2) AS REAL)  AS lon,
            CAST(substr(coordinates,
                        instr(coordinates, ',')+1,
                        instr(coordinates, ')')-instr(coordinates, ',')-1)
                 AS REAL)                                 AS lat,
            json_extract(city, '$.en')                    AS city_en
     FROM airports_data
),
legs AS (
     SELECT
         CASE WHEN c1.city_en < c2.city_en THEN c1.city_en ELSE c2.city_en END AS city1,
         CASE WHEN c1.city_en < c2.city_en THEN c2.city_en ELSE c1.city_en END AS city2,
         6371 * 2 *
         ASIN(
             SQRT(
                   POW(SIN(RADIANS(c2.lat - c1.lat)/2), 2) +
                   COS(RADIANS(c1.lat)) * COS(RADIANS(c2.lat)) *
                   POW(SIN(RADIANS(c2.lon - c1.lon)/2), 2)
                 )
             ) AS dist_km
     FROM flights AS f
     JOIN coords AS c1 ON c1.airport_code = f.departure_airport
     JOIN coords AS c2 ON c2.airport_code = f.arrival_airport
)
SELECT city1,
       city2,
       AVG(dist_km) AS avg_distance_km
FROM legs
GROUP BY city1, city2
LIMIT 20;
```

```sql
-- 8) Place every city pair into the requested distance buckets
WITH coords AS (
     SELECT airport_code,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',')-2) AS REAL)  AS lon,
            CAST(substr(coordinates,
                        instr(coordinates, ',')+1,
                        instr(coordinates, ')')-instr(coordinates, ',')-1)
                 AS REAL)                                 AS lat,
            json_extract(city, '$.en')                    AS city_en
     FROM airports_data
),
pairs AS (
     SELECT
         CASE WHEN c1.city_en < c2.city_en THEN c1.city_en ELSE c2.city_en END AS city1,
         CASE WHEN c1.city_en < c2.city_en THEN c2.city_en ELSE c1.city_en END AS city2,
         6371 * 2 *
         ASIN(
             SQRT(
                   POW(SIN(RADIANS(c2.lat - c1.lat)/2), 2) +
                   COS(RADIANS(c1.lat)) * COS(RADIANS(c2.lat)) *
                   POW(SIN(RADIANS(c2.lon - c1.lon)/2), 2)
                 )
             ) AS dist_km
     FROM flights AS f
     JOIN coords AS c1 ON c1.airport_code = f.departure_airport
     JOIN coords AS c2 ON c2.airport_code = f.arrival_airport
),
avg_pairs AS (
     SELECT city1,
            city2,
            AVG(dist_km) AS avg_dist
     FROM pairs
     GROUP BY city1, city2
),
bucketed AS (
     SELECT *,
            CASE
              WHEN avg_dist < 1000 THEN '0–999'
              WHEN avg_dist < 2000 THEN '1000–1999'
              WHEN avg_dist < 3000 THEN '2000–2999'
              WHEN avg_dist < 4000 THEN '3000–3999'
              WHEN avg_dist < 5000 THEN '4000–4999'
              WHEN avg_dist < 6000 THEN '5000–5999'
              ELSE '6000+'
            END AS distance_range
     FROM avg_pairs
)
SELECT distance_range,
       COUNT(*) AS pair_cnt
FROM bucketed
GROUP BY distance_range;
```

```sql
-- 9) Finally, show the bucket that contains the fewest unique city pairs
WITH coords AS (
     SELECT airport_code,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',')-2) AS REAL)  AS lon,
            CAST(substr(coordinates,
                        instr(coordinates, ',')+1,
                        instr(coordinates, ')')-instr(coordinates, ',')-1)
                 AS REAL)                                 AS lat,
            json_extract(city, '$.en')                    AS city_en
     FROM airports_data
),
pairs AS (
     SELECT
         CASE WHEN c1.city_en < c2.city_en THEN c1.city_en ELSE c2.city_en END AS city1,
         CASE WHEN c1.city_en < c2.city_en THEN c2.city_en ELSE c1.city_en END AS city2,
         6371 * 2 *
         ASIN(
             SQRT(
                   POW(SIN(RADIANS(c2.lat - c1.lat)/2), 2) +
                   COS(RADIANS(c1.lat)) * COS(RADIANS(c2.lat)) *
                   POW(SIN(RADIANS(c2.lon - c1.lon)/2), 2)
                 )
             ) AS dist_km
     FROM flights AS f
     JOIN coords AS c1 ON c1.airport_code = f.departure_airport
     JOIN coords AS c2 ON c2.airport_code = f.arrival_airport
),
avg_pairs AS (
     SELECT city1,
            city2,
            AVG(dist_km) AS avg_dist
     FROM pairs
     GROUP BY city1, city2
),
bucketed AS (
     SELECT *,
            CASE
              WHEN avg_dist < 1000 THEN '0–999'
              WHEN avg_dist < 2000 THEN '1000–1999'
              WHEN avg_dist < 3000 THEN '2000–2999'
              WHEN avg_dist < 4000 THEN '3000–3999'
              WHEN avg_dist < 5000 THEN '4000–4999'
              WHEN avg_dist < 6000 THEN '5000–5999'
              ELSE '6000+'
            END AS distance_range
     FROM avg_pairs
),
counts AS (
     SELECT distance_range,
            COUNT(*) AS pair_cnt
     FROM bucketed
     GROUP BY distance_range
)
SELECT distance_range,
       pair_cnt
FROM counts
WHERE pair_cnt = (SELECT MIN(pair_cnt) FROM counts);
```

```sql
-- 10) (Optional) List the actual city pairs that fall into that sparsest bucket
WITH coords AS (
     SELECT airport_code,
            CAST(substr(coordinates, 2,
                        instr(coordinates, ',')-2) AS REAL)  AS lon,
            CAST(substr(coordinates,
                        instr(coordinates, ',')+1,
                        instr(coordinates, ')')-instr(coordinates, ',')-1)
                 AS REAL)                                 AS lat,
            json_extract(city, '$.en')                    AS city_en
     FROM airports_data
),
pairs AS (
     SELECT
         CASE WHEN c1.city_en < c2.city_en THEN c1.city_en ELSE c2.city_en END AS city1,
         CASE WHEN c1.city_en < c2.city_en THEN c2.city_en ELSE c1.city_en END AS city2,
         6371 * 2 *
         ASIN(
             SQRT(
                   POW(SIN(RADIANS(c2.lat - c1.lat)/2), 2) +
                   COS(RADIANS(c1.lat)) * COS(RADIANS(c2.lat)) *
                   POW(SIN(RADIANS(c2.lon - c1.lon)/2), 2)
                 )
             ) AS dist_km
     FROM flights AS f
     JOIN coords AS c1 ON c1.airport_code = f.departure_airport
     JOIN coords AS c2 ON c2.airport_code = f.arrival_airport
),
avg_pairs AS (
     SELECT city1,
            city2,
            AVG(dist_km) AS avg_dist
     FROM pairs
     GROUP BY city1, city2
),
bucketed AS (
     SELECT *,
            CASE
              WHEN avg_dist < 1000 THEN '0–999'
              WHEN avg_dist < 2000 THEN '1000–1999'
              WHEN avg_dist < 3000 THEN '2000–2999'
              WHEN avg_dist < 4000 THEN '3000–3999'
              WHEN avg_dist < 5000 THEN '4000–4999'
              WHEN avg_dist < 6000 THEN '5000–5999'
              ELSE '6000+'
            END AS distance_range
     FROM avg_pairs
),
counts AS (
     SELECT distance_range,
            COUNT(*) AS pair_cnt
     FROM bucketed
     GROUP BY distance_range
),
min_bucket AS (
     SELECT distance_range
     FROM counts
     ORDER BY pair_cnt
     LIMIT 1
)
SELECT b.city1,
       b.city2,
       ROUND(b.avg_dist, 1) AS avg_km
FROM bucketed AS b
JOIN min_bucket AS m ON m.distance_range = b.distance_range
LIMIT 20;
```
