```sql
--Description: Join flights with both airports to show 20 flights together with their English city names.
SELECT f."flight_id",
       json_extract(dep."city", '$.en') AS "dep_city",
       json_extract(arr."city", '$.en') AS "arr_city"
FROM   "flights"         AS f
JOIN   "airports_data"   AS dep ON dep."airport_code" = f."departure_airport"
JOIN   "airports_data"   AS arr ON arr."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
--Description: Calculate great-circle distance (km) for 20 flights using the haversine formula.
WITH coords AS (
    SELECT "airport_code",
           CAST(SUBSTR("coordinates", 2,
                       INSTR("coordinates", ',') - 2)                  AS REAL) AS lon,
           CAST(SUBSTR("coordinates",
                       INSTR("coordinates", ',') + 1,
                       INSTR("coordinates", ')') - INSTR("coordinates", ',') - 1)
                       AS REAL)                                         AS lat,
           json_extract("city", '$.en')                                 AS city_en
    FROM   "airports_data"
)
SELECT f."flight_id",
       dep.city_en                           AS "dep_city",
       arr.city_en                           AS "arr_city",
       6371 *
       ACOS( SIN(dep.lat*3.141592653589793/180) * SIN(arr.lat*3.141592653589793/180) +
             COS(dep.lat*3.141592653589793/180) * COS(arr.lat*3.141592653589793/180) *
             COS((arr.lon-dep.lon)*3.141592653589793/180) )            AS "distance_km"
FROM   "flights" AS f
JOIN   coords     AS dep ON dep."airport_code" = f."departure_airport"
JOIN   coords     AS arr ON arr."airport_code" = f."arrival_airport"
LIMIT 20;
```

```sql
--Description: Work out the average distance for every unordered city-pair (A,B) – showing 20 pairs.
WITH coords AS (
    SELECT "airport_code",
           CAST(SUBSTR("coordinates", 2,
                       INSTR("coordinates", ',') - 2)                  AS REAL) AS lon,
           CAST(SUBSTR("coordinates",
                       INSTR("coordinates", ',') + 1,
                       INSTR("coordinates", ')') - INSTR("coordinates", ',') - 1)
                       AS REAL)                                         AS lat,
           json_extract("city", '$.en')                                 AS city_en
    FROM   "airports_data"
),
dists AS (
    SELECT CASE WHEN dep.city_en < arr.city_en THEN dep.city_en ELSE arr.city_en END AS city_a,
           CASE WHEN dep.city_en < arr.city_en THEN arr.city_en ELSE dep.city_en END AS city_b,
           6371 *
           ACOS( SIN(dep.lat*3.141592653589793/180) * SIN(arr.lat*3.141592653589793/180) +
                 COS(dep.lat*3.141592653589793/180) * COS(arr.lat*3.141592653589793/180) *
                 COS((arr.lon-dep.lon)*3.141592653589793/180) )          AS distance_km
    FROM   "flights" AS f
    JOIN   coords     AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   coords     AS arr ON arr."airport_code" = f."arrival_airport"
)
SELECT "city_a",
       "city_b",
       AVG("distance_km") AS "avg_distance_km"
FROM   dists
GROUP  BY "city_a", "city_b"
LIMIT 20;
```

```sql
--Description: Put every city-pair into a 0,1000,2000,3000,4000,5000,6000+ distance bucket (20 rows shown).
WITH coords AS (
    SELECT "airport_code",
           CAST(SUBSTR("coordinates", 2,
                       INSTR("coordinates", ',') - 2)                  AS REAL) AS lon,
           CAST(SUBSTR("coordinates",
                       INSTR("coordinates", ',') + 1,
                       INSTR("coordinates", ')') - INSTR("coordinates", ',') - 1)
                       AS REAL)                                         AS lat,
           json_extract("city", '$.en')                                 AS city_en
    FROM   "airports_data"
),
dists AS (
    SELECT CASE WHEN dep.city_en < arr.city_en THEN dep.city_en ELSE arr.city_en END AS city_a,
           CASE WHEN dep.city_en < arr.city_en THEN arr.city_en ELSE dep.city_en END AS city_b,
           6371 *
           ACOS( SIN(dep.lat*3.141592653589793/180) * SIN(arr.lat*3.141592653589793/180) +
                 COS(dep.lat*3.141592653589793/180) * COS(arr.lat*3.141592653589793/180) *
                 COS((arr.lon-dep.lon)*3.141592653589793/180) )          AS distance_km
    FROM   "flights" AS f
    JOIN   coords     AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   coords     AS arr ON arr."airport_code" = f."arrival_airport"
),
avg_pair AS (
    SELECT city_a,
           city_b,
           AVG(distance_km) AS avg_distance
    FROM   dists
    GROUP  BY city_a, city_b
)
SELECT city_a,
       city_b,
       avg_distance,
       CASE
         WHEN avg_distance < 1000 THEN '0-999'
         WHEN avg_distance < 2000 THEN '1000-1999'
         WHEN avg_distance < 3000 THEN '2000-2999'
         WHEN avg_distance < 4000 THEN '3000-3999'
         WHEN avg_distance < 5000 THEN '4000-4999'
         WHEN avg_distance < 6000 THEN '5000-5999'
         ELSE '6000+'
       END AS "distance_bucket"
FROM   avg_pair
LIMIT 20;
```

```sql
--Description: Count how many unique city-pairs fall into every distance bucket.
WITH coords AS (
    SELECT "airport_code",
           CAST(SUBSTR("coordinates", 2,
                       INSTR("coordinates", ',') - 2)                  AS REAL) AS lon,
           CAST(SUBSTR("coordinates",
                       INSTR("coordinates", ',') + 1,
                       INSTR("coordinates", ')') - INSTR("coordinates", ',') - 1)
                       AS REAL)                                         AS lat,
           json_extract("city", '$.en')                                 AS city_en
    FROM   "airports_data"
),
dists AS (
    SELECT CASE WHEN dep.city_en < arr.city_en THEN dep.city_en ELSE arr.city_en END AS city_a,
           CASE WHEN dep.city_en < arr.city_en THEN arr.city_en ELSE dep.city_en END AS city_b,
           6371 *
           ACOS( SIN(dep.lat*3.141592653589793/180) * SIN(arr.lat*3.141592653589793/180) +
                 COS(dep.lat*3.141592653589793/180) * COS(arr.lat*3.141592653589793/180) *
                 COS((arr.lon-dep.lon)*3.141592653589793/180) )          AS distance_km
    FROM   "flights" AS f
    JOIN   coords     AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   coords     AS arr ON arr."airport_code" = f."arrival_airport"
),
avg_pair AS (
    SELECT city_a,
           city_b,
           AVG(distance_km) AS avg_distance
    FROM   dists
    GROUP  BY city_a, city_b
),
bucketed AS (
    SELECT CASE
             WHEN avg_distance < 1000 THEN '0-999'
             WHEN avg_distance < 2000 THEN '1000-1999'
             WHEN avg_distance < 3000 THEN '2000-2999'
             WHEN avg_distance < 4000 THEN '3000-3999'
             WHEN avg_distance < 5000 THEN '4000-4999'
             WHEN avg_distance < 6000 THEN '5000-5999'
             ELSE '6000+'
           END AS bucket
    FROM   avg_pair
)
SELECT bucket,
       COUNT(*) AS pair_count
FROM   bucketed
GROUP  BY bucket
ORDER  BY bucket
LIMIT 20;
```

```sql
--Description: Show the bucket(s) that contains the fewest unique city-pairs (final answer).
WITH coords AS (
    SELECT "airport_code",
           CAST(SUBSTR("coordinates", 2,
                       INSTR("coordinates", ',') - 2)                  AS REAL) AS lon,
           CAST(SUBSTR("coordinates",
                       INSTR("coordinates", ',') + 1,
                       INSTR("coordinates", ')') - INSTR("coordinates", ',') - 1)
                       AS REAL)                                         AS lat,
           json_extract("city", '$.en')                                 AS city_en
    FROM   "airports_data"
),
dists AS (
    SELECT CASE WHEN dep.city_en < arr.city_en THEN dep.city_en ELSE arr.city_en END AS city_a,
           CASE WHEN dep.city_en < arr.city_en THEN arr.city_en ELSE dep.city_en END AS city_b,
           6371 *
           ACOS( SIN(dep.lat*3.141592653589793/180) * SIN(arr.lat*3.141592653589793/180) +
                 COS(dep.lat*3.141592653589793/180) * COS(arr.lat*3.141592653589793/180) *
                 COS((arr.lon-dep.lon)*3.141592653589793/180) )          AS distance_km
    FROM   "flights" AS f
    JOIN   coords     AS dep ON dep."airport_code" = f."departure_airport"
    JOIN   coords     AS arr ON arr."airport_code" = f."arrival_airport"
),
avg_pair AS (
    SELECT city_a,
           city_b,
           AVG(distance_km) AS avg_distance
    FROM   dists
    GROUP  BY city_a, city_b
),
bucketed AS (
    SELECT CASE
             WHEN avg_distance < 1000 THEN '0-999'
             WHEN avg_distance < 2000 THEN '1000-1999'
             WHEN avg_distance < 3000 THEN '2000-2999'
             WHEN avg_distance < 4000 THEN '3000-3999'
             WHEN avg_distance < 5000 THEN '4000-4999'
             WHEN avg_distance < 6000 THEN '5000-5999'
             ELSE '6000+'
           END AS bucket
    FROM   avg_pair
),
bucket_counts AS (
    SELECT bucket,
           COUNT(*) AS pair_count
    FROM   bucketed
    GROUP  BY bucket
)
SELECT bucket,
       pair_count
FROM   bucket_counts
WHERE  pair_count = (SELECT MIN(pair_count) FROM bucket_counts)
LIMIT 20;
```
