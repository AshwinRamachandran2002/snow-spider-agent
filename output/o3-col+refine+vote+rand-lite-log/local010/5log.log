```sql
--Description (thinking process in-line):
-- 1) airports_cte       : parse every airport’s coordinates and expose them as
--                         lon / lat in *radians* plus its English city name.
-- 2) flight_geo         : join flights with the two airports (departure & arrival)
--                         so each row contains both geo-points and the two city names.
-- 3) city_pairs_raw     : compute the great-circle distance for every flight by the
--                         Haversine formula (R = 6371 km) and make the city-pair
--                         unordered (alphabetical) so Moscow↔Sochi equals Sochi↔Moscow.
-- 4) avg_pair_distance  : average the distance over all parallel routes that connect
--                         the same unordered pair of cities.
-- 5) bucket_counts      : bucket each pair into the requested distance ranges and
--                         count how many unique pairs fall into every bucket.
-- 6) FINAL SELECT       : return the minimum of those counts — i.e. how many pairs
--                         are in the range that has the fewest city pairs.
WITH airports_cte AS (
     SELECT  airport_code,
             RADIANS(
                 CAST(SUBSTR(coordinates, 2,
                              INSTR(coordinates, ',') - 2) AS REAL)
             ) AS lon,
             RADIANS(
                 CAST(SUBSTR(coordinates,
                              INSTR(coordinates, ',') + 1,
                              LENGTH(coordinates) - INSTR(coordinates, ',') - 1
                             ) AS REAL)
             ) AS lat,
             json_extract(city, '$.en') AS city_en
     FROM    airports_data
),
flight_geo AS (
     SELECT  f.flight_id,
             ad.city_en AS dep_city,
             aa.city_en AS arr_city,
             ad.lon     AS dep_lon,
             ad.lat     AS dep_lat,
             aa.lon     AS arr_lon,
             aa.lat     AS arr_lat
     FROM    flights        AS f
     JOIN    airports_cte   AS ad ON ad.airport_code = f.departure_airport
     JOIN    airports_cte   AS aa ON aa.airport_code = f.arrival_airport
),
city_pairs_raw AS (
     SELECT
            CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city_from,
            CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city_to,
            ROUND(
                  6371 * 2 *
                  ASIN(
                       SQRT(
                             POWER(SIN((arr_lat - dep_lat)/2), 2) +
                             COS(dep_lat) * COS(arr_lat) *
                             POWER(SIN((arr_lon - dep_lon)/2), 2)
                          )
                      )
            , 0) AS distance_km
     FROM   flight_geo
),
avg_pair_distance AS (
     SELECT  city_from,
             city_to,
             AVG(distance_km) AS avg_distance
     FROM    city_pairs_raw
     GROUP   BY city_from, city_to
),
bucket_counts AS (
     SELECT
            CASE
                 WHEN avg_distance < 1000 THEN '0-1000'
                 WHEN avg_distance < 2000 THEN '1000-2000'
                 WHEN avg_distance < 3000 THEN '2000-3000'
                 WHEN avg_distance < 4000 THEN '3000-4000'
                 WHEN avg_distance < 5000 THEN '4000-5000'
                 WHEN avg_distance < 6000 THEN '5000-6000'
                 ELSE                            '6000+'
            END AS bucket,
            COUNT(*) AS pair_cnt
     FROM    avg_pair_distance
     GROUP   BY bucket
)
SELECT MIN(pair_cnt) AS fewest_city_pairs
FROM   bucket_counts;
```
