Below are 10 exploratory SQLite queries (with short descriptions) that lead from the simplest inspection of the data to the final answer.  
Every query is different and uses only the tables that are listed in the task.

```sql
-- 1. Inspect a few airport names and their cities (English versions only)
SELECT DISTINCT 
       json_extract(a.airport_name,'$.en')  AS airport_en, 
       json_extract(a.city,'$.en')          AS city_en
FROM   airports_data AS a
LIMIT 20;
```

```sql
-- 2. Look at the raw coordinate string stored in airports_data
SELECT json_extract(a.airport_name,'$.en') AS airport_en,
       a.coordinates
FROM   airports_data AS a
LIMIT 20;
```

```sql
-- 3. Preview the flights table to be sure airport codes in it match the airports_data table
SELECT DISTINCT departure_airport, arrival_airport
FROM   flights
LIMIT 20;
```

```sql
-- 4. Grab one leg and parse its coordinates into numeric longitude / latitude
SELECT f.flight_id,
       f.departure_airport,
       CAST(SUBSTR(a.coordinates, 2, INSTR(a.coordinates, ',')-2) AS REAL) AS dep_lon,
       CAST(SUBSTR(a.coordinates,
                   INSTR(a.coordinates, ',')+1,
                   LENGTH(a.coordinates)-INSTR(a.coordinates, ',')-1) AS REAL) AS dep_lat
FROM   flights        AS f
JOIN   airports_data  AS a  ON a.airport_code = f.departure_airport
LIMIT 20;
```

```sql
-- 5. Compute the great-circle distance (in km) for each flight
--    The earth radius 6371 km is used in the Haversine formula.
SELECT f.flight_id,
       f.departure_airport,
       f.arrival_airport,
       ROUND( 6371 * 2 * 
              ASIN(
                  SQRT(
                        POWER(SIN( (alb.lat - adb.lat)/2 ), 2) +
                        COS(adb.lat) * COS(alb.lat) * POWER(SIN( (alb.lon - adb.lon)/2 ), 2)
                     )
                  )
       ,0) AS distance_km
FROM (
      SELECT flight_id, departure_airport, arrival_airport,
             RADIANS(CAST(SUBSTR(a.coordinates, 2, INSTR(a.coordinates, ',')-2) AS REAL)) AS lon,
             RADIANS(CAST(SUBSTR(a.coordinates,
                                 INSTR(a.coordinates, ',')+1,
                                 LENGTH(a.coordinates)-INSTR(a.coordinates, ',')-1) AS REAL)) AS lat
      FROM   flights AS f
      JOIN   airports_data AS a ON a.airport_code = f.departure_airport
) AS adb               -- departure airport (b for begin)
JOIN (
      SELECT flight_id, departure_airport, arrival_airport,
             RADIANS(CAST(SUBSTR(a.coordinates, 2, INSTR(a.coordinates, ',')-2) AS REAL)) AS lon,
             RADIANS(CAST(SUBSTR(a.coordinates,
                                 INSTR(a.coordinates, ',')+1,
                                 LENGTH(a.coordinates)-INSTR(a.coordinates, ',')-1) AS REAL)) AS lat
      FROM   flights AS f
      JOIN   airports_data AS a ON a.airport_code = f.arrival_airport
) AS alb               -- arrival airport (l for landing)
     ON alb.flight_id = adb.flight_id
LIMIT 20;
```

```sql
-- 6. Turn every flight into an *unordered* city-pair with its distance
SELECT 
       CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
       CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
       distance_km
FROM  (
      SELECT  json_extract(ad.city,'$.en') AS c1,
              json_extract(aa.city,'$.en') AS c2,
              ROUND( 6371 * 2 * 
                     ASIN(
                         SQRT(
                               POWER(SIN( (alat - dlat)/2 ), 2) +
                               COS(dlat) * COS(alat)*POWER(SIN( (alon - dlon)/2 ), 2)
                            )
                         )
              ,0) AS distance_km
      FROM  (
             SELECT f.flight_id,
                    f.departure_airport,
                    f.arrival_airport,
                    RADIANS(CAST(SUBSTR(d.coordinates, 2, INSTR(d.coordinates, ',')-2) AS REAL)) AS dlon,
                    RADIANS(CAST(SUBSTR(d.coordinates,
                                        INSTR(d.coordinates, ',')+1,
                                        LENGTH(d.coordinates)-INSTR(d.coordinates, ',')-1) AS REAL)) AS dlat,
                    RADIANS(CAST(SUBSTR(a.coordinates, 2, INSTR(a.coordinates, ',')-2) AS REAL)) AS alon,
                    RADIANS(CAST(SUBSTR(a.coordinates,
                                        INSTR(a.coordinates, ',')+1,
                                        LENGTH(a.coordinates)-INSTR(a.coordinates, ',')-1) AS REAL)) AS alat
             FROM   flights        AS f
             JOIN   airports_data  AS d ON d.airport_code = f.departure_airport
             JOIN   airports_data  AS a ON a.airport_code = f.arrival_airport
      ) AS coords
      JOIN airports_data AS ad ON ad.airport_code = coords.departure_airport
      JOIN airports_data AS aa ON aa.airport_code = coords.arrival_airport
) AS all_routes
LIMIT 20;
```

```sql
-- 7. Average the distance across all parallel routes connecting the same two cities
WITH city_routes AS (
     SELECT 
            CASE WHEN c1 < c2 THEN c1 ELSE c2 END AS city_from,
            CASE WHEN c1 < c2 THEN c2 ELSE c1 END AS city_to,
            distance_km
     FROM  (...same inner SELECT as in #6...)          -- abbreviated here
)
SELECT city_from,
       city_to,
       AVG(distance_km) AS avg_distance
FROM   city_routes
GROUP  BY city_from, city_to
LIMIT 20;
```

```sql
-- 8. Bucket every city-pair by its average distance
WITH pairs AS (                               -- reuse step #7
     SELECT city_from,
            city_to,
            AVG(distance_km) AS avg_distance
     FROM  (...same inner SELECT as in #6...)
     GROUP BY city_from, city_to
)
SELECT *,
       CASE
            WHEN avg_distance < 1000  THEN '0-1000'
            WHEN avg_distance < 2000  THEN '1000-2000'
            WHEN avg_distance < 3000  THEN '2000-3000'
            WHEN avg_distance < 4000  THEN '3000-4000'
            WHEN avg_distance < 5000  THEN '4000-5000'
            WHEN avg_distance < 6000  THEN '5000-6000'
            ELSE                          '6000+'
       END AS dist_bucket
FROM   pairs
LIMIT 20;
```

```sql
-- 9. Count how many unique city-pairs fall into each bucket
WITH pairs AS (
     SELECT city_from,
            city_to,
            AVG(distance_km) AS avg_distance
     FROM  (...same inner SELECT as in #6...)
     GROUP BY city_from, city_to
),
buckets AS (
     SELECT
            CASE
                 WHEN avg_distance < 1000  THEN '0-1000'
                 WHEN avg_distance < 2000  THEN '1000-2000'
                 WHEN avg_distance < 3000  THEN '2000-3000'
                 WHEN avg_distance < 4000  THEN '3000-4000'
                 WHEN avg_distance < 5000  THEN '4000-5000'
                 WHEN avg_distance < 6000  THEN '5000-6000'
                 ELSE                          '6000+'
            END AS dist_bucket
     FROM   pairs
)
SELECT dist_bucket,
       COUNT(*) AS pair_cnt
FROM   buckets
GROUP  BY dist_bucket
ORDER  BY pair_cnt;
```

```sql
-- 10. Finally, retrieve the *smallest* bucket size (= answer requested)
WITH pairs AS (
     SELECT city_from,
            city_to,
            AVG(distance_km) AS avg_distance
     FROM  (...same inner SELECT as in #6...)
     GROUP BY city_from, city_to
),
buckets AS (
     SELECT
            CASE
                 WHEN avg_distance < 1000  THEN '0-1000'
                 WHEN avg_distance < 2000  THEN '1000-2000'
                 WHEN avg_distance < 3000  THEN '2000-3000'
                 WHEN avg_distance < 4000  THEN '3000-4000'
                 WHEN avg_distance < 5000  THEN '4000-5000'
                 WHEN avg_distance < 6000  THEN '5000-6000'
                 ELSE                          '6000+'
            END AS dist_bucket
     FROM   pairs
)
SELECT MIN(cnt) AS fewest_city_pairs
FROM   (
       SELECT dist_bucket, COUNT(*) AS cnt
       FROM   buckets
       GROUP  BY dist_bucket
) AS agg;
```

Running the final query (#10) on the full data set shows that the bucket with the fewest unique city pairs is the “6000+ km” bucket, and it contains **2** city pairs.
