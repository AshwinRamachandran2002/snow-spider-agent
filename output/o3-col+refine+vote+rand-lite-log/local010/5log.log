--Description: (#7) Using the same distance computation as #6, average the distance
--              over all routes connecting each unordered city pair.
--              Return 20 example rows.
WITH airports_cte AS (
     SELECT  airport_code,
             RADIANS( CAST(SUBSTR(coordinates, 2,
                                   INSTR(coordinates, ',') - 2) AS REAL) )   AS lon,
             RADIANS( CAST(SUBSTR(coordinates,
                                   INSTR(coordinates, ',') + 1,
                                   LENGTH(coordinates) - INSTR(coordinates, ',') - 1
                                  ) AS REAL) )                              AS lat,
             json_extract(city, '$.en')                                      AS city_en
     FROM   airports_data
),
flight_geo AS (
     SELECT  f.flight_id,
             ad.city_en AS dep_city,
             aa.city_en AS arr_city,
             ad.lon     AS dep_lon,
             ad.lat     AS dep_lat,
             aa.lon     AS arr_lon,
             aa.lat     AS arr_lat
     FROM   flights AS f
     JOIN   airports_cte AS ad ON ad.airport_code = f.departure_airport
     JOIN   airports_cte AS aa ON aa.airport_code = f.arrival_airport
),
pair_dist AS (
     SELECT CASE WHEN dep_city < arr_city THEN dep_city ELSE arr_city END AS city_from,
            CASE WHEN dep_city < arr_city THEN arr_city ELSE dep_city END AS city_to,
            ROUND(
                  6371 * 2 *
                  ASIN(
                       SQRT(
                             POWER(SIN((arr_lat - dep_lat)/2),2) +
                             COS(dep_lat) * COS(arr_lat) *
                             POWER(SIN((arr_lon - dep_lon)/2),2)
                         )
                  )
            ,0) AS distance_km
     FROM   flight_geo
)
SELECT  city_from,
        city_to,
        AVG(distance_km) AS avg_distance
FROM    pair_dist
GROUP   BY city_from, city_to
LIMIT 20;
