```sql
--Description: List 20 orders together with both the purchase month cohort and the order month to verify month-offset logic.  
SELECT
    o."order_id",
    o."user_id",
    TO_CHAR(TO_TIMESTAMP(u."first_order_created_at"/1e6), 'YYYY-MM') AS "cohort_month",
    TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM')            AS "order_month",
    o."status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT 
        "user_id",
        MIN("created_at") AS "first_order_created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
) u
  ON o."user_id" = u."user_id"
WHERE o."status" = 'Complete'
ORDER BY o."created_at"
LIMIT 20;
```

```sql
--Description: Calculate the month offset (0,1,2,3…) since first purchase for 20 sample rows to validate retention logic.  
SELECT
    o."order_id",
    o."user_id",
    TO_CHAR(TO_TIMESTAMP(u."first_order_created_at"/1e6), 'YYYY-MM') AS "cohort_month",
    DATEDIFF(
        month, 
        TO_DATE(TO_TIMESTAMP(u."first_order_created_at"/1e6)),
        TO_DATE(TO_TIMESTAMP(o."created_at"/1e6))
    ) AS "month_since_first",
    o."status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
JOIN (
    SELECT 
        "user_id",
        MIN("created_at") AS "first_order_created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
) u
  ON o."user_id" = u."user_id"
WHERE o."status" = 'Complete'
ORDER BY o."user_id", o."created_at"
LIMIT 20;
```

```sql
--Description: Pull the count of distinct users in each cohort month up to 2022-12 for a sense of base denominators.  
SELECT
    TO_CHAR(TO_TIMESTAMP(MIN("created_at")/1e6), 'YYYY-MM') AS "cohort_month",
    COUNT(DISTINCT "user_id")                               AS "num_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
WHERE "status" = 'Complete'
  AND "created_at" < TO_TIMESTAMP('2023-01-01')::TIMESTAMP * 1e6  -- end of 2022
GROUP BY "cohort_month"
ORDER BY "cohort_month"
LIMIT 20;
```

```sql
--Description: For one cohort month (e.g., 2022-09), show user-level flags of whether they purchased in the 0th,1st,2nd,3rd month to cross-check later aggregation.  
WITH first_purchase AS (
    SELECT 
        "user_id",
        MIN("created_at") AS "first_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
)
SELECT
    f."user_id",
    TO_CHAR(TO_TIMESTAMP(f."first_ts"/1e6), 'YYYY-MM') AS "cohort_month",
    MAX(CASE WHEN DATEDIFF(month, TO_DATE(TO_TIMESTAMP(f."first_ts"/1e6)), TO_DATE(TO_TIMESTAMP(o."created_at"/1e6))) = 0 THEN 1 END) AS "m0_purchased",
    MAX(CASE WHEN DATEDIFF(month, TO_DATE(TO_TIMESTAMP(f."first_ts"/1e6)), TO_DATE(TO_TIMESTAMP(o."created_at"/1e6))) = 1 THEN 1 END) AS "m1_purchased",
    MAX(CASE WHEN DATEDIFF(month, TO_DATE(TO_TIMESTAMP(f."first_ts"/1e6)), TO_DATE(TO_TIMESTAMP(o."created_at"/1e6))) = 2 THEN 1 END) AS "m2_purchased",
    MAX(CASE WHEN DATEDIFF(month, TO_DATE(TO_TIMESTAMP(f."first_ts"/1e6)), TO_DATE(TO_TIMESTAMP(o."created_at"/1e6))) = 3 THEN 1 END) AS "m3_purchased"
FROM first_purchase f
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  ON o."user_id" = f."user_id"
WHERE o."status" = 'Complete'
  AND TO_CHAR(TO_TIMESTAMP(f."first_ts"/1e6), 'YYYY-MM') = '2022-09'
GROUP BY f."user_id", "cohort_month"
LIMIT 20;
```

```sql
--Description: Final cohort-retention summary through 2022, producing the % users purchasing in months 0-3; limited to 20 cohort-months to stay within the exploration scope.  
WITH first_purchase AS (
    SELECT 
        "user_id",
        MIN("created_at") AS "first_ts"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
), cohort_flags AS (
    SELECT
        f."user_id",
        TO_CHAR(TO_TIMESTAMP(f."first_ts"/1e6), 'YYYY-MM') AS "cohort_month",
        DATEDIFF(
            month, 
            TO_DATE(TO_TIMESTAMP(f."first_ts"/1e6)),
            TO_DATE(TO_TIMESTAMP(o."created_at"/1e6))
        ) AS "month_since_first"
    FROM first_purchase f
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
      ON o."user_id" = f."user_id"
    WHERE o."status" = 'Complete'
      AND o."created_at" < TO_TIMESTAMP('2023-01-01')::TIMESTAMP * 1e6
)
SELECT
    "cohort_month",
    ROUND(100 * SUM(CASE WHEN "month_since_first" = 0 THEN 1 END) / COUNT(DISTINCT "user_id"), 2) AS "pct_m0",
    ROUND(100 * SUM(CASE WHEN "month_since_first" = 1 THEN 1 END) / COUNT(DISTINCT "user_id"), 2) AS "pct_m1",
    ROUND(100 * SUM(CASE WHEN "month_since_first" = 2 THEN 1 END) / COUNT(DISTINCT "user_id"), 2) AS "pct_m2",
    ROUND(100 * SUM(CASE WHEN "month_since_first" = 3 THEN 1 END) / COUNT(DISTINCT "user_id"), 2) AS "pct_m3"
FROM cohort_flags
GROUP BY "cohort_month"
ORDER BY "cohort_month"
LIMIT 20;
```
