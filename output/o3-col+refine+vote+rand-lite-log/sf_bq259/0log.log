```sql
--Description:  Each user’s first “Complete” order marks the start of their cohort.
--              The raw micro-second value (“created_at”) is divided by 1 000 000 and
--              converted with TO_TIMESTAMP(); DATE_TRUNC(month, …) anchors it to the
--              cohort month.  We then keep only first purchases that happened before
--              2023-01-01 and count how many distinct users belong to each cohort.
WITH first_purchase AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_ts"          -- micro-seconds
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
)
SELECT
    TO_CHAR(
        DATE_TRUNC(month, TO_TIMESTAMP("first_ts" / 1e6)),
        'YYYY-MM'
    ) AS "cohort_month",
    COUNT(DISTINCT "user_id") AS "num_users"
FROM first_purchase
WHERE TO_TIMESTAMP("first_ts" / 1e6) < TO_TIMESTAMP('2023-01-01')
GROUP BY "cohort_month"
ORDER BY "cohort_month"
LIMIT 20;
```
