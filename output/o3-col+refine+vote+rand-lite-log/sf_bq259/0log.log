```sql
--Description:  Build a cohort-retention table (months 0-3) for users whose first completed
--              purchase happened before 2023-01-01.  Steps:
--              1) first_purchase – each user’s first “Complete” order timestamp (“first_ts”).
--              2) orders_22     – all completed orders through 2022-12-31.
--              3) cohort_flags  – join the two, compute month_since_first (0-∞).
--              4) Final SELECT  – for every cohort month, count distinct users (denominator)
--                                 and the share that placed an order in months 0, 1, 2, 3.
WITH first_purchase AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_ts"                            -- micro-seconds
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
),
orders_22 AS (
    SELECT
        "order_id",
        "user_id",
        "created_at"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
      AND "created_at" <  TO_TIMESTAMP('2023-01-01') ::TIMESTAMP * 1000000  -- keep 2022 and earlier
),
cohort_flags AS (
    SELECT
        fp."user_id",
        TO_CHAR(DATE_TRUNC(month, TO_TIMESTAMP(fp."first_ts" / 1e6)), 'YYYY-MM') AS cohort_month,
        DATEDIFF(
            month,
            DATE_TRUNC(month, TO_TIMESTAMP(fp."first_ts" / 1e6)),
            DATE_TRUNC(month, TO_TIMESTAMP(o."created_at" / 1e6))
        ) AS month_since_first
    FROM first_purchase fp
    JOIN orders_22 o
      ON o."user_id" = fp."user_id"
    WHERE TO_TIMESTAMP(fp."first_ts" / 1e6) < TO_TIMESTAMP('2023-01-01')
)
SELECT
    cohort_month,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN month_since_first = 0 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS pct_m0,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN month_since_first = 1 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS pct_m1,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN month_since_first = 2 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS pct_m2,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN month_since_first = 3 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS pct_m3
FROM cohort_flags
WHERE month_since_first BETWEEN 0 AND 3
GROUP BY cohort_month
ORDER BY cohort_month
LIMIT 20;
```
