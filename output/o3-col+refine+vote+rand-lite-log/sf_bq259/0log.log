```sql
--Description:  For a given cohort month (example: 2022-09), flag whether each user placed a
--              completed order in months 0-3 after their first completed purchase.
--              The micro-second fields (“first_ts”, “created_at”) are divided by 1 000 000
--              before TO_TIMESTAMP() so Snowflake receives seconds.
WITH first_purchase AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_ts"          -- µs
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
)
SELECT
    f."user_id",
    TO_CHAR(TO_TIMESTAMP(f."first_ts" / 1e6), 'YYYY-MM') AS "cohort_month",
    MAX(CASE WHEN DATEDIFF(
                    month,
                    TO_DATE(TO_TIMESTAMP(f."first_ts" / 1e6)),
                    TO_DATE(TO_TIMESTAMP(o."created_at" / 1e6))
               ) = 0 THEN 1 END) AS "m0_purchased",
    MAX(CASE WHEN DATEDIFF(
                    month,
                    TO_DATE(TO_TIMESTAMP(f."first_ts" / 1e6)),
                    TO_DATE(TO_TIMESTAMP(o."created_at" / 1e6))
               ) = 1 THEN 1 END) AS "m1_purchased",
    MAX(CASE WHEN DATEDIFF(
                    month,
                    TO_DATE(TO_TIMESTAMP(f."first_ts" / 1e6)),
                    TO_DATE(TO_TIMESTAMP(o."created_at" / 1e6))
               ) = 2 THEN 1 END) AS "m2_purchased",
    MAX(CASE WHEN DATEDIFF(
                    month,
                    TO_DATE(TO_TIMESTAMP(f."first_ts" / 1e6)),
                    TO_DATE(TO_TIMESTAMP(o."created_at" / 1e6))
               ) = 3 THEN 1 END) AS "m3_purchased"
FROM first_purchase f
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
  ON o."user_id" = f."user_id"
WHERE o."status" = 'Complete'
  AND TO_CHAR(TO_TIMESTAMP(f."first_ts" / 1e6), 'YYYY-MM') = '2022-09'
GROUP BY f."user_id", "cohort_month"
LIMIT 20;
```

```sql
--Description:  Cohort-retention summary (months 0-3) for all cohorts whose first purchase
--              occurred before 2023-01-01.  We replace the invalid multiplication of a
--              TIMESTAMP by 1 000 000 with a proper conversion of “created_at” from µs to
--              TIMESTAMP for the date filter.
WITH first_purchase AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_ts"          -- µs
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS
    WHERE "status" = 'Complete'
    GROUP BY "user_id"
),
cohort_flags AS (
    SELECT
        f."user_id",
        TO_CHAR(TO_TIMESTAMP(f."first_ts" / 1e6), 'YYYY-MM') AS "cohort_month",
        DATEDIFF(
            month,
            DATE_TRUNC(month, TO_TIMESTAMP(f."first_ts" / 1e6)),
            DATE_TRUNC(month, TO_TIMESTAMP(o."created_at" / 1e6))
        ) AS "month_since_first"
    FROM first_purchase f
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS o
      ON o."user_id" = f."user_id"
    WHERE o."status" = 'Complete'
      AND TO_TIMESTAMP(o."created_at" / 1e6) < TO_TIMESTAMP('2023-01-01')
)
SELECT
    "cohort_month",
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN "month_since_first" = 0 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS "pct_m0",
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN "month_since_first" = 1 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS "pct_m1",
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN "month_since_first" = 2 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS "pct_m2",
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN "month_since_first" = 3 THEN "user_id" END)
          / COUNT(DISTINCT "user_id"), 2) AS "pct_m3"
FROM cohort_flags
WHERE "month_since_first" BETWEEN 0 AND 3
GROUP BY "cohort_month"
ORDER BY "cohort_month"
LIMIT 20;
```
