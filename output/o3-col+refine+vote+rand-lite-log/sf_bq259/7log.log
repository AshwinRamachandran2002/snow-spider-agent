```sql
--Description: 1) Peek at a few orders (≤ 2022) to understand the raw purchase-date column we will work with
SELECT "order_id",
       "user_id",
       "created_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE  "created_at" < 1672531200000000      -- 2023-01-01 in µs
LIMIT  20;
```

```sql
--Description: 2) Verify that a user may have several orders (look at one random user)
SELECT *
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE  "user_id" = (
       SELECT "user_id"
       FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
       WHERE  "created_at" < 1672531200000000
       LIMIT  1 )
ORDER  BY "created_at"
LIMIT  20;
```

```sql
--Description: 3) Get each user’s first purchase date (≤ 2022) – basic aggregation
SELECT "user_id",
       MIN("created_at") AS "first_purchase_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE  "created_at" < 1672531200000000
GROUP  BY "user_id"
LIMIT  20;
```

```sql
--Description: 4) Join first-purchase CTE back to all later orders to compute the “month number” since first purchase
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT o."user_id",
       o."created_at",
       f."first_purchase_at",
       FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) AS "nth_month"   -- 30*24*60*60*1e6
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN   first_buy f  ON f."user_id" = o."user_id"
WHERE  o."created_at" < 1672531200000000
ORDER  BY o."user_id", o."created_at"
LIMIT  20;
```

```sql
--Description: 5) Count distinct purchasers by month-number bucket (0 = first month, 1 = second, etc.)
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) AS "nth_month",
       COUNT(DISTINCT o."user_id")                                   AS "purchasing_users"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN   first_buy f  ON f."user_id" = o."user_id"
WHERE  o."created_at" < 1672531200000000
GROUP  BY 1
ORDER  BY 1
LIMIT  20;
```

```sql
--Description: 6) Retrieve the total unique user count that had any purchase (≤ 2022) for later percentage math
SELECT COUNT(DISTINCT "user_id") AS "total_active_users_≤2022"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE  "created_at" < 1672531200000000;
```

```sql
--Description: 7) Inspect how many order rows per user fall in their 0-3 month range (sanity check)
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT o."user_id",
       COUNT(*) AS "orders_in_first_4_months"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   first_buy f ON f."user_id" = o."user_id"
WHERE  o."created_at" < 1672531200000000
  AND  FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) BETWEEN 0 AND 3
GROUP  BY o."user_id"
ORDER  BY 2 DESC
LIMIT  20;
```

```sql
--Description: 8) Tie users to profile information (age, country, etc.)—helps if we want to slice retention later
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT u."id"            AS "user_id",
       u."gender",
       u."age",
       u."country",
       f."first_purchase_at"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"  u
JOIN   first_buy f ON f."user_id" = u."id"
LIMIT  20;
```

```sql
--Description: 9) Quickly check that the “nth_month” logic never yields negative values
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT MIN( FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) ) AS "min_nth_month",
       MAX( FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) ) AS "max_nth_month"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   first_buy f ON f."user_id" = o."user_id"
WHERE  o."created_at" < 1672531200000000;
```

```sql
--Description: 10) Final aggregation template that will later be turned into % retention (still raw counts)
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id"),
activity AS (
     SELECT DISTINCT
            o."user_id",
            FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) AS "nth_month"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
     JOIN   first_buy f ON f."user_id" = o."user_id"
     WHERE  o."created_at" < 1672531200000000
       AND  FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) BETWEEN 0 AND 3 )
SELECT "nth_month",
       COUNT(DISTINCT "user_id") AS "users_who_purchased"
FROM   activity
GROUP  BY "nth_month"
ORDER  BY "nth_month";
```
