Query:
--Description: 5) Count distinct purchasers by month-number bucket (0 = first month, 1 = second, etc.)
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) AS "nth_month",
       COUNT(DISTINCT o."user_id")                                   AS "purchasing_users"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"  o
JOIN   first_buy f  ON f."user_id" = o."user_id"
WHERE  o."created_at" < 1672531200000000
GROUP  BY 1
ORDER  BY 1
LIMIT  20;
