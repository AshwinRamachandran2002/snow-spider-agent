Query:
--Description: 9) Quickly check that the “nth_month” logic never yields negative values
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT MIN( FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) ) AS "min_nth_month",
       MAX( FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) ) AS "max_nth_month"
