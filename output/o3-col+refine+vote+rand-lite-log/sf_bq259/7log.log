Query:
--Description: 7) Inspect how many order rows per user fall in their 0-3 month range (sanity check)
WITH first_buy AS (
     SELECT "user_id",
            MIN("created_at") AS "first_purchase_at"
     FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
     WHERE  "created_at" < 1672531200000000
     GROUP  BY "user_id")
SELECT o."user_id",
       COUNT(*) AS "orders_in_first_4_months"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   first_buy f ON f."user_id" = o."user_id"
WHERE  o."created_at" < 1672531200000000
  AND  FLOOR( (o."created_at" - f."first_purchase_at") / 2592000000000 ) BETWEEN 0 AND 3
GROUP  BY o."user_id"
ORDER  BY 2 DESC
