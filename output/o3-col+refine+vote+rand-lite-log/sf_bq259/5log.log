--Description: 9) Turn the raw counts into percentages inside each cohort; this is the retention matrix that answers the question.
SELECT
    cohort."cohort_month",
    ROUND(100.0 * cohort."m0" / cohort."m0", 2) AS "pct_month0",   -- always 100 %
    ROUND(100.0 * cohort."m1" / cohort."m0", 2) AS "pct_month1",
    ROUND(100.0 * cohort."m2" / cohort."m0", 2) AS "pct_month2",
    ROUND(100.0 * cohort."m3" / cohort."m0", 2) AS "pct_month3"
FROM (
    SELECT
        "cohort_month",
        MAX(CASE WHEN "month_offset" = 0 THEN "active_users" END) AS "m0",
        MAX(CASE WHEN "month_offset" = 1 THEN "active_users" END) AS "m1",
        MAX(CASE WHEN "month_offset" = 2 THEN "active_users" END) AS "m2",
        MAX(CASE WHEN "month_offset" = 3 THEN "active_users" END) AS "m3"
    FROM (
        /* use the raw result from query 8, no need to repeat it here */
        SELECT
            fp."first_purchase_month"                                         AS "cohort_month",
            MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                           fp."first_purchase_month")                         AS "month_offset",
            COUNT(DISTINCT o."user_id")                                       AS "active_users"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
        JOIN (
              SELECT 
                  "user_id",
                  MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              GROUP BY "user_id"
        ) fp
          ON fp."user_id" = o."user_id"
        WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
          AND MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                             fp."first_purchase_month") BETWEEN 0 AND 3
        GROUP BY 1, 2
    )
    GROUP BY "cohort_month"
) cohort
ORDER BY "cohort_month"
LIMIT 20;
