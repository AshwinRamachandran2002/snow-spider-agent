--Description: 7) Add the month-offset (0 = cohort month, 1 = second month, etc.) so we can see retention positions for a few users.
SELECT 
    "user_id",
    "order_id",
    "order_month",
    "first_purchase_month",
    MONTHS_BETWEEN("order_month", "first_purchase_month")          AS "month_offset"
FROM (
    -- same sub-query as above
    SELECT 
        o."user_id",
        o."order_id",
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000))          AS "order_month",
        fp."first_purchase_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN (
          SELECT 
              "user_id",
              MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
          FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP BY "user_id"
    ) fp
      ON fp."user_id" = o."user_id"
    WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
)
WHERE ABS("month_offset") < 4        -- show only first four months
ORDER BY "user_id", "order_month"
LIMIT 20;
