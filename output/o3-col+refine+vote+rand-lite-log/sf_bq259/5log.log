```sql
--Description: 1) Peek at a few orders to understand the raw “created_at” timestamp values (micro-seconds since epoch) and the columns we’ll need.
SELECT 
    "order_id",
    "user_id",
    "status",
    "created_at",
    "shipped_at",
    "delivered_at",
    "returned_at",
    "num_of_item"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
LIMIT 20;
```

```sql
--Description: 2) Look at one user’s time-series of orders so we can see how the timestamps change and whether multiple rows per user are present.
SELECT 
    "user_id",
    "order_id",
    "status",
    "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "user_id" = 52                 -- sample user taken from the preview
ORDER BY "created_at"
LIMIT 20;
```

```sql
--Description: 3) Observe distinct months (in UTC) in which orders were created, using a quick micro-second → timestamp conversion.
SELECT DISTINCT 
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000)) AS "order_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
ORDER BY "order_month"
LIMIT 20;
```

```sql
--Description: 4) For every user, return the month of their first recorded purchase (the cohort month).  We’ll need this for the cohort/retention analysis.
SELECT 
    "user_id",
    MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
GROUP BY "user_id"
LIMIT 20;
```

```sql
--Description: 5) Count how many new purchasers appear in each cohort month (up to Dec-2022).
SELECT 
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000)) AS "cohort_month",
    COUNT(DISTINCT "user_id")                                      AS "new_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_TIMESTAMP_NTZ("created_at" / 1000000) < '2023-01-01'
GROUP BY "cohort_month"
ORDER BY "cohort_month"
LIMIT 20;
```

```sql
--Description: 6) Build a staging set with every order plus the user’s first purchase month, limited to orders created before 2023.
SELECT 
    o."user_id",
    o."order_id",
    DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000))          AS "order_month",
    fp."first_purchase_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
      SELECT 
          "user_id",
          MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
) fp
  ON fp."user_id" = o."user_id"
WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
LIMIT 20;
```

```sql
--Description: 7) Add the month-offset (0 = cohort month, 1 = second month, etc.) so we can see retention positions for a few users.
SELECT 
    "user_id",
    "order_id",
    "order_month",
    "first_purchase_month",
    MONTHS_BETWEEN("order_month", "first_purchase_month")          AS "month_offset"
FROM (
    -- same sub-query as above
    SELECT 
        o."user_id",
        o."order_id",
        DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000))          AS "order_month",
        fp."first_purchase_month"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN (
          SELECT 
              "user_id",
              MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
          FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP BY "user_id"
    ) fp
      ON fp."user_id" = o."user_id"
    WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
)
WHERE ABS("month_offset") < 4        -- show only first four months
ORDER BY "user_id", "order_month"
LIMIT 20;
```

```sql
--Description: 8) For each cohort month, compute the number of unique purchasers in month-offsets 0, 1, 2, 3.  This raw count table is the backbone of retention.
SELECT
    fp."first_purchase_month"                                         AS "cohort_month",
    MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                   fp."first_purchase_month")                         AS "month_offset",
    COUNT(DISTINCT o."user_id")                                       AS "active_users"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
      SELECT 
          "user_id",
          MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
      GROUP BY "user_id"
) fp
  ON fp."user_id" = o."user_id"
WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
  AND MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                     fp."first_purchase_month") BETWEEN 0 AND 3
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: 9) Turn the raw counts into percentages inside each cohort; this is the retention matrix that answers the question.
SELECT
    cohort."cohort_month",
    ROUND(100.0 * cohort."m0" / cohort."m0", 2) AS "pct_month0",   -- always 100 %
    ROUND(100.0 * cohort."m1" / cohort."m0", 2) AS "pct_month1",
    ROUND(100.0 * cohort."m2" / cohort."m0", 2) AS "pct_month2",
    ROUND(100.0 * cohort."m3" / cohort."m0", 2) AS "pct_month3"
FROM (
    SELECT
        "cohort_month",
        MAX(CASE WHEN "month_offset" = 0 THEN "active_users" END) AS "m0",
        MAX(CASE WHEN "month_offset" = 1 THEN "active_users" END) AS "m1",
        MAX(CASE WHEN "month_offset" = 2 THEN "active_users" END) AS "m2",
        MAX(CASE WHEN "month_offset" = 3 THEN "active_users" END) AS "m3"
    FROM (
        /* use the raw result from query 8, no need to repeat it here */
        SELECT
            fp."first_purchase_month"                                         AS "cohort_month",
            MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                           fp."first_purchase_month")                         AS "month_offset",
            COUNT(DISTINCT o."user_id")                                       AS "active_users"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
        JOIN (
              SELECT 
                  "user_id",
                  MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              GROUP BY "user_id"
        ) fp
          ON fp."user_id" = o."user_id"
        WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
          AND MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                             fp."first_purchase_month") BETWEEN 0 AND 3
        GROUP BY 1, 2
    )
    GROUP BY "cohort_month"
) cohort
ORDER BY "cohort_month"
LIMIT 20;
```

```sql
--Description: 10) (Validation) List overall retention percentages aggregated across all cohorts to see the average % of users purchasing again in months 1-3.
WITH cohort_raw AS (
    /* raw counts computed the same way as in query 8 */
    SELECT
        fp."first_purchase_month"                                         AS "cohort_month",
        MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                       fp."first_purchase_month")                         AS "month_offset",
        COUNT(DISTINCT o."user_id")                                       AS "active_users"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN (
          SELECT 
              "user_id",
              MIN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ("created_at" / 1000000))) AS "first_purchase_month"
          FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
          GROUP BY "user_id"
    ) fp
      ON fp."user_id" = o."user_id"
    WHERE TO_TIMESTAMP_NTZ(o."created_at" / 1000000) < '2023-01-01'
      AND MONTHS_BETWEEN(DATE_TRUNC('month', TO_TIMESTAMP_NTZ(o."created_at" / 1000000)),
                         fp."first_purchase_month") BETWEEN 0 AND 3
    GROUP BY 1, 2
),
cohort_totals AS (
    SELECT 
        "cohort_month",
        MAX(CASE WHEN "month_offset" = 0 THEN "active_users" END) AS "m0",
        MAX(CASE WHEN "month_offset" = 1 THEN "active_users" END) AS "m1",
        MAX(CASE WHEN "month_offset" = 2 THEN "active_users" END) AS "m2",
        MAX(CASE WHEN "month_offset" = 3 THEN "active_users" END) AS "m3"
    FROM cohort_raw
    GROUP BY "cohort_month"
)
SELECT
    ROUND(100.0 * SUM("m1") / SUM("m0"), 2) AS "overall_pct_month1",
    ROUND(100.0 * SUM("m2") / SUM("m0"), 2) AS "overall_pct_month2",
    ROUND(100.0 * SUM("m3") / SUM("m0"), 2) AS "overall_pct_month3"
FROM cohort_totals
LIMIT 20;
```
