```sql
--Description: Join each order (≤2022) back to its user’s cohort to get month lag
WITH firsts AS (
    SELECT "user_id",
           DATE_TRUNC('month',
                      MIN(TO_TIMESTAMP("created_at"/1000000))) AS "cohort_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE  TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP  BY "user_id"
)
SELECT o."user_id",
       f."cohort_month",
       DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month",
       MONTHS_BETWEEN(
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
            f."cohort_month"
       )::INT AS "month_number"          -- 0 = first month, 1 = second, etc.
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   firsts f
  ON   o."user_id" = f."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
LIMIT  20;
```

```sql
--Description: Keep only months 0-3 (first through fourth) for each user
WITH firsts AS (
    SELECT "user_id",
           DATE_TRUNC('month',
                      MIN(TO_TIMESTAMP("created_at"/1000000))) AS "cohort_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE  TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP  BY "user_id"
)
SELECT o."user_id",
       f."cohort_month",
       MONTHS_BETWEEN(
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
            f."cohort_month"
       )::INT AS "month_number"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   firsts f
  ON   o."user_id" = f."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
  AND  MONTHS_BETWEEN(
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
            f."cohort_month"
       ) BETWEEN 0 AND 3
LIMIT  20;
```

```sql
--Description: Aggregate distinct users per cohort / lag-month (0-3)
WITH firsts AS (
    SELECT "user_id",
           DATE_TRUNC('month',
                      MIN(TO_TIMESTAMP("created_at"/1000000))) AS "cohort_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE  TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP  BY "user_id"
), cohort_orders AS (
    SELECT DISTINCT
           f."cohort_month",
           o."user_id",
           MONTHS_BETWEEN(
                DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
                f."cohort_month"
           )::INT AS "month_number"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   firsts f
      ON   o."user_id" = f."user_id"
    WHERE  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
      AND  MONTHS_BETWEEN(
                DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
                f."cohort_month"
           ) BETWEEN 0 AND 3
)
SELECT "cohort_month",
       "month_number",
       COUNT(DISTINCT "user_id") AS "users_made_purchase"
FROM   cohort_orders
GROUP  BY "cohort_month", "month_number"
ORDER  BY "cohort_month", "month_number"
LIMIT  20;
```

```sql
--Description: For each cohort, calculate base user count (month 0) and % retained months 0-3
WITH firsts AS (
    SELECT "user_id",
           DATE_TRUNC('month',
                      MIN(TO_TIMESTAMP("created_at"/1000000))) AS "cohort_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE  TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP  BY "user_id"
), cohort_orders AS (
    SELECT DISTINCT
           f."cohort_month",
           o."user_id",
           MONTHS_BETWEEN(
                DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
                f."cohort_month"
           )::INT AS "month_number"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   firsts f
      ON   o."user_id" = f."user_id"
    WHERE  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
      AND  MONTHS_BETWEEN(
                DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
                f."cohort_month"
           ) BETWEEN 0 AND 3
), counts AS (
    SELECT "cohort_month",
           "month_number",
           COUNT(DISTINCT "user_id") AS "users"
    FROM   cohort_orders
    GROUP  BY "cohort_month", "month_number"
)
SELECT c0."cohort_month",
       c0."users"                                                    AS "users_month0",
       ROUND(100 * c1."users" / c0."users", 2)                       AS "pct_month1",
       ROUND(100 * c2."users" / c0."users", 2)                       AS "pct_month2",
       ROUND(100 * c3."users" / c0."users", 2)                       AS "pct_month3"
FROM   counts c0
LEFT JOIN counts c1 ON c1."cohort_month" = c0."cohort_month" AND c1."month_number" = 1
LEFT JOIN counts c2 ON c2."cohort_month" = c0."cohort_month" AND c2."month_number" = 2
LEFT JOIN counts c3 ON c3."cohort_month" = c0."cohort_month" AND c3."month_number" = 3
WHERE  c0."month_number" = 0
ORDER  BY c0."cohort_month"
LIMIT  20;
```

```sql
--Description: Single summary across ALL cohorts – overall user-level retention percentages
WITH firsts AS (
    SELECT "user_id",
           DATE_TRUNC('month',
                      MIN(TO_TIMESTAMP("created_at"/1000000))) AS "cohort_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE  TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP  BY "user_id"
), cohort_orders AS (
    SELECT DISTINCT
           f."cohort_month",
           o."user_id",
           MONTHS_BETWEEN(
                DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
                f."cohort_month"
           )::INT AS "month_number"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
    JOIN   firsts f
      ON   o."user_id" = f."user_id"
    WHERE  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
      AND  MONTHS_BETWEEN(
                DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
                f."cohort_month"
           ) BETWEEN 0 AND 3
), counts AS (
    SELECT "month_number",
           COUNT(DISTINCT "user_id") AS "users"
    FROM   cohort_orders
    GROUP  BY "month_number"
)
SELECT ROUND(100 * MAX(CASE WHEN "month_number"=0 THEN "users" END) / MAX(CASE WHEN "month_number"=0 THEN "users" END),2) AS "pct_month0",
       ROUND(100 * MAX(CASE WHEN "month_number"=1 THEN "users" END) / MAX(CASE WHEN "month_number"=0 THEN "users" END),2) AS "pct_month1",
       ROUND(100 * MAX(CASE WHEN "month_number"=2 THEN "users" END) / MAX(CASE WHEN "month_number"=0 THEN "users" END),2) AS "pct_month2",
       ROUND(100 * MAX(CASE WHEN "month_number"=3 THEN "users" END) / MAX(CASE WHEN "month_number"=0 THEN "users" END),2) AS "pct_month3"
FROM   counts;
```
