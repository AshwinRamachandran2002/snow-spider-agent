Query:
--Description: Join each order (≤2022) back to its user’s cohort to get month lag
WITH firsts AS (
    SELECT "user_id",
           DATE_TRUNC('month',
                      MIN(TO_TIMESTAMP("created_at"/1000000))) AS "cohort_month"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
    WHERE  TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
    GROUP  BY "user_id"
)
SELECT o."user_id",
       f."cohort_month",
       DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS "order_month",
       MONTHS_BETWEEN(
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)),
            f."cohort_month"
       )::INT AS "month_number"          -- 0 = first month, 1 = second, etc.
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN   firsts f
  ON   o."user_id" = f."user_id"
WHERE  TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
LIMIT  20;
