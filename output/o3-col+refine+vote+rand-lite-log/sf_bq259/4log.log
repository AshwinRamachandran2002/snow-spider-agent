```sql
--Description / Thinking process:
-- We need one query that delivers, for every cohort of users whose first-purchase
-- month (YYYYMM) falls on or before 2022-12, the percentage of that cohort’s users
-- who made a purchase in their:
--   • 0th month (month of first purchase)   → pct_month_0
--   • 1st month after first purchase        → pct_month_1
--   • 2nd month after first purchase        → pct_month_2
--   • 3rd month after first purchase        → pct_month_3
--
-- Implementation steps inside CTEs:
--   1) first_purchase  : first order time-stamp for every user before 2023-01-01.
--   2) cohort_orders   : all orders by those users (same cut-off), labelled with
--                        cohort_month and month_index = floor(Δtime / 30-day-µs).
--   3) cohort_counts   : distinct-user counts for each (cohort_month, month_index).
--   4) cohort_totals   : total users per cohort (month_index = 0 count).
--   5) Final SELECT    : pivot counts into percentages, grouping by cohort_month
--                        and total_users (to satisfy SQL aggregation rules).

WITH first_purchase AS (            -- 1) first purchase per user
    SELECT
        "user_id",
        MIN("created_at") AS "first_purchase_us"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "created_at" < 1672531200000000              -- < 2023-01-01
    GROUP BY "user_id"
),
cohort_orders AS (                  -- 2) every order tagged with cohort & month_index
    SELECT
        fp."user_id",
        TO_CHAR(
            TO_TIMESTAMP_NTZ(fp."first_purchase_us" / 1e6), 'YYYYMM'
        ) AS "cohort_month",
        FLOOR(
            (o."created_at" - fp."first_purchase_us") / 2592000000000
        ) AS "month_index"                              -- 30-day month approximation
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
    JOIN first_purchase fp
      ON o."user_id" = fp."user_id"
    WHERE o."created_at" < 1672531200000000
),
cohort_counts AS (                  -- 3) user counts by cohort & index (0-3)
    SELECT
        "cohort_month",
        "month_index",
        COUNT(DISTINCT "user_id") AS "users_cnt"
    FROM cohort_orders
    WHERE "month_index" BETWEEN 0 AND 3
    GROUP BY "cohort_month", "month_index"
),
cohort_totals AS (                  -- 4) total users per cohort (month_index = 0)
    SELECT
        "cohort_month",
        "users_cnt" AS "total_users"
    FROM cohort_counts
    WHERE "month_index" = 0
)
-- 5) final pivot: percentages for month_index 0-3
SELECT
    ct."cohort_month",
    ROUND(
        100.0 * MAX(CASE WHEN cc."month_index" = 0 THEN cc."users_cnt" END)
        / ct."total_users", 2
    ) AS "pct_month_0",
    ROUND(
        100.0 * MAX(CASE WHEN cc."month_index" = 1 THEN cc."users_cnt" END)
        / ct."total_users", 2
    ) AS "pct_month_1",
    ROUND(
        100.0 * MAX(CASE WHEN cc."month_index" = 2 THEN cc."users_cnt" END)
        / ct."total_users", 2
    ) AS "pct_month_2",
    ROUND(
        100.0 * MAX(CASE WHEN cc."month_index" = 3 THEN cc."users_cnt" END)
        / ct."total_users", 2
    ) AS "pct_month_3"
FROM cohort_totals ct
LEFT JOIN cohort_counts cc
       ON ct."cohort_month" = cc."cohort_month"
WHERE ct."cohort_month" <= '202212'                    -- cohorts up to Dec-2022
GROUP BY ct."cohort_month", ct."total_users"           -- include total_users in GROUP BY
ORDER BY ct."cohort_month";
