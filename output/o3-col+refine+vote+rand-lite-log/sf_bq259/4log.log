--Description: Overall retention – percentage of all users (whose first purchase was before 2023-01-01)
--             that placed an order in their 0-3rd month after first purchase.
WITH first_purchase AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_purchase_us"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "created_at" < 1672531200000000          -- data through 2022-12-31
    GROUP BY "user_id"
), all_orders AS (
    SELECT
        o."user_id",
        FLOOR( (o."created_at" - fp."first_purchase_us") / 2592000000000 ) AS "month_index"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
    JOIN first_purchase fp
      ON o."user_id" = fp."user_id"
    WHERE o."created_at" < 1672531200000000
)
SELECT
    ao."month_index",
    ROUND(
        100.0 * COUNT(DISTINCT ao."user_id")
        / (SELECT COUNT(*) FROM first_purchase),      -- denominator = total users
        2
    ) AS "pct_of_users"
FROM all_orders ao
WHERE ao."month_index" BETWEEN 0 AND 3
GROUP BY ao."month_index"
ORDER BY ao."month_index";
