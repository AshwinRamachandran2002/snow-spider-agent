```sql
--Description: Attach every order to its user’s first purchase timestamp so we can compute month-index (0-based).
SELECT o."user_id",
       o."order_id",
       o."created_at"              AS "order_us",
       fp."first_purchase_us",
       FLOOR( (o."created_at" - fp."first_purchase_us")
               / 2592000000000 )   AS "month_index"  -- 30-day month approximation
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
JOIN (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_us"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE  "created_at" < 1672531200000000
        GROUP BY "user_id"
     ) fp
     ON o."user_id" = fp."user_id"
WHERE  o."created_at" < 1672531200000000
LIMIT 20;
```

```sql
--Description: Count distinct users that have at least one order in their 0th, 1st, 2nd or 3rd month-index window.
SELECT mo."month_index",
       COUNT(DISTINCT mo."user_id") AS "users_in_bucket"
FROM (
        SELECT o."user_id",
               FLOOR( (o."created_at" - fp."first_purchase_us")
                       / 2592000000000 ) AS "month_index"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
        JOIN (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_us"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE  "created_at" < 1672531200000000
                GROUP BY "user_id"
             ) fp
             ON o."user_id" = fp."user_id"
        WHERE  o."created_at" < 1672531200000000
      ) mo
WHERE mo."month_index" BETWEEN 0 AND 3
GROUP BY mo."month_index"
ORDER BY mo."month_index"
LIMIT 20;
```

```sql
--Description: Compute the total number of users who had their first purchase (denominator for percentages) by month bucket.
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM') AS "first_purchase_month",
       COUNT(*)                                                       AS "total_users_started"
FROM (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_us"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE  "created_at" < 1672531200000000
        GROUP BY "user_id"
     ) fp
GROUP BY TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM')
ORDER BY "first_purchase_month"
LIMIT 20;
```

```sql
--Description: For a given start-month (e.g., 202201), show how many of those users bought again in month-index 1.
SELECT start_month."first_purchase_month",
       COUNT(DISTINCT CASE WHEN mo."month_index" = 1 THEN mo."user_id" END) AS "users_month_1"
FROM (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_us"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE  "created_at" < 1672531200000000
        GROUP BY "user_id"
     ) fp
JOIN (
        SELECT o."user_id",
               o."created_at" AS "order_us"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
        WHERE  o."created_at" < 1672531200000000
     ) o
     ON fp."user_id" = o."user_id"
JOIN LATERAL (
        SELECT TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM') AS "first_purchase_month"
     ) start_month
     ON TRUE
JOIN LATERAL (
        SELECT FLOOR( (o."order_us" - fp."first_purchase_us") / 2592000000000 ) AS "month_index"
     ) mo
     ON TRUE
WHERE start_month."first_purchase_month" = '202201'
GROUP BY start_month."first_purchase_month"
LIMIT 20;
```

```sql
--Description: Derive overall retention percentages (0-3) across all cohorts; rough illustration.
SELECT ret."month_index",
       ( COUNT(DISTINCT ret."user_id") * 100.0
         / (SELECT COUNT(DISTINCT "user_id")
            FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
            WHERE "created_at" < 1672531200000000) )      AS "pct_of_users"
FROM (
        SELECT o."user_id",
               FLOOR( (o."created_at" - fp."first_purchase_us")
                       / 2592000000000 ) AS "month_index"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
        JOIN (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_us"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE  "created_at" < 1672531200000000
                GROUP BY "user_id"
             ) fp
             ON o."user_id" = fp."user_id"
        WHERE  o."created_at" < 1672531200000000
      ) ret
WHERE ret."month_index" BETWEEN 0 AND 3
GROUP BY ret."month_index"
ORDER BY ret."month_index"
LIMIT 20;
```

```sql
--Description: Quick cohort view – users who started in 2022 but bought in months 0-3 with percentages.
SELECT cohort."first_purchase_month",
       SUM(CASE WHEN cohort."month_index" = 0 THEN 1 ELSE 0 END) AS "users_m0",
       SUM(CASE WHEN cohort."month_index" = 1 THEN 1 ELSE 0 END) AS "users_m1",
       SUM(CASE WHEN cohort."month_index" = 2 THEN 1 ELSE 0 END) AS "users_m2",
       SUM(CASE WHEN cohort."month_index" = 3 THEN 1 ELSE 0 END) AS "users_m3"
FROM (
        SELECT o."user_id",
               TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM') AS "first_purchase_month",
               FLOOR( (o."created_at" - fp."first_purchase_us")
                       / 2592000000000 ) AS "month_index"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
        JOIN (
                SELECT "user_id",
                       MIN("created_at") AS "first_purchase_us"
                FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
                WHERE  "created_at" BETWEEN 1640995200000000 AND 1672531200000000   -- 2022 only
                GROUP BY "user_id"
             ) fp
             ON o."user_id" = fp."user_id"
        WHERE  o."created_at" < 1672531200000000
      ) cohort
GROUP BY cohort."first_purchase_month"
ORDER BY cohort."first_purchase_month"
LIMIT 20;
```
