Query:
--Description: 2022 cohorts – percentage of each 2022 cohort’s users who ordered again
--             in months 0-3 after their first purchase.
WITH first_purchase_2022 AS (             -- users whose very first order happened in 2022
    SELECT
        "user_id",
        MIN("created_at") AS "first_purchase_us"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "created_at" BETWEEN 1640995200000000 AND 1672531200000000   -- 2022-01-01 to 2022-12-31
    GROUP BY "user_id"
), cohort_orders AS (                     -- every 2022 user’s orders (up to 2022-12-31)
    SELECT
        fp."user_id",
        TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM') AS "cohort_month",
        FLOOR( (o."created_at" - fp."first_purchase_us") / 2592000000000 ) AS "month_index"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
    JOIN first_purchase_2022 fp
      ON o."user_id" = fp."user_id"
    WHERE o."created_at" < 1672531200000000
          AND FLOOR( (o."created_at" - fp."first_purchase_us") / 2592000000000 ) BETWEEN 0 AND 3
), cohort_counts AS (                     -- distinct-user counts per cohort & month_index
    SELECT
        "cohort_month",
        "month_index",
        COUNT(DISTINCT "user_id") AS "users_cnt"
    FROM cohort_orders
    GROUP BY "cohort_month", "month_index"
), cohort_totals AS (                     -- total users in each cohort
    SELECT
        "cohort_month",
        MAX("users_cnt") AS "total_users"     -- month_index 0 value
    FROM cohort_counts
    WHERE "month_index" = 0
    GROUP BY "cohort_month"
)
SELECT
    ct."cohort_month",
    ROUND(100.0 * MAX(CASE WHEN cc."month_index" = 0 THEN cc."users_cnt" END) / ct."total_users", 2) AS "pct_m0",
    ROUND(100.0 * MAX(CASE WHEN cc."month_index" = 1 THEN cc."users_cnt" END) / ct."total_users", 2) AS "pct_m1",
    ROUND(100.0 * MAX(CASE WHEN cc."month_index" = 2 THEN cc."users_cnt" END) / ct."total_users", 2) AS "pct_m2",
    ROUND(100.0 * MAX(CASE WHEN cc."month_index" = 3 THEN cc."users_cnt" END) / ct."total_users", 2) AS "pct_m3"
FROM cohort_totals ct
LEFT JOIN cohort_counts cc
       ON ct."cohort_month" = cc."cohort_month"
GROUP BY ct."cohort_month", ct."total_users"
ORDER BY ct."cohort_month"
