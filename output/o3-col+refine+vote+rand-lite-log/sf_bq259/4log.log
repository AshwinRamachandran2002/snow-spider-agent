```sql
--Description / Thinking process:
-- Goal:  For every cohort defined by the month (YYYYMM) of a user’s very first purchase 
--        up to and including 2022-12, show the percentage of that cohort’s users who 
--        placed an order in month_index 0, 1, 2, 3 (where month_index 0 = month of first purchase).
-- Steps:
--   1) first_purchase  : each user’s first order timestamp (µs) before 2023-01-01.
--   2) cohort_orders   : all orders of those users (also before 2023-01-01) tagged with
--                       cohort_month (YYYYMM of first purchase) and month_index =
--                       floor(Δtime / 30-day-µs).
--   3) cohort_counts   : distinct-user counts per cohort_month & month_index (0-3).
--   4) cohort_totals   : total users in each cohort (month_index = 0 count).
--   5) Final SELECT    : pivot percentages for month_index 0-3.
WITH first_purchase AS (
    SELECT
        "user_id",
        MIN("created_at") AS "first_purchase_us"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "created_at" < 1672531200000000                         -- before 2023-01-01
    GROUP BY "user_id"
),
cohort_orders AS (
    SELECT
        fp."user_id",
        TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM')  AS "cohort_month",
        FLOOR( (o."created_at" - fp."first_purchase_us") / 2592000000000 ) AS "month_index"
