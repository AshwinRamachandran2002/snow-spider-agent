       COUNT(*)                                                       AS "total_users_started"
FROM (
        SELECT "user_id",
               MIN("created_at") AS "first_purchase_us"
        FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE  "created_at" < 1672531200000000
        GROUP BY "user_id"
     ) fp
GROUP BY TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase_us"/1e6), 'YYYYMM')
ORDER BY "first_purchase_month"
LIMIT 20;
