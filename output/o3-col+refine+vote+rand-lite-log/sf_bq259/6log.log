Query:
-- Description: Add each cohort’s denominator (total users) so we can later compute percentages.
SELECT 
       cohort."cohort_month",
       cohort."total_users",
       retention."months_since_first_purchase",
       retention."user_count",
       retention."user_count"*100.0 / cohort."total_users"  AS "retention_pct"
FROM (
       SELECT 
              TO_CHAR(TO_TIMESTAMP_NTZ("first_purchase"/1000000), 'YYYY-MM') AS "cohort_month",
              COUNT(DISTINCT "user_id")                                     AS "total_users"
       FROM (
              SELECT "user_id", MIN("created_at") AS "first_purchase"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              WHERE "status" = 'Complete'
                AND "created_at" < 1672531200000000
              GROUP BY "user_id"
            )
       GROUP BY 1
     ) cohort
JOIN (
       SELECT 
              TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000), 'YYYY-MM') AS "cohort_month",
              DATEDIFF(
                  month,
                  TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
                  TO_TIMESTAMP_NTZ(o."created_at"/1000000)
              )                                                                 AS "months_since_first_purchase",
              COUNT(DISTINCT o."user_id")                                        AS "user_count"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
       JOIN (
              SELECT "user_id", MIN("created_at") AS "first_purchase"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              WHERE "status" = 'Complete'
                AND "created_at" < 1672531200000000
              GROUP BY "user_id"
            ) fp
         ON o."user_id" = fp."user_id"
       WHERE o."status" = 'Complete'
         AND o."created_at" < 1672531200000000
         AND DATEDIFF(
                month,
                TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
                TO_TIMESTAMP_NTZ(o."created_at"/1000000)
             ) BETWEEN 0 AND 3
       GROUP BY 1,2
     ) retention
  ON cohort."cohort_month" = retention."cohort_month"
ORDER BY 1,2
LIMIT 20;
