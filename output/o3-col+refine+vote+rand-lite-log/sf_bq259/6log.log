```sql
-- Description: Quick look at a handful of order records (only those created before 2023-01-01).
SELECT DISTINCT 
       "order_id",
       "user_id",
       "status",
       "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "created_at" < 1672531200000000   -- micro-seconds for 2023-01-01 00:00:00
LIMIT 20;
```

```sql
-- Description: First-purchase time-stamp (in micro-seconds) for each user, based on “Complete” orders.
SELECT 
       "user_id",
       MIN("created_at") AS "first_purchase_us"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "status" = 'Complete'
  AND "created_at" < 1672531200000000
GROUP BY "user_id"
LIMIT 20;
```

```sql
-- Description: Show the (year-month) when a purchase happened – useful for cohort bucketing.
SELECT DISTINCT
       "user_id",
       TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000), 'YYYY-MM') AS "purchase_month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE "status" = 'Complete'
  AND "created_at" < 1672531200000000
LIMIT 20;
```

```sql
-- Description: Tie “ORDER_ITEMS” to “ORDERS” so we can use the same purchase filter later on.
SELECT 
       oi."user_id",
       oi."product_id",
       oi."sale_price",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
     ON oi."order_id" = o."order_id"
WHERE o."status" = 'Complete'
  AND o."created_at" < 1672531200000000
LIMIT 20;
```

```sql
-- Description: Month of first purchase for each user (string YYYY-MM) – core of a cohort.
SELECT 
       fp."user_id",
       TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000), 'YYYY-MM') AS "first_purchase_month"
FROM (
       SELECT "user_id", MIN("created_at") AS "first_purchase"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
       WHERE "status" = 'Complete'
         AND "created_at" < 1672531200000000
       GROUP BY "user_id"
     ) fp
LIMIT 20;
```

```sql
-- Description: For every qualifying order, calculate the number of months since that user’s first purchase (0-3).
SELECT 
       o."user_id",
       DATEDIFF(
           month,
           TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
           TO_TIMESTAMP_NTZ(o."created_at"/1000000)
       )                                              AS "months_since_first_purchase",
       o."order_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
       SELECT "user_id", MIN("created_at") AS "first_purchase"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
       WHERE "status" = 'Complete'
         AND "created_at" < 1672531200000000
       GROUP BY "user_id"
     ) fp
  ON o."user_id" = fp."user_id"
WHERE o."status" = 'Complete'
  AND o."created_at" < 1672531200000000
  AND DATEDIFF(
         month,
         TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
         TO_TIMESTAMP_NTZ(o."created_at"/1000000)
      ) BETWEEN 0 AND 3
LIMIT 20;
```

```sql
-- Description: Count distinct users by (cohort_month × months_since_first_purchase); gives raw retention counts.
SELECT
       TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000), 'YYYY-MM')        AS "cohort_month",
       DATEDIFF(
           month,
           TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
           TO_TIMESTAMP_NTZ(o."created_at"/1000000)
       )                                                                        AS "months_since_first_purchase",
       COUNT(DISTINCT o."user_id")                                             AS "user_count"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
JOIN (
       SELECT "user_id", MIN("created_at") AS "first_purchase"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
       WHERE "status" = 'Complete'
         AND "created_at" < 1672531200000000
       GROUP BY "user_id"
     ) fp
  ON o."user_id" = fp."user_id"
WHERE o."status" = 'Complete'
  AND o."created_at" < 1672531200000000
  AND DATEDIFF(
         month,
         TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
         TO_TIMESTAMP_NTZ(o."created_at"/1000000)
      ) BETWEEN 0 AND 3
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
-- Description: Add each cohort’s denominator (total users) so we can later compute percentages.
SELECT 
       cohort."cohort_month",
       cohort."total_users",
       retention."months_since_first_purchase",
       retention."user_count",
       retention."user_count"*100.0 / cohort."total_users"  AS "retention_pct"
FROM (
       SELECT 
              TO_CHAR(TO_TIMESTAMP_NTZ("first_purchase"/1000000), 'YYYY-MM') AS "cohort_month",
              COUNT(DISTINCT "user_id")                                     AS "total_users"
       FROM (
              SELECT "user_id", MIN("created_at") AS "first_purchase"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              WHERE "status" = 'Complete'
                AND "created_at" < 1672531200000000
              GROUP BY "user_id"
            )
       GROUP BY 1
     ) cohort
JOIN (
       SELECT 
              TO_CHAR(TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000), 'YYYY-MM') AS "cohort_month",
              DATEDIFF(
                  month,
                  TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
                  TO_TIMESTAMP_NTZ(o."created_at"/1000000)
              )                                                                 AS "months_since_first_purchase",
              COUNT(DISTINCT o."user_id")                                        AS "user_count"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
       JOIN (
              SELECT "user_id", MIN("created_at") AS "first_purchase"
              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
              WHERE "status" = 'Complete'
                AND "created_at" < 1672531200000000
              GROUP BY "user_id"
            ) fp
         ON o."user_id" = fp."user_id"
       WHERE o."status" = 'Complete'
         AND o."created_at" < 1672531200000000
         AND DATEDIFF(
                month,
                TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
                TO_TIMESTAMP_NTZ(o."created_at"/1000000)
             ) BETWEEN 0 AND 3
       GROUP BY 1,2
     ) retention
  ON cohort."cohort_month" = retention."cohort_month"
ORDER BY 1,2
LIMIT 20;
```

```sql
-- Description: Overall retention (all cohorts combined) for months 0-3 since first purchase.
SELECT
       ms."months_since_first_purchase",
       COUNT(DISTINCT o."user_id")                                       AS "users_with_purchase",
       COUNT(DISTINCT fp."user_id")                                      AS "total_users",
       COUNT(DISTINCT o."user_id")*100.0 / COUNT(DISTINCT fp."user_id")  AS "pct_users"
FROM (
       SELECT "user_id", MIN("created_at") AS "first_purchase"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
       WHERE "status" = 'Complete'
         AND "created_at" < 1672531200000000
       GROUP BY "user_id"
     ) fp
LEFT JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
       ON o."user_id" = fp."user_id"
JOIN LATERAL (
       SELECT DATEDIFF(
                 month,
                 TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
                 TO_TIMESTAMP_NTZ(o."created_at"/1000000)
              ) AS "months_since_first_purchase"
     ) ms
WHERE o."status" = 'Complete'
  AND o."created_at" < 1672531200000000
  AND ms."months_since_first_purchase" BETWEEN 0 AND 3
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
-- Description: Example of a single cohort (users whose first purchase was during January 2022) and their first 4-month retention.
SELECT
       DATEDIFF(
           month,
           TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
           TO_TIMESTAMP_NTZ(o."created_at"/1000000)
       )                                            AS "months_since_first_purchase",
       COUNT(DISTINCT o."user_id")                 AS "user_count"
FROM (
       SELECT "user_id", MIN("created_at") AS "first_purchase"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
       WHERE "status" = 'Complete'
         AND "created_at" BETWEEN 1640995200000000 AND 1643673600000000  -- Jan-2022 (micro-seconds)
       GROUP BY "user_id"
     ) fp
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS" o
     ON o."user_id" = fp."user_id"
WHERE o."status" = 'Complete'
  AND o."created_at" < 1672531200000000
  AND DATEDIFF(
         month,
         TO_TIMESTAMP_NTZ(fp."first_purchase"/1000000),
         TO_TIMESTAMP_NTZ(o."created_at"/1000000)
      ) BETWEEN 0 AND 3
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

These 10 queries progressively explore raw orders, define cohorts, measure the gap in months since the first purchase, and calculate user counts that will later be converted into the requested percentages for months 0, 1, 2, 3.
