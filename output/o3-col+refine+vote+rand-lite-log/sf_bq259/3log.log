```sql
--Description / Thinking process:
-- Goal:  For all customers whose *first* completed order occurred on or before 2022-12-31,
--        calculate what % of them bought in their 0-th (first-purchase), 1-st, 2-nd,
--        and 3-rd months after that initial purchase.
--
-- Steps inside one query:
--   1) cohort_base  : each user’s first-purchase month using only “Complete” orders < 2023-01-01.
--   2) relative_purchases : for every later “Complete” order (also < 2023-01-01) work out
--        the number of whole months that separate it from the user’s cohort month.
--        Keep only month_number 0-3, and collapse to one row per (user, month_number).
--   3) totals : total distinct users in the cohort – denominator for percentages.
--   4) Final SELECT : count distinct users per month_number, divide by cohort size,
--        round to 2 decimals, deliver rows 0-3 ordered chronologically.
WITH cohort_base AS (            -- Step-1: first purchase month per user
    SELECT
        "user_id",
        MIN(DATE_TRUNC('month', TO_TIMESTAMP("created_at" / 1000000)))
            AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at" / 1000000) < '2023-01-01'
    GROUP BY "user_id"
),
relative_purchases AS (          -- Step-2: purchases in months 0-3 relative to cohort
    SELECT
        cb."user_id",
        DATEDIFF(
            'month',
            cb."first_purchase_month",
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))
        ) AS "month_number"
    FROM cohort_base cb
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
          ON cb."user_id" = o."user_id"
    WHERE o."status" = 'Complete'
      AND TO_TIMESTAMP(o."created_at" / 1000000) < '2023-01-01'
      AND DATEDIFF(
            'month',
            cb."first_purchase_month",
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))
          ) BETWEEN 0 AND 3
    GROUP BY cb."user_id",
             DATEDIFF(
                 'month',
                 cb."first_purchase_month",
                 DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))
             )
),
totals AS (                      -- Step-3: denominator
    SELECT COUNT(DISTINCT "user_id") AS "total_users"
    FROM cohort_base
)
-- Step-4: final % of shoppers purchasing in each month_number
SELECT
    rp."month_number"                             AS "months_since_first_purchase",
    ROUND(COUNT(DISTINCT rp."user_id") * 100.0 /
          t."total_users", 2)                    AS "pct_of_users_with_purchase"
FROM relative_purchases rp
CROSS JOIN totals t
GROUP BY rp."month_number", t."total_users"
ORDER BY rp."month_number";
```
