        MIN(DATE_TRUNC('month', TO_TIMESTAMP("created_at" / 1000000))) AS "first_purchase_month"
    FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
    WHERE "status" = 'Complete'
      AND TO_TIMESTAMP("created_at" / 1000000) < '2023-01-01'
    GROUP BY "user_id"
),
purchases AS (
    SELECT
        cb."user_id",
        DATEDIFF(
            'month',
            cb."first_purchase_month",
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))
        ) AS "month_number"
    FROM cohort_base cb
    JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
          ON cb."user_id" = o."user_id"
    WHERE o."status" = 'Complete'
      AND TO_TIMESTAMP(o."created_at" / 1000000) < '2023-01-01'
      AND DATEDIFF(
            'month',
            cb."first_purchase_month",
            DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))
          ) BETWEEN 0 AND 3
    GROUP BY cb."user_id",
             DATEDIFF(
                 'month',
                 cb."first_purchase_month",
                 DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))
             )
),
numerators AS (
    SELECT
        "month_number",
        COUNT(DISTINCT "user_id") AS "users_purchased"
    FROM purchases
    GROUP BY "month_number"
),
denominator AS (
    SELECT COUNT(DISTINCT "user_id") AS "total_users"
    FROM cohort_base
)
SELECT
    n."month_number",
    ROUND(n."users_purchased" * 100.0 / d."total_users", 2) AS "overall_pct_of_users"
FROM numerators n, denominator d
ORDER BY n."month_number"
LIMIT 20;
