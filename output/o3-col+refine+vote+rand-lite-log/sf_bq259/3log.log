Query:
--Description: Cohort sizes (denominator) – total users who made their first purchase in each month
SELECT
    "first_purchase_month",
    COUNT(DISTINCT "user_id") AS "cohort_size"
FROM (
        SELECT
            "user_id",
            MIN(DATE_TRUNC('month', TO_TIMESTAMP("created_at" / 1000000))) AS "first_purchase_month"
        FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
        WHERE "status" = 'Complete'
          AND TO_TIMESTAMP("created_at" / 1000000) < '2023-01-01'
        GROUP BY "user_id"
     ) cb                     --<< added required alias
GROUP BY "first_purchase_month"
ORDER BY "first_purchase_month"
LIMIT 20
