```sql
--Description: Join orders to their cohort month and calculate months since first purchase (0 = first month)
SELECT o."user_id",
       fp."first_purchase_month",
       DATE_TRUNC('month',TO_TIMESTAMP(o."created_at"/1000000))   AS "order_month",
       DATEDIFF('month',
                fp."first_purchase_month",
                DATE_TRUNC('month',TO_TIMESTAMP(o."created_at"/1000000))) AS "month_number"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
JOIN (
      SELECT "user_id",
             MIN(DATE_TRUNC('month',TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
      WHERE "status" = 'Complete'
        AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
      GROUP BY "user_id"
     ) fp
  ON o."user_id" = fp."user_id"
WHERE o."status" = 'Complete'
  AND TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
LIMIT 20;
```

```sql
--Description: Count distinct purchasing users per cohort and month_number (0-4) – i.e., retention matrix numerator
SELECT fp."first_purchase_month",
       d."month_number",
       COUNT(DISTINCT d."user_id") AS "users_purchased"
FROM (
      SELECT "user_id",
             MIN(DATE_TRUNC('month',TO_TIMESTAMP("created_at"/1000000))) AS "first_purchase_month"
      FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"
      WHERE "status" = 'Complete'
        AND TO_TIMESTAMP("created_at"/1000000) < '2023-01-01'
      GROUP BY "user_id"
     ) fp
JOIN "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS" o
  ON fp."user_id" = o."user_id"
JOIN LATERAL (
      SELECT DATEDIFF('month',
                      fp."first_purchase_month",
                      DATE_TRUNC('month',TO_TIMESTAMP(o."created_at"/1000000))) AS "month_number"
 ) d
WHERE o."status" = 'Complete'
  AND TO_TIMESTAMP(o."created_at"/1000000) < '2023-01-01'
  AND d."month_number" BETWEEN 0 AND 3
GROUP BY fp."first_purchase_month", d."month_number"
ORDER BY fp."first_purchase_month", d."month_number"
LIMIT 20;
```

```sql
--Description: Compute cohort sizes (denominator) – number of users making their first purchase in each cohort month
