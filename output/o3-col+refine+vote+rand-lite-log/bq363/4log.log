```sql
-- 1) Peek at raw seconds & fare values for a handful of trips
SELECT `unique_key`,
       `trip_seconds`,
       `fare`
FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT  20;
```

```sql
-- 2) Convert the seconds to *rounded* minutes so we can see the new column
SELECT `unique_key`,
       `trip_seconds`,
       ROUND(trip_seconds / 60.0) AS trip_minutes,
       `fare`
FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT  20;
```

```sql
-- 3) Look at distinct minute-values that fall between 1-50 minutes
SELECT DISTINCT
       ROUND(trip_seconds / 60.0) AS trip_minutes
FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE  trip_seconds BETWEEN 60 AND 3000
ORDER BY trip_minutes
LIMIT  20;
```

```sql
-- 4) How many trips exist for each rounded minute value (1-50)?
SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
       COUNT(*)                   AS trips
FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE  trip_seconds BETWEEN 60 AND 3000
GROUP  BY trip_minutes
ORDER  BY trip_minutes
LIMIT  20;
```

```sql
-- 5) Same as #4 but ordered by most-frequent durations
SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
       COUNT(*)                   AS trips
FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE  trip_seconds BETWEEN 60 AND 3000
GROUP  BY trip_minutes
ORDER  BY trips DESC
LIMIT  20;
```

```sql
-- 6) Assign every qualifying trip to one of 10 NTILE quantile buckets
SELECT `unique_key`,
       ROUND(trip_seconds / 60.0)            AS trip_minutes,
       NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS quantile
FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE  trip_seconds BETWEEN 60 AND 3000
LIMIT  20;
```

```sql
-- 7) Preview the min / max duration that falls into each NTILE bucket
WITH base AS (
  SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS tile
  FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE  trip_seconds BETWEEN 60 AND 3000
)
SELECT tile,
       MIN(trip_minutes) AS min_minutes,
       MAX(trip_minutes) AS max_minutes
FROM   base
GROUP  BY tile
ORDER  BY tile
LIMIT  20;
```

```sql
-- 8) Add trip counts & average fare to each tile
WITH base AS (
  SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
         fare,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS tile
  FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE  trip_seconds BETWEEN 60 AND 3000
        AND fare IS NOT NULL
)
SELECT tile,
       MIN(trip_minutes)      AS min_minutes,
       MAX(trip_minutes)      AS max_minutes,
       COUNT(*)               AS total_trips,
       AVG(fare)              AS avg_fare
FROM   base
GROUP  BY tile
ORDER  BY tile;
```

```sql
-- 9) Format the minute ranges as "XXm to XXm" (zero-padded), 
--    and the average fare to two decimals
WITH base AS (
  SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
         fare,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS tile
  FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE  trip_seconds BETWEEN 60 AND 3000
        AND fare IS NOT NULL
)
SELECT tile,
       CONCAT(
         LPAD(CAST(MIN(trip_minutes) AS STRING), 2, '0'), 'm to ',
         LPAD(CAST(MAX(trip_minutes) AS STRING), 2, '0'), 'm'
       )                            AS time_range,
       COUNT(*)                     AS total_trips,
       FORMAT('%.2f', AVG(fare))    AS average_fare
FROM   base
GROUP  BY tile
ORDER  BY MIN(trip_minutes);
```

```sql
-- 10) FINAL ANSWER – total trips & average fare for each of the 10 equal-sized
--     quantile groups of rounded durations (1-50 minutes), chronologically sorted
WITH eligible AS (
  SELECT ROUND(trip_seconds / 60.0) AS trip_minutes,
         fare,
         NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS tile
  FROM   `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE  trip_seconds BETWEEN 60 AND 3000      -- 1-50 minutes
        AND fare IS NOT NULL                   -- needed for avg()
)
SELECT CONCAT(
         LPAD(CAST(MIN(trip_minutes) AS STRING), 2, '0'), 'm to ',
         LPAD(CAST(MAX(trip_minutes) AS STRING), 2, '0'), 'm'
       )                          AS time_range,
       COUNT(*)                   AS total_trips,
       FORMAT('%.2f', AVG(fare))  AS average_fare
FROM   eligible
GROUP  BY tile
ORDER  BY MIN(trip_minutes);
```
