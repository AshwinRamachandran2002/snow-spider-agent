```sql
--Description: 1) Peek at a handful of raw taxi-trip rows.
SELECT
  `unique_key`,
  `trip_start_timestamp`,
  `trip_seconds`,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 2) Look at the same rows but convert trip-seconds to minutes (rounded).
SELECT
  `unique_key`,
  ROUND(`trip_seconds`/60.0) AS rounded_min,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
LIMIT 20;
```

```sql
--Description: 3) Find distinct rounded-minute values that fall between 1-50 minutes.
SELECT DISTINCT
  ROUND(`trip_seconds`/60.0) AS rounded_min
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE ROUND(`trip_seconds`/60.0) BETWEEN 1 AND 50
ORDER BY rounded_min
LIMIT 20;
```

```sql
--Description: 4) Count the number of trips for each rounded-minute value (1-50) to see the spread.
SELECT
  ROUND(`trip_seconds`/60.0) AS rounded_min,
  COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE ROUND(`trip_seconds`/60.0) BETWEEN 1 AND 50
GROUP BY rounded_min
ORDER BY rounded_min
LIMIT 20;
```

```sql
--Description: 5) Assign every qualifying trip to one of 10 NTILE buckets and show a sample.
SELECT
  `unique_key`,
  ROUND(`trip_seconds`/60.0)    AS rounded_min,
  NTILE(10) OVER (ORDER BY ROUND(`trip_seconds`/60.0)) AS quantile
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE ROUND(`trip_seconds`/60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
--Description: 6) Summarise each NTILE bucket with min/max minutes and average fare (raw).
SELECT
  NTILE(10) OVER (ORDER BY ROUND(`trip_seconds`/60.0)) AS quantile,
  MIN(ROUND(`trip_seconds`/60.0))                       AS min_minute,
  MAX(ROUND(`trip_seconds`/60.0))                       AS max_minute,
  AVG(`fare`)                                           AS avg_fare
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE ROUND(`trip_seconds`/60.0) BETWEEN 1 AND 50
GROUP BY quantile
LIMIT 20;
```

```sql
--Description: 7) Same as above but format the minute range and the average fare.
SELECT
  LPAD(CAST(MIN(ROUND(`trip_seconds`/60.0)) AS STRING),2,'0') || 'm to ' ||
  LPAD(CAST(MAX(ROUND(`trip_seconds`/60.0)) AS STRING),2,'0') || 'm' AS time_range,
  COUNT(*)                                                  AS total_trips,
  FORMAT('%.2f', AVG(`fare`))                               AS average_fare
FROM (
  SELECT
    ROUND(`trip_seconds`/60.0)                              AS rounded_min,
    `fare`,
    NTILE(10) OVER (ORDER BY ROUND(`trip_seconds`/60.0))    AS quantile
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE ROUND(`trip_seconds`/60.0) BETWEEN 1 AND 50
)
GROUP BY quantile
ORDER BY time_range
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – 10 quantile groups, total trips & avg fare (formatted).
WITH eligible AS (
  SELECT
    ROUND(`trip_seconds`/60.0) AS rounded_min,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE ROUND(`trip_seconds`/60.0) BETWEEN 1 AND 50
),
bucketed AS (
  SELECT
    rounded_min,
    `fare`,
    NTILE(10) OVER (ORDER BY rounded_min) AS quantile
  FROM eligible
)
SELECT
  LPAD(CAST(MIN(rounded_min) AS STRING),2,'0') || 'm to ' ||
  LPAD(CAST(MAX(rounded_min) AS STRING),2,'0') || 'm' AS time_range,
  COUNT(*)                           AS total_trips,
  FORMAT('%.2f', AVG(`fare`))        AS average_fare
FROM bucketed
GROUP BY quantile
ORDER BY MIN(rounded_min);
```

