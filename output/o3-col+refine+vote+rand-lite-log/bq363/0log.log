```sql
--Description / Thinking process:
-- We need min-max duration (rounded minutes) and average fare for 10 equal-sized
-- quantiles of trips whose rounded duration is 1-50 minutes.
-- Problem: NTILE(10) is an analytic function and cannot be placed directly in
-- GROUP BY; therefore:
--   1. Filter to “eligible” trips (rounded 1-50 minutes).
--   2. In a subquery, compute NTILE(10) OVER (ORDER BY rounded_min) to assign
--      each eligible trip to one of the ten buckets.  This executes before any
--      aggregation.
--   3. In the outer query, GROUP BY that pre-computed quantile to derive:
--        • minimum rounded_min  -> bucket’s lower bound
--        • maximum rounded_min  -> bucket’s upper bound
--        • average fare         -> mean fare per bucket
--   4. ORDER BY quantile to list results from shortest to longest durations.
WITH eligible AS (
  SELECT
    ROUND(trip_seconds / 60.0) AS rounded_min,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
),
bucketed AS (
  SELECT
    NTILE(10) OVER (ORDER BY rounded_min) AS quantile,
    rounded_min,
    fare
  FROM eligible
)
SELECT
  quantile,
  MIN(rounded_min) AS min_minute,
  MAX(rounded_min) AS max_minute,
  AVG(fare)        AS avg_fare
FROM bucketed
GROUP BY quantile
ORDER BY quantile;
```
