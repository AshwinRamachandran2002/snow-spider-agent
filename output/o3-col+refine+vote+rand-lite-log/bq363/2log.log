```sql
--Description / Thinking process:
-- We need 10 equal-sized quantile groups (NTILE = 10) based on each trip’s
-- rounded duration in minutes, considering only trips that last 1–50 minutes
-- (60–3000 seconds).
--
-- 1) Inner SELECT:
--      • Compute trip_min  =  ROUND(trip_seconds / 60).
--      • Apply NTILE(10)   =  decile label for each trip.
--
-- 2) Middle aggregation:
--      • For each decile gather:
--          – MIN(trip_min)  → lower bound of range
--          – MAX(trip_min)  → upper bound of range
--          – COUNT(*)       → total trips
--          – AVG(fare)      → mean fare
--
-- 3) Outer SELECT:
--      • Format the time range as “XXm to XXm” (zero-padded two-digit minutes).
--      • Format the average fare to two decimals.
--      • Sort by the numeric lower bound so ranges appear chronologically.
SELECT
  CONCAT(
    LPAD(CAST(min_minutes AS STRING), 2, '0'), 'm to ',
    LPAD(CAST(max_minutes AS STRING), 2, '0'), 'm'
  )                         AS time_range,
  trips                     AS total_trips,
  FORMAT('%.2f', avg_fare)  AS avg_fare
FROM (
  SELECT
    decile,
    MIN(trip_min) AS min_minutes,
    MAX(trip_min) AS max_minutes,
    COUNT(*)      AS trips,
    AVG(fare)     AS avg_fare
  FROM (
    SELECT
      ROUND(trip_seconds / 60.0) AS trip_min,
      fare,
      NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS decile
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE trip_seconds BETWEEN 60 AND 3000          -- 1–50 minute trips
  )
  GROUP BY decile
)
ORDER BY min_minutes;
```
