Query:
--Description: Produce nicely formatted time ranges (“XXm to XXm”), the total
--             trips, and the average fare (2-decimals) for each decile.
--             Requires two nesting levels:  (1) compute NTILE labels,
--             (2) aggregate by decile, then (3) format the final output.
SELECT
  CONCAT(
    LPAD(CAST(min_minutes AS STRING), 2, '0'), 'm to ',
    LPAD(CAST(max_minutes AS STRING), 2, '0'), 'm'
  )                         AS time_range,
  trips                     AS total_trips,
  FORMAT('%.2f', avg_fare)  AS avg_fare
FROM (
  SELECT
    decile,
    MIN(trip_min) AS min_minutes,
    MAX(trip_min) AS max_minutes,
    COUNT(*)      AS trips,
    AVG(fare)     AS avg_fare
  FROM (
    SELECT
      ROUND(trip_seconds / 60.0)                                   AS trip_min,
      fare,
      NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS decile
    FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
    WHERE trip_seconds BETWEEN 60 AND 3000            -- 1-50-minute trips
  ) AS t2
  GROUP BY decile
) AS g
ORDER BY min_minutes
LIMIT 20
