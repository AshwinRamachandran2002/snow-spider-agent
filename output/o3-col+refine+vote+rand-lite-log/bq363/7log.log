```sql
--Description: Quick glimpse at trip duration (in seconds) and fare amounts.
SELECT 
  `trip_seconds`, 
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL 
  AND fare IS NOT NULL
LIMIT 20;
```

```sql
--Description: Look at some distinct rounded trip-duration values (minutes).
SELECT DISTINCT 
  ROUND(trip_seconds/60.0) AS trip_minutes
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
LIMIT 20;
```

```sql
--Description: Count of trips by rounded minute value to see the distribution.
SELECT 
  ROUND(trip_seconds/60.0) AS trip_minutes,
  COUNT(*) AS trips
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
GROUP BY trip_minutes
ORDER BY trip_minutes
LIMIT 20;
```

```sql
--Description: Sample of trips whose rounded duration is 1–50 minutes.
SELECT 
  `unique_key`,
  ROUND(trip_seconds/60.0) AS trip_minutes,
  `fare`
FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
WHERE trip_seconds IS NOT NULL
  AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
LIMIT 20;
```

```sql
--Description: Assign each qualifying trip to one of ten NTILE(10) buckets.
WITH trips AS (
  SELECT
    `unique_key`,
    ROUND(trip_seconds/60.0) AS trip_minutes,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND fare IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
)
SELECT
  NTILE(10) OVER (ORDER BY trip_minutes) AS quantile,
  trip_minutes,
  fare
FROM trips
LIMIT 20;
```

```sql
--Description: Aggregate min/max minute, total trips, and average fare per quantile.
WITH trips AS (
  SELECT
    ROUND(trip_seconds/60.0) AS trip_minutes,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND fare IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
),
bucketed AS (
  SELECT
    NTILE(10) OVER (ORDER BY trip_minutes) AS quantile,
    trip_minutes,
    fare
  FROM trips
)
SELECT
  quantile,
  MIN(trip_minutes) AS min_minute,
  MAX(trip_minutes) AS max_minute,
  COUNT(*)       AS total_trips,
  AVG(fare)      AS avg_fare
FROM bucketed
GROUP BY quantile
ORDER BY min_minute
LIMIT 20;
```

```sql
--Description: Same aggregation, but nicely formatted time-range label and avg fare.
WITH trips AS (
  SELECT
    ROUND(trip_seconds/60.0) AS trip_minutes,
    `fare`
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND fare IS NOT NULL
    AND ROUND(trip_seconds/60.0) BETWEEN 1 AND 50
),
bucketed AS (
  SELECT
    NTILE(10) OVER (ORDER BY trip_minutes) AS quantile,
    trip_minutes,
    fare
  FROM trips
),
agg AS (
  SELECT
    quantile,
    MIN(trip_minutes) AS min_minute,
    MAX(trip_minutes) AS max_minute,
    COUNT(*)       AS total_trips,
    AVG(fare)      AS avg_fare
  FROM bucketed
  GROUP BY quantile
)
SELECT
  CONCAT(
    LPAD(CAST(min_minute AS STRING),2,'0'),'m to ',
    LPAD(CAST(max_minute AS STRING),2,'0'),'m'
  ) AS time_range,
  total_trips,
  FORMAT('%.2f', avg_fare) AS avg_fare
FROM agg
ORDER BY min_minute
LIMIT 20;
```

```sql
