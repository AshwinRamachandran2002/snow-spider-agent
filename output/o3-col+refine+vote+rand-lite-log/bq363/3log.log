```sql
-- THINKING PROCESS & FINAL QUERY
-- Goal: For trips 1–50 rounded minutes long, build 10 equal-sized NTILE groups,
-- then show: (a) zero-padded "XXm to XXm" time range, (b) total trips,
-- (c) average fare formatted to two decimals, ordered chronologically.
--
-- 1. Convert trip_seconds → rounded_minutes and keep 1-50 mins.
-- 2. NTILE(10) OVER (ORDER BY rounded_minutes) assigns each trip to one
--    of ten quantiles of equal row-count.
-- 3. Aggregate each quantile: MIN & MAX minutes define the range, COUNT(*) trips,
--    AVG(fare) mean fare.
-- 4. Format the range and fare as requested and sort by earliest minute.

WITH quant AS (
  SELECT
    NTILE(10) OVER (ORDER BY ROUND(trip_seconds / 60.0)) AS qtile,
    ROUND(trip_seconds / 60.0)                           AS rounded_minutes,
    fare
  FROM `bigquery-public-data.chicago_taxi_trips.taxi_trips`
  WHERE trip_seconds IS NOT NULL
    AND ROUND(trip_seconds / 60.0) BETWEEN 1 AND 50
),
agg AS (
  SELECT
    qtile,
    MIN(rounded_minutes) AS min_min,
    MAX(rounded_minutes) AS max_min,
    COUNT(*)             AS total_trips,
    AVG(fare)            AS avg_fare
  FROM quant
  GROUP BY qtile
)
SELECT
  CONCAT(
    LPAD(CAST(min_min AS STRING), 2, '0'), 'm to ',
    LPAD(CAST(max_min AS STRING), 2, '0'), 'm'
  )                       AS time_range,
  total_trips,
  FORMAT('%.2f', avg_fare) AS avg_fare
FROM agg
ORDER BY min_min;
```
