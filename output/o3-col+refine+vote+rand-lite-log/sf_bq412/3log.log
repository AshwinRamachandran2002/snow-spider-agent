--         • availability date is NULL
--         • at least one audience-selection field ≠  ‘CRITERIA_UNUSED’
--
--Reasoning steps inside the query
--1.  region_stats is an ARRAY → FLATTEN to reach each region object as rs.value.
--2.  disapproval is an ARRAY → FLATTEN to expose removal_reason / violation_category as d.value.
--3.  audience_selection_approach_info is a JSON OBJECT (not an array); we can reference its keys
--    directly without FLATTEN, so we keep rcs.* for that test.
--4.  Apply all requested filters, then order by last_shown DESC and limit 5.

SELECT  rcs."creative_page_url"                                                            AS "page_url",
        rs.value:"first_shown"::DATE                                                       AS "first_shown",
        rs.value:"last_shown"::DATE                                                        AS "last_shown",
        d.value:"removal_reason"::STRING                                                   AS "removal_reason",
