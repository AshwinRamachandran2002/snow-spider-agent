Query:
--Description: 10) Combine all six pollutants into one table of monthly averages for California, 2020
WITH
  pm10 AS (
    SELECT FORMAT_DATE('%Y-%m', date_local) AS month,
           AVG(arithmetic_mean)             AS pm10
    FROM `bigquery-public-data.epa_historical_air_quality.pm10_daily_summary`
    WHERE state_name = 'California' AND EXTRACT(YEAR FROM date_local)=2020
    GROUP BY month
  ),
  pm25_frm AS (
