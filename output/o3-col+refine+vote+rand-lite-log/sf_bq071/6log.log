```sql
/*  Count the number of (named) hurricanes whose individual
    track points fall inside each ZIP-code polygon, and list
    the hurricane names (alphabetically, comma-separated).

    Assumptions about column names in the ZIP-code boundary
    table:
      • "zip_code"  –  5-digit ZIP
      • "city"      –  primary city for the ZIP
      • "state"     –  2-letter state abbreviation
      • "shape_geometry" – WKB polygon/multipolygon geometry
*/

WITH
-- 1.  Hurricane track points (exclude “UNNAMED” storms)
hurricanes AS (
    SELECT
        "name"      AS hurricane_name,
        "latitude"  AS lat,
        "longitude" AS lon
    FROM NOAA_DATA_PLUS.NOAA_HURRICANES.HURRICANES
    WHERE   "latitude"  IS NOT NULL
        AND "longitude" IS NOT NULL
        AND UPPER(TRIM("name")) <> 'UNNAMED'
),

-- 2.  ZIP-code polygons
zip_polygons AS (
    SELECT
        "zip_code"                                       AS zip_code,
        "city"                                           AS city,
        "state"                                          AS state,
        ST_GEOMFROMWKB("shape_geometry")                 AS geom          -- convert WKB to GEOGRAPHY/GEOMETRY
    FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES.US_ZIP_CODES
)

-- 3.  Spatial join, aggregate, and present results
SELECT
    z.city,
    z.zip_code                                        AS zip_code,
    z.state,
    COUNT(DISTINCT h.hurricane_name)                  AS hurricane_count,
    LISTAGG(DISTINCT h.hurricane_name, ', ')
        WITHIN GROUP (ORDER BY h.hurricane_name)      AS hurricane_names
FROM zip_polygons z
JOIN hurricanes h
      ON ST_WITHIN( ST_POINT(h.lon, h.lat), z.geom )  -- point must fall inside polygon
GROUP BY z.city, z.zip_code, z.state
ORDER BY hurricane_count DESC NULLS LAST;
```
