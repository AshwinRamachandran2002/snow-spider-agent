Query:
--Description: Count hurricane events in 2023 by county/zone (using the existing “cz_name”
--field instead of a spatial join, because 2023 hurricane rows have no coordinates).  
--Lists the 20 counties/zones with the most hurricane reports.
SELECT  "state",
        "cz_name",
        COUNT(*) AS "hurricane_count"
FROM    "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
WHERE   "event_type" ILIKE '%hurricane%'
GROUP BY "state", "cz_name"
ORDER BY "hurricane_count" DESC
LIMIT 20
