/*  Hurricanes by (city, ZIP-code) – count plus alphabetised list of names
    ----------------------------------------------------------------------
    Because a dedicated ZIP-code boundary table is not available in the
    provided Snowflake environment, we approximate “ZIP code” with the
    Storm-Data county/zone FIPS identifier (“cz_fips_code”).  That field
    is present in every Storm-Data table and is treated here as the ZIP
    surrogate while “cz_name” supplies the city/area description.

    Only hurricanes with a non-null, explicit name are kept.
*/
WITH hurricanes AS (

    /* ---------- 1956 --------------------------------------------------- */
    SELECT  "state",
            "cz_fips_code"              AS "zip_code",
            "cz_name"                   AS "city",
            "event_name"
    FROM    "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1956"
