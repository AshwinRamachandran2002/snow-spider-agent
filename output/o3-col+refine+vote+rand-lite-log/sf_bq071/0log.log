```sql
--Description: Produce, for 2021, each state’s count of unique hurricane names
--and a comma-separated list of those names.
SELECT  "state",
        COUNT(DISTINCT "event_name")                                        AS "unique_hurricane_count",
        LISTAGG(DISTINCT "event_name", ', ') WITHIN GROUP (ORDER BY "event_name") AS "hurricanes"
FROM    "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
WHERE   "event_type" ILIKE '%hurricane%'
  AND   "event_name" IS NOT NULL
GROUP BY "state"
ORDER BY "unique_hurricane_count" DESC
LIMIT 20;
