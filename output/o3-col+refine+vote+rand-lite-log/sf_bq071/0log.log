--We then filter for hurricane-type events that have valid coordinates and
--return a sample of 20 rows, showing which forecast zone each point falls in.
SELECT  s."event_id",
        s."state",
        s."event_type",
        z."state" AS "zone_state",
        z."zone"  AS "zone_code",
        z."name"  AS "zone_name"
FROM    "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"          s
JOIN    "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."NWS_FORECAST_REGIONS" z
      ON ST_WITHIN(
           TO_GEOGRAPHY('POINT(' || s."event_longitude" || ' ' || s."event_latitude" || ')'),
           TO_GEOGRAPHY(z."shape_geometry")
         )
WHERE   s."event_type"      ILIKE '%hurricane%'
  AND   s."event_latitude"   IS NOT NULL
  AND   s."event_longitude"  IS NOT NULL
LIMIT 20;
