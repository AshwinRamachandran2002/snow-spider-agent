```sql
--Description: Combine the 2023, 2021, and 2019 storm tables and return 20 hurricane
--events that actually have latitude/longitude.  The NOT NULL filter removes the
--many rows that lack coordinates in 2023/2021, but retains any from 2019.
SELECT  "event_id",
        "state",
        "event_type",
        "event_name",
        "event_latitude",
        "event_longitude"
FROM (
        SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
        UNION ALL
        SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
        UNION ALL
        SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
     )
WHERE   "event_type"     ILIKE '%hurricane%'
  AND   "event_latitude"  IS NOT NULL
  AND   "event_longitude" IS NOT NULL
LIMIT 20;
```
