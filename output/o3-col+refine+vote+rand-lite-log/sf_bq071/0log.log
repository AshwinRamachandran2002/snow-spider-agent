```sql
--Description: Example spatial join – place 2023 hurricane points inside forecast-zone polygons, returning just a sample.  
SELECT s."EVENT_ID",
       s."STATE",
       s."EVENT_TYPE",
       z."STATE"  AS "ZONE_STATE",
       z."ZONE"   AS "ZONE_CODE",
       z."NAME"   AS "ZONE_NAME"
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"  s
JOIN   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."NWS_FORECAST_REGIONS" z
       ON ST_WITHIN(
            TO_GEOGRAPHY('POINT(' || s."EVENT_LONGITUDE" || ' ' || s."EVENT_LATITUDE" || ')'),
            z."SHAPE_GEOMETRY"
          )
WHERE  s."EVENT_TYPE" ILIKE '%hurricane%'
  AND  s."EVENT_LATITUDE"  IS NOT NULL
  AND  s."EVENT_LONGITUDE" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Count how many hurricane events occur in each forecast zone (sample – 2023 only).  
SELECT z."STATE"       AS "STATE",
       z."ZONE"        AS "ZONE_CODE",
       z."NAME"        AS "ZONE_NAME",
       COUNT(*)        AS "HURRICANE_COUNT"
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023" s
JOIN   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."NWS_FORECAST_REGIONS" z
       ON ST_WITHIN(
            TO_GEOGRAPHY('POINT(' || s."EVENT_LONGITUDE" || ' ' || s."EVENT_LATITUDE" || ')'),
            z."SHAPE_GEOMETRY"
          )
WHERE  s."EVENT_TYPE" ILIKE '%hurricane%'
GROUP  BY 1,2,3
ORDER BY "HURRICANE_COUNT" DESC
LIMIT 20;
```

