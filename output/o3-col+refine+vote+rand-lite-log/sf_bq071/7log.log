Query:
--Description:  ❹  Quickly see how many hurricane events each state recorded in 2021.  
SELECT 
  "state",
  COUNT(*) AS "hurricane_events_2021"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
WHERE "event_type" ILIKE '%hurricane%'
GROUP BY "state"
ORDER BY "hurricane_events_2021" DESC
LIMIT 20;
