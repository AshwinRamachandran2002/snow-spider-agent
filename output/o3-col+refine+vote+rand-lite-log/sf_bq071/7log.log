/*  Hurricanes that track inside U.S. ZIP-code polygons
    ----------------------------------------------------
    • Take every NAMED best-track position from the HURDAT2 file.
    • Keep only points whose name is not “UNNAMED”.
    • Convert each point to GEOGRAPHY and spatially join to the
      ZIP-code polygons.
    • For every (city, ZIP, state) return the number of DISTINCT
      hurricane names that entered the ZIP and the alphabetised list
      of those names.
    • Sort by the count, largest first.                                  */

WITH hurricanes AS (          -- every named hurricane track position
    SELECT
        UPPER(TRIM("name"))                                   AS "name",
        GEOGRAPHY_POINT("longitude", "latitude")              AS "geom"
    FROM NOAA_DATA_PLUS.NOAA_HURRICANES."HURDAT2_BEST_TRACKS"
    WHERE "name" IS NOT NULL
      AND UPPER(TRIM("name")) NOT IN ('UNNAMED', '')
),
zips AS (                     -- ZIP-code polygons
    SELECT
        "po_name"        AS "city",
        "zip_code",
        "state_usps"     AS "state",
        "geom"           -- GEOGRAPHY polygon
    FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES."US_ZIP_CODES"
)

SELECT
    z."city",
    z."zip_code",
    z."state",
    COUNT(DISTINCT h."name")                                                AS "hurricane_count",
    LISTAGG(DISTINCT h."name", ', ') WITHIN GROUP (ORDER BY h."name")       AS "hurricane_names"
FROM zips z
JOIN hurricanes h
  ON ST_WITHIN(h."geom", z."geom")
GROUP BY
    z."city",
    z."zip_code",
    z."state"
ORDER BY
    "hurricane_count" DESC NULLS LAST;
```
