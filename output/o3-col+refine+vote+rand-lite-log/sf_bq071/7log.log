```sql
--Description:  ❼  Build a GEOGRAPHY point for every hurricane record so we can do spatial joins later.  
SELECT 
  "event_id",
  "state",
  "event_type",
  ST_POINT("event_longitude", "event_latitude") AS "event_geo"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
WHERE "event_type" ILIKE '%hurricane%'
  AND "event_latitude" IS NOT NULL
  AND "event_longitude" IS NOT NULL
LIMIT 20;
```

```sql
--Description:  ❽  Preview the National Weather Service forecast-zone polygons so we can validate geometries.  
SELECT 
  "state_zone",
  "name",
  "state",
  ST_ASTEXT(TO_GEOGRAPHY("shape_geometry")) AS "wkt"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS"
LIMIT 20;
```

```sql
--Description:  ❾  Example of a spatial containment test: find which hurricane events (2021) fall inside each forecast zone.  
SELECT 
  r."state_zone",
  r."state",
  r."name" AS "forecast_zone_name",
  COUNT(e."event_id") AS "hurricane_events_in_zone"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" r
JOIN (
  SELECT 
    "event_id",
    ST_POINT("event_longitude", "event_latitude") AS "event_geo"
  FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
  WHERE "event_type" ILIKE '%hurricane%'
    AND "event_latitude" IS NOT NULL
    AND "event_longitude" IS NOT NULL
) e
  ON ST_WITHIN(e."event_geo", TO_GEOGRAPHY(r."shape_geometry"))
GROUP BY r."state_zone", r."state", r."forecast_zone_name"
ORDER BY "hurricane_events_in_zone" DESC
LIMIT 20;
```

```sql
--Description:  ❿  Illustrative final-step query outline: aggregate named hurricanes by city & ZIP once a ZIP-boundary
--              dataset is identified (replace ZIP_BOUNDARIES.US_ZIP_CODES with the real table when available).
SELECT 
  z."city",
  z."zip_code",
  z."state",
  COUNT(DISTINCT h."hurricane_id") AS "hurricane_count",
  LISTAGG(DISTINCT h."hurricane_name", ', ' ORDER BY h."hurricane_name") AS "hurricane_names"
FROM ZIP_BOUNDARIES.US_ZIP_CODES z
JOIN (
  /* Derive hurricane point & name from storms tables (all years) */
  SELECT 
    "event_id"      AS "hurricane_id",
    /* simple parse — adjust once the exact name column is confirmed */
    SPLIT_PART("event_narrative", ' ', 1) AS "hurricane_name",
    ST_POINT("event_longitude", "event_latitude") AS "geo_pt"
  FROM (
    SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1956"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1960"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1962"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1964"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1968"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1985"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2000"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2002"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
    UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
  )
  WHERE "event_type" ILIKE '%hurricane%'
    AND "event_latitude" IS NOT NULL
    AND "event_longitude" IS NOT NULL
    AND "event_narrative" IS NOT NULL
) h
  ON ST_WITHIN(h."geo_pt", TO_GEOGRAPHY(z."shape_geometry"))
  /* “Unnamed” storms omitted */
  AND h."hurricane_name" NOT ILIKE '%unnamed%'
GROUP BY z."city", z."zip_code", z."state"
ORDER BY "hurricane_count" DESC
LIMIT 20;
```

The sequence starts with very small inspections, moves to state-level summaries, introduces spatial joins with the forecast-zone polygons, and finally outlines a full city/ZIP-level aggregation once a ZIP-code boundary table is located.
