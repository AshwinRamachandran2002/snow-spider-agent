--Description:  ❸  Get the same distinct list, but across every year’s table that exists, to see all hurricane-style labels.  
SELECT DISTINCT "event_type"
FROM (
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1956"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1960"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1962"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1964"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1968"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1985"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2000"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2002"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
  UNION ALL
  SELECT "event_type" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
) t
WHERE "event_type" ILIKE '%hurricane%'
LIMIT 20;
