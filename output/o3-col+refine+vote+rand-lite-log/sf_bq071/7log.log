```sql
/*  Hurricanes that track inside U.S. ZIP-code polygons
    ----------------------------------------------------
    • Pull every named hurricane track point (name ≠ ‘UNNAMED’)
      from the NOAA hurricane-tracks table and build a GEOGRAPHY point.
    • Join those points to the GEOGRAPHY polygon for each ZIP code.
    • Aggregate per city-ZIP-state: 
        – how many different hurricanes reached that ZIP
        – alphabetised, comma-separated list of their names.
    • Sort by the number of hurricanes, biggest first.          */

WITH hurricanes AS (   -- every named track point
    SELECT
        UPPER(TRIM("name"))                              AS "name",
        GEOGRAPHY_POINT("lon","lat")                     AS "geom"
    FROM NOAA_DATA_PLUS.NOAA_HURRICANES."HURRICANE_TRACKS"
    WHERE "name" IS NOT NULL
      AND UPPER(TRIM("name")) NOT IN ('UNNAMED','')
),
zips AS (              -- ZIP-code polygons
    SELECT
        "po_name"                              AS "city",
        "zip_code",
        "state_usps"                           AS "state",
        "geom"                                 -- GEOGRAPHY polygon
    FROM NOAA_DATA_PLUS.GEO_US_BOUNDARIES."US_ZIP_CODES"
)

SELECT
    z."city",
    z."zip_code",
    z."state",
    COUNT(DISTINCT h."name")                                  AS "hurricane_count",
    LISTAGG(DISTINCT h."name", ', ') 
        WITHIN GROUP (ORDER BY h."name")                      AS "hurricane_names"
FROM zips z
JOIN hurricanes h
  ON ST_WITHIN(h."geom", z."geom")
GROUP BY
    z."city",
    z."zip_code",
    z."state"
ORDER BY
    "hurricane_count" DESC NULLS LAST;
```
