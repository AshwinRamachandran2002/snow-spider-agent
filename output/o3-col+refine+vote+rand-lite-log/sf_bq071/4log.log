--              1) Remove the leading word “Hurricane ” (any capitalization) with REGEXP_REPLACE,
--                 passing the case-insensitive flag 'i' instead of the inline (?i) syntax that
--                 caused an error earlier.
--              2) Trim any leftover whitespace.
--              3) Exclude rows whose EVENT_TYPE contains the word “unnamed”.
--              4) Return the first 20 distinct results so we can verify which named
--                 hurricanes are recorded in 2021.
SELECT DISTINCT
       RTRIM(
         LTRIM(
           REGEXP_REPLACE(
             "event_type",          -- source text
             '^hurricane\\s+',      -- pattern: leading “Hurricane ” plus spaces
             '',                    -- replace with empty string
             1,                     -- position to start
             0,                     -- 0 = replace all occurrences
             'i'                    -- case-insensitive flag
           )
         )
       ) AS "hurricane_name"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
WHERE  "event_type" ILIKE '%hurricane%'
  AND  "event_type" NOT ILIKE '%unnamed%'
LIMIT 20;
