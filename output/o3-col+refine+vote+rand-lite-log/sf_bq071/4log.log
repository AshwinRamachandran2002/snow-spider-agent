```sql
--Description: 1)  We need to confirm that the ST_WITHIN logic works after fixing the earlier
--              casting error.  The polygon column ("shape_geometry") is stored as WKB (BINARY),
--              so we wrap it in TO_GEOGRAPHY() to convert it to a GEOGRAPHY object.  
--              2)  The hurricane’s location is created with ST_POINT(long, lat), which already
--              yields a GEOGRAPHY point.  
--              3)  ST_WITHIN(point, polygon) then returns TRUE when the hurricane’s reported
--              coordinates lie inside the NWS forecast-region boundary that we matched on
--              state + county/zone name.  Limiting to 20 rows keeps the spatial calculation
--              lightweight while we validate the fix.
SELECT  s."event_id",
        s."state",
        s."cz_name",
        ST_WITHIN(
            ST_POINT(s."event_longitude", s."event_latitude"),   -- GEOGRAPHY point for hurricane
            TO_GEOGRAPHY(n."shape_geometry")                     -- GEOGRAPHY polygon for forecast region
        ) AS "is_within"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"  s
JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" n
  ON  UPPER(s."cz_name") = UPPER(n."name")
  AND UPPER(s."state")   = UPPER(n."state")
WHERE s."event_type" ILIKE '%hurricane%'
  AND s."event_latitude"  IS NOT NULL
  AND s."event_longitude" IS NOT NULL
LIMIT 20;
```
