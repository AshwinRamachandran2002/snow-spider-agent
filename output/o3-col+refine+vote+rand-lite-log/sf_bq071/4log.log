    – only events whose lat / lon fall INSIDE the ZIP-code polygon
    – ordered by hurricane count (highest first)                                */

WITH hurricanes AS (
    /* ---------- UNION every historic Storm-Data table that exists ---------- */
    SELECT  event_id,
            event_type,
            event_latitude   AS lat,
            event_longitude  AS lon,
            state
    FROM   (
              SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1956
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1960
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1962
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1964
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1968
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1985
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2000
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2002
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2011
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2019
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
       UNION ALL SELECT * FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2023
    )
    WHERE  LOWER(event_type)        LIKE '%hurricane%'
      AND  LOWER(event_type) NOT   LIKE '%unnamed%'
      AND  lat IS NOT NULL
      AND  lon IS NOT NULL
),

hurricanes_geo AS (
    SELECT  event_id,
            state,
            ST_POINT(lon , lat)                                      AS geom,
            RTRIM(
              LTRIM(
                REGEXP_REPLACE(
                    LOWER(event_type),
                    '^hurricane\\s+',
                    '',
                    1, 0, 'i'
                )
              )
            )                                                        AS hurricane_name
    FROM   hurricanes
),

/* ---------- ZIP-code polygons (BigQuery public-data copy) ---------- */
zip_shapes AS (
    SELECT  zip_code,                   -- 5-digit ZIP
            name       AS city,        -- USPS city-name
            usps_code  AS state,       -- 2-letter state code
            geom                       -- GEOGRAPHY polygon
    FROM    BIGQUERY_PUBLIC_DATA.GEO_US_BOUNDARIES.US_ZIP_CODES
),

/* ---------- spatial join ---------- */
joined AS (
    SELECT  z.city,
            z.zip_code,
            z.state,
            h.event_id,
            h.hurricane_name
    FROM    hurricanes_geo h
    JOIN    zip_shapes     z
           ON ST_WITHIN(h.geom , z.geom)
)

/* ---------- aggregate & output ---------- */
SELECT  city,
        zip_code,
        state,
        COUNT(DISTINCT event_id)                            AS count_hurricanes,
        LISTAGG( DISTINCT INITCAP(hurricane_name),
                  ', ' ) WITHIN GROUP (ORDER BY INITCAP(hurricane_name))
                                                           AS hurricanes
FROM    joined
GROUP BY city, zip_code, state
ORDER BY count_hurricanes DESC NULLS LAST;
