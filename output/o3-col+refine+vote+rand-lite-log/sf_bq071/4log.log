       MIN(s."event_id") AS "sample_event_id"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"    s
JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" n
     ON UPPER(s."cz_name") = UPPER(n."name")
    AND UPPER(s."state")   = UPPER(n."state")
WHERE s."event_type" ILIKE '%hurricane%'
GROUP BY s."state", s."cz_name"
LIMIT 20;
```

```sql
--Description: 8)  Build a POINT out of each storm’s lat/lon and check if it falls *within* its matched forecast-zone polygon using Snowflake’s ST_WITHIN.  
--        (Only a 20-row sample because the geometry test is heavy.)  
SELECT s."event_id",
       s."state",
       s."cz_name",
       ST_WITHIN(
           TO_GEOGRAPHY(ST_POINT(s."event_longitude", s."event_latitude")),
           n."shape_geometry"::GEOGRAPHY
       ) AS "is_within"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"    s
JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" n
     ON UPPER(s."cz_name") = UPPER(n."name")
    AND UPPER(s."state")   = UPPER(n."state")
WHERE s."event_type" ILIKE '%hurricane%'
  AND s."event_latitude"  IS NOT NULL
  AND s."event_longitude" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 9)  Extract just the hurricane *names* out of the event_type text (basic string cleanup) so we can aggregate on them later.  
--        Here we trim off the leading word “Hurricane” (case-insensitive) and any extra spaces.  
SELECT DISTINCT RTRIM(LTRIM(REGEXP_REPLACE("event_type", '(?i)^hurricane\\s+', ''))) AS "hurricane_name"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
WHERE "event_type" ILIKE '%hurricane%'
  AND "event_type" NOT ILIKE '%unnamed%'
LIMIT 20;
```

```sql
--Description: 10)  Prototype the full aggregation: for each (state, cz_name) count hurricanes and list names alphabetically, ignoring “unnamed” rows.  
--         Limited to 20 rows while testing.  
SELECT s."state",
       s."cz_name"              AS "city_or_zone",
       COUNT(DISTINCT s."event_id")                                        AS "cnt_hurricanes",
       LISTAGG(
           DISTINCT RTRIM(LTRIM(REGEXP_REPLACE(s."event_type", '(?i)^hurricane\\s+', ''))),
           ', ' ORDER BY 1
       ) AS "hurricane_names"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" s
WHERE s."event_type" ILIKE '%hurricane%'
  AND s."event_type" NOT ILIKE '%unnamed%'
GROUP BY s."state", s."cz_name"
ORDER BY "cnt_hurricanes" DESC
LIMIT 20;
```
