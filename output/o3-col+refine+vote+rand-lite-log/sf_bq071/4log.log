--Description: 10)  Aggregate 2021 hurricane events by state + county/zone:
--              • Count distinct EVENT_IDs (cnt_hurricanes).
--              • Build an alphabetical, comma-separated list of hurricane names
--                after stripping the leading word “Hurricane ” (case-insensitive)
--                with REGEXP_REPLACE that uses the 'i' flag rather than inline (?i).
--              • Exclude rows whose EVENT_TYPE contains “unnamed”.
--              • Show the top 20 areas by hurricane count.
SELECT  s."state",
        s."cz_name"                                          AS "city_or_zone",
        COUNT(DISTINCT s."event_id")                         AS "cnt_hurricanes",
        LISTAGG(
            DISTINCT RTRIM(
                       LTRIM(
                         REGEXP_REPLACE(
                           s."event_type",
                           '^hurricane\\s+',   -- pattern to remove
                           '',
                           1,                  -- start position
                           0,                  -- replace all
                           'i'                 -- case-insensitive flag
                         )
                       )
                     ),
            ', '
        ) WITHIN GROUP (ORDER BY
            RTRIM(
              LTRIM(
                REGEXP_REPLACE(
                  s."event_type",
                  '^hurricane\\s+',
                  '',
                  1,
                  0,
                  'i'
                )
              )
            )
        )                                                   AS "hurricane_names"
FROM    NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" s
WHERE   s."event_type" ILIKE '%hurricane%'
  AND   s."event_type" NOT ILIKE '%unnamed%'
GROUP BY s."state", s."cz_name"
ORDER BY "cnt_hurricanes" DESC
LIMIT   20;
