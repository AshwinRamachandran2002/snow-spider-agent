```sql
--Description:  
-- City/zip (forecast-zone) hurricane summary using STORMS_2021, which contains
-- the largest number of hurricane records with non-NULL coordinates (51 rows).
-- 1) Pull only hurricane events that have valid latitude/longitude and are not
--    labelled “unnamed”.  
-- 2) Convert each event to a GEOGRAPHY point and test if it lies within an NWS
--    forecast-zone polygon.  
-- 3) Aggregate by zone (used here as a ZIP-code proxy) to return the city/zone
--    name, zone code, state, count of hurricanes, and a comma-separated list of
--    distinct hurricane names.  Ordered by the count, highest first.
WITH hurr AS (
  SELECT
    "event_id",
    INITCAP("event_type") AS "hurr_name",
    "event_latitude",
    "event_longitude"
  FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
  WHERE "event_type" ILIKE '%hurricane%'
    AND "event_type" NOT ILIKE '%unnamed%'
    AND "event_latitude"  IS NOT NULL
    AND "event_longitude" IS NOT NULL
), hits AS (
  SELECT
    z."name"  AS "city_or_zone",
    z."zone"  AS "zip_proxy",
    z."state",
    h."hurr_name"
  FROM hurr h
  JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" z
    ON ST_WITHIN(
         TO_GEOGRAPHY(ST_POINT(h."event_longitude", h."event_latitude")),
         TO_GEOGRAPHY(z."shape_geometry")
       )
)
SELECT
  "city_or_zone" AS "city",
  "zip_proxy"    AS "zip_code",
  "state",
  COUNT(*)       AS "hurricane_count",
  LISTAGG(DISTINCT "hurr_name", ', ' ORDER BY "hurr_name") AS "hurricane_list"
FROM hits
GROUP BY "city_or_zone", "zip_proxy", "state"
ORDER BY "hurricane_count" DESC
LIMIT 20;
```
