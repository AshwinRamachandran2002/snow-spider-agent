```sql
--Description:  
-- Create a city / ZIP-proxy (forecast zone) summary of 2021 hurricane events.  
-- • Filter STORMS_2021 for rows whose “event_type” contains “hurricane”, exclude any
--   that mention “unnamed”, and keep only those with non-NULL coordinates.  
-- • Convert each (longitude, latitude) pair into a GEOGRAPHY point and test whether
--   the point lies within an NWS forecast-zone polygon (used here as a ZIP proxy).  
-- • Aggregate by forecast zone to return city/zone name, zone code, state, the count
--   of hurricane events, and an alphabetically-ordered, comma-separated list of
--   distinct hurricane names.  
WITH hurr AS (                            -- step-1: pull clean hurricane rows
  SELECT
    "event_id",
    INITCAP("event_type")  AS "hurr_name",
    "event_latitude",
    "event_longitude"
  FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
  WHERE "event_type" ILIKE '%hurricane%'
    AND "event_type" NOT ILIKE '%unnamed%'
    AND "event_latitude"  IS NOT NULL
    AND "event_longitude" IS NOT NULL
),
hits AS (                                -- step-2: spatial join to forecast zones
  SELECT
    z."name"  AS "city_or_zone",
    z."zone"  AS "zip_proxy",
    z."state",
    h."hurr_name"
  FROM hurr h
  JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" z
    ON ST_WITHIN(
         TO_GEOGRAPHY(ST_POINT(h."event_longitude", h."event_latitude")),
         TO_GEOGRAPHY(z."shape_geometry")
       )
)
SELECT                                    -- step-3: aggregate and present results
  "city_or_zone"                                   AS "city",
  "zip_proxy"                                      AS "zip_code",
  "state",
  COUNT(*)                                         AS "hurricane_count",
  LISTAGG(DISTINCT "hurr_name", ', ')
       WITHIN GROUP (ORDER BY "hurr_name")         AS "hurricane_list"
FROM hits
GROUP BY "city_or_zone", "zip_proxy", "state"
ORDER BY "hurricane_count" DESC
LIMIT 20;
```
