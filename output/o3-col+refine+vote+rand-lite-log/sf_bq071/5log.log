/*--------------------------------------------------------------------
  Hurricanes in the NOAA “Storms” files, counted per ZIP code
  and accompanied by an alphabetically-sorted list of hurricane names.

  Strategy
  1.  UNION ALL every STORMS_<year> table available in the
      NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS schema.
  2.  Keep only rows whose EVENT_TYPE contains the word “hurricane”,
      that possess non-null latitude/longitude, and that have a
      non-blank, non-“UNNAMED” STORM_NAME value.
  3.  Convert each (lon, lat) pair to a GEOGRAPHY point and spatially
      join it to the ZIP-code polygons in
      NOAA_DATA_PLUS.GEO_US_BOUNDARIES.US_ZIP_CODE_AREAS.
  4.  Aggregate by (city, ZIP, state), returning the hurricane count
      and a comma-separated, alphabetically-sorted list of distinct
      hurricane names.
--------------------------------------------------------------------*/

WITH all_storms AS (               -- 1) one big union of every STORMS_<yr> table
    SELECT "event_type",
           "storm_name",           -- Storm Data contains a STORM_NAME column
           CAST("event_latitude"  AS FLOAT)  AS lat,
           CAST("event_longitude" AS FLOAT)  AS lon
    FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2002"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2000"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1985"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1968"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1964"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1962"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1960"
    UNION ALL
    SELECT "event_type","storm_name",CAST("event_latitude" AS FLOAT),CAST("event_longitude" AS FLOAT)
      FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1956"
),

hurricane_pts AS (                 -- 2) keep only *named* hurricane rows
    SELECT
        TRIM("storm_name")                       AS hurr_name,
        lat,
        lon,
        ST_POINT(lon, lat)                       AS geom
    FROM all_storms
    WHERE "event_type" ILIKE '%hurricane%'
      AND lat IS NOT NULL
      AND lon IS NOT NULL
      AND hurr_name IS NOT NULL
      AND hurr_name <> ''
      AND UPPER(hurr_name) <> 'UNNAMED'
),

hurr_zip_join AS (                 -- 3) spatially match to ZIP polygons
    SELECT
        z."CITY",
        z."ZIP_CODE",
        z."STATE",
        p.hurr_name
    FROM hurricane_pts p
    JOIN NOAA_DATA_PLUS.GEO_US_BOUNDARIES."US_ZIP_CODE_AREAS" z
      ON ST_WITHIN(p.geom, z."GEOMETRY")
)

-- 4) aggregate & return results
SELECT
    "CITY"                                        AS city,
    "ZIP_CODE"                                    AS zip_code,
    "STATE"                                       AS state,
    COUNT(*)                                      AS hurricane_cnt,
    LISTAGG(DISTINCT hurr_name, ', ')
        WITHIN GROUP (ORDER BY hurr_name)         AS hurricane_names
FROM hurr_zip_join
GROUP BY
    "CITY",
    "ZIP_CODE",
    "STATE"
ORDER BY
    hurricane_cnt DESC NULLS LAST;
