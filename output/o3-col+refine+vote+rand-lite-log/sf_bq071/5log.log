```sql
-- 6) Just one example: build a POINT from hurricane rows
--    and see if it falls inside any forecast–zone polygon
SELECT 
  s."event_id",
  s."event_type",
  z."state"  AS "zone_state",
  z."zone"   AS "zone_code",
  z."name"   AS "zone_name"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"  s
JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" z
  ON ST_WITHIN(
       TO_GEOGRAPHY(ST_POINT(s."event_longitude", s."event_latitude")),
       TO_GEOGRAPHY(z."shape_geometry")
     )
WHERE s."event_type" ILIKE '%hurricane%'
  AND s."event_latitude"  IS NOT NULL
  AND s."event_longitude" IS NOT NULL
LIMIT 20;
```

```sql
-- 7) Build a UNION-ALL view of all hurricane events we can find
--    (limiting to years that actually have a storms table)
WITH yrs AS (
  SELECT column1::STRING AS "tbl"
  FROM (VALUES 
        ('STORMS_1956'),('STORMS_1960'),('STORMS_1962'),('STORMS_1964'),
        ('STORMS_1968'),('STORMS_1985'),('STORMS_2000'),('STORMS_2002'),
        ('STORMS_2011'),('STORMS_2019'),('STORMS_2021'),('STORMS_2023'))
)
SELECT *
FROM (
  SELECT 
    'NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.'||"tbl" AS "table_name",
    (SELECT COUNT(*) 
       FROM IDENTIFIER('NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.'||"tbl")  
       WHERE "event_type" ILIKE '%hurricane%') AS "hurricane_rows"
  FROM yrs
)
ORDER BY "hurricane_rows" DESC
LIMIT 20;
```

```sql
-- 8) Aggregate hurricanes by state (all years together)
WITH all_hurr AS (
  SELECT "state", "event_type"
  FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
  WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state", "event_type"
  FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
  WHERE "event_type" ILIKE '%hurricane%'
  -- …repeat UNION ALL for each storms table as needed
)
SELECT 
  "state",
  COUNT(*) AS "hurricane_cnt"
FROM all_hurr
GROUP BY "state"
ORDER BY "hurricane_cnt" DESC
LIMIT 20;
```

```sql
-- 9) Check for unnamed hurricanes (sometimes stored as “unnamed”)
--    so we know what to exclude later
SELECT DISTINCT 
  "event_type"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
WHERE "event_type" ILIKE '%hurricane%'
  AND "event_type" ILIKE '%unnamed%'
LIMIT 20;
```

```sql
--10) Sketch of the final join that will eventually give
--    city/zip (using forecast zone as proxy) and hurricane counts/names
--    — here shown for just 2023 for brevity and LIMITed rows
WITH hurr AS (
  SELECT 
    "event_id",
    INITCAP("event_type") AS "hurr_name",
    "event_latitude",
    "event_longitude"
  FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023"
  WHERE "event_type" ILIKE '%hurricane%'
    AND "event_type" NOT ILIKE '%unnamed%'
    AND "event_latitude"  IS NOT NULL
    AND "event_longitude" IS NOT NULL
),
hits AS (
  SELECT 
    z."name"  AS "city_or_zone",
    z."zone"  AS "zip_proxy",
    z."state",
    h."hurr_name"
  FROM hurr h
  JOIN NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."NWS_FORECAST_REGIONS" z
    ON ST_WITHIN(
         TO_GEOGRAPHY(ST_POINT(h."event_longitude", h."event_latitude")),
         TO_GEOGRAPHY(z."shape_geometry")
       )
)
SELECT
  "city_or_zone"   AS "city",
  "zip_proxy"      AS "zip_code",
  "state",
  COUNT(*)         AS "hurricane_count",
  LISTAGG(DISTINCT "hurr_name", ', ' ORDER BY "hurr_name") AS "hurricane_list"
FROM hits
GROUP BY "city_or_zone", "zip_proxy", "state"
ORDER BY "hurricane_count" DESC
LIMIT 20;
```
