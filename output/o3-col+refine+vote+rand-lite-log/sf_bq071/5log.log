/*  Count of (named) hurricanes whose track-points fall inside every
    U.S. ZIP-code polygon, together with a comma-separated list of the
    hurricane names (alphabetically sorted).

    Assumptions about the public data sets that are available in the
    NOAA DATA PLUS share:

      • Hurricane track points:
          NOOA_DATA_PLUS.NOAA_HURRICANES.HURRICANE_TRACKS
            "NAME"    – hurricane name
            "LAT"     – latitude   (decimal degrees)
            "LON"     – longitude  (decimal degrees)

      • ZIP-code polygons:
          NOOA_DATA_PLUS.GEO_US_BOUNDARIES.US_ZIP_CODE_AREAS
            "ZIP_CODE"   – 5-digit ZIP
            "CITY"       – primary USPS city name
            "STATE"      – two-letter state code
            "GEOMETRY"   – GEOGRAPHY / GEOMETRY polygon of the ZIP area
*/

WITH hurricane_pts AS (            -- 1.  Clean, pointify, and drop unnamed storms
    SELECT
        "NAME"                           AS "hurr_name",
        CAST("LAT"  AS FLOAT)            AS lat,
        CAST("LON"  AS FLOAT)            AS lon,
        ST_POINT("LON", "LAT")           AS geom
    FROM NOOA_DATA_PLUS.NOAA_HURRICANES."HURRICANE_TRACKS"
    WHERE "NAME" IS NOT NULL
