Query:
--Description:  
-- 8) Aggregate hurricane counts by state across all STORMS_<year> tables.  
--    A UNION ALL gathers the “state” field for every row whose “event_type”
--    contains “hurricane”, and then we GROUP BY state to obtain the total
--    number of hurricane events per state (ordered from largest to smallest).
WITH all_hurr AS (
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2023" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2019" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2011" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2002" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2000" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1985" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1968" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1964" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1962" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1960" WHERE "event_type" ILIKE '%hurricane%'
  UNION ALL
  SELECT "state" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_1956" WHERE "event_type" ILIKE '%hurricane%'
)
SELECT 
  "state",
  COUNT(*) AS "hurricane_cnt"
FROM all_hurr
GROUP BY "state"
ORDER BY "hurricane_cnt" DESC
LIMIT 20
Answer:
state,hurricane_cnt
