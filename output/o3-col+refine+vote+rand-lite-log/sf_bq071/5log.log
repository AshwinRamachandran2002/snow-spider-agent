--Description:  
-- Determine whether 2021 hurricane events actually contain usable coordinates.  
-- The query counts all hurricane rows and also how many of those rows have BOTH
-- latitude and longitude populated.  If “with_coordinates” is zero, a spatial
-- join will necessarily return no results.
SELECT
  COUNT(*)                                                           AS "total_hurricane_rows",
  SUM(CASE WHEN "event_latitude" IS NOT NULL
            AND "event_longitude" IS NOT NULL THEN 1 ELSE 0 END)     AS "with_coordinates"
FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS."STORMS_2021"
WHERE "event_type" ILIKE '%hurricane%';
