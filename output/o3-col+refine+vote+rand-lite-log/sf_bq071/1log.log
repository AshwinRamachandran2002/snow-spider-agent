--Description: 1)  Look at the different event types stored in one recent Storm-Data table
SELECT DISTINCT "event_type"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
LIMIT 20;
