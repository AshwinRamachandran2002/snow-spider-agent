```sql
--Description:  Determine which of the available Storm-Data year-tables actually contain
--              any “hurricane” or “typhoon” events **with non-NULL latitude and longitude**.
--              By scanning every listed table and returning only those whose coordinate
--              count is greater than zero, we learn where spatial joins will be possible.
WITH year_tables AS (
    SELECT 'STORMS_2023' AS tbl UNION ALL
    SELECT 'STORMS_2021' UNION ALL
    SELECT 'STORMS_2019' UNION ALL
    SELECT 'STORMS_2011' UNION ALL
    SELECT 'STORMS_2002' UNION ALL
    SELECT 'STORMS_2000' UNION ALL
    SELECT 'STORMS_1985' UNION ALL
    SELECT 'STORMS_1968' UNION ALL
    SELECT 'STORMS_1964' UNION ALL
    SELECT 'STORMS_1962' UNION ALL
    SELECT 'STORMS_1960' UNION ALL
    SELECT 'STORMS_1956'
)
SELECT
    yt.tbl                                            AS "table_name",
    COUNT(*)                                          AS "events_with_coords"
FROM   year_tables yt,
       LATERAL (
           SELECT "event_id"
           FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS".IDENTIFIER(yt.tbl)
           WHERE  ("event_type" ILIKE '%hurricane%' OR "event_type" ILIKE '%typhoon%')
              AND "event_latitude"  IS NOT NULL
              AND "event_longitude" IS NOT NULL
       ) s
GROUP BY yt.tbl
HAVING COUNT(*) > 0
ORDER BY "events_with_coords" DESC;
```
