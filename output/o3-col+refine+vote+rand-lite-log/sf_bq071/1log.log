Query:
--Description: 2)  Identify the exact spelling of hurricane–related events (‘hurricane’, ‘typhoon’, etc.)   
SELECT DISTINCT "event_type"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
WHERE "event_type" ILIKE '%hurricane%'
   OR "event_type" ILIKE '%typhoon%'
LIMIT 20;
Answer:
event_type
hurricane
marine hurricane/typhoon
Query:
--Description: 4)  Check the 2000 table to see how many hurricane (or typhoon) events exist and
--                how many of those contain non-NULL latitude/longitude values.  This mirrors the
--                diagnostic approach we used for the 2021 table and prevents “no-data” surprises.
SELECT
    "event_type",
    COUNT(*)                                                         AS "total_events",
    COUNT(CASE WHEN "event_latitude" IS NOT NULL
                    AND "event_longitude" IS NOT NULL THEN 1 END)    AS "events_with_coords"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2000"
WHERE "event_type" ILIKE '%hurricane%'
   OR "event_type" ILIKE '%typhoon%'
GROUP BY "event_type"
Answer:
event_type,total_events,events_with_coords
hurricane (typhoon),42,0
Query:
--Description: 6)  Inspect a sample of NWS forecast–region polygons by converting the WKB
--                geometry to a GEOGRAPHY object.  No casting issues here; ST_GEOGFROMWKB
--                directly returns a GEOGRAPHY value.
SELECT
    "state",
    "zone",
    "name",
    ST_GEOGFROMWKB("shape_geometry") AS "zone_geom"
FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."NWS_FORECAST_REGIONS"
LIMIT 20
