/*  Count named-hurricane hits that fall inside each ZIP-code polygon
    and list the distinct hurricane names (alphabetically, comma-separated)
    for every (city, ZIP, state).                                   */

WITH hurricane_points AS (          -- 1 ─ all named hurricanes as GEOGRAPHY points
    SELECT
        "storm_id",
        "storm_name",
