Query:
--Description: 10)  Summarise (for four recent year-tables) how many hurricane or typhoon
--                  events each table contains.  This version explicitly counts both
--                  “hurricane” and “typhoon” classifications to keep the logic consistent.
SELECT 'STORMS_2023' AS "table_name",
       COUNT(*)      AS "cnt"
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023"
WHERE  "event_type" ILIKE '%hurricane%'
   OR  "event_type" ILIKE '%typhoon%'
UNION ALL
SELECT 'STORMS_2021',
       COUNT(*)
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021"
WHERE  "event_type" ILIKE '%hurricane%'
   OR  "event_type" ILIKE '%typhoon%'
UNION ALL
SELECT 'STORMS_2019',
       COUNT(*)
FROM   "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019"
WHERE  "event_type" ILIKE '%hurricane%'
   OR  "event_type" ILIKE '%typhoon%'
