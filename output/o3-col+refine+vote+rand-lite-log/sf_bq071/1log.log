```sql
/*  For every NWS forecast zone (state-zone ID) and its county/zone name,
    count the hurricane / typhoon events whose reported point location
    lies inside the zone polygon, and list the distinct event-IDs (used
    here as hurricane “names”) in alphabetical order.                     */

WITH all_storms AS (   /* 1 ─ combine every historic Storm-Data year table */
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2023" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2021" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2019" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2011" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2002" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_2000" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1985" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1968" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1964" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1962" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1960" UNION ALL
    SELECT * FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."STORMS_1956"
),

hurricane_pts AS (     /* 2 ─ hurricane / typhoon rows that have coordinates */
    SELECT
        "event_id"                                    AS "hurricane_id",
        ST_POINT("event_longitude", "event_latitude") AS "pt_geom"
    FROM all_storms
    WHERE ("event_type" ILIKE '%hurricane%' OR "event_type" ILIKE '%typhoon%')
      AND "event_latitude"  IS NOT NULL
      AND "event_longitude" IS NOT NULL
),

forecast_zones AS (    /* 3 ─ polygons for NWS forecast zones (always present) */
    SELECT
        "state_zone",                       -- e.g.  TX028
        "name"       AS "city",             -- county / zone descriptive name
        "state",
        ST_GEOGFROMWKB("shape_geometry")    AS "zone_geom"
    FROM "NOAA_DATA_PLUS"."NOAA_HISTORIC_SEVERE_STORMS"."NWS_FORECAST_REGIONS"
),

zone_hits AS (         /* 4 ─ spatial join: hurricane point ∈ forecast-zone polygon */
    SELECT
        z."city",
        z."state_zone"  AS "zip",   -- serves as a ZIP-like unique identifier
        z."state",
        h."hurricane_id"
    FROM hurricane_pts  h
    JOIN forecast_zones z
      ON ST_WITHIN(h."pt_geom", z."zone_geom")
)

/* 5 ─ aggregate & return results */
SELECT
    "city",
    "zip"                                      AS "zip_code",
    "state",
    COUNT(*)                                   AS "hurricane_cnt",
    LISTAGG(DISTINCT "hurricane_id", ', ')
        WITHIN GROUP (ORDER BY "hurricane_id") AS "hurricanes"
FROM zone_hits
GROUP BY "city", "zip", "state"
ORDER BY "hurricane_cnt" DESC NULLS LAST;
```
