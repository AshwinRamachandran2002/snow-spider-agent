```

```sql
--Description: 2)  Count how many rows in 2021 Storm-Data are tagged as “hurricane”.
SELECT COUNT(*) AS "cnt_hurricanes_2021"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane';
```

```sql
--Description: 3)  Inspect the first 20 hurricane rows (id, state, county/zone,
--lat-lon) from the 2021 table.
SELECT "event_id",
       "state",
       "cz_name",
       "cz_fips_code",
       "event_latitude",
       "event_longitude"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
LIMIT  20;
```

```sql
--Description: 4)  Same as above but only rows that carry non-null coordinates.
SELECT "event_id",
       "state",
       "cz_name",
       "event_latitude",
       "event_longitude"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
  AND  "event_latitude"  IS NOT NULL
  AND  "event_longitude" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 5)  Combine three different years to see if hurricane events span
--multiple files and get an overall count by year.
SELECT '2021'      AS "yr", COUNT(*) AS "hurricane_cnt" FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021 WHERE LOWER("event_type") = 'hurricane'
UNION ALL
SELECT '2002', COUNT(*) FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2002 WHERE LOWER("event_type") = 'hurricane'
UNION ALL
SELECT '2000', COUNT(*) FROM NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2000 WHERE LOWER("event_type") = 'hurricane'
LIMIT  20;
```

```sql
--Description: 6)  Preview National Weather Service (NWS) forecast-region polygons
--for any state that has hurricanes (example: FL, TX) – geometry is stored in
--binary WKB; show state, zone, name, centroid lat/lon.
SELECT "state",
       "zone",
       "name",
       "lat",
       "lon"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.NWS_FORECAST_REGIONS
WHERE  "state" IN ('FL','TX')
LIMIT  20;
```

```sql
--Description: 7)  Create a GEOMETRY point from the storm’s lon/lat so it can be
--used with spatial predicates later.
SELECT "event_id",
       ST_POINT("event_longitude", "event_latitude") AS "event_geom"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
  AND  "event_latitude"  IS NOT NULL
  AND  "event_longitude" IS NOT NULL
LIMIT  20;
```

```sql
--Description: 8)  List all states that registered at least one hurricane event
--in 2021 together with the corresponding count.
SELECT "state",
       COUNT(*) AS "hurricane_cnt"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
GROUP  BY "state"
ORDER  BY "hurricane_cnt" DESC
LIMIT  20;
```

```sql
--Description: 9)  For one hurricane-prone state (e.g., FL) list distinct county/
--zone (“cz_name”) values where hurricanes were recorded.
SELECT DISTINCT "cz_name"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
  AND  "state" = 'Fl'
LIMIT  20;
```

```sql
--Description: 10)  Sample attempt at pairing each hurricane event with the NWS
--forecast zone polygon by matching on state and zone code (first three chars of
--“cz_fips_code” can equal “zone”).  This reveals which events will be spatially
--joinable once we have actual zip-code boundaries.
SELECT s."event_id",
       s."state",
       s."cz_fips_code",
       r."zone",
       r."name"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021     s
JOIN   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.NWS_FORECAST_REGIONS r
       ON  UPPER(r."state") = UPPER(s."state")
       AND r."zone" = LPAD(s."cz_fips_code", 3, '0')
WHERE  LOWER(s."event_type") = 'hurricane'
LIMIT  20;
```

