Query:
--Description: 7)  Produce a geometry point when BOTH coordinates are available,
--but still list all 2021 hurricanes by using a CASE expression.  This avoids the
--previous “no-row” situation yet keeps ST_POINT safe from NULL inputs.
SELECT "event_id",
       CASE
           WHEN "event_latitude"  IS NOT NULL
            AND "event_longitude" IS NOT NULL
           THEN ST_POINT("event_longitude", "event_latitude")
       END                       AS "event_geom",
       "event_latitude",
       "event_longitude"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
LIMIT 20
