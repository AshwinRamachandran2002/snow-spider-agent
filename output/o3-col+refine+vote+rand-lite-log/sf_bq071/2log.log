--Description: 10)  The earlier join used both state and zone-code equality, but the
--Storm-Data table stores non-standard state abbreviations such as “Lo” (Louisiana)
--that don’t match the two-letter postal codes (“LA”) in the NWS table.  To avoid an
--empty set, this version drops the state join and links the two tables only through
--zero-padded county/zone codes.  It lists the first 20 hurricanes from 2021 together
--with any matching NWS forecast-region information that shares the same 3-digit zone.
SELECT s."event_id",
       s."state"                 AS "storm_state",
       s."cz_fips_code",
       r."state"                 AS "nws_state",
       r."zone",
       r."name"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021          s
LEFT JOIN
       NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.NWS_FORECAST_REGIONS r
       ON  r."zone" = LPAD(s."cz_fips_code", 3, '0')
WHERE  LOWER(s."event_type") = 'hurricane'
LIMIT 20
