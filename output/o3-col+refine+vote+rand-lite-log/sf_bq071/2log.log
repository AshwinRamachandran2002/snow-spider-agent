```sql
WITH all_hurricane_events AS (

    /* ----- 1.  UNION every yearly Storm-Data table that exists in the catalog ----- */
    SELECT  "event_id",
            "event_latitude",
            "event_longitude",
            "state",
            "storm_name" ,                --  official storm / hurricane name
            "event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1956  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1960  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1962  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1964  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1968  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_1985  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2000  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2002  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2011  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2019  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021  UNION ALL
    SELECT  "event_id","event_latitude","event_longitude","state","storm_name","event_type"
    FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2023
),

/* ----- 2.  Keep only named-hurricane rows that have usable coordinates ----- */
named_hurricanes AS (
    SELECT  *,
            ST_POINT("event_longitude", "event_latitude")  AS event_geom
    FROM    all_hurricane_events
    WHERE   LOWER("event_type")                 = 'hurricane'
      AND   "event_latitude"   IS NOT NULL
      AND   "event_longitude"  IS NOT NULL
      AND   "storm_name"       IS NOT NULL
      AND   TRIM("storm_name") <> ''
      AND   LOWER(TRIM("storm_name")) NOT LIKE 'unnamed%'
)

/* ----- 3.  Spatial join to U.S. ZIP-code polygons and final aggregation ----- */
SELECT
       z."city"                               AS "city",
       z."zip_code"                           AS "zip_code",
       z."state"                              AS "state",
       COUNT(*)                               AS "hurricane_cnt",
       LISTAGG( DISTINCT nh."storm_name",
                ', ' )          WITHIN GROUP (ORDER BY nh."storm_name")  AS "hurricane_names"
FROM       named_hurricanes                nh
JOIN       NOAA_DATA_PLUS.GEO_US_BOUNDARIES.US_ZIP_CODES   z
       ON  ST_WITHIN( nh.event_geom , TO_GEOGRAPHY( z."shape_geometry" ) )
GROUP BY   z."city", z."zip_code", z."state"
ORDER BY   "hurricane_cnt" DESC NULLS LAST;
```
