--Description: Identify every unique state abbreviation that actually appears in
--the 2021 Storm-Data file for the “hurricane” event type.  Knowing this list first
--prevents empty-result filters (such as the earlier attempt with “Fl”).
SELECT DISTINCT "state"
FROM   NOAA_DATA_PLUS.NOAA_HISTORIC_SEVERE_STORMS.STORMS_2021
WHERE  LOWER("event_type") = 'hurricane'
LIMIT 20;
