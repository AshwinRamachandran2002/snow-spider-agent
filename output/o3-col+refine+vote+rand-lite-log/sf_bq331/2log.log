--Description: Compute absolute difference between each user’s message-score and the global average.
WITH author_stats AS (
    SELECT 
           fm."PostUserId"                 AS "author_id",
           u."UserName",
           COUNT(DISTINCT fmv."FromUserId") AS "message_score"
    FROM   "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"         ft
    JOIN   "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES"       fm
           ON fm."Id" = ft."FirstForumMessageId"
    LEFT  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
           ON fmv."ForumMessageId" = ft."FirstForumMessageId"
    JOIN   "META_KAGGLE"."META_KAGGLE"."USERS"               u
           ON u."Id" = fm."PostUserId"
    WHERE  ft."FirstForumMessageId" IS NOT NULL
    GROUP  BY fm."PostUserId", u."UserName"
), global_stats AS (
    SELECT AVG(msg_grp."msg_score") AS "avg_score"
    FROM (
           SELECT ft."FirstForumMessageId",
                  COUNT(DISTINCT fmv."FromUserId") AS "msg_score"
           FROM   "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"         ft
           LEFT  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
                  ON fmv."ForumMessageId" = ft."FirstForumMessageId"
           WHERE  ft."FirstForumMessageId" IS NOT NULL
           GROUP  BY ft."FirstForumMessageId"
    ) msg_grp
)
SELECT 
       a."author_id",
       a."UserName",
       a."message_score",
       ABS(a."message_score" - g."avg_score") AS "abs_diff_to_avg"
FROM   author_stats a
CROSS  JOIN global_stats g
ORDER  BY "abs_diff_to_avg" DESC
LIMIT 20
