Query:
--Description: Show up to 20 first-messages that have received zero votes, together
--              with the author information.  We use a LEFT JOIN to the votes table
--              and then filter groups whose COUNT of vote-rows is 0.
SELECT
       ft."FirstForumMessageId"               AS "msg_id",
       fm."PostUserId"                        AS "author_id",
       u."UserName",
       COUNT(fmv."Id")                       AS "num_votes"
FROM   "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"         ft
JOIN   "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES"       fm
       ON fm."Id" = ft."FirstForumMessageId"
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS"               u
       ON u."Id" = fm."PostUserId"
LEFT  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
       ON fmv."ForumMessageId" = ft."FirstForumMessageId"
WHERE  ft."FirstForumMessageId" IS NOT NULL
GROUP  BY ft."FirstForumMessageId", fm."PostUserId", u."UserName"
HAVING COUNT(fmv."Id") = 0
LIMIT 20
