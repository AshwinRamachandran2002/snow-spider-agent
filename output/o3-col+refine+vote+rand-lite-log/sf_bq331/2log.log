```sql
--Description: 1) For every forum topic, take its very first message and count how many
--                distinct users voted on it (that is the message’s “score”).
--             2) For each author, keep only the single highest-scoring first-message
--                they ever wrote (their “best_message_score”).
--             3) Compute the overall average score across ALL first-messages.
--             4) Return the three users whose best_message_score is largest, along
--                with the absolute difference between that score and the global
--                average.  This directly answers “top three users by message score
--                and how far above average they are”.
WITH msg_scores AS (           -- step-1: score for every first message
    SELECT
        ft."FirstForumMessageId"          AS msg_id,
        fm."PostUserId"                   AS author_id,
        COUNT(DISTINCT fmv."FromUserId")  AS message_score
    FROM   "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"          ft
    JOIN   "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES"        fm
           ON fm."Id" = ft."FirstForumMessageId"
    LEFT  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
           ON fmv."ForumMessageId" = ft."FirstForumMessageId"
    WHERE  ft."FirstForumMessageId" IS NOT NULL
    GROUP  BY ft."FirstForumMessageId", fm."PostUserId"
), user_best AS (              -- step-2: one row per author = their best score
    SELECT
        author_id,
        MAX(message_score) AS best_message_score
    FROM   msg_scores
    GROUP  BY author_id
), avg_val AS (                -- step-3: overall average score
    SELECT AVG(message_score) AS avg_score
    FROM   msg_scores
)
SELECT
    u."UserName",
    b.best_message_score                      AS "message_score",
    ABS(b.best_message_score - avg_val.avg_score) AS "abs_diff_to_avg"
FROM   user_best              b
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS" u
       ON u."Id" = b.author_id
CROSS  JOIN avg_val
ORDER  BY b.best_message_score DESC
LIMIT 3;
```
