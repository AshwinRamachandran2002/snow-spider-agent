Query:
--Description: Pull the average message-score across ALL first-messages.
SELECT 
       AVG(msg_scores."message_score") AS "avg_first_msg_score"
FROM (
       SELECT ft."FirstForumMessageId",
              COUNT(DISTINCT fmv."FromUserId") AS "message_score"
       FROM   "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"         ft
       LEFT  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
              ON fmv."ForumMessageId" = ft."FirstForumMessageId"
       WHERE  ft."FirstForumMessageId" IS NOT NULL
       GROUP  BY ft."FirstForumMessageId"
) msg_scores
