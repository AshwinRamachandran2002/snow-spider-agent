```sql
--Description:  One-shot query that
--  1) builds “msg_scores” = every first-message in every forum topic together
--     with its author and a score (# distinct voters);
--  2) gets the global average of those scores (“avg_score” CTE);
--  3) keeps, for each author, only their best-scoring first-message (“user_best”);
--  4) returns the top-3 authors ranked by that best score together with the
--     absolute difference between their score and the overall average.
WITH msg_scores AS (
    SELECT
        ft."FirstForumMessageId"                          AS msg_id,
        fm."PostUserId"                                   AS author_id,
        COUNT(DISTINCT fmv."FromUserId")                  AS message_score
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"         ft
    JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES"       fm
         ON fm."Id" = ft."FirstForumMessageId"
    LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
         ON fmv."ForumMessageId" = ft."FirstForumMessageId"
    WHERE ft."FirstForumMessageId" IS NOT NULL
    GROUP BY ft."FirstForumMessageId", fm."PostUserId"
), avg_score AS (
    SELECT AVG(message_score) AS avg_msg_score
    FROM   msg_scores
), user_best AS (
    SELECT
        author_id,
        MAX(message_score) AS best_message_score
    FROM   msg_scores
    GROUP  BY author_id
)
SELECT
    u."UserName",
    user_best.best_message_score                                 AS "message_score",
    ABS(user_best.best_message_score - avg_score.avg_msg_score)  AS "abs_diff_to_avg"
FROM   user_best
CROSS  JOIN avg_score
JOIN   "META_KAGGLE"."META_KAGGLE"."USERS" u
       ON u."Id" = user_best.author_id
ORDER  BY user_best.best_message_score DESC
LIMIT 3;
```
