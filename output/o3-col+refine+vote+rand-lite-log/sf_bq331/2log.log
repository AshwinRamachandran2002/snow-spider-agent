```sql
--Description: Compute absolute difference between each user’s message-score and the global average.
SELECT 
  author_stats."author_id",
  author_stats."UserName",
  author_stats."message_score",
  ABS(author_stats."message_score" - global_stats."avg_score") AS "abs_diff_to_avg"
FROM (
    SELECT
      fm."PostUserId"                   AS "author_id",
      u."UserName",
      COUNT(DISTINCT fmv."FromUserId")  AS "message_score"
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"  ft
    JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES" fm
         ON fm."Id" = ft."FirstForumMessageId"
    LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
           ON fmv."ForumMessageId" = ft."FirstForumMessageId"
    JOIN "META_KAGGLE"."META_KAGGLE"."USERS"        u
         ON u."Id" = fm."PostUserId"
    WHERE ft."FirstForumMessageId" IS NOT NULL
    GROUP BY fm."PostUserId", u."UserName"
) author_stats
CROSS JOIN (
    SELECT AVG("msg_score") AS "avg_score"
    FROM (
        SELECT 
          ft."FirstForumMessageId" AS "msg_id",
          COUNT(DISTINCT fmv."FromUserId") AS "msg_score"
        FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS" ft
        LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
               ON fmv."ForumMessageId" = ft."FirstForumMessageId"
        WHERE ft."FirstForumMessageId" IS NOT NULL
        GROUP BY ft."FirstForumMessageId"
    )
) global_stats
ORDER BY "abs_diff_to_avg" DESC
LIMIT 20;
```

```sql
--Description: Fetch the three highest-scoring users on their first-messages together with the absolute
--difference to the average first-message score.
SELECT 
  author_stats."UserName",
  ABS(author_stats."message_score" - global_stats."avg_score") AS "abs_diff_to_avg"
FROM (
    SELECT
      fm."PostUserId"                   AS "author_id",
      u."UserName",
      COUNT(DISTINCT fmv."FromUserId")  AS "message_score",
      ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT fmv."FromUserId") DESC) AS "rn"
    FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"  ft
    JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES" fm
         ON fm."Id" = ft."FirstForumMessageId"
    LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
           ON fmv."ForumMessageId" = ft."FirstForumMessageId"
    JOIN "META_KAGGLE"."META_KAGGLE"."USERS"        u
         ON u."Id" = fm."PostUserId"
    WHERE ft."FirstForumMessageId" IS NOT NULL
    GROUP BY fm."PostUserId", u."UserName"
) author_stats
CROSS JOIN (
    SELECT AVG("msg_score") AS "avg_score"
    FROM (
        SELECT 
          ft."FirstForumMessageId" AS "msg_id",
          COUNT(DISTINCT fmv."FromUserId") AS "msg_score"
        FROM "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS" ft
        LEFT JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
               ON fmv."ForumMessageId" = ft."FirstForumMessageId"
        WHERE ft."FirstForumMessageId" IS NOT NULL
        GROUP BY ft."FirstForumMessageId"
    )
) global_stats
WHERE author_stats."rn" <= 3
ORDER BY author_stats."message_score" DESC
LIMIT 20;
```

