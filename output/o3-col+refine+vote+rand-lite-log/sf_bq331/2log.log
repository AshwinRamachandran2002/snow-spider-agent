--Description: Fetch the three highest-scoring users on their first-messages and show
--             the absolute difference from the overall average first-message score.
WITH msg_scores AS (
    SELECT 
           ft."FirstForumMessageId"           AS "msg_id",
           fm."PostUserId"                    AS "author_id",
           COUNT(DISTINCT fmv."FromUserId")   AS "message_score"
    FROM   "META_KAGGLE"."META_KAGGLE"."FORUMTOPICS"         ft
    JOIN   "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGES"       fm
           ON fm."Id" = ft."FirstForumMessageId"
    LEFT  JOIN "META_KAGGLE"."META_KAGGLE"."FORUMMESSAGEVOTES" fmv
           ON fmv."ForumMessageId" = ft."FirstForumMessageId"
    WHERE  ft."FirstForumMessageId" IS NOT NULL
    GROUP  BY ft."FirstForumMessageId", fm."PostUserId"
), user_best AS (
    SELECT author_id,
           MAX(message_score) AS message_score
    FROM   msg_scores
    GROUP  BY author_id
), avg_val AS (
    SELECT AVG(message_score) AS avg_score
    FROM   msg_scores
)
