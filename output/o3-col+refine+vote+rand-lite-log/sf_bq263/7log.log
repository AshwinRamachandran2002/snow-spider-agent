```

```sql
--Description: 2) List a few “Sleep & Lounge” products (name, id, cost, retail_price) to understand the items that will be in-scope.
SELECT "id",
       "name",
       "cost",
       "retail_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS
WHERE "category" ILIKE '%Sleep%Lounge%'
LIMIT 20;
```

```sql
--Description: 3) Preview order-item rows for those products, regardless of date or status.
SELECT oi."id"              AS "order_item_id",
       oi."order_id",
       oi."product_id",
       oi."sale_price",
       oi."status",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS        oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS           p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
LIMIT 20;
```

```sql
--Description: 4) Join in ORDERS to see overall order status (expecting “Complete”) and creation timestamp.
SELECT o."order_id",
       o."status"           AS "order_status",
       o."created_at"       AS "order_created_at",
       oi."id"              AS "order_item_id",
       oi."status"          AS "item_status",
       p."category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS             o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS        oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS           p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000   -- 2023 only
LIMIT 20;
```

```sql
--Description: 5) Check that the product-level “cost” aligns for a single month (Jan-2023) and only “Complete” orders.
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM') AS "month",
       oi."order_id",
       oi."sale_price",
       p."cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1672531200000000 AND 1675209599000000   -- Jan-2023
LIMIT 20;
```

```sql
--Description: 6) Compute monthly aggregates for 2023: total sales & total cost (all Complete orders).
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM')    AS "month",
       SUM(oi."sale_price")                                    AS "total_sales",
       SUM(p."cost")                                           AS "total_cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS         p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000   -- Year 2023
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 7) Add count of distinct “Complete” orders for each month to previous aggregation.
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM')            AS "month",
       COUNT(DISTINCT o."order_id")                                    AS "num_complete_orders",
       SUM(oi."sale_price")                                           AS "total_sales",
       SUM(p."cost")                                                  AS "total_cost"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS         p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 8) Extend aggregate to include total profit (sales – cost) and profit-to-cost ratio.
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM')                    AS "month",
       COUNT(DISTINCT o."order_id")                                            AS "num_complete_orders",
       SUM(oi."sale_price")                                                   AS "total_sales",
       SUM(p."cost")                                                          AS "total_cost",
       SUM(oi."sale_price") - SUM(p."cost")                                   AS "total_profit",
       ROUND( (SUM(oi."sale_price") - SUM(p."cost")) / NULLIF(SUM(p."cost"),0), 4)  AS "profit_to_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS           o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS         p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 9) Double-check February 2023 details to make sure profit calculation looks plausible.
SELECT oi."order_id",
       oi."sale_price",
       p."cost",
       (oi."sale_price" - p."cost") AS "item_profit",
       TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM') AS "month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS      o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS    p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND o."status" = 'Complete'
  AND o."created_at" BETWEEN 1675209600000000 AND 1677628799000000   -- Feb-2023
LIMIT 20;
```

```sql
--Description: 10) (Ready-to-use) Final month-by-month report for the full year 2023, ordered chronologically.
SELECT TO_CHAR(TO_TIMESTAMP(o."created_at"/1e6), 'YYYY-MM')                    AS "month",
       SUM(oi."sale_price")                                                   AS "total_sales",
