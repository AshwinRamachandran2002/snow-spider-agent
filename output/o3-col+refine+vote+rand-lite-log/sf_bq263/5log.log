```sql
-- 6) Description:  
--    Calculate per-row profit (sale_price − cost) for the same data, just to validate math.  
SELECT oi."id"                 AS "order_item_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost") AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"        oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"             o
       ON oi."order_id" = o."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"           p
       ON oi."product_id" = p."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"    ii
       ON oi."inventory_item_id" = ii."id"
WHERE  oi."status" = 'Complete'
  AND  (p."category" ILIKE '%Sleep%' OR p."category" ILIKE '%Lounge%')
  AND  o."created_at" BETWEEN 1672531200000000 AND 1704067199000000
LIMIT 20;
```

```sql
-- 7) Description:  
--    Preview month-level aggregates (sales, cost, profit) for 2023 before adding ratios.  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))     AS "order_month",
       SUM(oi."sale_price")                                           AS "total_sales",
       SUM(ii."cost")                                                 AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                  AS "complete_orders",
       SUM(oi."sale_price" - ii."cost")                               AS "total_profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"          oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"               o
       ON oi."order_id" = o."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"             p
       ON oi."product_id" = p."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"      ii
       ON oi."inventory_item_id" = ii."id"
WHERE  oi."status" = 'Complete'
  AND  (p."category" ILIKE '%Sleep%' OR p."category" ILIKE '%Lounge%')
  AND  o."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
-- 8) Description:  
--    Add the profit-to-cost ratio (total_profit / total_cost) to the monthly summary.  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))     AS "order_month",
       SUM(oi."sale_price")                                           AS "total_sales",
       SUM(ii."cost")                                                 AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                  AS "complete_orders",
       SUM(oi."sale_price" - ii."cost")                               AS "total_profit",
       CASE WHEN SUM(ii."cost") <> 0 
            THEN SUM(oi."sale_price" - ii."cost") / SUM(ii."cost") 
            ELSE NULL 
       END                                                             AS "profit_to_cost_ratio"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"          oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"               o
       ON oi."order_id" = o."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"             p
       ON oi."product_id" = p."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"      ii
       ON oi."inventory_item_id" = ii."id"
WHERE  oi."status" = 'Complete'
  AND  (p."category" ILIKE '%Sleep%' OR p."category" ILIKE '%Lounge%')
  AND  o."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```

```sql
-- 9) Description:  
--    Ensure the month list contains every month of 2023 by CROSS JOIN-ing to a calendar spine 
--    (using ARRAY_GENERATE_INTEGER) and then left-joining the aggregates.  
WITH months_2023 AS (
     SELECT DATEADD(month, seq4(), '2023-01-01') AS month_start
     FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
monthly_sales AS (
     SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at"/1000000)) AS order_month,
            SUM(oi."sale_price")                                     AS total_sales,
            SUM(ii."cost")                                           AS total_cost,
            COUNT(DISTINCT oi."order_id")                            AS complete_orders,
            SUM(oi."sale_price" - ii."cost")                         AS total_profit
     FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"    oi
     JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"         o
            ON oi."order_id" = o."order_id"
     JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"       p
            ON oi."product_id" = p."id"
     JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
            ON oi."inventory_item_id" = ii."id"
     WHERE  oi."status" = 'Complete'
       AND  (p."category" ILIKE '%Sleep%' OR p."category" ILIKE '%Lounge%')
       AND  o."created_at" BETWEEN 1672531200000000 AND 1704067199000000
     GROUP  BY 1
)
SELECT m."month_start"                           AS "order_month",
       COALESCE(s."total_sales",        0)       AS "total_sales",
       COALESCE(s."total_cost",         0)       AS "total_cost",
       COALESCE(s."complete_orders",    0)       AS "complete_orders",
       COALESCE(s."total_profit",       0)       AS "total_profit",
       CASE WHEN COALESCE(s."total_cost",0) <> 0
            THEN COALESCE(s."total_profit",0) / s."total_cost"
            ELSE NULL
       END                                       AS "profit_to_cost_ratio"
FROM   months_2023          m
LEFT  JOIN monthly_sales    s  ON m."month_start" = s."order_month"
ORDER BY m."month_start"
LIMIT 20;
```

```sql
-- 10) Description:  
--     Final concise query (without calendar spine) that delivers the requested month-by-month report 
--     for 2023 Sleep & Lounge sales, including sales, cost, profit, order count, and profit-to-cost ratio.  
SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))     AS "order_month",
       SUM(oi."sale_price")                                           AS "total_sales",
       SUM(ii."cost")                                                 AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                  AS "complete_orders",
       SUM(oi."sale_price" - ii."cost")                               AS "total_profit",
       CASE WHEN SUM(ii."cost") <> 0 
            THEN ROUND(SUM(oi."sale_price" - ii."cost") / SUM(ii."cost"), 4) 
            ELSE NULL 
       END                                                             AS "profit_to_cost_ratio"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"          oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"               o
       ON oi."order_id" = o."order_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"             p
       ON oi."product_id" = p."id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"      ii
       ON oi."inventory_item_id" = ii."id"
WHERE  oi."status" = 'Complete'
  AND  (p."category" ILIKE '%Sleep%' OR p."category" ILIKE '%Lounge%')
  AND  o."created_at" BETWEEN 1672531200000000 AND 1704067199000000   -- 2023 only
GROUP  BY 1
ORDER  BY 1
LIMIT 20;
```
