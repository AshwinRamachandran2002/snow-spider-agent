--Description: 
-- Task:  Return a 2023 month-by-month performance report for the “Sleep & Lounge” product category.  
-- Logic steps (inline):  
--   1.  Build a 12-row calendar spine (months_2023) beginning 2023-01-01 via GENERATOR + DATEADD.  
--   2.  Gather 2023 sales facts in CTE monthly_sales:  
--         • ORDER_ITEMS  → ORDERS (for order date)  
--         • → PRODUCTS   (filter category)  
--         • → INVENTORY_ITEMS (unit cost)  
--         • Keep ORDER_ITEMS.status = 'Complete' and ORDERS.created_at within 2023 (µs epoch).  
--         • Aggregate by month: total_sales, total_cost, distinct complete_orders, total_profit.  
--   3.  Left-join the calendar spine to the aggregates to guarantee all 12 months appear  
--       (zero-filled where no sales).  
--   4.  Compute profit_to_cost_ratio safely (NULL when total_cost = 0).  
--   5.  Present results ordered chronologically; LIMIT 20 to satisfy prompt.  
WITH months_2023 AS (
    SELECT DATEADD(month, SEQ4(), '2023-01-01') AS month_start
    FROM TABLE(GENERATOR(ROWCOUNT => 12))
),
monthly_sales AS (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP(o."created_at" / 1000000))          AS order_month,
           SUM(oi."sale_price")                                                 AS total_sales,
           SUM(ii."cost")                                                       AS total_cost,
           COUNT(DISTINCT oi."order_id")                                        AS complete_orders,
           SUM(oi."sale_price" - ii."cost")                                     AS total_profit
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"                oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"                     o
           ON oi."order_id" = o."order_id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"                   p
           ON oi."product_id" = p."id"
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"            ii
           ON oi."inventory_item_id" = ii."id"
    WHERE  oi."status" = 'Complete'
      AND  p."category" = 'Sleep & Lounge'        -- exact match is now known
      AND  o."created_at" BETWEEN 1672531200000000     -- 2023-01-01 00:00:00 µs
                                AND 1704067199000000   -- 2023-12-31 23:59:59 µs
    GROUP  BY 1
)
SELECT m.month_start                                          AS "order_month",
       COALESCE(s.total_sales,      0)                        AS "total_sales",
       COALESCE(s.total_cost,       0)                        AS "total_cost",
       COALESCE(s.complete_orders,  0)                        AS "complete_orders",
       COALESCE(s.total_profit,     0)                        AS "total_profit",
       CASE WHEN COALESCE(s.total_cost,0) <> 0
            THEN COALESCE(s.total_profit,0) / s.total_cost
            ELSE NULL
       END                                                    AS "profit_to_cost_ratio"
FROM   months_2023 m
LEFT   JOIN monthly_sales s
       ON m.month_start = s.order_month
ORDER  BY m.month_start
LIMIT 20;
