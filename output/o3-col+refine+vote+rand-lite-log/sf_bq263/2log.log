```

```sql
--Description: 2) Pull a small sample of products that belong to the “Sleep & Lounge” category 
SELECT "id",
       "name",
       "brand",
       "cost",
       "retail_price",
       "distribution_center_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
WHERE "category" ILIKE '%Sleep%Lounge%'
LIMIT 20;
```

```sql
--Description: 3) See which inventory items carry the “Sleep & Lounge” products and the distribution centers involved
SELECT "id",
       "product_id",
       "product_distribution_center_id",
       "cost",
       "created_at",
       "sold_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"
WHERE "product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
LIMIT 20;
```

```sql
--Description: 4) List 2023 order-items that contain “Sleep & Lounge” products (regardless of order status)
SELECT oi."id"        AS "order_item_id",
       oi."order_id",
       oi."product_id",
       oi."sale_price",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
WHERE oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067200000000   -- 2023 range
LIMIT 20;
```

```sql
--Description: 5) Narrow the above list to order-items that come from ORDERS whose status is “Complete” in 2023
SELECT oi."id"        AS "order_item_id",
       oi."order_id",
       o."status",
       oi."product_id",
       oi."sale_price",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"       o
     ON oi."order_id" = o."order_id"
WHERE o."status" = 'Complete'
  AND oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
LIMIT 20;
```

```sql
--Description: 6) Bring in INVENTORY_ITEMS to attach accurate product cost to each qualified order-item
SELECT oi."id"                   AS "order_item_id",
       oi."order_id",
       oi."product_id",
       ii."cost"                 AS "unit_cost",
       oi."sale_price",
       (oi."sale_price" - ii."cost") AS "profit",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
WHERE o."status" = 'Complete'
  AND oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
LIMIT 20;
```

```sql
--Description: 7) Produce per-month aggregates for 2023 – total sales, total cost, number of complete orders, total profit
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1000000), 'YYYY-MM')  AS "year_month",
       SUM(oi."sale_price")                                         AS "total_sales",
       SUM(ii."cost")                                               AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                AS "num_complete_orders",
       SUM(oi."sale_price" - ii."cost")                             AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
WHERE o."status" = 'Complete'
  AND oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 8) Add the profit-to-cost ratio to the monthly aggregates
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at" / 1000000), 'YYYY-MM')      AS "year_month",
       SUM(oi."sale_price")                                             AS "total_sales",
       SUM(ii."cost")                                                   AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                    AS "num_complete_orders",
       SUM(oi."sale_price" - ii."cost")                                 AS "total_profit",
       CASE 
         WHEN SUM(ii."cost") = 0 THEN NULL
         ELSE ROUND(SUM(oi."sale_price" - ii."cost") / SUM(ii."cost"), 4)
       END                                                              AS "profit_to_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
WHERE o."status" = 'Complete'
  AND oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 9) Check the distribution centers most frequently used for the 2023 “Sleep & Lounge” complete orders
SELECT dc."name"                           AS "distribution_center",
       COUNT(*)                            AS "order_item_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."DISTRIBUTION_CENTERS" dc
     ON ii."product_distribution_center_id" = dc."id"
WHERE o."status" = 'Complete'
  AND oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
GROUP BY dc."name"
ORDER BY "order_item_cnt" DESC
LIMIT 20;
```

```sql
--Description: 10) Surface the top 20 highest profit “Sleep & Lounge” order-items from 2023
SELECT oi."order_id",
       oi."id"             AS "order_item_id",
       oi."sale_price",
       ii."cost"           AS "unit_cost",
       (oi."sale_price" - ii."cost")  AS "profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"           o   ON oi."order_id" = o."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii  ON oi."inventory_item_id" = ii."id"
WHERE o."status" = 'Complete'
  AND oi."product_id" IN (
        SELECT "id"
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
        WHERE "category" ILIKE '%Sleep%Lounge%'
      )
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067200000000
ORDER BY "profit" DESC
LIMIT 20;
```
