Query:
-- 10. Description: Full 2023 month-by-month report including sales, cost, complete orders, profit and profit-to-cost ratio.
SELECT TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at" / 1000000), 'YYYY-MM')                          AS "month",
       SUM(oi."sale_price")                                                                     AS "total_sales",
       SUM(ii."cost")                                                                           AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                                            AS "complete_orders",
       SUM(oi."sale_price" - ii."cost")                                                        AS "total_profit",
       CASE WHEN SUM(ii."cost") <> 0
            THEN SUM(oi."sale_price" - ii."cost") / SUM(ii."cost")
       END                                                                                      AS "profit_to_cost_ratio"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS      oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS  ii
       ON oi."inventory_item_id" = ii."id"
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS         p
       ON oi."product_id" = p."id"
WHERE  p."category" = 'Sleep & Lounge'
  AND  oi."status"  = 'Complete'
  AND  oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
