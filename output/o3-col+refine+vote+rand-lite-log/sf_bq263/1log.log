--Description / Thinking process:
--We need to check data consistency between parent “ORDERS” and child “ORDER_ITEMS”.
--Earlier, filtering exclusively for mismatches returned no rows; therefore, to be certain
--we will COUNT how many rows exist for each combination of parent-status and child-status.
--Steps:
-- 1. Join ORDER_ITEMS (oi) to ORDERS (o) on "order_id".
-- 2. Join to PRODUCTS (p) so we can restrict to the “Sleep & Lounge” category.
-- 3. Restrict to order-item creation timestamps that fall inside calendar year-2023
--    using the micro-second epoch values already employed in previous queries.
-- 4. GROUP BY the two status fields and COUNT(*) to see how frequently each pairing occurs.
-- 5. Ordering by row_count (descending) will show the dominant pairing first; any row where
--    the two statuses differ highlights a potential inconsistency.
-- 6. LIMIT 20 keeps the output concise while still surfacing any anomaly.

SELECT
    o."status"  AS "order_status_parent",
    oi."status" AS "order_item_status",
    COUNT(*)    AS "row_count"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS       o
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON p."id" = oi."product_id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."created_at" BETWEEN 1672531200000000   -- 1-Jan-2023 00:00:00
                          AND 1704067199000000   -- 31-Dec-2023 23:59:59
GROUP BY o."status", oi."status"
ORDER BY "row_count" DESC
LIMIT 20;
