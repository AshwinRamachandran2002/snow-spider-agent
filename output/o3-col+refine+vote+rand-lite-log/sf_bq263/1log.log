Query:
--Description: 9)  Quickly list the DISTINCT distribution-centers that handled at least one 2023
--               “Sleep & Lounge” order-item marked ‘Complete’.  This keeps the original intent
--               but removes any unnecessary columns and preserves the micro-second date filter.
SELECT DISTINCT 
       dc."id"          AS "dc_id",
       dc."name",
       dc."latitude",
       dc."longitude"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS          oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS      ii
     ON ii."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.DISTRIBUTION_CENTERS dc
     ON dc."id" = ii."product_distribution_center_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS             p
     ON p."id" = oi."product_id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000    -- 01-Jan-2023
                          AND 1704067199000000    -- 31-Dec-2023
LIMIT 20
