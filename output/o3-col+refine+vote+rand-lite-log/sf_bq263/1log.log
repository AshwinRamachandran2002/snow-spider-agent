  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
LIMIT 20;
```

```sql
--Description: 4)  Check how many distinct “Complete” orders per month we have in 2023 for the Sleep & Lounge category
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "order_month",
       COUNT(DISTINCT oi."order_id")                            AS "complete_orders"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
       ON p."id" = oi."product_id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 5)  Take a quick look at inventory_items joining back to the order_items we just pulled
SELECT oi."id"                        AS "order_item_id",
       oi."inventory_item_id",
       ii."cost",
       ii."product_distribution_center_id"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS ii
       ON ii."id" = oi."inventory_item_id"
WHERE oi."id" IN (  -- any 2023 Sleep & Lounge completed order-item
       SELECT oi2."id"
       FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi2
       JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p2
              ON p2."id" = oi2."product_id"
       WHERE p2."category" ILIKE '%Sleep%Lounge%'
         AND oi2."status" = 'Complete'
         AND oi2."created_at" BETWEEN 1672531200000000 AND 1704067199000000
       LIMIT 20 )
LIMIT 20;
```

```sql
--Description: 6)  Calculate sale, cost and profit for a small sample of 2023 Sleep & Lounge completed order-items
SELECT oi."id"                                            AS "order_item_id",
       oi."sale_price",
       ii."cost",
       (oi."sale_price" - ii."cost")                      AS "profit",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS ii
       ON ii."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS        p
       ON p."id" = oi."product_id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
LIMIT 20;
```

```sql
--Description: 7)  Summarise month-by-month totals of sales, cost and profit for the Sleep & Lounge category in 2023
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM')                  AS "month",
       SUM(oi."sale_price")                                                      AS "total_sales",
       SUM(ii."cost")                                                            AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                             AS "complete_orders",
       SUM(oi."sale_price" - ii."cost")                                          AS "total_profit",
       CASE WHEN SUM(ii."cost") = 0
            THEN NULL
            ELSE SUM(oi."sale_price" - ii."cost") / SUM(ii."cost")
       END                                                                       AS "profit_to_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS     oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS ii
       ON ii."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS        p
       ON p."id" = oi."product_id"
WHERE p."category" ILIKE '%Sleep%Lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: 8)  Verify that “Complete” orders in ORDER_ITEMS also appear as “Complete” in the parent ORDERS table, for consistency
SELECT DISTINCT oi."order_id",
       o."status" AS "order_status_in_parent",
       oi."status" AS "order_item_status"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS       o
       ON o."order_id" = oi."order_id"
WHERE oi."status" = 'Complete'
  AND o."status" <> 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
LIMIT 20;
```

```sql
--Description: 9)  Quick look at distribution centers tied to Sleep & Lounge products for 2023 orders
