```sql
--Description: 3)  Pull a sample of 2023 order-items that are already marked “Complete” and whose products are in “Sleep & Lounge”
SELECT oi."id"              AS "order_item_id",
       oi."order_id",
       oi."user_id",
       oi."product_id",
