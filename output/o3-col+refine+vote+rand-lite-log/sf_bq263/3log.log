```sql
--Description: Show a few “Sleep & Lounge” order-items together with their sale prices and creation timestamps.
SELECT oi."id",
       oi."order_id",
       oi."product_id",
       oi."sale_price",
       oi."created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%sleep%lounge%'
LIMIT 20;
```

```sql
--Description: Peek at how an order’s header looks; join an example order-item to the parent order.
SELECT o."order_id",
       o."created_at",
       o."status",
       oi."id"           AS "order_item_id",
       oi."status"       AS "item_status",
       oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
     ON o."order_id" = oi."order_id"
WHERE o."status" = 'Complete'
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067199000000  -- 2023 micro-seconds
LIMIT 20;
```

```sql
--Description: Verify the product “cost” that matches each order-item through the PRODUCTS table.
SELECT oi."id"               AS "order_item_id",
       oi."sale_price",
       p."cost"              AS "product_cost",
       (oi."sale_price" - p."cost")  AS "profit_est"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%sleep%lounge%'
  AND oi."status" = 'Complete'
LIMIT 20;
```

```sql
--Description: Pull the month (YYYY-MM) out of the micro-second timestamp for a 2023 “Sleep & Lounge” sample; this guides the aggregation logic.
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "yyyymm",
       COUNT(*)                                       AS "items_cnt",
       SUM(oi."sale_price")                           AS "tot_sales"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%sleep%lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Aggregate 2023 data by month-number using numeric math only (no TO_CHAR) to cross-check month segmentation.
SELECT FLOOR((oi."created_at" - 1672531200000000) / 2592000000000) + 1 AS "month_number_1_12",
       COUNT(*)                                  AS "item_cnt",
       ROUND(SUM(oi."sale_price"),2)            AS "sales_sum"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%sleep%lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Confirm that every complete order in 2023 that has Sleep & Lounge items is reflected when we join to ORDERS.
SELECT DISTINCT o."order_id",
       COUNT(*) OVER() AS "rows_in_sample"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDERS       o
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
     ON o."order_id" = oi."order_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE o."status" = 'Complete'
  AND p."category" ILIKE '%sleep%lounge%'
  AND o."created_at" BETWEEN 1672531200000000 AND 1704067199000000
LIMIT 20;
```

```sql
--Description: Produce a profit-and-cost check per month (rounded) in draft form before the final report.
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM')      AS "yyyymm",
       ROUND(SUM(oi."sale_price"),2)                                  AS "tot_sales",
       ROUND(SUM(p."cost"),2)                                         AS "tot_cost",
       COUNT(DISTINCT oi."order_id")                                  AS "complete_orders",
       ROUND(SUM(oi."sale_price" - p."cost"),2)                       AS "profit",
       ROUND(SUM(oi."sale_price" - p."cost") / NULLIF(SUM(p."cost"),0),4) AS "profit_to_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%sleep%lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
--Description: Final aggregation using exact month numbers (1-12) for 2023; this is the layout that can be turned into the formal report.
SELECT FLOOR((oi."created_at" - 1672531200000000) / 2592000000000) + 1 AS "month_no",
       ROUND(SUM(oi."sale_price"),2)                                   AS "total_sales",
       ROUND(SUM(p."cost"),2)                                          AS "total_cost",
       COUNT(DISTINCT oi."order_id")                                   AS "num_complete_orders",
       ROUND(SUM(oi."sale_price" - p."cost"),2)                        AS "profit",
       ROUND(SUM(oi."sale_price" - p."cost") / NULLIF(SUM(p."cost"),0),4) AS "profit_to_cost_ratio"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
     ON oi."product_id" = p."id"
WHERE p."category" ILIKE '%sleep%lounge%'
  AND oi."status" = 'Complete'
  AND oi."created_at" BETWEEN 1672531200000000 AND 1704067199000000
GROUP BY 1
ORDER BY 1
LIMIT 20;
```
