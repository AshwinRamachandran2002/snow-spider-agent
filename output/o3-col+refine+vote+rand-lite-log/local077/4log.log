```sql
-- 4. Description: calculate the composition-to-index ratio for every interest in 09-2018
SELECT imt.month_year,
       imp.interest_name,
       AVG(imt.composition / imt.index_value) AS avg_comp_ratio
FROM interest_metrics AS imt
JOIN interest_map     AS imp
  ON imp.id = CAST(imt.interest_id AS INTEGER)
WHERE imt._year = 2018 AND imt._month = 9
GROUP BY imt.month_year, imp.interest_name
ORDER BY avg_comp_ratio DESC
LIMIT 20;
```

```sql
-- 5. Description: for each month from Sep-2018 to Aug-2019, find the highest avg_comp_ratio
WITH per_int AS (
  SELECT _year,
         _month,
         month_year,
         interest_id,
         AVG(composition / index_value) AS avg_comp_ratio
  FROM interest_metrics
  WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
  GROUP BY _year, _month, month_year, interest_id
)
SELECT *
FROM per_int
WHERE ( _year, _month, avg_comp_ratio ) IN (
        SELECT _year, _month, MAX(avg_comp_ratio)
        FROM per_int
        GROUP BY _year, _month )
ORDER BY _year, _month
LIMIT 20;
```

```sql
-- 6. Description: attach the interest names to those monthly winners
WITH per_int AS (
  SELECT _year,
         _month,
         month_year,
         interest_id,
         AVG(composition / index_value) AS avg_comp_ratio
  FROM interest_metrics
  WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
  GROUP BY _year, _month, month_year, interest_id
),
monthly_max AS (
  SELECT p.* 
  FROM per_int p
  JOIN (
        SELECT _year, _month, MAX(avg_comp_ratio) AS max_ratio
        FROM per_int
        GROUP BY _year, _month
       ) mx
    ON mx._year  = p._year
   AND mx._month = p._month
   AND mx.max_ratio = p.avg_comp_ratio
)
SELECT mm.month_year,
       im.interest_name,
       mm.avg_comp_ratio AS max_index_composition
FROM monthly_max AS mm
JOIN interest_map AS im
  ON im.id = CAST(mm.interest_id AS INTEGER)
ORDER BY mm._year, mm._month
LIMIT 20;
```

```sql
-- 7. Description: compute the 3-month rolling average of those monthly max compositions
WITH per_int AS (
  SELECT _year,
         _month,
         month_year,
         interest_id,
         AVG(composition / index_value) AS avg_comp_ratio
  FROM interest_metrics
  WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
  GROUP BY _year, _month, month_year, interest_id
),
monthly_max AS (
  SELECT p.* 
  FROM per_int p
  JOIN (
        SELECT _year, _month, MAX(avg_comp_ratio) AS max_ratio
        FROM per_int
        GROUP BY _year, _month
       ) mx
    ON mx._year  = p._year
   AND mx._month = p._month
   AND mx.max_ratio = p.avg_comp_ratio
)
SELECT month_year,
       avg_comp_ratio AS max_index_composition,
       ROUND(AVG(avg_comp_ratio) OVER (ORDER BY _year, _month
                                       ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4) AS rolling_avg_3m
FROM monthly_max
ORDER BY _year, _month
LIMIT 20;
```

```sql
-- 8. Description: final report – for every month show
--    (a) the top interest & its max index composition,
--    (b) 3-month rolling average,
--    (c) last month’s and two-months-ago’s top interests & values
WITH per_int AS (
  SELECT _year,
         _month,
         month_year,
         interest_id,
         AVG(composition / index_value) AS avg_comp_ratio
  FROM interest_metrics
  WHERE (_year = 2018 AND _month >= 9) OR (_year = 2019 AND _month <= 8)
  GROUP BY _year, _month, month_year, interest_id
),
monthly_max AS (
  SELECT p.* 
  FROM per_int p
  JOIN (
        SELECT _year, _month, MAX(avg_comp_ratio) AS max_ratio
        FROM per_int
        GROUP BY _year, _month
       ) mx
    ON mx._year  = p._year
   AND mx._month = p._month
   AND mx.max_ratio = p.avg_comp_ratio
),
monthly_named AS (
  SELECT mm._year,
         mm._month,
         mm.month_year,
         im.interest_name,
         mm.avg_comp_ratio AS max_index_comp
  FROM monthly_max mm
  JOIN interest_map im
    ON im.id = CAST(mm.interest_id AS INTEGER)
)
SELECT month_year   AS date,
       interest_name,
       ROUND(max_index_comp, 4)                    AS max_index_composition,
       ROUND(AVG(max_index_comp) OVER (
             ORDER BY _year, _month
             ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4)  AS rolling_avg_3m,
       LAG(interest_name,1)  OVER (ORDER BY _year, _month)  AS last_month_interest,
       LAG(max_index_comp,1) OVER (ORDER BY _year, _month)  AS last_month_max_index_comp,
       LAG(interest_name,2)  OVER (ORDER BY _year, _month)  AS two_months_ago_interest,
       LAG(max_index_comp,2) OVER (ORDER BY _year, _month)  AS two_months_ago_max_index_comp
FROM monthly_named
ORDER BY _year, _month
LIMIT 20;
```
