--Description: 8)  Combine everything: show current month, rolling average, and previous two months’ winners
WITH monthly_avg AS (
    SELECT
        "month_year",
        CAST(SUBSTR("month_year",4,4)||SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
        "interest_id",
        ROUND(AVG("composition"/NULLIF("index_value",0)),4) AS avg_comp,
        RANK() OVER (PARTITION BY "month_year"
                     ORDER BY AVG("composition"/NULLIF("index_value",0)) DESC) AS rk
    FROM "interest_metrics"
    WHERE ("_year"=2018 AND "_month">=9)
       OR ("_year"=2019 AND "_month"<=8)
    GROUP BY "month_year","interest_id"
),
monthly_max AS (
    SELECT "month_year",ym_key,"interest_id",avg_comp AS max_index_comp
    FROM monthly_avg
    WHERE rk=1
),
rolling AS (
    SELECT mm.*,
           ROUND(AVG(mm.max_index_comp) OVER (
                     ORDER BY mm.ym_key
                     ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_3m_avg
    FROM monthly_max mm
)
SELECT
    cur."month_year",
    icur."interest_name"             AS current_interest,
    cur."max_index_comp",
    cur."rolling_3m_avg",
    ip1."interest_name"              AS prev1_interest,
    p1."max_index_comp"              AS prev1_max_comp,
    ip2."interest_name"              AS prev2_interest,
    p2."max_index_comp"              AS prev2_max_comp
FROM rolling  cur
LEFT JOIN rolling  p1 ON p1.ym_key = cur.ym_key - 1
LEFT JOIN rolling  p2 ON p2.ym_key = cur.ym_key - 2
LEFT JOIN "interest_map" icur ON icur."id" = cur."interest_id"
LEFT JOIN "interest_map" ip1  ON ip1."id"  = p1."interest_id"
LEFT JOIN "interest_map" ip2  ON ip2."id"  = p2."interest_id"
ORDER BY cur.ym_key
LIMIT 20
Answer:
