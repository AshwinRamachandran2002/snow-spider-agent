```sql
--Description:  Thinking process (embedded):
--  • We must find, for every month (Sep-2018 ➜ Aug-2019), the interest whose
--    average-composition (composition ÷ index_value) is greatest.
--  • STEP-1 (CTE monthly_avg)  →  compute that average for every (month, interest)
--    and rank interests within each month (rk = 1 = monthly winner).
--  • STEP-2 (CTE monthly_max)  →  keep only those winners and store a yyyymm key.
--  • STEP-3 (CTE rolling)      →  add a 3-month rolling average of the monthly
--    max_index_comp values using a window frame (2 PRECEDING to CURRENT).
--  • Final SELECT              →  join current month’s winner (cur) to the winners
--    from one month ago (prev1) and two months ago (prev2) via ym_key-1 and ym_key-2,
--    attach the readable interest names, and return the requested columns.
WITH monthly_avg AS (
    SELECT
        "month_year",
        CAST(SUBSTR("month_year",4,4) || SUBSTR("month_year",1,2) AS INTEGER) AS ym_key, -- e.g. '03-2019' ➜ 201903
        "interest_id",
        ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS avg_comp,
        RANK() OVER (PARTITION BY "month_year"
                     ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rk
    FROM "interest_metrics"
    WHERE ("_year" = 2018 AND "_month" >= 9)
       OR ("_year" = 2019 AND "_month" <= 8)
    GROUP BY "month_year", "interest_id"
),
monthly_max AS (
    SELECT
        "month_year",
        ym_key,
        "interest_id",
        avg_comp AS max_index_comp
    FROM monthly_avg
    WHERE rk = 1                           -- keep only monthly winner
),
rolling AS (
    SELECT
        mm.*,
        ROUND(
            AVG(mm.max_index_comp) OVER (
                ORDER BY mm.ym_key
                ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
            ),4
        ) AS rolling_3m_avg
    FROM monthly_max mm
)
SELECT
    cur."month_year"                                        AS month,
    icur."interest_name"                                    AS current_interest,
    cur."max_index_comp"                                    AS max_index_composition,
    cur."rolling_3m_avg"                                    AS rolling_avg_3m,
    iprev1."interest_name"                                  AS prev1_interest,
    prev1."max_index_comp"                                  AS prev1_max_comp,
    iprev2."interest_name"                                  AS prev2_interest,
    prev2."max_index_comp"                                  AS prev2_max_comp
FROM rolling cur
LEFT JOIN rolling prev1  ON prev1.ym_key = cur.ym_key - 1   -- last month
LEFT JOIN rolling prev2  ON prev2.ym_key = cur.ym_key - 2   -- two months ago
LEFT JOIN "interest_map" icur   ON icur."id" = cur."interest_id"
LEFT JOIN "interest_map" iprev1 ON iprev1."id" = prev1."interest_id"
LEFT JOIN "interest_map" iprev2 ON iprev2."id" = prev2."interest_id"
ORDER BY cur.ym_key;
```
