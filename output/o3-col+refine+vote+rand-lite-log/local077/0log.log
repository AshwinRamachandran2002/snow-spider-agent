```sql
--Description: 10)  Validate the three-month rolling average for Jul-2019 (manually sum & divide by 3).
SELECT r."month_year",
       r."max_index_comp" AS "Jul_2019_max",
       (SELECT SUM(max_index_comp)
        FROM (
            SELECT max_index_comp
            FROM (
                SELECT "month_year", max_index_comp,
                       ROW_NUMBER() OVER (ORDER BY ym_key DESC) AS rn
                FROM (
                    SELECT CAST(SUBSTR("month_year",4,4)||SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
                           "month_year", max_index_comp
                    FROM (
                        SELECT "month_year",
                               MAX("composition" / NULLIF("index_value",0)) AS max_index_comp
                        FROM "interest_metrics"
                        WHERE ("_year" = 2019 AND "_month" <= 7)
                        GROUP BY "month_year"
                    )
                ) WHERE rn<=3
            )
        ) / 3.0 AS "hand_calc_rolling_avg",
        r."rolling_3m_avg" AS "window_calc"
FROM (
    /* previous CTE 'rolling' from query 8 */
    WITH mm AS (
        SELECT "month_year",
               CAST(SUBSTR("month_year",4,4)||SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
               MAX("composition" / NULLIF("index_value",0)) AS max_index_comp
        FROM "interest_metrics"
        WHERE ("_year" = 2018 AND "_month" >= 9)
           OR ("_year" = 2019 AND "_month" <= 8)
        GROUP BY "month_year"
    )
    SELECT mm.*,
           ROUND(AVG(mm.max_index_comp) OVER (ORDER BY ym_key
                 ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_3m_avg
    FROM mm
) r
WHERE r."month_year" = '07-2019'
LIMIT 20;
```

These ten progressively complex queries build up the full analysis: from locating the months in scope, through computing average compositions and monthly winners, to producing the final requested report with three-month rolling averages and historical context.
