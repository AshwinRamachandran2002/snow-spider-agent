```sql
--Description: 7)  Add a three-month rolling average of the monthly winners’ max-index compositions
WITH monthly_avg AS (
    SELECT
        "month_year",
        CAST(SUBSTR("month_year",4,4)||SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
        "interest_id",
        ROUND(AVG("composition"/NULLIF("index_value",0)),4) AS avg_comp,
        RANK() OVER (PARTITION BY "month_year"
                     ORDER BY AVG("composition"/NULLIF("index_value",0)) DESC) AS rk
    FROM "interest_metrics"
    WHERE ("_year"=2018 AND "_month">=9)
       OR ("_year"=2019 AND "_month"<=8)
    GROUP BY "month_year","interest_id"
),
monthly_max AS (
    SELECT "month_year",ym_key,"interest_id",avg_comp AS max_index_comp
    FROM monthly_avg
    WHERE rk=1
)
SELECT
    mm."month_year",
    im."interest_name"               AS current_interest,
    mm."max_index_comp",
    ROUND(AVG(mm.max_index_comp) OVER (
              ORDER BY mm.ym_key
              ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4)  AS rolling_3m_avg
FROM monthly_max mm
LEFT JOIN "interest_map" im ON im."id" = mm."interest_id"
ORDER BY mm.ym_key
LIMIT 20;
