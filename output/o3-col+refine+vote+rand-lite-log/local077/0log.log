```sql
--Description: 1)  Which months are available between Sep-2018 and Aug-2019?
SELECT DISTINCT "month_year"
FROM "interest_metrics"
WHERE ("_year" = 2018 AND "_month" >= 9)
   OR ("_year" = 2019 AND "_month" <= 8)
ORDER BY "_year", "_month"
LIMIT 20;
```

```sql
--Description: 2)  Peek at the raw metrics (composition vs index_value) during the period.
SELECT "_month", "_year", "interest_id",
       "composition", "index_value"
FROM "interest_metrics"
WHERE ("_year" = 2018 AND "_month" >= 9)
   OR ("_year" = 2019 AND "_month" <= 8)
LIMIT 20;
```

```sql
--Description: 3)  Calculate the average-composition (composition / index_value) for every interest each month.
SELECT "month_year",
       "interest_id",
       ROUND(AVG("composition" / NULLIF("index_value",0)), 4) AS "avg_comp"
FROM "interest_metrics"
WHERE ("_year" = 2018 AND "_month" >= 9)
   OR ("_year" = 2019 AND "_month" <= 8)
GROUP BY "month_year", "interest_id"
LIMIT 20;
```

```sql
--Description: 4)  Identify, for every month, the interest with the highest average-composition.
SELECT m1."month_year",
       m1."interest_id",
       m1."avg_comp"           AS "max_index_comp"
FROM (
    SELECT "month_year",
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)), 4) AS "avg_comp",
           RANK() OVER (PARTITION BY "month_year"
                        ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rk
    FROM "interest_metrics"
    WHERE ("_year" = 2018 AND "_month" >= 9)
       OR ("_year" = 2019 AND "_month" <= 8)
    GROUP BY "month_year", "interest_id"
) AS m1
WHERE m1.rk = 1
LIMIT 20;
```

```sql
--Description: 5)  Attach the readable interest name to each monthly winner.
SELECT w."month_year",
       i."interest_name",
       w."max_index_comp"
FROM (
    SELECT m1."month_year", m1."interest_id", m1."avg_comp" AS "max_index_comp"
    FROM (
        SELECT "month_year", "interest_id",
               AVG("composition" / NULLIF("index_value",0)) AS "avg_comp",
               RANK() OVER (PARTITION BY "month_year"
                            ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rk
        FROM "interest_metrics"
        WHERE ("_year" = 2018 AND "_month" >= 9)
           OR ("_year" = 2019 AND "_month" <= 8)
        GROUP BY "month_year", "interest_id"
    ) AS m1
    WHERE m1.rk = 1
) AS w
LEFT JOIN "interest_map"  i
  ON i."id" = w."interest_id"
LIMIT 20;
```

```sql
--Description: 6)  For every monthly winner, bring along last month’s and two-months-ago winners and their max compositions.
WITH monthly_max AS (
    SELECT "month_year",
           CAST(SUBSTR("month_year",4,4) || SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)), 4) AS max_index_comp
    FROM "interest_metrics"
    WHERE ("_year" = 2018 AND "_month" >= 9)
       OR ("_year" = 2019 AND "_month" <= 8)
    GROUP BY "month_year", "interest_id"
    HAVING max_index_comp = (
        SELECT MAX(AVG("composition" / NULLIF("index_value",0)))
        FROM "interest_metrics" m2
        WHERE m2."month_year" = "interest_metrics"."month_year"
        GROUP BY m2."month_year"
    )
)
SELECT cur."month_year",
       icur."interest_name"               AS "current_interest",
       cur."max_index_comp",
       iprev1."interest_name"             AS "prev1_interest",
       prev1."max_index_comp"             AS "prev1_max_comp",
       iprev2."interest_name"             AS "prev2_interest",
       prev2."max_index_comp"             AS "prev2_max_comp"
FROM monthly_max  cur
LEFT JOIN monthly_max prev1 ON prev1.ym_key = cur.ym_key - 1
LEFT JOIN monthly_max prev2 ON prev2.ym_key = cur.ym_key - 2
LEFT JOIN "interest_map" icur   ON icur."id" = cur."interest_id"
LEFT JOIN "interest_map" iprev1 ON iprev1."id" = prev1."interest_id"
LEFT JOIN "interest_map" iprev2 ON iprev2."id" = prev2."interest_id"
ORDER BY cur.ym_key
LIMIT 20;
```

```sql
--Description: 7)  Add a three-month rolling average of the max index compositions.
WITH monthly_max AS (
    SELECT "month_year",
           CAST(SUBSTR("month_year",4,4) || SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)), 4) AS max_index_comp
    FROM "interest_metrics"
    WHERE ("_year" = 2018 AND "_month" >= 9)
       OR ("_year" = 2019 AND "_month" <= 8)
    GROUP BY "month_year", "interest_id"
    HAVING max_index_comp = (
        SELECT MAX(AVG("composition" / NULLIF("index_value",0)))
        FROM "interest_metrics" m2
        WHERE m2."month_year" = "interest_metrics"."month_year"
        GROUP BY m2."month_year"
    )
)
SELECT cur."month_year",
       icur."interest_name"               AS "current_interest",
       cur."max_index_comp",
       ROUND(AVG(cur."max_index_comp") OVER (ORDER BY cur.ym_key
            ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4)  AS "rolling_3m_avg"
FROM monthly_max cur
LEFT JOIN "interest_map" icur ON icur."id" = cur."interest_id"
ORDER BY cur.ym_key
LIMIT 20;
```

```sql
--Description: 8)  Combine everything: current month, rolling average, and previous two months’ winners in one view.
WITH monthly_max AS (
    SELECT "month_year",
           CAST(SUBSTR("month_year",4,4) || SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)), 4) AS max_index_comp
    FROM "interest_metrics"
    WHERE ("_year" = 2018 AND "_month" >= 9)
       OR ("_year" = 2019 AND "_month" <= 8)
    GROUP BY "month_year", "interest_id"
    HAVING max_index_comp = (
        SELECT MAX(AVG("composition" / NULLIF("index_value",0)))
        FROM "interest_metrics" m2
        WHERE m2."month_year" = "interest_metrics"."month_year"
        GROUP BY m2."month_year"
    )
),
rolling AS (
    SELECT mm.*,
           ROUND(AVG(mm.max_index_comp) OVER (ORDER BY mm.ym_key
                 ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4) AS rolling_3m_avg
    FROM monthly_max mm
)
SELECT cur."month_year",
       icur."interest_name"              AS "current_interest",
       cur."max_index_comp",
       cur."rolling_3m_avg",
       iprev1."interest_name"            AS "prev1_interest",
       prev1."max_index_comp"            AS "prev1_max_comp",
       iprev2."interest_name"            AS "prev2_interest",
       prev2."max_index_comp"            AS "prev2_max_comp"
FROM rolling cur
LEFT JOIN rolling prev1  ON prev1.ym_key = cur.ym_key - 1
LEFT JOIN rolling prev2  ON prev2.ym_key = cur.ym_key - 2
LEFT JOIN "interest_map" icur   ON icur."id" = cur."interest_id"
LEFT JOIN "interest_map" iprev1 ON iprev1."id" = prev1."interest_id"
LEFT JOIN "interest_map" iprev2 ON iprev2."id" = prev2."interest_id"
ORDER BY cur.ym_key
LIMIT 20;
```

