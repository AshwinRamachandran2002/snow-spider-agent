--Description: 10)  Validate the three-month rolling average for Jul-2019 (compare manual vs window calc)
WITH monthly_avg AS (
    SELECT
        "month_year",
        CAST(SUBSTR("month_year",4,4)||SUBSTR("month_year",1,2) AS INTEGER) AS ym_key,
        "interest_id",
        ROUND(AVG("composition"/NULLIF("index_value",0)),4) AS avg_comp,
        RANK() OVER (PARTITION BY "month_year"
                     ORDER BY AVG("composition"/NULLIF("index_value",0)) DESC) AS rk
    FROM "interest_metrics"
    WHERE ("_year"=2018 AND "_month">=9)
       OR ("_year"=2019 AND "_month"<=8)
    GROUP BY "month_year","interest_id"
),
monthly_max AS (
    SELECT "month_year",ym_key,"interest_id",avg_comp AS max_index_comp
    FROM monthly_avg
    WHERE rk=1
),
rolling AS (
    SELECT
        mm.*,
        ROUND(AVG(mm.max_index_comp) OVER (
                  ORDER BY mm.ym_key
                  ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_3m_avg
    FROM monthly_max mm
),
manual AS (               -- compute manual 3-month average for comparison
    SELECT
        SUM(max_index_comp)/3.0 AS manual_avg
    FROM monthly_max
    WHERE ym_key BETWEEN 201905 AND 201907       -- May, Jun, Jul 2019
)
SELECT 
    r."month_year",
    r."max_index_comp"        AS jul_2019_max_comp,
    r."rolling_3m_avg"        AS window_calc_avg,
    m.manual_avg              AS hand_calc_avg
FROM rolling r, manual m
WHERE r."month_year" = '07-2019'
Answer:
month_year,jul_2019_max_comp,window_calc_avg,hand_calc_avg
