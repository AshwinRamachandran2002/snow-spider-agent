```sql
-- Description: For every month-interest pair in the window, compute
--              avg_comp  = composition / index_value.
SELECT 
       _year,
       _month,
       month_year,
       interest_id,
       ROUND( composition / NULLIF(index_value,0), 4 ) AS avg_comp
FROM   interest_metrics
WHERE ( _year = 2018 AND _month >= 9 )
   OR ( _year = 2019 AND _month <= 8 )
LIMIT 20;
