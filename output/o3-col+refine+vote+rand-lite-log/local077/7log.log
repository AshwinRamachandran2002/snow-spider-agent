Query:
-- Description: Identify, for each month in the window, the single interest that has
--              the greatest avg_comp (max index composition).
WITH month_interest AS (
    SELECT
        printf('%04d-%02d', _year, _month) AS month_date,
        im.interest_id,
        mp.interest_name,
        ROUND( composition / NULLIF(index_value,0), 4 ) AS avg_comp
    FROM   interest_metrics AS im
    JOIN   interest_map     AS mp ON im.interest_id = mp.id
    WHERE ( _year = 2018 AND _month >= 9 )
       OR ( _year = 2019 AND _month <= 8 )
),
ranked AS (
    SELECT
        month_date,
        interest_id,
        interest_name,
        avg_comp,
        RANK() OVER (PARTITION BY month_date ORDER BY avg_comp DESC) AS rnk
    FROM   month_interest
)
SELECT
    month_date,
    interest_name,
    avg_comp AS max_index_comp
FROM   ranked
WHERE  rnk = 1
ORDER BY month_date
LIMIT 20;
