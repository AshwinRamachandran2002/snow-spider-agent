-- “average composition” each month.  That “average composition” is defined
-- as composition / index_value.  Once those monthly winners are identified
-- we also need:
--   • the winning value (max_index_comp) for each month
--   • a 3-month rolling average of those max_index_comp values
--   • the winners and max_index_comp values from one and two months ago.
--
-- Approach
--   1. month_interest CTE
--        – filter the 12-month window.
--        – compute avg_comp.
--        – rank the interests within each month by that value.
--   2. monthly_max CTE
--        – keep only the rank-1 rows (top interest per month).
--   3. rolling CTE
--        – on that reduced set, calculate
--              • rolling_avg   (ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)
--              • LAG() columns for 1- and 2-month look-backs.
--   4. Final SELECT returns the requested columns chronologically.
WITH month_interest AS (
    SELECT
        _year,
        _month,
        printf('%04d-%02d', _year, _month)                        AS month_date,
        mp.interest_name,
        ROUND(composition / NULLIF(index_value, 0), 4)            AS avg_comp,
        ROW_NUMBER() OVER (
            PARTITION BY _year, _month
            ORDER BY composition / NULLIF(index_value, 0) DESC
        )                                                         AS rn
    FROM   interest_metrics AS im
    JOIN   interest_map      AS mp ON im.interest_id = mp.id
    WHERE  (_year = 2018 AND _month >= 9)
       OR  (_year = 2019 AND _month <= 8)
),
monthly_max AS (
    SELECT
        month_date,
        interest_name,
        avg_comp
    FROM   month_interest
    WHERE  rn = 1
),
rolling AS (
    SELECT
        month_date,
        interest_name                                       AS current_top_interest,
        avg_comp                                            AS max_index_comp,
        ROUND(AVG(avg_comp) OVER (
                ORDER BY month_date
                ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
             ), 4)                                          AS rolling_avg,
        LAG(interest_name, 1) OVER (ORDER BY month_date)    AS top_interest_1_month_ago,
        LAG(avg_comp,      1) OVER (ORDER BY month_date)    AS max_index_comp_1_month_ago,
        LAG(interest_name, 2) OVER (ORDER BY month_date)    AS top_interest_2_months_ago,
        LAG(avg_comp,      2) OVER (ORDER BY month_date)    AS max_index_comp_2_months_ago
    FROM   monthly_max
)
SELECT *
FROM   rolling
ORDER BY month_date;
Results:
month_date,current_top_interest,max_index_comp,rolling_avg,top_interest_1_month_ago,max_index_comp_1_month_ago,top_interest_2_months_ago,max_index_comp_2_months_ago
