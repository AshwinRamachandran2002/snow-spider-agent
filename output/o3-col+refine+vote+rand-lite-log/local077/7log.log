Query:
-- Description: Combine steps 3 & 4 – Full month-interest list (window) with names
--              and avg_comp so we can spot the biggest interest manually if needed.
SELECT 
       printf('%04d-%02d', _year, _month)        AS month_date,
       mp.interest_name,
       ROUND( composition / NULLIF(index_value,0), 4 ) AS avg_comp
FROM   interest_metrics AS im
JOIN   interest_map     AS mp
       ON im.interest_id = mp.id
WHERE ( _year = 2018 AND _month >= 9 )
   OR ( _year = 2019 AND _month <= 8 )
ORDER BY month_date, avg_comp DESC
LIMIT 40;
