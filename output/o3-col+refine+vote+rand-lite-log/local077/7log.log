```sql
-- Description: Combine steps 3 & 4 – Full month-interest list (window) with names
--              and avg_comp so we can spot the biggest interest manually if needed.
SELECT 
       printf('%04d-%02d', _year, _month)        AS month_date,
       mp.interest_name,
       ROUND( composition / NULLIF(index_value,0), 4 ) AS avg_comp
FROM   interest_metrics AS im
JOIN   interest_map     AS mp
       ON im.interest_id = mp.id
WHERE ( _year = 2018 AND _month >= 9 )
   OR ( _year = 2019 AND _month <= 8 )
ORDER BY month_date, avg_comp DESC
LIMIT 40;
```

```sql
-- Description: Identify, for each month in the window, the single interest that has
--              the greatest avg_comp (max index composition).
WITH month_interest AS (
    SELECT
        printf('%04d-%02d', _year, _month) AS month_date,
        im.interest_id,
        mp.interest_name,
        ROUND( composition / NULLIF(index_value,0), 4 ) AS avg_comp
    FROM   interest_metrics AS im
    JOIN   interest_map     AS mp ON im.interest_id = mp.id
    WHERE ( _year = 2018 AND _month >= 9 )
       OR ( _year = 2019 AND _month <= 8 )
),
ranked AS (
    SELECT
        month_date,
        interest_id,
        interest_name,
        avg_comp,
        RANK() OVER (PARTITION BY month_date ORDER BY avg_comp DESC) AS rnk
    FROM   month_interest
)
SELECT
    month_date,
    interest_name,
    avg_comp AS max_index_comp
FROM   ranked
WHERE  rnk = 1
ORDER BY month_date
LIMIT 20;
```

```sql
-- Description: Add three-month rolling average of the monthly max_index_comp
--              (current + previous two months).
WITH monthly_max AS (
    SELECT
        printf('%04d-%02d', _year, _month) AS month_date,
        ROUND( composition / NULLIF(index_value,0), 4 ) AS avg_comp,
        mp.interest_name
    FROM   interest_metrics AS im
    JOIN   interest_map     AS mp ON im.interest_id = mp.id
    WHERE ( _year = 2018 AND _month >= 9 )
       OR ( _year = 2019 AND _month <= 8 )
    QUALIFY RANK() OVER (
        PARTITION BY _year, _month 
        ORDER BY composition / NULLIF(index_value,0) DESC
    ) = 1
),
rolling AS (
    SELECT
        month_date,
        interest_name,
        avg_comp                                       AS max_index_comp,
        ROUND( AVG(avg_comp) OVER (
                 ORDER BY month_date
                 ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
              ), 4 )                                  AS rolling_avg,
        LAG(interest_name, 1) OVER (ORDER BY month_date)       AS m1_interest,
        LAG(avg_comp,      1) OVER (ORDER BY month_date)       AS m1_max_index,
        LAG(interest_name, 2) OVER (ORDER BY month_date)       AS m2_interest,
        LAG(avg_comp,      2) OVER (ORDER BY month_date)       AS m2_max_index
    FROM   monthly_max
)
SELECT
    month_date,
    interest_name                     AS current_top_interest,
    max_index_comp,
    rolling_avg,
    m1_interest       AS top_interest_1_month_ago,
    m1_max_index      AS max_index_comp_1_month_ago,
    m2_interest       AS top_interest_2_months_ago,
    m2_max_index      AS max_index_comp_2_months_ago
FROM   rolling
ORDER BY month_date
LIMIT 20;
```

```sql
-- Description: Final answer – the complete list (September-2018 to August-2019)
--              with dates, current top interest, current max index composition,
--              3-month rolling average, plus the prior two months’ winners.
WITH month_interest AS (
    SELECT
        _year,
        _month,
        printf('%04d-%02d', _year, _month)                   AS month_date,
        im.interest_id,
        mp.interest_name,
        ROUND( composition / NULLIF(index_value,0), 4 )      AS avg_comp
    FROM   interest_metrics AS im
    JOIN   interest_map     AS mp ON im.interest_id = mp.id
    WHERE ( _year = 2018 AND _month >= 9 )
       OR ( _year = 2019 AND _month <= 8 )
),
monthly_max AS (
    SELECT
        month_date,
        interest_name,
        avg_comp
    FROM   (
        SELECT
            month_date,
            interest_name,
            avg_comp,
            ROW_NUMBER() OVER (PARTITION BY month_date ORDER BY avg_comp DESC) AS rn
        FROM   month_interest
    )
    WHERE rn = 1
),
rolling AS (
    SELECT
        month_date,
        interest_name                                              AS current_top_interest,
        avg_comp                                                   AS max_index_comp,
        ROUND( AVG(avg_comp) OVER (
                 ORDER BY month_date 
                 ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
              ), 4 )                                               AS rolling_avg,
        LAG(interest_name, 1) OVER (ORDER BY month_date)           AS top_interest_1_month_ago,
        LAG(avg_comp,      1) OVER (ORDER BY month_date)           AS max_index_comp_1_month_ago,
        LAG(interest_name, 2) OVER (ORDER BY month_date)           AS top_interest_2_months_ago,
        LAG(avg_comp,      2) OVER (ORDER BY month_date)           AS max_index_comp_2_months_ago
    FROM   monthly_max
)
SELECT *
FROM   rolling
ORDER BY month_date;
```
