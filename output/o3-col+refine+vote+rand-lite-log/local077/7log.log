--Description:
--Goal : Deliver the complete report for Sep-2018 → Aug-2019 that includes
--       • the top-ranked interest each month
--       • its max_index_comp (composition/index_value)
--       • a 3-month rolling average of those monthly max_index_comp values
--       • the winners and values from one and two months prior.
--
--Method
-- 1. month_interest
--      ‑ restrict to the 12-month window
--      ‑ compute avg_comp = composition / index_value
--      ‑ rank interests within each month (ROW_NUMBER).
-- 2. monthly_max
--      ‑ keep only rank-1 rows → monthly winners.
-- 3. rolling
--      ‑ compute 3-month rolling average of max_index_comp
--      ‑ fetch winners from 1- and 2-months ago with LAG.
WITH month_interest AS (
    SELECT
        _year,
        _month,
        printf('%04d-%02d', _year, _month)                   AS month_date,
        mp.interest_name,
        ROUND(composition / NULLIF(index_value, 0), 4)       AS avg_comp,
        ROW_NUMBER() OVER (
            PARTITION BY _year, _month
            ORDER BY composition / NULLIF(index_value, 0) DESC
