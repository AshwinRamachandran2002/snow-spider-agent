--Description: Create a month-level table of top interests (numeric date filter), then expose each month’s current top interest plus the top interest and composition from the prior one and two months via LAG.
WITH monthly_max AS (
     SELECT  "month_year",
             "interest_id",
             ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "max_index_comp",
             RANK() OVER (PARTITION BY "month_year"
                          ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
     FROM   "interest_metrics"
     WHERE  (CAST(SUBSTR("month_year",4,4) AS INTEGER) * 100
             + CAST(SUBSTR("month_year",1,2) AS INTEGER)) BETWEEN 201809 AND 201908
     GROUP  BY "month_year","interest_id"
),
top_monthly AS (
     SELECT mm."month_year",
            im."interest_name",
            mm."max_index_comp"
     FROM   monthly_max AS mm
     JOIN   "interest_map" AS im
       ON   im."id" = mm."interest_id"
     WHERE  mm.rnk = 1
)
SELECT t."month_year",
       t."interest_name"                             AS "current_interest",
       t."max_index_comp"                            AS "current_max_comp",
       LAG(t."interest_name",1) OVER(ORDER BY t."month_year")  AS "prev_interest",
       LAG(t."max_index_comp",1) OVER(ORDER BY t."month_year") AS "prev_max_comp",
       LAG(t."interest_name",2) OVER(ORDER BY t."month_year")  AS "prev2_interest",
       LAG(t."max_index_comp",2) OVER(ORDER BY t."month_year") AS "prev2_max_comp"
FROM   top_monthly AS t
ORDER  BY t."month_year"
LIMIT 20
