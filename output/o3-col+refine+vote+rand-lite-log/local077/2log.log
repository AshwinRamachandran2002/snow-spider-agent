FROM "interest_metrics"
WHERE "month_year" BETWEEN '09-2018' AND '08-2019'
ORDER BY "interest_id"
LIMIT 20;
```

```sql
-- 3. Map those ids to readable names
SELECT im."id"          AS "interest_id",
       im."interest_name"
FROM   "interest_map" AS im
WHERE  im."id" IN (
       SELECT DISTINCT "interest_id"
       FROM "interest_metrics"
       WHERE "month_year" BETWEEN '09-2018' AND '08-2019')
ORDER BY im."id"
LIMIT 20;
```

```sql
-- 4. For one sample month (Sep-2018) calculate the “average composition”
--    (composition ÷ index_value) for every interest
SELECT "month_year",
       "interest_id",
       ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp"
FROM   "interest_metrics"
WHERE  "month_year" = '09-2018'
GROUP  BY "month_year","interest_id"
ORDER  BY "avg_comp" DESC
LIMIT 20;
```

```sql
-- 5. For each month in scope, pick the interest_id with the highest avg_comp
SELECT t."month_year",
       t."interest_id",
       t."avg_comp" AS "max_index_comp"
FROM   (
        SELECT  "month_year",
                "interest_id",
                ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "avg_comp",
                RANK() OVER (PARTITION BY "month_year"
                             ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
        FROM   "interest_metrics"
        WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
        GROUP  BY "month_year","interest_id"
       ) AS t
WHERE  t.rnk = 1
ORDER  BY t."month_year"
LIMIT 20;
```

```sql
-- 6. Join the previous result with interest_map to show the top interest’s name each month
SELECT a."month_year",
       m."interest_name",
       a."max_index_comp"
FROM   (
        /* same CTE as in query 5 */  
        SELECT  "month_year",
                "interest_id",
                ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "max_index_comp",
                RANK() OVER (PARTITION BY "month_year"
                             ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
        FROM   "interest_metrics"
        WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
        GROUP  BY "month_year","interest_id"
       ) AS a
JOIN   "interest_map" AS m
  ON   m."id" = a."interest_id"
WHERE  a.rnk = 1
ORDER  BY a."month_year"
LIMIT 20;
```

```sql
-- 7. Add the previous month’s and two-months-ago’s top interest & their compositions
WITH monthly_max AS (
      SELECT  "month_year",
              "interest_id",
              ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "max_index_comp",
              RANK() OVER (PARTITION BY "month_year"
                           ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
      FROM   "interest_metrics"
      WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
      GROUP  BY "month_year","interest_id"
),
top_monthly AS (
      SELECT mm."month_year",
             im."interest_name",
             mm."max_index_comp"
      FROM   monthly_max AS mm
      JOIN   "interest_map" AS im
        ON   im."id" = mm."interest_id"
      WHERE  mm.rnk = 1
)
SELECT t1."month_year",
       t1."interest_name"               AS "current_interest",
       t1."max_index_comp"              AS "current_max_comp",
       LAG(t1."interest_name",1) OVER(ORDER BY t1."month_year") AS "prev_interest",
       LAG(t1."max_index_comp",1) OVER(ORDER BY t1."month_year") AS "prev_max_comp",
       LAG(t1."interest_name",2) OVER(ORDER BY t1."month_year") AS "prev2_interest",
       LAG(t1."max_index_comp",2) OVER(ORDER BY t1."month_year") AS "prev2_max_comp"
FROM   top_monthly AS t1
ORDER  BY t1."month_year"
LIMIT 20;
```

```sql
-- 8. Compute the 3-month rolling average of the max_index_comp
WITH monthly_max AS (
      SELECT  "month_year",
              "interest_id",
              ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "max_index_comp",
              RANK() OVER (PARTITION BY "month_year"
                           ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
      FROM   "interest_metrics"
      WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
      GROUP  BY "month_year","interest_id"
),
top_monthly AS (
      SELECT mm."month_year",
             mm."max_index_comp"
      FROM   monthly_max AS mm
      WHERE  mm.rnk = 1
)
SELECT tm.*,
       ROUND(AVG(tm."max_index_comp") OVER
             (ORDER BY tm."month_year" ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),6) AS "rolling_3m_avg"
FROM   top_monthly AS tm
ORDER  BY tm."month_year"
LIMIT 20;
```

```sql
-- 9. Final combined result with rolling average and names for lag-1 and lag-2 months
WITH monthly_max AS (
      SELECT  "month_year",
              "interest_id",
              ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "max_index_comp",
              RANK() OVER (PARTITION BY "month_year"
                           ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
      FROM   "interest_metrics"
      WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
      GROUP  BY "month_year","interest_id"
),
top_monthly AS (
      SELECT mm."month_year",
             im."interest_name",
             mm."max_index_comp"
      FROM   monthly_max AS mm
      JOIN   "interest_map" AS im
        ON   im."id" = mm."interest_id"
      WHERE  mm.rnk = 1
)
SELECT  tm."month_year"                    AS "date",
        tm."interest_name"                 AS "top_interest",
        tm."max_index_comp"                AS "max_index_composition",
        ROUND(AVG(tm."max_index_comp") OVER
              (ORDER BY tm."month_year" ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),6) AS "rolling_3m_avg",
        LAG(tm."interest_name",1) OVER(ORDER BY tm."month_year")  AS "top_interest_m-1",
        LAG(tm."max_index_comp",1) OVER(ORDER BY tm."month_year") AS "max_comp_m-1",
        LAG(tm."interest_name",2) OVER(ORDER BY tm."month_year")  AS "top_interest_m-2",
        LAG(tm."max_index_comp",2) OVER(ORDER BY tm."month_year") AS "max_comp_m-2"
FROM    top_monthly AS tm
ORDER   BY tm."month_year"
LIMIT 20;
```

