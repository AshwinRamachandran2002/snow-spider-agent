Query:
--Description: For every month in the Sep-2018 (201809) to Aug-2019 (201908) window, find the interest_id with the highest average composition (composition ÷ index_value); uses numeric YYYYMM conversion for correct filtering.
SELECT t."month_year",
       t."interest_id",
       t."avg_comp" AS "max_index_comp"
FROM (
     SELECT  "month_year",
             "interest_id",
             ROUND(AVG("composition" / NULLIF("index_value",0)),6) AS "avg_comp",
             RANK() OVER (PARTITION BY "month_year"
                          ORDER BY AVG("composition" / NULLIF("index_value",0)) DESC) AS rnk
     FROM   "interest_metrics"
     WHERE  (CAST(SUBSTR("month_year",4,4) AS INTEGER) * 100
             + CAST(SUBSTR("month_year",1,2) AS INTEGER)) BETWEEN 201809 AND 201908
     GROUP  BY "month_year","interest_id"
) AS t
WHERE  t.rnk = 1
ORDER  BY t."month_year"
LIMIT 20
