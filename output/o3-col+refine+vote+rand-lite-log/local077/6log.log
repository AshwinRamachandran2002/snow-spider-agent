        printf('%04d-%02d', CAST(im."_year"  AS INTEGER),
                           CAST(im."_month" AS INTEGER))          AS month_start,
        mp.interest_name,
        AVG(im.composition / NULLIF(im.index_value, 0))            AS avg_comp
