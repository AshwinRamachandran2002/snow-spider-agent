```sql
--Description: Build a month-by-month list (Sept-2018 → Aug-2019) of the interest with the highest avg-composition
SELECT strftime('%Y-%m', date(im._year || '-' || printf('%02d', im._month) || '-01'))  AS month_start,
       mp.interest_name,
       ROUND(AVG(im.composition / NULLIF(im.index_value,0)), 4)                         AS max_index_composition
FROM   interest_metrics AS im
JOIN   interest_map     AS mp ON mp.id = im.interest_id
WHERE  (im._year = 2018 AND im._month BETWEEN 9 AND 12)
   OR  (im._year = 2019 AND im._month BETWEEN 1 AND 8)
GROUP  BY month_start
HAVING max_index_composition = (
        SELECT MAX(avg_val)  -- calculate the max avg-comp for that same month inside a subquery
        FROM  (
              SELECT AVG(im2.composition / NULLIF(im2.index_value,0)) AS avg_val
              FROM  interest_metrics AS im2
              WHERE im2._year = im._year AND im2._month = im._month
              GROUP BY im2.interest_id
        )
)
ORDER  BY month_start
LIMIT 20;
```

```sql
--Description: Store the above monthly winners in a CTE and calculate the 3-month rolling average of their max_index_composition values
WITH monthly_max AS (
  SELECT strftime('%Y-%m', date(im._year || '-' || printf('%02d', im._month) || '-01')) AS month_start,
         mp.interest_name,
         ROUND(AVG(im.composition / NULLIF(im.index_value,0)), 4) AS max_index_composition
  FROM   interest_metrics AS im
  JOIN   interest_map     AS mp ON mp.id = im.interest_id
  WHERE  (im._year = 2018 AND im._month BETWEEN 9 AND 12)
     OR  (im._year = 2019 AND im._month BETWEEN 1 AND 8)
  GROUP  BY month_start
  HAVING max_index_composition = (
          SELECT MAX(avg_val)
          FROM  (
                SELECT AVG(im2.composition / NULLIF(im2.index_value,0)) AS avg_val
                FROM  interest_metrics AS im2
                WHERE im2._year = im._year AND im2._month = im._month
                GROUP BY im2.interest_id
          )
  )
)
SELECT month_start,
       interest_name,
       max_index_composition,
       ROUND(AVG(max_index_composition) OVER (
             ORDER BY month_start
             ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4)         AS rolling_3m_avg
FROM   monthly_max
ORDER  BY month_start
LIMIT 20;
```

```sql
--Description: Enrich the rolling-average result by appending the previous month’s and two-months-ago top interests + their values
WITH monthly_max AS (
  SELECT strftime('%Y-%m', date(im._year || '-' || printf('%02d', im._month) || '-01')) AS month_start,
         mp.interest_name,
         ROUND(AVG(im.composition / NULLIF(im.index_value,0)), 4) AS max_index_composition
  FROM   interest_metrics AS im
  JOIN   interest_map     AS mp ON mp.id = im.interest_id
  WHERE  (im._year = 2018 AND im._month BETWEEN 9 AND 12)
     OR  (im._year = 2019 AND im._month BETWEEN 1 AND 8)
  GROUP  BY month_start
  HAVING max_index_composition = (
          SELECT MAX(avg_val)
          FROM  (
                SELECT AVG(im2.composition / NULLIF(im2.index_value,0)) AS avg_val
                FROM  interest_metrics AS im2
                WHERE im2._year = im._year AND im2._month = im._month
                GROUP BY im2.interest_id
          )
  )
), final AS (
  SELECT m.*,
         LAG(interest_name,1)  OVER (ORDER BY month_start) AS prev1_interest,
         LAG(max_index_composition,1) OVER (ORDER BY month_start) AS prev1_max,
         LAG(interest_name,2)  OVER (ORDER BY month_start) AS prev2_interest,
         LAG(max_index_composition,2) OVER (ORDER BY month_start) AS prev2_max,
         ROUND(AVG(max_index_composition) OVER (
               ORDER BY month_start
               ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4)      AS rolling_3m_avg
  FROM   monthly_max AS m
)
SELECT *
FROM   final
ORDER  BY month_start
LIMIT 20;
```

