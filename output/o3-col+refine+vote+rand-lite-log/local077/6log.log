--Description: For one month (September-2018) calculate the “average composition” metric (composition ÷ index_value) for every interest_id
SELECT
       _month,
       _year,
       interest_id,
       ROUND(AVG(composition / NULLIF(index_value,0)), 4) AS avg_comp
FROM   interest_metrics
WHERE  (_year = 2018 AND _month = 9)
GROUP  BY _month, _year, interest_id
ORDER  BY avg_comp DESC
LIMIT 20;
