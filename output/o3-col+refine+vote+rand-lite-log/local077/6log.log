Query:
--Description: Identify September-2018’s top interest by average composition and attach its name
SELECT im.month_year,
       mp.interest_name,
       ROUND(AVG(im.composition / NULLIF(im.index_value,0)), 4) AS max_index_composition
FROM   interest_metrics AS im
JOIN   interest_map     AS mp ON mp.id = im.interest_id
WHERE  im._year = 2018 AND im._month = 9
GROUP  BY im.month_year
ORDER  BY max_index_composition DESC
LIMIT 1;
