```sql
--Description:  Goal → one result per month (2018-09 ➜ 2019-08) that shows  
--              • the interest with the highest average-composition (composition ÷ index_value)  
--              • that month’s max index-composition,  
--              • a 3-month rolling average of those maxima, and  
--              • the top-interest names & values from one and two months prior.  
--              --------------------------------------------------------------  
--              1. interest_avg  – average-composition for every interest_id each month.  
--              2. monthly_max   – pick the single highest avg_comp per month (ROW_NUMBER).  
--              3. final         – add LAGs for prev-1/prev-2 months and a 3-month rolling AVG.  
WITH interest_avg AS (          -- step-1
    SELECT
        strftime('%Y-%m', date(_year || '-' || printf('%02d', _month) || '-01'))     AS month_start,
        mp.interest_name,
        AVG(im.composition / NULLIF(im.index_value, 0))                              AS avg_comp
    FROM   interest_metrics  AS im
    JOIN   interest_map      AS mp  ON mp.id = im.interest_id
    WHERE  (_year = 2018 AND _month BETWEEN 9 AND 12)
       OR  (_year = 2019 AND _month BETWEEN 1 AND 8)
    GROUP  BY month_start, mp.interest_name
), monthly_max AS (             -- step-2
    SELECT month_start,
           interest_name,
           avg_comp AS max_index_composition
    FROM  (
        SELECT
            month_start,
            interest_name,
            avg_comp,
            ROW_NUMBER() OVER (PARTITION BY month_start
                               ORDER BY avg_comp DESC) AS rn
        FROM interest_avg
    )
    WHERE rn = 1                -- keep the monthly winner
), final AS (                   -- step-3
    SELECT
        month_start,
        interest_name,
        ROUND(max_index_composition, 4)                                         AS max_index_composition,
        ROUND(AVG(max_index_composition) OVER (
              ORDER BY month_start
              ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 4)                    AS rolling_3m_avg,
        LAG(interest_name, 1) OVER (ORDER BY month_start)                       AS prev1_interest,
        LAG(max_index_composition, 1) OVER (ORDER BY month_start)               AS prev1_max_index_composition,
        LAG(interest_name, 2) OVER (ORDER BY month_start)                       AS prev2_interest,
        LAG(max_index_composition, 2) OVER (ORDER BY month_start)               AS prev2_max_index_composition
    FROM monthly_max
)
SELECT *
FROM   final
ORDER  BY month_start;
