2025-05-05 04:39:12 - Thread-3614 (execute) - INFO - [Exploration]
Below are 8 incremental SQL statements (all use only SELECT).  
Each one is annotated so you can see how the logic is built – from inspecting the raw monthly data to the final result that includes the three-month rolling average and the look-back to the prior two months.

```sql
--Description: 1) List all year / month combinations in the target period
SELECT DISTINCT _year,
       _month,
       month_year
FROM interest_metrics
WHERE (_year = 2018 AND _month >= 9)
   OR (_year = 2019 AND _month <= 8)
ORDER BY _year, _month
LIMIT 20;
```

```sql
--Description: 2) Sample the mapping between interest_id (metrics) and interest_name (map)
SELECT DISTINCT im.interest_id,
       mp.interest_name
FROM interest_metrics  AS im
LEFT JOIN interest_map AS mp
       ON im.interest_id = mp.id
LIMIT 20;
```

```sql
--Description: 3) For every month & every interest calculate
--              avg_comp  =  composition / index_value
SELECT _year,
       _month,
       month_year,
       interest_id,
       ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_comp
FROM interest_metrics
WHERE (_year = 2018 AND _month >= 9)
   OR (_year = 2019 AND _month <= 8)
GROUP BY _year, _month, interest_id
ORDER BY _year, _month
LIMIT 20;
```

```sql
--Description: 4) For every month rank interests by the above avg_comp
SELECT _year,
       _month,
       month_year,
       interest_id,
       avg_comp
FROM (
      SELECT _year,
             _month,
             month_year,
             interest_id,
             AVG(composition / NULLIF(index_value,0))                       AS avg_comp,
             RANK() OVER (PARTITION BY _year,_month ORDER BY AVG(composition / NULLIF(index_value,0)) DESC) AS rk
      FROM interest_metrics
      WHERE (_year = 2018 AND _month >= 9)
         OR (_year = 2019 AND _month <= 8)
      GROUP BY _year, _month, interest_id
) 
WHERE rk = 1
ORDER BY _year, _month
LIMIT 20;
```

```sql
--Description: 5) Add the interest_name to the monthly winners
SELECT m.month_year,
       mp.interest_name,
       ROUND(m.avg_comp,4) AS max_index_composition
FROM (
      SELECT _year,
             _month,
             month_year,
             interest_id,
             AVG(composition / NULLIF(index_value,0)) AS avg_comp,
             RANK() OVER (PARTITION BY _year,_month ORDER BY AVG(composition / NULLIF(index_value,0)) DESC) AS rk
      FROM interest_metrics
      WHERE (_year = 2018 AND _month >= 9)
         OR (_year = 2019 AND _month <= 8)
      GROUP BY _year, _month, interest_id
)  AS m
JOIN interest_map AS mp
  ON m.interest_id = mp.id
WHERE m.rk = 1
ORDER BY m._year, m._month
LIMIT 20;
```

```sql
--Description: 6) Use the same ranked sub-query and add a 3-month rolling average
SELECT month_year,
       interest_name,
       ROUND(max_index_composition,4)                                         AS max_index_composition,
       ROUND(AVG(max_index_composition) OVER (ORDER BY _year,_month
                                              ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_avg_3m
FROM (
      SELECT _year,
             _month,
             month_year,
             mp.interest_name,
             AVG(im.composition / NULLIF(im.index_value,0)) AS max_index_composition,
             RANK() OVER (PARTITION BY _year,_month
                          ORDER BY AVG(im.composition / NULLIF(im.index_value,0)) DESC) AS rk
      FROM interest_metrics AS im
      JOIN interest_map     AS mp ON im.interest_id = mp.id
      WHERE (_year = 2018 AND _month >= 9)
         OR (_year = 2019 AND _month <= 8)
      GROUP BY _year, _month, im.interest_id
) 
WHERE rk = 1
ORDER BY _year, _month
LIMIT 20;
```

```sql
--Description: 7) Add LAGs to report the top interests and values
--              from one month and two months ago
SELECT month_year                 AS date,
       interest_name              AS current_top_interest,
       ROUND(max_index_composition,4)                AS current_max_index_comp,
       ROUND(AVG(max_index_composition) OVER (ORDER BY _year,_month
                                              ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_avg_3m,
       LAG(interest_name,1) OVER (ORDER BY _year,_month) AS top_interest_1_month_ago,
       ROUND(LAG(max_index_composition,1) OVER (ORDER BY _year,_month),4) AS max_index_comp_1_month_ago,
       LAG(interest_name,2) OVER (ORDER BY _year,_month) AS top_interest_2_months_ago,
       ROUND(LAG(max_index_composition,2) OVER (ORDER BY _year,_month),4) AS max_index_comp_2_months_ago
FROM (
      SELECT _year,
             _month,
             month_year,
             mp.interest_name,
             AVG(im.composition / NULLIF(im.index_value,0)) AS max_index_composition,
             RANK() OVER (PARTITION BY _year,_month
                          ORDER BY AVG(im.composition / NULLIF(im.index_value,0)) DESC) AS rk
      FROM interest_metrics AS im
      JOIN interest_map     AS mp ON im.interest_id = mp.id
      WHERE (_year = 2018 AND _month >= 9)
         OR (_year = 2019 AND _month <= 8)
      GROUP BY _year, _month, im.interest_id
) 
WHERE rk = 1
ORDER BY _year, _month
LIMIT 20;
```

```sql
--Description: 8) (Optional) Show the complete 12-month result set without the LIMIT
--               Remove LIMIT if you want the full Sept-2018 to Aug-2019 output
SELECT month_year                 AS date,
       interest_name              AS current_top_interest,
       ROUND(max_index_composition,4)                AS current_max_index_comp,
