Query:
--Description: For every month, find the single interest that has the highest avg_ratio.
WITH month_int_ratio AS (
  SELECT month_year, interest_id,
         ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_ratio
  FROM interest_metrics
  WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
     OR (_year=2019 AND _month BETWEEN 1 AND 8)
     AND index_value <> 0
  GROUP BY month_year, interest_id
),
ranked AS (
  SELECT month_year, interest_id, avg_ratio,
         RANK() OVER (PARTITION BY month_year ORDER BY avg_ratio DESC) AS rnk
  FROM month_int_ratio
)
SELECT
       month_year,
       interest_id,
       avg_ratio
FROM ranked
WHERE rnk = 1
LIMIT 20;
