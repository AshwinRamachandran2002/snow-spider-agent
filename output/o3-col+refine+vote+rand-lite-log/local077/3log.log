```sql
--Description: View all distinct month/year combinations in interest_metrics so we can confirm the
--2018-09 to 2019-08 range exists.
SELECT DISTINCT month_year
FROM interest_metrics
WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
   OR (_year=2019 AND _month BETWEEN 1 AND 8)
LIMIT 20;
```

```sql
--Description: Inspect a sample of rows in September-2018 to understand the raw composition
--and index_value numbers we will later aggregate.
SELECT *
FROM interest_metrics
WHERE _year = 2018
  AND _month = 9
LIMIT 20;
```

```sql
--Description: Calculate the composition-to-index ratio (protecting against divide-by-zero) for the
--September-2018 rows as a worked example.
SELECT
       interest_id,
       month_year,
       ROUND(composition / NULLIF(index_value,0), 4) AS comp_idx_ratio
FROM interest_metrics
WHERE _year = 2018
  AND _month = 9
  AND index_value <> 0
LIMIT 20;
```

```sql
--Description: Aggregate the average comp/index ratio per month & per interest across the whole
--Sep-2018 → Aug-2019 window.
SELECT
       month_year,
       interest_id,
       ROUND(AVG(composition / NULLIF(index_value,0)), 4) AS avg_ratio
FROM interest_metrics
WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
   OR (_year=2019 AND _month BETWEEN 1 AND 8)
   AND index_value <> 0
GROUP BY month_year, interest_id
LIMIT 20;
```

```sql
--Description: Join the previous aggregation with interest_map to attach readable interest names.
WITH month_int_ratio AS (
  SELECT month_year, interest_id,
         ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_ratio
  FROM interest_metrics
  WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
     OR (_year=2019 AND _month BETWEEN 1 AND 8)
     AND index_value <> 0
  GROUP BY month_year, interest_id
)
SELECT
       m.month_year,
       im.interest_name,
       m.avg_ratio
FROM month_int_ratio AS m
JOIN interest_map AS im
  ON im.id = m.interest_id
LIMIT 20;
```

```sql
--Description: For every month, find the single interest that has the highest avg_ratio.
WITH month_int_ratio AS (
  SELECT month_year, interest_id,
         ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_ratio
  FROM interest_metrics
  WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
     OR (_year=2019 AND _month BETWEEN 1 AND 8)
     AND index_value <> 0
  GROUP BY month_year, interest_id
),
ranked AS (
  SELECT month_year, interest_id, avg_ratio,
         RANK() OVER (PARTITION BY month_year ORDER BY avg_ratio DESC) AS rnk
  FROM month_int_ratio
)
SELECT
       month_year,
       interest_id,
       avg_ratio
FROM ranked
WHERE rnk = 1
LIMIT 20;
```

```sql
--Description: Add the interest name to the monthly winners from the previous query.
WITH month_int_ratio AS (
  SELECT month_year, interest_id,
         ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_ratio
  FROM interest_metrics
  WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
     OR (_year=2019 AND _month BETWEEN 1 AND 8)
     AND index_value <> 0
  GROUP BY month_year, interest_id
),
winners AS (
  SELECT month_year, interest_id, avg_ratio,
         RANK() OVER (PARTITION BY month_year ORDER BY avg_ratio DESC) AS rnk
  FROM month_int_ratio
)
SELECT
       w.month_year,
       im.interest_name,
       w.avg_ratio AS max_idx_composition
FROM winners AS w
JOIN interest_map AS im
  ON im.id = w.interest_id
WHERE w.rnk = 1
LIMIT 20;
```

```sql
--Description: Produce the final requested output.  For every month from Sep-2018 to Aug-2019:
-- • top interest & its max index composition
-- • three-month rolling average of those max compositions
-- • names & compositions of the top interests one-month and two-months earlier.
WITH month_int_ratio AS (
  SELECT month_year, interest_id,
         ROUND(AVG(composition / NULLIF(index_value,0)),4) AS avg_ratio
  FROM interest_metrics
  WHERE (_year=2018 AND _month BETWEEN 9 AND 12)
     OR (_year=2019 AND _month BETWEEN 1 AND 8)
     AND index_value <> 0
  GROUP BY month_year, interest_id
),
winners AS (
  SELECT month_year,
         interest_id,
         avg_ratio,
         RANK() OVER (PARTITION BY month_year ORDER BY avg_ratio DESC) AS rnk
  FROM month_int_ratio
),
top_monthly AS (
  SELECT month_year,
         interest_id,
         avg_ratio
  FROM winners
  WHERE rnk = 1
),
with_names AS (
  SELECT
         tm.month_year,
         im.interest_name,
         tm.avg_ratio
  FROM top_monthly AS tm
  JOIN interest_map AS im
    ON im.id = tm.interest_id
),
rolling AS (
  SELECT
         wn.month_year AS cur_month,
         wn.interest_name  AS cur_interest,
         wn.avg_ratio      AS cur_max_idx_comp,
         -- Three-month rolling average including current month
         ROUND(AVG(wn.avg_ratio)
               OVER (ORDER BY wn.month_year
                     ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS rolling_3m,
         -- previous month winner
         LAG(wn.interest_name,1) OVER (ORDER BY wn.month_year)  AS prev1_interest,
         LAG(wn.avg_ratio,1)      OVER (ORDER BY wn.month_year) AS prev1_max_idx,
         -- two months ago winner
         LAG(wn.interest_name,2) OVER (ORDER BY wn.month_year)  AS prev2_interest,
         LAG(wn.avg_ratio,2)      OVER (ORDER BY wn.month_year) AS prev2_max_idx
  FROM with_names AS wn
)
SELECT
       cur_month        AS month_year,
       cur_interest     AS top_interest,
       cur_max_idx_comp AS max_idx_composition,
       rolling_3m       AS rolling_3m_avg,
       prev1_interest,
       prev1_max_idx,
       prev2_interest,
       prev2_max_idx
FROM rolling
ORDER BY cur_month
LIMIT 20;
```

