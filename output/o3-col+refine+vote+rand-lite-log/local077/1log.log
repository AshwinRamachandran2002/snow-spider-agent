```sql
-- Description: 6) Compute the monthly average composition (=composition/index_value) per interest
SELECT "month_year",
       "interest_id",
       ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp_idx"
FROM  "interest_metrics"
WHERE "month_year" BETWEEN '09-2018' AND '08-2019'
GROUP BY "month_year","interest_id"
LIMIT 20;
```

```sql
-- Description: 7) For each month, keep only the interest with the highest average composition
WITH monthly_avg AS (
    SELECT "month_year",
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp_idx"
    FROM   "interest_metrics"
    WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
    GROUP  BY "month_year","interest_id"
)
SELECT ma.*
FROM   monthly_avg AS ma
JOIN  (SELECT "month_year",
              MAX("avg_comp_idx") AS mx
       FROM   monthly_avg
       GROUP  BY "month_year") AS mxs
  ON  ma."month_year" = mxs."month_year"
 AND  ma."avg_comp_idx" = mxs.mx
ORDER BY ma."month_year"
LIMIT 20;
```

```sql
-- Description: 8) Add the human-readable interest names to the monthly maxima
WITH monthly_avg AS (
    SELECT "month_year",
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp_idx"
    FROM   "interest_metrics"
    WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
    GROUP  BY "month_year","interest_id"
),
monthly_max AS (
    SELECT ma."month_year",
           ma."interest_id",
           ma."avg_comp_idx"
    FROM   monthly_avg AS ma
    JOIN  (SELECT "month_year",
                  MAX("avg_comp_idx") AS mx
           FROM   monthly_avg
           GROUP  BY "month_year") AS mxs
      ON  ma."month_year" = mxs."month_year"
     AND ma."avg_comp_idx" = mxs.mx
)
SELECT mm."month_year",
       mp."interest_name",
       mm."avg_comp_idx" AS "max_idx_comp"
FROM   monthly_max AS mm
LEFT  JOIN "interest_map" AS mp
       ON mp."id" = mm."interest_id"
ORDER BY mm."month_year"
LIMIT 20;
```

```sql
-- Description: 9) Compute the 3-month rolling average of the monthly max index compositions
WITH monthly_avg AS (
    SELECT "month_year",
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp_idx"
    FROM   "interest_metrics"
    WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
    GROUP  BY "month_year","interest_id"
),
monthly_max AS (
    SELECT ma."month_year",
           ma."interest_id",
           ma."avg_comp_idx"
    FROM   monthly_avg AS ma
    JOIN  (SELECT "month_year",
                  MAX("avg_comp_idx") AS mx
           FROM   monthly_avg
           GROUP  BY "month_year") AS mxs
      ON  ma."month_year" = mxs."month_year"
     AND ma."avg_comp_idx" = mxs.mx
)
SELECT mm.*,
       ROUND(AVG(mm."avg_comp_idx") OVER (
             ORDER BY mm."month_year"
             ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS "rolling_avg_3m"
FROM   monthly_max AS mm
ORDER  BY mm."month_year"
LIMIT 20;
```

```sql
-- Description: 10) Final answer – include current month’s winner, rolling average, and prior two months’ winners & values
WITH monthly_avg AS (
    SELECT "month_year",
           "interest_id",
           ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp_idx"
    FROM   "interest_metrics"
    WHERE  "month_year" BETWEEN '09-2018' AND '08-2019'
    GROUP  BY "month_year","interest_id"
),
monthly_max AS (
    SELECT ma."month_year",
           ma."interest_id",
           ma."avg_comp_idx"
    FROM   monthly_avg AS ma
    JOIN  (SELECT "month_year",
                  MAX("avg_comp_idx") AS mx
           FROM   monthly_avg
           GROUP  BY "month_year") AS mxs
      ON  ma."month_year" = mxs."month_year"
     AND ma."avg_comp_idx" = mxs.mx
),
named_max AS (
    SELECT mm."month_year",
           mp."interest_name",
           mm."avg_comp_idx"
    FROM   monthly_max AS mm
    LEFT  JOIN "interest_map" AS mp
           ON mp."id" = mm."interest_id"
),
rolling_final AS (
    SELECT nm.*,
           ROUND(AVG(nm."avg_comp_idx") OVER (
                 ORDER BY nm."month_year"
                 ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS "rolling_avg_3m",
           LAG(nm."interest_name",1) OVER (ORDER BY nm."month_year")  AS "interest_m1",
           LAG(nm."avg_comp_idx",1)   OVER (ORDER BY nm."month_year")  AS "max_idx_m1",
           LAG(nm."interest_name",2) OVER (ORDER BY nm."month_year")  AS "interest_m2",
           LAG(nm."avg_comp_idx",2)   OVER (ORDER BY nm."month_year")  AS "max_idx_m2"
    FROM   named_max AS nm
)
SELECT "month_year"       AS "date",
       "interest_name"    AS "top_interest",
       "avg_comp_idx"     AS "max_idx_comp",
       "rolling_avg_3m",
       "interest_m1",
       "max_idx_m1",
       "interest_m2",
       "max_idx_m2"
FROM   rolling_final
ORDER  BY "date"
LIMIT 20;
```
