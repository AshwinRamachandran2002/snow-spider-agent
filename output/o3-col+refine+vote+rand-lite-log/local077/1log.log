--Description: 10) Final answer – winner each month, 3-month rolling average, and prior-month winners/values  
WITH monthly_avg AS (  
    SELECT "month_year","interest_id",  
           ROUND(AVG("composition" / NULLIF("index_value",0)),4) AS "avg_comp_idx"  
    FROM "interest_metrics"  
    WHERE "month_year" <> ''  
      AND ( (substr("month_year",4,4)='2018' AND substr("month_year",1,2)>='09')  
         OR (substr("month_year",4,4)='2019' AND substr("month_year",1,2)<='08') )  
    GROUP BY "month_year","interest_id"  
),  
monthly_max AS (  
    SELECT ma.*  
    FROM monthly_avg AS ma  
    JOIN (SELECT "month_year", MAX("avg_comp_idx") AS mx  
          FROM monthly_avg GROUP BY "month_year") AS mxs  
      ON ma."month_year" = mxs."month_year"  
     AND ma."avg_comp_idx" = mxs.mx  
),  
named_max AS (  
    SELECT mm."month_year", mp."interest_name", mm."avg_comp_idx"  
    FROM monthly_max AS mm  
    LEFT JOIN "interest_map" AS mp ON mp."id" = mm."interest_id"  
),  
rolling_final AS (  
    SELECT nm.*,  
           ROUND(AVG(nm."avg_comp_idx") OVER (  
                 ORDER BY nm."month_year"  
                 ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),4) AS "rolling_avg_3m",  
           LAG(nm."interest_name",1) OVER (ORDER BY nm."month_year") AS "interest_m1",  
           LAG(nm."avg_comp_idx",1) OVER (ORDER BY nm."month_year") AS "max_idx_m1",  
           LAG(nm."interest_name",2) OVER (ORDER BY nm."month_year") AS "interest_m2",  
           LAG(nm."avg_comp_idx",2) OVER (ORDER BY nm."month_year") AS "max_idx_m2"  
    FROM named_max AS nm  
)  
SELECT "month_year" AS "date",  
       "interest_name" AS "top_interest",  
       "avg_comp_idx" AS "max_idx_comp",  
       "rolling_avg_3m",  
       "interest_m1", "max_idx_m1",  
       "interest_m2", "max_idx_m2"  
FROM rolling_final  
ORDER BY "date"  
LIMIT 20
