WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
  AND event_name = 'session_start'
  AND PARSE_DATE('%Y%m%d',event_date) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
LIMIT 20;
```

```sql
-- 7. Description: For the same users, pull their session_start events
-- that happened two calendar weeks (14-20 days) after their cohort week  
WITH cohorts AS (
  SELECT DISTINCT
         DATE_TRUNC(PARSE_DATE('%Y%m%d',event_date), WEEK(MONDAY)) AS cohort_week,
         user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
)
SELECT c.cohort_week,
       r.event_date AS week2_event_date,
       c.user_pseudo_id
FROM cohorts AS c
JOIN `firebase-public-project.analytics_153293282.events_*` AS r
  ON r.user_pseudo_id = c.user_pseudo_id
WHERE r.event_name = 'session_start'
  AND _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
  AND PARSE_DATE('%Y%m%d',r.event_date)
      BETWEEN DATE_ADD(c.cohort_week, INTERVAL 14 DAY)
          AND DATE_ADD(c.cohort_week, INTERVAL 20 DAY)
LIMIT 20;
```

```sql
-- 8. Description: Count size of each weekly cohort (July-09 ➜ Sep-17)  
WITH cohorts AS (
  SELECT DISTINCT
         DATE_TRUNC(PARSE_DATE('%Y%m%d',event_date), WEEK(MONDAY)) AS cohort_week,
         user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
)
SELECT cohort_week,
       COUNT(DISTINCT user_pseudo_id) AS cohort_size
FROM cohorts
WHERE cohort_week BETWEEN '2018-07-09' AND '2018-09-17'
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 9. Description: Count retained users (those with a session_start in week-2)  
WITH cohorts AS (
  SELECT DISTINCT
         DATE_TRUNC(PARSE_DATE('%Y%m%d',event_date), WEEK(MONDAY)) AS cohort_week,
         user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
),
week2 AS (
  SELECT DISTINCT
         c.cohort_week,
         c.user_pseudo_id
  FROM cohorts AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS r
    ON r.user_pseudo_id = c.user_pseudo_id
  WHERE r.event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND PARSE_DATE('%Y%m%d',r.event_date)
        BETWEEN DATE_ADD(c.cohort_week, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week, INTERVAL 20 DAY)
)
SELECT cohort_week,
       COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM week2
WHERE cohort_week BETWEEN '2018-07-09' AND '2018-09-17'
GROUP BY cohort_week
ORDER BY cohort_week
LIMIT 20;
```

```sql
-- 10. Description: FINAL ANSWER – Week-2 retention rate for each cohort  
WITH cohorts AS (
  SELECT DISTINCT
         DATE_TRUNC(PARSE_DATE('%Y%m%d',event_date), WEEK(MONDAY)) AS cohort_week,
         user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'               -- all tables we need
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))  -- new users
),
week2_retained AS (
  SELECT DISTINCT
         c.cohort_week,
         c.user_pseudo_id
  FROM cohorts AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS r
    ON r.user_pseudo_id = c.user_pseudo_id
  WHERE r.event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND PARSE_DATE('%Y%m%d',r.event_date)
        BETWEEN DATE_ADD(c.cohort_week, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week, INTERVAL 20 DAY)             -- week 2 window
)
SELECT
  c.cohort_week,
  COUNT(DISTINCT w.user_pseudo_id)       AS retained_users,
  COUNT(DISTINCT c.user_pseudo_id)       AS cohort_size,
  ROUND(100 * COUNT(DISTINCT w.user_pseudo_id) /
              COUNT(DISTINCT c.user_pseudo_id),2) AS week2_retention_pct
FROM cohorts AS c
LEFT JOIN week2_retained AS w
  ON w.cohort_week = c.cohort_week
GROUP BY c.cohort_week
HAVING c.cohort_week BETWEEN '2018-07-09' AND '2018-09-17'            -- only cohorts with full 2-week look-ahead
ORDER BY c.cohort_week
LIMIT 20;
```
