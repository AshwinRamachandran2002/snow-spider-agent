         c.cohort_week,
         c.user_pseudo_id
  FROM cohorts AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS r
    ON r.user_pseudo_id = c.user_pseudo_id
  WHERE r.event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND PARSE_DATE('%Y%m%d',r.event_date)
        BETWEEN DATE_ADD(c.cohort_week, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week, INTERVAL 20 DAY)             -- week 2 window
)
SELECT
  c.cohort_week,
  COUNT(DISTINCT w.user_pseudo_id)       AS retained_users,
  COUNT(DISTINCT c.user_pseudo_id)       AS cohort_size,
  ROUND(100 * COUNT(DISTINCT w.user_pseudo_id) /
              COUNT(DISTINCT c.user_pseudo_id),2) AS week2_retention_pct
FROM cohorts AS c
LEFT JOIN week2_retained AS w
  ON w.cohort_week = c.cohort_week
GROUP BY c.cohort_week
HAVING c.cohort_week BETWEEN '2018-07-09' AND '2018-09-17'            -- only cohorts with full 2-week look-ahead
ORDER BY c.cohort_week
LIMIT 20;
