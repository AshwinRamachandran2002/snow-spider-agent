-- 9. Description: Count retained users (those with a session_start in week-2)  
WITH cohorts AS (
  SELECT DISTINCT
         DATE_TRUNC(PARSE_DATE('%Y%m%d',event_date), WEEK(MONDAY)) AS cohort_week,
         user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d',event_date) = DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))
),
week2 AS (
  SELECT DISTINCT
         c.cohort_week,
         c.user_pseudo_id
  FROM cohorts AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS r
    ON r.user_pseudo_id = c.user_pseudo_id
  WHERE r.event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180709' AND '20181002'
    AND PARSE_DATE('%Y%m%d',r.event_date)
        BETWEEN DATE_ADD(c.cohort_week, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week, INTERVAL 20 DAY)
)
SELECT cohort_week,
       COUNT(DISTINCT user_pseudo_id) AS retained_users
FROM week2
WHERE cohort_week BETWEEN '2018-07-09' AND '2018-09-17'
GROUP BY cohort_week
ORDER BY cohort_week
