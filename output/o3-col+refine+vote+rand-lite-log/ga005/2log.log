--   3. Restrict tables to 9-Jul-2018 through 17-Sep-2018 (last cohort with a measurable Week-2).
--   4. Keep only session_start events where the event day equals the user’s first-touch day
--      → definition of a brand-new user.
--   5. Count distinct user_pseudo_id per cohort.
SELECT
