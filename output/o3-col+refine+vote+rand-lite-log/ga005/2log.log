  DATE_TRUNC(DATE(event_date), WEEK(MONDAY)) AS cohort_week_start,
  COUNT(DISTINCT user_pseudo_id)             AS cohort_size
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'      -- last cohort we can study
  AND event_name = 'session_start'
  AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```

```sql
-- 6. For every (user , cohort_week) find whether the user came back in the
--    week that starts exactly 14 days later (week-2 window).
WITH cohorts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(DATE(event_date), WEEK(MONDAY))            AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
  GROUP BY user_pseudo_id, cohort_week_start
),

returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_week_start
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20181001'   -- 14-day shifted window
    AND e.event_name = 'session_start'
    -- date of the return must fall into the exact Week-2 window
    AND DATE(e.event_date) BETWEEN c.cohort_week_start + 14  AND c.cohort_week_start + 20
)
SELECT *
FROM returns
LIMIT 20;
```

```sql
-- 7. Final answer – Week-2 retention rate for every weekly cohort
WITH cohorts AS (
  SELECT
    DATE_TRUNC(DATE(event_date), WEEK(MONDAY))            AS cohort_week_start,
    user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
  GROUP BY cohort_week_start, user_pseudo_id
),

returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_week_start
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20181001'   -- 14-day shifted window
    AND e.event_name = 'session_start'
    AND DATE(e.event_date) BETWEEN c.cohort_week_start + 14  AND c.cohort_week_start + 20
)

SELECT
  cohort_week_start                           AS cohort,
  COUNT(DISTINCT r.user_pseudo_id) /
  COUNT(DISTINCT c.user_pseudo_id)            AS week2_retention_rate
FROM cohorts c
LEFT JOIN returns r
  ON c.user_pseudo_id = r.user_pseudo_id
  AND c.cohort_week_start = r.cohort_week_start
GROUP BY cohort_week_start
ORDER BY cohort_week_start
LIMIT 20;
```

The last query produces one line per cohort Monday (from 2018-07-09 through 2018-09-17) together with that cohort’s Week-2 retention percentage.
