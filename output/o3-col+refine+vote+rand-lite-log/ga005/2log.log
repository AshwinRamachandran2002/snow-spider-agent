Query:
--Description:
-- Corrected query #6 – identify users who return with a session_start in the Week-2 window.
-- Fixes applied:
--   • Cast event_date from STRING to DATE with PARSE_DATE('%Y%m%d', event_date).
--   • Use DATE_TRUNC on that DATE to create the cohort start (Monday).
--   • Convert e.event_date the same way for the BETWEEN comparison.
--   • Use DATE_ADD to express “+14 days” and “+20 days” for clarity / safety.
WITH cohorts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS cohort_week_start
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'        -- cohorts we care about
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp))) -- new users
  GROUP BY user_pseudo_id, cohort_week_start
),

returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_week_start
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20181001'        -- tables that can hold Week-2 activity
    AND e.event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', e.event_date)
        BETWEEN DATE_ADD(c.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week_start, INTERVAL 20 DAY) -- Week-2 window (Mon-Sun)
)

SELECT *
FROM returns
LIMIT 20
