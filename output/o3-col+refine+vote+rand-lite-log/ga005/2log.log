--Description:
-- Goal: weekly cohort analysis (weeks start Monday) for users who install between 9-Jul-2018
--       and 17-Sep-2018, and compute their Week-2 retention (session_start 14-20 days later).
-- Reasoning steps
--   1. NEW user  = first-day session_start → event_date equals DATE(user_first_touch_timestamp).
--   2. event_date is a STRING (YYYYMMDD); always convert with PARSE_DATE to do date math safely.
--   3. Cohort label = DATE_TRUNC(<parsed date>, WEEK(MONDAY)).
--   4. Week-2 window = cohort Monday +14 to +20 days inclusive (Mon-Sun two weeks later).
--   5. Build two CTEs:
--        • cohorts : distinct (user, cohort_week_start).
--        • returns : subset that fires session_start inside the Week-2 window.
--   6. LEFT JOIN cohorts → returns and divide (#returned / #cohort) with SAFE_DIVIDE.
WITH cohorts AS (
  SELECT
    DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)) AS cohort_week_start,
    user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180709' AND '20180917'
    AND event_name = 'session_start'
    AND event_date = FORMAT_DATE('%Y%m%d', DATE(TIMESTAMP_MICROS(user_first_touch_timestamp)))
  GROUP BY cohort_week_start, user_pseudo_id
),
returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_week_start
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20181001'   -- tables that contain 14-20-day range
    AND e.event_name = 'session_start'
    AND PARSE_DATE('%Y%m%d', e.event_date)
        BETWEEN DATE_ADD(c.cohort_week_start, INTERVAL 14 DAY)
            AND DATE_ADD(c.cohort_week_start, INTERVAL 20 DAY)
)
SELECT
  c.cohort_week_start                           AS cohort,
  SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
              COUNT(DISTINCT c.user_pseudo_id))  AS week2_retention_rate
FROM cohorts c
LEFT JOIN returns r
  ON c.user_pseudo_id     = r.user_pseudo_id
  AND c.cohort_week_start = r.cohort_week_start
GROUP BY c.cohort_week_start
ORDER BY c.cohort_week_start;
