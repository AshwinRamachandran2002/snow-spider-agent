             COUNT(DISTINCT IF(sd.event_dt BETWEEN cu.cohort_week_start + 14
                                            AND cu.cohort_week_start + 20 ,
                               cu.user_pseudo_id , NULL)),
             COUNT(DISTINCT cu.user_pseudo_id)
       ),2) AS week2_retention_rate_percent
FROM cohort_users  AS cu
LEFT JOIN session_dates AS sd
       USING(user_pseudo_id)
WHERE cu.cohort_week_start BETWEEN DATE '2018-07-09' AND DATE '2018-09-17'
GROUP BY cu.cohort_week_start
ORDER BY cu.cohort_week_start
LIMIT 20;
