--Description: 5) First (initial) quickplay timestamp per user & quickplay-type in the period
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplay AS (
  SELECT event_name,
         user_pseudo_id,
         event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
)
SELECT event_name   AS quickplay_type,
       user_pseudo_id,
       MIN(event_timestamp) AS first_quickplay_ts
FROM quickplay
GROUP BY quickplay_type, user_pseudo_id
LIMIT 20;
