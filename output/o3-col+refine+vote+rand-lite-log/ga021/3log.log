--Description:
-- Goal  : 14-day retention for each “quickplay” event among users who began a session 2–16 Jul 2018.
-- Steps  :
--   (1) cohort    – users with ≥1 session_start in the window.
--   (2) quickplays – every event whose name contains “quickplay”; keep _TABLE_SUFFIX as `ds`.
--   (3) initials  – for each (user, quickplay_type) pick the FIRST quickplay inside the window
--                   → defines “day-0” for that pair.
--   (4) retained  – a user is retained if the same quickplay occurs ≥14 days (1 209 600 000 000 µs)
--                   after the initial timestamp.
--   (5) Aggregate – initial-user count, retained-user count, and retention-rate.
WITH cohort AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplays AS (
  SELECT
    event_name,
    user_pseudo_id,
    event_timestamp,
    _TABLE_SUFFIX AS ds                          -- keep date string for filtering
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
),
initials AS (
  SELECT
    event_name            AS quickplay_type,
    user_pseudo_id,
    MIN(event_timestamp)  AS first_ts            -- first quickplay per type/user in window
  FROM quickplays
  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
    AND ds BETWEEN '20180702' AND '20180716'
  GROUP BY quickplay_type, user_pseudo_id
),
retained AS (
  SELECT DISTINCT
    i.quickplay_type,
    i.user_pseudo_id
  FROM initials i
  JOIN quickplays q
    ON q.user_pseudo_id  = i.user_pseudo_id
   AND q.event_name      = i.quickplay_type
   AND q.event_timestamp >= i.first_ts + 1209600000000      -- 14 days (µs)
)
SELECT
  i.quickplay_type,
  COUNT(DISTINCT i.user_pseudo_id)                       AS users_initial,
  COUNT(DISTINCT r.user_pseudo_id)                       AS users_retained,
  ROUND(COUNT(DISTINCT r.user_pseudo_id)
        / NULLIF(COUNT(DISTINCT i.user_pseudo_id),0),4)  AS retention_rate
FROM initials i
LEFT JOIN retained r
  ON r.quickplay_type = i.quickplay_type
 AND r.user_pseudo_id = i.user_pseudo_id
