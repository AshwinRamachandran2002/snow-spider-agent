--Description: FINAL answer – 14-day retention (D14) for each “quickplay” event type
-- Logic (written inline):
--   1) cohort    → every user who fired at least one session_start between 2 Jul 2018 and 16 Jul 2018.
--   2) quickplays→ pull all events whose name contains “quickplay” and keep the table suffix (ds).
--   3) base      → for each cohort user & quickplay_type, find the very first quickplay inside that window.
--                  That first_ts is “day-0” for the pair.
--   4) retained  → user counts as retained if the SAME quickplay is fired ≥14 days (1 209 600 000 000 µs)
--                  after first_ts, at any later date.
--   5) Aggregate → output initial user-count, retained user-count, and retention-rate.
WITH cohort AS (                           -- step-1
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplays AS (                            -- step-2
  SELECT
    event_name,
    user_pseudo_id,
    event_timestamp,
    _TABLE_SUFFIX AS ds
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
),
base AS (                                  -- step-3
  SELECT
    event_name            AS quickplay_type,
    user_pseudo_id,
    MIN(event_timestamp)  AS first_ts
  FROM quickplays
  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM cohort)
    AND ds BETWEEN '20180702' AND '20180716'
  GROUP BY quickplay_type, user_pseudo_id
),
retained AS (                              -- step-4
  SELECT DISTINCT
    b.quickplay_type,
    b.user_pseudo_id
  FROM base b
  JOIN quickplays q
    ON q.event_name     = b.quickplay_type
   AND q.user_pseudo_id = b.user_pseudo_id
   AND q.event_timestamp >= b.first_ts + 1209600000000      -- ≥14 days
)
-- step-5: aggregation with retention-rate
SELECT
  b.quickplay_type,
  COUNT(DISTINCT b.user_pseudo_id)                      AS users_initial,
  COUNT(DISTINCT r.user_pseudo_id)                      AS users_retained,
  ROUND(COUNT(DISTINCT r.user_pseudo_id)
        / NULLIF(COUNT(DISTINCT b.user_pseudo_id),0),4) AS retention_rate
FROM base b
LEFT JOIN retained r
       ON r.quickplay_type = b.quickplay_type
      AND r.user_pseudo_id = b.user_pseudo_id
GROUP BY b.quickplay_type
ORDER BY retention_rate DESC
LIMIT 20;
