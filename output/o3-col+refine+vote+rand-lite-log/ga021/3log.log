Query:
--Description: 7) Count base vs retained users (14-day) for each quick-play type
-- Fix: keep `_TABLE_SUFFIX` as `ds` inside quickplay_all; use it in the window filter
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplay_all AS (
  SELECT
    event_name,
    user_pseudo_id,
    event_timestamp,
    _TABLE_SUFFIX AS ds
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
),
initial AS (                        -- first quick-play inside the window
  SELECT
    event_name            AS quickplay_type,
    user_pseudo_id,
    MIN(event_timestamp)  AS first_ts
  FROM quickplay_all
  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
    AND ds BETWEEN '20180702' AND '20180716'
  GROUP BY quickplay_type, user_pseudo_id
),
retained AS (                       -- same quick-play ≥14 days later
  SELECT DISTINCT
    i.quickplay_type,
    i.user_pseudo_id
  FROM initial i
  JOIN quickplay_all q
    ON q.user_pseudo_id  = i.user_pseudo_id
   AND q.event_name      = i.quickplay_type
   AND q.event_timestamp >= i.first_ts + 1209600000000
)
SELECT
  i.quickplay_type,
  COUNT(DISTINCT i.user_pseudo_id) AS users_initial,
  COUNT(DISTINCT r.user_pseudo_id) AS users_retained,
  ROUND(COUNT(DISTINCT r.user_pseudo_id)
        / NULLIF(COUNT(DISTINCT i.user_pseudo_id),0),4) AS retention_rate
FROM initial i
LEFT JOIN retained r
       ON r.quickplay_type = i.quickplay_type
      AND r.user_pseudo_id = i.user_pseudo_id
GROUP BY i.quickplay_type
LIMIT 20
Answer:
quickplay_type,users_initial,users_retained,retention_rate
