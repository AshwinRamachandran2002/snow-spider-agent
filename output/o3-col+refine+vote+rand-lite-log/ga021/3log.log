--Description: 10) FINAL – concise 14-day retention per quickplay event type (no extra CTEs)
WITH base AS (                          -- first quick-play per user/type in window
  SELECT
    event_name           AS quickplay_type,
    user_pseudo_id,
    MIN(event_timestamp) AS first_ts,
    MIN(_TABLE_SUFFIX)   AS ds          -- any ds inside window; just to keep field count tidy
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (
          SELECT DISTINCT user_pseudo_id
          FROM `firebase-public-project.analytics_153293282.events_*`
          WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
            AND event_name = 'session_start')
  GROUP BY quickplay_type, user_pseudo_id
),
retained AS (                           -- same quick-play ≥14 days later
  SELECT DISTINCT
    b.quickplay_type,
    b.user_pseudo_id
  FROM base b
  JOIN `firebase-public-project.analytics_153293282.events_*` q
    ON q.event_name     = b.quickplay_type
   AND q.user_pseudo_id = b.user_pseudo_id
   AND q.event_timestamp >= b.first_ts + 1209600000000
)
SELECT
  quickplay_type,
  COUNT(DISTINCT user_pseudo_id)                                AS users_initial,
  COUNT(DISTINCT IF((quickplay_type, user_pseudo_id) IN
                    (SELECT quickplay_type, user_pseudo_id FROM retained),
                    user_pseudo_id, NULL))                      AS users_retained,
  ROUND(COUNT(DISTINCT IF((quickplay_type, user_pseudo_id) IN
                           (SELECT quickplay_type, user_pseudo_id FROM retained),
                           user_pseudo_id, NULL))
        / NULLIF(COUNT(DISTINCT user_pseudo_id),0),4)           AS retention_rate
FROM base
GROUP BY quickplay_type
LIMIT 20;
```
