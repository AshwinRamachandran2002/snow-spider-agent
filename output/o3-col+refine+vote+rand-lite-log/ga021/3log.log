Below is a progressive set of ( ≤ 10 ) BigQuery SQL statements that move from simple exploration to the final 14-day retention calculation.  
All of them use the public GA4 gaming dataset
`firebase-public-project.analytics_153293282.events_*`  
and every query is capped with `LIMIT 20`.

```sql
--Description: 1) Distinct event names that contain “quickplay” during 2–16 Jul 2018
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
--Description: 2) How many “quickplay” events occurred on 2018-07-02 (get a feel for volumes)
SELECT event_name, COUNT(*) AS cnt
FROM `firebase-public-project.analytics_153293282.events_20180702`
WHERE LOWER(event_name) LIKE '%quickplay%'
GROUP BY event_name
ORDER BY cnt DESC
LIMIT 20;
```

```sql
--Description: 3) Sample of users who initiated at least one session (session_start) in the target period
SELECT DISTINCT user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'session_start'
LIMIT 20;
```

```sql
--Description: 4) Example rows of quickplay events generated by those session users
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
)
SELECT event_name, user_pseudo_id, event_timestamp, _TABLE_SUFFIX AS event_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
LIMIT 20;
```

```sql
--Description: 5) First (initial) quickplay timestamp per user & quickplay-type in the period
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplay AS (
  SELECT event_name,
         user_pseudo_id,
         event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
)
SELECT event_name   AS quickplay_type,
       user_pseudo_id,
       MIN(event_timestamp) AS first_quickplay_ts
FROM quickplay
GROUP BY quickplay_type, user_pseudo_id
LIMIT 20;
```

```sql
--Description: 6) Users who repeated the SAME quickplay event ≥ 14 days after their first one
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplay_all AS (
  SELECT event_name,
         user_pseudo_id,
         event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
),
initial AS (
  SELECT event_name AS quickplay_type,
         user_pseudo_id,
         MIN(event_timestamp) AS first_ts
  FROM quickplay_all
  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  GROUP BY quickplay_type, user_pseudo_id
),
retained AS (
  SELECT i.quickplay_type,
         i.user_pseudo_id
  FROM initial i
  JOIN quickplay_all q
    ON q.user_pseudo_id = i.user_pseudo_id
   AND q.event_name    = i.quickplay_type
   AND q.event_timestamp >= i.first_ts + 1209600000000  -- 14 days in µs
)
SELECT DISTINCT *
FROM retained
LIMIT 20;
```

```sql
--Description: 7) Count base vs retained users (14-day) for each quickplay type
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplay_all AS (
  SELECT event_name,
         user_pseudo_id,
         event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
),
initial AS (
  SELECT event_name AS quickplay_type,
         user_pseudo_id,
         MIN(event_timestamp) AS first_ts
  FROM quickplay_all
  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  GROUP BY quickplay_type, user_pseudo_id
),
retained AS (
  SELECT i.quickplay_type,
         i.user_pseudo_id
  FROM initial i
  JOIN quickplay_all q
    ON q.user_pseudo_id = i.user_pseudo_id
   AND q.event_name    = i.quickplay_type
   AND q.event_timestamp >= i.first_ts + 1209600000000  -- 14 days
)
SELECT i.quickplay_type,
       COUNT(DISTINCT i.user_pseudo_id)                       AS users_initial,
       COUNT(DISTINCT r.user_pseudo_id)                       AS users_retained,
       ROUND(COUNT(DISTINCT r.user_pseudo_id)
/ NULLIF(COUNT(DISTINCT i.user_pseudo_id),0),4)              AS retention_rate
FROM initial i
LEFT JOIN retained r
  ON r.quickplay_type = i.quickplay_type
  AND r.user_pseudo_id = i.user_pseudo_id
GROUP BY i.quickplay_type
LIMIT 20;
