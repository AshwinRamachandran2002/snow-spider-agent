--Description: 9) Display the first-and-second quickplay timestamps for retained users
--              (helps validate the retention window logic).
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
quickplay_all AS (
  SELECT event_name,
         user_pseudo_id,
         event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE LOWER(event_name) LIKE '%quickplay%'
),
initial AS (
  SELECT event_name AS quickplay_type,
         user_pseudo_id,
         MIN(event_timestamp) AS first_ts
  FROM quickplay_all
  WHERE user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  GROUP BY quickplay_type, user_pseudo_id
)
SELECT i.quickplay_type,
       i.user_pseudo_id,
       i.first_ts,
       MIN(q.event_timestamp) AS second_ts
