```sql
-- 4.  Which users started at least one session in the requested period?
SELECT DISTINCT user_pseudo_id
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND event_name = 'session_start'
LIMIT 20;
```

```sql
-- 5.  For those session users, grab their FIRST quickplay event
--     between 2-Jul and 16-Jul (per user & event type).
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
)
SELECT
  user_pseudo_id,
  event_name                        AS quickplay_event,
  MIN(event_timestamp)              AS first_quickplay_ts
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
  AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
GROUP BY user_pseudo_id, quickplay_event
LIMIT 20;
```

```sql
-- 6.  How large are the cohorts (number of users) for every quickplay event type?
WITH first_quickplay AS (
  SELECT
    user_pseudo_id,
    event_name  AS quickplay_event,
    MIN(event_timestamp) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, quickplay_event
)
SELECT
  quickplay_event,
  COUNT(DISTINCT user_pseudo_id) AS cohort_users
FROM first_quickplay
GROUP BY quickplay_event
ORDER BY cohort_users DESC
LIMIT 20;
```

```sql
-- 7.  For one sample event (e.g. “level_complete_quickplay”)
--     show users who were seen exactly 14 days afterwards.
WITH first_quickplay AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'level_complete_quickplay'
  GROUP BY user_pseudo_id
)
SELECT
  fq.user_pseudo_id,
  TIMESTAMP_MICROS(fq.first_ts) AS first_time,
  TIMESTAMP_MICROS(ev.event_timestamp) AS time_14d_after
FROM first_quickplay  AS fq
JOIN `firebase-public-project.analytics_153293282.events_*` AS ev
ON  ev.user_pseudo_id = fq.user_pseudo_id
WHERE DATE(TIMESTAMP_MICROS(ev.event_timestamp)) 
      = DATE_ADD(DATE(TIMESTAMP_MICROS(fq.first_ts)), INTERVAL 14 DAY)
LIMIT 20;
```

```sql
-- 8.  Flag every user / quickplay-event pair as “retained” (1) or “not retained” (0)
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
first_quickplay AS (
  SELECT
    user_pseudo_id,
    event_name  AS quickplay_event,
    MIN(event_timestamp) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
  GROUP BY user_pseudo_id, quickplay_event
),
retained_users AS (
  SELECT DISTINCT
    fq.user_pseudo_id,
    fq.quickplay_event
  FROM first_quickplay fq
  JOIN `firebase-public-project.analytics_153293282.events_*` ev
  ON  ev.user_pseudo_id = fq.user_pseudo_id
  WHERE DATE(TIMESTAMP_MICROS(ev.event_timestamp))
        = DATE_ADD(DATE(TIMESTAMP_MICROS(fq.first_ts)), INTERVAL 14 DAY)
)
SELECT
  fq.quickplay_event,
  fq.user_pseudo_id,
  IF(ru.user_pseudo_id IS NULL, 0, 1) AS is_retained
FROM first_quickplay AS fq
LEFT JOIN retained_users AS ru
ON  fq.user_pseudo_id = ru.user_pseudo_id
AND fq.quickplay_event = ru.quickplay_event
LIMIT 20;
```

```sql
-- 9.  Aggregate retained / total users for each quickplay event type
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
first_quickplay AS (
  SELECT
    user_pseudo_id,
    event_name  AS quickplay_event,
    MIN(event_timestamp) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
  GROUP BY user_pseudo_id, quickplay_event
),
retained_users AS (
  SELECT DISTINCT
    fq.user_pseudo_id,
    fq.quickplay_event
  FROM first_quickplay fq
  JOIN `firebase-public-project.analytics_153293282.events_*` ev
  ON  ev.user_pseudo_id = fq.user_pseudo_id
  WHERE DATE(TIMESTAMP_MICROS(ev.event_timestamp))
        = DATE_ADD(DATE(TIMESTAMP_MICROS(fq.first_ts)), INTERVAL 14 DAY)
)
SELECT
  fq.quickplay_event,
  COUNT(DISTINCT fq.user_pseudo_id)          AS cohort_users,
  COUNT(DISTINCT ru.user_pseudo_id)          AS retained_users
FROM first_quickplay fq
LEFT JOIN retained_users ru
  ON fq.user_pseudo_id = ru.user_pseudo_id
  AND fq.quickplay_event = ru.quickplay_event
GROUP BY fq.quickplay_event
ORDER BY cohort_users DESC
LIMIT 20;
```

```sql
-- 10.  FINAL ANSWER – two-week retention rate, per quickplay event type.
WITH session_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
first_quickplay AS (
  SELECT
    user_pseudo_id,
    event_name  AS quickplay_event,
    MIN(event_timestamp) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
    AND user_pseudo_id IN (SELECT user_pseudo_id FROM session_users)
  GROUP BY user_pseudo_id, quickplay_event
),
retained_users AS (
  SELECT DISTINCT
    fq.user_pseudo_id,
    fq.quickplay_event
  FROM first_quickplay fq
  JOIN `firebase-public-project.analytics_153293282.events_*` ev
  ON  ev.user_pseudo_id = fq.user_pseudo_id
  WHERE DATE(TIMESTAMP_MICROS(ev.event_timestamp))
        = DATE_ADD(DATE(TIMESTAMP_MICROS(fq.first_ts)), INTERVAL 14 DAY)
)
SELECT
  fq.quickplay_event,
  COUNT(DISTINCT ru.user_pseudo_id)  AS retained_users,
  COUNT(DISTINCT fq.user_pseudo_id)  AS cohort_users,
  ROUND( COUNT(DISTINCT ru.user_pseudo_id)
/ COUNT(DISTINCT fq.user_pseudo_id), 4)   AS two_week_retention_rate
FROM first_quickplay fq
LEFT JOIN retained_users ru
  ON fq.user_pseudo_id = ru.user_pseudo_id
  AND fq.quickplay_event = ru.quickplay_event
GROUP BY fq.quickplay_event
ORDER BY two_week_retention_rate DESC
LIMIT 20;
```

