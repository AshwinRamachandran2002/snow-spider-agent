```sql
--Description: 1)  List every event whose name contains the substring “quickplay”
--               during the cohort-building window 2-Jul-2018 to 16-Jul-2018.  
SELECT DISTINCT
       event_name
FROM   `firebase-public-project.analytics_153293282.events_*`
WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'     -- tables to scan
  AND  LOWER(event_name) LIKE '%quickplay%'                -- only quickplay-type
LIMIT  20;
```

```sql
--Description: 2)  Look at a handful of rows for the discovered quick-play events
--               to verify the fields we will need later (event_date, user id, …).
SELECT
  event_date,
  event_timestamp,
  event_name,
  user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180704'
  AND LOWER(event_name) LIKE '%quickplay%'
LIMIT 20;
```

```sql
--Description: 3)  How many quick-play events of each type happened on each day
--               inside the cohort window?
SELECT
  event_date,
  event_name,
  COUNT(*) AS quickplay_events
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
GROUP BY event_date, event_name
ORDER BY event_date, event_name
LIMIT 20;
```

```sql
--Description: 4)  Build the “cohort” – the FIRST time each user triggered
--               each quick-play event between 2-Jul and 16-Jul (inclusive)
--               AND the user actually started a session in that span.
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date      -- first quick-play
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
),
session_users AS (                                             -- users w/ session
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
)
SELECT
  c.user_pseudo_id,
  c.event_name,
  c.cohort_date
FROM cohort c
JOIN session_users s
  ON c.user_pseudo_id = s.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 5)  For those cohort users, find ANY session they launched exactly
--               14 days after their individual cohort_date (“retained” users).
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
),
ret_sessions AS (
  SELECT DISTINCT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date)                AS session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'  -- need +14 days
    AND event_name = 'session_start'
)
SELECT
  c.user_pseudo_id,
  c.event_name,
  c.cohort_date,
  r.session_date
FROM cohort c
LEFT JOIN ret_sessions r
  ON  r.user_pseudo_id = c.user_pseudo_id
  AND r.session_date = DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
LIMIT 20;
```

```sql
--Description: 6)  Flag each cohort user as retained (1) or not retained (0). 
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
),
ret_sessions AS (
  SELECT DISTINCT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
    AND event_name = 'session_start'
)
SELECT
  c.event_name,
  c.user_pseudo_id,
  IF( r.user_pseudo_id IS NULL, 0, 1 ) AS is_retained
FROM cohort c
LEFT JOIN ret_sessions r
  ON  r.user_pseudo_id = c.user_pseudo_id
  AND r.session_date   = DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
LIMIT 20;
```

```sql
--Description: 7)  Count *cohort size* and *retained users* per quick-play type. 
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
),
ret_sessions AS (
  SELECT DISTINCT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
    AND event_name = 'session_start'
),
labeled AS (
  SELECT
    c.event_name,
    c.user_pseudo_id,
    IF( r.user_pseudo_id IS NULL, 0, 1 ) AS is_retained
  FROM cohort c
  LEFT JOIN ret_sessions r
    ON  r.user_pseudo_id = c.user_pseudo_id
    AND r.session_date   = DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
)
SELECT
  event_name,
  COUNT(*)                             AS cohort_users,
  SUM(is_retained)                     AS retained_users
FROM labeled
GROUP BY event_name
LIMIT 20;
```

```sql
--Description: 8)  FINAL ANSWER – 14-day retention rate for every
--               quick-play event type (only quick-play cohorts whose first
--               instance was between 2-Jul-2018 and 16-Jul-2018, and who had
--               at least one session_start in that window).
WITH cohort AS (
  SELECT
    user_pseudo_id,
    event_name,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS cohort_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id, event_name
),
session_filter AS (   -- keep only users who actually started a session 2-Jul–16-Jul
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
cohort_clean AS (
  SELECT c.*
  FROM cohort c
  JOIN session_filter s USING (user_pseudo_id)
),
ret_sessions AS (      -- any session exactly 14 days after cohort_date
  SELECT DISTINCT
    user_pseudo_id,
    PARSE_DATE('%Y%m%d', event_date) AS session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180730'
    AND event_name = 'session_start'
),
labeled AS (
  SELECT
    c.event_name,
    IF(r.user_pseudo_id IS NULL, 0, 1) AS is_retained
  FROM cohort_clean c
  LEFT JOIN ret_sessions r
    ON  r.user_pseudo_id = c.user_pseudo_id
    AND r.session_date   = DATE_ADD(c.cohort_date, INTERVAL 14 DAY)
)
SELECT
  event_name,
  COUNT(*)                             AS cohort_users,
  SUM(is_retained)                     AS retained_users,
  ROUND(SAFE_DIVIDE(SUM(is_retained), COUNT(*))*100, 2) AS retention_rate_pct
FROM labeled
GROUP BY event_name
ORDER BY retention_rate_pct DESC
LIMIT 20;
```

The last query returns, for each “quick-play” event type,  

• the size of the cohort (users whose very first quick-play of that type occurred between 2-Jul-2018 and 16-Jul-2018 and who opened at least one session that same period)  
• how many of those users came back exactly 14 days later (had another `session_start`)  
• the corresponding retention-rate (%) two weeks after their initial quick-play action.
