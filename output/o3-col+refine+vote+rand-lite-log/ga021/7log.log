--Description: 6) Verify which of those users fired the SAME quick-play event exactly 14 days later  
SELECT
  iq.event_name ,
  iq.user_pseudo_id ,
  iq.first_quickplay_date ,
  iq.target_14d_date ,
  r.event_date        AS retained_event_date
FROM (
    SELECT
      user_pseudo_id ,
      event_name ,
      MIN(event_date) AS first_event_date ,
      FORMAT_DATE('%Y%m%d',
        DATE_ADD(PARSE_DATE('%Y%m%d',MIN(event_date)),INTERVAL 14 DAY)) AS target_date_str
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
      AND LOWER(event_name) LIKE '%quickplay%'
    GROUP BY user_pseudo_id , event_name
) iq
LEFT JOIN `firebase-public-project.analytics_153293282.events_*`  r
ON  r.user_pseudo_id = iq.user_pseudo_id
AND r.event_name      = iq.event_name
AND r._TABLE_SUFFIX   = iq.target_date_str          --exact same calendar day (D+14)
LIMIT 20 ;
```

```sql
--Description: 7) Aggregate totals vs. 14-day returns (only users that had a session_start in the cohort window)  
SELECT
  iq.event_name ,
  COUNT(DISTINCT iq.user_pseudo_id)                                               AS total_users ,
  COUNT(DISTINCT CASE WHEN r.user_pseudo_id IS NOT NULL THEN iq.user_pseudo_id END) AS retained_users
FROM (
    --cohort: first quick-play between Jul-02…Jul-16 **and** at least one session_start in that window
    SELECT
      qp.user_pseudo_id ,
      qp.event_name ,
      MIN(qp.event_date) AS first_event_date ,
      FORMAT_DATE('%Y%m%d',
        DATE_ADD(PARSE_DATE('%Y%m%d',MIN(qp.event_date)),INTERVAL 14 DAY)) AS target_date_str
    FROM `firebase-public-project.analytics_153293282.events_*` qp
    WHERE qp._TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
      AND LOWER(qp.event_name) LIKE '%quickplay%'
      AND qp.user_pseudo_id IN (
            SELECT DISTINCT user_pseudo_id
            FROM `firebase-public-project.analytics_153293282.events_*`
            WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
              AND event_name = 'session_start'
          )
    GROUP BY qp.user_pseudo_id , qp.event_name
) iq
LEFT JOIN `firebase-public-project.analytics_153293282.events_*` r
ON  r.user_pseudo_id = iq.user_pseudo_id
AND r.event_name      = iq.event_name
AND r._TABLE_SUFFIX   = iq.target_date_str
GROUP BY iq.event_name
LIMIT 20 ;
```

