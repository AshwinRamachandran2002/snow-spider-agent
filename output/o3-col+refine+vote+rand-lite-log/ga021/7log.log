--Description: 3) Inspect a few Quick-Play events and some parameters (level value & board)  
SELECT
  event_date ,
  user_pseudo_id ,
  event_name ,
  (SELECT ep.value.int_value   FROM UNNEST(event_params) AS ep WHERE ep.key = 'value')  AS level_value ,
  (SELECT ep.value.string_value FROM UNNEST(event_params) AS ep WHERE ep.key = 'board') AS board_letter
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
  AND LOWER(event_name) LIKE '%quickplay%'
LIMIT 20 ;
