--Description: 5) Show the same records but also calculate the exact “+14-day” date we will look at  
SELECT
  user_pseudo_id ,
  event_name ,
  first_quickplay_date ,
  DATE_ADD(first_quickplay_date,INTERVAL 14 DAY) AS target_14d_date
FROM (
  SELECT
    user_pseudo_id ,
    event_name ,
    MIN(PARSE_DATE('%Y%m%d',event_date)) AS first_quickplay_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(event_name) LIKE '%quickplay%'
  GROUP BY user_pseudo_id , event_name
)
LIMIT 20 ;
Answer:
user_pseudo_id,event_name,first_quickplay_date,target_14d_date
