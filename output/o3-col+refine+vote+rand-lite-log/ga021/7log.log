```sql
--Description / Thinking Process in one query:
-- 1.  Start with all users that triggered a session_start between 2-Jul-2018 and 16-Jul-2018 (cohort_users).
-- 2.  For those users, find their very FIRST occurrence of each quick-play event type in the same window,
--     then compute the calendar day exactly 14 days later (first_quickplay CTE).
-- 3.  Join the raw tables again to see whether that SAME quick-play event occurred for the user
--     on the +14-day calendar date (retention CTE).
-- 4.  Aggregate per quick-play event name: total cohort users, retained users, and 14-day retention-rate.
WITH cohort_users AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND event_name = 'session_start'
),
first_quickplay AS (
  SELECT
    qp.user_pseudo_id,
    qp.event_name,
    MIN(qp.event_date)                                                   AS first_event_date,
    FORMAT_DATE('%Y%m%d',
      DATE_ADD(PARSE_DATE('%Y%m%d', MIN(qp.event_date)), INTERVAL 14 DAY)) AS target_date_str
  FROM `firebase-public-project.analytics_153293282.events_*` qp
  WHERE qp._TABLE_SUFFIX BETWEEN '20180702' AND '20180716'
    AND LOWER(qp.event_name) LIKE '%quickplay%'
    AND qp.user_pseudo_id IN (SELECT user_pseudo_id FROM cohort_users)
  GROUP BY qp.user_pseudo_id, qp.event_name
),
retention AS (
  SELECT
    fq.user_pseudo_id,
    fq.event_name
  FROM first_quickplay fq
  JOIN `firebase-public-project.analytics_153293282.events_*` r
    ON r.user_pseudo_id = fq.user_pseudo_id
   AND r.event_name     = fq.event_name
   AND r._TABLE_SUFFIX  = fq.target_date_str          -- fires on exact D+14
)
SELECT
  fq.event_name,
  COUNT(DISTINCT fq.user_pseudo_id)                                AS total_users,
  COUNT(DISTINCT r.user_pseudo_id)                                 AS retained_users,
  ROUND(SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
                    COUNT(DISTINCT fq.user_pseudo_id))*100, 2)     AS retention_rate_14d_pct
FROM first_quickplay fq
LEFT JOIN retention r
  ON r.user_pseudo_id = fq.user_pseudo_id
 AND r.event_name     = fq.event_name
GROUP BY fq.event_name
ORDER BY fq.event_name;
```
