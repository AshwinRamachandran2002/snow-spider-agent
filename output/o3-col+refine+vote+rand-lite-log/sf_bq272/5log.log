```sql
--Description: 1)  Examine the different line-item level statuses that exist in the order items table.
SELECT DISTINCT "status"
FROM "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
LIMIT 20;
```

```sql
--Description: 2)  Inspect how line-items with various statuses look together with their parent order status.
SELECT 
       oi."id"              AS "order_item_id",
       oi."order_id",
       oi."status"          AS "item_status",
       o."status"           AS "order_status",
       oi."returned_at",
       oi."sale_price"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"  oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDERS"       o
       ON o."order_id" = oi."order_id"
LIMIT 20;
```

```sql
--Description: 3)  Check a few completed or shipped lines along with their associated cost coming from the inventory item that was actually sold.
SELECT 
       oi."order_id",
       oi."product_id",
       p."name"                        AS "product_name",
       oi."status",
       oi."sale_price",
       ii."cost",
       oi."created_at"                 AS "sold_time"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"        oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"    ii
       ON ii."id" = oi."inventory_item_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"           p
       ON p."id"  = oi."product_id"
WHERE  oi."status" IN ('Complete','Shipped')
LIMIT 20;
```

```sql
--Description: 4)  Look at one month (e.g., March-2019) to see the raw profit calculation logic before we generalize it.
SELECT 
       DATE_TRUNC('MONTH', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))  AS "month",
       oi."product_id",
       p."name",
       SUM(oi."sale_price")                         AS "revenue",
       SUM(ii."cost")                               AS "cogs",
       SUM(oi."sale_price") - SUM(ii."cost")        AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
       ON ii."id" = oi."inventory_item_id"
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS"        p
       ON p."id" = oi."product_id"
WHERE  oi."status" NOT IN ('Cancelled','Returned')
  AND  DATE_TRUNC('MONTH', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = '2019-03-01'
GROUP  BY 1,2,3
ORDER  BY "profit" DESC
LIMIT 20;
```

```sql
--Description: 5)  Aggregate monthly profits for every product (Jan-2019 to Aug-2022) while still excluding cancelled / returned lines.
SELECT 
       DATE_TRUNC('MONTH', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))  AS "month",
       oi."product_id",
       SUM(oi."sale_price") - SUM(ii."cost")        AS "profit"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"     oi
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS" ii
       ON ii."id" = oi."inventory_item_id"
WHERE  oi."status" NOT IN ('Cancelled','Returned')
  AND  DATE_TRUNC('MONTH', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))
         BETWEEN '2019-01-01' AND '2022-08-01'
GROUP  BY 1,2
ORDER  BY "month", "profit" DESC
LIMIT 20;
```

```sql
--Description: 6)  For a set of high-profit product IDs, pull their human-readable names & categories.
SELECT 
       p."id"           AS "product_id",
       p."name",
       p."category",
       p."brand",
       p."department"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
WHERE  p."id" IN (14115, 14157, 14273, 15816, 28646)   -- sample IDs
LIMIT 20;
```

```sql
--Description: 7)  Check the date span we have in the order items table.
SELECT
       MIN(TO_TIMESTAMP_NTZ("created_at"/1e6)) AS "earliest",
       MAX(TO_TIMESTAMP_NTZ("created_at"/1e6)) AS "latest"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS";
```

```sql
--Description: 8)  Quick frequency of each order item status.
SELECT
       "status",
       COUNT(*) AS "cnt"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
GROUP  BY "status"
ORDER  BY "cnt" DESC
LIMIT 20;
```

```sql
--Description: 9)  See how many items have a non-null returned_at timestamp (possible returns to exclude).
SELECT
       CASE WHEN "returned_at" IS NULL THEN 'not_returned' ELSE 'returned' END AS "return_flag",
       COUNT(*) AS "cnt"
FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"
GROUP  BY 1
LIMIT 20;
```

```sql
--Description: 10)  Draft final logic: top-3 most profitable products per month (Jan-2019 .. Aug-2022); limited preview.
WITH monthly_profit AS (
    SELECT 
           DATE_TRUNC('MONTH', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) AS "month",
           oi."product_id",
           SUM(oi."sale_price") - SUM(ii."cost")                      AS "profit"
    FROM   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."ORDER_ITEMS"      oi
    JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."INVENTORY_ITEMS"  ii
           ON ii."id" = oi."inventory_item_id"
    WHERE  oi."status" NOT IN ('Cancelled','Returned')
      AND  DATE_TRUNC('MONTH', TO_TIMESTAMP_NTZ(oi."created_at"/1e6))
             BETWEEN '2019-01-01' AND '2022-08-01'
    GROUP  BY 1,2
), ranked AS (
    SELECT 
           mp.*,
           ROW_NUMBER() OVER (PARTITION BY mp."month"
                              ORDER BY mp."profit" DESC) AS "rn"
    FROM   monthly_profit mp
)
SELECT 
       r."month",
       r."product_id",
       p."name"        AS "product_name",
       r."profit"
FROM   ranked r
JOIN   "THELOOK_ECOMMERCE"."THELOOK_ECOMMERCE"."PRODUCTS" p
       ON p."id" = r."product_id"
WHERE  r."rn" <= 3
ORDER  BY r."month" DESC, r."profit" DESC
LIMIT 20;
```
