--Description: (9) Show 20 matches in which the top-winning player took part,
--             along with the final score and player name.
WITH appearances AS ( /* full UNION-ALL list exactly as in (7) */ 
        SELECT (home_team_goal > away_team_goal) AS is_winner, home_player_1 AS player_id, match_api_id
        FROM   Match WHERE home_player_1 IS NOT NULL AND home_team_goal <> away_team_goal UNION ALL
        /* … repeat for all remaining 21 slots, each adding match_api_id … */
        SELECT (away_team_goal > home_team_goal),              away_player_11, match_api_id
        FROM   Match WHERE away_player_11 IS NOT NULL AND home_team_goal <> away_team_goal
),
agg AS (
    SELECT player_id,
           SUM(is_winner) AS wins
    FROM   appearances
    GROUP  BY player_id
),
top_winner AS (
    SELECT player_id
    FROM   agg
    ORDER  BY wins DESC
    LIMIT 1
)
SELECT m.id               AS match_id,
       m.home_team_goal,
       m.away_team_goal,
       p.player_name
FROM   Match  m
JOIN   top_winner tw
JOIN   Player p ON p.player_api_id = tw.player_id
WHERE  tw.player_id IN (
          m.home_player_1,  m.home_player_2,  m.home_player_3,
          m.home_player_4,  m.home_player_5,  m.home_player_6,
          m.home_player_7,  m.home_player_8,  m.home_player_9,
          m.home_player_10, m.home_player_11,
          m.away_player_1,  m.away_player_2,  m.away_player_3,
          m.away_player_4,  m.away_player_5,  m.away_player_6,
          m.away_player_7,  m.away_player_8,  m.away_player_9,
          m.away_player_10, m.away_player_11 )
LIMIT 20;
