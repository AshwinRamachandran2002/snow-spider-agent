Query:
-- 3) Build one long list of every (match, player) appearance with a flag
--    that tells whether the player’s side won (1) or lost (0). 
--    (Draws are ignored.)  Only keep non-NULL player slots.
SELECT CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 1 ELSE 0 END AS "is_winner",
       m."home_player_1" AS "player_api_id"
FROM   "Match" AS m
WHERE  m."home_player_1" IS NOT NULL
  AND  m."home_team_goal" <> m."away_team_goal"

UNION ALL
SELECT CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 1 ELSE 0 END,
       m."away_player_1"
FROM   "Match" AS m
WHERE  m."away_player_1" IS NOT NULL
  AND  m."home_team_goal" <> m."away_team_goal"

UNION ALL
SELECT CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 1 ELSE 0 END,
       m."home_player_2"
FROM   "Match" AS m
WHERE  m."home_player_2" IS NOT NULL
  AND  m."home_team_goal" <> m."away_team_goal"

UNION ALL
SELECT CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 1 ELSE 0 END,
       m."away_player_2"
FROM   "Match" AS m
WHERE  m."away_player_2" IS NOT NULL
  AND  m."home_team_goal" <> m."away_team_goal"

UNION ALL
SELECT CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 1 ELSE 0 END,
       m."home_player_3"
FROM   "Match" AS m
WHERE  m."home_player_3" IS NOT NULL
  AND  m."home_team_goal" <> m."away_team_goal"

UNION ALL
SELECT CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 1 ELSE 0 END,
       m."away_player_3"
FROM   "Match" AS m
WHERE  m."away_player_3" IS NOT NULL
  AND  m."home_team_goal" <> m."away_team_goal"

--   …repeat the same UNION pattern for home_player_4 … home_player_11
--   and away_player_4 … away_player_11 (not shown here to keep query short)
LIMIT 20;
