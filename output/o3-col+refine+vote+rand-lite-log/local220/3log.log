```sql
--Description: (9) Show up to 20 matches in which the player that has the most
--             wins participated, along with the final score.
WITH appearances AS ( /* identical UNION-ALL construction as above */ … ),
agg AS ( SELECT player_api_id, SUM(is_winner) AS wins
         FROM appearances GROUP BY player_api_id ),
top_winner AS ( SELECT player_api_id FROM agg ORDER BY wins DESC LIMIT 1 )
SELECT m.match_api_id,
       m.home_team_goal, m.away_team_goal,
       p.player_name
