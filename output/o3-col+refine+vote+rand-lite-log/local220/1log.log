```sql
-- Description: Take a first look at some Match rows – show goals and the first three
-- player–id slots on each side so we are sure the columns really contain the
-- participating players that we will need for the analysis.
SELECT DISTINCT "home_team_goal",
                "away_team_goal",
                "home_player_1",
                "home_player_2",
                "home_player_3",
                "away_player_1",
                "away_player_2",
                "away_player_3"
FROM "Match"
LIMIT 20;
```

```sql
-- Description: See a sample of the (non-null) player_api_id values that appear in the
-- very first home–player column.
SELECT DISTINCT "home_player_1"          AS "player_api_id"
FROM           "Match"
