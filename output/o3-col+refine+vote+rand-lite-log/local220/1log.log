Query:
-- Description: Retrieve 20 different players who were on the winning side of a
-- match (home wins from the 11 home-player columns UNIONED with away wins from the
-- 11 away-player columns).  This shows how we will gather winners later on.
SELECT DISTINCT winner_id AS "player_api_id"
FROM (
          /* home-side winners */
          SELECT "home_player_1" AS winner_id FROM "Match"
          WHERE "home_team_goal" > "away_team_goal" AND "home_player_1" IS NOT NULL
          UNION
          SELECT "home_player_2" FROM "Match"
          WHERE "home_team_goal" > "away_team_goal" AND "home_player_2" IS NOT NULL
          UNION
          SELECT "home_player_3" FROM "Match"
          WHERE "home_team_goal" > "away_team_goal" AND "home_player_3" IS NOT NULL
          /* … repeat UNIONs for home_player_4 … home_player_11 … */

          UNION
          /* away-side winners */
          SELECT "away_player_1" FROM "Match"
          WHERE "away_team_goal" > "home_team_goal" AND "away_player_1" IS NOT NULL
          UNION
          SELECT "away_player_2" FROM "Match"
          WHERE "away_team_goal" > "home_team_goal" AND "away_player_2" IS NOT NULL
          UNION
          SELECT "away_player_3" FROM "Match"
          WHERE "away_team_goal" > "home_team_goal" AND "away_player_3" IS NOT NULL
          /* … repeat UNIONs for away_player_4 … away_player_11 … */
     )
LIMIT 20;
