Query:
-- Description: Show a few matches that had a clear winner (no draw) and label which
-- side won.  This verifies the condition we will later use to separate wins and
-- losses.
SELECT DISTINCT "id"                                              AS "match_id",
                CASE
                     WHEN "home_team_goal" > "away_team_goal" THEN 'home'
                     ELSE                                            'away'
                END                                                 AS "winning_side",
                "home_team_goal",
                "away_team_goal"
FROM           "Match"
WHERE          "home_team_goal" <> "away_team_goal"
LIMIT 20;
