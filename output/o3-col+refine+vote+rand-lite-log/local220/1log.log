--Description:
-- We want one definitive answer: the player who appeared in the most WINS and the
-- player who appeared in the most LOSSES.  The idea is:
--   1.  “Un-pivot” every one of the 22 player columns of Match into a tall list,
--       tagging each occurrence as a ‘win’ or a ‘loss’ according to the final score
--       (draws are ignored per the task).
--   2.  Count wins and losses per player.
--   3.  Pick the top-1 from each list.
--   4.  Join to Player to show the actual names.
WITH
/* ---------------------------------------------------------------------------
   Step-1: make a tall table (player_api_id , result) for every non-null player
--------------------------------------------------------------------------- */
player_results AS (
    /* home side rows */
    SELECT home_player_1 AS pid,
           CASE WHEN home_team_goal > away_team_goal THEN 'win'
                WHEN home_team_goal < away_team_goal THEN 'loss' END AS result
    FROM Match WHERE home_player_1 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_2, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_2 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_3, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_3 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_4, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_4 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_5, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_5 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_6, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_6 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_7, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_7 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_8, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_8 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_9, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_9 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_10, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_10 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT home_player_11, CASE WHEN home_team_goal > away_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE home_player_11 IS NOT NULL AND home_team_goal <> away_team_goal
    /* away side rows */
    UNION ALL SELECT away_player_1, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_1 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_2, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_2 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_3, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_3 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_4, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_4 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_5, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_5 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_6, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_6 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_7, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_7 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_8, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_8 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_9, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_9 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_10, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_10 IS NOT NULL AND home_team_goal <> away_team_goal
    UNION ALL SELECT away_player_11, CASE WHEN away_team_goal > home_team_goal THEN 'win' ELSE 'loss' END
    FROM Match WHERE away_player_11 IS NOT NULL AND home_team_goal <> away_team_goal
),
/* ---------------------------------------------------------------------------
   Step-2: count wins and losses for every player
--------------------------------------------------------------------------- */
agg AS (
    SELECT pid AS player_api_id,
           SUM(result='win')  AS wins,
           SUM(result='loss') AS losses
    FROM   player_results
    GROUP  BY pid
),
/* ---------------------------------------------------------------------------
   Step-3: isolate the top winner and top loser
--------------------------------------------------------------------------- */
top_win AS (
    SELECT player_api_id, wins AS matches
    FROM   agg
    ORDER  BY wins DESC
    LIMIT  1
),
top_loss AS (
    SELECT player_api_id, losses AS matches
    FROM   agg
    ORDER  BY losses DESC
    LIMIT  1
)
/* ---------------------------------------------------------------------------
   Step-4: present names + counts
--------------------------------------------------------------------------- */
SELECT 'highest_wins'  AS category,
       p.player_name,
       t.matches
FROM   top_win t
JOIN   Player  p ON p.player_api_id = t.player_api_id
UNION ALL
SELECT 'highest_losses',
       p.player_name,
       t.matches
FROM   top_loss t
JOIN   Player    p ON p.player_api_id = t.player_api_id;
```
