LIMIT 20;
```

```sql
-- Description: Collect a sample of the (non-null) player_api_id values that appear in
-- the very first away–player column to confirm both sides use the same id space.
SELECT DISTINCT "away_player_1"          AS "player_api_id"
FROM           "Match"
WHERE          "away_player_1" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Show a few matches that had a clear winner (no draw) and label which
-- side won.  This verifies the condition we will later use to separate wins and
-- losses.
SELECT DISTINCT "id"                                              AS "match_id",
                CASE
                     WHEN "home_team_goal" > "away_team_goal" THEN 'home'
                     ELSE                                            'away'
                END                                                 AS "winning_side",
                "home_team_goal",
                "away_team_goal"
FROM           "Match"
WHERE          "home_team_goal" <> "away_team_goal"
LIMIT 20;
```

```sql
-- Description: Retrieve 20 different players who were on the winning side of a
-- match (home wins from the 11 home-player columns UNIONED with away wins from the
-- 11 away-player columns).  This shows how we will gather winners later on.
SELECT DISTINCT winner_id AS "player_api_id"
FROM (
          /* home-side winners */
          SELECT "home_player_1" AS winner_id FROM "Match"
          WHERE "home_team_goal" > "away_team_goal" AND "home_player_1" IS NOT NULL
          UNION
          SELECT "home_player_2" FROM "Match"
          WHERE "home_team_goal" > "away_team_goal" AND "home_player_2" IS NOT NULL
          UNION
          SELECT "home_player_3" FROM "Match"
          WHERE "home_team_goal" > "away_team_goal" AND "home_player_3" IS NOT NULL
          /* … repeat UNIONs for home_player_4 … home_player_11 … */

          UNION
          /* away-side winners */
          SELECT "away_player_1" FROM "Match"
          WHERE "away_team_goal" > "home_team_goal" AND "away_player_1" IS NOT NULL
          UNION
          SELECT "away_player_2" FROM "Match"
          WHERE "away_team_goal" > "home_team_goal" AND "away_player_2" IS NOT NULL
          UNION
          SELECT "away_player_3" FROM "Match"
          WHERE "away_team_goal" > "home_team_goal" AND "away_player_3" IS NOT NULL
          /* … repeat UNIONs for away_player_4 … away_player_11 … */
     )
LIMIT 20;
```

```sql
-- Description: Get the top-20 players who have participated in the greatest number
-- of winning matches (aggregating over every field that can hold a player id).
SELECT     p."player_name",
           w."player_api_id",
           COUNT(*)                   AS "winning_matches"
FROM      (
              /* one long UNION-ALL list of every winning player occurrence */
              SELECT "home_player_1" AS player_api_id FROM "Match"
              WHERE "home_team_goal" > "away_team_goal" AND "home_player_1" IS NOT NULL
              UNION ALL
              SELECT "home_player_2" FROM "Match"
              WHERE "home_team_goal" > "away_team_goal" AND "home_player_2" IS NOT NULL
              /* … UNION ALL for every other home_player_* column … */
              UNION ALL
              SELECT "away_player_1" FROM "Match"
              WHERE "away_team_goal" > "home_team_goal" AND "away_player_1" IS NOT NULL
              UNION ALL
              SELECT "away_player_2" FROM "Match"
              WHERE "away_team_goal" > "home_team_goal" AND "away_player_2" IS NOT NULL
              /* … UNION ALL for every other away_player_* column … */
          ) AS w
JOIN       "Player"  AS p ON p."player_api_id" = w."player_api_id"
GROUP BY   w."player_api_id"
ORDER BY   "winning_matches" DESC
LIMIT 20;
```

```sql
-- Description: Get the top-20 players who have participated in the greatest number
-- of losing matches (mirrors the previous query but flips the > sign so we collect
-- players on the losing side).
SELECT     p."player_name",
           l."player_api_id",
           COUNT(*)                   AS "losing_matches"
FROM      (
              /* one long UNION-ALL list of every losing player occurrence */
              SELECT "home_player_1" AS player_api_id FROM "Match"
              WHERE "home_team_goal" < "away_team_goal" AND "home_player_1" IS NOT NULL
              UNION ALL
              SELECT "home_player_2" FROM "Match"
              WHERE "home_team_goal" < "away_team_goal" AND "home_player_2" IS NOT NULL
              /* … UNION ALL for every other home_player_* column … */
              UNION ALL
              SELECT "away_player_1" FROM "Match"
              WHERE "away_team_goal" < "home_team_goal" AND "away_player_1" IS NOT NULL
              UNION ALL
              SELECT "away_player_2" FROM "Match"
              WHERE "away_team_goal" < "home_team_goal" AND "away_player_2" IS NOT NULL
              /* … UNION ALL for every other away_player_* column … */
          ) AS l
JOIN       "Player"  AS p ON p."player_api_id" = l."player_api_id"
GROUP BY   l."player_api_id"
ORDER BY   "losing_matches" DESC
LIMIT 20;
```

```sql
-- Description: Cross-check one particular high-win/high-loss player (replace
-- :some_id with the player_api_id you want to inspect) to see all matches in which
-- he played, together with the result, so we can manually verify the counts.
SELECT DISTINCT "id"                           AS "match_id",
                "date",
                "home_team_goal",
                "away_team_goal",
                CASE
                     WHEN "home_player_1" = :some_id OR "home_player_2" = :some_id
                       /* … OR through home_player_11 … */          THEN 'home'
                     ELSE                                            'away'
                END                                                 AS "player_side",
                CASE
                     WHEN "home_team_goal" > "away_team_goal" THEN 'home'
                     WHEN "away_team_goal" > "home_team_goal" THEN 'away'
                     ELSE                                            'draw'
                END                                                 AS "who_won"
FROM           "Match"
WHERE          :some_id IN ("home_player_1", "home_player_2", "home_player_3",
                            /* … list every home_player_* and away_player_* column … */
                            "away_player_11")
LIMIT 20;
```

```sql
-- Description: Finally, return just the single player who has the MOST wins and
-- the single player who has the MOST losses (two small result sets that answer the
-- original question directly).
/* MOST WINS */
SELECT     p."player_name",
           w."player_api_id",
           COUNT(*) AS "winning_matches"
FROM      (
              /* same UNION-ALL list as in the big wins query above */
          ) AS w
JOIN       "Player" AS p ON p."player_api_id" = w."player_api_id"
GROUP BY   w."player_api_id"
ORDER BY   "winning_matches" DESC
LIMIT 1;

/* MOST LOSSES */
SELECT     p."player_name",
           l."player_api_id",
           COUNT(*) AS "losing_matches"
FROM      (
              /* same UNION-ALL list as in the big losses query above */
          ) AS l
JOIN       "Player" AS p ON p."player_api_id" = l."player_api_id"
GROUP BY   l."player_api_id"
ORDER BY   "losing_matches" DESC
LIMIT 1;
```

