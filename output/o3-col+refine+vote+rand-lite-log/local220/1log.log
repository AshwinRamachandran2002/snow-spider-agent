-- Description: Get the top-20 players who have participated in the greatest number
-- of winning matches (aggregating over every field that can hold a player id).
SELECT     p."player_name",
           w."player_api_id",
           COUNT(*)                   AS "winning_matches"
FROM      (
              /* one long UNION-ALL list of every winning player occurrence */
              SELECT "home_player_1" AS player_api_id FROM "Match"
              WHERE "home_team_goal" > "away_team_goal" AND "home_player_1" IS NOT NULL
              UNION ALL
              SELECT "home_player_2" FROM "Match"
              WHERE "home_team_goal" > "away_team_goal" AND "home_player_2" IS NOT NULL
              /* … UNION ALL for every other home_player_* column … */
              UNION ALL
              SELECT "away_player_1" FROM "Match"
              WHERE "away_team_goal" > "home_team_goal" AND "away_player_1" IS NOT NULL
              UNION ALL
              SELECT "away_player_2" FROM "Match"
              WHERE "away_team_goal" > "home_team_goal" AND "away_player_2" IS NOT NULL
              /* … UNION ALL for every other away_player_* column … */
          ) AS w
JOIN       "Player"  AS p ON p."player_api_id" = w."player_api_id"
GROUP BY   w."player_api_id"
ORDER BY   "winning_matches" DESC
LIMIT 20;
