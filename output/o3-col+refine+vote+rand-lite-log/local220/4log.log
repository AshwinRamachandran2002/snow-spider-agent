        SELECT away_player_10 FROM "Match" WHERE away_team_goal < home_team_goal AND away_player_10 IS NOT NULL UNION ALL
        SELECT away_player_11 FROM "Match" WHERE away_team_goal < home_team_goal AND away_player_11 IS NOT NULL
    )
    GROUP BY player_api_id
),

/* ----------  best (max) rows ---------- */
max_win AS (
    SELECT player_api_id, win_count
    FROM win_player_counts
    ORDER BY win_count DESC
    LIMIT 1
),
max_loss AS (
    SELECT player_api_id, loss_count
    FROM loss_player_counts
    ORDER BY loss_count DESC
    LIMIT 1
)

/* ----------  final answer ---------- */
SELECT 'most_wins'  AS record_type,
       p.player_name,
       mw.win_count  AS match_count
FROM max_win mw
JOIN "Player" AS p ON p.player_api_id = mw.player_api_id

UNION ALL

