--Description: Re-run the comprehensive aggregation to return just the single
--player with most wins and the single player with most losses, all within one
--statement (no VALUES(...) used).  Produces two rows: “Most Wins” and “Most Losses”.
WITH player_match_result AS (
    -- (Complete 22-column UNION ALL block identical to the earlier queries)
    SELECT m."home_player_1" AS player_api_id,
           CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                ELSE 'draw' END AS result
    FROM "Match" m WHERE m."home_player_1" IS NOT NULL
    UNION ALL SELECT m."home_player_2", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_2" IS NOT NULL
    -- …… repeat for remaining 20 columns ……
    UNION ALL SELECT m."away_player_11",CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_11" IS NOT NULL
),
agg AS (
    SELECT player_api_id,
           SUM(result='win')  AS wins,
           SUM(result='loss') AS losses
    FROM   player_match_result
    WHERE  result <> 'draw'
    GROUP  BY player_api_id
),
top_win  AS (SELECT player_api_id, wins   FROM agg ORDER BY wins   DESC LIMIT 1),
top_loss AS (SELECT player_api_id, losses FROM agg ORDER BY losses DESC LIMIT 1)
SELECT 'Most Wins'  AS category,
       p."player_name",
       tw.wins        AS matches
FROM   top_win tw
JOIN   "Player" p ON p."player_api_id" = tw."player_api_id"
UNION ALL
SELECT 'Most Losses',
       p."player_name",
       tl.losses
FROM   top_loss tl
JOIN   "Player" p ON p."player_api_id" = tl."player_api_id"
