    FROM   "Match" AS m WHERE m."away_player_11" IS NOT NULL
),
wins AS (
    SELECT player_api_id,
           COUNT(*) AS win_cnt
    FROM   player_match_result
    WHERE  result = 'win'
    GROUP  BY player_api_id
),
losses AS (
    SELECT player_api_id,
           COUNT(*) AS loss_cnt
    FROM   player_match_result
    WHERE  result = 'loss'
    GROUP  BY player_api_id
),
top_win AS (
    SELECT player_api_id,
           win_cnt
    FROM   wins
    ORDER  BY win_cnt DESC
    LIMIT  1
),
top_loss AS (
    SELECT player_api_id,
           loss_cnt
    FROM   losses
    ORDER  BY loss_cnt DESC
    LIMIT  1
)
SELECT 'Most Winning Player' AS category,
       p."player_name",
       tw."win_cnt"          AS matches
FROM   top_win  AS tw
JOIN   "Player" AS p ON p."player_api_id" = tw."player_api_id"

UNION ALL

SELECT 'Most Losing  Player',
       p2."player_name",
       tl."loss_cnt"
FROM   top_loss AS tl
JOIN   "Player" AS p2 ON p2."player_api_id" = tl."player_api_id";
```

