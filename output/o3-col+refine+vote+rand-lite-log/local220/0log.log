    UNION ALL
    SELECT m."home_player_2", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                   WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                   ELSE 'draw' END
