Query:
--Description: Produce win / loss counts for every player who ever appeared
--(all 22 player columns are unioned).  Draws are ignored, and the result lists
--the top 20 players by number of wins.
WITH player_match_result AS (
    -- 11 home spots
    SELECT m."home_player_1" AS player_api_id,
           CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                ELSE 'draw' END AS result
    FROM "Match" m WHERE m."home_player_1" IS NOT NULL
    UNION ALL SELECT m."home_player_2", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_2" IS NOT NULL
    UNION ALL SELECT m."home_player_3", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_3" IS NOT NULL
    UNION ALL SELECT m."home_player_4", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_4" IS NOT NULL
    UNION ALL SELECT m."home_player_5", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_5" IS NOT NULL
    UNION ALL SELECT m."home_player_6", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_6" IS NOT NULL
    UNION ALL SELECT m."home_player_7", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_7" IS NOT NULL
    UNION ALL SELECT m."home_player_8", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_8" IS NOT NULL
    UNION ALL SELECT m."home_player_9", CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_9" IS NOT NULL
    UNION ALL SELECT m."home_player_10",CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_10" IS NOT NULL
    UNION ALL SELECT m."home_player_11",CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                                             WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."home_player_11" IS NOT NULL
    -- 11 away spots
    UNION ALL SELECT m."away_player_1", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_1" IS NOT NULL
    UNION ALL SELECT m."away_player_2", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_2" IS NOT NULL
    UNION ALL SELECT m."away_player_3", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_3" IS NOT NULL
    UNION ALL SELECT m."away_player_4", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_4" IS NOT NULL
    UNION ALL SELECT m."away_player_5", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_5" IS NOT NULL
    UNION ALL SELECT m."away_player_6", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_6" IS NOT NULL
    UNION ALL SELECT m."away_player_7", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_7" IS NOT NULL
    UNION ALL SELECT m."away_player_8", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_8" IS NOT NULL
    UNION ALL SELECT m."away_player_9", CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_9" IS NOT NULL
    UNION ALL SELECT m."away_player_10",CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_10" IS NOT NULL
    UNION ALL SELECT m."away_player_11",CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
                                             WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
                                             ELSE 'draw' END
              FROM "Match" m WHERE m."away_player_11" IS NOT NULL
)
SELECT p."player_name",
       COUNT(*) AS wins
FROM   player_match_result pmr
JOIN   "Player"            p
  ON   p."player_api_id" = pmr."player_api_id"
WHERE  pmr.result = 'win'
GROUP  BY p."player_name"
ORDER  BY wins DESC
LIMIT 20
