```sql
-- 1. Quick look at goals and a couple of player columns
SELECT "id",
       "home_team_goal",
       "away_team_goal",
       "home_player_1",
       "away_player_1"
FROM   "Match"
WHERE  "home_player_1" IS NOT NULL
  AND  "away_player_1" IS NOT NULL
LIMIT  20;
```

```sql
-- 2. Distinct (non-null) player id’s that ever appear in the first home slot
SELECT DISTINCT "home_player_1" AS "player_api_id"
FROM   "Match"
WHERE  "home_player_1" IS NOT NULL
LIMIT  20;
```

```sql
-- 3. Same idea for one of the away slots
SELECT DISTINCT "away_player_7" AS "player_api_id"
FROM   "Match"
WHERE  "away_player_7" IS NOT NULL
LIMIT  20;
```

```sql
-- 4. Join a few player id’s with names to be sure they match
SELECT p."player_api_id",
       p."player_name"
FROM   "Player" AS p
WHERE  p."player_api_id" IN
       (SELECT "home_player_1"
        FROM   "Match"
        WHERE  "home_player_1" IS NOT NULL
        LIMIT  10);
```

```sql
-- 5. For a handful of matches show the winner / loser
SELECT "id",
       "home_team_goal"  AS H,
       "away_team_goal"  AS A,
       CASE WHEN "home_team_goal" > "away_team_goal" THEN 'home wins'
            WHEN "home_team_goal" < "away_team_goal" THEN 'away wins'
            ELSE 'draw' END       AS "match_result"
FROM   "Match"
WHERE  "home_team_goal" <> "away_team_goal"      -- remove draws
LIMIT  20;
```

```sql
-- 6. Un-pivot only two home positions (demo) and attach win/loss tag
SELECT m."match_api_id",
       hp."player_api_id",
       CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
            WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
            ELSE 'draw' END                       AS "result"
FROM   "Match" AS m
CROSS  JOIN
       (VALUES ('home_player_1', m."home_player_1"),
               ('home_player_2', m."home_player_2")) AS hp(col, "player_api_id")
WHERE  hp."player_api_id" IS NOT NULL
LIMIT  20;
```

```sql
-- 7. Same trick for two away positions (demo)
SELECT m."match_api_id",
       ap."player_api_id",
       CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
            WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
            ELSE 'draw' END                       AS "result"
FROM   "Match" AS m
CROSS  JOIN
       (VALUES ('away_player_1', m."away_player_1"),
               ('away_player_2', m."away_player_2")) AS ap(col, "player_api_id")
WHERE  ap."player_api_id" IS NOT NULL
LIMIT  20;
```

