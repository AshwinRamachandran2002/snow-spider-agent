Query:
--Description: “Un-pivot” just the first two away–player columns without using the
--unsupported VALUES(...) trick.  Two SELECTs (one for away_player_1, one for
--away_player_2) are stacked with UNION ALL; each row is labelled win / loss /
--draw from the away team’s point of view, and NULL player slots are skipped.
SELECT m."match_api_id",
       m."away_player_1"                        AS "player_api_id",
       CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
            WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
            ELSE 'draw' END                     AS "result"
FROM   "Match" AS m
WHERE  m."away_player_1" IS NOT NULL

UNION ALL

SELECT m."match_api_id",
       m."away_player_2",
       CASE WHEN m."away_team_goal" > m."home_team_goal" THEN 'win'
            WHEN m."away_team_goal" < m."home_team_goal" THEN 'loss'
            ELSE 'draw' END
FROM   "Match" AS m
WHERE  m."away_player_2" IS NOT NULL
LIMIT 20
