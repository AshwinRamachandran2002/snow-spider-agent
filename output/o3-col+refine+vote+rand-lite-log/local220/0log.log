--Description: Build a long (player_api_id,result) list by stacking all 22 player columns
--from each match with UNION ALL.  For each row we label whether that player’s team won
--or lost the match (draws are ignored later).  We then aggregate to count total wins
--and losses per player, pick the one with the most wins and the one with the most
--losses, and finally show their names and match counts.
WITH player_match_result AS (
    -- ---------- home players ----------
    SELECT m."home_player_1" AS player_api_id,
           CASE WHEN m."home_team_goal" > m."away_team_goal" THEN 'win'
                WHEN m."home_team_goal" < m."away_team_goal" THEN 'loss'
                ELSE 'draw' END AS result
