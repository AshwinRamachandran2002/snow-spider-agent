 UNION ALL SELECT "away_player_9"  FROM "Match" WHERE "away_team_goal" < "home_team_goal"
 UNION ALL SELECT "away_player_10" FROM "Match" WHERE "away_team_goal" < "home_team_goal"
 UNION ALL SELECT "away_player_11" FROM "Match" WHERE "away_team_goal" < "home_team_goal"
),
/* B: counts of wins / losses per player */
win_cnt AS (SELECT pid AS player_api_id, COUNT(*) AS win_games  FROM win_app  WHERE pid IS NOT NULL GROUP BY pid),
los_cnt AS (SELECT pid AS player_api_id, COUNT(*) AS loss_games FROM loss_app WHERE pid IS NOT NULL GROUP BY pid),
/* C: take the row(s) with the maximum count in each set */
max_win AS (SELECT * FROM win_cnt ORDER BY win_games  DESC LIMIT 1),
max_loss AS(SELECT * FROM los_cnt ORDER BY loss_games DESC LIMIT 1)

SELECT 'Most Wins'   AS category,
       pl."player_name",
       mw.win_games   AS total_matches
FROM   max_win mw
JOIN   "Player" pl ON pl."player_api_id" = mw.player_api_id

UNION ALL

SELECT 'Most Losses',
       pl."player_name",
       ml.loss_games
FROM   max_loss ml
JOIN   "Player" pl ON pl."player_api_id" = ml.player_api_id;
