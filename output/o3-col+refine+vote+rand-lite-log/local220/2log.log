win_app AS (
        SELECT "home_player_1"  AS pid FROM "Match" WHERE "home_team_goal" > "away_team_goal"
 UNION ALL SELECT "home_player_2"  FROM "Match" WHERE "home_team_goal" > "away_team_goal"
