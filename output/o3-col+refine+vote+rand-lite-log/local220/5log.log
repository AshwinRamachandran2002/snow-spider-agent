Query:
--Description: 6)  Retrieve the player’s name who tops the *wins* list.
SELECT p.player_name,
       w.win_matches
FROM   (
        SELECT player_api_id, COUNT(*) AS win_matches
        FROM   (
                /*  same win-UNION as query 4, repeated once here                */
                SELECT id, home_player_1 AS player_api_id
                FROM   "Match"
                WHERE  home_player_1 IS NOT NULL
                  AND  home_team_goal > away_team_goal
                UNION ALL
                SELECT id, home_player_2
                FROM   "Match"
                WHERE  home_player_2 IS NOT NULL
                  AND  home_team_goal > away_team_goal
                UNION ALL
                SELECT id, away_player_1
                FROM   "Match"
                WHERE  away_player_1 IS NOT NULL
                  AND  away_team_goal > home_team_goal
                UNION ALL
                SELECT id, away_player_2
                FROM   "Match"
                WHERE  away_player_2 IS NOT NULL
                  AND  away_team_goal > home_team_goal
              )
        GROUP BY player_api_id
        ORDER BY win_matches DESC
        LIMIT 1
      ) AS w
JOIN   "Player" AS p
  ON   p.player_api_id = w.player_api_id;
