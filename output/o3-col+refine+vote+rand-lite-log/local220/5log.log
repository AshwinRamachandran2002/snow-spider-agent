```sql
--Description: 1)  Take a first glance at goals and the player–slots that hold the
--              participating footballers.  We only fetch matches that are not
--              draws (`home_team_goal <> away_team_goal`) so that later we can
--              decide who actually *won* or *lost*.
SELECT id, home_team_goal, away_team_goal,
       home_player_1, home_player_2, home_player_3,
       away_player_1, away_player_2, away_player_3
FROM   "Match"
WHERE  home_team_goal <> away_team_goal
LIMIT  20;
```

```sql
--Description: 2)  Look at *all* distinct player-ids that ever occur in the
--              home-player columns (non-NULL only).
SELECT DISTINCT home_player_1 AS player_api_id
FROM   "Match"
WHERE  home_player_1 IS NOT NULL
LIMIT  20;
```

```sql
--Description: 3)  Build a “long” view that lists each player that appeared in a
--              match together with the *result* from that player’s point of
--              view (win / loss).  This query shows a sample of 20 rows.
SELECT *
FROM   (
        --home side
        SELECT id            AS match_id,
               home_player_1 AS player_api_id,
               CASE WHEN home_team_goal > away_team_goal THEN 'win'
                    ELSE 'loss' END        AS result
        FROM   "Match"
        WHERE  home_player_1 IS NOT NULL
          AND  home_team_goal <> away_team_goal
        UNION ALL
        SELECT id, home_player_2,
               CASE WHEN home_team_goal > away_team_goal THEN 'win'
                    ELSE 'loss' END
        FROM   "Match"
        WHERE  home_player_2 IS NOT NULL
          AND  home_team_goal <> away_team_goal
        UNION ALL
        --away side (reverse the logic)
        SELECT id, away_player_1,
               CASE WHEN away_team_goal > home_team_goal THEN 'win'
                    ELSE 'loss' END
        FROM   "Match"
        WHERE  away_player_1 IS NOT NULL
          AND  home_team_goal <> away_team_goal
        UNION ALL
        SELECT id, away_player_2,
               CASE WHEN away_team_goal > home_team_goal THEN 'win'
                    ELSE 'loss' END
        FROM   "Match"
        WHERE  away_player_2 IS NOT NULL
          AND  home_team_goal <> away_team_goal
      ) AS long_view
LIMIT 20;
```

```sql
--Description: 4)  Count, for every player, how many *wins* he has accumulated.
SELECT player_api_id,
       COUNT(*) AS win_matches
FROM   (
        /*  The same UNIONS as above, covering the 22 player-slots               */
        SELECT id, home_player_1 AS player_api_id
        FROM   "Match"
        WHERE  home_player_1 IS NOT NULL
          AND  home_team_goal > away_team_goal
        UNION ALL
        SELECT id, home_player_2
        FROM   "Match"
        WHERE  home_player_2 IS NOT NULL
          AND  home_team_goal > away_team_goal
        UNION ALL
        SELECT id, away_player_1
        FROM   "Match"
        WHERE  away_player_1 IS NOT NULL
          AND  away_team_goal > home_team_goal
        UNION ALL
        SELECT id, away_player_2
        FROM   "Match"
        WHERE  away_player_2 IS NOT NULL
          AND  away_team_goal > home_team_goal
      ) AS wins
GROUP  BY player_api_id
ORDER BY win_matches DESC
LIMIT 20;
```

```sql
--Description: 5)  Count, for every player, how many *losses* he has suffered.
SELECT player_api_id,
       COUNT(*) AS loss_matches
FROM   (
        SELECT id, home_player_1 AS player_api_id
        FROM   "Match"
        WHERE  home_player_1 IS NOT NULL
          AND  home_team_goal < away_team_goal
        UNION ALL
        SELECT id, home_player_2
        FROM   "Match"
        WHERE  home_player_2 IS NOT NULL
          AND  home_team_goal < away_team_goal
        UNION ALL
        SELECT id, away_player_1
        FROM   "Match"
        WHERE  away_player_1 IS NOT NULL
          AND  away_team_goal < home_team_goal
        UNION ALL
        SELECT id, away_player_2
        FROM   "Match"
        WHERE  away_player_2 IS NOT NULL
          AND  away_team_goal < home_team_goal
      ) AS losses
GROUP  BY player_api_id
ORDER BY loss_matches DESC
LIMIT 20;
```

```sql
--Description: 6)  Retrieve the player’s name who tops the *wins* list.
SELECT p.player_name,
       w.win_matches
FROM   (
        SELECT player_api_id, COUNT(*) AS win_matches
        FROM   (
                /*  same win-UNION as query 4, repeated once here                */
                SELECT id, home_player_1 AS player_api_id
                FROM   "Match"
                WHERE  home_player_1 IS NOT NULL
                  AND  home_team_goal > away_team_goal
                UNION ALL
                SELECT id, home_player_2
                FROM   "Match"
                WHERE  home_player_2 IS NOT NULL
                  AND  home_team_goal > away_team_goal
                UNION ALL
                SELECT id, away_player_1
                FROM   "Match"
                WHERE  away_player_1 IS NOT NULL
                  AND  away_team_goal > home_team_goal
                UNION ALL
                SELECT id, away_player_2
                FROM   "Match"
                WHERE  away_player_2 IS NOT NULL
                  AND  away_team_goal > home_team_goal
              )
        GROUP BY player_api_id
        ORDER BY win_matches DESC
        LIMIT 1
      ) AS w
JOIN   "Player" AS p
  ON   p.player_api_id = w.player_api_id;
```

```sql
--Description: 7)  Retrieve the player’s name who tops the *losses* list.
SELECT p.player_name,
       l.loss_matches
FROM   (
        SELECT player_api_id, COUNT(*) AS loss_matches
        FROM   (
                /*  same loss-UNION as query 5, repeated once here               */
                SELECT id, home_player_1 AS player_api_id
                FROM   "Match"
                WHERE  home_player_1 IS NOT NULL
                  AND  home_team_goal < away_team_goal
                UNION ALL
                SELECT id, home_player_2
                FROM   "Match"
                WHERE  home_player_2 IS NOT NULL
                  AND  home_team_goal < away_team_goal
                UNION ALL
                SELECT id, away_player_1
                FROM   "Match"
                WHERE  away_player_1 IS NOT NULL
                  AND  away_team_goal < home_team_goal
                UNION ALL
                SELECT id, away_player_2
                FROM   "Match"
                WHERE  away_player_2 IS NOT NULL
                  AND  away_team_goal < home_team_goal
              )
        GROUP BY player_api_id
        ORDER BY loss_matches DESC
        LIMIT 1
      ) AS l
JOIN   "Player" AS p
  ON   p.player_api_id = l.player_api_id;
```

```sql
--Description: 8)  One compact query that returns *both* answers side-by-side.
SELECT 'most_wins' AS category,
       p_win.player_name,
       w.win_matches AS matches
FROM   (
        /* wins sub-query (top 1) */
        SELECT player_api_id, COUNT(*) AS win_matches
        FROM   (
                SELECT id, home_player_1 AS player_api_id
                FROM   "Match"
                WHERE  home_player_1 IS NOT NULL
                  AND  home_team_goal > away_team_goal
                UNION ALL
                SELECT id, home_player_2
                FROM   "Match"
                WHERE  home_player_2 IS NOT NULL
                  AND  home_team_goal > away_team_goal
                UNION ALL
                SELECT id, away_player_1
                FROM   "Match"
                WHERE  away_player_1 IS NOT NULL
                  AND  away_team_goal > home_team_goal
                UNION ALL
                SELECT id, away_player_2
                FROM   "Match"
                WHERE  away_player_2 IS NOT NULL
                  AND  away_team_goal > home_team_goal
              )
        GROUP BY player_api_id
        ORDER BY win_matches DESC
        LIMIT 1
      ) AS w
JOIN   "Player" AS p_win
  ON   p_win.player_api_id = w.player_api_id

UNION ALL

SELECT 'most_losses',
       p_loss.player_name,
       l.loss_matches
FROM   (
        /* losses sub-query (top 1) */
        SELECT player_api_id, COUNT(*) AS loss_matches
        FROM   (
                SELECT id, home_player_1 AS player_api_id
                FROM   "Match"
                WHERE  home_player_1 IS NOT NULL
                  AND  home_team_goal < away_team_goal
                UNION ALL
                SELECT id, home_player_2
                FROM   "Match"
                WHERE  home_player_2 IS NOT NULL
                  AND  home_team_goal < away_team_goal
                UNION ALL
                SELECT id, away_player_1
                FROM   "Match"
                WHERE  away_player_1 IS NOT NULL
                  AND  away_team_goal < home_team_goal
                UNION ALL
                SELECT id, away_player_2
                FROM   "Match"
                WHERE  away_player_2 IS NOT NULL
                  AND  away_team_goal < home_team_goal
              )
        GROUP BY player_api_id
        ORDER BY loss_matches DESC
        LIMIT 1
      ) AS l
JOIN   "Player" AS p_loss
  ON   p_loss.player_api_id = l.player_api_id;
```

