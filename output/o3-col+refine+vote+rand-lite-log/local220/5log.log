--Description: 3)  Build a “long” view that lists each player that appeared in a
--              match together with the *result* from that player’s point of
--              view (win / loss).  This query shows a sample of 20 rows.
SELECT *
FROM   (
        --home side
        SELECT id            AS match_id,
               home_player_1 AS player_api_id,
               CASE WHEN home_team_goal > away_team_goal THEN 'win'
                    ELSE 'loss' END        AS result
        FROM   "Match"
        WHERE  home_player_1 IS NOT NULL
          AND  home_team_goal <> away_team_goal
        UNION ALL
        SELECT id, home_player_2,
               CASE WHEN home_team_goal > away_team_goal THEN 'win'
                    ELSE 'loss' END
        FROM   "Match"
        WHERE  home_player_2 IS NOT NULL
          AND  home_team_goal <> away_team_goal
        UNION ALL
        --away side (reverse the logic)
        SELECT id, away_player_1,
               CASE WHEN away_team_goal > home_team_goal THEN 'win'
                    ELSE 'loss' END
        FROM   "Match"
        WHERE  away_player_1 IS NOT NULL
          AND  home_team_goal <> away_team_goal
        UNION ALL
        SELECT id, away_player_2,
               CASE WHEN away_team_goal > home_team_goal THEN 'win'
                    ELSE 'loss' END
        FROM   "Match"
        WHERE  away_player_2 IS NOT NULL
          AND  home_team_goal <> away_team_goal
      ) AS long_view
LIMIT 20;
