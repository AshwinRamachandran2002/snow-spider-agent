--Description: 4) List 20 sample rows of players who were on the WINNING side (home side that scored more, or away side that scored more).
SELECT player_api_id,
       match_id,
       side
FROM (
        /* home winners */
        SELECT "id"               AS match_id,
               "home_player_1"    AS player_api_id,
               'home'             AS side
        FROM   "Match"
        WHERE  "home_team_goal"  > "away_team_goal"
        AND    "home_player_1" IS NOT NULL
