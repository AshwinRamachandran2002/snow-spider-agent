```sql
-- 1.  Inspect the set of recorded genders in the legislators master table
SELECT DISTINCT "gender"
FROM "legislators"
LIMIT 20;
```

```sql
-- 2.  List a few female legislators together with their unique BioGuide id
SELECT DISTINCT "full_name",
       "id_bioguide",
       "birthday"
FROM   "legislators"
WHERE  "gender" = 'F'
LIMIT 20;
```

```sql
-- 3.  Show the congressional terms for one sample female legislator
SELECT  lt.*
FROM    "legislators_terms" AS lt
WHERE   lt."id_bioguide" = (SELECT "id_bioguide"
                            FROM   "legislators"
                            WHERE  "gender" = 'F'
                            LIMIT 1)
LIMIT 20;
```

```sql
-- 4.  For every term, test whether it spans December 31 of the start year
SELECT  lt."id_bioguide",
        lt."term_start",
        lt."term_end",
        CASE
            WHEN DATE(lt."term_end") >= DATE(substr(lt."term_start",1,4) || '-12-31')
            THEN 1 ELSE 0
        END AS "includes_dec31"
FROM    "legislators_terms" AS lt
LIMIT 20;
```

```sql
-- 5.  Retrieve every female legislator who has at least one term that includes December 31
SELECT DISTINCT l."id_bioguide"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS lt
       ON lt."id_bioguide" = l."id_bioguide"
WHERE  l."gender" = 'F'
  AND  DATE(lt."term_end") >= DATE(substr(lt."term_start",1,4) || '-12-31');
```

```sql
-- 6.  For those legislators, find the state from their first (earliest) term
SELECT  f."id_bioguide",
        ( SELECT lt2."state"
          FROM   "legislators_terms" AS lt2
          WHERE  lt2."id_bioguide" = f."id_bioguide"
          ORDER  BY lt2."term_start"
          LIMIT 1 )  AS "first_state"
FROM    ( /* female legislators covering Dec 31 */
          SELECT DISTINCT l."id_bioguide"
          FROM   "legislators"       AS l
          JOIN   "legislators_terms" AS lt
                 ON lt."id_bioguide" = l."id_bioguide"
          WHERE  l."gender" = 'F'
            AND  DATE(lt."term_end") >= DATE(substr(lt."term_start",1,4) || '-12-31')
        ) AS f
LIMIT 20;
```

```sql
-- 7.  Count how many such legislators have each first-represented state
SELECT  first_state       AS "state",
        COUNT(*)          AS "female_legislator_cnt"
FROM   ( SELECT  f."id_bioguide",
                ( SELECT lt2."state"
                  FROM   "legislators_terms" AS lt2
                  WHERE  lt2."id_bioguide" = f."id_bioguide"
                  ORDER  BY lt2."term_start"
                  LIMIT 1 )
                AS first_state
         FROM  ( SELECT DISTINCT l."id_bioguide"
                 FROM   "legislators"       AS l
                 JOIN   "legislators_terms" AS lt
                        ON lt."id_bioguide" = l."id_bioguide"
                 WHERE  l."gender" = 'F'
                   AND  DATE(lt."term_end") >= DATE(substr(lt."term_start",1,4) || '-12-31')
               ) AS f
       )
GROUP BY first_state
ORDER BY female_legislator_cnt DESC,
         state
LIMIT 20;
```

```sql
-- 8.  Return only the state with the maximum count (final answer)
SELECT  first_state  AS "state_with_most",
        COUNT(*)     AS "female_legislator_cnt"
FROM   ( SELECT  f."id_bioguide",
                ( SELECT lt2."state"
                  FROM   "legislators_terms" AS lt2
                  WHERE  lt2."id_bioguide" = f."id_bioguide"
                  ORDER  BY lt2."term_start"
                  LIMIT 1 )
                AS first_state
         FROM  ( SELECT DISTINCT l."id_bioguide"
                 FROM   "legislators"       AS l
                 JOIN   "legislators_terms" AS lt
                        ON lt."id_bioguide" = l."id_bioguide"
                 WHERE  l."gender" = 'F'
                   AND  DATE(lt."term_end") >= DATE(substr(lt."term_start",1,4) || '-12-31')
               ) AS f
       )
GROUP BY first_state
ORDER BY female_legislator_cnt DESC,
         state_with_most
LIMIT 1;
```

The last query will output one row — the two-letter postal abbreviation of the state that produced the greatest number of female legislators whose service at any time spanned a December 31, together with that count.
