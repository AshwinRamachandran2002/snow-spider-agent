Query:
-- 7.  Count how many such legislators have each first-represented state
SELECT  first_state       AS "state",
        COUNT(*)          AS "female_legislator_cnt"
FROM   ( SELECT  f."id_bioguide",
                ( SELECT lt2."state"
                  FROM   "legislators_terms" AS lt2
                  WHERE  lt2."id_bioguide" = f."id_bioguide"
                  ORDER  BY lt2."term_start"
                  LIMIT 1 )
                AS first_state
         FROM  ( SELECT DISTINCT l."id_bioguide"
                 FROM   "legislators"       AS l
                 JOIN   "legislators_terms" AS lt
                        ON lt."id_bioguide" = l."id_bioguide"
                 WHERE  l."gender" = 'F'
                   AND  DATE(lt."term_end") >= DATE(substr(lt."term_start",1,4) || '-12-31')
               ) AS f
       )
GROUP BY first_state
ORDER BY female_legislator_cnt DESC,
         state
LIMIT 20;
