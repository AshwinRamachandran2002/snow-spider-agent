```sql
--Description: 1) Find the distinct gender codes that appear in the master people file
SELECT DISTINCT gender
FROM legislators
LIMIT 20;


--Description: 2) Peek at a few female legislators and keep their bioguide-ids
SELECT full_name,
       id_bioguide,
       gender
FROM legislators
WHERE gender = 'F'
LIMIT 20;


--Description: 3) Show some term-rows that belong to female legislators
SELECT *
FROM legislators_terms
WHERE id_bioguide IN (SELECT id_bioguide
                      FROM legislators
                      WHERE gender = 'F')
LIMIT 20;


--Description: 4) Pick out term rows that clearly span at least one 31-Dec
SELECT id_bioguide,
       term_start,
       term_end,
       state
FROM legislators_terms
WHERE CAST(substr(term_end ,1,4) AS INTEGER) >
      CAST(substr(term_start,1,4) AS INTEGER)
LIMIT 20;


--Description: 5) List every FEMALE legislator who has at least one
--               term that included a 31-Dec
SELECT DISTINCT lt.id_bioguide
FROM legislators_terms  AS lt
JOIN  legislators       AS l
      ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'F'
  AND CAST(substr(lt.term_end ,1,4) AS INTEGER) >
      CAST(substr(lt.term_start,1,4) AS INTEGER)
LIMIT 20;


--Description: 6) For each of the women found above, return the state
--               she first represented (earliest start-date)
SELECT l.id_bioguide,
       (SELECT state
        FROM   legislators_terms AS t2
        WHERE  t2.id_bioguide = l.id_bioguide
        ORDER  BY term_start
        LIMIT 1)          AS first_state
FROM legislators AS l
WHERE l.id_bioguide IN (
        SELECT DISTINCT lt.id_bioguide
        FROM legislators_terms AS lt
        JOIN legislators       AS lx
              ON lx.id_bioguide = lt.id_bioguide
        WHERE lx.gender = 'F'
          AND CAST(substr(lt.term_end ,1,4) AS INTEGER) >
              CAST(substr(lt.term_start,1,4) AS INTEGER)
)
LIMIT 20;


--Description: 7) Count how many such women’s very-first state is each state
SELECT first_state                     AS state_abbrev,
       COUNT(*)                        AS female_legislator_count
FROM (
        SELECT l.id_bioguide,
               (SELECT state
                FROM   legislators_terms AS t2
                WHERE  t2.id_bioguide = l.id_bioguide
                ORDER  BY term_start
                LIMIT 1) AS first_state
        FROM legislators AS l
        JOIN legislators_terms AS lt
              ON lt.id_bioguide = l.id_bioguide
        WHERE l.gender = 'F'
          AND CAST(substr(lt.term_end ,1,4) AS INTEGER) >
              CAST(substr(lt.term_start,1,4) AS INTEGER)
        GROUP BY l.id_bioguide
) sub
GROUP BY first_state
ORDER BY female_legislator_count DESC
LIMIT 20;


--Description: 8) Finally return the single state with the biggest count
SELECT state_abbrev,
       female_legislator_count
FROM (
        SELECT first_state AS state_abbrev,
               COUNT(*)    AS female_legislator_count
        FROM (
                SELECT l.id_bioguide,
                       (SELECT state
                        FROM   legislators_terms AS t2
                        WHERE  t2.id_bioguide = l.id_bioguide
                        ORDER  BY term_start
                        LIMIT 1) AS first_state
                FROM legislators AS l
                JOIN legislators_terms AS lt
                      ON lt.id_bioguide = l.id_bioguide
                WHERE l.gender = 'F'
                  AND CAST(substr(lt.term_end ,1,4) AS INTEGER) >
                      CAST(substr(lt.term_start,1,4) AS INTEGER)
                GROUP BY l.id_bioguide
        ) z
        GROUP BY first_state
        ORDER BY female_legislator_count DESC
) top1
LIMIT 1;
```

