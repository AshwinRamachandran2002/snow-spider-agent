```sql
-- Description: 1) Inspect the gender column – list a few female legislators.
SELECT DISTINCT "full_name", "id_bioguide", "gender"
FROM "legislators"
WHERE "gender" = 'F'
LIMIT 20;
```

```sql
-- Description: 2) Join female legislators to all of their terms to see state & dates.
SELECT l."id_bioguide",
       l."full_name",
       t."state",
       t."term_start",
       t."term_end"
FROM   "legislators"       AS l
JOIN   "legislators_terms" AS t
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'F'
LIMIT 20;
```

```sql
-- Description: 3) For every female legislator, show the FIRST state she represented (earliest term).
SELECT lt."id_bioguide",
       MIN(lt."term_start")      AS "first_term_start",
       (SELECT "state"
        FROM   "legislators_terms"
        WHERE  "id_bioguide" = lt."id_bioguide"
        ORDER BY "term_start"
        LIMIT 1)                 AS "first_state"
FROM   "legislators_terms" AS lt
JOIN   "legislators"       AS l
       ON l."id_bioguide" = lt."id_bioguide"
WHERE  l."gender" = 'F'
GROUP  BY lt."id_bioguide"
LIMIT 20;
```

```sql
-- Description: 4) Identify all female-held terms that included a December 31 (any year).
SELECT t."id_bioguide",
       t."state",
       t."term_start",
       t."term_end"
FROM   "legislators_terms" AS t
JOIN   "legislators"       AS l
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'F'
  AND  DATE(t."term_start") 
       <= DATE(substr(t."term_end",1,4) || '-12-31')   -- term covers at least one Dec-31
LIMIT 20;
```

```sql
-- Description: 5) List every female legislator (distinct) whose career included a term that covered Dec 31.
SELECT DISTINCT t."id_bioguide"
FROM   "legislators_terms" AS t
JOIN   "legislators"       AS l
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'F'
  AND  DATE(t."term_start") 
       <= DATE(substr(t."term_end",1,4) || '-12-31')
LIMIT 20;
```

```sql
-- Description: 6) From those legislators, pull the first state each of them served.
WITH first_state AS (
    SELECT lt."id_bioguide",
           (SELECT "state"
            FROM   "legislators_terms"
            WHERE  "id_bioguide" = lt."id_bioguide"
            ORDER  BY "term_start"
            LIMIT 1) AS "first_state"
    FROM   "legislators_terms" AS lt
    GROUP  BY lt."id_bioguide"
),
dec31_females AS (
    SELECT DISTINCT t."id_bioguide"
    FROM   "legislators_terms" AS t
    JOIN   "legislators"       AS l
           ON l."id_bioguide" = t."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  DATE(t."term_start")
           <= DATE(substr(t."term_end",1,4) || '-12-31')
)
SELECT fs."first_state"      AS "state",
       COUNT(*)              AS "female_count"
FROM   first_state AS fs
JOIN   dec31_females AS d
       ON fs."id_bioguide" = d."id_bioguide"
GROUP  BY fs."first_state"
ORDER  BY "female_count" DESC
LIMIT 20;
```

```sql
-- Description: 7) Final answer – the single state with the greatest number and that count.
WITH first_state AS (
    SELECT lt."id_bioguide",
           (SELECT "state"
            FROM   "legislators_terms"
            WHERE  "id_bioguide" = lt."id_bioguide"
            ORDER  BY "term_start"
            LIMIT 1) AS "first_state"
    FROM   "legislators_terms" AS lt
    GROUP  BY lt."id_bioguide"
),
dec31_females AS (
    SELECT DISTINCT t."id_bioguide"
    FROM   "legislators_terms" AS t
    JOIN   "legislators"       AS l
           ON l."id_bioguide" = t."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  DATE(t."term_start")
           <= DATE(substr(t."term_end",1,4) || '-12-31')
)
SELECT fs."first_state"      AS "state_abbrev",
       COUNT(*)              AS "female_legislator_count"
FROM   first_state AS fs
JOIN   dec31_females AS d
       ON fs."id_bioguide" = d."id_bioguide"
GROUP  BY fs."first_state"
ORDER  BY "female_legislator_count" DESC
LIMIT 1;
```

Running the last query will return the state abbreviation with the highest number of female legislators whose service at some point included December 31, along with that count.
