Query:
-- Description: 4) Identify all female-held terms that included a December 31 (any year).
SELECT t."id_bioguide",
       t."state",
       t."term_start",
       t."term_end"
FROM   "legislators_terms" AS t
JOIN   "legislators"       AS l
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'F'
  AND  DATE(t."term_start") 
       <= DATE(substr(t."term_end",1,4) || '-12-31')   -- term covers at least one Dec-31
LIMIT 20;
