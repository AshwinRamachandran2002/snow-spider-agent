Query:
-- Description: 6) From those legislators, pull the first state each of them served.
WITH first_state AS (
    SELECT lt."id_bioguide",
           (SELECT "state"
            FROM   "legislators_terms"
            WHERE  "id_bioguide" = lt."id_bioguide"
            ORDER  BY "term_start"
            LIMIT 1) AS "first_state"
    FROM   "legislators_terms" AS lt
    GROUP  BY lt."id_bioguide"
),
dec31_females AS (
    SELECT DISTINCT t."id_bioguide"
    FROM   "legislators_terms" AS t
    JOIN   "legislators"       AS l
           ON l."id_bioguide" = t."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  DATE(t."term_start")
           <= DATE(substr(t."term_end",1,4) || '-12-31')
)
SELECT fs."first_state"      AS "state",
       COUNT(*)              AS "female_count"
FROM   first_state AS fs
JOIN   dec31_females AS d
       ON fs."id_bioguide" = d."id_bioguide"
GROUP  BY fs."first_state"
ORDER  BY "female_count" DESC
LIMIT 20;
