Query:
-- Description: 3) For every female legislator, show the FIRST state she represented (earliest term).
SELECT lt."id_bioguide",
       MIN(lt."term_start")      AS "first_term_start",
       (SELECT "state"
        FROM   "legislators_terms"
        WHERE  "id_bioguide" = lt."id_bioguide"
        ORDER BY "term_start"
        LIMIT 1)                 AS "first_state"
FROM   "legislators_terms" AS lt
JOIN   "legislators"       AS l
       ON l."id_bioguide" = lt."id_bioguide"
WHERE  l."gender" = 'F'
GROUP  BY lt."id_bioguide"
LIMIT 20;
