```sql
-- 3) Inspect some term records for those female legislators.
SELECT DISTINCT l."id_bioguide",
       t."term_start",
       t."term_end",
       t."state"
FROM   "legislators" AS l
JOIN   "legislators_terms" AS t
       ON l."id_bioguide" = t."id_bioguide"
WHERE  l."gender" = 'F'
LIMIT 20;
```

```sql
-- 4) Check how to detect if a given term spans December 31 of its start-year.
SELECT DISTINCT t."id_bioguide",
       t."term_start",
       t."term_end",
       date(substr(t."term_start",1,4) || '-12-31')               AS "dec31_of_start_year",
       CASE WHEN date(substr(t."term_start",1,4) || '-12-31')
                 BETWEEN t."term_start" AND t."term_end"
            THEN 1 ELSE 0 END                                     AS "includes_dec31"
FROM   "legislators_terms" AS t
LIMIT 20;
```

```sql
-- 5) Which female legislators have at least one term that includes a December 31?
WITH dec_female AS (
    SELECT DISTINCT l."id_bioguide"
    FROM   "legislators"        AS l
    JOIN   "legislators_terms"  AS t
           ON l."id_bioguide" = t."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  date(substr(t."term_start",1,4) || '-12-31')
           BETWEEN t."term_start" AND t."term_end"
)
SELECT *
FROM   dec_female
LIMIT 20;
```

```sql
-- 6) For each of those legislators, find the state they first represented.
WITH dec_female AS (
    SELECT DISTINCT l."id_bioguide"
    FROM   "legislators"        AS l
    JOIN   "legislators_terms"  AS t
           ON l."id_bioguide" = t."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  date(substr(t."term_start",1,4) || '-12-31')
           BETWEEN t."term_start" AND t."term_end"
),
first_terms AS (
    SELECT t."id_bioguide",
           t."state",
           t."term_start"
    FROM   "legislators_terms" AS t
    JOIN   dec_female          AS df
           ON t."id_bioguide" = df."id_bioguide"
    WHERE  t."term_start" = (
            SELECT MIN("term_start")
            FROM   "legislators_terms"
            WHERE  "id_bioguide" = t."id_bioguide"
          )
)
SELECT *
FROM   first_terms
LIMIT 20;
```

```sql
-- 7) Count how many such legislators started out in each state.
WITH dec_female AS (
    SELECT DISTINCT l."id_bioguide"
    FROM   "legislators"        AS l
    JOIN   "legislators_terms"  AS t
           ON l."id_bioguide" = t."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  date(substr(t."term_start",1,4) || '-12-31')
           BETWEEN t."term_start" AND t."term_end"
),
first_terms AS (
    SELECT t."id_bioguide",
           t."state",
           t."term_start"
    FROM   "legislators_terms" AS t
    JOIN   dec_female          AS df
           ON t."id_bioguide" = df."id_bioguide"
    WHERE  t."term_start" = (
            SELECT MIN("term_start")
            FROM   "legislators_terms"
            WHERE  "id_bioguide" = t."id_bioguide"
          )
)
SELECT "state",
       COUNT(*) AS "female_legislator_count"
FROM   first_terms
GROUP  BY "state"
ORDER  BY "female_legislator_count" DESC
LIMIT 20;
```

```sql
-- 8) Finally, which single state has the highest number and what is that count?
WITH dec_female AS (
