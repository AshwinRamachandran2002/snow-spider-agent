-- 4) Check how to detect if a given term spans December 31 of its start-year.
SELECT DISTINCT t."id_bioguide",
       t."term_start",
       t."term_end",
       date(substr(t."term_start",1,4) || '-12-31')               AS "dec31_of_start_year",
       CASE WHEN date(substr(t."term_start",1,4) || '-12-31')
                 BETWEEN t."term_start" AND t."term_end"
            THEN 1 ELSE 0 END                                     AS "includes_dec31"
FROM   "legislators_terms" AS t
LIMIT 20;
