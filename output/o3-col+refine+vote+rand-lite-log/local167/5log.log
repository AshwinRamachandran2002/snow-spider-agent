Below are nine progressively-complex inspection queries (all use LIMIT 20 for safety) followed by one final query that gives the requested result.  
Run them in order to see how the answer is built.

```sql
-- 1.  What values are stored in the “gender” column?
SELECT DISTINCT gender
FROM legislators
LIMIT 20;
```

```sql
-- 2.  List a few female legislators.
SELECT id_bioguide, full_name, gender
FROM legislators
WHERE gender = 'F'
LIMIT 20;
```

```sql
-- 3.  View every term for a sample female legislator (Maria Cantwell).
SELECT *
FROM legislators_terms
WHERE id_bioguide = 'C000127'
LIMIT 20;
```

```sql
-- 4.  Find terms that cover 31 December of the start-year.
SELECT id_bioguide,
       term_number,
       term_start,
       term_end
FROM legislators_terms
WHERE date(term_end) >= date(substr(term_start,1,4) || '-12-31')
LIMIT 20;
```

```sql
-- 5.  Female legislators who have at least one “Dec-31” term.
SELECT DISTINCT l.id_bioguide,
       l.full_name
FROM legislators   AS l
JOIN ( SELECT DISTINCT id_bioguide
       FROM legislators_terms
       WHERE date(term_end) >= date(substr(term_start,1,4) || '-12-31')
     )              AS d  USING (id_bioguide)
WHERE l.gender = 'F'
LIMIT 20;
```

```sql
-- 6.  For every female legislator, locate her first term number.
SELECT lt.id_bioguide,
       MIN(lt.term_number) AS first_term_num
FROM legislators_terms AS lt
JOIN legislators       AS l  ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'F'
GROUP BY lt.id_bioguide
LIMIT 20;
```

```sql
-- 7.  Attach the state from each woman’s very first term.
SELECT ft.id_bioguide,
       lt.state
FROM (
        SELECT lt.id_bioguide,
               MIN(lt.term_number) AS first_term_num
        FROM legislators_terms AS lt
        JOIN legislators       AS l  ON l.id_bioguide = lt.id_bioguide
        WHERE l.gender = 'F'
        GROUP BY lt.id_bioguide
     )            AS ft
JOIN legislators_terms AS lt
     ON lt.id_bioguide = ft.id_bioguide
    AND lt.term_number = ft.first_term_num
LIMIT 20;
```

```sql
-- 8.  Combine first-state info with “Dec-31” qualification.
SELECT s.state,
       s.id_bioguide
FROM (
        SELECT ft.id_bioguide,
               lt.state
        FROM (
                SELECT lt.id_bioguide,
                       MIN(lt.term_number) AS first_term_num
                FROM legislators_terms AS lt
                JOIN legislators       AS l  ON l.id_bioguide = lt.id_bioguide
                WHERE l.gender = 'F'
                GROUP BY lt.id_bioguide
             )            AS ft
        JOIN legislators_terms AS lt
             ON lt.id_bioguide = ft.id_bioguide
            AND lt.term_number = ft.first_term_num
     )                    AS s
JOIN (
        SELECT DISTINCT id_bioguide
        FROM legislators_terms
        WHERE date(term_end) >= date(substr(term_start,1,4) || '-12-31')
     )                    AS d  USING (id_bioguide)
LIMIT 20;
```

```sql
-- 9.  Count qualified female legislators by their first-represented state
--     and return the state with the highest count.
SELECT s.state                          AS top_state_abbrev,
       COUNT(*)                         AS female_legislators_count
FROM (
        SELECT ft.id_bioguide,
               lt.state
        FROM (
                SELECT lt.id_bioguide,
                       MIN(lt.term_number) AS first_term_num
                FROM legislators_terms AS lt
                JOIN legislators       AS l  ON l.id_bioguide = lt.id_bioguide
                WHERE l.gender = 'F'
                GROUP BY lt.id_bioguide
             )            AS ft
        JOIN legislators_terms AS lt
             ON lt.id_bioguide = ft.id_bioguide
            AND lt.term_number = ft.first_term_num
     )                    AS s
JOIN (
        SELECT DISTINCT id_bioguide
        FROM legislators_terms
        WHERE date(term_end) >= date(substr(term_start,1,4) || '-12-31')
     )                    AS d  USING (id_bioguide)
GROUP BY s.state
ORDER BY female_legislators_count DESC
LIMIT 1;
```

