-- 1. Check the values that appear in the gender column
SELECT DISTINCT gender 
FROM legislators 
LIMIT 20;
```

```sql
-- 2. See a few female legislators and their bioguide id’s
SELECT full_name,
       id_bioguide,
       gender
FROM legislators
WHERE gender = 'F'
LIMIT 20;
```

```sql
-- 3. Look at the term records for one random female legislator (replace id if needed)
SELECT *
FROM legislators_terms
WHERE id_bioguide = 'C000127'      -- Maria Cantwell chosen from the sample
LIMIT 20;
```

```sql
-- 4. Which terms (any legislator) lasted at least through 31 Dec of the start-year?
SELECT id_bioguide,
       term_number,
       term_start,
       term_end,
       state
FROM legislators_terms
WHERE term_end >= substr(term_start, 1, 4) || '-12-31'
LIMIT 20;
```

```sql
-- 5. Get all DISTINCT female legislators whose ANY term satisfied that 31-Dec condition
SELECT DISTINCT lt.id_bioguide
FROM legislators_terms  AS lt
JOIN legislators        AS l
      ON l.id_bioguide = lt.id_bioguide
WHERE l.gender = 'F'
  AND lt.term_end >= substr(lt.term_start, 1, 4) || '-12-31'
LIMIT 20;
```

```sql
-- 6. For those qualifying women, pull their FIRST (smallest term_number) term’s state
SELECT q.id_bioguide,
       MIN(lt.term_number)                   AS first_term_no,
       (SELECT state
        FROM legislators_terms
        WHERE id_bioguide = q.id_bioguide
        ORDER BY term_number
        LIMIT 1)                             AS first_state
FROM (
     SELECT DISTINCT lt.id_bioguide
     FROM legislators_terms  AS lt
     JOIN legislators        AS l
           ON l.id_bioguide = lt.id_bioguide
     WHERE l.gender = 'F'
       AND lt.term_end >= substr(lt.term_start, 1, 4) || '-12-31'
) AS q
JOIN legislators_terms AS lt
     ON lt.id_bioguide = q.id_bioguide
GROUP BY q.id_bioguide
LIMIT 20;
```

```sql
-- 7. Count how many qualifying women have each first-represented state
SELECT first_state                          AS state,
       COUNT(*)                             AS female_legislator_cnt
FROM (
     SELECT q.id_bioguide,
            (SELECT state
             FROM legislators_terms
             WHERE id_bioguide = q.id_bioguide
             ORDER BY term_number
             LIMIT 1)  AS first_state
     FROM (
          SELECT DISTINCT lt.id_bioguide
          FROM legislators_terms  AS lt
          JOIN legislators        AS l
                ON l.id_bioguide = lt.id_bioguide
          WHERE l.gender = 'F'
            AND lt.term_end >= substr(lt.term_start, 1, 4) || '-12-31'
     ) AS q
) AS first_states
GROUP BY first_state
ORDER BY female_legislator_cnt DESC
LIMIT 20;
```

```sql
-- 8. Finally, obtain the single state with the highest number
SELECT state,
       female_legislator_cnt
FROM (
     SELECT first_state  AS state,
            COUNT(*)     AS female_legislator_cnt
     FROM (
          SELECT q.id_bioguide,
                 (SELECT state
                  FROM legislators_terms
                  WHERE id_bioguide = q.id_bioguide
                  ORDER BY term_number
                  LIMIT 1)  AS first_state
          FROM (
               SELECT DISTINCT lt.id_bioguide
               FROM legislators_terms  AS lt
               JOIN legislators        AS l
                     ON l.id_bioguide = lt.id_bioguide
               WHERE l.gender = 'F'
                 AND lt.term_end >= substr(lt.term_start, 1, 4) || '-12-31'
          ) AS q
     ) AS first_states
     GROUP BY first_state
) AS counts
ORDER BY female_legislator_cnt DESC
LIMIT 1;
```
