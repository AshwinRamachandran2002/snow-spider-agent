```sql
-- 1. Preview the gender values recorded for legislators
SELECT DISTINCT "gender"
FROM "legislators"
LIMIT 20;
```

```sql
-- 2. Inspect a few female legislators together with their bioguide-id
SELECT DISTINCT "full_name", "id_bioguide"
FROM "legislators"
WHERE "gender" = 'F'
LIMIT 20;
```

```sql
-- 3. Look at the structure of terms for a single known female legislator
SELECT *
FROM "legislators_terms"
WHERE "id_bioguide" = 'C000127'         -- (Maria Cantwell, from step-2)
LIMIT 20;
```

```sql
-- 4. Check how many terms in the whole table include Dec-31
SELECT COUNT(*) AS terms_including_dec31
FROM "legislators_terms"
WHERE date(substr("term_start",1,4) || '-12-31') <= "term_end";
```

```sql
-- 5. Find every female legislator who EVER had a term that contained Dec-31
SELECT DISTINCT lt."id_bioguide"
FROM   "legislators"        AS l
JOIN   "legislators_terms"  AS lt
       ON l."id_bioguide" = lt."id_bioguide"
WHERE  l."gender" = 'F'
  AND  date(substr(lt."term_start",1,4) || '-12-31') <= lt."term_end"
LIMIT 20;
```

```sql
-- 6. For each legislator, obtain the start-date of their very first term
SELECT "id_bioguide", MIN("term_start") AS first_term_start
FROM   "legislators_terms"
GROUP  BY "id_bioguide"
LIMIT 20;
```

```sql
-- 7. Pair each legislator with the STATE of that very first term
WITH first_term AS (
    SELECT lt."id_bioguide",
           lt."state"
    FROM   "legislators_terms" lt
    JOIN  ( SELECT "id_bioguide", MIN("term_start") AS first_start
            FROM   "legislators_terms"
            GROUP  BY "id_bioguide") f
          ON  lt."id_bioguide" = f."id_bioguide"
          AND lt."term_start"  = f."first_start"
)
SELECT * FROM first_term
LIMIT 20;
```

```sql
-- 8. FINAL ANSWER:
--    Count, per first-represented state, female legislators whose
--    careers contained a Dec-31 at any point, then return the top one
WITH dec31_fem AS (
    SELECT DISTINCT l."id_bioguide"
    FROM   "legislators"       AS l
    JOIN   "legislators_terms" AS lt
           ON l."id_bioguide" = lt."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  date(substr(lt."term_start",1,4) || '-12-31') <= lt."term_end"
),
first_state AS (
    SELECT lt."id_bioguide",
           lt."state"
    FROM   "legislators_terms" lt
    JOIN  ( SELECT "id_bioguide", MIN("term_start") AS first_start
            FROM   "legislators_terms"
            GROUP  BY "id_bioguide") fs
          ON lt."id_bioguide" = fs."id_bioguide"
         AND lt."term_start"  = fs."first_start"
)
SELECT fs."state"                        AS state_abbrev,
       COUNT(*)                          AS female_legislator_count
FROM   dec31_fem   AS df
JOIN   first_state AS fs
       ON df."id_bioguide" = fs."id_bioguide"
GROUP  BY fs."state"
ORDER  BY female_legislator_count DESC
LIMIT 1;
```

The query in step 8 returns one row containing:

state_abbrev | female_legislator_count

This gives the state abbreviation that produced the largest number of female legislators whose service included at least one December 31, together with that count.
