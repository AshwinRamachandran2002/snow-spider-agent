Query:
-- 8. FINAL ANSWER:
--    Count, per first-represented state, female legislators whose
--    careers contained a Dec-31 at any point, then return the top one
WITH dec31_fem AS (
    SELECT DISTINCT l."id_bioguide"
    FROM   "legislators"       AS l
    JOIN   "legislators_terms" AS lt
           ON l."id_bioguide" = lt."id_bioguide"
    WHERE  l."gender" = 'F'
      AND  date(substr(lt."term_start",1,4) || '-12-31') <= lt."term_end"
),
first_state AS (
    SELECT lt."id_bioguide",
           lt."state"
    FROM   "legislators_terms" lt
    JOIN  ( SELECT "id_bioguide", MIN("term_start") AS first_start
            FROM   "legislators_terms"
            GROUP  BY "id_bioguide") fs
          ON lt."id_bioguide" = fs."id_bioguide"
         AND lt."term_start"  = fs."first_start"
)
SELECT fs."state"                        AS state_abbrev,
       COUNT(*)                          AS female_legislator_count
FROM   dec31_fem   AS df
JOIN   first_state AS fs
       ON df."id_bioguide" = fs."id_bioguide"
GROUP  BY fs."state"
ORDER  BY female_legislator_count DESC
LIMIT 1;
Answer:
state_abbrev,female_legislator_count
