```sql
--Description: Preview 2020 individual FEC contributions made by donors in New York State
SELECT zip_code , transaction_amt
FROM `bigquery-public-data.fec.indiv20`
WHERE state = 'NY'
  AND transaction_amt IS NOT NULL
LIMIT 20;
```

```sql
--Description: Inspect New York individual donations with Brooklyn ZIP codes (those beginning with 112**)
SELECT zip_code , transaction_amt
FROM `bigquery-public-data.fec.indiv20`
WHERE state = 'NY'
  AND SAFE_CAST(SUBSTR(zip_code,1,5) AS INT64) BETWEEN 11200 AND 11299
LIMIT 20;
```

```sql
--Description: Look up census-tract mappings for a few Brooklyn ZIP codes in the HUD cross-walk
SELECT DISTINCT zip_code , census_tract_geoid
FROM `bigquery-public-data.hud_zipcode_crosswalk.zipcode_to_census_tracts`
WHERE zip_code IN ('11201','11211','11215')
LIMIT 20;
```

```sql
--Description: Join FEC donors with the ZIP-to-tract cross-walk to attach census-tract GEOIDs
SELECT DISTINCT
  SUBSTR(d.zip_code,1,5) AS zip5 ,
  x.census_tract_geoid ,
  d.transaction_amt
FROM `bigquery-public-data.fec.indiv20` AS d
JOIN `bigquery-public-data.hud_zipcode_crosswalk.zipcode_to_census_tracts` AS x
  ON SUBSTR(d.zip_code,1,5) = x.zip_code
WHERE d.state = 'NY'
LIMIT 20;
```

```sql
--Description: Compute the average individual donation per census tract in Kings County
SELECT
  x.census_tract_geoid AS geo_id ,
  AVG(d.transaction_amt) AS avg_donation
FROM `bigquery-public-data.fec.indiv20` AS d
JOIN `bigquery-public-data.hud_zipcode_crosswalk.zipcode_to_census_tracts` AS x
  ON SUBSTR(d.zip_code,1,5) = x.zip_code
WHERE d.state = 'NY'
  AND SUBSTR(x.census_tract_geoid,1,5) = '36047'
  AND d.transaction_amt IS NOT NULL
GROUP BY geo_id
LIMIT 20;
```

```sql
--Description: Final result – Kings County census tracts with their median income and average 2020 donation
SELECT
  a.geo_id ,
  a.median_income ,
  don.avg_donation
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS a
JOIN (
    SELECT
      x.census_tract_geoid AS geo_id ,
      AVG(d.transaction_amt) AS avg_donation
    FROM `bigquery-public-data.fec.indiv20` AS d
    JOIN `bigquery-public-data.hud_zipcode_crosswalk.zipcode_to_census_tracts` AS x
      ON SUBSTR(d.zip_code,1,5) = x.zip_code
    WHERE d.state = 'NY'
      AND SUBSTR(x.census_tract_geoid,1,5) = '36047'
      AND d.transaction_amt IS NOT NULL
    GROUP BY geo_id
) AS don
ON a.geo_id = don.geo_id
WHERE SUBSTR(a.geo_id,1,5) = '36047'
LIMIT 20;
```
