```sql
-- 1) Look at the list of countries that have customers
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
-- 2) How many customers does each country have?
SELECT "Country",
       COUNT(*) AS "num_customers"
FROM "customers"
GROUP BY "Country"
ORDER BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 3) Countries whose customer count is greater than 4
SELECT "Country",
       COUNT(*) AS "num_customers"
FROM "customers"
GROUP BY "Country"
HAVING COUNT(*) > 4
ORDER BY "num_customers" DESC;
```

```sql
-- 4) Inspect a few invoices to see the sales figures we will sum up
SELECT *
FROM "invoices"
LIMIT 20;
```

```sql
-- 5) Total sales (sum of invoice totals) generated from each country
SELECT c."Country",
       SUM(i."Total") AS "total_sales"
FROM   "invoices"  AS i
JOIN   "customers" AS c
  ON   c."CustomerId" = i."CustomerId"
GROUP  BY c."Country"
ORDER  BY "total_sales" DESC;
```

```sql
-- 6) Combine the two pieces: countries with >4 customers
--    together with their total sales
SELECT cs."Country",
       cs."total_sales",
       cc."num_customers"
FROM   (
         SELECT c."Country",
                SUM(i."Total") AS "total_sales"
         FROM   "invoices"  AS i
         JOIN   "customers" AS c
           ON   c."CustomerId" = i."CustomerId"
         GROUP  BY c."Country"
       ) AS cs
JOIN   (
         SELECT "Country",
                COUNT(*) AS "num_customers"
         FROM   "customers"
         GROUP  BY "Country"
         HAVING COUNT(*) > 4
       ) AS cc
  ON   cs."Country" = cc."Country"
ORDER BY cs."total_sales";
```

```sql
-- 7) FINAL ANSWER:
--    Median of the total sales values calculated in query (6)
WITH customer_counts AS (
     SELECT "Country", COUNT(*) AS num_customers
     FROM   "customers"
     GROUP  BY "Country"
     HAVING COUNT(*) > 4
),
country_sales AS (
     SELECT c."Country",
            SUM(i."Total") AS total_sales
     FROM   "invoices"  AS i
     JOIN   "customers" AS c
       ON   c."CustomerId" = i."CustomerId"
     GROUP  BY c."Country"
),
filtered AS (
     SELECT cs."Country", cs.total_sales
     FROM   country_sales  AS cs
     JOIN   customer_counts AS cc
       ON   cs."Country" = cc."Country"
),
ranked AS (
     SELECT total_sales,
            ROW_NUMBER() OVER (ORDER BY total_sales) AS rn,
            COUNT(*)  OVER ()                       AS cnt
     FROM   filtered
)
SELECT AVG(total_sales) AS "median_total_sales"
FROM   ranked
WHERE  rn IN ( (cnt + 1)/2, (cnt + 2)/2 );
```

