```sql
-- 1. Inspect how many customers reside in each country  
SELECT Country, COUNT(*) AS customer_cnt
FROM customers
GROUP BY Country
ORDER BY customer_cnt DESC
LIMIT 20;
```

```sql
-- 2. List only the countries that have more than 4 customers  
SELECT Country
FROM customers
GROUP BY Country
HAVING COUNT(*) > 4;
```

```sql
-- 3. Look at a few customers from those high–customer-count countries  
SELECT CustomerId, FirstName, LastName, Country
FROM customers
WHERE Country IN (SELECT Country
                  FROM customers GROUP BY Country HAVING COUNT(*) > 4)
LIMIT 20;
```

```sql
-- 4. Preview invoices coming from the selected countries  
SELECT InvoiceId, BillingCountry, Total
FROM invoices
WHERE BillingCountry IN (SELECT Country
                         FROM customers GROUP BY Country HAVING COUNT(*) > 4)
LIMIT 20;
```

```sql
-- 5. Make sure totals really vary as expected (distinct values)  
SELECT DISTINCT Total
FROM invoices
WHERE BillingCountry IN (SELECT Country
                         FROM customers GROUP BY Country HAVING COUNT(*) > 4)
ORDER BY Total
LIMIT 20;
```

```sql
-- 6. Count how many invoices exist for those countries  
SELECT COUNT(*) AS invoice_cnt
FROM invoices
WHERE BillingCountry IN (SELECT Country
                         FROM customers GROUP BY Country HAVING COUNT(*) > 4);
```

```sql
-- 7. Show all invoice totals together with an ordering number; this will
--    later help to understand how the median is derived  
SELECT Total,
       ROW_NUMBER() OVER (ORDER BY Total)   AS rn,
       COUNT(*)  OVER ()                    AS cnt
FROM invoices
WHERE BillingCountry IN (SELECT Country
                         FROM customers GROUP BY Country HAVING COUNT(*) > 4)
LIMIT 20;
```

```sql
-- 8. (Optional) Verify the two middle positions that define the median
SELECT (cnt + 1) / 2  AS lower_mid,
       (cnt + 2) / 2  AS upper_mid
FROM (
      SELECT COUNT(*) AS cnt
      FROM invoices
      WHERE BillingCountry IN (SELECT Country
                               FROM customers GROUP BY Country HAVING COUNT(*) > 4)
     );
```

```sql
-- 9. Final answer: calculate the median total of sales made in the
--    countries that have more than 4 customers  
WITH hi_cust_ctry AS (
     SELECT Country
     FROM customers
     GROUP BY Country
     HAVING COUNT(*) > 4
),
invoice_sales AS (
     SELECT Total
     FROM invoices
     WHERE BillingCountry IN (SELECT Country FROM hi_cust_ctry)
),
ordered AS (
     SELECT Total,
            ROW_NUMBER() OVER (ORDER BY Total)         AS rn,
            COUNT(*)      OVER ()                      AS cnt
     FROM invoice_sales
)
SELECT ROUND(AVG(Total), 2) AS median_total_sales
FROM ordered
WHERE rn IN ( (cnt + 1) / 2,
              (cnt + 2) / 2 );
```

The last query returns the median value of `Total` for all invoices issued in countries where the number of customers exceeds four.
