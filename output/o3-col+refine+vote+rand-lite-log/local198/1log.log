```sql
--Description: View the list of distinct customer countries
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
--Description: Find how many customers each country has
SELECT "Country",
       COUNT(*) AS "num_customers"
FROM   "customers"
GROUP  BY "Country"
ORDER  BY "num_customers" DESC
LIMIT 20;
```

```sql
--Description: Retrieve distinct billing countries that actually generated invoices
SELECT DISTINCT "BillingCountry"
FROM   "invoices"
LIMIT 20;
```

```sql
--Description: Calculate the total sales (sum of invoice totals) for every country
SELECT "BillingCountry"           AS "Country",
       ROUND(SUM("Total"), 2)     AS "total_sales"
FROM   "invoices"
GROUP  BY "BillingCountry"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
--Description: Show total sales only for countries with more than 4 customers
WITH "big_countries" AS (
    SELECT "Country"
    FROM   "customers"
    GROUP  BY "Country"
    HAVING COUNT(*) > 4
)
SELECT i."BillingCountry"         AS "Country",
       ROUND(SUM(i."Total"), 2)   AS "total_sales"
FROM   "invoices" AS i
WHERE  i."BillingCountry" IN (SELECT "Country" FROM "big_countries")
GROUP  BY i."BillingCountry"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
--Description: Final answer – compute the median of those total-sales figures
WITH big_countries AS (
    SELECT "Country"
    FROM   "customers"
    GROUP  BY "Country"
    HAVING COUNT(*) > 4
),
sales_by_country AS (
    SELECT i."BillingCountry"      AS "Country",
           ROUND(SUM(i."Total"),2) AS "total_sales"
    FROM   "invoices" AS i
    GROUP  BY i."BillingCountry"
),
ranked AS (
    SELECT "total_sales",
           ROW_NUMBER() OVER (ORDER BY "total_sales")  AS rn,
           COUNT(*)    OVER ()                         AS cnt
    FROM   sales_by_country
    WHERE  "Country" IN (SELECT "Country" FROM big_countries)
)
SELECT AVG("total_sales") AS "median_total_sales"
FROM   ranked
WHERE  rn IN ( (cnt + 1)/2, (cnt + 2)/2 );
```
