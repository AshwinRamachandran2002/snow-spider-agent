Below is a progressive set of SQL queries (all limited to 20 rows where relevant) that goes from basic exploration to the final computation of the median value requested.

```sql
-- 1. List every country that has at least one customer
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
-- 2. How many customers does each country have?
SELECT "Country",
       COUNT(*) AS "num_customers"
FROM   "customers"
GROUP  BY "Country"
ORDER  BY "num_customers" DESC
LIMIT 20;
```

```sql
-- 3. Countries whose customer count is greater than 4
SELECT "Country"
FROM   "customers"
GROUP  BY "Country"
HAVING COUNT(*) > 4
ORDER  BY "Country"
LIMIT 20;
```

```sql
-- 4. All distinct billing countries appearing in invoices
SELECT DISTINCT "BillingCountry"
FROM   "invoices"
LIMIT 20;
```

```sql
-- 5. Join invoices to customers so we can double-check country counts in invoices
SELECT i."BillingCountry",
       COUNT(*)            AS "invoice_cnt",
       SUM(i."Total")      AS "sales_total"
FROM   "invoices"  AS i
JOIN   "customers" AS c
       ON i."CustomerId" = c."CustomerId"
GROUP  BY i."BillingCountry"
ORDER  BY "sales_total" DESC
LIMIT 20;
```

```sql
-- 6. Total sales per country, only for countries with >4 customers
WITH big_countries AS (
    SELECT "Country"
    FROM   "customers"
    GROUP  BY "Country"
    HAVING COUNT(*) > 4
)
SELECT i."BillingCountry"              AS "Country",
       SUM(i."Total")                  AS "total_sales"
FROM   "invoices" AS i
JOIN   big_countries  bc
       ON i."BillingCountry" = bc."Country"
GROUP  BY i."BillingCountry"
ORDER  BY "total_sales" DESC
LIMIT 20;
```

```sql
-- 7. Rank those country-level totals so we can compute a median
WITH big_countries AS (
    SELECT "Country"
    FROM   "customers"
    GROUP  BY "Country"
    HAVING COUNT(*) > 4
),
country_sales AS (
    SELECT i."BillingCountry" AS "Country",
           SUM(i."Total")     AS "total_sales"
    FROM   "invoices" AS i
    JOIN   big_countries bc
           ON i."BillingCountry" = bc."Country"
    GROUP  BY i."BillingCountry"
)
SELECT cs."Country",
       cs."total_sales",
       ROW_NUMBER() OVER (ORDER BY cs."total_sales") AS "rn",
       COUNT(*)  OVER ()                              AS "cnt"
FROM   country_sales cs
ORDER  BY cs."total_sales"
LIMIT 20;
```

```sql
-- 8. Compute the (possibly two) middle positions needed for the median
WITH big_countries AS (
    SELECT "Country"
    FROM   "customers"
    GROUP  BY "Country"
    HAVING COUNT(*) > 4
),
country_sales AS (
    SELECT i."BillingCountry" AS "Country",
           SUM(i."Total")     AS "total_sales"
    FROM   "invoices" AS i
    JOIN   big_countries bc
           ON i."BillingCountry" = bc."Country"
    GROUP  BY i."BillingCountry"
),
ordered_sales AS (
    SELECT cs."total_sales",
           ROW_NUMBER() OVER (ORDER BY cs."total_sales") AS "rn",
           COUNT(*)  OVER ()                              AS "cnt"
    FROM   country_sales cs
)
SELECT *
FROM   ordered_sales
WHERE  rn IN ( (cnt + 1) / 2,          -- lower middle for even, or the single middle for odd
               (cnt + 2) / 2 )         -- upper middle for even
ORDER BY rn
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: median of total sales made in countries with >4 customers
WITH big_countries AS (
    SELECT "Country"
    FROM   "customers"
    GROUP  BY "Country"
    HAVING COUNT(*) > 4
),
country_sales AS (
    SELECT i."BillingCountry" AS "Country",
           SUM(i."Total")     AS "total_sales"
    FROM   "invoices" AS i
    JOIN   big_countries bc
           ON i."BillingCountry" = bc."Country"
    GROUP  BY i."BillingCountry"
),
ordered_sales AS (
    SELECT cs."total_sales",
           ROW_NUMBER() OVER (ORDER BY cs."total_sales") AS "rn",
           COUNT(*)  OVER ()                              AS "cnt"
    FROM   country_sales cs
)
SELECT AVG("total_sales") AS "median_total_sales"
FROM   ordered_sales
WHERE  rn IN ( (cnt + 1) / 2,
               (cnt + 2) / 2 );
```

Run the last query to obtain the required single-number result—the median total-sales figure for all countries that have more than four customers.
