```sql
-- 1) See the list of different billing countries that appear in the Customers table
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
-- 2) How many customers does each country have?
SELECT "Country",
       COUNT(*) AS "customer_cnt"
FROM   "customers"
GROUP  BY "Country"
ORDER  BY "customer_cnt" DESC
LIMIT 20;
```

```sql
-- 3) Which countries have more than 4 customers?
SELECT "Country"
FROM   "customers"
GROUP  BY "Country"
HAVING COUNT(*) > 4
LIMIT 20;
```

```sql
-- 4) Look at the invoice totals together with their customers’ countries
SELECT i."InvoiceId",
       i."Total",
       c."Country"
FROM   "invoices" AS i
JOIN   "customers" AS c
       ON c."CustomerId" = i."CustomerId"
LIMIT 20;
```

```sql
-- 5) Invoice totals restricted to those countries that have > 4 customers
SELECT i."InvoiceId",
       i."Total",
       c."Country"
FROM   "invoices" AS i
JOIN   "customers" AS c
       ON c."CustomerId" = i."CustomerId"
WHERE  c."Country" IN (SELECT "Country"
                       FROM   "customers"
                       GROUP  BY "Country"
                       HAVING COUNT(*) > 4)
ORDER  BY i."Total"
LIMIT 20;
```

```sql
-- 6) Count the number of invoices that belong to the qualifying countries
SELECT COUNT(*) AS "invoice_cnt"
FROM   "invoices" AS i
JOIN   "customers" AS c
       ON c."CustomerId" = i."CustomerId"
WHERE  c."Country" IN (SELECT "Country"
                       FROM   "customers"
                       GROUP  BY "Country"
                       HAVING COUNT(*) > 4)
LIMIT 20;
```

```sql
-- 7) Attach a row number to each of those invoice totals in ascending order
SELECT i."Total",
       ROW_NUMBER() OVER (ORDER BY i."Total")        AS "rn",
       COUNT(*)  OVER ()                              AS "cnt"
FROM   "invoices" AS i
JOIN   "customers" AS c
       ON c."CustomerId" = i."CustomerId"
WHERE  c."Country" IN (SELECT "Country"
                       FROM   "customers"
                       GROUP  BY "Country"
                       HAVING COUNT(*) > 4)
ORDER  BY i."Total"
LIMIT 20;
```

```sql
-- 8) Final answer: the median value of total sales (invoice totals) made in countries with >4 customers
SELECT AVG("Total") AS "median_total_sales"
FROM (
       SELECT i."Total",
              ROW_NUMBER() OVER (ORDER BY i."Total")        AS "rn",
              COUNT(*)  OVER ()                              AS "cnt"
       FROM   "invoices" AS i
       JOIN   "customers" AS c
              ON c."CustomerId" = i."CustomerId"
       WHERE  c."Country" IN (SELECT "Country"
                              FROM   "customers"
                              GROUP  BY "Country"
                              HAVING COUNT(*) > 4)
     )
WHERE "rn" IN ( ( "cnt" + 1 ) / 2, ( "cnt" + 2 ) / 2 )
LIMIT 20;
```
