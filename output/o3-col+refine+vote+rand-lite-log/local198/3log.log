```sql
-- 1. Look at all distinct customer countries
SELECT DISTINCT "Country"
FROM "customers"
LIMIT 20;
```

```sql
-- 2. Count customers in every country (ordered, top 20 shown)
SELECT "Country",
       COUNT(*) AS "customer_count"
FROM   "customers"
GROUP  BY "Country"
ORDER  BY "customer_count" DESC
LIMIT 20;
```

```sql
-- 3. List countries that have more than 4 customers
SELECT DISTINCT "Country"
FROM   "customers"
GROUP  BY "Country"
HAVING COUNT(*) > 4
LIMIT 20;
```

```sql
-- 4. Inspect invoice totals together with their billing countries
SELECT "InvoiceId",
       "BillingCountry",
       "Total"
FROM   "invoices"
LIMIT 20;
```

```sql
-- 5. See invoice totals only for the countries that passed the >4-customers filter
SELECT i."InvoiceId",
       i."BillingCountry",
       i."Total"
FROM   "invoices" AS i
WHERE  i."BillingCountry" IN (
       SELECT c."Country"
       FROM   "customers" AS c
       GROUP  BY c."Country"
       HAVING COUNT(*) > 4)
LIMIT 20;
```

```sql
-- 6. Aggregate: total sales (sum of invoice totals) per country
SELECT i."BillingCountry"                   AS "Country",
       SUM(i."Total")                      AS "country_total_sales"
FROM   "invoices" AS i
WHERE  i."BillingCountry" IN (
       SELECT c."Country"
       FROM   "customers" AS c
       GROUP  BY c."Country"
       HAVING COUNT(*) > 4)
GROUP  BY i."BillingCountry"
ORDER  BY "country_total_sales" ASC
LIMIT 20;
```

```sql
-- 7. Add row numbers to those summed totals so it is easy to locate the median
WITH country_sales AS (
     SELECT i."BillingCountry" AS "Country",
            SUM(i."Total")     AS "country_total"
     FROM   "invoices" AS i
     WHERE  i."BillingCountry" IN (
            SELECT c."Country"
            FROM   "customers" AS c
            GROUP  BY c."Country"
            HAVING COUNT(*) > 4)
     GROUP  BY i."BillingCountry"
)
SELECT cs."Country",
       cs."country_total",
       ROW_NUMBER() OVER (ORDER BY cs."country_total")        AS rn,
       COUNT(*)    OVER ()                                    AS cnt
FROM   country_sales AS cs
ORDER  BY rn
LIMIT 20;
```

```sql
-- 8. Finally, compute the median of those country-level total sales
WITH country_sales AS (
     SELECT i."BillingCountry" AS "Country",
            SUM(i."Total")     AS "country_total"
     FROM   "invoices" AS i
     WHERE  i."BillingCountry" IN (
            SELECT c."Country"
            FROM   "customers" AS c
            GROUP  BY c."Country"
            HAVING COUNT(*) > 4)
     GROUP  BY i."BillingCountry"
),
ordered AS (
     SELECT cs."country_total",
            ROW_NUMBER() OVER (ORDER BY cs."country_total") AS rn,
            COUNT(*)    OVER ()                             AS cnt
     FROM   country_sales AS cs
)
SELECT AVG("country_total") AS "median_total_sales"
FROM   ordered
WHERE  rn IN ( (cnt + 1) / 2, (cnt + 2) / 2 );
```
