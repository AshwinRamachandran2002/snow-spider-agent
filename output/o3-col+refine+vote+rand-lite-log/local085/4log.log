```sql
--Description: List distinct employee IDs that have at least one order
SELECT DISTINCT employeeid
FROM orders
LIMIT 20;
```

```sql
--Description: Count the total number of orders handled by each employee
SELECT employeeid,
       COUNT(*) AS total_orders
FROM orders
GROUP BY employeeid
LIMIT 20;
```

```sql
--Description: Count late orders (shippeddate ≥ requireddate) for every employee
SELECT employeeid,
       COUNT(*) AS late_orders
FROM orders
WHERE shippeddate IS NOT NULL
  AND requireddate IS NOT NULL
  AND shippeddate >= requireddate
GROUP BY employeeid
LIMIT 20;
```

```sql
--Description: Combine total-order counts with late-order counts for each employee
SELECT t.employeeid,
       t.total_orders,
       COALESCE(l.late_orders, 0) AS late_orders
FROM ( SELECT employeeid,
              COUNT(*) AS total_orders
       FROM orders
       GROUP BY employeeid ) AS t
LEFT JOIN ( SELECT employeeid,
                   COUNT(*) AS late_orders
            FROM orders
            WHERE shippeddate IS NOT NULL
              AND requireddate IS NOT NULL
              AND shippeddate >= requireddate
            GROUP BY employeeid ) AS l
  ON t.employeeid = l.employeeid
LIMIT 20;
```

```sql
--Description: Compute late-order percentage for every employee
SELECT t.employeeid,
       l.late_orders,
       t.total_orders,
       (CAST(l.late_orders AS REAL) / t.total_orders) * 100 AS late_percentage
FROM ( SELECT employeeid,
              COUNT(*) AS total_orders
       FROM orders
       GROUP BY employeeid ) AS t
JOIN ( SELECT employeeid,
              COUNT(*) AS late_orders
       FROM orders
       WHERE shippeddate IS NOT NULL
         AND requireddate IS NOT NULL
         AND shippeddate >= requireddate
       GROUP BY employeeid ) AS l
  ON t.employeeid = l.employeeid
LIMIT 20;
```

```sql
--Description: Restrict to employees with more than 50 total orders and show their late-order metrics
SELECT t.employeeid,
       l.late_orders,
       t.total_orders,
       (CAST(l.late_orders AS REAL) / t.total_orders) * 100 AS late_percentage
FROM ( SELECT employeeid,
              COUNT(*) AS total_orders
       FROM orders
       GROUP BY employeeid
       HAVING COUNT(*) > 50 ) AS t
JOIN ( SELECT employeeid,
              COUNT(*) AS late_orders
       FROM orders
       WHERE shippeddate IS NOT NULL
         AND requireddate IS NOT NULL
         AND shippeddate >= requireddate
       GROUP BY employeeid ) AS l
  ON t.employeeid = l.employeeid
LIMIT 20;
```

```sql
--Description: Final answer – top 3 employees (among those with >50 orders) ranked by highest late-order percentage
SELECT t.employeeid                           AS employee_id,
       l.late_orders                          AS late_order_count,
       ROUND( (CAST(l.late_orders AS REAL) /
               t.total_orders) * 100, 2)      AS late_order_percentage
FROM ( SELECT employeeid,
              COUNT(*) AS total_orders
       FROM orders
       GROUP BY employeeid
       HAVING COUNT(*) > 50 ) AS t
JOIN ( SELECT employeeid,
              COUNT(*) AS late_orders
       FROM orders
       WHERE shippeddate IS NOT NULL
         AND requireddate IS NOT NULL
         AND shippeddate >= requireddate
       GROUP BY employeeid ) AS l
  ON t.employeeid = l.employeeid
ORDER BY late_order_percentage DESC
LIMIT 3;
```
