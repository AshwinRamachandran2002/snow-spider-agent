--Description: Final answer – top 3 employees (among those with >50 orders) ranked by highest late-order percentage
SELECT t.employeeid                           AS employee_id,
       l.late_orders                          AS late_order_count,
       ROUND( (CAST(l.late_orders AS REAL) /
               t.total_orders) * 100, 2)      AS late_order_percentage
FROM ( SELECT employeeid,
              COUNT(*) AS total_orders
       FROM orders
       GROUP BY employeeid
       HAVING COUNT(*) > 50 ) AS t
JOIN ( SELECT employeeid,
              COUNT(*) AS late_orders
       FROM orders
       WHERE shippeddate IS NOT NULL
         AND requireddate IS NOT NULL
         AND shippeddate >= requireddate
       GROUP BY employeeid ) AS l
  ON t.employeeid = l.employeeid
ORDER BY late_order_percentage DESC
LIMIT 3;
