-- Description: Attach employee names to the top-3 result for a friendlier final list
SELECT  e."employeeid",
        e."firstname" || ' ' || e."lastname"            AS "employee_name",
        r."late_orders",
        r."late_pct"
FROM (
        SELECT  t."employeeid",
                t."late_orders",
                ROUND(100.0 * t."late_orders" / t."total_orders", 2) AS "late_pct"
        FROM (
                SELECT  o."employeeid",
                        COUNT(*) AS "total_orders",
                        SUM(CASE
                                WHEN o."shippeddate" IS NOT NULL
                                 AND o."requireddate" IS NOT NULL
                                 AND o."shippeddate" >= o."requireddate"
                             THEN 1 ELSE 0 END) AS "late_orders"
                FROM "orders" AS o
                GROUP BY o."employeeid"
                HAVING "total_orders" > 50
             ) AS t
        ORDER BY "late_pct" DESC
        LIMIT 3
     ) AS r
JOIN "employees" AS e
     ON e."employeeid" = r."employeeid";
