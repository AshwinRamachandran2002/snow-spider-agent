```sql
-- Description: Look at raw order records to understand the three date columns involved
SELECT "orderid", "employeeid", "orderdate", "requireddate", "shippeddate"
FROM "orders"
LIMIT 20;
```

```sql
-- Description: See which employees appear in the Orders table
SELECT DISTINCT "employeeid"
FROM "orders"
LIMIT 20;
```

```sql
-- Description: Count total orders handled by each employee
SELECT "employeeid",
       COUNT(*) AS "total_orders"
FROM "orders"
GROUP BY "employeeid"
ORDER BY "total_orders" DESC
LIMIT 20;
```

```sql
-- Description: Keep only employees who have handled more than 50 orders
SELECT "employeeid",
       COUNT(*) AS "total_orders"
FROM "orders"
GROUP BY "employeeid"
HAVING "total_orders" > 50
ORDER BY "total_orders" DESC;
```

```sql
-- Description: For every employee, count how many of their orders are late
SELECT "employeeid",
       SUM(CASE
               WHEN "shippeddate" IS NOT NULL
                AND "requireddate" IS NOT NULL
                AND "shippeddate" >= "requireddate"
               THEN 1 ELSE 0 END) AS "late_orders"
FROM "orders"
GROUP BY "employeeid"
LIMIT 20;
```

```sql
-- Description: Combine the total-orders count with late-orders count for employees with > 50 orders
SELECT  o."employeeid",
        COUNT(*)                                      AS "total_orders",
        SUM(CASE
                WHEN o."shippeddate" IS NOT NULL
                 AND o."requireddate" IS NOT NULL
                 AND o."shippeddate" >= o."requireddate"
             THEN 1 ELSE 0 END)                      AS "late_orders"
FROM "orders" AS o
GROUP BY o."employeeid"
HAVING "total_orders" > 50;
```

```sql
-- Description: Add a late-order percentage and rank by that percentage
SELECT  t."employeeid",
        t."late_orders",
        ROUND(100.0 * t."late_orders" / t."total_orders", 2) AS "late_pct"
FROM (
        SELECT  o."employeeid",
                COUNT(*) AS "total_orders",
                SUM(CASE
                        WHEN o."shippeddate" IS NOT NULL
                         AND o."requireddate" IS NOT NULL
                         AND o."shippeddate" >= o."requireddate"
                     THEN 1 ELSE 0 END) AS "late_orders"
        FROM "orders" AS o
        GROUP BY o."employeeid"
        HAVING "total_orders" > 50
     ) AS t
ORDER BY "late_pct" DESC
LIMIT 3;
```

```sql
-- Description: Attach employee names to the top-3 result for a friendlier final list
SELECT  e."employeeid",
        e."firstname" || ' ' || e."lastname"            AS "employee_name",
        r."late_orders",
        r."late_pct"
FROM (
        SELECT  t."employeeid",
                t."late_orders",
                ROUND(100.0 * t."late_orders" / t."total_orders", 2) AS "late_pct"
        FROM (
                SELECT  o."employeeid",
                        COUNT(*) AS "total_orders",
                        SUM(CASE
                                WHEN o."shippeddate" IS NOT NULL
                                 AND o."requireddate" IS NOT NULL
                                 AND o."shippeddate" >= o."requireddate"
                             THEN 1 ELSE 0 END) AS "late_orders"
                FROM "orders" AS o
                GROUP BY o."employeeid"
                HAVING "total_orders" > 50
             ) AS t
        ORDER BY "late_pct" DESC
        LIMIT 3
     ) AS r
JOIN "employees" AS e
     ON e."employeeid" = r."employeeid";
```

These queries step from raw inspection to the final answer (top three employees—by late–order percentage—who have handled more than 50 orders), showing each employee’s ID, the number of late orders, and the percentage of orders that were late.
