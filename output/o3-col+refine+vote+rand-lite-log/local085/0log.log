```sql
--Description: Retrieve all unique employee IDs which appear in the Orders table
SELECT DISTINCT "employeeid"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Inspect a handful of orders to understand date fields (OrderDate, RequiredDate, ShippedDate)
SELECT "orderid",
       "employeeid",
       "orderdate",
       "requireddate",
       "shippeddate"
FROM "orders"
LIMIT 20;
```

```sql
--Description: Count total number of orders handled by every employee
SELECT "employeeid",
       COUNT(*) AS "total_orders"
FROM "orders"
GROUP BY "employeeid"
ORDER BY "total_orders" DESC
LIMIT 20;
```

```sql
--Description: Determine how many orders per employee were shipped on/after the RequiredDate (late orders)
SELECT "employeeid",
       SUM(CASE
               WHEN "shippeddate" IS NOT NULL
                AND "shippeddate" >= "requireddate"
               THEN 1 ELSE 0 END) AS "late_orders"
FROM "orders"
GROUP BY "employeeid"
ORDER BY "late_orders" DESC
LIMIT 20;
```

```sql
--Description: Identify employees who have processed more than 50 total orders
SELECT "employeeid"
FROM "orders"
GROUP BY "employeeid"
HAVING COUNT(*) > 50
ORDER BY COUNT(*) DESC
LIMIT 20;
```

```sql
--Description: For each employee, calculate total orders, late orders, and the late-order percentage
SELECT  "employeeid",
        COUNT(*)                                                AS "total_orders",
        SUM(CASE
                WHEN "shippeddate" IS NOT NULL
                 AND "shippeddate" >= "requireddate"
                THEN 1 ELSE 0 END)                             AS "late_orders",
        ROUND(100.0 * SUM(CASE
                              WHEN "shippeddate" IS NOT NULL
                               AND "shippeddate" >= "requireddate"
                              THEN 1 ELSE 0 END) / COUNT(*),2) AS "late_percentage"
FROM "orders"
GROUP BY "employeeid"
HAVING COUNT(*) > 50
ORDER BY "late_percentage" DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – top three employees (with >50 orders) having the highest percentage of late orders
SELECT  "employeeid",
        SUM(CASE
                WHEN "shippeddate" IS NOT NULL
                 AND "shippeddate" >= "requireddate"
                THEN 1 ELSE 0 END)                             AS "late_orders",
        ROUND(100.0 * SUM(CASE
                              WHEN "shippeddate" IS NOT NULL
                               AND "shippeddate" >= "requireddate"
                              THEN 1 ELSE 0 END) / COUNT(*),2) AS "late_percentage"
FROM "orders"
GROUP BY "employeeid"
HAVING COUNT(*) > 50
ORDER BY "late_percentage" DESC
LIMIT 3;
```
