--Description: 
-- 6.  Calculate allele statistics for AFR using the same mock dataset
WITH afr_calls AS (
  SELECT * FROM UNNEST([
    STRUCT('1' AS reference_name, 8737865 AS start,
           'HG00096' AS sample, [0,1] AS genotype),
    STRUCT('1', 8737865, 'HG00097', [1,1]),
    STRUCT('2',43580463,'HG00096',[0,0])
  ])
)
SELECT reference_name,
       start,
       COUNT(DISTINCT sample)                                        AS sample_cnt,
       SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g))               AS alt_allele_cnt,
       2*COUNT(DISTINCT sample)                                      AS total_alleles,
       SAFE_DIVIDE(SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g)),
                   2*COUNT(DISTINCT sample))                         AS allele_freq
FROM afr_calls
GROUP BY 1,2
LIMIT 20
