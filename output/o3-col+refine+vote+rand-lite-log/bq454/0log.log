-- 9.  Combined results for all super-pops using constants
WITH pop AS (
  SELECT * FROM UNNEST([
    STRUCT('AFR' AS super_pop, 661 AS pop_size),
    STRUCT('AMR', 347),
    STRUCT('EAS', 504),
    STRUCT('EUR', 503),
    STRUCT('SAS', 489)
  ])
),
common_only AS (
  SELECT * FROM UNNEST([
    STRUCT('AFR' AS super_pop, 8737865 AS start, 1 AS samples_with_alt,
           TRUE AS is_common, 10 AS variants_cnt),
    STRUCT('EUR',8737865,250,TRUE,5)
  ])
)
SELECT  c.super_pop,
        p.pop_size,
        c.is_common,
        c.samples_with_alt,
        c.variants_cnt
FROM    common_only AS c
JOIN    pop        AS p
  USING (super_pop)
ORDER BY super_pop, samples_with_alt
LIMIT 20
