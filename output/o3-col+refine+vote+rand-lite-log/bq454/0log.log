```sql
--Description: 
-- 9.  Combined results for all super-pops using constants
WITH pop AS (
  SELECT * FROM UNNEST([
    STRUCT('AFR' AS super_pop, 661 AS pop_size),
    STRUCT('AMR', 347),
    STRUCT('EAS', 504),
    STRUCT('EUR', 503),
    STRUCT('SAS', 489)
  ])
),
common_only AS (
