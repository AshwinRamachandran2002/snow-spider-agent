Below is a step-by-step exploration (10 queries) that ends with a complete answer.  
All queries use the 1000 Genomes tables that are available in  
`spider2-public-data.1000_genomes`.

```sql
-- 1.  Inspect the 1000 Genomes sample list and verify the five super–populations
SELECT DISTINCT `Super_Population`
FROM   `spider2-public-data.1000_genomes.sample_info`
ORDER  BY 1;
```

```sql
-- 2.  See how many samples belong to every super–population (population size)
SELECT  `Super_Population`,
        COUNT(DISTINCT `Sample`)          AS pop_size
FROM    `spider2-public-data.1000_genomes.sample_info`
GROUP BY 1
ORDER BY 1
LIMIT 20;
```

```sql
-- 3.  Glimpse autosomal variants only (chromosomes 1–22)
SELECT  `reference_name`, `start`, `alternate_bases`
FROM    `spider2-public-data.1000_genomes.variants`
WHERE   `reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
LIMIT 20;
```

```sql
-- 4.  Expand one variant’s calls to inspect genotype arrays
SELECT  v.`reference_name`, v.`start`,
        c.`call_set_name`  AS sample,
        c.`genotype`
FROM    `spider2-public-data.1000_genomes.variants`    AS v,
        UNNEST(v.`call`)                              AS c
WHERE   v.`reference_name` = '1'
LIMIT 20;
```

```sql
-- 5.  For a small slice, join calls with sample_info and
--     decide whether each sample carries ≥1 alternate allele
SELECT  c.`call_set_name`       AS sample,
        s.`Super_Population`,
        v.`reference_name`,
        v.`start`,
        ( SELECT COUNTIF(g>0) FROM UNNEST(c.`genotype`) AS g ) > 0  AS has_alt
FROM    `spider2-public-data.1000_genomes.variants`    AS v,
        UNNEST(v.`call`)                              AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
        ON s.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` = '2'
LIMIT 20;
```

```sql
-- 6.  Still limited data: calculate, for AFR only, allele-count,
--     sample-count and allele-frequency for a handful of variants
SELECT  v.`reference_name`, v.`start`,
        COUNT(DISTINCT c.`call_set_name`)                    AS sample_cnt,
        SUM( (SELECT SUM(g) FROM UNNEST(c.`genotype`) AS g) ) AS alt_allele_cnt,
        2 * COUNT(DISTINCT c.`call_set_name`)                AS total_alleles,
        SAFE_DIVIDE(SUM( (SELECT SUM(g) FROM UNNEST(c.`genotype`) AS g) ),
                    2 * COUNT(DISTINCT c.`call_set_name`))   AS allele_freq
FROM    `spider2-public-data.1000_genomes.variants`    AS v,
        UNNEST(v.`call`)                              AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
        ON s.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` IN ('1','2','3')            -- small slice
  AND   s.`Super_Population` = 'AFR'
  AND   (SELECT COUNTIF(g>0) FROM UNNEST(c.`genotype`) AS g) > 0   -- carries alt
GROUP BY 1,2
LIMIT 20;
```

```sql
-- 7.  For one super-population (EUR) show, per variant, whether it is common
--     (allele frequency ≥0.05) and how many EUR samples share it
WITH eur_size AS (
  SELECT COUNT(DISTINCT `Sample`) AS n
  FROM   `spider2-public-data.1000_genomes.sample_info`
  WHERE  `Super_Population` = 'EUR'
)
SELECT  v.`reference_name`, v.`start`,
        COUNT(DISTINCT c.`call_set_name`)                     AS samples_with_alt,
        SUM( (SELECT SUM(g) FROM UNNEST(c.`genotype`) AS g) ) AS alt_alleles,
        2 * (SELECT n FROM eur_size)                          AS total_alleles_in_pop,
        SAFE_DIVIDE(
          SUM( (SELECT SUM(g) FROM UNNEST(c.`genotype`) AS g) ),
          2 * (SELECT n FROM eur_size)
        )                                                     AS allele_freq,
        SAFE_DIVIDE(
          SUM( (SELECT SUM(g) FROM UNNEST(c.`genotype`) AS g) ),
          2 * (SELECT n FROM eur_size)
        )  >= 0.05                                            AS is_common
FROM    `spider2-public-data.1000_genomes.variants`    AS v,
        UNNEST(v.`call`)                              AS c
JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
        ON s.`Sample` = c.`call_set_name`
WHERE   v.`reference_name` IN UNNEST(GENERATE_ARRAY(1,22))      -- autosomes only
  AND   s.`Super_Population` = 'EUR'
  AND   (SELECT COUNTIF(g>0) FROM UNNEST(c.`genotype`) AS g) > 0
GROUP BY 1,2
LIMIT 20;
```

```sql
-- 8.  Count, inside EUR, how many variants are shared by each specific
--     number of EUR samples (only COMMON variants kept)
WITH eur_size AS (
  SELECT COUNT(DISTINCT `Sample`) AS n
  FROM   `spider2-public-data.1000_genomes.sample_info`
  WHERE  `Super_Population` = 'EUR'
),
per_variant AS (
  SELECT  v.`reference_name`, v.`start`,
          COUNT(DISTINCT c.`call_set_name`)                     AS samples_with_alt,
          SUM( (SELECT SUM(g) FROM UNNEST(c.`genotype`) AS g) ) AS alt_alleles
  FROM    `spider2-public-data.1000_genomes.variants`    AS v,
          UNNEST(v.`call`)                              AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
          ON s.`Sample` = c.`call_set_name`
  WHERE   v.`reference_name` IN UNNEST(GENERATE_ARRAY(1,22))
    AND   s.`Super_Population` = 'EUR'
    AND   (SELECT COUNTIF(g>0) FROM UNNEST(c.`genotype`) AS g) > 0
  GROUP BY 1,2
  HAVING  SAFE_DIVIDE(alt_alleles, 2 * (SELECT n FROM eur_size)) >= 0.05   -- common
)
SELECT  (SELECT n FROM eur_size)                                AS pop_size,
        TRUE                                                    AS is_common,
        samples_with_alt,
        COUNT(*)                                                AS variants_cnt
FROM    per_variant
GROUP BY samples_with_alt
ORDER BY samples_with_alt
LIMIT 20;
```

```sql
-- 9.  Put everything together for ALL super-populations
WITH pop AS (
  SELECT  `Super_Population`            AS super_pop,
          COUNT(DISTINCT `Sample`)      AS pop_size
  FROM    `spider2-public-data.1000_genomes.sample_info`
  GROUP BY 1
),
per_var_pop AS (      -- stats per variant & super-population
  SELECT  s.`Super_Population`                      AS super_pop,
          v.`reference_name`, v.`start`,
          COUNT(DISTINCT c.`call_set_name`)         AS samples_with_alt,
          SUM( (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )   AS alt_alleles
  FROM    `spider2-public-data.1000_genomes.variants` AS v,
          UNNEST(v.call)                              AS c
  JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
          ON s.Sample = c.call_set_name
  WHERE   v.reference_name IN UNNEST(GENERATE_ARRAY(1,22))   -- autosomes
    AND   (SELECT COUNTIF(g>0) FROM UNNEST(c.genotype) AS g) > 0
  GROUP BY 1,2,3
),
common_only AS (      -- keep only common variants in each super-pop
  SELECT  p.super_pop,
          p.reference_name,
          p.start,
          p.samples_with_alt,
          p.alt_alleles,
          ( 2 * pop.pop_size )                              AS total_alleles,
          SAFE_DIVIDE(p.alt_alleles, 2 * pop.pop_size)      AS allele_freq,
          SAFE_DIVIDE(p.alt_alleles, 2 * pop.pop_size) >= 0.05 AS is_common
  FROM    per_var_pop AS p
  JOIN    pop          USING (super_pop)
  WHERE   SAFE_DIVIDE(p.alt_alleles, 2 * pop.pop_size) >= 0.05
)
SELECT  super_pop,
        pop_size,
        is_common,
        samples_with_alt,
        COUNT(*)                 AS variants_cnt
FROM    common_only
JOIN    pop USING (super_pop)
GROUP BY 1,2,3,4
ORDER BY super_pop, samples_with_alt
LIMIT 20;
```

```sql
-- 10.  (Final answer)  Show full distribution without LIMIT
SELECT  super_pop               AS super_population,
        pop_size,
        is_common,              -- always TRUE here (we kept only common)
        samples_with_alt        AS num_samples_with_variant,
        COUNT(*)                AS variants_shared_by_that_many_samples
FROM  (
  -- identical common_only CTE from Query 9
  WITH pop AS (
    SELECT  `Super_Population`     AS super_pop,
            COUNT(DISTINCT `Sample`) AS pop_size
    FROM    `spider2-public-data.1000_genomes.sample_info`
    GROUP BY 1
  ),
  per_var_pop AS (
    SELECT  s.`Super_Population`          AS super_pop,
            v.`reference_name`, v.`start`,
            COUNT(DISTINCT c.`call_set_name`)                     AS samples_with_alt,
            SUM( (SELECT SUM(g) FROM UNNEST(c.genotype) AS g) )   AS alt_alleles
    FROM    `spider2-public-data.1000_genomes.variants` AS v,
            UNNEST(v.call)                             AS c
    JOIN    `spider2-public-data.1000_genomes.sample_info` AS s
            ON s.Sample = c.call_set_name
    WHERE   v.reference_name IN UNNEST(GENERATE_ARRAY(1,22))       -- autosomes
      AND   (SELECT COUNTIF(g>0) FROM UNNEST(c.genotype) AS g) > 0
    GROUP BY 1,2,3
  )
  SELECT  p.super_pop,
          pv.reference_name,
          pv.start,
          pv.samples_with_alt,
          pv.alt_alleles,
          (2 * pop.pop_size)                            AS total_alleles,
          SAFE_DIVIDE(pv.alt_alleles, 2 * pop.pop_size) AS allele_freq,
          SAFE_DIVIDE(pv.alt_alleles, 2 * pop.pop_size) >= 0.05 AS is_common,
          pop.pop_size
  FROM    per_var_pop AS pv
  JOIN    pop         AS pop
    ON    pop.super_pop = pv.super_pop
  WHERE   SAFE_DIVIDE(pv.alt_alleles, 2 * pop.pop_size) >= 0.05
)
GROUP BY super_population, pop_size, is_common, num_samples_with_variant
ORDER BY super_population, num_samples_with_variant;
```

Explanation of the final query
• Autosomal variants only (`reference_name` ∈ 1-22).  
• A sample is counted if **any** allele in its `genotype` array is > 0.  
• Allele frequency = alt-allele-count / (2 × population-size).  
• `is_common` is TRUE when allele-frequency ≥ 0.05.  
• For every super-population we group common variants by the number of
  samples that share them and report how many such variants there are.
