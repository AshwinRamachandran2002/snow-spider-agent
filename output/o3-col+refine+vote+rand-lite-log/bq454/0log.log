```sql
--Description: 
-- 5.  Mock join of variants with sample_info to flag alt-carriers
WITH calls AS (
  SELECT * FROM UNNEST([
    STRUCT('HG00096' AS sample, 'AFR' AS Super_Population,
           '1' AS reference_name, 8737865 AS start, [0,1] AS genotype),
    STRUCT('HG00101','EUR','1',8737865,[1,1]),
    STRUCT('HG00102','EAS','1',8737865,[0,0])
  ])
)
SELECT sample,
       Super_Population,
       reference_name,
       start,
       (SELECT COUNTIF(g>0) FROM UNNEST(genotype) AS g) > 0 AS has_alt
FROM calls
LIMIT 20;
```

```sql
--Description: 
-- 6.  Calculate allele statistics for AFR using the same mock dataset
WITH afr_calls AS (
  SELECT * FROM UNNEST([
    STRUCT('1' AS reference_name, 8737865 AS start,
           'HG00096' AS sample, [0,1] AS genotype),
    STRUCT('1', 8737865, 'HG00097', [1,1]),
    STRUCT('2',43580463,'HG00096',[0,0])
  ])
)
SELECT reference_name,
       start,
       COUNT(DISTINCT sample)                                        AS sample_cnt,
       SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g))               AS alt_allele_cnt,
       2*COUNT(DISTINCT sample)                                      AS total_alleles,
       SAFE_DIVIDE(SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g)),
                   2*COUNT(DISTINCT sample))                         AS allele_freq
FROM afr_calls
GROUP BY 1,2
LIMIT 20;
```

```sql
--Description: 
-- 7.  EUR variant commonness – use inline data plus EUR size (=503)
WITH eur_size AS (SELECT 503 AS n),
mock_calls AS (
  SELECT * FROM UNNEST([
    STRUCT('1' AS reference_name,8737865 AS start,'HG00101' AS sample,[1,0] AS genotype),
    STRUCT('1',8737865,'HG00102',[0,1]),
    STRUCT('1',8737865,'HG00103',[0,0])
  ])
)
SELECT reference_name,
       start,
       COUNT(DISTINCT sample)                                         AS samples_with_alt,
       SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g))                AS alt_alleles,
       2*(SELECT n FROM eur_size)                                     AS total_alleles_in_pop,
       SAFE_DIVIDE(SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g)),
                   2*(SELECT n FROM eur_size))                        AS allele_freq,
       SAFE_DIVIDE(SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g)),
                   2*(SELECT n FROM eur_size)) >= 0.05                AS is_common
FROM mock_calls
GROUP BY 1,2
LIMIT 20;
```

```sql
