       start,
       COUNT(DISTINCT sample)                                         AS samples_with_alt,
       SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g))                AS alt_alleles,
       2*(SELECT n FROM eur_size)                                     AS total_alleles_in_pop,
       SAFE_DIVIDE(SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g)),
                   2*(SELECT n FROM eur_size))                        AS allele_freq,
       SAFE_DIVIDE(SUM((SELECT SUM(g) FROM UNNEST(genotype) AS g)),
                   2*(SELECT n FROM eur_size)) >= 0.05                AS is_common
FROM mock_calls
GROUP BY 1,2
LIMIT 20
