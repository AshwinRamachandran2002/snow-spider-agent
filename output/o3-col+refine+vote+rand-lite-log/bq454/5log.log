  SUM(has_alt)                         AS alt_samples,
  COUNT(*)                             AS pop_samples,
  SAFE_DIVIDE(SUM(has_alt), COUNT(*))  AS sample_freq
FROM joined
GROUP BY reference_name, start, Super_Population
LIMIT 20;
