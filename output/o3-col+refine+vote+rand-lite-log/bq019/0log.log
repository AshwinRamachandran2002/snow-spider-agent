```sql
-- 1. Peek at a handful of 2014 inpatient-charges rows
SELECT *
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
LIMIT 20;
```

```sql
-- 2. See a few distinct DRG definitions that exist in the 2014 table
SELECT DISTINCT drg_definition
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
LIMIT 20;
```

```sql
-- 3. Aggregate discharges by DRG to understand overall volumes
SELECT drg_definition,
       SUM(total_discharges) AS total_discharges
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
GROUP BY drg_definition
LIMIT 20;
```

```sql
-- 4. Which DRGs have the most discharges?  (top 10)
SELECT drg_definition,
       SUM(total_discharges) AS total_discharges
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
GROUP BY drg_definition
ORDER BY total_discharges DESC
LIMIT 10;
```

```sql
-- 5. Identify the single DRG with the highest number of discharges
SELECT drg_definition
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
GROUP BY drg_definition
ORDER BY SUM(total_discharges) DESC
LIMIT 1;
```

```sql
-- 6. For that top-volume DRG, see total discharges by city
WITH top_drg AS (
  SELECT drg_definition
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
  ORDER BY SUM(total_discharges) DESC
  LIMIT 1
)
SELECT provider_city,
       SUM(total_discharges) AS city_discharges
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014` t
JOIN top_drg d
  ON t.drg_definition = d.drg_definition
GROUP BY provider_city
ORDER BY city_discharges DESC
LIMIT 20;
```

```sql
-- 7. Calculate weighted average total payments (payments weighted by discharges)
--    for every city on the top DRG
WITH top_drg AS (
  SELECT drg_definition
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
  ORDER BY SUM(total_discharges) DESC
  LIMIT 1
)
SELECT provider_city,
       SUM(total_discharges)                                          AS city_discharges,
       SUM(average_total_payments * total_discharges)
/ SUM(total_discharges)                                               AS weighted_avg_payment
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014` t
JOIN top_drg d
  ON t.drg_definition = d.drg_definition
GROUP BY provider_city
LIMIT 20;
```

```sql
-- 8. Restrict to the three cities with the most discharges on that DRG
WITH top_drg AS (
  SELECT drg_definition
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
  ORDER BY SUM(total_discharges) DESC
  LIMIT 1
),
city_agg AS (
  SELECT provider_city,
         SUM(total_discharges)                           AS city_discharges,
         SUM(average_total_payments * total_discharges)  AS pay_weighted
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014` t
  JOIN top_drg d
    ON t.drg_definition = d.drg_definition
  GROUP BY provider_city
)
SELECT provider_city,
       city_discharges,
       pay_weighted / city_discharges AS weighted_avg_payment
FROM city_agg
ORDER BY city_discharges DESC
LIMIT 3;
```

```sql
-- 9. FINAL ANSWER: the top-volume DRG and the weighted average total payments
--                 for the three cities with the most discharges
WITH
top_drg AS (
  SELECT drg_definition
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
  ORDER BY SUM(total_discharges) DESC
  LIMIT 1
),
city_stats AS (
  SELECT provider_city,
         SUM(total_discharges)                           AS city_discharges,
         SUM(average_total_payments * total_discharges)  AS pay_weighted
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014` t
  JOIN top_drg d
    ON t.drg_definition = d.drg_definition
  GROUP BY provider_city
),
top3 AS (
  SELECT *
  FROM city_stats
  ORDER BY city_discharges DESC
  LIMIT 3
)
SELECT (SELECT drg_definition FROM top_drg)                    AS top_drg_definition,
       provider_city,
       city_discharges,
       ROUND(pay_weighted / city_discharges, 2)                AS weighted_avg_total_payments
FROM top3
ORDER BY city_discharges DESC;
```
