```sql
-- 5) Substitute the result from #4 in the WHERE-clause below
--    to see how discharges are distributed across cities
SELECT
  provider_city,
  SUM(total_discharges) AS total_discharges_city
FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
WHERE drg_definition = '470 - MAJOR JOINT REPLACEMENT OR REATTACHMENT OF LOWER EXTREMITY W/O MCC'
GROUP BY provider_city
ORDER BY total_discharges_city DESC
LIMIT 20;
```

```sql
-- 6) Pull just the TOP-3 cities (by discharge volume) for that DRG
SELECT
  provider_city,
  SUM(total_discharges) AS total_discharges_city
FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
WHERE drg_definition = '470 - MAJOR JOINT REPLACEMENT OR REATTACHMENT OF LOWER EXTREMITY W/O MCC'
GROUP BY provider_city
ORDER BY total_discharges_city DESC
LIMIT 3;
```

```sql
-- 7) Compute the weighted-average total payments
--    ( Σ(payments * discharges) / Σ(discharges) ) for EACH of those three cities
SELECT
  provider_city,
  SUM(total_discharges * average_total_payments) / SUM(total_discharges) AS weighted_avg_total_payments,
  SUM(total_discharges)                                               AS total_discharges_city
FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
WHERE drg_definition = '470 - MAJOR JOINT REPLACEMENT OR REATTACHMENT OF LOWER EXTREMITY W/O MCC'
  AND provider_city IN (
        SELECT provider_city
        FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
        WHERE drg_definition = '470 - MAJOR JOINT REPLACEMENT OR REATTACHMENT OF LOWER EXTREMITY W/O MCC'
        GROUP BY provider_city
        ORDER BY SUM(total_discharges) DESC
        LIMIT 3
      )
GROUP BY provider_city
ORDER BY total_discharges_city DESC;
```

```sql
-- 8) (Optional check) Display results rounded to nearest dollar
SELECT
  provider_city,
  ROUND( SUM(total_discharges * average_total_payments) / SUM(total_discharges) , 0 ) AS weighted_avg_total_payments
FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
WHERE drg_definition = '470 - MAJOR JOINT REPLACEMENT OR REATTACHMENT OF LOWER EXTREMITY W/O MCC'
GROUP BY provider_city
ORDER BY SUM(total_discharges) DESC
LIMIT 3;
```

```sql
-- 9) Everything tied together (no LIMIT) — final answer query
SELECT
  drg_definition                                            AS top_drg_definition,
  provider_city,
  SUM(total_discharges)                                    AS city_total_discharges,
  ROUND( SUM(total_discharges * average_total_payments)
        / SUM(total_discharges), 2)                       AS weighted_avg_total_payments
FROM (
  SELECT
    drg_definition,
    provider_city,
    total_discharges,
    average_total_payments
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
)
WHERE drg_definition = (
  SELECT drg_definition
  FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
  ORDER BY SUM(total_discharges) DESC
  LIMIT 1
)
GROUP BY drg_definition, provider_city
ORDER BY city_total_discharges DESC
LIMIT 3;
```

```sql
-- 10) Verify that the DRG chosen really is #1 in total discharges (sanity check)
SELECT
  drg_definition,
  SUM(total_discharges) AS total_discharges_all_providers
FROM  `bigquery-public-data.cms_medicare.inpatient_charges_2014`
GROUP BY drg_definition
ORDER BY total_discharges_all_providers DESC
LIMIT 5;
```

