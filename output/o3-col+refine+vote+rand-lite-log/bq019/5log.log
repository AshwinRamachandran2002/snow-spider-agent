```sql
--Description: Peek at 20 random rows from the 2014 inpatient-charges file to get a feel for the data.
SELECT *
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
LIMIT 20;
```

```sql
--Description: How many distinct DRG definitions appear in the 2014 file?
SELECT COUNT(DISTINCT drg_definition) AS distinct_drg_definitions
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
LIMIT 20;
```

```sql
--Description: Rank DRG definitions by total discharges (across all providers & cities).
SELECT
  drg_definition,
  SUM(total_discharges) AS total_discharges_all
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
GROUP BY drg_definition
ORDER BY total_discharges_all DESC
LIMIT 20;
```

```sql
--Description: Identify the single DRG definition with the MOST discharges.
SELECT
  drg_definition,
  SUM(total_discharges) AS total_discharges_all
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
GROUP BY drg_definition
ORDER BY total_discharges_all DESC
LIMIT 1;
```

```sql
--Description: For that top DRG, list all provider cities ranked by their total discharges.
WITH top_drg AS (
  SELECT drg_definition
  FROM (
    SELECT
      drg_definition,
      SUM(total_discharges) AS total_discharges_all
    FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
    GROUP BY drg_definition
    ORDER BY total_discharges_all DESC
    LIMIT 1
  )
)
SELECT
  ic.provider_city,
  SUM(ic.total_discharges) AS city_total_discharges
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014` AS ic
JOIN top_drg
ON ic.drg_definition = top_drg.drg_definition
GROUP BY ic.provider_city
ORDER BY city_total_discharges DESC
LIMIT 20;
```

```sql
--Description: Pull the TOP-3 discharge cities for the top DRG so we can calculate weighted payments.
WITH top_drg AS (
  SELECT drg_definition
  FROM (
    SELECT drg_definition,
           SUM(total_discharges) AS total_discharges_all
    FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
    GROUP BY drg_definition
    ORDER BY total_discharges_all DESC
    LIMIT 1
  )
),
city_ranks AS (
  SELECT
    provider_city,
    SUM(total_discharges) AS city_total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE drg_definition = (SELECT drg_definition FROM top_drg)
  GROUP BY provider_city
  ORDER BY city_total_discharges DESC
  LIMIT 3
)
SELECT * FROM city_ranks
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – for the 2014 file, return
--   1) the DRG with the highest total discharges,
--   2) the TOP-3 provider cities for that DRG (highest discharges),
--   3) each city’s weighted-average total payment
--      ( Σ(discharges * avg_payment) / Σ(discharges) ).
WITH drg_totals AS (
  SELECT
    drg_definition,
    SUM(total_discharges) AS total_discharges_all
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
),
top_drg AS (
  SELECT drg_definition
  FROM drg_totals
  ORDER BY total_discharges_all DESC
  LIMIT 1
),
city_discharge_totals AS (
  SELECT
    provider_city,
    SUM(total_discharges) AS city_total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE drg_definition = (SELECT drg_definition FROM top_drg)
  GROUP BY provider_city
  ORDER BY city_total_discharges DESC
  LIMIT 3
)
SELECT
  (SELECT drg_definition FROM top_drg)                AS drg_definition_with_most_discharges,
  provider_city,
  city_total_discharges,
  -- weighted average = Σ(discharges*payment)/Σ(discharges)
  SUM(total_discharges * average_total_payments)
    / SUM(total_discharges) AS weighted_avg_total_payments
FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
JOIN city_discharge_totals USING (provider_city)
WHERE drg_definition = (SELECT drg_definition FROM top_drg)
GROUP BY provider_city, city_total_discharges
ORDER BY city_total_discharges DESC
LIMIT 20;
```


