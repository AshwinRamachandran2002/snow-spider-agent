```sql
--Description:  Thinking process (inline):
--  • Goal: identify (a) the DRG with the greatest overall volume of discharges in 2014,
--    then (b) for that single DRG, return the three cities with the most discharges
--    together with each city’s weighted-average total payment
--    (weight = total_discharges).
--  • Step-1 (drg_totals CTE):  aggregate discharges by drg_definition and sort to find
--    which DRG has the maximum total_discharges.
--  • Step-2 (top_drg CTE): keep only that max-volume DRG (LIMIT 1).
--  • Step-3 (city_stats CTE): within the chosen DRG, calculate per-city
--    (i) sum of discharges and (ii) weighted average of average_total_payments.
--  • Final SELECT: order cities by discharge volume, keep the top-3 and output
--    the DRG name, city and its weighted average payment.
WITH drg_totals AS (
  SELECT
    drg_definition,
    SUM(total_discharges) AS total_discharges
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  GROUP BY drg_definition
),
top_drg AS (
  SELECT drg_definition
  FROM drg_totals
  ORDER BY total_discharges DESC
  LIMIT 1
),
city_stats AS (
  SELECT
    provider_city,
    SUM(total_discharges)                                           AS city_total_discharges,
    SUM(average_total_payments * total_discharges) /
    SUM(total_discharges)                                           AS weighted_avg_total_payment
  FROM `bigquery-public-data.cms_medicare.inpatient_charges_2014`
  WHERE drg_definition = (SELECT drg_definition FROM top_drg)
  GROUP BY provider_city
)
SELECT
  (SELECT drg_definition FROM top_drg) AS top_drg_definition,
  provider_city,
  weighted_avg_total_payment
FROM city_stats
ORDER BY city_total_discharges DESC
LIMIT 3;
