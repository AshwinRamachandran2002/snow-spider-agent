Query:
--Description: 10)  Summarise, for HTAN WUSTL, which data levels are present
--                (Level2, Level3, Level4) for each imaging assay type.  Start
--                with all WUSTL Level-2 imaging files, then find provenance
--                records whose HTAN_Parent_Data_File_ID points to those Level-2
--                files and whose Component indicates Level3 or Level4.  Finally,
--                aggregate the distinct levels observed per assay type.
WITH lvl2 AS (      -- every WUSTL imaging Level-2 file
  SELECT DISTINCT
         HTAN_Data_File_ID,
         Imaging_Assay_Type
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE  HTAN_Center = 'HTAN WUSTL'
    AND  Component IS NOT NULL
    AND  LOWER(Component) NOT LIKE '%auxiliary%'
    AND  LOWER(Component) NOT LIKE '%otherassay%'
),
higher AS (         -- any Level-3/4 children referencing those Level-2 files
  SELECT
      l2.Imaging_Assay_Type,
      CASE
          WHEN LOWER(p.Component) LIKE '%level3%' THEN 'Level3'
          WHEN LOWER(p.Component) LIKE '%level4%' THEN 'Level4'
      END AS level_label
  FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
  JOIN   lvl2                                        AS l2
         ON p.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
  WHERE  p.HTAN_Center = 'HTAN WUSTL'
    AND  p.Component IS NOT NULL
    AND (LOWER(p.Component) LIKE '%level3%' OR LOWER(p.Component) LIKE '%level4%')
)
SELECT
    Imaging_Assay_Type,
    STRING_AGG(DISTINCT level_label ORDER BY level_label) AS available_levels
FROM (
    SELECT Imaging_Assay_Type, 'Level2' AS level_label FROM lvl2  -- baseline
    UNION ALL
    SELECT Imaging_Assay_Type, level_label FROM higher            -- Level3/4
)
GROUP BY Imaging_Assay_Type
LIMIT 20
Answer:
Imaging_Assay_Type,available_levels
IMC,Level2
H&E,Level2
CODEX,Level2
