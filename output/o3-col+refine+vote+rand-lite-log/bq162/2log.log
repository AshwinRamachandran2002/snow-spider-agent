```sql
--Description:  Starting from all HTAN WUSTL Level-2 imaging files (imaging_level2_metadata_r5),
--              join id_provenance_r5 to find children that cite those Level-2 files
--              in HTAN_Parent_Data_File_ID.  Record the level of each child
--              (Level3 / Level4).  Finally, union the guaranteed Level2 entry,
--              aggregate distinct levels per Imaging_Assay_Type, and return the
--              imaging assay types together with the set of data levels that
--              exist.  Rows whose Component is NULL or contains “Auxiliary” /
--              “OtherAssay”, as well as Electron-Microscopy assay types, are
--              excluded.
WITH lvl2 AS (                       -- WUSTL imaging Level-2 files
    SELECT DISTINCT
           HTAN_Data_File_ID,
           Imaging_Assay_Type
    FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
    WHERE  HTAN_Center = 'HTAN WUSTL'
      AND  Component IS NOT NULL
      AND  LOWER(Component) NOT LIKE '%auxiliary%'
      AND  LOWER(Component) NOT LIKE '%otherassay%'
      AND  LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'     -- exclude EM
),
higher AS (                         -- Level-3 / Level-4 children derived from those Level-2 files
    SELECT
        l2.Imaging_Assay_Type,
        CASE
            WHEN LOWER(p.Component) LIKE '%level3%' THEN 'Level3'
            WHEN LOWER(p.Component) LIKE '%level4%' THEN 'Level4'
        END AS level_label
    FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
    JOIN   lvl2                                        AS l2
           ON p.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
    WHERE  p.HTAN_Center = 'HTAN WUSTL'
      AND  p.Component IS NOT NULL
      AND (LOWER(p.Component) LIKE '%level3%' OR LOWER(p.Component) LIKE '%level4%')
)
SELECT
    Imaging_Assay_Type,
    STRING_AGG(DISTINCT level_label ORDER BY level_label) AS available_levels
FROM (
    SELECT Imaging_Assay_Type, 'Level2' AS level_label FROM lvl2   -- every assay has Level-2
    UNION ALL
    SELECT Imaging_Assay_Type, level_label FROM higher             -- add Level-3 / Level-4 if present
)
GROUP BY Imaging_Assay_Type
ORDER BY Imaging_Assay_Type;
```
