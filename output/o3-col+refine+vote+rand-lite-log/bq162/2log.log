WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  (LOWER(`Component`) LIKE '%level3%')
  AND  `Component` IS NOT NULL
LIMIT  20;
```

```sql
--Description: 5)  List a sample of id_provenance records for WUSTL whose
--               Component clearly represents imaging Level4 data.
SELECT *
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  (LOWER(`Component`) LIKE '%level4%')
  AND  `Component` IS NOT NULL
LIMIT  20;
```

```sql
--Description: 6)  Bring together Level2 WUSTL imaging files and the matching
--               id_provenance rows to see what Level each Level2 entityId is
--               recorded as.  (Usually should repeat the Level2 row itself.)
SELECT  l2.`entityId`,
        l2.`Imaging_Assay_Type`,
        p.`Component` AS provenance_component
FROM    `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN    `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS p
ON      l2.`entityId` = p.`entityId`
WHERE   l2.`HTAN_Center` = 'HTAN WUSTL'
  AND   l2.`Component` IS NOT NULL
  AND   p.`Component` IS NOT NULL
  AND   LOWER(p.`Component`) NOT LIKE '%auxiliary%'
  AND   LOWER(p.`Component`) NOT LIKE '%otherassay%'
LIMIT   20;
```

```sql
--Description: 7)  Try to find WUSTL Level3/Level4 imaging entities whose parent
--               Level2 entityIds appear in the ‘used’ field (if present). 
--               First list the column names except the three shown earlier.
SELECT *
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
LIMIT  20;
```

```sql
--Description: 8)  If id_provenance_r5 uses a nested field called `used` to keep
--               parent entityIds, extract those for WUSTL Level3 imaging files.
SELECT  p.`entityId`                         AS level3_or_4_entityId,
        p.`Component`,
        JSON_EXTRACT_SCALAR(u, '$')          AS parent_entityId
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p,
       UNNEST(p.`used`) AS u
WHERE  p.`HTAN_Center` = 'HTAN WUSTL'
  AND  (LOWER(p.`Component`) LIKE '%level3%' OR LOWER(p.`Component`) LIKE '%level4%')
LIMIT  20;
```

```sql
--Description: 9)  Join that parent_entityId back to Level2 metadata to recover
--               the Imaging_Assay_Type (still restricting to WUSTL).
SELECT DISTINCT
        l2.`Imaging_Assay_Type`,
        CASE
            WHEN LOWER(p.`Component`) LIKE '%level3%' THEN 'Level3'
            WHEN LOWER(p.`Component`) LIKE '%level4%' THEN 'Level4'
        END AS higher_level_found
FROM    `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p,
        UNNEST(p.`used`) AS u
JOIN    `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
ON      JSON_EXTRACT_SCALAR(u, '$') = l2.`entityId`
WHERE   p.`HTAN_Center`       = 'HTAN WUSTL'
  AND   l2.`HTAN_Center`      = 'HTAN WUSTL'
  AND   l2.`Component`       IS NOT NULL
  AND   LOWER(l2.`Component`) NOT LIKE '%auxiliary%'
  AND   LOWER(l2.`Component`) NOT LIKE '%otherassay%'
  AND   (LOWER(p.`Component`) LIKE '%level3%' OR LOWER(p.`Component`) LIKE '%level4%')
LIMIT   20;
```

```sql
--Description: 10)  Summarise, per imaging assay type, which higher data levels
--                (Level3 / Level4) exist that are derived from WUSTL Level2
--                imaging data.
SELECT  l2.`Imaging_Assay_Type`,
        STRING_AGG(DISTINCT
                   CASE
                       WHEN LOWER(p.`Component`) LIKE '%level2%' THEN 'Level2'
                       WHEN LOWER(p.`Component`) LIKE '%level3%' THEN 'Level3'
                       WHEN LOWER(p.`Component`) LIKE '%level4%' THEN 'Level4'
                   END
                   ORDER BY 1)  AS available_levels
FROM    `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS p
LEFT JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
       ON p.`entityId` = l2.`entityId`
WHERE   p.`HTAN_Center` = 'HTAN WUSTL'
  AND   p.`Component` IS NOT NULL
  AND   LOWER(p.`Component`) NOT LIKE '%auxiliary%'
  AND   LOWER(p.`Component`) NOT LIKE '%otherassay%'
  AND   l2.`Imaging_Assay_Type` IS NOT NULL
GROUP BY l2.`Imaging_Assay_Type`
LIMIT  20;
```

The sequence moves from simple discovery of WUSTL imaging-Level2 assay types, through inspection of provenance information, to assembling the list of higher-level (Level3 / Level4) data derived from those Level2 files – all while filtering out NULL / Auxiliary / OtherAssay components and ignoring Level1 and electron-microscopy data.
