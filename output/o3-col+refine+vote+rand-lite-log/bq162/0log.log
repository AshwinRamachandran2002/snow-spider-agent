```sql
--Description:  Identify assay types that have Level-2 imaging data at HTAN WUSTL
--              but possess no linked Level-3 or Level-4 provenance records.
WITH with_level2 AS (
  SELECT DISTINCT Imaging_Assay_Type
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE  HTAN_Center = 'HTAN WUSTL'
        AND Imaging_Assay_Type IS NOT NULL
        AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron mic%'
),
with_level34 AS (
  SELECT DISTINCT l2.Imaging_Assay_Type
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
         ON l2.entityId = p.entityId
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'
        AND (LOWER(p.Component) LIKE '%level3%' OR LOWER(p.Component) LIKE '%level4%')
)
SELECT *
FROM   with_level2
WHERE  Imaging_Assay_Type NOT IN (SELECT Imaging_Assay_Type FROM with_level34)
LIMIT 20;
```
