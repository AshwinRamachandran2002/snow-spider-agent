```sql
--7. Description:  Imaging assay types vs. available Level-4 Components
SELECT DISTINCT l2.Imaging_Assay_Type,
       p.Component AS level4_component
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS p
  ON l2.entityId = p.entityId
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(p.Component) LIKE '%level4%'
  AND LOWER(p.Component) NOT LIKE '%auxiliary%'
  AND LOWER(p.Component) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
--8. Description:  Compile available data levels (2/3/4) per imaging assay type for HTAN WUSTL
SELECT Imaging_Assay_Type,
       STRING_AGG(DISTINCT level, ', ' ORDER BY level) AS available_levels
FROM (
  -- Level-2 is implicit from l2 table; union with Level-3/4 derived via provenance
  SELECT DISTINCT l2.Imaging_Assay_Type, 'Level2' AS level
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
        AND l2.Imaging_Assay_Type IS NOT NULL
        AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron mic%'

  UNION ALL
  SELECT DISTINCT l2.Imaging_Assay_Type,
         CASE WHEN LOWER(p.Component) LIKE '%level3%' THEN 'Level3'
              WHEN LOWER(p.Component) LIKE '%level4%' THEN 'Level4' END AS level
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS p
    ON l2.entityId = p.entityId
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
    AND (LOWER(p.Component) LIKE '%level3%' OR LOWER(p.Component) LIKE '%level4%')
)
GROUP BY Imaging_Assay_Type
LIMIT 20;
```

```sql
--9. Description:  Verify no Electron Microscopy assays slipped in
SELECT DISTINCT Imaging_Assay_Type
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND LOWER(Imaging_Assay_Type) LIKE '%electron mic%'
LIMIT 20;
```

```sql
--10. Description:  Final cross-check – show assay types that have Level-2 but *no* connected Level-3/4
WITH levels AS (
  SELECT Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
        AND Imaging_Assay_Type IS NOT NULL
        AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron mic%'
  EXCEPT DISTINCT
  SELECT l2.Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`            AS p
    ON l2.entityId = p.entityId
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND LOWER(p.Component) LIKE '%level%'
    AND LOWER(p.Component) NOT LIKE '%auxiliary%'
    AND LOWER(p.Component) NOT LIKE '%otherassay%'
)
SELECT *
FROM levels
LIMIT 20;
```
