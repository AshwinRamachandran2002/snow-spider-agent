```sql
--Description:
-- Identify imaging-assay types that have Level-2 data at HTAN WUSTL but show no
-- evidence of *any* higher-level (Level-3/4) imaging provenance.  Instead of
-- looking only for the substrings “level3” or “level4”, we flag every provenance
-- Component that contains the word “level” **and is not Level-2**; this captures
-- patterns such as “ImagingLevel3Segmentation”, “ImagingLevel4”, etc.
WITH level2_assays AS (
  SELECT DISTINCT Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND Imaging_Assay_Type IS NOT NULL
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
higher_level_assays AS (
  SELECT DISTINCT l2.Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
    ON l2.entityId = p.entityId
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND p.Component IS NOT NULL
    AND LOWER(p.Component) LIKE '%level%'      -- any higher level string
    AND LOWER(p.Component) NOT LIKE '%level2%' -- exclude Level-2 self-links
)
SELECT *
FROM level2_assays
WHERE Imaging_Assay_Type NOT IN (SELECT Imaging_Assay_Type FROM higher_level_assays)
ORDER BY Imaging_Assay_Type;
```
