```sql
--Description:  Compile which data levels (2, 3, 4) are available for each imaging
--              assay type at HTAN WUSTL.  If no Level-3/4 provenance exists the
--              assay will still appear with only “Level2”.
WITH all_levels AS (
  -- always include Level-2
  SELECT DISTINCT
         l2.Imaging_Assay_Type,
         'Level2' AS level
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'
        AND l2.Imaging_Assay_Type IS NOT NULL
        AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron mic%'

  UNION ALL
  -- add Level-3 / Level-4 detected via provenance
  SELECT DISTINCT
         l2.Imaging_Assay_Type,
         CASE WHEN LOWER(p.Component) LIKE '%level3%' THEN 'Level3'
              WHEN LOWER(p.Component) LIKE '%level4%' THEN 'Level4' END AS level
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
         ON l2.entityId = p.entityId
  WHERE  l2.HTAN_Center = 'HTAN WUSTL'
        AND p.Component IS NOT NULL
        AND (LOWER(p.Component) LIKE '%level3%' OR LOWER(p.Component) LIKE '%level4%')
)
SELECT
  Imaging_Assay_Type,
  STRING_AGG(DISTINCT level, ', ' ORDER BY level) AS available_levels
FROM all_levels
GROUP BY Imaging_Assay_Type
LIMIT 20;
```

