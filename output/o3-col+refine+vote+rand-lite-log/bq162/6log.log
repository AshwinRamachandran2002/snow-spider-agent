  AND  l2.Imaging_Assay_Type IS NOT NULL
  AND  LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'

UNION DISTINCT

SELECT DISTINCT l2.Imaging_Assay_Type,
       'Level4' AS available_level
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON   l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS prov
  ON   l4.entityId = prov.entityId
WHERE  prov.HTAN_Center = 'HTAN WUSTL'
  AND  prov.Component NOT LIKE '%Auxiliary%'
  AND  prov.Component NOT LIKE '%OtherAssay%'
  AND  l2.Imaging_Assay_Type IS NOT NULL
  AND  LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
-- 7. Aggregate to see which data levels (2/4) each WUSTL imaging assay type possesses
WITH levels AS (
  SELECT DISTINCT l2.Imaging_Assay_Type, 'Level2' AS lvl
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND l2.Imaging_Assay_Type IS NOT NULL
    AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'

  UNION DISTINCT

  SELECT DISTINCT l2.Imaging_Assay_Type, 'Level4' AS lvl
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
    ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS prov
    ON l4.entityId = prov.entityId
  WHERE prov.HTAN_Center = 'HTAN WUSTL'
    AND prov.Component NOT LIKE '%Auxiliary%'
    AND prov.Component NOT LIKE '%OtherAssay%'
)
SELECT Imaging_Assay_Type,
       STRING_AGG(lvl ORDER BY lvl) AS available_levels
FROM   levels
GROUP BY Imaging_Assay_Type
LIMIT 20;
```

```sql
-- 8. Verify no Level 3 records for WUSTL imaging data in id_provenance_r5 (sanity check)
SELECT DISTINCT Component
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE HTAN_Center = 'HTAN WUSTL'
  AND LOWER(Component) LIKE '%level3%'
  AND Component NOT LIKE '%Auxiliary%'
  AND Component NOT LIKE '%OtherAssay%'
LIMIT 20;
```

```sql
-- 9. If any Level 3 imaging components do appear, list their assay types through parent links (none expected, but check)
SELECT DISTINCT l2.Imaging_Assay_Type,
       prov.Component AS level3_component
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS prov
JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON prov.entityId = l2.entityId               -- assumes Level3 may reference same entityId; adjust if schema differs
WHERE prov.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(prov.Component) LIKE '%level3%'
  AND prov.Component NOT LIKE '%Auxiliary%'
  AND prov.Component NOT LIKE '%OtherAssay%'
LIMIT 20;
```

```sql
-- 10. Final concise table of WUSTL imaging assay types and the data levels (2/4) they currently have (exclude EM)
WITH level2 AS (
  SELECT DISTINCT HTAN_Data_File_ID, Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND Imaging_Assay_Type IS NOT NULL
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
level4 AS (
  SELECT DISTINCT l4.HTAN_Parent_Data_File_ID
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5` AS prov
    ON l4.entityId = prov.entityId
  WHERE prov.HTAN_Center = 'HTAN WUSTL'
    AND prov.Component NOT LIKE '%Auxiliary%'
    AND prov.Component NOT LIKE '%OtherAssay%'
)
SELECT l2.Imaging_Assay_Type,
       CASE WHEN TRUE THEN 'Level2' END                                   AS has_level2,
       CASE WHEN EXISTS (
              SELECT 1 FROM level4 WHERE level4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
            ) THEN 'Level4' END                                           AS has_level4
FROM   level2 AS l2
GROUP BY l2.Imaging_Assay_Type, l2.HTAN_Data_File_ID
LIMIT 20;
```
