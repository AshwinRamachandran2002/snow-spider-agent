Query:
--Description:
-- 7. Aggregate the previous result to show, for each imaging assay type,
--    which data levels (Level-2 and/or Level-4) are present for HTAN WUSTL.
WITH levels AS (
  -- Level-2 presence
  SELECT DISTINCT l2.Imaging_Assay_Type, 'Level2' AS lvl
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND l2.Imaging_Assay_Type IS NOT NULL
    AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'

  UNION DISTINCT

  -- Level-4 presence, found via HTAN_Parent_Data_File_ID mapping
  SELECT DISTINCT l2.Imaging_Assay_Type, 'Level4' AS lvl
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
    ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND l2.Imaging_Assay_Type IS NOT NULL
    AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
)
SELECT Imaging_Assay_Type,
       STRING_AGG(lvl ORDER BY lvl) AS available_levels
FROM   levels
GROUP BY Imaging_Assay_Type
LIMIT 20
Answer:
Imaging_Assay_Type,available_levels
IMC,Level2
H&E,Level2
CODEX,Level2
