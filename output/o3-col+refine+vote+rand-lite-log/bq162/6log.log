Query:
--Description:
-- Produce a concise summary for HTAN WUSTL: each imaging assay type that has
-- Level-2 data (always present) and whether any Level-4 derivative exists.
-- 1. Collect unique assay types from WUSTL Level-2 metadata (exclude EM).
-- 2. Collect assay types that have Level-4 files whose parent came from those
--    Level-2 records (no `id_provenance_r5` needed).
-- 3. Combine both sets and flag availability of Level-2 and Level-4.
WITH level2_types AS (
  SELECT DISTINCT Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
  WHERE HTAN_Center = 'HTAN WUSTL'
    AND Imaging_Assay_Type IS NOT NULL
    AND LOWER(Imaging_Assay_Type) NOT LIKE '%electron%'
),
level4_types AS (
  SELECT DISTINCT l2.Imaging_Assay_Type
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level4_metadata_r5` AS l4
  JOIN `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
    ON l4.HTAN_Parent_Data_File_ID = l2.HTAN_Data_File_ID
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND l2.Imaging_Assay_Type IS NOT NULL
    AND LOWER(l2.Imaging_Assay_Type) NOT LIKE '%electron%'
)
SELECT
  l2.Imaging_Assay_Type,
  'Level2'                                 AS has_level2,
  CASE WHEN l4.Imaging_Assay_Type IS NOT NULL THEN 'Level4' END AS has_level4
FROM level2_types AS l2
LEFT JOIN level4_types AS l4
  ON l2.Imaging_Assay_Type = l4.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type
LIMIT 20
Answer:
Imaging_Assay_Type,has_level2,has_level4
CODEX,Level2,
H&E,Level2,
IMC,Level2,
