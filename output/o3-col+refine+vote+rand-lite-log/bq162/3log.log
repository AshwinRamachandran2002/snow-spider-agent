```sql
--Description: 
-- To verify whether any higher-level imaging metadata (Level 3 or Level 4) exist
-- for the HTAN WUSTL center, we can look directly in the provenance table.
-- If WUSTL has registered Level-3/Level-4 imaging files, their rows will contain
-- `Component` values with “Level3” or “Level4” and `HTAN_Center` = 'HTAN WUSTL'.
-- This query lists the distinct Components that satisfy those conditions;
-- if it returns zero rows, then no higher-level imaging data are present.
SELECT DISTINCT `Component`
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE `HTAN_Center` = 'HTAN WUSTL'
  AND `Component` IS NOT NULL
  AND (`Component` LIKE '%Level3%' OR `Component` LIKE '%Level4%')
LIMIT 20;
