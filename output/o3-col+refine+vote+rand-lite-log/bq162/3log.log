```sql
--1.  Quick glance at the centers that own Level-2 imaging metadata (r5)
SELECT DISTINCT `HTAN_Center`
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
LIMIT 20;
```

```sql
--2.  Imaging assay types that have Level-2 data at the HTAN WUSTL center
SELECT DISTINCT `Imaging_Assay_Type`
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE `HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
--3.  Example Level-2 rows for HTAN WUSTL (to see entityId values we will join on)
SELECT `entityId`, `Imaging_Assay_Type`, `Component`, `HTAN_Center`
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE `HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
--4.  All provenance records that point to those Level-2 entityIds
SELECT p.`entityId`, p.`Component`
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`       AS p
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
LIMIT 20;
```

```sql
--5.  Distinct higher-level Components derived from WUSTL Level-2 imaging data
SELECT DISTINCT p.`Component`
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`       AS p
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND p.`Component` IS NOT NULL
  AND LOWER(p.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(p.`Component`) NOT LIKE '%otherassay%'
LIMIT 20;
```

```sql
--6.  Imaging assay types that have Level-3 data derived from WUSTL Level-2
SELECT DISTINCT l2.`Imaging_Assay_Type`
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND p.`Component` LIKE '%Level3%'
  AND LOWER(p.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(p.`Component`) NOT LIKE '%otherassay%'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
--7.  Imaging assay types that have Level-4 data derived from WUSTL Level-2
SELECT DISTINCT l2.`Imaging_Assay_Type`
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND p.`Component` LIKE '%Level4%'
  AND LOWER(p.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(p.`Component`) NOT LIKE '%otherassay%'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'
LIMIT 20;
```

```sql
--8.  Count of distinct Level-3 / Level-4 files per assay type for HTAN WUSTL
SELECT l2.`Imaging_Assay_Type`,
       COUNT(DISTINCT CASE WHEN p.`Component` LIKE '%Level3%' THEN p.`entityId` END) AS n_Level3_files,
       COUNT(DISTINCT CASE WHEN p.`Component` LIKE '%Level4%' THEN p.`entityId` END) AS n_Level4_files
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`       AS p
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'
  AND (p.`Component` IS NULL 
       OR (LOWER(p.`Component`) NOT LIKE '%auxiliary%' AND LOWER(p.`Component`) NOT LIKE '%otherassay%'))
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
--9.  Final summary: available data levels for each WUSTL imaging assay type
SELECT 
  l2.`Imaging_Assay_Type`,
  'Level2'                                        AS Level2_available,
  MAX(CASE WHEN p.`Component` LIKE '%Level3%' THEN 'Level3' END) AS Level3_available,
  MAX(CASE WHEN p.`Component` LIKE '%Level4%' THEN 'Level4' END) AS Level4_available
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`       AS p
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'           -- exclude EM
  AND l2.`Component` IS NOT NULL
  AND LOWER(l2.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(l2.`Component`) NOT LIKE '%otherassay%'
  AND (p.`Component` IS NULL 
       OR (LOWER(p.`Component`) NOT LIKE '%auxiliary%' AND LOWER(p.`Component`) NOT LIKE '%otherassay%'))
GROUP BY l2.`Imaging_Assay_Type`
ORDER BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
--10.  (Optional) Show the specific higher-level Components tied to every assay type
SELECT l2.`Imaging_Assay_Type`,
       ARRAY_AGG(DISTINCT p.`Component` ORDER BY p.`Component`) AS all_related_components
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`       AS p
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(l2.`Imaging_Assay_Type`) NOT LIKE '%electron%'
  AND (p.`Component` IS NULL 
       OR (LOWER(p.`Component`) NOT LIKE '%auxiliary%' AND LOWER(p.`Component`) NOT LIKE '%otherassay%'))
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20;
```
