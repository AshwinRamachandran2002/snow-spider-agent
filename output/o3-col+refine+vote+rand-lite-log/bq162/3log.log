Query:
--5.  Distinct higher-level Components derived from WUSTL Level-2 imaging data
SELECT DISTINCT p.`Component`
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`       AS p
JOIN   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  ON p.`entityId` = l2.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND p.`Component` IS NOT NULL
  AND LOWER(p.`Component`) NOT LIKE '%auxiliary%'
  AND LOWER(p.`Component`) NOT LIKE '%otherassay%'
LIMIT 20;
Answer:
Component
ImagingLevel2
Query:
--Description: 
--(Corrected 7)  List any higher-level Components (Level4) that exist in the
--provenance table for the HTAN WUSTL center.  We no longer join on entityId
--because Level-4 files have their own IDs that do not match Level-2 IDs.
SELECT DISTINCT `Component`
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE `HTAN_Center` = 'HTAN WUSTL'
  AND `Component` LIKE '%Level4%'
LIMIT 20
Answer:
Component
ScATAC-seqLevel4
ScRNA-seqLevel4
Query:
--Description: 
--(Corrected 8)  Provide a simple count of rows in the provenance table that
--correspond to Level-3 and Level-4 imaging metadata for the HTAN WUSTL center.
SELECT
  SUM(CASE WHEN `Component` LIKE '%Level3%' THEN 1 ELSE 0 END) AS n_Level3_rows,
  SUM(CASE WHEN `Component` LIKE '%Level4%' THEN 1 ELSE 0 END) AS n_Level4_rows
FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE `HTAN_Center` = 'HTAN WUSTL'
Answer:
n_Level3_rows,n_Level4_rows
2046,1482
Query:
--Description: 
--(Corrected 9)  Summarise the data levels available for each WUSTL imaging assay
--type.  We know Level-2 exists (it is the source table).  We use EXISTS sub-queries
--to determine if *any* Level-3 or Level-4 rows are present for the WUSTL center,
--without relying on an entityId join that previously produced no matches.
SELECT
  l2.`Imaging_Assay_Type`,
  'Level2' AS Level2_available,
  CASE WHEN EXISTS (
        SELECT 1
        FROM `isb-cgc-bq.HTAN_versioned.id_provenance_r5` p
