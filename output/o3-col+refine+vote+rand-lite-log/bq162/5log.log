  AND LOWER(`Component`) = 'imaginglevel2'
  AND NOT LOWER(`Imaging_Assay_Type`) LIKE '%electron%'
LIMIT 20;
```

```sql
--Description:  (#9)  For HTAN-WUSTL Level-2 imaging files, list every higher-level imaging
--                        Component (Levels 2-4) that shares the same entityId.  This confirms
--                        whether Level-3 or Level-4 metadata exist and shows which exact
--                        Component tags are registered.  Level-1 rows are excluded.
SELECT
  l2.`Imaging_Assay_Type`,
  p.`Component` AS level_tag,
  p.`entityId`  AS shared_entity_id
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
  ON l2.`entityId` = p.`entityId`
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(l2.`Component`) = 'imaginglevel2'
  AND LOWER(p.`Component`) LIKE 'imaginglevel%'   -- imaging Components only
  AND LOWER(p.`Component`) NOT LIKE '%level1%'    -- exclude Level-1
  AND NOT LOWER(l2.`Imaging_Assay_Type`) LIKE '%electron%'
ORDER BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
--Description:  (#10)  Produce a compact summary for each imaging assay type at HTAN-WUSTL that
--                         has Level-2 metadata, listing all higher-level imaging metadata
--                         (Level-3 and/or Level-4) actually found via entityId links.  The
--                         result includes the base Level-2 tag and a comma-separated list of
--                         higher levels; if none are found the field will be NULL.
SELECT
  l2.`Imaging_Assay_Type`,
  'Level2' AS base_level,
  STRING_AGG(
      DISTINCT CASE
                 WHEN LOWER(p.`Component`) LIKE 'imaginglevel3%' THEN 'Level3'
                 WHEN LOWER(p.`Component`) LIKE 'imaginglevel4%' THEN 'Level4'
               END
      ORDER BY 1
  ) AS higher_levels
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS p
       ON l2.`entityId` = p.`entityId`
       AND LOWER(p.`Component`) LIKE 'imaginglevel%'         -- imaging Components only
       AND LOWER(p.`Component`) NOT LIKE '%level1%'          -- exclude Level-1
WHERE l2.`HTAN_Center` = 'HTAN WUSTL'
  AND LOWER(l2.`Component`) = 'imaginglevel2'
  AND NOT LOWER(l2.`Imaging_Assay_Type`) LIKE '%electron%'
GROUP BY l2.`Imaging_Assay_Type`
ORDER BY l2.`Imaging_Assay_Type`
LIMIT 20;
```
