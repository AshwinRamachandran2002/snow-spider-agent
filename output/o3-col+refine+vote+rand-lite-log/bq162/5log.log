2025-05-05 03:53:19 - Thread-2430 (execute) - INFO - [Exploration]
Below is a progressive set of (≤ 10) exploratory BigQuery SQL statements that can be used to identify, for the 5-th revision (r5) data, the Imaging-assay types produced at the HTAN WUSTL center that  
• have Level 2 metadata, and  
• for which higher-level metadata (Level 3 and/or Level 4) can be located through matching `entityId` records in `id_provenance_r5`.  

All queries avoid NULL / “Auxiliary” / “OtherAssay” components, skip Electron-Microscopy assays, and never touch Level 1 data.

```sql
-- 1)  Distinct imaging assay types that have Level-2 metadata for HTAN WUSTL
SELECT DISTINCT `Imaging_Assay_Type`
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(`Component`) = 'imaginglevel2'
  AND  `Imaging_Assay_Type` IS NOT NULL
LIMIT 20;
```

```sql
-- 2)  How many Level-2 files exist per imaging assay type at HTAN WUSTL?
SELECT `Imaging_Assay_Type`,
       COUNT(*) AS level2_file_count
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(`Component`) = 'imaginglevel2'
GROUP BY `Imaging_Assay_Type`
LIMIT 20;
```

```sql
-- 3)  Which imaging-related Components (Levels 3/4) are registered for HTAN WUSTL in id_provenance_r5?
SELECT DISTINCT `Component`
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(`Component`) LIKE 'imaginglevel%'
  AND  LOWER(`Component`) NOT LIKE '%level1%'
LIMIT 20;
```

```sql
-- 4)  Sample of WUSTL imaging entityIds that already have Level 3 / Level 4 provenance entries
SELECT `entityId`, `Component`
FROM   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(`Component`) LIKE 'imaginglevel%'
  AND  LOWER(`Component`) NOT LIKE '%level1%'
LIMIT 20;
```

```sql
-- 5)  Link Level-2 metadata to its higher-level (3/4) provenance via shared entityId
SELECT DISTINCT l2.`Imaging_Assay_Type`,
                p.`Component`   AS higher_level_component
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
  ON   l2.`entityId` = p.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imaginglevel2'
  AND  LOWER(p.`Component`) LIKE 'imaginglevel%'
  AND  LOWER(p.`Component`) NOT LIKE '%level1%'
LIMIT 20;
```

```sql
-- 6)  For every imaging assay type, flag whether Level 3 and/or Level 4 data exist
SELECT l2.`Imaging_Assay_Type`,
       COUNTIF(LOWER(p.`Component`) LIKE 'imaginglevel3%') > 0 AS has_level3,
       COUNTIF(LOWER(p.`Component`) LIKE 'imaginglevel4%') > 0 AS has_level4
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`        AS p
       ON l2.`entityId` = p.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imaginglevel2'
  AND  NOT LOWER(l2.`Imaging_Assay_Type`) LIKE '%electron%'
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
-- 7)  Same as #6 but suppress assay types that still lack ANY higher-level metadata
SELECT *
FROM (
  SELECT l2.`Imaging_Assay_Type`,
         ARRAY_AGG(DISTINCT
                   CASE
                     WHEN LOWER(p.`Component`) LIKE 'imaginglevel3%' THEN 'Level3'
                     WHEN LOWER(p.`Component`) LIKE 'imaginglevel4%' THEN 'Level4'
                   END
                   IGNORE NULLS) AS higher_levels
  FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`        AS p
         ON l2.`entityId` = p.`entityId`
  WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
    AND  LOWER(l2.`Component`) = 'imaginglevel2'
    AND  NOT LOWER(l2.`Imaging_Assay_Type`) LIKE '%electron%'
  GROUP BY l2.`Imaging_Assay_Type`
)
WHERE ARRAY_LENGTH(higher_levels) > 0
LIMIT 20;
```

```sql
-- 8)  Quick look at Level-2 entityIds for each WUSTL imaging assay (helps manual spot-checking)
SELECT `Imaging_Assay_Type`,
       `entityId`
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5`
WHERE  `HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(`Component`) = 'imaginglevel2'
  AND  NOT LOWER(`Imaging_Assay_Type`) LIKE '%electron%'
LIMIT 20;
```

```sql
-- 9)  Inspect higher-level Components actually linked to those Level-2 entityIds (detailed view)
SELECT l2.`Imaging_Assay_Type`,
       p.`Component`          AS level_tag,
       p.`entityId`           AS shared_entity_id
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
  ON   l2.`entityId` = p.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imaginglevel2'
  AND  LOWER(p.`Component`) LIKE 'imaginglevel%'
  AND  LOWER(p.`Component`) NOT LIKE '%level1%'
  AND  NOT LOWER(l2.`Imaging_Assay_Type`) LIKE '%electron%'
ORDER BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

```sql
--10)  Final compact summary: Level2 + any higher levels, ready for reporting
SELECT l2.`Imaging_Assay_Type`,
       'Level2'                                           AS base_level,
       STRING_AGG(DISTINCT
                  CASE
                    WHEN LOWER(p.`Component`) LIKE 'imaginglevel3%' THEN 'Level3'
                    WHEN LOWER(p.`Component`) LIKE 'imaginglevel4%' THEN 'Level4'
                  END
                  ORDER BY 1)                             AS higher_levels
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`        AS p
       ON l2.`entityId` = p.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imaginglevel2'
  AND  NOT LOWER(l2.`Imaging_Assay_Type`) LIKE '%electron%'
GROUP BY l2.`Imaging_Assay_Type`
LIMIT 20;
```

