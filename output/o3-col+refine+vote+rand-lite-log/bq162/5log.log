```sql
--Description:
-- Purpose: Re-check which HTAN-WUSTL imaging assay types (Level-2 metadata)
--          have ANY entry in id_provenance_r5 whose Component starts with
--          'ImagingLevel' (so Level2/3/4).  We do NOT insist on Level3/4;
--          this lets us see whether any higher-level records exist at all.
-- Logic / thinking:
--   1. Select Level-2 rows from imaging_level2_metadata_r5 for HTAN WUSTL.
--   2. LEFT JOIN to id_provenance_r5 on entityId.
--   3. Keep only provenance Components that begin with 'ImagingLevel'
--      (avoids Auxiliary/OtherAssay).  No Electron-microscopy filter needed
--      because Imaging_Assay_Type already excludes it for WUSTL, but it is
--      left in place to satisfy specification.
--   4. Aggregate by Imaging_Assay_Type, counting how many provenance rows
--      we find (prov_cnt) and collecting the distinct Levels represented
--      (prov_levels).  If prov_cnt = 0 the assay has no higher-level links.
SELECT
  l2.Imaging_Assay_Type,
  COUNT(p.Component)                 AS prov_cnt,
  ARRAY_AGG(DISTINCT p.Component
            ORDER BY p.Component)    AS prov_levels
FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS p
       ON l2.entityId = p.entityId
       AND LOWER(p.Component) LIKE 'imaginglevel%'          -- only imaging components
WHERE l2.HTAN_Center = 'HTAN WUSTL'
  AND LOWER(l2.Component) = 'imaginglevel2'
  AND NOT LOWER(l2.Imaging_Assay_Type) LIKE '%electron%'
GROUP BY l2.Imaging_Assay_Type
ORDER BY l2.Imaging_Assay_Type
LIMIT 20;
```
