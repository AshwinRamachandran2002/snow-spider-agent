```sql
--Description:
-- Final, single-step solution that satisfies the task:
--   “For HTAN WUSTL, list each imaging assay type that has Level-2 metadata and
--    indicate what higher-level imaging metadata (Level-3 and/or Level-4) exist,
--    discovered through shared entityIds in id_provenance_r5.  Exclude assay
--    types that are Electron Microscopy and ignore Components marked Auxiliary /
--    OtherAssay / NULL.”
-- Logic:
--   1. Start with imaging_level2_metadata_r5, filter to HTAN_Center = 'HTAN WUSTL',
--      Component = 'ImagingLevel2', and non-Electron assays.
--   2. LEFT JOIN to id_provenance_r5 on entityId, but retain only provenance
--      Components that begin with 'ImagingLevel' (and are NOT Level1).
--   3. Convert the provenance Component to a simple tag ('Level3' / 'Level4').
--   4. Aggregate by Imaging_Assay_Type, reporting: Level2 (always present) and a
--      comma-separated list of higher levels actually found (NULL if none).
WITH linked AS (
  SELECT
    l2.Imaging_Assay_Type,
    CASE
      WHEN LOWER(p.Component) LIKE 'imaginglevel3%' THEN 'Level3'
      WHEN LOWER(p.Component) LIKE 'imaginglevel4%' THEN 'Level4'
    END AS higher_tag
  FROM `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
  LEFT JOIN `isb-cgc-bq.HTAN_versioned.id_provenance_r5`      AS p
         ON l2.entityId = p.entityId
         AND LOWER(p.Component) LIKE 'imaginglevel%'          -- keep imaging provenance only
         AND LOWER(p.Component) NOT LIKE '%level1%'           -- discard Level1
  WHERE l2.HTAN_Center = 'HTAN WUSTL'
    AND LOWER(l2.Component) = 'imaginglevel2'
    AND NOT LOWER(l2.Imaging_Assay_Type) LIKE '%electron%'    -- exclude EM
)
SELECT
  Imaging_Assay_Type,
  'Level2' AS base_level,
  STRING_AGG(DISTINCT higher_tag ORDER BY higher_tag) AS higher_levels
FROM linked
GROUP BY Imaging_Assay_Type
ORDER BY Imaging_Assay_Type;
```
