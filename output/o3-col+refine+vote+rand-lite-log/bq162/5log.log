-- 5)  Link Level-2 metadata to its higher-level (3/4) provenance via shared entityId
SELECT DISTINCT l2.`Imaging_Assay_Type`,
                p.`Component`   AS higher_level_component
FROM   `isb-cgc-bq.HTAN_versioned.imaging_level2_metadata_r5` AS l2
JOIN   `isb-cgc-bq.HTAN_versioned.id_provenance_r5`           AS p
  ON   l2.`entityId` = p.`entityId`
WHERE  l2.`HTAN_Center` = 'HTAN WUSTL'
  AND  LOWER(l2.`Component`) = 'imaginglevel2'
  AND  LOWER(p.`Component`) LIKE 'imaginglevel%'
  AND  LOWER(p.`Component`) NOT LIKE '%level1%'
LIMIT 20;
