```sql
--Description: 5) Aggregate to the level “one row = one purchase session” (sum of revenue inside the session).  
SELECT  `user_pseudo_id`,
        ep.value.int_value            AS `ga_session_id`,
        SUM(`ecommerce`.purchase_revenue_in_usd) AS `session_revenue_usd`
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
        UNNEST(`event_params`) AS ep
WHERE   _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND   `event_name` = 'purchase'
  AND   `ecommerce`.purchase_revenue_in_usd IS NOT NULL
  AND   ep.key = 'ga_session_id'
GROUP BY `user_pseudo_id`, ep.value.int_value
LIMIT 20;
```

```sql
--Description: 6) Count how many distinct purchase sessions each user had during the month.  
SELECT  `user_pseudo_id`,
        COUNT(DISTINCT ep.value.int_value) AS `purchase_sessions`
FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
        UNNEST(`event_params`) AS ep
WHERE   _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
  AND   `event_name` = 'purchase'
  AND   `ecommerce`.purchase_revenue_in_usd IS NOT NULL
  AND   ep.key = 'ga_session_id'
GROUP BY `user_pseudo_id`
HAVING  `purchase_sessions` > 1
LIMIT 20;
```

```sql
--Description: 7) Put steps 5 & 6 together – only keep users that bought in >1 session, then give each of their sessions a revenue.  
WITH session_revenue AS (
  SELECT  `user_pseudo_id`,
          ep.value.int_value            AS `ga_session_id`,
          SUM(`ecommerce`.purchase_revenue_in_usd) AS `session_revenue_usd`
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
          UNNEST(`event_params`) AS ep
  WHERE   _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND   `event_name` = 'purchase'
    AND   `ecommerce`.purchase_revenue_in_usd IS NOT NULL
    AND   ep.key = 'ga_session_id'
  GROUP BY `user_pseudo_id`, ep.value.int_value
),
multi_buyers AS (
  SELECT  `user_pseudo_id`
  FROM    session_revenue
  GROUP BY `user_pseudo_id`
  HAVING  COUNT(*) > 1
)
SELECT  sr.*
FROM    session_revenue AS sr
JOIN    multi_buyers   AS mb
ON      sr.`user_pseudo_id` = mb.`user_pseudo_id`
LIMIT 20;
```

```sql
--Description: 8) For those multi-purchase users compute the average purchase revenue per session.  
WITH session_revenue AS (
  SELECT  `user_pseudo_id`,
          ep.value.int_value            AS `ga_session_id`,
          SUM(`ecommerce`.purchase_revenue_in_usd) AS `session_revenue_usd`
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
          UNNEST(`event_params`) AS ep
  WHERE   _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND   `event_name` = 'purchase'
    AND   `ecommerce`.purchase_revenue_in_usd IS NOT NULL
    AND   ep.key = 'ga_session_id'
  GROUP BY `user_pseudo_id`, ep.value.int_value
)
SELECT  `user_pseudo_id`,
        AVG(`session_revenue_usd`) AS `avg_purchase_revenue_per_session`
FROM    session_revenue
GROUP BY `user_pseudo_id`
HAVING  COUNT(*) > 1
LIMIT 20;
```

```sql
--Description: 9) Same logic as #8 but using a scalar sub-query to pick ga_session_id instead of UNNEST, just to show another style.  
WITH session_revenue AS (
  SELECT  `user_pseudo_id`,
          ( SELECT value.int_value
            FROM   UNNEST(`event_params`)
            WHERE  key = 'ga_session_id' ) AS `ga_session_id`,
          `ecommerce`.purchase_revenue_in_usd
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND   `event_name` = 'purchase'
    AND   `ecommerce`.purchase_revenue_in_usd IS NOT NULL
), folded AS (
  SELECT  `user_pseudo_id`,
          `ga_session_id`,
          SUM(`purchase_revenue_in_usd`) AS `session_revenue_usd`
  FROM    session_revenue
  GROUP BY `user_pseudo_id`, `ga_session_id`
)
SELECT  `user_pseudo_id`,
        AVG(`session_revenue_usd`) AS `avg_purchase_revenue_per_session`
FROM    folded
GROUP BY `user_pseudo_id`
HAVING  COUNT(*) > 1
LIMIT 20;
```

```sql
--Description: 10) FINAL answer (no LIMIT so it returns the complete list) – average revenue per purchase-session
--               during 1-30 Nov 2020 for users who bought in more than one session.  
WITH session_revenue AS (
  SELECT  `user_pseudo_id`,
          ep.value.int_value            AS `ga_session_id`,
          SUM(`ecommerce`.purchase_revenue_in_usd) AS `session_revenue_usd`
  FROM    `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`,
          UNNEST(`event_params`) AS ep
  WHERE   _TABLE_SUFFIX BETWEEN '20201101' AND '20201130'
    AND   `event_name` = 'purchase'
    AND   `ecommerce`.purchase_revenue_in_usd IS NOT NULL
    AND   ep.key = 'ga_session_id'
  GROUP BY `user_pseudo_id`, ep.value.int_value
)
SELECT  `user_pseudo_id`,
        AVG(`session_revenue_usd`) AS `avg_purchase_revenue_per_session`
FROM    session_revenue
GROUP BY `user_pseudo_id`
HAVING  COUNT(*) > 1;
```
