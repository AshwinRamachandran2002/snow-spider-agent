```sql
--8) Join the two previous sub-results to keep only users with >1 purchase session
SELECT
  s.user_pseudo_id,
  s.ga_session_id,
  s.session_revenue_usd
FROM (
  SELECT
    user_pseudo_id,
    ga_session_id,
    SUM(purchase_revenue_usd) AS session_revenue_usd
  FROM (
    SELECT
      user_pseudo_id,
      ep.value.int_value AS ga_session_id,
      ecommerce.purchase_revenue_in_usd AS purchase_revenue_usd
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
    UNNEST(event_params) AS ep
    WHERE event_name = 'purchase'
      AND ep.key = 'ga_session_id'
      AND ecommerce.purchase_revenue_in_usd IS NOT NULL
      AND event_date BETWEEN '20201101' AND '20201130'
  )
  GROUP BY user_pseudo_id, ga_session_id
) AS s
JOIN (
  SELECT user_pseudo_id
  FROM (
    SELECT
      user_pseudo_id,
      COUNT(DISTINCT ga_session_id) AS purchase_sessions
    FROM (
      SELECT
        user_pseudo_id,
        ep.value.int_value AS ga_session_id
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
      UNNEST(event_params) AS ep
      WHERE event_name = 'purchase'
        AND ep.key = 'ga_session_id'
        AND ecommerce.purchase_revenue_in_usd IS NOT NULL
        AND event_date BETWEEN '20201101' AND '20201130'
    )
    GROUP BY user_pseudo_id
    HAVING purchase_sessions > 1
  )
) AS u
ON s.user_pseudo_id = u.user_pseudo_id
LIMIT 20;
```

```sql
--9) Compute the average purchase revenue per session for qualifying users
SELECT
  s.user_pseudo_id,
  AVG(s.session_revenue_usd) AS avg_purchase_revenue_per_session_usd
FROM (
  SELECT
    user_pseudo_id,
    ga_session_id,
    SUM(purchase_revenue_usd) AS session_revenue_usd
  FROM (
    SELECT
      user_pseudo_id,
      ep.value.int_value AS ga_session_id,
      ecommerce.purchase_revenue_in_usd AS purchase_revenue_usd
    FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
    UNNEST(event_params) AS ep
    WHERE event_name = 'purchase'
      AND ep.key = 'ga_session_id'
      AND ecommerce.purchase_revenue_in_usd IS NOT NULL
      AND event_date BETWEEN '20201101' AND '20201130'
  )
  GROUP BY user_pseudo_id, ga_session_id
) AS s
JOIN (
  SELECT user_pseudo_id
  FROM (
    SELECT
      user_pseudo_id,
      COUNT(DISTINCT ga_session_id) AS purchase_sessions
    FROM (
      SELECT
        user_pseudo_id,
        ep.value.int_value AS ga_session_id
      FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`,
      UNNEST(event_params) AS ep
      WHERE event_name = 'purchase'
        AND ep.key = 'ga_session_id'
        AND ecommerce.purchase_revenue_in_usd IS NOT NULL
        AND event_date BETWEEN '20201101' AND '20201130'
    )
    GROUP BY user_pseudo_id
    HAVING purchase_sessions > 1
  )
) AS u
ON s.user_pseudo_id = u.user_pseudo_id
GROUP BY s.user_pseudo_id
ORDER BY avg_purchase_revenue_per_session_usd DESC
LIMIT 20;
```

```sql
--10) FINAL ANSWER – average purchase revenue per session for users with >1 purchase session (Nov 1-30 2020)
