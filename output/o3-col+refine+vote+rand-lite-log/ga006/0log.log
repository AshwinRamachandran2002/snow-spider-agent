Query:
--Description: 8) Count the number of purchase sessions per user in November-2020 to find those with >1.
SELECT
  user_pseudo_id,
  COUNT(DISTINCT ga_session_id) AS purchase_sessions
FROM (
  SELECT
    user_pseudo_id,
    ( SELECT CAST(p.value.int_value AS INT64)
      FROM UNNEST(event_params) AS p
      WHERE p.key = 'ga_session_id'
    ) AS ga_session_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '30'
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
)
GROUP BY user_pseudo_id
HAVING purchase_sessions > 1
LIMIT 20
