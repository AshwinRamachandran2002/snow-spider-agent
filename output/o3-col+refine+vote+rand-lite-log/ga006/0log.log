--Description: 4) Sum purchase revenue per (user, session) for 2020-11-09.
SELECT
  user_pseudo_id,
  ga_session_id,
  SUM(purchase_revenue_usd) AS session_revenue_usd
FROM (
  SELECT
    user_pseudo_id,
    ecommerce.purchase_revenue_in_usd AS purchase_revenue_usd,
    (SELECT CAST(value.int_value AS INT64)
       FROM UNNEST(event_params)
       WHERE key = 'ga_session_id') AS ga_session_id
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201109`
  WHERE event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
)
GROUP BY user_pseudo_id, ga_session_id
LIMIT 20;
