```sql
--Description / Thinking process inside comments:
-- Goal: For Nov-01→Nov-30 2020 return each user_pseudo_id that completed
--       purchases in more than one session together with the average
--       purchase revenue (USD) per session.
--
-- 1. Scan the daily tables `events_202011*` restricted by _TABLE_SUFFIX
--    BETWEEN '01' AND '30' to cover the month.
-- 2. Filter rows where event_name = 'purchase' and
--    ecommerce.purchase_revenue_in_usd IS NOT NULL.
-- 3. Extract ga_session_id from the repeated event_params array
--    (the element whose key = 'ga_session_id'); cast it to INT64.
-- 4. CTE purchase_events keeps (user_pseudo_id, ga_session_id,
--    purchase_revenue_usd) for every qualifying row.
-- 5. CTE session_revenue aggregates those rows to one total revenue
--    per (user_pseudo_id, ga_session_id).
-- 6. Final SELECT averages the session totals for each user and
--    retains only users that have >1 distinct purchase sessions.
-- 7. Result: user_pseudo_id + avg purchase-revenue-per-session (USD),
--    ordered by that average, limited to 20 rows for inspection.
WITH purchase_events AS (
  SELECT
    user_pseudo_id,
    -- Extract ga_session_id from event_params
    ( SELECT CAST(p.value.int_value AS INT64)
      FROM UNNEST(event_params) AS p
      WHERE p.key = 'ga_session_id'
    )                                AS ga_session_id,
    ecommerce.purchase_revenue_in_usd AS purchase_revenue_usd
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_202011*`
  WHERE _TABLE_SUFFIX BETWEEN '01' AND '30'           -- November 2020
    AND event_name = 'purchase'
    AND ecommerce.purchase_revenue_in_usd IS NOT NULL
),
session_revenue AS (
  -- Revenue per (user, session)
  SELECT
    user_pseudo_id,
    ga_session_id,
    SUM(purchase_revenue_usd) AS session_revenue_usd
  FROM purchase_events
  GROUP BY user_pseudo_id, ga_session_id
)
SELECT
  user_pseudo_id,
  AVG(session_revenue_usd) AS avg_purchase_revenue_usd_per_session
FROM session_revenue
GROUP BY user_pseudo_id
HAVING COUNT(*) > 1                       -- only users with >1 sessions
ORDER BY avg_purchase_revenue_usd_per_session DESC
LIMIT 20;
```
