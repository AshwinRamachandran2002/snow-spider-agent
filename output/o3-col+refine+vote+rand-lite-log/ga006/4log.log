--Description: 3) Look at the raw event_params array to find where the ga_session_id lives
SELECT event_timestamp,
       ep.key              AS param_key,
       ep.value.int_value  AS int_val,
       ep.value.string_value AS str_val
FROM   `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20201101`,
       UNNEST(event_params) AS ep
WHERE  event_name = 'purchase'
  AND  ep.key IN ('ga_session_id')
