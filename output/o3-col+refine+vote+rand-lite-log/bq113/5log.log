Query:
--Description: Join 2000 Q3 data with the counties table to see county names
SELECT c.county_name,
       q.area_fips,
       q.month3_emplvl_23_construction
FROM `bigquery-public-data.bls_qcew.2000_q3` AS q
JOIN `bigquery-public-data.geo_us_boundaries.counties` AS c
  ON q.area_fips = c.geo_id
WHERE c.state_fips_code = '49'
LIMIT 20;
