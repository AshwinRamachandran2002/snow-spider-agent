-- Description: 8) Count, for each status, how many times every L1_model appears
SELECT  s."status",
        l."L1_model",
        COUNT(*) AS "occurrences"
FROM   (
          /* status of each (name,version) */
          SELECT  a."name",
                  a."version",
                  CASE
                      WHEN b."max_nonstack_score" <  a."max_stack_score" THEN 'strong'
                      WHEN b."max_nonstack_score" = a."max_stack_score" THEN 'soft'
                  END AS "status"
          FROM  (SELECT "name","version",MAX("test_score") AS "max_stack_score"
                 FROM   "model_score"
                 WHERE  "model" LIKE '%Stack%'
                 GROUP BY "name","version") AS a
          JOIN  (SELECT "name","version",MAX("test_score") AS "max_nonstack_score"
                 FROM   "model_score"
                 WHERE  "model" NOT LIKE '%Stack%'
                 GROUP BY "name","version") AS b
          ON a."name" = b."name" AND a."version" = b."version"
       ) AS s
JOIN  (
        SELECT  "name","version",MIN("L1_model") AS "L1_model"
        FROM    "model"
        GROUP BY "name","version"
      ) AS l
ON   s."name" = l."name" AND s."version" = l."version"
GROUP BY s."status", l."L1_model"
LIMIT 20;
