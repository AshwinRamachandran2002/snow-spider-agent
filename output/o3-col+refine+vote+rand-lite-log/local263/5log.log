```sql
-- Description: 1) Inspect the (name, version, L1_model) couples that exist in the “model” table
SELECT DISTINCT "name", "version", "L1_model"
FROM "model"
LIMIT 20;
```

```sql
-- Description: 2) List every different child-model label that appears in “model_score”
SELECT DISTINCT "model"
FROM "model_score"
LIMIT 20;
```

```sql
-- Description: 3) Check which model labels contain the word “Stack”
SELECT DISTINCT "model"
FROM "model_score"
WHERE "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
-- Description: 4) For each (name,version) get the best test score obtained by a “Stack” model
SELECT  "name",
        "version",
        MAX("test_score") AS "max_stack_score"
FROM    "model_score"
WHERE   "model" LIKE '%Stack%'
GROUP BY "name", "version"
LIMIT 20;
```

```sql
-- Description: 5) For the same couples get the best test score among the NON-“Stack” models
SELECT  "name",
        "version",
        MAX("test_score") AS "max_nonstack_score"
FROM    "model_score"
WHERE   "model" NOT LIKE '%Stack%'
GROUP BY "name", "version"
LIMIT 20;
```

```sql
-- Description: 6) Decide whether each (name,version) is “strong” or “soft” comparing the two maxima
SELECT  a."name",
        a."version",
        CASE
            WHEN b."max_nonstack_score" <  a."max_stack_score" THEN 'strong'
            WHEN b."max_nonstack_score" = a."max_stack_score" THEN 'soft'
        END AS "status"
FROM   (SELECT "name","version",MAX("test_score") AS "max_stack_score"
        FROM   "model_score"
        WHERE  "model" LIKE '%Stack%'
        GROUP  BY "name","version") AS a
JOIN   (SELECT "name","version",MAX("test_score") AS "max_nonstack_score"
        FROM   "model_score"
        WHERE  "model" NOT LIKE '%Stack%'
        GROUP  BY "name","version") AS b
ON  a."name" = b."name" AND a."version" = b."version"
LIMIT 20;
```

```sql
-- Description: 7) Retrieve one representative L1_model for every (name,version)
SELECT  "name",
        "version",
        MIN("L1_model") AS "L1_model"        -- any consistent choice; MIN is used to pick one
FROM    "model"
GROUP BY "name","version"
LIMIT 20;
```

```sql
-- Description: 8) Count, for each status, how many times every L1_model appears
SELECT  s."status",
        l."L1_model",
        COUNT(*) AS "occurrences"
FROM   (
          /* status of each (name,version) */
          SELECT  a."name",
                  a."version",
                  CASE
                      WHEN b."max_nonstack_score" <  a."max_stack_score" THEN 'strong'
                      WHEN b."max_nonstack_score" = a."max_stack_score" THEN 'soft'
                  END AS "status"
          FROM  (SELECT "name","version",MAX("test_score") AS "max_stack_score"
                 FROM   "model_score"
                 WHERE  "model" LIKE '%Stack%'
                 GROUP BY "name","version") AS a
          JOIN  (SELECT "name","version",MAX("test_score") AS "max_nonstack_score"
                 FROM   "model_score"
                 WHERE  "model" NOT LIKE '%Stack%'
                 GROUP BY "name","version") AS b
          ON a."name" = b."name" AND a."version" = b."version"
       ) AS s
JOIN  (
        SELECT  "name","version",MIN("L1_model") AS "L1_model"
        FROM    "model"
        GROUP BY "name","version"
      ) AS l
ON   s."name" = l."name" AND s."version" = l."version"
GROUP BY s."status", l."L1_model"
LIMIT 20;
```

```sql
-- Description: 9) Pick, for each status, the L1_model with the highest occurrence count
SELECT  "status",
        "L1_model"
FROM   (
        SELECT  s."status",
                l."L1_model",
                COUNT(*)  AS "occurrences",
                RANK() OVER (PARTITION BY s."status"
                             ORDER BY COUNT(*) DESC) AS rnk
        FROM   (
                  SELECT  a."name",a."version",
                          CASE
                              WHEN b."max_nonstack_score" <  a."max_stack_score" THEN 'strong'
                              WHEN b."max_nonstack_score" = a."max_stack_score" THEN 'soft'
                          END AS "status"
                  FROM  (SELECT "name","version",MAX("test_score") AS "max_stack_score"
                         FROM   "model_score"
                         WHERE  "model" LIKE '%Stack%'
                         GROUP BY "name","version") AS a
                  JOIN  (SELECT "name","version",MAX("test_score") AS "max_nonstack_score"
                         FROM   "model_score"
                         WHERE  "model" NOT LIKE '%Stack%'
                         GROUP BY "name","version") AS b
                  ON a."name" = b."name" AND a."version" = b."version"
               ) AS s
        JOIN  (
                SELECT  "name","version",MIN("L1_model") AS "L1_model"
                FROM    "model"
                GROUP BY "name","version"
              ) AS l
        ON s."name" = l."name" AND s."version" = l."version"
        GROUP BY s."status", l."L1_model"
       )
WHERE rnk = 1
LIMIT 20;
```

