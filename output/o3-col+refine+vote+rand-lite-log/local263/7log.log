-- 10. Final answer:
--     Count how many times each L1_model appears with ‘strong’ or ‘soft’ status
--     and keep the top L1_model for every status.
WITH step_status AS (
     -- same CTE as in query 9 (without LIMIT)
     WITH non_stack AS (
          SELECT "name", "version", "step",
                 MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS max_non_stack
          FROM   "model_score"
          GROUP  BY "name","version","step"
     ),
     stack AS (
          SELECT "name","version","step","test_score" AS stack_score
          FROM   "model_score"
          WHERE  "model" LIKE '%Stack%'
     )
     SELECT n."name", n."version",
            CASE 
                 WHEN  s.stack_score > n.max_non_stack THEN 'strong'
                 WHEN  s.stack_score = n.max_non_stack THEN 'soft'
            END AS status
     FROM   non_stack AS n
     JOIN   stack     AS s
            ON s."name" = n."name"
           AND s."version" = n."version"
           AND s."step"    = n."step"
),
model_status AS (
     -- one status per (name,version)
     SELECT "name",
            "version",
            CASE 
                 WHEN MAX(CASE WHEN status='strong' THEN 1 END) = 1 THEN 'strong'
                 ELSE 'soft'
            END AS model_status
     FROM   step_status
     GROUP  BY "name","version"
),
l1 AS (
     -- unique L1_model for every (name,version)
     SELECT "name","version",
            MAX("L1_model") AS L1_model      -- they are usually identical across steps
     FROM   "model"
     GROUP  BY "name","version"
),
totals AS (
     SELECT l1.L1_model,
            ms.model_status AS status,
            COUNT(*)        AS freq
     FROM   l1
     JOIN   model_status AS ms
            ON ms."name" = l1."name"
           AND ms."version" = l1."version"
     GROUP  BY l1.L1_model, ms.model_status
),
ranked AS (
     SELECT *,
            RANK() OVER (PARTITION BY status ORDER BY freq DESC) AS rnk
     FROM   totals
)
SELECT status,
       L1_model,
       freq AS occurrences
FROM   ranked
WHERE  rnk = 1
ORDER  BY status;
