           ns."version",
           ns."step",
           CASE
               WHEN st.stack_score > ns.max_non_stack THEN 'strong'
               WHEN st.stack_score = ns.max_non_stack THEN 'soft'
           END AS status
    FROM   non_stack ns
    JOIN   stack     st
           ON st."name"    = ns."name"
          AND st."version" = ns."version"
          AND st."step"    = ns."step"
),
model_status AS (                   -- one status per (name,version)
