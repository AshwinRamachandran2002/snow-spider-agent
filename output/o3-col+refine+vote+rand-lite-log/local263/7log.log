-- 9. Collapse the step-level result to one status per (name, version)
WITH step_status AS (
     -- query 8 without the LIMIT clause
     WITH non_stack AS (
          SELECT "name", "version", "step",
                 MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS max_non_stack
          FROM   "model_score"
          GROUP  BY "name","version","step"
     ),
     stack AS (
          SELECT "name","version","step","test_score" AS stack_score
          FROM   "model_score"
          WHERE  "model" LIKE '%Stack%'
     )
     SELECT n."name", n."version",
            CASE 
                 WHEN  s.stack_score > n.max_non_stack THEN 'strong'
                 WHEN  s.stack_score = n.max_non_stack THEN 'soft'
            END AS status
     FROM   non_stack AS n
     JOIN   stack     AS s
            ON s."name" = n."name"
           AND s."version" = n."version"
           AND s."step"    = n."step"
)
SELECT "name",
       "version",
       MAX(CASE WHEN status = 'strong' THEN 1 ELSE 0 END) AS any_strong,
       MAX(CASE WHEN status = 'soft'   THEN 1 ELSE 0 END) AS any_soft
FROM   step_status
GROUP  BY "name","version"
LIMIT 20;
