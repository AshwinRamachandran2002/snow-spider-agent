Query:
--Description: For one data set (“iris”), join model and model_score to see the Level-1 model together with its test score
SELECT m."name", m."version", m."step", m."L1_model", s."model", s."test_score"
FROM "model"  AS m
JOIN "model_score" AS s
  ON m."name" = s."name"
 AND m."version" = s."version"
 AND m."step" = s."step"
WHERE m."name" = 'iris'
ORDER BY m."version", m."step"
LIMIT 20;
