```sql
--Description: Get an overview of every distinct model label that appears in model_score
SELECT DISTINCT "model" 
FROM "model_score" 
LIMIT 20;
```

```sql
--Description: Check whether any model names contain the string “Stack” (possible stacking models)
SELECT DISTINCT "name", "version", "step", "model", "test_score"
FROM "model_score"
WHERE "model" LIKE '%Stack%' 
LIMIT 20;
```

```sql
--Description: Inspect all model-scores for one known data set (“iris”) to understand the spread of test scores
SELECT "name", "version", "step", "model", "train_score", "test_score"
FROM "model_score"
WHERE "name" = 'iris'
ORDER BY "version", "step", "test_score" DESC
LIMIT 20;
```

```sql
--Description: List every (name, version) pair that has at least one model whose label contains “Stack”
SELECT DISTINCT "name", "version"
FROM "model_score"
WHERE "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
--Description: Peek into the model table to see which Level-1 (L1) model each (name, version, step) corresponds to
SELECT "name", "version", "step", "L1_model"
FROM "model"
ORDER BY "name", "version", "step"
LIMIT 20;
```

```sql
--Description: Count how many times each L1_model occurs in the entire model table
SELECT "L1_model", COUNT(*) AS cnt
FROM "model"
GROUP BY "L1_model"
ORDER BY cnt DESC
LIMIT 20;
```

```sql
--Description: For one data set (“iris”), join model and model_score to see the Level-1 model together with its test score
SELECT m."name", m."version", m."step", m."L1_model", s."model", s."test_score"
FROM "model"  AS m
JOIN "model_score" AS s
  ON m."name" = s."name"
 AND m."version" = s."version"
 AND m."step" = s."step"
WHERE m."name" = 'iris'
ORDER BY m."version", m."step"
LIMIT 20;
```

```sql
--Description: Compare, for every (name, version), the best non-Stack test score with the Stack test score (if any)
SELECT s1."name", s1."version",
       MAX(CASE WHEN s1."model" NOT LIKE '%Stack%' THEN s1."test_score" END) AS max_non_stack,
       MAX(CASE WHEN s1."model"  LIKE '%Stack%' THEN s1."test_score" END) AS stack_score
FROM "model_score" s1
GROUP BY s1."name", s1."version"
LIMIT 20;
```

```sql
--Description: Identify which (name, version) groups satisfy the “strong” definition
SELECT ss."name", ss."version"
FROM (
  SELECT s1."name", s1."version",
         MAX(CASE WHEN s1."model" NOT LIKE '%Stack%' THEN s1."test_score" END)  AS max_non_stack,
         MAX(CASE WHEN s1."model"  LIKE '%Stack%' THEN s1."test_score" END)    AS stack_score
  FROM "model_score" s1
  GROUP BY s1."name", s1."version"
) AS ss
WHERE ss."stack_score" IS NOT NULL
  AND ss."max_non_stack"  IS NOT NULL
  AND ss."stack_score"  > ss."max_non_stack"
LIMIT 20;
```

```sql
--Description: Identify which (name, version) groups satisfy the “soft” definition
SELECT ss."name", ss."version"
FROM (
  SELECT s1."name", s1."version",
         MAX(CASE WHEN s1."model" NOT LIKE '%Stack%' THEN s1."test_score" END)  AS max_non_stack,
         MAX(CASE WHEN s1."model"  LIKE '%Stack%' THEN s1."test_score" END)    AS stack_score
  FROM "model_score" s1
  GROUP BY s1."name", s1."version"
) AS ss
WHERE ss."stack_score" IS NOT NULL
  AND ss."max_non_stack"  IS NOT NULL
  AND ss."stack_score"  = ss."max_non_stack"
LIMIT 20;
```
