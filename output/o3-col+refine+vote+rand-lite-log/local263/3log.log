Query:
--Description: Identify which (name, version) groups satisfy the “soft” definition
SELECT ss."name", ss."version"
FROM (
  SELECT s1."name", s1."version",
         MAX(CASE WHEN s1."model" NOT LIKE '%Stack%' THEN s1."test_score" END)  AS max_non_stack,
         MAX(CASE WHEN s1."model"  LIKE '%Stack%' THEN s1."test_score" END)    AS stack_score
  FROM "model_score" s1
  GROUP BY s1."name", s1."version"
) AS ss
WHERE ss."stack_score" IS NOT NULL
  AND ss."max_non_stack"  IS NOT NULL
