```sql
-- 1. Quick look at the raw score table (first 20 rows)
SELECT *
FROM model_score
LIMIT 20;
```

```sql
-- 2. All distinct (name, version) pairs which have at least one entry in `model_score`
SELECT DISTINCT name, version
FROM model_score
LIMIT 20;
```

```sql
-- 3. Distinct model codes that contain the word “Stack” (possible stacking models)
SELECT DISTINCT model
FROM model_score
WHERE model LIKE '%Stack%'
   OR model LIKE '%STK%'
   OR model LIKE '%STACK%'
LIMIT 20;
```

```sql
-- 4. Distinct model codes that do NOT contain “Stack” (baseline / level-0 models)
SELECT DISTINCT model
FROM model_score
WHERE model NOT LIKE '%Stack%'
  AND model NOT LIKE '%STK%'
  AND model NOT LIKE '%STACK%'
LIMIT 20;
```

```sql
-- 5. Join `model` and `model_score` to see which L1_model produced which model-code
SELECT ms.name, ms.version, ms.step, ms.model, m.L1_model, ms.train_score, ms.test_score
FROM model_score AS ms
JOIN model       AS m
  ON  ms.name = m.name
 AND ms.version = m.version
 AND ms.step    = m.step
LIMIT 20;
```

```sql
-- 6. For every (name, version), compute the best test score among non-Stack models
SELECT name,
       version,
       MAX(test_score) AS best_non_stack
FROM model_score
WHERE model NOT LIKE '%Stack%'
  AND model NOT LIKE '%STK%'
  AND model NOT LIKE '%STACK%'
GROUP BY name, version
LIMIT 20;
```

```sql
-- 7. For every (name, version), pick the test score of the Stack model (if it exists)
SELECT name,
       version,
       MAX(test_score) AS stack_score           -- MAX in case there are several “Stack” models
FROM model_score
WHERE model LIKE '%Stack%'
   OR model LIKE '%STK%'
   OR model LIKE '%STACK%'
GROUP BY name, version
LIMIT 20;
```

```sql
-- 8. Classify each (name, version) as “strong” or “soft”
WITH best_non_stack AS (
     SELECT name, version, MAX(test_score) AS best_non_stack
     FROM model_score
     WHERE model NOT LIKE '%Stack%'
       AND model NOT LIKE '%STK%'
       AND model NOT LIKE '%STACK%'
     GROUP BY name, version
),
stack_score AS (
     SELECT name, version, MAX(test_score) AS stack_score
     FROM model_score
     WHERE model LIKE '%Stack%'
        OR model LIKE '%STK%'
        OR model LIKE '%STACK%'
     GROUP BY name, version
)
SELECT bns.name,
       bns.version,
       CASE
           WHEN ss.stack_score IS NULL                            THEN 'no_stack'
           WHEN ss.stack_score  > bns.best_non_stack              THEN 'strong'
           WHEN ss.stack_score  = bns.best_non_stack              THEN 'soft'
           ELSE 'weaker'
       END AS status,
       bns.best_non_stack,
       ss.stack_score
FROM best_non_stack AS bns
LEFT JOIN stack_score AS ss
       ON bns.name = ss.name
      AND bns.version = ss.version
LIMIT 20;
```

```sql
-- 9. Attach L1_model to each status for counting
WITH best_non_stack AS (
     SELECT name, version, MAX(test_score) AS best_non_stack
     FROM model_score
     WHERE model NOT LIKE '%Stack%'
       AND model NOT LIKE '%STK%'
       AND model NOT LIKE '%STACK%'
     GROUP BY name, version
),
stack_score AS (
     SELECT name, version, MAX(test_score) AS stack_score
     FROM model_score
     WHERE model LIKE '%Stack%'
        OR model LIKE '%STK%'
        OR model LIKE '%STACK%'
     GROUP BY name, version
),
status AS (
     SELECT bns.name,
            bns.version,
            CASE
                WHEN ss.stack_score IS NULL                   THEN 'no_stack'
                WHEN ss.stack_score >  bns.best_non_stack     THEN 'strong'
                WHEN ss.stack_score =  bns.best_non_stack     THEN 'soft'
                ELSE 'weaker'
            END AS status
     FROM best_non_stack AS bns
     LEFT JOIN stack_score AS ss
            ON bns.name = ss.name
           AND bns.version = ss.version
)
SELECT s.status,
       m.L1_model,
       COUNT(*) AS nb_occurrences
FROM status  AS s
JOIN model   AS m
  ON s.name    = m.name
 AND s.version = m.version
WHERE s.status IN ('strong', 'soft')
GROUP BY s.status, m.L1_model
ORDER BY s.status, nb_occurrences DESC
LIMIT 20;
```

```sql
-- 10. Final answer: for each status, the L1_model with the highest occurrence count
WITH best_non_stack AS (
     SELECT name, version, MAX(test_score) AS best_non_stack
     FROM model_score
     WHERE model NOT LIKE '%Stack%'
       AND model NOT LIKE '%STK%'
       AND model NOT LIKE '%STACK%'
     GROUP BY name, version
),
stack_score AS (
     SELECT name, version, MAX(test_score) AS stack_score
     FROM model_score
     WHERE model LIKE '%Stack%'
        OR model LIKE '%STK%'
        OR model LIKE '%STACK%'
     GROUP BY name, version
),
status AS (
     SELECT bns.name,
            bns.version,
            CASE
                WHEN ss.stack_score IS NULL                   THEN 'no_stack'
                WHEN ss.stack_score >  bns.best_non_stack     THEN 'strong'
                WHEN ss.stack_score =  bns.best_non_stack     THEN 'soft'
                ELSE 'weaker'
            END AS status
     FROM best_non_stack AS bns
     LEFT JOIN stack_score AS ss
            ON bns.name = ss.name
           AND bns.version = ss.version
),
counted AS (
     SELECT s.status,
            m.L1_model,
            COUNT(*) AS nb_occurrences
     FROM status  AS s
     JOIN model   AS m
       ON s.name    = m.name
      AND s.version = m.version
     WHERE s.status IN ('strong', 'soft')
     GROUP BY s.status, m.L1_model
)
SELECT c1.status,
       c1.L1_model,
       c1.nb_occurrences
FROM counted AS c1
JOIN (
      SELECT status, MAX(nb_occurrences) AS max_cnt
      FROM counted
      GROUP BY status
) AS c2
  ON c1.status = c2.status
 AND c1.nb_occurrences = c2.max_cnt
ORDER BY c1.status;
```
