Query:
-- 7. Count, for every L1_model, how often it is associated with
--    a ‘strong’ or ‘soft’ (name, version) pair
WITH perf AS (
  SELECT 
      "name",
      "version",
      MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
      MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
  FROM "model_score"
  GROUP BY "name", "version"
), status AS (
  SELECT 
      "name",
      "version",
      CASE 
           WHEN stack_score  > nonstack_max THEN 'strong'
           WHEN stack_score == nonstack_max THEN 'soft'
      END AS status
  FROM perf
  WHERE stack_score IS NOT NULL
)
SELECT 
    s.status,
    m."L1_model",
    COUNT(*) AS occurrences
FROM status AS s
JOIN "model" AS m
  ON m."name" = s."name" AND m."version" = s."version"
GROUP BY s.status, m."L1_model"
ORDER BY s.status, occurrences DESC
LIMIT 20;
