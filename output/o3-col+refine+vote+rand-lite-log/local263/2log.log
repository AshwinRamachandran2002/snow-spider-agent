```sql
-- 1. Inspect every distinct dataset (name) and version we have in the “model” table
SELECT DISTINCT "name", "version"
FROM "model"
LIMIT 20;
```

```sql
-- 2. View each step and its associated “L1_model” to see which first-level
--    learner is used in every (name, version, step) pair
SELECT DISTINCT "name", "version", "step", "L1_model"
FROM "model"
ORDER BY "name", "version", "step"
LIMIT 20;
```

```sql
-- 3. Check which specific algorithms appear in the “model_score” table
SELECT DISTINCT "model"
FROM "model_score"
LIMIT 20;
```

```sql
-- 4. Look for rows whose algorithm contains the word “Stack” 
--    (these are candidate stacking models)
SELECT *
FROM "model_score"
WHERE "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
-- 5. For every (name, version) compute the best test score of
--    (a) every non-Stack model and (b) every Stack model
WITH perf AS (
  SELECT 
      "name",
      "version",
      MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
      MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
  FROM "model_score"
  GROUP BY "name", "version"
)
SELECT *
FROM perf
LIMIT 20;
```

```sql
-- 6. Classify each (name, version) as ‘strong’ or ‘soft’ according to
--    the definition in the prompt
WITH perf AS (
  SELECT 
      "name",
      "version",
      MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
      MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
  FROM "model_score"
  GROUP BY "name", "version"
)
SELECT 
    "name",
    "version",
    CASE 
         WHEN stack_score  > nonstack_max THEN 'strong'
         WHEN stack_score == nonstack_max THEN 'soft'
    END AS status
FROM perf
WHERE stack_score IS NOT NULL
LIMIT 20;
```

```sql
-- 7. Count, for every L1_model, how often it is associated with
--    a ‘strong’ or ‘soft’ (name, version) pair
WITH perf AS (
  SELECT 
      "name",
      "version",
      MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
      MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
  FROM "model_score"
  GROUP BY "name", "version"
), status AS (
  SELECT 
      "name",
      "version",
      CASE 
           WHEN stack_score  > nonstack_max THEN 'strong'
           WHEN stack_score == nonstack_max THEN 'soft'
      END AS status
  FROM perf
  WHERE stack_score IS NOT NULL
)
SELECT 
    s.status,
    m."L1_model",
    COUNT(*) AS occurrences
FROM status AS s
JOIN "model" AS m
  ON m."name" = s."name" AND m."version" = s."version"
GROUP BY s.status, m."L1_model"
ORDER BY s.status, occurrences DESC
LIMIT 20;
```

```sql
-- 8. Identify, for each status, the L1_model with the largest number of occurrences
WITH perf AS (
  SELECT 
      "name",
      "version",
      MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
      MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
  FROM "model_score"
  GROUP BY "name", "version"
), status AS (
  SELECT 
      "name",
      "version",
      CASE 
           WHEN stack_score  > nonstack_max THEN 'strong'
           WHEN stack_score == nonstack_max THEN 'soft'
      END AS status
  FROM perf
  WHERE stack_score IS NOT NULL
), counts AS (
  SELECT 
      s.status,
      m."L1_model",
      COUNT(*) AS occurrences
  FROM status AS s
  JOIN "model" AS m
    ON m."name" = s."name" AND m."version" = s."version"
  GROUP BY s.status, m."L1_model"
)
SELECT 
    c.status,
    c."L1_model",
    c.occurrences
FROM (
  SELECT 
      status,
      MAX(occurrences) AS max_occ
  FROM counts
  GROUP BY status
) AS mx
JOIN counts AS c
  ON c.status = mx.status
 AND c.occurrences = mx.max_occ
LIMIT 20;
```

```sql
-- 9. (Optional extra) Show the complete list of (name, version) that are ‘strong’
SELECT "name", "version"
FROM (
  WITH perf AS (
    SELECT 
        "name",
        "version",
        MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
        MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
    FROM "model_score"
    GROUP BY "name", "version"
  )
  SELECT 
      "name",
      "version"
  FROM perf
  WHERE stack_score > nonstack_max
)
LIMIT 20;
```

```sql
--10. (Optional extra) Show the complete list of (name, version) that are ‘soft’
SELECT "name", "version"
FROM (
  WITH perf AS (
    SELECT 
        "name",
        "version",
        MAX(CASE WHEN "model" LIKE '%Stack%'    THEN "test_score" END) AS stack_score,
        MAX(CASE WHEN "model" NOT LIKE '%Stack%' THEN "test_score" END) AS nonstack_max
    FROM "model_score"
    GROUP BY "name", "version"
  )
  SELECT 
      "name",
      "version"
  FROM perf
  WHERE stack_score = nonstack_max
)
LIMIT 20;
```
