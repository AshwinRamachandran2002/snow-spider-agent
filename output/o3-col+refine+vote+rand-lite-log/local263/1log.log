-- 9. Final aggregation – which L1_model occurs most often for each status ('strong' or 'soft')
WITH ranked AS (
    SELECT ms."name",
           ms."version",
           MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "max_non_stack",
           MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_score"
    FROM   "model_score" AS ms
    GROUP  BY ms."name", ms."version"
), status AS (
    SELECT r."name",
           r."version",
           CASE
             WHEN r."stack_score" IS NULL THEN 'no_stack_row'
             WHEN r."stack_score"  > r."max_non_stack"  THEN 'strong'
             WHEN r."stack_score"  = r."max_non_stack"  THEN 'soft'
             ELSE 'other'
           END AS "status"
    FROM   ranked AS r
), stats AS (
    SELECT s."status",
           m."L1_model",
           COUNT(*) AS "occurrences"
    FROM   status AS s
    JOIN   "model" AS m
      ON   s."name"    = m."name"
     AND  s."version" = m."version"
    GROUP  BY s."status", m."L1_model"
)
SELECT st1."status",
       st1."L1_model",
       st1."occurrences"
FROM   stats AS st1
JOIN  ( SELECT "status", MAX("occurrences") AS mx
        FROM   stats
        GROUP  BY "status"
      ) AS st2
  ON  st1."status"       = st2."status"
 AND st1."occurrences" = st2.mx
ORDER BY st1."status";
Answer:
status,L1_model,occurrences
other,regression,72
soft,regression,45
strong,regression,96
