SELECT DISTINCT "model"
FROM "model_score"
LIMIT 20;
```

```sql
-- 4. Check if any models containing the word “Stack” are present (potential stacked ensemble rows)
SELECT DISTINCT "model"
FROM "model_score"
WHERE "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
-- 5. Bring together each (name, version, step) with the model’s test score
SELECT ms."name",
       ms."version",
       ms."step",
       ms."model"            AS "algo",
       ms."test_score"
FROM   "model_score" AS ms
ORDER BY ms."name", ms."version", ms."step"
LIMIT 20;
```

```sql
-- 6. Join "model_score" with "model" to attach the corresponding L1_model
SELECT ms."name",
       ms."version",
       m."L1_model",
       ms."model"            AS "algo",
       ms."test_score"
FROM   "model_score" AS ms
JOIN   "model"       AS m
  ON   ms."name" = m."name"
 AND   ms."version" = m."version"
 AND   ms."step"    = m."step"
LIMIT 20;
```

```sql
-- 7. For every (name, version) decide the model-level status: 'strong' or 'soft'
WITH ranked AS (
    SELECT ms."name",
           ms."version",
           MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "max_non_stack",
           MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_score"
    FROM   "model_score" AS ms
    GROUP  BY ms."name", ms."version"
)
SELECT r."name",
       r."version",
       CASE
         WHEN r."stack_score" IS NULL THEN 'no_stack_row'
         WHEN r."stack_score"  > r."max_non_stack"  THEN 'strong'
         WHEN r."stack_score"  = r."max_non_stack"  THEN 'soft'
         ELSE 'other'
       END AS "status"
FROM   ranked AS r
LIMIT 20;
```

```sql
-- 8. Attach L1_model to each (name, version) status calculated above
WITH ranked AS (
    SELECT ms."name",
           ms."version",
           MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "max_non_stack",
           MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_score"
    FROM   "model_score" AS ms
    GROUP  BY ms."name", ms."version"
), status AS (
    SELECT r."name",
           r."version",
           CASE
             WHEN r."stack_score" IS NULL THEN 'no_stack_row'
             WHEN r."stack_score"  > r."max_non_stack"  THEN 'strong'
             WHEN r."stack_score"  = r."max_non_stack"  THEN 'soft'
             ELSE 'other'
           END AS "status"
    FROM   ranked AS r
)
SELECT s."status",
       m."L1_model",
       COUNT(*) AS "occurrences"
FROM   status AS s
JOIN   "model" AS m
  ON   s."name"    = m."name"
 AND  s."version" = m."version"
GROUP  BY s."status", m."L1_model"
ORDER  BY s."status", "occurrences" DESC
LIMIT 20;
```

```sql
-- 9. Final aggregation – which L1_model occurs most often for each status ('strong' or 'soft')
WITH ranked AS (
    SELECT ms."name",
           ms."version",
           MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "max_non_stack",
           MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_score"
    FROM   "model_score" AS ms
    GROUP  BY ms."name", ms."version"
), status AS (
    SELECT r."name",
           r."version",
           CASE
             WHEN r."stack_score" IS NULL THEN 'no_stack_row'
             WHEN r."stack_score"  > r."max_non_stack"  THEN 'strong'
             WHEN r."stack_score"  = r."max_non_stack"  THEN 'soft'
             ELSE 'other'
           END AS "status"
    FROM   ranked AS r
), stats AS (
    SELECT s."status",
           m."L1_model",
           COUNT(*) AS "occurrences"
    FROM   status AS s
    JOIN   "model" AS m
      ON   s."name"    = m."name"
     AND  s."version" = m."version"
    GROUP  BY s."status", m."L1_model"
)
SELECT st1."status",
       st1."L1_model",
       st1."occurrences"
FROM   stats AS st1
JOIN  ( SELECT "status", MAX("occurrences") AS mx
        FROM   stats
        GROUP  BY "status"
      ) AS st2
  ON  st1."status"       = st2."status"
 AND st1."occurrences" = st2.mx
ORDER BY st1."status";
```

```sql
-- 10. (Optional deeper dive) Display every (name, version) classified as 'strong' together with its best test scores
WITH ranked AS (
    SELECT ms."name",
           ms."version",
