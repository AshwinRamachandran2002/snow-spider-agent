```sql
-- Description: 1) Inspect all distinct model names that have been scored.
SELECT DISTINCT "model" 
FROM "model_score" 
LIMIT 20;
```

```sql
-- Description: 2) Check which model names contain the word “Stack” (potential stacked models).
SELECT DISTINCT "model" 
FROM "model_score" 
WHERE "model" LIKE '%Stack%' 
LIMIT 20;
```

```sql
-- Description: 3) View the test-scores of every “Stack” model (name, version, step).
SELECT "name",
       "version",
       "step",
       "model",
       "test_score"
FROM   "model_score"
WHERE  "model" LIKE '%Stack%'
LIMIT 20;
```

```sql
-- Description: 4) Look at test-scores of a few non-“Stack” models for comparison.
SELECT "name",
       "version",
       "step",
       "model",
       "test_score"
FROM   "model_score"
WHERE  "model" NOT LIKE '%Stack%'
LIMIT 20;
```

```sql
-- Description: 5) For every (name,version) get the best “Stack” test-score vs. the best non-“Stack” test-score.
SELECT  ms."name",
        ms."version",
        MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_test",
        MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "non_stack_test"
FROM    "model_score" AS ms
GROUP BY ms."name", ms."version"
LIMIT 20;
```

```sql
-- Description: 6) Classify each (name,version) as ‘strong’ (stack better) or ‘soft’ (equal).
SELECT  t."name",
        t."version",
        CASE
             WHEN t."stack_test" > t."non_stack_test" THEN 'strong'
             WHEN t."stack_test" = t."non_stack_test" THEN 'soft'
        END AS "status"
FROM   (
        SELECT  ms."name",
                ms."version",
                MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_test",
                MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "non_stack_test"
        FROM    "model_score" AS ms
        GROUP BY ms."name", ms."version"
       ) AS t
WHERE  t."stack_test" IS NOT NULL
LIMIT 20;
```

```sql
-- Description: 7) List every dataset version together with its L1_model family.
SELECT DISTINCT
       m."name",
       m."version",
       m."L1_model"
FROM   "model" AS m
LIMIT 20;
```

```sql
-- Description: 8) Attach the ‘strong/soft’ status to the corresponding L1_model of every dataset version.
SELECT  s."name",
        s."version",
        m."L1_model",
        s."status"
FROM   (
        SELECT  t."name",
                t."version",
                CASE
                     WHEN t."stack_test" > t."non_stack_test" THEN 'strong'
                     WHEN t."stack_test" = t."non_stack_test" THEN 'soft'
                END AS "status"
        FROM   (
                SELECT  ms."name",
                        ms."version",
                        MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_test",
                        MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "non_stack_test"
                FROM    "model_score" AS ms
                GROUP BY ms."name", ms."version"
               ) AS t
        WHERE  t."stack_test" IS NOT NULL
       ) AS s
JOIN   "model" AS m
  ON   m."name" = s."name"
 AND   m."version" = s."version"
GROUP BY s."name", s."version", m."L1_model", s."status"
LIMIT 20;
```

```sql
-- Description: 9) Count how many times each L1_model appears within each status category.
SELECT  q."L1_model",
        q."status",
        COUNT(*) AS "occurrences"
FROM   (
        SELECT  s."name",
                s."version",
                m."L1_model",
                s."status"
        FROM   (
                SELECT  t."name",
                        t."version",
                        CASE
                             WHEN t."stack_test" > t."non_stack_test" THEN 'strong'
                             WHEN t."stack_test" = t."non_stack_test" THEN 'soft'
                        END AS "status"
                FROM   (
                        SELECT  ms."name",
                                ms."version",
                                MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_test",
                                MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "non_stack_test"
                        FROM    "model_score" AS ms
                        GROUP BY ms."name", ms."version"
                       ) AS t
                WHERE  t."stack_test" IS NOT NULL
               ) AS s
        JOIN   "model" AS m
          ON   m."name" = s."name"
         AND   m."version" = s."version"
        GROUP BY s."name", s."version", m."L1_model", s."status"
       ) AS q
GROUP BY q."L1_model", q."status"
LIMIT 20;
```

```sql
-- Description: 10) Final answer – for each status (‘strong’ or ‘soft’), give the L1_model with the highest occurrence.
WITH counts AS (
    SELECT  q."L1_model",
            q."status",
            COUNT(*) AS "cnt"
    FROM   (
            SELECT  s."name",
                    s."version",
                    m."L1_model",
                    s."status"
            FROM   (
                    SELECT  t."name",
                            t."version",
                            CASE
                                 WHEN t."stack_test" > t."non_stack_test" THEN 'strong'
                                 WHEN t."stack_test" = t."non_stack_test" THEN 'soft'
                            END AS "status"
                    FROM   (
                            SELECT  ms."name",
                                    ms."version",
                                    MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_test",
                                    MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "non_stack_test"
                            FROM    "model_score" AS ms
                            GROUP BY ms."name", ms."version"
                           ) AS t
                    WHERE  t."stack_test" IS NOT NULL
                   ) AS s
            JOIN   "model" AS m
              ON   m."name" = s."name"
             AND   m."version" = s."version"
            GROUP BY s."name", s."version", m."L1_model", s."status"
           ) AS q
    GROUP BY q."L1_model", q."status"
),
maxcnt AS (
    SELECT  "status",
            MAX("cnt") AS "max_cnt"
    FROM    counts
    GROUP BY "status"
)
SELECT  c."status",
        c."L1_model",
        c."cnt" AS "occurrences"
FROM    counts AS c
JOIN    maxcnt AS m
  ON    c."status" = m."status"
 AND    c."cnt"    = m."max_cnt";
```
