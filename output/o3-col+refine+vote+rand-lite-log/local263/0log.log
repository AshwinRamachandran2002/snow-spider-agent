Query:
-- Description: 9) Count how many times each L1_model appears within each status category.
SELECT  q."L1_model",
        q."status",
        COUNT(*) AS "occurrences"
FROM   (
        SELECT  s."name",
                s."version",
                m."L1_model",
                s."status"
        FROM   (
                SELECT  t."name",
                        t."version",
                        CASE
                             WHEN t."stack_test" > t."non_stack_test" THEN 'strong'
                             WHEN t."stack_test" = t."non_stack_test" THEN 'soft'
                        END AS "status"
                FROM   (
                        SELECT  ms."name",
                                ms."version",
                                MAX(CASE WHEN ms."model" LIKE '%Stack%'     THEN ms."test_score" END) AS "stack_test",
                                MAX(CASE WHEN ms."model" NOT LIKE '%Stack%' THEN ms."test_score" END) AS "non_stack_test"
                        FROM    "model_score" AS ms
                        GROUP BY ms."name", ms."version"
                       ) AS t
                WHERE  t."stack_test" IS NOT NULL
               ) AS s
        JOIN   "model" AS m
          ON   m."name" = s."name"
         AND   m."version" = s."version"
        GROUP BY s."name", s."version", m."L1_model", s."status"
       ) AS q
GROUP BY q."L1_model", q."status"
LIMIT 20;
