```sql
-- 5. Compute, for every (name, version, step), the best test-score obtained 
--    by NON-Stack models
WITH best_non_stack AS (
    SELECT name,
           version,
           step,
           MAX(test_score) AS best_non_stack_score
    FROM   model_score
    WHERE  model NOT LIKE '%Stack%'
    GROUP  BY name, version, step
)
SELECT *
FROM   best_non_stack
LIMIT 20;
```

```sql
-- 6. Combine Stack and non-Stack performance to label each (name, version, step)
--    as “strong” (Stack > best_non_stack) or “soft” (Stack = best_non_stack)
WITH stack AS (
    SELECT name, version, step, test_score AS stack_score
    FROM   model_score
    WHERE  model LIKE '%Stack%'
),
best_non_stack AS (
    SELECT name, version, step, MAX(test_score) AS best_non_stack
    FROM   model_score
    WHERE  model NOT LIKE '%Stack%'
    GROUP  BY name, version, step
)
SELECT s.name,
       s.version,
       s.step,
       CASE 
           WHEN s.stack_score > b.best_non_stack THEN 'strong'
           WHEN s.stack_score = b.best_non_stack THEN 'soft'
       END AS status
FROM   stack s
JOIN   best_non_stack b
       ON b.name = s.name
      AND b.version = s.version
      AND b.step = s.step
LIMIT 20;
```

```sql
-- 7. Attach the L1_model (taken from the model table) to every status record
WITH status_per_step AS (
    /* reuse the CTE from #6 */
    WITH stack AS (
        SELECT name, version, step, test_score AS stack_score
        FROM   model_score
        WHERE  model LIKE '%Stack%'
    ),
    best_non_stack AS (
        SELECT name, version, step, MAX(test_score) AS best_non_stack
        FROM   model_score
        WHERE  model NOT LIKE '%Stack%'
        GROUP  BY name, version, step
    )
    SELECT s.name,
           s.version,
           s.step,
           CASE 
               WHEN s.stack_score > b.best_non_stack THEN 'strong'
               WHEN s.stack_score = b.best_non_stack THEN 'soft'
           END AS status
    FROM   stack s
    JOIN   best_non_stack b
           ON b.name = s.name
          AND b.version = s.version
          AND b.step = s.step
)
SELECT sp.name,
       sp.version,
       sp.status,
       m.L1_model
FROM   status_per_step  sp
JOIN   model            m
       ON  m.name    = sp.name
       AND m.version = sp.version
       AND m.step    = sp.step
LIMIT 20;
```

```sql
-- 8. Count, for every L1_model, how many times it is associated with
--    a “strong” or a “soft” status
WITH status_with_l1 AS (
    /* reuse the CTE logic from #7 */
    WITH stack AS (
        SELECT name, version, step, test_score AS stack_score
        FROM   model_score
        WHERE  model LIKE '%Stack%'
    ),
    best_non_stack AS (
        SELECT name, version, step, MAX(test_score) AS best_non_stack
        FROM   model_score
        WHERE  model NOT LIKE '%Stack%'
        GROUP  BY name, version, step
    ),
    status_per_step AS (
        SELECT s.name,
               s.version,
               s.step,
               CASE 
                   WHEN s.stack_score > b.best_non_stack THEN 'strong'
                   WHEN s.stack_score = b.best_non_stack THEN 'soft'
               END AS status
        FROM   stack s
        JOIN   best_non_stack b
               ON b.name = s.name
              AND b.version = s.version
              AND b.step = s.step
    )
    SELECT sp.status,
           m.L1_model
    FROM   status_per_step sp
    JOIN   model           m
           ON  m.name    = sp.name
           AND m.version = sp.version
           AND m.step    = sp.step
)
SELECT L1_model,
       status,
       COUNT(*) AS nb_occurrence
FROM   status_with_l1
GROUP  BY L1_model, status
LIMIT 20;
```

```sql
-- 9. For each status (“strong”, “soft”), find the L1_model
--    that has the highest number of occurrences
WITH status_with_l1 AS (
    -- same CTE as in query #8
    WITH stack AS (
        SELECT name, version, step, test_score AS stack_score
        FROM   model_score
        WHERE  model LIKE '%Stack%'
    ),
    best_non_stack AS (
        SELECT name, version, step, MAX(test_score) AS best_non_stack
        FROM   model_score
        WHERE  model NOT LIKE '%Stack%'
        GROUP  BY name, version, step
    ),
    status_per_step AS (
        SELECT s.name,
               s.version,
               s.step,
               CASE 
                   WHEN s.stack_score > b.best_non_stack THEN 'strong'
                   WHEN s.stack_score = b.best_non_stack THEN 'soft'
               END AS status
        FROM   stack s
        JOIN   best_non_stack b
               ON b.name = s.name
              AND b.version = s.version
              AND b.step = s.step
    )
    SELECT sp.status,
           m.L1_model
    FROM   status_per_step sp
    JOIN   model           m
           ON  m.name    = sp.name
           AND m.version = sp.version
           AND m.step    = sp.step
),
count_per_l1 AS (
    SELECT L1_model,
           status,
           COUNT(*) AS nb_occurrence
    FROM   status_with_l1
    GROUP  BY L1_model, status
)
SELECT c1.status,
       c1.L1_model,
       c1.nb_occurrence
FROM   count_per_l1 c1
JOIN   (
        SELECT status, MAX(nb_occurrence) AS max_occ
        FROM   count_per_l1
        GROUP  BY status
       ) c2
       ON c1.status = c2.status
      AND c1.nb_occurrence = c2.max_occ
ORDER  BY c1.status;
```

All nine queries (≤ 10) progressively build the necessary information and finish with the answer: for each status (“strong”, “soft”), which L1_model appears most frequently and how many times it occurs.
