```sql
-- 1. Description: Inspect the exact text values of the “Location” column so we know how the four cities are spelled in the data. 
SELECT DISTINCT "Location"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 2. Description: Look at a few raw salary strings for the target cities.
SELECT "CompanyName",
       "Location",
       "Salary"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
LIMIT 20;
```

```sql
-- 3. Description: Demonstrate how a salary string can be cleaned
--    (₹, commas, and “/yr” removed) and cast to a numeric value.
SELECT "Salary",
       REPLACE(
           REPLACE(
               REPLACE("Salary", '₹','')
           , ',','')
       , '/yr','')            AS "CleanText",
       CAST(
           REPLACE(
               REPLACE(
                   REPLACE("Salary", '₹','')
               , ',','')
           , '/yr','') AS REAL) AS "CleanNumeric"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 4. Description: Compute the overall national-level average salary
--    across every row in the dataset (cleaned to numeric).
SELECT AVG(
         CAST(
           REPLACE(
             REPLACE(
               REPLACE("Salary",'₹','')
             , ',','')
           , '/yr','') AS REAL)
       ) AS "National_Avg_Salary"
FROM "SalaryDataset";
```

```sql
-- 5. Description: For each (Location, Company) pair in the four cities,
--    calculate the average salary after cleaning.
SELECT "Location",
       "CompanyName",
       AVG(
         CAST(
           REPLACE(
             REPLACE(
               REPLACE("Salary",'₹','')
             , ',','')
           , '/yr','') AS REAL)
       ) AS "AvgSalary_City_Company"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
-- 6. Description: Rank companies inside each city by their average salary
--    (highest first) and select only the top 5 per city.
WITH CityCompany AS (
    SELECT "Location",
           "CompanyName",
           AVG(
             CAST(
               REPLACE(
                 REPLACE(
                   REPLACE("Salary",'₹','')
                 , ',','')
               , '/yr','') AS REAL)
           ) AS AvgSalary
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
),
Ranked AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "Location" ORDER BY AvgSalary DESC) AS rn
    FROM CityCompany
)
SELECT *
FROM Ranked
WHERE rn <= 5
LIMIT 20;
```

```sql
-- 7. Description: Bring the national average (computed once) together
--    with the previously-ranked table for direct comparison.
WITH NationalAvg AS (
    SELECT AVG(
             CAST(
               REPLACE(
                 REPLACE(
                   REPLACE("Salary",'₹','')
                 , ',','')
               , '/yr','') AS REAL)
           ) AS NatAvg
    FROM "SalaryDataset"
),
CityCompany AS (
    SELECT "Location",
           "CompanyName",
           AVG(
             CAST(
               REPLACE(
                 REPLACE(
                   REPLACE("Salary",'₹','')
                 , ',','')
               , '/yr','') AS REAL)
           ) AS AvgSalary
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
),
Ranked AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY "Location" ORDER BY AvgSalary DESC) AS rn
    FROM CityCompany
)
SELECT  r."Location"                        AS "Location",
        r."CompanyName"                     AS "Company Name",
        ROUND(r.AvgSalary, 2)               AS "Average Salary in State",
        ROUND(n.NatAvg, 2)                  AS "Average Salary in Country"
FROM Ranked  r
CROSS JOIN NationalAvg n
WHERE r.rn <= 5
ORDER BY r."Location",
         r.AvgSalary DESC
LIMIT 20;
```

