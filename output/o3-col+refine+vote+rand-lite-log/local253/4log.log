-- 3. Convert the “Salary” text to a pure-numeric value (₹ / commas / ‘/yr’ removed)
SELECT "CompanyName",
       "Location",
       "Salary",
       CAST(
           REPLACE(
               REPLACE(
                   REPLACE(
                       REPLACE("Salary",'₹','')      -- drop the rupee sign
