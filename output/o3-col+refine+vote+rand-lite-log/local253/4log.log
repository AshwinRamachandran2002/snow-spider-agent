-- 8. Final answer: add the national average salary next to each of the TOP-5 companies in every city
WITH city_rank AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
              CAST(
                  REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
              AS REAL)
            ) AS "avg_salary_city",
            ROW_NUMBER() OVER (PARTITION BY "Location"
                               ORDER BY AVG(
                                 CAST(
                                    REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
                                 AS REAL)
                               ) DESC) AS "rk"
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
),
country_avg AS (
    SELECT AVG(
             CAST(
                 REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
             AS REAL)
           ) AS "avg_salary_national"
    FROM "SalaryDataset"
)
SELECT   cr."Location"      AS "Location",
         cr."CompanyName"   AS "Company Name",
         ROUND(cr."avg_salary_city",2)  AS "Average Salary in State",
         ROUND(ca."avg_salary_national",2) AS "Average Salary in Country"
FROM city_rank  cr
CROSS JOIN country_avg ca
WHERE cr."rk" <= 5
ORDER BY cr."Location",
         cr."avg_salary_city" DESC,
         cr."CompanyName";
