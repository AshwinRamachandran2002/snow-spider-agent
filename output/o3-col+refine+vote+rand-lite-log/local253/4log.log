```sql
-- 1. Preview the city names available in SalaryDataset
SELECT DISTINCT "Location"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 2. Preview a sample of the raw salaries to understand the cleaning work
SELECT "CompanyName",
       "Location",
       "Salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 3. Convert the “Salary” text to a pure-numeric value (₹ / commas / ‘/yr’ removed)
SELECT "CompanyName",
       "Location",
       "Salary",
       CAST(
           REPLACE(
               REPLACE(
                   REPLACE(
                       REPLACE("Salary",'₹','')      -- drop the rupee sign
                   ,',','')                         -- drop commas
               ,'/yr','')                           -- drop trailing /yr
           ,' ','')                                 -- drop spaces
       AS REAL) AS "clean_salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
-- 4. Compute the national (all-India) average salary after cleaning
SELECT AVG(
         CAST(
             REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
         AS REAL)
       ) AS "avg_salary_national"
FROM "SalaryDataset";
```

```sql
-- 5. Compute average salary by company in the four requested cities
SELECT "Location",
       "CompanyName",
       AVG(
         CAST(
             REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
         AS REAL)
       ) AS "avg_salary_city"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
-- 6. Rank companies inside each of the four cities by their average salary
SELECT  "Location",
        "CompanyName",
        AVG(
          CAST(
              REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
          AS REAL)
        ) AS "avg_salary_city",
        ROW_NUMBER() OVER (PARTITION BY "Location"
                           ORDER BY AVG(
                               CAST(
                                   REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
                               AS REAL)
                           ) DESC) AS "rk"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
-- 7. Pull only the TOP-5 companies in each city (using the previous ranking CTE)
WITH city_rank AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
              CAST(
                  REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
              AS REAL)
            ) AS "avg_salary_city",
            ROW_NUMBER() OVER (PARTITION BY "Location"
                               ORDER BY AVG(
                                 CAST(
                                    REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
                                 AS REAL)
                               ) DESC) AS "rk"
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
)
SELECT *
FROM city_rank
WHERE rk <= 5
ORDER BY "Location", "avg_salary_city" DESC
LIMIT 20;
```

```sql
-- 8. Final answer: add the national average salary next to each of the TOP-5 companies in every city
WITH city_rank AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
              CAST(
                  REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
              AS REAL)
            ) AS "avg_salary_city",
            ROW_NUMBER() OVER (PARTITION BY "Location"
                               ORDER BY AVG(
                                 CAST(
                                    REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
                                 AS REAL)
                               ) DESC) AS "rk"
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
),
country_avg AS (
    SELECT AVG(
             CAST(
                 REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
             AS REAL)
           ) AS "avg_salary_national"
    FROM "SalaryDataset"
)
SELECT   cr."Location"      AS "Location",
         cr."CompanyName"   AS "Company Name",
         ROUND(cr."avg_salary_city",2)  AS "Average Salary in State",
         ROUND(ca."avg_salary_national",2) AS "Average Salary in Country"
FROM city_rank  cr
CROSS JOIN country_avg ca
WHERE cr."rk" <= 5
ORDER BY cr."Location",
         cr."avg_salary_city" DESC,
         cr."CompanyName";
```

```sql
