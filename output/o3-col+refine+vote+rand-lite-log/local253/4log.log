              AS REAL)
            ) AS "avg_salary_city",
            ROW_NUMBER() OVER (PARTITION BY "Location"
                               ORDER BY AVG(
                                 CAST(
                                    REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
                                 AS REAL)
                               ) DESC) AS "rk"
    FROM "SalaryDataset"
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
),
country_avg AS (
    SELECT AVG(
             CAST(
                 REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),',',''),'/yr',''),' ','')
             AS REAL)
           ) AS "avg_salary_national"
    FROM "SalaryDataset"
)
SELECT   cr."Location",
         cr."CompanyName",
         ROUND(cr."avg_salary_city",2)  AS "avg_salary_city",
         ROUND(ca."avg_salary_national",2) AS "avg_salary_country"
FROM city_rank  cr
CROSS JOIN country_avg ca
WHERE cr."rk" <= 5
ORDER BY cr."Location",
         cr."avg_salary_city" DESC
LIMIT 20;
