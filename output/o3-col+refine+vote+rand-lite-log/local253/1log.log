--Description: 3) Preview how the raw salary text can be converted to a numeric value
SELECT
  "CompanyName",
  "Location",
  "Salary"                      AS "raw_salary",
  CAST(
        REPLACE(
          REPLACE(
            REPLACE("Salary", '₹',''),   -- drop currency sign
          ',',''),                       -- drop thousand-separators
        '/yr','')                        -- drop time unit
       AS REAL)                          -- cast to number
       AS "clean_salary"
FROM "SalaryDataset"
LIMIT 20;
