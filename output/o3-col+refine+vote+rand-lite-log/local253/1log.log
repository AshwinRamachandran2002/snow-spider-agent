```sql
--Description: 2) Inspect a few distinct company names that will later be ranked
SELECT DISTINCT "CompanyName"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
--Description: 3) Preview how the raw salary text can be converted to a numeric value
SELECT
  "CompanyName",
  "Location",
  "Salary"                      AS "raw_salary",
  CAST(
        REPLACE(
          REPLACE(
            REPLACE("Salary", '₹',''),   -- drop currency sign
          ',',''),                       -- drop thousand-separators
        '/yr','')                        -- drop time unit
       AS REAL)                          -- cast to number
       AS "clean_salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
--Description: 4) Calculate overall (national) average salary for every company
SELECT
  "CompanyName",
  AVG(
      CAST(
            REPLACE(
              REPLACE(
                REPLACE("Salary",'₹',''),
              ',',''),
            '/yr','')
           AS REAL)
     ) AS "avg_salary_country"
FROM "SalaryDataset"
GROUP BY "CompanyName"
ORDER BY "avg_salary_country" DESC
LIMIT 20;
```

```sql
--Description: 5) Compute average salary of each company within the four required cities
SELECT
  "Location",
  "CompanyName",
  AVG(
      CAST(
            REPLACE(
              REPLACE(
                REPLACE("Salary",'₹',''),
              ',',''),
            '/yr','')
          AS REAL)
     ) AS "avg_salary_state"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
ORDER BY "Location","avg_salary_state" DESC
LIMIT 20;
```

```sql
--Description: 6) Rank companies only for Mumbai (example) by their city-level average salary
WITH city_avg AS (
  SELECT
    "CompanyName",
    AVG(
        CAST(
              REPLACE(
                REPLACE(
                  REPLACE("Salary",'₹',''),
                ',',''),
              '/yr','')
            AS REAL)
       ) AS avg_salary_state
  FROM "SalaryDataset"
  WHERE "Location" = 'Mumbai'
  GROUP BY "CompanyName"
)
SELECT
  "CompanyName",
  avg_salary_state,
  ROW_NUMBER() OVER (ORDER BY avg_salary_state DESC) AS rn
FROM city_avg
ORDER BY avg_salary_state DESC
LIMIT 20;
```

```sql
--Description: 7) FINAL ANSWER – top-5 companies (by avg salary) for each required city,
--                compared with their national average salary
WITH cleaned AS (
  SELECT
    "CompanyName",
    "Location",
    CAST(
          REPLACE(
            REPLACE(
              REPLACE("Salary",'₹',''),
            ',',''),
          '/yr','')
         AS REAL) AS salary_num
  FROM "SalaryDataset"
  WHERE "Salary" LIKE '₹%'            -- keeps rows with yearly salaries
),
national AS (                         -- overall company averages
  SELECT
    "CompanyName",
    AVG(salary_num) AS avg_salary_country
  FROM cleaned
  GROUP BY "CompanyName"
),
city_avg AS (                         -- city-level averages for the 4 cities
  SELECT
    "Location",
    "CompanyName",
    AVG(salary_num) AS avg_salary_state
  FROM cleaned
  WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
  GROUP BY "Location","CompanyName"
),
ranked AS (                           -- rank companies within each city
  SELECT
    ca."Location",
    ca."CompanyName",
    ca.avg_salary_state,
    n.avg_salary_country,
    ROW_NUMBER() OVER (
        PARTITION BY ca."Location"
        ORDER BY ca.avg_salary_state DESC
    ) AS rn
  FROM city_avg AS ca
  JOIN national AS n
    ON ca."CompanyName" = n."CompanyName"
)
SELECT
  "Location",
  "CompanyName",
  ROUND(avg_salary_state, 2)   AS "Average Salary in State",
  ROUND(avg_salary_country, 2) AS "Average Salary in Country"
FROM ranked
WHERE rn <= 5                      -- keep top-5 companies per city
ORDER BY "Location", avg_salary_state DESC
LIMIT 20;                          -- 4 cities × 5 companies = 20 rows
```
