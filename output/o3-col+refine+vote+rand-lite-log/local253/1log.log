--Description: 5) Compute average salary of each company within the four required cities
SELECT
  "Location",
  "CompanyName",
  AVG(
      CAST(
            REPLACE(
              REPLACE(
                REPLACE("Salary",'₹',''),
              ',',''),
            '/yr','')
          AS REAL)
     ) AS "avg_salary_state"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
ORDER BY "Location","avg_salary_state" DESC
LIMIT 20;
