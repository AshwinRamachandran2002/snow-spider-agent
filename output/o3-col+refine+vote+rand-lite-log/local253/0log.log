```sql
--Description: 1) Inspect all available locations in SalaryDataset
SELECT DISTINCT "Location"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
--Description: 2) Inspect a few raw salary strings to understand the pattern we need to clean
SELECT "CompanyName",
       "Location",
       "Salary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
--Description: 3) Show how to strip the currency symbol (₹), commas, and the “/yr” suffix and cast to NUMERIC
SELECT "CompanyName",
       "Location",
       "Salary",
       CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC) 
         AS "CleanSalary"
FROM "SalaryDataset"
LIMIT 20;
```

```sql
--Description: 4) Compute average salary per company for the four required cities
SELECT  "Location",
        "CompanyName",
        AVG(
             CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
           ) AS "avg_salary_state"
FROM    "SalaryDataset"
WHERE   "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
LIMIT 20;
```

```sql
--Description: 5) Compute overall (national) average salary for every company in the dataset
SELECT  "CompanyName",
        AVG(
             CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
           ) AS "avg_salary_country"
FROM    "SalaryDataset"
GROUP BY "CompanyName"
LIMIT 20;
```

```sql
--Description: 6) Join the state-level averages (four cities) with the national averages
WITH state_avg AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
                 CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
               ) AS "avg_salary_state"
    FROM    "SalaryDataset"
    WHERE   "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
),
country_avg AS (
    SELECT  "CompanyName",
            AVG(
                 CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
               ) AS "avg_salary_country"
    FROM    "SalaryDataset"
    GROUP BY "CompanyName"
)
SELECT  s."Location",
        s."CompanyName",
        s."avg_salary_state",
        c."avg_salary_country"
FROM    state_avg s
JOIN    country_avg c
  ON    s."CompanyName" = c."CompanyName"
LIMIT 20;
```

```sql
--Description: 7) Rank companies within each of the four cities by their average salary
WITH state_avg AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
                 CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
               ) AS "avg_salary_state"
    FROM    "SalaryDataset"
    WHERE   "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
), ranked_state AS (
    SELECT  "Location",
            "CompanyName",
            "avg_salary_state",
            ROW_NUMBER() OVER (PARTITION BY "Location" 
                               ORDER BY "avg_salary_state" DESC) AS rn
    FROM    state_avg
)
SELECT *
FROM   ranked_state
WHERE  rn <= 5
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – Top-5 companies by average salary in each city, with comparison to the national average
WITH state_avg AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
                 CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
               ) AS "avg_salary_state"
    FROM    "SalaryDataset"
    WHERE   "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
), country_avg AS (
    SELECT  "CompanyName",
            AVG(
                 CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
               ) AS "avg_salary_country"
    FROM    "SalaryDataset"
    GROUP BY "CompanyName"
), ranked_state AS (
    SELECT  s."Location",
            s."CompanyName",
            s."avg_salary_state",
            c."avg_salary_country",
            ROW_NUMBER() OVER (PARTITION BY s."Location" 
                               ORDER BY s."avg_salary_state" DESC) AS rn
    FROM    state_avg s
    JOIN    country_avg c
      ON    s."CompanyName" = c."CompanyName"
)
SELECT  "Location"                              AS "Location",
        "CompanyName"                           AS "Company Name",
        ROUND("avg_salary_state",   2)          AS "Average Salary in State",
        ROUND("avg_salary_country", 2)          AS "Average Salary in Country"
FROM    ranked_state
WHERE   rn <= 5        -- keep only the top-5 per specified city
LIMIT 20;              -- 4 cities × 5 companies = 20 rows
```
