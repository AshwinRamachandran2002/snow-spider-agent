--Description: 3) Show how to strip the currency symbol (₹), commas, and the “/yr” suffix and cast to NUMERIC
SELECT "CompanyName",
       "Location",
       "Salary",
       CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC) 
         AS "CleanSalary"
FROM "SalaryDataset"
LIMIT 20;
