Query:
--Description: 7) Rank companies within each of the four cities by their average salary
WITH state_avg AS (
    SELECT  "Location",
            "CompanyName",
            AVG(
                 CAST(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',','') AS NUMERIC)
               ) AS "avg_salary_state"
    FROM    "SalaryDataset"
    WHERE   "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location","CompanyName"
), ranked_state AS (
    SELECT  "Location",
            "CompanyName",
            "avg_salary_state",
            ROW_NUMBER() OVER (PARTITION BY "Location" 
                               ORDER BY "avg_salary_state" DESC) AS rn
    FROM    state_avg
)
SELECT *
FROM   ranked_state
WHERE  rn <= 5
LIMIT 20;
