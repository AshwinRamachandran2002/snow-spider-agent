WITH cleaned AS (
    SELECT
        "CompanyName",
        "Location",
        CAST(
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE("Salary", '₹', ''),
                    '/yr', ''),
                ',', ''),
            '/') AS REAL) AS salary_num
    FROM "SalaryDataset"
),
state_avg AS (
    SELECT
        "Location",
        "CompanyName",
        AVG(salary_num) AS avg_salary_state
    FROM cleaned
    WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
    GROUP BY "Location", "CompanyName"
),
country_avg AS (
    SELECT
        "CompanyName",
        AVG(salary_num) AS avg_salary_country
    FROM cleaned
    GROUP BY "CompanyName"
),
ranked AS (
    SELECT
        s."Location",
        s."CompanyName",
        s.avg_salary_state,
        c.avg_salary_country,
        ROW_NUMBER() OVER (
            PARTITION BY s."Location"
            ORDER BY s.avg_salary_state DESC
        ) AS rn
    FROM state_avg s
    JOIN country_avg c
      ON s."CompanyName" = c."CompanyName"
)
SELECT
