Query:
-- 6.  Join the state-level and country-level averages
SELECT s."Location",
       s."CompanyName",
       s."avg_salary_state",
       n."avg_salary_country"
FROM (
      SELECT "Location",
             "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_state"
      FROM "SalaryDataset"
      WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
      GROUP BY "Location","CompanyName"
     ) AS s
JOIN (
      SELECT "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_country"
      FROM "SalaryDataset"
      GROUP BY "CompanyName"
     ) AS n
  ON s."CompanyName" = n."CompanyName"
ORDER BY s."Location", s."avg_salary_state" DESC
LIMIT 20;
