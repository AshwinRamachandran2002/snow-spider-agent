-- 7.  Add a row-number to rank companies by city (window function)
SELECT s."Location",
       s."CompanyName",
       s."avg_salary_state",
       n."avg_salary_country",
       ROW_NUMBER() OVER (PARTITION BY s."Location"
                          ORDER BY s."avg_salary_state" DESC) AS rn
FROM (
      SELECT "Location",
             "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_state"
      FROM "SalaryDataset"
      WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
      GROUP BY "Location","CompanyName"
     ) AS s
JOIN (
      SELECT "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_country"
      FROM "SalaryDataset"
      GROUP BY "CompanyName"
     ) AS n
  ON s."CompanyName" = n."CompanyName"
LIMIT 20;
