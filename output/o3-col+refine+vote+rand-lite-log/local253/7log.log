    "CompanyName"                      AS "Company Name",
    ROUND(avg_salary_state, 4)         AS "Average Salary in State",
    ROUND(avg_salary_country, 4)       AS "Average Salary in Country"
FROM ranked
WHERE rn <= 5
ORDER BY
    "Location",
    "Average Salary in State" DESC;
