```sql
-- 3.  Prototype a “clean-up” expression that converts the salary text to a pure number
SELECT "CompanyName",
       "Location",
       "Salary",
       CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER) AS "salary_numeric"
FROM "SalaryDataset"
WHERE "Location" = 'Mumbai'
LIMIT 20;
```

```sql
-- 4.  Average salary by company *within* each of the four cities (state-level view)
SELECT "Location",
       "CompanyName",
       AVG(
         CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
       ) AS "avg_salary_state"
FROM "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
ORDER BY "Location","avg_salary_state" DESC
LIMIT 20;
```

```sql
-- 5.  National-level (all locations) average salary for every company
SELECT "CompanyName",
       AVG(
         CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
       ) AS "avg_salary_country"
FROM "SalaryDataset"
GROUP BY "CompanyName"
ORDER BY "avg_salary_country" DESC
LIMIT 20;
```

```sql
-- 6.  Join the state-level and country-level averages
SELECT s."Location",
       s."CompanyName",
       s."avg_salary_state",
       n."avg_salary_country"
FROM (
      SELECT "Location",
             "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_state"
      FROM "SalaryDataset"
      WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
      GROUP BY "Location","CompanyName"
     ) AS s
JOIN (
      SELECT "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_country"
      FROM "SalaryDataset"
      GROUP BY "CompanyName"
     ) AS n
  ON s."CompanyName" = n."CompanyName"
ORDER BY s."Location", s."avg_salary_state" DESC
LIMIT 20;
```

```sql
-- 7.  Add a row-number to rank companies by city (window function)
SELECT s."Location",
       s."CompanyName",
       s."avg_salary_state",
       n."avg_salary_country",
       ROW_NUMBER() OVER (PARTITION BY s."Location"
                          ORDER BY s."avg_salary_state" DESC) AS rn
FROM (
      SELECT "Location",
             "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_state"
      FROM "SalaryDataset"
      WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
      GROUP BY "Location","CompanyName"
     ) AS s
JOIN (
      SELECT "CompanyName",
             AVG(
               CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER)
             ) AS "avg_salary_country"
      FROM "SalaryDataset"
      GROUP BY "CompanyName"
     ) AS n
  ON s."CompanyName" = n."CompanyName"
LIMIT 20;
```

```sql
-- 8.  FINAL ANSWER → Top-5 companies in each city against national averages
WITH cleaned AS (
     SELECT "CompanyName",
            "Location",
            CAST(REPLACE(REPLACE(REPLACE(REPLACE("Salary",'₹',''),'/yr',''),',',''),'/', '') AS INTEGER) AS salary_num
     FROM "SalaryDataset"
), state_avg AS (
     SELECT "Location",
            "CompanyName",
            AVG(salary_num) AS avg_salary_state
     FROM cleaned
     WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
     GROUP BY "Location","CompanyName"
), country_avg AS (
     SELECT "CompanyName",
            AVG(salary_num) AS avg_salary_country
     FROM cleaned
     GROUP BY "CompanyName"
), ranked AS (
     SELECT s."Location",
            s."CompanyName",
            s.avg_salary_state,
            c.avg_salary_country,
            ROW_NUMBER() OVER (PARTITION BY s."Location"
                               ORDER BY s.avg_salary_state DESC) AS rn
     FROM state_avg s
     JOIN country_avg c
       ON s."CompanyName" = c."CompanyName"
)
SELECT "Location"                                           AS "Location",
       "CompanyName"                                        AS "Company Name",
       ROUND(avg_salary_state,2)     AS "Average Salary in State",
       ROUND(avg_salary_country,2)   AS "Average Salary in Country"
FROM ranked
WHERE rn <= 5
ORDER BY "Location", "Average Salary in State" DESC
LIMIT 20;
```
