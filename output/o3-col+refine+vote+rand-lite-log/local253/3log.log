--Description: 7) Put the national average beside each of those city-level company averages
SELECT t."Location",
       t."CompanyName",
       ROUND(t."avg_salary_city",2)      AS "Average Salary in State",
       ROUND(c."avg_salary_country",2)   AS "Average Salary in Country"
FROM (
        SELECT "Location",
               "CompanyName",
               AVG(
                   CAST(
                         REPLACE(
                           REPLACE(
                             REPLACE("Salary",'₹','')
                           ,',','')
                         ,'/yr','') AS REAL)
                  )                                         AS "avg_salary_city",
               ROW_NUMBER() OVER (PARTITION BY "Location"
                                  ORDER BY AVG(
                                          CAST(
                                                REPLACE(
                                                  REPLACE(
                                                    REPLACE("Salary",'₹','')
                                                  ,',','')
                                                ,'/yr','') AS REAL)
                                        ) DESC)             AS rn
        FROM   "SalaryDataset"
        WHERE  "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
        GROUP  BY "Location","CompanyName"
     ) AS t
JOIN (
        SELECT AVG(
                   CAST(
                         REPLACE(
