       ROUND(c."avg_salary_country",2)   AS "Average Salary in Country"
FROM (
        SELECT "Location",
               "CompanyName",
               AVG(
                   CAST(
                         REPLACE(
                           REPLACE(
                             REPLACE("Salary",'₹','')
                           ,',','')
                         ,'/yr','') AS REAL)
                  )                                         AS "avg_salary_city",
               ROW_NUMBER() OVER (PARTITION BY "Location"
                                  ORDER BY AVG(
                                          CAST(
                                                REPLACE(
                                                  REPLACE(
                                                    REPLACE("Salary",'₹','')
                                                  ,',','')
                                                ,'/yr','') AS REAL)
                                        ) DESC)             AS rn
        FROM   "SalaryDataset"
        WHERE  "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
        GROUP  BY "Location","CompanyName"
     ) AS t
JOIN (
        SELECT AVG(
                   CAST(
                         REPLACE(
                           REPLACE(
                             REPLACE("Salary",'₹','')
                           ,',','')
                         ,'/yr','') AS REAL))  AS "avg_salary_country"
        FROM   "SalaryDataset"
     ) AS c
WHERE  t.rn <= 5
ORDER  BY t."Location",
          t."avg_salary_city" DESC;
```

```sql
--Description: 9) Verify only the requested four columns are shown in final answer
SELECT "Location",
       "CompanyName",
       ROUND(
         AVG(
              CAST(
                    REPLACE(
                      REPLACE(
                        REPLACE("Salary",'₹','')
                      ,',','')
                    ,'/yr','') AS REAL)
             ),2)                         AS "Average Salary in State",
       (SELECT ROUND(
                   AVG(
                        CAST(
                              REPLACE(
                                REPLACE(
                                  REPLACE("Salary",'₹','')
                                ,',','')
                              ,'/yr','') AS REAL)
                     ),2)
        FROM "SalaryDataset")             AS "Average Salary in Country"
FROM  "SalaryDataset"
WHERE "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP BY "Location","CompanyName"
HAVING ROW_NUMBER() OVER (PARTITION BY "Location"
                          ORDER BY AVG(
                                  CAST(
                                        REPLACE(
                                          REPLACE(
                                            REPLACE("Salary",'₹','')
                                          ,',','')
                                        ,'/yr','') AS REAL)
                                ) DESC) <= 5
ORDER BY "Location", "Average Salary in State" DESC
LIMIT 20;
```

