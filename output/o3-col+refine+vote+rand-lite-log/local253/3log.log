--Description: 
-- THINKING PROCESS
-- • Objective: For each of the four cities (Mumbai, Pune, New Delhi, Hyderabad) list the five companies with
--   the highest average salary, and show (a) that city-level average and (b) the national average salary.
-- • Data issues: “Salary” column is textual (e.g. “₹6,48,573/yr”).  Strip the “₹”, commas, and “/yr”, then CAST to REAL.
-- • Plan:
--   1. In a sub-query, convert salary to numeric, compute AVG salary per Company × City, rank with ROW_NUMBER()
--      (partitioned by Location, ordered by average salary DESC).
--   2. Keep rows with rn ≤ 5 → top-5 companies per city.
--   3. In a scalar sub-query, compute the overall national average salary once.
--   4. CROSS JOIN the national average so every result row carries it.
--   5. Select only the four requested columns; order by City then descending city-average salary.
--
SELECT
       city_rank."Location",
       city_rank."CompanyName",
       ROUND(city_rank."avg_salary_city", 2)      AS "Average Salary in State",
       ROUND(national."avg_salary_country", 2)    AS "Average Salary in Country"
FROM (
        SELECT   s."Location",
                 s."CompanyName",
                 AVG(
                     CAST(
                           REPLACE(
                             REPLACE(
                               REPLACE(s."Salary", '₹', '')
                             , ',', '')
                           , '/yr', '') AS REAL)
                 )                                       AS "avg_salary_city",
                 ROW_NUMBER() OVER (
                     PARTITION BY s."Location"
                     ORDER BY AVG(
                               CAST(
                                     REPLACE(
                                       REPLACE(
                                         REPLACE(s."Salary", '₹', '')
                                       , ',', '')
                                     , '/yr', '') AS REAL)
                             ) DESC
                 )                                       AS rn
        FROM     "SalaryDataset" AS s
        WHERE    s."Location" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')
        GROUP BY s."Location", s."CompanyName"
     ) AS city_rank
CROSS JOIN (
           SELECT AVG(
                       CAST(
                             REPLACE(
                               REPLACE(
                                 REPLACE("Salary", '₹', '')
                               , ',', '')
                             , '/yr', '') AS REAL)
                     )                    AS "avg_salary_country"
           FROM   "SalaryDataset"
          ) AS national
WHERE  city_rank.rn <= 5
ORDER BY city_rank."Location",
         city_rank."avg_salary_city" DESC;
