Query:
--Description: 6) Rank companies by average salary within each city and keep only the top 5
SELECT *
FROM (
       SELECT "Location",
              "CompanyName",
              AVG(
                  CAST(
                        REPLACE(
                          REPLACE(
                            REPLACE("Salary",'₹','')
                          ,',','')
                        ,'/yr','') AS REAL)
                 )                                         AS "avg_salary_city",
              ROW_NUMBER() OVER (PARTITION BY "Location"
                                 ORDER BY AVG(
                                         CAST(
                                               REPLACE(
                                                 REPLACE(
                                                   REPLACE("Salary",'₹','')
                                                 ,',','')
                                               ,'/yr','') AS REAL)
                                       ) DESC)              AS rn
       FROM   "SalaryDataset"
       WHERE  "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
       GROUP  BY "Location","CompanyName"
)
WHERE  rn <= 5
LIMIT 20;
