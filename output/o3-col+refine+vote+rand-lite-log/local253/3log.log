FROM   "SalaryDataset"
LIMIT 20;
```

```sql
--Description: 4) Find the overall (national) average salary after cleaning the text field
SELECT AVG(
          CAST(
               REPLACE(
                 REPLACE(
                   REPLACE("Salary",'₹','')
                 ,',','')
               ,'/yr','') AS REAL)
          )  AS "avg_salary_country"
FROM   "SalaryDataset";
```

```sql
--Description: 5) Compute average salary for every company in each of the four target cities
SELECT "Location",
       "CompanyName",
       AVG(
           CAST(
                 REPLACE(
                   REPLACE(
                     REPLACE("Salary",'₹','')
                   ,',','')
                 ,'/yr','') AS REAL)
          ) AS "avg_salary_city"
FROM   "SalaryDataset"
WHERE  "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
GROUP  BY "Location","CompanyName"
LIMIT 20;
```

```sql
--Description: 6) Rank companies by average salary within each city and keep only the top 5
SELECT *
FROM (
       SELECT "Location",
              "CompanyName",
              AVG(
                  CAST(
                        REPLACE(
                          REPLACE(
                            REPLACE("Salary",'₹','')
                          ,',','')
                        ,'/yr','') AS REAL)
                 )                                         AS "avg_salary_city",
              ROW_NUMBER() OVER (PARTITION BY "Location"
                                 ORDER BY AVG(
                                         CAST(
                                               REPLACE(
                                                 REPLACE(
                                                   REPLACE("Salary",'₹','')
                                                 ,',','')
                                               ,'/yr','') AS REAL)
                                       ) DESC)              AS rn
       FROM   "SalaryDataset"
       WHERE  "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
       GROUP  BY "Location","CompanyName"
)
WHERE  rn <= 5
LIMIT 20;
```

```sql
--Description: 7) Put the national average beside each of those city-level company averages
SELECT t."Location",
       t."CompanyName",
       ROUND(t."avg_salary_city",2)      AS "Average Salary in State",
       ROUND(c."avg_salary_country",2)   AS "Average Salary in Country"
FROM (
        SELECT "Location",
               "CompanyName",
               AVG(
                   CAST(
                         REPLACE(
                           REPLACE(
                             REPLACE("Salary",'₹','')
                           ,',','')
                         ,'/yr','') AS REAL)
                  )                                         AS "avg_salary_city",
               ROW_NUMBER() OVER (PARTITION BY "Location"
                                  ORDER BY AVG(
                                          CAST(
                                                REPLACE(
                                                  REPLACE(
                                                    REPLACE("Salary",'₹','')
                                                  ,',','')
                                                ,'/yr','') AS REAL)
                                        ) DESC)             AS rn
        FROM   "SalaryDataset"
        WHERE  "Location" IN ('Mumbai','Pune','New Delhi','Hyderabad')
        GROUP  BY "Location","CompanyName"
     ) AS t
JOIN (
        SELECT AVG(
                   CAST(
                         REPLACE(
                           REPLACE(
                             REPLACE("Salary",'₹','')
                           ,',','')
                         ,'/yr','') AS REAL))  AS "avg_salary_country"
        FROM   "SalaryDataset"
     ) AS c
WHERE  t.rn <= 5
ORDER  BY t."Location",
          t."avg_salary_city" DESC
LIMIT 20;
```

```sql
--Description: 8) (Optional) See the final ordered list without the LIMIT clause
SELECT t."Location",
       t."CompanyName",
