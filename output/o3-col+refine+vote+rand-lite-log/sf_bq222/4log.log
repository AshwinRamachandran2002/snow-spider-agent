```sql
--Description:  Determine, for each CPC sub-class (first-4-character symbol) that appears
--              in German patents granted during December 2016, the calendar year in which
--              its exponential moving average (EMA, α = 0.1) of German patent-publication
--              counts is highest.  The query is kept compact yet self–contained:
--
--  • dec16_cls  – distinct CPC sub-classes taken from all DE publications whose
--                 grant_date lies in 2016-12.
--  • per_year   – yearly DISTINCT-publication counts in Germany for those sub-classes.
--  • ordered    – adds a sequential index (rn) per sub-class so the recursion can
--                 advance one step even when some years are missing.
--  • ema        – recursive CTE implementing  ema_t = 0.1·cnt_t + 0.9·ema_{t-1}.
--  • peak       – keeps only the row (year) with the highest EMA for each sub-class.
--  • final      – LEFT JOIN to CPC_DEFINITION (level 4) to obtain the full title
--                 where available; if missing, ‘N/A’ is shown.  The result is ordered
--                 by descending EMA and limited to 20 rows.
WITH
dec16_cls AS (   ---------------------------------------------------------------
    SELECT DISTINCT
           SUBSTRING(f.value:"code"::STRING,1,4)        AS cpc_subclass
    FROM   PATENTS.PATENTS.PUBLICATIONS p
    JOIN  (SELECT "publication_number"
           FROM   PATENTS.PATENTS.PUBLICATIONS
           WHERE  "country_code" = 'DE'
             AND  "grant_date"   BETWEEN 20161201 AND 20161231) g
      ON  p."publication_number" = g."publication_number"
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
),
per_year AS (     ---------------------------------------------------------------
    SELECT
        SUBSTRING(f.value:"code"::STRING,1,4)           AS cpc_subclass,
        FLOOR(p."publication_date"/10000)               AS pub_year,
        COUNT(DISTINCT p."publication_number")          AS pub_count
    FROM   PATENTS.PATENTS.PUBLICATIONS p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
    WHERE  p."country_code" = 'DE'
       AND SUBSTRING(f.value:"code"::STRING,1,4) IN (SELECT cpc_subclass FROM dec16_cls)
    GROUP BY 1,2
),
ordered AS (      ---------------------------------------------------------------
    SELECT  cpc_subclass,
            pub_year,
            pub_count,
            ROW_NUMBER() OVER (PARTITION BY cpc_subclass ORDER BY pub_year) AS rn
    FROM    per_year
),
ema AS (          ---------------------------------------------------------------
    SELECT  o.cpc_subclass,
            o.pub_year,
            o.pub_count,
            o.rn,
            o.pub_count                                  AS ema
    FROM    ordered o
    WHERE   o.rn = 1
    UNION ALL
    SELECT  o.cpc_subclass,
            o.pub_year,
            o.pub_count,
            o.rn,
            0.1 * o.pub_count + 0.9 * e.ema             AS ema
    FROM    ema e
    JOIN    ordered o
      ON    o.cpc_subclass = e.cpc_subclass
     AND    o.rn           = e.rn + 1
),
peak AS (        ---------------------------------------------------------------
    SELECT  cpc_subclass,
            pub_year    AS best_year,
            ema         AS max_ema,
            ROW_NUMBER() OVER (PARTITION BY cpc_subclass ORDER BY ema DESC) AS rnk
    FROM    ema
)
SELECT
    COALESCE(d."titleFull",'N/A')   AS cpc_full_title,
    p.cpc_subclass                  AS cpc_group,
    p.best_year                     AS year_of_highest_ema
FROM   peak p
LEFT  JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = p.cpc_subclass AND d."level" = 4
WHERE  p.rnk = 1
ORDER  BY p.max_ema DESC
LIMIT 20;
```
