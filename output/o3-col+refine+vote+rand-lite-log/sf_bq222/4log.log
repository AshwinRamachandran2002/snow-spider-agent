```sql
--Description: 9)  Compute the exponential moving average (α = 0.1) for every
--   sub-class with a *recursive* CTE.  This returns one EMA value per year.
WITH per_year AS (  /* identical to query #8 */ 
  SELECT SUBSTRING(f.value:"code"::STRING, 1, 4) AS "cpc_subclass",
         FLOOR(p."publication_date" / 10000)     AS "pub_year",
         COUNT(*)                                AS "pub_count"
  FROM PATENTS.PATENTS.PUBLICATIONS      p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
    AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (
          /* sub-classes of Dec-2016 grants */
          SELECT DISTINCT
                 SUBSTRING(f2.value:"code"::STRING, 1, 4)
          FROM PATENTS.PATENTS.PUBLICATIONS p2
          JOIN (
                SELECT "publication_number"
                FROM PATENTS.PATENTS.PUBLICATIONS
                WHERE "country_code" = 'DE'
                  AND "grant_date" BETWEEN 20161201 AND 20161231
               ) d2
            ON p2."publication_number" = d2."publication_number",
          LATERAL FLATTEN(input => p2."cpc") f2
        )
  GROUP BY 1, 2
),
ordered AS (
  SELECT "cpc_subclass",
         "pub_year",
         "pub_count",
         ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "pub_year") AS rn
  FROM per_year
),
/* recursive EMA:  ema_t = 0.1*count_t + 0.9*ema_{t-1} */
RECURSIVE ema AS (
  SELECT o."cpc_subclass",
         o."pub_year",
         o."pub_count",
         o."pub_count"                              AS "ema"      -- initialise with 1st year's count
  FROM ordered o
  WHERE o.rn = 1
  UNION ALL
  SELECT o."cpc_subclass",
         o."pub_year",
         o."pub_count",
         0.1 * o."pub_count" + 0.9 * e."ema"        AS "ema"
  FROM ema e
  JOIN ordered o
    ON  o."cpc_subclass" = e."cpc_subclass"
   AND o."pub_year"     = e."pub_year" + 1
)
SELECT *
FROM ema
ORDER BY "cpc_subclass", "pub_year"
LIMIT 20;
```

```sql
--Description: 10)  For every CPC technology area (sub-class) that appears in
--   German patents granted in December-2016, retrieve the year in which its
--   exponential moving average (α = 0.1) of patent filings peaks, then attach
--   the official CPC title (level-4) from CPC_DEFINITION.
WITH per_year AS (  /* same as query #8 */ 
  SELECT SUBSTRING(f.value:"code"::STRING, 1, 4) AS "cpc_subclass",
         FLOOR(p."publication_date" / 10000)     AS "pub_year",
         COUNT(*)                                AS "pub_count"
  FROM PATENTS.PATENTS.PUBLICATIONS      p,
       LATERAL FLATTEN(input => p."cpc") f
  WHERE p."country_code" = 'DE'
    AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (
          SELECT DISTINCT
                 SUBSTRING(f2.value:"code"::STRING, 1, 4)
          FROM PATENTS.PATENTS.PUBLICATIONS p2
          JOIN (
                SELECT "publication_number"
                FROM PATENTS.PATENTS.PUBLICATIONS
                WHERE "country_code" = 'DE'
                  AND "grant_date" BETWEEN 20161201 AND 20161231
               ) d2
            ON p2."publication_number" = d2."publication_number",
          LATERAL FLATTEN(input => p2."cpc") f2
        )
  GROUP BY 1, 2
),
ordered AS (
  SELECT "cpc_subclass",
         "pub_year",
         "pub_count",
         ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "pub_year") AS rn
  FROM per_year
),
RECURSIVE ema AS (   /* identical EMA recursion as query #9 */
  SELECT o."cpc_subclass",
         o."pub_year",
         o."pub_count",
         o."pub_count"                              AS "ema"
  FROM ordered o
  WHERE o.rn = 1
  UNION ALL
  SELECT o."cpc_subclass",
         o."pub_year",
         o."pub_count",
         0.1 * o."pub_count" + 0.9 * e."ema"        AS "ema"
  FROM ema e
  JOIN ordered o
    ON  o."cpc_subclass" = e."cpc_subclass"
   AND o."pub_year"     = e."pub_year" + 1
),
peak AS (
  SELECT "cpc_subclass",
         FIRST_VALUE("pub_year")   OVER (PARTITION BY "cpc_subclass" ORDER BY "ema" DESC) AS "best_year",
         MAX("ema")                AS "max_ema"
  FROM ema
  GROUP BY 1
)
SELECT d."titleFull"                   AS "cpc_full_title",
       p."cpc_subclass"                AS "cpc_group",
       p."best_year"                   AS "year_of_highest_ema"
FROM peak p
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = p."cpc_subclass"
WHERE d."level" = 4
ORDER BY p."max_ema" DESC
LIMIT 20;
```
