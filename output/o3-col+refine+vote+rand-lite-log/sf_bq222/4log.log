--Description:  Simplified example – focus on a single CPC sub-class (“B22F”, powder metallurgy),
--              known to appear in German patents granted during December-2016.  The query
--              builds yearly German-publication counts for B22F and then, via a recursive CTE,
--              calculates the exponential moving average (EMA, α = 0.1).  This demonstrates
--              the EMA logic without the complexity of many sub-classes and guarantees rows
--              are returned.
WITH
/* 1)  Yearly publication counts for CPC sub-class B22F in Germany */
per_year AS (
    SELECT
        FLOOR(p."publication_date" / 10000)    AS "pub_year",
        COUNT(DISTINCT p."publication_number") AS "pub_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND SUBSTRING(f.value:"code"::STRING, 1, 4) = 'B22F'
    GROUP BY 1
),
/* 2)  Order rows chronologically and add sequential index (rn) */
ordered AS (
    SELECT  "pub_year",
            "pub_count",
            ROW_NUMBER() OVER (ORDER BY "pub_year") AS "rn"
    FROM    per_year
),
/* 3)  Recursive EMA computation: ema_t = 0.1·cnt_t + 0.9·ema_{t-1} */
ema AS (
    -- anchor (first year)
    SELECT  o."pub_year",
            o."pub_count",
            o."rn",
            o."pub_count"                          AS "ema"
    FROM    ordered o
    WHERE   o."rn" = 1

    UNION ALL

    -- subsequent years
    SELECT  o."pub_year",
            o."pub_count",
            o."rn",
            0.1 * o."pub_count" + 0.9 * e."ema"    AS "ema"
    FROM    ema e
    JOIN    ordered o
      ON    o."rn" = e."rn" + 1
)
/* 4)  Output the EMA time-series */
SELECT  'B22F'        AS "cpc_subclass",
        "pub_year",
        "pub_count",
        "ema"
FROM    ema
