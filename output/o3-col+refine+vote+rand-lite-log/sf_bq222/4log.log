```sql
--Description:  Compute the exponential moving average (EMA, α = 0.1) of yearly German
--              patent-publication counts for every CPC sub-class that occurs in patents
--              granted during December 2016, then return (for each sub-class) the year
--              where that EMA peaks, together with the official level-4 CPC title.
--              -----------------------------------------------------------------
--              1. dec16_cls  – distinct CPC sub-classes (first 4 chars) extracted from
--                 German publications whose grant_date lies between 2016-12-01 and 2016-12-31.
--              2. per_year   – yearly DISTINCT-publication counts in Germany for those
--                 sub-classes (year = publication_date ÷ 10000).
--              3. ordered    – adds a sequential index (rn) per sub-class so the recursion
--                 can advance one step at a time even if years are missing.
--              4. ema        – RECURSIVE CTE implementing  ema_t = 0.1·cnt_t + 0.9·ema_{t-1}.
--              5. peak       – pick the row with the highest EMA per sub-class (QUALIFY).
--              6. Final      – attach CPC_DEFINITION titles and list the top 20 rows.
WITH
/*--------------------------------------------------------------*/
dec16_cls AS (  -- CPC sub-classes present in German grants (Dec-2016)
    SELECT DISTINCT
           SUBSTRING(f.value:"code"::STRING, 1, 4) AS "cpc_subclass"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    JOIN (
          SELECT "publication_number"
          FROM   PATENTS.PATENTS.PUBLICATIONS
          WHERE  "country_code" = 'DE'
            AND  "grant_date"   BETWEEN 20161201 AND 20161231
         ) g
      ON p."publication_number" = g."publication_number"
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
),
/*--------------------------------------------------------------*/
per_year AS (   -- yearly German publication counts for those sub-classes
    SELECT
        SUBSTRING(f.value:"code"::STRING, 1, 4)     AS "cpc_subclass",
        FLOOR(p."publication_date" / 10000)         AS "pub_year",
        COUNT(DISTINCT p."publication_number")      AS "pub_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (SELECT "cpc_subclass" FROM dec16_cls)
    GROUP BY 1, 2
),
/*--------------------------------------------------------------*/
ordered AS (    -- sequential index per sub-class
    SELECT  "cpc_subclass",
            "pub_year",
            "pub_count",
            ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "pub_year") AS "rn"
    FROM    per_year
),
/*--------------------------------------------------------------*/
ema AS (        -- recursive EMA computation (α = 0.1)
    -- anchor: first chronological year of each sub-class
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            o."rn",
            o."pub_count"                         AS "ema"
    FROM    ordered o
    WHERE   o."rn" = 1
    UNION ALL
    -- inductive step: advance one year
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            o."rn",
            0.1 * o."pub_count" + 0.9 * e."ema"  AS "ema"
    FROM    ema e
    JOIN    ordered o
      ON    o."cpc_subclass" = e."cpc_subclass"
     AND    o."rn"           = e."rn" + 1
),
/*--------------------------------------------------------------*/
peak AS (       -- retain the year with the highest EMA per sub-class
    SELECT  "cpc_subclass",
            "pub_year"  AS "best_year",
            "ema"       AS "max_ema"
    FROM    (
             SELECT *, 
                    ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "ema" DESC) AS rnk
             FROM   ema
            )
    WHERE rnk = 1
)
/*--------------------------------------------------------------*/
SELECT  d."titleFull"           AS "cpc_full_title",
        p."cpc_subclass"        AS "cpc_group",
        p."best_year"           AS "year_of_highest_ema"
FROM    peak p
JOIN    PATENTS.PATENTS.CPC_DEFINITION d
  ON    d."symbol" = p."cpc_subclass"
WHERE   d."level" = 4
ORDER BY p."max_ema" DESC
LIMIT 20;
