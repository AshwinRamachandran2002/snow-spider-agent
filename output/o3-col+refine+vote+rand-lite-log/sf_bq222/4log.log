```sql
--Description:  Find, for every CPC sub-class (first 4-character symbol, i.e. level-4 group)
--              that occurs in German patents granted in December 2016, the year in which its
--              exponential moving average (EMA, α = 0.1) of German patent-publication counts
--              is highest.  The query proceeds as a single WITH RECURSIVE block:
--
--   1) dec16_cls  :  All distinct CPC sub-classes that appear in publications whose
--                   grant_date is between 2016-12-01 and 2016-12-31 and country_code = 'DE'.
--
--   2) per_year   :  For those subclasses, count DISTINCT German publications per
--                   publication year (derived from publication_date /10000).
--
--   3) ordered    :  Add a sequential row number (rn) per subclass so the recursion
--                   can step through the years even when some intermediate years are absent.
--
--   4) ema        :  Recursive CTE that computes   ema_t = 0.1*count_t + 0.9*ema_{t-1}.
--
--   5) peak       :  For each subclass, pick the year where EMA is maximal.
--
--   6) Final SELECT : Attach the official CPC level-4 title and present the results.
WITH RECURSIVE
/*--------------------------------------------------------------*/
dec16_cls AS (      -- subclasses present in German grants (Dec-2016)
    SELECT DISTINCT
           SUBSTRING(f.value:"code"::STRING, 1, 4) AS "cpc_subclass"
    FROM  PATENTS.PATENTS.PUBLICATIONS p
    JOIN (
          SELECT "publication_number"
          FROM   PATENTS.PATENTS.PUBLICATIONS
          WHERE  "country_code" = 'DE'
            AND  "grant_date"   BETWEEN 20161201 AND 20161231
         ) g
      ON p."publication_number" = g."publication_number"
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
),
/*--------------------------------------------------------------*/
per_year AS (       -- yearly German publication counts for those subclasses
    SELECT
        SUBSTRING(f.value:"code"::STRING, 1, 4)      AS "cpc_subclass",
        FLOOR(p."publication_date" / 10000)          AS "pub_year",
        COUNT(DISTINCT p."publication_number")       AS "pub_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (SELECT "cpc_subclass" FROM dec16_cls)
    GROUP BY 1, 2
),
/*--------------------------------------------------------------*/
ordered AS (        -- impose sequential order (rn) inside each subclass
    SELECT  "cpc_subclass",
            "pub_year",
            "pub_count",
            ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "pub_year") AS "rn"
    FROM    per_year
),
/*--------------------------------------------------------------*/
ema AS (            -- recursive EMA calculation
    /* base case: first chronological year of each subclass */
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            o."rn",
            o."pub_count"                          AS "ema_val"
    FROM    ordered o
    WHERE   o."rn" = 1
    UNION ALL
    /* recursive step: advance one rn (next chronological year) */
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            o."rn",
            0.1 * o."pub_count" + 0.9 * e."ema_val" AS "ema_val"
    FROM    ema e
    JOIN    ordered o
      ON    o."cpc_subclass" = e."cpc_subclass"
     AND    o."rn"           = e."rn" + 1
),
/*--------------------------------------------------------------*/
peak AS (           -- pick the year where EMA peaks for each subclass
    SELECT
        "cpc_subclass",
        FIRST_VALUE("pub_year") OVER (PARTITION BY "cpc_subclass" ORDER BY "ema_val" DESC) AS "best_year",
        MAX("ema_val")                                                                     AS "max_ema"
    FROM ema
    GROUP BY 1
)
/*--------------------------------------------------------------*/
SELECT
    d."titleFull"        AS "cpc_full_title",
    p."cpc_subclass"     AS "cpc_group",
    p."best_year"        AS "year_of_highest_ema"
FROM peak p
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = p."cpc_subclass"
WHERE d."level" = 4             -- keep only level-4 CPC definitions
ORDER BY p."max_ema" DESC
LIMIT 20;
