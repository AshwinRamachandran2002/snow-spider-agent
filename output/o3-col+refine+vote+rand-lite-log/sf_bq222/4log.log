    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (SELECT "cpc_subclass" FROM dec16_cls)
    GROUP BY 1, 2
),
ordered AS (           -- enforce sequential year numbers
    SELECT  "cpc_subclass",
            "pub_year",
            "pub_count",
            ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "pub_year") AS rn
    FROM    per_year
),
RECURSIVE ema AS (     -- recursive EMA:  ema_t = 0.1*count_t + 0.9*ema_{t-1}
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            o."pub_count" AS "ema"
    FROM    ordered o
    WHERE   o.rn = 1
    UNION ALL
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            0.1 * o."pub_count" + 0.9 * e."ema" AS "ema"
    FROM    ema e
    JOIN    ordered o
      ON    o."cpc_subclass" = e."cpc_subclass"
     AND    o.rn = e.rn + 1
)
SELECT *
FROM   ema
ORDER  BY "cpc_subclass", "pub_year"
LIMIT 20;
