```sql
--Description:
--  Goal:  For every CPC sub-class (first 4 chars) that occurs in German patents granted in
--         December-2016, show how many German patent publications were issued per year.
--  Steps / Thinking:
--    1. dec16_grants : find all German publications with grant_date in 2016-12 and keep
--       their publication_numbers.
--    2. dec16_cls    : flatten the CPC arrays of those grants to extract the relevant
--       CPC sub-classes (level-4 symbols) and keep a DISTINCT list.
--    3. per_year     : for the whole PUBLICATIONS table (Germany only), flatten CPC arrays,
--       filter rows whose sub-class is in dec16_cls, derive the publication year from the
--       numeric YYYYMMDD date, and count DISTINCT publication_numbers per (sub-class, year).
--    4. Final SELECT : display a sample (LIMIT 20) ordered by sub-class then year so that
--       we can inspect the raw time-series that will feed the EMA calculation next.
WITH dec16_grants AS (
    SELECT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'DE'
      AND "grant_date" BETWEEN 20161201 AND 20161231
),
dec16_cls AS (
    SELECT DISTINCT
           SUBSTRING(f.value:"code"::STRING, 1, 4) AS "cpc_subclass"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    JOIN dec16_grants g
      ON p."publication_number" = g."publication_number",
    LATERAL FLATTEN(input => p."cpc") f
),
per_year AS (
    SELECT
        SUBSTRING(f.value:"code"::STRING, 1, 4)   AS "cpc_subclass",
        FLOOR(p."publication_date" / 10000)       AS "pub_year",
        COUNT(DISTINCT p."publication_number")    AS "pub_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (SELECT "cpc_subclass" FROM dec16_cls)
    GROUP BY 1, 2
)
SELECT *
FROM per_year
ORDER BY "cpc_subclass", "pub_year"
LIMIT 20;
```
