--Description: 10)  For each CPC sub-class that appears in German patents granted
--                in Dec-2016, return the year with the highest exponential moving
--                average of filings together with the official level-4 CPC title.
WITH dec16_cls AS (      -- subclasses from Dec-2016 grants
    SELECT DISTINCT
           SUBSTRING(f.value:"code"::STRING, 1, 4) AS "cpc_subclass"
    FROM  PATENTS.PATENTS.PUBLICATIONS p
    JOIN (
           SELECT "publication_number"
           FROM PATENTS.PATENTS.PUBLICATIONS
           WHERE "country_code" = 'DE'
             AND "grant_date" BETWEEN 20161201 AND 20161231
         ) g
      ON p."publication_number" = g."publication_number"
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
),
per_year AS (           -- yearly counts for those subclasses
    SELECT
        SUBSTRING(f.value:"code"::STRING, 1, 4)     AS "cpc_subclass",
        FLOOR(p."publication_date" / 10000)         AS "pub_year",
        COUNT(DISTINCT p."publication_number")      AS "pub_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p
    CROSS JOIN LATERAL FLATTEN(input => p."cpc") f
    WHERE p."country_code" = 'DE'
      AND SUBSTRING(f.value:"code"::STRING, 1, 4) IN (SELECT "cpc_subclass" FROM dec16_cls)
    GROUP BY 1, 2
),
ordered AS (           -- sequential numbering per subclass
    SELECT  "cpc_subclass",
            "pub_year",
            "pub_count",
            ROW_NUMBER() OVER (PARTITION BY "cpc_subclass" ORDER BY "pub_year") AS rn
    FROM    per_year
),
RECURSIVE ema AS (     -- exponential moving average
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            o."pub_count" AS "ema"
    FROM    ordered o
    WHERE   o.rn = 1
    UNION ALL
    SELECT  o."cpc_subclass",
            o."pub_year",
            o."pub_count",
            0.1 * o."pub_count" + 0.9 * e."ema" AS "ema"
    FROM    ema e
    JOIN    ordered o
      ON    o."cpc_subclass" = e."cpc_subclass"
     AND    o.rn = e.rn + 1
),
peak AS (              -- pick year with highest EMA per subclass
    SELECT  "cpc_subclass",
            FIRST_VALUE("pub_year") OVER (PARTITION BY "cpc_subclass" ORDER BY "ema" DESC) AS "best_year",
            MAX("ema")  AS "max_ema"
    FROM    ema
    GROUP BY 1
)
SELECT  d."titleFull"        AS "cpc_full_title",
        p."cpc_subclass"     AS "cpc_group",
        p."best_year"        AS "year_of_highest_ema"
FROM    peak p
JOIN    PATENTS.PATENTS.CPC_DEFINITION d
  ON    d."symbol" = p."cpc_subclass"
WHERE   d."level" = 4
ORDER BY p."max_ema" DESC
LIMIT 20;
