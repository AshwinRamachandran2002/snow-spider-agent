--Description: Snowflake’s EMA( value , alpha ) analytic function cannot use an UNBOUNDED frame,
--             so apply a long—but finite—window: the previous 99 years plus the current year.
--             This gives nearly the same effect as a cumulative EMA while satisfying syntax.
--             The query returns annual German patent-filing counts for each CPC group together
--             with the corresponding exponential moving average (α = 0.1).
SELECT
  "cpc_group",
  "year",
  "filings",
  EMA("filings", 0.1)
      OVER (
        PARTITION BY "cpc_group"
        ORDER BY "year"
        ROWS BETWEEN 99 PRECEDING AND CURRENT ROW
      ) AS "ema_0p1"
FROM (
  SELECT
    SPLIT_PART(c.value:"code"::STRING, '/', 0) AS "cpc_group",
    FLOOR("publication_date" / 10000)          AS "year",
    COUNT(*)                                   AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") c
  WHERE t."country_code" = 'DE'
    AND t."publication_date" IS NOT NULL
  GROUP BY 1, 2
)
ORDER BY "cpc_group", "year"
LIMIT 20;
