```sql
--Description:  Starting from German patents whose GRANT_DATE falls within December 2016,
--              this single query
--              1)  extracts every CPC code attached to those patents,
--              2)  maps each code to its CPC “class” (level-4 symbol = 1 letter + 2 digits, e.g. “H04”),
--              3)  counts, for each class and publication YEAR, how many of those Dec-2016 patents
--                 were published that year,
--              4)  manually computes the exponential moving average (EMA, α = 0.1) of those annual
--                 counts by summing α·(1-α)^(lag)-weighted past filings,
--              5)  selects, for every CPC class, the single YEAR in which that EMA is highest, and
--              6)  joins to CPC_DEFINITION (level 4) to display the full technology title.
WITH december_grants AS (       -- patents granted in Germany during December 2016
    SELECT
        t."publication_date",
        SPLIT_PART(c.value:"code"::STRING, '/', 0) AS "cpc_full"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") c
    WHERE t."country_code" = 'DE'
      AND t."grant_date" BETWEEN 20161201 AND 20161231
),
yearly AS (                     -- annual filing counts per CPC class
    SELECT
        SUBSTRING("cpc_full", 1, 3)            AS "cpc_class",   -- level-4 symbol
        FLOOR("publication_date" / 10000)      AS "year",
        COUNT(*)                               AS "filings"
    FROM december_grants
    GROUP BY 1, 2
),
ema_calc AS (                   -- manual EMA across years (α = 0.1)
    SELECT
        cur."cpc_class",
        cur."year",
        SUM(0.1 * prev."filings" * POWER(0.9, cur."year" - prev."year")) AS "ema_0p1"
    FROM yearly cur
    JOIN yearly prev
      ON cur."cpc_class" = prev."cpc_class"
     AND prev."year"     <= cur."year"
    GROUP BY cur."cpc_class", cur."year"
),
best_year AS (                  -- keep the year with the peak EMA for each class
    SELECT
        "cpc_class",
        "year",
        "ema_0p1",
        ROW_NUMBER() OVER (PARTITION BY "cpc_class" ORDER BY "ema_0p1" DESC) AS rn
    FROM ema_calc
)
SELECT
    b."cpc_class"                    AS "cpc_group_level4",
    d."titleFull"                    AS "cpc_title",
    b."year"                         AS "best_year",
    b."ema_0p1"                      AS "max_ema_0p1"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_class"
      AND d."level"  = 4
WHERE b.rn = 1
ORDER BY b."ema_0p1" DESC
LIMIT 20;
```
