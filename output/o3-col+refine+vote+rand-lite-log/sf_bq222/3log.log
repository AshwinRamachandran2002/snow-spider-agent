--Description: 8) Aggregate annual filing counts (by publication year) for every German CPC group
--   – this will be the base series to which we will later apply the exponential moving average.
SELECT
  SPLIT_PART(c.value:"code"::STRING, '/', 0)              AS "cpc_group",
  FLOOR("publication_date" / 10000)                       AS "year",   -- extract YYYY from YYYYMMDD numeric
  COUNT(*)                                                AS "filings"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c
WHERE t."country_code" = 'DE'
  AND t."publication_date" IS NOT NULL
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: 9) Compute the exponential moving average (α = 0.1) of annual filings
--   for each CPC group using Snowflake’s EXPONENTIAL_MOVING_AVERAGE window function.
SELECT
  "cpc_group",
  "year",
  "filings",
  EXPONENTIAL_MOVING_AVERAGE("filings", 0.1)
      OVER (PARTITION BY "cpc_group" ORDER BY "year") AS "ema_0p1"
FROM (
  SELECT
    SPLIT_PART(c.value:"code"::STRING, '/', 0)         AS "cpc_group",
    FLOOR("publication_date" / 10000)                  AS "year",
    COUNT(*)                                           AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") c
  WHERE t."country_code" = 'DE'
    AND t."publication_date" IS NOT NULL
  GROUP BY 1, 2
)
ORDER BY "cpc_group", "year"
LIMIT 20;
```

```sql
--Description: 10) For every CPC group, retrieve the single year where the EMA(0.1) is maximal,
--   then attach the level-4 CPC title for that group.
SELECT
  g."cpc_group",
  d."titleFull"                       AS "cpc_title",
  g."year",
  g."ema_0p1"
FROM (
  SELECT
    "cpc_group",
    "year",
    "ema_0p1",
    ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "ema_0p1" DESC) AS rn
  FROM (
    SELECT
      "cpc_group",
      "year",
      EXPONENTIAL_MOVING_AVERAGE("filings", 0.1)
        OVER (PARTITION BY "cpc_group" ORDER BY "year") AS "ema_0p1"
    FROM (
      SELECT
        SPLIT_PART(c.value:"code"::STRING, '/', 0)      AS "cpc_group",
        FLOOR("publication_date" / 10000)               AS "year",
        COUNT(*)                                        AS "filings"
      FROM PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."cpc") c
      WHERE t."country_code" = 'DE'
        AND t."publication_date" IS NOT NULL
      GROUP BY 1, 2
    )
  )
  WHERE rn = 1
) g
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" ILIKE g."cpc_group" || '%'   -- use ILIKE to match case-insensitive and include sub-groups
  AND d."level" = 4
ORDER BY g."ema_0p1" DESC
LIMIT 20;
