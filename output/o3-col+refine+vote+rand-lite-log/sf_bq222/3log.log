```sql
--Description: 1) Peek at German patents that were granted in December-2016.
SELECT 
  "publication_number",
  "grant_date",
  "publication_date",
  "country_code",
  "cpc"
FROM PATENTS.PATENTS.PUBLICATIONS
WHERE "country_code" = 'DE'
  AND "grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 2) Flatten the CPC list for those December-2016 German grants to see individual CPC codes.
SELECT 
  t."publication_number",
  t."grant_date",
  c.value:"code"::STRING      AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c
WHERE t."country_code" = 'DE'
  AND t."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 3) Show distinct CPC codes (full) that appear for the December-2016 German grants.
SELECT DISTINCT
  c.value:"code"::STRING  AS "cpc_code"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c
WHERE t."country_code" = 'DE'
  AND t."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 4) Reduce the CPC code to the “group” by trimming everything after the slash.
--   This will later be used as the level-4 group key (“H04L9”, “G06F7”, …).
SELECT DISTINCT
  SPLIT_PART(c.value:"code"::STRING, '/', 0) AS "cpc_group"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c
WHERE t."country_code" = 'DE'
  AND t."grant_date" BETWEEN 20161201 AND 20161231
LIMIT 20;
```

```sql
--Description: 5) Count how many German patents (granted Dec-2016) belong to each CPC group.
SELECT 
  SPLIT_PART(c.value:"code"::STRING, '/', 0) AS "cpc_group",
  COUNT(*)                                     AS "patent_count"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c
WHERE t."country_code" = 'DE'
  AND t."grant_date" BETWEEN 20161201 AND 20161231
GROUP BY 1
ORDER BY "patent_count" DESC
LIMIT 20;
```

```sql
--Description: 6) Look at CPC-definition rows that are registered as level-4 groups
--   (will provide the full technology titles we need in the final join).
SELECT 
  "symbol",
  "titleFull",
  "level"
FROM PATENTS.PATENTS.CPC_DEFINITION
WHERE "level" = 4
LIMIT 20;
```

```sql
--Description: 7) Quick check: for a specific code pattern (e.g. H04L9) get all matching level-4 titles.
SELECT 
  "symbol",
  "titleFull",
  "level"
FROM PATENTS.PATENTS.CPC_DEFINITION
WHERE "symbol" LIKE 'H04L9%'
  AND "level" = 4
LIMIT 20;
```

```sql
--Description: 8) Aggregate annual filing counts (by publication year) for every German CPC group
--   – this will be the base series to which we will later apply the exponential moving average.
SELECT
  SPLIT_PART(c.value:"code"::STRING, '/', 0)                    AS "cpc_group",
  FLOOR("publication_date"/10000)                               AS "year",  --YYYY from YYYYMMDD number
  COUNT(*)                                                      AS "filings"
FROM PATENTS.PATENTS.PUBLICATIONS t,
     LATERAL FLATTEN(input => t."cpc") c
WHERE t."country_code" = 'DE'
  AND t."publication_date" IS NOT NULL
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: 9) Compute the exponential moving average (α = 0.1) of annual filings
--   for each CPC group using the built-in EXPONENTIAL_MOVING_AVERAGE window function.
SELECT
  "cpc_group",
  "year",
  "filings",
  EXPONENTIAL_MOVING_AVERAGE("filings", 0.1)
      OVER (PARTITION BY "cpc_group" ORDER BY "year")  AS "ema_0p1"
FROM (
  SELECT
    SPLIT_PART(c.value:"code"::STRING, '/', 0)         AS "cpc_group",
    FLOOR("publication_date"/10000)                    AS "year",
    COUNT(*)                                           AS "filings"
  FROM PATENTS.PATENTS.PUBLICATIONS t,
       LATERAL FLATTEN(input => t."cpc") c
  WHERE t."country_code" = 'DE'
    AND t."publication_date" IS NOT NULL
  GROUP BY 1,2
)
ORDER BY "cpc_group", "year"
LIMIT 20;
```

```sql
--Description: 10) For every CPC group retrieve the single year where the EMA(0.1) is maximal,
--   and attach the level-4 CPC title (final format preview).
SELECT
  g."cpc_group",
  d."titleFull"                           AS "cpc_title",
  g."year",
  g."ema_0p1"
FROM (
  SELECT
    "cpc_group",
    "year",
    "ema_0p1",
    ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "ema_0p1" DESC) AS rn
  FROM (
    SELECT
      "cpc_group",
      "year",
      EXPONENTIAL_MOVING_AVERAGE("filings", 0.1)
        OVER (PARTITION BY "cpc_group" ORDER BY "year") AS "ema_0p1"
    FROM (
      SELECT
        SPLIT_PART(c.value:"code"::STRING, '/', 0)      AS "cpc_group",
        FLOOR("publication_date"/10000)                 AS "year",
        COUNT(*)                                        AS "filings"
      FROM PATENTS.PATENTS.PUBLICATIONS t,
           LATERAL FLATTEN(input => t."cpc") c
      WHERE t."country_code" = 'DE'
        AND t."publication_date" IS NOT NULL
      GROUP BY 1,2
    )
  )
  WHERE rn = 1
) g
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" LIKE g."cpc_group" || '%'
  AND d."level" = 4
ORDER BY g."ema_0p1" DESC
LIMIT 20;
```
