--Description: Use Snowflake’s analytic function EMA(value , alpha) to calculate the
--             exponential moving average (α = 0.1) of annual German patent-filing counts
--             per CPC group.  The window frame “UNBOUNDED PRECEDING … CURRENT ROW”
--             is required for a cumulative EMA over time.
SELECT
  "cpc_group",
  "year",
  "filings",
  EMA("filings", 0.1)
      OVER (
        PARTITION BY "cpc_group"
        ORDER BY "year"
