```sql
--Description: Manually compute the exponential moving average (α = 0.1) of annual German
--             patent-filing counts for each CPC group without relying on Snowflake’s EMA/EXPONENTIAL_MOVING_AVERAGE
--             (which raise window-frame errors).  The EMA for year t is:
--                 EMA_t = α·x_t + α·(1−α)·x_{t−1} + α·(1−α)^2·x_{t−2} + … ,
--             which equals the weighted sum of all current-and-prior years’ filings with geometric
--             decay factor (1−α).  A self-join implements this formula and SUM() aggregates the
--             weighted contributions.
WITH yearly AS (
    SELECT
        SPLIT_PART(c.value:"code"::STRING, '/', 0) AS "cpc_group",
        FLOOR("publication_date" / 10000)          AS "year",
        COUNT(*)                                   AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS t,
         LATERAL FLATTEN(input => t."cpc") c
    WHERE t."country_code" = 'DE'
      AND t."publication_date" IS NOT NULL
    GROUP BY 1, 2
)
SELECT
    curr."cpc_group",
    curr."year",
    curr."filings",
    SUM(0.1 * prev."filings" * POWER(0.9, curr."year" - prev."year")) AS "ema_0p1"
FROM yearly curr
JOIN yearly prev
  ON  curr."cpc_group" = prev."cpc_group"
  AND prev."year"      <= curr."year"          -- include current & all earlier years
GROUP BY curr."cpc_group", curr."year", curr."filings"
ORDER BY curr."cpc_group", curr."year"
LIMIT 20;
```
