```sql
--Description: 10) For every CPC “class” (level-4 code: one section letter + two digits, e.g. “H04”),
--             find the year with the highest exponential moving average (α = 0.1) of German
--             patent-filing counts, then attach the level-4 CPC title.
WITH yearly AS (   -- annual filings per CPC class (level-4)
    SELECT
        SUBSTRING(SPLIT_PART(c.value:"code"::STRING, '/', 0), 1, 3)  AS "cpc_class",  -- e.g. H04
        FLOOR("publication_date" / 10000)                            AS "year",
        COUNT(*)                                                     AS "filings"
    FROM PATENTS.PATENTS.PUBLICATIONS  t,
         LATERAL FLATTEN(input => t."cpc") c
    WHERE t."country_code" = 'DE'
      AND t."publication_date" IS NOT NULL
    GROUP BY 1, 2
),
ema_calc AS (       -- manual EMA: α·x_t + α(1-α)x_{t-1} + …
    SELECT
        cur."cpc_class",
        cur."year",
        SUM(0.1 * prev."filings" * POWER(0.9, cur."year" - prev."year")) AS "ema_0p1"
    FROM yearly cur
    JOIN yearly prev
      ON  cur."cpc_class" = prev."cpc_class"
      AND prev."year"     <= cur."year"
    GROUP BY cur."cpc_class", cur."year"
),
best_year AS (      -- pick the year with the peak EMA for each class
    SELECT
        "cpc_class",
        "year",
        "ema_0p1",
        ROW_NUMBER() OVER (PARTITION BY "cpc_class" ORDER BY "ema_0p1" DESC) AS rn
    FROM ema_calc
)
SELECT
    b."cpc_class"                         AS "cpc_group_level4",
    d."titleFull"                         AS "cpc_title",
    b."year"                              AS "best_year",
    b."ema_0p1"                           AS "max_ema_0p1"
FROM best_year b
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = b."cpc_class"
      AND d."level"  = 4
WHERE b.rn = 1
ORDER BY b."max_ema_0p1" DESC
LIMIT 20;
```
