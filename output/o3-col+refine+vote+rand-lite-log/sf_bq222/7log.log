```sql
--Description:  FINAL – Identify all CPC codes that appear on German patents granted
--              in December 2016, collapse each detailed code to its main-group
--              (“<prefix>/00”), compute the exponential moving average (α = 0.1) of
--              yearly German grant counts for every such main group, and report
--              the year in which that EMA peaks.  No level filter is enforced when
--              joining CPC_DEFINITION so that a title is shown whenever it exists.
WITH RECURSIVE
/* A. patents granted in DE during Dec-2016 ------------------------------ */
december16 AS (
    SELECT DISTINCT "publication_number"
    FROM PATENTS.PATENTS.PUBLICATIONS
    WHERE "country_code" = 'DE'
      AND "grant_date" BETWEEN 20161201 AND 20161231
),

/* B. CPC codes present on those patents -------------------------------- */
dec_cpc AS (
    SELECT DISTINCT c.value:"code"::STRING AS detailed_code
    FROM PATENTS.PATENTS.PUBLICATIONS p
    JOIN december16 d
      ON d."publication_number" = p."publication_number",
         LATERAL FLATTEN(input => p."cpc") c
),

/* C. yearly counts for ALL German grants, but keep only CPCs seen in B -- */
detail_year AS (
    SELECT SUBSTR(CAST("grant_date" AS STRING), 1, 4)     AS "year",
           c.value:"code"::STRING                         AS detailed_code,
           COUNT(*)                                       AS "patent_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE p."country_code" = 'DE'
      AND c.value:"code"::STRING IN (SELECT detailed_code FROM dec_cpc)
    GROUP BY "year", detailed_code
),

/* D. collapse each detailed code to its main group "<prefix>/00" -------- */
yr AS (
    SELECT "year",
           CONCAT(SPLIT_PART(detailed_code, '/', 1), '/00') AS cpc_code,
           SUM("patent_count")                              AS patent_count
    FROM detail_year
    GROUP BY "year", cpc_code
),

/* E. chronological ordering per CPC group ------------------------------ */
ordered AS (
    SELECT cpc_code,
           TO_NUMBER("year")                                AS yr,
           patent_count,
           ROW_NUMBER() OVER (PARTITION BY cpc_code
                               ORDER BY TO_NUMBER("year"))  AS rn
    FROM yr
),

/* F. recursive EMA computation ----------------------------------------- */
ema AS (
    -- seed row
    SELECT cpc_code, yr, patent_count,
           patent_count                                     AS ema_val,
           rn
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- recursive step
    SELECT o.cpc_code,
           o.yr,
           o.patent_count,
           0.1 * o.patent_count + 0.9 * e.ema_val          AS ema_val,
           o.rn
    FROM ema e
    JOIN ordered o
      ON o.cpc_code = e.cpc_code
     AND o.rn       = e.rn + 1
),

/* G. pick the year where EMA is highest for each CPC group ------------- */
peak AS (
    SELECT cpc_code,
           MAX_BY(OBJECT_CONSTRUCT('yr',  yr,
                                    'ema', ema_val), ema_val) AS max_obj
    FROM ema
    GROUP BY cpc_code
)

/* H. final output ------------------------------------------------------ */
SELECT p.cpc_code,
       d.titleFull,
       p.max_obj:"yr"  ::INTEGER  AS best_year,
       p.max_obj:"ema" ::FLOAT    AS best_ema,
       COALESCE(d.level, -1)      AS definition_level
FROM peak p
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d.symbol = p.cpc_code
ORDER BY best_ema DESC
LIMIT 20;
