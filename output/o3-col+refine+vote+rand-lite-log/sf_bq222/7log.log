JOIN   PATENTS.PATENTS.CPC_DEFINITION d
  ON   d."symbol" = b.subclass_code
 AND   d."level"  = 4.0                -- subclass level
WHERE  b.rnk = 1                       -- highest-EMA year per subclass
ORDER  BY b.ema_value DESC NULLS LAST; -- biggest EMA first
