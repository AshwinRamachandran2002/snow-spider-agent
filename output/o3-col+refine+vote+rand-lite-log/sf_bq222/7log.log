```sql
--Description: 7) Compute the exponential moving average (α = 0.1) for one sample CPC code to verify the maths  
WITH yr AS (
  SELECT SUBSTR(CAST("grant_date" AS STRING),1,4)      AS "year",
         c.value:"code"::STRING                        AS "cpc_code",
         COUNT(*)                                      AS "patent_count"
  FROM PATENTS.PATENTS.PUBLICATIONS  p,
       LATERAL FLATTEN (input => p."cpc") c
  WHERE p."country_code" = 'DE'
    AND c.value:"code"::STRING = 'H04L9/0844'          --sample code
  GROUP BY "year","cpc_code"
), 
ordered AS (
  SELECT "cpc_code",
         TO_NUMBER("year")                             AS "yr",
         "patent_count",
         ROW_NUMBER() OVER (ORDER BY TO_NUMBER("year")) AS rn
  FROM yr
),
RECURSIVE ema AS (                                     --Snowflake recursive CTE
  SELECT "cpc_code","yr","patent_count",
         "patent_count"                               AS ema_val,
         rn
  FROM ordered
  WHERE rn = 1
  
  UNION ALL
  
  SELECT o."cpc_code",
         o."yr",
         o."patent_count",
         0.1 * o."patent_count" + 0.9 * e.ema_val     AS ema_val,
         o.rn
  FROM ema e
  JOIN ordered o
    ON o."cpc_code" = e."cpc_code"
   AND o.rn = e.rn + 1
)
SELECT *
FROM ema
ORDER BY "yr"
LIMIT 20;
```

```sql
--Description: 8) Calculate yearly EMA for every CPC code and capture, for each code, the year where the EMA peaks  
WITH yr AS (
  SELECT SUBSTR(CAST("grant_date" AS STRING),1,4)      AS "year",
         c.value:"code"::STRING                        AS "cpc_code",
         COUNT(*)                                      AS "patent_count"
  FROM PATENTS.PATENTS.PUBLICATIONS  p,
       LATERAL FLATTEN (input => p."cpc") c
  WHERE p."country_code" = 'DE'
  GROUP BY "year","cpc_code"
),
ordered AS (
  SELECT "cpc_code",
         TO_NUMBER("year")                             AS "yr",
         "patent_count",
         ROW_NUMBER() OVER (PARTITION BY "cpc_code" ORDER BY TO_NUMBER("year")) AS rn
  FROM yr
),
RECURSIVE ema AS (
  SELECT "cpc_code","yr","patent_count",
         "patent_count"                               AS ema_val,
         rn
  FROM ordered
  WHERE rn = 1
  UNION ALL
  SELECT o."cpc_code",
         o."yr",
         o."patent_count",
         0.1 * o."patent_count" + 0.9 * e.ema_val,
         o.rn
  FROM ema e
  JOIN ordered o
    ON o."cpc_code" = e."cpc_code"
   AND o.rn = e.rn + 1
),
peak AS (
  SELECT "cpc_code",
         MAX_BY(OBJECT_CONSTRUCT('yr', "yr", 'ema', ema_val), ema_val) AS max_obj
  FROM ema
  GROUP BY "cpc_code"
)
SELECT p."cpc_code",
       p.max_obj:"yr"  ::INTEGER  AS "best_year",
       p.max_obj:"ema" ::FLOAT    AS "best_ema"
FROM peak p
ORDER BY "best_ema" DESC
LIMIT 20;
```

```sql
--Description: 9) Bring in the CPC_DEFINITION table; keep only level-4 groups and attach their full titles  
WITH yr AS (
  SELECT SUBSTR(CAST("grant_date" AS STRING),1,4)      AS "year",
         c.value:"code"::STRING                        AS "cpc_code",
         COUNT(*)                                      AS "patent_count"
  FROM PATENTS.PATENTS.PUBLICATIONS  p,
       LATERAL FLATTEN (input => p."cpc") c
  WHERE p."country_code" = 'DE'
  GROUP BY "year","cpc_code"
),
ordered AS (
  SELECT "cpc_code",
         TO_NUMBER("year")                             AS "yr",
         "patent_count",
         ROW_NUMBER() OVER (PARTITION BY "cpc_code" ORDER BY TO_NUMBER("year")) AS rn
  FROM yr
),
RECURSIVE ema AS (
  SELECT "cpc_code","yr","patent_count",
         "patent_count"                               AS ema_val,
         rn
  FROM ordered
  WHERE rn = 1
  UNION ALL
  SELECT o."cpc_code",
         o."yr",
         o."patent_count",
         0.1 * o."patent_count" + 0.9 * e.ema_val,
         o.rn
  FROM ema e
  JOIN ordered o
    ON o."cpc_code" = e."cpc_code"
   AND o.rn = e.rn + 1
),
peak AS (
  SELECT "cpc_code",
         MAX_BY(OBJECT_CONSTRUCT('yr', "yr", 'ema', ema_val), ema_val) AS max_obj
  FROM ema
  GROUP BY "cpc_code"
),
lvl4 AS (
  SELECT p."cpc_code",
         p.max_obj:"yr"  ::INTEGER  AS "best_year",
         p.max_obj:"ema" ::FLOAT    AS "best_ema"
  FROM peak p
  JOIN PATENTS.PATENTS.CPC_DEFINITION d
    ON d."symbol" = p."cpc_code"
