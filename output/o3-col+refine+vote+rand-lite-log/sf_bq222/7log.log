--Description: 10) FINAL – For level-4 CPC codes that appear in German patents granted
--                during December-2016, report their year of highest EMA (α = 0.1)  
WITH
    /* patents granted in DE during Dec-2016 ---------------------------------- */
    december16 AS (
        SELECT DISTINCT "publication_number"
        FROM PATENTS.PATENTS.PUBLICATIONS
        WHERE "country_code" = 'DE'
          AND "grant_date" BETWEEN 20161201 AND 20161231
    ),

    /* CPC codes on those patents -------------------------------------------- */
    dec_cpc AS (
        SELECT DISTINCT c.value:"code"::STRING AS "cpc_code"
        FROM PATENTS.PATENTS.PUBLICATIONS p
        JOIN december16 d
          ON d."publication_number" = p."publication_number",
             LATERAL FLATTEN(input => p."cpc") c
    ),

    /* yearly counts for all German grants ----------------------------------- */
    yr AS (
        SELECT SUBSTR(CAST("grant_date" AS STRING), 1, 4)  AS "year",
               c.value:"code"::STRING                      AS "cpc_code",
               COUNT(*)                                    AS "patent_count"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
        GROUP BY "year", "cpc_code"
    ),

    /* keep only CPCs observed in Dec-2016 ---------------------------------- */
    ordered AS (
        SELECT "cpc_code",
               TO_NUMBER("year")                           AS "yr",
               "patent_count",
               ROW_NUMBER() OVER (PARTITION BY "cpc_code"
                                   ORDER BY TO_NUMBER("year")) AS rn
        FROM yr
        WHERE "cpc_code" IN (SELECT "cpc_code" FROM dec_cpc)
    ),

    /* recursive EMA --------------------------------------------------------- */
    RECURSIVE ema AS (
        SELECT "cpc_code", "yr", "patent_count",
               "patent_count"                              AS ema_val,
               rn
        FROM ordered
        WHERE rn = 1
        UNION ALL
        SELECT o."cpc_code",
               o."yr",
               o."patent_count",
               0.1 * o."patent_count" + 0.9 * e.ema_val    AS ema_val,
               o.rn
        FROM ema e
        JOIN ordered o
          ON o."cpc_code" = e."cpc_code"
         AND o.rn        = e.rn + 1
    ),

    /* find peak EMA per CPC ------------------------------------------------- */
    peak AS (
        SELECT "cpc_code",
               MAX_BY(OBJECT_CONSTRUCT('yr', "yr",
                                        'ema', ema_val), ema_val) AS max_obj
        FROM ema
        GROUP BY "cpc_code"
    ),

    /* keep only level-4 CPC definitions ------------------------------------ */
    lvl4 AS (
        SELECT p."cpc_code",
               p.max_obj:"yr"  ::INTEGER  AS "best_year",
               p.max_obj:"ema" ::FLOAT    AS "best_ema"
        FROM peak p
        JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON d."symbol" = p."cpc_code"
         AND d."level"  = 4
    )

SELECT l."cpc_code",
       d."titleFull",
       l."best_year",
       l."best_ema"
FROM lvl4 l
JOIN PATENTS.PATENTS.CPC_DEFINITION d
  ON d."symbol" = l."cpc_code"
ORDER BY l."best_ema" DESC
LIMIT 20;
```
