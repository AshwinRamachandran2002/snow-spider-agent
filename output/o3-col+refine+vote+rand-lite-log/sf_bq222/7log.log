```sql
--Description:  Calculate, for CPC code ‘H04L9/0844’, the year-by-year exponential moving
--              average (α = 0.1) of German patent grants.  We use Snowflake’s
--              WITH RECURSIVE syntax so the recursive CTE (ema) can reference itself.  
WITH RECURSIVE
    /* 1. yearly counts ---------------------------------------------------- */
    yr AS (
        SELECT SUBSTR(CAST("grant_date" AS STRING), 1, 4)     AS "year",
               c.value:"code"::STRING                         AS "cpc_code",
               COUNT(*)                                       AS "patent_count"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND c.value:"code"::STRING = 'H04L9/0844'
        GROUP BY "year", "cpc_code"
    ),

    /* 2. chronological ordering ------------------------------------------ */
    ordered AS (
        SELECT "cpc_code",
               TO_NUMBER("year")                              AS "yr",
               "patent_count",
               ROW_NUMBER() OVER (ORDER BY TO_NUMBER("year")) AS rn
        FROM yr
    ),

    /* 3. recursive EMA ---------------------------------------------------- */
    ema AS (
        -- seed row (earliest year)
        SELECT "cpc_code",
               "yr",
               "patent_count",
               "patent_count"                                 AS ema_val,
               rn
        FROM ordered
        WHERE rn = 1

        UNION ALL

        -- recursive calculation
        SELECT o."cpc_code",
               o."yr",
               o."patent_count",
               0.1 * o."patent_count" + 0.9 * e.ema_val       AS ema_val,
               o.rn
        FROM ema e
        JOIN ordered o
          ON o."cpc_code" = e."cpc_code"
         AND o.rn        = e.rn + 1
    )

/* 4. show EMA values ------------------------------------------------------ */
SELECT *
FROM ema
ORDER BY "yr"
LIMIT 20;
