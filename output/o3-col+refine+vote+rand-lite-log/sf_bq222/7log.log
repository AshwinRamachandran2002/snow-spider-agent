--Description:  We simplify the previous query by dropping the “level = 4” restriction, so
--              any CPC main-group that exists in CPC_DEFINITION (no matter what level value
--              it carries) can appear in the result.  Steps:
--              1) detail_year – yearly German-grant counts for each detailed CPC symbol.
--              2) yr          – collapse every detailed symbol to its main group
--                               (“prefix before ‘/’ + ‘/00’”) and sum counts.
--              3) ordered     – put the years in chronological order inside each group.
--              4) ema         – recursive CTE that calculates an exponential moving
--                               average (α = 0.1) across the ordered years.
--              5) peak        – for each CPC group, keep the (year, EMA) pair with the
--                               highest EMA value.
--              The final SELECT shows the CPC main group, its full title from
--              CPC_DEFINITION, the year in which the EMA peaks, that EMA value, and the
--              “level” stored in CPC_DEFINITION.  The output is sorted by EMA descending
--              and limited to 20 rows to get a concise sample.
WITH RECURSIVE
/* 1. yearly counts for detailed CPC codes -------------------------------- */
detail_year AS (
    SELECT SUBSTR(CAST("grant_date" AS STRING), 1, 4)     AS "year",
           c.value:"code"::STRING                         AS "full_code",
           COUNT(*)                                       AS "patent_count"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN(input => p."cpc") c
    WHERE p."country_code" = 'DE'
    GROUP BY "year", "full_code"
),

/* 2. collapse to main group "<prefix>/00" ------------------------------- */
yr AS (
    SELECT "year",
           CONCAT(SPLIT_PART("full_code", '/', 1), '/00') AS "cpc_code",
           SUM("patent_count")                            AS "patent_count"
    FROM detail_year
    GROUP BY "year", "cpc_code"
),

/* 3. chronological ordering -------------------------------------------- */
ordered AS (
    SELECT "cpc_code",
           TO_NUMBER("year")                              AS "yr",
           "patent_count",
           ROW_NUMBER() OVER (PARTITION BY "cpc_code"
                               ORDER BY TO_NUMBER("year")) AS rn
    FROM yr
),

/* 4. recursive EMA ------------------------------------------------------ */
ema AS (
    -- seed (first year)
    SELECT "cpc_code", "yr", "patent_count",
           "patent_count"                                 AS ema_val,
           rn
    FROM ordered
    WHERE rn = 1
    UNION ALL
    -- recursive step
    SELECT o."cpc_code",
           o."yr",
           o."patent_count",
           0.1 * o."patent_count" + 0.9 * e.ema_val       AS ema_val,
           o.rn
    FROM ema e
    JOIN ordered o
      ON o."cpc_code" = e."cpc_code"
     AND o.rn        = e.rn + 1
),

/* 5. take the peak EMA year per CPC group ------------------------------ */
peak AS (
    SELECT "cpc_code",
           MAX_BY(OBJECT_CONSTRUCT('yr',  "yr",
                                    'ema', ema_val), ema_val) AS max_obj
    FROM ema
    GROUP BY "cpc_code"
)

/* final output --------------------------------------------------------- */
SELECT p."cpc_code",
       d."titleFull",
       p.max_obj:"yr"  ::INTEGER  AS "best_year",
       p.max_obj:"ema" ::FLOAT    AS "best_ema",
       COALESCE(d."level", -1)    AS "definition_level"
FROM peak p
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
       ON d."symbol" = p."cpc_code"
ORDER BY p.max_obj:"ema"::FLOAT DESC
LIMIT 20;
