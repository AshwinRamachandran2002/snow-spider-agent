```sql
--Description:  Snowflake requires the keyword RECURSIVE immediately after WITH when any CTE
--              in the block is recursive.  The query below therefore starts with
--              “WITH RECURSIVE”.  It generates, for every CPC code found on German patent
--              grants, the exponential moving average (α = 0.1) of yearly grant counts and
--              then selects the year in which that EMA reaches its maximum.  Steps
--              embedded as separate CTEs:
--                1) yr      – yearly counts per CPC code.
--                2) ordered – chronological ordering with row numbers inside each CPC.
--                3) ema     – recursive computation of EMA using the ordered rows.
--                4) peak    – per CPC, keep the (year, EMA) tuple with the highest EMA.
--              The final SELECT lists the CPC code, the “best_year” (peak EMA year) and the
--              EMA value, ordered by EMA descending and limited to 20 rows.
WITH RECURSIVE
    /* step-1: yearly grant counts for every CPC code ----------------------- */
    yr AS (
        SELECT SUBSTR(CAST("grant_date" AS STRING), 1, 4)       AS "year",
               c.value:"code"::STRING                           AS "cpc_code",
               COUNT(*)                                         AS "patent_count"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
        GROUP BY "year", "cpc_code"
    ),

    /* step-2: chronological ordering + row numbers ------------------------ */
    ordered AS (
        SELECT "cpc_code",
               TO_NUMBER("year")                                AS "yr",
               "patent_count",
               ROW_NUMBER() OVER (PARTITION BY "cpc_code"
                                   ORDER BY TO_NUMBER("year"))  AS rn
        FROM yr
    ),

    /* step-3: recursive EMA calculation ---------------------------------- */
    ema AS (
        -- seed row (earliest year for each CPC)
        SELECT "cpc_code",
               "yr",
               "patent_count",
               "patent_count"                                   AS ema_val,
               rn
        FROM ordered
        WHERE rn = 1

        UNION ALL

        -- recursive step for subsequent years
        SELECT o."cpc_code",
               o."yr",
               o."patent_count",
               0.1 * o."patent_count" + 0.9 * e.ema_val         AS ema_val,
               o.rn
        FROM ema e
        JOIN ordered o
          ON o."cpc_code" = e."cpc_code"
         AND o.rn        = e.rn + 1
    ),

    /* step-4: pick peak EMA year per CPC --------------------------------- */
    peak AS (
        SELECT "cpc_code",
               MAX_BY(OBJECT_CONSTRUCT('yr',  "yr",
                                        'ema', ema_val), ema_val) AS max_obj
        FROM ema
        GROUP BY "cpc_code"
    )

/* ---------------- final result ----------------------------------------- */
SELECT p."cpc_code",
       p.max_obj:"yr"  ::INTEGER  AS "best_year",
       p.max_obj:"ema" ::FLOAT    AS "best_ema"
FROM peak p
ORDER BY "best_ema" DESC
LIMIT 20;
```
