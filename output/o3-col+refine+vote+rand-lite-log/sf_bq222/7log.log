```sql
--Description: 8) Compute EMA (α = 0.1) for every CPC code and find the year where the EMA peaks  
WITH
    /* yearly counts ------------------------------------------------------- */
    yr AS (
        SELECT SUBSTR(CAST("grant_date" AS STRING), 1, 4)  AS "year",
               c.value:"code"::STRING                      AS "cpc_code",
               COUNT(*)                                    AS "patent_count"
        FROM PATENTS.PATENTS.PUBLICATIONS p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
        GROUP BY "year", "cpc_code"
    ),

    /* order years inside each CPC code ----------------------------------- */
    ordered AS (
        SELECT "cpc_code",
               TO_NUMBER("year")                           AS "yr",
               "patent_count",
               ROW_NUMBER() OVER (PARTITION BY "cpc_code"
                                   ORDER BY TO_NUMBER("year")) AS rn
        FROM yr
    ),

    /* recursive EMA ------------------------------------------------------- */
    RECURSIVE ema AS (
        -- seed row
        SELECT "cpc_code",
               "yr",
               "patent_count",
               "patent_count"                              AS ema_val,
               rn
        FROM ordered
        WHERE rn = 1

        UNION ALL

        -- iterative step
        SELECT o."cpc_code",
               o."yr",
               o."patent_count",
               0.1 * o."patent_count" + 0.9 * e.ema_val    AS ema_val,
               o.rn
        FROM ema e
        JOIN ordered o
          ON o."cpc_code" = e."cpc_code"
         AND o.rn        = e.rn + 1
    ),

    /* pick the year with max-EMA per CPC --------------------------------- */
    peak AS (
        SELECT "cpc_code",
               MAX_BY(OBJECT_CONSTRUCT('yr', "yr",
                                        'ema', ema_val), ema_val) AS max_obj
        FROM ema
        GROUP BY "cpc_code"
    )

SELECT p."cpc_code",
       p.max_obj:"yr"  ::INTEGER  AS "best_year",
       p.max_obj:"ema" ::FLOAT    AS "best_ema"
FROM peak p
ORDER BY "best_ema" DESC
LIMIT 20;
