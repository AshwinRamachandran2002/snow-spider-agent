```sql
/*---------------------------------------------------------------------------------
  1) Grab all CPC subclass codes (level-4) that appear on German patents
     granted during December-2016.
  2) For those subclasses, count how many German patents were granted
     every calendar year.
  3) Calculate the exponential moving average (α = 0.1) of yearly counts
     with a recursive CTE.
  4) Pick, for every subclass, the year where that EMA reaches its maximum.
  5) Return the CPC full title (from CPC_DEFINITION), the subclass code,
     and the “best year”.
---------------------------------------------------------------------------------*/
WITH dec16_subclasses AS (               -- Step-1
    SELECT DISTINCT
           SUBSTR(c.value:"code"::STRING, 1, 4) AS subclass_code
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") c
    WHERE  p."country_code" = 'DE'
      AND  p."grant_date"   BETWEEN 20161201 AND 20161231
),

yearly_counts AS (                       -- Step-2
    SELECT
        SUBSTR(c.value:"code"::STRING, 1, 4)     AS subclass_code,
        FLOOR(p."grant_date" / 10000)            AS year,
        COUNT(*)                                 AS patent_count
    FROM   PATENTS.PATENTS.PUBLICATIONS p,
           LATERAL FLATTEN(input => p."cpc") c
    WHERE  p."country_code" = 'DE'
      AND  SUBSTR(c.value:"code"::STRING, 1, 4)
           IN (SELECT subclass_code FROM dec16_subclasses)
    GROUP  BY subclass_code, year
),

ordered_counts AS (
    SELECT
        subclass_code,
        year,
        patent_count,
        ROW_NUMBER() OVER (PARTITION BY subclass_code
                           ORDER BY year)        AS rn
    FROM   yearly_counts
),

/*-------------------------------------------------------------
  Step-3 : recursive EMA   (EMA_t = 0.1·x_t + 0.9·EMA_(t-1))
-------------------------------------------------------------*/
RECURSIVE ema_calc AS (
    /* anchor row (first year for each subclass) */
    SELECT
        subclass_code,
        year,
        patent_count,
        patent_count * 0.1                         AS ema_value,
        rn
    FROM   ordered_counts
    WHERE  rn = 1

    UNION ALL

    /* recursive rows */
    SELECT
        oc.subclass_code,
        oc.year,
        oc.patent_count,
        0.1 * oc.patent_count + 0.9 * ec.ema_value AS ema_value,
        oc.rn
    FROM   ordered_counts oc
    JOIN   ema_calc      ec
      ON   oc.subclass_code = ec.subclass_code
     AND   oc.rn          = ec.rn + 1
),

best_years AS (                           -- Step-4
    SELECT
        subclass_code,
        year                  AS best_year,
        ema_value,
        ROW_NUMBER() OVER (PARTITION BY subclass_code
                           ORDER BY ema_value DESC) AS rnk
    FROM   ema_calc
)

/*-------------------------------------------------------------
  Step-5 : final result
-------------------------------------------------------------*/
SELECT
    d."titleFull"   AS "cpc_title",
    b.subclass_code AS "cpc_group",
    b.best_year     AS "year_with_highest_ema"
FROM   best_years                        b
JOIN   PATENTS.PATENTS.CPC_DEFINITION   d
  ON   d."symbol" = b.subclass_code
 AND   d."level"  = 4.0                  -- level-4 = subclass
WHERE  b.rnk = 1                         -- only the max-EMA year per subclass
ORDER  BY b.ema_value DESC NULLS LAST;   -- highest EMA areas on top
```
