```sql
--Description: We need to look up CPC technology codes that appear on German patents granted
--             during December 2016 and see their full CPC definition (title & hierarchy level).
--             Snowflake raises an error if a table with LATERAL FLATTEN sits on the LEFT side
--             of a JOIN, so we first perform the FLATTEN inside a sub-query (derived table).
--             The outer query then simply joins this result to CPC_DEFINITION.
--             LIMIT 20 is added to keep the result small for inspection.
SELECT DISTINCT dec_cpcs."cpc_code",
       def."titleFull",
       def."level"
FROM (
        /* sub-query: explode the CPC array for German grants in Dec-2016 */
        SELECT c.value:"code"::STRING AS "cpc_code"
        FROM PATENTS.PATENTS.PUBLICATIONS  p,
             LATERAL FLATTEN(input => p."cpc") c
        WHERE p."country_code" = 'DE'
          AND p."grant_date" BETWEEN 20161201 AND 20161231
     ) AS dec_cpcs
LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION def
       ON def."symbol" = dec_cpcs."cpc_code"
LIMIT 20;
```
