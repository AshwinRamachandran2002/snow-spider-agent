```sql
--Description:
-- We want the five constructors that have most often (since 2001) had a driver who,
-- at season-end, recorded the lowest non-zero points total among all point-scoring
-- drivers that year.  The query proceeds in four logical layers:
--
--  1. last_rounds   – final round number of every season ≥2001.
--  2. min_points    – the minimum non-zero points total in the final driver_standings
--                     of each of those seasons.
--  3. bottom_drivers– the driver_id(s) that actually scored that minimum in their season.
--  4. bottom_constructors – every constructor those drivers raced for during the same
--                     season (year), obtained via results + races.
--
-- Finally, we count distinct seasons per constructor, order descending, and take the
-- top five.

WITH last_rounds AS (                         -- step 1
    SELECT year, MAX(round) AS last_round
    FROM races
    WHERE year >= 2001
    GROUP BY year
),
min_points AS (                               -- step 2
    SELECT rs.year,
           MIN(ds.points) AS min_points
    FROM driver_standings ds
    JOIN races rs         ON rs.race_id = ds.race_id
    JOIN last_rounds lr   ON lr.year = rs.year AND lr.last_round = rs.round
    WHERE ds.points > 0
    GROUP BY rs.year
),
bottom_drivers AS (                           -- step 3
    SELECT rs.year,
           ds.driver_id
    FROM driver_standings ds
    JOIN races rs         ON rs.race_id = ds.race_id
    JOIN last_rounds lr   ON lr.year = rs.year AND lr.last_round = rs.round
    JOIN min_points mp    ON mp.year = rs.year AND mp.min_points = ds.points
),
bottom_constructors AS (                      -- step 4
    SELECT DISTINCT bd.year,
           res.constructor_id
    FROM bottom_drivers bd
    JOIN results res ON res.driver_id = bd.driver_id
    JOIN races   r   ON r.race_id = res.race_id
    WHERE r.year = bd.year                     -- keep same season
)
SELECT c.constructor_ref,
       COUNT(DISTINCT bc.year) AS seasons_with_bottom_scorer
FROM bottom_constructors bc
JOIN constructors c ON c.constructor_id = bc.constructor_id
GROUP BY c.constructor_ref
ORDER BY seasons_with_bottom_scorer DESC
LIMIT 5;
```
