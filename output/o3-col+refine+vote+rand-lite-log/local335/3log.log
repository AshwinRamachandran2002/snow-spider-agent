-- 3) Description:  Retrieve the race_id of the final Grand Prix of each season ≥2001.  
SELECT r.year,
       r.race_id,
       r.name,
       r.round
FROM races AS r
JOIN (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     ) AS fin
  ON r.year = fin.year
 AND r.round = fin.last_round
ORDER BY r.year
LIMIT 20;
