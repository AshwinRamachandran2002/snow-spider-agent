        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
),
min_points AS (
        SELECT rs.year,
               MIN(ds.points) AS min_points
        FROM driver_standings ds
        JOIN races rs  ON rs.race_id = ds.race_id
        JOIN last_rounds lr ON lr.year = rs.year AND lr.last_round = rs.round
        WHERE ds.points > 0
        GROUP BY rs.year
),
bottom_drivers AS (
        SELECT rs.year,
               ds.driver_id
        FROM driver_standings ds
        JOIN races rs  ON rs.race_id = ds.race_id
        JOIN last_rounds lr ON lr.year = rs.year AND lr.last_round = rs.round
        JOIN min_points mp  ON mp.year = rs.year AND mp.min_points = ds.points
),
bottom_constructors AS (
        SELECT DISTINCT bd.year,
               res.constructor_id
        FROM bottom_drivers bd
        JOIN results res ON res.driver_id = bd.driver_id
        JOIN races   r   ON r.race_id   = res.race_id
        WHERE r.year = bd.year
)
SELECT c.constructor_ref,
       COUNT(DISTINCT bc.year) AS seasons_with_least_points_driver
FROM bottom_constructors bc
JOIN constructors c ON c.constructor_id = bc.constructor_id
GROUP BY c.constructor_ref
ORDER BY seasons_with_least_points_driver DESC
LIMIT 20;
```

```sql
--Description: Retrieve the five constructors that have recorded the most seasons (since 2001)
--             in which one of their drivers finished with the lowest non-zero points total.
WITH last_rounds AS (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
),
min_points AS (
        SELECT rs.year,
               MIN(ds.points) AS min_points
        FROM driver_standings ds
        JOIN races rs  ON rs.race_id = ds.race_id
        JOIN last_rounds lr ON lr.year = rs.year AND lr.last_round = rs.round
        WHERE ds.points > 0
        GROUP BY rs.year
),
bottom_drivers AS (
        SELECT rs.year,
               ds.driver_id
        FROM driver_standings ds
        JOIN races rs  ON rs.race_id = ds.race_id
        JOIN last_rounds lr ON lr.year = rs.year AND lr.last_round = rs.round
        JOIN min_points mp  ON mp.year = rs.year AND mp.min_points = ds.points
),
bottom_constructors AS (
        SELECT DISTINCT bd.year,
               res.constructor_id
        FROM bottom_drivers bd
        JOIN results res ON res.driver_id = bd.driver_id
        JOIN races   r   ON r.race_id   = res.race_id
        WHERE r.year = bd.year
)
SELECT c.constructor_ref,
       COUNT(DISTINCT bc.year) AS seasons_with_least_points_driver
FROM bottom_constructors bc
JOIN constructors c ON c.constructor_id = bc.constructor_id
GROUP BY c.constructor_ref
ORDER BY seasons_with_least_points_driver DESC
LIMIT 5;
```

