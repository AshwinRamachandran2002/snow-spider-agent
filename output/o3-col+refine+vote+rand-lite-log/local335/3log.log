```sql
-- 1) Description:  List every Formula-1 season in the dataset from 2001 onward.
SELECT DISTINCT r.year
FROM races AS r
WHERE r.year >= 2001
ORDER BY r.year
LIMIT 20;
```

```sql
-- 2) Description:  Show the Grand Prix (race) that closed each season
--    (its “round” is the highest round number in that year).
SELECT r.year,
       MAX(r.round) AS last_round
FROM races AS r
WHERE r.year >= 2001
GROUP BY r.year
ORDER BY r.year
LIMIT 20;
```

```sql
-- 3) Description:  Retrieve the race_id of the final Grand Prix of each season ≥2001.  
SELECT r.year,
       r.race_id,
       r.name,
       r.round
FROM races AS r
JOIN (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     ) AS fin
  ON r.year = fin.year
 AND r.round = fin.last_round
ORDER BY r.year
LIMIT 20;
```

```sql
-- 4) Description:  Final driver-standings (total season points) for 2001–2005 seasons.
--    We filter to drivers who ended the season with >0 points.
SELECT rs.year,
       ds.driver_id,
       ds.points
FROM driver_standings AS ds
JOIN races           AS rs  ON rs.race_id = ds.race_id
JOIN (
        SELECT r.year, MAX(r.round) AS last_round
        FROM races AS r
        WHERE r.year BETWEEN 2001 AND 2005
        GROUP BY r.year
     ) AS fin
  ON rs.year  = fin.year
 AND rs.round = fin.last_round
WHERE ds.points > 0
ORDER BY rs.year, ds.points
LIMIT 20;
```

```sql
-- 5) Description:  For every season since 2001, find the minimum points total
--    among drivers who scored any points.
SELECT rs.year,
       MIN(ds.points) AS min_points
FROM driver_standings AS ds
JOIN races AS rs ON rs.race_id = ds.race_id
JOIN (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     ) AS fin
  ON rs.year  = fin.year
 AND rs.round = fin.last_round
WHERE ds.points > 0
GROUP BY rs.year
ORDER BY rs.year
LIMIT 20;
```

```sql
-- 6) Description:  Identify the driver(s) with that season’s fewest points
--    (only the bottom point-scorers) for 2001–2005.
SELECT rs.year,
       ds.driver_id,
       ds.points
FROM driver_standings AS ds
JOIN races AS rs ON rs.race_id = ds.race_id
JOIN (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year BETWEEN 2001 AND 2005
        GROUP BY year
     ) AS fin
  ON rs.year  = fin.year
 AND rs.round = fin.last_round
JOIN (
        SELECT rs2.year, MIN(ds2.points) AS min_points
        FROM driver_standings AS ds2
        JOIN races AS rs2 ON rs2.race_id = ds2.race_id
        JOIN (
                SELECT year, MAX(round) AS last_round
                FROM races
                WHERE year BETWEEN 2001 AND 2005
                GROUP BY year
             ) AS fin2
          ON rs2.year  = fin2.year
         AND rs2.round = fin2.last_round
        WHERE ds2.points > 0
        GROUP BY rs2.year
     ) AS mp
  ON rs.year   = mp.year
 AND ds.points = mp.min_points
ORDER BY rs.year
LIMIT 20;
```

```sql
-- 7) Description:  Show every constructor a bottom-scoring driver raced for
--    during that same season (uses the results table).
SELECT DISTINCT rs.year,
       dsd.driver_id,
       res.constructor_id
FROM (
        -- Bottom-scoring driver-seasons (query 6 without LIMIT)
        SELECT rs.year,
               ds.driver_id
        FROM driver_standings AS ds
        JOIN races AS rs ON rs.race_id = ds.race_id
        JOIN (
                SELECT year, MAX(round) AS last_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS fin ON rs.year = fin.year AND rs.round = fin.last_round
        JOIN (
                SELECT rs2.year, MIN(ds2.points) AS min_points
                FROM driver_standings AS ds2
                JOIN races AS rs2 ON rs2.race_id = ds2.race_id
                JOIN (
                        SELECT year, MAX(round) AS last_round
                        FROM races
                        WHERE year >= 2001
                        GROUP BY year
                     ) AS fin2 ON rs2.year = fin2.year AND rs2.round = fin2.last_round
                WHERE ds2.points > 0
                GROUP BY rs2.year
             ) AS mp ON rs.year = mp.year AND ds.points = mp.min_points
     ) AS dsd
JOIN results AS res       ON res.driver_id = dsd.driver_id
JOIN races   AS rseason   ON rseason.race_id = res.race_id
WHERE rseason.year = dsd.year
LIMIT 20;
```

```sql
-- 8) Description:  Count, for each constructor, how many seasons since 2001
--    they had at least one bottom-scoring point-scoring driver.
SELECT c.constructor_ref,
       COUNT(DISTINCT tmp.year) AS seasons_with_least_points_driver
FROM (
        -- Derived table of constructor-season appearances from query 7 (without LIMIT)
        SELECT DISTINCT rs.year,
                        res.constructor_id
        FROM driver_standings AS ds
        JOIN races AS rs  ON rs.race_id = ds.race_id
        JOIN (
                SELECT year, MAX(round) AS last_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS fin ON rs.year = fin.year AND rs.round = fin.last_round
        JOIN (
                SELECT rs2.year, MIN(ds2.points) AS min_points
                FROM driver_standings AS ds2
                JOIN races AS rs2 ON rs2.race_id = ds2.race_id
                JOIN (
                        SELECT year, MAX(round) AS last_round
                        FROM races
                        WHERE year >= 2001
                        GROUP BY year
                     ) AS fin2 ON rs2.year = fin2.year AND rs2.round = fin2.last_round
                WHERE ds2.points > 0
                GROUP BY rs2.year
             ) AS mp ON rs.year = mp.year AND ds.points = mp.min_points
        JOIN results AS res     ON res.driver_id = ds.driver_id
        JOIN races   AS rseason ON rseason.race_id = res.race_id
        WHERE rseason.year = rs.year
     ) AS tmp
JOIN constructors AS c ON c.constructor_id = tmp.constructor_id
GROUP BY c.constructor_ref
ORDER BY seasons_with_least_points_driver DESC
LIMIT 20;
```

```sql
-- 9) Description:  Display the five constructors with the MOST seasons
--    in which their driver(s) scored the fewest points.
SELECT c.constructor_ref,
       seasons_with_least_points_driver
FROM (
        SELECT c2.constructor_id,
               COUNT(DISTINCT tmp.year) AS seasons_with_least_points_driver
        FROM (
                SELECT DISTINCT rs.year,
                                res.constructor_id
                FROM driver_standings AS ds
                JOIN races AS rs  ON rs.race_id = ds.race_id
                JOIN (
                        SELECT year, MAX(round) AS last_round
                        FROM races
                        WHERE year >= 2001
                        GROUP BY year
                     ) AS fin ON rs.year = fin.year AND rs.round = fin.last_round
                JOIN (
                        SELECT rs2.year, MIN(ds2.points) AS min_points
                        FROM driver_standings AS ds2
                        JOIN races AS rs2 ON rs2.race_id = ds2.race_id
                        JOIN (
                                SELECT year, MAX(round) AS last_round
                                FROM races
                                WHERE year >= 2001
                                GROUP BY year
                             ) AS fin2 ON rs2.year = fin2.year AND rs2.round = fin2.last_round
                        WHERE ds2.points > 0
                        GROUP BY rs2.year
                     ) AS mp ON rs.year = mp.year AND ds.points = mp.min_points
                JOIN results AS res     ON res.driver_id = ds.driver_id
                JOIN races   AS rseason ON rseason.race_id = res.race_id
                WHERE rseason.year = rs.year
             ) AS tmp
        JOIN constructors AS c2 ON c2.constructor_id = tmp.constructor_id
        GROUP BY c2.constructor_id
     ) AS totals
JOIN constructors AS c ON c.constructor_id = totals.constructor_id
ORDER BY totals.seasons_with_least_points_driver DESC
LIMIT 5;
```

