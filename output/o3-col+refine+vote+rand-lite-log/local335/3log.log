Query:
--Description: Show the readable short names (constructors_ext.short_name) for the top-5 constructors
--             that most frequently had a bottom-scoring driver, together with the count of such seasons.
WITH last_rounds AS (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
),
min_points AS (
        SELECT rs.year,
               MIN(ds.points) AS min_points
        FROM driver_standings ds
        JOIN races rs  ON rs.race_id = ds.race_id
        JOIN last_rounds lr ON lr.year = rs.year AND lr.last_round = rs.round
        WHERE ds.points > 0
        GROUP BY rs.year
),
bottom_drivers AS (
        SELECT rs.year,
               ds.driver_id
        FROM driver_standings ds
        JOIN races rs  ON rs.race_id = ds.race_id
        JOIN last_rounds lr ON lr.year = rs.year AND lr.last_round = rs.round
        JOIN min_points mp  ON mp.year = rs.year AND mp.min_points = ds.points
),
bottom_constructors AS (
        SELECT DISTINCT bd.year,
               res.constructor_id
        FROM bottom_drivers bd
        JOIN results res ON res.driver_id = bd.driver_id
        JOIN races   r   ON r.race_id   = res.race_id
        WHERE r.year = bd.year
),
constructor_totals AS (
        SELECT constructor_id,
               COUNT(DISTINCT year) AS seasons_with_least_points_driver
        FROM bottom_constructors
        GROUP BY constructor_id
        ORDER BY seasons_with_least_points_driver DESC
        LIMIT 5
)
SELECT ce.short_name,
       ct.seasons_with_least_points_driver
FROM constructor_totals ct
JOIN constructors_ext ce ON ce.constructor_id = ct.constructor_id
ORDER BY ct.seasons_with_least_points_driver DESC
