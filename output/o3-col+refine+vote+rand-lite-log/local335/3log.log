-- 5) Description:  For every season since 2001, find the minimum points total
--    among drivers who scored any points.
SELECT rs.year,
       MIN(ds.points) AS min_points
FROM driver_standings AS ds
JOIN races AS rs ON rs.race_id = ds.race_id
JOIN (
        SELECT year, MAX(round) AS last_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     ) AS fin
  ON rs.year  = fin.year
 AND rs.round = fin.last_round
WHERE ds.points > 0
GROUP BY rs.year
ORDER BY rs.year
LIMIT 20;
