```sql
--Description:  Minimum positive points in every season (final standings) since 2001.
WITH finale AS (                                         -- season-ending race of every year
        SELECT r.year,
               r.race_id
        FROM races AS r
        JOIN (
                SELECT year, MAX(round) AS final_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS f
          ON f.year = r.year
         AND f.final_round = r.round
)
SELECT f.year,
       MIN(ds.points) AS min_positive_points
FROM finale           AS f
JOIN driver_standings AS ds ON ds.race_id = f.race_id
WHERE ds.points > 0
GROUP BY f.year
ORDER BY f.year DESC
LIMIT 20;
```

```sql
--Description:  For every season since 2001, list constructors that had at least one
--              driver finish the season with that year’s minimum positive points total.
WITH finale AS (                       -- season-ending race of every year
        SELECT r.year,
               r.race_id
        FROM races AS r
        JOIN (
                SELECT year, MAX(round) AS final_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS f
          ON f.year = r.year
         AND f.final_round = r.round
),
min_pts AS (                           -- minimum positive points per season
        SELECT f.year,
               MIN(ds.points) AS min_pts
        FROM finale           AS f
        JOIN driver_standings AS ds ON ds.race_id = f.race_id
        WHERE ds.points > 0
        GROUP BY f.year
)
SELECT f.year,
       c.constructor_id,
       c.name AS constructor_name
FROM finale           AS f
JOIN driver_standings AS ds   ON ds.race_id  = f.race_id
JOIN min_pts          AS mp   ON mp.year     = f.year
                              AND mp.min_pts = ds.points
JOIN results          AS res  ON res.race_id  = ds.race_id
                              AND res.driver_id = ds.driver_id
JOIN constructors     AS c    ON c.constructor_id = res.constructor_id
GROUP BY f.year, c.constructor_id, c.name
ORDER BY f.year DESC, c.name
LIMIT 20;
```

```sql
--Description:  Final answer – five constructors with the most seasons (2001-present)
--              in which one of their drivers finished the year with the fewest
--              points among all point-scorers.
WITH finale AS (                       -- season-ending race of every year
        SELECT r.year,
               r.race_id
        FROM races AS r
        JOIN (
                SELECT year, MAX(round) AS final_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS f
          ON f.year = r.year
         AND f.final_round = r.round
),
min_pts AS (                           -- minimum positive points per season
        SELECT f.year,
               MIN(ds.points) AS min_pts
        FROM finale           AS f
        JOIN driver_standings AS ds ON ds.race_id = f.race_id
        WHERE ds.points > 0
        GROUP BY f.year
),
lowest_constructors AS (               -- constructors owning those minimum-point drivers
        SELECT f.year,
               c.constructor_id,
               c.name
        FROM finale           AS f
        JOIN driver_standings AS ds   ON ds.race_id  = f.race_id
        JOIN min_pts          AS mp   ON mp.year     = f.year
                                      AND mp.min_pts = ds.points
        JOIN results          AS res  ON res.race_id  = ds.race_id
                                      AND res.driver_id = ds.driver_id
        JOIN constructors     AS c    ON c.constructor_id = res.constructor_id
        GROUP BY f.year, c.constructor_id, c.name
)
SELECT lc.name  AS constructor_name,
       COUNT(*) AS seasons_with_lowest_point_scorer
FROM lowest_constructors AS lc
GROUP BY lc.constructor_id, lc.name
ORDER BY seasons_with_lowest_point_scorer DESC
LIMIT 5;
```
