```sql
-- 1. Description: Final round number in every season from 2001 onward (helps pick the “season-ending” race for each year).
SELECT r.year,
       MAX(r.round) AS final_round
FROM races AS r
WHERE r.year >= 2001
GROUP BY r.year
ORDER BY r.year DESC
LIMIT 20;
```

```sql
-- 2. Description: The race_id (and Grand Prix name) of each season-ending race since 2001.
SELECT r.year,
       r.race_id,
       r.name,
       r.round
FROM races AS r
JOIN (
        SELECT year,
               MAX(round) AS final_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     ) AS x
  ON x.year = r.year
 AND x.final_round = r.round
ORDER BY r.year DESC
LIMIT 20;
```

```sql
-- 3. Description: Driver-standing points for the final race of 2009 (sample season) – lets us see cumulative season totals.
SELECT ds.driver_id,
       d.forename || ' ' || d.surname AS driver_name,
       ds.points
FROM driver_standings AS ds
JOIN drivers           AS d  ON d.driver_id = ds.driver_id
WHERE ds.race_id = (
        SELECT r.race_id
        FROM races AS r
        WHERE r.year  = 2009
          AND r.round = (SELECT MAX(round) FROM races WHERE year = 2009)
      )
ORDER BY ds.points ASC
LIMIT 20;
```

```sql
-- 4. Description: Minimum positive points scored by any point-scoring driver in the 2009 season.
SELECT MIN(ds.points) AS min_positive_points_2009
FROM driver_standings AS ds
JOIN races AS r ON r.race_id = ds.race_id
WHERE r.year  = 2009
  AND r.round = (SELECT MAX(round) FROM races WHERE year = 2009)
  AND ds.points > 0;
```

```sql
-- 5. Description: Drivers who had that minimum positive tally in 2009 and the constructor they drove for in the finale.
SELECT d.forename || ' ' || d.surname AS driver_name,
       c.name                       AS constructor_name,
       ds.points
FROM driver_standings AS ds
JOIN races            AS r   ON r.race_id = ds.race_id
JOIN results          AS res ON res.race_id = ds.race_id
                            AND res.driver_id = ds.driver_id
JOIN constructors     AS c   ON c.constructor_id = res.constructor_id
JOIN drivers          AS d   ON d.driver_id = ds.driver_id
WHERE r.year  = 2009
  AND r.round = (SELECT MAX(round) FROM races WHERE year = 2009)
  AND ds.points = (
        SELECT MIN(ds2.points)
        FROM driver_standings AS ds2
        JOIN races AS r2 ON r2.race_id = ds2.race_id
        WHERE r2.year  = 2009
          AND r2.round = (SELECT MAX(round) FROM races WHERE year = 2009)
          AND ds2.points > 0
      )
LIMIT 20;
```

```sql
-- 6. Description: Minimum positive points in every season (final standings) since 2001.
SELECT r.year,
       MIN(ds.points) AS min_positive_points
FROM driver_standings AS ds
JOIN races AS r ON r.race_id = ds.race_id
JOIN (
        SELECT year, MAX(round) AS final_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     ) AS x
  ON x.year = r.year
 AND x.final_round = r.round
WHERE ds.points > 0
GROUP BY r.year
ORDER BY r.year DESC
LIMIT 20;
```

```sql
-- 7. Description: For every season since 2001, list constructors whose driver(s) had that season’s minimum positive points.
SELECT r.year,
       c.constructor_id,
       c.name AS constructor_name
FROM races            AS r
JOIN (
        SELECT year, MAX(round) AS final_round
        FROM races
        WHERE year >= 2001
        GROUP BY year
     )                AS x   ON x.year = r.year
                            AND x.final_round = r.round
JOIN driver_standings AS ds  ON ds.race_id = r.race_id
JOIN (
        SELECT ds2.race_id,
               MIN(ds2.points) AS min_pts
        FROM driver_standings AS ds2
        JOIN races AS r2 ON r2.race_id = ds2.race_id
        WHERE r2.year >= 2001
          AND ds2.points > 0
        GROUP BY ds2.race_id
     )                AS mp  ON mp.race_id = ds.race_id
                            AND mp.min_pts = ds.points
JOIN results          AS res ON res.race_id  = ds.race_id
                            AND res.driver_id = ds.driver_id
JOIN constructors     AS c   ON c.constructor_id = res.constructor_id
GROUP BY r.year, c.constructor_id
ORDER BY r.year DESC, c.name
LIMIT 20;
```

```sql
-- 8. Description: The final answer – five constructors with the most seasons where their driver(s) had the fewest points among all point-scorers, 2001-present.
SELECT c.name                                 AS constructor_name,
       COUNT(DISTINCT r.year)                 AS seasons_with_lowest_point_scorer
FROM (
        -- season-ending races since 2001
        SELECT r.year,
               r.race_id
        FROM races AS r
        JOIN (
                SELECT year, MAX(round) AS final_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS x
          ON x.year = r.year
         AND x.final_round = r.round
     )                       AS finale
JOIN driver_standings        AS ds  ON ds.race_id = finale.race_id
JOIN (
        -- minimum positive points at every finale
        SELECT ds2.race_id,
               MIN(ds2.points) AS min_pts
        FROM driver_standings AS ds2
        JOIN races AS r2 ON r2.race_id = ds2.race_id
        WHERE r2.year >= 2001
          AND ds2.points > 0
        GROUP BY ds2.race_id
     )                       AS mp   ON mp.race_id = ds.race_id
                                   AND mp.min_pts  = ds.points
JOIN results                 AS res  ON res.race_id  = ds.race_id
                                   AND res.driver_id = ds.driver_id
JOIN constructors            AS c    ON c.constructor_id = res.constructor_id
GROUP BY c.constructor_id
ORDER BY seasons_with_lowest_point_scorer DESC
LIMIT 5;
```
