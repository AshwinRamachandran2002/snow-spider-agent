--Description:  Minimum positive points in every season (final standings) since 2001.
WITH finale AS (                                         -- season-ending race of every year
        SELECT r.year,
               r.race_id
        FROM races AS r
        JOIN (
                SELECT year, MAX(round) AS final_round
                FROM races
                WHERE year >= 2001
                GROUP BY year
             ) AS f
          ON f.year = r.year
         AND f.final_round = r.round
)
SELECT f.year,
       MIN(ds.points) AS min_positive_points
FROM finale           AS f
JOIN driver_standings AS ds ON ds.race_id = f.race_id
WHERE ds.points > 0
GROUP BY f.year
ORDER BY f.year DESC
LIMIT 20
