Query:
--Description: find the final (max-round) race of every season since 2001
SELECT r.year,
       r.race_id,
       r.round,
       r.name
FROM races AS r
JOIN (
     SELECT year, MAX(round) AS max_round
     FROM races
     WHERE year >= 2001
     GROUP BY year
) AS f
ON  r.year  = f.year
AND r.round = f.max_round
ORDER BY r.year
LIMIT 20;
