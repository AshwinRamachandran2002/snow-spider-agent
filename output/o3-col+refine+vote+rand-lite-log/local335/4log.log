Query:
--Description: per-season detail – which lowest-scoring driver(s) and their constructor
SELECT t.year,
       d.forename || ' ' || d.surname AS driver_name,
       t.points,
       con.name                     AS constructor_name
FROM (
     SELECT y.year,
            y.race_id  AS final_race_id,
            ds.driver_id,
            ds.points
     FROM (
          SELECT r.year,
                 r.race_id
          FROM races AS r
          JOIN (
               SELECT year, MAX(round) AS max_round
               FROM races
               WHERE year >= 2001
               GROUP BY year
          ) AS f
          ON  r.year  = f.year
          AND r.round = f.max_round
     ) AS y
     JOIN driver_standings AS ds
     ON  ds.race_id = y.race_id
     JOIN (
          SELECT y2.year,
                 MIN(ds2.points) AS min_points
          FROM (
               SELECT r.year,
                      r.race_id
               FROM races AS r
               JOIN (
                    SELECT year, MAX(round) AS max_round
                    FROM races
                    WHERE year >= 2001
                    GROUP BY year
               ) AS f
               ON  r.year  = f.year
               AND r.round = f.max_round
          ) AS y2
          JOIN driver_standings AS ds2
          ON  ds2.race_id = y2.race_id
          WHERE ds2.points > 0
          GROUP BY y2.year
     ) AS m
     ON  m.year   = y.year
     AND ds.points = m.min_points
) AS t
JOIN results       AS r   ON r.race_id  = t.final_race_id
                         AND r.driver_id = t.driver_id
JOIN drivers       AS d   ON d.driver_id = t.driver_id
JOIN constructors  AS con ON con.constructor_id = r.constructor_id
ORDER BY t.year
LIMIT 20;
