Query:
--Description: top five constructors with the most such seasons (final answer set)
SELECT con.name  AS constructor_name,
       x.seasons_with_least_points
FROM constructors AS con
JOIN (
     SELECT c.constructor_id,
            COUNT(*) AS seasons_with_least_points
     FROM (
          SELECT t.year,
                 r.constructor_id
          FROM (
               SELECT y.year,
                      y.race_id  AS final_race_id,
                      ds.driver_id
               FROM (
                    SELECT r.year,
                           r.race_id
                    FROM races AS r
                    JOIN (
                         SELECT year, MAX(round) AS max_round
                         FROM races
                         WHERE year >= 2001
                         GROUP BY year
                    ) AS f
                    ON  r.year  = f.year
                    AND r.round = f.max_round
               ) AS y
               JOIN driver_standings AS ds
               ON  ds.race_id = y.race_id
               JOIN (
                    SELECT y2.year,
                           MIN(ds2.points) AS min_points
                    FROM (
                         SELECT r.year,
                                r.race_id
                         FROM races AS r
                         JOIN (
                              SELECT year, MAX(round) AS max_round
                              FROM races
                              WHERE year >= 2001
                              GROUP BY year
                         ) AS f
                         ON  r.year  = f.year
                         AND r.round = f.max_round
                    ) AS y2
                    JOIN driver_standings AS ds2
                    ON  ds2.race_id = y2.race_id
                    WHERE ds2.points > 0
                    GROUP BY y2.year
               ) AS m
               ON  m.year   = y.year
               AND ds.points = m.min_points
          ) AS t
          JOIN results AS r
          ON  r.race_id  = t.final_race_id
          AND r.driver_id = t.driver_id
     ) AS c
     GROUP BY c.constructor_id
     ORDER BY COUNT(*) DESC
     LIMIT 5
) AS x
ON con.constructor_id = x.constructor_id
ORDER BY x.seasons_with_least_points DESC, constructor_name;
