```sql
--Description: list seasons on record from 2001 onward
SELECT DISTINCT year 
FROM races 
WHERE year >= 2001 
ORDER BY year 
LIMIT 20;
```

```sql
--Description: find the final (max-round) race of every season since 2001
SELECT r.year,
       r.race_id,
       r.round,
       r.name
FROM races AS r
JOIN (
     SELECT year, MAX(round) AS max_round
     FROM races
     WHERE year >= 2001
     GROUP BY year
) AS f
ON  r.year  = f.year
AND r.round = f.max_round
ORDER BY r.year
LIMIT 20;
```

```sql
--Description: inspect driver standings at the 2001 season-finale race
SELECT ds.driver_id,
       ds.points,
       ds.position,
       ds.wins
FROM driver_standings AS ds
JOIN (
     SELECT race_id
     FROM races
     WHERE year = 2001
     ORDER BY round DESC
     LIMIT 1
) AS fr
ON  ds.race_id = fr.race_id
ORDER BY ds.points ASC
LIMIT 20;
```

```sql
--Description: minimum positive points scored by any point-scoring driver in each season (2001+)
SELECT y.year,
       MIN(ds.points) AS min_points
FROM (
     SELECT r.year,
            r.race_id
     FROM races AS r
     JOIN (
          SELECT year, MAX(round) AS max_round
          FROM races
          WHERE year >= 2001
          GROUP BY year
     ) AS f
     ON  r.year  = f.year
     AND r.round = f.max_round
) AS y
JOIN driver_standings AS ds
ON  ds.race_id = y.race_id
WHERE ds.points > 0
GROUP BY y.year
ORDER BY y.year
LIMIT 20;
```

```sql
--Description: identify drivers whose season total equals that minimum for their year
SELECT y.year,
       ds.driver_id,
       ds.points
FROM (
     SELECT r.year,
            r.race_id
     FROM races AS r
     JOIN (
          SELECT year, MAX(round) AS max_round
          FROM races
          WHERE year >= 2001
          GROUP BY year
     ) AS f
     ON  r.year  = f.year
     AND r.round = f.max_round
) AS y
JOIN driver_standings AS ds
ON  ds.race_id = y.race_id
JOIN (
     SELECT y2.year,
            MIN(ds2.points) AS min_points
     FROM (
          SELECT r.year,
                 r.race_id
          FROM races AS r
          JOIN (
               SELECT year, MAX(round) AS max_round
               FROM races
               WHERE year >= 2001
               GROUP BY year
          ) AS f
          ON  r.year  = f.year
          AND r.round = f.max_round
     ) AS y2
     JOIN driver_standings AS ds2
     ON  ds2.race_id = y2.race_id
     WHERE ds2.points > 0
     GROUP BY y2.year
) AS m
ON  m.year   = y.year
AND ds.points = m.min_points
ORDER BY y.year
LIMIT 20;
```

```sql
--Description: link those lowest-scoring drivers to the constructor they drove for in the season-finale race
SELECT t.year,
       t.driver_id,
       r.constructor_id
FROM (
     SELECT y.year,
            y.race_id  AS final_race_id,
            ds.driver_id
     FROM (
          SELECT r.year,
                 r.race_id
          FROM races AS r
          JOIN (
               SELECT year, MAX(round) AS max_round
               FROM races
               WHERE year >= 2001
               GROUP BY year
          ) AS f
          ON  r.year  = f.year
          AND r.round = f.max_round
     ) AS y
     JOIN driver_standings AS ds
     ON  ds.race_id = y.race_id
     JOIN (
          SELECT y2.year,
                 MIN(ds2.points) AS min_points
          FROM (
               SELECT r.year,
                      r.race_id
               FROM races AS r
               JOIN (
                    SELECT year, MAX(round) AS max_round
                    FROM races
                    WHERE year >= 2001
                    GROUP BY year
               ) AS f
               ON  r.year  = f.year
               AND r.round = f.max_round
          ) AS y2
          JOIN driver_standings AS ds2
          ON  ds2.race_id = y2.race_id
          WHERE ds2.points > 0
          GROUP BY y2.year
     ) AS m
     ON  m.year   = y.year
     AND ds.points = m.min_points
) AS t
JOIN results AS r
ON  r.race_id  = t.final_race_id
AND r.driver_id = t.driver_id
LIMIT 20;
```

```sql
--Description: count how many seasons each constructor appears in that “fewest points” group
SELECT c.constructor_id,
       COUNT(*) AS seasons_with_least_points
FROM (
     SELECT t.year,
            r.constructor_id
     FROM (
          SELECT y.year,
                 y.race_id  AS final_race_id,
                 ds.driver_id
          FROM (
               SELECT r.year,
                      r.race_id
               FROM races AS r
               JOIN (
                    SELECT year, MAX(round) AS max_round
                    FROM races
                    WHERE year >= 2001
                    GROUP BY year
               ) AS f
               ON  r.year  = f.year
               AND r.round = f.max_round
          ) AS y
          JOIN driver_standings AS ds
          ON  ds.race_id = y.race_id
          JOIN (
               SELECT y2.year,
                      MIN(ds2.points) AS min_points
               FROM (
                    SELECT r.year,
                           r.race_id
                    FROM races AS r
                    JOIN (
                         SELECT year, MAX(round) AS max_round
                         FROM races
                         WHERE year >= 2001
                         GROUP BY year
                    ) AS f
                    ON  r.year  = f.year
                    AND r.round = f.max_round
               ) AS y2
               JOIN driver_standings AS ds2
               ON  ds2.race_id = y2.race_id
               WHERE ds2.points > 0
               GROUP BY y2.year
          ) AS m
          ON  m.year   = y.year
          AND ds.points = m.min_points
     ) AS t
     JOIN results AS r
     ON  r.race_id  = t.final_race_id
     AND r.driver_id = t.driver_id
) AS c
GROUP BY c.constructor_id
ORDER BY seasons_with_least_points DESC
LIMIT 20;
```

```sql
--Description: attach constructor names to the above counts
SELECT con.name,
       x.seasons_with_least_points
FROM constructors AS con
JOIN (
     SELECT c.constructor_id,
            COUNT(*) AS seasons_with_least_points
     FROM (
          SELECT t.year,
                 r.constructor_id
          FROM (
               SELECT y.year,
                      y.race_id  AS final_race_id,
                      ds.driver_id
               FROM (
                    SELECT r.year,
                           r.race_id
                    FROM races AS r
                    JOIN (
                         SELECT year, MAX(round) AS max_round
                         FROM races
                         WHERE year >= 2001
                         GROUP BY year
                    ) AS f
                    ON  r.year  = f.year
                    AND r.round = f.max_round
               ) AS y
               JOIN driver_standings AS ds
               ON  ds.race_id = y.race_id
               JOIN (
                    SELECT y2.year,
                           MIN(ds2.points) AS min_points
                    FROM (
                         SELECT r.year,
                                r.race_id
                         FROM races AS r
                         JOIN (
                              SELECT year, MAX(round) AS max_round
                              FROM races
                              WHERE year >= 2001
                              GROUP BY year
                         ) AS f
                         ON  r.year  = f.year
                         AND r.round = f.max_round
                    ) AS y2
                    JOIN driver_standings AS ds2
                    ON  ds2.race_id = y2.race_id
                    WHERE ds2.points > 0
                    GROUP BY y2.year
               ) AS m
               ON  m.year   = y.year
               AND ds.points = m.min_points
          ) AS t
          JOIN results AS r
          ON  r.race_id  = t.final_race_id
          AND r.driver_id = t.driver_id
     ) AS c
     GROUP BY c.constructor_id
) AS x
ON con.constructor_id = x.constructor_id
ORDER BY x.seasons_with_least_points DESC, con.name
LIMIT 20;
```

```sql
--Description: top five constructors with the most such seasons (final answer set)
SELECT con.name  AS constructor_name,
       x.seasons_with_least_points
FROM constructors AS con
JOIN (
     SELECT c.constructor_id,
            COUNT(*) AS seasons_with_least_points
     FROM (
          SELECT t.year,
                 r.constructor_id
          FROM (
               SELECT y.year,
                      y.race_id  AS final_race_id,
                      ds.driver_id
               FROM (
                    SELECT r.year,
                           r.race_id
                    FROM races AS r
                    JOIN (
                         SELECT year, MAX(round) AS max_round
                         FROM races
                         WHERE year >= 2001
                         GROUP BY year
                    ) AS f
                    ON  r.year  = f.year
                    AND r.round = f.max_round
               ) AS y
               JOIN driver_standings AS ds
               ON  ds.race_id = y.race_id
               JOIN (
                    SELECT y2.year,
                           MIN(ds2.points) AS min_points
                    FROM (
                         SELECT r.year,
                                r.race_id
                         FROM races AS r
                         JOIN (
                              SELECT year, MAX(round) AS max_round
                              FROM races
                              WHERE year >= 2001
                              GROUP BY year
                         ) AS f
                         ON  r.year  = f.year
                         AND r.round = f.max_round
                    ) AS y2
                    JOIN driver_standings AS ds2
                    ON  ds2.race_id = y2.race_id
                    WHERE ds2.points > 0
                    GROUP BY y2.year
               ) AS m
               ON  m.year   = y.year
               AND ds.points = m.min_points
          ) AS t
          JOIN results AS r
          ON  r.race_id  = t.final_race_id
          AND r.driver_id = t.driver_id
     ) AS c
     GROUP BY c.constructor_id
     ORDER BY COUNT(*) DESC
     LIMIT 5
) AS x
ON con.constructor_id = x.constructor_id
ORDER BY x.seasons_with_least_points DESC, constructor_name;
```

```sql
--Description: per-season detail – which lowest-scoring driver(s) and their constructor
SELECT t.year,
       d.forename || ' ' || d.surname AS driver_name,
       t.points,
       con.name                     AS constructor_name
FROM (
     SELECT y.year,
            y.race_id  AS final_race_id,
            ds.driver_id,
            ds.points
     FROM (
          SELECT r.year,
                 r.race_id
          FROM races AS r
          JOIN (
               SELECT year, MAX(round) AS max_round
               FROM races
               WHERE year >= 2001
               GROUP BY year
          ) AS f
          ON  r.year  = f.year
          AND r.round = f.max_round
     ) AS y
     JOIN driver_standings AS ds
     ON  ds.race_id = y.race_id
     JOIN (
          SELECT y2.year,
                 MIN(ds2.points) AS min_points
          FROM (
               SELECT r.year,
                      r.race_id
               FROM races AS r
               JOIN (
                    SELECT year, MAX(round) AS max_round
                    FROM races
                    WHERE year >= 2001
                    GROUP BY year
               ) AS f
               ON  r.year  = f.year
               AND r.round = f.max_round
          ) AS y2
          JOIN driver_standings AS ds2
          ON  ds2.race_id = y2.race_id
          WHERE ds2.points > 0
          GROUP BY y2.year
     ) AS m
     ON  m.year   = y.year
     AND ds.points = m.min_points
) AS t
JOIN results       AS r   ON r.race_id  = t.final_race_id
                         AND r.driver_id = t.driver_id
JOIN drivers       AS d   ON d.driver_id = t.driver_id
JOIN constructors  AS con ON con.constructor_id = r.constructor_id
ORDER BY t.year
LIMIT 20;
```
