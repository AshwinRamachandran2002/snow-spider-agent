Query:
--Description: Repeat the previous step but restrict to seasons since 2001 and
--             keep only point-scoring drivers (>0 points).  (One season sample.)
SELECT r."year",
       d."driver_ref",
       SUM(res."points") AS season_points
FROM   "results"  AS res
JOIN   "races"    AS r ON r."race_id" = res."race_id"
JOIN   "drivers"  AS d ON d."driver_id" = res."driver_id"
WHERE  r."year" = 2010            -- change year to inspect others
GROUP  BY r."year", d."driver_id"
HAVING season_points > 0
ORDER  BY season_points
LIMIT 20;
