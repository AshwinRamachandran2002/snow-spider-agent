```sql
--Description:  For every driver-season from 2001 onward, identify the constructor
--              with which that driver scored the MOST points (handles drivers who
--              switched teams mid-year).  A window-function ranks constructors per
--              driver-season by summed points; rn = 1 marks the primary team.
WITH driver_season_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           SUM(res."points") AS pts
    FROM   "results" AS res
    JOIN   "races"   AS r  ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
),
ranked AS (
    SELECT dsc.*,
           ROW_NUMBER() OVER (PARTITION BY dsc."year", dsc."driver_id"
                              ORDER BY dsc.pts DESC) AS rn
    FROM   driver_season_constructor AS dsc
)
SELECT *
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description:  Pair each season’s lowest-scoring point-earning driver(s) with the
--              primary constructor (the one they scored most points for) in that year.
WITH driver_points AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING SUM(res."points") > 0
),
season_min AS (
    SELECT "year", MIN(driver_points) AS min_pts
    FROM   driver_points
    GROUP  BY "year"
),
fewest_drivers AS (
    SELECT dp."year", dp."driver_id"
    FROM   driver_points AS dp
    JOIN   season_min    AS sm
      ON   sm."year" = dp."year"
     AND   sm.min_pts = dp.driver_points
),
driver_primary_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           ROW_NUMBER() OVER (PARTITION BY r."year", res."driver_id"
                              ORDER BY SUM(res."points") DESC) AS rn
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
)
SELECT f."year",
       c."constructor_ref",
       c."name" AS constructor_name
FROM   fewest_drivers             AS f
JOIN   driver_primary_constructor AS dpc
  ON   dpc."year"      = f."year"
 AND   dpc."driver_id" = f."driver_id"
 AND   dpc.rn          = 1
JOIN   "constructors"  AS c ON c."constructor_id" = dpc."constructor_id"
ORDER  BY f."year"
LIMIT 20;
```

