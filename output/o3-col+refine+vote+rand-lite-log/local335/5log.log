```sql
--Description: List all Formula 1 seasons available from 2001 onward (deduplicated “year” values).
SELECT DISTINCT r."year"
FROM "races" AS r
WHERE r."year" >= 2001
ORDER BY r."year"
LIMIT 20;
```

```sql
--Description: For one recent season (e.g., 2023) show every driver’s total points that season
--             (summing race-by-race “results.points”).  This helps confirm how to aggregate.
SELECT d."driver_ref",
       SUM(res."points") AS season_points
FROM   "results"  AS res
JOIN   "races"    AS r   ON r."race_id" = res."race_id"
JOIN   "drivers"  AS d   ON d."driver_id" = res."driver_id"
WHERE  r."year" = 2023
GROUP  BY d."driver_id"
ORDER  BY season_points DESC
LIMIT 20;
```

```sql
--Description: Repeat the previous step but restrict to seasons since 2001 and
--             keep only point-scoring drivers (>0 points).  (One season sample.)
SELECT r."year",
       d."driver_ref",
       SUM(res."points") AS season_points
FROM   "results"  AS res
JOIN   "races"    AS r ON r."race_id" = res."race_id"
JOIN   "drivers"  AS d ON d."driver_id" = res."driver_id"
WHERE  r."year" = 2010            -- change year to inspect others
GROUP  BY r."year", d."driver_id"
HAVING season_points > 0
ORDER  BY season_points
LIMIT 20;
```

```sql
--Description: For every season ≥2001 obtain the minimum points scored by ANY
--             point-scoring driver in that season (i.e., the “lowest scorer” total).
SELECT r."year",
       MIN(driver_points) AS min_driver_points
FROM (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING driver_points > 0
) AS season_totals
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
--Description: Retrieve all driver-season combinations where the driver’s total
--             equals that season’s minimum (i.e., the “fewest points” scorers).
WITH season_driver_points AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING driver_points > 0
),
season_min AS (
    SELECT "year", MIN(driver_points) AS min_points
    FROM   season_driver_points
    GROUP  BY "year"
)
SELECT sdp."year",
       sdp."driver_id",
       sdp."driver_points"
FROM   season_driver_points AS sdp
JOIN   season_min          AS sm
  ON   sm."year" = sdp."year"
 AND   sm.min_points = sdp.driver_points
ORDER  BY sdp."year"
LIMIT 20;
```

```sql
--Description: For a given season (e.g., 2010) show how many points each constructor
--             earned from that “fewest-points driver” to see which constructor carried him.
WITH driver_constructor_points AS (
    SELECT res."constructor_id",
           SUM(res."points") AS constructor_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" = 2010   -- adjust as needed
      AND  res."driver_id" =  49  -- put a driver_id from previous query
    GROUP  BY res."constructor_id"
)
SELECT c."name",
       dcp.constructor_points
FROM   driver_constructor_points AS dcp
JOIN   "constructors" AS c ON c."constructor_id" = dcp."constructor_id"
ORDER  BY constructor_points DESC
LIMIT 20;
```

```sql
--Description: Associate every driver with the constructor that scored the MOST points
--             for him in a season (handles mid-season team changes).
WITH driver_season_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           SUM(res."points") AS pts
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
),
ranked AS (
    SELECT dsc.*,
           ROW_NUMBER() OVER (PARTITION BY "year", "driver_id"
                              ORDER BY pts DESC) AS rn
    FROM   driver_season_constructor AS dsc
)
SELECT *
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: Combine “fewest-points drivers” with their primary constructor
--             (per previous CTE) to know which constructor is involved each season.
WITH driver_points AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING driver_points > 0
),
season_min AS (
    SELECT "year", MIN(driver_points) AS min_pts
    FROM   driver_points
    GROUP  BY "year"
),
fewest_drivers AS (
    SELECT dp."year", dp."driver_id"
    FROM   driver_points AS dp
    JOIN   season_min  AS sm ON sm."year" = dp."year"
                            AND sm.min_pts = dp.driver_points
),
driver_primary_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           SUM(res."points")  AS pts,
           ROW_NUMBER() OVER (PARTITION BY r."year", res."driver_id"
                              ORDER BY SUM(res."points") DESC) AS rn
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
)
SELECT f."year",
       c."constructor_ref",
       c."name"  AS constructor_name
FROM   fewest_drivers                AS f
JOIN   driver_primary_constructor AS dpc
  ON   dpc."year" = f."year"
 AND   dpc."driver_id" = f."driver_id"
 AND   dpc.rn = 1
JOIN   "constructors" AS c ON c."constructor_id" = dpc."constructor_id"
ORDER  BY f."year"
LIMIT 20;
```

```sql
--Description: Count how many seasons (since 2001) each constructor appears in the
--             previous result set, then sort to find the five constructors with the
--             MOST such seasons (i.e., most often had the “fewest-points” driver).
WITH driver_points AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING driver_points > 0
),
season_min AS (
    SELECT "year", MIN(driver_points) AS min_pts
    FROM   driver_points
    GROUP  BY "year"
),
fewest_drivers AS (
    SELECT dp."year", dp."driver_id"
    FROM   driver_points AS dp
    JOIN   season_min  AS sm ON sm."year" = dp."year"
                            AND sm.min_pts = dp.driver_points
),
driver_primary_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           ROW_NUMBER() OVER (PARTITION BY r."year", res."driver_id"
                              ORDER BY SUM(res."points") DESC) AS rn
    FROM   "results" AS res
    JOIN   "races"   AS r ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
)
SELECT c."name"  AS constructor_name,
       COUNT(*)  AS seasons_with_fewest_pts_driver
FROM   fewest_drivers                AS f
JOIN   driver_primary_constructor AS dpc
  ON   dpc."year" = f."year"
 AND   dpc."driver_id" = f."driver_id"
 AND   dpc.rn = 1
JOIN   "constructors" AS c ON c."constructor_id" = dpc."constructor_id"
GROUP  BY c."constructor_id"
ORDER  BY seasons_with_fewest_pts_driver DESC, constructor_name
LIMIT 20;
```

