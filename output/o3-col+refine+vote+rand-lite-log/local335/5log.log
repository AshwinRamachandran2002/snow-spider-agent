```sql
--Description: To know the lowest-scoring point earner each season (2001-present),
-- 1) build a driver-season table: join results→races, keep seasons ≥2001, sum points per driver.
-- 2) discard drivers who scored 0 (HAVING driver_points>0).
-- 3) in the outer query, group by year and take MIN(driver_points); that is the fewest points 
--    any point-scoring driver managed that season.
SELECT season_totals."year",
       MIN(season_totals.driver_points) AS min_driver_points
FROM (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r
           ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING driver_points > 0
) AS season_totals
GROUP BY season_totals."year"
ORDER BY season_totals."year"
LIMIT 20;
```
