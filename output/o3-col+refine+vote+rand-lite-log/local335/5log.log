```sql
--Description: Retrieve every driver-season pair (2001-present) in which the driver’s
--             season-total points equal that year’s minimum among point-scorers
--             (“fewest-points” drivers).
WITH season_driver_points AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r  ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING SUM(res."points") > 0          -- exclude zero-point drivers
),
season_min AS (
    SELECT "year",
           MIN(driver_points) AS min_points
    FROM   season_driver_points
    GROUP  BY "year"
)
SELECT sdp."year",
       sdp."driver_id",
       sdp."driver_points"
FROM   season_driver_points AS sdp
JOIN   season_min           AS sm
  ON   sm."year"      = sdp."year"
 AND   sm.min_points  = sdp."driver_points"
ORDER  BY sdp."year"
LIMIT 20;
```

```sql
--Description: For a chosen season (example 2010) show how many points each constructor
--             earned from one particular “fewest-points” driver (replace :driver_id as needed).
WITH driver_constructor_points AS (
    SELECT res."constructor_id",
           SUM(res."points") AS constructor_points
    FROM   "results" AS res
    JOIN   "races"   AS r  ON r."race_id" = res."race_id"
    WHERE  r."year"     = 2010      -- adjust season
      AND  res."driver_id" = :driver_id   -- supply driver from previous query
    GROUP  BY res."constructor_id"
)
SELECT c."name",
       dcp.constructor_points
FROM   driver_constructor_points AS dcp
JOIN   "constructors" AS c ON c."constructor_id" = dcp."constructor_id"
ORDER  BY dcp.constructor_points DESC
LIMIT 20;
```

```sql
--Description: For every driver-season (2001-present) determine the constructor with
--             which the driver scored the most points (handles mid-season team switches).
WITH driver_season_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           SUM(res."points") AS pts
    FROM   "results" AS res
    JOIN   "races"   AS r  ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
),
ranked AS (
    SELECT dsc.*,
           ROW_NUMBER() OVER (PARTITION BY dsc."year", dsc."driver_id"
                              ORDER BY dsc.pts DESC) AS rn
    FROM   driver_season_constructor AS dsc
)
SELECT *
FROM   ranked
WHERE  rn = 1
LIMIT 20;
```

```sql
--Description: Combine the “fewest-points” drivers with their primary constructor
--             for each season (2001-present).
WITH driver_points AS (
    SELECT r."year",
           res."driver_id",
           SUM(res."points") AS driver_points
    FROM   "results" AS res
    JOIN   "races"   AS r  ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id"
    HAVING SUM(res."points") > 0
),
season_min AS (
    SELECT "year", MIN(driver_points) AS min_pts
    FROM   driver_points
    GROUP  BY "year"
),
fewest_drivers AS (
    SELECT dp."year", dp."driver_id"
    FROM   driver_points AS dp
    JOIN   season_min    AS sm
      ON   sm."year" = dp."year"
     AND   sm.min_pts = dp.driver_points
),
driver_primary_constructor AS (
    SELECT r."year",
           res."driver_id",
           res."constructor_id",
           ROW_NUMBER() OVER (PARTITION BY r."year", res."driver_id"
                              ORDER BY SUM(res."points") DESC) AS rn
    FROM   "results" AS res
    JOIN   "races"   AS r  ON r."race_id" = res."race_id"
    WHERE  r."year" >= 2001
    GROUP  BY r."year", res."driver_id", res."constructor_id"
)
SELECT f."year",
       c."constructor_ref",
       c."name" AS constructor_name
FROM   fewest_drivers              AS f
JOIN   driver_primary_constructor  AS dpc
  ON   dpc."year"      = f."year"
 AND   dpc."driver_id" = f."driver_id"
 AND   dpc.rn          = 1
JOIN   "constructors" AS c ON c."constructor_id" = dpc."constructor_id"
ORDER  BY f."year"
LIMIT 20;
