Query:
-- 7. Count, for every constructor, how many seasons (since 2001) they supplied a driver
-- who ended up with the fewest points among all point-scoring drivers
WITH final_races AS (
    SELECT r1."year",
           MAX(r1."round") AS "final_round"
    FROM   "races" AS r1
    WHERE  r1."year" >= 2001
    GROUP  BY r1."year"
),
min_pts AS (
    SELECT fr."year",
           MIN(ds."points") AS "min_points"
    FROM   final_races      AS fr
    JOIN   "races"          AS r  ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds ON ds."race_id" = r."race_id"
    WHERE  ds."points" > 0
    GROUP  BY fr."year"
),
drivers_with_min AS (
    SELECT mp."year",
           ds."driver_id",
           res."constructor_id"
    FROM   min_pts          AS mp
    JOIN   final_races      AS fr  ON fr."year" = mp."year"
    JOIN   "races"          AS r   ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds  ON ds."race_id" = r."race_id" AND ds."points" = mp."min_points"
    JOIN   "results"        AS res ON res."race_id" = ds."race_id" AND res."driver_id" = ds."driver_id"
)
SELECT dwm."constructor_id",
       COUNT(DISTINCT dwm."year") AS "seasons_with_min_points_driver"
FROM   drivers_with_min AS dwm
GROUP  BY dwm."constructor_id"
ORDER  BY "seasons_with_min_points_driver" DESC
LIMIT 20;
