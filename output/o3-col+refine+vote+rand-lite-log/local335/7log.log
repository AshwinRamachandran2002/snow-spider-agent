```sql
-- 1. Distinct list of seasons available from 2001 onward
SELECT DISTINCT "year"
FROM "races"
WHERE "year" >= 2001
ORDER BY "year"
LIMIT 20;
```

```sql
-- 2. For every season (≥2001) get the last round number – i.e. the final Grand Prix of the year
SELECT r."year",
       MAX(r."round") AS "final_round"
FROM "races" AS r
WHERE r."year" >= 2001
GROUP BY r."year"
ORDER BY r."year"
LIMIT 20;
```

```sql
-- 3. Inspect the final-round race of 2001 (should correspond to the previous query’s result)
SELECT r."race_id",
       r."year",
       r."round",
       r."name"
FROM "races" AS r
WHERE r."year" = 2001
  AND r."round" = (SELECT MAX(r2."round") FROM "races" AS r2 WHERE r2."year" = 2001)
ORDER BY r."round" DESC
LIMIT 20;
```

```sql
-- 4. Driver-standings table for that final 2001 race (ascending by points)
SELECT ds."driver_id",
       ds."points"
FROM "driver_standings" AS ds
JOIN "races"              AS r  ON r."race_id" = ds."race_id"
WHERE r."year"  = 2001
  AND r."round" = (SELECT MAX(r2."round") FROM "races" AS r2 WHERE r2."year" = 2001)
ORDER BY ds."points" ASC
LIMIT 20;
```

```sql
-- 5. Minimum points scored by any points-scoring driver in every season since 2001
WITH final_races AS (
    SELECT r1."year",
           MAX(r1."round") AS "final_round"
    FROM   "races" AS r1
    WHERE  r1."year" >= 2001
    GROUP  BY r1."year"
)
SELECT fr."year",
       MIN(ds."points") AS "min_points"
FROM   final_races      AS fr
JOIN   "races"          AS r  ON r."year" = fr."year" AND r."round" = fr."final_round"
JOIN   "driver_standings" AS ds ON ds."race_id" = r."race_id"
WHERE  ds."points" > 0
GROUP  BY fr."year"
ORDER  BY fr."year"
LIMIT 20;
```

```sql
-- 6. Drivers (and their constructors in the final race) who had that season-minimum points
WITH final_races AS (
    SELECT r1."year",
           MAX(r1."round") AS "final_round"
    FROM   "races" AS r1
    WHERE  r1."year" >= 2001
    GROUP  BY r1."year"
),
min_pts AS (
    SELECT fr."year",
           MIN(ds."points") AS "min_points"
    FROM   final_races      AS fr
    JOIN   "races"          AS r  ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds ON ds."race_id" = r."race_id"
    WHERE  ds."points" > 0
    GROUP  BY fr."year"
)
SELECT DISTINCT mp."year",
       ds."driver_id",
       ds."points",
       res."constructor_id"
FROM   min_pts          AS mp
JOIN   final_races      AS fr  ON fr."year" = mp."year"
JOIN   "races"          AS r   ON r."year" = fr."year" AND r."round" = fr."final_round"
JOIN   "driver_standings" AS ds  ON ds."race_id" = r."race_id" AND ds."points" = mp."min_points"
JOIN   "results"        AS res ON res."race_id" = ds."race_id" AND res."driver_id" = ds."driver_id"
ORDER  BY mp."year"
LIMIT 20;
```

```sql
-- 7. Count, for every constructor, how many seasons (since 2001) they supplied a driver
-- who ended up with the fewest points among all point-scoring drivers
WITH final_races AS (
    SELECT r1."year",
           MAX(r1."round") AS "final_round"
    FROM   "races" AS r1
    WHERE  r1."year" >= 2001
    GROUP  BY r1."year"
),
min_pts AS (
    SELECT fr."year",
           MIN(ds."points") AS "min_points"
    FROM   final_races      AS fr
    JOIN   "races"          AS r  ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds ON ds."race_id" = r."race_id"
    WHERE  ds."points" > 0
    GROUP  BY fr."year"
),
drivers_with_min AS (
    SELECT mp."year",
           ds."driver_id",
           res."constructor_id"
    FROM   min_pts          AS mp
    JOIN   final_races      AS fr  ON fr."year" = mp."year"
    JOIN   "races"          AS r   ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds  ON ds."race_id" = r."race_id" AND ds."points" = mp."min_points"
    JOIN   "results"        AS res ON res."race_id" = ds."race_id" AND res."driver_id" = ds."driver_id"
)
SELECT dwm."constructor_id",
       COUNT(DISTINCT dwm."year") AS "seasons_with_min_points_driver"
FROM   drivers_with_min AS dwm
GROUP  BY dwm."constructor_id"
ORDER  BY "seasons_with_min_points_driver" DESC
LIMIT 20;
```

```sql
-- 8. Retrieve the top-5 constructors (name included) with the most such seasons
WITH final_races AS (
    SELECT r1."year",
           MAX(r1."round") AS "final_round"
    FROM   "races" AS r1
    WHERE  r1."year" >= 2001
    GROUP  BY r1."year"
),
min_pts AS (
    SELECT fr."year",
           MIN(ds."points") AS "min_points"
    FROM   final_races      AS fr
    JOIN   "races"          AS r  ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds ON ds."race_id" = r."race_id"
    WHERE  ds."points" > 0
    GROUP  BY fr."year"
),
drivers_with_min AS (
    SELECT mp."year",
           res."constructor_id"
    FROM   min_pts          AS mp
    JOIN   final_races      AS fr  ON fr."year" = mp."year"
    JOIN   "races"          AS r   ON r."year" = fr."year" AND r."round" = fr."final_round"
    JOIN   "driver_standings" AS ds  ON ds."race_id" = r."race_id" AND ds."points" = mp."min_points"
    JOIN   "results"        AS res ON res."race_id" = ds."race_id" AND res."driver_id" = ds."driver_id"
),
cnt AS (
    SELECT dwm."constructor_id",
           COUNT(DISTINCT dwm."year") AS "seasons_with_min_points_driver"
    FROM   drivers_with_min AS dwm
    GROUP  BY dwm."constructor_id"
)
SELECT c."name"                AS "constructor_name",
       cnt."seasons_with_min_points_driver"
FROM   cnt
JOIN   "constructors" AS c ON c."constructor_id" = cnt."constructor_id"
ORDER  BY cnt."seasons_with_min_points_driver" DESC,
          c."name"
LIMIT 5;
```

Each successive query builds toward identifying the five constructors who, since 2001, have most frequently fielded the driver(s) with the fewest points among all point-scoring drivers in a season.
