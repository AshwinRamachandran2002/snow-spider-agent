Query:
--Description: Count how many seasons (since 2001) each constructor appears as the team of the lowest-scoring point-scoring driver; show all constructors.
WITH driver_totals AS (
    SELECT ra.year,
           r.driver_id,
           SUM(r.points) AS total_pts
    FROM   results r
    JOIN   races   ra USING (race_id)
    WHERE  ra.year >= 2001
    GROUP  BY ra.year, r.driver_id
    HAVING total_pts > 0
),
min_pts AS (
    SELECT year,
           MIN(total_pts) AS min_positive_pts
    FROM   driver_totals
    GROUP  BY year
),
driver_cons AS (
    SELECT ra.year,
           r.driver_id,
           r.constructor_id,
           SUM(r.points) AS pts_for_constructor
    FROM   results r
    JOIN   races   ra USING (race_id)
    WHERE  ra.year >= 2001
    GROUP  BY ra.year, r.driver_id, r.constructor_id
),
driver_min_pts AS (
    SELECT dt.year,
           dt.driver_id,
           dt.total_pts
    FROM   driver_totals dt
    JOIN   min_pts mp
      ON   mp.year = dt.year
     AND   mp.min_positive_pts = dt.total_pts
),
driver_min_cons AS (
    SELECT dm.year,
           dc.constructor_id,
           dc.pts_for_constructor,
           ROW_NUMBER() OVER (
               PARTITION BY dm.year, dm.driver_id
               ORDER BY dc.pts_for_constructor DESC
           ) AS rn
    FROM   driver_min_pts dm
    JOIN   driver_cons    dc
      ON   dc.year      = dm.year
     AND   dc.driver_id = dm.driver_id
)
SELECT COALESCE(scn.short_name, c.name) AS constructor_name,
       COUNT(DISTINCT dmc.year)         AS seasons_with_lowest_scorer
FROM   driver_min_cons dmc
JOIN   constructors            c   USING (constructor_id)
LEFT   JOIN short_constructor_names scn
       ON scn.constructor_ref = c.constructor_ref
WHERE  dmc.rn = 1
GROUP  BY c.constructor_id
ORDER  BY seasons_with_lowest_scorer DESC
LIMIT 20
