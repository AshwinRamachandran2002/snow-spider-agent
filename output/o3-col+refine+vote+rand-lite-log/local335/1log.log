```sql
-- 7.  Combine everything: which constructor(s) “owned” the season’s
--     lowest-scoring point-scoring driver, year by year
WITH driver_totals AS (
    SELECT ra."year",
           r."driver_id",
           SUM(r."points") AS total_pts
    FROM   "results" AS r
    JOIN   "races"   AS ra USING ("race_id")
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING total_pts > 0
),
min_pts AS (
    SELECT "year",
           MIN(total_pts) AS min_positive_pts
    FROM   driver_totals
    GROUP  BY "year"
),
driver_cons AS (
    SELECT ra."year",
           r."driver_id",
           r."constructor_id",
           SUM(r."points") AS pts_for_constructor
    FROM   "results" AS r
    JOIN   "races"   AS ra USING ("race_id")
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id", r."constructor_id"
),
driver_min_pts AS (
    SELECT dt."year", dt."driver_id", dt."total_pts"
    FROM   driver_totals dt
    JOIN   min_pts mp
           ON mp."year" = dt."year"
          AND mp."min_positive_pts" = dt."total_pts"
),
driver_min_cons AS (
    SELECT dm."year",
           dm."driver_id",
           dc."constructor_id",
           dc."pts_for_constructor",
           ROW_NUMBER() OVER (
               PARTITION BY dm."year", dm."driver_id"
               ORDER BY dc."pts_for_constructor" DESC
           ) AS rn
    FROM   driver_min_pts dm
    JOIN   driver_cons    dc
           ON  dc."year"      = dm."year"
           AND dc."driver_id" = dm."driver_id"
)
SELECT dmc."year",
       c."constructor_id",
       COALESCE(scn."short_name", c."name") AS constructor_name
FROM   driver_min_cons dmc
JOIN   "constructors" c USING ("constructor_id")
LEFT   JOIN "short_constructor_names" scn
       ON scn."constructor_ref" = c."constructor_ref"
WHERE  dmc.rn = 1
ORDER  BY dmc."year"
LIMIT 20;
```

