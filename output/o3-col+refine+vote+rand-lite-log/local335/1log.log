Query:
--Description: Show the exact seasons (since 2001) for each of those top-5 constructors in which they were the team of the lowest-scoring point-scorer.
WITH driver_totals AS (
    SELECT ra.year,
           r.driver_id,
           SUM(r.points) AS total_pts
    FROM   results r
    JOIN   races   ra USING (race_id)
    WHERE  ra.year >= 2001
    GROUP  BY ra.year, r.driver_id
    HAVING total_pts > 0
),
min_pts AS (
    SELECT year,
           MIN(total_pts) AS min_positive_pts
    FROM   driver_totals
    GROUP  BY year
),
driver_cons AS (
    SELECT ra.year,
           r.driver_id,
           r.constructor_id,
           SUM(r.points) AS pts_for_constructor
    FROM   results r
    JOIN   races   ra USING (race_id)
    WHERE  ra.year >= 2001
    GROUP  BY ra.year, r.driver_id, r.constructor_id
),
driver_min_pts AS (
    SELECT dt.year,
           dt.driver_id,
           dt.total_pts
    FROM   driver_totals dt
    JOIN   min_pts mp
      ON   mp.year = dt.year
     AND   mp.min_positive_pts = dt.total_pts
),
driver_min_cons AS (
    SELECT dm.year,
           dc.constructor_id,
           ROW_NUMBER() OVER (
               PARTITION BY dm.year, dm.driver_id
               ORDER BY dc.pts_for_constructor DESC
           ) AS rn
    FROM   driver_min_pts dm
    JOIN   driver_cons    dc
      ON   dc.year      = dm.year
     AND   dc.driver_id = dm.driver_id
),
ranked AS (  -- constructor per season that ‘owns’ the lowest scorer
    SELECT COALESCE(scn.short_name, c.name) AS constructor_name,
           dmc.year
    FROM   driver_min_cons dmc
    JOIN   constructors            c   USING (constructor_id)
    LEFT   JOIN short_constructor_names scn
           ON scn.constructor_ref = c.constructor_ref
    WHERE  dmc.rn = 1
),
top5 AS (
    SELECT constructor_name
    FROM   ranked
    GROUP  BY constructor_name
    ORDER  BY COUNT(DISTINCT year) DESC
    LIMIT 5
)
SELECT r.constructor_name,
       r.year
FROM   ranked r
JOIN   top5   t ON t.constructor_name = r.constructor_name
ORDER  BY r.constructor_name, r.year
