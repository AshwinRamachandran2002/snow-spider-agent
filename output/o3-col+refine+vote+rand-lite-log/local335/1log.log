--Description:
-- Determine the five constructors that have most frequently been the team of the
-- lowest-scoring (yet point-scoring) driver in every Formula 1 season since 2001.
-- Steps inside one query (via CTEs):
--   1. driver_totals   – total points each driver collected in a season (only > 0).
--   2. season_min      – the minimum of those positive totals for each season.
--   3. low_drivers     – driver-seasons whose total equals that minimum.
--   4. driver_cons     – split each low_driver season by constructor and sum points.
--   5. best_cons       – for every (season, driver) keep the constructor that gave
--                        that driver the most points (ROW_NUMBER = 1).
--   6. final count     – count distinct seasons per constructor, sort, take top 5.
WITH driver_totals AS (
    SELECT ra.year,
           r.driver_id,
           SUM(r.points) AS total_pts
    FROM   results r
    JOIN   races   ra USING (race_id)
    WHERE  ra.year >= 2001
    GROUP  BY ra.year, r.driver_id
    HAVING total_pts > 0
),
season_min AS (
    SELECT year,
           MIN(total_pts) AS min_pts
    FROM   driver_totals
    GROUP  BY year
),
low_drivers AS (
    SELECT dt.year,
           dt.driver_id
    FROM   driver_totals dt
    JOIN   season_min sm
      ON   sm.year = dt.year
     AND   sm.min_pts = dt.total_pts
),
driver_cons AS (
    SELECT ra.year,
           r.driver_id,
           r.constructor_id,
           SUM(r.points) AS pts_for_constructor
    FROM   results r
    JOIN   races   ra USING (race_id)
    WHERE  ra.year >= 2001
    GROUP  BY ra.year, r.driver_id, r.constructor_id
),
best_cons AS (
    SELECT ld.year,
           ld.driver_id,
           dc.constructor_id,
           ROW_NUMBER() OVER (
               PARTITION BY ld.year, ld.driver_id
               ORDER BY dc.pts_for_constructor DESC, dc.constructor_id
           ) AS rn
    FROM   low_drivers ld
    JOIN   driver_cons dc
      ON   dc.year      = ld.year
     AND   dc.driver_id = ld.driver_id
)
SELECT COALESCE(scn.short_name, c.name) AS constructor_name,
       COUNT(DISTINCT bc.year)          AS seasons_with_lowest_scorer
FROM   best_cons bc
JOIN   constructors c            USING (constructor_id)
LEFT   JOIN short_constructor_names scn
       ON scn.constructor_ref = c.constructor_ref
WHERE  bc.rn = 1
GROUP  BY c.constructor_id
ORDER  BY seasons_with_lowest_scorer DESC
LIMIT 5;
