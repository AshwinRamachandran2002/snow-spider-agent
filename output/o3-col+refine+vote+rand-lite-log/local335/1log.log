WITH driver_totals AS (
    SELECT ra."year",
           r."driver_id",
           SUM(r."points") AS pts
    FROM   "results" AS r
    JOIN   "races"   AS ra USING ("race_id")
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING pts > 0
