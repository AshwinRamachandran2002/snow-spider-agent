```sql
-- 1.  Inspect how many points each driver is awarded in each race
SELECT DISTINCT r."race_id",
       ra."year",
       r."driver_id",
       r."constructor_id",
       r."points"
FROM   "results" AS r
JOIN   "races"   AS ra USING ("race_id")
WHERE  ra."year" >= 2001
LIMIT 20;
```

```sql
-- 2.  Aggregate race points to a driver-season total (all constructors pooled)
SELECT ra."year",
       r."driver_id",
       SUM(r."points") AS driver_season_pts
FROM   "results" AS r
JOIN   "races"   AS ra USING ("race_id")
WHERE  ra."year" >= 2001
GROUP  BY ra."year", r."driver_id"
HAVING driver_season_pts > 0           -- only point-scoring drivers
ORDER  BY ra."year", driver_season_pts
LIMIT 20;
```

```sql
-- 3.  For every season since 2001, find the minimum positive point total
WITH driver_totals AS (
    SELECT ra."year",
           r."driver_id",
           SUM(r."points") AS pts
    FROM   "results" AS r
    JOIN   "races"   AS ra USING ("race_id")
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING pts > 0
)
SELECT dt."year",
       MIN(dt."pts") AS min_positive_pts
FROM   driver_totals AS dt
GROUP  BY dt."year"
ORDER  BY dt."year"
LIMIT 20;
```

```sql
-- 4.  Drivers who recorded that minimum-positive total in every season
WITH driver_totals AS (
    SELECT ra."year",
           r."driver_id",
           SUM(r."points") AS pts
    FROM   "results" AS r
    JOIN   "races"   AS ra USING ("race_id")
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING pts > 0
),
min_pts AS (
    SELECT "year",
           MIN(pts) AS min_positive_pts
    FROM   driver_totals
    GROUP  BY "year"
)
SELECT dt."year",
       dt."driver_id",
       dt."pts"
FROM   driver_totals AS dt
JOIN   min_pts       AS mp USING ("year")
WHERE  dt."pts" = mp."min_positive_pts"
ORDER  BY dt."year"
LIMIT 20;
```

```sql
-- 5.  Split each of the above driver-seasons by constructor and
--     keep the constructor that supplied most of that driver’s points
WITH driver_totals AS (
    SELECT ra."year",
           r."driver_id",
           SUM(r."points") AS total_pts
    FROM   "results" AS r
    JOIN   "races"   AS ra USING ("race_id")
    WHERE  ra."year" >= 2001
    GROUP  BY ra."year", r."driver_id"
    HAVING total_pts > 0
),
min_pts AS (
    SELECT "year",
           MIN(total_pts) AS min_positive_pts
    FROM   driver_totals
    GROUP  BY "year"
),
driver_cons AS (
    SELECT ra."year",
           r."driver_id",
           r."constructor_id",
           SUM(r."points")               AS pts_for_constructor,
           SUM(r."points") * 1.0 /
           (SELECT SUM(r2."points")
              FROM "results" r2
              JOIN "races"  ra2 USING ("race_id")
              WHERE ra2."year" = ra."year"
                AND r2."driver_id" = r."driver_id") AS pct_share
    FROM   "results" AS r
    JOIN   "races"   AS ra  USING ("race_id")
    GROUP  BY ra."year", r."driver_id", r."constructor_id"
),
driver_min_pts AS (
    SELECT dt."year", dt."driver_id", dt."total_pts"
    FROM   driver_totals dt
    JOIN   min_pts mp
           ON mp."year" = dt."year"
          AND mp."min_positive_pts" = dt."total_pts"
)
SELECT dm."year",
       dm."driver_id",
       dc."constructor_id",
       dc."pts_for_constructor"
FROM   driver_min_pts dm
JOIN   driver_cons    dc
       ON  dc."year"      = dm."year"
       AND dc."driver_id" = dm."driver_id"
QUALIFY ROW_NUMBER() OVER (
           PARTITION BY dm."year", dm."driver_id"
           ORDER BY dc."pts_for_constructor" DESC
       ) = 1                -- keep constructor with most of the driver’s points
ORDER  BY dm."year"
LIMIT 20;
```

