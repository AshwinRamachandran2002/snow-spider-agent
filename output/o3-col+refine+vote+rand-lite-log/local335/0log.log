```sql
-- Description / Thinking process:
-- We need the driver(s) who, in 2001, scored the fewest positive total points.
-- 1. Join results → races, keep 2001, group by driver, sum points.
-- 2. Filter out drivers with zero points (HAVING SUM(points) > 0).
-- 3. With a window-function, rank those sums; the minimum gets rank = 1.
-- 4. Pick the rank-1 rows and show driver name + total.
SELECT
    d.driver_id,
    d.forename || ' ' || d.surname AS driver_name,
    drv_tot.season_points
FROM (
        SELECT
            re.driver_id,
            SUM(re.points) AS season_points,
            RANK() OVER (ORDER BY SUM(re.points)) AS rnk
        FROM results re
        JOIN races   ra ON ra.race_id = re.race_id
        WHERE ra.year = 2001
        GROUP BY re.driver_id
        HAVING SUM(re.points) > 0
     ) AS drv_tot
JOIN drivers d ON d.driver_id = drv_tot.driver_id
WHERE drv_tot.rnk = 1;
```
