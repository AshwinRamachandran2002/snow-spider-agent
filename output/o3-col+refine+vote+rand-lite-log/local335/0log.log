Query:
-- Description: 9)  Constructors that had at least one driver with the season-minimum points (since 2001)
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
),
min_drivers AS (
    SELECT  year,
            driver_id
    FROM   (
            SELECT  driver_tot.*,
                    RANK() OVER (PARTITION BY year ORDER BY season_points) AS rnk
            FROM    driver_tot
           )
    WHERE  rnk = 1
)
SELECT DISTINCT ra.year,
       c.constructor_id,
       c.name AS constructor_name
FROM   min_drivers md
JOIN   results      re ON re.driver_id = md.driver_id
JOIN   races        ra ON ra.race_id   = re.race_id  AND ra.year = md.year
JOIN   constructors c  ON c.constructor_id = re.constructor_id
LIMIT 20
