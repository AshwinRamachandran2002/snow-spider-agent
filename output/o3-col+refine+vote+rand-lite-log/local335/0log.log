```sql
-- Description: 7)  The minimum positive driver-points total for each season since 2001
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
)
SELECT  year,
        MIN(season_points) AS min_points
FROM    driver_tot
GROUP   BY year
ORDER   BY year
LIMIT 20;
```

```sql
-- Description: 8)  (year, driver) pairs whose season total equals the minimum among point-scorers
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
),
ranked AS (
    SELECT  driver_tot.*,
            RANK() OVER (PARTITION BY year ORDER BY season_points) AS rnk
    FROM    driver_tot
)
SELECT  year,
        driver_id,
        season_points
FROM    ranked
WHERE   rnk = 1
ORDER   BY year
LIMIT 20;
```

```sql
-- Description: 9)  Constructors that had at least one driver with the season-minimum points (since 2001)
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
),
min_drivers AS (
    SELECT  year,
            driver_id
    FROM   (
            SELECT  driver_tot.*,
                    RANK() OVER (PARTITION BY year ORDER BY season_points) AS rnk
            FROM    driver_tot
           )
    WHERE  rnk = 1
)
SELECT DISTINCT ra.year,
       c.constructor_id,
       c.name AS constructor_name
FROM   min_drivers md
JOIN   results      re ON re.driver_id = md.driver_id
JOIN   races        ra ON ra.race_id   = re.race_id  AND ra.year = md.year
JOIN   constructors c  ON c.constructor_id = re.constructor_id
LIMIT 20;
```

```sql
-- Description: 10)  Top 5 constructors by number of seasons (since 2001) 
--                   in which they fielded a driver with the season-minimum points
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
),
min_drivers AS (
    SELECT  year,
            driver_id
    FROM   (
            SELECT  driver_tot.*,
                    RANK() OVER (PARTITION BY year ORDER BY season_points) AS rnk
            FROM    driver_tot
           )
    WHERE  rnk = 1
)
SELECT  c.name AS constructor,
        COUNT(DISTINCT ra.year) AS seasons_with_min_point_driver
FROM   min_drivers md
JOIN   results      re ON re.driver_id = md.driver_id
JOIN   races        ra ON ra.race_id   = re.race_id  AND ra.year = md.year
JOIN   constructors c  ON c.constructor_id = re.constructor_id
GROUP  BY c.constructor_id, c.name
ORDER  BY seasons_with_min_point_driver DESC
LIMIT 5;
```
