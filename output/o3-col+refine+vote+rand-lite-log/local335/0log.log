```sql
-- Description: 8)  (year, driver) pairs that had the season-minimum among point scorers
SELECT  yd."year",
        yd."driver_id",
        yd."season_points"
FROM   (
        SELECT  ra."year",
                re."driver_id",
                SUM(re."points") AS "season_points"
        FROM    "results" AS re
        JOIN    "races"   AS ra ON ra."race_id" = re."race_id"
        WHERE   ra."year" >= 2001
        GROUP BY ra."year", re."driver_id"
        HAVING  SUM(re."points") > 0
       ) AS yd
JOIN   (
        SELECT  "year",
                MIN("season_points") AS "min_points"
        FROM   (
                SELECT  ra2."year",
                        re2."driver_id",
                        SUM(re2."points") AS "season_points"
                FROM    "results" AS re2
                JOIN    "races"   AS ra2 ON ra2."race_id" = re2."race_id"
                WHERE   ra2."year" >= 2001
                GROUP BY ra2."year", re2."driver_id"
                HAVING  SUM(re2."points") > 0
              )
        GROUP BY "year"
       ) AS mn
       ON  mn."year" = yd."year"
       AND mn."min_points" = yd."season_points"
ORDER BY yd."year"
LIMIT 20;
```

```sql
-- Description: 9)  Constructors associated with each of those lowest-scoring drivers
SELECT DISTINCT yd."year",
       c."constructor_id",
       c."name" AS "constructor_name"
FROM  (
      /* (year, driver) pairs with season-minimum points – query 8 without LIMIT */
      SELECT  yd2."year",
              yd2."driver_id"
      FROM   (
              SELECT  ra."year",
                      re."driver_id",
                      SUM(re."points") AS "season_points"
              FROM    "results" AS re
              JOIN    "races"   AS ra ON ra."race_id" = re."race_id"
              WHERE   ra."year" >= 2001
              GROUP BY ra."year", re."driver_id"
              HAVING  SUM(re."points") > 0
             ) AS yd2
      JOIN   (
              SELECT  "year",
                      MIN("season_points") AS "min_points"
              FROM   (
                      SELECT  ra3."year",
                              re3."driver_id",
                              SUM(re3."points") AS "season_points"
                      FROM    "results" AS re3
                      JOIN    "races"   AS ra3 ON ra3."race_id" = re3."race_id"
                      WHERE   ra3."year" >= 2001
                      GROUP BY ra3."year", re3."driver_id"
                      HAVING  SUM(re3."points") > 0
                     )
              GROUP BY "year"
             ) AS mn2
             ON mn2."year" = yd2."year"
            AND mn2."min_points" = yd2."season_points"
     ) AS lowdrv
JOIN "results"      AS re ON re."driver_id" = lowdrv."driver_id"
JOIN "races"        AS ra ON ra."race_id"   = re."race_id"
JOIN "constructors" AS c  ON c."constructor_id" = re."constructor_id"
WHERE ra."year" = lowdrv."year"   -- keep within same season
LIMIT 20;
```

```sql
-- Description: 10)  Top 5 constructors by number of seasons (since 2001) 
--          in which they had at least one driver with the season-minimum points
SELECT  c."name"  AS "constructor",
        COUNT(DISTINCT lowdrv."year") AS "seasons_with_min_point_driver"
FROM  (
      /* same low-scoring driver list as query 9 (without LIMIT) */
      SELECT  yd2."year",
              yd2."driver_id"
      FROM   (
              SELECT  ra."year",
                      re."driver_id",
                      SUM(re."points") AS "season_points"
              FROM    "results" AS re
              JOIN    "races"   AS ra ON ra."race_id" = re."race_id"
              WHERE   ra."year" >= 2001
              GROUP BY ra."year", re."driver_id"
              HAVING  SUM(re."points") > 0
             ) AS yd2
      JOIN   (
              SELECT  "year",
                      MIN("season_points") AS "min_points"
              FROM   (
                      SELECT  ra3."year",
                              re3."driver_id",
                              SUM(re3."points") AS "season_points"
                      FROM    "results" AS re3
                      JOIN    "races"   AS ra3 ON ra3."race_id" = re3."race_id"
                      WHERE   ra3."year" >= 2001
                      GROUP BY ra3."year", re3."driver_id"
                      HAVING  SUM(re3."points") > 0
                     )
              GROUP BY "year"
             ) AS mn2
             ON mn2."year" = yd2."year"
            AND mn2."min_points" = yd2."season_points"
     ) AS lowdrv
JOIN "results"      AS re ON re."driver_id" = lowdrv."driver_id"
JOIN "races"        AS ra ON ra."race_id"   = re."race_id"
JOIN "constructors" AS c  ON c."constructor_id" = re."constructor_id"
WHERE ra."year" = lowdrv."year"
GROUP BY c."constructor_id", c."name"
ORDER BY "seasons_with_min_point_driver" DESC
LIMIT 5;
```
