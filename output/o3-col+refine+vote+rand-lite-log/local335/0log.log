```sql
-- Description: 1) Seasons that are in scope – all years since 2001 (inclusive)
SELECT DISTINCT "year"
FROM "seasons"
WHERE "year" >= 2001
ORDER BY "year"
LIMIT 20;
```

```sql
-- Description: 2)  Driver-level season points for one sample year (2001)   
--      (sum of race-result points for every driver who scored >0)
SELECT  ra."year",
        re."driver_id",
        SUM(re."points") AS "season_points"
FROM    "results"   AS re
JOIN    "races"     AS ra  ON ra."race_id" = re."race_id"
WHERE   ra."year" = 2001
GROUP BY ra."year", re."driver_id"
HAVING  SUM(re."points") > 0
ORDER BY "season_points" ASC
LIMIT 20;
```

```sql
-- Description: 3)  The minimum positive points total scored by any driver in 2001
SELECT  MIN("season_points") AS "min_points_2001"
FROM   (
        SELECT  re."driver_id",
                SUM(re."points") AS "season_points"
        FROM    "results" AS re
        JOIN    "races"   AS ra  ON ra."race_id" = re."race_id"
        WHERE   ra."year" = 2001
        GROUP BY re."driver_id"
        HAVING  SUM(re."points") > 0
       );
```

```sql
-- Description: 4)  Drivers who had that minimum total in 2001
SELECT  d."driver_id",
        d."forename" || ' ' || d."surname" AS "driver_name"
FROM    "drivers" AS d
WHERE   d."driver_id" IN (
        SELECT  re."driver_id"
        FROM    "results" AS re
        JOIN    "races"   AS ra ON ra."race_id" = re."race_id"
        GROUP BY re."driver_id"
        HAVING  ra."year" = 2001
           AND  SUM(re."points") > 0
           AND  SUM(re."points") = (
                SELECT  MIN("season_points")
                FROM   (
                        SELECT  re2."driver_id",
                                SUM(re2."points") AS "season_points"
                        FROM    "results" AS re2
                        JOIN    "races"   AS ra2 ON ra2."race_id" = re2."race_id"
                        WHERE   ra2."year" = 2001
                        GROUP BY re2."driver_id"
                        HAVING  SUM(re2."points") > 0
                       )
               )
       )
LIMIT 20;
```

```sql
-- Description: 5)  Constructors that those lowest-scoring 2001 drivers raced for
