Query:
-- Description: 8)  (year, driver) pairs whose season total equals the minimum among point-scorers
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
),
ranked AS (
    SELECT  driver_tot.*,
            RANK() OVER (PARTITION BY year ORDER BY season_points) AS rnk
    FROM    driver_tot
)
SELECT  year,
        driver_id,
        season_points
FROM    ranked
WHERE   rnk = 1
ORDER   BY year
LIMIT 20
