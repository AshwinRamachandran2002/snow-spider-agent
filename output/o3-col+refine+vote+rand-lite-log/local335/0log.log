-- Description: 2)  Driver-level season points for one sample year (2001)   
--      (sum of race-result points for every driver who scored >0)
SELECT  ra."year",
        re."driver_id",
        SUM(re."points") AS "season_points"
FROM    "results"   AS re
JOIN    "races"     AS ra  ON ra."race_id" = re."race_id"
WHERE   ra."year" = 2001
GROUP BY ra."year", re."driver_id"
HAVING  SUM(re."points") > 0
ORDER BY "season_points" ASC
LIMIT 20;
