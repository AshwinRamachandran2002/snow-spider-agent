-- Description: 7)  The minimum positive driver-points total for each season since 2001
WITH driver_tot AS (
    SELECT  ra.year,
            re.driver_id,
            SUM(re.points) AS season_points
    FROM    results re
    JOIN    races   ra ON ra.race_id = re.race_id
    WHERE   ra.year >= 2001
    GROUP   BY ra.year, re.driver_id
    HAVING  SUM(re.points) > 0
)
SELECT  year,
        MIN(season_points) AS min_points
FROM    driver_tot
GROUP   BY year
ORDER   BY year
LIMIT 20
