-- Description: 3)  The minimum positive points total scored by any driver in 2001
SELECT  MIN("season_points") AS "min_points_2001"
FROM   (
        SELECT  re."driver_id",
                SUM(re."points") AS "season_points"
        FROM    "results" AS re
        JOIN    "races"   AS ra  ON ra."race_id" = re."race_id"
        WHERE   ra."year" = 2001
        GROUP BY re."driver_id"
        HAVING  SUM(re."points") > 0
       );
