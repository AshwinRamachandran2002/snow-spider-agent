```sql
--Description: For the first 20 seasons beginning with 2001, list the driver(s) who finished
--             each year with the lowest positive points total together with the constructor
--             they drove for in the final Grand Prix of that season.  
WITH final_races AS (                     -- last GP per season
    SELECT r."year", r."race_id"
    FROM   races r
    JOIN  (SELECT "year", MAX("round") AS max_round
           FROM   races
           WHERE  "year" >= 2001
           GROUP  BY "year") t
      ON  t."year"    = r."year"
     AND  t.max_round = r."round"
),
min_points AS (                           -- minimum positive points in each season
    SELECT fr."year",
           MIN(ds."points") AS min_pts
    FROM   final_races fr
    JOIN   driver_standings ds ON ds."race_id" = fr."race_id"
    WHERE  ds."points" > 0
    GROUP  BY fr."year"
),
lowest_drivers AS (                       -- driver(s) who have that minimum
    SELECT fr."year",
           ds."driver_id",
           ds."points"
    FROM   final_races  fr
    JOIN   driver_standings ds ON ds."race_id" = fr."race_id"
    JOIN   min_points   mp ON mp."year" = fr."year"
                          AND mp.min_pts = ds."points"
),
driver_constructors AS (                  -- constructor in the final GP
    SELECT ld."year",
           ld."driver_id",
           r."constructor_id"
    FROM   lowest_drivers ld
    JOIN   final_races   fr ON fr."year" = ld."year"
    JOIN   results       r  ON r."race_id"  = fr."race_id"
                            AND r."driver_id" = ld."driver_id"
)
SELECT dc."year",
       dc."driver_id",
       c."name" AS constructor_name,
       ld."points"
FROM   driver_constructors dc
JOIN   constructors       c  ON c."constructor_id" = dc."constructor_id"
JOIN   lowest_drivers     ld ON ld."year" = dc."year"
                            AND ld."driver_id" = dc."driver_id"
ORDER  BY dc."year"
LIMIT 20;
```

