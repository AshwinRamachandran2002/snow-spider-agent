```sql
--Description:  Determine the five constructors who, from 2001 onward, most often supplied
--              the driver finishing a season with the fewest (but positive) points among
--              all point-scoring drivers.  Steps:  
--              1) Identify the final Grand Prix of every season (final_races).  
--              2) For each season, find the minimum positive points total in the final
--                 driver-standings (min_points).  
--              3) Select the driver(s) whose points equal that minimum (lowest_drivers).  
--              4) Retrieve the constructor each such driver represented in the final GP
--                 (driver_constructors).  
--              5) Count, per constructor, in how many seasons this occurred and return
--                 the five highest counts.
WITH final_races AS (                       -- last GP of each season ≥2001
    SELECT r.year,
           r.race_id
    FROM   races r
    JOIN  (SELECT year, MAX(round) AS max_round
           FROM   races
           WHERE  year >= 2001
           GROUP  BY year) t
      ON  t.year      = r.year
     AND  t.max_round = r.round
),
min_points AS (                             -- season minimum positive points
    SELECT fr.year,
           MIN(ds.points) AS min_pts
    FROM   final_races fr
    JOIN   driver_standings ds ON ds.race_id = fr.race_id
    WHERE  ds.points > 0
    GROUP  BY fr.year
),
lowest_drivers AS (                         -- drivers with that minimum
    SELECT fr.year,
           ds.driver_id,
           ds.points
    FROM   final_races   fr
    JOIN   driver_standings ds ON ds.race_id = fr.race_id
    JOIN   min_points    mp ON mp.year = fr.year
                           AND mp.min_pts = ds.points
),
driver_constructors AS (                    -- their constructor in that final GP
    SELECT ld.year,
           r.constructor_id
    FROM   lowest_drivers ld
    JOIN   final_races    fr ON fr.year = ld.year
    JOIN   results        r  ON r.race_id  = fr.race_id
                             AND r.driver_id = ld.driver_id
)
SELECT c.name                         AS constructor_name,
       COUNT(DISTINCT dc.year)        AS seasons_with_lowest_scorer
FROM   driver_constructors dc
JOIN   constructors        c ON c.constructor_id = dc.constructor_id
GROUP  BY c.name
ORDER  BY seasons_with_lowest_scorer DESC,
         c.name
LIMIT 5;
```
