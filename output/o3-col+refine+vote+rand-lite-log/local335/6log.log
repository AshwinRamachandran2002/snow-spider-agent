```sql
--Description:  From 2001 onward, determine for each season the point-scoring driver(s) who finished
--              the year with the lowest positive points total, identify the constructor they drove
--              for in that season’s final Grand Prix, then count how many different seasons each
--              constructor supplied such a “lowest-scorer”.  Return the five constructors with the
--              highest counts.
WITH final_races AS (                           -- last GP of every season ≥2001
    SELECT r."year",
           r."race_id"
    FROM   races r
    JOIN  (SELECT "year", MAX("round") AS max_round
           FROM   races
           WHERE  "year" >= 2001
           GROUP  BY "year") t
      ON  t."year"   = r."year"
     AND  t.max_round = r."round"
),
min_points AS (                                 -- minimum positive points in each season
    SELECT fr."year",
           MIN(ds."points") AS min_points
    FROM   final_races     fr
    JOIN   driver_standings ds ON ds."race_id" = fr."race_id"
    WHERE  ds."points" > 0
    GROUP  BY fr."year"
),
lowest_drivers AS (                             -- driver(s) owning that minimum
    SELECT fr."year",
           ds."driver_id",
           ds."points"
    FROM   final_races      fr
    JOIN   driver_standings ds ON ds."race_id" = fr."race_id"
    JOIN   min_points       mp ON mp."year"    = fr."year"
                              AND mp.min_points = ds."points"
),
driver_constructors AS (                        -- constructor in the final GP
    SELECT ld."year",
           r."constructor_id"
    FROM   lowest_drivers ld
    JOIN   final_races    fr ON fr."year" = ld."year"
    JOIN   results        r  ON r."race_id"  = fr."race_id"
                             AND r."driver_id" = ld."driver_id"
)
SELECT c."name"                                AS constructor_name,
       COUNT(DISTINCT dc."year")               AS seasons_with_lowest_scorer
FROM   driver_constructors dc
JOIN   constructors       c ON c."constructor_id" = dc."constructor_id"
GROUP  BY c."name"
ORDER  BY seasons_with_lowest_scorer DESC,
         c."name"
LIMIT 5;
```
