```sql
-- 6. Minimum positive points for every season (since 2001)
SELECT r."year",
       MIN(ds."points") AS "min_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
WHERE  r."year" >= 2001
  AND  ds."points" > 0
  AND  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = r."year")
GROUP  BY r."year"
ORDER  BY r."year"
LIMIT 20;
```

```sql
-- 7. Driver(s) who had those minimum points (first 20 seasons shown)
WITH min_pts AS (                           -- minimum positive points per season
  SELECT r."year"                       AS "season_year",
         MIN(ds."points")               AS "min_points"
  FROM   "driver_standings"  ds
  JOIN   "races"              r ON r."race_id" = ds."race_id"
  WHERE  r."year" >= 2001
    AND  ds."points" > 0
    AND  r."round" = (SELECT MAX("round")
                       FROM   "races"
                       WHERE  "year" = r."year")
  GROUP  BY r."year"
)
SELECT r."year",
       d."driver_id",
       drv."forename",
       drv."surname",
       ds."points"
FROM       min_pts          mp
JOIN       "races"          r  ON r."year" = mp."season_year"
                               AND r."round" = (SELECT MAX("round")
                                                 FROM   "races"
                                                 WHERE  "year" = r."year")
JOIN       "driver_standings" ds ON ds."race_id"  = r."race_id"
                                AND ds."points"   = mp."min_points"
JOIN       "drivers"         drv ON drv."driver_id" = ds."driver_id"
ORDER BY   r."year"
LIMIT 20;
```

```sql
-- 8. What constructor(s) did those drivers represent in that season?
SELECT dr."year",
       dr."driver_id",
       dr."constructor_id",
       c."name" AS "constructor_name"
FROM   "drives"        dr
JOIN  (SELECT DISTINCT "year", "driver_id"
       FROM   "drives"
       WHERE  "year" >= 2001)              base     ON base."year" = dr."year"
                                           AND base."driver_id" = dr."driver_id"
JOIN   "constructors"  c  ON c."constructor_id" = dr."constructor_id"
ORDER  BY dr."year" DESC
LIMIT 20;
```

```sql
-- 9. FINAL ANSWER: five constructors that most often had the season’s
--    lowest-scoring (yet point-scoring) driver, 2001-present
WITH final_races AS (                             -- id of last GP each year
  SELECT r."year", r."race_id"
  FROM   "races" AS r
  JOIN  (SELECT "year", MAX("round") AS "max_round"
         FROM   "races"
         WHERE  "year" >= 2001
         GROUP  BY "year") AS t
    ON  t."year" = r."year"
   AND  t."max_round" = r."round"
),
driver_points AS (                                -- points in final standings
  SELECT r."year"              AS "season_year",
         ds."driver_id",
         ds."points",
         ROW_NUMBER() OVER (PARTITION BY r."year"
                            ORDER BY ds."points") AS "rn"
  FROM   "driver_standings" ds
  JOIN   "races"            r ON r."race_id" = ds."race_id"
  WHERE  r."year"     >= 2001
    AND  ds."points"  > 0
    AND  ds."race_id" IN (SELECT "race_id" FROM final_races)
),
lowest_drivers AS (                               -- one row per season
  SELECT "season_year" AS "year",
         "driver_id"
  FROM   driver_points
  WHERE  "rn" = 1
)
SELECT c."name"                           AS "constructor_name",
       COUNT(*)                           AS "seasons_with_lowest_scorer"
FROM        lowest_drivers   ld
JOIN        "drives"        dr ON dr."year"      = ld."year"
                               AND dr."driver_id" = ld."driver_id"
JOIN        "constructors"  c  ON c."constructor_id" = dr."constructor_id"
GROUP  BY   c."name"
ORDER  BY   "seasons_with_lowest_scorer" DESC,
           c."name"
LIMIT 5;
```

```sql
-- 10. (Optional check) Display the year & driver for the five constructors above
WITH final_races AS (
  SELECT r."year", r."race_id"
  FROM   "races" r
  JOIN  (SELECT "year", MAX("round") AS "max_round"
         FROM   "races"
         WHERE  "year" >= 2001
         GROUP  BY "year") t
    ON  t."year" = r."year" AND t."max_round" = r."round"
),
driver_points AS (
  SELECT r."year" AS season_year,
         ds."driver_id",
         ds."points",
         ROW_NUMBER() OVER (PARTITION BY r."year" ORDER BY ds."points") AS rn
  FROM   "driver_standings" ds
  JOIN   "races"            r ON r."race_id" = ds."race_id"
  WHERE  r."year" >= 2001
    AND  ds."points" > 0
    AND  ds."race_id" IN (SELECT "race_id" FROM final_races)
),
lowest_drivers AS (
  SELECT season_year AS year, driver_id
  FROM   driver_points
  WHERE  rn = 1
),
drivers_ctors AS (
  SELECT ld.year,
         ld.driver_id,
         dr.constructor_id
  FROM   lowest_drivers ld
  JOIN   drives        dr ON dr.year = ld.year AND dr.driver_id = ld.driver_id
)
SELECT c.name           AS constructor_name,
       d.forename || ' ' || d.surname AS driver_name,
       dc.year
FROM   drivers_ctors dc
JOIN   drivers       d ON d.driver_id       = dc.driver_id
JOIN   constructors  c ON c.constructor_id  = dc.constructor_id
WHERE  c.name IN (                          -- the top-5 from previous query
       SELECT c.name
       FROM   constructors c
       JOIN   drivers_ctors dc2 ON dc2.constructor_id = c.constructor_id
       GROUP  BY c.name
       ORDER  BY COUNT(*) DESC
       LIMIT 5)
ORDER  BY c.name, dc.year
LIMIT 20;
```
