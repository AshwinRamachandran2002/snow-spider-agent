-- 5. Example (2009): lowest positive points among point-scoring drivers
SELECT r."year",
       MIN(ds."points") AS "min_points"
FROM   "driver_standings" AS ds
JOIN   "races"            AS r ON r."race_id" = ds."race_id"
WHERE  r."year"  = 2009
  AND  ds."points" > 0
  AND  r."round" = (SELECT MAX("round") FROM "races" WHERE "year" = 2009)
GROUP  BY r."year";
