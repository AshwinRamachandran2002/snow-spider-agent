       ld."points"
FROM   driver_constructors dc
JOIN   top_five           tf ON tf."constructor_id" = dc."constructor_id"
JOIN   constructors       c  ON c."constructor_id"  = dc."constructor_id"
JOIN   drivers            d  ON d."driver_id"       = dc."driver_id"
JOIN   lowest_drivers     ld ON ld."year" = dc."year"
                             AND ld."driver_id" = dc."driver_id"
ORDER  BY c."name", dc."year";
