       r."race_id",
       r."name"
FROM   "races" AS r
JOIN  (SELECT "year", MAX("round") AS "max_round"
       FROM   "races"
       WHERE  "year" >= 2001
       GROUP  BY "year") AS t
  ON  t."year"  = r."year"
 AND t."max_round" = r."round"
ORDER BY r."year"
LIMIT 20;
