--Description:
--condition_occurrence.condition_concept_id stores STANDARD concepts (mostly SNOMED),
--so raw ICD-10-CM concept_ids (e.g., those whose text code starts with L20/L40/L70/L80)
--will not appear there.  The query therefore:
-- 1) collects every ICD-10-CM dermatology concept beginning with the four root families;
-- 2) translates each of those ICD-10-CM concept_ids to its mapped STANDARD concept_id(s)
--    via concept_relationship where relationship_id = 'Maps to' (both directions, just in case);
-- 3) joins the resulting STANDARD concept set to condition_occurrence and returns a sample
--    of 20 participant–condition rows, including which dermatologic family (root_code) 
--    triggered the match.

WITH icd10_derm AS (   -- Step-1: all dermatologic ICD-10-CM concepts
  SELECT concept_id,
         CASE
           WHEN concept_code LIKE 'L20%' THEN 'L20'   -- Atopic dermatitis
           WHEN concept_code LIKE 'L40%' THEN 'L40'   -- Psoriasis
           WHEN concept_code LIKE 'L70%' THEN 'L70'   -- Acne
           WHEN concept_code LIKE 'L80%' THEN 'L80'   -- Vitiligo
         END AS root_code
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  (concept_code LIKE 'L20%' OR
          concept_code LIKE 'L40%' OR
          concept_code LIKE 'L70%' OR
          concept_code LIKE 'L80%')
),

std_targets AS (       -- Step-2: map to STANDARD concept_ids
  SELECT DISTINCT id.root_code,
                  cr.concept_id_2 AS standard_concept_id
  FROM   icd10_derm id
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_1 = id.concept_id
  WHERE  cr.relationship_id = 'Maps to'
  UNION
  SELECT DISTINCT id.root_code,
                  cr.concept_id_1 AS standard_concept_id
  FROM   icd10_derm id
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_relationship` cr
         ON cr.concept_id_2 = id.concept_id
  WHERE  cr.relationship_id = 'Maps to'
)

SELECT DISTINCT co.person_id,
       st.root_code,
       co.condition_concept_id AS standard_concept_id
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` AS co
