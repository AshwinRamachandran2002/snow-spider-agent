--Description: 3) Count how many ICD-10-CM dermatologic concepts exist for each family
--We no longer rely on concept_ancestor or the “standard” flag.  
--Instead we treat every ICD-10-CM code that starts with L20, L40, L70 or L80 as belonging
--to the atopic-dermatitis, psoriasis, acne or vitiligo families, respectively.
SELECT root_code,
       COUNT(*) AS n_icd10cm_concepts
FROM (
  SELECT CASE
           WHEN concept_code LIKE 'L20%' THEN 'L20'
           WHEN concept_code LIKE 'L40%' THEN 'L40'
           WHEN concept_code LIKE 'L70%' THEN 'L70'
           WHEN concept_code LIKE 'L80%' THEN 'L80'
         END AS root_code
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  (concept_code LIKE 'L20%' OR
          concept_code LIKE 'L40%' OR
          concept_code LIKE 'L70%' OR
          concept_code LIKE 'L80%')
)
GROUP BY root_code
LIMIT 20;
