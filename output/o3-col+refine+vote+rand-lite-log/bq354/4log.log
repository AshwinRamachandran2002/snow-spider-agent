```sql
-- 6.  Participant counts per dermatologic family  
WITH roots AS (
  SELECT concept_id, concept_code
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  concept_code IN ('L20','L40','L70','L80')
),
descendants AS (
  SELECT r.concept_code   AS root_code,
         a.descendant_concept_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` a
         ON r.concept_id = a.ancestor_concept_id
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` d
         ON a.descendant_concept_id = d.concept_id
  WHERE  d.standard_concept = 'S'
),
persons AS (
  SELECT  d.root_code,
          co.person_id
  FROM    descendants d
  JOIN    `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
          ON co.condition_concept_id = d.descendant_concept_id
)
SELECT  root_code,
        COUNT(DISTINCT person_id) AS n_persons
FROM    persons
GROUP BY root_code
LIMIT 20;
```

```sql
-- 7.  Bring the total participant count into the picture and compute percentages  
WITH total AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
),
roots AS (
  SELECT concept_id, concept_code
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  concept_code IN ('L20','L40','L70','L80')
),
descendants AS (
  SELECT r.concept_code   AS root_code,
         a.descendant_concept_id
  FROM   roots r
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept_ancestor` a
         ON r.concept_id = a.ancestor_concept_id
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.concept` d
         ON a.descendant_concept_id = d.concept_id
  WHERE  d.standard_concept = 'S'
),
persons AS (
  SELECT  d.root_code,
          co.person_id
  FROM    descendants d
  JOIN    `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
          ON co.condition_concept_id = d.descendant_concept_id
)
SELECT  p.root_code                                    AS icd10_root,
        COUNT(DISTINCT p.person_id)                    AS n_persons,
        t.total_participants,
        ROUND(100 * COUNT(DISTINCT p.person_id) /
                     t.total_participants, 2)          AS percentage_of_participants
FROM    persons p
CROSS JOIN total t
GROUP BY icd10_root, t.total_participants
ORDER BY icd10_root
LIMIT 20;
```

