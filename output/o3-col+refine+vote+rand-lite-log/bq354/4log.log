--Description: 7) Compute percentages of participants for each family relative to all participants
WITH total AS (
  SELECT COUNT(DISTINCT person_id) AS total_participants
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence`
),
derm_codes AS (
  SELECT concept_id,
         CASE
           WHEN concept_code LIKE 'L20%' THEN 'L20'
           WHEN concept_code LIKE 'L40%' THEN 'L40'
           WHEN concept_code LIKE 'L70%' THEN 'L70'
           WHEN concept_code LIKE 'L80%' THEN 'L80'
         END AS root_code
  FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
  WHERE  vocabulary_id = 'ICD10CM'
    AND  (concept_code LIKE 'L20%' OR
          concept_code LIKE 'L40%' OR
          concept_code LIKE 'L70%' OR
          concept_code LIKE 'L80%')
),
persons AS (
  SELECT dc.root_code,
         co.person_id
  FROM   derm_codes dc
  JOIN   `bigquery-public-data.cms_synthetic_patient_data_omop.condition_occurrence` co
         ON co.condition_concept_id = dc.concept_id
)
SELECT  p.root_code                               AS icd10_root,
        COUNT(DISTINCT p.person_id)               AS n_persons,
        t.total_participants,
        ROUND(100 * COUNT(DISTINCT p.person_id) /
                     t.total_participants, 2)     AS pct_participants
FROM    persons p
