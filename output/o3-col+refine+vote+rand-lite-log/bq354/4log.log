```sql
--Description:
--ICD-10-CM concepts are often not linked by concept_ancestor in OMOP; hence the previous query
--returned no rows.  Instead of relying on those hierarchical links, we can capture “descendants”
--simply by selecting every ICD-10-CM concept whose code starts with one of the four dermatologic
--root codes (L20 for atopic dermatitis, L40 for psoriasis, L70 for acne, L80 for vitiligo).  
--This query lists the first 20 such concepts, tagging each with its corresponding root family.
SELECT CASE
         WHEN concept_code LIKE 'L20%' THEN 'L20'        -- Atopic dermatitis family
         WHEN concept_code LIKE 'L40%' THEN 'L40'        -- Psoriasis family
         WHEN concept_code LIKE 'L70%' THEN 'L70'        -- Acne family
         WHEN concept_code LIKE 'L80%' THEN 'L80'        -- Vitiligo family
       END                     AS root_code,
       concept_code            AS icd10cm_code,
       concept_name
FROM   `bigquery-public-data.cms_synthetic_patient_data_omop.concept`
WHERE  vocabulary_id = 'ICD10CM'
  AND  (concept_code LIKE 'L20%' OR
        concept_code LIKE 'L40%' OR
        concept_code LIKE 'L70%' OR
        concept_code LIKE 'L80%')
LIMIT 20;
```
