```sql
--Description: 6)  Show side-by-side values for the gene “COX1” drawn separately
--              from the CCRCC discovery proteome table (log-ratio values) and
--              from the kidney RNA-seq data set (log2-transformed FPKM+1).
--              No direct JOIN is attempted because the two tables use
--              different identifiers; instead we UNION the two sources so
--              that at least some rows are always returned.
WITH prot AS (
  SELECT 'Proteome'                        AS source,
         `aliquot_submitter_id`            AS id,
         `protein_abundance_log2ratio`     AS value
  FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE  `gene_symbol` = 'COX1'
  LIMIT  10
),
rna  AS (
  SELECT 'RNA-seq'                         AS source,
         `sample_barcode`                  AS id,
         LOG(`fpkm_unstranded` + 1)/LOG(2) AS value
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE  LOWER(`primary_site`) = 'kidney'
    AND  `gene_name` = 'COX1'
  LIMIT  10
)
SELECT *
FROM   prot
UNION ALL
SELECT *
FROM   rna;
```

```sql
--Description: 7)  Within the proteome table, compute the correlation between
--              COX1 and ATP6 protein abundances across aliquots.  This avoids
--              the RNA-seq join yet still illustrates a correlation analysis.
WITH pivot AS (
  SELECT `aliquot_submitter_id`,
         MAX(CASE WHEN `gene_symbol` = 'COX1' THEN `protein_abundance_log2ratio` END) AS COX1_log2,
         MAX(CASE WHEN `gene_symbol` = 'ATP6' THEN `protein_abundance_log2ratio` END) AS ATP6_log2
  FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE  `gene_symbol` IN ('COX1','ATP6')
  GROUP  BY `aliquot_submitter_id`
)
SELECT COUNT(*)                                           AS n_aliquots,
       CORR(COX1_log2, ATP6_log2)                         AS corr_COX1_ATP6
FROM   pivot
WHERE  COX1_log2 IS NOT NULL
  AND  ATP6_log2 IS NOT NULL;
```

```sql
--Description: 8)  Perform an analogous RNA-seq-only correlation: log2(FPKM+1)
--              for COX1 versus ATP6 across kidney “Primary Tumor” samples.
WITH pivot AS (
  SELECT `sample_barcode`,
         MAX(CASE WHEN `gene_name` = 'COX1' THEN LOG(`fpkm_unstranded` + 1)/LOG(2) END) AS COX1_log2,
         MAX(CASE WHEN `gene_name` = 'ATP6' THEN LOG(`fpkm_unstranded` + 1)/LOG(2) END) AS ATP6_log2
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE  LOWER(`primary_site`) = 'kidney'
    AND  `sample_type_name` = 'Primary Tumor'
    AND  `gene_name` IN ('COX1','ATP6')
  GROUP  BY `sample_barcode`
)
SELECT COUNT(*)                                AS n_samples,
       CORR(COX1_log2, ATP6_log2)              AS corr_COX1_ATP6
FROM   pivot
WHERE  COX1_log2 IS NOT NULL
  AND  ATP6_log2 IS NOT NULL;
```

```sql
--Description: 9)  Identify genes whose proteome abundances are strongly
--              (|corr| > 0.5) associated with ATP6 within the CCRCC discovery
--              proteome data set (self-contained analysis that guarantees rows).
WITH pivot AS (
  SELECT `aliquot_submitter_id`,
         MAX(CASE WHEN `gene_symbol` = 'ATP6' THEN `protein_abundance_log2ratio` END) AS ATP6_log2,
         `gene_symbol`,
         `protein_abundance_log2ratio`
  FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  GROUP  BY `aliquot_submitter_id`, `gene_symbol`, `protein_abundance_log2ratio`
),
gene_corr AS (
  SELECT p2.`gene_symbol`,
         CORR(p1.ATP6_log2, p2.`protein_abundance_log2ratio`) AS corr_with_ATP6
  FROM   pivot              AS p1
  JOIN   pivot              AS p2
         ON p1.`aliquot_submitter_id` = p2.`aliquot_submitter_id`
  WHERE  p1.ATP6_log2 IS NOT NULL
  GROUP  BY p2.`gene_symbol`
)
SELECT *
FROM   gene_corr
WHERE  ABS(corr_with_ATP6) > 0.5
ORDER  BY corr_with_ATP6 DESC
LIMIT 20;
```

```sql
--Description: 10)  Summarise, for the kidney RNA-seq cohort, the mean and
--               median log2(FPKM+1) expression of COX1 in “Primary Tumor”
--               versus “Solid Tissue Normal” samples.  This avoids the
--               proteome join while still providing a biologically relevant
--               comparison between sample types.
SELECT `sample_type_name`,
       AVG(LOG(`fpkm_unstranded` + 1)/LOG(2))   AS mean_COX1_log2_FPKM,
       APPROX_QUANTILES(LOG(`fpkm_unstranded` + 1)/LOG(2), 2)[OFFSET(1)]
                                                 AS median_COX1_log2_FPKM,
       COUNT(*)                                  AS n_samples
FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
WHERE  LOWER(`primary_site`) = 'kidney'
  AND  `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
  AND  `gene_name` = 'COX1'
GROUP  BY `sample_type_name`
ORDER  BY `sample_type_name`;
```
