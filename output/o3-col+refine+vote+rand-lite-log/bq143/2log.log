/*---------------------------------------------------------------------------
  Clear-cell RCC: RNA-seq vs. Proteome correlations
  -------------------------------------------------
  • Kidney (“clear-cell RCC”) samples only
  • Sample types kept:  Primary Tumor  |  Solid Tissue Normal
  • Join RNA (log2[FPKM+1]) with Proteome (log2-ratio) on
        sample_barcode / aliquot_submitter_id  AND  gene_symbol
  • Keep genes with |Pearson r| > 0.5 and ≥3 paired observations
  • Report gene-level correlations plus per-sample-type averages
---------------------------------------------------------------------------*/
WITH rna AS (           -- RNA-seq
  SELECT
      sample_barcode                     AS sample_id,
      sample_type_name                   AS sample_type,
      UPPER(gene_name)                   AS gene_symbol,
      LOG(fpkm_unstranded + 1) / LOG(2)  AS rna_log2
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE LOWER(primary_site) = 'kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
    AND fpkm_unstranded IS NOT NULL
),
prot AS (           -- Proteome
  SELECT
      aliquot_submitter_id               AS sample_id,
      UPPER(gene_symbol)                 AS gene_symbol,
      protein_abundance_log2ratio        AS prot_log2
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE protein_abundance_log2ratio IS NOT NULL
),
joined AS (         -- Paired RNA + Protein values
  SELECT
      r.sample_type,
      r.gene_symbol,
      r.rna_log2,
      p.prot_log2
  FROM rna AS r
  JOIN prot AS p
    ON r.sample_id   = p.sample_id
   AND r.gene_symbol = p.gene_symbol
),
gene_corr AS (      -- Correlation per gene & sample type
  SELECT
      sample_type,
      gene_symbol,
      COUNT(*)                        AS n_pairs,
      CORR(rna_log2, prot_log2)       AS gene_corr
  FROM joined
  GROUP BY sample_type, gene_symbol
  HAVING n_pairs >= 3
),
strong_corr AS (    -- Keep strong correlations
  SELECT *
  FROM gene_corr
  WHERE ABS(gene_corr) > 0.5
)

SELECT
    sample_type,
    gene_symbol,
    ROUND(gene_corr, 4) AS correlation,
    ROUND(AVG(gene_corr) OVER (PARTITION BY sample_type), 4)
        AS avg_correlation_per_sample_type
FROM strong_corr
ORDER BY sample_type,
         ABS(correlation) DESC;
```
