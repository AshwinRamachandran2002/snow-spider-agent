```sql
-- 1)  Prepare RNA-seq: keep Clear Cell RCC (“Kidney”) samples that are either
--     ‘Primary Tumor’ or ‘Solid Tissue Normal’.  Express abundance as
--     log2(FPKM+1).
WITH rna AS (
  SELECT
      `sample_barcode`                         AS sample_id,
      `sample_type_name`                       AS sample_type,
      UPPER(`gene_name`)                       AS gene_symbol,
      LOG(`fpkm_unstranded` + 1) / LOG(2)      AS rna_log2
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE LOWER(`primary_site`) = 'kidney'
    AND `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
    AND `fpkm_unstranded` IS NOT NULL
),

-- 2)  Prepare proteome: keep aliquots from the CCRCC discovery data set.
prot AS (
  SELECT
      `aliquot_submitter_id`                   AS sample_id,
      UPPER(`gene_symbol`)                     AS gene_symbol,
      `protein_abundance_log2ratio`            AS prot_log2
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE `protein_abundance_log2ratio` IS NOT NULL
),

-- 3)  Inner-join on sample_id and gene_symbol so that only measurements that
--     exist in BOTH data sources are retained.
joined AS (
  SELECT
      r.sample_type,
      r.gene_symbol,
      r.rna_log2,
      p.prot_log2
  FROM rna AS r
  JOIN prot AS p
    ON r.sample_id   = p.sample_id
   AND r.gene_symbol = p.gene_symbol
),

-- 4)  For each gene within each sample_type, compute the Pearson correlation
--     between RNA and protein abundances.
gene_corr AS (
  SELECT
      sample_type,
      gene_symbol,
      COUNT(*)                                   AS n_pairs,
      CORR(rna_log2, prot_log2)                  AS gene_corr
  FROM joined
  GROUP BY sample_type, gene_symbol
  HAVING n_pairs >= 3                  -- require at least 3 paired values
),

-- 5)  Keep only “strong” correlations (|corr| > 0.5).
strong_corr AS (
  SELECT *
  FROM gene_corr
  WHERE ABS(gene_corr) > 0.5
)

-- 6)  Final results:
--     a)  List of genes with strong correlations, one row per gene & sample type
--     b)  Average correlation for each sample type across those genes
SELECT
    sample_type,
    gene_symbol,
    ROUND(gene_corr, 4) AS correlation
FROM strong_corr
ORDER BY sample_type, ABS(gene_corr) DESC;

-- To also show the overall mean of the strong correlations per sample type,
-- run the aggregation below (kept separate for clarity):
--
-- SELECT
--     sample_type,
--     ROUND(AVG(gene_corr), 4) AS avg_strong_correlation
-- FROM strong_corr
-- GROUP BY sample_type;
```
