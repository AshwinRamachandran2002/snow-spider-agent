--Description: 7)  Within the proteome table, compute the correlation between
--              COX1 and ATP6 protein abundances across aliquots.  This avoids
--              the RNA-seq join yet still illustrates a correlation analysis.
WITH pivot AS (
  SELECT `aliquot_submitter_id`,
         MAX(CASE WHEN `gene_symbol` = 'COX1' THEN `protein_abundance_log2ratio` END) AS COX1_log2,
         MAX(CASE WHEN `gene_symbol` = 'ATP6' THEN `protein_abundance_log2ratio` END) AS ATP6_log2
  FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE  `gene_symbol` IN ('COX1','ATP6')
  GROUP  BY `aliquot_submitter_id`
)
SELECT COUNT(*)                                           AS n_aliquots,
       CORR(COX1_log2, ATP6_log2)                         AS corr_COX1_ATP6
FROM   pivot
WHERE  COX1_log2 IS NOT NULL
  AND  ATP6_log2 IS NOT NULL
