  HAVING ABS(CORR( p.`protein_abundance_log2ratio`,
                   LOG(r.`fpkm_unstranded`+1)/LOG(2) )) > 0.5
)
SELECT `sample_type_name`,
       AVG(corr_rna_prot) AS avg_corr_significant
FROM   gene_corr
GROUP  BY `sample_type_name`
LIMIT 20;
