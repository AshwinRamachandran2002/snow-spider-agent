--              that at least some rows are always returned.
WITH prot AS (
  SELECT 'Proteome'                        AS source,
         `aliquot_submitter_id`            AS id,
         `protein_abundance_log2ratio`     AS value
  FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE  `gene_symbol` = 'COX1'
