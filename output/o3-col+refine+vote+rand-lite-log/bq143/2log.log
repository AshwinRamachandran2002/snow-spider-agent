```sql
--Description: 9)  Keep only those gene-level correlations whose absolute value
--                 exceeds 0.5
WITH gene_corr AS (
  SELECT r.`sample_type_name`,
         r.`gene_name` AS gene_symbol,
         CORR( p.`protein_abundance_log2ratio`,
               LOG(r.`fpkm_unstranded`+1)/LOG(2) ) AS corr_rna_prot
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                AS r
  JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
         ON r.`sample_barcode`   = p.`aliquot_submitter_id`
        AND r.`gene_name`        = p.`gene_symbol`
  WHERE  LOWER(r.`primary_site`) = 'kidney'
    AND  r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
  GROUP  BY r.`sample_type_name`, r.`gene_name`
