Query:
--Description: Return only those gene–sample-type pairs whose absolute correlation exceeds 0.5.
WITH joined AS (
  SELECT
      r.`sample_type_name`               AS sample_type,
      p.`gene_symbol`,
      p.`protein_abundance_log2ratio`    AS prot_log2ratio,
      LOG(r.`fpkm_unstranded` + 1, 2)    AS rna_log2_fpkm
  FROM (
        SELECT `gene_symbol`, `protein_abundance_log2ratio`,
               REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
        WHERE  `protein_abundance_log2ratio` IS NOT NULL
       ) AS p
  JOIN (
        SELECT `sample_type_name`, `gene_name`, `fpkm_unstranded`,
               REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
        WHERE  LOWER(`primary_site`) LIKE '%kidney%'
          AND  `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
          AND  `fpkm_unstranded` IS NOT NULL
       ) AS r
  ON  p.patient_code = r.patient_code
  AND p.`gene_symbol` = r.`gene_name`
)
SELECT *
FROM (
      SELECT sample_type,
             gene_symbol,
             CORR(prot_log2ratio, rna_log2_fpkm) AS prot_vs_rna_corr
      FROM   joined
      GROUP  BY sample_type, gene_symbol
     )
WHERE ABS(prot_vs_rna_corr) > 0.5
LIMIT 20
