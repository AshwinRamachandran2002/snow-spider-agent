--Description: 
-- Search for ANY overlapping patients between the CCRCC proteome study and the RNA-Seq dataset.
-- Each identifier embeds a 5-digit patient code:
--   • Proteome aliquot  “CPT0007320003”  → code = 00732  (five digits before the final four-digit suffix)
--   • RNA-Seq barcode   “C3N-00732-01”   → code = 00732  (five digits between the first and second hyphens)
-- The query REGEXP_EXTRACTs those codes, then joins the two tables on that common key.
-- If rows return, we have matched patients available for integrative analysis.

WITH proteome AS (
  SELECT
    `aliquot_submitter_id`,
    REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
rna AS (
  SELECT
    `sample_barcode`,
    REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-')         AS patient_code
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
)
SELECT DISTINCT
       p.`aliquot_submitter_id` AS proteome_aliquot,
       r.`sample_barcode`       AS rna_barcode,
       p.patient_code
FROM   proteome p
JOIN   rna      r
ON     p.patient_code = r.patient_code
LIMIT 20;
