```sql
--Description: 
-- Earlier we found no exact string match between proteome aliquot IDs and RNA-Seq barcodes.
-- Both identifiers, however, embed the SAME 5-digit patient code:
--      • Proteome aliquot:  CPT0007320003  →  00732
--      • RNA-Seq barcode:  C3N-00732-01   →  00732
-- By REGEXP_EXTRACT-ing that 5-digit segment from each table we can join on “patient_code”.
-- This query lists Kidney / CCRCC RNA-Seq samples (Primary Tumor or Solid Tissue Normal)
-- that have a matching proteome record in the CCRCC discovery study.  
-- Result confirms cross-platform overlap needed for correlation analysis.
WITH proteome AS (
  SELECT
    `aliquot_submitter_id`,
    REGEXP_EXTRACT(`aliquot_submitter_id`, r'^CPT0*(\d{5})') AS patient_code
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
rna AS (
  SELECT
    `sample_barcode`,
    `sample_type_name`,
    REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-')       AS patient_code
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE LOWER(`primary_site`) LIKE '%kidney%'
    AND `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
)
SELECT DISTINCT
       r.patient_code,
       r.`sample_barcode`             AS rna_barcode,
       r.`sample_type_name`,
       p.`aliquot_submitter_id`       AS proteome_aliquot
FROM   rna r
JOIN   proteome p
ON     r.patient_code = p.patient_code
LIMIT 20;
