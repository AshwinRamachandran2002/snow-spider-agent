```sql
-- 6.  Derive log2(FPKM+1) and keep rows that have BOTH measurements present
SELECT   p.`aliquot_submitter_id`             AS sample_id,
         r.`sample_type_name`                 AS sample_type,
         p.`gene_symbol`,
         p.`protein_abundance_log2ratio`      AS prot_log2ratio,
         LOG(r.`fpkm_unstranded` + 1 , 2)     AS rna_log2_fpkm
FROM     `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
JOIN     `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                AS r
ON       p.`aliquot_submitter_id` = r.`sample_barcode`
WHERE    LOWER(r.`primary_site`) LIKE '%kidney%'
  AND    r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
  AND    p.`protein_abundance_log2ratio` IS NOT NULL
  AND    r.`fpkm_unstranded`              IS NOT NULL
LIMIT 20;
```

```sql
-- 7.  Compute per-gene / per-sample-type Pearson correlations
SELECT   sample_type,
         gene_symbol,
         CORR(prot_log2ratio , rna_log2_fpkm) AS prot_vs_rna_corr
FROM   (
        SELECT   r.`sample_type_name`                 AS sample_type,
                 p.`gene_symbol`,
                 p.`protein_abundance_log2ratio`      AS prot_log2ratio,
                 LOG(r.`fpkm_unstranded` + 1 , 2)     AS rna_log2_fpkm
        FROM     `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
        JOIN     `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                AS r
        ON       p.`aliquot_submitter_id` = r.`sample_barcode`
        WHERE    LOWER(r.`primary_site`) LIKE '%kidney%'
          AND    r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
          AND    p.`protein_abundance_log2ratio` IS NOT NULL
          AND    r.`fpkm_unstranded`              IS NOT NULL
      )
GROUP BY sample_type, gene_symbol
LIMIT 20;
```

```sql
-- 8.  Keep only strong correlations (|r| > 0.5)
SELECT *
FROM (
      SELECT   sample_type,
               gene_symbol,
               CORR(prot_log2ratio , rna_log2_fpkm) AS prot_vs_rna_corr
      FROM   (
              SELECT   r.`sample_type_name`                 AS sample_type,
                       p.`gene_symbol`,
                       p.`protein_abundance_log2ratio`      AS prot_log2ratio,
                       LOG(r.`fpkm_unstranded` + 1 , 2)     AS rna_log2_fpkm
              FROM     `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
              JOIN     `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                AS r
              ON       p.`aliquot_submitter_id` = r.`sample_barcode`
              WHERE    LOWER(r.`primary_site`) LIKE '%kidney%'
                AND    r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
                AND    p.`protein_abundance_log2ratio` IS NOT NULL
                AND    r.`fpkm_unstranded`              IS NOT NULL
           )
      GROUP BY sample_type, gene_symbol
     )
WHERE ABS(prot_vs_rna_corr) > 0.5
LIMIT 20;
```

```sql
-- 9.  Compute the average (mean) correlation for each sample type among the strong gene-level correlations
SELECT   sample_type,
         AVG(prot_vs_rna_corr) AS avg_corr_strong_genes
FROM   (
        SELECT   sample_type,
                 gene_symbol,
                 CORR(prot_log2ratio , rna_log2_fpkm) AS prot_vs_rna_corr
        FROM   (
                SELECT   r.`sample_type_name`                 AS sample_type,
                         p.`gene_symbol`,
                         p.`protein_abundance_log2ratio`      AS prot_log2ratio,
                         LOG(r.`fpkm_unstranded` + 1 , 2)     AS rna_log2_fpkm
                FROM     `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
                JOIN     `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                AS r
                ON       p.`aliquot_submitter_id` = r.`sample_barcode`
                WHERE    LOWER(r.`primary_site`) LIKE '%kidney%'
                  AND    r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
                  AND    p.`protein_abundance_log2ratio` IS NOT NULL
                  AND    r.`fpkm_unstranded`              IS NOT NULL
             )
        GROUP BY sample_type, gene_symbol
        HAVING  ABS(CORR(prot_log2ratio , rna_log2_fpkm)) > 0.5
      )
GROUP BY sample_type;
```

