```sql
--Description: Preview a handful of paired Protein–RNA measurements for matched CCRCC patients. 
--Extract the 5-digit patient code from each identifier, join on that plus the gene symbol/name, 
--and show sample type, gene, proteome log2-ratio, and RNA FPKM.
WITH proteome AS (
  SELECT
      `aliquot_submitter_id`,
      `gene_symbol`,
      `protein_abundance_log2ratio`,
      REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
  FROM  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
rna AS (
  SELECT
      `sample_barcode`,
      `sample_type_name`,
      `gene_name`,
      `fpkm_unstranded`,
      REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-')         AS patient_code
  FROM  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE LOWER(`primary_site`) LIKE '%kidney%'
    AND `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
)
SELECT
    p.`aliquot_submitter_id`       AS sample_id,
    r.`sample_type_name`           AS sample_type,
    p.`gene_symbol`,
    p.`protein_abundance_log2ratio` AS prot_log2ratio,
    r.`fpkm_unstranded`            AS rna_fpkm
FROM proteome p
JOIN rna      r
  ON p.patient_code = r.patient_code
 AND p.`gene_symbol` = r.`gene_name`
LIMIT 20;
```

```sql
--Description: Same join as above, but compute log2(FPKM+1) and keep rows with both values present.
WITH proteome AS (
  SELECT
      `gene_symbol`,
      `protein_abundance_log2ratio`,
      REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
  FROM  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE `protein_abundance_log2ratio` IS NOT NULL
),
rna AS (
  SELECT
      `sample_type_name`,
      `gene_name`,
      `fpkm_unstranded`,
      REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-')         AS patient_code
  FROM  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE LOWER(`primary_site`) LIKE '%kidney%'
    AND `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
    AND `fpkm_unstranded` IS NOT NULL
)
SELECT
    r.`sample_type_name`                 AS sample_type,
    p.`gene_symbol`,
    p.`protein_abundance_log2ratio`      AS prot_log2ratio,
    LOG(r.`fpkm_unstranded` + 1, 2)      AS rna_log2_fpkm
FROM proteome p
JOIN rna      r
  ON p.patient_code = r.patient_code
 AND p.`gene_symbol` = r.`gene_name`
LIMIT 20;
```

```sql
--Description: Compute Pearson correlation between protein abundance and RNA expression for each gene & sample type.
WITH joined AS (
  SELECT
      r.`sample_type_name`               AS sample_type,
      p.`gene_symbol`,
      p.`protein_abundance_log2ratio`    AS prot_log2ratio,
      LOG(r.`fpkm_unstranded` + 1, 2)    AS rna_log2_fpkm
  FROM (
        SELECT `aliquot_submitter_id`, `gene_symbol`, `protein_abundance_log2ratio`,
               REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
        WHERE  `protein_abundance_log2ratio` IS NOT NULL
       ) AS p
  JOIN (
        SELECT `sample_barcode`, `sample_type_name`, `gene_name`, `fpkm_unstranded`,
               REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
        WHERE  LOWER(`primary_site`) LIKE '%kidney%'
          AND  `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
          AND  `fpkm_unstranded` IS NOT NULL
       ) AS r
  ON  p.patient_code = r.patient_code
  AND p.`gene_symbol` = r.`gene_name`
)
SELECT
    sample_type,
    gene_symbol,
    CORR(prot_log2ratio, rna_log2_fpkm) AS prot_vs_rna_corr
FROM joined
GROUP BY sample_type, gene_symbol
LIMIT 20;
```

```sql
--Description: Return only those gene–sample-type pairs whose absolute correlation exceeds 0.5.
WITH joined AS (
  SELECT
      r.`sample_type_name`               AS sample_type,
      p.`gene_symbol`,
      p.`protein_abundance_log2ratio`    AS prot_log2ratio,
      LOG(r.`fpkm_unstranded` + 1, 2)    AS rna_log2_fpkm
  FROM (
        SELECT `gene_symbol`, `protein_abundance_log2ratio`,
               REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
        WHERE  `protein_abundance_log2ratio` IS NOT NULL
       ) AS p
  JOIN (
        SELECT `sample_type_name`, `gene_name`, `fpkm_unstranded`,
               REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
        WHERE  LOWER(`primary_site`) LIKE '%kidney%'
          AND  `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
          AND  `fpkm_unstranded` IS NOT NULL
       ) AS r
  ON  p.patient_code = r.patient_code
  AND p.`gene_symbol` = r.`gene_name`
)
SELECT *
FROM (
      SELECT sample_type,
             gene_symbol,
             CORR(prot_log2ratio, rna_log2_fpkm) AS prot_vs_rna_corr
      FROM   joined
      GROUP  BY sample_type, gene_symbol
     )
WHERE ABS(prot_vs_rna_corr) > 0.5
LIMIT 20;
```

```sql
--Description: Average the strong (|r| > 0.5) protein-RNA correlations for each sample type.
WITH joined AS (
  SELECT
      r.`sample_type_name`               AS sample_type,
      p.`gene_symbol`,
      p.`protein_abundance_log2ratio`    AS prot_log2ratio,
      LOG(r.`fpkm_unstranded` + 1, 2)    AS rna_log2_fpkm
  FROM (
        SELECT `gene_symbol`, `protein_abundance_log2ratio`,
               REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
        WHERE  `protein_abundance_log2ratio` IS NOT NULL
       ) AS p
  JOIN (
        SELECT `sample_type_name`, `gene_name`, `fpkm_unstranded`,
               REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
        WHERE  LOWER(`primary_site`) LIKE '%kidney%'
          AND  `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
          AND  `fpkm_unstranded` IS NOT NULL
       ) AS r
  ON  p.patient_code = r.patient_code
  AND p.`gene_symbol` = r.`gene_name`
),
gene_corr AS (
  SELECT
      sample_type,
      gene_symbol,
      CORR(prot_log2ratio, rna_log2_fpkm) AS r_val
  FROM   joined
  GROUP  BY sample_type, gene_symbol
  HAVING ABS(r_val) > 0.5
)
SELECT
    sample_type,
    AVG(r_val) AS avg_corr_strong_genes
FROM gene_corr
GROUP BY sample_type;
```

```sql
--Description: Final summary – for each sample type, count genes with |r| > 0.5 and report the mean correlation.
WITH joined AS (
  SELECT
      r.`sample_type_name`               AS sample_type,
      p.`gene_symbol`,
      p.`protein_abundance_log2ratio`    AS prot_log2ratio,
      LOG(r.`fpkm_unstranded` + 1, 2)    AS rna_log2_fpkm
  FROM (
        SELECT `gene_symbol`, `protein_abundance_log2ratio`,
               REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
        WHERE  `protein_abundance_log2ratio` IS NOT NULL
       ) AS p
  JOIN (
        SELECT `sample_type_name`, `gene_name`, `fpkm_unstranded`,
               REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-') AS patient_code
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
        WHERE  LOWER(`primary_site`) LIKE '%kidney%'
          AND  `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
          AND  `fpkm_unstranded` IS NOT NULL
       ) AS r
  ON  p.patient_code = r.patient_code
  AND p.`gene_symbol` = r.`gene_name`
),
gene_corr AS (
  SELECT
      sample_type,
      gene_symbol,
      CORR(prot_log2ratio, rna_log2_fpkm) AS r_val
  FROM   joined
  GROUP  BY sample_type, gene_symbol
  HAVING ABS(r_val) > 0.5
)
SELECT
    sample_type,
    COUNT(*)  AS n_strong_genes,
    AVG(r_val) AS avg_corr_strong_genes
FROM gene_corr
GROUP BY sample_type;
