Query:
--Description: Preview a handful of paired Protein–RNA measurements for matched CCRCC patients. 
--Extract the 5-digit patient code from each identifier, join on that plus the gene symbol/name, 
--and show sample type, gene, proteome log2-ratio, and RNA FPKM.
WITH proteome AS (
  SELECT
      `aliquot_submitter_id`,
      `gene_symbol`,
      `protein_abundance_log2ratio`,
      REGEXP_EXTRACT(`aliquot_submitter_id`, r'(\d{5})\d{4}$') AS patient_code
  FROM  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
rna AS (
  SELECT
      `sample_barcode`,
      `sample_type_name`,
      `gene_name`,
      `fpkm_unstranded`,
      REGEXP_EXTRACT(`sample_barcode`, r'-0?(\d{5})-')         AS patient_code
  FROM  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE LOWER(`primary_site`) LIKE '%kidney%'
    AND `sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
)
SELECT
    p.`aliquot_submitter_id`       AS sample_id,
    r.`sample_type_name`           AS sample_type,
    p.`gene_symbol`,
    p.`protein_abundance_log2ratio` AS prot_log2ratio,
    r.`fpkm_unstranded`            AS rna_fpkm
FROM proteome p
JOIN rna      r
  ON p.patient_code = r.patient_code
 AND p.`gene_symbol` = r.`gene_name`
LIMIT 20
Answer:
sample_id,sample_type,gene_symbol,prot_log2ratio,rna_fpkm
