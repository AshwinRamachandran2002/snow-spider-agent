```

```sql
--Description: 5)  Examine the unique aliquot-submitter identifiers that appear in
--   the CCRCC discovery study PROTEOME table (these will eventually be mapped
--   to sample-barcode identifiers coming from GDC RNA-Seq).
SELECT DISTINCT
  `aliquot_submitter_id`
FROM
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
LIMIT 20;
```

```sql
--Description: 6)  Look at a few protein log2-ratios for the mitochondrial gene
--   COX1 in the CCRCC discovery proteome study – confirms that values we plan
--   to correlate are present.
SELECT
  `aliquot_submitter_id`,
  `gene_symbol`,
  ROUND(`protein_abundance_log2ratio`, 4) AS prot_log2ratio
FROM
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
WHERE
  `gene_symbol` = 'COX1'
LIMIT 20;
```

```sql
--Description: 7)  Attempt to attach a sample-type label to proteome aliquots by
--   joining with the PDC aliquot-to-case mapping table (not every aliquot is
--   present, but this reveals the structure of any available mapping).
SELECT
  p.`aliquot_submitter_id`,
  m.`sample_type`
FROM
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
LEFT JOIN
  `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` AS m
ON
  p.`aliquot_submitter_id` = m.`sample_submitter_id`
LIMIT 20;
```

```sql
--Description: 8)  Check whether any aliquot identifiers in the proteomics table
--   ALSO appear directly as sample_barcodes in the RNA-Seq table.  If present,
--   these rows would allow a one-to-one join without an external mapping file.
SELECT
  p.`aliquot_submitter_id`,
  r.`sample_barcode`
FROM
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
INNER JOIN
  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                AS r
ON
  p.`aliquot_submitter_id` = r.`sample_barcode`
LIMIT 20;
```

```sql
--Description: 9)  Build a “joined” analytical table by pairing RNA-Seq and
--   proteome measurements that share BOTH (i) the same gene symbol and
--   (ii) a common sample_barcode / aliquot ID (as discovered in query 8).
--   For each entry we create log-transformed RNA expression (log2(FPKM+1)).
SELECT
  r.`sample_barcode`,
  r.`sample_type_name`,
  r.`gene_name`                                        AS gene_symbol,
  LOG2(r.`fpkm_unstranded` + 1)                        AS log2_fpkm,
  p.`protein_abundance_log2ratio`                      AS prot_log2ratio
FROM
  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`           AS r
JOIN
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
ON
  r.`sample_barcode`      =  p.`aliquot_submitter_id`   -- overlap found in #8
  AND r.`gene_name`       =  p.`gene_symbol`
WHERE
  LOWER(r.`primary_site`) = 'kidney'
  AND r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: 10)  Using the (small) set of overlapping samples found above,
--   calculate gene-by-gene Spearman/Pearson correlations and retain only those
--   with |corr| > 0.5;  finally compute the average correlation for each sample
--   type (Primary Tumor vs Normal).
SELECT
  joined.`sample_type_name`,
  AVG(corr_val) AS avg_corr
FROM (
  SELECT
    `sample_type_name`,
    `gene_symbol`,
    CORR(`log2_fpkm`, `prot_log2ratio`) AS corr_val
  FROM (
    -- re-use the join in query 9 without the LIMIT
    SELECT
      r.`sample_barcode`,
      r.`sample_type_name`,
      r.`gene_name`                      AS gene_symbol,
      LOG2(r.`fpkm_unstranded` + 1)      AS log2_fpkm,
      p.`protein_abundance_log2ratio`     AS prot_log2ratio
    FROM
      `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`   AS r
    JOIN
      `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
    ON
      r.`sample_barcode` = p.`aliquot_submitter_id`
      AND r.`gene_name`  = p.`gene_symbol`
    WHERE
      LOWER(r.`primary_site`) = 'kidney'
      AND r.`sample_type_name` IN ('Primary Tumor','Solid Tissue Normal')
  )
  GROUP BY
    `sample_type_name`, `gene_symbol`
  HAVING
    ABS(CORR(`log2_fpkm`,`prot_log2ratio`)) > 0.5
) AS joined
GROUP BY
  joined.`sample_type_name`
LIMIT 20;
```

These ten queries walk from simple data exploration (queries 1-6), through
identifier / sample-type mapping checks (queries 7-8), to construction of a
joined analytical table (query 9) and finally to the requested correlation
calculation and summarisation (query 10).
