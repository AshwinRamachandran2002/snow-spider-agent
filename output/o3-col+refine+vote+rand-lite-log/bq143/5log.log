```sql
--Description:
-- Our earlier inner-join between proteomics aliquot IDs and RNA-Seq sample
-- barcodes yielded zero matches.  That suggests most proteomics IDs use the
-- “CPT…” format, while RNA-Seq barcodes use TCGA-style strings such as
-- “C3L-00608-01”.  To confirm whether *any* proteomics aliquots are labeled
-- with TCGA-style IDs (those typically start with “C3…”) we list every
-- distinct proteomics aliquot_submitter_id that begins with “C3”.  If this
-- returns an empty set we know a direct join is impossible and an external
-- mapping is required.
SELECT DISTINCT
  `aliquot_submitter_id`
FROM
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
WHERE
  `aliquot_submitter_id` LIKE 'C3%'
LIMIT 20;
