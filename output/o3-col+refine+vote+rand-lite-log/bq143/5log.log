```sql
--Description:  
-- Count how many identifier strings are shared between the CCRCC proteomics
-- aliquot IDs and the RNA-Seq sample barcodes.  
-- • Step-1: collect the distinct proteomics aliquot IDs.  
-- • Step-2: collect the distinct RNA-Seq sample barcodes.  
-- • Step-3: use INTERSECT to keep only IDs present in both sets, then count them.  
-- If the resulting count is 0, there is no direct overlap and we must rely on an
-- external mapping file to relate the two datasets.
WITH proteome_ids AS (
  SELECT DISTINCT `aliquot_submitter_id` AS id
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE `aliquot_submitter_id` IS NOT NULL
),
rna_ids AS (
  SELECT DISTINCT `sample_barcode` AS id
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE `sample_barcode` IS NOT NULL
)
SELECT COUNT(*) AS shared_id_count
FROM (
  SELECT id FROM proteome_ids
  INTERSECT DISTINCT
  SELECT id FROM rna_ids
);
