```sql
/* Correlate gene–level protein abundance (log2-ratio) with log2(FPKM+1) RNA-Seq
   for Clear-Cell Renal Cell Carcinoma (ccRCC) “Primary Tumor” vs “Solid Tissue Normal”.
   -------------------------------------------------------------------------------
   1)  Map proteome aliquots to GDC sample barcodes through the PDC↔GDC
       biospecimen bridge table.
   2)  Keep only Kidney samples that are either Primary Tumor or Solid Tissue Normal.
   3)  Join on (sample_barcode, gene_symbol) to obtain matched proteome/RNA pairs.
   4)  For every (sample_type, gene) compute Pearson correlation across samples,
       require |r| > 0.5, then average the remaining correlations per sample_type.
*/
WITH gdc_pdc_map AS (          -- 1)  Aliquot→sample barcode bridge
  SELECT DISTINCT
    aliquot_submitter_id,
    sample_barcode
  FROM
    `isb-cgc-bq.PDC_metadata.gdc_to_pdc_biospecimen_mapping_current`
  WHERE sample_barcode IS NOT NULL
),

kidney_rna AS (                -- 2a)  Kidney RNA-Seq (tumour & normal)
  SELECT
    sample_barcode,
    LOWER(sample_type_name)          AS sample_type,      -- “primary tumor”, “solid tissue normal”
    gene_name                        AS gene_symbol,
    LOG(fpkm_unstranded + 1) / LOG(2) AS log2_fpkm        -- log2(FPKM+1)
  FROM
    `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE
        LOWER(primary_site)   = 'kidney'
    AND LOWER(sample_type_name) IN ('primary tumor','solid tissue normal')
),

ccrcc_proteome AS (            -- 2b)  Kidney proteome values with mapped barcodes
  SELECT
    m.sample_barcode,
    LOWER(r.sample_type_name)  AS sample_type,            -- inherit sample-type from RNA table
    p.gene_symbol,
    p.protein_abundance_log2ratio  AS prot_log2ratio
  FROM
    `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
  JOIN
    gdc_pdc_map               m ON m.aliquot_submitter_id = p.aliquot_submitter_id
  JOIN (
        SELECT DISTINCT sample_barcode, sample_type_name
        FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
        WHERE  LOWER(primary_site)   = 'kidney'
           AND LOWER(sample_type_name) IN ('primary tumor','solid tissue normal')
  )                            r ON r.sample_barcode     = m.sample_barcode
),

joined_pairs AS (              -- 3)  Matched RNA / Proteome values
  SELECT
    p.sample_type,
    p.gene_symbol,
    p.sample_barcode,
    p.prot_log2ratio,
    r.log2_fpkm
  FROM
    ccrcc_proteome p
  JOIN
    kidney_rna    r USING (sample_barcode, gene_symbol, sample_type)
  WHERE
        p.prot_log2ratio IS NOT NULL
    AND r.log2_fpkm       IS NOT NULL
),

corr_per_gene AS (             -- 4)  Correlation for each gene within each sample-type
  SELECT
    sample_type,
    gene_symbol,
    CORR(prot_log2ratio, log2_fpkm) AS gene_corr
  FROM joined_pairs
  GROUP BY sample_type, gene_symbol
  HAVING ABS(gene_corr) > 0.5       -- keep only strong correlations
)

SELECT
  INITCAP(sample_type)                    AS sample_type_name,
  AVG(gene_corr)                          AS avg_correlation
FROM corr_per_gene
WHERE gene_corr IS NOT NULL               -- safeguard
GROUP BY sample_type
ORDER BY sample_type_name;
```
