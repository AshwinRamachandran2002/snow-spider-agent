```sql
--Description: 9)  Build a “joined” analytical table by pairing RNA-Seq and
--   proteome measurements that share BOTH (i) the same gene symbol and
--   (ii) a common identifier string (sample_barcode = aliquot_submitter_id).
--   We replace the non-existent LOG2() with LOG(x , 2) which BigQuery supports.
SELECT
  r.`sample_barcode`,
  r.`sample_type_name`,
  r.`gene_name`                                    AS gene_symbol,
  LOG(r.`fpkm_unstranded` + 1, 2)                  AS log2_fpkm,
  p.`protein_abundance_log2ratio`                  AS prot_log2ratio
FROM
  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`  AS r
JOIN
  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
ON
  r.`sample_barcode` = p.`aliquot_submitter_id`
  AND r.`gene_name`  = p.`gene_symbol`
WHERE
  LOWER(r.`primary_site`) = 'kidney'
  AND r.`sample_type_name` IN ('Primary Tumor', 'Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: 10)  From the joined table created above, compute gene-wise
--   Pearson correlations between log2-FPKM (RNA) and protein log2 ratios.
--   Keep only correlations with |corr| > 0.5 and then report the average
--   correlation for each sample type (“Primary Tumor” vs “Solid Tissue Normal”).
WITH joined AS (
  SELECT
    r.`sample_barcode`,
    r.`sample_type_name`,
    r.`gene_name`                   AS gene_symbol,
    LOG(r.`fpkm_unstranded` + 1, 2) AS log2_fpkm,
    p.`protein_abundance_log2ratio` AS prot_log2ratio
  FROM
    `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`  AS r
  JOIN
    `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  ON
    r.`sample_barcode` = p.`aliquot_submitter_id`
    AND r.`gene_name`  = p.`gene_symbol`
  WHERE
    LOWER(r.`primary_site`) = 'kidney'
    AND r.`sample_type_name` IN ('Primary Tumor', 'Solid Tissue Normal')
)
, gene_corr AS (
  SELECT
    sample_type_name,
    gene_symbol,
    CORR(log2_fpkm, prot_log2ratio) AS corr_val
  FROM joined
  GROUP BY sample_type_name, gene_symbol
  HAVING ABS(corr_val) > 0.5
)
SELECT
  sample_type_name,
  AVG(corr_val) AS avg_correlation
FROM gene_corr
GROUP BY sample_type_name
LIMIT 20;
```
