```sql
--Description:  
--  We cannot join RNA-seq and proteomics at the individual-sample level (0 shared IDs).
--  Instead, evaluate the *gene-level* association between modalities:
--    1)  Summarise Kidney RNA-seq data:  average log2(FPKM+1) for each gene
--        separately in “Primary Tumor” and “Solid Tissue Normal”.
--    2)  Summarise CCRCC discovery proteomics:  average protein log2-ratio
--        for each gene across all aliquots.
--    3)  Join the two summaries on gene_symbol.
--    4)  For each sample-type group compute the Pearson correlation across
--        genes between RNA and protein averages; keep only |corr| > 0.5.
WITH rna_summary AS (
  SELECT
    gene_name                         AS gene_symbol,
    sample_type_name,
    AVG( LOG(fpkm_unstranded + 1, 2) ) AS avg_log2_fpkm
  FROM
    `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE
    LOWER(primary_site) = 'kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
  GROUP BY
    gene_symbol, sample_type_name
),
prot_summary AS (
  SELECT
    gene_symbol,
    AVG(protein_abundance_log2ratio) AS avg_prot_log2ratio
  FROM
    `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  GROUP BY
    gene_symbol
),
joined AS (
  SELECT
    r.sample_type_name,
    r.gene_symbol,
    r.avg_log2_fpkm,
    p.avg_prot_log2ratio
  FROM
    rna_summary AS r
  JOIN
    prot_summary AS p
  USING (gene_symbol)
)
SELECT
  sample_type_name,
  CORR(avg_log2_fpkm, avg_prot_log2ratio) AS gene_corr
FROM
  joined
GROUP BY
  sample_type_name
HAVING
  ABS(gene_corr) > 0.5
LIMIT 20;
```
