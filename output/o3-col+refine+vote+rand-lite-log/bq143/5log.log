--Description:  
-- Corrected version of “SQL 10”.  Because no RNA-Seq sample_barcodes match
-- proteomics aliquot IDs, we operate at the GENE level instead of the per-sample
-- level:  
--   1)  RNA-Seq (Kidney):  for each gene, compute the average log2(FPKM+1)
--       separately in “Primary Tumor” and “Solid Tissue Normal” samples.  
--   2)  Proteomics (CCRCC discovery): compute the average protein log2-ratio for
--       each gene across all aliquots.  
--   3)  Join the two summaries on gene_symbol.  
--   4)  For each sample-type group, compute the Pearson correlation across genes
--       between RNA and protein averages; retain only correlations whose
--       absolute value exceeds 0.5, then report the average of those retained
--       correlations for each sample type.
WITH rna_summary AS (
  SELECT
    gene_name                         AS gene_symbol,
    sample_type_name,
    AVG( LOG(fpkm_unstranded + 1, 2) ) AS avg_log2_fpkm
  FROM
    `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE
    LOWER(primary_site) = 'kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
  GROUP BY
    gene_symbol, sample_type_name
),
prot_summary AS (
  SELECT
    gene_symbol,
    AVG(protein_abundance_log2ratio) AS avg_prot_log2ratio
  FROM
    `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  GROUP BY
    gene_symbol
),
joined AS (
  SELECT
    r.sample_type_name,
    r.gene_symbol,
    r.avg_log2_fpkm,
    p.avg_prot_log2ratio
  FROM
    rna_summary AS r
  JOIN
    prot_summary AS p
  USING (gene_symbol)
),
gene_corr AS (
  SELECT
    sample_type_name,
    -- correlation across genes (one value per sample_type)
    CORR(avg_log2_fpkm, avg_prot_log2ratio) AS corr_val
  FROM
    joined
  GROUP BY
    sample_type_name
)
SELECT
  sample_type_name,
  corr_val AS average_correlation
FROM
  gene_corr
WHERE
  ABS(corr_val) > 0.5;
