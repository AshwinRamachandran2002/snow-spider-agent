```sql
--Description:  
-- Compute the transcript-versus-protein association for Clear-Cell Renal Cell
-- Carcinoma (Kidney) without relying on matching sample identifiers (which do
-- not overlap across the two platforms).  The analysis proceeds in three
-- stages:
--   1)  RNA-Seq → for each gene calculate the mean log2(FPKM+1) within
--       “Primary Tumor” and “Solid Tissue Normal” samples.              (CTE rna)
--   2)  Proteome → for each gene calculate the mean protein log2-ratio
--       across all aliquots in the CCRCC discovery study.              (CTE prot)
--   3)  Join the summaries on gene_symbol and, for each sample type, compute
--       a single Pearson correlation coefficient across genes between the two
--       averaged modalities.  This yields one correlation value per sample
--       class, showing how strongly mRNA abundance tracks with protein
--       abundance overall.
WITH rna AS (
  SELECT
    gene_name                           AS gene_symbol,
    sample_type_name,
    AVG( LOG(fpkm_unstranded + 1, 2) )  AS avg_log2_fpkm
  FROM
    `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE
    LOWER(primary_site) = 'kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
  GROUP BY
    gene_symbol, sample_type_name
),
prot AS (
  SELECT
    gene_symbol,
    AVG(protein_abundance_log2ratio)    AS avg_prot_log2ratio
  FROM
    `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  GROUP BY
    gene_symbol
),
joined AS (
  SELECT
    r.sample_type_name,
    r.gene_symbol,
    r.avg_log2_fpkm,
    p.avg_prot_log2ratio
  FROM
    rna  AS r
  JOIN
    prot AS p
  USING (gene_symbol)
)
SELECT
  sample_type_name,
  CORR(avg_log2_fpkm, avg_prot_log2ratio) AS transcript_protein_correlation
FROM
  joined
GROUP BY
  sample_type_name;
