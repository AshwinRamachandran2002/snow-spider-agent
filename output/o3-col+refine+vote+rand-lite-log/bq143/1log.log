--Description:  Check whether the mean protein values (avg_prot) calculated for
--              genes in the CCRCC proteome actually vary.  If all non-NULL
--              genes share the same avg_prot value (or if fewer than two genes
--              remain after removing NULL / NaN), STDDEV_SAMP() and CORR() both
--              return NULL—explaining the earlier NULL correlations.  The query
--              counts genes, removes NaN, and reports the number of distinct
--              avg_prot values plus their standard deviation.
WITH prot AS (
  SELECT
    gene_symbol,
    AVG(protein_abundance_log2ratio) AS avg_prot             -- mean protein log2-ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  GROUP BY gene_symbol
)
SELECT
  COUNT(*)                                   AS n_genes_total,
  COUNTIF(avg_prot IS NOT NULL               -- genes with finite protein means
           AND NOT IS_NAN(avg_prot))         AS n_genes_nonnull,
  COUNT(DISTINCT avg_prot)                   AS n_distinct_avg_prot,
  STDDEV_SAMP(avg_prot)                      AS sd_avg_prot_nonnull
FROM prot
WHERE avg_prot IS NOT NULL
  AND NOT IS_NAN(avg_prot);
