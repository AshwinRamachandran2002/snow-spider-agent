WHERE r.primary_site     = 'Kidney'
  AND r.sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: 6)  Build small “RNA” and “Proteome” CTEs containing only the 
--   fields we need, then INNER JOIN on sample-ID plus gene symbol to get the 
--   paired measurements for each sample / gene.
WITH rna AS (
  SELECT
    sample_barcode            AS sample_id,
    sample_type_name          AS sample_type,
    gene_name                 AS gene_symbol,
    fpkm_unstranded
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
),
prot AS (
  SELECT
    aliquot_submitter_id      AS sample_id,
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
)
SELECT
  r.sample_id,
  r.sample_type,
  r.gene_symbol,
  LOG10(r.fpkm_unstranded + 1)       AS log10_fpkm_plus1,
  p.protein_abundance_log2ratio
FROM rna r
JOIN prot p
  USING (sample_id, gene_symbol)
LIMIT 20;
```

```sql
--Description: 7)  For every gene within each sample-type calculate the 
--   Pearson correlation between the log-transformed RNA expression and the 
--   protein abundance.
WITH joined AS (
  SELECT
    r.sample_type,
    r.gene_symbol,
    LOG10(r.fpkm_unstranded + 1)       AS expr,
    p.protein_abundance_log2ratio      AS prot
  FROM (
    SELECT
      sample_barcode            AS sample_id,
      sample_type_name          AS sample_type,
      gene_name                 AS gene_symbol,
      fpkm_unstranded
    FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
    WHERE primary_site = 'Kidney'
      AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
  ) AS r
  JOIN `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
    ON r.sample_id   = p.aliquot_submitter_id
   AND r.gene_symbol = p.gene_symbol
)
SELECT
  sample_type,
  gene_symbol,
  CORR(expr, prot) AS r_gene
FROM joined
GROUP BY sample_type, gene_symbol
LIMIT 20;
```

```sql
--Description: 8)  Keep only those gene-level correlations whose absolute value 
--   exceeds |0.5|.
WITH joined AS ( ...same as query-7... ),
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(expr, prot) AS r_gene
  FROM joined
  GROUP BY sample_type, gene_symbol
)
SELECT *
FROM gene_corr
WHERE ABS(r_gene) > 0.5
LIMIT 20;
```

```sql
--Description: 9)  Now, within each sample-type, average the correlations that 
--   passed the |0.5| threshold.
WITH joined AS ( ...same as query-7... ),
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(expr, prot) AS r_gene
  FROM joined
  GROUP BY sample_type, gene_symbol
  HAVING ABS(CORR(expr, prot)) > 0.5
)
SELECT
  sample_type,
  AVG(r_gene) AS avg_corr_over_05
FROM gene_corr
GROUP BY sample_type;
```

```sql
--Description: 10)  A complete, self-contained query from raw tables to the 
--   requested final answer (average correlation per sample-type for all genes 
--   in CCRCC whose |protein–RNA| correlation is > 0.5).
WITH rna AS (
  SELECT
    sample_barcode            AS sample_id,
    sample_type_name          AS sample_type,
    gene_name                 AS gene_symbol,
    LOG10(fpkm_unstranded + 1) AS log10_fpkm_plus1
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
),
prot AS (
  SELECT
    aliquot_submitter_id      AS sample_id,
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE protein_abundance_log2ratio IS NOT NULL
),
joined AS (
  SELECT
    r.sample_type,
    r.gene_symbol,
    r.log10_fpkm_plus1        AS expr,
    p.protein_abundance_log2ratio AS prot
  FROM rna r
  JOIN prot p
    USING (sample_id, gene_symbol)
),
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(expr, prot) AS r_gene
  FROM joined
  GROUP BY sample_type, gene_symbol
  HAVING ABS(r_gene) > 0.5
)
SELECT
  sample_type,
  AVG(r_gene) AS average_correlation
FROM gene_corr
GROUP BY sample_type;
