```sql
--Description:  After filtering out genes with missing values, summarise the
--              number of gene pairs and the variability (std-dev) of both RNA
--              expression and protein abundance for each Kidney sample_type.
--              If STDDEV_SAMP(avg_prot) is zero, Pearson correlation will be
--              undefined (NULL); this diagnostic query reveals whether low
--              variance—not lack of data—is causing the NULL correlations.
WITH rna AS (
  SELECT
    gene_name                       AS gene_symbol,
    sample_type_name                AS sample_type,
    AVG(LOG10(fpkm_unstranded + 1)) AS avg_expr
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
  GROUP BY sample_type, gene_symbol
),
prot AS (
  SELECT
    gene_symbol,
    AVG(protein_abundance_log2ratio) AS avg_prot
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  GROUP BY gene_symbol
),
joined AS (
  SELECT
    r.sample_type,
    r.gene_symbol,
    r.avg_expr,
    p.avg_prot
  FROM rna r
  JOIN prot p USING (gene_symbol)
  WHERE r.avg_expr IS NOT NULL
    AND p.avg_prot IS NOT NULL
)
SELECT
  sample_type,
  COUNT(*)                   AS n_gene_pairs,
  STDDEV_SAMP(avg_expr)      AS sd_expr,
  STDDEV_SAMP(avg_prot)      AS sd_prot
FROM joined
GROUP BY sample_type;
