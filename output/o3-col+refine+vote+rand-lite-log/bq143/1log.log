2025-05-05 03:48:27 - Thread-2274 (execute) - INFO - [Try to run SQL in self-refine]
```sql
/*  --------------------------------------------------------------
    Clear Cell Renal Cell Carcinoma (CCRCC)
    RNA-seq  (expression)  vs  Proteome (protein abundance)

    1)  Keep only Kidney samples that are “Primary Tumor” or
        “Solid Tissue Normal”, and log-transform the RNA FPKM.
    2)  Bring in the CCRCC discovery proteome log2 ratios.
    3)  Join the two datasets on both   sample_id   AND   gene_symbol.
    4)  For every gene × sample_type, compute the Pearson correlation
        across the overlapping samples.
    5)  Keep only those gene-level correlations with |corr| > 0.5.
    6)  Compute the mean (rounded to 4 d.p.) correlation for each
        sample_type.
    -------------------------------------------------------------- */
WITH
-- RNA-seq (expression) ------------------------------------------------
rna AS (
  SELECT
    sample_barcode                     AS sample_id,
    gene_name                          AS gene_symbol,
    LOG10(fpkm_unstranded + 1)         AS expr_value,
    sample_type_name                   AS sample_type
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
),

-- Proteome (protein abundance) ---------------------------------------
prot AS (
  SELECT
    aliquot_submitter_id               AS sample_id,
    gene_symbol,
    protein_abundance_log2ratio        AS prot_value
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE protein_abundance_log2ratio IS NOT NULL
),

-- Match on sample_id AND gene_symbol ---------------------------------
joined AS (
  SELECT
    r.sample_type,
    r.gene_symbol,
    r.expr_value,
    p.prot_value
  FROM rna  r
  JOIN prot p
    USING (sample_id, gene_symbol)
),

-- Gene-level correlations per sample_type ----------------------------
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(expr_value, prot_value) AS corr
  FROM joined
  GROUP BY sample_type, gene_symbol
),

-- Filter to strong correlations (|corr| > 0.5) -----------------------
strong_corr AS (
  SELECT *
  FROM gene_corr
  WHERE corr IS NOT NULL
    AND ABS(corr) > 0.5
)

-- Final:  mean correlation per sample_type ---------------------------
SELECT
  sample_type,
  ROUND(AVG(corr), 4)  AS avg_correlation
FROM strong_corr
GROUP BY sample_type
ORDER BY sample_type;
```
