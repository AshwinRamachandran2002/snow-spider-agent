```sql
-- 6) Build the joined data set that adds a log-transformed RNA value
WITH rna AS (
  SELECT
    sample_barcode                          AS sample_id,
    gene_name                               AS gene_symbol,
    LOG10(fpkm_unstranded + 1)              AS log_fpkm,
    sample_type_name
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
),
prot AS (
  SELECT
    aliquot_submitter_id                    AS sample_id,
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
map AS (
  SELECT DISTINCT
    prot.sample_id        AS proteome_id,
    m.sample_submitter_id AS sample_barcode,
    prot.gene_symbol,
    prot.protein_abundance_log2ratio
  FROM prot
  JOIN `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` AS m
    ON prot.sample_id = m.sample_submitter_id
)
SELECT
  map.gene_symbol,
  rna.sample_type_name,
  map.protein_abundance_log2ratio,
  rna.log_fpkm
FROM map
JOIN rna
  ON map.sample_barcode = rna.sample_id
LIMIT 20;
```

```sql
-- 7) For every gene & sample type calculate the Pearson correlation coefficient
WITH rna AS (
  SELECT
    sample_barcode                          AS sample_id,
    gene_name                               AS gene_symbol,
    LOG10(fpkm_unstranded + 1)              AS log_fpkm,
    sample_type_name
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
),
prot AS (
  SELECT
    aliquot_submitter_id                    AS sample_id,
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
map AS (
  SELECT DISTINCT
    prot.sample_id        AS proteome_id,
    m.sample_submitter_id AS sample_barcode,
    prot.gene_symbol,
    prot.protein_abundance_log2ratio
  FROM prot
  JOIN `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` AS m
    ON prot.sample_id = m.sample_submitter_id
),
joined AS (
  SELECT
    map.gene_symbol,
    rna.sample_type_name,
    map.protein_abundance_log2ratio,
    rna.log_fpkm
  FROM map
  JOIN rna
    ON map.sample_barcode = rna.sample_id
)
SELECT
  gene_symbol,
  sample_type_name,
  CORR(protein_abundance_log2ratio, log_fpkm) AS correlation
FROM joined
GROUP BY gene_symbol, sample_type_name
LIMIT 20;
```

```sql
-- 8) Keep only correlations whose absolute value exceeds 0.5
WITH rna AS (
  SELECT
    sample_barcode                          AS sample_id,
    gene_name                               AS gene_symbol,
    LOG10(fpkm_unstranded + 1)              AS log_fpkm,
    sample_type_name
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
),
prot AS (
  SELECT
    aliquot_submitter_id                    AS sample_id,
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
map AS (
  SELECT DISTINCT
    prot.sample_id        AS proteome_id,
    m.sample_submitter_id AS sample_barcode,
    prot.gene_symbol,
    prot.protein_abundance_log2ratio
  FROM prot
  JOIN `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` AS m
    ON prot.sample_id = m.sample_submitter_id
),
joined AS (
  SELECT
    map.gene_symbol,
    rna.sample_type_name,
    map.protein_abundance_log2ratio,
    rna.log_fpkm
  FROM map
  JOIN rna
    ON map.sample_barcode = rna.sample_id
),
corrs AS (
  SELECT
    gene_symbol,
    sample_type_name,
    CORR(protein_abundance_log2ratio, log_fpkm) AS correlation
  FROM joined
  GROUP BY gene_symbol, sample_type_name
)
SELECT *
FROM corrs
WHERE ABS(correlation) > 0.5
LIMIT 20;
```

