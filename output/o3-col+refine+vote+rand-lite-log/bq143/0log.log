  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
map AS (
  SELECT DISTINCT
    prot.sample_id        AS proteome_id,
    m.sample_submitter_id AS sample_barcode,
    prot.gene_symbol,
    prot.protein_abundance_log2ratio
  FROM prot
  JOIN `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` AS m
    ON prot.sample_id = m.sample_submitter_id
),
joined AS (
  SELECT
    map.gene_symbol,
    rna.sample_type_name,
    map.protein_abundance_log2ratio,
    rna.log_fpkm
  FROM map
  JOIN rna
    ON map.sample_barcode = rna.sample_id
),
corrs AS (
  SELECT
    gene_symbol,
    sample_type_name,
