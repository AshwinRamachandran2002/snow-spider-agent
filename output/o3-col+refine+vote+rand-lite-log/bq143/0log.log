```sql
--Description:  
--  Some CCRCC proteomics aliquot IDs are already TCGA-style barcodes that start
--  with “C3L-” or “C3N-”.  Those barcodes also appear as RNA-seq `sample_barcode`
--  values, giving us a direct bridge without the mapping table.  
--  This query:  
--    1) pulls Kidney RNA-seq data (Primary Tumor + Solid Tissue Normal) and
--       log-transforms the FPKM;  
--    2) selects only proteomics rows whose aliquot ID begins with “C3”  
--       (covers both C3L and C3N prefixes);  
--    3) joins on the shared TCGA barcode + gene symbol and shows 20 paired rows.
WITH kidney_rna AS (
  SELECT
    sample_barcode                     AS shared_id,
    gene_name                          AS gene_symbol,
    LOG10(fpkm_unstranded + 1)         AS log_fpkm,
    sample_type_name
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
),
tcga_proteome AS (
  SELECT
    aliquot_submitter_id               AS shared_id,
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE STARTS_WITH(aliquot_submitter_id, 'C3')   -- selects C3L- / C3N- IDs
)
SELECT
  p.gene_symbol,
  r.sample_type_name,
  p.protein_abundance_log2ratio,
  r.log_fpkm
FROM tcga_proteome p
JOIN kidney_rna   r
  USING (shared_id, gene_symbol)
LIMIT 20;
```
