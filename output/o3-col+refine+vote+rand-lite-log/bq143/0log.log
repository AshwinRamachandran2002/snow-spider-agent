```sql
/* ------------------------------------------------------------
   Correlation between protein abundance (log2-ratio) and
   log2(FPKM+1) RNA expression for Clear Cell Renal Cell
   Carcinoma (CCRCC) samples.

   Steps
   1)  Pull RNA-seq Kidney rows and keep Primary Tumor /
       Solid Tissue Normal; average any replicate aliquots.
   2)  Pull CCRCC proteome rows, map aliquot → sample,
       keep same two sample types and average replicates.
   3)  Inner-join on sample_barcode + gene_symbol.
   4)  For every (gene, sample_type) compute Pearson r.
   5)  Retain |r| > 0.5 and report the mean r per sample type.
---------------------------------------------------------------- */
WITH rna AS (        -- 1)  Kidney RNA-seq (CCRCC project)
  SELECT
    sample_barcode,
    sample_type_name,                 -- Primary Tumor / Solid Tissue Normal
    gene_name          AS gene_symbol,
    AVG(fpkm_unstranded) AS mean_fpkm -- average any technical replicates
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site = 'Kidney'
    AND sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
  GROUP BY sample_barcode, sample_type_name, gene_symbol
),
rna_log AS (
  SELECT
    sample_barcode,
    sample_type_name,
    gene_symbol,
    LOG(mean_fpkm + 1, 2) AS log2_fpkm               -- log2(FPKM+1)
  FROM rna
),

prot AS (           -- 2)  CCRCC discovery proteome
  SELECT
    m.sample_submitter_id            AS sample_barcode,
    m.sample_type                    AS sample_type_name,
    p.gene_symbol,
    AVG(p.protein_abundance_log2ratio) AS protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
  JOIN `isb-cgc-bq.PDC_metadata.aliquot_to_case_mapping_current` m
    ON p.aliquot_submitter_id = m.sample_submitter_id
  WHERE m.sample_type IN ('Primary Tumor','Solid Tissue Normal')
  GROUP BY sample_barcode, sample_type_name, gene_symbol
),

joined AS (         -- 3)  Match RNA and protein by sample & gene
  SELECT
    r.sample_type_name,
    r.gene_symbol,
    r.sample_barcode,
    r.log2_fpkm,
    p.protein_abundance_log2ratio
  FROM rna_log r
  JOIN prot   p
    ON r.sample_barcode   = p.sample_barcode
   AND r.gene_symbol      = p.gene_symbol
   AND r.sample_type_name = p.sample_type_name
),

gene_corr AS (      -- 4)  Pearson correlation per gene & sample type
  SELECT
    sample_type_name,
    gene_symbol,
    CORR(log2_fpkm, protein_abundance_log2ratio) AS corr
  FROM joined
  GROUP BY sample_type_name, gene_symbol
  HAVING ABS(corr) > 0.5                       -- 5)  keep strong correlations
)

-- 6)  Average correlation for each sample type
SELECT
  sample_type_name,
  AVG(corr) AS avg_correlation
FROM gene_corr
GROUP BY sample_type_name
ORDER BY sample_type_name;
```
