/*  Clear-cell RCC (Kidney) ─ protein vs. RNA concordance
    --------------------------------------------------------------------
    1.  Extract a 5-digit “case number” from both the proteome aliquot
        IDs (e.g.  CPT0016510003 → 001651) and the RNA-Seq barcodes
        (e.g.  C3N-01651-01  → 01651).  This provides a common sample
        key that lets us pair measurements originating from the same
        patient / case.
    2.  Restrict RNA-Seq to Kidney samples of type “Primary Tumor” or
        “Solid Tissue Normal”.
    3.  Join proteome and transcriptome on gene symbol + case number.
    4.  For every gene × sample-type combination with ≥5 matched
        samples, compute the Pearson correlation between
        log2-protein abundance and log2(FPKM + 1).
    5.  Keep only correlations with |corr| > 0.5 and report, for each
        sample type, the mean correlation and the number of genes that
        passed the filter.                                                     */

WITH proteome AS (
  SELECT
      gene_symbol,
      protein_abundance_log2ratio AS prot_val,
      -- pull the 5-digit case number after the leading zeros
      LPAD(REGEXP_EXTRACT(aliquot_submitter_id,
                          r'^CPT0*([0-9]+)'), 5, '0')      AS case_num
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE protein_abundance_log2ratio IS NOT NULL
),

rna AS (
  SELECT
      gene_name                                 AS gene_symbol,
      LOG(fpkm_unstranded + 1, 2)               AS rna_val,
      sample_type_name,
      -- capture the 5-digit case number found between the dashes
      LPAD(REGEXP_EXTRACT(sample_barcode,
                          r'^[^-]+-([0-9]+)-'), 5, '0')   AS case_num
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site      = 'Kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
    AND fpkm_unstranded    IS NOT NULL
),

joined AS (
  SELECT
      p.gene_symbol,
      r.sample_type_name,
      p.prot_val,
      r.rna_val
  FROM proteome AS p
  JOIN rna      AS r
    USING (gene_symbol, case_num)
),

per_gene_corr AS (
  SELECT
      gene_symbol,
      sample_type_name,
      CORR(prot_val, rna_val) AS corr,
      COUNT(*)               AS n_pairs
  FROM joined
  GROUP BY gene_symbol, sample_type_name
  HAVING n_pairs >= 5
),

filtered AS (
  SELECT *
  FROM per_gene_corr
  WHERE ABS(corr) > 0.5
)

SELECT
    sample_type_name,
    AVG(corr) AS average_corr_over_genes,
    COUNT(*)  AS n_genes_retained
FROM filtered
GROUP BY sample_type_name
ORDER BY sample_type_name;
