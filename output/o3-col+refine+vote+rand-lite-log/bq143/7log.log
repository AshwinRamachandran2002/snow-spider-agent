  SELECT
      gene_symbol,
      protein_abundance_log2ratio AS prot_val,
      -- 5-digit case number right after ‘CPT’; preserves leading zeros
      REGEXP_EXTRACT(aliquot_submitter_id, r'^CPT0*([0-9]{5})') AS case_num
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE protein_abundance_log2ratio IS NOT NULL
        -- keep rows where extraction succeeded
        AND REGEXP_CONTAINS(aliquot_submitter_id, r'^CPT0*[0-9]{5}')
