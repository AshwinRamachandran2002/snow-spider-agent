```sql
-- Description:  Clear-cell RCC proteome vs. transcriptome concordance
--   1.  Kidney (CCRCC) only
--   2.  keep “Primary Tumor” and “Solid Tissue Normal” RNA-seq samples
--   3.  Join on gene symbol (protein ↔ RNA) and, where possible, the
--       common CPTAC sample/aliquot identifiers (*sample submitter id*);
--       rows lacking either measurement are discarded.
--   4.  For every gene-by-sample-type pair, compute the Pearson
--       correlation between log2-protein abundance ratios and
--       log2(FPKM + 1) RNA levels (only genes with ≥5 paired values).
--   5.  Keep correlations whose absolute value exceeds 0.5 and,
--       finally, report the average correlation across those genes for
--       each sample-type.

WITH joined AS (
  SELECT
      p.gene_symbol,
      r.sample_type_name,
      p.protein_abundance_log2ratio                   AS prot_val,
      LOG(r.fpkm_unstranded + 1, 2)                   AS rna_val
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`  AS p
  JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                  AS r
        ON  p.gene_symbol = r.gene_name         -- gene match
  WHERE r.primary_site      = 'Kidney'
    AND r.sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
    AND p.protein_abundance_log2ratio IS NOT NULL
    AND r.fpkm_unstranded              IS NOT NULL
),

per_gene_corr AS (
  SELECT
      gene_symbol,
      sample_type_name,
      CORR(prot_val, rna_val)  AS corr,
      COUNT(*)                 AS n_pairs
  FROM joined
  GROUP BY gene_symbol, sample_type_name
  HAVING n_pairs >= 5
),

filtered AS (
  SELECT *
  FROM per_gene_corr
  WHERE ABS(corr) > 0.5
)

SELECT
    sample_type_name,
    AVG(corr)  AS average_corr_over_genes,
    COUNT(*)   AS n_genes_retained
FROM filtered
GROUP BY sample_type_name
ORDER BY sample_type_name;
