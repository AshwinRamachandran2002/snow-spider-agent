```

```sql
--Description: Create log-transformed RNA expression and keep only desired sample types
SELECT r.sample_barcode,
       r.sample_type_name,
       p.gene_symbol,
       p.protein_abundance_log2ratio       AS prot_log2ratio,
       LOG2(r.fpkm_unstranded + 1)         AS rna_log2fpkm
FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`  AS p
JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                   AS r
  ON p.aliquot_submitter_id = r.sample_barcode
 AND p.gene_symbol        = r.gene_name
WHERE r.primary_site      = 'Kidney'
  AND r.sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
LIMIT 20;
```

```sql
--Description: Gene-wise correlation between protein and RNA for each sample type
SELECT
  p.gene_symbol,
  r.sample_type_name,
  CORR(p.protein_abundance_log2ratio,
       LOG2(r.fpkm_unstranded + 1))        AS prot_rna_corr,
  COUNT(*)                                 AS n_pairs
FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`  AS p
JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                   AS r
  ON p.aliquot_submitter_id = r.sample_barcode
 AND p.gene_symbol        = r.gene_name
WHERE r.primary_site      = 'Kidney'
  AND r.sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
GROUP BY p.gene_symbol, r.sample_type_name
HAVING n_pairs >= 5
LIMIT 20;
```

```sql
--Description: Keep only strong correlations (|corr| > 0.5)
SELECT *
FROM (
  SELECT
    p.gene_symbol,
    r.sample_type_name,
    CORR(p.protein_abundance_log2ratio,
         LOG2(r.fpkm_unstranded + 1))      AS prot_rna_corr,
    COUNT(*)                               AS n_pairs
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                  AS r
    ON p.aliquot_submitter_id = r.sample_barcode
   AND p.gene_symbol        = r.gene_name
  WHERE r.primary_site      = 'Kidney'
    AND r.sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
  GROUP BY p.gene_symbol, r.sample_type_name
)
WHERE ABS(prot_rna_corr) > 0.5
LIMIT 20;
```

```sql
--Description: FINAL – average strong (|corr| > 0.5) correlation per sample type
WITH gene_corr AS (
  SELECT
    p.gene_symbol,
    r.sample_type_name,
    CORR(p.protein_abundance_log2ratio,
         LOG2(r.fpkm_unstranded + 1))      AS prot_rna_corr
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                  AS r
    ON p.aliquot_submitter_id = r.sample_barcode
   AND p.gene_symbol        = r.gene_name
  WHERE r.primary_site      = 'Kidney'
    AND r.sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
  GROUP BY p.gene_symbol, r.sample_type_name
)
SELECT
  sample_type_name,
  AVG(prot_rna_corr)  AS avg_correlation,
  COUNT(*)            AS num_genes
FROM gene_corr
WHERE ABS(prot_rna_corr) > 0.5
GROUP BY sample_type_name;
```
