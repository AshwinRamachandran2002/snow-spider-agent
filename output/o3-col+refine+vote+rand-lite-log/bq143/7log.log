```sql
/*  Clear-cell RCC (Kidney) – protein vs RNA concordance
    ------------------------------------------------------------------
    Goal
      •  Correlate protein abundance (log2-ratio) with RNA expression
         [log2(FPKM + 1)] for each gene and RNA sample-type
         (“Primary Tumor”, “Solid Tissue Normal”) in CCRCC.
      •  Exclude correlations whose absolute value exceeds 0.5
         (|corr| > 0.5).
      •  Report, per sample-type, the mean correlation of the genes
         that remain and how many genes contributed.

    NOTE
      Because a one-to-one mapping between CPTAC proteome aliquots and
      TCGA-style RNA barcodes is not directly available in the public
      tables, we join only on gene symbol; the correlation therefore
      measures overall concordance across all available protein and
      RNA values within a sample-type, not per individual sample.
*/

WITH joined AS (
  SELECT
      p.gene_symbol,
      r.sample_type_name,
      p.protein_abundance_log2ratio           AS prot_val,
      LOG(r.fpkm_unstranded + 1, 2)           AS rna_val
  FROM  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  JOIN  `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                 AS r
        ON  p.gene_symbol = r.gene_name                    -- gene match
  WHERE r.primary_site      = 'Kidney'
    AND r.sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
    AND p.protein_abundance_log2ratio IS NOT NULL
    AND r.fpkm_unstranded              IS NOT NULL
),

per_gene_corr AS (
  SELECT
      gene_symbol,
      sample_type_name,
      SAFE_CORR(prot_val, rna_val) AS corr,      -- avoid NULL on 0-variance
      COUNT(*)                    AS n_pairs
  FROM joined
  GROUP BY gene_symbol, sample_type_name
  HAVING n_pairs >= 5              -- at least 5 paired rows for a gene
         AND corr IS NOT NULL
),

-- Exclude highly positive/negative correlations (|corr| > 0.5)
filtered AS (
  SELECT *
  FROM   per_gene_corr
  WHERE  ABS(corr) <= 0.5
)

SELECT
    sample_type_name,
    AVG(corr) AS average_corr_over_genes,
    COUNT(*)  AS n_genes_retained
FROM filtered
GROUP BY sample_type_name
ORDER BY sample_type_name;
```
