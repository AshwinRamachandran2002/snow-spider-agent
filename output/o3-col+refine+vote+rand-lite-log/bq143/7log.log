```sql
--Description:  Summarise the protein-vs-RNA relationship in Kidney by sample type.
--              For each gene that appears in both CCRCC proteomics and Kidney RNA-Seq
--              (joined only on gene_symbol), compute Pearson correlation between
--              protein abundance (log2-ratio) and log2(FPKM + 1) RNA counts,
--              requiring at least five paired observations per gene to ensure a
--              stable statistic.  Then, for each RNA sample_type
--              (“Primary Tumor”, “Solid Tissue Normal”) report:
--                 • the mean correlation,
--                 • the mean absolute correlation,
--                 • how many genes contributed.
WITH gene_corr AS (
  SELECT
    p.gene_symbol,
    r.sample_type_name,
    CORR(p.protein_abundance_log2ratio,
         LOG(r.fpkm_unstranded + 1, 2)) AS prot_rna_corr
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  JOIN `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                                AS r
    ON p.gene_symbol = r.gene_name
  WHERE r.primary_site      = 'Kidney'
    AND r.sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
  GROUP BY p.gene_symbol, r.sample_type_name
  HAVING COUNT(*) >= 5
)
SELECT
  sample_type_name,
  AVG(prot_rna_corr)      AS avg_correlation,
  AVG(ABS(prot_rna_corr)) AS avg_abs_correlation,
  COUNT(*)                AS num_genes
FROM gene_corr
GROUP BY sample_type_name;
```
