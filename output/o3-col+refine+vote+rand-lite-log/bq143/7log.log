  SELECT
      gene_name                         AS gene_symbol,
      LOG(fpkm_unstranded + 1, 2)       AS rna_val,
      sample_type_name,
      -- 5-digit case number in the middle of the TCGA-style barcode
      REGEXP_EXTRACT(sample_barcode, r'^[^-]+-([0-9]{5})-') AS case_num
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site      = 'Kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
    AND fpkm_unstranded    IS NOT NULL
    AND REGEXP_CONTAINS(sample_barcode, r'^[^-]+-[0-9]{5}-')
),

joined AS (
  SELECT
      p.gene_symbol,
      r.sample_type_name,
      p.prot_val,
      r.rna_val
  FROM proteome AS p
  JOIN rna      AS r
    USING (gene_symbol, case_num)
),

per_gene_corr AS (
  SELECT
      gene_symbol,
      sample_type_name,
      CORR(prot_val, rna_val) AS corr,
      COUNT(*)               AS n_pairs
  FROM joined
  GROUP BY gene_symbol, sample_type_name
  HAVING n_pairs >= 5
),

