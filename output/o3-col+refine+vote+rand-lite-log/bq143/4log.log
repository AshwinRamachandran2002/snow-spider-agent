/*  Correlate protein abundance vs. RNA expression for CPTAC-CCRCC samples
    (Primary Tumor and Solid Tissue Normal only).                         */

WITH
-- ──────────  Proteome: keep CCRCC aliquots plus their sample-type  ──────────
prot AS (
  SELECT
    SUBSTR(p.aliquot_submitter_id,1,9)         AS core_id,     -- “CPT000732”
    p.gene_symbol,
    p.protein_abundance_log2ratio,
    m.sample_type                              -- Primary Tumor / Solid Tissue Normal
  FROM  `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
  JOIN  `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`         m
        ON SUBSTR(p.aliquot_submitter_id,1,9) = m.sample_submitter_id
  WHERE m.sample_type IN ('Primary Tumor','Solid Tissue Normal')
    AND p.protein_abundance_log2ratio IS NOT NULL
),

-- ──────────  RNA-seq: only the samples that appear in the CCRCC proteome  ──────────
rna AS (
  SELECT
    r.sample_barcode                           AS core_id,
    r.gene_name,
    LOG(r.fpkm_unstranded + 1, 2)              AS log2_fpkm        -- log2(FPKM+1)
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current` r
  WHERE r.sample_barcode IN (SELECT DISTINCT core_id FROM prot)
    AND r.fpkm_unstranded IS NOT NULL
),

-- ──────────  Match on core-ID and gene  ──────────
joint AS (
  SELECT
    p.sample_type,
    p.gene_symbol,
    p.protein_abundance_log2ratio,
    r.log2_fpkm
  FROM prot p
  JOIN rna  r
    ON p.core_id    = r.core_id
   AND p.gene_symbol = r.gene_name
),

-- ──────────  Per-gene, per-type correlation  ──────────
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(protein_abundance_log2ratio, log2_fpkm) AS corr_coeff
  FROM joint
  GROUP BY sample_type, gene_symbol
  HAVING corr_coeff IS NOT NULL                  -- need ≥2 points
),

-- ──────────  Keep strong correlations  ──────────
strong_corr AS (
  SELECT *
  FROM gene_corr
  WHERE ABS(corr_coeff) > 0.5
)

-- ──────────  Average correlation per sample-type  ──────────
SELECT
  sample_type,
  COUNT(*)        AS n_genes_retained,
  AVG(corr_coeff) AS avg_correlation
FROM strong_corr
GROUP BY sample_type
ORDER BY sample_type;
