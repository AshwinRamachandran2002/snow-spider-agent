```sql
--Description:  We suspect the proteome aliquot IDs such as “CPT0008140003” might 
--              correspond to RNA-seq barcodes once the final four digits (“0003”) 
--              are removed.  The query compares that 9-character core  
--              (e.g.  CPT000814) from the CCRCC proteome table with the first  
--              9 characters of every Kidney RNA-seq sample_barcode to see whether  
--              any overlap exists.  A non-zero overlap_count would confirm the  
--              truncation hypothesis and guide the next JOIN attempt.  
WITH proteome_core AS (
  SELECT DISTINCT SUBSTR(aliquot_submitter_id, 1, 9) AS id9
  FROM   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
),
rna_core AS (
  SELECT DISTINCT SUBSTR(sample_barcode, 1, 9)        AS id9
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE  primary_site = 'Kidney'
)
SELECT COUNT(*) AS overlap_count,
       ARRAY_AGG(id9 LIMIT 10) AS example_matching_ids
FROM   proteome_core
JOIN   rna_core
USING  (id9);
