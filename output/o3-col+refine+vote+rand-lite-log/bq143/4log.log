```sql
/*  Correlate protein abundance (log2-ratio) with RNA expression (log2(FPKM+1))
    for CPTAC samples whose IDs share the 9-character “CPT000###” core.
    Results are summarised separately for Primary-Tumor and Solid-Tissue-Normal
    specimens; only genes with |r| > 0.5 are retained before averaging.      */

WITH
-- ──────────  Proteome: keep core-ID + gene + log2ratio + sample-type  ──────────
prot AS (
  SELECT
    SUBSTR(p.aliquot_submitter_id,1,9)              AS core_id,      -- e.g. CPT000732
    p.gene_symbol,
    p.protein_abundance_log2ratio,
    m.sample_type                                   -- Primary Tumor / Solid Tissue Normal
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
  JOIN `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`        m
    ON SUBSTR(p.aliquot_submitter_id,1,9) = m.sample_submitter_id
  WHERE m.sample_type IN ('Primary Tumor','Solid Tissue Normal')
    AND p.protein_abundance_log2ratio IS NOT NULL
),

-- ──────────  RNA-seq: only barcodes beginning with the same “CPT” core  ──────────
rna AS (
  SELECT
    r.sample_barcode                               AS core_id,        -- already 9 chars
    r.gene_name                                    AS gene_symbol,
    LOG(r.fpkm_unstranded + 1) / LOG(2)            AS log2_fpkm,      -- log2(FPKM+1)
    r.sample_type_name                             AS sample_type
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current` r
  WHERE r.sample_barcode LIKE 'CPT%'                         -- ensures same ID style
    AND r.sample_type_name IN ('Primary Tumor','Solid Tissue Normal')
    AND r.fpkm_unstranded IS NOT NULL
),

-- ──────────  Inner-join on core-ID and gene  ──────────
joined AS (
  SELECT
    r.sample_type,                     -- label from RNA table
    r.gene_symbol,
    p.protein_abundance_log2ratio,
    r.log2_fpkm
  FROM prot  p
  JOIN rna   r
    ON p.core_id     = r.core_id
   AND p.gene_symbol = r.gene_symbol
),

-- ──────────  Per-gene correlation within each sample-type  ──────────
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(protein_abundance_log2ratio, log2_fpkm) AS corr_coeff
  FROM joined
  GROUP BY sample_type, gene_symbol
  HAVING corr_coeff IS NOT NULL            -- requires ≥2 paired measurements
),

-- ──────────  Keep strong correlations (|r| > 0.5)  ──────────
strong_corr AS (
  SELECT *
  FROM   gene_corr
  WHERE  ABS(corr_coeff) > 0.5
)

-- ──────────  Average strong correlation per sample-type  ──────────
SELECT
  sample_type,
  COUNT(*)        AS n_genes_retained,
  AVG(corr_coeff) AS avg_correlation
FROM strong_corr
GROUP BY sample_type
ORDER BY sample_type;
```
