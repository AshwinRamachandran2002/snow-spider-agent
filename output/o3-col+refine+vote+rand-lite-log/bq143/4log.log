```sql
/* Correlation between protein abundance (log2-ratio) and log2(FPKM+1)  
   for CPTAC clear–cell RCC Primary-Tumor vs Solid-Tissue-Normal samples      */

WITH
-- ─────────────  RNA-seq (Kidney project)  ─────────────
rna AS (
  SELECT
    sample_barcode                       AS core_id,                       -- e.g. CPT000732
    gene_name,
    LOG(fpkm_unstranded + 1, 2)          AS log2_fpkm,                     -- log2(FPKM+1)
    sample_type_name                     AS sample_type                    -- Primary Tumor / Solid Tissue Normal
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site      = 'Kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
    AND fpkm_unstranded IS NOT NULL
),

-- ─────────────  Proteome (CPTAC-CCRCC discovery study)  ─────────────
prot AS (
  SELECT
    SUBSTR(p.aliquot_submitter_id,1,9)   AS core_id,                       -- e.g. CPT000732
    p.gene_symbol,
    p.protein_abundance_log2ratio,
    m.sample_type
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
  LEFT JOIN `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`      AS m
         ON SUBSTR(p.aliquot_submitter_id,1,9) = m.sample_submitter_id
  WHERE m.sample_type IN ('Primary Tumor', 'Solid Tissue Normal')
    AND p.protein_abundance_log2ratio IS NOT NULL
),

-- ─────────────  Join RNA & Proteome on core-ID and gene  ─────────────
joint AS (
  SELECT
    r.sample_type,                              -- sample label carried from RNA-seq
    r.gene_name           AS gene_symbol,
    r.log2_fpkm,
    p.protein_abundance_log2ratio
  FROM rna  AS r
  JOIN prot AS p
    ON r.core_id    = p.core_id
   AND r.gene_name  = p.gene_symbol
),

-- ─────────────  Per-gene correlation within each sample-type  ─────────────
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(protein_abundance_log2ratio, log2_fpkm) AS corr_coeff
  FROM joint
  GROUP BY sample_type, gene_symbol
),

-- ─────────────  Keep strong correlations (|r| > 0.5)  ─────────────
strong_corr AS (
  SELECT *
  FROM   gene_corr
  WHERE  ABS(corr_coeff) > 0.5
)

-- ─────────────  Average correlation per sample-type  ─────────────
SELECT
  sample_type,
  COUNT(*)                 AS n_genes_retained,
  AVG(corr_coeff)          AS avg_correlation
FROM strong_corr
GROUP BY sample_type
ORDER BY sample_type;
```
