JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`  AS p
           ON  SUBSTR(r.sample_barcode,1,9) = SUBSTR(p.aliquot_submitter_id,1,9)
          AND r.gene_name              = p.gene_symbol
JOIN   `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`            AS m
           ON  m.sample_submitter_id   = SUBSTR(p.aliquot_submitter_id,1,9)
WHERE  r.primary_site     = 'Kidney'
  AND  r.sample_type_name = 'Primary Tumor'
