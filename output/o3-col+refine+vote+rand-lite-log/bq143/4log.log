```sql
--Description: 7)  Calculate gene-wise Spearman correlation (|ρ|) for ‘Primary Tumor’  
SELECT   r.`gene_name`                                               AS gene,
         CORR( p.`protein_abundance_log2ratio`,
               LOG10(r.`fpkm_unstranded` + 1) )                      AS corr_pt
FROM     `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                              AS r
JOIN     `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
       ON r.`sample_barcode` = p.`aliquot_submitter_id`
JOIN     `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`         AS m
       ON p.`aliquot_submitter_id` = m.`sample_submitter_id`
WHERE    r.`primary_site`      = 'Kidney'
  AND    r.`sample_type_name`  = 'Primary Tumor'
  AND    m.`sample_type`       = 'Primary Tumor'
GROUP BY r.`gene_name`
HAVING   ABS(corr_pt) > 0.5
LIMIT 20;
```

```sql
--Description: 8)  Calculate gene-wise correlation for ‘Solid Tissue Normal’  
SELECT   r.`gene_name`                                               AS gene,
         CORR( p.`protein_abundance_log2ratio`,
               LOG10(r.`fpkm_unstranded` + 1) )                      AS corr_norm
FROM     `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`                              AS r
JOIN     `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` AS p
       ON r.`sample_barcode` = p.`aliquot_submitter_id`
JOIN     `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`         AS m
       ON p.`aliquot_submitter_id` = m.`sample_submitter_id`
WHERE    r.`primary_site`      = 'Kidney'
  AND    r.`sample_type_name`  = 'Solid Tissue Normal'
  AND    m.`sample_type`       = 'Solid Tissue Normal'
GROUP BY r.`gene_name`
HAVING   ABS(corr_norm) > 0.5
LIMIT 20;
```

```sql
--Description: 9)  Bring the two filtered correlation result-sets together and tag by sample-type  
WITH tumor AS (
  SELECT r.`gene_name` AS gene,
         'Primary Tumor'         AS sample_type,
         CORR( p.`protein_abundance_log2ratio`,
               LOG10(r.`fpkm_unstranded` + 1) ) AS corr_val
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`  r
  JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
         ON r.`sample_barcode` = p.`aliquot_submitter_id`
  JOIN   `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current` m
         ON p.`aliquot_submitter_id` = m.`sample_submitter_id`
  WHERE  r.`primary_site`     = 'Kidney'
    AND  r.`sample_type_name` = 'Primary Tumor'
    AND  m.`sample_type`      = 'Primary Tumor'
  GROUP BY r.`gene_name`
  HAVING ABS(corr_val) > 0.5
), norm AS (
  SELECT r.`gene_name` AS gene,
         'Solid Tissue Normal'  AS sample_type,
         CORR( p.`protein_abundance_log2ratio`,
               LOG10(r.`fpkm_unstranded` + 1) ) AS corr_val
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`  r
  JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
         ON r.`sample_barcode` = p.`aliquot_submitter_id`
  JOIN   `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current` m
         ON p.`aliquot_submitter_id` = m.`sample_submitter_id`
  WHERE  r.`primary_site`     = 'Kidney'
    AND  r.`sample_type_name` = 'Solid Tissue Normal'
    AND  m.`sample_type`      = 'Solid Tissue Normal'
  GROUP BY r.`gene_name`
  HAVING ABS(corr_val) > 0.5
)
SELECT * FROM tumor
UNION ALL
SELECT * FROM norm
LIMIT 20;
```

```sql
--Description: 10)  FINAL – average absolute correlation (|ρ|) per sample-type after the |ρ|>0.5 filter  
WITH all_corr AS (
  SELECT 'Primary Tumor'        AS sample_type,
         CORR( p.`protein_abundance_log2ratio`,
               LOG10(r.`fpkm_unstranded` + 1) ) AS rho
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`  r
  JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
         ON r.`sample_barcode` = p.`aliquot_submitter_id`
  JOIN   `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current` m
         ON p.`aliquot_submitter_id` = m.`sample_submitter_id`
  WHERE  r.`primary_site`     = 'Kidney'
    AND  r.`sample_type_name` = 'Primary Tumor'
    AND  m.`sample_type`      = 'Primary Tumor'
  GROUP BY r.`gene_name`
  HAVING ABS(rho) > 0.5
  
  UNION ALL
  
  SELECT 'Solid Tissue Normal' AS sample_type,
         CORR( p.`protein_abundance_log2ratio`,
               LOG10(r.`fpkm_unstranded` + 1) ) AS rho
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`  r
  JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
         ON r.`sample_barcode` = p.`aliquot_submitter_id`
  JOIN   `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current` m
         ON p.`aliquot_submitter_id` = m.`sample_submitter_id`
  WHERE  r.`primary_site`     = 'Kidney'
    AND  r.`sample_type_name` = 'Solid Tissue Normal'
    AND  m.`sample_type`      = 'Solid Tissue Normal'
  GROUP BY r.`gene_name`
  HAVING ABS(rho) > 0.5
)
SELECT   sample_type,
         AVG(rho) AS avg_correlation_after_filter
FROM     all_corr
GROUP BY sample_type;
```
