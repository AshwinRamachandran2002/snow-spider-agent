/*  Correlate protein abundance (proteome) with RNA expression (FPKM)
    in CPTAC clear-cell RCC samples, separating Primary Tumor vs
    Solid Tissue Normal.                                                 */

WITH
-- ─────────  CCRCC proteome (keep core-ID + gene + log2ratio)  ─────────
proteome AS (
  SELECT
    SUBSTR(aliquot_submitter_id, 1, 9)       AS core_id,      -- e.g. CPT000732
    gene_symbol,
    protein_abundance_log2ratio
  FROM `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current`
  WHERE protein_abundance_log2ratio IS NOT NULL
),

-- ─────────  RNA-seq for Kidney samples (with sample-type label)  ─────────
rna AS (
  SELECT
    sample_barcode                           AS core_id,
    gene_name                                AS gene_symbol,
    LOG(fpkm_unstranded + 1) / LOG(2)        AS log2_fpkm,     -- log2(FPKM+1)
    sample_type_name                         AS sample_type    -- Primary Tumor / Solid Tissue Normal
  FROM `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`
  WHERE primary_site      = 'Kidney'
    AND sample_type_name IN ('Primary Tumor', 'Solid Tissue Normal')
    AND fpkm_unstranded IS NOT NULL
),

-- ─────────  Join on core-ID and gene  ─────────
joined AS (
  SELECT
    r.sample_type,
    r.gene_symbol,
    p.protein_abundance_log2ratio,
    r.log2_fpkm
  FROM proteome p
  JOIN rna      r
    ON p.core_id     = r.core_id
   AND p.gene_symbol = r.gene_symbol
),

-- ─────────  Per-gene correlation within each sample-type  ─────────
gene_corr AS (
  SELECT
    sample_type,
    gene_symbol,
    CORR(protein_abundance_log2ratio, log2_fpkm) AS corr_coeff
  FROM joined
  GROUP BY sample_type, gene_symbol
  HAVING CORR(protein_abundance_log2ratio, log2_fpkm) IS NOT NULL
),

-- ─────────  Keep strong correlations (|r| > 0.5)  ─────────
strong_corr AS (
  SELECT *
  FROM   gene_corr
  WHERE  ABS(corr_coeff) > 0.5
)

-- ─────────  Average strong correlation per sample-type  ─────────
SELECT
  sample_type,
  COUNT(*)        AS n_genes_retained,
  AVG(corr_coeff) AS avg_correlation
FROM strong_corr
GROUP BY sample_type
ORDER BY sample_type;
