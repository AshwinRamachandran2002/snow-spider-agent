```sql
--Description: 7)  Gene-wise correlation (|ρ|) ≥0.5 for ‘Primary Tumor’ using 9-char core ID join  
WITH joined AS (
  SELECT  r.gene_name,
          p.protein_abundance_log2ratio                     AS prot,
          LOG10(r.fpkm_unstranded + 1)                      AS expr
  FROM   `isb-cgc-bq.CPTAC.RNAseq_hg38_gdc_current`        r
  JOIN   `isb-cgc-bq.CPTAC.quant_proteome_CPTAC_CCRCC_discovery_study_pdc_current` p
         ON SUBSTR(r.sample_barcode,1,9)=SUBSTR(p.aliquot_submitter_id,1,9)
        AND r.gene_name = p.gene_symbol
  JOIN   `isb-cgc-bq.CPTAC.per_sample_file_metadata_CPTAC_2_pdc_current`          m
         ON m.sample_submitter_id = SUBSTR(p.aliquot_submitter_id,1,9)
  WHERE  r.primary_site     = 'Kidney'
    AND  r.sample_type_name = 'Primary Tumor'
    AND  m.sample_type      = 'Primary Tumor'
)
SELECT   gene_name AS gene,
         CORR(prot, expr) AS corr_pt
FROM     joined
GROUP BY gene_name
HAVING   ABS(corr_pt) > 0.5
LIMIT 20;
```

