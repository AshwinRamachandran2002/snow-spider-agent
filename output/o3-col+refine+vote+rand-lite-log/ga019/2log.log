```sql
-- Description: 6) Combine first_open and first_uninstall to see how many days the app survived
WITH installs AS (
  SELECT
    user_pseudo_id ,
    MIN(event_timestamp) AS first_open_ts
  FROM
    `firebase-public-project.analytics_153293282.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id ,
    MIN(event_timestamp) AS first_uninstall_ts
  FROM
    `firebase-public-project.analytics_153293282.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  i.user_pseudo_id ,
  i.first_open_ts ,
  u.first_uninstall_ts ,
  ROUND( (u.first_uninstall_ts - i.first_open_ts)/1e6/86400 , 2) AS days_until_uninstall
FROM
  installs i
LEFT JOIN
  uninstalls u
USING (user_pseudo_id)
LIMIT 20;
```

```sql
-- Description: 7) Count total number of installs (unique users) during Aug–Sep-2018
SELECT
  COUNT(DISTINCT user_pseudo_id) AS total_installs
FROM
  `firebase-public-project.analytics_153293282.events_*`
WHERE
  _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
  AND event_name = 'first_open'
LIMIT 20;
```

```sql
-- Description: 8) Count users who un-installed the app within 7 days of install
WITH installs AS (
  SELECT
    user_pseudo_id ,
    MIN(event_timestamp) AS first_open_ts
  FROM
    `firebase-public-project.analytics_153293282.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id ,
    MIN(event_timestamp) AS first_uninstall_ts
  FROM
    `firebase-public-project.analytics_153293282.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  COUNT(*) AS uninstall_within_7d
FROM
  installs i
JOIN
  uninstalls u
USING (user_pseudo_id)
WHERE
  (u.first_uninstall_ts - i.first_open_ts) <= 7*86400*1e6
LIMIT 20;
```

```sql
-- Description: 9) Final – percentage of users who either never uninstalled or uninstalled AFTER day-7
WITH installs AS (
  SELECT
    user_pseudo_id ,
    MIN(event_timestamp) AS first_open_ts
  FROM
    `firebase-public-project.analytics_153293282.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id ,
    MIN(event_timestamp) AS first_uninstall_ts
  FROM
    `firebase-public-project.analytics_153293282.events_*`
  WHERE
    _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
),
unioned AS (
  SELECT
    i.user_pseudo_id ,
    i.first_open_ts ,
    u.first_uninstall_ts ,
    IF( u.first_uninstall_ts IS NULL
        OR (u.first_uninstall_ts - i.first_open_ts) > 7*86400*1e6
      , 1 , 0) AS survived_7d_or_never
  FROM
    installs i
  LEFT JOIN
    uninstalls u
  USING (user_pseudo_id)
)
SELECT
  SUM(survived_7d_or_never)          AS users_survived_7d_or_never ,
  COUNT(*)                           AS total_installs             ,
  ROUND( 100 * SUM(survived_7d_or_never) / COUNT(*), 2) AS pct_survived
FROM
  unioned
LIMIT 20;
```
