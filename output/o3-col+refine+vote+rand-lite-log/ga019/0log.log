  SAFE_DIVIDE(
      SUM(
        CASE
          WHEN first_uninstall_ts IS NULL                      -- never uninstalled
               OR first_uninstall_ts > install_ts + 604800000000  -- after 7 days (7*24*60*60*1e6 µs)
          THEN 1
        END),
      COUNT(*)
  ) * 100 AS pct_users_not_uninstall_within_7days
FROM user_lifecycle;
