```sql
--Description: 6) For each user who installed in Aug–Sep, get install time & first uninstall time  
WITH installs AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS first_uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT i.user_pseudo_id,
       i.install_ts,
       u.first_uninstall_ts
FROM installs AS i
LEFT JOIN uninstalls AS u
USING (user_pseudo_id)
LIMIT 20;
```

```sql
--Description: 7) Classify every installed user by uninstall timing (≤7 days, >7 days, never)  
WITH user_lifecycle AS (
  -- query 6 reused
  WITH installs AS (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS install_ts
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'first_open'
    GROUP BY user_pseudo_id
  ),
  uninstalls AS (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS first_uninstall_ts
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'app_remove'
    GROUP BY user_pseudo_id
  )
  SELECT i.user_pseudo_id,
         i.install_ts,
         u.first_uninstall_ts
  FROM installs AS i
  LEFT JOIN uninstalls AS u
  USING (user_pseudo_id)
)
SELECT user_pseudo_id,
       CASE
         WHEN first_uninstall_ts IS NULL THEN 'never_uninstalled'
         WHEN first_uninstall_ts <= install_ts + 604800000000 THEN 'uninstalled_within_7'
         ELSE 'uninstalled_after_7'
       END AS uninstall_status
FROM user_lifecycle
LIMIT 20;
```

```sql
--Description: 8) Calculate the percentage of users who did NOT uninstall within 7 days  
WITH user_lifecycle AS (
  -- same CTE as query 7
  WITH installs AS (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS install_ts
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'first_open'
    GROUP BY user_pseudo_id
  ),
  uninstalls AS (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS first_uninstall_ts
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'app_remove'
    GROUP BY user_pseudo_id
  )
  SELECT i.user_pseudo_id,
         i.install_ts,
         u.first_uninstall_ts
  FROM installs AS i
  LEFT JOIN uninstalls AS u
  USING (user_pseudo_id)
)
SELECT SAFE_DIVIDE(
         SUM(CASE
               WHEN first_uninstall_ts IS NULL
                    OR first_uninstall_ts > install_ts + 604800000000
               THEN 1 END),
         COUNT(*)
       ) * 100 AS pct_users_not_uninstall_within_7days
FROM user_lifecycle
LIMIT 20;
```

These eight queries move from exploring the available event names, to identifying install and uninstall events, to classifying each August–September 2018 installer, and finally to computing the desired percentage of users who either never uninstalled or waited more than seven days before uninstalling.
