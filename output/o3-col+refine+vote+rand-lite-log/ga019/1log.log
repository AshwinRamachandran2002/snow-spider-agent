```sql
--Description: 5) Grab the very first uninstall (app_remove) time-stamp per user (if any).  
SELECT user_pseudo_id,
       MIN(event_timestamp) AS uninstall_ts
FROM  `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
  AND event_name = 'app_remove'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
--Description: 6) Join installs with uninstalls and compute days-to-uninstall.  
SELECT i.user_pseudo_id,
       i.install_ts,
       u.uninstall_ts,
       (u.uninstall_ts - i.install_ts)/1e6/60/60/24 AS days_to_uninstall   -- μs → days
FROM  (
        SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
        FROM  `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
          AND event_name = 'first_open'
        GROUP BY user_pseudo_id
      ) AS i
LEFT JOIN (
        SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
        FROM  `firebase-public-project.analytics_153293282.events_*`
        WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
          AND event_name = 'app_remove'
        GROUP BY user_pseudo_id
      ) AS u
USING (user_pseudo_id)
LIMIT 20;
```

```sql
--Description: 7) Classify every installer into the three buckets needed.  
SELECT user_pseudo_id,
       CASE
         WHEN uninstall_ts IS NULL                       THEN 'never_uninstalled'
         WHEN (uninstall_ts - install_ts) > 7*24*60*60*1e6 THEN 'uninstalled_after_7_days'
         ELSE 'uninstalled_within_7_days'
       END AS uninstall_bucket
FROM (
      -- reuse joined table from step 6
      SELECT i.user_pseudo_id,
             i.install_ts,
             u.uninstall_ts
      FROM  (
              SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
              FROM  `firebase-public-project.analytics_153293282.events_*`
              WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
                AND event_name = 'first_open'
              GROUP BY user_pseudo_id
            ) i
      LEFT JOIN (
              SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
              FROM  `firebase-public-project.analytics_153293282.events_*`
              WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
                AND event_name = 'app_remove'
              GROUP BY user_pseudo_id
            ) u
      USING (user_pseudo_id)
     )
LIMIT 20;
```

```sql
--Description: 8) Count users in each bucket.  
SELECT uninstall_bucket,
       COUNT(*) AS users
FROM (
      -- same derived table as step 7
      SELECT user_pseudo_id,
             CASE
               WHEN uninstall_ts IS NULL                       THEN 'never_uninstalled'
               WHEN (uninstall_ts - install_ts) > 7*24*60*60*1e6 THEN 'uninstalled_after_7_days'
               ELSE 'uninstalled_within_7_days'
             END AS uninstall_bucket
      FROM (
            SELECT i.user_pseudo_id,
                   i.install_ts,
                   u.uninstall_ts
            FROM  (
                    SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
                    FROM  `firebase-public-project.analytics_153293282.events_*`
                    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
                      AND event_name = 'first_open'
                    GROUP BY user_pseudo_id
                  ) i
            LEFT JOIN (
                    SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
                    FROM  `firebase-public-project.analytics_153293282.events_*`
                    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
                      AND event_name = 'app_remove'
                    GROUP BY user_pseudo_id
                  ) u
            USING (user_pseudo_id)
           )
     )
GROUP BY uninstall_bucket
LIMIT 20;
```

```sql
--Description: 9) Compute the percentage of users that EITHER never uninstalled OR did so after 7 days.  
WITH buckets AS (
  SELECT user_pseudo_id,
         CASE
           WHEN uninstall_ts IS NULL                       THEN 'never_uninstalled'
           WHEN (uninstall_ts - install_ts) > 7*24*60*60*1e6 THEN 'uninstalled_after_7_days'
           ELSE 'uninstalled_within_7_days'
         END AS uninstall_bucket
  FROM (
        SELECT i.user_pseudo_id,
               i.install_ts,
               u.uninstall_ts
        FROM  (
                SELECT user_pseudo_id, MIN(event_timestamp) AS install_ts
                FROM  `firebase-public-project.analytics_153293282.events_*`
                WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
                  AND event_name = 'first_open'
                GROUP BY user_pseudo_id
              ) i
        LEFT JOIN (
                SELECT user_pseudo_id, MIN(event_timestamp) AS uninstall_ts
                FROM  `firebase-public-project.analytics_153293282.events_*`
                WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
                  AND event_name = 'app_remove'
                GROUP BY user_pseudo_id
              ) u
        USING (user_pseudo_id)
       )
)
SELECT
  ROUND( 100.0 * SUM(CASE WHEN uninstall_bucket IN ('never_uninstalled',
                                                   'uninstalled_after_7_days') THEN 1 END)
        / COUNT(*), 2) AS pct_retained_or_long_uninstall
FROM buckets
LIMIT 20;
```

