--Description / Thinking process:  
-- Goal: % of users who installed (first_open) in Aug–Sep 2018 and did NOT uninstall
--       within 7 days (i.e., either never triggered app_remove or did so >7 days later).
-- Steps  
--   1. installs CTE: earliest first_open per user between 2018-08-01 and 2018-09-30.  
--   2. uninstalls CTE: earliest app_remove per user between 2018-08-01 and 2018-10-31  
--      (gives an extra month to capture removals).  
--   3. joined CTE: left-join; retained_flag = 1 when uninstall_ts is NULL or the gap  
--      exceeds 7 days (7*24*60*60*1,000,000 µs).  
--   4. Final select: aggregate retained users, total installers, and percentage.  
WITH installs AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20181031'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
),
joined AS (
  SELECT
    i.user_pseudo_id,
    IF(
         u.uninstall_ts IS NULL
         OR (u.uninstall_ts - i.install_ts) > 7*24*60*60*1000000,
         1, 0
       ) AS retained_flag
  FROM installs i
  LEFT JOIN uninstalls u USING (user_pseudo_id)
)
SELECT
  SUM(retained_flag)                           AS retained_users,
  COUNT(*)                                     AS total_installed_users,
  ROUND(100 * SUM(retained_flag)/COUNT(*), 2)  AS percent_retained_7day_or_never
FROM joined;
