```sql
--Description: 7) For every installing user, find the time-difference (in days) to their first uninstall (if any)  
SELECT
  install.user_pseudo_id,
  DATE_DIFF(DATE(TIMESTAMP_MICROS(remove.event_timestamp)),
            DATE(TIMESTAMP_MICROS(install.event_timestamp)),
            DAY) AS days_to_uninstall
FROM (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
) AS install
LEFT JOIN (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS event_timestamp
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
) AS remove
ON install.user_pseudo_id = remove.user_pseudo_id
LIMIT 20;
```

```sql
--Description: 8) Count how many Aug-Sep installers uninstalled within 7 days  
WITH diff AS (
  SELECT
    install.user_pseudo_id,
    DATE_DIFF(DATE(TIMESTAMP_MICROS(remove.event_timestamp)),
              DATE(TIMESTAMP_MICROS(install.event_timestamp)),
              DAY) AS days_to_uninstall
  FROM (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS event_timestamp
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'first_open'
    GROUP BY user_pseudo_id
  ) AS install
  JOIN (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS event_timestamp
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'app_remove'
    GROUP BY user_pseudo_id
  ) AS remove
  ON install.user_pseudo_id = remove.user_pseudo_id
)
SELECT COUNT(*) AS uninstall_within_7d
FROM diff
WHERE days_to_uninstall <= 7
LIMIT 20;
```

```sql
--Description: 9) Count installers who NEVER uninstalled or uninstalled after 7 days  
WITH firsts AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
removes AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  COUNT(*) AS good_users
FROM firsts f
LEFT JOIN removes r
ON f.user_pseudo_id = r.user_pseudo_id
WHERE r.uninstall_ts IS NULL
   OR DATE_DIFF(DATE(TIMESTAMP_MICROS(r.uninstall_ts)),
                DATE(TIMESTAMP_MICROS(f.install_ts)),
                DAY) > 7
LIMIT 20;
```

```sql
--Description: 10) Final query – percentage of August-September installers who did NOT uninstall within 7 days  
WITH installs AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
),
combined AS (
  SELECT
    i.user_pseudo_id,
    DATE_DIFF(
      DATE(TIMESTAMP_MICROS(u.uninstall_ts)),
      DATE(TIMESTAMP_MICROS(i.install_ts)),
      DAY) AS days_to_uninstall
  FROM installs i
  LEFT JOIN uninstalls u
  ON i.user_pseudo_id = u.user_pseudo_id
)
SELECT
  ROUND(100 * SUM(
           CASE
             WHEN days_to_uninstall IS NULL THEN 1          -- never uninstalled
             WHEN days_to_uninstall > 7 THEN 1              -- uninstalled but after 7 days
             ELSE 0
           END
         ) / COUNT(*), 2) AS pct_not_uninstall_within_7d
FROM combined
LIMIT 20;
```
