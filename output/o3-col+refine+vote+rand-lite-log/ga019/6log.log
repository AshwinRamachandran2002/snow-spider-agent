uninstall_within_7d
783
Query:
--Description: 9) Count installers who NEVER uninstalled or uninstalled after 7 days  
WITH firsts AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
removes AS (
  SELECT user_pseudo_id,
         MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  COUNT(*) AS good_users
FROM firsts f
LEFT JOIN removes r
ON f.user_pseudo_id = r.user_pseudo_id
WHERE r.uninstall_ts IS NULL
   OR DATE_DIFF(DATE(TIMESTAMP_MICROS(r.uninstall_ts)),
                DATE(TIMESTAMP_MICROS(f.install_ts)),
                DAY) > 7
LIMIT 20;
