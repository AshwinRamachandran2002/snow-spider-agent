Query:
--Description: 8) Count how many Aug-Sep installers uninstalled within 7 days  
WITH diff AS (
  SELECT
    install.user_pseudo_id,
    DATE_DIFF(DATE(TIMESTAMP_MICROS(remove.event_timestamp)),
              DATE(TIMESTAMP_MICROS(install.event_timestamp)),
              DAY) AS days_to_uninstall
  FROM (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS event_timestamp
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'first_open'
    GROUP BY user_pseudo_id
  ) AS install
  JOIN (
    SELECT user_pseudo_id,
           MIN(event_timestamp) AS event_timestamp
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
      AND event_name = 'app_remove'
    GROUP BY user_pseudo_id
  ) AS remove
  ON install.user_pseudo_id = remove.user_pseudo_id
)
SELECT COUNT(*) AS uninstall_within_7d
FROM diff
WHERE days_to_uninstall <= 7
LIMIT 20;
