Query:
--Description: 6. For every user who installed in Aug-Sep, record their FIRST install date (earliest first_open)  
WITH installs AS (
  SELECT
      user_pseudo_id,
      MIN(PARSE_DATE('%Y%m%d', event_date))                  AS install_date,
      MIN(event_timestamp)                                   AS install_ts
  FROM  `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
)
SELECT *
FROM installs
LIMIT 20;
