Query:
--Description: 7)  Among those installs, count how many users uninstalled within
--             7 days (first “app_remove” minus first “first_open” ≤ 7 days).
WITH installs AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  COUNT(DISTINCT i.user_pseudo_id) AS uninstall_within_7d
FROM installs i
JOIN uninstalls u
ON  i.user_pseudo_id = u.user_pseudo_id
WHERE (u.uninstall_ts - i.install_ts) <= 7 * 86400 * 1e6   -- 7 days in µs
LIMIT 20
