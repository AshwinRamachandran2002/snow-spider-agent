Query:
--Description: 5)  For a sample of users: show their first “first_open” timestamp
--             (install) in Aug-Sep 2018 and the first “app_remove” timestamp (if any),
--             plus the day gap between the two.
WITH installs AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  i.user_pseudo_id,
  i.install_ts,
  u.uninstall_ts,
  ROUND( (u.uninstall_ts - i.install_ts) / 1e6 / 86400 , 2) AS days_between
FROM installs i
LEFT JOIN uninstalls u
ON  i.user_pseudo_id = u.user_pseudo_id
LIMIT 20
