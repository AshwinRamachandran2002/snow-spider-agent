```sql
--Description: 4)  Peek at some “app_remove” (un-install) events in the same period  
SELECT `_TABLE_SUFFIX`    AS `event_table`,
       `event_date`,
       `user_pseudo_id`,
       `event_timestamp`
FROM   `firebase-public-project.analytics_153293282.events_2018*`
WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
  AND  `event_name` = 'app_remove'
LIMIT  20;
```

```sql
--Description: 5)  For a few users, show install time and the very first uninstall (if any) plus the day-gap  
WITH installs AS (
  SELECT `user_pseudo_id`,
         MIN(`event_timestamp`) AS install_ts
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'first_open'
  GROUP  BY `user_pseudo_id`
), uninstalls AS (
  SELECT `user_pseudo_id`,
         MIN(`event_timestamp`) AS uninstall_ts
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'app_remove'
  GROUP  BY `user_pseudo_id`
)
SELECT i.user_pseudo_id,
       i.install_ts,
       u.uninstall_ts,
       ROUND( (u.uninstall_ts - i.install_ts) / 1e6 / 86400 , 2) AS days_between
FROM   installs i
LEFT JOIN uninstalls u
ON     i.user_pseudo_id = u.user_pseudo_id
LIMIT  20;
```

```sql
--Description: 6)  How many total installs happened in Aug-Sep 2018?  
SELECT COUNT(DISTINCT `user_pseudo_id`) AS total_installs
FROM   `firebase-public-project.analytics_153293282.events_2018*`
WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
  AND  `event_name` = 'first_open'
LIMIT  20;
```

```sql
--Description: 7)  How many of those users produced an uninstall within 7 days of their install?  
WITH installs AS (
  SELECT `user_pseudo_id`,
         MIN(`event_timestamp`) AS install_ts
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'first_open'
  GROUP  BY `user_pseudo_id`
), uninstalls AS (
  SELECT `user_pseudo_id`,
         MIN(`event_timestamp`) AS uninstall_ts
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'app_remove'
  GROUP  BY `user_pseudo_id`
)
SELECT COUNT(DISTINCT i.user_pseudo_id) AS uninstall_within_7d
FROM   installs i
JOIN   uninstalls u
ON     i.user_pseudo_id = u.user_pseudo_id
WHERE  (u.uninstall_ts - i.install_ts) <= 7*86400*1e6   -- 7 days in micro-seconds
LIMIT  20;
```

```sql
--Description: 8)  How many installs ever produced an uninstall (no time limit)?  
WITH installs AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'first_open'
), uninstalls AS (
  SELECT DISTINCT `user_pseudo_id`
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'app_remove'
)
SELECT COUNT(DISTINCT installs.user_pseudo_id)              AS installs,
       COUNT(DISTINCT uninstalls.user_pseudo_id)            AS ever_uninstalled
FROM   installs
LEFT JOIN uninstalls
ON     installs.user_pseudo_id = uninstalls.user_pseudo_id
LIMIT  20;
```

```sql
--Description: 9)  Final percentage of users who EITHER never uninstalled OR uninstalled after 7 days  
WITH installs AS (
  SELECT `user_pseudo_id`,
         MIN(`event_timestamp`) AS install_ts
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'first_open'
  GROUP  BY `user_pseudo_id`
), uninstalls AS (
  SELECT `user_pseudo_id`,
         MIN(`event_timestamp`) AS uninstall_ts
  FROM   `firebase-public-project.analytics_153293282.events_2018*`
  WHERE  `_TABLE_SUFFIX` BETWEEN '20180801' AND '20180930'
    AND  `event_name` = 'app_remove'
  GROUP  BY `user_pseudo_id`
)
SELECT
  COUNT(DISTINCT installs.user_pseudo_id)                                         AS total_installs,
  COUNTIF( u.uninstall_ts IS NULL
           OR (u.uninstall_ts - installs.install_ts) > 7*86400*1e6 )              AS kept_7d_or_more,
  ROUND( 100 * COUNTIF( u.uninstall_ts IS NULL
                        OR (u.uninstall_ts - installs.install_ts) > 7*86400*1e6 )
           / COUNT(DISTINCT installs.user_pseudo_id), 2)                          AS pct_kept_7d_or_more
FROM   installs
LEFT JOIN uninstalls u
ON     installs.user_pseudo_id = u.user_pseudo_id
LIMIT  20;
```
