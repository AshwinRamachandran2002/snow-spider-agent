Query:
--Description: 9)  Final metric: percentage of Aug-Sep installers who EITHER never
--             uninstalled or uninstalled more than 7 days after install.
WITH installs AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS install_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
  GROUP BY user_pseudo_id
),
uninstalls AS (
  SELECT
    user_pseudo_id,
    MIN(event_timestamp) AS uninstall_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
  GROUP BY user_pseudo_id
)
SELECT
  COUNT(DISTINCT installs.user_pseudo_id) AS total_installs,
  COUNTIF( u.uninstall_ts IS NULL
        OR (u.uninstall_ts - installs.install_ts) > 7 * 86400 * 1e6 ) 
      AS kept_7d_or_more,
  ROUND(
    100 * COUNTIF( u.uninstall_ts IS NULL
                OR (u.uninstall_ts - installs.install_ts) > 7 * 86400 * 1e6 )
      / COUNT(DISTINCT installs.user_pseudo_id)
  , 2) AS pct_kept_7d_or_more
FROM installs
LEFT JOIN uninstalls u
ON installs.user_pseudo_id = u.user_pseudo_id
LIMIT 20
Answer:
total_installs,kept_7d_or_more,pct_kept_7d_or_more
