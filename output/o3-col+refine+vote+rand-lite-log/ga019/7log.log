--Description: 4)  Peek at some “app_remove” (un-install) events that occurred between
--             1-Aug-2018 and 30-Sep-2018.  Uses the wildcard `events_*` (all daily
--             tables) and limits to 20 rows.
SELECT
  _TABLE_SUFFIX  AS event_table,
  event_date,
  user_pseudo_id,
  event_timestamp
FROM
  `firebase-public-project.analytics_153293282.events_*`
WHERE
  _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
  AND event_name   = 'app_remove'
LIMIT 20
