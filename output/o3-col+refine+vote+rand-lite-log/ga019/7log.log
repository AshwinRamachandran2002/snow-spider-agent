Query:
--Description: 8)  How many Aug-Sep installs ever produced an uninstall (any time
--             during the two-month window)?
WITH installs AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'first_open'
),
uninstalls AS (
  SELECT DISTINCT user_pseudo_id
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180801' AND '20180930'
    AND event_name = 'app_remove'
)
SELECT
  COUNT(DISTINCT installs.user_pseudo_id)   AS installs,
  COUNT(DISTINCT uninstalls.user_pseudo_id) AS ever_uninstalled
FROM installs
LEFT JOIN uninstalls
ON installs.user_pseudo_id = uninstalls.user_pseudo_id
LIMIT 20
