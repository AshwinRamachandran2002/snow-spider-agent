```sql
--Description: Inspect a sample of the preference rows that customers have recorded  
SELECT DISTINCT "CustomerID", "StyleID", "PreferenceSeq"
FROM   "Musical_Preferences"
LIMIT  20;
```

```sql
--Description: Check which preference-sequence positions are actually used (1st / 2nd / 3rd / …)  
SELECT DISTINCT "PreferenceSeq"
FROM   "Musical_Preferences"
LIMIT  20;
```

```sql
--Description: Join the two tables to see how each style shows up in customers’ preference lists  
SELECT DISTINCT p."CustomerID",
                s."StyleName",
                p."PreferenceSeq"
FROM   "Musical_Preferences" AS p
JOIN   "Musical_Styles"      AS s ON s."StyleID" = p."StyleID"
LIMIT  20;
```

```sql
--Description: Count how many total preferences (all positions) each style has received  
SELECT s."StyleName",
       COUNT(*) AS "TotalPreferenceCnt"
FROM   "Musical_Styles"      AS s
JOIN   "Musical_Preferences" AS p ON s."StyleID" = p."StyleID"
GROUP  BY s."StyleName"
ORDER  BY "TotalPreferenceCnt" DESC
LIMIT  20;
```

```sql
--Description: Break the counts down by preference-sequence (still one row per style *and* sequence)  
SELECT s."StyleName",
       p."PreferenceSeq",
       COUNT(*) AS "PrefCnt"
FROM   "Musical_Styles"      AS s
JOIN   "Musical_Preferences" AS p ON s."StyleID" = p."StyleID"
GROUP  BY s."StyleName", p."PreferenceSeq"
ORDER  BY s."StyleName", p."PreferenceSeq"
LIMIT  20;
```

```sql
--Description: FINAL ANSWER – put the 1st, 2nd, and 3rd-preference counts side-by-side in one row per style  
SELECT s."StyleName",
       SUM(CASE WHEN p."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPreferenceCnt",
       SUM(CASE WHEN p."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPreferenceCnt",
       SUM(CASE WHEN p."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPreferenceCnt"
FROM   "Musical_Styles"      AS s
LEFT JOIN "Musical_Preferences" AS p
       ON s."StyleID" = p."StyleID"
GROUP  BY s."StyleID", s."StyleName"
ORDER  BY s."StyleName"
LIMIT  20;
```
