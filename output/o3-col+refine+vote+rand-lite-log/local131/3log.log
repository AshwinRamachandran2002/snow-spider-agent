Query:
--Description: Count how many times each style is chosen as 3rd preference.
SELECT   ms."StyleName",
         COUNT(*) AS "ThirdPrefCnt"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 3
GROUP BY ms."StyleName"
ORDER BY COUNT(*) DESC
LIMIT    20;
Answer:
