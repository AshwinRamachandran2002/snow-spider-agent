```sql
--Description: Look at all distinct music styles defined in the dictionary table.
SELECT DISTINCT "StyleID",
       "StyleName"
FROM   "Musical_Styles"
LIMIT  20;
```

```sql
--Description: See how customers express their musical preferences
--(StyleID together with the sequence position 1-3).
SELECT DISTINCT "CustomerID",
       "StyleID",
       "PreferenceSeq"
FROM   "Musical_Preferences"
LIMIT  20;
```

```sql
--Description: Count how many total preferences (any sequence) each style has
--to get a feel for the distribution before splitting it up by 1st/2nd/3rd.
SELECT   "StyleID",
         COUNT(*) AS "TotalPreferences"
FROM     "Musical_Preferences"
GROUP BY "StyleID"
ORDER BY COUNT(*) DESC
LIMIT    20;
```

```sql
--Description: Add the style name to the previous count so that it is readable.
SELECT   ms."StyleName",
         mp."StyleID",
         COUNT(*) AS "TotalPreferences"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
GROUP BY mp."StyleID", ms."StyleName"
ORDER BY COUNT(*) DESC
LIMIT    20;
```

```sql
--Description: Count how many times each style is chosen as 1st preference.
SELECT   ms."StyleName",
         COUNT(*) AS "FirstPrefCnt"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 1
GROUP BY ms."StyleName"
ORDER BY COUNT(*) DESC
LIMIT    20;
```

```sql
--Description: Count how many times each style is chosen as 2nd preference.
SELECT   ms."StyleName",
         COUNT(*) AS "SecondPrefCnt"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 2
GROUP BY ms."StyleName"
ORDER BY COUNT(*) DESC
LIMIT    20;
```

```sql
--Description: Count how many times each style is chosen as 3rd preference.
SELECT   ms."StyleName",
         COUNT(*) AS "ThirdPrefCnt"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
WHERE    mp."PreferenceSeq" = 3
GROUP BY ms."StyleName"
ORDER BY COUNT(*) DESC
LIMIT    20;
```

```sql
--Description: Put the previous three counts together so that each musical style
--appears once with its 1st, 2nd, and 3rd-preference counts in separate columns.
SELECT   ms."StyleName",
         SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPrefCnt",
         SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPrefCnt",
         SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPrefCnt"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleName"
ORDER BY ms."StyleName"
LIMIT    20;
```
