Classical,1
80's Music,1
40's Ballroom Music,1
Query:
--Description: Put the previous three counts together so that each musical style
--appears once with its 1st, 2nd, and 3rd-preference counts in separate columns.
SELECT   ms."StyleName",
         SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPrefCnt",
         SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPrefCnt",
         SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPrefCnt"
FROM     "Musical_Preferences" AS mp
JOIN     "Musical_Styles"      AS ms
       ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleName"
ORDER BY ms."StyleName"
LIMIT    20;
