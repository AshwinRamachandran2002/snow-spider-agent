LIMIT 20;
```

```sql
-- Description: List all musical styles that exist in the catalog.
SELECT DISTINCT "StyleID",
                "StyleName"
FROM "Musical_Styles"
LIMIT 20;
```

```sql
-- Description: Join preferences to style names so we can see the text label that goes with each StyleID.
SELECT mp."CustomerID",
       mp."StyleID",
       ms."StyleName",
       mp."PreferenceSeq"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms
       ON mp."StyleID" = ms."StyleID"
LIMIT 20;
```

```sql
-- Description: Count how many times every style is chosen as the 1st preference.
SELECT ms."StyleName",
       COUNT(*) AS "FirstPrefCount"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms
       ON mp."StyleID" = ms."StyleID"
WHERE  mp."PreferenceSeq" = 1
GROUP BY ms."StyleName"
ORDER BY "FirstPrefCount" DESC
LIMIT 20;
```

```sql
-- Description: Count how many times every style is chosen as the 2nd preference.
SELECT ms."StyleName",
       COUNT(*) AS "SecondPrefCount"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms
       ON mp."StyleID" = ms."StyleID"
WHERE  mp."PreferenceSeq" = 2
GROUP BY ms."StyleName"
ORDER BY "SecondPrefCount" DESC
LIMIT 20;
```

```sql
-- Description: Count how many times every style is chosen as the 3rd preference.
SELECT ms."StyleName",
       COUNT(*) AS "ThirdPrefCount"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms
       ON mp."StyleID" = ms."StyleID"
WHERE  mp."PreferenceSeq" = 3
GROUP BY ms."StyleName"
ORDER BY "ThirdPrefCount" DESC
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – one row per style showing how often it is picked 1st, 2nd, or 3rd.
SELECT ms."StyleID",
       ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPrefCount"
FROM   "Musical_Styles"      AS ms
LEFT JOIN "Musical_Preferences" AS mp
       ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleID",
         ms."StyleName"
ORDER BY ms."StyleID"
LIMIT 20;
```
