```sql
--Description: Look at a sample of musical styles that exist in the catalog
SELECT DISTINCT "StyleID",
                "StyleName"
FROM   "Musical_Styles"
LIMIT  20;
```

```sql
--Description: Inspect every recorded musical-preference entry (customer ↔ style ↔ preference order)
SELECT *
FROM   "Musical_Preferences"
LIMIT  20;
```

```sql
--Description: Verify which preference positions (1st, 2nd, 3rd …) are in use
SELECT DISTINCT "PreferenceSeq"
FROM   "Musical_Preferences"
LIMIT  20;
```

```sql
--Description: How many total choices were recorded for each preference position?
SELECT   "PreferenceSeq",
         COUNT(*) AS "PrefCount"
FROM     "Musical_Preferences"
GROUP BY "PreferenceSeq"
LIMIT    20;
```

```sql
--Description: Count how often each style is chosen as the 1st preference
SELECT   "StyleID",
         COUNT(*) AS "Pref1Count"
FROM     "Musical_Preferences"
WHERE    "PreferenceSeq" = 1
GROUP BY "StyleID"
LIMIT    20;
```

```sql
--Description: Count how often each style is chosen as the 2nd preference
SELECT   "StyleID",
         COUNT(*) AS "Pref2Count"
FROM     "Musical_Preferences"
WHERE    "PreferenceSeq" = 2
GROUP BY "StyleID"
LIMIT    20;
```

```sql
--Description: Count how often each style is chosen as the 3rd preference
SELECT   "StyleID",
         COUNT(*) AS "Pref3Count"
FROM     "Musical_Preferences"
WHERE    "PreferenceSeq" = 3
GROUP BY "StyleID"
LIMIT    20;
```

```sql
--Description: Bring the above three counts together in one pass, one row per style
SELECT   "StyleID",
         SUM(CASE WHEN "PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPref",
         SUM(CASE WHEN "PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPref",
         SUM(CASE WHEN "PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPref"
FROM     "Musical_Preferences"
GROUP BY "StyleID"
LIMIT    20;
```

```sql
--Description: Attach the human-readable style name to the aggregated counts
SELECT   ms."StyleName",
         mp."FirstPref",
         mp."SecondPref",
         mp."ThirdPref"
FROM   ( SELECT   "StyleID",
                 SUM(CASE WHEN "PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPref",
                 SUM(CASE WHEN "PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPref",
                 SUM(CASE WHEN "PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPref"
         FROM     "Musical_Preferences"
         GROUP BY "StyleID"
       ) AS mp
JOIN   "Musical_Styles" AS ms
       ON ms."StyleID" = mp."StyleID"
LIMIT 20;
```

```sql
--Description: (Final) Present every musical style with its 1st, 2nd, and 3rd-preference counts, unsuppressed
SELECT   ms."StyleName",
         mp."FirstPref",
         mp."SecondPref",
         mp."ThirdPref"
FROM   ( SELECT   "StyleID",
                 SUM(CASE WHEN "PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPref",
                 SUM(CASE WHEN "PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPref",
                 SUM(CASE WHEN "PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPref"
         FROM     "Musical_Preferences"
         GROUP BY "StyleID"
       ) AS mp
JOIN   "Musical_Styles" AS ms
       ON ms."StyleID" = mp."StyleID";
```
