```sql
--Description: 1) Inspect all musical styles available. 
SELECT DISTINCT "StyleID", "StyleName"
FROM "Musical_Styles"
LIMIT 20;
```

```sql
--Description: 2) Look at a sample of customer musical‐preference rows. 
SELECT "CustomerID", "StyleID", "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: 3) See the different preference-sequence numbers that actually occur. 
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: 4) Join musical styles to preferences so we can read the style names attached to each preference record. 
SELECT mp."CustomerID",
       ms."StyleName",
       mp."PreferenceSeq"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
LIMIT 20;
```

```sql
--Description: 5) Count total (all sequences combined) preference occurrences for each style. 
SELECT ms."StyleName",
       COUNT(*) AS "Total_Preferences"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
GROUP  BY ms."StyleName"
ORDER  BY "Total_Preferences" DESC
LIMIT 20;
```

```sql
--Description: 6) Count how many times each style is a 1st preference (PreferenceSeq = 1). 
SELECT ms."StyleName",
       COUNT(*) AS "First_Pref_Count"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
WHERE  mp."PreferenceSeq" = 1
GROUP  BY ms."StyleName"
ORDER  BY "First_Pref_Count" DESC
LIMIT 20;
```

```sql
--Description: 7) Count how many times each style is a 2nd preference (PreferenceSeq = 2). 
SELECT ms."StyleName",
       COUNT(*) AS "Second_Pref_Count"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
WHERE  mp."PreferenceSeq" = 2
GROUP  BY ms."StyleName"
ORDER  BY "Second_Pref_Count" DESC
LIMIT 20;
```

```sql
--Description: 8) Produce, in one row per style, the number of times it appears as a 1st, 2nd, or 3rd preference. 
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "First_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Second_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Third_Pref"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
GROUP  BY ms."StyleName"
ORDER  BY ms."StyleName"
LIMIT 20;
```

```sql
--Description: 9) Same as (8) but showing the underlying StyleID as well for easy reconciliation. 
SELECT ms."StyleID",
       ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "First_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Second_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Third_Pref"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
GROUP  BY ms."StyleID", ms."StyleName"
ORDER  BY ms."StyleID"
LIMIT 20;
```

```sql
--Description: 10) Show only those styles that have at least one 1st, 2nd, or 3rd preference (filters out styles never chosen). 
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "First_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Second_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Third_Pref"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
GROUP  BY ms."StyleName"
HAVING "First_Pref" > 0
    OR "Second_Pref" > 0
    OR "Third_Pref" > 0
ORDER  BY ms."StyleName"
LIMIT 20;
```
