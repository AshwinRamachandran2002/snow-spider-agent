Query:
--Description: 5) Count total (all sequences combined) preference occurrences for each style. 
SELECT ms."StyleName",
       COUNT(*) AS "Total_Preferences"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
GROUP  BY ms."StyleName"
ORDER  BY "Total_Preferences" DESC
LIMIT 20;
