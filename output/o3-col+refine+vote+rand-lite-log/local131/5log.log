Query:
--Description: 6) Count how many times each style is a 1st preference (PreferenceSeq = 1). 
SELECT ms."StyleName",
       COUNT(*) AS "First_Pref_Count"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
WHERE  mp."PreferenceSeq" = 1
GROUP  BY ms."StyleName"
ORDER  BY "First_Pref_Count" DESC
LIMIT 20;
