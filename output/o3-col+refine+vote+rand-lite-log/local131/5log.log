Query:
--Description: 10) Show only those styles that have at least one 1st, 2nd, or 3rd preference (filters out styles never chosen). 
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "First_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Second_Pref",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Third_Pref"
FROM   "Musical_Preferences" AS mp
JOIN   "Musical_Styles"      AS ms USING ("StyleID")
GROUP  BY ms."StyleName"
HAVING "First_Pref" > 0
    OR "Second_Pref" > 0
    OR "Third_Pref" > 0
ORDER  BY ms."StyleName"
LIMIT 20;
