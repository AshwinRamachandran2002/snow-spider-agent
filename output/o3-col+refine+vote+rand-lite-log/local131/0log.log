```

```sql
--Description: Check how many total 1st, 2nd, or 3rd-place votes exist in the data.
SELECT mp."PreferenceSeq", COUNT(*) AS "PreferenceCount"
FROM "Musical_Preferences" AS mp
GROUP BY mp."PreferenceSeq"
LIMIT 20;
```

```sql
--Description: Count how many 1st-place votes each style has received.
SELECT ms."StyleName",
       COUNT(*) AS "FirstPrefCount"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"      AS ms ON ms."StyleID" = mp."StyleID"
WHERE mp."PreferenceSeq" = 1
GROUP BY ms."StyleName"
ORDER BY "FirstPrefCount" DESC
LIMIT 20;
```

```sql
--Description: Count how many 2nd-place votes each style has received.
SELECT ms."StyleName",
       COUNT(*) AS "SecondPrefCount"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"      AS ms ON ms."StyleID" = mp."StyleID"
WHERE mp."PreferenceSeq" = 2
GROUP BY ms."StyleName"
ORDER BY "SecondPrefCount" DESC
LIMIT 20;
```

```sql
--Description: Count how many 3rd-place votes each style has received.
SELECT ms."StyleName",
       COUNT(*) AS "ThirdPrefCount"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"      AS ms ON ms."StyleID" = mp."StyleID"
WHERE mp."PreferenceSeq" = 3
GROUP BY ms."StyleName"
ORDER BY "ThirdPrefCount" DESC
LIMIT 20;
```

```sql
--Description: Produce one row per style, showing 1st, 2nd, and 3rd vote totals side-by-side.
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPrefCount"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"      AS ms ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleName"
LIMIT 20;
```

```sql
--Description: Same as above, but alphabetically by style name.
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPrefCount"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"      AS ms ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleName"
ORDER BY ms."StyleName"
LIMIT 20;
```

```sql
--Description: Same pivoted view but ranked by number of 1st-place votes (highest first).
SELECT ms."StyleName",
       SUM(CASE WHEN mp."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "FirstPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "SecondPrefCount",
       SUM(CASE WHEN mp."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "ThirdPrefCount"
FROM "Musical_Preferences" AS mp
JOIN "Musical_Styles"      AS ms ON ms."StyleID" = mp."StyleID"
GROUP BY ms."StyleName"
ORDER BY "FirstPrefCount" DESC
LIMIT 20;
```
