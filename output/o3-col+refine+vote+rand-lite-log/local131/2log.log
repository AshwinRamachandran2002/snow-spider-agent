```sql
--Description: 1) Inspect the preference ranks recorded in the data  
SELECT DISTINCT "PreferenceSeq"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: 2) See which style IDs customers have chosen in their preferences  
SELECT DISTINCT "StyleID"
FROM "Musical_Preferences"
LIMIT 20;
```

```sql
--Description: 3) Look up the readable style names for the StyleIDs found above  
SELECT DISTINCT s."StyleID", s."StyleName"
FROM "Musical_Styles" AS s
JOIN "Musical_Preferences" AS p
  ON p."StyleID" = s."StyleID"
LIMIT 20;
```

```sql
--Description: 4) Verify the raw preference rows for one style (e.g., StyleID = 3)  
SELECT *
FROM "Musical_Preferences"
WHERE "StyleID" = 3
LIMIT 20;
```

```sql
--Description: 5) Count how many times each style is chosen at each individual rank  
SELECT s."StyleName",
       p."PreferenceSeq",
       COUNT(*) AS "cnt"
FROM "Musical_Preferences" AS p
JOIN "Musical_Styles" AS s
  ON s."StyleID" = p."StyleID"
GROUP BY s."StyleName", p."PreferenceSeq"
ORDER BY s."StyleName", p."PreferenceSeq"
LIMIT 20;
```

```sql
--Description: 6) Show total first-choice counts for every style only  
SELECT s."StyleName",
       COUNT(*) AS "first_pref_cnt"
FROM "Musical_Preferences" AS p
JOIN "Musical_Styles" AS s
  ON s."StyleID" = p."StyleID"
WHERE p."PreferenceSeq" = 1
GROUP BY s."StyleName"
ORDER BY "first_pref_cnt" DESC
LIMIT 20;
```

```sql
--Description: 7) Produce a pivot-style view: counts of 1st, 2nd, 3rd preferences in separate columns  
SELECT s."StyleName",
       SUM(CASE WHEN p."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "Pref1_cnt",
       SUM(CASE WHEN p."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Pref2_cnt",
       SUM(CASE WHEN p."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Pref3_cnt"
FROM "Musical_Styles" AS s
LEFT JOIN "Musical_Preferences" AS p
       ON p."StyleID" = s."StyleID"
GROUP BY s."StyleName"
ORDER BY s."StyleName"
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – list every musical style with the number of times it appears as 1st, 2nd, and 3rd preference in one row per style  
SELECT s."StyleID",
       s."StyleName",
       SUM(CASE WHEN p."PreferenceSeq" = 1 THEN 1 ELSE 0 END) AS "Pref1_Count",
       SUM(CASE WHEN p."PreferenceSeq" = 2 THEN 1 ELSE 0 END) AS "Pref2_Count",
       SUM(CASE WHEN p."PreferenceSeq" = 3 THEN 1 ELSE 0 END) AS "Pref3_Count"
FROM "Musical_Styles" AS s
LEFT JOIN "Musical_Preferences" AS p
       ON p."StyleID" = s."StyleID"
GROUP BY s."StyleID", s."StyleName"
ORDER BY s."StyleID"
LIMIT 20;
```
