Query:
--Description: Count how many cohort users come back in week-1 / 2 / 3  
WITH cohort AS (
  SELECT `user_pseudo_id`,
         MIN(TIMESTAMP_MICROS(`event_timestamp`)) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180831' AND '20180907'
    AND `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
follow AS (
  SELECT `user_pseudo_id`,
         TIMESTAMP_MICROS(`event_timestamp`) AS evt_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
)
SELECT DATE_DIFF(DATE(evt_ts, "Asia/Shanghai"),
                 DATE(first_ts, "Asia/Shanghai"), WEEK(MONDAY)) AS week_index,
       COUNT(DISTINCT follow.`user_pseudo_id`)              AS retained_users
FROM  follow
JOIN  cohort USING (`user_pseudo_id`)
WHERE DATE_DIFF(DATE(evt_ts, "Asia/Shanghai"),
                DATE(first_ts, "Asia/Shanghai"), WEEK(MONDAY)) BETWEEN 1 AND 3
GROUP BY week_index
ORDER BY week_index
LIMIT 20;
