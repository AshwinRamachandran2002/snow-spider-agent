)
SELECT
  ROUND(100 * MAX(IF(week_index = 1, users_retained, NULL)) / MAX(cohort_size), 2) AS week1_retention_rate,
  ROUND(100 * MAX(IF(week_index = 2, users_retained, NULL)) / MAX(cohort_size), 2) AS week2_retention_rate,
  ROUND(100 * MAX(IF(week_index = 3, users_retained, NULL)) / MAX(cohort_size), 2) AS week3_retention_rate
FROM retention
CROSS JOIN cohort_cnt;
