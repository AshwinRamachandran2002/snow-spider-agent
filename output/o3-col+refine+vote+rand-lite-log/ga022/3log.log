```sql
--Description: Count how many cohort users come back in week-1 / 2 / 3  
WITH cohort AS (
  SELECT `user_pseudo_id`,
         MIN(TIMESTAMP_MICROS(`event_timestamp`)) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180831' AND '20180907'
    AND `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
follow AS (
  SELECT `user_pseudo_id`,
         TIMESTAMP_MICROS(`event_timestamp`) AS evt_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
)
SELECT DATE_DIFF(DATE(evt_ts, "Asia/Shanghai"),
                 DATE(first_ts, "Asia/Shanghai"), WEEK(MONDAY)) AS week_index,
       COUNT(DISTINCT follow.`user_pseudo_id`)              AS retained_users
FROM  follow
JOIN  cohort USING (`user_pseudo_id`)
WHERE DATE_DIFF(DATE(evt_ts, "Asia/Shanghai"),
                DATE(first_ts, "Asia/Shanghai"), WEEK(MONDAY)) BETWEEN 1 AND 3
GROUP BY week_index
ORDER BY week_index
LIMIT 20;
```

```sql
--Description: FINAL – weekly retention rate (%) for cohort who first opened 1-7 Sep 2018 (Asia/Shanghai)  
WITH cohort AS (
  SELECT `user_pseudo_id`,
         MIN(TIMESTAMP_MICROS(`event_timestamp`)) AS first_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180831' AND '20180907'
    AND `event_name` = 'first_open'
  GROUP BY `user_pseudo_id`
),
events_all AS (
  SELECT e.`user_pseudo_id`,
         TIMESTAMP_MICROS(e.`event_timestamp`) AS evt_ts
  FROM `firebase-public-project.analytics_153293282.events_*` AS e
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
),
retention AS (
  SELECT DATE_DIFF(DATE(evt_ts, "Asia/Shanghai"),
                   DATE(first_ts, "Asia/Shanghai"), WEEK(MONDAY)) AS week_index,
         COUNT(DISTINCT events_all.`user_pseudo_id`)            AS users_retained
  FROM  events_all
  JOIN  cohort USING (`user_pseudo_id`)
  WHERE DATE_DIFF(DATE(evt_ts, "Asia/Shanghai"),
                  DATE(first_ts, "Asia/Shanghai"), WEEK(MONDAY)) BETWEEN 1 AND 3
  GROUP BY week_index
),
cohort_cnt AS (SELECT COUNT(*) AS cohort_size FROM cohort)
SELECT
  ROUND(100 * MAX(IF(week_index = 1, users_retained, NULL)) / cohort_size, 2) AS week1_retention_rate,
  ROUND(100 * MAX(IF(week_index = 2, users_retained, NULL)) / cohort_size, 2) AS week2_retention_rate,
  ROUND(100 * MAX(IF(week_index = 3, users_retained, NULL)) / cohort_size, 2) AS week3_retention_rate
FROM  retention, cohort_cnt
LIMIT 20;
```

The last query returns three columns – the week-1, week-2, and week-3 retention rates for users whose very first `first_open` occurred during 1-7 September 2018 in Shanghai time.
