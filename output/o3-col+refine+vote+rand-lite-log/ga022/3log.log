```sql
--Description / Thinking process:
-- • Cohort definition: users whose FIRST `first_open` (in Shanghai time) falls on 1-7 Sep 2018.  
--   Because GA4 tables are partitioned by UTC date, we fetch partitions 31-Aug-2018 … 07-Sep-2018
--   then filter on Shanghai calendar date.
-- • Retention window: any event made by those users during September 2018.
-- • Metric: N-week retention (weeks start Monday) → week-1, week-2, week-3 after the cohort week.
-- • Steps implemented as CTEs:
--   1) cohort_raw   – raw first_open rows + Shanghai date.  
--   2) cohort       – keep only 1-7 Sep Shanghai, pick MIN timestamp per user.  
--   3) events_all   – all September events (any event_name counts as a return).  
--   4) retention    – join events to cohort, compute week_index (1-3) & count distinct users.  
--   5) cohort_cnt   – size of the cohort (single row).  
-- • Final SELECT pivots week rows into columns and divides by cohort size.  
--   MAX() aggregates single-row values, eliminating “not grouped” errors.

WITH cohort_raw AS (
  SELECT
    user_pseudo_id,
    TIMESTAMP_MICROS(event_timestamp)                                     AS first_ts_utc,
    DATE(TIMESTAMP_MICROS(event_timestamp), 'Asia/Shanghai')              AS first_dt_sh
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180831' AND '20180907'
    AND event_name = 'first_open'
),
cohort AS (
  SELECT
    user_pseudo_id,
    MIN(first_ts_utc) AS first_ts                                         -- earliest first_open per user
  FROM cohort_raw
  WHERE first_dt_sh BETWEEN '2018-09-01' AND '2018-09-07'
  GROUP BY user_pseudo_id
),
events_all AS (
  SELECT
    user_pseudo_id,
    TIMESTAMP_MICROS(event_timestamp) AS evt_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180901' AND '20180930'
),
retention AS (
  SELECT
    DATE_DIFF(DATE(evt_ts, 'Asia/Shanghai'),
              DATE(first_ts, 'Asia/Shanghai'), WEEK(MONDAY)) AS week_index,
    COUNT(DISTINCT events_all.user_pseudo_id)                AS users_retained
  FROM events_all
  JOIN cohort USING (user_pseudo_id)
  WHERE DATE_DIFF(DATE(evt_ts, 'Asia/Shanghai'),
                  DATE(first_ts, 'Asia/Shanghai'), WEEK(MONDAY)) BETWEEN 1 AND 3
  GROUP BY week_index
),
cohort_cnt AS (
  SELECT COUNT(*) AS cohort_size FROM cohort
)
SELECT
  ROUND(100 * MAX(IF(week_index = 1, users_retained, NULL)) / MAX(cohort_size), 2) AS week1_retention_rate,
  ROUND(100 * MAX(IF(week_index = 2, users_retained, NULL)) / MAX(cohort_size), 2) AS week2_retention_rate,
  ROUND(100 * MAX(IF(week_index = 3, users_retained, NULL)) / MAX(cohort_size), 2) AS week3_retention_rate
FROM retention
CROSS JOIN cohort_cnt;
```
