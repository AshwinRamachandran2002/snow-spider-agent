  fullVisitorId,
  MIN(PARSE_DATE('%Y%m%d', date)) AS first_visit_date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 5. First-transaction date for every visitor (sample)  
SELECT
  fullVisitorId,
  MIN(PARSE_DATE('%Y%m%d', date)) AS first_txn_date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE totals.transactions > 0
GROUP BY fullVisitorId
LIMIT 20;
```

```sql
-- 6. Combine both previous sub-results to compare first visit vs. first transaction  
WITH first_visit AS (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
first_txn AS (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_txn_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
  GROUP BY fullVisitorId
)
SELECT
  v.fullVisitorId,
  v.first_visit_date,
  t.first_txn_date
FROM first_visit AS v
JOIN first_txn  AS t
USING (fullVisitorId)
WHERE t.first_txn_date > v.first_visit_date
LIMIT 20;
```

```sql
-- 7. Identify the device used in the first transaction session (sample)  
WITH first_transaction_session AS (
  SELECT
    fullVisitorId,
    PARSE_DATE('%Y%m%d', date)              AS session_date,
    device.isMobile                         AS is_mobile,
    ROW_NUMBER() OVER(
      PARTITION BY fullVisitorId
      ORDER BY PARSE_DATE('%Y%m%d', date)
    ) AS rn
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
)
SELECT
  fullVisitorId,
  session_date AS first_txn_date,
  is_mobile
FROM first_transaction_session
WHERE rn = 1
LIMIT 20;
```

```sql
-- 8. Bring everything together – visitors whose first txn > first visit  
--    and whose first-txn device is explicitly mobile (sample rows)  
WITH first_visit AS (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
first_txn_session AS (
  SELECT
    fullVisitorId,
    PARSE_DATE('%Y%m%d', date)              AS txn_date,
    device.isMobile                         AS is_mobile,
    ROW_NUMBER() OVER(
      PARTITION BY fullVisitorId
      ORDER BY PARSE_DATE('%Y%m%d', date)
    ) AS rn
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
)
SELECT
  fts.fullVisitorId,
  fv.first_visit_date,
  fts.txn_date AS first_txn_date,
  fts.is_mobile
FROM first_txn_session AS fts
JOIN first_visit        AS fv
USING (fullVisitorId)
WHERE rn = 1                        -- first transaction only
  AND fts.txn_date > fv.first_visit_date
  AND fts.is_mobile = TRUE
LIMIT 20;
```

```sql
-- 9. Distinct visitor IDs that satisfy all the requirements  
SELECT DISTINCT
  fts.fullVisitorId
FROM (
  -- first visit per visitor
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
) AS fv
JOIN (
  -- first transaction session per visitor
  SELECT
    fullVisitorId,
    PARSE_DATE('%Y%m%d', date) AS first_txn_date,
    device.isMobile           AS is_mobile,
    ROW_NUMBER() OVER(
      PARTITION BY fullVisitorId
      ORDER BY PARSE_DATE('%Y%m%d', date)
    ) AS rn
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
) AS fts
ON fv.fullVisitorId = fts.fullVisitorId
WHERE fts.rn = 1                    -- keep only first transaction
  AND fts.first_txn_date > fv.first_visit_date
  AND fts.is_mobile = TRUE
LIMIT 20;
