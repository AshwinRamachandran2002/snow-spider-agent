Query:
-- 9. Distinct visitor IDs that satisfy all the requirements  
SELECT DISTINCT
  fts.fullVisitorId
FROM (
  -- first visit per visitor
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
) AS fv
JOIN (
  -- first transaction session per visitor
  SELECT
    fullVisitorId,
    PARSE_DATE('%Y%m%d', date) AS first_txn_date,
    device.isMobile           AS is_mobile,
    ROW_NUMBER() OVER(
      PARTITION BY fullVisitorId
      ORDER BY PARSE_DATE('%Y%m%d', date)
    ) AS rn
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
) AS fts
ON fv.fullVisitorId = fts.fullVisitorId
WHERE fts.rn = 1                    -- keep only first transaction
  AND fts.first_txn_date > fv.first_visit_date
  AND fts.is_mobile = TRUE
LIMIT 20;
