--Description / Thinking process:
-- We need visitor IDs whose FIRST transaction happened on a device marked “mobile”,
-- and that transaction occurred on a later calendar day than the visitor’s FIRST visit.
-- All GA-sample tables share the same schema, so we can wildcard over them.
--
-- 1) CTE first_sessions   – for every visitor, grab the MIN( date ) (their very first visit).
-- 2) CTE first_mobile_tx  – for every visitor, grab the MIN( date ) where:
--        • totals.transactions > 0  (a transaction took place)
--        • device.deviceCategory = 'mobile'
-- 3) Join the two CTEs and retain only those rows where first_mobile_tx_date > first_session_date.
-- 4) Return the visitor IDs (plus both dates for sanity) – sample limited to 20 rows.

WITH first_sessions AS (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_session_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY fullVisitorId
),
first_mobile_tx AS (
  SELECT
    fullVisitorId,
    MIN(PARSE_DATE('%Y%m%d', date)) AS first_mobile_tx_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions > 0
    AND device.deviceCategory = 'mobile'
  GROUP BY fullVisitorId
)
SELECT
  ftx.fullVisitorId,
  fs.first_session_date,
  ftx.first_mobile_tx_date
FROM first_mobile_tx AS ftx
JOIN first_sessions  AS fs
USING (fullVisitorId)
WHERE ftx.first_mobile_tx_date > fs.first_session_date
LIMIT 20;
