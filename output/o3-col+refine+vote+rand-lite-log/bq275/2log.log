Query:
-- 4. Description: first (earliest) session date for each visitor in one table  
SELECT fullVisitorId,
       MIN(PARSE_DATE('%Y%m%d', date)) AS first_session_date
FROM   `bigquery-public-data.google_analytics_sample.ga_sessions_20170127`
GROUP  BY fullVisitorId
LIMIT 20;
