```sql
-- 1.  Quick look at sessions that contain at least one transaction coming from a mobile device  
SELECT
  fullVisitorId ,
  date ,
  totals.transactions ,
  totals.transactionRevenue ,
  device.deviceCategory
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE totals.transactions IS NOT NULL
  AND totals.transactions > 0
  AND device.deviceCategory = 'mobile'
LIMIT 20 ;
```

```sql
-- 2.  First (earliest) session date for every user – any device, any interaction  
SELECT
  fullVisitorId ,
  MIN( PARSE_DATE('%Y%m%d', date) ) AS first_visit_date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
GROUP BY 1
LIMIT 20 ;
```

```sql
-- 3.  First (earliest) transaction-session date for every user where the device was **mobile**  
SELECT
  fullVisitorId ,
  MIN( PARSE_DATE('%Y%m%d', date) ) AS first_mobile_txn_date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
WHERE totals.transactions IS NOT NULL
  AND totals.transactions > 0
  AND device.deviceCategory = 'mobile'
GROUP BY 1
LIMIT 20 ;
```

```sql
-- 4.  Combine the two previous CTE-style sub-queries to see both dates side by side  
WITH first_visit AS (
  SELECT fullVisitorId ,
         MIN( PARSE_DATE('%Y%m%d', date) ) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY 1 ),
first_mobile_txn AS (
  SELECT fullVisitorId ,
         MIN( PARSE_DATE('%Y%m%d', date) ) AS first_mobile_txn_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  WHERE totals.transactions IS NOT NULL
    AND totals.transactions > 0
    AND device.deviceCategory = 'mobile'
  GROUP BY 1 )
SELECT *
FROM first_visit a
JOIN first_mobile_txn b
USING (fullVisitorId)
LIMIT 20 ;
```

```sql
-- 5.  Filter only those users whose first **mobile** transaction happened **after** their very first visit  
