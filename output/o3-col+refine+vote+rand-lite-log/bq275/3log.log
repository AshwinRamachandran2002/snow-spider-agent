```sql
-- 7.  Inspect hit-level data to see which hits actually contain a transaction id & revenue (mobile only)  
SELECT
  fullVisitorId ,
  date ,
  device.deviceCategory ,
  h.transaction.transactionId AS txn_id ,
  h.transaction.transactionRevenue AS txn_revenue
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
     UNNEST(hits) AS h
WHERE h.transaction.transactionId IS NOT NULL
  AND device.deviceCategory = 'mobile'
LIMIT 20 ;
```

```sql
-- 8.  Derive earliest **hit-level** transaction date for each user on mobile devices  
SELECT
  fullVisitorId ,
  MIN( PARSE_DATE('%Y%m%d', date) ) AS first_mobile_txn_hit_date
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
     UNNEST(hits) AS h
WHERE h.transaction.transactionId IS NOT NULL
  AND device.deviceCategory = 'mobile'
GROUP BY 1
LIMIT 20 ;
```

```sql
-- 9.  Final answer (hit-level variant) – visitor ids whose first mobile transaction (hit) is after first visit  
WITH first_visit AS (
  SELECT fullVisitorId ,
         MIN( PARSE_DATE('%Y%m%d', date) ) AS first_visit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`
  GROUP BY 1 ),
first_mobile_txn_hit AS (
  SELECT fullVisitorId ,
         MIN( PARSE_DATE('%Y%m%d', date) ) AS first_mobile_txn_hit_date
  FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
       UNNEST(hits) AS h
  WHERE h.transaction.transactionId IS NOT NULL
    AND device.deviceCategory = 'mobile'
  GROUP BY 1 )
SELECT DISTINCT
  t.fullVisitorId
FROM first_visit v
JOIN first_mobile_txn_hit t
ON  v.fullVisitorId = t.fullVisitorId
WHERE t.first_mobile_txn_hit_date > v.first_visit_date
LIMIT 20 ;
```

