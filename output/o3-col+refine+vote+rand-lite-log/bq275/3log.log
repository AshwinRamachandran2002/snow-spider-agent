-- 7.  Inspect hit-level data to see which hits actually contain a transaction id & revenue (mobile only)  
SELECT
  fullVisitorId ,
  date ,
  device.deviceCategory ,
  h.transaction.transactionId AS txn_id ,
  h.transaction.transactionRevenue AS txn_revenue
FROM `bigquery-public-data.google_analytics_sample.ga_sessions_*`,
     UNNEST(hits) AS h
WHERE h.transaction.transactionId IS NOT NULL
  AND device.deviceCategory = 'mobile'
LIMIT 20 ;
