Query:
--Description: 10) OPTIONAL – show how dominant (share %) the #1 drug is within each state. (Sample 20.)
WITH state_totals AS (
  SELECT nppes_provider_state,
         SUM(total_claim_count) AS state_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY nppes_provider_state
),
ranked AS (
  SELECT nppes_provider_state,
         drug_name,
         SUM(total_claim_count) AS drug_claims,
         ROW_NUMBER() OVER (PARTITION BY nppes_provider_state
                            ORDER BY SUM(total_claim_count) DESC) AS rn
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY nppes_provider_state, drug_name
)
SELECT r.nppes_provider_state AS state,
       r.drug_name            AS most_prescribed_medication,
       r.drug_claims,
       t.state_claims,
       ROUND(r.drug_claims / t.state_claims, 4) AS claim_share
FROM ranked r
JOIN state_totals t
  ON r.nppes_provider_state = t.nppes_provider_state
WHERE r.rn = 1
ORDER BY claim_share DESC
LIMIT 20;
Answer:
state,most_prescribed_medication,drug_claims,state_claims,claim_share
