       COUNT(DISTINCT nppes_provider_state) AS distinct_states
FROM ranked
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 9) FINAL ANSWER – most prescribed medication (highest total Part-D claims) in each state in 2014.  (All states returned; trimmed to 20 rows here.)
WITH ranked AS (
  SELECT nppes_provider_state,
         drug_name,
         SUM(total_claim_count) AS total_claims,
         ROW_NUMBER() OVER (PARTITION BY nppes_provider_state
                            ORDER BY SUM(total_claim_count) DESC) AS rn
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY nppes_provider_state, drug_name
)
SELECT nppes_provider_state AS state,
       drug_name           AS most_prescribed_medication,
       total_claims
FROM ranked
WHERE rn = 1
ORDER BY state
LIMIT 20;
```

```sql
--Description: 10) OPTIONAL – show how dominant (share %) the #1 drug is within each state. (Sample 20.)
WITH state_totals AS (
  SELECT nppes_provider_state,
         SUM(total_claim_count) AS state_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY nppes_provider_state
),
ranked AS (
  SELECT nppes_provider_state,
         drug_name,
         SUM(total_claim_count) AS drug_claims,
         ROW_NUMBER() OVER (PARTITION BY nppes_provider_state
                            ORDER BY SUM(total_claim_count) DESC) AS rn
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY nppes_provider_state, drug_name
)
SELECT r.nppes_provider_state AS state,
       r.drug_name            AS most_prescribed_medication,
       r.drug_claims,
       t.state_claims,
       ROUND(r.drug_claims / t.state_claims, 4) AS claim_share
FROM ranked r
JOIN state_totals t
  ON r.nppes_provider_state = t.nppes_provider_state
WHERE r.rn = 1
ORDER BY claim_share DESC
LIMIT 20;
```

These progressively build toward the final query (#9) that answers: “What is the most prescribed medication in each state in 2014?”
