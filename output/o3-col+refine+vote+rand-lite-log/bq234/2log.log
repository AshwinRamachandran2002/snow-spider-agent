```sql
--Description: Preview 20 sample rows from the Medicare Part-D prescriber file for 2014
SELECT *
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: List the distinct two–letter state codes that appear in the Part-D file
SELECT DISTINCT nppes_provider_state
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
ORDER BY nppes_provider_state
LIMIT 20;
```

```sql
--Description: Show 20 distinct drug names that appear in the data
SELECT DISTINCT drug_name
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
ORDER BY drug_name
LIMIT 20;
```

```sql
--Description: Aggregate total Part-D claims for every (state, drug) combination in 2014
SELECT
  nppes_provider_state  AS state,
  drug_name,
  SUM(total_claim_count) AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY state, total_claims DESC
LIMIT 20;
```

```sql
--Description: Display the 20 drugs with the highest national claim counts in 2014
SELECT
  drug_name,
  SUM(total_claim_count) AS national_total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY drug_name
ORDER BY national_total_claims DESC
LIMIT 20;
```

```sql
--Description: For every state pick the single drug with the greatest number of claims in 2014 (ties broken arbitrarily)
WITH state_drug_totals AS (
  SELECT
    nppes_provider_state                 AS state,
    drug_name,
    SUM(total_claim_count)               AS total_claims,
    ROW_NUMBER() OVER (
      PARTITION BY nppes_provider_state
      ORDER BY SUM(total_claim_count) DESC
    ) AS rn
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY state, drug_name
)
SELECT
  state,
  drug_name            AS most_prescribed_drug,
  total_claims
FROM state_drug_totals
WHERE rn = 1
ORDER BY state
LIMIT 20;           -- remove LIMIT to return every state
```

```sql
--Description: Same result as above but using QUALIFY instead of a subquery
SELECT
  nppes_provider_state  AS state,
  drug_name             AS most_prescribed_drug,
  SUM(total_claim_count) AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
QUALIFY ROW_NUMBER() OVER (
          PARTITION BY state
          ORDER BY SUM(total_claim_count) DESC
        ) = 1
ORDER BY state
LIMIT 20;
```

```sql
--Description: Return the final answer for all states without the LIMIT clause
SELECT
  nppes_provider_state  AS state,
  drug_name             AS most_prescribed_drug,
  SUM(total_claim_count) AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
QUALIFY ROW_NUMBER() OVER (
          PARTITION BY state
          ORDER BY SUM(total_claim_count) DESC
        ) = 1
ORDER BY state;
```

```sql
--Description: (Optional) Inspect the distribution of claim counts for the top drug in Texas
SELECT
  drug_name,
  total_claim_count
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'TX'
  AND drug_name = (
        SELECT drug_name
        FROM (
          SELECT drug_name,
                 SUM(total_claim_count) AS tot
          FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
          WHERE nppes_provider_state = 'TX'
          GROUP BY drug_name
          ORDER BY tot DESC
          LIMIT 1
        )
      )
ORDER BY total_claim_count DESC
LIMIT 20;
```

```sql
--Description: (Optional sanity check) Count how many states share the same most-prescribed drug
WITH tops AS (
  SELECT
    nppes_provider_state AS state,
    drug_name,
    SUM(total_claim_count) AS total_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY state, drug_name
  QUALIFY ROW_NUMBER() OVER (PARTITION BY state ORDER BY SUM(total_claim_count) DESC) = 1
)
SELECT
  drug_name,
  COUNT(*) AS number_of_states
FROM tops
GROUP BY drug_name
ORDER BY number_of_states DESC
LIMIT 20;
```
