```sql
-- 1) Preview a handful of rows in the Part-D prescriber file for 2014
SELECT *
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
-- 2) See what drug names are recorded (distinct sample)
SELECT DISTINCT drug_name
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
ORDER BY drug_name
LIMIT 20;
```

```sql
-- 3) List the distinct 2-letter state codes that appear in the 2014 file
SELECT DISTINCT nppes_provider_state
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
ORDER BY nppes_provider_state
LIMIT 20;
```

```sql
-- 4) Count how many Part-D rows each state contributes (provider*drug rows)
SELECT nppes_provider_state AS state,
       COUNT(*) AS row_cnt
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state
ORDER BY row_cnt DESC
LIMIT 20;
```

```sql
-- 5) Aggregate total Part-D claims for every (state, drug) pair
SELECT nppes_provider_state  AS state,
       drug_name,
       SUM(total_claim_count) AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY total_claims DESC
LIMIT 20;
```

```sql
-- 6) For one example state (Texas) show the drugs with the most claims
SELECT drug_name,
       SUM(total_claim_count) AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'TX'
GROUP BY drug_name
ORDER BY total_claims DESC
LIMIT 20;
```

```sql
-- 7) Rank drugs inside each state by descending claim volume
SELECT nppes_provider_state  AS state,
       drug_name,
       SUM(total_claim_count) AS total_claims,
       RANK() OVER (PARTITION BY nppes_provider_state
                    ORDER BY SUM(total_claim_count) DESC) AS rnk
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY state, rnk
LIMIT 20;
```

```sql
-- 8) Fetch only the #1 (most-prescribed) drug in every state
WITH state_drug AS (
  SELECT nppes_provider_state AS state,
         drug_name,
         SUM(total_claim_count) AS total_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY state, drug_name
),
ranked AS (
  SELECT state,
         drug_name,
         total_claims,
         ROW_NUMBER() OVER (PARTITION BY state ORDER BY total_claims DESC) AS rn
  FROM state_drug
)
SELECT state,
       drug_name,
       total_claims
FROM ranked
WHERE rn = 1
ORDER BY state
LIMIT 20;          -- Most-prescribed medication per state (first 20 states)
```

```sql
-- 9) Same idea but also retrieve the share each #1 drug represents within its state
WITH state_drug AS (
  SELECT nppes_provider_state AS state,
         drug_name,
         SUM(total_claim_count) AS total_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY state, drug_name
),
state_totals AS (
  SELECT state,
         SUM(total_claims) AS state_claims
  FROM state_drug
  GROUP BY state
),
ranked AS (
  SELECT d.state,
         d.drug_name,
         d.total_claims,
         t.state_claims,
         ROW_NUMBER() OVER (PARTITION BY d.state ORDER BY d.total_claims DESC) AS rn
  FROM state_drug AS d
  JOIN state_totals AS t
  USING (state)
)
SELECT state,
       drug_name,
       total_claims,
       ROUND(100 * total_claims / state_claims, 2) AS pct_of_state_claims
FROM ranked
WHERE rn = 1
ORDER BY state
LIMIT 20;          -- Top drug + its % share for the first 20 states
```
