```sql
--Description: 2) List all two–letter state codes that appear in the file
SELECT DISTINCT `nppes_provider_state`
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
ORDER BY `nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 3) Show the 20 drugs with the highest national claim counts in 2014
SELECT `drug_name`,
       SUM(`total_claim_count`) AS total_claims_usa
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY `drug_name`
ORDER BY total_claims_usa DESC
LIMIT 20;
```

```sql
--Description: 4) Aggregate claims by state & drug (sample of 20 rows)
SELECT `nppes_provider_state`   AS state,
       `drug_name`,
       SUM(`total_claim_count`) AS state_drug_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, `drug_name`
ORDER BY state, state_drug_claims DESC
LIMIT 20;
```

```sql
--Description: 5) Example for one state (CA) – which drugs lead in total claims?
SELECT `drug_name`,
       SUM(`total_claim_count`) AS ca_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE `nppes_provider_state` = 'CA'
GROUP BY `drug_name`
ORDER BY ca_claims DESC
LIMIT 20;
```

```sql
--Description: 6) Rank drugs within every state using a window function (top 20 rows shown)
SELECT `nppes_provider_state`                   AS state,
       `drug_name`,
       SUM(`total_claim_count`)                 AS state_drug_claims,
       ROW_NUMBER() OVER (PARTITION BY `nppes_provider_state`
                          ORDER BY SUM(`total_claim_count`) DESC) AS rn
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, `drug_name`
ORDER BY state, rn
LIMIT 20;
```

```sql
--Description: 7) Same ranking but keeping only the #1 drug per state (top 20 states shown)
SELECT state,
       drug_name,
       state_drug_claims
FROM (
    SELECT `nppes_provider_state`               AS state,
           `drug_name`,
           SUM(`total_claim_count`)             AS state_drug_claims,
           ROW_NUMBER() OVER (PARTITION BY `nppes_provider_state`
                              ORDER BY SUM(`total_claim_count`) DESC) AS rn
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    GROUP BY state, `drug_name`
)
WHERE rn = 1
ORDER BY state
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – the most-prescribed medication (by total Medicare Part-D claims) in EACH U.S. state in 2014
SELECT state,
       drug_name,
       state_drug_claims
FROM (
    SELECT `nppes_provider_state`               AS state,
           `drug_name`,
           SUM(`total_claim_count`)             AS state_drug_claims,
           ROW_NUMBER() OVER (PARTITION BY `nppes_provider_state`
                              ORDER BY SUM(`total_claim_count`) DESC) AS rn
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    GROUP BY state, `drug_name`
)
WHERE rn = 1
ORDER BY state;
```
