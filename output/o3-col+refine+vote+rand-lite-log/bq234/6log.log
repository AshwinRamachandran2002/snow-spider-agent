--Description: 6) For the whole nation, compute total claims per (state, drug) pair.
SELECT
  `nppes_provider_state` AS state,
  `drug_name`,
  SUM(`total_claim_count`) AS total_claims
FROM
  `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY
  state,
  `drug_name`
ORDER BY
  total_claims DESC
LIMIT 20;
