Query:
--Description: 9) Use DENSE_RANK to keep the most-prescribed drug(s) in each state (ties allowed).
--Logic: aggregate → rank with DENSE_RANK inside every state → filter rk = 1.
SELECT
  state,
  drug_name,
  total_claims
FROM (
  SELECT
    `nppes_provider_state` AS state,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims,
    DENSE_RANK() OVER (
        PARTITION BY `nppes_provider_state`
        ORDER BY SUM(`total_claim_count`) DESC
    ) AS rk
  FROM
    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY
    state,
    `drug_name`
)
WHERE
  rk = 1
ORDER BY
  state
LIMIT 20
