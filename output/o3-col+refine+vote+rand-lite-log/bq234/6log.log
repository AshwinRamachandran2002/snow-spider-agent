```

```sql
--Description: 5) Aggregate total Part-D claims for each drug in Texas (TX).
SELECT
  `drug_name`,
  SUM(`total_claim_count`) AS total_claims
FROM
  `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE
  `nppes_provider_state` = 'TX'
GROUP BY
  `drug_name`
ORDER BY
  total_claims DESC
LIMIT 20;
```

```sql
--Description: 6) For the whole nation, compute total claims per (state, drug) pair.
SELECT
  `nppes_provider_state` AS state,
  `drug_name`,
  SUM(`total_claim_count`) AS total_claims
FROM
  `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY
  state,
  `drug_name`
ORDER BY
  total_claims DESC
LIMIT 20;
```

```sql
--Description: 7) Add a window function to rank each drug within its state by claim volume.
SELECT
  state,
  drug_name,
  total_claims,
  ROW_NUMBER() OVER (PARTITION BY state ORDER BY total_claims DESC) AS rn
FROM (
  SELECT
    `nppes_provider_state` AS state,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims
  FROM
    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY
    state,
    `drug_name`
)
ORDER BY
  state,
  rn
LIMIT 20;
```

```sql
--Description: 8) Using QUALIFY to keep only the top-ranked (most-prescribed) drug in each state.
SELECT
  state,
  drug_name,
  total_claims
FROM (
  SELECT
    `nppes_provider_state` AS state,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims,
    ROW_NUMBER() OVER (PARTITION BY `nppes_provider_state`
                       ORDER BY SUM(`total_claim_count`) DESC) AS rn
  FROM
    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY
    state,
    `drug_name`
)
QUALIFY rn = 1
ORDER BY
  state
LIMIT 20;
```

```sql
--Description: 9) Same idea as query 8 but using the DENSE_RANK() function
--               (will still return one row per state; ties keep both).
SELECT
  state,
  drug_name,
  total_claims
FROM (
  SELECT
    `nppes_provider_state` AS state,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims,
    DENSE_RANK() OVER (PARTITION BY `nppes_provider_state`
                       ORDER BY SUM(`total_claim_count`) DESC) AS rk
  FROM
    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY
    state,
    `drug_name`
)
WHERE
  rk = 1
ORDER BY
  state
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – The most prescribed medication in each state for 2014
--                 (one row per state, highest total_claim_count).
SELECT
  state,
  drug_name AS most_prescribed_drug,
  total_claims
FROM (
  SELECT
    `nppes_provider_state` AS state,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims,
    ROW_NUMBER() OVER (PARTITION BY `nppes_provider_state`
                       ORDER BY SUM(`total_claim_count`) DESC) AS rn
  FROM
    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY
    state,
    `drug_name`
)
WHERE
  rn = 1
ORDER BY
  state
LIMIT 20;
```
