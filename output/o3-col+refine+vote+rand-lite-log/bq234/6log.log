```sql
--Description & Thinking Process:
-- Step-1:  Aggregate the data first → for each (state, drug) pair compute the
--         total number of Medicare Part-D claims in 2014.
-- Step-2:  In an outer SELECT, add ROW_NUMBER() to rank those drugs inside
--         every state, ordering by the previously-computed total_claims.
-- Step-3:  Keep only rank = 1 → the most-prescribed drug for that state.
-- The result is exactly one (state, drug, total_claims) row per state.

SELECT
  state,
  drug_name,
  total_claims
FROM (
  SELECT
    state,
    drug_name,
    total_claims,
    ROW_NUMBER() OVER (PARTITION BY state ORDER BY total_claims DESC) AS rn
  FROM (
    SELECT
      `nppes_provider_state` AS state,
      `drug_name`,
      SUM(`total_claim_count`) AS total_claims
    FROM
      `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    GROUP BY
      state,
      `drug_name`
  )
)
WHERE
  rn = 1
ORDER BY
  state;
```
