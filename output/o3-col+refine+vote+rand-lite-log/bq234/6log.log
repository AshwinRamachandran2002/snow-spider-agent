--Description: 10) FINAL ANSWER – single most-prescribed medication in each state for 2014.
--Steps: aggregate totals → rank with ROW_NUMBER() inside each state → keep rn = 1.
SELECT
  state,
  drug_name AS most_prescribed_drug,
  total_claims
FROM (
  SELECT
    `nppes_provider_state` AS state,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims,
    ROW_NUMBER() OVER (
        PARTITION BY `nppes_provider_state`
        ORDER BY SUM(`total_claim_count`) DESC
    ) AS rn
  FROM
    `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY
    state,
    `drug_name`
)
WHERE
  rn = 1
ORDER BY
  state
LIMIT 20
