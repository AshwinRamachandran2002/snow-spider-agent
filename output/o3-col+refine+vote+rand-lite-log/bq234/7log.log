Query:
--Description: 5) Use a window function to rank drugs by claim volume inside each state
SELECT
  `nppes_provider_state`,
  `drug_name`,
  SUM(`total_claim_count`) AS state_drug_claims,
  RANK() OVER (
      PARTITION BY `nppes_provider_state` 
      ORDER BY SUM(`total_claim_count`) DESC
  ) AS rk
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY `nppes_provider_state`, `drug_name`
ORDER BY `nppes_provider_state`, rk
LIMIT 20;
