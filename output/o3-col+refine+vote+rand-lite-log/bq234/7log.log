Query:
--Description: 9) Bring together state, top drug, and its share of all claims in that state (sample 20)
WITH totals AS (
  SELECT
    `nppes_provider_state`,
    SUM(`total_claim_count`) AS state_total
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`
),
tops AS (
  SELECT
    `nppes_provider_state`,
    `drug_name`,
    SUM(`total_claim_count`) AS top_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`, `drug_name`
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY `nppes_provider_state`
    ORDER BY SUM(`total_claim_count`) DESC
  ) = 1
)
SELECT
  t.`nppes_provider_state`,
  t.`drug_name`        AS most_prescribed_drug,
  t.top_claims,
  ROUND(100 * t.top_claims / tot.state_total , 2) AS pct_of_state_claims
FROM tops t
JOIN totals tot
  ON t.`nppes_provider_state` = tot.`nppes_provider_state`
ORDER BY t.`nppes_provider_state`
LIMIT 20;
Answer:
nppes_provider_state,most_prescribed_drug,top_claims,pct_of_state_claims
