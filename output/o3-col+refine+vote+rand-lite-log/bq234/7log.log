```sql
--Description: 1) Peek at raw prescription records for 2014
SELECT 
  `nppes_provider_state`,
  `drug_name`,
  `total_claim_count`
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: 2) List the distinct 2–letter state codes that appear in the 2014 Part-D file
SELECT DISTINCT 
  `nppes_provider_state`
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
ORDER BY `nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 3) How many different drugs were prescribed in each state? (first 20 states)
SELECT 
  `nppes_provider_state`,
  COUNT(DISTINCT `drug_name`) AS distinct_drug_cnt
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY `nppes_provider_state`
ORDER BY `nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 4) Aggregate the total claim count for every drug inside one sample state (e.g. CA)
SELECT 
  `drug_name`,
  SUM(`total_claim_count`) AS total_claims_in_CA
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE `nppes_provider_state` = 'CA'
GROUP BY `drug_name`
ORDER BY total_claims_in_CA DESC
LIMIT 20;
```

```sql
--Description: 5) Use a window function to rank drugs by claim volume inside each state
SELECT
  `nppes_provider_state`,
  `drug_name`,
  SUM(`total_claim_count`) AS state_drug_claims,
  RANK() OVER (
      PARTITION BY `nppes_provider_state` 
      ORDER BY SUM(`total_claim_count`) DESC
  ) AS rk
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY `nppes_provider_state`, `drug_name`
ORDER BY `nppes_provider_state`, rk
LIMIT 20;
```

```sql
--Description: 6) Show ONLY the #1-ranked drug per state via QUALIFY (ties keep lowest alphabetical)
SELECT
  `nppes_provider_state`,
  `drug_name`,
  SUM(`total_claim_count`) AS top_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY `nppes_provider_state`, `drug_name`
QUALIFY ROW_NUMBER() OVER (
           PARTITION BY `nppes_provider_state`
           ORDER BY SUM(`total_claim_count`) DESC, `drug_name`
        ) = 1
ORDER BY `nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 7) Alternative formulation with a sub-query and MAX() join to get the same result
WITH state_max AS (
  SELECT 
    `nppes_provider_state`,
    MAX(total_claims) AS max_claims
  FROM (
    SELECT 
      `nppes_provider_state`,
      `drug_name`,
      SUM(`total_claim_count`) AS total_claims
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    GROUP BY `nppes_provider_state`, `drug_name`
  )
  GROUP BY `nppes_provider_state`
)
SELECT 
  d.`nppes_provider_state`,
  d.`drug_name`,
  d.total_claims
FROM (
  SELECT 
    `nppes_provider_state`,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`, `drug_name`
) AS d
JOIN state_max m
  ON d.`nppes_provider_state` = m.`nppes_provider_state`
 AND d.total_claims        = m.max_claims
ORDER BY d.`nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 8) Verify there is only one winner per state (count ranked =1)** sample 20 states
WITH ranked AS (
  SELECT
    `nppes_provider_state`,
    `drug_name`,
    SUM(`total_claim_count`) AS cnt,
    RANK() OVER (
      PARTITION BY `nppes_provider_state`
      ORDER BY SUM(`total_claim_count`) DESC
    ) AS rk
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`, `drug_name`
)
SELECT 
  `nppes_provider_state`,
  COUNTIF(rk = 1) AS num_top_drugs
FROM ranked
GROUP BY `nppes_provider_state`
ORDER BY `nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 9) Bring together state, top drug, and its share of all claims in that state (sample 20)
WITH totals AS (
  SELECT
    `nppes_provider_state`,
    SUM(`total_claim_count`) AS state_total
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`
),
tops AS (
  SELECT
    `nppes_provider_state`,
    `drug_name`,
    SUM(`total_claim_count`) AS top_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`, `drug_name`
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY `nppes_provider_state`
    ORDER BY SUM(`total_claim_count`) DESC
  ) = 1
)
SELECT
  t.`nppes_provider_state`,
  t.`drug_name`        AS most_prescribed_drug,
  t.top_claims,
  ROUND(100 * t.top_claims / tot.state_total , 2) AS pct_of_state_claims
FROM tops t
JOIN totals tot
  ON t.`nppes_provider_state` = tot.`nppes_provider_state`
ORDER BY t.`nppes_provider_state`
LIMIT 20;
```

```sql
--Description: 10) FINAL – Most prescribed medication in each U.S. state (2014)  
--(limited to 20 rows for display)
SELECT
  `nppes_provider_state`       AS state,
  `drug_name`                  AS most_prescribed_drug,
  SUM(`total_claim_count`)     AS claim_count
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY `nppes_provider_state`, `drug_name`
QUALIFY ROW_NUMBER() OVER (
          PARTITION BY `nppes_provider_state`
          ORDER BY SUM(`total_claim_count`) DESC
        ) = 1
ORDER BY state
LIMIT 20;
```
