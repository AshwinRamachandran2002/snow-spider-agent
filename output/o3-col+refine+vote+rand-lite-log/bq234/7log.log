Query:
--Description: 7) Alternative formulation with a sub-query and MAX() join to get the same result
WITH state_max AS (
  SELECT 
    `nppes_provider_state`,
    MAX(total_claims) AS max_claims
  FROM (
    SELECT 
      `nppes_provider_state`,
      `drug_name`,
      SUM(`total_claim_count`) AS total_claims
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    GROUP BY `nppes_provider_state`, `drug_name`
  )
  GROUP BY `nppes_provider_state`
)
SELECT 
  d.`nppes_provider_state`,
  d.`drug_name`,
  d.total_claims
FROM (
  SELECT 
    `nppes_provider_state`,
    `drug_name`,
    SUM(`total_claim_count`) AS total_claims
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`, `drug_name`
) AS d
JOIN state_max m
  ON d.`nppes_provider_state` = m.`nppes_provider_state`
 AND d.total_claims        = m.max_claims
ORDER BY d.`nppes_provider_state`
LIMIT 20;
