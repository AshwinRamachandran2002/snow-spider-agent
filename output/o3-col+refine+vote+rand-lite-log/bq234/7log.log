Query:
--Description: 8) Verify there is only one winner per state (count ranked =1)** sample 20 states
WITH ranked AS (
  SELECT
    `nppes_provider_state`,
    `drug_name`,
    SUM(`total_claim_count`) AS cnt,
    RANK() OVER (
      PARTITION BY `nppes_provider_state`
      ORDER BY SUM(`total_claim_count`) DESC
    ) AS rk
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY `nppes_provider_state`, `drug_name`
)
SELECT 
  `nppes_provider_state`,
  COUNTIF(rk = 1) AS num_top_drugs
FROM ranked
GROUP BY `nppes_provider_state`
ORDER BY `nppes_provider_state`
LIMIT 20;
