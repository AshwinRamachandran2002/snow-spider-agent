```sql
-- Description: 4) Sum the total claims for every (state, drug) pair  
SELECT
  nppes_provider_state      AS state,
  drug_name,
  SUM(total_claim_count)    AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY total_claims DESC
LIMIT 20;
```

```sql
-- Description: 5) For a single state (example TX), show the top 20 drugs by claims
SELECT
  drug_name,
  SUM(total_claim_count) AS tx_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'TX'
GROUP BY drug_name
ORDER BY tx_claims DESC
LIMIT 20;
```

```sql
-- Description: 6) Rank drugs within every state by total claims using a window
SELECT
  nppes_provider_state AS state,
  drug_name,
  SUM(total_claim_count) AS total_claims,
  RANK() OVER (PARTITION BY nppes_provider_state
               ORDER BY SUM(total_claim_count) DESC) AS rnk
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY state, rnk
LIMIT 20;
```

```sql
-- Description: 7) Pick the single most-prescribed drug per state via QUALIFY
SELECT
  nppes_provider_state AS state,
  drug_name,
  SUM(total_claim_count) AS total_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
QUALIFY ROW_NUMBER() OVER (PARTITION BY state
                           ORDER BY SUM(total_claim_count) DESC) = 1
ORDER BY state
LIMIT 20;           -- remove LIMIT to return every state
```

```sql
-- Description: 8) Same result as #7 but using ARRAY_AGG to keep only the max row
SELECT
  state,
  (SELECT AS STRUCT drug_name               -- top drug
   FROM UNNEST(drugs)
   ORDER BY total_claims DESC
   LIMIT 1).*
FROM (
  SELECT
    nppes_provider_state AS state,
    ARRAY_AGG(STRUCT(drug_name, SUM(total_claim_count) AS total_claims)
              ORDER BY SUM(total_claim_count) DESC) AS drugs
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY state
)
ORDER BY state
LIMIT 20;
```

```sql
-- Description: 9) Verify total claims for one of the identified “top drugs” (e.g., FL)
SELECT
  drug_name,
  SUM(total_claim_count) AS fl_claims
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'FL'
GROUP BY drug_name
ORDER BY fl_claims DESC
LIMIT 20;
```

```sql
-- Description: 10) FINAL – full list of the most prescribed medication in every state (remove LIMIT for complete output)
SELECT
  nppes_provider_state  AS state,
  drug_name             AS most_prescribed_drug,
  SUM(total_claim_count) AS total_claims_2014
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
QUALIFY ROW_NUMBER() OVER (PARTITION BY state
                           ORDER BY SUM(total_claim_count) DESC) = 1
ORDER BY state
LIMIT 20;          -- drop LIMIT to obtain the answer for all states
```
