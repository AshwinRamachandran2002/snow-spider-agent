```sql
-- Description / Thinking process:
-- • Task: Find the single most-prescribed medication (largest total_claim_count) in every state for 2014.
-- • Step-1  Aggregate: SUM total_claim_count for each (state, drug) pair.
-- • Step-2  Rank: Use ROW_NUMBER partitioned by state, ordered by the summed claims DESC.
-- • Step-3  Filter: Keep only row where rn = 1 → top drug in each state.
-- • Step-4  Present: Show state, drug, and its total claims; ORDER by state for readability.
-- • LIMIT 20 just to preview (omit for full list).

SELECT
  state,
  drug_name AS most_prescribed_drug,
  total_claims_2014
FROM (
  SELECT
    nppes_provider_state AS state,
    drug_name,
    SUM(total_claim_count) AS total_claims_2014,
    ROW_NUMBER() OVER (
      PARTITION BY nppes_provider_state
      ORDER BY SUM(total_claim_count) DESC
    ) AS rn
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY nppes_provider_state, drug_name
)
WHERE rn = 1
ORDER BY state
LIMIT 20;
```
