Query:
-- Description: 6) Rank drugs within every state by total claims using a window
SELECT
  nppes_provider_state AS state,
  drug_name,
  SUM(total_claim_count) AS total_claims,
  RANK() OVER (PARTITION BY nppes_provider_state
               ORDER BY SUM(total_claim_count) DESC) AS rnk
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY state, rnk
LIMIT 20;
