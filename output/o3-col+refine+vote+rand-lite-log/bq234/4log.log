```sql
--Description: 1) Peek at raw prescription records in 2014
SELECT
  nppes_provider_state,
  drug_name,
  total_claim_count
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: 2) List distinct state codes that appear in the 2014 Part-D file
SELECT DISTINCT
  nppes_provider_state
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
LIMIT 20;
```

```sql
--Description: 3) Total Part-D claims written for every drug nation-wide (highest 20)
SELECT
  drug_name,
  SUM(total_claim_count) AS total_claims_2014
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY drug_name
ORDER BY total_claims_2014 DESC
LIMIT 20;
```

```sql
--Description: 4) Total Part-D claims by drug within one sample state (California)  
SELECT
  drug_name,
  SUM(total_claim_count) AS state_claims_2014
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
WHERE nppes_provider_state = 'CA'
GROUP BY drug_name
ORDER BY state_claims_2014 DESC
LIMIT 20;
```

```sql
--Description: 5) Aggregate claims by state and drug across the whole table  
SELECT
  nppes_provider_state AS state,
  drug_name,
  SUM(total_claim_count) AS claims_2014
FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
GROUP BY state, drug_name
ORDER BY state, claims_2014 DESC
LIMIT 20;
```

```sql
--Description: 6) Add a rank to every (state, drug) pair using window functions  
SELECT
  state,
  drug_name,
  claims_2014,
  ROW_NUMBER() OVER (PARTITION BY state ORDER BY claims_2014 DESC) AS rn
FROM (
  SELECT
    nppes_provider_state AS state,
    drug_name,
    SUM(total_claim_count) AS claims_2014
  FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
  GROUP BY state, drug_name )
ORDER BY state, rn
LIMIT 20;
```

```sql
--Description: 7) Return only the top-ranked medication for each state (most prescribed)  
SELECT
  state,
  drug_name AS most_prescribed_drug,
  claims_2014 AS total_claims_2014
FROM (
  SELECT
    state,
    drug_name,
    claims_2014,
    ROW_NUMBER() OVER (PARTITION BY state ORDER BY claims_2014 DESC) AS rn
  FROM (
    SELECT
      nppes_provider_state AS state,
      drug_name,
      SUM(total_claim_count) AS claims_2014
    FROM `bigquery-public-data.cms_medicare.part_d_prescriber_2014`
    GROUP BY state, drug_name ) )
WHERE rn = 1
ORDER BY state
LIMIT 20;
```

