-- 7. Description: Find every player’s highest score in a single match (top 20 rows).
WITH player_match_runs AS (
    SELECT bb.striker      AS player_id,
           bb.match_id,
           SUM(bs.runs_scored) AS runs_in_match
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
         ON (bb.match_id, bb.over_id, bb.ball_id) =
            (bs.match_id, bs.over_id, bs.ball_id)
    GROUP BY bb.striker, bb.match_id
)
SELECT p.player_id,
       p.player_name,
       MAX(pm.runs_in_match) AS highest_score
FROM player_match_runs AS pm
JOIN player AS p
     ON p.player_id = pm.player_id
GROUP BY p.player_id
ORDER BY highest_score DESC
LIMIT 20;
