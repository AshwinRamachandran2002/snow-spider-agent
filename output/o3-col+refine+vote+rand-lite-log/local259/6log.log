```sql
--Description / Thinking process:
-- Goal: Count total wickets per bowler.
-- Step-1: wicket_taken lists every dismissal but not the bowler.
-- Step-2: ball_by_ball lists the bowler for each (match_id, over_id, ball_id).
-- Step-3: Join wicket_taken to ball_by_ball on those three columns
--         to pick up the bowler who delivered the wicket ball.
-- Step-4: Join to player to get the bowler’s name.
-- Step-5: Group by bowler and COUNT(*) to obtain wickets taken.
-- Step-6: Order by the count descending and limit to top 20 rows.
SELECT
    bb.bowler        AS player_id,
    p.player_name,
    COUNT(*)         AS total_wickets
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
  ON wt.match_id = bb.match_id
 AND wt.over_id  = bb.over_id
 AND wt.ball_id  = bb.ball_id
JOIN player AS p
  ON p.player_id = bb.bowler
GROUP BY bb.bowler
ORDER BY total_wickets DESC
LIMIT 20;
```
