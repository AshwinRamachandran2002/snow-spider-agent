```sql
-- 7. Description: Find every player’s highest score in a single match (top 20 rows).
WITH player_match_runs AS (
    SELECT bb.striker      AS player_id,
           bb.match_id,
           SUM(bs.runs_scored) AS runs_in_match
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
         ON (bb.match_id, bb.over_id, bb.ball_id) =
            (bs.match_id, bs.over_id, bs.ball_id)
    GROUP BY bb.striker, bb.match_id
)
SELECT p.player_id,
       p.player_name,
       MAX(pm.runs_in_match) AS highest_score
FROM player_match_runs AS pm
JOIN player AS p
     ON p.player_id = pm.player_id
GROUP BY p.player_id
ORDER BY highest_score DESC
LIMIT 20;
```

```sql
-- 8. Description: Number of matches where a batsman crossed 30, 50, and 100 (sample 20).
WITH player_match_runs AS (
    SELECT bb.striker    AS player_id,
           bb.match_id,
           SUM(bs.runs_scored) AS runs_in_match
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
         ON (bb.match_id, bb.over_id, bb.ball_id) =
            (bs.match_id, bs.over_id, bs.ball_id)
    GROUP BY bb.striker, bb.match_id
)
SELECT p.player_id,
       p.player_name,
       SUM(CASE WHEN runs_in_match >= 30 THEN 1 ELSE 0 END) AS _30_plus,
       SUM(CASE WHEN runs_in_match >= 50 THEN 1 ELSE 0 END) AS _50_plus,
       SUM(CASE WHEN runs_in_match >= 100 THEN 1 ELSE 0 END) AS _100_plus
FROM player_match_runs
JOIN player AS p
     ON p.player_id = player_match_runs.player_id
GROUP BY p.player_id
LIMIT 20;
```

```sql
-- 9. Description: Total wickets taken by each player (first 20).
SELECT wt.bowler        AS player_id,
       p.player_name,
       COUNT(*)          AS total_wkts
FROM wicket_taken AS wt
JOIN ball_by_ball AS bb
     ON (wt.match_id, wt.over_id, wt.ball_id) =
        (bb.match_id, bb.over_id, bb.ball_id)
JOIN player AS p
     ON p.player_id = bb.bowler
GROUP BY wt.bowler
ORDER BY total_wkts DESC
LIMIT 20;
```

```sql
--10. Description: Best bowling spell (most wickets, fewest runs conceded) per player (sample 20).
WITH bowler_runs AS (
    -- Runs conceded by bowler for every ball (ignore extras as requested)
    SELECT bb.match_id,
           bb.bowler       AS player_id,
           SUM(bs.runs_scored) AS runs_conceded
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
         ON (bb.match_id, bb.over_id, bb.ball_id) =
            (bs.match_id, bs.over_id, bs.ball_id)
    GROUP BY bb.match_id, bb.bowler
),
bowler_wkts AS (
    SELECT wt.match_id,
           bb.bowler      AS player_id,
           COUNT(*)       AS wkts
    FROM wicket_taken AS wt
    JOIN ball_by_ball AS bb
         ON (wt.match_id, wt.over_id, wt.ball_id) =
            (bb.match_id, bb.over_id, bb.ball_id)
    GROUP BY wt.match_id, bb.bowler
),
spell AS (
    SELECT r.match_id,
           r.player_id,
           r.runs_conceded,
           COALESCE(w.wkts, 0) AS wkts
    FROM bowler_runs AS r
    LEFT JOIN bowler_wkts AS w
           ON (r.match_id = w.match_id AND r.player_id = w.player_id)
)
SELECT p.player_id,
       p.player_name,
       -- format “wickets-runs”
       (SELECT wkts FROM spell s2
        WHERE s2.player_id = p.player_id
        ORDER BY wkts DESC, runs_conceded ASC, match_id
        LIMIT 1) || '-' ||
       (SELECT runs_conceded FROM spell s2
        WHERE s2.player_id = p.player_id
        ORDER BY wkts DESC, runs_conceded ASC, match_id
        LIMIT 1) AS best_bowling
FROM player AS p
WHERE EXISTS (SELECT 1 FROM spell WHERE player_id = p.player_id)
LIMIT 20;
```
