```sql
--Description:  Best bowling spell for each player (most wickets in a single match,    
--tie-broken by fewest runs conceded).  
--1. bowler_runs  : total runs a bowler concedes in each match (using batsman_scored, ignoring extras).  
--2. bowler_wkts  : total wickets that same bowler takes in that match (link wicket_taken → ball_by_ball to know bowler).  
--3. spell        : combine the two CTEs so every (bowler, match) row has both runs_conceded and wkts (0 when none).  
--4. Final SELECT : for every player in player table that ever bowled, pick the spell with
--                  highest wkts; if several spells have equal wkts, choose the one with
--                  least runs_conceded (ORDER BY wkts DESC, runs_conceded ASC, match_id).  
--                  Concatenate as “wkts-runs” string.  Show first 20 players.
WITH bowler_runs AS (
    SELECT
        bb.match_id,
        bb.bowler           AS player_id,
        SUM(bs.runs_scored) AS runs_conceded
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
      ON bb.match_id = bs.match_id
     AND bb.over_id  = bs.over_id
     AND bb.ball_id  = bs.ball_id
    GROUP BY bb.match_id, bb.bowler
),
bowler_wkts AS (
    SELECT
        wt.match_id,
        bb.bowler        AS player_id,
        COUNT(*)         AS wkts
    FROM wicket_taken AS wt
    JOIN ball_by_ball AS bb
      ON wt.match_id = bb.match_id
     AND wt.over_id  = bb.over_id
     AND wt.ball_id  = bb.ball_id
    GROUP BY wt.match_id, bb.bowler
),
spell AS (
    SELECT
        r.match_id,
        r.player_id,
        r.runs_conceded,
        COALESCE(w.wkts, 0) AS wkts
    FROM bowler_runs AS r
    LEFT JOIN bowler_wkts AS w
      ON r.match_id  = w.match_id
     AND r.player_id = w.player_id
)
SELECT
    p.player_id,
    p.player_name,
    -- best spell formatted as "wickets-runs"
    (SELECT s2.wkts
       FROM spell AS s2
      WHERE s2.player_id = p.player_id
      ORDER BY s2.wkts DESC, s2.runs_conceded ASC, s2.match_id
      LIMIT 1
    ) || '-' ||
    (SELECT s2.runs_conceded
       FROM spell AS s2
      WHERE s2.player_id = p.player_id
      ORDER BY s2.wkts DESC, s2.runs_conceded ASC, s2.match_id
      LIMIT 1
    ) AS best_bowling
FROM player AS p
WHERE EXISTS (SELECT 1 FROM spell WHERE player_id = p.player_id)
LIMIT 20;
