```sql
-- 4. Description: Aggregate total career runs per player (first 20 players).
SELECT p.player_id,
       p.player_name,
       SUM(bs.runs_scored) AS total_runs
FROM batsman_scored AS bs
JOIN ball_by_ball AS bb
     ON (bs.match_id, bs.over_id, bs.ball_id) =
        (bb.match_id, bb.over_id, bb.ball_id)
JOIN player AS p
     ON p.player_id = bb.striker
GROUP BY p.player_id
ORDER BY total_runs DESC
LIMIT 20;
```

```sql
-- 5. Description: Count how many times each player was dismissed (sample 20).
