-- 8. Description: Number of matches where a batsman crossed 30, 50, and 100 (sample 20).
WITH player_match_runs AS (
    SELECT bb.striker    AS player_id,
           bb.match_id,
           SUM(bs.runs_scored) AS runs_in_match
    FROM ball_by_ball AS bb
    JOIN batsman_scored AS bs
         ON (bb.match_id, bb.over_id, bb.ball_id) =
            (bs.match_id, bs.over_id, bs.ball_id)
    GROUP BY bb.striker, bb.match_id
)
SELECT p.player_id,
       p.player_name,
       SUM(CASE WHEN runs_in_match >= 30 THEN 1 ELSE 0 END) AS _30_plus,
       SUM(CASE WHEN runs_in_match >= 50 THEN 1 ELSE 0 END) AS _50_plus,
       SUM(CASE WHEN runs_in_match >= 100 THEN 1 ELSE 0 END) AS _100_plus
FROM player_match_runs
JOIN player AS p
     ON p.player_id = player_match_runs.player_id
GROUP BY p.player_id
LIMIT 20;
