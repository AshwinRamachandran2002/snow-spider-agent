       CASE WHEN bf.balls_faced=0
            THEN NULL
            ELSE ROUND(100.0*r.total_runs/bf.balls_faced,2)
       END                            AS strike_rate,

       COALESCE(w.wickets_taken,0)    AS total_wickets,
       CASE WHEN eb.balls_bowled=0
            THEN NULL
            ELSE ROUND(6.0*eb.runs_conceded/eb.balls_bowled,2)
       END                            AS economy_rate,
       bp.best_bowling
FROM   player AS p
/* Batting aggregates */
LEFT JOIN (
        SELECT bb.striker AS player_id,
               SUM(bs.runs_scored) AS total_runs
        FROM   ball_by_ball   AS bb
        JOIN   batsman_scored AS bs
               USING (match_id, over_id, ball_id, innings_no)
        GROUP  BY bb.striker
     )  AS r             USING (player_id)
LEFT JOIN (
        SELECT player_id, COUNT(DISTINCT match_id) AS matches
        FROM   player_match
        GROUP  BY player_id
     )  AS m             USING (player_id)
LEFT JOIN (
        SELECT player_out AS player_id,
               COUNT(*)    AS dismissals
        FROM   wicket_taken
        GROUP  BY player_out
     )  AS d             USING (player_id)
LEFT JOIN (
        SELECT striker AS player_id,
               COUNT(*) AS balls_faced
        FROM   ball_by_ball
        GROUP  BY striker
     )  AS bf            USING (player_id)
/* Bowling aggregates */
LEFT JOIN (
        SELECT bb.bowler AS player_id,
               COUNT(*)  AS wickets_taken
        FROM   ball_by_ball AS bb
        JOIN   wicket_taken AS wt
               ON wt.match_id = bb.match_id
              AND wt.over_id  = bb.over_id
              AND wt.ball_id  = bb.ball_id
        GROUP  BY bb.bowler
     )  AS w             USING (player_id)
LEFT JOIN (
        SELECT bb.bowler AS player_id,
               SUM(bs.runs_scored) AS runs_conceded,
               COUNT(*)            AS balls_bowled
        FROM   ball_by_ball   AS bb
        JOIN   batsman_scored AS bs
               USING (match_id, over_id, ball_id, innings_no)
        GROUP  BY bb.bowler
     )  AS eb            USING (player_id)
/* Highest score */
LEFT JOIN (
        SELECT player_id,
               MAX(runs_in_match) AS highest_score
        FROM (
                SELECT bb.striker AS player_id,
                       bb.match_id,
                       SUM(bs.runs_scored) AS runs_in_match
                FROM   ball_by_ball   AS bb
                JOIN   batsman_scored AS bs
                       USING (match_id, over_id, ball_id, innings_no)
                GROUP  BY bb.striker, bb.match_id
             )
        GROUP BY player_id
     ) AS hs             USING (player_id)
/* 30/50/100 counts */
LEFT JOIN (
        SELECT player_id,
               SUM(CASE WHEN runs_in_match>=30  THEN 1 ELSE 0 END) AS matches_30_plus,
               SUM(CASE WHEN runs_in_match>=50  THEN 1 ELSE 0 END) AS matches_50_plus,
               SUM(CASE WHEN runs_in_match>=100 THEN 1 ELSE 0 END) AS matches_100_plus
        FROM (
                SELECT bb.striker AS player_id,
                       bb.match_id,
                       SUM(bs.runs_scored) AS runs_in_match
                FROM   ball_by_ball   AS bb
                JOIN   batsman_scored AS bs
                       USING (match_id, over_id, ball_id, innings_no)
                GROUP  BY bb.striker, bb.match_id
             )
        GROUP BY player_id
     ) AS c             USING (player_id)
/* Best bowling */
LEFT JOIN (
        SELECT player_id,
               MAX(wickets)||'-'||MIN(runs_conceded) AS best_bowling
        FROM (
                SELECT bb.bowler AS player_id,
                       bb.match_id,
                       COUNT(wt.player_out)        AS wickets,
                       SUM(bs.runs_scored)         AS runs_conceded
                FROM   ball_by_ball   AS bb
                LEFT  JOIN wicket_taken  AS wt
                       ON wt.match_id = bb.match_id
                      AND wt.over_id  = bb.over_id
                      AND wt.ball_id  = bb.ball_id
                JOIN   batsman_scored AS bs
                       USING (match_id, over_id, ball_id, innings_no)
                GROUP  BY bb.bowler, bb.match_id
             )
        GROUP BY player_id
     ) AS bp            USING (player_id)
LIMIT 20;
