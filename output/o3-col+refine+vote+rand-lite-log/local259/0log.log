```sql
-- 1. Distinct roles a player can have in a match
SELECT DISTINCT "role"
FROM "player_match"
LIMIT 20;
```

```sql
-- 2. Quick look at player basic information (id, name, batting & bowling styles)
SELECT "player_id",
       "player_name",
       "batting_hand",
       "bowling_skill",
       "country_name"
FROM "player"
LIMIT 20;
```

```sql
-- 3. How many runs (batsman_scored) events exist and their range
SELECT DISTINCT "runs_scored"
FROM "batsman_scored"
ORDER BY "runs_scored"
LIMIT 20;
```

```sql
-- 4. Example of total runs scored by a batsman in a single match
SELECT bs."match_id",
       bb."striker"         AS "batsman_id",
       SUM(bs."runs_scored") AS "runs_in_match"
FROM   "ball_by_ball" AS bb
JOIN   "batsman_scored" AS bs
       ON bb."match_id" = bs."match_id"
      AND bb."over_id"  = bs."over_id"
      AND bb."ball_id"  = bs."ball_id"
      AND bb."innings_no" = bs."innings_no"
GROUP  BY bs."match_id", bb."striker"
LIMIT 20;
```

```sql
-- 5. Distinct dismissal types recorded
SELECT DISTINCT "kind_out"
FROM "wicket_taken"
LIMIT 20;
```

```sql
-- 6. Sample of wickets credited to a bowler in a match
SELECT wt."match_id",
       bb."bowler"          AS "bowler_id",
       COUNT(*)             AS "wickets_in_match"
FROM   "wicket_taken" AS wt
JOIN   "ball_by_ball" AS bb
       ON wt."match_id" = bb."match_id"
      AND wt."over_id"  = bb."over_id"
      AND wt."ball_id"  = bb."ball_id"
      AND wt."innings_no" = bb."innings_no"
GROUP  BY wt."match_id", bb."bowler"
LIMIT 20;
```

```sql
-- 7. Balls faced by each batsman (career-wide) – helps for strike-rate
SELECT bb."striker" AS "batsman_id",
       COUNT(*)     AS "balls_faced"
FROM   "ball_by_ball" AS bb
GROUP  BY bb."striker"
LIMIT 20;
```

```sql
-- 8. Balls bowled by each bowler and corresponding legal deliveries (helps for economy)
SELECT bb."bowler" AS "bowler_id",
       COUNT(*)    AS "balls_bowled"
FROM   "ball_by_ball" AS bb
GROUP  BY bb."bowler"
LIMIT 20;
```

```sql
-- 9. Matches played by each player (any role) – for appearance count
SELECT "player_id",
       COUNT(DISTINCT "match_id") AS "matches_played"
FROM   "player_match"
GROUP  BY "player_id"
LIMIT 20;
```

```sql
-- 10. Highest individual score by a batsman in any match
SELECT t."batsman_id",
       MAX(t."runs_in_match") AS "highest_score"
FROM (
        SELECT bs."match_id",
               bb."striker"         AS "batsman_id",
               SUM(bs."runs_scored") AS "runs_in_match"
        FROM   "ball_by_ball" AS bb
        JOIN   "batsman_scored" AS bs
               ON bb."match_id" = bs."match_id"
              AND bb."over_id"  = bs."over_id"
              AND bb."ball_id"  = bs."ball_id"
              AND bb."innings_no" = bs."innings_no"
        GROUP  BY bs."match_id", bb."striker"
     ) AS t
GROUP BY t."batsman_id"
LIMIT 20;
```
