Below are 10 exploratory SQLite queries (each limited to 20 rows) that progressively inspect the main columns you will need in order to compute every statistic requested in the final problem statement.

```sql
-- 1) Overview of players: IDs, names, batting hand and bowling skill
SELECT DISTINCT
       p.player_id,
       p.player_name,
       p.batting_hand,
       p.bowling_skill
FROM   player AS p
LIMIT 20;
```

```sql
-- 2) Distinct combinations of batting-hand and bowling-skill that appear in the database
SELECT DISTINCT
       batting_hand,
       bowling_skill
FROM   player
LIMIT 20;
```

```sql
-- 3) Distinct roles that a player can have in the “player_match” table
SELECT DISTINCT
       role
FROM   player_match
LIMIT 20;
```

```sql
-- 4) Sample of how many matches each player has appeared in
SELECT DISTINCT
       pm.player_id,
       COUNT(pm.match_id) AS matches_played
FROM   player_match AS pm
GROUP  BY pm.player_id
ORDER  BY matches_played DESC
LIMIT 20;
```

```sql
-- 5) Total career runs (ignoring extras) for each striker
SELECT DISTINCT
       bb.striker        AS player_id,
       SUM(bs.runs_scored) AS total_runs
FROM   ball_by_ball AS bb
JOIN   batsman_scored AS bs
       ON  bb.match_id = bs.match_id
       AND bb.over_id  = bs.over_id
       AND bb.ball_id  = bs.ball_id
GROUP  BY bb.striker
ORDER  BY total_runs DESC
LIMIT 20;
```

```sql
-- 6) Total balls faced (deliveries) by each player
SELECT DISTINCT
       striker AS player_id,
       COUNT(*) AS balls_faced
FROM   ball_by_ball
GROUP  BY striker
ORDER  BY balls_faced DESC
LIMIT 20;
```

```sql
-- 7) Number of dismissals for each player (how many times they were out)
SELECT DISTINCT
       wt.player_out AS player_id,
       COUNT(*)      AS dismissals
FROM   wicket_taken AS wt
GROUP  BY wt.player_out
ORDER  BY dismissals DESC
LIMIT 20;
```

```sql
-- 8) Highest score by a player in any single match
SELECT DISTINCT
       runs_by_match.player_id,
       MAX(runs_by_match.match_runs) AS highest_score
FROM   (
        SELECT bb.striker AS player_id,
               bb.match_id,
               SUM(bs.runs_scored) AS match_runs
        FROM   ball_by_ball AS bb
        JOIN   batsman_scored AS bs
               ON  bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
        GROUP  BY bb.striker, bb.match_id
       ) AS runs_by_match
GROUP  BY runs_by_match.player_id
ORDER  BY highest_score DESC
LIMIT 20;
```

```sql
-- 9) Career wickets taken by each bowler
SELECT DISTINCT
       bb.bowler AS player_id,
       COUNT(wt.player_out) AS wickets
FROM   ball_by_ball AS bb
LEFT JOIN wicket_taken AS wt
       ON  wt.match_id = bb.match_id
       AND wt.over_id  = bb.over_id
       AND wt.ball_id  = bb.ball_id
GROUP  BY bb.bowler
ORDER  BY wickets DESC
LIMIT 20;
```

```sql
-- 10) Best bowling performance per bowler in a single match (wickets & runs conceded)
SELECT DISTINCT
       perf.player_id,
       perf.wickets_in_match || '-' || perf.runs_conceded AS best_figure
FROM   (
        SELECT  bb.bowler AS player_id,
                bb.match_id,
                COUNT(wt.player_out)                       AS wickets_in_match,
                SUM(bs.runs_scored)                        AS runs_conceded,
                ROW_NUMBER() OVER (
                    PARTITION BY bb.bowler
                    ORDER BY COUNT(wt.player_out) DESC,
                             SUM(bs.runs_scored) ASC
                ) AS rn
        FROM    ball_by_ball AS bb
        JOIN    batsman_scored AS bs
                ON bb.match_id = bs.match_id
               AND bb.over_id  = bs.over_id
               AND bb.ball_id  = bs.ball_id
        LEFT JOIN wicket_taken AS wt
                ON wt.match_id = bb.match_id
               AND wt.over_id  = bb.over_id
               AND wt.ball_id  = bb.ball_id
        GROUP   BY bb.bowler, bb.match_id
       ) AS perf
WHERE  perf.rn = 1      -- keep only the best match per bowler
LIMIT 20;
```

These queries reveal:
• player identities and attributes  
• roles in matches  
• matches played, runs scored, balls faced, dismissals  
• highest individual scores, wicket tallies, and best bowling figures  

With these building blocks, you can compose the full query (or set of queries) that aggregates every batting and bowling statistic specified in the main task.
