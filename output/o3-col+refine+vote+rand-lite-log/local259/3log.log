```sql
--Description: 1) Show the different kinds of roles a player can have in a match
SELECT DISTINCT "role"
FROM "player_match"
LIMIT 20;
```

```sql
--Description: 2) Display the various batting-hand styles recorded in the database
SELECT DISTINCT "batting_hand"
FROM "player"
WHERE "batting_hand" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3) Display the various bowling-skill descriptions recorded in the database
SELECT DISTINCT "bowling_skill"
FROM "player"
WHERE "bowling_skill" IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Sample of deliveries with the batter involved and the runs scored off that ball
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker"          AS "batsman_id",
       bs."runs_scored"
FROM   "ball_by_ball" AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id" = bs."match_id"
       AND b."over_id"  = bs."over_id"
       AND b."ball_id"  = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
LIMIT 20;
```

```sql
--Description: 5) Aggregate: total career runs for each batter
SELECT DISTINCT b."striker" AS "player_id",
       SUM(bs."runs_scored") AS "total_runs"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id" = bs."match_id"
       AND b."over_id"  = bs."over_id"
       AND b."ball_id"  = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
GROUP  BY b."striker"
ORDER  BY "total_runs" DESC
LIMIT 20;
```

```sql
--Description: 6) Aggregate: total number of times each player was dismissed
SELECT DISTINCT "player_out" AS "player_id",
       COUNT(*)             AS "dismissals"
FROM   "wicket_taken"
GROUP  BY "player_out"
ORDER  BY "dismissals" DESC
LIMIT 20;
```

```sql
--Description: 7) Aggregate: balls faced (deliveries received) by each batter
SELECT DISTINCT "striker" AS "player_id",
       COUNT(*)  AS "balls_faced"
FROM   "ball_by_ball"
GROUP  BY "striker"
ORDER  BY "balls_faced" DESC
LIMIT 20;
```

```sql
--Description: 8) Aggregate: total wickets credited to each bowler
SELECT DISTINCT b."bowler" AS "player_id",
       COUNT(*)            AS "wickets_taken"
FROM   "wicket_taken"  AS w
JOIN   "ball_by_ball"  AS b
       ON  w."match_id"  = b."match_id"
       AND w."over_id"   = b."over_id"
       AND w."ball_id"   = b."ball_id"
       AND w."innings_no"= b."innings_no"
GROUP  BY b."bowler"
ORDER  BY "wickets_taken" DESC
LIMIT 20;
```

```sql
--Description: 9) Aggregate: runs conceded and balls bowled for each bowler (ignores extras)
SELECT DISTINCT b."bowler" AS "player_id",
       SUM(bs."runs_scored") AS "runs_conceded",
       COUNT(*)              AS "balls_bowled"
FROM   "ball_by_ball"  AS b
JOIN   "batsman_scored" AS bs
       ON  b."match_id" = bs."match_id"
       AND b."over_id"  = bs."over_id"
       AND b."ball_id"  = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
GROUP  BY b."bowler"
ORDER  BY "runs_conceded" DESC
LIMIT 20;
```

```sql
--Description: 10) Per-match bowling figures: wickets & runs conceded; ordered to find each bowler’s best spell
SELECT DISTINCT b."bowler" AS "player_id",
       b."match_id",
       COUNT(w."player_out")        AS "wickets_in_match",
       SUM(bs."runs_scored")        AS "runs_conceded"
FROM   "ball_by_ball"  AS b
LEFT JOIN "wicket_taken" AS w
       ON  w."match_id"  = b."match_id"
       AND w."over_id"   = b."over_id"
       AND w."ball_id"   = b."ball_id"
       AND w."innings_no"= b."innings_no"
JOIN   "batsman_scored" AS bs
       ON  bs."match_id" = b."match_id"
       AND bs."over_id"  = b."over_id"
       AND bs."ball_id"  = b."ball_id"
       AND bs."innings_no"= b."innings_no"
GROUP  BY b."bowler", b."match_id"
ORDER  BY "wickets_in_match" DESC,
          "runs_conceded"   ASC
LIMIT 20;
```
