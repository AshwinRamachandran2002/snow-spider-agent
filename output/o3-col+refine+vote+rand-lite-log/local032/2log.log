```sql
--Description:
-- We want four separate “bests” among sellers, restricted to delivered orders:
--   1. Most distinct customers (by customer_unique_id)
--   2. Highest profit (SUM(price – freight_value))
--   3. Most distinct orders
--   4. Most 5-star reviews
-- Approach (all inside one query):
-- • delivered_items  : joins orders → items → customers keeping only delivered orders.
-- • seller_metrics   : aggregates delivered_items once to get three KPIs per seller.
-- • five_star        : counts 5-star reviews per seller on delivered orders.
-- • max_* CTEs       : each picks the seller topping a single KPI, returning seller_id + value.
-- • Final UNION ALL  : stacks the four records, each labelled with its achievement.

WITH delivered_items AS (
    SELECT oi.seller_id,
           o.order_id,
           c.customer_unique_id,
           oi.price,
           oi.freight_value
    FROM   olist_order_items  AS oi
    JOIN   olist_orders       AS o ON o.order_id    = oi.order_id
    JOIN   olist_customers    AS c ON c.customer_id = o.customer_id
    WHERE  o.order_status = 'delivered'
),
seller_metrics AS (
    SELECT seller_id,
           COUNT(DISTINCT customer_unique_id) AS distinct_customers,
           SUM(price - freight_value)         AS profit,
           COUNT(DISTINCT order_id)           AS distinct_orders
    FROM   delivered_items
    GROUP BY seller_id
),
five_star AS (
    SELECT oi.seller_id,
           COUNT(*) AS five_star_reviews
    FROM   olist_order_items   AS oi
    JOIN   olist_orders        AS o ON o.order_id = oi.order_id
    JOIN   olist_order_reviews AS r ON r.order_id = o.order_id
    WHERE  o.order_status = 'delivered'
      AND  r.review_score = 5
    GROUP BY oi.seller_id
),
max_customers AS (
    SELECT 'Most distinct customers' AS achievement,
           seller_id,
           distinct_customers        AS value
    FROM   seller_metrics
    ORDER BY distinct_customers DESC
    LIMIT 1
),
max_profit AS (
    SELECT 'Highest profit' AS achievement,
           seller_id,
           profit           AS value
    FROM   seller_metrics
    ORDER BY profit DESC
    LIMIT 1
),
max_orders AS (
    SELECT 'Most distinct orders' AS achievement,
           seller_id,
           distinct_orders        AS value
    FROM   seller_metrics
    ORDER BY distinct_orders DESC
    LIMIT 1
),
max_five AS (
    SELECT 'Most 5-star reviews' AS achievement,
           seller_id,
           five_star_reviews      AS value
    FROM   five_star
    ORDER BY five_star_reviews DESC
    LIMIT 1
)
SELECT * FROM max_customers
UNION ALL
SELECT * FROM max_profit
UNION ALL
SELECT * FROM max_orders
UNION ALL
SELECT * FROM max_five;
```
