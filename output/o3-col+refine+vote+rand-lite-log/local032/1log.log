```sql
-- 1) Preview the orders that were actually delivered
SELECT DISTINCT o.order_id, o.customer_id, o.order_status
FROM olist_orders AS o
WHERE o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- 2) Count how many DISTINCT customer *unique* IDs each seller has reached (delivered orders only)
SELECT oi.seller_id,
       COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM   olist_order_items  AS oi
JOIN   olist_orders       AS o  ON o.order_id   = oi.order_id
JOIN   olist_customers    AS c  ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
GROUP  BY oi.seller_id
ORDER  BY distinct_customers DESC
LIMIT 20;
```

```sql
-- 3) Top-1 seller by number of DISTINCT customer unique IDs
SELECT oi.seller_id,
       COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM   olist_order_items  AS oi
JOIN   olist_orders       AS o  ON o.order_id   = oi.order_id
JOIN   olist_customers    AS c  ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
GROUP  BY oi.seller_id
ORDER  BY distinct_customers DESC
LIMIT 1;
```

```sql
-- 4) Total PROFIT (= Σ(price − freight_value)) earned by every seller (delivered orders only)
SELECT oi.seller_id,
       SUM(oi.price - oi.freight_value) AS total_profit
FROM   olist_order_items AS oi
JOIN   olist_orders      AS o  ON o.order_id = oi.order_id
WHERE  o.order_status = 'delivered'
GROUP  BY oi.seller_id
ORDER  BY total_profit DESC
LIMIT 20;
```

```sql
-- 5) Top-1 seller by TOTAL PROFIT
SELECT oi.seller_id,
       SUM(oi.price - oi.freight_value) AS total_profit
FROM   olist_order_items AS oi
JOIN   olist_orders      AS o  ON o.order_id = oi.order_id
WHERE  o.order_status = 'delivered'
GROUP  BY oi.seller_id
ORDER  BY total_profit DESC
LIMIT 1;
```

```sql
-- 6) Count DISTINCT delivered orders each seller fulfilled
SELECT oi.seller_id,
       COUNT(DISTINCT oi.order_id) AS distinct_orders
FROM   olist_order_items AS oi
JOIN   olist_orders      AS o  ON o.order_id = oi.order_id
WHERE  o.order_status = 'delivered'
GROUP  BY oi.seller_id
ORDER  BY distinct_orders DESC
LIMIT 20;
```

```sql
-- 7) Number of 5-star REVIEWED delivered orders for each seller
SELECT oi.seller_id,
       COUNT(DISTINCT oi.order_id) AS five_star_orders
FROM   olist_order_items   AS oi
JOIN   olist_order_reviews AS r  ON r.order_id = oi.order_id
JOIN   olist_orders        AS o  ON o.order_id = oi.order_id
WHERE  o.order_status = 'delivered'
  AND  r.review_score = 5
GROUP  BY oi.seller_id
ORDER  BY five_star_orders DESC
LIMIT 20;
```

```sql
-- 8) FINAL answer – four “champions” and their winning metric
WITH
distinct_cust AS (
    SELECT oi.seller_id,
           COUNT(DISTINCT c.customer_unique_id) AS metric
    FROM   olist_order_items  AS oi
    JOIN   olist_orders       AS o  ON o.order_id = oi.order_id
    JOIN   olist_customers    AS c  ON c.customer_id = o.customer_id
    WHERE  o.order_status = 'delivered'
    GROUP  BY oi.seller_id
    ORDER  BY metric DESC
    LIMIT 1
),
profit AS (
    SELECT oi.seller_id,
           SUM(oi.price - oi.freight_value) AS metric
    FROM   olist_order_items AS oi
    JOIN   olist_orders      AS o ON o.order_id = oi.order_id
    WHERE  o.order_status = 'delivered'
    GROUP  BY oi.seller_id
    ORDER  BY metric DESC
    LIMIT 1
),
distinct_orders AS (
    SELECT oi.seller_id,
           COUNT(DISTINCT oi.order_id) AS metric
    FROM   olist_order_items AS oi
    JOIN   olist_orders      AS o ON o.order_id = oi.order_id
    WHERE  o.order_status = 'delivered'
    GROUP  BY oi.seller_id
    ORDER  BY metric DESC
    LIMIT 1
),
five_star AS (
    SELECT oi.seller_id,
           COUNT(DISTINCT oi.order_id) AS metric
    FROM   olist_order_items   AS oi
    JOIN   olist_order_reviews AS r ON r.order_id = oi.order_id
    JOIN   olist_orders        AS o ON o.order_id = oi.order_id
    WHERE  o.order_status = 'delivered'
      AND  r.review_score = 5
    GROUP  BY oi.seller_id
    ORDER  BY metric DESC
    LIMIT 1
)
SELECT 'Most distinct customers' AS description, seller_id, metric AS value FROM distinct_cust
UNION ALL
SELECT 'Highest profit'          AS description, seller_id, metric AS value FROM profit
UNION ALL
SELECT 'Most distinct orders'    AS description, seller_id, metric AS value FROM distinct_orders
UNION ALL
SELECT 'Most 5-star ratings'     AS description, seller_id, metric AS value FROM five_star;
```
