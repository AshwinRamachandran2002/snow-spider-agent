```sql
--Description: list every different status that exists inside the orders table
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
--Description: preview a few different seller IDs that appear in the sellers table
SELECT DISTINCT "seller_id"
FROM "olist_sellers"
LIMIT 20;
```

```sql
--Description: show some delivered orders together with the seller that took part in them
SELECT DISTINCT oi."order_id",
       oi."seller_id",
       o."order_status"
FROM "olist_order_items"  AS oi
JOIN "olist_orders"       AS o  ON o."order_id" = oi."order_id"
WHERE o."order_status" = 'delivered'
LIMIT 20;
```

```sql
--Description: calculate the total profit (∑ price – freight) per seller for delivered orders
SELECT DISTINCT sp."seller_id",
       sp."total_profit"
FROM (
        SELECT oi."seller_id",
               SUM(oi."price" - oi."freight_value") AS "total_profit"
        FROM   "olist_order_items" AS oi
        JOIN   "olist_orders"      AS o  ON o."order_id" = oi."order_id"
        WHERE  o."order_status" = 'delivered'
        GROUP BY oi."seller_id"
     ) AS sp
ORDER BY sp."total_profit" DESC
LIMIT 20;
```

```sql
--Description: number of different customer_unique_id’s served by every seller (delivered orders only)
SELECT DISTINCT sc."seller_id",
       sc."distinct_customers"
FROM (
        SELECT oi."seller_id",
               COUNT(DISTINCT cu."customer_unique_id") AS "distinct_customers"
        FROM   "olist_order_items" AS oi
        JOIN   "olist_orders"      AS o   ON o."order_id" = oi."order_id"
        JOIN   "olist_customers"   AS cu  ON cu."customer_id" = o."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP BY oi."seller_id"
     ) AS sc
ORDER BY sc."distinct_customers" DESC
LIMIT 20;
```

```sql
--Description: number of distinct delivered orders handled by each seller
SELECT DISTINCT so."seller_id",
       so."distinct_orders"
FROM (
        SELECT oi."seller_id",
               COUNT(DISTINCT oi."order_id") AS "distinct_orders"
        FROM   "olist_order_items" AS oi
        JOIN   "olist_orders"      AS o  ON o."order_id" = oi."order_id"
        WHERE  o."order_status" = 'delivered'
        GROUP BY oi."seller_id"
     ) AS so
ORDER BY so."distinct_orders" DESC
LIMIT 20;
```

```sql
--Description: number of 5-star reviews attributed to each seller (for delivered orders)
SELECT DISTINCT sr."seller_id",
       sr."five_star_reviews"
FROM (
        SELECT oi."seller_id",
               COUNT(DISTINCT r."review_id") AS "five_star_reviews"
        FROM   "olist_order_items"   AS oi
        JOIN   "olist_orders"        AS o  ON o."order_id" = oi."order_id"
        JOIN   "olist_order_reviews" AS r  ON r."order_id" = o."order_id"
        WHERE  o."order_status" = 'delivered'
          AND  r."review_score" = 5
        GROUP BY oi."seller_id"
     ) AS sr
ORDER BY sr."five_star_reviews" DESC
LIMIT 20;
```

```sql
--Description: give the single top-performing seller for each requested category and label every row accordingly
WITH delivered AS (
    SELECT DISTINCT "order_id", "customer_id"
    FROM "olist_orders"
    WHERE "order_status" = 'delivered'
),
profit AS (
    SELECT oi."seller_id",
           SUM(oi."price" - oi."freight_value") AS total_profit
    FROM   "olist_order_items" AS oi
    JOIN   delivered           AS d  ON d."order_id" = oi."order_id"
    GROUP BY oi."seller_id"
),
customers AS (
    SELECT oi."seller_id",
           COUNT(DISTINCT cu."customer_unique_id") AS distinct_customers
    FROM   "olist_order_items" AS oi
    JOIN   delivered           AS d  ON d."order_id" = oi."order_id"
    JOIN   "olist_customers"   AS cu ON cu."customer_id" = d."customer_id"
    GROUP BY oi."seller_id"
),
orders AS (
    SELECT oi."seller_id",
           COUNT(DISTINCT oi."order_id") AS distinct_orders
    FROM   "olist_order_items" AS oi
    JOIN   delivered           AS d  ON d."order_id" = oi."order_id"
    GROUP BY oi."seller_id"
),
five_star AS (
    SELECT oi."seller_id",
           COUNT(DISTINCT r."review_id") AS five_star_reviews
    FROM   "olist_order_items"   AS oi
    JOIN   delivered             AS d  ON d."order_id" = oi."order_id"
    JOIN   "olist_order_reviews" AS r  ON r."order_id" = d."order_id"
    WHERE  r."review_score" = 5
    GROUP BY oi."seller_id"
)
SELECT DISTINCT 'Most distinct customer unique IDs' AS achievement,
       c."seller_id",
       c."distinct_customers"     AS value
FROM   customers AS c
WHERE  c."distinct_customers" = (SELECT MAX(distinct_customers) FROM customers)

UNION ALL
SELECT DISTINCT 'Highest profit',
       p."seller_id",
       p."total_profit"
FROM   profit AS p
WHERE  p."total_profit" = (SELECT MAX(total_profit) FROM profit)

UNION ALL
SELECT DISTINCT 'Most distinct orders',
       o."seller_id",
       o."distinct_orders"
FROM   orders AS o
WHERE  o."distinct_orders" = (SELECT MAX(distinct_orders) FROM orders)

UNION ALL
SELECT DISTINCT 'Most 5-star ratings',
       f."seller_id",
       f."five_star_reviews"
FROM   five_star AS f
WHERE  f."five_star_reviews" = (SELECT MAX(five_star_reviews) FROM five_star)
LIMIT 20;
```
