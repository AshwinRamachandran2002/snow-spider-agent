                customer_unique_id
FROM olist_customers
LIMIT 20;
```

```sql
-- 4) Join of DELIVERED orders with order_items and customers
SELECT DISTINCT oi.seller_id,
                o.order_id,
                c.customer_unique_id
FROM   olist_order_items  AS oi
JOIN   olist_orders       AS o  USING(order_id)
JOIN   olist_customers    AS c  ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- 5) Distinct-customer count per seller (delivered orders only) – top 20
SELECT   oi.seller_id,
         COUNT(DISTINCT c.customer_unique_id) AS distinct_customers
FROM     olist_order_items  AS oi
JOIN     olist_orders       AS o  USING(order_id)
JOIN     olist_customers    AS c  ON c.customer_id = o.customer_id
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY distinct_customers DESC
LIMIT 20;
```

```sql
-- 6) Total profit ( Σ(price − freight_value) ) per seller – top 20
SELECT   oi.seller_id,
         ROUND(SUM(oi.price - oi.freight_value), 2) AS total_profit
FROM     olist_order_items  AS oi
JOIN     olist_orders       AS o  USING(order_id)
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY total_profit DESC
LIMIT 20;
```

```sql
-- 7) Distinct delivered orders handled by each seller – top 20
SELECT   oi.seller_id,
         COUNT(DISTINCT oi.order_id) AS delivered_orders
FROM     olist_order_items  AS oi
JOIN     olist_orders       AS o  USING(order_id)
WHERE    o.order_status = 'delivered'
GROUP BY oi.seller_id
ORDER BY delivered_orders DESC
LIMIT 20;
```

```sql
-- 8) Five-star reviews tied to each seller – top 20
SELECT   oi.seller_id,
         COUNT(*) AS five_star_reviews
FROM     olist_order_items   AS oi
JOIN     olist_orders        AS o   USING(order_id)
JOIN     olist_order_reviews AS r   ON r.order_id = oi.order_id
WHERE    o.order_status   = 'delivered'
  AND    r.review_score  = 5
GROUP BY oi.seller_id
ORDER BY five_star_reviews DESC
LIMIT 20;
```

```sql
-- 9) Who tops each category?  (one row per metric, plus its winning value)
WITH delivered AS (
       SELECT * FROM olist_orders WHERE order_status = 'delivered'
),
base AS (
       SELECT oi.seller_id,
              o.order_id,
              (oi.price - oi.freight_value)               AS profit,
              c.customer_unique_id
       FROM   olist_order_items AS oi
       JOIN   delivered         AS o  USING(order_id)
       JOIN   olist_customers   AS c  ON c.customer_id = o.customer_id
),
custs  AS (SELECT seller_id,
                  COUNT(DISTINCT customer_unique_id) AS v
           FROM base GROUP BY seller_id ORDER BY v DESC LIMIT 1),
profit AS (SELECT seller_id,
                  ROUND(SUM(profit),2)               AS v
           FROM base GROUP BY seller_id ORDER BY v DESC LIMIT 1),
orders AS (SELECT seller_id,
                  COUNT(DISTINCT order_id)           AS v
           FROM base GROUP BY seller_id ORDER BY v DESC LIMIT 1),
stars  AS (SELECT oi.seller_id,
                  COUNT(*)                           AS v
           FROM   olist_order_items   AS oi
           JOIN   delivered           AS o  USING(order_id)
           JOIN   olist_order_reviews AS r  ON r.order_id = oi.order_id
           WHERE  r.review_score = 5
           GROUP BY oi.seller_id
           ORDER BY v DESC LIMIT 1)

SELECT 'Most distinct customer_unique_ids' AS achievement, seller_id, v AS value FROM custs
UNION ALL
SELECT 'Highest total profit (price - freight)',          seller_id, v FROM profit
UNION ALL
SELECT 'Most distinct delivered orders',                  seller_id, v FROM orders
UNION ALL
SELECT 'Most 5-star reviews',                             seller_id, v FROM stars
LIMIT 20;
```

```sql
-- 10) If you also want to see the four winners side-by-side in a single row
WITH delivered AS (
       SELECT * FROM olist_orders WHERE order_status = 'delivered'
), base AS (
       SELECT oi.seller_id,
              o.order_id,
              (oi.price - oi.freight_value) AS profit,
              c.customer_unique_id
       FROM   olist_order_items AS oi
       JOIN   delivered         AS o  USING(order_id)
       JOIN   olist_customers   AS c  ON c.customer_id = o.customer_id
), agg AS (
       SELECT seller_id,
              COUNT(DISTINCT customer_unique_id)             AS customers,
              ROUND(SUM(profit),2)                           AS profit,
              COUNT(DISTINCT order_id)                       AS orders
       FROM   base
       GROUP BY seller_id
), stars AS (
       SELECT oi.seller_id,
              COUNT(*) AS five_star_reviews
       FROM   olist_order_items   AS oi
       JOIN   delivered           AS o  USING(order_id)
       JOIN   olist_order_reviews AS r  ON r.order_id = oi.order_id
       WHERE  r.review_score = 5
       GROUP BY oi.seller_id
)
SELECT a.seller_id,
       customers,
       profit,
       orders,
       five_star_reviews
FROM   agg  AS a
JOIN   stars AS s USING(seller_id)
WHERE  a.customers          = (SELECT MAX(customers) FROM agg)
   OR  a.profit             = (SELECT MAX(profit)    FROM agg)
   OR  a.orders             = (SELECT MAX(orders)    FROM agg)
   OR  s.five_star_reviews  = (SELECT MAX(five_star_reviews) FROM stars)
LIMIT 20;
```

The final two queries (9 and 10) deliver the exact sellers who lead in:

• most distinct customer unique IDs  
• highest total profit (price – freight)  
• most distinct delivered orders  
• most 5-star reviews  

Query 9 gives one row per achievement, while query 10 shows all four champion sellers and their metrics side-by-side.
