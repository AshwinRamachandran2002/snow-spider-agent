Query:
-- 4) Count the number of DISTINCT customer_unique_id each seller has served (top 20 sellers shown)
SELECT seller_id,
       COUNT(DISTINCT customer_unique_id) AS distinct_customers
FROM (
      SELECT o.order_id,
             c.customer_unique_id,
             oi.seller_id
      FROM  olist_orders      AS o
      JOIN  olist_customers   AS c  ON o.customer_id = c.customer_id
      JOIN  olist_order_items AS oi ON o.order_id     = oi.order_id
      WHERE o.order_status = 'delivered'
) AS delivered_base
GROUP BY seller_id
ORDER BY distinct_customers DESC
LIMIT 20;
