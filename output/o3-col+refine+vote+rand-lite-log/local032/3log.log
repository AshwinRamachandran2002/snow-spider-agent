```sql
-- 1) Inspect the “olist_orders” table and keep only orders whose status is “delivered”
SELECT DISTINCT order_id, customer_id
FROM olist_orders
WHERE order_status = 'delivered'
LIMIT 20;
```

```sql
-- 2) Bring the seller information into the delivered orders by joining with “olist_order_items”
SELECT DISTINCT o.order_id,
       oi.seller_id
FROM olist_orders AS o
JOIN olist_order_items AS oi
      ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- 3) Add the customer_unique_id so we can later count distinct customers per seller
SELECT DISTINCT o.order_id,
       c.customer_unique_id,
       oi.seller_id
FROM olist_orders          AS o
JOIN olist_customers       AS c  ON o.customer_id = c.customer_id
JOIN olist_order_items     AS oi ON o.order_id     = oi.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- 4) Count the number of DISTINCT customer_unique_id each seller has served (top 20 sellers shown)
SELECT seller_id,
       COUNT(DISTINCT customer_unique_id) AS distinct_customers
FROM (
      SELECT o.order_id,
             c.customer_unique_id,
             oi.seller_id
      FROM  olist_orders      AS o
      JOIN  olist_customers   AS c  ON o.customer_id = c.customer_id
      JOIN  olist_order_items AS oi ON o.order_id     = oi.order_id
      WHERE o.order_status = 'delivered'
) AS delivered_base
GROUP BY seller_id
ORDER BY distinct_customers DESC
LIMIT 20;
```

```sql
-- 5) Compute total PROFIT (SUM(price - freight_value)) for each seller on delivered orders (top 20)
SELECT seller_id,
       SUM(price - freight_value) AS total_profit
FROM  olist_order_items  AS oi
JOIN  olist_orders       AS o  ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY seller_id
ORDER BY total_profit DESC
LIMIT 20;
```

```sql
-- 6) Count DISTINCT orders handled by each seller on delivered orders (top 20)
SELECT seller_id,
       COUNT(DISTINCT oi.order_id) AS distinct_orders
FROM olist_order_items AS oi
JOIN olist_orders      AS o ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY seller_id
ORDER BY distinct_orders DESC
LIMIT 20;
```

```sql
-- 7) Bring in 5-star reviews and count how many such orders each seller has (top 20)
SELECT seller_id,
       COUNT(DISTINCT oi.order_id) AS five_star_orders
FROM  olist_order_reviews AS r
JOIN  olist_orders        AS o  ON r.order_id = o.order_id
JOIN  olist_order_items   AS oi ON oi.order_id = o.order_id
WHERE o.order_status   = 'delivered'
  AND r.review_score  = 5
GROUP BY seller_id
ORDER BY five_star_orders DESC
LIMIT 20;
```

```sql
-- 8) FINAL ANSWER – Four rows, one for each requested “best-in-class” seller
WITH delivered_base AS (
    SELECT o.order_id,
           c.customer_unique_id,
           oi.seller_id,
           (oi.price - oi.freight_value) AS profit
    FROM  olist_orders      AS o
    JOIN  olist_customers   AS c  ON o.customer_id = c.customer_id
    JOIN  olist_order_items AS oi ON o.order_id     = oi.order_id
    WHERE o.order_status = 'delivered'
),
five_star_orders AS (
    SELECT DISTINCT order_id
    FROM olist_order_reviews
    WHERE review_score = 5
)
SELECT 'most_distinct_customers' AS achievement,
       seller_id,
       cnt AS value
FROM (
      SELECT seller_id,
             COUNT(DISTINCT customer_unique_id) AS cnt
      FROM delivered_base
      GROUP BY seller_id
      ORDER BY cnt DESC
      LIMIT 1
)
UNION ALL
SELECT 'highest_profit',
       seller_id,
       total_profit
FROM (
      SELECT seller_id,
             SUM(profit) AS total_profit
      FROM delivered_base
      GROUP BY seller_id
      ORDER BY total_profit DESC
      LIMIT 1
)
UNION ALL
SELECT 'most_distinct_orders',
       seller_id,
       order_cnt
FROM (
      SELECT seller_id,
             COUNT(DISTINCT order_id) AS order_cnt
      FROM delivered_base
      GROUP BY seller_id
      ORDER BY order_cnt DESC
      LIMIT 1
)
UNION ALL
SELECT 'most_5_star_ratings',
       seller_id,
       rating_cnt
FROM (
      SELECT db.seller_id,
             COUNT(DISTINCT db.order_id) AS rating_cnt
      FROM delivered_base AS db
      WHERE db.order_id IN (SELECT order_id FROM five_star_orders)
      GROUP BY db.seller_id
      ORDER BY rating_cnt DESC
      LIMIT 1
);
```

