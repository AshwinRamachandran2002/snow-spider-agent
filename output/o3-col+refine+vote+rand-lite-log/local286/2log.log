```sql
--Description: List all distinct states in which our sellers operate
SELECT DISTINCT "seller_state"
FROM "sellers"
LIMIT 20;
```

```sql
--Description: See the original Brazilian product category names and their English translations
SELECT DISTINCT pct."product_category_name",
                pct."product_category_name_english"
FROM "product_category_name_translation" AS pct
LIMIT 20;
```

```sql
--Description: Look at a sample of order items together with the seller’s city & state
SELECT oi."order_id",
       oi."product_id",
       oi."seller_id",
       oi."price",
       s."seller_city",
       s."seller_state"
FROM "order_items" AS oi
JOIN "sellers"  AS s  ON s."seller_id" = oi."seller_id"
LIMIT 20;
```

```sql
--Description: Find every seller that has sold more than 100 items and how many items they sold
SELECT oi."seller_id",
       COUNT(*) AS "products_sold"
FROM "order_items" AS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: For those high-volume sellers, show total sales value and average item price
SELECT oi."seller_id",
       COUNT(*)          AS "qty_sold",
       SUM(oi."price")   AS "total_sales_value",
       AVG(oi."price")   AS "avg_item_price"
FROM "order_items" AS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Average review score for each high-volume seller
SELECT oi."seller_id",
       AVG(orv."review_score") AS "avg_review_score",
       COUNT(*)                AS "review_count"
FROM "order_items"  AS oi
JOIN "order_reviews" AS orv ON orv."order_id" = oi."order_id"
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Calculate packing time (days) for individual orders (approval → handed to carrier)
SELECT o."order_id",
       JULIANDAY(o."order_delivered_carrier_date")
     - JULIANDAY(o."order_approved_at")      AS "packing_time_days"
FROM "orders" AS o
WHERE o."order_delivered_carrier_date" IS NOT NULL
  AND o."order_approved_at"           IS NOT NULL
LIMIT 20;
```

```sql
--Description: Average packing time for each seller that shipped >100 items
SELECT oi."seller_id",
       AVG( JULIANDAY(o."order_delivered_carrier_date")
           -JULIANDAY(o."order_approved_at") ) AS "avg_packing_time_days",
       COUNT(*)                                 AS "order_count"
FROM "order_items" AS oi
JOIN "orders"      AS o  ON o."order_id" = oi."order_id"
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: How many units each high-volume seller sold per English product category
SELECT oi."seller_id",
       pct."product_category_name_english",
       COUNT(*) AS "qty_sold"
FROM "order_items" AS oi
JOIN "products" AS p  ON p."product_id"             = oi."product_id"
JOIN "product_category_name_translation" AS pct
                      ON pct."product_category_name" = p."product_category_name"
GROUP BY oi."seller_id", pct."product_category_name_english"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: Overall top-selling product categories (English) across the marketplace
SELECT pct."product_category_name_english",
       COUNT(*) AS "total_qty_sold"
FROM "order_items" AS oi
JOIN "products" AS p  ON p."product_id"             = oi."product_id"
JOIN "product_category_name_translation" AS pct
                      ON pct."product_category_name" = p."product_category_name"
GROUP BY pct."product_category_name_english"
ORDER BY COUNT(*) DESC
LIMIT 20;
```
