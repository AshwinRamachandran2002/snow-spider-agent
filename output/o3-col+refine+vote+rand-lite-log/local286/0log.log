```sql
--Description: Quick look at the seller master list (basic seller attributes)
SELECT DISTINCT 
       "seller_id",
       "seller_city",
       "seller_state"
FROM   "sellers"
LIMIT 20;
```

```sql
--Description: Display a sample of sales records that connect orders and sellers
SELECT DISTINCT 
       "order_id",
       "seller_id",
       "product_id",
       "price",
       "freight_value"
FROM   "order_items"
LIMIT 20;
```

```sql
--Description: Identify sellers that have sold more than 100 items (raw counts only)
SELECT 
       "seller_id",
       COUNT(*)            AS "items_sold"
FROM   "order_items"
GROUP  BY "seller_id"
HAVING COUNT(*) > 100
ORDER  BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Compute total sales value (sum of item prices) for high-volume sellers
SELECT 
       oi."seller_id",
       SUM(oi."price")    AS "total_sales_value",
       COUNT(*)           AS "items_sold"
FROM   "order_items" AS oi
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER  BY "total_sales_value" DESC
LIMIT 20;
```

```sql
--Description: Calculate average item price for high-volume sellers
SELECT 
       oi."seller_id",
       AVG(oi."price")    AS "avg_item_price"
FROM   "order_items" AS oi
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER  BY "avg_item_price" DESC
LIMIT 20;
```

```sql
--Description: Derive average review scores per seller (high-volume only)
SELECT 
       oi."seller_id",
       AVG(r."review_score") AS "avg_review_score"
FROM   "order_items"  AS oi
JOIN   "order_reviews" AS r
       ON r."order_id" = oi."order_id"
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER  BY "avg_review_score" DESC
LIMIT 20;
```

```sql
--Description: Measure average packing time (purchase → carrier date) in days for high-volume sellers
SELECT 
       oi."seller_id",
       AVG(
           JULIANDAY(o."order_delivered_carrier_date") 
         - JULIANDAY(o."order_purchase_timestamp")
       ) AS "avg_packing_days"
FROM   "order_items" AS oi
JOIN   "orders"      AS o
       ON o."order_id" = oi."order_id"
WHERE  o."order_delivered_carrier_date" IS NOT NULL
  AND  o."order_purchase_timestamp"     IS NOT NULL
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
ORDER  BY "avg_packing_days"
LIMIT 20;
```

```sql
--Description: Find product category names (English) with the highest overall sales volume
SELECT 
       pct."product_category_name_english",
       COUNT(*) AS "items_sold"
FROM   "order_items"                     AS oi
JOIN   "products"                        AS p   ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS pct
       ON pct."product_category_name" = p."product_category_name"
GROUP  BY pct."product_category_name_english"
ORDER  BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: Pinpoint the top-selling English product category for each high-volume seller
SELECT 
       sub."seller_id",
       sub."product_category_name_english",
       sub."items_sold"
FROM  (
       SELECT 
              oi."seller_id",
              pct."product_category_name_english",
              COUNT(*) AS "items_sold",
              RANK() OVER (
                     PARTITION BY oi."seller_id"
                     ORDER BY COUNT(*) DESC
              ) AS rk
       FROM   "order_items"  AS oi
       JOIN   "products"     AS p   ON p."product_id" = oi."product_id"
       JOIN   "product_category_name_translation" AS pct
              ON pct."product_category_name" = p."product_category_name"
       GROUP  BY oi."seller_id", pct."product_category_name_english"
     ) sub
WHERE  sub.rk = 1
LIMIT 20;
```

```sql
--Description: Final consolidated performance report (all key metrics) for sellers with >100 sales
SELECT 
       s."seller_id",
       s."seller_city",
       s."seller_state",
       sales."items_sold",
       ROUND(sales."total_sales_value", 2)          AS "total_sales_value",
       ROUND(sales."avg_item_price", 2)             AS "avg_item_price",
       ROUND(rev."avg_review_score", 2)             AS "avg_review_score",
       ROUND(pack."avg_packing_days", 2)            AS "avg_packing_days",
       top_cat."product_category_name_english"      AS "top_category_eng"
FROM   "sellers" AS s
JOIN  (
       SELECT 
              "seller_id",
              COUNT(*)            AS "items_sold",
              SUM("price")        AS "total_sales_value",
              AVG("price")        AS "avg_item_price"
       FROM   "order_items"
       GROUP  BY "seller_id"
       HAVING COUNT(*) > 100
     )            AS sales  ON sales."seller_id" = s."seller_id"
LEFT JOIN (
       SELECT 
              oi."seller_id",
              AVG(r."review_score") AS "avg_review_score"
       FROM   "order_items"  AS oi
       JOIN   "order_reviews" AS r
              ON r."order_id" = oi."order_id"
       GROUP  BY oi."seller_id"
     )            AS rev    ON rev."seller_id"   = s."seller_id"
LEFT JOIN (
       SELECT 
              oi."seller_id",
              AVG(
                  JULIANDAY(o."order_delivered_carrier_date") 
                - JULIANDAY(o."order_purchase_timestamp")
              ) AS "avg_packing_days"
       FROM   "order_items" AS oi
       JOIN   "orders"      AS o
              ON o."order_id" = oi."order_id"
       WHERE  o."order_delivered_carrier_date" IS NOT NULL
         AND  o."order_purchase_timestamp"     IS NOT NULL
       GROUP  BY oi."seller_id"
     )            AS pack   ON pack."seller_id"  = s."seller_id"
LEFT JOIN (
       SELECT 
              sub."seller_id",
              sub."product_category_name_english"
       FROM  (
              SELECT 
                     oi."seller_id",
                     pct."product_category_name_english",
                     COUNT(*) AS cnt,
                     RANK() OVER (
                            PARTITION BY oi."seller_id"
                            ORDER BY COUNT(*) DESC
                     ) AS rk
              FROM   "order_items"  AS oi
              JOIN   "products"     AS p   ON p."product_id" = oi."product_id"
              JOIN   "product_category_name_translation" AS pct
                     ON pct."product_category_name" = p."product_category_name"
              GROUP  BY oi."seller_id", pct."product_category_name_english"
           ) sub
       WHERE sub.rk = 1
     )            AS top_cat ON top_cat."seller_id" = s."seller_id"
ORDER  BY sales."items_sold" DESC
LIMIT 20;
```
