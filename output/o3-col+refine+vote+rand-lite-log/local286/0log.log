Query:
--Description: Pinpoint the top-selling English product category for each high-volume seller
SELECT 
       sub."seller_id",
       sub."product_category_name_english",
       sub."items_sold"
FROM  (
       SELECT 
              oi."seller_id",
              pct."product_category_name_english",
              COUNT(*) AS "items_sold",
              RANK() OVER (
                     PARTITION BY oi."seller_id"
                     ORDER BY COUNT(*) DESC
              ) AS rk
       FROM   "order_items"  AS oi
       JOIN   "products"     AS p   ON p."product_id" = oi."product_id"
       JOIN   "product_category_name_translation" AS pct
              ON pct."product_category_name" = p."product_category_name"
       GROUP  BY oi."seller_id", pct."product_category_name_english"
     ) sub
WHERE  sub.rk = 1
