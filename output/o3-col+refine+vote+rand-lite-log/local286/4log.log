```sql
-- 1. Description: Get a first glance at the sellers that exist in the marketplace
SELECT DISTINCT "seller_id",
                "seller_city",
                "seller_state"
FROM   "sellers"
LIMIT 20;
```

```sql
-- 2. Description: Inspect the basic commercial information stored in the
--    order-items table (1 line per product sold)
SELECT DISTINCT "order_id",
                "seller_id",
                "price",
                "freight_value"
FROM   "order_items"
LIMIT 20;
```

```sql
-- 3. Description: Check how many items each seller has already sold
SELECT DISTINCT "seller_id",
                COUNT(*) AS "qty_sold"
FROM   "order_items"
GROUP  BY "seller_id"
LIMIT 20;
```

```sql
-- 4. Description: List only the sellers that have sold more than 100 items
SELECT DISTINCT "seller_id",
                COUNT(*) AS "qty_sold"
FROM   "order_items" AS oi
GROUP  BY "seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
-- 5. Description: Calculate the average packing time (days between order
--    approval and the moment the order left the warehouse) for every seller
SELECT DISTINCT oi."seller_id",
       ROUND(AVG(julianday(o."order_delivered_carrier_date")
              - julianday(o."order_approved_at")), 2) AS "avg_packing_days"
FROM   "order_items" AS oi
JOIN   "orders"       AS o  ON o."order_id" = oi."order_id"
GROUP  BY oi."seller_id"
LIMIT 20;
```

```sql
-- 6. Description: Average review score earned by each seller
SELECT DISTINCT oi."seller_id",
       ROUND(AVG(orv."review_score"), 2) AS "avg_review_score"
FROM   "order_items" AS oi
JOIN   "order_reviews" AS orv ON orv."order_id" = oi."order_id"
GROUP  BY oi."seller_id"
LIMIT 20;
```

```sql
-- 7. Description: Overall sales volume by product category (in English)
SELECT DISTINCT pct."product_category_name_english",
       COUNT(*) AS "qty_sold"
FROM   "order_items" AS oi
JOIN   "products"    AS p   ON p."product_id" = oi."product_id"
JOIN   "product_category_name_translation" AS pct
       ON pct."product_category_name" = p."product_category_name"
GROUP  BY pct."product_category_name_english"
ORDER  BY "qty_sold" DESC
LIMIT 20;
```

```sql
-- 8. Description: For every seller discover which product category (English)
--    accounts for most of his/her sales
SELECT DISTINCT "seller_id",
                "product_category_name_english",
                "qty_sold"
FROM   (
         SELECT  oi."seller_id",
                 pct."product_category_name_english",
                 COUNT(*) AS "qty_sold",
                 RANK() OVER (PARTITION BY oi."seller_id"
                              ORDER BY COUNT(*) DESC) AS rnk
         FROM   "order_items" AS oi
         JOIN   "products"    AS p   ON p."product_id" = oi."product_id"
         JOIN   "product_category_name_translation" AS pct
                ON pct."product_category_name" = p."product_category_name"
         GROUP  BY oi."seller_id", pct."product_category_name_english"
       )
WHERE  rnk = 1
LIMIT 20;
```

```sql
-- 9. Description: Build a synthetic performance table – only sellers with
--    quantity > 100, showing their total revenue, average item price,
--    average review score and average packing time
SELECT DISTINCT perf."seller_id",
       perf."total_sales",
       perf."avg_item_price",
       rev."avg_review_score",
       pack."avg_packing_days"
FROM  (
        SELECT "seller_id",
               COUNT(*)                AS "total_units",
               ROUND(SUM("price"), 2)  AS "total_sales",
               ROUND(AVG("price"), 2)  AS "avg_item_price"
        FROM   "order_items"
        GROUP  BY "seller_id"
        HAVING COUNT(*) > 100
      ) AS perf
LEFT JOIN (
        SELECT  oi."seller_id",
                ROUND(AVG(orv."review_score"), 2) AS "avg_review_score"
        FROM    "order_items" AS oi
        JOIN    "order_reviews" AS orv ON orv."order_id" = oi."order_id"
        GROUP   BY oi."seller_id"
      ) AS rev   ON rev."seller_id"   = perf."seller_id"
LEFT JOIN (
        SELECT  oi."seller_id",
                ROUND(AVG(julianday(o."order_delivered_carrier_date")
                       - julianday(o."order_approved_at")), 2)
                       AS "avg_packing_days"
        FROM    "order_items" AS oi
        JOIN    "orders"      AS o  ON o."order_id" = oi."order_id"
        GROUP   BY oi."seller_id"
      ) AS pack  ON pack."seller_id"  = perf."seller_id"
LIMIT 20;
```

```sql
-- 10. Description: Enrich the performance table with the top (highest-volume)
--     product category, already translated into English, for each qualified seller
SELECT DISTINCT pr."seller_id",
       pr."total_sales",
       pr."avg_item_price",
       pr."avg_review_score",
       pr."avg_packing_days",
       tc."product_category_name_english" AS "top_category_en",
       tc."qty_sold"                      AS "top_category_units"
FROM   (
         /* query #9 (all qualified sellers and their metrics) */
         SELECT perf."seller_id",
                perf."total_sales",
                perf."avg_item_price",
                rev."avg_review_score",
                pack."avg_packing_days"
         FROM   (
                  SELECT "seller_id",
                         ROUND(SUM("price"), 2) AS "total_sales",
                         ROUND(AVG("price"), 2) AS "avg_item_price"
                  FROM   "order_items"
                  GROUP  BY "seller_id"
                  HAVING COUNT(*) > 100
                ) AS perf
         LEFT JOIN (
                  SELECT  oi."seller_id",
                          ROUND(AVG(orv."review_score"), 2) AS "avg_review_score"
                  FROM    "order_items" AS oi
                  JOIN    "order_reviews" AS orv
                         ON orv."order_id" = oi."order_id"
                  GROUP   BY oi."seller_id"
                ) AS rev  ON rev."seller_id"  = perf."seller_id"
         LEFT JOIN (
                  SELECT  oi."seller_id",
                          ROUND(AVG(julianday(o."order_delivered_carrier_date")
                                 - julianday(o."order_approved_at")), 2)
                                 AS "avg_packing_days"
                  FROM    "order_items" AS oi
                  JOIN    "orders"      AS o
                         ON o."order_id" = oi."order_id"
                  GROUP   BY oi."seller_id"
                ) AS pack ON pack."seller_id" = perf."seller_id"
       ) AS pr
JOIN   (
         /* query #8 (only the top category for each seller) */
         SELECT DISTINCT "seller_id",
                         "product_category_name_english",
                         "qty_sold"
         FROM   (
                  SELECT  oi."seller_id",
                          pct."product_category_name_english",
                          COUNT(*) AS "qty_sold",
                          RANK() OVER (PARTITION BY oi."seller_id"
                                       ORDER BY COUNT(*) DESC) AS rnk
                  FROM   "order_items" AS oi
                  JOIN   "products"    AS p
                         ON p."product_id" = oi."product_id"
                  JOIN   "product_category_name_translation" AS pct
                         ON pct."product_category_name" = p."product_category_name"
                  GROUP  BY oi."seller_id", pct."product_category_name_english"
                )
         WHERE  rnk = 1
       ) AS tc ON tc."seller_id" = pr."seller_id"
LIMIT 20;
```
