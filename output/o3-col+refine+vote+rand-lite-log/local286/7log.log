```sql
--Description: 2) Review the distinct product category names together with their English translations.  
SELECT DISTINCT p."product_category_name",
                t."product_category_name_english"
FROM "products"  AS p
LEFT JOIN "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
LIMIT 20;
```

```sql
--Description: 3) Identify sellers that have sold more than 100 items and rank them by volume.  
SELECT "seller_id",
       COUNT(*) AS "items_sold"
FROM "order_items"
GROUP BY "seller_id"
HAVING COUNT(*) > 100
ORDER BY "items_sold" DESC
LIMIT 20;
```

```sql
--Description: 4) Compute the average item price for every seller who already meets the 100-items threshold.  
SELECT oi."seller_id",
       AVG(oi."price") AS "avg_item_price"
FROM  "order_items" AS oi
GROUP BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: 5) Derive the average review score that each high-volume seller receives.  
SELECT oi."seller_id",
       AVG(orv."review_score") AS "avg_review_score"
FROM   "order_items" AS oi
JOIN   "order_reviews" AS orv
       ON oi."order_id" = orv."order_id"
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: 6) Measure average packing time (purchase → carrier) in days for those same sellers.  
SELECT oi."seller_id",
       AVG( julianday(o."order_delivered_carrier_date")
           - julianday(o."order_purchase_timestamp") ) AS "avg_packing_time_days"
FROM   "order_items" AS oi
JOIN   "orders"      AS o
       ON oi."order_id" = o."order_id"
GROUP  BY oi."seller_id"
HAVING COUNT(*) > 100
LIMIT 20;
```

```sql
--Description: 7) Provide one consolidated view: sales volume, avg price, avg review, avg packing time (only sellers >100 items).  
SELECT s."seller_id",
       s."items_sold",
       p."avg_item_price",
       r."avg_review_score",
       t."avg_packing_time_days"
FROM
    (SELECT "seller_id", COUNT(*) AS "items_sold"
     FROM "order_items"
     GROUP BY "seller_id"
     HAVING COUNT(*) > 100)                       AS s
LEFT JOIN
    (SELECT "seller_id", AVG("price") AS "avg_item_price"
     FROM "order_items"
     GROUP BY "seller_id")                        AS p
       ON s."seller_id" = p."seller_id"
LEFT JOIN
    (SELECT oi."seller_id", AVG(orv."review_score") AS "avg_review_score"
     FROM   "order_items" AS oi
     JOIN   "order_reviews" AS orv
            ON oi."order_id" = orv."order_id"
     GROUP  BY oi."seller_id")                   AS r
       ON s."seller_id" = r."seller_id"
LEFT JOIN
    (SELECT oi."seller_id",
            AVG( julianday(o."order_delivered_carrier_date")
                - julianday(o."order_purchase_timestamp") ) AS "avg_packing_time_days"
     FROM   "order_items" AS oi
     JOIN   "orders"      AS o
            ON oi."order_id" = o."order_id"
     GROUP  BY oi."seller_id")                   AS t
       ON s."seller_id" = t."seller_id"
ORDER BY s."items_sold" DESC
LIMIT 20;
```

```sql
--Description: 8) Highlight product category names (in English) with the highest sales volume.  
SELECT t."product_category_name_english",
       COUNT(*) AS "items_sold"
FROM   "order_items"                          AS oi
JOIN   "products"                             AS p
       ON oi."product_id" = p."product_id"
LEFT JOIN "product_category_name_translation" AS t
       ON p."product_category_name" = t."product_category_name"
GROUP  BY t."product_category_name_english"
ORDER BY "items_sold" DESC
LIMIT 20;
```
