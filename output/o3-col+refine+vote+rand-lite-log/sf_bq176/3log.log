--Description: 6)  Compute the weighted-average copy number for each TCGA-LAML case in cytoband 15q11.
SELECT
  "case_barcode",
  "sum_weighted" / NULLIF("sum_len",0) AS "weighted_avg_cn"
FROM (
  SELECT
    "case_barcode",
    SUM("segment_mean" * "overlap_len") AS "sum_weighted",
    SUM("overlap_len")                  AS "sum_len"
  FROM (
    SELECT 
      s."case_barcode",
      s."segment_mean",
      LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
      ON b."cytoband_name" ILIKE '%15q11%'
     AND b."chromosome" = 'chr15'
     AND s."project_short_name" = 'TCGA-LAML'
     AND s."chromosome" = '15'
    WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
  ) o
  GROUP BY "case_barcode"
) r
ORDER BY "weighted_avg_cn" DESC
LIMIT 20;
