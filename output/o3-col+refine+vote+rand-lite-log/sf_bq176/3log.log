case_barcode,weighted_avg_cn
TCGA-AB-2972,0.0296
Query:
--Description: 9)  Confirm that those top-ranking LAML cases actually exist in the 
--               per-sample file-metadata table (data availability sanity check).
SELECT DISTINCT
  m."case_barcode",
  m."experimental_strategy",
  m."data_type"
FROM TCGA_MITELMAN.TCGA_VERSIONED.PER_SAMPLE_FILE_METADATA_HG38_GDC_R34 m
WHERE m."project_short_name" = 'TCGA-LAML'
  AND m."case_barcode" IN (
      -- same case barcodes found in query 7
      SELECT "case_barcode"
      FROM (
        SELECT
          "case_barcode",
          ROW_NUMBER() OVER (ORDER BY SUM("segment_mean" * "overlap_len") / NULLIF(SUM("overlap_len"),0) DESC) AS "rk"
        FROM (
          SELECT 
            s."case_barcode",
            s."segment_mean",
            LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
          FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
          JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
            ON b."cytoband_name" ILIKE '%15q11%'
           AND b."chromosome" = 'chr15'
           AND s."project_short_name" = 'TCGA-LAML'
           AND s."chromosome" = '15'
          WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
        ) t
        GROUP BY "case_barcode"
      ) w
      WHERE "rk" = 1
)
LIMIT 20;
