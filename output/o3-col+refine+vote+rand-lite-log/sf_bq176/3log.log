```sql
--Description: 1)  Confirm the genomic boundaries for chromosome-15 cytoband “15q11”.
SELECT 
  "chromosome",
  "cytoband_name",
  "hg38_start",
  "hg38_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE "cytoband_name" ILIKE '%15q11%'
LIMIT 20;
```

```sql
--Description: 2)  Preview copy-number segments from the HG38 masked-segment table 
--               that belong to the TCGA-LAML study and sit on chromosome-15.
SELECT 
  "project_short_name",
  "case_barcode",
  "chromosome",
  "start_pos",
  "end_pos",
  "segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14
WHERE "project_short_name" = 'TCGA-LAML'
  AND "chromosome" = '15'
LIMIT 20;
```

```sql
--Description: 3)  Pull every segment that actually overlaps cytoband 15q11, together with the 
--               intersection length; this gives the rows that will feed the weighting step.
SELECT 
  s."case_barcode",
  s."start_pos"  AS "seg_start",
  s."end_pos"    AS "seg_end",
  s."segment_mean",
  b."hg38_start" AS "band_start",
  b."hg38_stop"  AS "band_end",
  LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    b
  ON b."cytoband_name" ILIKE '%15q11%'
 AND b."chromosome" = 'chr15'
 AND s."project_short_name" = 'TCGA-LAML'
 AND s."chromosome" = '15'
WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
LIMIT 20;
```

```sql
--Description: 4)  Compute per-segment weight (= segment_mean × overlap_len) 
--               for the same overlapping rows (sanity-check numerical values).
SELECT 
  "case_barcode",
  "segment_mean",
  "overlap_len",
  "segment_mean" * "overlap_len" AS "weighted_value"
FROM (
  SELECT 
    s."case_barcode",
    s."segment_mean",
    LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
    ON b."cytoband_name" ILIKE '%15q11%'
   AND b."chromosome" = 'chr15'
   AND s."project_short_name" = 'TCGA-LAML'
   AND s."chromosome" = '15'
  WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
) q
LIMIT 20;
```

```sql
--Description: 5)  Aggregate to obtain, for every case, the weighted sum of segment_mean 
--               and the total overlapped length inside 15q11.
SELECT
  "case_barcode",
  SUM("segment_mean" * "overlap_len") AS "sum_weighted",
  SUM("overlap_len")                  AS "sum_len"
FROM (
  SELECT 
    s."case_barcode",
    s."segment_mean",
    LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
    ON b."cytoband_name" ILIKE '%15q11%'
   AND b."chromosome" = 'chr15'
   AND s."project_short_name" = 'TCGA-LAML'
   AND s."chromosome" = '15'
  WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
) w
GROUP BY "case_barcode"
LIMIT 20;
```

```sql
--Description: 6)  Compute the weighted-average copy number for each TCGA-LAML case in cytoband 15q11.
SELECT
  "case_barcode",
  "sum_weighted" / NULLIF("sum_len",0) AS "weighted_avg_cn"
FROM (
  SELECT
    "case_barcode",
    SUM("segment_mean" * "overlap_len") AS "sum_weighted",
    SUM("overlap_len")                  AS "sum_len"
  FROM (
    SELECT 
      s."case_barcode",
      s."segment_mean",
      LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
      ON b."cytoband_name" ILIKE '%15q11%'
     AND b."chromosome" = 'chr15'
     AND s."project_short_name" = 'TCGA-LAML'
     AND s."chromosome" = '15'
    WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
  ) o
  GROUP BY "case_barcode"
) r
ORDER BY "weighted_avg_cn" DESC
LIMIT 20;
```

```sql
--Description: 7)  Show the single TCGA-LAML case(s) with the highest weighted-average CN value.
SELECT
  "case_barcode",
  "weighted_avg_cn"
FROM (
  SELECT
    "case_barcode",
    "sum_weighted" / NULLIF("sum_len",0) AS "weighted_avg_cn",
    ROW_NUMBER() OVER (ORDER BY "sum_weighted" / NULLIF("sum_len",0) DESC) AS "rn"
  FROM (
    SELECT
      "case_barcode",
      SUM("segment_mean" * "overlap_len") AS "sum_weighted",
      SUM("overlap_len")                  AS "sum_len"
    FROM (
      SELECT 
        s."case_barcode",
        s."segment_mean",
        LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
        ON b."cytoband_name" ILIKE '%15q11%'
       AND b."chromosome" = 'chr15'
       AND s."project_short_name" = 'TCGA-LAML'
       AND s."chromosome" = '15'
      WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
    ) z
    GROUP BY "case_barcode"
  ) y
) x
WHERE "rn" = 1
LIMIT 20;
```

```sql
--Description: 8)  Cross-check the above winners with gene-level copy-number calls that fall 
--               into cytoband 15q11, to view raw “copy_number” values for those cases.
SELECT 
  g."case_barcode",
  g."copy_number",
  g."start_pos",
  g."end_pos"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
  ON b."cytoband_name" ILIKE '%15q11%'
 AND b."chromosome" = 'chr15'
 AND g."chromosome" = 'chr15'
WHERE g."project_short_name" = 'TCGA-LAML'
  AND g."case_barcode" IN (
      -- plug-in names returned by query 7
      SELECT "case_barcode"
      FROM (
        SELECT
          "case_barcode",
          ROW_NUMBER() OVER (ORDER BY SUM("segment_mean" * "overlap_len") / NULLIF(SUM("overlap_len"),0) DESC) AS "rk"
        FROM (
          SELECT 
            s."case_barcode",
            s."segment_mean",
            LEAST(s."end_pos",  b."hg38_stop")  - GREATEST(s."start_pos", b."hg38_start") + 1 AS "overlap_len"
          FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
          JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
            ON b."cytoband_name" ILIKE '%15q11%'
           AND b."chromosome" = 'chr15'
           AND s."project_short_name" = 'TCGA-LAML'
           AND s."chromosome" = '15'
          WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
        ) u
        GROUP BY "case_barcode"
      ) v
      WHERE "rk" = 1
)
LIMIT 20;
```

