Query:
--Description: 1)  Confirm the genomic boundaries for chromosome-15 cytoband “15q11”.
SELECT 
  "chromosome",
  "cytoband_name",
  "hg38_start",
  "hg38_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE "cytoband_name" ILIKE '%15q11%'
LIMIT 20;
