          FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
          JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
            ON b."cytoband_name" ILIKE '%15q11%'
           AND b."chromosome" = 'chr15'
           AND s."project_short_name" = 'TCGA-LAML'
           AND s."chromosome" = '15'
          WHERE LEAST(s."end_pos",  b."hg38_stop")  > GREATEST(s."start_pos", b."hg38_start")
        ) t
        GROUP BY "case_barcode"
      ) w
      WHERE "rk" = 1
)
LIMIT 20;
