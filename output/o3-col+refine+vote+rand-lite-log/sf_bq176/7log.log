Query:
--Description: Compute a weighted average absolute copy-number (2*2^segment_mean) for every LAML case within 15q11  
SELECT
  s."case_barcode",
  SUM( (LEAST(s."end_pos",  c."hg38_stop")
      - GREATEST(s."start_pos", c."hg38_start") + 1)
      * 2 * POWER(2, s."segment_mean") )        -- length-weighted CN
  / SUM(LEAST(s."end_pos",  c."hg38_stop")
      - GREATEST(s."start_pos", c."hg38_start") + 1)  AS "weighted_avg_copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14    s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
  ON c."chromosome"      = 'chr15'
 AND c."cytoband_name"   ILIKE '15q11%'
 AND s."chromosome"      = '15'
 AND s."project_short_name" = 'TCGA-LAML'
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
GROUP BY s."case_barcode"
LIMIT 20;
