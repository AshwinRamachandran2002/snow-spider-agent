```sql
--Description: Identify the 15q11 cytoband(s) on chromosome 15 and inspect their genomic ranges
SELECT
  "chromosome",
  "cytoband_name",
  "hg38_start",
  "hg38_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE "chromosome" = 'chr15'
  AND "cytoband_name" ILIKE '15q11%'
LIMIT 20;
```

```sql
--Description: Get the full genomic span (min-start / max-stop) that covers every 15q11 sub-band  
SELECT
  MIN("hg38_start") AS "q11_min_start",
  MAX("hg38_stop")  AS "q11_max_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE "chromosome" = 'chr15'
  AND "cytoband_name" ILIKE '15q11%';
```

```sql
--Description: Preview masked copy-number segments for the TCGA-LAML study on chromosome 15  
SELECT
  "project_short_name",
  "case_barcode",
  "chromosome",
  "start_pos",
  "end_pos",
  "segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14
WHERE "project_short_name" = 'TCGA-LAML'
  AND "chromosome" = '15'
LIMIT 20;
```

```sql
--Description: Show LAML segments that actually overlap any 15q11 cytoband, together with cytoband info  
SELECT
  s."case_barcode",
  s."start_pos",
  s."end_pos",
  s."segment_mean",
  c."cytoband_name",
  c."hg38_start",
  c."hg38_stop"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14    s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
  ON c."chromosome"      = 'chr15'
 AND c."cytoband_name"   ILIKE '15q11%'
 AND s."chromosome"      = '15'
 AND s."project_short_name" = 'TCGA-LAML'
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
```

```sql
--Description: Calculate, per overlapping segment, the exact bp overlap length with 15q11 and keep its log2 CN value  
SELECT
  s."case_barcode",
  LEAST(s."end_pos",  c."hg38_stop") - GREATEST(s."start_pos", c."hg38_start") + 1  AS "overlap_len",
  s."segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14    s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
  ON c."chromosome"      = 'chr15'
 AND c."cytoband_name"   ILIKE '15q11%'
 AND s."chromosome"      = '15'
 AND s."project_short_name" = 'TCGA-LAML'
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
```

```sql
--Description: Compute a weighted average absolute copy-number (2*2^segment_mean) for every LAML case within 15q11  
SELECT
  s."case_barcode",
  SUM( (LEAST(s."end_pos",  c."hg38_stop")
      - GREATEST(s."start_pos", c."hg38_start") + 1)
      * 2 * POWER(2, s."segment_mean") )        -- length-weighted CN
  / SUM(LEAST(s."end_pos",  c."hg38_stop")
      - GREATEST(s."start_pos", c."hg38_start") + 1)  AS "weighted_avg_copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14    s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
  ON c."chromosome"      = 'chr15'
 AND c."cytoband_name"   ILIKE '15q11%'
 AND s."chromosome"      = '15'
 AND s."project_short_name" = 'TCGA-LAML'
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
GROUP BY s."case_barcode"
LIMIT 20;
```

```sql
--Description: Rank LAML cases by the weighted average copy-number in 15q11 (highest first)  
SELECT
  "case_barcode",
  "weighted_avg_copy_number"
FROM (
  SELECT
    s."case_barcode",
    SUM( (LEAST(s."end_pos",  c."hg38_stop")
        - GREATEST(s."start_pos", c."hg38_start") + 1)
        * 2 * POWER(2, s."segment_mean") )
    / SUM(LEAST(s."end_pos",  c."hg38_stop")
        - GREATEST(s."start_pos", c."hg38_start") + 1) AS "weighted_avg_copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14  s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome"      = 'chr15'
   AND c."cytoband_name"   ILIKE '15q11%'
   AND s."chromosome"      = '15'
   AND s."project_short_name" = 'TCGA-LAML'
   AND s."start_pos" <= c."hg38_stop"
   AND s."end_pos"   >= c."hg38_start"
  GROUP BY s."case_barcode"
)
ORDER BY "weighted_avg_copy_number" DESC
LIMIT 20;
```

```sql
--Description: Check which TCGA projects are present in the HG38 masked segment table (sanity check)  
SELECT DISTINCT
  "project_short_name"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14
LIMIT 20;
```

```sql
--Description: List a sample of unique LAML case barcodes present in the HG38 segment table  
SELECT DISTINCT
  "case_barcode"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14
WHERE "project_short_name" = 'TCGA-LAML'
LIMIT 20;
```

```sql
--Description: Inspect gene-level copy-number calls that intersect the 15q11 span for LAML cases (cross-validation)  
SELECT
  g."case_barcode",
  g."chromosome",
  g."start_pos",
  g."end_pos",
  g."copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
WHERE g."project_short_name" = 'TCGA-LAML'
  AND g."chromosome" = 'chr15'
  AND g."start_pos" < (SELECT MAX("hg38_stop")
                       FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
                       WHERE "chromosome"='chr15'
                         AND "cytoband_name" ILIKE '15q11%')
  AND g."end_pos"   > (SELECT MIN("hg38_start")
                       FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
                       WHERE "chromosome"='chr15'
                         AND "cytoband_name" ILIKE '15q11%')
LIMIT 20;
```
