--Description: Calculate, per overlapping segment, the exact bp overlap length with 15q11 and keep its log2 CN value  
SELECT
  s."case_barcode",
  LEAST(s."end_pos",  c."hg38_stop") - GREATEST(s."start_pos", c."hg38_start") + 1  AS "overlap_len",
  s."segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14    s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
  ON c."chromosome"      = 'chr15'
 AND c."cytoband_name"   ILIKE '15q11%'
 AND s."chromosome"      = '15'
 AND s."project_short_name" = 'TCGA-LAML'
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
