--Description: 6) Compute the weighted-average copy number in 15q11 for every TCGA-LAML case  
WITH overlap AS (
    SELECT 
           s."case_barcode",
           GREATEST(s."start_pos", b."hg38_start") AS "ov_start",
           LEAST(s."end_pos",   b."hg38_stop")     AS "ov_end",
           s."copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
      ON s."chromosome" = b."chromosome"
    WHERE s."project_short_name" = 'TCGA-LAML'
      AND s."chromosome" = 'chr15'
      AND b."cytoband_name" ILIKE '15q11%'
      AND GREATEST(s."start_pos", b."hg38_start") <= LEAST(s."end_pos", b."hg38_stop")
)
SELECT 
       "case_barcode",
       SUM("copy_number" * ("ov_end" - "ov_start" + 1)) 
       / NULLIF(SUM("ov_end" - "ov_start" + 1),0)      AS "weighted_avg_copy_number"
FROM overlap
GROUP BY "case_barcode"
ORDER BY "weighted_avg_copy_number" DESC
LIMIT 20;
