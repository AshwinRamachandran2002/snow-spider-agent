```sql
--Description: 9) Optional: inspect masked CN segments (log2 scale) for chromosome 15 in TCGA-LAML
SELECT 
       "case_barcode",
       "chromosome",
       "start_pos",
       "end_pos",
       "segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14
WHERE "project_short_name" = 'TCGA-LAML'
  AND "chromosome" = '15'
LIMIT 20;
```

```sql
--Description: 10) Alternate computation using masked segments (converted from log2 CN) for 15q11  
WITH band AS (
    SELECT MIN("hg38_start") AS "band_start",
           MAX("hg38_stop")  AS "band_end"
    FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
    WHERE "cytoband_name" ILIKE '15q11%'
),
masked AS (
    SELECT 
           s."case_barcode",
           GREATEST(s."start_pos",  b."band_start") AS "ov_start",
           LEAST(s."end_pos",       b."band_end")   AS "ov_end",
           -- convert segment_mean (log2(CN/2))  → absolute CN value = 2 * 2^(segment_mean)
           2 * POWER(2, s."segment_mean")           AS "abs_cn"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
    CROSS JOIN band b
    WHERE s."project_short_name" = 'TCGA-LAML'
      AND s."chromosome" = '15'
      AND GREATEST(s."start_pos",  b."band_start") <= LEAST(s."end_pos",  b."band_end")
)
SELECT 
       "case_barcode",
       SUM("abs_cn" * ("ov_end" - "ov_start" + 1))
       / NULLIF(SUM("ov_end" - "ov_start" + 1),0) AS "weighted_avg_copy_number"
FROM masked
GROUP BY "case_barcode"
ORDER BY "weighted_avg_copy_number" DESC
LIMIT 20;
```
