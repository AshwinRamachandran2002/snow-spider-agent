```sql
--Description: 4) Preview a few chromosome-15 copy-number segments from
--             the TCGA-LAML study.
SELECT *
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
WHERE "project_short_name" = 'TCGA-LAML'
  AND "chromosome" = 'chr15'
LIMIT 20;
```

```sql
--Description: 5) Intersect TCGA-LAML copy-number segments with the 15q11
--             cytoband to see per-segment overlaps and how many bases
--             each segment contributes.
SELECT s."project_short_name",
       s."case_barcode",
       s."chromosome",
       s."start_pos",
       s."end_pos",
       s."copy_number",
       c."cytoband_name",
       c."hg38_start",
       c."hg38_stop",
       LEAST(s."end_pos",  c."hg38_stop")
     - GREATEST(s."start_pos", c."hg38_start") + 1  AS "overlap_bp"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
  ON  s."chromosome" = c."chromosome"
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
ORDER BY s."case_barcode"
LIMIT 20;
```

```sql
--Description: 6) Compute the weighted average copy-number for EACH
--             TCGA-LAML case in the 15q11 cytoband.
SELECT s."case_barcode",
       SUM( (LEAST(s."end_pos",  c."hg38_stop")
           - GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number" )
         AS "weighted_cn_sum",
       SUM( LEAST(s."end_pos",  c."hg38_stop")
          - GREATEST(s."start_pos", c."hg38_start") + 1 ) AS "total_overlap_bp",
       SUM( (LEAST(s."end_pos",  c."hg38_stop")
           - GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number" )
       / NULLIF(
           SUM( LEAST(s."end_pos",  c."hg38_stop")
              - GREATEST(s."start_pos", c."hg38_start") + 1), 0)
         AS "weighted_avg_copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
  ON  s."chromosome" = c."chromosome"
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
GROUP BY s."case_barcode"
LIMIT 20;
```

```sql
--Description: 7) Rank TCGA-LAML cases by the weighted average copy-number
--             across 15q11 (highest first).
SELECT *
FROM (
    SELECT s."case_barcode",
           SUM( (LEAST(s."end_pos",  c."hg38_stop")
               - GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number" )
         / NULLIF(
              SUM( LEAST(s."end_pos",  c."hg38_stop")
                 - GREATEST(s."start_pos", c."hg38_start") + 1 ), 0)
           AS "weighted_avg_copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
      ON  s."chromosome" = c."chromosome"
      AND c."cytoband_name" ILIKE '15q11%'
      AND s."start_pos" <= c."hg38_stop"
      AND s."end_pos"   >= c."hg38_start"
    WHERE s."project_short_name" = 'TCGA-LAML'
    GROUP BY s."case_barcode"
) sub
ORDER BY "weighted_avg_copy_number" DESC
LIMIT 20;
```

```sql
--Description: 8) Quick cross-check: use gene-level copy-number to see if
--             top cases from segments match gene-level averages in 15q11.
SELECT g."case_barcode",
       AVG(g."copy_number") AS "avg_copy_number_15q11"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36 g
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                  c
  ON g."chromosome" = c."chromosome"
  AND c."cytoband_name" ILIKE '15q11%'
  AND g."start_pos" <= c."hg38_stop"
  AND g."end_pos"   >= c."hg38_start"
WHERE g."project_short_name" = 'TCGA-LAML'
GROUP BY g."case_barcode"
ORDER BY "avg_copy_number_15q11" DESC
LIMIT 20;
```

```sql
--Description: 9) Attach basic metadata to the segment-based result so we
--             can report the barcodes with highest weighted averages.
WITH w AS (
    SELECT s."case_barcode",
           SUM( (LEAST(s."end_pos",  c."hg38_stop")
               - GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number" )
         / NULLIF(
              SUM( LEAST(s."end_pos",  c."hg38_stop")
                 - GREATEST(s."start_pos", c."hg38_start") + 1 ), 0)
           AS "weighted_avg_copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
      ON  s."chromosome" = c."chromosome"
      AND c."cytoband_name" ILIKE '15q11%'
      AND s."start_pos" <= c."hg38_stop"
      AND s."end_pos"   >= c."hg38_start"
    WHERE s."project_short_name" = 'TCGA-LAML'
    GROUP BY s."case_barcode"
)
SELECT m."case_barcode",
       m."project_short_name",
       w."weighted_avg_copy_number"
FROM w
JOIN TCGA_MITELMAN.TCGA_VERSIONED.PER_SAMPLE_FILE_METADATA_HG38_GDC_R28 m
  ON w."case_barcode" = m."case_barcode"
  AND m."project_short_name" = 'TCGA-LAML'
ORDER BY w."weighted_avg_copy_number" DESC
LIMIT 20;
```

```sql
--Description: 10) OPTIONAL sanity check – see how many total bases of
