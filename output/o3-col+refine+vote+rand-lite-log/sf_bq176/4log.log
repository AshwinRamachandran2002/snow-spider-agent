--Description: 10) Sanity check – compute how many base pairs of cytoband 15q11
--              each TCGA-LAML sample covers in the allelic segment file.
SELECT s."case_barcode",
       SUM(
             LEAST(s."end_pos",  c."hg38_stop")
           - GREATEST(s."start_pos", c."hg38_start") + 1
         ) AS "bp_covered_15q11"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
  ON  s."chromosome" = c."chromosome"
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
GROUP BY s."case_barcode"
ORDER BY "bp_covered_15q11" DESC
LIMIT 20
