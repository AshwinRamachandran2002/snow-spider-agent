Query:
--Description: 9) Attach basic metadata (if available) to the segment-based
--             weighted-average result.  Use LEFT JOIN instead of INNER JOIN
--             so every LAML barcode found in the segment file is returned
--             even when the metadata table lacks a matching record.
WITH w AS (
    SELECT s."case_barcode",
           SUM(
                 (LEAST(s."end_pos",  c."hg38_stop")
                -  GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number"
               )
           / NULLIF(
                 SUM(
                      LEAST(s."end_pos",  c."hg38_stop")
                    - GREATEST(s."start_pos", c."hg38_start") + 1
                 ), 0
             ) AS "weighted_avg_copy_number"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
      ON  s."chromosome" = c."chromosome"
      AND c."cytoband_name" ILIKE '15q11%'
      AND s."start_pos" <= c."hg38_stop"
      AND s."end_pos"   >= c."hg38_start"
    WHERE s."project_short_name" = 'TCGA-LAML'
    GROUP BY s."case_barcode"
)
SELECT w."case_barcode",
       COALESCE(m."project_short_name", 'TCGA-LAML') AS "project_short_name",
       w."weighted_avg_copy_number"
FROM w
LEFT JOIN TCGA_MITELMAN.TCGA_VERSIONED.PER_SAMPLE_FILE_METADATA_HG38_GDC_R28 m
       ON w."case_barcode" = m."case_barcode"
ORDER BY w."weighted_avg_copy_number" DESC
LIMIT 20
