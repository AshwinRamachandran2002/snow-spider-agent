Query:
--Description: 5) Intersect TCGA-LAML copy-number segments with the 15q11
--             cytoband to see per-segment overlaps and how many bases
--             each segment contributes.
SELECT s."project_short_name",
       s."case_barcode",
       s."chromosome",
       s."start_pos",
       s."end_pos",
       s."copy_number",
       c."cytoband_name",
       c."hg38_start",
       c."hg38_stop",
       LEAST(s."end_pos",  c."hg38_stop")
     - GREATEST(s."start_pos", c."hg38_start") + 1  AS "overlap_bp"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
  ON  s."chromosome" = c."chromosome"
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
ORDER BY s."case_barcode"
LIMIT 20;
