Query:
--Description: 6) Compute the weighted average copy-number for EACH
--             TCGA-LAML case in the 15q11 cytoband.
SELECT s."case_barcode",
       SUM( (LEAST(s."end_pos",  c."hg38_stop")
           - GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number" )
         AS "weighted_cn_sum",
       SUM( LEAST(s."end_pos",  c."hg38_stop")
          - GREATEST(s."start_pos", c."hg38_start") + 1 ) AS "total_overlap_bp",
       SUM( (LEAST(s."end_pos",  c."hg38_stop")
           - GREATEST(s."start_pos", c."hg38_start") + 1) * s."copy_number" )
       / NULLIF(
           SUM( LEAST(s."end_pos",  c."hg38_stop")
              - GREATEST(s."start_pos", c."hg38_start") + 1), 0)
         AS "weighted_avg_copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                       c
  ON  s."chromosome" = c."chromosome"
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
GROUP BY s."case_barcode"
LIMIT 20;
