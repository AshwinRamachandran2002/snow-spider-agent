```sql
--Description:  
-- Compute the average gene-level copy number for each TCGA-LAML case whose genes
-- overlap (not necessarily lie completely within) the cytoband 15q11.  
-- 1) `region` fetches the genomic coordinates of 15q11 on chr15.  
-- 2) `genes` keeps gene-level CN rows that INTERSECT that span  
--    (criterion: gene.end_pos ≥ region_start AND gene.start_pos ≤ region_end).  
-- 3) Final SELECT averages the copy_number per case and orders the result.  
WITH region AS (
    SELECT MIN("hg38_start") AS region_start,
           MAX("hg38_stop")  AS region_end
    FROM "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"
    WHERE "cytoband_name" ILIKE '15q11%'
      AND "chromosome" = 'chr15'
),
genes AS (
    SELECT g."case_barcode",
           g."copy_number"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g,
         region r
    WHERE g."project_short_name" = 'TCGA-LAML'
      AND g."chromosome" = 'chr15'
      AND g."end_pos"   >= r.region_start   --gene overlaps left boundary
      AND g."start_pos" <= r.region_end     --gene overlaps right boundary
)
SELECT "case_barcode",
       AVG("copy_number") AS avg_gene_copy_number
FROM genes
GROUP BY "case_barcode"
ORDER BY avg_gene_copy_number DESC
LIMIT 20;
```
