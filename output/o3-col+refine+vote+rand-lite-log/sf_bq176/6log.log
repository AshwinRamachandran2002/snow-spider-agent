```sql
--Description:  
-- Goal: list the TCGA-LAML case barcodes with the highest length-weighted average copy-number
--        (segment_mean) across cytoband 15q11.  
-- Reasoning steps (inline):  
--   1) `cb` – obtain exact hg38 span for 15q11 on chr15.  
--   2) `seg` – pull all masked CN segments from TCGA-LAML on chr15 that overlap that span and
--              compute the coordinates of their actual overlap (ov_start / ov_end).  
--   3) Final SELECT – calculate, for each case, the weighted average of segment_mean
--                     (weight = overlapped bases) and sort descending to surface the highest values.  
WITH cb AS (
    SELECT MIN("hg38_start") AS region_start,
           MAX("hg38_stop")  AS region_end
    FROM "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"
    WHERE "cytoband_name" ILIKE '15q11%'
      AND "chromosome" = 'chr15'
),
seg AS (
    SELECT s."case_barcode",
           GREATEST(s."start_pos", cb.region_start) AS ov_start,
           LEAST(  s."end_pos",    cb.region_end)   AS ov_end,
           s."segment_mean"
    FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02" s
    JOIN cb
      ON s."chromosome" = '15'
     AND s."project_short_name" = 'TCGA-LAML'
     AND s."end_pos"   >= cb.region_start   -- segment extends into region
     AND s."start_pos" <= cb.region_end     -- segment starts before region ends
)
SELECT "case_barcode",
       SUM( (ov_end - ov_start + 1) * "segment_mean" ) /
       SUM(  ov_end - ov_start + 1 )                  AS weighted_avg_segment_mean
FROM seg
GROUP BY "case_barcode"
ORDER BY weighted_avg_segment_mean DESC
LIMIT 10;
```
