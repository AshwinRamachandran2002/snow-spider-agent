--Description:  
-- Verify whether any gene-level copy-number data for acute myeloid leukemia is
-- present in the R36 table by listing every distinct `project_short_name`
-- containing the substring “LAML” together with a row count.  
-- If this returns zero rows, TCGA-LAML gene-level CN data is simply absent in
-- this release, which explains the earlier empty results.
SELECT g."project_short_name",
       COUNT(*) AS row_count
FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_GENE_LEVEL_HG38_GDC_R36" g
WHERE g."project_short_name" ILIKE '%LAML%'
GROUP BY g."project_short_name"
ORDER BY row_count DESC
LIMIT 20;
