```sql
--Description: Compute per-case weighted-average segment_mean across 15q11 (TCGA-LAML)
WITH cb AS (  -- coordinate bounds of 15q11
  SELECT MIN("hg38_start") AS "region_start",
         MAX("hg38_stop")  AS "region_end"
  FROM "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"
  WHERE "cytoband_name" ILIKE '15q11%'
    AND "chromosome" = 'chr15'
),
seg AS (       -- segments that overlap the region
  SELECT s."case_barcode",
         GREATEST(s."start_pos", cb."region_start") AS "ov_start",
         LEAST(s."end_pos",   cb."region_end")   AS "ov_end",
         s."segment_mean"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02" s,
       cb
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome" = '15'
    AND s."end_pos"   >= cb."region_start"
    AND s."start_pos" <= cb."region_end"
)
SELECT "case_barcode",
       SUM( ("ov_end"-"ov_start"+1) * "segment_mean" )
       / SUM("ov_end"-"ov_start"+1)                   AS "weighted_avg_segment_mean"
FROM seg
GROUP BY "case_barcode"
LIMIT 20;
```

