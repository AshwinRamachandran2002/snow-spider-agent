--Description: 7) Calculate the weighted average absolute copy number for each TCGA-LAML case in cytoband 15q11.
WITH band AS (
  SELECT "hg38_start", "hg38_stop"
  FROM "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"
  WHERE "chromosome" = 'chr15' AND "cytoband_name" = '15q11'
),
segs AS (
  SELECT
    s."case_barcode",
    GREATEST(s."start_pos", b."hg38_start")           AS "ovl_start",
    LEAST( s."end_pos",   b."hg38_stop")             AS "ovl_end",
    2 * POWER(2, s."segment_mean")                   AS "abs_cn"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14" s,
       band b
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome" = '15'
    AND s."end_pos"   >= b."hg38_start"
    AND s."start_pos" <= b."hg38_stop"
)
SELECT
  "case_barcode",
  SUM( ("ovl_end" - "ovl_start" + 1) * "abs_cn") / SUM("ovl_end" - "ovl_start" + 1) AS "weighted_avg_cn"
FROM segs
GROUP BY "case_barcode"
ORDER BY "weighted_avg_cn" DESC
LIMIT 20;
