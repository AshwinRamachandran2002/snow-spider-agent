```sql
--Description: 1)  Inspect Mitelman cytoband table to retrieve the hg38
--              genomic span for cytoband 15q11 on chromosome 15
--              (there are several sub-bands such as 15q11.1, 15q11.2 …).
--              We will need these coordinates for the overlap.
SELECT 
  "chromosome",
  "cytoband_name",
  "hg38_start",
  "hg38_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE "chromosome" = 'chr15' 
  AND "cytoband_name" ILIKE '15q11%' 
LIMIT 20;
```

```sql
--Description: 2)  Confirm that the masked-segment HG38 table indeed contains
--              the TCGA-LAML study (project_short_name = 'TCGA-LAML').
SELECT DISTINCT 
  "project_short_name"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02
WHERE "project_short_name" ILIKE '%LAML%' 
LIMIT 20;
```

```sql
--Description: 3)  List a few copy-number segments from the TCGA-LAML cohort
--              that are located on chromosome 15.  Note that this table
--              stores chromosome values as plain numbers (no 'chr' prefix).
SELECT 
  "project_short_name",
  "case_barcode",
  "chromosome",
  "start_pos",
  "end_pos",
  "segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02
WHERE "project_short_name" = 'TCGA-LAML'
  AND "chromosome" = '15'
LIMIT 20;
```

```sql
--Description: 4)  Pull all segments for TCGA-LAML whose genomic interval
--              intersects any 15q11 sub-band.  A segment overlaps a
--              cytoband if its start ≤ cytoband_stop and its end ≥ cytoband_start.
SELECT 
  s."case_barcode",
  s."chromosome",
  s."start_pos",
  s."end_pos",
  s."segment_mean",
  c."cytoband_name",
  c."hg38_start"        AS "cyto_start",
  c."hg38_stop"         AS "cyto_stop"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                         c
  ON c."chromosome"   = 'chr' || s."chromosome"
WHERE s."project_short_name" = 'TCGA-LAML'
  AND s."chromosome" = '15'
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
```

```sql
--Description: 5)  For each overlapping segment, compute the exact overlap
--              length (in base-pairs) with the cytoband span.
SELECT
  s."case_barcode",
  c."cytoband_name",
  GREATEST(0,
           LEAST(s."end_pos",   c."hg38_stop") 
         - GREATEST(s."start_pos", c."hg38_start") + 1)     AS "overlap_bp",
  s."segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                         c
  ON c."chromosome"   = 'chr' || s."chromosome"
WHERE s."project_short_name" = 'TCGA-LAML'
  AND s."chromosome" = '15'
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
```

```sql
--Description: 6)  Convert segment_mean (log2(CN/2)) back to absolute
--              copy-number value (CN = 2*2^segment_mean) and compute the
--              contribution of each segment to the weighted sum:
--              overlap_bp * CN.
SELECT
  s."case_barcode",
  GREATEST(0,
           LEAST(s."end_pos",   c."hg38_stop") 
         - GREATEST(s."start_pos", c."hg38_start") + 1)          AS "overlap_bp",
  2 * POWER(2, s."segment_mean")                                 AS "copy_number",
  GREATEST(0,
           LEAST(s."end_pos",   c."hg38_stop") 
         - GREATEST(s."start_pos", c."hg38_start") + 1)
        * (2 * POWER(2, s."segment_mean"))                       AS "weighted_cn_bp"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                         c
  ON c."chromosome"   = 'chr' || s."chromosome"
WHERE s."project_short_name" = 'TCGA-LAML'
  AND s."chromosome" = '15'
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
```

```sql
--Description: 7)  Aggregate the previous result for each case_barcode to
--              obtain (a) total base-pairs covered inside 15q11 and
--              (b) the weighted average copy number inside 15q11.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
)
SELECT
  "case_barcode",
  SUM("overlap_bp")                                   AS "total_bp",
  SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
                                                      AS "weighted_avg_cn"
FROM overlap
GROUP BY "case_barcode"
LIMIT 20;
```

```sql
--Description: 8)  Order the previous per-case table to show the highest
--              weighted average copy numbers in 15q11 for TCGA-LAML.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
)
SELECT
  "case_barcode",
  SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
      AS "weighted_avg_cn"
FROM overlap
GROUP BY "case_barcode"
ORDER BY "weighted_avg_cn" DESC
LIMIT 20;
```

```sql
--Description: 9)  Produce the final list of TCGA-LAML case barcodes that
--              have the single highest weighted average CN in cytoband 15q11.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
),
per_case AS (
  SELECT
    "case_barcode",
    SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
        AS "weighted_avg_cn"
  FROM overlap
  GROUP BY "case_barcode"
),
max_cn AS (
  SELECT MAX("weighted_avg_cn") AS "max_cn" FROM per_case
)
SELECT 
  p."case_barcode",
  p."weighted_avg_cn"
FROM per_case        p
JOIN max_cn          m ON p."weighted_avg_cn" = m."max_cn"
LIMIT 20;
```

```sql
--Description: 10)  (Optional sanity check) Show the cytoband-level weighted
--              CN value next to the overall genome-wide average for the
--              top-ranked cases to highlight the amplification specificity.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
),
band_avg AS (
  SELECT
    "case_barcode",
    SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
        AS "band_cn"
  FROM overlap
  GROUP BY "case_barcode"
),
genome_avg AS (
  SELECT
    "case_barcode",
    AVG(2 * POWER(2, "segment_mean")) AS "genome_cn"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02
  WHERE "project_short_name" = 'TCGA-LAML'
  GROUP BY "case_barcode"
)
SELECT 
  b."case_barcode",
  b."band_cn",
  g."genome_cn"
FROM band_avg b
JOIN genome_avg g USING ("case_barcode")
ORDER BY b."band_cn" DESC
LIMIT 20;
```
