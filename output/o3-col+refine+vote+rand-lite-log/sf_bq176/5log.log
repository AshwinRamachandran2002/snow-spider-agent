Query:
--Description: 7)  Aggregate the previous result for each case_barcode to
--              obtain (a) total base-pairs covered inside 15q11 and
--              (b) the weighted average copy number inside 15q11.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
)
SELECT
  "case_barcode",
  SUM("overlap_bp")                                   AS "total_bp",
  SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
                                                      AS "weighted_avg_cn"
FROM overlap
GROUP BY "case_barcode"
LIMIT 20;
