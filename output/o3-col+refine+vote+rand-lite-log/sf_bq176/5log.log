Query:
--Description: 9)  Produce the final list of TCGA-LAML case barcodes that
--              have the single highest weighted average CN in cytoband 15q11.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
),
per_case AS (
  SELECT
    "case_barcode",
    SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
        AS "weighted_avg_cn"
  FROM overlap
  GROUP BY "case_barcode"
),
max_cn AS (
  SELECT MAX("weighted_avg_cn") AS "max_cn" FROM per_case
)
SELECT 
  p."case_barcode",
  p."weighted_avg_cn"
FROM per_case        p
JOIN max_cn          m ON p."weighted_avg_cn" = m."max_cn"
LIMIT 20;
Answer:
case_barcode,weighted_avg_cn
TCGA-AB-2939,4.992630022145063
Query:
--Description: 10)  (Optional sanity check) Show the cytoband-level weighted
--              CN value next to the overall genome-wide average for the
--              top-ranked cases to highlight the amplification specificity.
WITH overlap AS (
  SELECT
    s."case_barcode",
    GREATEST(0,
             LEAST(s."end_pos",   c."hg38_stop") 
           - GREATEST(s."start_pos", c."hg38_start") + 1)      AS "overlap_bp",
    2 * POWER(2, s."segment_mean")                             AS "copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                    c
    ON c."chromosome" = 'chr' || s."chromosome"
  WHERE s."project_short_name" = 'TCGA-LAML'
    AND s."chromosome"         = '15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."start_pos" <= c."hg38_stop"
    AND s."end_pos"   >= c."hg38_start"
),
band_avg AS (
  SELECT
    "case_barcode",
    SUM("overlap_bp" * "copy_number") / NULLIF(SUM("overlap_bp"),0)
        AS "band_cn"
  FROM overlap
  GROUP BY "case_barcode"
),
genome_avg AS (
  SELECT
    "case_barcode",
    AVG(2 * POWER(2, "segment_mean")) AS "genome_cn"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02
  WHERE "project_short_name" = 'TCGA-LAML'
  GROUP BY "case_barcode"
)
SELECT 
  b."case_barcode",
  b."band_cn",
  g."genome_cn"
FROM band_avg b
JOIN genome_avg g USING ("case_barcode")
ORDER BY b."band_cn" DESC
LIMIT 20;
Answer:
case_barcode,band_cn,genome_cn
