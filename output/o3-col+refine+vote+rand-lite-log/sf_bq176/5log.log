Query:
--Description: 4)  Pull all segments for TCGA-LAML whose genomic interval
--              intersects any 15q11 sub-band.  A segment overlaps a
--              cytoband if its start ≤ cytoband_stop and its end ≥ cytoband_start.
SELECT 
  s."case_barcode",
  s."chromosome",
  s."start_pos",
  s."end_pos",
  s."segment_mean",
  c."cytoband_name",
  c."hg38_start"        AS "cyto_start",
  c."hg38_stop"         AS "cyto_stop"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_2017_02  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                         c
  ON c."chromosome"   = 'chr' || s."chromosome"
WHERE s."project_short_name" = 'TCGA-LAML'
  AND s."chromosome" = '15'
  AND c."cytoband_name" ILIKE '15q11%'
  AND s."start_pos" <= c."hg38_stop"
  AND s."end_pos"   >= c."hg38_start"
LIMIT 20;
