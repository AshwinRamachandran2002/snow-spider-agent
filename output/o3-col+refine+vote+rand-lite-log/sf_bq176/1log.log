```sql
--Description: All LAML segments that overlap the 15q11 cytoband(s) on chr15  
SELECT s."case_barcode",
       s."start_pos",
       s."end_pos",
       s."segment_mean",
       c."cytoband_name"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14   s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
     ON c."chromosome"   = 'chr15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."chromosome"   = '15'
    AND s."start_pos"   <= c."hg38_stop"
    AND s."end_pos"     >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
LIMIT 20;
```

```sql
--Description: Compute the exact overlap (bp) between each LAML segment and 15q11 cytoband regions  
SELECT s."case_barcode",
       c."cytoband_name",
       GREATEST(s."start_pos", c."hg38_start") AS "overlap_start",
       LEAST  (s."end_pos"  , c."hg38_stop")  AS "overlap_end",
       ( LEAST(s."end_pos", c."hg38_stop") 
         - GREATEST(s."start_pos", c."hg38_start") + 1 )            AS "overlap_len",
       s."segment_mean"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14   s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                      c
     ON c."chromosome"   = 'chr15'
    AND c."cytoband_name" ILIKE '15q11%'
    AND s."chromosome"   = '15'
    AND s."start_pos"   <= c."hg38_stop"
    AND s."end_pos"     >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-LAML'
LIMIT 20;
```

```sql
--Description: Weighted average segment_mean across 15q11 for each LAML case (higher = more gain)  
SELECT t."case_barcode",
       SUM(t."segment_mean" * t."overlap_len") / SUM(t."overlap_len")  AS "weighted_avg_segment_mean",
       SUM(t."overlap_len")                                           AS "total_overlap_bp"
FROM (
      SELECT s."case_barcode",
             ( LEAST(s."end_pos", c."hg38_stop") 
               - GREATEST(s."start_pos", c."hg38_start") + 1 ) AS "overlap_len",
             s."segment_mean"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  c
           ON c."chromosome"='chr15'
          AND c."cytoband_name" ILIKE '15q11%'
          AND s."chromosome"='15'
          AND s."start_pos"<=c."hg38_stop"
          AND s."end_pos">=c."hg38_start"
      WHERE s."project_short_name"='TCGA-LAML'
     ) t
GROUP BY t."case_barcode"
ORDER BY "weighted_avg_segment_mean" DESC
LIMIT 20;
```

```sql
--Description: Convert segment_mean to absolute copy-number (2^(mean)*2) & get weighted average CN  
SELECT t."case_barcode",
       SUM( POWER(2, t."segment_mean") * 2 * t."overlap_len") / SUM(t."overlap_len") AS "weighted_avg_copy_number"
FROM (
      SELECT s."case_barcode",
             ( LEAST(s."end_pos", c."hg38_stop") 
               - GREATEST(s."start_pos", c."hg38_start") + 1 ) AS "overlap_len",
             s."segment_mean"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  c
           ON c."chromosome"='chr15'
          AND c."cytoband_name" ILIKE '15q11%'
          AND s."chromosome"='15'
          AND s."start_pos"<=c."hg38_stop"
          AND s."end_pos">=c."hg38_start"
      WHERE s."project_short_name"='TCGA-LAML'
     ) t
GROUP BY t."case_barcode"
ORDER BY "weighted_avg_copy_number" DESC
LIMIT 20;
```

```sql
--Description: Inspect segment-level details for the top 5 LAML cases with highest weighted CN in 15q11  
WITH ranked AS (
     SELECT t."case_barcode",
            SUM( POWER(2, t."segment_mean")*2 * t."overlap_len") / SUM(t."overlap_len") AS "w_avg_cn"
     FROM (
           SELECT s."case_barcode",
                  ( LEAST(s."end_pos", c."hg38_stop") 
                    - GREATEST(s."start_pos", c."hg38_start") + 1 ) AS "overlap_len",
                  s."segment_mean"
           FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
           JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                          c
                ON c."chromosome"='chr15'
               AND c."cytoband_name" ILIKE '15q11%'
               AND s."chromosome"='15'
               AND s."start_pos"<=c."hg38_stop"
               AND s."end_pos">=c."hg38_start"
           WHERE s."project_short_name"='TCGA-LAML'
          ) t
     GROUP BY t."case_barcode"
     ORDER BY "w_avg_cn" DESC
     LIMIT 5
)
SELECT s."case_barcode",
       s."start_pos",
       s."end_pos",
       s."segment_mean",
       POWER(2, s."segment_mean")*2 AS "segment_copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
JOIN ranked r
     ON r."case_barcode" = s."case_barcode"
WHERE s."chromosome" = '15'
LIMIT 20;
```

```sql
--Description: Attach experimental strategy / data-type metadata to LAML cases ranked by 15q11 copy number  
WITH top_cases AS (
     SELECT t."case_barcode",
            SUM( POWER(2, t."segment_mean")*2 * t."overlap_len") / SUM(t."overlap_len") AS "w_avg_cn"
     FROM (
           SELECT s."case_barcode",
                  ( LEAST(s."end_pos", c."hg38_stop") 
                    - GREATEST(s."start_pos", c."hg38_start") + 1 ) AS "overlap_len",
                  s."segment_mean"
           FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_MASKED_HG38_GDC_R14 s
           JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                          c
                ON c."chromosome"='chr15'
               AND c."cytoband_name" ILIKE '15q11%'
               AND s."chromosome"='15'
               AND s."start_pos"<=c."hg38_stop"
               AND s."end_pos">=c."hg38_start"
           WHERE s."project_short_name"='TCGA-LAML'
          ) t
     GROUP BY t."case_barcode"
     ORDER BY "w_avg_cn" DESC
     LIMIT 20
)
SELECT tc."case_barcode",
       tc."w_avg_cn",
       m."data_type",
       m."experimental_strategy"
FROM top_cases tc
LEFT JOIN TCGA_MITELMAN.TCGA_VERSIONED.PER_SAMPLE_FILE_METADATA_HG38_GDC_R32 m
       ON tc."case_barcode" = m."case_barcode"
LIMIT 20;
```
