```sql
--Description: 
-- Goal: daily % change in trading volume for every ticker from 01-Aug-2021 to 10-Aug-2021.  
-- Logic inside the query:  
--   1) CTE clean                         – convert DD-MM-YYYY to ISO date and turn
--                                          “volume” text into a pure number
--                                          (K → ×1 000, M → ×1 000 000, “-” → 0).  
--   2) CTE add_prev                      – for each row in the target window, fetch the
--                                          most-recent *non-zero* prior volume of the same
--                                          ticker (NULL if none).  
--   3) Final SELECT                      – compute % change:  
--                                          (today – prev) / prev × 100, rounded to 2 dp;  
--                                          if prev is NULL or 0 ⇒ NULL.  
--   4) Order by ticker then date.

WITH clean AS (
    SELECT
        ticker,
        DATE(SUBSTR(market_date,7,4) || '-' || SUBSTR(market_date,4,2) || '-' || SUBSTR(market_date,1,2)) AS iso_date,
        CASE
            WHEN volume = '-'      THEN 0
            WHEN volume LIKE '%K'  THEN CAST(REPLACE(volume,'K','') AS REAL) * 1000
            WHEN volume LIKE '%M'  THEN CAST(REPLACE(volume,'M','') AS REAL) * 1000000
            ELSE CAST(volume AS REAL)
        END AS volume_num
    FROM bitcoin_prices
),
add_prev AS (
    SELECT
        c.*,
        (
            SELECT c2.volume_num
            FROM clean c2
            WHERE c2.ticker = c.ticker
              AND c2.volume_num > 0
              AND c2.iso_date < c.iso_date
            ORDER BY c2.iso_date DESC
            LIMIT 1
        ) AS prev_volume
    FROM clean c
    WHERE c.iso_date BETWEEN '2021-08-01' AND '2021-08-10'
)
SELECT
    ticker,
    iso_date AS market_date,
    CASE
        WHEN prev_volume IS NULL OR prev_volume = 0
            THEN NULL
        ELSE ROUND( (volume_num - prev_volume) * 100.0 / prev_volume , 2)
    END AS pct_change_vol
FROM add_prev
ORDER BY ticker, market_date;
```
