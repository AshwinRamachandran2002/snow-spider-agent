-- Description: 7) Finally, calculate the daily % change in trading volume for each ticker
--               between 2021-08-01 and 2021-08-10, using the previous
--               *non-zero* volume as the base.  Ordered by ticker and date.
SELECT
  bp."ticker",
  date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2)) AS "market_date",
  CAST(
    CASE
        WHEN bp."volume" = '-'                     THEN 0
        WHEN bp."volume" LIKE '%K'                 THEN REPLACE(bp."volume",'K','') * 1000
        WHEN bp."volume" LIKE '%M'                 THEN REPLACE(bp."volume",'M','') * 1000000
        ELSE bp."volume"
    END AS REAL
  )                                               AS "volume_num",
  CAST(
    (
      SELECT
        CASE
            WHEN bp2."volume" = '-'                     THEN 0
            WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
            WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
            ELSE bp2."volume"
        END
      FROM "bitcoin_prices" AS bp2
      WHERE bp2."ticker" = bp."ticker"
        AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
            < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
      AND
        (
          CASE
              WHEN bp2."volume" = '-'                     THEN 0
              WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
              WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
              ELSE bp2."volume"
          END
        ) > 0
      ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
      LIMIT 1
    ) AS REAL
  )                                               AS "prev_non_zero_vol",
  CASE
      WHEN (
        (
          SELECT
            CASE
                WHEN bp2."volume" = '-'                     THEN 0
                WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                ELSE bp2."volume"
            END
          FROM "bitcoin_prices" AS bp2
          WHERE bp2."ticker" = bp."ticker"
            AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
            AND
              (
                CASE
                    WHEN bp2."volume" = '-'                     THEN 0
                    WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                    WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                    ELSE bp2."volume"
                END
              ) > 0
          ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
          LIMIT 1
        )
      ) = 0 OR
      (
        (
          SELECT
            CASE
                WHEN bp2."volume" = '-'                     THEN 0
                WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                ELSE bp2."volume"
            END
          FROM "bitcoin_prices" AS bp2
          WHERE bp2."ticker" = bp."ticker"
            AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
            AND
              (
                CASE
                    WHEN bp2."volume" = '-'                     THEN 0
                    WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                    WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                    ELSE bp2."volume"
                END
              ) > 0
          ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
          LIMIT 1
        )
      ) IS NULL
      THEN NULL
      ELSE ROUND(
            (
              CAST(
                  CASE
                      WHEN bp."volume" = '-'                     THEN 0
                      WHEN bp."volume" LIKE '%K'                 THEN REPLACE(bp."volume",'K','') * 1000
                      WHEN bp."volume" LIKE '%M'                 THEN REPLACE(bp."volume",'M','') * 1000000
                      ELSE bp."volume"
                  END AS REAL
              )
              -
              CAST(
                  (
                    SELECT
                      CASE
                          WHEN bp2."volume" = '-'                     THEN 0
                          WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                          WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                          ELSE bp2."volume"
                      END
                    FROM "bitcoin_prices" AS bp2
                    WHERE bp2."ticker" = bp."ticker"
                      AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                          < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
                      AND
                        (
                          CASE
                              WHEN bp2."volume" = '-'                     THEN 0
                              WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                              WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                              ELSE bp2."volume"
                          END
                        ) > 0
                    ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
                    LIMIT 1
                  ) AS REAL
              )
            )
            /
            CAST(
                (
                  SELECT
                    CASE
                        WHEN bp2."volume" = '-'                     THEN 0
                        WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                        WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                        ELSE bp2."volume"
                    END
                  FROM "bitcoin_prices" AS bp2
                  WHERE bp2."ticker" = bp."ticker"
                    AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                        < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
                    AND
                      (
                        CASE
                            WHEN bp2."volume" = '-'                     THEN 0
                            WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                            WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                            ELSE bp2."volume"
                        END
                      ) > 0
                  ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
                  LIMIT 1
                ) AS REAL
            )
            * 100, 2)
  END AS "pct_change_vol"
FROM "bitcoin_prices" AS bp
WHERE bp."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "market_date";
