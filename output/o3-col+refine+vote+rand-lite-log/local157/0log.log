```sql
-- Description: 4) Convert the “volume” text into a pure number (K = ×1 000, M = ×1 000 000, ‘-’ = 0)
--               for a few sample rows to confirm the logic.
SELECT
  "ticker",
  "market_date",
  "volume",
  CASE
      WHEN "volume" = '-'                     THEN 0
      WHEN "volume" LIKE '%K'                 THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
      WHEN "volume" LIKE '%M'                 THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
      ELSE CAST("volume" AS REAL)
  END AS "volume_num"
FROM "bitcoin_prices"
WHERE "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "market_date"
LIMIT 20;
```

```sql
-- Description: 5) Show the same numeric volume together with an ISO-formatted date
--               so we can use SQLite’s date functions more easily.
SELECT
  "ticker",
  date(substr("market_date",7,4)||'-'||substr("market_date",4,2)||'-'||substr("market_date",1,2)) AS "mkt_date_iso",
  CASE
      WHEN "volume" = '-'                     THEN 0
      WHEN "volume" LIKE '%K'                 THEN CAST(REPLACE("volume",'K','') AS REAL) * 1000
      WHEN "volume" LIKE '%M'                 THEN CAST(REPLACE("volume",'M','') AS REAL) * 1000000
      ELSE CAST("volume" AS REAL)
  END AS "volume_num"
FROM "bitcoin_prices"
WHERE "market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "mkt_date_iso"
LIMIT 20;
```

```sql
-- Description: 6) For every ticker/date in the target range,
--               pull the most recent *non-zero* prior volume for that ticker.
SELECT
  bp."ticker",
  date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2)) AS "mkt_date_iso",
  CASE
      WHEN bp."volume" = '-'                     THEN 0
      WHEN bp."volume" LIKE '%K'                 THEN CAST(REPLACE(bp."volume",'K','') AS REAL) * 1000
      WHEN bp."volume" LIKE '%M'                 THEN CAST(REPLACE(bp."volume",'M','') AS REAL) * 1000000
      ELSE CAST(bp."volume" AS REAL)
  END AS "volume_num",
  (
    SELECT
      CASE
          WHEN bp2."volume" = '-'                     THEN 0
          WHEN bp2."volume" LIKE '%K'                 THEN CAST(REPLACE(bp2."volume",'K','') AS REAL) * 1000
          WHEN bp2."volume" LIKE '%M'                 THEN CAST(REPLACE(bp2."volume",'M','') AS REAL) * 1000000
          ELSE CAST(bp2."volume" AS REAL)
      END
    FROM "bitcoin_prices" AS bp2
    WHERE bp2."ticker" = bp."ticker"
      AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
          < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
      AND (
            (bp2."volume" NOT LIKE '-')  -- exclude explicit '-'
         OR (bp2."volume" <> '-'         -- safeguard
         )
          )
    AND
      CASE                                           -- keep only non-zero numeric volumes
          WHEN bp2."volume" LIKE '%K' THEN CAST(REPLACE(bp2."volume",'K','') AS REAL) * 1000
          WHEN bp2."volume" LIKE '%M' THEN CAST(REPLACE(bp2."volume",'M','') AS REAL) * 1000000
          WHEN bp2."volume" = '-'     THEN 0
          ELSE CAST(bp2."volume" AS REAL)
      END > 0
    ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
    LIMIT 1
  ) AS "prev_non_zero_vol"
FROM "bitcoin_prices" AS bp
WHERE bp."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "mkt_date_iso"
LIMIT 20;
```

```sql
-- Description: 7) Finally, calculate the daily % change in trading volume for each ticker
--               between 2021-08-01 and 2021-08-10, using the previous
--               *non-zero* volume as the base.  Ordered by ticker and date.
SELECT
  bp."ticker",
  date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2)) AS "market_date",
  CAST(
    CASE
        WHEN bp."volume" = '-'                     THEN 0
        WHEN bp."volume" LIKE '%K'                 THEN REPLACE(bp."volume",'K','') * 1000
        WHEN bp."volume" LIKE '%M'                 THEN REPLACE(bp."volume",'M','') * 1000000
        ELSE bp."volume"
    END AS REAL
  )                                               AS "volume_num",
  CAST(
    (
      SELECT
        CASE
            WHEN bp2."volume" = '-'                     THEN 0
            WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
            WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
            ELSE bp2."volume"
        END
      FROM "bitcoin_prices" AS bp2
      WHERE bp2."ticker" = bp."ticker"
        AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
            < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
      AND
        (
          CASE
              WHEN bp2."volume" = '-'                     THEN 0
              WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
              WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
              ELSE bp2."volume"
          END
        ) > 0
      ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
      LIMIT 1
    ) AS REAL
  )                                               AS "prev_non_zero_vol",
  CASE
      WHEN (
        (
          SELECT
            CASE
                WHEN bp2."volume" = '-'                     THEN 0
                WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                ELSE bp2."volume"
            END
          FROM "bitcoin_prices" AS bp2
          WHERE bp2."ticker" = bp."ticker"
            AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
            AND
              (
                CASE
                    WHEN bp2."volume" = '-'                     THEN 0
                    WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                    WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                    ELSE bp2."volume"
                END
              ) > 0
          ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
          LIMIT 1
        )
      ) = 0 OR
      (
        (
          SELECT
            CASE
                WHEN bp2."volume" = '-'                     THEN 0
                WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                ELSE bp2."volume"
            END
          FROM "bitcoin_prices" AS bp2
          WHERE bp2."ticker" = bp."ticker"
            AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
            AND
              (
                CASE
                    WHEN bp2."volume" = '-'                     THEN 0
                    WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                    WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                    ELSE bp2."volume"
                END
              ) > 0
          ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
          LIMIT 1
        )
      ) IS NULL
      THEN NULL
      ELSE ROUND(
            (
              CAST(
                  CASE
                      WHEN bp."volume" = '-'                     THEN 0
                      WHEN bp."volume" LIKE '%K'                 THEN REPLACE(bp."volume",'K','') * 1000
                      WHEN bp."volume" LIKE '%M'                 THEN REPLACE(bp."volume",'M','') * 1000000
                      ELSE bp."volume"
                  END AS REAL
              )
              -
              CAST(
                  (
                    SELECT
                      CASE
                          WHEN bp2."volume" = '-'                     THEN 0
                          WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                          WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                          ELSE bp2."volume"
                      END
                    FROM "bitcoin_prices" AS bp2
                    WHERE bp2."ticker" = bp."ticker"
                      AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                          < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
                      AND
                        (
                          CASE
                              WHEN bp2."volume" = '-'                     THEN 0
                              WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                              WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                              ELSE bp2."volume"
                          END
                        ) > 0
                    ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
                    LIMIT 1
                  ) AS REAL
              )
            )
            /
            CAST(
                (
                  SELECT
                    CASE
                        WHEN bp2."volume" = '-'                     THEN 0
                        WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                        WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                        ELSE bp2."volume"
                    END
                  FROM "bitcoin_prices" AS bp2
                  WHERE bp2."ticker" = bp."ticker"
                    AND date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2))
                        < date(substr(bp."market_date",7,4)||'-'||substr(bp."market_date",4,2)||'-'||substr(bp."market_date",1,2))
                    AND
                      (
                        CASE
                            WHEN bp2."volume" = '-'                     THEN 0
                            WHEN bp2."volume" LIKE '%K'                 THEN REPLACE(bp2."volume",'K','') * 1000
                            WHEN bp2."volume" LIKE '%M'                 THEN REPLACE(bp2."volume",'M','') * 1000000
                            ELSE bp2."volume"
                        END
                      ) > 0
                  ORDER BY date(substr(bp2."market_date",7,4)||'-'||substr(bp2."market_date",4,2)||'-'||substr(bp2."market_date",1,2)) DESC
                  LIMIT 1
                ) AS REAL
            )
            * 100, 2)
  END AS "pct_change_vol"
FROM "bitcoin_prices" AS bp
WHERE bp."market_date" BETWEEN '01-08-2021' AND '10-08-2021'
ORDER BY "ticker", "market_date";
```

```sql
-- Description: 8) Check only the final percentage-change result,
--               omitting the intermediate columns.
SELECT
  "ticker",
  "market_date",
  ROUND("pct_change_vol", 2) AS "pct_chg_vol_%"
FROM (
  -- the full calculation from step 7 would be nested here or saved via CTE
)
