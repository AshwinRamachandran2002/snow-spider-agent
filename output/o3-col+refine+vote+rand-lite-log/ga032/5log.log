/* Navigation flow (page_view only) for one user on 2021-01-28  */
WITH page_views AS (
  /* Pull one row per page_view with its URL and title  */
  SELECT
    event_timestamp,
    (
      SELECT MAX(p.value.string_value)
      FROM   UNNEST(event_params) AS p
      WHERE  p.key = 'page_location'
    ) AS page_location,
    (
