```sql
--Description: 6)  Classify every URL as PDP / PLP (or leave title unchanged if neither)  
WITH pages AS (
  SELECT  
        `event_timestamp`,
        MAX(CASE WHEN param.key='page_location' THEN param.value.string_value END) AS page_location,
        MAX(CASE WHEN param.key='page_title'    THEN param.value.string_value END) AS page_title
  FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`,
        UNNEST(`event_params`) AS param
  WHERE `user_pseudo_id`='1362228.4966015575'
    AND `event_name`   ='page_view'
  GROUP BY `event_timestamp`
)
SELECT
  event_timestamp,
  page_title,
  page_location,
  CASE
      -- PDP:  ≥5 segments, “+” in last segment, and category word in 4th or 5th segment
      WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(page_location,r'^https?://[^/]+/',''),'/')) >= 5
           AND REGEXP_CONTAINS(SPLIT(page_location,'/')[-1], r'\+')
           AND (
                  REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
               OR REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
               )
      THEN 'PDP'
      -- PLP:  ≥5 segments, no “+” in 4th or 5th segment, but category word present
      WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(page_location,r'^https?://[^/]+/',''),'/')) >= 5
           AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/')[OFFSET(3)], r'\+')
           AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/')[OFFSET(4)], r'\+')
           AND (
                  REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
               OR REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
               )
      THEN 'PLP'
      ELSE page_title
  END AS page_identifier
FROM pages
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 7)  Remove consecutive duplicates so the user staying on the same page isn’t repeated  
WITH classified AS (
  SELECT
    event_timestamp,
    CASE
        WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(page_location,r'^https?://[^/]+/',''),'/')) >= 5
             AND REGEXP_CONTAINS(SPLIT(page_location,'/')[-1], r'\+')
             AND (  REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                 OR REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)'))
        THEN 'PDP'
        WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(page_location,r'^https?://[^/]+/',''),'/')) >= 5
             AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/')[OFFSET(3)], r'\+')
             AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/')[OFFSET(4)], r'\+')
             AND (  REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                 OR REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)'))
        THEN 'PLP'
        ELSE page_title
    END AS page_id
  FROM (
        SELECT  
              `event_timestamp`,
              MAX(CASE WHEN param.key='page_location' THEN param.value.string_value END) AS page_location,
              MAX(CASE WHEN param.key='page_title'    THEN param.value.string_value END) AS page_title
        FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`,
              UNNEST(`event_params`) AS param
        WHERE `user_pseudo_id`='1362228.4966015575'
          AND `event_name`   ='page_view'
        GROUP BY `event_timestamp`
  )
)
SELECT *
FROM   classified
QUALIFY LAG(page_id) OVER (ORDER BY event_timestamp) IS NULL
     OR LAG(page_id) OVER (ORDER BY event_timestamp) <> page_id
ORDER BY event_timestamp
LIMIT 20;
```

```sql
--Description: 8)  Final query – stitch the cleaned sequence together with “>>” to show the navigation flow  
WITH classified AS (
  SELECT
    event_timestamp,
    CASE
        WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(page_location,r'^https?://[^/]+/',''),'/')) >= 5
             AND REGEXP_CONTAINS(SPLIT(page_location,'/')[-1], r'\+')
             AND (  REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                 OR REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)'))
        THEN 'PDP'
        WHEN ARRAY_LENGTH(SPLIT(REGEXP_REPLACE(page_location,r'^https?://[^/]+/',''),'/')) >= 5
             AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/')[OFFSET(3)], r'\+')
             AND NOT REGEXP_CONTAINS(SPLIT(page_location,'/')[OFFSET(4)], r'\+')
             AND (  REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(3)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)')
                 OR REGEXP_CONTAINS(LOWER(SPLIT(page_location,'/')[OFFSET(4)]), r'(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)'))
        THEN 'PLP'
        ELSE page_title
    END AS page_id
  FROM (
        SELECT  
              `event_timestamp`,
              MAX(CASE WHEN param.key='page_location' THEN param.value.string_value END) AS page_location,
              MAX(CASE WHEN param.key='page_title'    THEN param.value.string_value END) AS page_title
        FROM  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`,
              UNNEST(`event_params`) AS param
        WHERE `user_pseudo_id`='1362228.4966015575'
          AND `event_name`   ='page_view'
        GROUP BY `event_timestamp`
  )
),
dedup AS (
  SELECT 
        event_timestamp,
        page_id,
        CASE WHEN LAG(page_id) OVER (ORDER BY event_timestamp) = page_id THEN 0 ELSE 1 END AS new_step
  FROM classified
),
numbered AS (
  SELECT *,
         SUM(new_step) OVER (ORDER BY event_timestamp) AS grp
  FROM dedup
)
SELECT STRING_AGG(page_id, '>>' ORDER BY grp) AS navigation_flow
FROM  (SELECT DISTINCT grp, page_id FROM numbered ORDER BY grp)
;
```

Run the last query to obtain the final navigation-flow string for the user  
(only page_view events, PLP/PDP conversion applied, consecutive duplicates merged).
