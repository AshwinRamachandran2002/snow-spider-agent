--Description: Build the cleaned-up navigation flow (page_view only) for user 1362228.4966015575 on 28-Jan-2021
--  • Step A: pull every page_view row from the partition table events_20210128.
--  • Step B: extract two parameters from event_params – page_title and page_location – via sub-queries.
--  • Step C: classify each URL as PDP or PLP:
--        ‑ PDP  → URL contains category segment (list provided) AND a “+” in the final segment.
--        ‑ PLP  → URL contains the category segment but no “+” in that position.
--        ‑ else → keep the original page_title.
--  • Step D: collapse consecutive repeats (LAG + QUALIFY, which BigQuery allows instead of WHERE).
--  • Output the time-ordered, de-duplicated hits (first 20 rows for quick inspection; remove LIMIT for full list).

WITH base AS (
  SELECT
    event_timestamp,
    (SELECT value.string_value FROM UNNEST(event_params)
     WHERE key = 'page_title'    LIMIT 1) AS page_title,
    (SELECT value.string_value FROM UNNEST(event_params)
     WHERE key = 'page_location' LIMIT 1) AS page_location
  FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_20210128`
  WHERE user_pseudo_id = '1362228.4966015575'
    AND event_name     = 'page_view'
),
labeled AS (
  SELECT
    event_timestamp,
    CASE
      WHEN REGEXP_CONTAINS(
             LOWER(page_location),
             r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/[^/]*\+')
           THEN 'PDP'
      WHEN REGEXP_CONTAINS(
             LOWER(page_location),
             r'/(accessories|apparel|brands|campus\+collection|drinkware|electronics|google\+redesign|lifestyle|nest|new\+2015\+logo|notebooks\+journals|office|shop\+by\+brand|small\+goods|stationery|wearables)/')
           THEN 'PLP'
      ELSE page_title
    END AS page_label
  FROM base
)
SELECT
  event_timestamp,
  page_label
FROM labeled
QUALIFY page_label IS NOT NULL
        AND (page_label <> LAG(page_label) OVER (ORDER BY event_timestamp)
             OR LAG(page_label) OVER (ORDER BY event_timestamp) IS NULL)
ORDER BY event_timestamp
LIMIT 20;
