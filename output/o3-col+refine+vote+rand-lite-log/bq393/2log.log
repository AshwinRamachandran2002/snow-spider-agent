--Description:
-- Purpose: Find the user who stayed active for the longest calendar-month span
-- (counted from their first month = month #0) **and** who has at least one
-- missing month inside that span, proving the user became intermittently
-- inactive and then completely inactive after their final month.
--
-- Reasoning steps written inline:
WITH user_months AS (      -- Step-1: one row per user per calendar month
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'       -- consider data up to 10-Sep-2024
  GROUP BY user_id, act_month
),
span_stats AS (            -- Step-2: gather first & last months and full list
  SELECT
    user_id,
    ARRAY_AGG(act_month ORDER BY act_month)                       AS months_arr,
    MIN(act_month)                                                AS first_mo,
    MAX(act_month)                                                AS last_mo
  FROM user_months
  GROUP BY user_id
),
with_gap AS (              -- Step-3: keep only users who have an internal gap
  SELECT
    user_id,
    DATE_DIFF(last_mo, first_mo, MONTH)            AS last_month_num, -- 0-based #
    ARRAY_LENGTH(months_arr)                       AS active_cnt,
    DATE_DIFF(last_mo, first_mo, MONTH) + 1        AS span_cnt
  FROM span_stats
  WHERE (DATE_DIFF(last_mo, first_mo, MONTH) + 1) > ARRAY_LENGTH(months_arr)
  -- condition ↑ means at least one month inside the span has zero activity
)
-- Step-4: pick the user with the highest month number (largest span)
SELECT
  user_id  AS most_persistent_then_inactive_user,
  last_month_num AS month_number_from_start        -- highest 0-based month #
FROM with_gap
ORDER BY last_month_num DESC
LIMIT 1;
```
