Query:
-- 7) Description: Rank above users by the month number of their final activity (“highest month number”)
WITH user_months AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
),
calc AS (
  SELECT
    user_id,
    MIN(act_month) AS first_mo,
    MAX(act_month) AS last_mo
  FROM user_months
  GROUP BY user_id
),
with_gap AS (
  SELECT
    c.*,
    DATE_DIFF(last_mo, first_mo, MONTH) AS last_month_num
  FROM calc c
  JOIN (
    -- users having an internal gap
    SELECT user_id
    FROM (
      SELECT
        user_id,
        ARRAY_AGG(DISTINCT act_month ORDER BY act_month)                AS months_array,
        MIN(act_month)                                                  AS f_mo,
        MAX(act_month)                                                  AS l_mo
      FROM user_months
      GROUP BY user_id
    )
    WHERE (DATE_DIFF(l_mo, f_mo, MONTH) + 1) > ARRAY_LENGTH(months_array)
  ) g
  ON c.user_id = g.user_id
)
SELECT
  user_id,
  last_month_num
FROM with_gap
ORDER BY last_month_num DESC
LIMIT 20;
