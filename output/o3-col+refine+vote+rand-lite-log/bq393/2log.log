Query:
-- 6) Description: Detect users that have at least one missing (inactive) month inside their activity span
WITH user_months AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
),
calc AS (
  SELECT
    user_id,
    ARRAY_AGG(DISTINCT act_month ORDER BY act_month)          AS act_months,
    MIN(act_month)                                            AS first_mo,
    MAX(act_month)                                            AS last_mo
  FROM user_months
  GROUP BY user_id
)
SELECT
  user_id,
  first_mo,
  last_mo,
  ARRAY_LENGTH(act_months)                                    AS active_mo_cnt,
  DATE_DIFF(last_mo, first_mo, MONTH) + 1                     AS span_mo_cnt,
  (DATE_DIFF(last_mo, first_mo, MONTH) + 1) - ARRAY_LENGTH(act_months) AS missing_mo_cnt
FROM calc
WHERE (DATE_DIFF(last_mo, first_mo, MONTH) + 1) > ARRAY_LENGTH(act_months) -- at least one missing month
LIMIT 20;
