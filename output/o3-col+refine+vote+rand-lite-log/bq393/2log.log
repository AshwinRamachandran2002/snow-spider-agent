```sql
-- 4) Description: Compute first and last activity month plus span length (months_from_start) for 20 users
WITH user_months AS (
  SELECT
    `by`                         AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
)
SELECT
  user_id,
  MIN(act_month)                       AS first_month,
  MAX(act_month)                       AS last_month,
  DATE_DIFF(MAX(act_month), MIN(act_month), MONTH) AS months_from_start
FROM user_months
GROUP BY user_id
ORDER BY months_from_start DESC
LIMIT 20;
```

```sql
-- 5) Description: For 20 users, show how many distinct months they posted in
WITH user_months AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
)
SELECT
  user_id,
  COUNT(*) AS active_month_cnt
FROM user_months
GROUP BY user_id
ORDER BY active_month_cnt DESC
LIMIT 20;
```

```sql
-- 6) Description: Detect users that have at least one missing (inactive) month inside their activity span
WITH user_months AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
),
calc AS (
  SELECT
    user_id,
    ARRAY_AGG(DISTINCT act_month ORDER BY act_month)          AS act_months,
    MIN(act_month)                                            AS first_mo,
    MAX(act_month)                                            AS last_mo
  FROM user_months
  GROUP BY user_id
)
SELECT
  user_id,
  first_mo,
  last_mo,
  ARRAY_LENGTH(act_months)                                    AS active_mo_cnt,
  DATE_DIFF(last_mo, first_mo, MONTH) + 1                     AS span_mo_cnt,
  (DATE_DIFF(last_mo, first_mo, MONTH) + 1) - ARRAY_LENGTH(act_months) AS missing_mo_cnt
FROM calc
WHERE (DATE_DIFF(last_mo, first_mo, MONTH) + 1) > ARRAY_LENGTH(act_months) -- at least one missing month
LIMIT 20;
```

```sql
-- 7) Description: Rank above users by the month number of their final activity (“highest month number”)
WITH user_months AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
),
calc AS (
  SELECT
    user_id,
    MIN(act_month) AS first_mo,
    MAX(act_month) AS last_mo
  FROM user_months
  GROUP BY user_id
),
with_gap AS (
  SELECT
    c.*,
    DATE_DIFF(last_mo, first_mo, MONTH) AS last_month_num
  FROM calc c
  JOIN (
    -- users having an internal gap
    SELECT user_id
    FROM (
      SELECT
        user_id,
        ARRAY_AGG(DISTINCT act_month ORDER BY act_month)                AS months_array,
        MIN(act_month)                                                  AS f_mo,
        MAX(act_month)                                                  AS l_mo
      FROM user_months
      GROUP BY user_id
    )
    WHERE (DATE_DIFF(l_mo, f_mo, MONTH) + 1) > ARRAY_LENGTH(months_array)
  ) g
  ON c.user_id = g.user_id
)
SELECT
  user_id,
  last_month_num
FROM with_gap
ORDER BY last_month_num DESC
LIMIT 20;
```

```sql
-- 8) Description: Show the single user that has the highest month number who later became inactive
WITH user_months AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
),
calc AS (
  SELECT
    user_id,
    ARRAY_AGG(DISTINCT act_month ORDER BY act_month) AS months_array,
    MIN(act_month)                                   AS first_mo,
    MAX(act_month)                                   AS last_mo
  FROM user_months
  GROUP BY user_id
),
with_gap AS (
  -- keep users with at least one missing month inside their span
  SELECT
    *,
    DATE_DIFF(last_mo, first_mo, MONTH) AS last_month_num,
    (DATE_DIFF(last_mo, first_mo, MONTH) + 1) - ARRAY_LENGTH(months_array) AS missing_mo_cnt
  FROM calc
  WHERE (DATE_DIFF(last_mo, first_mo, MONTH) + 1) > ARRAY_LENGTH(months_array)
)
SELECT
  user_id          AS most_persistent_then_inactive_user,
  last_month_num   AS month_number_from_start
FROM with_gap
ORDER BY last_month_num DESC
LIMIT 20;      -- returns the top user; LIMIT added to comply with spec
```

