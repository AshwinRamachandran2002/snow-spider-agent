-- 4) Description: Compute first and last activity month plus span length (months_from_start) for 20 users
WITH user_months AS (
  SELECT
    `by`                         AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS act_month
  FROM
    `bigquery-public-data.hacker_news.full`
  WHERE
    `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
  GROUP BY user_id, act_month
)
SELECT
  user_id,
  MIN(act_month)                       AS first_month,
  MAX(act_month)                       AS last_month,
  DATE_DIFF(MAX(act_month), MIN(act_month), MONTH) AS months_from_start
FROM user_months
GROUP BY user_id
ORDER BY months_from_start DESC
LIMIT 20;
