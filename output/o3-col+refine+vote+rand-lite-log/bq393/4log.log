--Description: 7) Rank those gap-users by largest expected month number (longest span)
WITH per_user AS (
  SELECT
    `by`,
    MIN(DATE_TRUNC(DATE(`timestamp`), MONTH))                              AS first_month,
    MAX(DATE_TRUNC(DATE(`timestamp`), MONTH))                              AS last_month,
    COUNT(DISTINCT DATE_TRUNC(DATE(`timestamp`), MONTH))                   AS active_months
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'
    AND `by` IS NOT NULL
  GROUP BY `by`
),
gap_users AS (
  SELECT
    *,
    DATE_DIFF(last_month, first_month, MONTH) + 1 AS expected_months
  FROM per_user
  WHERE active_months < DATE_DIFF(last_month, first_month, MONTH) + 1
)
SELECT
  `by`,
  expected_months
FROM gap_users
ORDER BY expected_months DESC
LIMIT 20
