```sql
--Description: 1) Peek at some raw activity records (user, timestamp, item type) up to 10-Sep-2024
SELECT `by`,
       `timestamp`,
       `type`,
       id
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `timestamp` < '2024-09-11'               -- only data up to 10-Sep-2024
  AND  `by` IS NOT NULL
LIMIT 20;
```

```sql
--Description: 2) Show a few “year-month” values each user was active in
SELECT `by`,
       FORMAT_TIMESTAMP('%Y-%m', `timestamp`) AS activity_month
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `timestamp` < '2024-09-11'
  AND  `by` IS NOT NULL
LIMIT 20;
```

```sql
--Description: 3) Count how many distinct months every user was active
SELECT `by`,
       COUNT(DISTINCT FORMAT_TIMESTAMP('%Y-%m', `timestamp`)) AS active_months
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `timestamp` < '2024-09-11'
  AND  `by` IS NOT NULL
GROUP  BY `by`
ORDER  BY active_months DESC
LIMIT 20;
```

```sql
--Description: 4) For each user get first and last active month and number of active months
SELECT `by`,
       MIN(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS first_month,
       MAX(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS last_month,
       COUNT(DISTINCT TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS active_months
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `timestamp` < '2024-09-11'
  AND  `by` IS NOT NULL
GROUP  BY `by`
LIMIT 20;
```

```sql
--Description: 5) Add the “expected” month span = months between first & last + 1
WITH per_user AS (
  SELECT `by`,
         MIN(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS first_month,
         MAX(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS last_month,
         COUNT(DISTINCT TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS active_months
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` < '2024-09-11'
    AND  `by` IS NOT NULL
  GROUP  BY `by`
)
SELECT *,
       TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1 AS expected_months
FROM   per_user
LIMIT 20;
```

```sql
--Description: 6) Keep only users who missed at least one month inside their span (gap present)
WITH per_user AS (
  SELECT `by`,
         MIN(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS first_month,
         MAX(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS last_month,
         COUNT(DISTINCT TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS active_months
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` < '2024-09-11'
    AND  `by` IS NOT NULL
  GROUP  BY `by`
)
SELECT `by`,
       last_month,
       TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1 AS expected_months,
       active_months
FROM   per_user
WHERE  active_months < TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1
LIMIT 20;
```

```sql
--Description: 7) Rank those gap-users by largest expected month number (longest span)
WITH per_user AS (
  SELECT `by`,
         MIN(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS first_month,
         MAX(TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS last_month,
         COUNT(DISTINCT TIMESTAMP_TRUNC(`timestamp`, MONTH)) AS active_months
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` < '2024-09-11'
    AND  `by` IS NOT NULL
  GROUP  BY `by`
),
gap_users AS (
  SELECT *,
         TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1 AS expected_months
  FROM   per_user
  WHERE  active_months < TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1
)
SELECT `by`,
       expected_months
FROM   gap_users
ORDER  BY expected_months DESC
LIMIT 20;
```

```sql
--Description: 8) Final answer – user & month-number (counting from first month) for the user
--with the highest month number who later became inactive
WITH user_months AS (
  SELECT `by`                         AS user_id,
         TIMESTAMP_TRUNC(`timestamp`, MONTH) AS month_ts
  FROM   `bigquery-public-data.hacker_news.full`
  WHERE  `timestamp` < '2024-09-11'
    AND  `by` IS NOT NULL
),
per_user AS (
  SELECT user_id,
         MIN(month_ts)                              AS first_month,
         MAX(month_ts)                              AS last_month,
         COUNT(DISTINCT month_ts)                   AS active_months
  FROM   user_months
  GROUP  BY user_id
),
gap_users AS (
  SELECT user_id,
         active_months,
         TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1 AS expected_months
  FROM   per_user
  WHERE  active_months < TIMESTAMP_DIFF(last_month, first_month, MONTH) + 1  -- at least one gap
)
SELECT user_id,
       expected_months AS month_number               -- months since first activity
FROM   gap_users
ORDER  BY expected_months DESC
LIMIT 1;
```
