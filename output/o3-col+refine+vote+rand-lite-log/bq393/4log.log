```sql
--Description: We need the span (in months) between a user’s first and last activity,
--             but TIMESTAMP_DIFF does not allow MONTH on TIMESTAMP values.  Therefore:
--   • Convert each TIMESTAMP to a DATE and truncate to the first day of that month
--     with DATE_TRUNC(DATE(timestamp), MONTH).
--   • Aggregate per user (column `by`) to find the earliest and latest such month
--     as first_month and last_month, respectively, and count distinct active months.
--   • Use DATE_DIFF(last_month, first_month, MONTH) + 1 to get the inclusive
--     number of months a user could have been active (“expected_months”).
--   • Restrict rows to activity before 11-Sep-2024.
--   • Show 20 sample users.
WITH per_user AS (
  SELECT
    `by`                                                       AS user_id,
    MIN(DATE_TRUNC(DATE(`timestamp`), MONTH))                 AS first_month,
    MAX(DATE_TRUNC(DATE(`timestamp`), MONTH))                 AS last_month,
    COUNT(DISTINCT DATE_TRUNC(DATE(`timestamp`), MONTH))      AS active_months
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `timestamp` < '2024-09-11'      -- only data up to 10-Sep-2024
    AND `by` IS NOT NULL
  GROUP BY user_id
)
SELECT
  user_id,
  first_month,
  last_month,
  active_months,
  DATE_DIFF(last_month, first_month, MONTH) + 1 AS expected_months
FROM per_user
LIMIT 20;
```
