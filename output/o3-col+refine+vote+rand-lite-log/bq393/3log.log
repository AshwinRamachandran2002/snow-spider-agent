```sql
--Description: 4) For every user: first month, last month and count of active months.
WITH monthly AS (
  SELECT `by`   AS user,
         DATE_TRUNC(DATE(`timestamp`), MONTH) AS month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
  GROUP BY user, month
)
SELECT user,
       MIN(month) AS first_month,
       MAX(month) AS last_month,
       COUNT(*)   AS active_months
FROM monthly
GROUP BY user
LIMIT 20;
```

```sql
--Description: 5) Extend the previous CTE – compute total span length and how many months are missing in-between.
WITH monthly AS (
  SELECT `by` AS user,
         DATE_TRUNC(DATE(`timestamp`), MONTH) AS month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
  GROUP BY user, month
),
agg AS (
  SELECT user,
         MIN(month) AS first_month,
         MAX(month) AS last_month,
         COUNT(*)   AS active_months
  FROM monthly
  GROUP BY user
)
SELECT user,
       first_month,
       last_month,
       active_months,
       DATE_DIFF(last_month, first_month, MONTH)+1       AS span_months,
       DATE_DIFF(last_month, first_month, MONTH)+1
         - active_months                                 AS missing_months
FROM agg
HAVING missing_months > 0
LIMIT 20;
```

```sql
--Description: 6) FINAL ANSWER – user with the largest numbered month (since their first post) who has gone inactive.
WITH monthly AS (
  SELECT `by` AS user,
         DATE_TRUNC(DATE(`timestamp`), MONTH) AS month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
        AND `timestamp` <= '2024-09-10'                     -- consider data only up to this date
  GROUP BY user, month
),
agg AS (
  SELECT user,
         MIN(month) AS first_month,
         MAX(month) AS last_month,
         COUNT(*)   AS active_months
  FROM monthly
  GROUP BY user
),
calc AS (
  SELECT user,
         first_month,
         last_month,
         DATE_DIFF(last_month, first_month, MONTH)+1 AS month_number,
         DATE_DIFF(last_month, first_month, MONTH)+1 - active_months AS missing_months
  FROM agg
  -- at least one hole in their activity timeline
  WHERE DATE_DIFF(last_month, first_month, MONTH)+1 - active_months > 0
        -- nothing posted in or after September-2024 (inactive now)
        AND last_month < DATE '2024-09-01'
)
SELECT user       AS inactive_user,
       month_number
FROM calc
ORDER BY month_number DESC
LIMIT 1;
```
