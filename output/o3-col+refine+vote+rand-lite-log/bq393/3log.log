```sql
--Description: FINAL ANSWER – identify the user who has accumulated the highest
--“month number” (span length in months, counting from their first active month)
--while (a) exhibiting at least one month-long gap of inactivity inside that span,
--and (b) having no activity in or after September 2024 (i.e. they are now inactive).
--Only events up to 10-Sep-2024 are examined.
WITH monthly AS (
  -- Unique (user, month) pairs up to the cut-off date
  SELECT
    `by` AS user,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND `timestamp` <= '2024-09-10'    -- analysis cut-off
  GROUP BY user, month
),
agg AS (
  -- First and last active month and count of active months per user
  SELECT
    user,
    MIN(month) AS first_month,
    MAX(month) AS last_month,
    COUNT(*)   AS active_months
  FROM monthly
  GROUP BY user
),
calc AS (
  -- Compute span length and how many months inside the span have no activity
  SELECT
    user,
    DATE_DIFF(last_month, first_month, MONTH) + 1                 AS month_number,
    DATE_DIFF(last_month, first_month, MONTH) + 1 - active_months AS missing_months,
    last_month
  FROM agg
  WHERE DATE_DIFF(last_month, first_month, MONTH) + 1 - active_months > 0   -- had ≥1 gap
    AND last_month < DATE '2024-09-01'                                      -- inactive now
)
SELECT
  user AS inactive_user,
  month_number
FROM calc
ORDER BY month_number DESC
LIMIT 1;
```
