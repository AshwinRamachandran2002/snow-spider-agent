SELECT MIN(`timestamp`) AS min_ts ,
       MAX(`timestamp`) AS max_ts
FROM  `bigquery-public-data.hacker_news.full`
WHERE `timestamp` < '2024-09-10';
```

```sql
--Description: 3) Monthly activity counts for a well-known user (“pg”)
SELECT DATE_TRUNC(`timestamp` , MONTH) AS month ,
       COUNT(*)                    AS activity_cnt
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` = 'pg'
  AND  `timestamp` < '2024-09-10'
GROUP  BY month
ORDER  BY month
LIMIT 20;
```

```sql
--Description: 4) First activity month for each user
