       MIN(DATE_TRUNC(`timestamp`, MONTH))    AS first_month
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` IS NOT NULL
  AND  `timestamp` < '2024-09-10'
GROUP  BY user
LIMIT 20;
```

```sql
--Description: 5) Month index (1-based) of every record for user “pg”
SELECT `by`                                                    AS user ,
       DATE_TRUNC(`timestamp`, MONTH)                          AS month ,
       DATE_DIFF(DATE_TRUNC(`timestamp`, MONTH) ,
                 MIN(DATE_TRUNC(`timestamp`, MONTH)) OVER (PARTITION BY `by`) ,
                 MONTH) + 1                                    AS month_number
FROM   `bigquery-public-data.hacker_news.full`
WHERE  `by` = 'pg'
  AND  `timestamp` < '2024-09-10'
ORDER  BY month
LIMIT 20;
```

```sql
--Description: 6) Users that have at least one missing month inside their active span
SELECT user ,
       first_month ,
       last_month ,
       expected_months ,
       active_months ,
       expected_months - active_months AS missing_months
FROM (
      SELECT `by`                                           AS user ,
             MIN(DATE_TRUNC(`timestamp`, MONTH))            AS first_month ,
             MAX(DATE_TRUNC(`timestamp`, MONTH))            AS last_month ,
             COUNT(DISTINCT DATE_TRUNC(`timestamp`, MONTH)) AS active_months ,
             DATE_DIFF(MAX(DATE_TRUNC(`timestamp`, MONTH)) ,
                       MIN(DATE_TRUNC(`timestamp`, MONTH)) , MONTH) + 1 AS expected_months
      FROM   `bigquery-public-data.hacker_news.full`
      WHERE  `by` IS NOT NULL
        AND  `timestamp` < '2024-09-10'
      GROUP  BY user
) 
WHERE expected_months > active_months
LIMIT 20;
```

```sql
--Description: 7) Users that stopped posting before Sep-2024 (inactive afterwards)
SELECT user ,
       last_month
FROM (
      SELECT `by` AS user ,
             MAX(DATE_TRUNC(`timestamp`, MONTH)) AS last_month
      FROM   `bigquery-public-data.hacker_news.full`
      WHERE  `by` IS NOT NULL
        AND  `timestamp` < '2024-09-10'
      GROUP  BY user
)
WHERE last_month < DATE '2024-09-01'
LIMIT 20;
```

```sql
--Description: 8) Top-20 users (by longest span index) who have internal gaps AND became inactive
SELECT user ,
       last_month ,
       max_month_num
FROM (
      SELECT user ,
             last_month ,
             max_month_num ,
             ROW_NUMBER() OVER (ORDER BY max_month_num DESC) AS rn
      FROM (
            SELECT `by` AS user ,
                   MAX(DATE_TRUNC(`timestamp`, MONTH))                      AS last_month ,
                   DATE_DIFF(MAX(DATE_TRUNC(`timestamp`, MONTH)),
                             MIN(DATE_TRUNC(`timestamp`, MONTH)), MONTH) + 1 AS max_month_num ,
                   COUNT(DISTINCT DATE_TRUNC(`timestamp`, MONTH))           AS active_months ,
                   DATE_DIFF(MAX(DATE_TRUNC(`timestamp`, MONTH)),
                             MIN(DATE_TRUNC(`timestamp`, MONTH)), MONTH) + 1 AS expected_months
            FROM   `bigquery-public-data.hacker_news.full`
            WHERE  `by` IS NOT NULL
              AND  `timestamp` < '2024-09-10'
            GROUP  BY user
            HAVING expected_months > active_months          -- internal gap
               AND last_month       < DATE '2024-09-01'     -- became inactive
      )
)
WHERE rn <= 20;
```

