```sql
--Description: Show 20 distinct author usernames that appear in the data.  
SELECT DISTINCT
  `by`
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` IS NOT NULL
LIMIT 20;
```

```sql
--Description: List the first 20 distinct activity-months for an example user (‘pg’).  
SELECT DISTINCT
  DATE_TRUNC(DATE(timestamp), MONTH) AS activity_month
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` = 'pg'
  AND timestamp < '2024-09-10'
ORDER BY activity_month
LIMIT 20;
```

```sql
--Description: For each user, count the number of distinct activity-months (cut-off 2024-09-10).  
SELECT
  `by`        AS user,
  COUNT(DISTINCT DATE_TRUNC(DATE(timestamp), MONTH)) AS active_months
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` IS NOT NULL
  AND timestamp < '2024-09-10'
GROUP BY user
ORDER BY active_months DESC
LIMIT 20;
```

```sql
--Description: Compute first month, last month and span (in months) for every user.  
WITH months AS (
  SELECT
    `by` AS user,
    DATE_TRUNC(DATE(timestamp), MONTH) AS month_val
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND timestamp < '2024-09-10'
)
SELECT
  user,
  MIN(month_val) AS first_month,
  MAX(month_val) AS last_month,
  DATE_DIFF(MAX(month_val), MIN(month_val), MONTH) + 1 AS month_span
FROM months
GROUP BY user
ORDER BY month_span DESC
LIMIT 20;
```

```sql
--Description: Find users whose activity-span contains at least one missing month (gap).  
WITH months AS (
  SELECT
    `by` AS user,
    DATE_TRUNC(DATE(timestamp), MONTH) AS month_val
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND timestamp < '2024-09-10'
),
agg AS (
  SELECT
    user,
    COUNT(DISTINCT month_val)                              AS active_months,
    MIN(month_val)                                         AS first_month,
    MAX(month_val)                                         AS last_month,
    DATE_DIFF(MAX(month_val), MIN(month_val), MONTH) + 1   AS month_span
  FROM months
  GROUP BY user
)
SELECT *
FROM agg
WHERE active_months < month_span      -- => at least one month with no records
ORDER BY month_span DESC
LIMIT 20;
```

```sql
--Description: Show users and how many months have elapsed since their last activity (to verify inactivity).  
WITH months AS (
  SELECT
    `by` AS user,
    DATE_TRUNC(DATE(timestamp), MONTH) AS month_val
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND timestamp < '2024-09-10'
),
last AS (
  SELECT
    user,
    MAX(month_val) AS last_month
  FROM months
  GROUP BY user
)
SELECT
  user,
  DATE_DIFF(DATE('2024-09-10'), last_month, MONTH) AS months_since_last
FROM last
ORDER BY months_since_last DESC
LIMIT 20;
```

```sql
--Description: FINAL – return the user with the highest month-number (counted from first month)  
--              who (1) has at least one inactive gap inside their activity span and  
--              (2) shows no activity after their last recorded month (cut-off 2024-09-10).  
WITH base AS (  -- all activity months per user
  SELECT
    `by` AS user,
    DATE_TRUNC(DATE(timestamp), MONTH) AS month_val
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND timestamp < '2024-09-10'
),
agg AS (  -- aggregate metrics
  SELECT
    user,
    COUNT(DISTINCT month_val)                              AS active_months,
    MIN(month_val)                                         AS first_month,
    MAX(month_val)                                         AS last_month,
    DATE_DIFF(MAX(month_val), MIN(month_val), MONTH) + 1   AS month_span,
    DATE_DIFF(DATE('2024-09-10'), MAX(month_val), MONTH)   AS months_since_last
  FROM base
  GROUP BY user
),
inact_with_gap AS (        -- satisfy both “gap” and “became inactive” conditions
  SELECT
    user,
    month_span AS last_month_number
  FROM agg
  WHERE active_months < month_span        -- at least one missing month inside span
    AND months_since_last > 0             -- no activity after last_month
)
SELECT
  user,
  last_month_number AS highest_month_number
FROM inact_with_gap
ORDER BY highest_month_number DESC
LIMIT 20;
```
