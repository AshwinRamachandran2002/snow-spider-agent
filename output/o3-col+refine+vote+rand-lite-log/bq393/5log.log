```sql
--Description: 4) For a sample user, list the first 20 records with their month bucket  
SELECT
  `by`,
  `timestamp`,
  DATE_TRUNC(`timestamp`, MONTH) AS activity_month
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` = 'pg'            -- sample user
ORDER BY `timestamp`
LIMIT 20;
```

```sql
--Description: 5) For every record, compute the user’s FIRST month and a running “month_index”  
SELECT
  `by`,
  DATE_TRUNC(`timestamp`, MONTH)              AS activity_month,
  MIN(DATE_TRUNC(`timestamp`, MONTH))
      OVER (PARTITION BY `by`)               AS first_month,
  DATE_DIFF(DATE_TRUNC(`timestamp`, MONTH),
            MIN(DATE_TRUNC(`timestamp`, MONTH))
              OVER (PARTITION BY `by`),
            MONTH) + 1                       AS month_index
FROM `bigquery-public-data.hacker_news.full`
WHERE `by` IS NOT NULL
  AND `timestamp` < '2024-09-11'              -- up-to 10-Sep-2024
LIMIT 20;
```

```sql
--Description: 6) Aggregate per user: how many distinct months vs. the highest month_index  
SELECT
  `by`                                  AS user_id,
  COUNT(DISTINCT month_index)           AS active_months,
  MAX(month_index)                      AS last_month_index
FROM (
  SELECT
    `by`,
    DATE_DIFF(DATE_TRUNC(`timestamp`, MONTH),
              MIN(DATE_TRUNC(`timestamp`, MONTH))
                OVER (PARTITION BY `by`),
              MONTH) + 1                AS month_index
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
) sub
GROUP BY user_id
LIMIT 20;
```

```sql
--Description: 7) Keep only users that have a gap (some expected month missing)  
SELECT
  user_id,
  active_months,
  last_month_index
FROM (
  SELECT
    `by`                                AS user_id,
    COUNT(DISTINCT month_index)         AS active_months,
    MAX(month_index)                    AS last_month_index
  FROM (
    SELECT
      `by`,
      DATE_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                MIN(DATE_TRUNC(`timestamp`, MONTH))
                  OVER (PARTITION BY `by`),
                MONTH) + 1              AS month_index
    FROM `bigquery-public-data.hacker_news.full`
    WHERE `by` IS NOT NULL
      AND `timestamp` < '2024-09-11'
  )
  GROUP BY user_id
)
WHERE active_months < last_month_index       -- at least one missing month
LIMIT 20;
```

```sql
--Description: 8) Rank those gap-users by how long they stayed active (highest month_index first)  
SELECT
  user_id,
  last_month_index
FROM (
  SELECT
    `by`                                AS user_id,
    COUNT(DISTINCT month_index)         AS active_months,
    MAX(month_index)                    AS last_month_index
  FROM (
    SELECT
      `by`,
      DATE_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                MIN(DATE_TRUNC(`timestamp`, MONTH))
                  OVER (PARTITION BY `by`),
                MONTH) + 1              AS month_index
    FROM `bigquery-public-data.hacker_news.full`
    WHERE `by` IS NOT NULL
      AND `timestamp` < '2024-09-11'
  )
  GROUP BY user_id
  HAVING active_months < last_month_index
)
ORDER BY last_month_index DESC
LIMIT 20;
```

```sql
--Description: 9) FINAL – the single user with the largest month number who later became inactive  
SELECT
  user_id,
  last_month_index AS month_number_from_first_activity
FROM (
  SELECT
    `by`                                AS user_id,
    COUNT(DISTINCT month_index)         AS active_months,
    MAX(month_index)                    AS last_month_index,
    ROW_NUMBER() OVER (ORDER BY MAX(month_index) DESC) AS rn
  FROM (
    SELECT
      `by`,
      DATE_DIFF(DATE_TRUNC(`timestamp`, MONTH),
                MIN(DATE_TRUNC(`timestamp`, MONTH))
                  OVER (PARTITION BY `by`),
                MONTH) + 1              AS month_index
    FROM `bigquery-public-data.hacker_news.full`
    WHERE `by` IS NOT NULL
      AND (`dead`    IS NULL OR `dead`    = FALSE)
      AND (`deleted` IS NULL OR `deleted` = FALSE)
      AND `timestamp` < '2024-09-11'     -- up-to 10-Sep-2024 (exclusive)
  )
  GROUP BY user_id
  HAVING active_months < last_month_index   -- gap exists
)
WHERE rn = 1
LIMIT 20;    -- only one row is expected, still respecting the 20-row limit
```
