--Description: 
-- Return the single user with the longest uninterrupted run of active months
-- (counting from their very first active month as “1”) before they hit their first
-- month of inactivity, using all Hacker News data through 10-Sep-2024.
-- Logic:
--   1) month_log  – distinct (user, month) rows of activity.
--   2) agg        – per user: first_month, last_month, list of active months.
--   3) first_hole – earliest month between first→last that’s missing in months_active.
--                  Users without such a gap are discarded.
--   4) ranked     – convert that first gap into a 1-based month index.
--   5) final      – order by that index (desc) and keep the top row.
WITH month_log AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'          -- data up to 10-Sep-2024
),
agg AS (
  SELECT
    user_id,
    MIN(activity_month)                                        AS first_month,
    MAX(activity_month)                                        AS last_month,
    ARRAY_AGG(DISTINCT activity_month ORDER BY activity_month) AS months_active
  FROM month_log
  GROUP BY user_id
),
first_hole AS (
  SELECT
    user_id,
    (
      SELECT MIN(m)                                            -- earliest missing month
      FROM UNNEST(GENERATE_DATE_ARRAY(first_month, last_month, INTERVAL 1 MONTH)) AS m
      WHERE m NOT IN UNNEST(months_active)
    ) AS first_missing_month,
    first_month
  FROM agg
  WHERE (
      SELECT MIN(m)
      FROM UNNEST(GENERATE_DATE_ARRAY(first_month, last_month, INTERVAL 1 MONTH)) AS m
      WHERE m NOT IN UNNEST(months_active)
  ) IS NOT NULL                                   -- keep only users who have a gap
),
ranked AS (
  SELECT
    user_id,
    1 + TIMESTAMP_DIFF(first_missing_month, first_month, MONTH) AS month_number_at_inactivity
  FROM first_hole
)
SELECT
  user_id,
  month_number_at_inactivity
FROM ranked
ORDER BY month_number_at_inactivity DESC
LIMIT 1;
