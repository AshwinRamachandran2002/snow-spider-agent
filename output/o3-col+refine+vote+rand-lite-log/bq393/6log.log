--Description:
-- We must return a single row:  the user who stayed active for the greatest number of
-- months (counting consecutively from their first activity month = 1) **and then went
-- inactive**, i.e. there is at least one full calendar-month gap inside their overall
-- span of activity and no further records after their last active month (true because
-- we limit the data to 10-Sep-2024).
--
-- Strategy
-- 1. month_log  … every distinct (user, month) in which the user posted/commented.
-- 2. agg        … for each user collect: first_month, last_month, and the array of
--                 months in which they were active.
-- 3. first_hole … inside the inclusive range [first_month, last_month] find the very
--                 first month that is NOT in months_active.  If such a month exists
--                 the user “became inactive” in the immediately preceding month.
-- 4. ranked     … calculate the 1-based month index (relative to first_month) at which
--                 the first hole occurs → this is 1 + TIMESTAMP_DIFF(first_missing,
--                 first_month, MONTH).  The user’s last active month is thus index-1.
-- 5. final      … pick the user with the greatest month_number_at_inactivity (i.e.
--                 longest streak before going silent).
WITH month_log AS (
  SELECT
    `by` AS user_id,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'              -- consider data only up to 10-Sep-2024
),
agg AS (
  SELECT
    user_id,
    MIN(activity_month)                                        AS first_month,
    MAX(activity_month)                                        AS last_month,
    ARRAY_AGG(DISTINCT activity_month ORDER BY activity_month) AS months_active
  FROM month_log
  GROUP BY user_id
),
first_hole AS (
  SELECT
    user_id,
    (
      SELECT MIN(m)                                            -- earliest missing month
      FROM UNNEST(GENERATE_DATE_ARRAY(first_month, last_month, INTERVAL 1 MONTH)) AS m
      WHERE m NOT IN UNNEST(months_active)
    ) AS first_missing_month,
    first_month
  FROM agg
  WHERE (
      SELECT MIN(m)
      FROM UNNEST(GENERATE_DATE_ARRAY(first_month, last_month, INTERVAL 1 MONTH)) AS m
      WHERE m NOT IN UNNEST(months_active)
  ) IS NOT NULL                               -- keep only users who actually have a gap
),
ranked AS (
  SELECT
    user_id,
    1 + TIMESTAMP_DIFF(first_missing_month, first_month, MONTH) AS month_number_at_inactivity
  FROM first_hole
)
SELECT
  user_id,
  month_number_at_inactivity
FROM ranked
ORDER BY month_number_at_inactivity DESC
LIMIT 1;
