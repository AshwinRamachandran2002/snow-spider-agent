```sql
-- 6.  Compute the month number (counting from 1) at which the user became inactive
WITH month_log AS (
  SELECT 
    `by` AS user_id ,
    DATE_TRUNC(DATE(`timestamp`), MONTH) AS activity_month
  FROM `bigquery-public-data.hacker_news.full`
  WHERE `by` IS NOT NULL
    AND `timestamp` < '2024-09-11'
),
agg AS (
  SELECT
    user_id ,
    MIN(activity_month)                                        AS first_month ,
    MAX(activity_month)                                        AS last_month ,
    ARRAY_AGG(DISTINCT activity_month ORDER BY activity_month) AS months_active
  FROM month_log
  GROUP BY user_id
),
first_hole AS (
  SELECT
    user_id ,
    (
      SELECT MIN(m)
      FROM UNNEST(GENERATE_DATE_ARRAY(first_month, last_month, INTERVAL 1 MONTH)) AS m
      WHERE m NOT IN UNNEST(months_active)
    ) AS first_missing_month ,
    first_month
  FROM agg
  HAVING first_missing_month IS NOT NULL
)
SELECT
  user_id ,
  1 + TIMESTAMP_DIFF(first_missing_month, first_month, MONTH)  AS month_number_at_inactivity
FROM first_hole
LIMIT 20;
