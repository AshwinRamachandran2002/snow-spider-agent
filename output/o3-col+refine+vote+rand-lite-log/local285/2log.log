SELECT DISTINCT substr("whsle_date",1,4) AS "year"
FROM "veg_whsle_df"
ORDER BY "year"
LIMIT 20;
```

```sql
-- 3) Distinct vegetable category names we will report on
SELECT DISTINCT "category_name"
FROM "veg_cat"
LIMIT 20;
```

```sql
-- 4) Average wholesale price (RMB / kg) per category & year
SELECT substr(w."whsle_date",1,4) AS "year",
       c."category_name",
       ROUND(AVG(w."whsle_px_rmb-kg"),2) AS "avg_wholesale_price"
FROM "veg_whsle_df"  w
JOIN "veg_cat"       c ON w."item_code" = c."item_code"
GROUP BY "year", c."category_name"
ORDER BY "year", c."category_name"
LIMIT 20;
```

```sql
-- 5) Maximum and minimum wholesale prices per category & year
SELECT substr(w."whsle_date",1,4) AS "year",
       c."category_name",
       ROUND(MAX(w."whsle_px_rmb-kg"),2) AS "max_wholesale_price",
       ROUND(MIN(w."whsle_px_rmb-kg"),2) AS "min_wholesale_price"
FROM "veg_whsle_df"  w
JOIN "veg_cat"       c ON w."item_code" = c."item_code"
GROUP BY "year", c."category_name"
ORDER BY "year", c."category_name"
LIMIT 20;
```

```sql
-- 6) Yearly wholesale-price spread (max – min) by category
SELECT substr(w."whsle_date",1,4) AS "year",
       c."category_name",
       ROUND(MAX(w."whsle_px_rmb-kg") - MIN(w."whsle_px_rmb-kg"),2) AS "wholesale_price_diff"
FROM "veg_whsle_df"  w
JOIN "veg_cat"       c ON w."item_code" = c."item_code"
GROUP BY "year", c."category_name"
ORDER BY "year", c."category_name"
LIMIT 20;
```

```sql
-- 7) Total wholesale *cost* (RMB) = Σ(qty × wholesale price) per category & year
SELECT substr(t."txn_date",1,4) AS "year",
       c."category_name",
       ROUND(SUM(t."qty_sold(kg)" * w."whsle_px_rmb-kg"),2) AS "total_wholesale_cost"
FROM "veg_txn_df"     t
JOIN "veg_whsle_df"   w ON t."item_code" = w."item_code"
                       AND t."txn_date"  = w."whsle_date"
JOIN "veg_cat"        c ON t."item_code" = c."item_code"
GROUP BY "year", c."category_name"
ORDER BY "year", c."category_name"
LIMIT 20;
```

```sql
-- 8) Total *selling* revenue (RMB) = Σ(qty × selling price) per category & year
SELECT substr(t."txn_date",1,4) AS "year",
       c."category_name",
       ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg"),2) AS "total_selling_price"
FROM "veg_txn_df" t
JOIN "veg_cat"    c ON t."item_code" = c."item_code"
GROUP BY "year", c."category_name"
ORDER BY "year", c."category_name"
LIMIT 20;
```

```sql
-- 9) Average loss-rate (%) by category (once – does not vary by year)
SELECT c."category_name",
       ROUND(AVG(l."loss_rate_%"),2) AS "avg_loss_rate"
FROM "veg_loss_rate_df" l
JOIN "veg_cat"       c ON l."item_code" = c."item_code"
GROUP BY c."category_name"
LIMIT 20;
```

```sql
-- 10) Pulling everything together: wholesale cost, selling revenue, loss & PROFIT per category & year
WITH selling AS (
     SELECT substr(t."txn_date",1,4) AS "year",
            c."category_name",
            SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_selling_price"
     FROM "veg_txn_df" t
     JOIN "veg_cat"    c ON t."item_code" = c."item_code"
     GROUP BY "year", c."category_name"
),
wholesale AS (
     SELECT substr(t."txn_date",1,4) AS "year",
            c."category_name",
            SUM(t."qty_sold(kg)" * w."whsle_px_rmb-kg") AS "total_wholesale_cost"
     FROM "veg_txn_df"   t
     JOIN "veg_whsle_df" w ON t."item_code" = w."item_code"
                            AND t."txn_date"  = w."whsle_date"
     JOIN "veg_cat"      c ON t."item_code" = c."item_code"
     GROUP BY "year", c."category_name"
),
loss AS (
     SELECT c."category_name",
            AVG(l."loss_rate_%") AS "avg_loss_rate"
     FROM "veg_loss_rate_df" l
     JOIN "veg_cat"         c ON l."item_code" = c."item_code"
     GROUP BY c."category_name"
)
SELECT s."year",
       s."category_name",
       ROUND(s."total_selling_price",2)              AS "total_selling_price",
       ROUND(w."total_wholesale_cost",2)             AS "total_wholesale_cost",
       ROUND(l."avg_loss_rate",2)                    AS "avg_loss_rate_pct",
       ROUND(w."total_wholesale_cost"
             * l."avg_loss_rate" / 100.0, 2)         AS "total_loss",
       ROUND(s."total_selling_price"
             - w."total_wholesale_cost"
             - w."total_wholesale_cost"*l."avg_loss_rate"/100.0, 2) AS "profit"
FROM  selling   s
JOIN  wholesale w ON s."year" = w."year"
                  AND s."category_name" = w."category_name"
JOIN  loss      l ON s."category_name" = l."category_name"
ORDER BY s."year", s."category_name"
LIMIT 20;
```
