Query:
-- 10) Pulling everything together: wholesale cost, selling revenue, loss & PROFIT per category & year
WITH selling AS (
     SELECT substr(t."txn_date",1,4) AS "year",
            c."category_name",
            SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_selling_price"
     FROM "veg_txn_df" t
     JOIN "veg_cat"    c ON t."item_code" = c."item_code"
     GROUP BY "year", c."category_name"
),
wholesale AS (
     SELECT substr(t."txn_date",1,4) AS "year",
            c."category_name",
            SUM(t."qty_sold(kg)" * w."whsle_px_rmb-kg") AS "total_wholesale_cost"
     FROM "veg_txn_df"   t
     JOIN "veg_whsle_df" w ON t."item_code" = w."item_code"
                            AND t."txn_date"  = w."whsle_date"
     JOIN "veg_cat"      c ON t."item_code" = c."item_code"
     GROUP BY "year", c."category_name"
),
loss AS (
     SELECT c."category_name",
            AVG(l."loss_rate_%") AS "avg_loss_rate"
     FROM "veg_loss_rate_df" l
     JOIN "veg_cat"         c ON l."item_code" = c."item_code"
     GROUP BY c."category_name"
)
SELECT s."year",
       s."category_name",
       ROUND(s."total_selling_price",2)              AS "total_selling_price",
       ROUND(w."total_wholesale_cost",2)             AS "total_wholesale_cost",
       ROUND(l."avg_loss_rate",2)                    AS "avg_loss_rate_pct",
       ROUND(w."total_wholesale_cost"
             * l."avg_loss_rate" / 100.0, 2)         AS "total_loss",
       ROUND(s."total_selling_price"
             - w."total_wholesale_cost"
             - w."total_wholesale_cost"*l."avg_loss_rate"/100.0, 2) AS "profit"
FROM  selling   s
JOIN  wholesale w ON s."year" = w."year"
                  AND s."category_name" = w."category_name"
JOIN  loss      l ON s."category_name" = l."category_name"
ORDER BY s."year", s."category_name"
LIMIT 20;
Answer:
year,category_name,total_selling_price,total_wholesale_cost,avg_loss_rate_pct,total_loss,profit
