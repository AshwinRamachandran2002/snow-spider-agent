--Description: Aggregate wholesale-price statistics by year & category (avg / max / min / diff / total)
SELECT substr(vwd."whsle_date",1,4)                     AS "year",
       vc."category_name",
       ROUND(AVG(vwd."whsle_px_rmb-kg"), 2)              AS "avg_whsle_px",
       ROUND(MAX(vwd."whsle_px_rmb-kg"), 2)              AS "max_whsle_px",
       ROUND(MIN(vwd."whsle_px_rmb-kg"), 2)              AS "min_whsle_px",
       ROUND(MAX(vwd."whsle_px_rmb-kg") 
            - MIN(vwd."whsle_px_rmb-kg"), 2)             AS "whsle_px_diff",
       ROUND(SUM(vwd."whsle_px_rmb-kg"), 2)              AS "tot_whsle_px"
FROM   "veg_whsle_df" AS vwd
JOIN   "veg_cat"      AS vc
       ON vwd."item_code" = vc."item_code"
GROUP  BY 1,2
LIMIT 20;
