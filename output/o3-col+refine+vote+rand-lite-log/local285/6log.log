Query:
--Description: Add profit calculation (revenue – cost – loss) per year & category
SELECT base."year",
       base."category_name",
       ROUND(base."tot_whsle_cost", 2) AS "total_wholesale_cost",
       ROUND(base."tot_sell_px", 2)    AS "total_revenue",
       ROUND(base."tot_loss_px", 2)    AS "total_loss",
       ROUND(base."tot_sell_px" - base."tot_whsle_cost" - base."tot_loss_px", 2) AS "profit"
FROM (
      /* reuse the previous aggregation */
      SELECT substr(vt."txn_date",1,4)                    AS "year",
             vc."category_name",
             SUM(vt."qty_sold(kg)"*vwd."whsle_px_rmb-kg")                    AS "tot_whsle_cost",
             SUM(vt."qty_sold(kg)"*vt."unit_selling_px_rmb/kg")              AS "tot_sell_px",
             SUM(vt."qty_sold(kg)"*vwd."whsle_px_rmb-kg"*COALESCE(vl."loss_rate_%",0)/100.0) AS "tot_loss_px"
      FROM   "veg_txn_df"   AS vt
      JOIN   "veg_cat"      AS vc  ON vt."item_code" = vc."item_code"
      JOIN   "veg_whsle_df" AS vwd ON vt."item_code" = vwd."item_code"
                                     AND vt."txn_date" = vwd."whsle_date"
      LEFT JOIN "veg_loss_rate_df" AS vl ON vt."item_code" = vl."item_code"
      WHERE  vt."sale/return" = 'sale'
      GROUP BY 1,2
) AS base
LIMIT 20;
