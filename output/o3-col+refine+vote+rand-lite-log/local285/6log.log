```

```sql
--Description: Preview distinct years available in the sales-transaction data
SELECT DISTINCT substr("txn_date", 1, 4) AS "year"
FROM "veg_txn_df"
LIMIT 20;
```

```sql
--Description: Inspect the vegetable categories we have to work with
SELECT DISTINCT "category_code",
       "category_name"
FROM "veg_cat"
LIMIT 20;
```

```sql
--Description: Sample mapping between wholesale records and category names
SELECT vwd."item_code",
       vwd."whsle_date",
       vwd."whsle_px_rmb-kg",
       vc."category_name"
FROM   "veg_whsle_df" AS vwd
JOIN   "veg_cat"      AS vc
       ON vwd."item_code" = vc."item_code"
LIMIT 20;
```

```sql
--Description: Aggregate wholesale-price statistics by year & category (avg / max / min / diff / total)
SELECT substr(vwd."whsle_date",1,4)                     AS "year",
       vc."category_name",
       ROUND(AVG(vwd."whsle_px_rmb-kg"), 2)              AS "avg_whsle_px",
       ROUND(MAX(vwd."whsle_px_rmb-kg"), 2)              AS "max_whsle_px",
       ROUND(MIN(vwd."whsle_px_rmb-kg"), 2)              AS "min_whsle_px",
       ROUND(MAX(vwd."whsle_px_rmb-kg") 
            - MIN(vwd."whsle_px_rmb-kg"), 2)             AS "whsle_px_diff",
       ROUND(SUM(vwd."whsle_px_rmb-kg"), 2)              AS "tot_whsle_px"
FROM   "veg_whsle_df" AS vwd
JOIN   "veg_cat"      AS vc
       ON vwd."item_code" = vc."item_code"
GROUP  BY 1,2
LIMIT 20;
```

```sql
--Description: Calculate total selling price (qty × selling px) by year & category
SELECT substr(vt."txn_date",1,4)                               AS "year",
       vc."category_name",
       ROUND(SUM(vt."qty_sold(kg)" * vt."unit_selling_px_rmb/kg"), 2) AS "tot_sell_px"
FROM   "veg_txn_df" AS vt
JOIN   "veg_cat"    AS vc
       ON vt."item_code" = vc."item_code"
WHERE  vt."sale/return" = 'sale'
GROUP  BY 1,2
LIMIT 20;
```

```sql
--Description: Preview loss-rate percentages by category
SELECT DISTINCT vc."category_name",
       vl."loss_rate_%"
FROM   "veg_loss_rate_df" AS vl
JOIN   "veg_cat"          AS vc
       ON vl."item_code" = vc."item_code"
LIMIT 20;
```

```sql
--Description: Derive average loss rate per category
SELECT vc."category_name",
       ROUND(AVG(vl."loss_rate_%"), 2) AS "avg_loss_rate_%"
FROM   "veg_loss_rate_df" AS vl
JOIN   "veg_cat"          AS vc
       ON vl."item_code" = vc."item_code"
GROUP  BY vc."category_name"
LIMIT 20;
```

```sql
--Description: Compute total wholesale cost, total selling price & total loss by year-category
SELECT yr_cat."year",
       yr_cat."category_name",
       ROUND(SUM(yr_cat."whsle_cost"), 2)        AS "tot_whsle_cost",
       ROUND(SUM(yr_cat."sell_revenue"), 2)      AS "tot_sell_px",
       ROUND(SUM(yr_cat."loss_cost"), 2)         AS "tot_loss_px"
FROM (
     SELECT substr(vt."txn_date",1,4)                    AS "year",
            vc."category_name",
            vt."qty_sold(kg)"                           AS "qty",
            vwd."whsle_px_rmb-kg"                       AS "whsle_px",
            (vt."qty_sold(kg)"*vwd."whsle_px_rmb-kg")   AS "whsle_cost",
            (vt."qty_sold(kg)"*vt."unit_selling_px_rmb/kg") AS "sell_revenue",
            (vt."qty_sold(kg)"*vwd."whsle_px_rmb-kg"*
                COALESCE(vl."loss_rate_%",0)/100.0)      AS "loss_cost"
     FROM   "veg_txn_df"      AS vt
     JOIN   "veg_cat"         AS vc  ON vt."item_code" = vc."item_code"
     JOIN   "veg_whsle_df"    AS vwd ON vt."item_code" = vwd."item_code"
                                      AND vt."txn_date" = vwd."whsle_date"
     LEFT JOIN "veg_loss_rate_df" AS vl ON vt."item_code" = vl."item_code"
     WHERE  vt."sale/return" = 'sale'
) AS yr_cat
GROUP BY 1,2
LIMIT 20;
```

```sql
--Description: Add profit calculation (revenue – cost – loss) per year & category
SELECT base."year",
       base."category_name",
       ROUND(base."tot_whsle_cost", 2) AS "total_wholesale_cost",
       ROUND(base."tot_sell_px", 2)    AS "total_revenue",
       ROUND(base."tot_loss_px", 2)    AS "total_loss",
       ROUND(base."tot_sell_px" - base."tot_whsle_cost" - base."tot_loss_px", 2) AS "profit"
FROM (
      /* reuse the previous aggregation */
      SELECT substr(vt."txn_date",1,4)                    AS "year",
             vc."category_name",
             SUM(vt."qty_sold(kg)"*vwd."whsle_px_rmb-kg")                    AS "tot_whsle_cost",
             SUM(vt."qty_sold(kg)"*vt."unit_selling_px_rmb/kg")              AS "tot_sell_px",
             SUM(vt."qty_sold(kg)"*vwd."whsle_px_rmb-kg"*COALESCE(vl."loss_rate_%",0)/100.0) AS "tot_loss_px"
      FROM   "veg_txn_df"   AS vt
      JOIN   "veg_cat"      AS vc  ON vt."item_code" = vc."item_code"
      JOIN   "veg_whsle_df" AS vwd ON vt."item_code" = vwd."item_code"
                                     AND vt."txn_date" = vwd."whsle_date"
      LEFT JOIN "veg_loss_rate_df" AS vl ON vt."item_code" = vl."item_code"
      WHERE  vt."sale/return" = 'sale'
      GROUP BY 1,2
) AS base
LIMIT 20;
```
