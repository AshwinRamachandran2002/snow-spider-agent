                 vt."unit_selling_px_rmb/kg"),2) AS "total_selling_price"
FROM   "veg_txn_df" vt
JOIN   "veg_cat"    vc ON vt."item_code" = vc."item_code"
WHERE  vt."sale/return" = 'sale'
GROUP  BY "year", vc."category_name"
LIMIT 20;
```

```sql
--Description: 8) Yearly wholesale price statistics (avg / max / min) per category.
SELECT substr(vw."whsle_date",1,4) AS "year",
       vc."category_name",
       ROUND(AVG(vw."whsle_px_rmb-kg"),2) AS "avg_wholesale_price",
       ROUND(MAX(vw."whsle_px_rmb-kg"),2) AS "max_wholesale_price",
       ROUND(MIN(vw."whsle_px_rmb-kg"),2) AS "min_wholesale_price"
FROM   "veg_whsle_df" vw
