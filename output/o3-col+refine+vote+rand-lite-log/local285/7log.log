LIMIT 20;
```

```sql
--Description: Compute yearly wholesale price summary (avg, max, min, diff, total) per category
SELECT substr(w."whsle_date",1,4)                                          AS "year",
       c."category_name",
       ROUND(AVG(w."whsle_px_rmb-kg"), 2)                                   AS "avg_whsle_px",
       ROUND(MAX(w."whsle_px_rmb-kg"), 2)                                   AS "max_whsle_px",
       ROUND(MIN(w."whsle_px_rmb-kg"), 2)                                   AS "min_whsle_px",
       ROUND(MAX(w."whsle_px_rmb-kg") - MIN(w."whsle_px_rmb-kg"), 2)        AS "whsle_px_diff",
       ROUND(SUM(w."whsle_px_rmb-kg"), 2)                                   AS "total_whsle_px"
FROM   "veg_whsle_df" AS w
JOIN   "veg_cat"      AS c ON w."item_code" = c."item_code"
WHERE  substr(w."whsle_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", c."category_name"
LIMIT 20;
```

```sql
--Description: Calculate total selling price (qty * unit_selling_px) per category & year
SELECT substr(t."txn_date",1,4)                                       AS "year",
       c."category_name",
       ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg"), 2)   AS "total_selling_px"
FROM   "veg_txn_df"  AS t
JOIN   "veg_cat"     AS c ON t."item_code" = c."item_code"
WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", c."category_name"
LIMIT 20;
```

```sql
--Description: Preview the loss rates per item with category mapping
SELECT l."item_code",
       c."category_name",
       ROUND(l."loss_rate_%", 2) AS "loss_rate_%"
FROM   "veg_loss_rate_df" AS l
JOIN   "veg_cat"          AS c ON l."item_code" = c."item_code"
LIMIT 20;
```

```sql
--Description: Compute the average loss rate per category
SELECT c."category_name",
       ROUND(AVG(l."loss_rate_%"), 2) AS "avg_loss_rate_%"
FROM   "veg_loss_rate_df" AS l
JOIN   "veg_cat"          AS c ON l."item_code" = c."item_code"
GROUP  BY c."category_name"
LIMIT 20;
```

```sql
--Description: Calculate the total loss (qty * unit_selling_px * loss_rate) per category & year
SELECT substr(t."txn_date",1,4)                                                    AS "year",
       c."category_name",
       ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg" * l."loss_rate_%"/100), 2) AS "total_loss_value"
FROM   "veg_txn_df"       AS t
JOIN   "veg_cat"          AS c ON t."item_code" = c."item_code"
JOIN   "veg_loss_rate_df" AS l ON t."item_code" = l."item_code"
WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
GROUP  BY "year", c."category_name"
LIMIT 20;
```

```sql
--Description: Combine wholesale, selling, and loss data to compute yearly profit per category (sub-query join)
WITH whsle AS (
    SELECT substr(w."whsle_date",1,4) AS "year",
           c."category_name",
           SUM(w."whsle_px_rmb-kg")   AS "total_whsle_px"
    FROM   "veg_whsle_df" AS w
    JOIN   "veg_cat"      AS c ON w."item_code" = c."item_code"
    WHERE  substr(w."whsle_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
),
sales AS (
    SELECT substr(t."txn_date",1,4) AS "year",
           c."category_name",
           SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_selling_px"
    FROM   "veg_txn_df" AS t
    JOIN   "veg_cat"    AS c ON t."item_code" = c."item_code"
    WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
),
loss AS (
    SELECT substr(t."txn_date",1,4) AS "year",
           c."category_name",
           SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg" * l."loss_rate_%"/100) AS "total_loss_value"
    FROM   "veg_txn_df"       AS t
    JOIN   "veg_cat"          AS c ON t."item_code" = c."item_code"
    JOIN   "veg_loss_rate_df" AS l ON t."item_code" = l."item_code"
    WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
)
SELECT w."year",
       w."category_name",
       ROUND(w."total_whsle_px", 2)                        AS "total_whsle_px",
       ROUND(s."total_selling_px", 2)                      AS "total_selling_px",
       ROUND(l."total_loss_value", 2)                      AS "total_loss",
       ROUND(s."total_selling_px" - w."total_whsle_px"
             - l."total_loss_value", 2)                    AS "profit"
FROM   whsle w
LEFT  JOIN sales s ON w."year" = s."year" AND w."category_name" = s."category_name"
LEFT  JOIN loss  l ON w."year" = l."year" AND w."category_name" = l."category_name"
LIMIT 20;
```

```sql
--Description: Final all-in-one summary report for 2020-2023 showing required metrics per category & year
WITH whsle_stats AS (
    SELECT substr(w."whsle_date",1,4)                                          AS "year",
           c."category_name",
           ROUND(AVG(w."whsle_px_rmb-kg"), 2)                                   AS "avg_whsle_px",
           ROUND(MAX(w."whsle_px_rmb-kg"), 2)                                   AS "max_whsle_px",
           ROUND(MIN(w."whsle_px_rmb-kg"), 2)                                   AS "min_whsle_px",
           ROUND(MAX(w."whsle_px_rmb-kg") - MIN(w."whsle_px_rmb-kg"), 2)        AS "whsle_px_diff",
           ROUND(SUM(w."whsle_px_rmb-kg"), 2)                                   AS "total_whsle_px"
    FROM   "veg_whsle_df" AS w
    JOIN   "veg_cat"      AS c ON w."item_code" = c."item_code"
    WHERE  substr(w."whsle_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
), sales_tot AS (
    SELECT substr(t."txn_date",1,4)                                       AS "year",
           c."category_name",
           ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg"), 2)   AS "total_selling_px"
    FROM   "veg_txn_df" AS t
    JOIN   "veg_cat"    AS c ON t."item_code" = c."item_code"
    WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
), loss_tot AS (
    SELECT substr(t."txn_date",1,4) AS "year",
           c."category_name",
           ROUND(AVG(l."loss_rate_%"), 2)                                   AS "avg_loss_rate_%",
           ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg"
                 * l."loss_rate_%"/100), 2)                                 AS "total_loss"
    FROM   "veg_txn_df"       AS t
    JOIN   "veg_cat"          AS c ON t."item_code" = c."item_code"
    JOIN   "veg_loss_rate_df" AS l ON t."item_code" = l."item_code"
    WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
)
SELECT w."year",
       w."category_name",
       w."avg_whsle_px",
       w."max_whsle_px",
       w."min_whsle_px",
       w."whsle_px_diff",
       w."total_whsle_px",
       s."total_selling_px",
       l."avg_loss_rate_%",
       l."total_loss",
       ROUND(s."total_selling_px" - w."total_whsle_px" - l."total_loss", 2) AS "profit"
FROM   whsle_stats w
LEFT  JOIN sales_tot s ON w."year" = s."year" AND w."category_name" = s."category_name"
LEFT  JOIN loss_tot  l ON w."year" = l."year" AND w."category_name" = l."category_name"
LIMIT 20;
```
