Query:
--Description: Combine wholesale, selling, and loss data to compute yearly profit per category (sub-query join)
WITH whsle AS (
    SELECT substr(w."whsle_date",1,4) AS "year",
           c."category_name",
           SUM(w."whsle_px_rmb-kg")   AS "total_whsle_px"
    FROM   "veg_whsle_df" AS w
    JOIN   "veg_cat"      AS c ON w."item_code" = c."item_code"
    WHERE  substr(w."whsle_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
),
sales AS (
    SELECT substr(t."txn_date",1,4) AS "year",
           c."category_name",
           SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_selling_px"
    FROM   "veg_txn_df" AS t
    JOIN   "veg_cat"    AS c ON t."item_code" = c."item_code"
    WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
),
loss AS (
    SELECT substr(t."txn_date",1,4) AS "year",
           c."category_name",
           SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg" * l."loss_rate_%"/100) AS "total_loss_value"
    FROM   "veg_txn_df"       AS t
    JOIN   "veg_cat"          AS c ON t."item_code" = c."item_code"
    JOIN   "veg_loss_rate_df" AS l ON t."item_code" = l."item_code"
    WHERE  substr(t."txn_date",1,4) BETWEEN '2020' AND '2023'
    GROUP  BY "year", c."category_name"
)
SELECT w."year",
       w."category_name",
       ROUND(w."total_whsle_px", 2)                        AS "total_whsle_px",
       ROUND(s."total_selling_px", 2)                      AS "total_selling_px",
       ROUND(l."total_loss_value", 2)                      AS "total_loss",
       ROUND(s."total_selling_px" - w."total_whsle_px"
             - l."total_loss_value", 2)                    AS "profit"
FROM   whsle w
LEFT  JOIN sales s ON w."year" = s."year" AND w."category_name" = s."category_name"
LEFT  JOIN loss  l ON w."year" = l."year" AND w."category_name" = l."category_name"
LIMIT 20;
