       SELECT substr(t."txn_date",1,4)  AS "year",
              c."category_name",
              SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_selling_price"
       FROM   "veg_txn_df" AS t
       JOIN   "veg_cat"    AS c USING ("item_code")
       GROUP  BY "year", c."category_name"
     ) AS s  ON y."year" = s."year" AND y."category_name" = s."category_name"
LEFT JOIN (
       -- loss aggregates
       SELECT substr(v."whsle_date",1,4) AS "year",
              c."category_name",
              AVG(l."loss_rate_%")                    AS "avg_loss_rate",
              SUM(v."whsle_px_rmb-kg" * l."loss_rate_%"/100) AS "total_loss"
       FROM   "veg_whsle_df"     AS v
       JOIN   "veg_loss_rate_df" AS l  USING ("item_code")
       JOIN   "veg_cat"          AS c  USING ("item_code")
       GROUP  BY "year", c."category_name"
     ) AS l  ON y."year" = l."year" AND y."category_name" = l."category_name"
WHERE y."year" IN ('2020','2021','2022','2023')
LIMIT  20;
