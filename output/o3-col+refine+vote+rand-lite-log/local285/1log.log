```sql
--Description: Check which years are available in the wholesale data (2020-2023 expected)
SELECT DISTINCT substr("whsle_date", 1, 4)   AS "year"
FROM   "veg_whsle_df"
LIMIT  20;
```

```sql
--Description: View a few sample wholesale records together with their category names
SELECT v."whsle_date",
       v."item_code",
       v."whsle_px_rmb-kg" AS "wholesale_price",
       c."category_name"
FROM   "veg_whsle_df"  AS v
JOIN   "veg_cat"       AS c  USING ("item_code")
LIMIT  20;
```

```sql
--Description: List all unique vegetable categories that exist in the catalog
SELECT DISTINCT "category_name"
FROM   "veg_cat"
ORDER BY "category_name"
LIMIT  20;
```

```sql
--Description: Average wholesale price per year (all categories combined)  
SELECT substr("whsle_date", 1, 4)                   AS "year",
       ROUND(AVG("whsle_px_rmb-kg"), 2)             AS "avg_wholesale_price"
FROM   "veg_whsle_df"
GROUP  BY "year"
LIMIT  20;
```

```sql
--Description: Example of total selling price per item & year (qty × unit selling price)
SELECT substr(t."txn_date", 1, 4)                  AS "year",
       t."item_code",
       ROUND(SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg"), 2)  AS "total_selling_price"
FROM   "veg_txn_df" AS t
GROUP  BY "year", t."item_code"
LIMIT  20;
```

```sql
--Description: Inspect the loss-rate table and find average loss rate per item
SELECT l."item_code",
       l."item_name",
       ROUND(l."loss_rate_%", 2) AS "loss_rate_%"
FROM   "veg_loss_rate_df" AS l
LIMIT  20;
```

```sql
--Description: Combine wholesale prices with loss rate to estimate total loss per item & year  
SELECT substr(v."whsle_date", 1, 4)               AS "year",
       v."item_code",
       ROUND(AVG(v."whsle_px_rmb-kg"), 2)         AS "avg_wholesale_price",
       ROUND(l."loss_rate_%", 2)                  AS "loss_rate_%",
       ROUND(SUM(v."whsle_px_rmb-kg" * l."loss_rate_%"/100), 2) AS "total_loss_est"
FROM   "veg_whsle_df"     AS v
JOIN   "veg_loss_rate_df" AS l USING ("item_code")
GROUP  BY "year", v."item_code"
LIMIT  20;
```

```sql
--Description: Find max-min wholesale price difference by category & year
SELECT substr(v."whsle_date", 1, 4)             AS "year",
       c."category_name",
       ROUND(MAX(v."whsle_px_rmb-kg"), 2)        AS "max_wholesale_price",
       ROUND(MIN(v."whsle_px_rmb-kg"), 2)        AS "min_wholesale_price",
       ROUND(MAX(v."whsle_px_rmb-kg") - MIN(v."whsle_px_rmb-kg"), 2) AS "price_diff"
FROM   "veg_whsle_df" AS v
JOIN   "veg_cat"      AS c USING ("item_code")
GROUP  BY "year", c."category_name"
LIMIT  20;
```

```sql
--Description: Top categories by total wholesale price in 2020
SELECT c."category_name",
       ROUND(SUM(v."whsle_px_rmb-kg"), 2) AS "total_wholesale_price_2020"
FROM   "veg_whsle_df" AS v
JOIN   "veg_cat"      AS c USING ("item_code")
WHERE  substr(v."whsle_date", 1, 4) = '2020'
GROUP  BY c."category_name"
ORDER  BY "total_wholesale_price_2020" DESC
LIMIT  20;
```

```sql
--Description: Final all-in-one summary 2020-2023: wholesale, selling, loss, profit per category & year
SELECT y."year",
       y."category_name",
       ROUND(y."avg_wholesale_price", 2)       AS "avg_wholesale_price",
       ROUND(y."max_wholesale_price", 2)       AS "max_wholesale_price",
       ROUND(y."min_wholesale_price", 2)       AS "min_wholesale_price",
       ROUND(y."max_wholesale_price" - y."min_wholesale_price", 2) AS "wholesale_price_diff",
       ROUND(y."total_wholesale_price", 2)     AS "total_wholesale_price",
       ROUND(s."total_selling_price", 2)       AS "total_selling_price",
       ROUND(l."avg_loss_rate", 2)             AS "avg_loss_rate_%",
       ROUND(l."total_loss", 2)                AS "total_loss",
       ROUND(s."total_selling_price" - y."total_wholesale_price" - l."total_loss", 2) AS "profit"
FROM (
       -- wholesale aggregates
       SELECT substr(v."whsle_date",1,4) AS "year",
              c."category_name",
              AVG(v."whsle_px_rmb-kg")   AS "avg_wholesale_price",
              MAX(v."whsle_px_rmb-kg")   AS "max_wholesale_price",
              MIN(v."whsle_px_rmb-kg")   AS "min_wholesale_price",
              SUM(v."whsle_px_rmb-kg")   AS "total_wholesale_price"
       FROM   "veg_whsle_df" AS v
       JOIN   "veg_cat"      AS c USING ("item_code")
       GROUP  BY "year", c."category_name"
     ) AS y
LEFT JOIN (
       -- selling aggregates
       SELECT substr(t."txn_date",1,4)  AS "year",
              c."category_name",
              SUM(t."qty_sold(kg)" * t."unit_selling_px_rmb/kg") AS "total_selling_price"
       FROM   "veg_txn_df" AS t
       JOIN   "veg_cat"    AS c USING ("item_code")
       GROUP  BY "year", c."category_name"
     ) AS s  ON y."year" = s."year" AND y."category_name" = s."category_name"
LEFT JOIN (
       -- loss aggregates
       SELECT substr(v."whsle_date",1,4) AS "year",
              c."category_name",
              AVG(l."loss_rate_%")                    AS "avg_loss_rate",
              SUM(v."whsle_px_rmb-kg" * l."loss_rate_%"/100) AS "total_loss"
       FROM   "veg_whsle_df"     AS v
       JOIN   "veg_loss_rate_df" AS l  USING ("item_code")
       JOIN   "veg_cat"          AS c  USING ("item_code")
       GROUP  BY "year", c."category_name"
     ) AS l  ON y."year" = l."year" AND y."category_name" = l."category_name"
WHERE y."year" IN ('2020','2021','2022','2023')
LIMIT  20;
```

