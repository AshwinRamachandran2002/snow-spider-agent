```sql
--Description: Preview 20 users created between 2019-01-01 and 2022-04-30 to make sure the time-range filter works.
SELECT 
  "id",
  "first_name",
  "last_name",
  "gender",
  "age",
  "created_at"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" >= 1546300800000000      -- 2019-01-01
  AND "created_at" <  1651363200000000      -- 2022-05-01 (exclusive)
LIMIT 20;
```

```sql
--Description: Check which gender values exist in this period.
SELECT DISTINCT
  "gender"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" >= 1546300800000000
  AND "created_at" <  1651363200000000
LIMIT 20;
```

```sql
--Description: Get the overall minimum and maximum ages among users in the time window.
SELECT 
  MIN("age") AS "overall_min_age",
  MAX("age") AS "overall_max_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" >= 1546300800000000
  AND "created_at" <  1651363200000000;
```

```sql
--Description: Find the youngest (minimum) age for each gender in the period.
SELECT
  "gender",
  MIN("age") AS "youngest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" >= 1546300800000000
  AND "created_at" <  1651363200000000
GROUP BY "gender"
LIMIT 20;
```

```sql
--Description: Count how many users are at that youngest age for each gender.
SELECT
  u."gender",
  u."age"  AS "youngest_age",
  COUNT(*) AS "num_users_at_youngest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS u
JOIN (
    SELECT "gender", MIN("age") AS "youngest_age"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
    WHERE "created_at" >= 1546300800000000
      AND "created_at" <  1651363200000000
    GROUP BY "gender"
) g
  ON u."gender" = g."gender"
 AND u."age"    = g."youngest_age"
WHERE u."created_at" >= 1546300800000000
  AND u."created_at" <  1651363200000000
GROUP BY u."gender", u."age"
LIMIT 20;
```

```sql
--Description: Find the oldest (maximum) age for each gender in the period.
SELECT
  "gender",
  MAX("age") AS "oldest_age"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" >= 1546300800000000
  AND "created_at" <  1651363200000000
GROUP BY "gender"
LIMIT 20;
```

```sql
--Description: Count how many users are at that oldest age for each gender.
SELECT
  u."gender",
