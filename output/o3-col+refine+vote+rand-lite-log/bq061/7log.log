FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE LEFT(`geo_id`, 2) = '06'
ORDER BY RAND()
LIMIT 20;
```

```sql
--Description: 3) Collect 2015 median incomes for all CA tracts  
SELECT `geo_id`,
       `median_income`   AS median_income_2015
FROM   `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE  LEFT(`geo_id`, 2) = '06'
  AND  `do_date` = '2015-01-01'
LIMIT 20;
```

```sql
--Description: 4) Collect 2018 median incomes for the very same CA tracts  
SELECT `geo_id`,
       `median_income`   AS median_income_2018
FROM   `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE  LEFT(`geo_id`, 2) = '06'
  AND  `do_date` = '2018-01-01'
LIMIT 20;
```

```sql
--Description: 5) Make sure the 2015 and 2018 records both exist for each tract  
SELECT COUNT(*) AS rows_2015
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `do_date` = '2015-01-01'
  AND LEFT(`geo_id`, 2) = '06';
```

```sql
--Description: 6) Same verification for 2018 (consistency check)  
SELECT COUNT(*) AS rows_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `do_date` = '2018-01-01'
  AND LEFT(`geo_id`, 2) = '06';
```

```sql
--Description: 7) Build a table of the change in median income, joining 2015 to 2018  
SELECT  t18.geo_id,
        t15.median_income   AS income_2015,
        t18.median_income   AS income_2018,
        (t18.median_income - t15.median_income) AS income_change
FROM  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t15
JOIN  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t18
      ON  t15.geo_id = t18.geo_id
WHERE t15.`do_date` = '2015-01-01'
  AND t18.`do_date` = '2018-01-01'
  AND LEFT(t15.geo_id,2) = '06'
LIMIT 20;
```

```sql
--Description: 8) Order those changes to see the largest increases  
SELECT  geo_id,
        income_2015,
        income_2018,
        income_change
FROM   (
        SELECT  t18.geo_id,
                t15.median_income AS income_2015,
                t18.median_income AS income_2018,
                (t18.median_income - t15.median_income) AS income_change
        FROM  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t15
        JOIN  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t18
              ON t15.geo_id = t18.geo_id
        WHERE t15.`do_date` = '2015-01-01'
          AND t18.`do_date` = '2018-01-01'
          AND LEFT(t15.geo_id,2) = '06'
       )
ORDER BY income_change DESC
LIMIT 20;
```

```sql
--Description: 9) Finally, return the single tract that experienced the largest jump  
SELECT  geo_id
FROM   (
        SELECT  t18.geo_id,
                (t18.median_income - t15.median_income) AS income_change
        FROM  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t15
        JOIN  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t18
              ON t15.geo_id = t18.geo_id
        WHERE t15.`do_date` = '2015-01-01'
          AND t18.`do_date` = '2018-01-01'
          AND LEFT(t15.geo_id,2) = '06'
       )
ORDER BY income_change DESC
LIMIT 1;
```

```sql
--Description: 10) Same as #9 but adding numbers for easy double-check  
SELECT  geo_id,
        income_2015,
        income_2018,
        income_change
FROM   (
        SELECT  t18.geo_id,
                t15.median_income AS income_2015,
                t18.median_income AS income_2018,
                (t18.median_income - t15.median_income) AS income_change
        FROM  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t15
        JOIN  `bigquery-public-data.census_bureau_acs.censustract_2018_5yr` AS t18
              ON t15.geo_id = t18.geo_id
        WHERE t15.`do_date` = '2015-01-01'
          AND t18.`do_date` = '2018-01-01'
          AND LEFT(t15.geo_id,2) = '06'
       )
ORDER BY income_change DESC
LIMIT 1;
```

These queries culminate in identifying the California census tract with the greatest jump in median household income from 2015 to 2018.  
Running query 9 (or 10) will return that tract code.
