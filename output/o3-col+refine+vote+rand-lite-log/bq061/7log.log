```sql
/* Which California census tract saw the biggest median-income jump
   from the 2015 ACS 5-year release to the 2018 ACS 5-year release? */
WITH incomes AS (
  SELECT
    geo_id,
    CASE _TABLE_SUFFIX
      WHEN '2015_5yr' THEN 2015
      WHEN '2018_5yr' THEN 2018
    END AS yr,
    median_income
  FROM `bigquery-public-data.census_bureau_acs.censustract_*_5yr`
  WHERE _TABLE_SUFFIX IN ('2015_5yr','2018_5yr')
    AND LEFT(geo_id, 2) = '06'          -- California tracts
),
inc_2015 AS (
  SELECT geo_id, median_income AS income_2015
  FROM incomes
  WHERE yr = 2015
),
inc_2018 AS (
  SELECT geo_id, median_income AS income_2018
  FROM incomes
  WHERE yr = 2018
)
SELECT
  inc_2018.geo_id
FROM inc_2018
JOIN inc_2015 USING (geo_id)
WHERE inc_2015.income_2015 IS NOT NULL
  AND inc_2018.income_2018 IS NOT NULL
ORDER BY (inc_2018.income_2018 - inc_2015.income_2015) DESC
LIMIT 1;
```
