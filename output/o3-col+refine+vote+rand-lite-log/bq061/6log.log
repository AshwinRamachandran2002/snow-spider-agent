```sql
--Description: 1) See which survey “do_date” years exist in the census-tract table
SELECT DISTINCT EXTRACT(YEAR FROM `do_date`) AS yr
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
ORDER BY yr
LIMIT 20;
```

```sql
--Description: 2) Look at 20 random California census-tract GEOIDs (they all start with the state FIPS ‘06’)
SELECT DISTINCT `geo_id`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` LIKE '06%'
LIMIT 20;
```

```sql
--Description: 3) Quick check of 20 non-California tracts (different state FIPS prefixes)
SELECT DISTINCT `geo_id`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` NOT LIKE '06%'
LIMIT 20;
```

```sql
--Description: 4) Inspect 2015 median-income values for a handful of California tracts
SELECT `geo_id`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` LIKE '06%' AND `do_date` = '2015-01-01'
LIMIT 20;
```

```sql
--Description: 5) Inspect 2018 median-income values for a handful of the same California tracts
SELECT `geo_id`, `median_income`
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE `geo_id` LIKE '06%' AND `do_date` = '2018-01-01'
LIMIT 20;
```

```sql
--Description: 6) Put 2015 and 2018 side-by-side for California tracts (sample of 20 rows)
SELECT
  geo_id,
  MAX(CASE WHEN do_date = '2015-01-01' THEN median_income END) AS inc_2015,
  MAX(CASE WHEN do_date = '2018-01-01' THEN median_income END) AS inc_2018
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE geo_id LIKE '06%' AND do_date IN ('2015-01-01','2018-01-01')
GROUP BY geo_id
LIMIT 20;
```

```sql
--Description: 7) Compute the income change, order by the largest gain (top 20)
SELECT
  geo_id,
  MAX(CASE WHEN do_date = '2015-01-01' THEN median_income END) AS inc_2015,
  MAX(CASE WHEN do_date = '2018-01-01' THEN median_income END) AS inc_2018,
  MAX(CASE WHEN do_date = '2018-01-01' THEN median_income END)
  - MAX(CASE WHEN do_date = '2015-01-01' THEN median_income END) AS income_change
FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
WHERE geo_id LIKE '06%' AND do_date IN ('2015-01-01','2018-01-01')
GROUP BY geo_id
ORDER BY income_change DESC
LIMIT 20;
```

```sql
--Description: 8) FINAL ANSWER – the California census tract with the single largest 2015→2018 median-income increase
SELECT
  geo_id   AS tract_code
FROM (
  SELECT
    geo_id,
    MAX(CASE WHEN do_date = '2015-01-01' THEN median_income END) AS inc_2015,
    MAX(CASE WHEN do_date = '2018-01-01' THEN median_income END) AS inc_2018,
    MAX(CASE WHEN do_date = '2018-01-01' THEN median_income END)
    - MAX(CASE WHEN do_date = '2015-01-01' THEN median_income END) AS income_change
  FROM `bigquery-public-data.census_bureau_acs.censustract_2018_5yr`
  WHERE geo_id LIKE '06%' AND do_date IN ('2015-01-01','2018-01-01')
  GROUP BY geo_id
)
ORDER BY income_change DESC
LIMIT 1;
```

The `tract_code` returned by the last query is the California census tract that experienced the greatest rise in median income between 2015 and 2018.
