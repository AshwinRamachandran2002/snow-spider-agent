```sql
--Description / Thinking process:
-- Goal: obtain the GitHub SOURCE_REPO URL of the NPM package whose *latest released*
--       version has the greatest number of dependencies (ignoring package names that
--       contain “@”).  We do everything in one query using CTEs.
--
-- Steps:
-- 1) latest_release : for every NPM package (without “@”) keep only its most-recent
--    released version   (VersionInfo.IsRelease = TRUE, highest Ordinal → newest).
-- 2) deps_counted   : left-join to DEPENDENCIES and count how many dependencies the
--    kept version has.
-- 3) top_pkg        : pick the single package/version pair with the MAX dependency
--    count.
-- 4) Final SELECT   : from PACKAGEVERSIONS, flatten Links and emit the SOURCE_REPO
--    whose URL includes “github.com”.
WITH latest_release AS (            /* step-1 */
    SELECT
        p."Name",
        p."Version",
        p."VersionInfo":"Ordinal"::NUMBER AS "Ordinal",
        p."SnapshotAt"
    FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
    WHERE p."System" = 'NPM'
      AND p."Name"   NOT ILIKE '%@%'
      AND p."VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (
              PARTITION BY p."Name"
              ORDER BY p."VersionInfo":"Ordinal"::NUMBER DESC,
                       p."SnapshotAt"              DESC) = 1
),
deps_counted AS (                   /* step-2 */
    SELECT
        lr."Name",
        lr."Version",
        COUNT(d."Dependency") AS "DepsCount"
    FROM latest_release lr
    LEFT JOIN DEPS_DEV_V1.DEPS_DEV_V1."DEPENDENCIES" d
           ON  d."System"  = 'NPM'
           AND d."Name"    = lr."Name"
           AND d."Version" = lr."Version"
    GROUP BY lr."Name", lr."Version"
),
top_pkg AS (                        /* step-3 */
    SELECT "Name", "Version"
    FROM deps_counted
    ORDER BY "DepsCount" DESC
    LIMIT 1
)
SELECT                                /* step-4 */
    tp."Name",
    tp."Version",
    l.value:"URL"::STRING AS "GitHub_SourceRepo_URL"
FROM top_pkg tp
JOIN DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
  ON p."Name"    = tp."Name"
 AND p."Version" = tp."Version"
,  LATERAL FLATTEN(input => p."Links") l
WHERE l.value:"Label"::STRING = 'SOURCE_REPO'
  AND l.value:"URL"::STRING   ILIKE '%github.com%'
LIMIT 20;
```
