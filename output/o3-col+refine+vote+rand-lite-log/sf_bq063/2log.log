```sql
--Description: 2) Inspect fields inside VersionInfo (IsRelease & Ordinal) for some of those rows
SELECT 
  "Name",
  "Version",
  "VersionInfo":"IsRelease"::BOOLEAN  AS "IsRelease",
  "VersionInfo":"Ordinal"::NUMBER     AS "Ordinal",
  "SnapshotAt"
FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS"
WHERE "System" = 'NPM'
  AND "Name" NOT ILIKE '%@%'
LIMIT 20;
```

```sql
--Description: 3) Show how many dependency rows each specific package version has (example set)
SELECT 
  p."Name",
  p."Version",
  COUNT(d."Dependency") AS "DepsCount"
FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS"   p
LEFT JOIN DEPS_DEV_V1.DEPS_DEV_V1."DEPENDENCIES" d
  ON  d."System"  = p."System"
  AND d."Name"    = p."Name"
  AND d."Version" = p."Version"
WHERE p."System" = 'NPM'
  AND p."Name" NOT ILIKE '%@%'
GROUP BY p."Name", p."Version"
LIMIT 20;
```

```sql
--Description: 4) Restrict to *released* versions only (IsRelease = TRUE) and count dependencies
SELECT 
  p."Name",
  p."Version",
  p."VersionInfo":"Ordinal"::NUMBER AS "Ordinal",
  COUNT(d."Dependency")            AS "DepsCount"
FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
LEFT JOIN DEPS_DEV_V1.DEPS_DEV_V1."DEPENDENCIES" d
  ON  d."System"  = p."System"
  AND d."Name"    = p."Name"
  AND d."Version" = p."Version"
WHERE p."System" = 'NPM'
  AND p."Name" NOT ILIKE '%@%'
  AND p."VersionInfo":"IsRelease"::BOOLEAN = TRUE
GROUP BY p."Name", p."Version", p."VersionInfo":"Ordinal"
LIMIT 20;
```

```sql
--Description: 5) For every package, keep only its *latest* released version (greatest Ordinal, then SnapshotAt)
SELECT *
FROM (
  SELECT
      p."Name",
      p."Version",
      p."VersionInfo":"Ordinal"::NUMBER AS "Ordinal",
      p."SnapshotAt",
      ROW_NUMBER() OVER (
          PARTITION BY p."Name"
          ORDER BY p."VersionInfo":"Ordinal"::NUMBER DESC, p."SnapshotAt" DESC
      ) AS rn
  FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
  WHERE p."System" = 'NPM'
    AND p."Name" NOT ILIKE '%@%'
    AND p."VersionInfo":"IsRelease"::BOOLEAN = TRUE
) t
WHERE rn = 1
LIMIT 20;
```

```sql
--Description: 6) Join latest-release rows with DEPENDENCIES and compute dependency counts
SELECT 
  lr."Name",
  lr."Version",
  COUNT(d."Dependency") AS "DepsCount"
FROM (
  SELECT
      p."Name",
      p."Version",
      p."VersionInfo":"Ordinal"::NUMBER AS "Ordinal",
      p."SnapshotAt"
  FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
  WHERE p."System" = 'NPM'
    AND p."Name" NOT ILIKE '%@%'
    AND p."VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY p."Name"
        ORDER BY p."VersionInfo":"Ordinal"::NUMBER DESC, p."SnapshotAt" DESC
    ) = 1
) lr
LEFT JOIN DEPS_DEV_V1.DEPS_DEV_V1."DEPENDENCIES" d
  ON  d."System"  = 'NPM'
  AND d."Name"    = lr."Name"
  AND d."Version" = lr."Version"
GROUP BY lr."Name", lr."Version"
LIMIT 20;
```

```sql
--Description: 7) Retrieve the package (latest release) with the *maximum* number of dependencies
SELECT 
  lr."Name",
  lr."Version",
  COUNT(d."Dependency") AS "DepsCount"
FROM (
  SELECT
      p."Name",
      p."Version",
      p."VersionInfo":"Ordinal"::NUMBER AS "Ordinal",
      p."SnapshotAt"
  FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
  WHERE p."System" = 'NPM'
    AND p."Name" NOT ILIKE '%@%'
    AND p."VersionInfo":"IsRelease"::BOOLEAN = TRUE
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY p."Name"
        ORDER BY p."VersionInfo":"Ordinal"::NUMBER DESC, p."SnapshotAt" DESC
    ) = 1
) lr
LEFT JOIN DEPS_DEV_V1.DEPS_DEV_V1."DEPENDENCIES" d
  ON  d."System"  = 'NPM'
  AND d."Name"    = lr."Name"
  AND d."Version" = lr."Version"
GROUP BY lr."Name", lr."Version"
ORDER BY "DepsCount" DESC
LIMIT 20;
```

```sql
--Description: 8) Show raw Links JSON for the top (highest-dependency) package/version identified above
SELECT 
  p."Name",
  p."Version",
  p."Links"
FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p
WHERE p."System" = 'NPM'
  AND p."Name" = '<replace_with_top_name>'
  AND p."Version" = '<replace_with_top_version>'
LIMIT 20;
```

```sql
--Description: 9) Flatten Links array to extract only those with label = 'SOURCE_REPO'
SELECT 
  p."Name",
  p."Version",
  l.value:"Label"::STRING AS "Label",
  l.value:"URL"::STRING   AS "URL"
FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p,
     LATERAL FLATTEN(input => p."Links") l
WHERE p."System" = 'NPM'
  AND p."Name" = '<replace_with_top_name>'
  AND p."Version" = '<replace_with_top_version>'
  AND l.value:"Label"::STRING = 'SOURCE_REPO'
LIMIT 20;
```

```sql
--Description: 10) Finally, filter SOURCE_REPO URLs that contain 'github.com'
SELECT 
  l.value:"URL"::STRING AS "GitHub_SourceRepo_URL"
FROM DEPS_DEV_V1.DEPS_DEV_V1."PACKAGEVERSIONS" p,
     LATERAL FLATTEN(input => p."Links") l
WHERE p."System" = 'NPM'
  AND p."Name" = '<replace_with_top_name>'
  AND p."Version" = '<replace_with_top_version>'
  AND l.value:"Label"::STRING = 'SOURCE_REPO'
  AND l.value:"URL"::STRING ILIKE '%github.com%'
LIMIT 20;
```
