--Description: Locate all un-scoped NPM package-versions that have at least one GitHub URL
--             in their Links array, count each version’s dependencies, and list the 20
--             versions with the highest dependency counts (also showing one GitHub URL).
WITH versions_with_github AS (               -- step 1: keep only versions whose Links include github.com
    SELECT
        p."Name",
        p."Version"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p,
         LATERAL FLATTEN(input => PARSE_JSON(p."Links")) f
    WHERE p."System" = 'NPM'
      AND p."Name"   NOT LIKE '%@%'          -- exclude scoped packages
      AND f.value:"URL"::STRING ILIKE '%github.com%'
    GROUP BY p."Name", p."Version"
)
SELECT
    v."Name",
    v."Version",
    COUNT(d."Dependency")        AS "DepsCount",
    MIN(f.value:"URL"::STRING)   AS "GitHubURL"   -- show one representative GitHub link
FROM versions_with_github v
LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
       ON d."System"  = 'NPM'
      AND d."Name"    = v."Name"
      AND d."Version" = v."Version"
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p   -- re-attach Links to pull URL for display
  ON p."System"  = 'NPM'
 AND p."Name"    = v."Name"
 AND p."Version" = v."Version",
     LATERAL FLATTEN(input => PARSE_JSON(p."Links")) f
WHERE f.value:"URL"::STRING ILIKE '%github.com%'
GROUP BY v."Name", v."Version"
ORDER BY "DepsCount" DESC
LIMIT 20;
