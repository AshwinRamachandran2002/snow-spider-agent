Query:
--Description: 6) Isolate the single package-version that has the *maximum* dependency count
WITH latest AS (
  SELECT
    p."Name",
    p."Version",
    p."SnapshotAt",
    ROW_NUMBER() OVER (PARTITION BY p."Name" ORDER BY p."SnapshotAt" DESC) AS rn
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
  WHERE p."System" = 'NPM'
    AND p."Name" NOT LIKE '%@%'
    AND PARSE_JSON(p."VersionInfo"):"IsRelease"::BOOLEAN = TRUE
),
deps AS (
  SELECT
    l."Name",
    l."Version",
    COUNT(d."Dependency") AS "DepsCount"
  FROM latest l
  LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
         ON d."System"  = 'NPM'
        AND d."Name"    = l."Name"
        AND d."Version" = l."Version"
  WHERE l.rn = 1
