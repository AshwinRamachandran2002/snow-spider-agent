```sql
-- Description: 9) Verify the URL(s) deduplicated (if multiple) for the winning package-version
WITH result AS (
  /* reuse CTEs from query #8 */
  WITH latest AS (
    SELECT p."Name", p."Version", p."SnapshotAt",
           ROW_NUMBER() OVER (PARTITION BY p."Name" ORDER BY p."SnapshotAt" DESC) AS rn
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
    WHERE p."System" = 'NPM'
      AND p."Name" NOT LIKE '%@%'
      AND PARSE_JSON(p."VersionInfo"):"IsRelease"::BOOLEAN = TRUE ),
  deps AS (
    SELECT l."Name", l."Version",
           COUNT(d."Dependency") AS "DepsCount"
    FROM latest l
    LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
           ON d."System"='NPM' AND d."Name"=l."Name" AND d."Version"=l."Version"
    WHERE l.rn=1
    GROUP BY l."Name", l."Version"),
  max_pkg AS ( SELECT * FROM deps ORDER BY "DepsCount" DESC LIMIT 1 )
  SELECT 
    DISTINCT f.value:"URL"::STRING AS "GitHubURL"
  FROM max_pkg mp
  JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
    ON p."System"='NPM' AND p."Name"=mp."Name" AND p."Version"=mp."Version",
  LATERAL FLATTEN(input => PARSE_JSON(p."Links")) f
  WHERE f.value:"Label"::STRING='SOURCE_REPO'
    AND f.value:"URL"::STRING ILIKE '%github.com%'
)
SELECT DISTINCT * FROM result
LIMIT 20;
```

