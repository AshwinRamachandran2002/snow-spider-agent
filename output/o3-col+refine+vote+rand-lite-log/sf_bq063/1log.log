Query:
-- Description: 2) Parse VersionInfo and keep only *released* versions (IsRelease = true)
SELECT 
  "Name",
  "Version",
  PARSE_JSON("VersionInfo"):"IsRelease"::BOOLEAN           AS "IsRelease",
  PARSE_JSON("VersionInfo"):"Ordinal"                      AS "Ordinal",
  "SnapshotAt"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
WHERE "System" = 'NPM'
  AND "Name" NOT LIKE '%@%'
  AND PARSE_JSON("VersionInfo"):"IsRelease"::BOOLEAN = TRUE
LIMIT 20;
