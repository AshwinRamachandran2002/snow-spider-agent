Query:
--Description: 4) Count dependencies for every released package-version (excluding “@”-scoped packages)
SELECT
  p."Name",
  p."Version",
  COUNT(d."Dependency") AS "DepsCount"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
       ON d."System"  = 'NPM'
      AND d."Name"    = p."Name"
      AND d."Version" = p."Version"
WHERE p."System" = 'NPM'
  AND p."Name" NOT LIKE '%@%'
  AND PARSE_JSON(p."VersionInfo"):"IsRelease"::BOOLEAN = TRUE
GROUP BY p."Name", p."Version"
ORDER BY "DepsCount" DESC
LIMIT 20
