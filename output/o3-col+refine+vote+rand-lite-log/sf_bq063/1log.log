```sql
-- Description: 4) Count dependencies for every released package-version (no “@” packages)
SELECT 
  p."Name",
  p."Version",
  COUNT(d."Dependency") AS "DepsCount"
FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
       ON  d."System"  = 'NPM'
       AND d."Name"    = p."Name"
       AND d."Version" = p."Version"
WHERE p."System" = 'NPM'
  AND p."Name" NOT LIKE '%@%'
  AND PARSE_JSON(p."VersionInfo"):"IsRelease"::BOOLEAN = TRUE
GROUP BY p."Name", p."Version"
ORDER BY "DepsCount" DESC
LIMIT 20;
```

```sql
-- Description: 5) For each package keep only its *latest released* version (greatest SnapshotAt) and compute dependency count
WITH latest AS (
  SELECT
    p."Name",
    p."Version",
    p."SnapshotAt",
    ROW_NUMBER() OVER (PARTITION BY p."Name" ORDER BY p."SnapshotAt" DESC) AS rn
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
  WHERE p."System" = 'NPM'
    AND p."Name" NOT LIKE '%@%'
    AND PARSE_JSON(p."VersionInfo"):"IsRelease"::BOOLEAN = TRUE
)
SELECT 
  l."Name",
  l."Version",
  COUNT(d."Dependency") AS "DepsCount"
FROM latest l
LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
       ON d."System"  = 'NPM'
      AND d."Name"    = l."Name"
      AND d."Version" = l."Version"
WHERE l.rn = 1
GROUP BY l."Name", l."Version"
ORDER BY "DepsCount" DESC
LIMIT 20;
```

```sql
-- Description: 6) Isolate the single package-version that has the *maximum* dependency count
WITH latest AS (
  SELECT
    p."Name",
    p."Version",
    p."SnapshotAt",
    ROW_NUMBER() OVER (PARTITION BY p."Name" ORDER BY p."SnapshotAt" DESC) AS rn
  FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
  WHERE p."System" = 'NPM'
    AND p."Name" NOT LIKE '%@%'
    AND PARSE_JSON(p."VersionInfo"):"IsRelease"::BOOLEAN = TRUE
),
deps AS (
  SELECT 
    l."Name",
    l."Version",
    COUNT(d."Dependency") AS "DepsCount"
  FROM latest l
  LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
         ON d."System"  = 'NPM'
        AND d."Name"    = l."Name"
        AND d."Version" = l."Version"
  WHERE l.rn = 1
  GROUP BY l."Name", l."Version"
)
SELECT *
FROM deps
ORDER BY "DepsCount" DESC
LIMIT 20;
```

