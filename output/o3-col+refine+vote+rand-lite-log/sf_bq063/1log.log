Query:
--Description: 9) Deduplicate GitHub URLs for the un-scoped NPM package-version whose Links array
--             contains at least one GitHub URL and which has the highest dependency count.
WITH versions_with_github AS (        -- All un-scoped versions that reference GitHub
    SELECT
        p."Name",
        p."Version"
    FROM "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p,
         LATERAL FLATTEN(input => PARSE_JSON(p."Links")) f
    WHERE p."System" = 'NPM'
      AND p."Name"   NOT LIKE '%@%'
      AND f.value:"URL"::STRING ILIKE '%github.com%'
    GROUP BY p."Name", p."Version"
),
deps_cnt AS (                         -- Dependency counts for those versions
    SELECT
        v."Name",
        v."Version",
        COUNT(d."Dependency") AS "DepsCount"
    FROM versions_with_github v
    LEFT JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
           ON d."System"  = 'NPM'
          AND d."Name"    = v."Name"
          AND d."Version" = v."Version"
    GROUP BY v."Name", v."Version"
),
max_pkg AS (                          -- Version with the largest dependency count
    SELECT *
    FROM deps_cnt
    ORDER BY "DepsCount" DESC
    LIMIT 1
)
SELECT DISTINCT                       -- Deduplicated GitHub URLs
    f.value:"URL"::STRING AS "GitHubURL"
FROM max_pkg mp
JOIN "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
  ON p."System"  = 'NPM'
 AND p."Name"    = mp."Name"
 AND p."Version" = mp."Version",
     LATERAL FLATTEN(input => PARSE_JSON(p."Links")) f
WHERE f.value:"URL"::STRING ILIKE '%github.com%'
