Query:
--Description: Count how many dependency rows each (Name,Version) pair has.
-- Show the packages with the most dependencies (all NPM, no “@” in the name).
SELECT  
    d."Name",
    d."Version",
    COUNT(*) AS "DepCount"
FROM    "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
WHERE   d."System" = 'NPM'
  AND   d."Name"  NOT ILIKE '%@%'
GROUP BY d."Name", d."Version"
ORDER BY "DepCount" DESC
LIMIT  20;
