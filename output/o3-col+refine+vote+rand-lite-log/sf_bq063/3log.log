Query:
--Description: 2️⃣ Revised end-to-end query.
--  • Find the package whose latest released version has the highest dependency
--    count (excluding names containing “@”).
--  • Then search ACROSS **ALL** VERSIONS of that package for link objects
--    labelled `SOURCE_REPO` whose URLs include `github.com`.
--    (Version is no longer constrained because the latest release may lack
--     link metadata.)
WITH latest_release AS (                -- latest released version per package
    SELECT
        "Name",
        MAX("VersionInfo":"Ordinal"::NUMBER) AS "LatestOrdinal"
    FROM   "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE  "System" = 'NPM'
      AND  "Name"   NOT ILIKE '%@%'
      AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    GROUP BY "Name"
), dep_counts AS (                      -- dependency count for each package’s latest release
    SELECT
        d."Name",
        d."Version",
        COUNT(*) AS "DepCount"
    FROM   latest_release lr
    JOIN   "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
           ON  p."Name"  = lr."Name"
          AND p."VersionInfo":"Ordinal"::NUMBER = lr."LatestOrdinal"
    JOIN   "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES" d
           ON  d."Name"    = p."Name"
