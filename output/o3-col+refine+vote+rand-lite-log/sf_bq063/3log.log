```sql
--Description: Filter those flattened links to keep only SOURCE_REPO entries whose URL
-- contains “github.com”.
SELECT  
    p."Name",
    p."Version",
    f.value:"URL"::STRING AS "GitHub_SourceRepo_URL"
FROM   "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p,
       LATERAL FLATTEN(input => p."Links") f
WHERE  p."System" = 'NPM'
  AND  p."Name"   = '<REPLACE_WITH_TOP_NAME>'
  AND  p."Version"= '<REPLACE_WITH_TOP_VERSION>'
  AND  f.value:"Label"::STRING = 'SOURCE_REPO'
  AND  f.value:"URL"::STRING ILIKE '%github.com%'
LIMIT 20;
```

```sql
--Description: All-in-one query that returns the GitHub SOURCE_REPO URL for the package
-- whose latest released version has the most dependencies, excluding “@” names.
WITH latest_release AS (
    SELECT 
        "Name",
        MAX("VersionInfo":"Ordinal"::NUMBER) AS "LatestOrdinal"
    FROM   "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS"
    WHERE  "System" = 'NPM'
      AND  "Name"  NOT ILIKE '%@%'
      AND  "VersionInfo":"IsRelease"::BOOLEAN = TRUE
    GROUP BY "Name"
), dep_counts AS (
    SELECT  
        d."Name",
        d."Version",
        COUNT(*) AS "DepCount"
    FROM  latest_release lr
    JOIN  "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
          ON p."Name"  = lr."Name"
         AND p."VersionInfo":"Ordinal"::NUMBER = lr."LatestOrdinal"
    JOIN  "DEPS_DEV_V1"."DEPS_DEV_V1"."DEPENDENCIES"    d
          ON d."Name"    = p."Name"
         AND d."Version" = p."Version"
         AND d."System"  = 'NPM'
    WHERE p."System" = 'NPM'
    GROUP BY d."Name", d."Version"
), top_pkg AS (
    SELECT "Name", "Version"
    FROM   dep_counts
    ORDER BY "DepCount" DESC
    LIMIT  1
)
SELECT  
    p."Name",
    p."Version",
    f.value:"URL"::STRING AS "GitHub_SourceRepo_URL"
FROM   "DEPS_DEV_V1"."DEPS_DEV_V1"."PACKAGEVERSIONS" p
JOIN   top_pkg t
  ON   t."Name"    = p."Name"
 AND   t."Version" = p."Version",
     LATERAL FLATTEN(input => p."Links") f
WHERE  f.value:"Label"::STRING = 'SOURCE_REPO'
  AND  f.value:"URL"::STRING ILIKE '%github.com%'
LIMIT 20;
```

