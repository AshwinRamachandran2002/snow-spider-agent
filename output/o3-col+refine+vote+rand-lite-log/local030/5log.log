```

```sql
--Description: Check what a “delivered” order looks like together with its customer’s city
SELECT o.order_id,
       c.customer_city,
       o.order_status,
       o.order_purchase_timestamp
FROM   olist_orders  AS o
JOIN   olist_customers AS c
       ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
LIMIT 20;
```

```sql
--Description: See the different kinds of payment methods that exist
SELECT DISTINCT payment_type
FROM   olist_order_payments
LIMIT 20;
```

```sql
--Description: Inspect how much money (sum of payments) each order actually represents
SELECT order_id,
       SUM(payment_value) AS total_payment_per_order
FROM   olist_order_payments
GROUP  BY order_id
LIMIT 20;
```

```sql
--Description: For delivered orders only, calculate the total payment coming from each city
SELECT c.customer_city,
       SUM(p.payment_value) AS total_payment_city
FROM   olist_orders  AS o
JOIN   olist_order_payments AS p ON p.order_id = o.order_id
JOIN   olist_customers       AS c ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
GROUP  BY c.customer_city
LIMIT 20;
```

```sql
--Description: For the same delivered-order subset, count how many delivered orders each city had
SELECT c.customer_city,
       COUNT(DISTINCT o.order_id) AS delivered_orders_city
FROM   olist_orders  AS o
JOIN   olist_customers AS c ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
GROUP  BY c.customer_city
LIMIT 20;
```

```sql
--Description: Combine the two metrics (total payments & delivered-order count) per city
SELECT c.customer_city,
       SUM(p.payment_value)                AS total_payment_city,
       COUNT(DISTINCT o.order_id)          AS delivered_orders_city
FROM   olist_orders  AS o
JOIN   olist_order_payments AS p ON p.order_id = o.order_id
JOIN   olist_customers       AS c ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
GROUP  BY c.customer_city
LIMIT 20;
```

```sql
--Description: Sort all cities by their total payment (ascending) and keep the five lowest
SELECT c.customer_city,
       SUM(p.payment_value)               AS total_payment_city,
       COUNT(DISTINCT o.order_id)         AS delivered_orders_city
FROM   olist_orders  AS o
JOIN   olist_order_payments AS p ON p.order_id = o.order_id
JOIN   olist_customers       AS c ON c.customer_id = o.customer_id
WHERE  o.order_status = 'delivered'
GROUP  BY c.customer_city
ORDER  BY total_payment_city ASC
LIMIT 5;
```

```sql
--Description: From those five lowest-payment cities, compute (1) the average total payment
--             and (2) the average delivered-order count
WITH city_stats AS (
    SELECT c.customer_city,
           SUM(p.payment_value)               AS total_payment_city,
           COUNT(DISTINCT o.order_id)         AS delivered_orders_city
    FROM   olist_orders  AS o
    JOIN   olist_order_payments AS p ON p.order_id = o.order_id
    JOIN   olist_customers       AS c ON c.customer_id = o.customer_id
    WHERE  o.order_status = 'delivered'
    GROUP  BY c.customer_city
    ORDER  BY total_payment_city ASC
    LIMIT 5
)
SELECT AVG(total_payment_city)       AS avg_of_total_payments,
       AVG(delivered_orders_city)    AS avg_of_delivered_order_counts
FROM   city_stats;
```

