Query:
--Description: From those five lowest-payment cities, compute (1) the average total payment
--             and (2) the average delivered-order count
WITH city_stats AS (
    SELECT c.customer_city,
           SUM(p.payment_value)               AS total_payment_city,
           COUNT(DISTINCT o.order_id)         AS delivered_orders_city
    FROM   olist_orders  AS o
    JOIN   olist_order_payments AS p ON p.order_id = o.order_id
    JOIN   olist_customers       AS c ON c.customer_id = o.customer_id
    WHERE  o.order_status = 'delivered'
    GROUP  BY c.customer_city
    ORDER  BY total_payment_city ASC
    LIMIT 5
)
SELECT AVG(total_payment_city)       AS avg_of_total_payments,
       AVG(delivered_orders_city)    AS avg_of_delivered_order_counts
FROM   city_stats;
Answer:
avg_of_total_payments,avg_of_delivered_order_counts
22.404000000000003,1.0
