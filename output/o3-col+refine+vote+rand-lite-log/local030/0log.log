```sql
--Description: Preview the payments registered for some orders.
SELECT DISTINCT order_id,
       payment_value
FROM olist_order_payments
LIMIT 20;
```

```sql
--Description: Combine delivered orders with their payments (one line per payment record).
SELECT DISTINCT o.order_id,
       c.customer_city,
       p.payment_value
FROM olist_orders AS o
JOIN olist_customers AS c
  ON o.customer_id = c.customer_id
JOIN olist_order_payments AS p
  ON o.order_id = p.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;
```

```sql
--Description: Aggregate the payments for each delivered order.
SELECT DISTINCT op.order_id,
       SUM(op.payment_value) AS order_payment
FROM olist_order_payments AS op
GROUP BY op.order_id
LIMIT 20;
```

```sql
--Description: Sum all delivered–order payments per customer city.
SELECT DISTINCT c.customer_city,
       SUM(pp.order_payment) AS total_payments
FROM (
        SELECT o.order_id,
               c.customer_city
        FROM olist_orders AS o
        JOIN olist_customers AS c
          ON o.customer_id = c.customer_id
        WHERE o.order_status = 'delivered'
     ) AS c
JOIN (
        SELECT order_id,
               SUM(payment_value) AS order_payment
        FROM olist_order_payments
        GROUP BY order_id
     ) AS pp
  ON c.order_id = pp.order_id
GROUP BY c.customer_city
ORDER BY total_payments
LIMIT 20;
```

```sql
--Description: Retrieve the five cities whose summed payments are the very lowest.
SELECT DISTINCT city,
       total_payments
FROM (
        SELECT c.customer_city  AS city,
               SUM(pp.order_payment) AS total_payments
        FROM (
                SELECT o.order_id,
                       c.customer_city
                FROM olist_orders AS o
                JOIN olist_customers AS c
                  ON o.customer_id = c.customer_id
                WHERE o.order_status = 'delivered'
             ) AS c
        JOIN (
                SELECT order_id,
                       SUM(payment_value) AS order_payment
                FROM olist_order_payments
                GROUP BY order_id
             ) AS pp
          ON c.order_id = pp.order_id
        GROUP BY c.customer_city
        ORDER BY total_payments ASC
        LIMIT 5
     )
LIMIT 20;
```

```sql
--Description: For those five lowest–payment cities, collect both the summed payments and the counts of delivered orders.
WITH delivered AS (
    SELECT o.order_id,
           c.customer_city AS city
    FROM olist_orders AS o
    JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
),
payments_per_order AS (
    SELECT order_id,
           SUM(payment_value) AS order_payment
    FROM olist_order_payments
    GROUP BY order_id
),
city_totals AS (
    SELECT d.city,
           SUM(p.order_payment) AS total_payments,
           COUNT(*)             AS delivered_orders
    FROM delivered AS d
    JOIN payments_per_order AS p
      ON d.order_id = p.order_id
    GROUP BY d.city
),
bottom_five AS (
    SELECT city,
           total_payments,
           delivered_orders
    FROM city_totals
    ORDER BY total_payments ASC
    LIMIT 5
)
SELECT DISTINCT *
FROM bottom_five
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – average of total payments and average number of delivered orders across the five lowest-payment cities.
WITH delivered AS (
    SELECT o.order_id,
           c.customer_city AS city
    FROM olist_orders AS o
    JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
),
payments_per_order AS (
    SELECT order_id,
           SUM(payment_value) AS order_payment
    FROM olist_order_payments
    GROUP BY order_id
),
city_totals AS (
    SELECT d.city,
           SUM(p.order_payment) AS total_payments,
           COUNT(*)             AS delivered_orders
    FROM delivered AS d
    JOIN payments_per_order AS p
      ON d.order_id = p.order_id
    GROUP BY d.city
),
bottom_five AS (
    SELECT city,
           total_payments,
           delivered_orders
    FROM city_totals
    ORDER BY total_payments ASC
    LIMIT 5
)
SELECT AVG(total_payments)  AS avg_total_payments,
       AVG(delivered_orders) AS avg_delivered_order_counts
FROM bottom_five;
```
