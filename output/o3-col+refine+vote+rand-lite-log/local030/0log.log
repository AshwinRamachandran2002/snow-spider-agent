Query:
--Description: For those five lowest–payment cities, collect both the summed payments and the counts of delivered orders.
WITH delivered AS (
    SELECT o.order_id,
           c.customer_city AS city
    FROM olist_orders AS o
    JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
),
payments_per_order AS (
    SELECT order_id,
           SUM(payment_value) AS order_payment
    FROM olist_order_payments
    GROUP BY order_id
),
city_totals AS (
    SELECT d.city,
           SUM(p.order_payment) AS total_payments,
           COUNT(*)             AS delivered_orders
    FROM delivered AS d
    JOIN payments_per_order AS p
      ON d.order_id = p.order_id
    GROUP BY d.city
),
bottom_five AS (
    SELECT city,
           total_payments,
           delivered_orders
    FROM city_totals
    ORDER BY total_payments ASC
    LIMIT 5
)
SELECT DISTINCT *
FROM bottom_five
LIMIT 20;
Answer:
city,total_payments,delivered_orders
sabaudia,20.42,1
polo petroquimico de triunfo,20.7,1
jenipapo de minas,22.58,1
tamboara,24.09,1
santo antonio do rio abaixo,24.23,1
Query:
--Description: FINAL ANSWER – average of total payments and average number of delivered orders across the five lowest-payment cities.
WITH delivered AS (
    SELECT o.order_id,
           c.customer_city AS city
    FROM olist_orders AS o
    JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
),
payments_per_order AS (
    SELECT order_id,
           SUM(payment_value) AS order_payment
    FROM olist_order_payments
    GROUP BY order_id
),
city_totals AS (
    SELECT d.city,
           SUM(p.order_payment) AS total_payments,
           COUNT(*)             AS delivered_orders
    FROM delivered AS d
    JOIN payments_per_order AS p
      ON d.order_id = p.order_id
    GROUP BY d.city
),
bottom_five AS (
    SELECT city,
           total_payments,
           delivered_orders
    FROM city_totals
    ORDER BY total_payments ASC
    LIMIT 5
)
SELECT AVG(total_payments)  AS avg_total_payments,
       AVG(delivered_orders) AS avg_delivered_order_counts
FROM bottom_five;
