Query:
--Description: Retrieve the five cities whose summed payments are the very lowest.
SELECT DISTINCT city,
       total_payments
FROM (
        SELECT c.customer_city  AS city,
               SUM(pp.order_payment) AS total_payments
        FROM (
                SELECT o.order_id,
                       c.customer_city
                FROM olist_orders AS o
                JOIN olist_customers AS c
                  ON o.customer_id = c.customer_id
                WHERE o.order_status = 'delivered'
             ) AS c
        JOIN (
                SELECT order_id,
                       SUM(payment_value) AS order_payment
                FROM olist_order_payments
                GROUP BY order_id
             ) AS pp
          ON c.order_id = pp.order_id
        GROUP BY c.customer_city
        ORDER BY total_payments ASC
        LIMIT 5
     )
LIMIT 20;
