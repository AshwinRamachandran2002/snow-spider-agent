```

```sql
-- Description: Count the number of delivered orders for each city (sample)
SELECT  c."customer_city",
        COUNT(*) AS delivered_orders
FROM    "olist_orders"   AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_city"
LIMIT 20;
```

```sql
-- Description: Sum of payments for each city considering only delivered orders (sample)
SELECT  c."customer_city",
        SUM(op."payment_value") AS total_payments
FROM    "olist_orders"   AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
JOIN    "olist_order_payments" AS op
       ON o."order_id" = op."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_city"
LIMIT 20;
```

```sql
-- Description: For every city, get total payments and number of delivered orders (ordered by lowest payments)
SELECT  c."customer_city",
        SUM(op."payment_value")            AS total_payments,
        COUNT(DISTINCT o."order_id")       AS delivered_orders
FROM    "olist_orders"   AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
JOIN    "olist_order_payments" AS op
       ON o."order_id" = op."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_city"
ORDER BY total_payments ASC
LIMIT 20;
```

```sql
-- Description: Retrieve the five cities whose summed payments are the lowest
SELECT  c."customer_city",
        SUM(op."payment_value")            AS total_payments,
        COUNT(DISTINCT o."order_id")       AS delivered_orders
FROM    "olist_orders"   AS o
JOIN    "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
JOIN    "olist_order_payments" AS op
       ON o."order_id" = op."order_id"
WHERE   o."order_status" = 'delivered'
GROUP BY c."customer_city"
ORDER BY total_payments ASC
LIMIT 5;
```

```sql
-- Description: Compute the average total payments and average delivered-order counts
--              for those five lowest-payment cities
SELECT  AVG(city_stats.total_payments)    AS avg_total_payments,
        AVG(city_stats.delivered_orders)  AS avg_delivered_orders
FROM   (
        SELECT  c."customer_city",
                SUM(op."payment_value")            AS total_payments,
                COUNT(DISTINCT o."order_id")       AS delivered_orders
        FROM    "olist_orders"   AS o
        JOIN    "olist_customers" AS c
               ON o."customer_id" = c."customer_id"
        JOIN    "olist_order_payments" AS op
               ON o."order_id" = op."order_id"
        WHERE   o."order_status" = 'delivered'
        GROUP BY c."customer_city"
        ORDER BY total_payments ASC
        LIMIT 5
       ) AS city_stats;
```
