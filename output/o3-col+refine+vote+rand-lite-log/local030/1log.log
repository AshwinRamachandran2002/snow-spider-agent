Query:
-- Description: Take the five cities with the smallest summed payments, then
--              return: ① their average total payments, ② their average delivered-order counts
SELECT AVG("total_payments")        AS "avg_of_city_totals",
       AVG("delivered_order_count") AS "avg_of_city_order_counts"
FROM  (
        SELECT c."customer_city",
               SUM(p."order_payment_total") AS "total_payments",
               COUNT(*)                     AS "delivered_order_count"
        FROM  (SELECT "order_id",
                      SUM("payment_value") AS "order_payment_total"
               FROM   "olist_order_payments"
               GROUP  BY "order_id")       AS p
        JOIN   "olist_orders"              AS o  ON p."order_id"  = o."order_id"
        JOIN   "olist_customers"           AS c  ON o."customer_id" = c."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_city"
        ORDER  BY "total_payments" ASC
        LIMIT 5
      );
