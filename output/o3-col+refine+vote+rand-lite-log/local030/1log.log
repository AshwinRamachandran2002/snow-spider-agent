Query:
-- Description: Join delivered orders with customers to confirm we get city information
SELECT o."order_id",
       c."customer_city",
       c."customer_state"
FROM   "olist_orders"    AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
