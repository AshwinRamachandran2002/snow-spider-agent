```sql
-- Description: See the different order statuses present in the orders table
SELECT DISTINCT "order_status"
FROM "olist_orders"
LIMIT 20;
```

```sql
-- Description: Inspect a few orders that have already been delivered
SELECT "order_id",
       "customer_id",
       "order_status"
FROM   "olist_orders"
WHERE  "order_status" = 'delivered'
LIMIT 20;
```

```sql
-- Description: Look at the customer → city / state mapping
SELECT "customer_id",
       "customer_city",
       "customer_state"
FROM   "olist_customers"
LIMIT 20;
```

```sql
-- Description: Join delivered orders with customers to confirm we get city information
SELECT o."order_id",
       c."customer_city",
       c."customer_state"
FROM   "olist_orders"    AS o
JOIN   "olist_customers" AS c
       ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
LIMIT 20;
```

```sql
-- Description: Aggregate payments per order (some orders can have many payment rows)
SELECT "order_id",
       SUM("payment_value") AS "order_payment_total"
FROM   "olist_order_payments"
GROUP  BY "order_id"
LIMIT 20;
```

```sql
-- Description: For each city, compute total payments of delivered orders and the delivered-order count
SELECT c."customer_city",
       SUM(p."order_payment_total") AS "total_payments",
       COUNT(*)                     AS "delivered_order_count"
FROM  (SELECT "order_id",
              SUM("payment_value") AS "order_payment_total"
       FROM   "olist_order_payments"
       GROUP  BY "order_id")       AS p
JOIN   "olist_orders"              AS o  ON p."order_id"  = o."order_id"
JOIN   "olist_customers"           AS c  ON o."customer_id" = c."customer_id"
WHERE  o."order_status" = 'delivered'
GROUP  BY c."customer_city"
ORDER  BY "total_payments" ASC
LIMIT 20;
```

```sql
-- Description: Take the five cities with the smallest summed payments, then
--              return: ① their average total payments, ② their average delivered-order counts
SELECT AVG("total_payments")        AS "avg_of_city_totals",
       AVG("delivered_order_count") AS "avg_of_city_order_counts"
FROM  (
        SELECT c."customer_city",
               SUM(p."order_payment_total") AS "total_payments",
               COUNT(*)                     AS "delivered_order_count"
        FROM  (SELECT "order_id",
                      SUM("payment_value") AS "order_payment_total"
               FROM   "olist_order_payments"
               GROUP  BY "order_id")       AS p
        JOIN   "olist_orders"              AS o  ON p."order_id"  = o."order_id"
        JOIN   "olist_customers"           AS c  ON o."customer_id" = c."customer_id"
        WHERE  o."order_status" = 'delivered'
        GROUP  BY c."customer_city"
        ORDER  BY "total_payments" ASC
        LIMIT 5
      );
```
