Query:
-- Description: For every city, calculate delivered-order count and total payments, 
--              then show the 20 cities with the smallest summed payments.
SELECT 
    c.customer_city                     AS city,
    COUNT(DISTINCT o.order_id)          AS delivered_orders,
    SUM(p.payment_value)                AS city_total_payments
FROM olist_orders AS o
JOIN olist_order_payments AS p
      ON o.order_id = p.order_id
JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
WHERE o.order_status = 'delivered'
GROUP BY city
ORDER BY city_total_payments ASC
LIMIT 20;
