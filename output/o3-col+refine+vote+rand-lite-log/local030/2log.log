```sql
-- Description: Check the different statuses an order can have.
SELECT DISTINCT order_status 
FROM olist_orders
LIMIT 20;
```

```sql
-- Description: Preview delivered orders together with each payment row.
SELECT 
    o.order_id,
    o.order_status,
    p.payment_value
FROM olist_orders AS o
JOIN olist_order_payments AS p
      ON o.order_id = p.order_id
WHERE o.order_status = 'delivered'
LIMIT 20;
```

```sql
-- Description: Aggregate (sum) the payments per delivered order.
SELECT 
    o.order_id,
    SUM(p.payment_value) AS total_payment
FROM olist_orders AS o
JOIN olist_order_payments AS p
      ON o.order_id = p.order_id
WHERE o.order_status = 'delivered'
GROUP BY o.order_id
LIMIT 20;
```

```sql
-- Description: Link each delivered order (with its summed payment) to the customer city.
SELECT 
    o.order_id,
    c.customer_city,
    SUM(p.payment_value) AS total_payment
FROM olist_orders AS o
JOIN olist_order_payments AS p
      ON o.order_id = p.order_id
JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
WHERE o.order_status = 'delivered'
GROUP BY o.order_id, c.customer_city
LIMIT 20;
```

```sql
-- Description: For every city, calculate delivered-order count and total payments, 
--              then show the 20 cities with the smallest summed payments.
SELECT 
    c.customer_city                     AS city,
    COUNT(DISTINCT o.order_id)          AS delivered_orders,
    SUM(p.payment_value)                AS city_total_payments
FROM olist_orders AS o
JOIN olist_order_payments AS p
      ON o.order_id = p.order_id
JOIN olist_customers AS c
      ON o.customer_id = c.customer_id
WHERE o.order_status = 'delivered'
GROUP BY city
ORDER BY city_total_payments ASC
LIMIT 20;
```

```sql
-- Description: Extract the five cities whose summed payments are the very lowest.
SELECT 
    city,
    delivered_orders,
    city_total_payments
FROM (
    SELECT 
        c.customer_city                 AS city,
        COUNT(DISTINCT o.order_id)      AS delivered_orders,
        SUM(p.payment_value)            AS city_total_payments
    FROM olist_orders AS o
    JOIN olist_order_payments AS p
          ON o.order_id = p.order_id
    JOIN olist_customers AS c
          ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY city
    ORDER BY city_total_payments ASC
    LIMIT 5
)
LIMIT 20;
```

```sql
-- Description: Compute the average of (1) the summed payments and (2) the delivered-order counts
--              for those five lowest-payment cities.
SELECT 
    AVG(city_total_payments)  AS avg_total_payments,
    AVG(delivered_orders)     AS avg_delivered_orders
FROM (
    SELECT 
        c.customer_city                 AS city,
        COUNT(DISTINCT o.order_id)      AS delivered_orders,
        SUM(p.payment_value)            AS city_total_payments
    FROM olist_orders AS o
    JOIN olist_order_payments AS p
          ON o.order_id = p.order_id
    JOIN olist_customers AS c
          ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY city
    ORDER BY city_total_payments ASC
    LIMIT 5
)
LIMIT 20;
```
