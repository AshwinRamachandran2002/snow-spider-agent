--Description: 9) Join those aggregated counts back to station metadata, compute
--              distance in miles, and list the first 20 stations ordered by the
--              highest number of valid observations.
WITH near AS (
  SELECT
    usaf,
    wban,
    name,
    lat,
    lon,
    ST_DISTANCE(
      ST_GEOGPOINT(lon, lat),
      ST_GEOGPOINT(-73.764, 41.197)
    ) AS dist_m
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(
          ST_GEOGPOINT(lon, lat),
          ST_GEOGPOINT(-73.764, 41.197),
          32186.8
        )
),
counts AS (
  SELECT
    stn  AS usaf,
    wban,
    COUNT(*) AS valid_temp_obs
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9
  GROUP BY usaf, wban
)
SELECT
  n.usaf,
  n.wban,
  n.name,
  ROUND(n.dist_m / 1609.34, 2) AS distance_miles,
  c.valid_temp_obs
FROM near  n
JOIN counts c USING (usaf, wban)
ORDER BY c.valid_temp_obs DESC
LIMIT 20
