-- 2. Description:  Stations that are within ~20-mile (32 186.8 m) radius 
--                  of Chappaqua, NY  (-73.764  lon , 41.197 lat)
SELECT usaf,
       wban,
       name,
       lat,
       lon
FROM   `bigquery-public-data.noaa_gsod.stations`
WHERE  ST_DWITHIN( ST_GEOGPOINT(lon , lat),
                   ST_GEOGPOINT(-73.764 , 41.197),
                   32186.8 )            -- 20 miles in metres
LIMIT  20;
