Query:
--Description: 10) FINAL consolidated answer: every NOAA GSOD station within
--               20 mi of Chappaqua along with its total count of valid
--               temperature observations for 2011-2020.  LEFT JOIN ensures
--               stations with zero valid rows still appear (value set to 0).
WITH near AS (
  SELECT
    usaf,
    wban,
    name,
    lat,
    lon
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(
          ST_GEOGPOINT(lon, lat),
          ST_GEOGPOINT(-73.764, 41.197),
          32186.8
        )
),
cnt AS (
  SELECT
    stn  AS usaf,
    wban,
    COUNT(*) AS valid_temp_obs
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9
  GROUP BY usaf, wban
)
SELECT
  n.usaf,
  n.wban,
  n.name,
  n.lat,
  n.lon,
  COALESCE(cnt.valid_temp_obs, 0) AS valid_temp_obs_2011_2020
FROM near n
LEFT JOIN cnt USING (usaf, wban)
ORDER BY valid_temp_obs_2011_2020 DESC NULLS LAST
LIMIT 20
