```sql
--Description: 6) Year-by-year counts of valid (temp ≠ 9999.9) observations for the
--              Westchester County Airport station (USAF 725037, WBAN 94745) from
--              2011-2020, built with a table-wildcard instead of manual UNIONs.
WITH d AS (
  SELECT
    _TABLE_SUFFIX AS year,
    temp
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND stn  = '725037'
    AND wban = '94745'
    AND temp <> 9999.9
)
SELECT year, COUNT(*) AS valid_temp_obs
FROM   d
GROUP  BY year
ORDER  BY year
LIMIT  20;
```

```sql
--Description: 7) Return 20 sample rows of 2011-2020 data (temp already filtered)
--              for every station lying within 20 mi of Chappaqua.  Uses the same
--              ‘near’ CTE and one wildcard scan instead of ten explicit UNIONs.
WITH near AS (
  SELECT usaf, wban
  FROM   `bigquery-public-data.noaa_gsod.stations`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(lon, lat),
                     ST_GEOGPOINT(-73.764, 41.197),
                     32186.8 )
)
SELECT
  stn  AS usaf,
  wban,
  temp
FROM `bigquery-public-data.noaa_gsod.gsod*`
WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
  AND (stn, wban) IN (SELECT usaf, wban FROM near)
  AND temp <> 9999.9
LIMIT 20;
