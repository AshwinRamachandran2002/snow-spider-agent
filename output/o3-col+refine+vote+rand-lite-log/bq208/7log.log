```sql
--Description: 8) Aggregate the previous result: count of valid temperature rows
--              per nearby station across 2011-2020, built with a single wildcard
--              scan plus GROUP BY.
WITH near AS (
  SELECT usaf, wban
  FROM   `bigquery-public-data.noaa_gsod.stations`
  WHERE  ST_DWITHIN( ST_GEOGPOINT(lon, lat),
                     ST_GEOGPOINT(-73.764, 41.197),
                     32186.8 )
),
obs AS (
  SELECT
    stn  AS usaf,
    wban,
    temp
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9
)
SELECT
  o.usaf,
  o.wban,
  COUNT(*) AS valid_temp_obs_2011_2020
FROM   obs o
JOIN   near n USING (usaf, wban)
GROUP  BY o.usaf, o.wban
LIMIT  20;
