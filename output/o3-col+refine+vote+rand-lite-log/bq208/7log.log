-- 3. Description:  Same stations as above but showing actual distance (metres)
SELECT usaf,
       wban,
       name,
       ROUND( ST_DISTANCE( ST_GEOGPOINT(lon , lat),
                           ST_GEOGPOINT(-73.764 , 41.197) ) ,1) AS dist_m
FROM   `bigquery-public-data.noaa_gsod.stations`
WHERE  ST_DWITHIN( ST_GEOGPOINT(lon , lat),
                   ST_GEOGPOINT(-73.764 , 41.197),
                   32186.8 )
ORDER  BY dist_m
LIMIT  20;
