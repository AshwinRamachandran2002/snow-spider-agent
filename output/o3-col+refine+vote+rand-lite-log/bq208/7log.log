```sql
--Description: To answer “Which NOAA GSOD stations lie within a 20-mile radius of
--             Chappaqua NY (41.197 N, –73.764 W) and how many valid temperature
--             observations (temp ≠ 9999.9) did they report from 2011-2020?” we
--             need just one query.  First, CTE ‘near’ filters the `stations`
--             metadata table using ST_DWITHIN to capture only those stations in
--             the 20-mile circle.  Second, CTE ‘cnt’ scans *all* 2011-2020 GSOD
--             tables in one pass via the table wildcard `gsod*`, counting rows
--             per (usaf, wban) whose temp value is real.  Finally, we join the
--             two CTEs so that every nearby station is listed together with its
--             total of valid observations, sorted from most to fewest.
WITH near AS (
  SELECT
    usaf,
    wban,
    name,
    lat,
    lon,
    ST_DISTANCE( ST_GEOGPOINT(lon, lat),
                 ST_GEOGPOINT(-73.764, 41.197) ) / 1609.34 AS dist_miles
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(
          ST_GEOGPOINT(lon, lat),
          ST_GEOGPOINT(-73.764, 41.197),
          32186.8        -- 20 miles in metres
        )
),
cnt AS (
  SELECT
    stn  AS usaf,
    wban,
    COUNT(*) AS valid_temp_obs
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9              -- exclude missing/invalid temperatures
  GROUP BY usaf, wban
)
SELECT
  n.usaf,
  n.wban,
  n.name,
  ROUND(n.dist_miles, 2) AS distance_miles,
  COALESCE(c.valid_temp_obs, 0) AS valid_temp_obs_2011_2020
FROM near n
LEFT JOIN cnt c USING (usaf, wban)
ORDER BY valid_temp_obs_2011_2020 DESC;
```
