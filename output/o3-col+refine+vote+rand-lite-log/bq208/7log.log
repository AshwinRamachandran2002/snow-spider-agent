Query:
--Description: 8) Aggregate count of valid temperature rows (temp ≠ 9999.9)
--              for every station within 20 mi of Chappaqua (41.197 N, –73.764 W)
--              across 2011-2020.  Uses a JOIN (not IN-tuple) between the nearby
--              station list (`near`) and a single wildcard scan (`obs`).
WITH near AS (
  SELECT usaf, wban
  FROM `bigquery-public-data.noaa_gsod.stations`
  WHERE ST_DWITHIN(
          ST_GEOGPOINT(lon, lat),
          ST_GEOGPOINT(-73.764, 41.197),
          32186.8          -- 20 miles in metres
        )
),
obs AS (
  SELECT
    stn  AS usaf,
    wban,
    temp
  FROM `bigquery-public-data.noaa_gsod.gsod*`
  WHERE _TABLE_SUFFIX BETWEEN '2011' AND '2020'
    AND temp <> 9999.9
)
SELECT
  o.usaf,
  o.wban,
  COUNT(*) AS valid_temp_obs_2011_2020
FROM obs  o
JOIN near n USING (usaf, wban)
GROUP BY o.usaf, o.wban
LIMIT 20
