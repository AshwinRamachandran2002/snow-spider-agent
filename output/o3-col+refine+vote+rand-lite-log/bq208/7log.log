  UNION ALL  SELECT '2012', temp FROM `bigquery-public-data.noaa_gsod.gsod2012` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2013', temp FROM `bigquery-public-data.noaa_gsod.gsod2013` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2014', temp FROM `bigquery-public-data.noaa_gsod.gsod2014` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2015', temp FROM `bigquery-public-data.noaa_gsod.gsod2015` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2016', temp FROM `bigquery-public-data.noaa_gsod.gsod2016` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2017', temp FROM `bigquery-public-data.noaa_gsod.gsod2017` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2018', temp FROM `bigquery-public-data.noaa_gsod.gsod2018` WHERE stn='725030' AND wban='14734'
  UNION ALL  SELECT '2019', temp FROM `bigquery-public-data.noaa_gsod.gsod2019` WHERE stn='725030' AND wban='14734'
