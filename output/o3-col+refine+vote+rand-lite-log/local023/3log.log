```sql
--Description: List all distinct season IDs available in the matches data
SELECT DISTINCT "season_id"
FROM "match"
LIMIT 20;
```

```sql
--Description: Fetch a sample of match-ids that belong to season 5
SELECT DISTINCT "match_id", "team_1", "team_2", "match_date"
FROM "match"
WHERE "season_id" = 5
LIMIT 20;
```

```sql
--Description: Look at ball-by-ball records for season 5 matches
SELECT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       b."bowler"
FROM "ball_by_ball" AS b
JOIN "match"        AS m ON m."match_id" = b."match_id"
WHERE m."season_id" = 5
LIMIT 20;
```

```sql
--Description: Verify how runs are stored by joining ball info with batsman_scored
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."striker",
       bs."runs_scored"
FROM "ball_by_ball"  AS bb
JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
JOIN "match"          AS m  ON m."match_id" = bb."match_id"
WHERE m."season_id" = 5
LIMIT 20;
```

```sql
--Description: Aggregate total runs each player scored in every season 5 match
SELECT bb."match_id",
       bb."striker" AS "player_id",
       SUM(bs."runs_scored") AS "total_runs_in_match"
FROM "ball_by_ball"  AS bb
JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
JOIN "match"          AS m  ON m."match_id" = bb."match_id"
WHERE m."season_id" = 5
GROUP BY bb."match_id", bb."striker"
LIMIT 20;
```

```sql
--Description: Count how many distinct matches each player appeared in during season 5
SELECT t."player_id",
       COUNT(DISTINCT t."match_id") AS "matches_played"
FROM (
    SELECT bb."match_id", bb."striker" AS "player_id"
    FROM "ball_by_ball" AS bb
    JOIN "match"        AS m ON m."match_id" = bb."match_id"
    WHERE m."season_id" = 5
    GROUP BY bb."match_id", bb."striker"
) AS t
GROUP BY t."player_id"
LIMIT 20;
```

```sql
--Description: Sum a player’s total runs across the whole of season 5
SELECT s."player_id",
       SUM(s."total_runs_in_match") AS "total_runs_season"
FROM (
    SELECT bb."match_id",
           bb."striker" AS "player_id",
           SUM(bs."runs_scored") AS "total_runs_in_match"
    FROM "ball_by_ball"  AS bb
    JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
    JOIN "match"          AS m  ON m."match_id" = bb."match_id"
    WHERE m."season_id" = 5
    GROUP BY bb."match_id", bb."striker"
) AS s
GROUP BY s."player_id"
LIMIT 20;
```

```sql
--Description: Compute batting average (= runs ÷ matches) for every player in season 5
SELECT tr."player_id",
       1.0 * tr."total_runs_season" / mp."matches_played" AS "avg_runs_per_match"
FROM (
    SELECT s."player_id",
           SUM(s."total_runs_in_match") AS "total_runs_season"
    FROM (
        SELECT bb."match_id",
               bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs_in_match"
        FROM "ball_by_ball"  AS bb
        JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
        JOIN "match"          AS m  ON m."match_id" = bb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bb."match_id", bb."striker"
    ) AS s
    GROUP BY s."player_id"
) AS tr
JOIN (
    SELECT t."player_id",
           COUNT(DISTINCT t."match_id") AS "matches_played"
    FROM (
        SELECT bb."match_id", bb."striker" AS "player_id"
        FROM "ball_by_ball" AS bb
        JOIN "match"        AS m ON m."match_id" = bb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bb."match_id", bb."striker"
    ) AS t
    GROUP BY t."player_id"
) AS mp ON tr."player_id" = mp."player_id"
LIMIT 20;
```

```sql
--Description: Order all season 5 players by their batting average (top 20 shown)
SELECT tr."player_id",
       1.0 * tr."total_runs_season" / mp."matches_played" AS "avg_runs_per_match"
FROM (
    SELECT s."player_id",
           SUM(s."total_runs_in_match") AS "total_runs_season"
    FROM (
        SELECT bb."match_id",
               bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs_in_match"
        FROM "ball_by_ball"  AS bb
        JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
        JOIN "match"          AS m  ON m."match_id" = bb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bb."match_id", bb."striker"
    ) AS s
    GROUP BY s."player_id"
) AS tr
JOIN (
    SELECT t."player_id",
           COUNT(DISTINCT t."match_id") AS "matches_played"
    FROM (
        SELECT bb."match_id", bb."striker" AS "player_id"
        FROM "ball_by_ball" AS bb
        JOIN "match"        AS m ON m."match_id" = bb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bb."match_id", bb."striker"
    ) AS t
    GROUP BY t."player_id"
) AS mp ON tr."player_id" = mp."player_id"
ORDER BY "avg_runs_per_match" DESC
LIMIT 20;
```

```sql
--Description: Final answer – top 5 players with the highest average runs per match in season 5
SELECT p."player_name",
       printf('%.2f', 1.0 * tr."total_runs_season" / mp."matches_played") AS "batting_average"
FROM (
    SELECT s."player_id",
           SUM(s."total_runs_in_match") AS "total_runs_season"
    FROM (
        SELECT bb."match_id",
               bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs_in_match"
        FROM "ball_by_ball"  AS bb
        JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
        JOIN "match"          AS m  ON m."match_id" = bb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bb."match_id", bb."striker"
    ) AS s
    GROUP BY s."player_id"
) AS tr
JOIN (
    SELECT t."player_id",
           COUNT(DISTINCT t."match_id") AS "matches_played"
    FROM (
        SELECT bb."match_id", bb."striker" AS "player_id"
        FROM "ball_by_ball" AS bb
        JOIN "match"        AS m ON m."match_id" = bb."match_id"
        WHERE m."season_id" = 5
        GROUP BY bb."match_id", bb."striker"
    ) AS t
    GROUP BY t."player_id"
) AS mp  ON tr."player_id" = mp."player_id"
JOIN "player" AS p ON p."player_id" = tr."player_id"
ORDER BY 1.0 * tr."total_runs_season" / mp."matches_played" DESC
LIMIT 5;
```
