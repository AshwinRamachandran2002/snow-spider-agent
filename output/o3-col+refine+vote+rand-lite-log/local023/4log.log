```sql
--Description: To determine how many runs each batsman (striker) scored in every season-5 match,
--we must combine the striker information in ball_by_ball with the runs stored in batsman_scored.
--We join on match_id, over_id, ball_id, and innings_no (the full ball identity),
--filter the matches to season 5, then sum runs for each (match_id, striker) pair.
SELECT
    b.match_id,
    b.striker                    AS player_id,
    SUM(s.runs_scored)           AS runs_in_match
FROM ball_by_ball   AS b
JOIN batsman_scored AS s
  ON  b.match_id   = s.match_id
  AND b.over_id    = s.over_id
  AND b.ball_id    = s.ball_id
  AND b.innings_no = s.innings_no
WHERE b.match_id IN (
      SELECT match_id
      FROM match
      WHERE season_id = 5
)
GROUP BY b.match_id, b.striker
LIMIT 20;
```
