```sql
-- 1) Identify matches that belong to season 5
SELECT DISTINCT match_id
FROM match
WHERE season_id = 5
LIMIT 20;
```

```sql
-- 2) Check ball-by-ball rows that correspond to those season 5 matches
SELECT DISTINCT match_id
FROM ball_by_ball
WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
LIMIT 20;
```

```sql
-- 3) Runs scored by every batsman in each season 5 match
SELECT match_id,
       striker          AS player_id,
       SUM(runs_scored) AS runs_in_match
FROM batsman_scored
WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
GROUP BY match_id, striker
LIMIT 20;
```

```sql
-- 4) Total runs scored by each player across the whole season 5
SELECT striker          AS player_id,
       SUM(runs_scored) AS total_runs
FROM batsman_scored
WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
GROUP BY striker
LIMIT 20;
```

```sql
-- 5) Number of season 5 matches in which each player appeared
SELECT player_id,
       COUNT(DISTINCT match_id) AS matches_played
FROM player_match
WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
GROUP BY player_id
LIMIT 20;
```

```sql
-- 6) Average runs per match for every player in season 5
SELECT striker                                         AS player_id,
       CAST(SUM(runs_scored) AS FLOAT) / 
       COUNT(DISTINCT match_id)                        AS avg_runs
FROM batsman_scored
WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
GROUP BY striker
LIMIT 20;
```

```sql
-- 7) Same list ordered by batting average (top 10)
SELECT striker                                         AS player_id,
       CAST(SUM(runs_scored) AS FLOAT) / 
       COUNT(DISTINCT match_id)                        AS avg_runs
FROM batsman_scored
WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
GROUP BY striker
ORDER BY avg_runs DESC
LIMIT 10;
```

```sql
-- 8) Bring in player names for those averages
SELECT p.player_name,
       a.avg_runs
FROM (
       SELECT striker AS player_id,
              CAST(SUM(runs_scored) AS FLOAT) / COUNT(DISTINCT match_id) AS avg_runs
       FROM batsman_scored
       WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
       GROUP BY striker
     ) AS a
JOIN player AS p
  ON p.player_id = a.player_id
ORDER BY a.avg_runs DESC
LIMIT 10;
```

```sql
-- 9) Final answer: top 5 players with highest batting average in season 5
SELECT p.player_name,
       a.avg_runs      AS batting_average
FROM (
       SELECT striker AS player_id,
              CAST(SUM(runs_scored) AS FLOAT) / COUNT(DISTINCT match_id) AS avg_runs
       FROM batsman_scored
       WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
       GROUP BY striker
     ) AS a
JOIN player AS p
  ON p.player_id = a.player_id
ORDER BY a.avg_runs DESC
LIMIT 5;
```

```sql
-- 10) (Optional check) Distinct list of those five players
SELECT DISTINCT player_name
FROM (
       SELECT p.player_name,
              a.avg_runs
       FROM (
              SELECT striker AS player_id,
                     CAST(SUM(runs_scored) AS FLOAT) / COUNT(DISTINCT match_id) AS avg_runs
              FROM batsman_scored
              WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
              GROUP BY striker
            ) AS a
       JOIN player AS p
         ON p.player_id = a.player_id
       ORDER BY a.avg_runs DESC
       LIMIT 5
     );
```
