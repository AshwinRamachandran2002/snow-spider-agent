```sql
--Description: (4) Compute total runs scored by each batsman in season-5.  
--Because striker information is in ball_by_ball and runs in batsman_scored,  
--join both tables on match_id, over_id, ball_id, and innings_no,  
--filter to season-5 matches, then aggregate runs per striker.
SELECT
    b.striker                    AS player_id,
    SUM(s.runs_scored)           AS total_runs
FROM ball_by_ball   AS b
JOIN batsman_scored AS s
  ON  b.match_id   = s.match_id
  AND b.over_id    = s.over_id
  AND b.ball_id    = s.ball_id
  AND b.innings_no = s.innings_no
WHERE b.match_id IN (
      SELECT match_id
      FROM match
      WHERE season_id = 5
)
GROUP BY b.striker
LIMIT 20;
```

```sql
--Description: (5) Count how many season-5 matches each player appeared in,  
--using player_match which already stores (match_id, player_id).  
--Simply filter to season-5 matches and count distinct match_id per player.
SELECT
    player_id,
    COUNT(DISTINCT match_id) AS matches_played
FROM player_match
WHERE match_id IN (
      SELECT match_id
      FROM match
      WHERE season_id = 5
)
GROUP BY player_id
LIMIT 20;
```

```sql
--Description: (6) Calculate average runs per match for each player in season-5.  
--First get total_runs per player (sub-query r), then matches_played per player (sub-query m),  
--and divide total_runs by matches_played.
WITH r AS (
      SELECT b.striker AS player_id,
             SUM(s.runs_scored) AS total_runs
      FROM ball_by_ball b
      JOIN batsman_scored s
        ON b.match_id   = s.match_id
       AND b.over_id    = s.over_id
       AND b.ball_id    = s.ball_id
       AND b.innings_no = s.innings_no
      WHERE b.match_id IN (SELECT match_id FROM match WHERE season_id = 5)
      GROUP BY b.striker
), m AS (
      SELECT player_id,
             COUNT(DISTINCT match_id) AS matches_played
      FROM player_match
      WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
      GROUP BY player_id
)
SELECT
    r.player_id,
    CAST(r.total_runs AS FLOAT) / m.matches_played AS avg_runs
FROM r
JOIN m ON m.player_id = r.player_id
LIMIT 20;
```

```sql
--Description: (7) List the same averages, ordered descending, top 10 players.
WITH r AS (
      SELECT b.striker AS player_id,
             SUM(s.runs_scored) AS total_runs
      FROM ball_by_ball b
      JOIN batsman_scored s
        ON b.match_id   = s.match_id
       AND b.over_id    = s.over_id
       AND b.ball_id    = s.ball_id
       AND b.innings_no = s.innings_no
      WHERE b.match_id IN (SELECT match_id FROM match WHERE season_id = 5)
      GROUP BY b.striker
), m AS (
      SELECT player_id,
             COUNT(DISTINCT match_id) AS matches_played
      FROM player_match
      WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
      GROUP BY player_id
)
SELECT
    r.player_id,
    CAST(r.total_runs AS FLOAT) / m.matches_played AS avg_runs
FROM r
JOIN m ON m.player_id = r.player_id
ORDER BY avg_runs DESC
LIMIT 10;
```

```sql
--Description: (8) Attach player names to those averages (top 10).  
--Reuse the previous CTE and join with the player table.
WITH r AS (
      SELECT b.striker AS player_id,
             SUM(s.runs_scored) AS total_runs
      FROM ball_by_ball b
      JOIN batsman_scored s
        ON b.match_id   = s.match_id
       AND b.over_id    = s.over_id
       AND b.ball_id    = s.ball_id
       AND b.innings_no = s.innings_no
      WHERE b.match_id IN (SELECT match_id FROM match WHERE season_id = 5)
      GROUP BY b.striker
), m AS (
      SELECT player_id,
             COUNT(DISTINCT match_id) AS matches_played
      FROM player_match
      WHERE match_id IN (SELECT match_id FROM match WHERE season_id = 5)
      GROUP BY player_id
), a AS (
      SELECT r.player_id,
             CAST(r.total_runs AS FLOAT) / m.matches_played AS avg_runs
      FROM r JOIN m ON m.player_id = r.player_id
)
SELECT
    p.player_name,
    a.avg_runs
FROM a
JOIN player AS p ON p.player_id = a.player_id
ORDER BY a.avg_runs DESC
LIMIT 10;
```

