Query:
--Description: Join ball_by_ball with batsman_scored to see striker-wise runs for season 5.
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       s."runs_scored"
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS s
  ON b."match_id" = s."match_id"
 AND b."over_id"  = s."over_id"
 AND b."ball_id"  = s."ball_id"
 AND b."innings_no" = s."innings_no"
WHERE b."match_id" IN (SELECT "match_id"
                       FROM "match"
                       WHERE "season_id" = 5)
LIMIT 20;
