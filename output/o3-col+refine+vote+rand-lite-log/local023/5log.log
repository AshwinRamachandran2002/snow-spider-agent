Query:
--Description: Aggregate total runs and number of matches played by each player in season 5.
SELECT t."player_id",
       SUM(t."runs_in_match")            AS "total_runs",
       COUNT(DISTINCT t."match_id")      AS "matches_played"
FROM (
    SELECT b."match_id",
           b."striker" AS "player_id",
           SUM(s."runs_scored") AS "runs_in_match"
    FROM "ball_by_ball" AS b
    JOIN "batsman_scored" AS s
      ON b."match_id" = s."match_id"
     AND b."over_id"  = s."over_id"
     AND b."ball_id"  = s."ball_id"
     AND b."innings_no" = s."innings_no"
    WHERE b."match_id" IN (SELECT "match_id"
                           FROM "match"
                           WHERE "season_id" = 5)
    GROUP BY b."match_id", b."striker"
) AS t
GROUP BY t."player_id"
LIMIT 20;
