```sql
--Description: List all the seasons available in the dataset (quick orientation).
SELECT DISTINCT "season_id"
FROM "match"
LIMIT 20;
```

```sql
--Description: Display a few matches that belong to season 5.
SELECT DISTINCT "match_id",
       "match_date"
FROM "match"
WHERE "season_id" = 5
LIMIT 20;
```

```sql
--Description: Collect the match-IDs of season 5 that we will use in next steps.
SELECT DISTINCT "match_id"
FROM "match"
WHERE "season_id" = 5
LIMIT 20;
```

```sql
--Description: Inspect some ball-by-ball rows from season 5 (focus on the striker column).
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker"
FROM "ball_by_ball" AS b
WHERE b."match_id" IN (SELECT "match_id"
                       FROM "match"
                       WHERE "season_id" = 5)
LIMIT 20;
```

```sql
--Description: Join ball_by_ball with batsman_scored to see striker-wise runs for season 5.
SELECT DISTINCT b."match_id",
       b."over_id",
       b."ball_id",
       b."striker",
       s."runs_scored"
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS s
  ON b."match_id" = s."match_id"
 AND b."over_id"  = s."over_id"
 AND b."ball_id"  = s."ball_id"
 AND b."innings_no" = s."innings_no"
WHERE b."match_id" IN (SELECT "match_id"
                       FROM "match"
                       WHERE "season_id" = 5)
LIMIT 20;
```

```sql
--Description: Compute runs scored by every player in each individual match of season 5.
SELECT b."match_id",
       b."striker"        AS "player_id",
       SUM(s."runs_scored") AS "runs_in_match"
FROM "ball_by_ball" AS b
JOIN "batsman_scored" AS s
  ON b."match_id" = s."match_id"
 AND b."over_id"  = s."over_id"
 AND b."ball_id"  = s."ball_id"
 AND b."innings_no" = s."innings_no"
WHERE b."match_id" IN (SELECT "match_id"
                       FROM "match"
                       WHERE "season_id" = 5)
GROUP BY b."match_id", b."striker"
LIMIT 20;
```

```sql
--Description: Aggregate total runs and number of matches played by each player in season 5.
SELECT t."player_id",
       SUM(t."runs_in_match")            AS "total_runs",
       COUNT(DISTINCT t."match_id")      AS "matches_played"
FROM (
    SELECT b."match_id",
           b."striker" AS "player_id",
           SUM(s."runs_scored") AS "runs_in_match"
    FROM "ball_by_ball" AS b
    JOIN "batsman_scored" AS s
      ON b."match_id" = s."match_id"
     AND b."over_id"  = s."over_id"
     AND b."ball_id"  = s."ball_id"
     AND b."innings_no" = s."innings_no"
    WHERE b."match_id" IN (SELECT "match_id"
                           FROM "match"
                           WHERE "season_id" = 5)
    GROUP BY b."match_id", b."striker"
) AS t
GROUP BY t."player_id"
LIMIT 20;
```

```sql
--Description: Final answer – top 5 players with the highest average runs per match in season 5.
SELECT p."player_name",
       ROUND(r."total_runs" * 1.0 / r."matches_played", 2) AS "batting_average"
FROM (
    SELECT t."player_id",
           SUM(t."runs_in_match")       AS "total_runs",
           COUNT(DISTINCT t."match_id") AS "matches_played"
    FROM (
        SELECT b."match_id",
               b."striker" AS "player_id",
               SUM(s."runs_scored") AS "runs_in_match"
        FROM "ball_by_ball" AS b
        JOIN "batsman_scored" AS s
          ON b."match_id" = s."match_id"
         AND b."over_id"  = s."over_id"
         AND b."ball_id"  = s."ball_id"
         AND b."innings_no" = s."innings_no"
        WHERE b."match_id" IN (SELECT "match_id"
                               FROM "match"
                               WHERE "season_id" = 5)
        GROUP BY b."match_id", b."striker"
    ) AS t
    GROUP BY t."player_id"
) AS r
JOIN "player" AS p
  ON p."player_id" = r."player_id"
ORDER BY "batting_average" DESC
LIMIT 5;
```
