```sql
-- Description: Look at distinct season_ids available in the match table (first 20 rows only)
SELECT DISTINCT season_id
FROM match
LIMIT 20;
```

```sql
-- Description: List the match_ids that belong to season 5 (first 20 rows only)
SELECT DISTINCT match_id
FROM match
WHERE season_id = 5
LIMIT 20;
```

```sql
-- Description: Inspect a few deliveries from ball_by_ball that occurred in season 5
SELECT DISTINCT b.match_id, b.over_id, b.ball_id, b.striker
FROM ball_by_ball AS b
JOIN match       AS m ON m.match_id = b.match_id
WHERE m.season_id = 5
LIMIT 20;
```

```sql
-- Description: Join ball_by_ball with batsman_scored (for season 5) to see runs scored by each striker on each ball
SELECT DISTINCT b.match_id, b.striker AS player_id, s.runs_scored
FROM ball_by_ball   AS b
JOIN batsman_scored AS s ON s.match_id = b.match_id
                       AND s.over_id  = b.over_id
                       AND s.ball_id  = b.ball_id
                       AND s.innings_no = b.innings_no
JOIN match          AS m ON m.match_id = b.match_id
WHERE m.season_id = 5
LIMIT 20;
```

```sql
-- Description: Aggregate total runs scored by every player in season 5
SELECT b.striker AS player_id,
       SUM(s.runs_scored) AS total_runs
FROM ball_by_ball   AS b
JOIN batsman_scored AS s ON s.match_id = b.match_id
                       AND s.over_id  = b.over_id
                       AND s.ball_id  = b.ball_id
                       AND s.innings_no = b.innings_no
JOIN match          AS m ON m.match_id = b.match_id
WHERE m.season_id = 5
GROUP BY b.striker
LIMIT 20;
```

```sql
-- Description: Count how many distinct matches each player batted in during season 5
SELECT b.striker AS player_id,
       COUNT(DISTINCT b.match_id) AS matches_played
FROM ball_by_ball AS b
JOIN match        AS m ON m.match_id = b.match_id
WHERE m.season_id = 5
GROUP BY b.striker
LIMIT 20;
```

```sql
-- Description: Compute each player’s batting average (total runs / matches played) for season 5
SELECT r.player_id,
       1.0 * r.total_runs / p.matches_played AS batting_average
FROM
    (SELECT b.striker AS player_id,
            SUM(s.runs_scored) AS total_runs
     FROM ball_by_ball   AS b
     JOIN batsman_scored AS s ON s.match_id  = b.match_id
                             AND s.over_id   = b.over_id
                             AND s.ball_id   = b.ball_id
                             AND s.innings_no = b.innings_no
     JOIN match          AS m ON m.match_id = b.match_id
     WHERE m.season_id = 5
     GROUP BY b.striker) AS r
JOIN
    (SELECT b.striker AS player_id,
            COUNT(DISTINCT b.match_id) AS matches_played
     FROM ball_by_ball AS b
     JOIN match        AS m ON m.match_id = b.match_id
     WHERE m.season_id = 5
     GROUP BY b.striker) AS p
ON r.player_id = p.player_id
LIMIT 20;
```

```sql
-- Description: Bring in player names and show top-5 batting averages in season 5
SELECT pl.player_name,
       ROUND(1.0 * r.total_runs / p.matches_played, 2) AS batting_average
FROM
    (SELECT b.striker AS player_id,
            SUM(s.runs_scored) AS total_runs
     FROM ball_by_ball   AS b
     JOIN batsman_scored AS s ON s.match_id  = b.match_id
                             AND s.over_id   = b.over_id
                             AND s.ball_id   = b.ball_id
                             AND s.innings_no = b.innings_no
     JOIN match          AS m ON m.match_id = b.match_id
     WHERE m.season_id = 5
     GROUP BY b.striker) AS r
JOIN
    (SELECT b.striker AS player_id,
            COUNT(DISTINCT b.match_id) AS matches_played
     FROM ball_by_ball AS b
     JOIN match        AS m ON m.match_id = b.match_id
     WHERE m.season_id = 5
     GROUP BY b.striker) AS p
  ON r.player_id = p.player_id
JOIN player AS pl
  ON pl.player_id = r.player_id
ORDER BY batting_average DESC
LIMIT 5;
```
