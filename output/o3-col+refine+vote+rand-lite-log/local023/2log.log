```sql
-- 1.  List the different seasons available in the data
SELECT DISTINCT "season_id"
FROM "match"
LIMIT 20;
```

```sql
-- 2.  Get a feel for the matches that belong to season 5
SELECT "match_id",
       "match_date"
FROM   "match"
WHERE  "season_id" = 5
LIMIT 20;
```

```sql
-- 3.  Look at a few ball-by-ball records that happened in season 5
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."striker",
       bb."non_striker",
       bb."bowler"
FROM   "ball_by_ball" AS bb
JOIN   "match"        AS m  ON m."match_id" = bb."match_id"
WHERE  m."season_id" = 5
LIMIT 20;
```

```sql
-- 4.  Join ball-by-ball with batsman_scored to verify that runs are aligned
SELECT bb."match_id",
       bb."striker"      AS "player_id",
       bs."runs_scored"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON bs."match_id"  = bb."match_id"
      AND bs."over_id"   = bb."over_id"
      AND bs."ball_id"   = bb."ball_id"
      AND bs."innings_no"= bb."innings_no"
JOIN   "match"          AS m
       ON m."match_id"  = bb."match_id"
WHERE  m."season_id" = 5
LIMIT 20;
```

```sql
-- 5.  Total runs scored by every player in season 5
SELECT bb."striker"                    AS "player_id",
       SUM(bs."runs_scored")           AS "total_runs"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
       ON bs."match_id"  = bb."match_id"
      AND bs."over_id"   = bb."over_id"
      AND bs."ball_id"   = bb."ball_id"
      AND bs."innings_no"= bb."innings_no"
JOIN   "match"          AS m
       ON m."match_id"  = bb."match_id"
WHERE  m."season_id" = 5
GROUP  BY bb."striker"
ORDER  BY "total_runs" DESC
LIMIT 20;
```

```sql
-- 6.  Count how many matches each player appeared in during season 5
SELECT pm."player_id",
       COUNT(DISTINCT pm."match_id")   AS "matches_played"
FROM   "player_match" AS pm
JOIN   "match"        AS m  ON m."match_id" = pm."match_id"
WHERE  m."season_id" = 5
GROUP  BY pm."player_id"
ORDER  BY "matches_played" DESC
LIMIT 20;
```

```sql
-- 7.  Combine total runs and matches played to compute average runs per match
SELECT r."player_id",
       r."total_runs" * 1.0 / mp."matches_played"  AS "avg_runs"
FROM  (
        SELECT bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS bb
        JOIN   "batsman_scored" AS bs
               ON bs."match_id"  = bb."match_id"
              AND bs."over_id"   = bb."over_id"
              AND bs."ball_id"   = bb."ball_id"
              AND bs."innings_no"= bb."innings_no"
        JOIN   "match" AS m ON m."match_id" = bb."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY bb."striker"
      ) AS r
JOIN  (
        SELECT pm."player_id",
               COUNT(DISTINCT pm."match_id") AS "matches_played"
        FROM   "player_match" AS pm
        JOIN   "match"        AS m ON m."match_id" = pm."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY pm."player_id"
      ) AS mp
      ON mp."player_id" = r."player_id"
WHERE  mp."matches_played" > 0
ORDER  BY "avg_runs" DESC
LIMIT 20;
```

```sql
-- 8.  Attach player names to the calculated averages
SELECT p."player_name",
       ROUND( r."total_runs" * 1.0 / mp."matches_played", 2 ) AS "batting_average"
FROM  (
        SELECT bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS bb
        JOIN   "batsman_scored" AS bs
               ON bs."match_id"  = bb."match_id"
              AND bs."over_id"   = bb."over_id"
              AND bs."ball_id"   = bb."ball_id"
              AND bs."innings_no"= bb."innings_no"
        JOIN   "match" AS m ON m."match_id" = bb."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY bb."striker"
      ) AS r
JOIN  (
        SELECT pm."player_id",
               COUNT(DISTINCT pm."match_id") AS "matches_played"
        FROM   "player_match" AS pm
        JOIN   "match"        AS m ON m."match_id" = pm."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY pm."player_id"
      ) AS mp
      ON mp."player_id" = r."player_id"
JOIN  "player" AS p
      ON p."player_id" = r."player_id"
ORDER BY "batting_average" DESC
LIMIT 20;
```

```sql
-- 9.  Retrieve the top-5 players with highest average runs per match in season 5
SELECT p."player_name",
       ROUND( r."total_runs" * 1.0 / mp."matches_played", 2 ) AS "batting_average"
FROM  (
        SELECT bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS bb
        JOIN   "batsman_scored" AS bs
               ON bs."match_id"  = bb."match_id"
              AND bs."over_id"   = bb."over_id"
              AND bs."ball_id"   = bb."ball_id"
              AND bs."innings_no"= bb."innings_no"
        JOIN   "match" AS m ON m."match_id" = bb."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY bb."striker"
      ) AS r
JOIN  (
        SELECT pm."player_id",
               COUNT(DISTINCT pm."match_id") AS "matches_played"
        FROM   "player_match" AS pm
        JOIN   "match"        AS m ON m."match_id" = pm."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY pm."player_id"
      ) AS mp
      ON mp."player_id" = r."player_id"
JOIN  "player" AS p ON p."player_id" = r."player_id"
WHERE mp."matches_played" > 0
ORDER BY "batting_average" DESC
LIMIT 5;
```

```sql
-- 10.  (Optional check) Show total runs and match count for those same top performers
SELECT p."player_name",
       r."total_runs",
       mp."matches_played"
FROM  (
        SELECT bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS bb
        JOIN   "batsman_scored" AS bs
               ON bs."match_id"  = bb."match_id"
              AND bs."over_id"   = bb."over_id"
              AND bs."ball_id"   = bb."ball_id"
              AND bs."innings_no"= bb."innings_no"
        JOIN   "match" AS m ON m."match_id" = bb."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY bb."striker"
      ) AS r
JOIN  (
        SELECT pm."player_id",
               COUNT(DISTINCT pm."match_id") AS "matches_played"
        FROM   "player_match" AS pm
        JOIN   "match"        AS m ON m."match_id" = pm."match_id"
        WHERE  m."season_id" = 5
        GROUP  BY pm."player_id"
      ) AS mp  ON mp."player_id" = r."player_id"
JOIN  "player" AS p  ON p."player_id" = r."player_id"
ORDER BY r."total_runs" DESC
LIMIT 20;
```
