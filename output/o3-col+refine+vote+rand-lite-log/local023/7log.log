```sql
--Description: 1)  See all the seasons that exist in the data.  
SELECT DISTINCT "season_id"
FROM "match"
LIMIT 20;
```

```sql
--Description: 2)  List a sample of matches that belong to season 5.  
SELECT DISTINCT "match_id"
FROM "match"
WHERE "season_id" = 5
LIMIT 20;
```

```sql
--Description: 3)  Look at a few ball-by-ball records from those season-5 matches.  
SELECT DISTINCT b."match_id",
                b."over_id",
                b."ball_id",
                b."striker"
FROM "ball_by_ball" AS b
WHERE b."match_id" IN (SELECT "match_id" FROM "match" WHERE "season_id" = 5)
LIMIT 20;
```

```sql
--Description: 4)  Join ball-by-ball with batsman_scored to see the runs a striker scored on each ball (season 5 only).  
SELECT DISTINCT bb."match_id",
                bb."striker",
                bs."runs_scored"
FROM "ball_by_ball"  AS bb
JOIN "batsman_scored" AS bs
  ON  bb."match_id"   = bs."match_id"
  AND bb."over_id"    = bs."over_id"
  AND bb."ball_id"    = bs."ball_id"
  AND bb."innings_no" = bs."innings_no"
WHERE bb."match_id" IN (SELECT "match_id" FROM "match" WHERE "season_id" = 5)
LIMIT 20;
```

```sql
--Description: 5)  Aggregate total runs scored by every player in season 5.  
SELECT bb."striker"                    AS "player_id",
       SUM(bs."runs_scored")           AS "total_runs"
FROM   "ball_by_ball"  AS bb
JOIN   "batsman_scored" AS bs
  ON   bb."match_id"   = bs."match_id"
 AND   bb."over_id"    = bs."over_id"
 AND   bb."ball_id"    = bs."ball_id"
 AND   bb."innings_no" = bs."innings_no"
WHERE  bb."match_id" IN (SELECT "match_id" FROM "match" WHERE "season_id" = 5)
GROUP BY bb."striker"
ORDER BY "total_runs" DESC
LIMIT 20;
```

```sql
--Description: 6)  Count how many season-5 matches each player appeared in.  
SELECT pm."player_id",
       COUNT(DISTINCT pm."match_id") AS "matches_played"
FROM   "player_match" AS pm
WHERE  pm."match_id" IN (SELECT "match_id" FROM "match" WHERE "season_id" = 5)
GROUP BY pm."player_id"
ORDER BY "matches_played" DESC
LIMIT 20;
```

```sql
--Description: 7)  Combine total runs and matches played to compute every player’s batting average (runs per match) in season 5.  
SELECT tr."player_id",
       tr."total_runs",
       mp."matches_played",
       CAST(tr."total_runs" AS FLOAT) / mp."matches_played"  AS "avg_runs"
FROM  ( SELECT bb."striker" AS "player_id",
               SUM(bs."runs_scored") AS "total_runs"
        FROM   "ball_by_ball"  AS bb
        JOIN   "batsman_scored" AS bs
          ON   bb."match_id"   = bs."match_id"
         AND   bb."over_id"    = bs."over_id"
         AND   bb."ball_id"    = bs."ball_id"
         AND   bb."innings_no" = bs."innings_no"
        WHERE  bb."match_id" IN (SELECT "match_id"
                                 FROM "match"
                                 WHERE "season_id" = 5)
        GROUP BY bb."striker"
      )  AS tr
JOIN  ( SELECT pm."player_id",
               COUNT(DISTINCT pm."match_id") AS "matches_played"
        FROM   "player_match" AS pm
        WHERE  pm."match_id" IN (SELECT "match_id"
                                 FROM "match"
                                 WHERE "season_id" = 5)
        GROUP BY pm."player_id"
      )  AS mp
ON  tr."player_id" = mp."player_id"
ORDER BY "avg_runs" DESC
LIMIT 20;
```

```sql
--Description: 8)  Attach player names to those batting-average figures.  
SELECT p."player_name",
       res."avg_runs"
FROM  ( SELECT tr."player_id",
               CAST(tr."total_runs" AS FLOAT) / mp."matches_played" AS "avg_runs"
        FROM  ( SELECT bb."striker" AS "player_id",
                       SUM(bs."runs_scored") AS "total_runs"
                FROM   "ball_by_ball"  AS bb
                JOIN   "batsman_scored" AS bs
                  ON   bb."match_id"   = bs."match_id"
                 AND   bb."over_id"    = bs."over_id"
                 AND   bb."ball_id"    = bs."ball_id"
                 AND   bb."innings_no" = bs."innings_no"
                WHERE  bb."match_id" IN (SELECT "match_id"
                                         FROM "match"
                                         WHERE "season_id" = 5)
                GROUP BY bb."striker"
              ) AS tr
        JOIN  ( SELECT pm."player_id",
                       COUNT(DISTINCT pm."match_id") AS "matches_played"
                FROM   "player_match" AS pm
                WHERE  pm."match_id" IN (SELECT "match_id"
                                         FROM "match"
                                         WHERE "season_id" = 5)
                GROUP BY pm."player_id"
              ) AS mp
        ON tr."player_id" = mp."player_id"
      )  AS res
JOIN "player" AS p
  ON p."player_id" = res."player_id"
ORDER BY res."avg_runs" DESC
LIMIT 5;
```

These eight progressively complex queries end with the final one that delivers the top 5 players and their batting averages (runs per match) for season 5.
