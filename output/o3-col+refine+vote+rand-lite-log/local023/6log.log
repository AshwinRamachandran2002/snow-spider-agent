```sql
-- Description: Find all different season identifiers present in the data (quick check of seasons that exist).
SELECT DISTINCT season_id
FROM "match"
LIMIT 20;
```

```sql
-- Description: Look at a few matches that belong to season 5 (will be required for subsequent joins).
SELECT match_id,
       match_date,
       team_1,
       team_2
FROM "match"
WHERE season_id = 5
LIMIT 20;
```

```sql
-- Description: Inspect how runs recorded in batsman_scored line-up with the striker field from ball_by_ball.
SELECT bs.match_id,
       bs.over_id,
       bs.ball_id,
       bs.runs_scored,
       bb.striker     AS player_id
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"   AS bb
USING  (match_id, over_id, ball_id)
LIMIT 20;
```

```sql
-- Description: For season-5 matches, aggregate total runs a player scores in every single match.
SELECT bb.striker        AS player_id,
       bs.match_id,
       SUM(bs.runs_scored) AS runs_in_match
FROM   "batsman_scored" AS bs
JOIN   "ball_by_ball"   AS bb
USING  (match_id, over_id, ball_id)
JOIN   "match"          AS m
ON     m.match_id = bs.match_id
WHERE  m.season_id = 5
GROUP BY bb.striker, bs.match_id
LIMIT 20;
```

```sql
-- Description: Using the previous result, compute the average runs per match for every player in season 5.
WITH season5_runs AS (
  SELECT bb.striker        AS player_id,
         bs.match_id,
         SUM(bs.runs_scored) AS runs_in_match
  FROM   "batsman_scored" AS bs
  JOIN   "ball_by_ball"   AS bb
  USING  (match_id, over_id, ball_id)
  JOIN   "match"          AS m
  ON     m.match_id = bs.match_id
  WHERE  m.season_id = 5
  GROUP BY bb.striker, bs.match_id
)
SELECT player_id,
       AVG(runs_in_match) AS avg_runs_per_match
FROM   season5_runs
GROUP BY player_id
ORDER BY avg_runs_per_match DESC
LIMIT 20;
```

```sql
-- Description: Pair those season-5 batting averages with player names.
WITH season5_runs AS (
  SELECT bb.striker        AS player_id,
         bs.match_id,
         SUM(bs.runs_scored) AS runs_in_match
  FROM   "batsman_scored" AS bs
  JOIN   "ball_by_ball"   AS bb
  USING  (match_id, over_id, ball_id)
  JOIN   "match"          AS m
  ON     m.match_id = bs.match_id
  WHERE  m.season_id = 5
  GROUP BY bb.striker, bs.match_id
),
avg_runs AS (
  SELECT player_id,
         AVG(runs_in_match) AS avg_runs
  FROM   season5_runs
  GROUP BY player_id
)
SELECT p.player_name,
       ROUND(ar.avg_runs, 2) AS batting_average
FROM   avg_runs AS ar
JOIN   "player" AS p
ON     p.player_id = ar.player_id
ORDER BY batting_average DESC
LIMIT 20;
```

```sql
-- Description: Final answer – top 5 players with the highest average runs per match in season 5.
WITH season5_runs AS (
  SELECT bb.striker        AS player_id,
         bs.match_id,
         SUM(bs.runs_scored) AS runs_in_match
  FROM   "batsman_scored" AS bs
  JOIN   "ball_by_ball"   AS bb
  USING  (match_id, over_id, ball_id)
  JOIN   "match"          AS m
  ON     m.match_id = bs.match_id
  WHERE  m.season_id = 5
  GROUP BY bb.striker, bs.match_id
),
avg_runs AS (
  SELECT player_id,
         AVG(runs_in_match) AS avg_runs
  FROM   season5_runs
  GROUP BY player_id
)
SELECT p.player_name,
       ROUND(ar.avg_runs, 2) AS batting_average
FROM   avg_runs AS ar
JOIN   "player" AS p
ON     p.player_id = ar.player_id
ORDER BY batting_average DESC
LIMIT 5;
```
