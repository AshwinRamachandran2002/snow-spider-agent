```sql
--Description: List all available seasons so we know the value for season-5
SELECT DISTINCT season_id 
FROM match 
LIMIT 20;
```

```sql
--Description: Get a sample of match-ids that belong to season-5
SELECT DISTINCT match_id 
FROM match 
WHERE season_id = 5 
LIMIT 20;
```

```sql
--Description: Inspect a few ball-by-ball rows from season-5 to see the striker (batsman) ids
SELECT DISTINCT bb.match_id,
                bb.over_id,
                bb.ball_id,
                bb.striker          AS player_id
FROM ball_by_ball AS bb
JOIN match        AS m  ON m.match_id = bb.match_id
WHERE m.season_id = 5
LIMIT 20;
```

```sql
--Description: Join ball_by_ball with batsman_scored to view the runs each striker made on each ball in season-5
SELECT DISTINCT bb.match_id,
                bb.striker          AS player_id,
                bs.runs_scored
FROM ball_by_ball   AS bb
JOIN batsman_scored AS bs ON bb.match_id  = bs.match_id
                         AND bb.over_id   = bs.over_id
                         AND bb.ball_id   = bs.ball_id
                         AND bb.innings_no= bs.innings_no
JOIN match          AS m  ON m.match_id   = bb.match_id
WHERE m.season_id = 5
LIMIT 20;
```

```sql
--Description: Compute total runs a player scored in each match during season-5
SELECT bb.striker                        AS player_id,
       bb.match_id,
       SUM(bs.runs_scored)               AS runs_in_match
FROM ball_by_ball   AS bb
JOIN batsman_scored AS bs ON bb.match_id  = bs.match_id
                         AND bb.over_id   = bs.over_id
                         AND bb.ball_id   = bs.ball_id
                         AND bb.innings_no= bs.innings_no
JOIN match          AS m  ON m.match_id   = bb.match_id
WHERE m.season_id = 5
GROUP BY bb.striker,
         bb.match_id
LIMIT 20;
```

```sql
--Description: Count how many season-5 matches each player appeared in (from player_match)
SELECT pm.player_id,
       COUNT(DISTINCT pm.match_id)       AS matches_played
FROM player_match AS pm
JOIN match        AS m  ON m.match_id = pm.match_id
WHERE m.season_id = 5
GROUP BY pm.player_id
LIMIT 20;
```

```sql
--Description: For every player, calculate total runs and matches to derive average runs per match in season-5
SELECT totals.player_id,
       totals.total_runs,
       matches.matches_played,
       ROUND(CAST(totals.total_runs AS FLOAT) / matches.matches_played, 2) AS avg_runs_per_match
FROM
     (SELECT bb.striker AS player_id,
             SUM(bs.runs_scored) AS total_runs
      FROM ball_by_ball   AS bb
      JOIN batsman_scored AS bs ON bb.match_id  = bs.match_id
                               AND bb.over_id   = bs.over_id
                               AND bb.ball_id   = bs.ball_id
                               AND bb.innings_no= bs.innings_no
      JOIN match          AS m  ON m.match_id   = bb.match_id
      WHERE m.season_id = 5
      GROUP BY bb.striker)             AS totals
JOIN
     (SELECT pm.player_id,
             COUNT(DISTINCT pm.match_id) AS matches_played
      FROM player_match AS pm
      JOIN match        AS m ON m.match_id = pm.match_id
      WHERE m.season_id = 5
      GROUP BY pm.player_id)           AS matches
ON totals.player_id = matches.player_id
LIMIT 20;
```

```sql
--Description: Final answer – top-5 players with highest average runs per match in season-5
SELECT DISTINCT p.player_name,
       ROUND(CAST(totals.total_runs AS FLOAT) / matches.matches_played, 2) AS batting_average
FROM
     (SELECT bb.striker AS player_id,
             SUM(bs.runs_scored) AS total_runs
      FROM ball_by_ball   AS bb
      JOIN batsman_scored AS bs ON bb.match_id  = bs.match_id
                               AND bb.over_id   = bs.over_id
                               AND bb.ball_id   = bs.ball_id
                               AND bb.innings_no= bs.innings_no
      JOIN match          AS m  ON m.match_id   = bb.match_id
      WHERE m.season_id = 5
      GROUP BY bb.striker)             AS totals
JOIN
     (SELECT pm.player_id,
             COUNT(DISTINCT pm.match_id) AS matches_played
      FROM player_match AS pm
      JOIN match        AS m ON m.match_id = pm.match_id
      WHERE m.season_id = 5
      GROUP BY pm.player_id)           AS matches
ON totals.player_id = matches.player_id
JOIN player AS p ON p.player_id = totals.player_id
ORDER BY batting_average DESC
LIMIT 5;
```
