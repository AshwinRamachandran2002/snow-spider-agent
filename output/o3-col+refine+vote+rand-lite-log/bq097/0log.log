```sql
--Description: We still do not know the exact field name that stores “average earnings per job”.
--             Rather than guess, this query (1) converts one Massachusetts record into a full
--             JSON string, (2) uses REGEXP_EXTRACT_ALL to capture every JSON-key that contains
--             the word “earnings”, and (3) unnests the resulting array so we can read the exact
--             spellings.  The output will list all column names that include “earnings”, making
--             it easy to spot the precise field we need for subsequent calculations.
WITH one_ma_row AS (
  SELECT TO_JSON_STRING(t) AS js
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips` AS t
  WHERE GeoName LIKE '%, MA'
  LIMIT 1
)
SELECT DISTINCT key
FROM one_ma_row,
UNNEST(
  REGEXP_EXTRACT_ALL(js, r'"([^"]*earnings[^"]*)":')
) AS key;
```
