```

```sql
--Description: 6)  Pull the 2017 average earnings per job for every Massachusetts county.  
SELECT
  GeoName,
  `avg_earnings_per_job` AS avg_earnings_2017
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2017
LIMIT 20;
```

```sql
--Description: 7)  Join the 2012 & 2017 slices side-by-side so each county is on one row.
WITH yr2012 AS (
  SELECT GeoName,
         `avg_earnings_per_job` AS avg12
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2012
),
yr2017 AS (
  SELECT GeoName,
         `avg_earnings_per_job` AS avg17
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2017
)
SELECT
  y17.GeoName,
  y12.avg12,
  y17.avg17
FROM yr2012 y12
JOIN yr2017 y17 USING (GeoName)
LIMIT 20;
```

```sql
--Description: 8)  Compute the raw dollar increase (2017 minus 2012) for each county.
WITH yr2012 AS (
  SELECT GeoName,
         `avg_earnings_per_job` AS avg12
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2012
),
yr2017 AS (
  SELECT GeoName,
         `avg_earnings_per_job` AS avg17
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2017
)
SELECT
  y17.GeoName,
  ROUND(y17.avg17 - y12.avg12, 2) AS increase_2012_to_2017
FROM yr2012 y12
JOIN yr2017 y17 USING (GeoName)
ORDER BY increase_2012_to_2017 DESC
LIMIT 20;
```

```sql
--Description: 9)  The same calculation but expressed as a percent change from the 2012 base year.
WITH yr2012 AS (
  SELECT GeoName,
         `avg_earnings_per_job` AS avg12
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2012
),
yr2017 AS (
  SELECT GeoName,
         `avg_earnings_per_job` AS avg17
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2017
)
SELECT
  y17.GeoName,
  ROUND( (y17.avg17 - y12.avg12) / y12.avg12 * 100, 2 ) AS pct_change_2012_to_2017
FROM yr2012 y12
JOIN yr2017 y17 USING (GeoName)
ORDER BY pct_change_2012_to_2017 DESC
LIMIT 20;
```

