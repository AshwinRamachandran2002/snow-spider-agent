```

```sql
--Description: Check which calendar years are available for the “Average earnings per job” series.
SELECT DISTINCT EXTRACT(YEAR FROM Year) AS yr
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE LOWER(Description) LIKE '%average earnings per job%'
ORDER BY yr
LIMIT 20;
```

```sql
--Description: Preview 2012 observations of “Average earnings per job” for Massachusetts counties.
SELECT Year,
       GeoName,
       value   -- numeric column that stores the metric
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2012
  AND LOWER(Description) LIKE '%average earnings per job%'
LIMIT 20;
```

```sql
--Description: Preview 2017 observations of the same metric for the same counties.
SELECT Year,
       GeoName,
       value
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2017
  AND LOWER(Description) LIKE '%average earnings per job%'
LIMIT 20;
```

```sql
--Description: Place 2012 and 2017 numbers side-by-side for every Massachusetts county (conditional aggregation).
SELECT GeoName,
       AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN value END) AS avg12,
       AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN value END) AS avg17
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND LOWER(Description) LIKE '%average earnings per job%'
GROUP BY GeoName
LIMIT 20;
```

```sql
--Description: Calculate the raw increase between 2012 and 2017 for each county (still showing both years for context).
SELECT GeoName,
       AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN value END) -
       AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN value END) AS increase_12_17
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND LOWER(Description) LIKE '%average earnings per job%'
GROUP BY GeoName
LIMIT 20;
```

```sql
--Description: A self-join version—pull just the two years you need and subtract.
WITH earnings AS (
  SELECT GeoName,
         EXTRACT(YEAR FROM Year) AS yr,
         value
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND LOWER(Description) LIKE '%average earnings per job%'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
)
SELECT e2017.GeoName,
       e2017.value - e2012.value AS increase_12_17
FROM earnings AS e2012
JOIN earnings AS e2017
  USING(GeoName)
WHERE e2012.yr = 2012
  AND e2017.yr = 2017
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – show the increase in average earnings per job from 2012 → 2017
--               for every Massachusetts county, ordered from largest to smallest gain.
SELECT
  GeoName                                        AS county_ma,
  ROUND(
        AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN value END) -
        AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN value END)
       , 2)                                      AS increase_avg_earnings_per_job_2012_2017
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND LOWER(Description) LIKE '%average earnings per job%'
GROUP BY GeoName
ORDER BY increase_avg_earnings_per_job_2012_2017 DESC
LIMIT 20;
```
