WHERE  GeoName LIKE '%, MA'
LIMIT 20;
```

```sql
-- Description: 5) Pull only the 2012 average earnings per job for Massachusetts counties.           
SELECT GeoName,
       avg_earnings_per_job AS avg_earnings_2012
FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE  GeoName LIKE '%, MA'
  AND  EXTRACT(YEAR FROM Year) = 2012
LIMIT 20;
```

```sql
-- Description: 6) Pull only the 2017 average earnings per job for Massachusetts counties.           
SELECT GeoName,
       avg_earnings_per_job AS avg_earnings_2017
FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE  GeoName LIKE '%, MA'
  AND  EXTRACT(YEAR FROM Year) = 2017
LIMIT 20;
```

```sql
-- Description: 7) Combine (5) and (6) to place 2012 and 2017 values side-by-side for each county.           
WITH earnings_2012 AS (
  SELECT GeoName,
         avg_earnings_per_job AS avg_earnings_2012
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
    AND  EXTRACT(YEAR FROM Year) = 2012
),
earnings_2017 AS (
  SELECT GeoName,
         avg_earnings_per_job AS avg_earnings_2017
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
    AND  EXTRACT(YEAR FROM Year) = 2017
)
SELECT e17.GeoName,
       e12.avg_earnings_2012,
       e17.avg_earnings_2017
FROM   earnings_2012 e12
JOIN   earnings_2017 e17
ON     e12.GeoName = e17.GeoName
LIMIT 20;
```

```sql
-- Description: 8) Compute the increase (2017 – 2012) in average earnings per job for every MA county.           
WITH earnings_2012 AS (
  SELECT GeoName,
         avg_earnings_per_job AS avg_earnings_2012
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
    AND  EXTRACT(YEAR FROM Year) = 2012
),
earnings_2017 AS (
  SELECT GeoName,
         avg_earnings_per_job AS avg_earnings_2017
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
    AND  EXTRACT(YEAR FROM Year) = 2017
)
SELECT e17.GeoName,
       e12.avg_earnings_2012,
       e17.avg_earnings_2017,
       (e17.avg_earnings_2017 - e12.avg_earnings_2012) AS increase_2012_to_2017
FROM   earnings_2012 e12
JOIN   earnings_2017 e17
ON     e12.GeoName = e17.GeoName
ORDER  BY increase_2012_to_2017 DESC
LIMIT 20;
```

```sql
-- Description: 9) Same as (8) but sorted alphabetically, useful for cross-checking against an external list.           
WITH earnings_2012 AS (
  SELECT GeoName,
         avg_earnings_per_job AS avg_earnings_2012
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
    AND  EXTRACT(YEAR FROM Year) = 2012
),
earnings_2017 AS (
  SELECT GeoName,
         avg_earnings_per_job AS avg_earnings_2017
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
    AND  EXTRACT(YEAR FROM Year) = 2017
)
SELECT e17.GeoName,
       (e17.avg_earnings_2017 - e12.avg_earnings_2012) AS increase_2012_to_2017
FROM   earnings_2012 e12
JOIN   earnings_2017 e17
ON     e12.GeoName = e17.GeoName
ORDER  BY e17.GeoName
LIMIT 20;
```

```sql
-- Description: 10) FINAL ANSWER – complete list of Massachusetts counties with the 2012➜2017 increase
--                in average earnings per job, ordered highest to lowest.           
WITH earnings AS (
  SELECT GeoName,
         EXTRACT(YEAR FROM Year) AS yr,
         avg_earnings_per_job
  FROM   `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE  GeoName LIKE '%, MA'
        AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
)
SELECT  GeoName,
        MAX(IF(yr = 2012, avg_earnings_per_job, NULL)) AS avg_earnings_2012,
        MAX(IF(yr = 2017, avg_earnings_per_job, NULL)) AS avg_earnings_2017,
        MAX(IF(yr = 2017, avg_earnings_per_job, NULL)) -
        MAX(IF(yr = 2012, avg_earnings_per_job, NULL)) AS increase_2012_to_2017
FROM    earnings
GROUP   BY GeoName
ORDER   BY increase_2012_to_2017 DESC
LIMIT 20;
```
