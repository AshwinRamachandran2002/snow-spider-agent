```sql
--Description: We keep guessing the wrong field name (“Average_wage_per_job” / “Average_earnings_per_job”).
--Because BigQuery is case-sensitive, inspect one Massachusetts row as JSON, then
--extract every key that contains “earn” or “wage”.  That list will reveal the exact
--column name to use for “average earnings per job”.
WITH sample_row AS (
  SELECT TO_JSON_STRING(t) AS js
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips` AS t
  WHERE GeoName LIKE '%, MA'
  LIMIT 1
)
SELECT DISTINCT
  REPLACE(REGEXP_EXTRACT(kv, r'"([^"]+)":'), '"', '') AS column_name
FROM sample_row,
     UNNEST(REGEXP_EXTRACT_ALL(js, r'"[^"]+":')) AS kv
WHERE LOWER(kv) LIKE '%earn%' OR LOWER(kv) LIKE '%wage%'
ORDER BY column_name;
```
