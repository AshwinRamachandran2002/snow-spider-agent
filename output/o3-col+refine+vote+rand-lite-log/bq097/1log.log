```sql
--Description: 6) Pull 2017 Massachusetts rows with the same measure
SELECT 
  GeoName,
  Year,
  average_earnings_per_job
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2017
LIMIT 20;
```

```sql
--Description: 7) Compute the increase (= 2017 value – 2012 value) for each Massachusetts region
SELECT 
  t17.GeoName,
  t12.average_earnings_per_job AS avg_earnings_2012,
  t17.average_earnings_per_job AS avg_earnings_2017,
  (t17.average_earnings_per_job - t12.average_earnings_per_job) AS earnings_increase
FROM (
  SELECT GeoName, average_earnings_per_job
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2012
) AS t12
JOIN (
  SELECT GeoName, average_earnings_per_job
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2017
) AS t17
USING (GeoName)
LIMIT 20;
```

```sql
--Description: 8) Same as #7 but sorted by the largest increase
SELECT 
  t17.GeoName,
  t17.average_earnings_per_job - t12.average_earnings_per_job AS earnings_increase
FROM (
  SELECT GeoName, average_earnings_per_job
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2012
) AS t12
JOIN (
  SELECT GeoName, average_earnings_per_job
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) = 2017
) AS t17
USING (GeoName)
ORDER BY earnings_increase DESC
LIMIT 20;
```

```sql
--Description: 9) Another way – use window functions to get both years in one scan
WITH ma_earn AS (
  SELECT
    GeoName,
    EXTRACT(YEAR FROM Year) AS yr,
    average_earnings_per_job
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
)
SELECT 
  GeoName,
  MAX(CASE WHEN yr = 2012 THEN average_earnings_per_job END) AS avg_earnings_2012,
  MAX(CASE WHEN yr = 2017 THEN average_earnings_per_job END) AS avg_earnings_2017,
  MAX(CASE WHEN yr = 2017 THEN average_earnings_per_job END) -
  MAX(CASE WHEN yr = 2012 THEN average_earnings_per_job END) AS earnings_increase
FROM ma_earn
GROUP BY GeoName
ORDER BY earnings_increase DESC
LIMIT 20;
```

```sql
--Description: 10) Final concise answer – increase in average earnings per job (2017 – 2012) for every MA geography
SELECT 
  GeoName,
  AVG_2012,
  AVG_2017,
  AVG_2017 - AVG_2012 AS earnings_increase
FROM (
  SELECT 
    GeoName,
    MAX(IF(EXTRACT(YEAR FROM Year) = 2012, average_earnings_per_job, NULL)) AS AVG_2012,
    MAX(IF(EXTRACT(YEAR FROM Year) = 2017, average_earnings_per_job, NULL)) AS AVG_2017
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
  GROUP BY GeoName
)
ORDER BY earnings_increase DESC
LIMIT 20;
```
