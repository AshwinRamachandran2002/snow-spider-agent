--Description:
--Task:  For every Massachusetts geography (GeoName ends with “, MA”) determine
--       how much BEA’s county‐level metric `Avg_earnings_per_job`
--       increased from calendar year 2012 to calendar year 2017.
--
--Reasoning steps embedded in CTEs:
-- 1.  CTE `ma_rows`  – keep only Massachusetts counties and the two target
--                      years, retaining the metric column.
-- 2.  CTE `pivoted`  – convert long form (year as rows) into wide form
--                      (separate columns for 2012 and 2017) so we can
--                      subtract directly.
-- 3.  Final SELECT  – expose both year values and compute the increase.
WITH ma_rows AS (
  SELECT
    GeoName,
    EXTRACT(YEAR FROM Year)            AS yr,
    Avg_earnings_per_job               AS earnings
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'                 -- Massachusetts only
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
),
pivoted AS (
  SELECT
    GeoName,
    MAX(CASE WHEN yr = 2012 THEN earnings END) AS earnings_2012,
    MAX(CASE WHEN yr = 2017 THEN earnings END) AS earnings_2017
  FROM ma_rows
  GROUP BY GeoName
)
SELECT
  GeoName,
  earnings_2012,
  earnings_2017,
  earnings_2017 - earnings_2012        AS increase_2012_2017
FROM pivoted
ORDER BY GeoName;
