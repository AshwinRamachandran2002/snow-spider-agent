LIMIT 20;
```

```sql
--Description: Pivot 2012 and 2017 values for every MA county
-- (useful to verify both years exist before computing differences).
WITH ma AS (
  SELECT `GeoName`,
         EXTRACT(YEAR FROM `Year`) AS yr,
         `value`
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE `GeoName` LIKE '%, MA'
    AND LOWER(`Description`) LIKE '%average earnings per job%'
    AND EXTRACT(YEAR FROM `Year`) IN (2012, 2017)
)
SELECT `GeoName`,
       MAX(CASE WHEN yr = 2012 THEN value END) AS earnings_2012,
       MAX(CASE WHEN yr = 2017 THEN value END) AS earnings_2017
FROM ma
GROUP BY `GeoName`
LIMIT 20;
```

```sql
--Description: Compute the absolute increase (2017 – 2012) in average earnings
-- for each Massachusetts geography and sort by the largest gains.
WITH ma AS (
  SELECT `GeoName`,
         EXTRACT(YEAR FROM `Year`) AS yr,
         `value`
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE `GeoName` LIKE '%, MA'
    AND LOWER(`Description`) LIKE '%average earnings per job%'
    AND EXTRACT(YEAR FROM `Year`) IN (2012, 2017)
),
pivot AS (
  SELECT `GeoName`,
         MAX(CASE WHEN yr = 2012 THEN value END) AS earnings_2012,
         MAX(CASE WHEN yr = 2017 THEN value END) AS earnings_2017
  FROM ma
  GROUP BY `GeoName`
)
SELECT `GeoName`,
       earnings_2017 - earnings_2012 AS increase_2012_2017
FROM pivot
ORDER BY increase_2012_2017 DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – report 2012 value, 2017 value, and the
-- change in average earnings per job for every Massachusetts geography.
WITH ma AS (
  SELECT `GeoName`,
         EXTRACT(YEAR FROM `Year`) AS yr,
         `value`
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE `GeoName` LIKE '%, MA'
    AND LOWER(`Description`) LIKE '%average earnings per job%'
    AND EXTRACT(YEAR FROM `Year`) IN (2012, 2017)
),
pivot AS (
  SELECT `GeoName`,
         MAX(CASE WHEN yr = 2012 THEN value END) AS earnings_2012,
         MAX(CASE WHEN yr = 2017 THEN value END) AS earnings_2017
  FROM ma
  GROUP BY `GeoName`
)
SELECT `GeoName`,
       earnings_2012,
       earnings_2017,
       earnings_2017 - earnings_2012 AS increase_2012_2017
FROM pivot
ORDER BY `GeoName`
LIMIT 1000;
```
