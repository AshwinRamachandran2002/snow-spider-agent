```

```sql
--Description: Inspect 2012 vs 2017 side-by-side for a single sample county
-- (Bristol, MA) to make sure the values align correctly.
SELECT `GeoName`,
       EXTRACT(YEAR FROM `Year`) AS year,
       `value`
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE `GeoName` = 'Bristol, MA'
  AND LOWER(`Description`) LIKE '%average earnings per job%'
  AND EXTRACT(YEAR FROM `Year`) IN (2012, 2017)
