  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
),
pivot AS (
  SELECT
    GeoName,
    MAX(CASE WHEN yr = 2012 THEN val END) AS earnings_2012,
    MAX(CASE WHEN yr = 2017 THEN val END) AS earnings_2017
  FROM ma
  GROUP BY GeoName
)
SELECT
