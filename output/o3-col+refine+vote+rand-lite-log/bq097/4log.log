```sql
--Description: 1) Quick peek at the raw data to learn the column layout. 
SELECT *
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
LIMIT 20;
```

```sql
--Description: 2) Inspect only Massachusetts records (GeoName ending in ", MA") to see which economic-value columns are present.  
SELECT *
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
LIMIT 20;
```

```sql
--Description: 3) List every Massachusetts county (removes duplicates).  
SELECT DISTINCT GeoName
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
ORDER BY GeoName
LIMIT 20;
```

```sql
--Description: 4) Check 2012 values of the “Average earnings per job” measure (assumed column name: AvgEarningsPerJob) for MA counties.  
SELECT Year,
       GeoName,
       AvgEarningsPerJob
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2012
LIMIT 20;
```

```sql
--Description: 5) Same check for 2017 to confirm data presence and units.  
SELECT Year,
       GeoName,
       AvgEarningsPerJob
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2017
LIMIT 20;
```

```sql
--Description: 6) Join 2012 and 2017 rows side-by-side for every MA county to preview the growth.  
SELECT a.GeoName,
       a.AvgEarningsPerJob  AS AvgEarnings2012,
       b.AvgEarningsPerJob  AS AvgEarnings2017,
       (b.AvgEarningsPerJob - a.AvgEarningsPerJob) AS IncreaseAmt
FROM `bigquery-public-data.sdoh_bea_cainc30.fips` AS a
JOIN `bigquery-public-data.sdoh_bea_cainc30.fips` AS b
  ON a.GeoName = b.GeoName
WHERE a.GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM a.Year) = 2012
  AND EXTRACT(YEAR FROM b.Year) = 2017
LIMIT 20;
```

```sql
--Description: 7) Achieve the same result with conditional aggregation (no self-join).  
SELECT GeoName,
       AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END) AS AvgEarnings2012,
       AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) AS AvgEarnings2017,
       (AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) -
        AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END))  AS IncreaseAmt
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
GROUP BY GeoName
LIMIT 20;
```

```sql
--Description: 8) Add percentage growth for a clearer picture (still capped at 20 rows).  
SELECT GeoName,
       AvgEarnings2012,
       AvgEarnings2017,
       IncreaseAmt,
       SAFE_DIVIDE(IncreaseAmt, AvgEarnings2012) * 100 AS PctIncrease
FROM (
  SELECT GeoName,
         AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END) AS AvgEarnings2012,
         AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) AS AvgEarnings2017,
         (AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) -
          AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END))  AS IncreaseAmt
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
  GROUP BY GeoName
)
ORDER BY IncreaseAmt DESC
LIMIT 20;
```

```sql
--Description: 9) Identify the top-five counties with the largest dollar increase in average earnings per job (descending order).  
SELECT GeoName,
       AvgEarnings2012,
       AvgEarnings2017,
       IncreaseAmt
FROM (
  SELECT GeoName,
         AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END) AS AvgEarnings2012,
         AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) AS AvgEarnings2017,
         (AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) -
          AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END))  AS IncreaseAmt
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
  GROUP BY GeoName
)
ORDER BY IncreaseAmt DESC
LIMIT 5;
```

```sql
--Description: 10) FINAL – Deliver the year-to-year increase (2012→2017) in average earnings per job for every Massachusetts county.  
SELECT GeoName                                               AS County,
       ROUND(AvgEarnings2012, 2)                            AS Avg_Earnings_2012,
       ROUND(AvgEarnings2017, 2)                            AS Avg_Earnings_2017,
       ROUND(IncreaseAmt, 2)                                AS Increase_2012_to_2017
FROM (
  SELECT GeoName,
         AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END) AS AvgEarnings2012,
         AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) AS AvgEarnings2017,
         (AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2017 THEN AvgEarningsPerJob END) -
          AVG(CASE WHEN EXTRACT(YEAR FROM Year)=2012 THEN AvgEarningsPerJob END))  AS IncreaseAmt
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
  GROUP BY GeoName
)
ORDER BY County
LIMIT 20;
```
