```

```sql
--Description: Inspect the column that stores average earnings per job for one sample MA county.  
SELECT
  Year,
  GeoName,
  average_earnings_per_job_dollars
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName = 'Bristol, MA'
ORDER BY Year
LIMIT 20;
```

```sql
--Description: Obtain 2012 average-earnings-per-job values for every MA county.  
SELECT
  GeoName,
  average_earnings_per_job_dollars
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2012
ORDER BY average_earnings_per_job_dollars DESC
LIMIT 20;
```

```sql
--Description: Obtain 2017 average-earnings-per-job values for every MA county.  
SELECT
  GeoName,
  average_earnings_per_job_dollars
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) = 2017
ORDER BY average_earnings_per_job_dollars DESC
LIMIT 20;
```

```sql
--Description: Calculate the 2012 vs 2017 change for MA counties with conditional aggregation.  
SELECT
  GeoName,
  MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2012 THEN average_earnings_per_job_dollars END) AS avg_2012,
  MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2017 THEN average_earnings_per_job_dollars END) AS avg_2017,
  (MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2017 THEN average_earnings_per_job_dollars END) -
   MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2012 THEN average_earnings_per_job_dollars END)
  ) AS increase_2012_2017
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
GROUP BY GeoName
LIMIT 20;
```

```sql
--Description: Same as above but ordered by the size of the increase (largest to smallest).  
SELECT
  GeoName,
  (MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2017 THEN average_earnings_per_job_dollars END) -
   MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2012 THEN average_earnings_per_job_dollars END)
  ) AS increase_2012_2017
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
GROUP BY GeoName
ORDER BY increase_2012_2017 DESC
LIMIT 20;
```

```sql
--Description: Return only counties whose earnings per job rose (positive change) between 2012 & 2017.  
WITH ma AS (
  SELECT
    GeoName,
    MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2012 THEN average_earnings_per_job_dollars END) AS avg_2012,
    MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2017 THEN average_earnings_per_job_dollars END) AS avg_2017
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
  GROUP BY GeoName
)
SELECT
  GeoName,
  avg_2012,
  avg_2017,
  (avg_2017 - avg_2012) AS increase_2012_2017
FROM ma
WHERE (avg_2017 - avg_2012) > 0
ORDER BY increase_2012_2017 DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – amount the average earnings per job increased from 2012 to 2017 for each Massachusetts county.  
SELECT
  GeoName,
  (MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2017 THEN average_earnings_per_job_dollars END) -
   MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2012 THEN average_earnings_per_job_dollars END)
  ) AS increase_avg_earnings_per_job_2012_to_2017
FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
WHERE GeoName LIKE '%, MA'
  AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
GROUP BY GeoName
ORDER BY increase_avg_earnings_per_job_2012_to_2017 DESC
LIMIT 20;
```
