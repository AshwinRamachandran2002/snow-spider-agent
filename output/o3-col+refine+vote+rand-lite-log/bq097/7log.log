Query:
--Description: List only counties whose average earnings per job rose between 2012 & 2017.  
WITH ma AS (
  SELECT
    GeoName,
    MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2012 THEN Earnings_per_job_avg END) AS avg_2012,
    MAX(CASE WHEN EXTRACT(YEAR FROM Year) = 2017 THEN Earnings_per_job_avg END) AS avg_2017
  FROM `bigquery-public-data.sdoh_bea_cainc30.fips`
  WHERE GeoName LIKE '%, MA'
    AND EXTRACT(YEAR FROM Year) IN (2012, 2017)
  GROUP BY GeoName
)
SELECT
  GeoName,
  avg_2012,
  avg_2017,
  (avg_2017 - avg_2012) AS increase_2012_2017
FROM ma
WHERE (avg_2017 - avg_2012) > 0
ORDER BY increase_2012_2017 DESC
LIMIT 20
