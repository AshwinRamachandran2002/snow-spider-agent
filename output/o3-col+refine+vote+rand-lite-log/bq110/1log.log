WHERE `CoC_Number` LIKE 'NY-%'
LIMIT 20;
```

```sql
--Description: 2) See which PIT count years are available for New York rows  
SELECT DISTINCT 
  `Count_Year` 
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
--Description: 3) Preview 2012 veteran-homelessness numbers for New York CoCs  
SELECT 
  `CoC_Number`,
  `CoC_Name`,
  `Homeless_Veterans`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2012
LIMIT 20;
```

```sql
--Description: 4) Preview 2018 veteran-homelessness numbers for the same state  
SELECT 
  `CoC_Number`,
  `CoC_Name`,
  `Homeless_Veterans`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2018
LIMIT 20;
```

```sql
--Description: 5) Pull both 2012 and 2018 rows side-by-side (still limited)  
SELECT
  `CoC_Number`,
  `CoC_Name`,
  `Count_Year`,
  `Homeless_Veterans`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
ORDER BY `CoC_Number`, `Count_Year`
LIMIT 20;
```

```sql
--Description: 6) Aggregate 2012 totals only—verify there are no duplicates  
SELECT
  `CoC_Number`,
  SUM(`Homeless_Veterans`) AS vets_2012
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2012
GROUP BY `CoC_Number`
LIMIT 20;
```

```sql
--Description: 7) Aggregate 2018 totals only—same validation step  
SELECT
  `CoC_Number`,
  SUM(`Homeless_Veterans`) AS vets_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2018
GROUP BY `CoC_Number`
LIMIT 20;
```

```sql
--Description: 8) Combine 2012 and 2018 with conditional aggregation (no change calc yet)  
SELECT
  `CoC_Number`,
  MAX(IF(`Count_Year` = 2012, `Homeless_Veterans`, NULL)) AS vets_2012,
  MAX(IF(`Count_Year` = 2018, `Homeless_Veterans`, NULL)) AS vets_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`
LIMIT 20;
```

```sql
--Description: 9) Same as above but also bring the CoC name (distinct by MAX)  
SELECT
  `CoC_Number`,
  MAX(`CoC_Name`) AS CoC_Name,
  MAX(IF(`Count_Year` = 2012, `Homeless_Veterans`, NULL)) AS vets_2012,
  MAX(IF(`Count_Year` = 2018, `Homeless_Veterans`, NULL)) AS vets_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`
HAVING vets_2012 IS NOT NULL 
   AND vets_2018 IS NOT NULL
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – change in homeless-veteran counts from 2012→2018 for every NY CoC that has data in both years  
SELECT
  `CoC_Number`,
  MAX(`CoC_Name`)                         AS CoC_Name,
  MAX(IF(`Count_Year` = 2012, `Homeless_Veterans`, NULL)) AS vets_2012,
  MAX(IF(`Count_Year` = 2018, `Homeless_Veterans`, NULL)) AS vets_2018,
  MAX(IF(`Count_Year` = 2018, `Homeless_Veterans`, NULL)) -
  MAX(IF(`Count_Year` = 2012, `Homeless_Veterans`, NULL)) AS change_2012_to_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`
HAVING vets_2012 IS NOT NULL
   AND vets_2018 IS NOT NULL
ORDER BY `CoC_Number`
LIMIT 20;
```
