SELECT DISTINCT `CoC_Number`, `CoC_Name`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
LIMIT 20;
```

```sql
--Description: Preview 2012 veteran counts for New York CoCs.  
SELECT `CoC_Number`, `CoC_Name`, `Homeless_Veterans`, `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2012
LIMIT 20;
```

```sql
--Description: Preview 2018 veteran counts for New York CoCs.  
SELECT `CoC_Number`, `CoC_Name`, `Homeless_Veterans`, `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2018
LIMIT 20;
```

```sql
--Description: Check which years have data for New York CoCs and how many rows per year.  
SELECT `Count_Year`, COUNT(*) AS rows_in_year
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
GROUP BY `Count_Year`
ORDER BY `Count_Year`
LIMIT 20;
```

```sql
--Description: Produce one row per CoC with separate columns for 2012 and 2018 veteran counts.  
SELECT
  `CoC_Number`,
  MAX(CASE WHEN Count_Year = 2012 THEN Homeless_Veterans END) AS vets_2012,
  MAX(CASE WHEN Count_Year = 2018 THEN Homeless_Veterans END) AS vets_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
GROUP BY `CoC_Number`
LIMIT 20;
```

```sql
--Description: Filter to CoCs that have data in BOTH 2012 and 2018, then compute the change.  
SELECT
  `CoC_Number`,
  MAX(CASE WHEN Count_Year = 2012 THEN Homeless_Veterans END) AS vets_2012,
  MAX(CASE WHEN Count_Year = 2018 THEN Homeless_Veterans END) AS vets_2018,
  MAX(CASE WHEN Count_Year = 2018 THEN Homeless_Veterans END) -
  MAX(CASE WHEN Count_Year = 2012 THEN Homeless_Veterans END) AS change_2012_to_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
GROUP BY `CoC_Number`
HAVING vets_2012 IS NOT NULL AND vets_2018 IS NOT NULL
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – change in homeless-veteran counts (2018 minus 2012) for each New York CoC that has data in both years, ordered by greatest decrease.  
SELECT
  `CoC_Number`,
  `CoC_Name`,
  vets_2012,
  vets_2018,
  vets_2018 - vets_2012 AS change_2012_to_2018
FROM (
  SELECT
    `CoC_Number`,
    MAX(`CoC_Name`) AS `CoC_Name`,
    MAX(CASE WHEN Count_Year = 2012 THEN Homeless_Veterans END) AS vets_2012,
    MAX(CASE WHEN Count_Year = 2018 THEN Homeless_Veterans END) AS vets_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE `CoC_Number` LIKE 'NY-%'
  GROUP BY `CoC_Number`
)
WHERE vets_2012 IS NOT NULL AND vets_2018 IS NOT NULL
ORDER BY change_2012_to_2018 ASC   -- negative means a reduction
LIMIT 20;
```
