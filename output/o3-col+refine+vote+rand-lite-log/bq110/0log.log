```sql
--Description: 4) Distinct CoC regions in NY that reported in 2018.
SELECT DISTINCT CoC_Number, CoC_Name
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE CoC_Number LIKE 'NY-%' AND Count_Year = 2018
LIMIT 20;
```

```sql
--Description: 5) NY CoCs that have data in BOTH 2012 and 2018.
SELECT DISTINCT a.CoC_Number, a.CoC_Name
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS a
JOIN `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS b
  ON a.CoC_Number = b.CoC_Number
WHERE a.CoC_Number LIKE 'NY-%'
  AND a.Count_Year = 2012
  AND b.Count_Year = 2018
LIMIT 20;
```

```sql
--Description: 6) Aggregate veteran counts for those NY CoCs in 2012.
SELECT CoC_Number,
       ANY_VALUE(CoC_Name) AS CoC_Name,
       SUM(Homeless_Veterans) AS vets_2012
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE CoC_Number LIKE 'NY-%' AND Count_Year = 2012
GROUP BY CoC_Number
LIMIT 20;
```

```sql
--Description: 7) Aggregate veteran counts for those NY CoCs in 2018.
SELECT CoC_Number,
       ANY_VALUE(CoC_Name) AS CoC_Name,
       SUM(Homeless_Veterans) AS vets_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE CoC_Number LIKE 'NY-%' AND Count_Year = 2018
GROUP BY CoC_Number
LIMIT 20;
```

```sql
--Description: 8) Final answer – change in homeless-veteran counts (2018 minus 2012)
--               for each NY CoC that has data in BOTH years.
SELECT
  a.CoC_Number,
  a.CoC_Name,
  b.vets_2018,
  a.vets_2012,
  b.vets_2018 - a.vets_2012 AS change_2012_to_2018
FROM (
  SELECT CoC_Number,
         ANY_VALUE(CoC_Name) AS CoC_Name,
         SUM(Homeless_Veterans) AS vets_2012
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE CoC_Number LIKE 'NY-%' AND Count_Year = 2012
  GROUP BY CoC_Number
) AS a
JOIN (
  SELECT CoC_Number,
         SUM(Homeless_Veterans) AS vets_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE CoC_Number LIKE 'NY-%' AND Count_Year = 2018
  GROUP BY CoC_Number
) AS b
ON a.CoC_Number = b.CoC_Number
ORDER BY change_2012_to_2018 DESC
LIMIT 20;
```
