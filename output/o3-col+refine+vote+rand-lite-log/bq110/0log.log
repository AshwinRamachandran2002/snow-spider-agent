  GROUP BY CoC_Number
) AS a
JOIN (
  SELECT CoC_Number,
         SUM(Homeless_Veterans) AS vets_2018
  FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
  WHERE CoC_Number LIKE 'NY-%' AND Count_Year = 2018
  GROUP BY CoC_Number
) AS b
ON a.CoC_Number = b.CoC_Number
ORDER BY change_2012_to_2018 DESC
LIMIT 20;
