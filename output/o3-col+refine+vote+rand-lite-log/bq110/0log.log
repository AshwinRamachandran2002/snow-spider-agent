  CoC_Number,
  ANY_VALUE(CoC_Name) AS CoC_Name,
  SUM(IF(Count_Year = 2012, Homeless_Veterans, 0)) AS vets_2012,
  SUM(IF(Count_Year = 2018, Homeless_Veterans, 0)) AS vets_2018,
  SUM(IF(Count_Year = 2018, Homeless_Veterans, 0)) -
