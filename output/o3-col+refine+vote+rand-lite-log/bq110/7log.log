```sql
--Description: 6) Aggregate the homeless-veteran totals for New York CoCs for 2012 and 2018 separately (first 20).
SELECT `CoC_Number`,
       `Count_Year`,
       SUM(`Homeless_Veterans`) AS vets_total
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`, `Count_Year`
ORDER BY `CoC_Number`, `Count_Year`
LIMIT 20;
```

```sql
--Description: 7) FINAL ANSWER – For every New York CoC that has data in both 2012 and 2018,
--               show the change in the number of homeless veterans (2018 minus 2012).
SELECT
  `CoC_Number`,
  ANY_VALUE(`CoC_Name`) AS `CoC_Name`,
  SUM(CASE WHEN `Count_Year` = 2018 THEN `Homeless_Veterans` END) AS vets_2018,
  SUM(CASE WHEN `Count_Year` = 2012 THEN `Homeless_Veterans` END) AS vets_2012,
  SUM(CASE WHEN `Count_Year` = 2018 THEN `Homeless_Veterans` END)
  - SUM(CASE WHEN `Count_Year` = 2012 THEN `Homeless_Veterans` END) AS change_2012_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`
HAVING vets_2018 IS NOT NULL AND vets_2012 IS NOT NULL
ORDER BY change_2012_2018 DESC;
```
