Query:
-- Description: Compute the change (2018 minus 2012) in homeless veterans for each qualifying NY CoC (first 20 rows).
SELECT  a.`CoC_Number`,
        a.`CoC_Name`,
        a.`Homeless_Veterans` AS veterans_2012,
        b.`Homeless_Veterans` AS veterans_2018,
        b.`Homeless_Veterans` - a.`Homeless_Veterans` AS change_2012_to_2018
FROM  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` a
JOIN  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` b
      ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`Count_Year` = 2012
  AND b.`Count_Year` = 2018
  AND LEFT(a.`CoC_Number`, 2) = 'NY'
LIMIT 20;
