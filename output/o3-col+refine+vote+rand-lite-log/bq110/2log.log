```sql
-- Description: Show 20 distinct Continuum-of-Care (CoC) areas whose codes start with “NY-”, i.e. New York.
SELECT DISTINCT `CoC_Number`, `CoC_Name`
FROM   `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE  LEFT(`CoC_Number`, 2) = 'NY'
LIMIT 20;
```

```sql
-- Description: Inspect 2012 homeless-veteran counts for the first 20 New York CoCs.
SELECT `CoC_Number`,
       `CoC_Name`,
       `Homeless_Veterans`,
       `Count_Year`
FROM   `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE  LEFT(`CoC_Number`, 2) = 'NY'
  AND  `Count_Year` = 2012
LIMIT 20;
```

```sql
-- Description: Inspect 2018 homeless-veteran counts for the first 20 New York CoCs.
SELECT `CoC_Number`,
       `CoC_Name`,
       `Homeless_Veterans`,
       `Count_Year`
FROM   `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE  LEFT(`CoC_Number`, 2) = 'NY'
  AND  `Count_Year` = 2018
LIMIT 20;
```

```sql
-- Description: Identify New York CoCs that have BOTH 2012 and 2018 data (first 20 rows).
SELECT DISTINCT `CoC_Number`
FROM   `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE  LEFT(`CoC_Number`, 2) = 'NY'
  AND  `Count_Year` IN (2012, 2018)
GROUP  BY `CoC_Number`
HAVING COUNT(DISTINCT `Count_Year`) = 2
LIMIT 20;
```

```sql
-- Description: Retrieve 2012 & 2018 veteran counts side-by-side for NY CoCs with both years (first 20 rows).
SELECT  a.`CoC_Number`,
        a.`CoC_Name`,
        a.`Homeless_Veterans` AS veterans_2012,
        b.`Homeless_Veterans` AS veterans_2018
FROM  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` a
JOIN  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` b
      ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`Count_Year` = 2012
  AND b.`Count_Year` = 2018
  AND LEFT(a.`CoC_Number`, 2) = 'NY'
LIMIT 20;
```

```sql
-- Description: Compute the change (2018 minus 2012) in homeless veterans for each qualifying NY CoC (first 20 rows).
SELECT  a.`CoC_Number`,
        a.`CoC_Name`,
        a.`Homeless_Veterans` AS veterans_2012,
        b.`Homeless_Veterans` AS veterans_2018,
        b.`Homeless_Veterans` - a.`Homeless_Veterans` AS change_2012_to_2018
FROM  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` a
JOIN  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` b
      ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`Count_Year` = 2012
  AND b.`Count_Year` = 2018
  AND LEFT(a.`CoC_Number`, 2) = 'NY'
LIMIT 20;
```

```sql
-- Description: Summarise how many NY CoCs experienced an increase, decrease, or no change (first 20 rows of aggregation).
SELECT
  CASE
    WHEN change > 0 THEN 'Increase'
    WHEN change < 0 THEN 'Decrease'
    ELSE 'No Change'
  END AS change_category,
  COUNT(*) AS coc_count
FROM (
  SELECT 
    b.`Homeless_Veterans` - a.`Homeless_Veterans` AS change
  FROM  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` a
  JOIN  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` b
        ON a.`CoC_Number` = b.`CoC_Number`
  WHERE a.`Count_Year` = 2012
    AND b.`Count_Year` = 2018
    AND LEFT(a.`CoC_Number`, 2) = 'NY'
)
GROUP BY change_category
LIMIT 20;
```

```sql
-- Description: FINAL ANSWER – report the change for every New York CoC that has both 2012 and 2018 data.
SELECT  a.`CoC_Number`,
        a.`CoC_Name`,
        a.`Homeless_Veterans` AS homeless_veterans_2012,
        b.`Homeless_Veterans` AS homeless_veterans_2018,
        b.`Homeless_Veterans` - a.`Homeless_Veterans` AS change_in_homeless_veterans
FROM  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` a
JOIN  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` b
      ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`Count_Year` = 2012
  AND b.`Count_Year` = 2018
  AND LEFT(a.`CoC_Number`, 2) = 'NY';
```
