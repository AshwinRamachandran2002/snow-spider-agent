Query:
-- Description: Summarise how many NY CoCs experienced an increase, decrease, or no change (first 20 rows of aggregation).
SELECT
  CASE
    WHEN change > 0 THEN 'Increase'
    WHEN change < 0 THEN 'Decrease'
    ELSE 'No Change'
  END AS change_category,
  COUNT(*) AS coc_count
FROM (
  SELECT 
    b.`Homeless_Veterans` - a.`Homeless_Veterans` AS change
  FROM  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` a
  JOIN  `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` b
        ON a.`CoC_Number` = b.`CoC_Number`
  WHERE a.`Count_Year` = 2012
    AND b.`Count_Year` = 2018
    AND LEFT(a.`CoC_Number`, 2) = 'NY'
)
GROUP BY change_category
LIMIT 20;
