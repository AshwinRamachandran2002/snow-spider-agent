```

```sql
-- 5. Homeless veterans counted in 2018 for New York CoCs
SELECT `CoC_Number`, `CoC_Name`, `Homeless_Veterans`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2018
ORDER BY `CoC_Number`
LIMIT 20;
```

```sql
-- 6. Identify NY CoCs that have data in BOTH 2012 and 2018
SELECT `CoC_Number`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`
HAVING COUNT(DISTINCT `Count_Year`) = 2
LIMIT 20;
```

```sql
-- 7. Retrieve 2012 counts for only those CoCs that also have 2018 data
SELECT a.`CoC_Number`,
       a.`CoC_Name`,
       a.`Homeless_Veterans` AS `Veterans_2012`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS a
JOIN (
      SELECT `CoC_Number`
      FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
      WHERE `CoC_Number` LIKE 'NY-%' AND `Count_Year` IN (2012, 2018)
      GROUP BY `CoC_Number`
      HAVING COUNT(DISTINCT `Count_Year`) = 2
     ) AS b
ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`Count_Year` = 2012
ORDER BY a.`CoC_Number`
LIMIT 20;
```

```sql
-- 8. FINAL ANSWER: Change in homeless veterans between 2012 and 2018 for NY CoCs with data in both years
SELECT 
  c2012.`CoC_Number`,
  c2012.`CoC_Name`,
  c2012.`Homeless_Veterans` AS `Veterans_2012`,
  c2018.`Homeless_Veterans` AS `Veterans_2018`,
  c2018.`Homeless_Veterans` - c2012.`Homeless_Veterans` AS `Change_2012_to_2018`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS c2012
JOIN `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS c2018
  ON c2012.`CoC_Number` = c2018.`CoC_Number`
WHERE c2012.`CoC_Number` LIKE 'NY-%'
  AND c2012.`Count_Year` = 2012
  AND c2018.`Count_Year` = 2018
ORDER BY c2012.`CoC_Number`
LIMIT 20;
```
