```sql
--Description: 4) Retrieve 2018 homeless-veteran counts for the same New York CoCs.
SELECT `CoC_Number`, `CoC_Name`, `Homeless_Veterans`, `Count_Year`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` = 2018
LIMIT 20;
```

```sql
--Description: 5) Confirm which New York CoCs have BOTH 2012 and 2018 data.
SELECT `CoC_Number`
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc`
WHERE `CoC_Number` LIKE 'NY-%'
  AND `Count_Year` IN (2012, 2018)
GROUP BY `CoC_Number`
HAVING COUNT(DISTINCT `Count_Year`) = 2
LIMIT 20;
```

```sql
--Description: 6) Show side-by-side 2012 vs 2018 veteran counts for qualifying New York CoCs.
SELECT 
  a.`CoC_Number`,
  a.`CoC_Name`,
  a.`Homeless_Veterans` AS veterans_2012,
  b.`Homeless_Veterans` AS veterans_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS a
JOIN `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS b
  ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`CoC_Number` LIKE 'NY-%'
  AND a.`Count_Year` = 2012
  AND b.`Count_Year` = 2018
LIMIT 20;
```

```sql
--Description: 7) Final answer – compute the change (2018 − 2012) in homeless veterans
--               for each New York CoC with data in both years.
SELECT 
  a.`CoC_Number`,
  a.`CoC_Name`,
  a.`Homeless_Veterans` AS veterans_2012,
  b.`Homeless_Veterans` AS veterans_2018,
  b.`Homeless_Veterans` - a.`Homeless_Veterans` AS change_2012_to_2018
FROM `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS a
JOIN `bigquery-public-data.sdoh_hud_pit_homelessness.hud_pit_by_coc` AS b
  ON a.`CoC_Number` = b.`CoC_Number`
WHERE a.`CoC_Number` LIKE 'NY-%'
  AND a.`Count_Year` = 2012
  AND b.`Count_Year` = 2018
ORDER BY `CoC_Number`
LIMIT 20;
```

