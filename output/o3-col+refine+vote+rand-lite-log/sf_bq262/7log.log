    TO_CHAR(DATE_TRUNC('month',
           TO_TIMESTAMP(oi."created_at" / 1000000)), 'YYYY-MM') AS "month",
    p."category"                                               AS "product_category",
    SUM(oi."sale_price" - p."cost")                            AS "total_profit"
