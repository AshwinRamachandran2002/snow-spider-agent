-- 4. Description:  Join ORDERS and ORDER_ITEMS to be sure that line-items really do map back
--                  to their parent orders through “order_id”.
SELECT oi."order_id",
       o."created_at"          AS "order_created_at",
       oi."created_at"         AS "item_created_at",
       oi."sale_price",
       o."status"              AS "order_status",
       oi."status"             AS "item_status"
