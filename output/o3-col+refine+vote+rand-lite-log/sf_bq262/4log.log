          ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-06-01'
    GROUP BY p."category"
), current_m AS (
    SELECT p."category",
           COUNT(DISTINCT oi."order_id")                      AS "orders_curr",
           SUM(oi."sale_price")                              AS "revenue_curr",
           SUM(oi."sale_price" - inv."cost")                 AS "profit_curr"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  inv
