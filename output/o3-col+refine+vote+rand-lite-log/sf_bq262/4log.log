```sql
--Description: Month-over-Month growth from June to July 2019 by category
--             (baseline = June 2019).
WITH baseline AS (
    SELECT p."category",
           COUNT(DISTINCT oi."order_id")                      AS "orders_base",
           SUM(oi."sale_price")                              AS "revenue_base",
           SUM(oi."sale_price" - inv."cost")                 AS "profit_base"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  inv
          ON oi."inventory_item_id" = inv."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
          ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-06-01'
    GROUP BY p."category"
), current_m AS (
    SELECT p."category",
           COUNT(DISTINCT oi."order_id")                      AS "orders_curr",
           SUM(oi."sale_price")                              AS "revenue_curr",
           SUM(oi."sale_price" - inv."cost")                 AS "profit_curr"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  inv
          ON oi."inventory_item_id" = inv."id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
          ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-07-01'
    GROUP BY p."category"
)
SELECT c."category",
       c."orders_curr",
       b."orders_base",
       (c."orders_curr"  - b."orders_base")  / NULLIF(b."orders_base",0)::FLOAT AS "orders_mom_growth",
       c."revenue_curr",
       b."revenue_base",
       (c."revenue_curr" - b."revenue_base") / NULLIF(b."revenue_base",0)::FLOAT AS "revenue_mom_growth",
       c."profit_curr",
       b."profit_base",
       (c."profit_curr"  - b."profit_base")  / NULLIF(b."profit_base",0)::FLOAT AS "profit_mom_growth"
FROM current_m c
LEFT JOIN baseline b USING ("category")
LIMIT 20;
```

```sql
--Description: Full monthly panel (Jun-Dec 2019) of orders, revenue, profit by category.
SELECT DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                              AS "total_orders",
       SUM(oi."sale_price")                                       AS "total_revenue",
       SUM(oi."sale_price" - inv."cost")                          AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  inv
      ON oi."inventory_item_id" = inv."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
      ON oi."product_id" = p."id"
WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1e6)
      BETWEEN DATE '2019-06-01' AND DATE '2019-12-31'
GROUP BY "month", p."category"
ORDER BY "month", p."category"
LIMIT 20;
```

```sql
--Description: Verify profit calculation on a sample of Jun-Dec 2019 order items.
SELECT oi."id"                          AS "order_item_id",
       oi."sale_price",
       inv."cost",
       (oi."sale_price" - inv."cost")   AS "calc_profit",
       p."category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  inv
     ON oi."inventory_item_id" = inv."id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
     ON oi."product_id" = p."id"
WHERE TO_TIMESTAMP_NTZ(oi."created_at"/1e6)
      BETWEEN DATE '2019-06-01' AND DATE '2019-12-31'
LIMIT 20;
```

```sql
--Description: Identify product categories that appear in Jul-2019 but not in Jun-2019.
WITH jun19 AS (
    SELECT DISTINCT p."category"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
      ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-06-01'
),
jul19 AS (
    SELECT DISTINCT p."category"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
      ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-07-01'
)
SELECT j19."category"
FROM jul19 j19
LEFT JOIN jun19 USING ("category")
WHERE jun19."category" IS NULL
LIMIT 20;
```
