--Description: Identify product categories that appear in Jul-2019 but not in Jun-2019.
WITH jun19 AS (
    SELECT DISTINCT p."category"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
      ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-06-01'
),
jul19 AS (
    SELECT DISTINCT p."category"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
      ON oi."product_id" = p."id"
    WHERE DATE_TRUNC('month', TO_TIMESTAMP_NTZ(oi."created_at"/1e6)) = DATE '2019-07-01'
)
SELECT j19."category"
FROM jul19 j19
LEFT JOIN jun19 USING ("category")
WHERE jun19."category" IS NULL
LIMIT 20
