```sql
--Description:
-- Goal: Produce the final report requested:
--   • From June-2019 through Dec-2019, summarise (per product category, per month):
--       – total distinct orders
--       – total revenue
--       – total profit
--   • Then calculate Month-over-Month (MoM) growth rates for Jul-2019 → Dec-2019
--     using Jun-2019 as the baseline.
-- Steps performed inside one SQL:
-- 1) CTE monthly:  join ORDER_ITEMS with INVENTORY_ITEMS, convert micro-second
--    epoch to YYYY-MM, aggregate metrics for each month & category (Jun-Dec 2019).
-- 2) Main SELECT: apply LAG window-functions (partitioned by category, ordered
--    by month) to fetch prior-month metrics and compute MoM % growth.
-- 3) Exclude the baseline month (2019-06) from output so only Jul-Dec appear.
-- 4) Sort by month then category, as requested.

WITH monthly AS (
    SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at" / 1000000), 'YYYY-MM') AS "month",
        ii."product_category",
        COUNT(DISTINCT oi."order_id")                                   AS "total_orders",
        SUM(oi."sale_price")                                            AS "total_revenue",
        SUM(oi."sale_price" - ii."cost")                                AS "total_profit"
    FROM  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS     oi
    JOIN  THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.INVENTORY_ITEMS  ii
          ON oi."inventory_item_id" = ii."id"
    WHERE oi."created_at" BETWEEN 1559347200000000                        -- 2019-06-01
                              AND 1577836800000000                        -- 2020-01-01
    GROUP BY 1, 2
)
SELECT
    m."month",
    m."product_category",
    m."total_orders",
    m."total_revenue",
    m."total_profit",
    ROUND(
        100 * (m."total_orders" - LAG(m."total_orders")
                 OVER (PARTITION BY m."product_category" ORDER BY m."month"))
        / NULLIF( LAG(m."total_orders")
                 OVER (PARTITION BY m."product_category" ORDER BY m."month"), 0)
        , 2) AS "orders_mom_growth_pct",
    ROUND(
        100 * (m."total_revenue" - LAG(m."total_revenue")
                 OVER (PARTITION BY m."product_category" ORDER BY m."month"))
        / NULLIF( LAG(m."total_revenue")
                 OVER (PARTITION BY m."product_category" ORDER BY m."month"), 0)
        , 2) AS "revenue_mom_growth_pct",
    ROUND(
        100 * (m."total_profit" - LAG(m."total_profit")
                 OVER (PARTITION BY m."product_category" ORDER BY m."month"))
        / NULLIF( LAG(m."total_profit")
                 OVER (PARTITION BY m."product_category" ORDER BY m."month"), 0)
        , 2) AS "profit_mom_growth_pct"
FROM monthly m
WHERE m."month" > '2019-06'       -- omit baseline month from final view
ORDER BY m."month", m."product_category";
```
