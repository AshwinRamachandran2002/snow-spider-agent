       "name",
       "category",
       "department",
       "cost",
       "retail_price"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: 4)  Join ORDER_ITEMS to PRODUCTS for a small sample (June-2019) to confirm the join gives product category and cost.
SELECT oi."id"               AS "order_item_id",
       oi."order_id",
       p."category",
       p."cost",
       oi."sale_price",
       TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "month"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') = '2019-06'
LIMIT 20;
```

```sql
--Description: 5)  Compute monthly totals (orders, revenue, profit) by category for June-2019 (this will be the baseline for M/M growth).
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM')        AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                                    AS "total_orders",
       SUM(oi."sale_price")                                            AS "total_revenue",
       SUM(oi."sale_price" - p."cost")                                 AS "total_profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') = '2019-06'
GROUP  BY 1,2
ORDER  BY 1,2
LIMIT 20;
```

```sql
--Description: 6)  Produce the same aggregates for July-2019 to compare later with June-2019.
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM')        AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                                    AS "total_orders",
       SUM(oi."sale_price")                                            AS "total_revenue",
       SUM(oi."sale_price" - p."cost")                                 AS "total_profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') = '2019-07'
GROUP  BY 1,2
ORDER  BY 1,2
LIMIT 20;
```

```sql
--Description: 7)  Aggregate every month from Jun-2019 to Dec-2019; this will later be self-joined to calculate MoM growth.
SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM')        AS "month",
       p."category",
       COUNT(DISTINCT oi."order_id")                                    AS "total_orders",
       SUM(oi."sale_price")                                            AS "total_revenue",
       SUM(oi."sale_price" - p."cost")                                 AS "total_profit"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p
       ON oi."product_id" = p."id"
WHERE  TO_TIMESTAMP(oi."created_at"/1000000)
          BETWEEN '2019-06-01' AND '2019-12-31 23:59:59'
GROUP  BY 1,2
ORDER  BY 1,2
LIMIT 20;
```

```sql
--Description: 8)  Demonstrate how to calculate month-over-month growth by joining July-Dec aggregates back to June baseline (example shown for July).
WITH monthly AS (
    SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "month",
           p."category",
           COUNT(DISTINCT oi."order_id")                            AS "total_orders",
           SUM(oi."sale_price")                                    AS "total_revenue",
           SUM(oi."sale_price" - p."cost")                         AS "total_profit"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
           ON oi."product_id" = p."id"
    WHERE  TO_TIMESTAMP(oi."created_at"/1000000)
             BETWEEN '2019-06-01' AND '2019-12-31 23:59:59'
    GROUP  BY 1,2
)
SELECT  cur."month",
        cur."category",
        cur."total_orders",
        prev."total_orders"  AS "prev_total_orders",
        100.0 * (cur."total_orders" - prev."total_orders") / NULLIF(prev."total_orders",0) AS "orders_growth_pct"
FROM    monthly cur
LEFT JOIN monthly prev
       ON prev."category" = cur."category"
      AND prev."month"     = '2019-06'
WHERE   cur."month"         = '2019-07'
ORDER BY cur."category"
LIMIT 20;
```

```sql
--Description: 9)  Verify that ORDER_ITEMS with any status (e.g., Cancelled) are in scope for 2019-H2.
SELECT DISTINCT "status"
FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE  TO_TIMESTAMP("created_at"/1000000)
          BETWEEN '2019-06-01' AND '2019-12-31 23:59:59'
LIMIT 20;
```

```sql
--Description: 10)  Show a complete picture (July-Dec 2019) with MoM growth against June-2019 for one category (“Accessories”) as a proof-of-concept.
WITH monthly AS (
    SELECT TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "month",
           p."category",
           COUNT(DISTINCT oi."order_id")                            AS "total_orders",
           SUM(oi."sale_price")                                    AS "total_revenue",
           SUM(oi."sale_price" - p."cost")                         AS "total_profit"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"    p
           ON oi."product_id" = p."id"
    WHERE  TO_TIMESTAMP(oi."created_at"/1000000)
             BETWEEN '2019-06-01' AND '2019-12-31 23:59:59'
      AND   p."category" = 'Accessories'
    GROUP  BY 1,2
)
SELECT  cur."month",
        cur."category",
        cur."total_orders",
        cur."total_revenue",
        cur."total_profit",
        100.0 * (cur."total_orders"  - jun."total_orders" ) / NULLIF(jun."total_orders",0)  AS "orders_growth_pct",
        100.0 * (cur."total_revenue" - jun."total_revenue") / NULLIF(jun."total_revenue",0) AS "revenue_growth_pct",
        100.0 * (cur."total_profit"  - jun."total_profit" ) / NULLIF(jun."total_profit",0)  AS "profit_growth_pct"
FROM    monthly cur
JOIN    monthly jun
       ON jun."category" = cur."category"
      AND jun."month"    = '2019-06'
WHERE   cur."month"      BETWEEN '2019-07' AND '2019-12'
ORDER BY cur."month"
LIMIT 20;
```
