SELECT DISTINCT 
  "category"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"
LIMIT 20;
```

```sql
--Description: 3) Glimpse at 2019 order items (any status) together with their categories.  
SELECT 
  oi."order_id",
  oi."id"               AS "order_item_id",
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM-DD') AS "created_date",
  p."category",
  oi."status",
  oi."sale_price"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"      p  ON p."id" = oi."product_id"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY') = '2019'
LIMIT 20;
```

```sql
--Description: 4) Verify cost for a few inventory items and the distribution center that owns them.  
SELECT 
  ii."id"                AS "inventory_item_id",
  ii."product_id",
  ii."product_distribution_center_id",
  ii."cost",
  ii."created_at",
  dc."name"              AS "distribution_center_name"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
LEFT JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."DISTRIBUTION_CENTERS" dc
       ON dc."id" = ii."product_distribution_center_id"
LIMIT 20;
```

```sql
--Description: 5) Sample of orders themselves in 2019 to check timestamps & statuses.  
SELECT 
  "order_id",
  "status",
  TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000),'YYYY-MM-DD') AS "created_date",
  "num_of_item",
  "gender"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDERS"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000),'YYYY') = '2019'
LIMIT 20;
```

```sql
--Description: 6) Distinct months (YYYY-MM) found in ORDER_ITEMS for 2019-06 to 2019-12.  
SELECT DISTINCT 
  TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000),'YYYY-MM') AS "month"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ("created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
ORDER BY "month"
LIMIT 20;
```

```sql
--Description: 7) Aggregate: total orders & revenue per category & month (Jun-Dec 2019).  
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')   AS "month",
  p."category"                                                   AS "product_category",
  COUNT(DISTINCT oi."order_id")                                  AS "total_orders",
  SUM(oi."sale_price")                                           AS "total_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id" = oi."product_id"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: 8) Same aggregation but adding cost to compute profit for each order item.  
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')        AS "month",
  p."category"                                                        AS "product_category",
  COUNT(DISTINCT oi."order_id")                                       AS "total_orders",
  SUM(oi."sale_price")                                                AS "total_revenue",
  SUM(oi."sale_price" - ii."cost")                                    AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii ON ii."id" = oi."inventory_item_id"
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON p."id" = oi."product_id"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```

```sql
--Description: 9) Extend previous query by adding MoM growth rates (lag) for revenue & profit; still show full set but limit sample.  
SELECT
  "month",
  "product_category",
  "total_orders",
  "total_revenue",
  "total_profit",
  ROUND(("total_revenue" - LAG("total_revenue") OVER (PARTITION BY "product_category" ORDER BY "month")) / NULLIF(LAG("total_revenue") OVER (PARTITION BY "product_category" ORDER BY "month"),0) * 100,2) AS "revenue_mom_growth_pct",
  ROUND(("total_profit"  - LAG("total_profit")  OVER (PARTITION BY "product_category" ORDER BY "month")) / NULLIF(LAG("total_profit")  OVER (PARTITION BY "product_category" ORDER BY "month"),0) * 100,2) AS "profit_mom_growth_pct"
FROM (
    SELECT
      TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')   AS "month",
      p."category"                                                   AS "product_category",
      COUNT(DISTINCT oi."order_id")                                  AS "total_orders",
      SUM(oi."sale_price")                                           AS "total_revenue",
      SUM(oi."sale_price" - ii."cost")                               AS "total_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii ON ii."id" = oi."inventory_item_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON p."id" = oi."product_id"
    WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
    GROUP BY 1,2
) q
WHERE "month" <> '2019-06'          -- omit June from final display but still used in LAG calculations
ORDER BY "month", "product_category"
LIMIT 20;
```

```sql
--Description: 10) Final full report (no LIMIT) ready for download – repeated here with LIMIT for preview.  
SELECT
  "month",
  "product_category",
  "total_orders",
  "total_revenue",
  "total_profit",
  "revenue_mom_growth_pct",
  "profit_mom_growth_pct"
FROM (
  SELECT
    "month",
    "product_category",
    "total_orders",
    "total_revenue",
    "total_profit",
    ROUND(("total_revenue" - LAG("total_revenue") OVER (PARTITION BY "product_category" ORDER BY "month")) / NULLIF(LAG("total_revenue") OVER (PARTITION BY "product_category" ORDER BY "month"),0) * 100,2) AS "revenue_mom_growth_pct",
    ROUND(("total_profit"  - LAG("total_profit")  OVER (PARTITION BY "product_category" ORDER BY "month")) / NULLIF(LAG("total_profit")  OVER (PARTITION BY "product_category" ORDER BY "month"),0) * 100,2) AS "profit_mom_growth_pct"
  FROM (
      SELECT
        TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')   AS "month",
        p."category"                                                   AS "product_category",
        COUNT(DISTINCT oi."order_id")                                  AS "total_orders",
        SUM(oi."sale_price")                                           AS "total_revenue",
        SUM(oi."sale_price" - ii."cost")                               AS "total_profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii ON ii."id" = oi."inventory_item_id"
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON p."id" = oi."product_id"
      WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
      GROUP BY 1,2
  ) base
) final
WHERE "month" <> '2019-06'
ORDER BY "month","product_category"
LIMIT 20;
```
