--Description: 7) Aggregate: total orders & revenue per category & month (Jun-Dec 2019).  
SELECT
  TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')   AS "month",
  p."category"                                                   AS "product_category",
  COUNT(DISTINCT oi."order_id")                                  AS "total_orders",
  SUM(oi."sale_price")                                           AS "total_revenue"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS" oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"     p  ON p."id" = oi."product_id"
WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
