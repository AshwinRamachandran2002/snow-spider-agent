--Description: 9) Extend previous query by adding MoM growth rates (lag) for revenue & profit; still show full set but limit sample.  
SELECT
  "month",
  "product_category",
  "total_orders",
  "total_revenue",
  "total_profit",
  ROUND(("total_revenue" - LAG("total_revenue") OVER (PARTITION BY "product_category" ORDER BY "month")) / NULLIF(LAG("total_revenue") OVER (PARTITION BY "product_category" ORDER BY "month"),0) * 100,2) AS "revenue_mom_growth_pct",
  ROUND(("total_profit"  - LAG("total_profit")  OVER (PARTITION BY "product_category" ORDER BY "month")) / NULLIF(LAG("total_profit")  OVER (PARTITION BY "product_category" ORDER BY "month"),0) * 100,2) AS "profit_mom_growth_pct"
FROM (
    SELECT
      TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM')   AS "month",
      p."category"                                                   AS "product_category",
      COUNT(DISTINCT oi."order_id")                                  AS "total_orders",
      SUM(oi."sale_price")                                           AS "total_revenue",
      SUM(oi."sale_price" - ii."cost")                               AS "total_profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii ON ii."id" = oi."inventory_item_id"
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p  ON p."id" = oi."product_id"
    WHERE TO_CHAR(TO_TIMESTAMP_NTZ(oi."created_at"/1000000),'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
    GROUP BY 1,2
) q
WHERE "month" <> '2019-06'          -- omit June from final display but still used in LAG calculations
ORDER BY "month", "product_category"
LIMIT 20;
Answer:
month,product_category,total_orders,total_revenue,total_profit,revenue_mom_growth_pct,profit_mom_growth_pct
