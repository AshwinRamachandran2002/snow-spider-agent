--for a single category (“Accessories”) to validate the growth-rate logic.
WITH  jun AS (
        SELECT  p."category",
                COUNT(DISTINCT oi."order_id")    AS "orders_jun",
                SUM(oi."sale_price")             AS "revenue_jun",
                SUM(oi."sale_price" - ii."cost") AS "profit_jun"
        FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
               ON oi."inventory_item_id" = ii."id"
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
               ON oi."product_id" = p."id"
        WHERE   oi."created_at" BETWEEN 1559347200000000 AND 1561939200000000
          AND   p."category" = 'Accessories'
        GROUP BY p."category"
),
     jul AS (
        SELECT  p."category",
                COUNT(DISTINCT oi."order_id")    AS "orders_jul",
                SUM(oi."sale_price")             AS "revenue_jul",
                SUM(oi."sale_price" - ii."cost") AS "profit_jul"
        FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
               ON oi."inventory_item_id" = ii."id"
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
               ON oi."product_id" = p."id"
        WHERE   oi."created_at" BETWEEN 1561939200000000 AND 1564617600000000
          AND   p."category" = 'Accessories'
        GROUP BY p."category"
)
SELECT  jul."category",
        jul."orders_jul",
        jun."orders_jun",
        (jul."orders_jul" - jun."orders_jun") / NULLIF(jun."orders_jun",0) AS "orders_mom_growth",
        jul."revenue_jul",
        jun."revenue_jun",
        (jul."revenue_jul" - jun."revenue_jun") / NULLIF(jun."revenue_jun",0) AS "revenue_mom_growth",
        jul."profit_jul",
        jun."profit_jun",
        (jul."profit_jul" - jun."profit_jun") / NULLIF(jun."profit_jun",0) AS "profit_mom_growth"
FROM   jun
JOIN   jul ON jun."category" = jul."category"
LIMIT 20;
