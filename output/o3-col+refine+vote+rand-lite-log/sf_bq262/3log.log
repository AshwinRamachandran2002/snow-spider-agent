```

```sql
--Description: Quick revenue & cost aggregation for JUL-2019  
--(unix micro-seconds 1-Jul-2019 00:00 → 1-Aug-2019 00:00).  
--Shows the basic math we will reuse for all months.
SELECT  p."category",
        COUNT(DISTINCT oi."order_id")          AS "total_orders",
        SUM(oi."sale_price")                   AS "total_revenue",
        SUM(oi."sale_price" - ii."cost")       AS "total_profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
       ON oi."product_id" = p."id"
WHERE   oi."created_at" BETWEEN 1561939200000000 AND 1564617600000000   -- 01-Jul-2019 to 01-Aug-2019
GROUP BY p."category"
LIMIT 20;
```

```sql
--Description: Same aggregation for JUN-2019 (baseline for growth calculations).
SELECT  p."category",
        COUNT(DISTINCT oi."order_id")    AS "jun_total_orders",
        SUM(oi."sale_price")             AS "jun_total_revenue",
        SUM(oi."sale_price" - ii."cost") AS "jun_total_profit"
FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
       ON oi."inventory_item_id" = ii."id"
JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
       ON oi."product_id" = p."id"
WHERE   oi."created_at" BETWEEN 1559347200000000 AND 1561939200000000   -- 01-Jun-2019 to 01-Jul-2019
GROUP BY p."category"
LIMIT 20;
```

```sql
--Description: Pull month-over-month growth for JUL-2019 vs JUN-2019  
--for a single category (“Accessories”) to validate the growth-rate logic.
WITH  jun AS (
        SELECT  p."category",
                COUNT(DISTINCT oi."order_id")    AS "orders_jun",
                SUM(oi."sale_price")             AS "revenue_jun",
                SUM(oi."sale_price" - ii."cost") AS "profit_jun"
        FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
               ON oi."inventory_item_id" = ii."id"
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
               ON oi."product_id" = p."id"
        WHERE   oi."created_at" BETWEEN 1559347200000000 AND 1561939200000000
          AND   p."category" = 'Accessories'
        GROUP BY p."category"
),
     jul AS (
        SELECT  p."category",
                COUNT(DISTINCT oi."order_id")    AS "orders_jul",
                SUM(oi."sale_price")             AS "revenue_jul",
                SUM(oi."sale_price" - ii."cost") AS "profit_jul"
        FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
               ON oi."inventory_item_id" = ii."id"
        JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
               ON oi."product_id" = p."id"
        WHERE   oi."created_at" BETWEEN 1561939200000000 AND 1564617600000000
          AND   p."category" = 'Accessories'
        GROUP BY p."category"
)
SELECT  jul."category",
        jul."orders_jul",
        jun."orders_jun",
        (jul."orders_jul" - jun."orders_jun") / NULLIF(jun."orders_jun",0) AS "orders_mom_growth",
        jul."revenue_jul",
        jun."revenue_jun",
        (jul."revenue_jul" - jun."revenue_jun") / NULLIF(jun."revenue_jun",0) AS "revenue_mom_growth",
        jul."profit_jul",
        jun."profit_jun",
        (jul."profit_jul" - jun."profit_jun") / NULLIF(jun."profit_jun",0) AS "profit_mom_growth"
FROM   jun
JOIN   jul ON jun."category" = jul."category"
LIMIT 20;
```

```sql
--Description: Preview the full month-by-month, category-by-category result set  
--(June is calculated inside the CTE but omitted from final SELECT).  
--Only 20 rows are shown here for brevity.
WITH monthly AS (
    SELECT  TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP("created_at"/1e6)), 'YYYY-MM') AS "year_month",
            p."category",
            COUNT(DISTINCT oi."order_id")                         AS "total_orders",
            SUM(oi."sale_price")                                  AS "total_revenue",
            SUM(oi."sale_price" - ii."cost")                      AS "total_profit"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
           ON oi."inventory_item_id" = ii."id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
           ON oi."product_id" = p."id"
    WHERE   oi."created_at" BETWEEN 1559347200000000 AND 1577836800000000   -- 01-Jun-2019 → 31-Dec-2019
    GROUP BY 1, p."category"
),
growth AS (
    SELECT  m.*,
            LAG(m."total_orders")  OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_orders",
            LAG(m."total_revenue") OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_revenue",
            LAG(m."total_profit")  OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_profit"
    FROM    monthly  m
)
SELECT  g."year_month",
        g."category",
        g."total_orders",
        g."total_revenue",
        g."total_profit",
        (g."total_orders" - g."prev_orders")  / NULLIF(g."prev_orders",0)  AS "orders_mom_growth",
        (g."total_revenue" - g."prev_revenue")/ NULLIF(g."prev_revenue",0) AS "revenue_mom_growth",
        (g."total_profit" - g."prev_profit")  / NULLIF(g."prev_profit",0)  AS "profit_mom_growth"
FROM    growth  g
WHERE   g."year_month" <> '2019-06'          -- exclude June from final display
ORDER BY g."year_month", g."category"
LIMIT 20;
```
