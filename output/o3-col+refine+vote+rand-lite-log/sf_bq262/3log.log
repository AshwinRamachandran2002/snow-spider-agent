```sql
--Description: 
-- We need a single query that (a) aggregates June-Dec-2019 sales by product
-- category & month, (b) calculates MoM growth using June 2019 as the baseline,
-- and (c) hides June in the final report while still feeding it to the LAG()
-- window for growth computation.
-- Key points
--   • ORDER_ITEMS gives sale_price; INVENTORY_ITEMS gives cost; PRODUCTS gives category.
--   • created_at is micro-seconds since epoch → divide by 1e6, cast to TIMESTAMP,
--     truncate to month, then format as 'YYYY-MM'.
--   • LAG() carries previous-month metrics within each category.
--   • MoM growth = (current − previous)/previous, with NULLIF to avoid /0.
--   • WHERE filter keeps rows 1-Jun-2019 ≤ created_at < 1-Jan-2020.
--   • Final WHERE removes June (2019-06) from display but still uses it for growth.
WITH monthly AS (
    SELECT
        TO_CHAR(
            DATE_TRUNC('month', TO_TIMESTAMP(oi."created_at" / 1e6)),
            'YYYY-MM'
        )                                   AS "year_month",
        p."category",
        COUNT(DISTINCT oi."order_id")       AS "total_orders",
        SUM(oi."sale_price")                AS "total_revenue",
        SUM(oi."sale_price" - ii."cost")    AS "total_profit"
    FROM   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"      oi
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS"  ii
           ON oi."inventory_item_id" = ii."id"
    JOIN   THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"         p
           ON oi."product_id" = p."id"
    WHERE  oi."created_at" BETWEEN 1559347200000000              -- 01-Jun-2019
                              AND 1577836800000000               -- 31-Dec-2019
    GROUP BY 1, p."category"
),
growth AS (
    SELECT
        m.*,
        LAG(m."total_orders")  OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_orders",
        LAG(m."total_revenue") OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_revenue",
        LAG(m."total_profit")  OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_profit"
    FROM   monthly m
)
SELECT
    g."year_month",
    g."category",
    g."total_orders",
    g."total_revenue",
    g."total_profit",
    (g."total_orders"  - g."prev_orders")  / NULLIF(g."prev_orders", 0)  AS "orders_mom_growth",
    (g."total_revenue" - g."prev_revenue") / NULLIF(g."prev_revenue",0)  AS "revenue_mom_growth",
    (g."total_profit"  - g."prev_profit")  / NULLIF(g."prev_profit",0)   AS "profit_mom_growth"
FROM   growth g
WHERE  g."year_month" <> '2019-06'          -- omit June baseline from output
ORDER BY g."year_month", g."category";
```
