--Only 20 rows are shown here for brevity.
WITH monthly AS (
    SELECT  TO_CHAR(DATE_TRUNC('month', TO_TIMESTAMP("created_at"/1e6)), 'YYYY-MM') AS "year_month",
            p."category",
            COUNT(DISTINCT oi."order_id")                         AS "total_orders",
            SUM(oi."sale_price")                                  AS "total_revenue",
            SUM(oi."sale_price" - ii."cost")                      AS "total_profit"
    FROM    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."ORDER_ITEMS"     oi
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."INVENTORY_ITEMS" ii
           ON oi."inventory_item_id" = ii."id"
    JOIN    THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."PRODUCTS"        p
           ON oi."product_id" = p."id"
    WHERE   oi."created_at" BETWEEN 1559347200000000 AND 1577836800000000   -- 01-Jun-2019 → 31-Dec-2019
    GROUP BY 1, p."category"
),
growth AS (
    SELECT  m.*,
            LAG(m."total_orders")  OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_orders",
            LAG(m."total_revenue") OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_revenue",
            LAG(m."total_profit")  OVER (PARTITION BY m."category" ORDER BY m."year_month") AS "prev_profit"
    FROM    monthly  m
)
SELECT  g."year_month",
        g."category",
        g."total_orders",
        g."total_revenue",
        g."total_profit",
        (g."total_orders" - g."prev_orders")  / NULLIF(g."prev_orders",0)  AS "orders_mom_growth",
        (g."total_revenue" - g."prev_revenue")/ NULLIF(g."prev_revenue",0) AS "revenue_mom_growth",
        (g."total_profit" - g."prev_profit")  / NULLIF(g."prev_profit",0)  AS "profit_mom_growth"
FROM    growth  g
WHERE   g."year_month" <> '2019-06'          -- exclude June from final display
ORDER BY g."year_month", g."category"
LIMIT 20;
