Query:
--Description: 7) Combine July-Dec metrics with June baseline to compute MoM growth rates.
WITH monthly AS (
    SELECT 
           TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "year_month",
           p."category",
           COUNT(DISTINCT oi."order_id")                             AS "orders",
           SUM(oi."sale_price")                                      AS "revenue",
           SUM(oi."sale_price" - p."cost")                           AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
    WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
    GROUP BY 1, 2
), june AS (
    SELECT *
    FROM monthly
    WHERE "year_month" = '2019-06'
)
SELECT 
       m."year_month",
       m."category",
       m."orders",
       m."revenue",
       m."profit",
       ROUND(((m."orders"  - j."orders")  / NULLIF(j."orders",  0)) * 100, 2) AS "orders_growth_pct",
       ROUND(((m."revenue" - j."revenue") / NULLIF(j."revenue", 0)) * 100, 2) AS "revenue_growth_pct",
       ROUND(((m."profit"  - j."profit")  / NULLIF(j."profit",  0)) * 100, 2) AS "profit_growth_pct"
FROM monthly m
JOIN june   j
  ON m."category" = j."category"
WHERE m."year_month" <> '2019-06'
ORDER BY m."year_month", m."category"
LIMIT 20;
