  ON oi."product_id" = p."id"
WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') = '2019-07'
GROUP BY p."category"
ORDER BY p."category"
LIMIT 20;
```

```sql
--Description: 5) Produce month-level metrics (orders, revenue, profit) for Jun–Dec-2019 by category.
SELECT 
       TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM')      AS "year_month",
       p."category",
       COUNT(DISTINCT oi."order_id")                                   AS "total_orders",
       SUM(oi."sale_price")                                            AS "total_revenue",
       SUM(oi."sale_price" - p."cost")                                 AS "total_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
  ON oi."product_id" = p."id"
WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
GROUP BY 1, 2
ORDER BY 1, 2
LIMIT 20;
```

```sql
--Description: 6) Isolate June-2019 metrics to use as the growth baseline.
SELECT 
       p."category",
       COUNT(DISTINCT oi."order_id")                         AS "jun_orders",
       SUM(oi."sale_price")                                  AS "jun_revenue",
       SUM(oi."sale_price" - p."cost")                       AS "jun_profit"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
  ON oi."product_id" = p."id"
WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') = '2019-06'
GROUP BY p."category"
LIMIT 20;
```

```sql
--Description: 7) Combine July-Dec metrics with June baseline to compute MoM growth rates.
WITH monthly AS (
    SELECT 
           TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "year_month",
           p."category",
           COUNT(DISTINCT oi."order_id")                             AS "orders",
           SUM(oi."sale_price")                                      AS "revenue",
           SUM(oi."sale_price" - p."cost")                           AS "profit"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
    JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
      ON oi."product_id" = p."id"
    WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
    GROUP BY 1, 2
), june AS (
    SELECT *
    FROM monthly
    WHERE "year_month" = '2019-06'
)
SELECT 
       m."year_month",
       m."category",
       m."orders",
       m."revenue",
       m."profit",
       ROUND(((m."orders"  - j."orders")  / NULLIF(j."orders",  0)) * 100, 2) AS "orders_growth_pct",
       ROUND(((m."revenue" - j."revenue") / NULLIF(j."revenue", 0)) * 100, 2) AS "revenue_growth_pct",
       ROUND(((m."profit"  - j."profit")  / NULLIF(j."profit",  0)) * 100, 2) AS "profit_growth_pct"
FROM monthly m
JOIN june   j
  ON m."category" = j."category"
WHERE m."year_month" <> '2019-06'
ORDER BY m."year_month", m."category"
LIMIT 20;
```

```sql
--Description: 8) Final formatted report (all rows) for Jul-Dec-2019 sorted by month then category.
SELECT 
       m."year_month",
       m."category",
       m."orders"                              AS "total_orders",
       m."revenue"                             AS "total_revenue",
       m."profit"                              AS "total_profit",
       ROUND(((m."orders"  - j."orders")  / NULLIF(j."orders",  0)) * 100, 2) AS "orders_growth_pct",
       ROUND(((m."revenue" - j."revenue") / NULLIF(j."revenue", 0)) * 100, 2) AS "revenue_growth_pct",
       ROUND(((m."profit"  - j."profit")  / NULLIF(j."profit",  0)) * 100, 2) AS "profit_growth_pct"
FROM (
      SELECT 
             TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') AS "year_month",
             p."category",
             COUNT(DISTINCT oi."order_id")                             AS "orders",
             SUM(oi."sale_price")                                      AS "revenue",
             SUM(oi."sale_price" - p."cost")                           AS "profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
        ON oi."product_id" = p."id"
      WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') BETWEEN '2019-06' AND '2019-12'
      GROUP BY 1, 2
) m
JOIN (
      SELECT 
             p."category",
             COUNT(DISTINCT oi."order_id")                             AS "orders",
             SUM(oi."sale_price")                                      AS "revenue",
             SUM(oi."sale_price" - p."cost")                           AS "profit"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.ORDER_ITEMS  oi
      JOIN THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.PRODUCTS     p
        ON oi."product_id" = p."id"
      WHERE TO_CHAR(TO_TIMESTAMP(oi."created_at"/1000000), 'YYYY-MM') = '2019-06'
      GROUP BY p."category"
) j
  ON m."category" = j."category"
WHERE m."year_month" <> '2019-06'
ORDER BY m."year_month", m."category";
```

