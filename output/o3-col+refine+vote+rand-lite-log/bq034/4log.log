Query:
--Description: 9) Join those 50-km stations to the states lookup to attach full
--              state names (if any)
SELECT s.id,
       s.name,
       st.name AS state_name,
       ROUND( ST_DISTANCE(
                 ST_GEOGPOINT(s.longitude, s.latitude),
                 ST_GEOGPOINT(-87.6847, 41.8319)
             ) / 1000, 2 ) AS distance_km
FROM `bigquery-public-data.ghcn_d.ghcnd_stations` AS s
LEFT JOIN `bigquery-public-data.ghcn_d.ghcnd_states` AS st
       ON s.state = st.code
WHERE ST_DISTANCE(
          ST_GEOGPOINT(s.longitude, s.latitude),
          ST_GEOGPOINT(-87.6847, 41.8319)
      ) < 50000
ORDER BY distance_km
LIMIT 20;
