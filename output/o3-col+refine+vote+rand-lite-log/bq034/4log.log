```sql
--Description: 1) Take a quick look at the structure / first rows of the stations table
SELECT *
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
LIMIT 20;
```

```sql
--Description: 2) Stations that report their two–letter “state” code as Illinois (IL)
SELECT id, name, latitude, longitude, state
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE state = 'IL'
LIMIT 20;
```

```sql
--Description: 3) What state codes exist in the stations file? (quick scan)
SELECT DISTINCT state
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE state IS NOT NULL
LIMIT 20;
```

```sql
--Description: 4) Stations whose name already contains the word “CHICAGO”
SELECT id, name, latitude, longitude
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE LOWER(name) LIKE '%chicago%'
LIMIT 20;
```

```sql
--Description: 5) Crude geographic window around Chicago (~1° in each direction)
SELECT id, name, latitude, longitude
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE latitude BETWEEN 41.0 AND 42.5       -- north-south window
  AND longitude BETWEEN -89.0 AND -87.0    -- east-west window
LIMIT 20;
```

```sql
--Description: 6) Compute straight-line distance (metres) from Chicago centre for the
--              rough-windowed stations; list the 20 closest
SELECT id,
       name,
       latitude,
       longitude,
       ST_DISTANCE(
            ST_GEOGPOINT(longitude, latitude),
            ST_GEOGPOINT(-87.6847, 41.8319)      -- Chicago centre
       ) AS distance_m
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE latitude BETWEEN 41.0 AND 42.5
  AND longitude BETWEEN -89.0 AND -87.0
ORDER BY distance_m
LIMIT 20;
```

```sql
--Description: 7) Same idea, but run over the entire table (no pre-window) and keep
--              only stations < 30 km away
SELECT id,
       name,
       latitude,
       longitude,
       ST_DISTANCE(
            ST_GEOGPOINT(longitude, latitude),
            ST_GEOGPOINT(-87.6847, 41.8319)
       ) AS distance_m
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(-87.6847, 41.8319)
      ) < 30000
ORDER BY distance_m
LIMIT 20;
```

```sql
--Description: 8) All stations within a 50-km radius; show distance in kilometres
SELECT id,
       name,
       latitude,
       longitude,
       ROUND( ST_DISTANCE(
                 ST_GEOGPOINT(longitude, latitude),
                 ST_GEOGPOINT(-87.6847, 41.8319)
             ) / 1000, 2 ) AS distance_km
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(-87.6847, 41.8319)
      ) < 50000
ORDER BY distance_km
LIMIT 20;
```

```sql
--Description: 9) Join those 50-km stations to the states lookup to attach full
--              state names (if any)
SELECT s.id,
       s.name,
       st.name AS state_name,
       ROUND( ST_DISTANCE(
                 ST_GEOGPOINT(s.longitude, s.latitude),
                 ST_GEOGPOINT(-87.6847, 41.8319)
             ) / 1000, 2 ) AS distance_km
FROM `bigquery-public-data.ghcn_d.ghcnd_stations` AS s
LEFT JOIN `bigquery-public-data.ghcn_d.ghcnd_states` AS st
       ON s.state = st.code
WHERE ST_DISTANCE(
          ST_GEOGPOINT(s.longitude, s.latitude),
          ST_GEOGPOINT(-87.6847, 41.8319)
      ) < 50000
ORDER BY distance_km
LIMIT 20;
```

```sql
--Description: 10) FINAL ANSWER – return the ids & names of every weather station
--               whose straight-line distance to Chicago centre is < 50 km,
--               ordered from nearest to farthest
SELECT id,
       name
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE ST_DISTANCE(
          ST_GEOGPOINT(longitude, latitude),
          ST_GEOGPOINT(-87.6847, 41.8319)
      ) < 50000
ORDER BY ST_DISTANCE(
            ST_GEOGPOINT(longitude, latitude),
            ST_GEOGPOINT(-87.6847, 41.8319)
         );
```
