Query:
--Description: 5) Crude geographic window around Chicago (~1° in each direction)
SELECT id, name, latitude, longitude
FROM `bigquery-public-data.ghcn_d.ghcnd_stations`
WHERE latitude BETWEEN 41.0 AND 42.5       -- north-south window
  AND longitude BETWEEN -89.0 AND -87.0    -- east-west window
LIMIT 20;
