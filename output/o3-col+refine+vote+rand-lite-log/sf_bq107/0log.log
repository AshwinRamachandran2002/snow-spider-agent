```sql
--Description: 6)  Count distinct variants on the longest reference 
--                 that have ANY genotype > 0 in at least one call-record
SELECT COUNT( DISTINCT v."variant_id")  AS "variant_cnt"
FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
       LATERAL FLATTEN( input => v."call" ) f
WHERE  v."reference_name" = ( SELECT "name"
                              FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
                              ORDER BY "length" DESC
                              LIMIT 1 )
  AND  (
        COALESCE( f.value:"genotype"[0]::INTEGER, 0 ) > 0
     OR COALESCE( f.value:"genotype"[1]::INTEGER, 0 ) > 0
     OR COALESCE( f.value:"genotype"[2]::INTEGER, 0 ) > 0   -- extra guard for polyploids
      );
```

```sql
--Description: 7)  Bring the reference length and the counted variants together
WITH longest_ref AS (
        SELECT "name","length"
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
        ORDER BY "length" DESC
        LIMIT 1
),
var_cnt AS (
        SELECT COUNT( DISTINCT v."variant_id") AS n_var
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
               LATERAL FLATTEN( input => v."call" ) f,
               longest_ref lr
        WHERE  v."reference_name" = lr."name"
          AND ( COALESCE( f.value:"genotype"[0]::INTEGER,0 ) > 0
             OR COALESCE( f.value:"genotype"[1]::INTEGER,0 ) > 0
             OR COALESCE( f.value:"genotype"[2]::INTEGER,0 ) > 0 )
)
SELECT lr."name"                        AS "reference_name",
       lr."length"                      AS "reference_length",
       vc.n_var                         AS "num_variants",
       vc.n_var / lr."length"           AS "variant_density_per_bp"
FROM   longest_ref lr
CROSS JOIN var_cnt vc;
```

```sql
--Description: 8)  (Optional)  Same density calculation but adding transcriptome-only variants
WITH longest_ref AS (
        SELECT "name","length"
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
        ORDER BY "length" DESC
        LIMIT 1
),
genome_var AS (
        SELECT DISTINCT v."variant_id"
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
               LATERAL FLATTEN( input => v."call") f,
               longest_ref lr
        WHERE  v."reference_name" = lr."name"
          AND  ( COALESCE( f.value:"genotype"[0]::INTEGER,0 ) > 0
              OR COALESCE( f.value:"genotype"[1]::INTEGER,0 ) > 0 )
),
trans_var AS (
        SELECT DISTINCT t."variant_id"
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_TRANSCRIPTOME_201703 t,
               LATERAL FLATTEN( input => t."call") f,
               longest_ref lr
        WHERE  t."reference_name" = lr."name"
          AND  ( COALESCE( f.value:"genotype"[0]::INTEGER,0 ) > 0
              OR COALESCE( f.value:"genotype"[1]::INTEGER,0 ) > 0 )
)
SELECT lr."name"                                                         AS "reference_name",
       lr."length"                                                       AS "reference_length",
       ( SELECT COUNT(*) FROM genome_var ) +
       ( SELECT COUNT(*) FROM trans_var )                                AS "total_variants",
       ( ( SELECT COUNT(*) FROM genome_var ) +
         ( SELECT COUNT(*) FROM trans_var ) ) / lr."length"              AS "variant_density_per_bp"
FROM   longest_ref lr;
```

