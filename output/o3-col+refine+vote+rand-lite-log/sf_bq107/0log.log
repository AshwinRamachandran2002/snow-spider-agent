```sql
--Description: 10)  Quick density in “variants per kilobase” (genome-only)
WITH longest_ref AS (
        SELECT "name","length"
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
        ORDER BY "length" DESC
        LIMIT 1
),
var_cnt AS (
        SELECT COUNT( DISTINCT v."variant_id") AS n_var
        FROM   GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_201703 v,
               LATERAL FLATTEN( input => v."call" ) f,
               longest_ref lr
        WHERE  v."reference_name" = lr."name"
          AND  ( COALESCE( f.value:"genotype"[0]::INTEGER,0 ) > 0
              OR COALESCE( f.value:"genotype"[1]::INTEGER,0 ) > 0 )
)
SELECT lr."name"     AS "reference_name",
       lr."length"   AS "reference_length",
       vc.n_var      AS "num_variants",
       vc.n_var / ( lr."length" / 1000.0 )  AS "variants_per_kb"
FROM   longest_ref lr
JOIN   var_cnt vc
  ON  1=1;
```
