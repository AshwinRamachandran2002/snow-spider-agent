  AND `primary_type` = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
-- 4. Description: Count the number of “Motor Vehicle Theft” incidents for each month of 2016.
SELECT EXTRACT(MONTH FROM `date`)  AS month_2016,
       COUNT(*)                    AS incidents
FROM   `bigquery-public-data.chicago_crime.crime`
WHERE  EXTRACT(YEAR  FROM `date`) = 2016
  AND  `primary_type`             = 'MOTOR VEHICLE THEFT'
GROUP  BY month_2016
ORDER  BY month_2016
LIMIT 20;
```

```sql
-- 5. Description: Find the single-month maximum number of “Motor Vehicle Theft” incidents that occurred in 2016.
SELECT MAX(monthly_count) AS highest_monthly_incidents_2016
FROM (
  SELECT EXTRACT(MONTH FROM `date`) AS month_2016,
         COUNT(*)                   AS monthly_count
  FROM   `bigquery-public-data.chicago_crime.crime`
  WHERE  EXTRACT(YEAR FROM `date`) = 2016
    AND  `primary_type`            = 'MOTOR VEHICLE THEFT'
  GROUP  BY month_2016
);
```

Running the final query (Query 5) returns the highest number of motor-vehicle-theft incidents recorded in any single month during 2016.
