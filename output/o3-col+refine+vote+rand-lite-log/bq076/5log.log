```

```sql
-- Description: Show a few 2016 rows where the crime type is specifically “MOTOR VEHICLE THEFT”.
SELECT `date`, `primary_type`, `description`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE `year` = 2016
  AND `primary_type` = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
-- Description: Extract the month number for each 2016 motor-vehicle-theft record (quick visual check).
SELECT EXTRACT(MONTH FROM `date`) AS `month`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE `year` = 2016
  AND `primary_type` = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
-- Description: Count how many motor-vehicle-theft incidents happened in each month of 2016.
SELECT
  EXTRACT(MONTH FROM `date`) AS `month`,
  COUNT(*) AS `incidents`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE `year` = 2016
  AND `primary_type` = 'MOTOR VEHICLE THEFT'
GROUP BY `month`
LIMIT 20;
```

```sql
-- Description: Order the monthly counts from highest to lowest so we can see which month is on top.
SELECT
  EXTRACT(MONTH FROM `date`) AS `month`,
  COUNT(*) AS `incidents`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE `year` = 2016
  AND `primary_type` = 'MOTOR VEHICLE THEFT'
GROUP BY `month`
ORDER BY `incidents` DESC
LIMIT 20;
```

```sql
-- Description: Final answer – return the single highest monthly count of motor-vehicle-theft incidents in 2016.
SELECT incidents AS max_monthly_motor_vehicle_thefts_2016
FROM (
  SELECT
    COUNT(*) AS incidents
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE `year` = 2016
    AND `primary_type` = 'MOTOR VEHICLE THEFT'
  GROUP BY EXTRACT(MONTH FROM `date`)
  ORDER BY incidents DESC
  LIMIT 1
)
LIMIT 20;
```
