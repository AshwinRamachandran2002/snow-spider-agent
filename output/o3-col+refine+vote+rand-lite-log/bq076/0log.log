```

```sql
-- Description: 2) Check which years are present in the data (descending)  
SELECT DISTINCT `year`
FROM `bigquery-public-data.chicago_crime.crime`
ORDER BY `year` DESC
LIMIT 20;
```

```sql
-- Description: 3) See the different primary crime classifications that exist  
SELECT DISTINCT `primary_type`
FROM `bigquery-public-data.chicago_crime.crime`
ORDER BY `primary_type`
LIMIT 20;
```

```sql
-- Description: 4) Look at some 2016 “Motor Vehicle Theft” incidents only  
SELECT `unique_key`,
       `date`,
       `block`,
       `description`
FROM `bigquery-public-data.chicago_crime.crime`
WHERE `year` = 2016
  AND `primary_type` = 'MOTOR VEHICLE THEFT'
LIMIT 20;
```

```sql
-- Description: 5) Count 2016 motor-vehicle-theft incidents by month (descending)  
SELECT
  EXTRACT(MONTH FROM `date`) AS month_num,
  COUNT(*)                  AS mv_theft_cnt
FROM `bigquery-public-data.chicago_crime.crime`
WHERE `year` = 2016
  AND `primary_type` = 'MOTOR VEHICLE THEFT'
GROUP BY month_num
ORDER BY mv_theft_cnt DESC
LIMIT 20;
```

```sql
-- Description: 6) Return only the single month that had the *highest* number of motor-vehicle-theft incidents in 2016 (requested answer)  
SELECT
  MAX(month_mv_cnt) AS highest_monthly_mv_theft_2016
FROM (
  SELECT
    EXTRACT(MONTH FROM `date`) AS month_num,
    COUNT(*)                  AS month_mv_cnt
  FROM `bigquery-public-data.chicago_crime.crime`
  WHERE `year` = 2016
    AND `primary_type` = 'MOTOR VEHICLE THEFT'
  GROUP BY month_num
)
LIMIT 20;
```

The result of the final query (`highest_monthly_mv_theft_2016`) is the largest number of motor-vehicle-theft incidents recorded in any single month during 2016.
