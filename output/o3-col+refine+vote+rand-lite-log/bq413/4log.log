--Description: 3) Look at publications that list any of those GRID-ids in their research_orgs array.
--   (Put the GRID-ids you saw in step-1 into the IN (…) clause.)
SELECT DISTINCT p.id, p.date_inserted, g.id AS qianjiang_grid_id
FROM `bigquery-public-data.dimensions_ai_covid19.publications`  AS p
JOIN UNNEST(p.research_orgs) AS org          --explode publication orgs
JOIN (
      SELECT id
      FROM `bigquery-public-data.dimensions_ai_covid19.grid`
      WHERE LOWER(address.city) = 'qianjiang'
     ) AS g
ON org = g.id
LIMIT 20;
