       p.proceedings_title.preferred AS proceedings_title,
       p.book_title.preferred       AS book_title,
       p.book_series_title.preferred AS book_series_title
FROM `bigquery-public-data.dimensions_ai_covid19.publications`  AS p
JOIN UNNEST(p.research_orgs) AS org
