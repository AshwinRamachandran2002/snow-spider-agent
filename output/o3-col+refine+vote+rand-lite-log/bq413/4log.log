08-30 03:00:10+00:00', 'patent_ids': '[]', 'citations': '[]', 'citations_count': None, 'journal': None, 'journal_lists': '[]', 'parent_id': 'pub.1133499516', 'source_id': None, 'researcher_ids': "['ur.012077721645.80']", 'research_orgs': '[]', 'research_org_cities': '[]', 'research_org_city_names': '[]', 'research_org_countries': '[]', 'research_org_country_names': '[]', 'research_org_state_codes': '[]', 'research_org_state_names': '[]', 'supporting_grant_ids': '[]', 'funder_countries': '[]', 'metrics': {'times_cited': 0, 'recent_citations': 0, 'field_citation_ratio': None, 'relative_citation_ratio': None}, 'authors': "[{'first_name': 'Katarína', 'last_name': 'Greškovičová', 'initials': None, 'researcher_id': 'ur.012077721645.80', 'grid_ids': array([], dtype=object), 'orcid': array(['0000-0002-2070-5660'], dtype=object), 'corresponding': False, 'raw_affiliations': array([], dtype=object), 'affiliations_address': array([], dtype=object)}]", 'concepts': '[]', 'altmetrics': {'id': None, 'score': None}}, {'id': 'pub.1141078913', 'year': 2021, 'doi': '10.1007/978-3-662-63722-7_23', 'volume': None, 'issue': None, 'pages': '379-396', 'subtitles': '[]', 'abstract': {'preferred': 'Zusammenfassung  Studien des IMVR der Universität zu Köln und des AOK-Bundesverbands zeigen, dass die Erbringung einer gesicherten und bedarfsgerechten Pflege durch die Corona-Pandemie vor enorme Herausforderungen gestellt wurde. Den zusätzlichen Belastungen und Herausforderungen waren besonders Führungskräfte ausgesetzt, um zum einen pflegebedürftige Menschen und sich selbst bestmöglich vor dem SARS-CoV-2-Virus zu schützen und zum anderen die Arbeitsorganisation den sich dynamisch ändernden Anforderungen anzupassen und Folgen körperlicher und psychischer Verausgabung der Mitarbeitenden aufzufangen. Die aus der pandemiebedingten Belastungskaskade resultierenden Folgen für den Gesundheitszustand und Präsentismus der Pflege- und vor allem Führungskräfte verstärken den Bedarf an Maßnahmen der Betrieblichen Gesundheitsförderung. Von besonderer Bedeutung sind Angebote zur psychischen Entlastung und zur Steigerung der Technikkompetenz, damit moderne, digital gestützte und damit flexibel einsetzbare Gesundheitsangebote genutzt werden können. Allerdings steht die Betrieblichen Gesundheitsförderung in der Pflege vor einem akuten Mangel an Glaubwürdigkeit, solange Arbeitsbelastungen durch mangelnde Personalressourcen nicht wirksam reduziert werden können.', 'original': None}, 'acknowledgements': None, 'funding_section': None, 'copyright_statement': '© Springer-Verlag GmbH Deutschland, ein Teil von Springer Nature 2021', 'publisher': {'id': 'pblshr.1000297', 'name': 'Springer Nature'}, 'pmid': None, 'pmcid': None, 'type': 'chapter', 'date': '2021-09-14', 'date_online': '2021-09-14', 'date_print': '2021', 'open_access_categories': "['closed']", 'open_access_categories_v2': "['closed']", 'book_title': {'preferred': 'Fehlzeiten-Report 2021', 'original': None}, 'book_series_title': None, 'proceedings_title': None, 'conference': None, 'repository_dois': '[]', 'arxiv_id': None, 'resulting_publication_doi': None, 'eisbn': '978-3-662-63722-7', 'isbn': '978-3-662-63721-0', 'editors': "[{'first_name': {'preferred': 'Bernhard', 'original': None}, 'last_name': {'preferred': 'Badura', 'original': None}}\n {'first_name': {'preferred': 'Antje', 'original': None}, 'last_name': {'preferred': 'Ducki', 'original': None}}\n {'first_name': {'preferred': 'Helmut', 'original': None}, 'last_name': {'preferred': 'Schröder', 'original': None}}\n {'first_name': {'preferred': 'Markus', 'original': None}, 'last_name': {'preferred': 'Meyer', 'original': None}}]", 'reference_ids': "['pub.1117825451' 'pub.1127574165' 'pub.1000071692' 'pub.1131250423'\n 'pub.1084194583' 'pub.1130190998' 'pub.1117827063' 'pub.1117823798'\n 'pub.1117827520' 'pub.1127537031' 'pub.1090007745' 'pub.1005521072']", 'mesh_headings': '[]', 'mesh_terms': '[]', 'category_bra': None, 'category_for': None, 'category_hra': None, 'ca