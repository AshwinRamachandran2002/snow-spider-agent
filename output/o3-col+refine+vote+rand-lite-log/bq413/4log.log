hrcs_rac_v1': None, 'icrp_cso_v1': None, 'icrp_ct_v1': None, 'rcdc_v1': None, 'sdg_v1': None, 'uoa_v1': {'codes': "['B07']", 'full': "[{'id': '30007', 'code': 'B07', 'name': 'Earth Systems and Environmental Sciences'}]"}, 'bra_v2020': None, 'for_v2020': {'first_level': {'codes': "['04' '03' '05']", 'full': "[{'id': '2204', 'code': '04', 'name': 'Earth Sciences'}\n {'id': '2203', 'code': '03', 'name': 'Chemical Sciences'}\n {'id': '2205', 'code': '05', 'name': 'Environmental Sciences'}]"}, 'second_level': {'codes': "['0401' '0399' '0502']", 'full': "[{'id': '2493', 'code': '0401', 'name': 'Atmospheric Sciences'}\n {'id': '2486', 'code': '0399', 'name': 'Other Chemical Sciences'}\n {'id': '2558', 'code': '0502', 'name': 'Environmental Science and Management'}]"}}, 'hrcs_hc_v2020': None, 'hrcs_rac_v2020': None, 'icrp_cso_v2020': None, 'icrp_ct_v2020': None, 'rcdc_v2020': None, 'for_2020_v2022': {'first_level': {'codes': "['37' '41']", 'full': "[{'id': '80008', 'code': '37', 'name': 'Earth Sciences'}\n {'id': '80012', 'code': '41', 'name': 'Environmental Sciences'}]"}, 'second_level': {'codes': "['3701' '4105']", 'full': "[{'id': '80090', 'code': '3701', 'name': 'Atmospheric Sciences'}\n {'id': '80133', 'code': '4105', 'name': 'Pollution And Contamination'}]"}}}, 'date_inserted': '2021-08-17 08:28:37+00:00', 'date_imported_gbq': '2022-08-31 03:03:16+00:00', 'resulting_publication_ids': '[]', 'funder_org_acronyms': "['NOAA']"}, {'id': 'grant.9852376', 'title': "Changes in Air Quality in Los Angeles Associated with COVID-19 'Safer-at-Home' Traffic Reductions", 'abstract': 'In this project, the PIs will analyze observations made during the dramatic reductions in traffic in spring and early summer 2020 (during the COVID-19 period) to better understand the factors contributing to poor air quality in the SoCAB. These observations include those from a suite of air quality monitoring instrumentation that was deployed on the campus of the California Institute of Technology in March 2020 (aerosol composition, PM2.5 mass, NO, NO2, NOy, O3, SO2 and CO). Volatile organic compounds (VOC) sampling was performed in association with UCRiverside and UC-Irvine. CIMS observations of oxygenated VOC (OVOC) and acids were brought online shortly thereafter. PIs will also include air quality data (i.e., O3, NOx, PM2.5 mass, SO2, and CO) collected by the South Coast Air Quality Management District (South Coast AQMD) across the Basin in our analysis to gain a better understanding of the spatial variations of these pollutants. Together, these data provide key observations that can inform what air quality management efforts will be most efficient to bring the Basin into attainment. Here, the PIs propose to use a hierarchy of analysis and modeling approaches to study the 2020 data within the context of both previous observations (e.g. CalNex) and a repeat set of measurements proposed here for spring/summer 2022 when, presumably, traffic levels will be restored to normal.', 'language': 'en', 'original_title': {'value': "Changes in Air Quality in Los Angeles Associated with COVID-19 'Safer-at-Home' Traffic Reductions", 'language': 'en'}, 'original_abstract': {'value': 'In this project, the PIs will analyze observations made during the dramatic reductions in traffic in spring and early summer 2020 (during the COVID-19 period) to better understand the factors contributing to poor air quality in the SoCAB. These observations include those from a suite of air quality monitoring instrumentation that was deployed on the campus of the California Institute of Technology in March 2020 (aerosol composition, PM2.5 mass, NO, NO2, NOy, O3, SO2 and CO). Volatile organic compounds (VOC) sampling was performed in association with UCRiverside and UC-Irvine. CIMS observations of oxygenated VOC (OVOC) and acids were brought online shortly thereafter. PIs will also include air quality data (i.e., O3, NOx, PM2.5 mass, SO2, and CO) collected by the South Coast Air Quality Management District (South Coast AQMD) across the Basin in our analysis to gain a better understanding of the spatial variations of these pollutants. Together, these data provide key observations that can inform what air quality management efforts will be most efficient to bring the Basin into attainment. Here, the PIs propose to use a hierarchy of analysis and modeling approaches to study the 2020 data within the context of both previous observations (e.g. CalNex) and a repeat set of measurements proposed here for spring/summer 2022 when, presumably, traffic levels will be restored to normal.', 'language': 'en'}, 'linkout': None, 'grant_number': 'NA21OAR4310224', 'foa_number': 'Not available', 'start_date': '2021-09-01', 'end_date': '2023-08-31', 'start_year': 2021, 'end_year': 2023, 'active_years': '[2021 2022 2023]', 'investigators': '[]', 'researcher_ids': '[]', 'research_orgs': "['grid.20861.3d']", 'organisation_details': "[{'name': 'CALIFORNIA INSTITUTE OF TECHNOLOGY', 'city': 'Pasadena', 'country': 'US', 'grid_id': 'grid.20861.3d'}]", 'research_org_cities': '[5381396]', 'research_org_state_codes': "['US-CA']", 'research_org_countries': "['US']", 'funder_org': 'grid.3532.7', 'funder_org_cities': '[4140963]', 'funder_org_state_codes': "['US-DC']", 'funder_org_countries': "['US']", 'funding_amount': 298462.0, 'funding_currency': 'USD', 'funding_aud': 408562.0, 'funding_cad': 377251.0, 'funding_chf': 276604.0, 'funding_eur': 265910.0, 'funding_gbp': 223379.0, 'funding_jpy': 35018264.0, 'funding_nzd': 438371.0, 'funding_usd': 298462.0, 'funding_cny': 1905334.0, 'concepts': "[{'concept': 'air quality', 'relevance': 0.6901418935}\n {'concept': 'early summer 2020', 'relevance': 0.6746468871}\n {'concept': 'South Coast Air Quality Management District', 'relevance': 0.6712880571}\n {'concept': 'Air Quality Management District', 'relevance': 0.6698764381}\n {'concept': 'poor air quality', 'relevance': 0.6422908002}\n {'concept': 'air quality data', 'relevance': 0.6331712023}\n {'c