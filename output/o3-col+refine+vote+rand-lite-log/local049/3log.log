Fintech,181
Query:
-- 6) Break down unicorn counts per year *for that top industry only*
WITH top_industry AS (
  SELECT i."industry"
  FROM   "companies_funding"   AS f
  JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
  JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
  WHERE  f."valuation" >= 1000000000
    AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
  GROUP  BY i."industry"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
)
SELECT substr(d."date_joined", 1, 4) AS "year_joined",
       COUNT(*) AS "unicorns_in_top_industry"
FROM   "companies_funding"   AS f
JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
JOIN   top_industry               ON i."industry" = top_industry."industry"
WHERE  f."valuation" >= 1000000000
  AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
GROUP  BY "year_joined"
ORDER  BY "year_joined"
LIMIT 20;
