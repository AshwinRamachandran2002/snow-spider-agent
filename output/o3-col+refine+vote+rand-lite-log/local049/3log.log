```sql
-- 1) Peek at the years when companies joined the list
SELECT DISTINCT substr("date_joined", 1, 4) AS "year_joined"
FROM "companies_dates"
ORDER BY "year_joined"
LIMIT 20;
```

```sql
-- 2) Inspect what industries exist
SELECT DISTINCT "industry"
FROM "companies_industries"
LIMIT 20;
```

```sql
-- 3) See a handful of company valuations to spot unicorns (≥1 B)
SELECT "company_id", "valuation"
FROM "companies_funding"
ORDER BY "valuation" DESC
LIMIT 20;
```

```sql
-- 4) Combine the three tables and get the yearly unicorn counts per industry (2019-2021)
SELECT substr(d."date_joined", 1, 4) AS "year_joined",
       i."industry",
       COUNT(*) AS "unicorns"
FROM   "companies_funding"   AS f
JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000               -- definition of a unicorn
  AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
GROUP  BY "year_joined", i."industry"
ORDER  BY "unicorns" DESC
LIMIT 20;
```

```sql
-- 5) Identify the single “top industry” with the most total unicorns (2019-2021)
SELECT i."industry",
       COUNT(*) AS "total_unicorns_2019_2021"
FROM   "companies_funding"   AS f
JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
WHERE  f."valuation" >= 1000000000
  AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
GROUP  BY i."industry"
ORDER  BY "total_unicorns_2019_2021" DESC
LIMIT 1;
```

```sql
-- 6) Break down unicorn counts per year *for that top industry only*
WITH top_industry AS (
  SELECT i."industry"
  FROM   "companies_funding"   AS f
  JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
  JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
  WHERE  f."valuation" >= 1000000000
    AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
  GROUP  BY i."industry"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
)
SELECT substr(d."date_joined", 1, 4) AS "year_joined",
       COUNT(*) AS "unicorns_in_top_industry"
FROM   "companies_funding"   AS f
JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
JOIN   top_industry               ON i."industry" = top_industry."industry"
WHERE  f."valuation" >= 1000000000
  AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
GROUP  BY "year_joined"
ORDER  BY "year_joined"
LIMIT 20;
```

```sql
-- 7) Calculate the average number of new unicorns per year (2019-2021) in the top industry
WITH top_industry AS (
  SELECT i."industry"
  FROM   "companies_funding"   AS f
  JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
  JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
  WHERE  f."valuation" >= 1000000000
    AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
  GROUP  BY i."industry"
  ORDER  BY COUNT(*) DESC
  LIMIT 1
),
yearly AS (
  SELECT substr(d."date_joined", 1, 4) AS "year_joined",
         COUNT(*) AS "unicorns"
  FROM   "companies_funding"   AS f
  JOIN   "companies_dates"     AS d ON f."company_id" = d."company_id"
  JOIN   "companies_industries" AS i ON f."company_id" = i."company_id"
  JOIN   top_industry               ON i."industry" = top_industry."industry"
  WHERE  f."valuation" >= 1000000000
    AND  substr(d."date_joined", 1, 4) BETWEEN '2019' AND '2021'
  GROUP  BY "year_joined"
)
SELECT top_industry."industry"                 AS "top_industry",
       ROUND(AVG(yearly."unicorns"), 2)        AS "avg_unicorns_per_year_2019_2021"
FROM   yearly, top_industry
LIMIT 20;
```
