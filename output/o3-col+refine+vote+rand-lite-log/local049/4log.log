```sql
--Description: See how many unicorns (valuation ≥1B) joined per year (2019-2021) in each industry
SELECT i.industry,
       substr(d.date_joined, 1, 4) AS join_year,
       COUNT(*) AS unicorns
FROM   companies_funding  AS f
JOIN   companies_dates    AS d ON f.company_id = d.company_id
JOIN   companies_industries AS i ON f.company_id = i.company_id
WHERE  f.valuation >= 1000000000            -- unicorn threshold
  AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
GROUP  BY i.industry, join_year
ORDER  BY unicorns DESC
LIMIT 20;
```

```sql
--Description: Aggregate total unicorns (2019-2021) per industry to find the top one
SELECT i.industry,
       COUNT(*) AS total_2019_2021
FROM   companies_funding  AS f
JOIN   companies_dates    AS d ON f.company_id = d.company_id
JOIN   companies_industries AS i ON f.company_id = i.company_id
WHERE  f.valuation >= 1000000000
  AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
GROUP  BY i.industry
ORDER  BY total_2019_2021 DESC
LIMIT 20;
```

```sql
--Description: Retrieve the exact top industry name (highest total unicorns 2019-2021)
SELECT industry
FROM (
      SELECT i.industry,
             COUNT(*) AS total_unicorns
      FROM   companies_funding  AS f
      JOIN   companies_dates    AS d ON f.company_id = d.company_id
      JOIN   companies_industries AS i ON f.company_id = i.company_id
      WHERE  f.valuation >= 1000000000
        AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
      GROUP  BY i.industry
      ORDER  BY total_unicorns DESC
     )
LIMIT 1;
```

```sql
--Description: Count unicorns per year (2019-2021) only for the top industry (replace 'Fintech' if returned differently)
SELECT substr(d.date_joined, 1, 4) AS join_year,
       COUNT(*) AS unicorns
FROM   companies_funding  AS f
JOIN   companies_dates    AS d ON f.company_id = d.company_id
JOIN   companies_industries AS i ON f.company_id = i.company_id
WHERE  f.valuation >= 1000000000
  AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
  AND  i.industry = 'Fintech'               -- top industry name
GROUP  BY join_year
ORDER  BY join_year
LIMIT 20;
```

```sql
--Description: Compute average number of new unicorns per year (2019-2021) in the top industry
SELECT AVG(year_count) AS avg_unicorns_per_year
FROM (
      SELECT substr(d.date_joined, 1, 4) AS join_year,
             COUNT(*) AS year_count
      FROM   companies_funding  AS f
      JOIN   companies_dates    AS d ON f.company_id = d.company_id
      JOIN   companies_industries AS i ON f.company_id = i.company_id
      WHERE  f.valuation >= 1000000000
        AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
        AND  i.industry = 'Fintech'        -- top industry name
      GROUP  BY join_year
     );
```

```sql
--Description: View individual unicorn companies from top industry for verification (limit 20)
SELECT f.company_id,
       d.date_joined,
       f.valuation,
       i.industry
FROM   companies_funding  AS f
JOIN   companies_dates    AS d ON f.company_id = d.company_id
JOIN   companies_industries AS i ON f.company_id = i.company_id
WHERE  f.valuation >= 1000000000
  AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
  AND  i.industry = 'Fintech'
LIMIT 20;
```

```sql
--Description: Final concise answer – average number of new unicorns per year (2019-2021) in the top industry
SELECT i.industry,
       ROUND(1.0 * COUNT(*) / 3, 2) AS avg_unicorns_per_year
FROM   companies_funding  AS f
JOIN   companies_dates    AS d ON f.company_id = d.company_id
JOIN   companies_industries AS i ON f.company_id = i.company_id
WHERE  f.valuation >= 1000000000
  AND  substr(d.date_joined, 1, 4) IN ('2019','2020','2021')
GROUP  BY i.industry
ORDER  BY COUNT(*) DESC
LIMIT 1;
```
