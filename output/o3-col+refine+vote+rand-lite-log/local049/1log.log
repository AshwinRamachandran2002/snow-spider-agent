```sql
--Description: Identify every unicorn (valuation ≥ $1 B) together with its industry  
SELECT DISTINCT cf."company_id",
       ci."industry"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON ci."company_id" = cf."company_id"
WHERE  cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: Count how many unicorns each industry has in total  
SELECT ci."industry",
       COUNT(DISTINCT cf."company_id") AS "unicorn_cnt"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON ci."company_id" = cf."company_id"
WHERE  cf."valuation" >= 1000000000
GROUP BY ci."industry"
ORDER BY "unicorn_cnt" DESC
LIMIT 20;
```

```sql
--Description: For the most common industry found above, count new unicorns per year (2019-2021)  
SELECT SUBSTR(cd."date_joined",1,4) AS "year",
       COUNT(DISTINCT cd."company_id") AS "new_unicorns"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd  ON cd."company_id" = cf."company_id"
JOIN   "companies_industries" AS ci  ON ci."company_id" = cf."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  ci."industry" = (
        SELECT ci2."industry"
        FROM   "companies_funding"   AS cf2
        JOIN   "companies_industries" AS ci2
               ON ci2."company_id" = cf2."company_id"
        WHERE  cf2."valuation" >= 1000000000
        GROUP BY ci2."industry"
        ORDER BY COUNT(*) DESC
        LIMIT 1               -- <- top industry
       )
  AND  SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
GROUP BY "year"
ORDER BY "year";
```

```sql
--Description: Compute the average number of new unicorns per year for that top industry (2019-2021)  
SELECT AVG("new_unicorns") AS "avg_new_unicorns_per_year"
FROM (
    SELECT SUBSTR(cd."date_joined",1,4) AS "year",
           COUNT(DISTINCT cd."company_id") AS "new_unicorns"
    FROM   "companies_funding"    AS cf
    JOIN   "companies_dates"      AS cd  ON cd."company_id" = cf."company_id"
    JOIN   "companies_industries" AS ci  ON ci."company_id" = cf."company_id"
    WHERE  cf."valuation" >= 1000000000
      AND  ci."industry" = (
            SELECT ci2."industry"
            FROM   "companies_funding"    AS cf2
            JOIN   "companies_industries" AS ci2
                   ON ci2."company_id" = cf2."company_id"
            WHERE  cf2."valuation" >= 1000000000
            GROUP BY ci2."industry"
            ORDER BY COUNT(*) DESC
            LIMIT 1
           )
      AND  SUBSTR(cd."date_joined",1,4) IN ('2019','2020','2021')
    GROUP BY "year"
);
```
