```sql
-- 4. Sample unicorn-status companies (valuation ≥ 1 B) with their industries
SELECT cf."company_id",
       cf."valuation",
       ci."industry"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
-- 5. Bring in the date they joined to see WHEN those unicorns appeared
SELECT cf."company_id",
       cf."valuation",
       ci."industry",
       cd."date_joined"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates"      AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
-- 6. Count unicorns (2019-2021) by industry to find the top industry
SELECT ci."industry",
       COUNT(*) AS "unicorn_count"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates"      AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  cd."date_joined" >= '2019-01-01'
  AND  cd."date_joined" <  '2022-01-01'
GROUP  BY ci."industry"
ORDER  BY "unicorn_count" DESC
LIMIT 20;
```

```sql
-- 7. Pick the single top industry in that 2019-2021 window
SELECT ci."industry"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates"      AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  cd."date_joined" >= '2019-01-01'
  AND  cd."date_joined" <  '2022-01-01'
GROUP  BY ci."industry"
ORDER  BY COUNT(*) DESC
LIMIT 1;
```

```sql
-- 8. Year-by-year unicorn counts for that top industry (2019-2021)
SELECT strftime('%Y', cd."date_joined") AS "year",
       COUNT(*)                        AS "unicorn_count"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates"      AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  cd."date_joined" >= '2019-01-01'
  AND  cd."date_joined" <  '2022-01-01'
  AND  ci."industry" = (
        SELECT  ci2."industry"
        FROM    "companies_funding"   AS cf2
        JOIN    "companies_industries" AS ci2
                ON cf2."company_id" = ci2."company_id"
        JOIN    "companies_dates"      AS cd2
                ON cf2."company_id" = cd2."company_id"
        WHERE   cf2."valuation" >= 1000000000
          AND   cd2."date_joined" >= '2019-01-01'
          AND   cd2."date_joined" <  '2022-01-01'
        GROUP   BY ci2."industry"
        ORDER   BY COUNT(*) DESC
        LIMIT   1
       )
GROUP  BY "year"
ORDER  BY "year"
LIMIT 20;
```

```sql
-- 9. Average number of new unicorns per year (2019-2021) in that top industry
SELECT AVG("unicorn_count") AS "avg_unicorns_per_year"
FROM (
      SELECT strftime('%Y', cd."date_joined") AS "year",
             COUNT(*)                        AS "unicorn_count"
      FROM   "companies_funding"   AS cf
      JOIN   "companies_industries" AS ci
             ON cf."company_id" = ci."company_id"
      JOIN   "companies_dates"      AS cd
             ON cf."company_id" = cd."company_id"
      WHERE  cf."valuation" >= 1000000000
        AND  cd."date_joined" >= '2019-01-01'
        AND  cd."date_joined" <  '2022-01-01'
        AND  ci."industry" = (
              SELECT  ci2."industry"
              FROM    "companies_funding"   AS cf2
              JOIN    "companies_industries" AS ci2
                     ON cf2."company_id" = ci2."company_id"
              JOIN    "companies_dates"      AS cd2
                     ON cf2."company_id" = cd2."company_id"
              WHERE   cf2."valuation" >= 1000000000
                AND   cd2."date_joined" >= '2019-01-01'
                AND   cd2."date_joined" <  '2022-01-01'
              GROUP   BY ci2."industry"
              ORDER   BY COUNT(*) DESC
              LIMIT   1
             )
      GROUP  BY "year"
     )
LIMIT 20;
```

