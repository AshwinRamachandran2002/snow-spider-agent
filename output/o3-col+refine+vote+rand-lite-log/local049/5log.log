-- 8. Year-by-year unicorn counts for that top industry (2019-2021)
SELECT strftime('%Y', cd."date_joined") AS "year",
       COUNT(*)                        AS "unicorn_count"
FROM   "companies_funding"   AS cf
JOIN   "companies_industries" AS ci
       ON cf."company_id" = ci."company_id"
JOIN   "companies_dates"      AS cd
       ON cf."company_id" = cd."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  cd."date_joined" >= '2019-01-01'
  AND  cd."date_joined" <  '2022-01-01'
  AND  ci."industry" = (
        SELECT  ci2."industry"
        FROM    "companies_funding"   AS cf2
        JOIN    "companies_industries" AS ci2
                ON cf2."company_id" = ci2."company_id"
        JOIN    "companies_dates"      AS cd2
                ON cf2."company_id" = cd2."company_id"
        WHERE   cf2."valuation" >= 1000000000
          AND   cd2."date_joined" >= '2019-01-01'
          AND   cd2."date_joined" <  '2022-01-01'
        GROUP   BY ci2."industry"
        ORDER   BY COUNT(*) DESC
        LIMIT   1
