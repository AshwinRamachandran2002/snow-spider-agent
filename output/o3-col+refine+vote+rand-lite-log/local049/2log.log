```sql
-- Description: 1) Peek at companies that already have unicorn-level valuations
SELECT DISTINCT company_id, valuation
FROM companies_funding
WHERE valuation >= 1000000000
LIMIT 20;
```

```sql
-- Description: 2) See what industries those unicorn companies belong to
SELECT DISTINCT cf.company_id, ci.industry
FROM companies_funding AS cf
JOIN companies_industries AS ci USING (company_id)
WHERE cf.valuation >= 1000000000
LIMIT 20;
```

```sql
-- Description: 3) Look at the join dates of unicorn companies
SELECT DISTINCT cf.company_id, cd.date_joined
FROM companies_funding AS cf
JOIN companies_dates  AS cd USING (company_id)
WHERE cf.valuation >= 1000000000
LIMIT 20;
```

```sql
-- Description: 4) Restrict unicorns to those that appeared between 2019-2021
SELECT DISTINCT cf.company_id,
       substr(cd.date_joined,1,4)  AS yr
FROM companies_funding  AS cf
JOIN companies_dates    AS cd USING (company_id)
WHERE cf.valuation >= 1000000000
  AND yr BETWEEN '2019' AND '2021'
LIMIT 20;
```

```sql
-- Description: 5) Count those 2019-2021 unicorns by industry
SELECT ci.industry,
       COUNT(*) AS unicorn_cnt
FROM companies_funding      AS cf
JOIN companies_dates        AS cd USING (company_id)
JOIN companies_industries   AS ci USING (company_id)
WHERE cf.valuation >= 1000000000
  AND substr(cd.date_joined,1,4) BETWEEN '2019' AND '2021'
GROUP BY ci.industry
ORDER BY unicorn_cnt DESC
LIMIT 20;
```

```sql
-- Description: 6) Identify the single top industry for 2019-2021 unicorn creation
SELECT ci.industry
FROM companies_funding     AS cf
JOIN companies_dates       AS cd USING (company_id)
JOIN companies_industries  AS ci USING (company_id)
WHERE cf.valuation >= 1000000000
  AND substr(cd.date_joined,1,4) BETWEEN '2019' AND '2021'
GROUP BY ci.industry
ORDER BY COUNT(*) DESC
LIMIT 1;
```

```sql
-- Description: 7) For that top industry, count new unicorns for each year 2019-2021
WITH top_industry AS (
   SELECT ci.industry
   FROM companies_funding   AS cf
   JOIN companies_dates     AS cd USING (company_id)
   JOIN companies_industries AS ci USING (company_id)
   WHERE cf.valuation >= 1000000000
     AND substr(cd.date_joined,1,4) BETWEEN '2019' AND '2021'
   GROUP BY ci.industry
   ORDER BY COUNT(*) DESC
   LIMIT 1
)
SELECT substr(cd.date_joined,1,4)       AS yr,
       COUNT(*)                         AS new_unicorns
FROM   companies_funding   AS cf
JOIN   companies_dates     AS cd USING (company_id)
JOIN   companies_industries AS ci USING (company_id), top_industry
WHERE  cf.valuation >= 1000000000
  AND  substr(cd.date_joined,1,4) BETWEEN '2019' AND '2021'
  AND  ci.industry = top_industry.industry
GROUP  BY yr
ORDER  BY yr;
```

```sql
-- Description: 8) Average number of new unicorns per year in that top industry
WITH unicorns AS (
   SELECT cf.company_id,
          ci.industry,
          substr(cd.date_joined,1,4) AS yr
   FROM   companies_funding     AS cf
   JOIN   companies_dates       AS cd USING (company_id)
   JOIN   companies_industries  AS ci USING (company_id)
   WHERE  cf.valuation >= 1000000000
     AND  yr BETWEEN '2019' AND '2021'
),
top_industry AS (
   SELECT industry
   FROM   unicorns
   GROUP  BY industry
   ORDER  BY COUNT(*) DESC
   LIMIT 1
),
yearly AS (
   SELECT yr, COUNT(*) AS year_cnt
   FROM   unicorns, top_industry
   WHERE  unicorns.industry = top_industry.industry
   GROUP  BY yr
)
SELECT AVG(year_cnt) AS avg_new_unicorns_per_year
FROM   yearly;
```

```sql
-- Description: 9) Show final average together with the name of the top industry
WITH unicorns AS (
   SELECT cf.company_id,
          ci.industry,
          substr(cd.date_joined,1,4) AS yr
   FROM   companies_funding     AS cf
   JOIN   companies_dates       AS cd USING (company_id)
   JOIN   companies_industries  AS ci USING (company_id)
   WHERE  cf.valuation >= 1000000000
     AND  yr BETWEEN '2019' AND '2021'
),
top_industry AS (
   SELECT industry
   FROM   unicorns
   GROUP  BY industry
   ORDER  BY COUNT(*) DESC
   LIMIT 1
),
yearly AS (
   SELECT yr, COUNT(*) AS year_cnt
   FROM   unicorns
   WHERE  industry = (SELECT industry FROM top_industry)
   GROUP  BY yr
)
SELECT (SELECT industry FROM top_industry)          AS industry,
       AVG(year_cnt)                                AS avg_new_unicorns_per_year
FROM   yearly;
```
