--Description: 6) Aggregate total unicorn counts across 2019-2021 for every industry
SELECT ci."industry",
       COUNT(*) AS "total_2019_2021"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
