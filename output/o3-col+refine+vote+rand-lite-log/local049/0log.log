Query:
--Description: 9) Compute the average number of new unicorns per year in that top industry (2019-2021)
SELECT AVG("yearly_count") AS "avg_new_unicorns_per_year"
FROM (
      SELECT substr(cd."date_joined",1,4) AS "year_joined",
             COUNT(*)                      AS "yearly_count"
      FROM   "companies_funding"    AS cf
      JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
      JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
      WHERE  cf."valuation" >= 1000000000
        AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
        AND  ci."industry" = (
              SELECT ci2."industry"
              FROM   "companies_funding"    AS cf2
              JOIN   "companies_dates"      AS cd2 ON cf2."company_id" = cd2."company_id"
              JOIN   "companies_industries" AS ci2 ON cf2."company_id" = ci2."company_id"
              WHERE  cf2."valuation" >= 1000000000
                AND  substr(cd2."date_joined",1,4) BETWEEN '2019' AND '2021'
              GROUP  BY ci2."industry"
              ORDER  BY COUNT(*) DESC
              LIMIT 1
            )
      GROUP  BY "year_joined"
     );
