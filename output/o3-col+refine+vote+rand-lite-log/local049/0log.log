```sql
--Description: 1) Look at some funding records to understand valuation magnitudes
SELECT "company_id", "valuation", "funding"
FROM "companies_funding"
LIMIT 20;
```

```sql
--Description: 2) Inspect the years contained in the “date_joined” column
SELECT DISTINCT substr("date_joined",1,4) AS "year"
FROM "companies_dates"
ORDER BY "year"
LIMIT 20;
```

```sql
--Description: 3) Review all distinct industries that companies belong to
SELECT DISTINCT "industry"
FROM "companies_industries"
LIMIT 20;
```

```sql
--Description: 4) List every company that met the unicorn valuation (≥ 1 B) together with its join-year and industry
SELECT cf."company_id",
       cf."valuation",
       substr(cd."date_joined",1,4) AS "year_joined",
       ci."industry"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
LIMIT 20;
```

```sql
--Description: 5) Count new unicorns per industry per year (2019-2021 only)
SELECT substr(cd."date_joined",1,4)         AS "year_joined",
       ci."industry",
       COUNT(*)                              AS "unicorns"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY "year_joined", ci."industry"
ORDER  BY "industry", "year_joined"
LIMIT 20;
```

```sql
--Description: 6) Aggregate total unicorn counts across 2019-2021 for every industry
SELECT ci."industry",
       COUNT(*) AS "total_2019_2021"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY ci."industry"
ORDER  BY "total_2019_2021" DESC
LIMIT 20;
```

```sql
--Description: 7) Identify the single top industry (most unicorns 2019-2021)
SELECT ci."industry"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
GROUP  BY ci."industry"
ORDER  BY COUNT(*) DESC
LIMIT 1;
```

```sql
--Description: 8) For that top industry, count new unicorns per year (2019-2021)
SELECT substr(cd."date_joined",1,4) AS "year_joined",
       COUNT(*)                     AS "new_unicorns"
FROM   "companies_funding"    AS cf
JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
WHERE  cf."valuation" >= 1000000000
  AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
  AND  ci."industry" = (
        SELECT ci2."industry"
        FROM   "companies_funding"    AS cf2
        JOIN   "companies_dates"      AS cd2 ON cf2."company_id" = cd2."company_id"
        JOIN   "companies_industries" AS ci2 ON cf2."company_id" = ci2."company_id"
        WHERE  cf2."valuation" >= 1000000000
          AND  substr(cd2."date_joined",1,4) BETWEEN '2019' AND '2021'
        GROUP  BY ci2."industry"
        ORDER  BY COUNT(*) DESC
        LIMIT 1
      )
GROUP  BY "year_joined"
ORDER  BY "year_joined";
```

```sql
--Description: 9) Compute the average number of new unicorns per year in that top industry (2019-2021)
SELECT AVG("yearly_count") AS "avg_new_unicorns_per_year"
FROM (
      SELECT substr(cd."date_joined",1,4) AS "year_joined",
             COUNT(*)                      AS "yearly_count"
      FROM   "companies_funding"    AS cf
      JOIN   "companies_dates"      AS cd ON cf."company_id" = cd."company_id"
      JOIN   "companies_industries" AS ci ON cf."company_id" = ci."company_id"
      WHERE  cf."valuation" >= 1000000000
        AND  substr(cd."date_joined",1,4) BETWEEN '2019' AND '2021'
        AND  ci."industry" = (
              SELECT ci2."industry"
              FROM   "companies_funding"    AS cf2
              JOIN   "companies_dates"      AS cd2 ON cf2."company_id" = cd2."company_id"
              JOIN   "companies_industries" AS ci2 ON cf2."company_id" = ci2."company_id"
              WHERE  cf2."valuation" >= 1000000000
                AND  substr(cd2."date_joined",1,4) BETWEEN '2019' AND '2021'
              GROUP  BY ci2."industry"
              ORDER  BY COUNT(*) DESC
              LIMIT 1
            )
      GROUP  BY "year_joined"
     );
```

These nine queries progressively explore the relevant data and finally calculate the requested average number of new unicorn companies per year (2019, 2020, 2021) in the industry that produced the most unicorns during that period.
