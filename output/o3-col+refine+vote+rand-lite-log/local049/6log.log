Query:
-- Description: From those unicorns, keep only the ones whose “date_joined” year is 2019-2021
SELECT DISTINCT cd.company_id,
       SUBSTR(cd.date_joined, 1, 4) AS year_joined
FROM companies_dates AS cd
JOIN companies_funding AS cf
  ON cd.company_id = cf.company_id
WHERE cf.valuation >= 1000000000
  AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
LIMIT 20;
