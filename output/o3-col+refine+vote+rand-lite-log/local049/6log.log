Query:
-- Description: Attach the industry for every 2019-2021 unicorn and count how many in each industry
SELECT ci.industry,
       COUNT(*) AS unicorns_2019_2021
FROM companies_industries AS ci
JOIN (
        SELECT cd.company_id
        FROM companies_dates AS cd
        JOIN companies_funding AS cf
          ON cd.company_id = cf.company_id
        WHERE cf.valuation >= 1000000000
          AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
     ) AS u
  ON ci.company_id = u.company_id
GROUP BY ci.industry
ORDER BY unicorns_2019_2021 DESC
LIMIT 20;
