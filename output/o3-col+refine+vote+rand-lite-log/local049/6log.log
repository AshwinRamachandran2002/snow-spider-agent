```sql
-- Description: Look at some company valuations (to see where the unicorn-cutoff of ≥1 B fits)
SELECT DISTINCT valuation
FROM companies_funding
ORDER BY valuation DESC
LIMIT 20;
```

```sql
-- Description: Sample the “date_joined” values so we know their format (will need the years 2019-2021)
SELECT DISTINCT date_joined
FROM companies_dates
ORDER BY date_joined
LIMIT 20;
```

```sql
-- Description: Inspect the list of industries that appear in the data set
SELECT DISTINCT industry
FROM companies_industries
ORDER BY industry
LIMIT 20;
```

```sql
-- Description: Find all companies that qualify as unicorns (valuation ≥ 1 000 000 000)
SELECT DISTINCT cf.company_id
FROM companies_funding AS cf
WHERE cf.valuation >= 1000000000
LIMIT 20;
```

```sql
-- Description: From those unicorns, keep only the ones whose “date_joined” year is 2019-2021
SELECT DISTINCT cd.company_id,
       SUBSTR(cd.date_joined, 1, 4) AS year_joined
FROM companies_dates AS cd
JOIN companies_funding AS cf
  ON cd.company_id = cf.company_id
WHERE cf.valuation >= 1000000000
  AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
LIMIT 20;
```

```sql
-- Description: Attach the industry for every 2019-2021 unicorn and count how many in each industry
SELECT ci.industry,
       COUNT(*) AS unicorns_2019_2021
FROM companies_industries AS ci
JOIN (
        SELECT cd.company_id
        FROM companies_dates AS cd
        JOIN companies_funding AS cf
          ON cd.company_id = cf.company_id
        WHERE cf.valuation >= 1000000000
          AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
     ) AS u
  ON ci.company_id = u.company_id
GROUP BY ci.industry
ORDER BY unicorns_2019_2021 DESC
LIMIT 20;
```

```sql
-- Description: Count the number of unicorns in the top industry (Fintech in this example) for each year
SELECT SUBSTR(cd.date_joined, 1, 4) AS year_joined,
       COUNT(*)                      AS unicorns_in_year
FROM companies_dates  AS cd
JOIN companies_funding AS cf
  ON cd.company_id = cf.company_id
JOIN companies_industries AS ci
  ON cd.company_id = ci.company_id
WHERE cf.valuation >= 1000000000
  AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
  AND ci.industry = 'Fintech'          -- replace by actual top-industry name from previous query
GROUP BY year_joined
ORDER BY year_joined;
```

```sql
-- Description: Compute the average number of new unicorns per year (2019-2021) in that top industry
SELECT AVG(unicorns_in_year) AS avg_unicorns_per_year
FROM (
       SELECT SUBSTR(cd.date_joined, 1, 4) AS year_joined,
              COUNT(*) AS unicorns_in_year
       FROM companies_dates  AS cd
       JOIN companies_funding AS cf
         ON cd.company_id = cf.company_id
       JOIN companies_industries AS ci
         ON cd.company_id = ci.company_id
       WHERE cf.valuation >= 1000000000
         AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
         AND ci.industry = 'Fintech'      -- top industry found earlier
       GROUP BY year_joined
     );
```

```sql
-- Description: Show the final answer together with the top industry’s name for clarity
SELECT 'Fintech'                 AS top_industry,    -- substitute if different
       ROUND(AVG(unicorns_in_year), 2) AS avg_new_unicorns_2019_2021
FROM (
       SELECT SUBSTR(cd.date_joined, 1, 4) AS year_joined,
              COUNT(*) AS unicorns_in_year
       FROM companies_dates  AS cd
       JOIN companies_funding AS cf
         ON cd.company_id = cf.company_id
       JOIN companies_industries AS ci
         ON cd.company_id = ci.company_id
       WHERE cf.valuation >= 1000000000
         AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
         AND ci.industry = 'Fintech'      -- top industry
       GROUP BY year_joined
     );
```
