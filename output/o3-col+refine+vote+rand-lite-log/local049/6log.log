Query:
-- Description: Compute the average number of new unicorns per year (2019-2021) in that top industry
SELECT AVG(unicorns_in_year) AS avg_unicorns_per_year
FROM (
       SELECT SUBSTR(cd.date_joined, 1, 4) AS year_joined,
              COUNT(*) AS unicorns_in_year
       FROM companies_dates  AS cd
       JOIN companies_funding AS cf
         ON cd.company_id = cf.company_id
       JOIN companies_industries AS ci
         ON cd.company_id = ci.company_id
       WHERE cf.valuation >= 1000000000
         AND SUBSTR(cd.date_joined, 1, 4) BETWEEN '2019' AND '2021'
         AND ci.industry = 'Fintech'      -- top industry found earlier
       GROUP BY year_joined
     );
