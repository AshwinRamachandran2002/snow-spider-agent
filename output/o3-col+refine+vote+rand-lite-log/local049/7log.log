```sql
--2. List all companies whose latest recorded valuation is ≥ $1 billion (“unicorns”)
SELECT DISTINCT company_id
FROM companies_funding
WHERE valuation >= 1000000000
LIMIT 20;
```

```sql
--3. Bring in the year each unicorn was first recorded in the data set (from companies_dates)
SELECT cf.company_id,
       substr(cd.date_joined, 1, 4) AS join_year
FROM   companies_funding cf
JOIN   companies_dates  cd USING (company_id)
WHERE  cf.valuation >= 1000000000
LIMIT 20;
```

```sql
--4. Restrict to the requested 2019-2021 period
SELECT company_id,
       join_year
FROM  (
    SELECT cf.company_id,
           substr(cd.date_joined, 1, 4) AS join_year
    FROM   companies_funding cf
    JOIN   companies_dates cd USING (company_id)
    WHERE  cf.valuation >= 1000000000
)
WHERE join_year IN ('2019','2020','2021')
LIMIT 20;
```

```sql
--5. Attach each unicorn’s industry
SELECT ui.company_id,
       ui.join_year,
       ci.industry
FROM (
    SELECT cf.company_id,
           substr(cd.date_joined,1,4) AS join_year
    FROM   companies_funding cf
    JOIN   companies_dates cd USING (company_id)
    WHERE  cf.valuation >= 1000000000
      AND  substr(cd.date_joined,1,4) IN ('2019','2020','2021')
) AS ui
JOIN companies_industries ci USING (company_id)
LIMIT 20;
```

```sql
--6. Count unicorns per industry over 2019-2021
SELECT industry,
       COUNT(*) AS unicorns_2019_2021
FROM (
    SELECT ui.company_id,
           ui.join_year,
           ci.industry
    FROM (
        SELECT cf.company_id,
               substr(cd.date_joined,1,4) AS join_year
        FROM   companies_funding cf
        JOIN   companies_dates cd USING (company_id)
        WHERE  cf.valuation >= 1000000000
          AND  substr(cd.date_joined,1,4) IN ('2019','2020','2021')
    ) ui
    JOIN companies_industries ci USING (company_id)
)
GROUP BY industry
ORDER BY unicorns_2019_2021 DESC
LIMIT 20;
```

```sql
--7. Identify the single “top” industry by total unicorn count (take the first row)
SELECT industry
FROM (
    SELECT industry,
           COUNT(*) AS unicorns_2019_2021
    FROM (
        SELECT ui.company_id,
               ui.join_year,
               ci.industry
        FROM (
            SELECT cf.company_id,
                   substr(cd.date_joined,1,4) AS join_year
            FROM   companies_funding cf
            JOIN   companies_dates cd USING (company_id)
            WHERE  cf.valuation >= 1000000000
              AND  substr(cd.date_joined,1,4) IN ('2019','2020','2021')
        ) ui
        JOIN companies_industries ci USING (company_id)
    )
    GROUP BY industry
    ORDER BY unicorns_2019_2021 DESC
    LIMIT 1
);
```

```sql
--8. Count the yearly number of unicorns **within** that top industry
SELECT substr(cd.date_joined,1,4) AS year,
       COUNT(*) AS yearly_unicorns
FROM   companies_funding cf
JOIN   companies_dates cd  USING (company_id)
JOIN   companies_industries ci USING (company_id)
WHERE  cf.valuation >= 1000000000
  AND  substr(cd.date_joined,1,4) IN ('2019','2020','2021')
  AND  ci.industry = (
        SELECT industry
        FROM (
            SELECT industry,
                   COUNT(*) AS unicorns_2019_2021
            FROM   companies_funding cf2
            JOIN   companies_dates cd2 USING (company_id)
            JOIN   companies_industries ci2 USING (company_id)
            WHERE  cf2.valuation >= 1000000000
              AND  substr(cd2.date_joined,1,4) IN ('2019','2020','2021')
            GROUP BY industry
            ORDER BY 2 DESC
            LIMIT 1
        )
      )
GROUP BY year
ORDER BY year
LIMIT 20;
```

```sql
--9. Compute the average yearly count of new unicorns in that top industry (2019-2021)
SELECT AVG(yearly_unicorns) AS avg_new_unicorns_per_year
FROM (
    SELECT substr(cd.date_joined,1,4) AS year,
           COUNT(*)                   AS yearly_unicorns
    FROM   companies_funding cf
    JOIN   companies_dates cd  USING (company_id)
    JOIN   companies_industries ci USING (company_id)
    WHERE  cf.valuation >= 1000000000
      AND  substr(cd.date_joined,1,4) IN ('2019','2020','2021')
      AND  ci.industry = (
            SELECT industry
            FROM (
                SELECT industry,
                       COUNT(*) AS unicorns_2019_2021
                FROM   companies_funding cf2
                JOIN   companies_dates cd2 USING (company_id)
                JOIN   companies_industries ci2 USING (company_id)
                WHERE  cf2.valuation >= 1000000000
                  AND  substr(cd2.date_joined,1,4) IN ('2019','2020','2021')
                GROUP BY industry
                ORDER BY 2 DESC
                LIMIT 1
            )
          )
    GROUP BY year
);
```

