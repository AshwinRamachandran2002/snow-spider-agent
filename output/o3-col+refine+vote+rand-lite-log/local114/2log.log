```sql
--Description: List all web regions.
SELECT DISTINCT id, name 
FROM web_region 
LIMIT 20;
```

```sql
--Description: Show each sales representative along with the region he / she belongs to.
SELECT DISTINCT ws.id   AS sales_rep_id,
       ws.name AS sales_rep_name,
       ws.region_id,
       wr.name AS region_name
FROM web_sales_reps AS ws
LEFT JOIN web_region AS wr
       ON ws.region_id = wr.id
LIMIT 20;
```

```sql
--Description: Display first 20 web-accounts together with their sales rep and region.
SELECT DISTINCT wa.id   AS account_id,
       wa.name AS account_name,
       ws.name AS sales_rep_name,
       wr.name AS region_name
FROM web_accounts AS wa
LEFT JOIN web_sales_reps AS ws
       ON wa.sales_rep_id = ws.id
LEFT JOIN web_region AS wr
       ON ws.region_id = wr.id
LIMIT 20;
```

```sql
--Description: Take a quick look at orders together with the region they fall into.
SELECT DISTINCT wo.id            AS order_id,
       wa.name           AS account_name,
       wr.name           AS region_name,
       wo.total_amt_usd
FROM web_orders  AS wo
JOIN web_accounts     AS wa ON wo.account_id = wa.id
JOIN web_sales_reps   AS ws ON wa.sales_rep_id = ws.id
JOIN web_region       AS wr ON ws.region_id = wr.id
LIMIT 20;
```

```sql
--Description: Number of orders per region.
SELECT wr.name AS region_name,
       COUNT(wo.id) AS num_orders
FROM web_orders AS wo
JOIN web_accounts   AS wa ON wo.account_id = wa.id
JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
JOIN web_region     AS wr ON ws.region_id = wr.id
GROUP BY wr.name
LIMIT 20;
```

```sql
--Description: Total sales amount (USD) per region.
SELECT wr.name AS region_name,
       SUM(wo.total_amt_usd) AS total_sales_amt_usd
FROM web_orders AS wo
JOIN web_accounts   AS wa ON wo.account_id = wa.id
JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
JOIN web_region     AS wr ON ws.region_id = wr.id
GROUP BY wr.name
LIMIT 20;
```

```sql
--Description: Sales amount per sales representative inside his / her region.
SELECT ws.name AS sales_rep_name,
       wr.name AS region_name,
       SUM(wo.total_amt_usd) AS sales_amount_usd
FROM web_orders AS wo
JOIN web_accounts   AS wa ON wo.account_id = wa.id
JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
JOIN web_region     AS wr ON ws.region_id = wr.id
GROUP BY ws.id, wr.name
LIMIT 20;
```

```sql
--Description: Region-wise ranking – list sales reps ordered by their sales amount (highest first).
SELECT wr.name AS region_name,
       ws.name AS sales_rep_name,
       SUM(wo.total_amt_usd) AS sales_amount_usd
FROM web_orders AS wo
JOIN web_accounts   AS wa ON wo.account_id = wa.id
JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
JOIN web_region     AS wr ON ws.region_id = wr.id
GROUP BY wr.name, ws.id
ORDER BY wr.name, sales_amount_usd DESC
LIMIT 20;
```

```sql
--Description: For each region find all sales reps that reach the regional maximum (handles ties).
WITH sales_per_rep_region AS (
    SELECT wr.name AS region_name,
           ws.name AS sales_rep_name,
           SUM(wo.total_amt_usd) AS sales_amount_usd
    FROM web_orders AS wo
    JOIN web_accounts   AS wa ON wo.account_id = wa.id
    JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
    JOIN web_region     AS wr ON ws.region_id = wr.id
    GROUP BY wr.name, ws.id
),
max_sales_region AS (
    SELECT region_name,
           MAX(sales_amount_usd) AS max_sales
    FROM sales_per_rep_region
    GROUP BY region_name
)
SELECT spr.region_name,
       spr.sales_rep_name,
       spr.sales_amount_usd
FROM sales_per_rep_region AS spr
JOIN max_sales_region AS msr
  ON spr.region_name       = msr.region_name
 AND spr.sales_amount_usd  = msr.max_sales
ORDER BY spr.region_name
LIMIT 20;
```

```sql
--Description: FINAL REPORT – detailed web-sales report per region, showing
--  • number of orders
--  • total sales amount
--  • every top-performing sales rep (ties included) and his / her sales amount
WITH orders_region AS (
    SELECT wr.name AS region_name,
           COUNT(wo.id)        AS num_orders,
           SUM(wo.total_amt_usd) AS total_sales_amt_usd
    FROM web_orders AS wo
    JOIN web_accounts   AS wa ON wo.account_id = wa.id
    JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
    JOIN web_region     AS wr ON ws.region_id = wr.id
    GROUP BY wr.name
),
sales_per_rep_region AS (
    SELECT wr.name AS region_name,
           ws.name AS sales_rep_name,
           SUM(wo.total_amt_usd) AS sales_amount_usd
    FROM web_orders AS wo
    JOIN web_accounts   AS wa ON wo.account_id = wa.id
    JOIN web_sales_reps AS ws ON wa.sales_rep_id = ws.id
    JOIN web_region     AS wr ON ws.region_id = wr.id
    GROUP BY wr.name, ws.id
),
max_sales_region AS (
    SELECT region_name,
           MAX(sales_amount_usd) AS max_sales
    FROM sales_per_rep_region
    GROUP BY region_name
),
top_reps AS (
    SELECT spr.region_name,
           spr.sales_rep_name,
           spr.sales_amount_usd
    FROM sales_per_rep_region AS spr
    JOIN max_sales_region AS msr
      ON spr.region_name      = msr.region_name
     AND spr.sales_amount_usd = msr.max_sales
)
SELECT orr.region_name,
       orr.num_orders,
       ROUND(orr.total_sales_amt_usd, 2) AS total_sales_amt_usd,
       tr.sales_rep_name,
       ROUND(tr.sales_amount_usd, 2)     AS sales_rep_amount_usd
FROM orders_region AS orr
JOIN top_reps      AS tr
  ON orr.region_name = tr.region_name
ORDER BY orr.region_name, tr.sales_rep_name
LIMIT 20;
```
