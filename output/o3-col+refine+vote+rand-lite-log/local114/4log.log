--Description: FINAL REPORT – number of orders, total sales, and top-performing rep(s) per region
--(using correct region linkage through web_sales_reps).
WITH orders_info AS (
    SELECT o.id          AS order_id,
           r.name        AS region_name,
           a.sales_rep_id,
           sr.name       AS rep_name,
           o.total_amt_usd
    FROM   web_orders       AS o
    JOIN   web_accounts     AS a  ON o.account_id  = a.id
    JOIN   web_sales_reps   AS sr ON a.sales_rep_id = sr.id
    JOIN   web_region       AS r  ON sr.region_id   = r.id
),
region_summary AS (
    SELECT region_name,
           COUNT(order_id)     AS num_orders,
           SUM(total_amt_usd)  AS total_sales
    FROM   orders_info
    GROUP  BY region_name
),
rep_sales AS (
    SELECT region_name,
           rep_name,
           SUM(total_amt_usd)  AS rep_sales
    FROM   orders_info
    GROUP  BY region_name,
             rep_name
),
max_sales AS (
    SELECT region_name,
           MAX(rep_sales) AS max_rep_sales
    FROM   rep_sales
    GROUP  BY region_name
),
top_reps AS (
    SELECT rs.region_name,
           rs.rep_name,
           rs.rep_sales
    FROM   rep_sales rs
    JOIN   max_sales ms
      ON   rs.region_name = ms.region_name
     AND   rs.rep_sales   = ms.max_rep_sales
)
SELECT s.region_name,
       s.num_orders,
       s.total_sales,
       tr.rep_name   AS top_rep_name,
       tr.rep_sales  AS top_rep_sales
FROM   region_summary s
JOIN   top_reps      tr ON s.region_name = tr.region_name
ORDER  BY s.region_name,
          tr.rep_name
LIMIT 20
