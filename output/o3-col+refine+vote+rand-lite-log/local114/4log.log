```sql
-- Description: Preview the available web-regions.
SELECT DISTINCT id, name
FROM web_region
LIMIT 20;
```

```sql
-- Description: Look at a few web-accounts to confirm the presence of region_id and sales_rep_id.
SELECT DISTINCT id, name, region_id, sales_rep_id
FROM web_accounts
LIMIT 20;
```

```sql
-- Description: Inspect some web-orders to verify the sales amount column we have to aggregate.
SELECT id, account_id, total_amt_usd
FROM web_orders
LIMIT 20;
```

```sql
-- Description: First pass – orders and sales amount aggregated by region.
SELECT r.name  AS region_name,
       COUNT(o.id)            AS num_orders,
       SUM(o.total_amt_usd)   AS total_sales
FROM web_orders      AS o
JOIN web_accounts    AS a  ON o.account_id = a.id
JOIN web_region      AS r  ON a.region_id  = r.id
GROUP BY r.name
LIMIT 20;
```

```sql
-- Description: Sales produced by every sales-rep inside every region.
SELECT r.name        AS region_name,
       sr.name       AS rep_name,
       SUM(o.total_amt_usd)  AS rep_sales
FROM web_orders       AS o
JOIN web_accounts     AS a  ON o.account_id = a.id
JOIN web_region       AS r  ON a.region_id  = r.id
JOIN web_sales_reps   AS sr ON a.sales_rep_id = sr.id
GROUP BY r.name, sr.name
LIMIT 20;
```

```sql
-- Description: For each region, discover the maximum sales amount achieved by any rep.
WITH rep_sales AS (
  SELECT r.name  AS region_name,
         sr.id   AS rep_id,
         SUM(o.total_amt_usd) AS rep_sales
  FROM web_orders     AS o
  JOIN web_accounts   AS a  ON o.account_id = a.id
  JOIN web_region     AS r  ON a.region_id  = r.id
  JOIN web_sales_reps AS sr ON a.sales_rep_id = sr.id
  GROUP BY r.name, sr.id
)
SELECT region_name,
       MAX(rep_sales) AS max_rep_sales
FROM rep_sales
GROUP BY region_name
LIMIT 20;
```

```sql
-- Description: Identify all reps (ties included) who reached that regional maximum.
WITH rep_sales AS (
  SELECT r.name  AS region_name,
         sr.name AS rep_name,
         SUM(o.total_amt_usd) AS rep_sales
  FROM web_orders     AS o
  JOIN web_accounts   AS a  ON o.account_id = a.id
  JOIN web_region     AS r  ON a.region_id  = r.id
  JOIN web_sales_reps AS sr ON a.sales_rep_id = sr.id
  GROUP BY r.name, sr.name
),
max_sales AS (
  SELECT region_name,
         MAX(rep_sales) AS max_rep_sales
  FROM rep_sales
  GROUP BY region_name
)
SELECT rs.region_name,
       rs.rep_name,
       rs.rep_sales
FROM rep_sales rs
JOIN max_sales ms
  ON rs.region_name = ms.region_name
 AND rs.rep_sales  = ms.max_rep_sales
LIMIT 20;
```

```sql
-- Description: FINAL REPORT – number of orders, total sales, and top-performing rep(s) for every region.
WITH orders_info AS (
  SELECT o.id            AS order_id,
         r.name          AS region_name,
         a.sales_rep_id,
         sr.name         AS rep_name,
         o.total_amt_usd
  FROM web_orders       AS o
  JOIN web_accounts     AS a  ON o.account_id  = a.id
  JOIN web_region       AS r  ON a.region_id   = r.id
  JOIN web_sales_reps   AS sr ON a.sales_rep_id = sr.id
),
region_summary AS (
  SELECT region_name,
         COUNT(order_id)               AS num_orders,
         SUM(total_amt_usd)            AS total_sales
  FROM orders_info
  GROUP BY region_name
),
rep_sales AS (
  SELECT region_name,
         rep_name,
         SUM(total_amt_usd)            AS rep_sales
  FROM orders_info
  GROUP BY region_name, rep_name
),
max_sales AS (
  SELECT region_name,
         MAX(rep_sales)                AS max_rep_sales
  FROM rep_sales
  GROUP BY region_name
),
top_reps AS (
  SELECT rs.region_name,
         rs.rep_name,
         rs.rep_sales
  FROM rep_sales rs
  JOIN max_sales ms
    ON rs.region_name = ms.region_name
   AND rs.rep_sales  = ms.max_rep_sales
)
SELECT s.region_name,
       s.num_orders,
       s.total_sales,
       tr.rep_name   AS top_rep_name,
       tr.rep_sales  AS top_rep_sales
FROM region_summary s
JOIN top_reps tr
  ON s.region_name = tr.region_name
ORDER BY s.region_name,
         tr.rep_name
LIMIT 20;
```
