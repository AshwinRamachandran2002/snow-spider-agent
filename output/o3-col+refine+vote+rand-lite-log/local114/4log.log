--However, the schema shows "region_id" exists in web_sales_reps. 
--To find the region attached to each account we must:
--   1) join web_accounts to web_sales_reps (via sales_rep_id),
--   2) then join web_sales_reps to web_region (via region_id).
--This query lists a sample of accounts with their sales rep and region to validate the joins.
SELECT DISTINCT
       a.id            AS account_id,
       a.name          AS account_name,
       sr.id           AS sales_rep_id,
       sr.name         AS sales_rep_name,
       sr.region_id,
       r.name          AS region_name
FROM   web_accounts      AS a
LEFT JOIN web_sales_reps AS sr ON a.sales_rep_id = sr.id
LEFT JOIN web_region      AS r  ON sr.region_id  = r.id
LIMIT 20;
```
