--Description: 9) Combine overall regional figures with the reps that reached the maximum sales  
--Fix: propagate the region via sales reps everywhere.  
SELECT reg."region_name",
       reg."total_orders",
       reg."region_sales",
       top."sales_rep_name",
       top."rep_sales" AS "sales_rep_sales"
FROM   (
        SELECT r."name"               AS "region_name",
               COUNT(DISTINCT o."id") AS "total_orders",
               SUM(o."total_amt_usd") AS "region_sales"
        FROM   "web_orders"      AS o
        JOIN   "web_accounts"    AS a ON o."account_id" = a."id"
        JOIN   "web_sales_reps"  AS s ON a."sales_rep_id" = s."id"
        JOIN   "web_region"      AS r ON s."region_id"   = r."id"
        GROUP  BY r."name"
       )  AS reg
JOIN   (
        SELECT sub."region_name",
               sub."sales_rep_name",
               sub."rep_sales"
        FROM   (
                SELECT s."name"               AS "sales_rep_name",
                       r."name"               AS "region_name",
                       SUM(o."total_amt_usd") AS "rep_sales"
                FROM   "web_orders"      AS o
                JOIN   "web_accounts"    AS a ON o."account_id" = a."id"
                JOIN   "web_sales_reps"  AS s ON a."sales_rep_id" = s."id"
                JOIN   "web_region"      AS r ON s."region_id"   = r."id"
                GROUP  BY s."id", r."name"
               ) AS sub
        JOIN   (
                SELECT "region_name",
                       MAX("rep_sales") AS "max_sales"
                FROM   (
                        SELECT r."name"               AS "region_name",
                               SUM(o."total_amt_usd") AS "rep_sales"
                        FROM   "web_orders"      AS o
                        JOIN   "web_accounts"    AS a ON o."account_id" = a."id"
                        JOIN   "web_sales_reps"  AS s ON a."sales_rep_id" = s."id"
                        JOIN   "web_region"      AS r ON s."region_id"   = r."id"
                        GROUP  BY r."name", s."id"
                       )
                GROUP  BY "region_name"
               ) AS mx
               ON sub."region_name" = mx."region_name"
              AND sub."rep_sales"   = mx."max_sales"
       )  AS top
       ON reg."region_name" = top."region_name"
LIMIT 20
