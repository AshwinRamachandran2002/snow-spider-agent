```sql
--Description: 6) Sales generated by every sales-rep in each region.  
SELECT s."id"               AS "sales_rep_id",
       s."name"             AS "sales_rep_name",
       r."name"             AS "region_name",
       SUM(o."total_amt_usd") AS "rep_sales"
FROM   "web_orders"   AS o
JOIN   "web_accounts" AS a ON o."account_id" = a."id"
JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
JOIN   "web_region"   AS r ON a."region_id" = r."id"
GROUP  BY s."id", s."name", r."name"
LIMIT 20;
```

```sql
--Description: 7) Highest individual sales amount achieved in every region.  
SELECT "region_name",
       MAX("rep_sales") AS "max_sales_in_region"
FROM   (
        SELECT r."name"            AS "region_name",
               SUM(o."total_amt_usd") AS "rep_sales"
        FROM   "web_orders"   AS o
        JOIN   "web_accounts" AS a ON o."account_id" = a."id"
        JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
        JOIN   "web_region"   AS r ON a."region_id" = r."id"
        GROUP  BY r."name", s."id"
       )
GROUP  BY "region_name"
LIMIT 20;
```

```sql
--Description: 8) All sales-reps whose sales equal the regional maximum (ties included).  
SELECT sub."region_name",
       sub."sales_rep_name",
       sub."rep_sales"
FROM   (
        SELECT s."name"          AS "sales_rep_name",
               r."name"          AS "region_name",
               SUM(o."total_amt_usd") AS "rep_sales"
        FROM   "web_orders"  AS o
        JOIN   "web_accounts" AS a ON o."account_id" = a."id"
        JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
        JOIN   "web_region"   AS r ON a."region_id" = r."id"
        GROUP  BY s."id", s."name", r."name"
       )  AS sub
JOIN   (
        SELECT "region_name",
               MAX("rep_sales") AS "max_sales"
        FROM   (
                SELECT r."name"            AS "region_name",
                       SUM(o."total_amt_usd") AS "rep_sales"
                FROM   "web_orders"  AS o
                JOIN   "web_accounts" AS a ON o."account_id" = a."id"
                JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
                JOIN   "web_region"   AS r ON a."region_id" = r."id"
                GROUP  BY r."name", s."id"
               )
        GROUP  BY "region_name"
       )  AS mx
       ON sub."region_name" = mx."region_name"
      AND sub."rep_sales"   = mx."max_sales"
LIMIT 20;
```

```sql
--Description: 9) Combine overall regional figures with the reps that reached the maximum sales.  
SELECT reg."region_name",
       reg."total_orders",
       reg."region_sales",
       top."sales_rep_name",
       top."rep_sales" AS "sales_rep_sales"
FROM   (
        SELECT r."name"               AS "region_name",
               COUNT(DISTINCT o."id") AS "total_orders",
               SUM(o."total_amt_usd") AS "region_sales"
        FROM   "web_orders"  AS o
        JOIN   "web_accounts" AS a ON o."account_id" = a."id"
        JOIN   "web_region"   AS r ON a."region_id" = r."id"
        GROUP  BY r."name"
       )  AS reg
JOIN   (
        SELECT sub."region_name",
               sub."sales_rep_name",
               sub."rep_sales"
        FROM   (
                SELECT s."name"          AS "sales_rep_name",
                       r."name"          AS "region_name",
                       SUM(o."total_amt_usd") AS "rep_sales"
                FROM   "web_orders"  AS o
                JOIN   "web_accounts" AS a ON o."account_id" = a."id"
                JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
                JOIN   "web_region"   AS r ON a."region_id" = r."id"
                GROUP  BY s."name", r."name"
               ) AS sub
        JOIN   (
                SELECT "region_name",
                       MAX("rep_sales") AS "max_sales"
                FROM   (
                        SELECT r."name"            AS "region_name",
                               SUM(o."total_amt_usd") AS "rep_sales"
                        FROM   "web_orders"  AS o
                        JOIN   "web_accounts" AS a ON o."account_id" = a."id"
                        JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
                        JOIN   "web_region"   AS r ON a."region_id" = r."id"
                        GROUP  BY r."name", s."id"
                       )
                GROUP  BY "region_name"
               ) AS mx
               ON sub."region_name" = mx."region_name"
              AND sub."rep_sales"   = mx."max_sales"
       )  AS top
       ON reg."region_name" = top."region_name"
LIMIT 20;
```

```sql
--Description: 10) FINAL detailed web-sales report: orders & sales per region plus all top-performing reps (ties kept).  
SELECT reg."region_name",
       reg."total_orders",
       reg."region_sales",
       GROUP_CONCAT(top."sales_rep_name", ', ') AS "top_sales_rep_names",
       MAX(top."rep_sales")                     AS "top_sales_amount"
FROM   (
        SELECT r."name"               AS "region_name",
               COUNT(DISTINCT o."id") AS "total_orders",
               SUM(o."total_amt_usd") AS "region_sales"
        FROM   "web_orders"  AS o
        JOIN   "web_accounts" AS a ON o."account_id" = a."id"
        JOIN   "web_region"   AS r ON a."region_id" = r."id"
        GROUP  BY r."name"
       )  AS reg
JOIN   (
        SELECT s."name"          AS "sales_rep_name",
               r."name"          AS "region_name",
               SUM(o."total_amt_usd") AS "rep_sales"
        FROM   "web_orders"  AS o
        JOIN   "web_accounts" AS a ON o."account_id" = a."id"
        JOIN   "web_sales_reps" AS s ON a."sales_rep_id" = s."id"
        JOIN   "web_region"   AS r ON a."region_id" = r."id"
        GROUP  BY s."name", r."name"
        HAVING "rep_sales" = (
               SELECT MAX(sr."rep_sales")
               FROM   (
                       SELECT SUM(o2."total_amt_usd") AS "rep_sales"
                       FROM   "web_orders"  AS o2
                       JOIN   "web_accounts" AS a2 ON o2."account_id" = a2."id"
                       JOIN   "web_sales_reps" AS s2 ON a2."sales_rep_id" = s2."id"
                       JOIN   "web_region"   AS r2 ON a2."region_id" = r2."id"
                       WHERE  r2."name" = r."name"
                       GROUP  BY s2."id"
                     )  AS sr
               )
       )  AS top
       ON reg."region_name" = top."region_name"
GROUP  BY reg."region_name",
         reg."total_orders",
         reg."region_sales"
LIMIT 20;
```
