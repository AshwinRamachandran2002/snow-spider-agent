--Description: 10) FINAL detailed web-sales report: orders & sales per region plus all top-performing reps (ties kept)  
--Fix: all region links go through sales reps.  
SELECT reg."region_name",
       reg."total_orders",
       reg."region_sales",
       GROUP_CONCAT(top."sales_rep_name", ', ') AS "top_sales_rep_names",
       MAX(top."rep_sales")                     AS "top_sales_amount"
FROM   (
        SELECT r."name"               AS "region_name",
               COUNT(DISTINCT o."id") AS "total_orders",
               SUM(o."total_amt_usd") AS "region_sales"
        FROM   "web_orders"      AS o
        JOIN   "web_accounts"    AS a ON o."account_id" = a."id"
        JOIN   "web_sales_reps"  AS s ON a."sales_rep_id" = s."id"
        JOIN   "web_region"      AS r ON s."region_id"   = r."id"
        GROUP  BY r."name"
       )  AS reg
JOIN   (
        SELECT s."name"               AS "sales_rep_name",
               r."name"               AS "region_name",
               SUM(o."total_amt_usd") AS "rep_sales"
        FROM   "web_orders"      AS o
        JOIN   "web_accounts"    AS a ON o."account_id" = a."id"
        JOIN   "web_sales_reps"  AS s ON a."sales_rep_id" = s."id"
        JOIN   "web_region"      AS r ON s."region_id"   = r."id"
        GROUP  BY s."id", r."name"
        HAVING "rep_sales" = (
               SELECT MAX(sr."rep_sales")
               FROM   (
                       SELECT SUM(o2."total_amt_usd") AS "rep_sales"
                       FROM   "web_orders"      AS o2
                       JOIN   "web_accounts"    AS a2 ON o2."account_id" = a2."id"
                       JOIN   "web_sales_reps"  AS s2 ON a2."sales_rep_id" = s2."id"
                       JOIN   "web_region"      AS r2 ON s2."region_id"   = r2."id"
                       WHERE  r2."name" = r."name"
                       GROUP  BY s2."id"
                     )  AS sr
               )
       )  AS top
       ON reg."region_name" = top."region_name"
GROUP  BY reg."region_name",
         reg."total_orders",
         reg."region_sales"
LIMIT 20
Answer:
region_name,total_orders,region_sales,top_sales_rep_names,top_sales_amount
