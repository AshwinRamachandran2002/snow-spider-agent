```sql
--Description: The table web_accounts does not store a region_id column; it only stores sales_rep_id.
--             Each sales representative (web_sales_reps) **does** have a region_id, which links to web_region.
--             Therefore, to obtain the region of an account we:
--               1) join web_accounts (alias a) with web_sales_reps (alias s) using a.sales_rep_id = s.id
--               2) join the result with web_region (alias r) using s.region_id = r.id
--             Finally, we select distinct account_id, account_name, and region_name.
SELECT DISTINCT
       a.id   AS account_id,
       a.name AS account_name,
       r.name AS region_name
FROM web_accounts   AS a
JOIN web_sales_reps AS s ON a.sales_rep_id = s.id
JOIN web_region     AS r ON s.region_id    = r.id
LIMIT 20;
```
