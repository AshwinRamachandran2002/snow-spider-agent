```sql
-- Description: Inspect all web regions that exist in the data.
SELECT DISTINCT id, name 
FROM web_region
LIMIT 20;
```

```sql
-- Description: Look at web accounts together with their region names.
SELECT DISTINCT a.id AS account_id,
                a.name AS account_name,
                r.name AS region_name
FROM web_accounts AS a
JOIN web_region  AS r ON a.region_id = r.id
LIMIT 20;
```

```sql
-- Description: Check a few orders to understand the monetary column we need.
SELECT id,
       account_id,
       total_amt_usd
FROM web_orders
LIMIT 20;
```

```sql
-- Description: Combine orders with regions to see how sales are distributed geographically.
SELECT o.id           AS order_id,
       r.name         AS region_name,
       o.total_amt_usd
FROM web_orders   AS o
JOIN web_accounts AS a ON o.account_id = a.id
JOIN web_region   AS r ON a.region_id  = r.id
LIMIT 20;
```

```sql
-- Description: Verify which sales-rep services which account.
SELECT DISTINCT a.id   AS account_id,
                a.name AS account_name,
                s.name AS sales_rep
FROM web_accounts    AS a
JOIN web_sales_reps  AS s ON a.sales_rep_id = s.id
LIMIT 20;
```

```sql
-- Description: Region-level summary ─ number of orders and total sales.
SELECT r.name                        AS region,
       COUNT(o.id)                   AS num_orders,
       SUM(o.total_amt_usd)          AS total_sales
FROM web_orders   AS o
JOIN web_accounts AS a ON o.account_id = a.id
JOIN web_region   AS r ON a.region_id  = r.id
GROUP BY r.name
LIMIT 20;
```

```sql
-- Description: Sales per representative within every region.
SELECT r.name                       AS region,
       s.name                       AS sales_rep,
       SUM(o.total_amt_usd)         AS rep_sales
FROM web_orders      AS o
JOIN web_accounts    AS a ON o.account_id = a.id
JOIN web_region      AS r ON a.region_id  = r.id
JOIN web_sales_reps  AS s ON a.sales_rep_id = s.id
GROUP BY r.name, s.name
LIMIT 20;
```

```sql
-- Description: For each region, identify the maximum representative sales amount.
SELECT region,
       MAX(rep_sales) AS max_rep_sales
FROM (
        SELECT r.name                  AS region,
               s.name                  AS sales_rep,
               SUM(o.total_amt_usd)    AS rep_sales
        FROM web_orders      AS o
        JOIN web_accounts    AS a ON o.account_id = a.id
        JOIN web_region      AS r ON a.region_id  = r.id
        JOIN web_sales_reps  AS s ON a.sales_rep_id = s.id
        GROUP BY r.name, s.name
     )
GROUP BY region
LIMIT 20;
```

```sql
-- Description: Final report – for every region show order count, total sales,
--              and ALL rep(s) who achieved the highest sales in that region.
SELECT reg.region,
       reg.num_orders,
       reg.total_sales,
       tops.sales_rep,
       tops.rep_sales
FROM
     ( /* region-level order & sales totals */
       SELECT r.name                 AS region,
              COUNT(o.id)            AS num_orders,
              SUM(o.total_amt_usd)   AS total_sales
       FROM web_orders   AS o
       JOIN web_accounts AS a ON o.account_id = a.id
       JOIN web_region   AS r ON a.region_id  = r.id
       GROUP BY r.name
     ) AS reg
JOIN
     ( /* representatives who hit the regional maximum */
       SELECT t1.region,
              t1.sales_rep,
              t1.rep_sales
       FROM
            ( /* sales per rep per region */
              SELECT r.name              AS region,
                     s.name              AS sales_rep,
                     SUM(o.total_amt_usd) AS rep_sales
              FROM web_orders      AS o
              JOIN web_accounts    AS a ON o.account_id = a.id
              JOIN web_region      AS r ON a.region_id  = r.id
              JOIN web_sales_reps  AS s ON a.sales_rep_id = s.id
              GROUP BY r.name, s.name
            ) AS t1
       JOIN
            ( /* regional maxima */
              SELECT region,
                     MAX(rep_sales) AS max_rep_sales
              FROM
                   (SELECT r.name            AS region,
                           s.name            AS sales_rep,
                           SUM(o.total_amt_usd) AS rep_sales
                    FROM web_orders      AS o
                    JOIN web_accounts    AS a ON o.account_id = a.id
                    JOIN web_region      AS r ON a.region_id  = r.id
                    JOIN web_sales_reps  AS s ON a.sales_rep_id = s.id
                    GROUP BY r.name, s.name)
              GROUP BY region
            ) AS t2
       ON  t1.region    = t2.region
       AND t1.rep_sales = t2.max_rep_sales
     ) AS tops
ON reg.region = tops.region
ORDER BY reg.region, tops.sales_rep
LIMIT 20;
```
