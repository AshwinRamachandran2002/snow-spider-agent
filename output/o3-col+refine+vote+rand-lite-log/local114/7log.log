Query:
--Description: Corrected version of SQL #10 – “final answer” query that produces
--             the detailed web-sales report.  Uses CTEs for clarity; ensures
--             every sub-query has an alias, so it executes without error.
WITH rep_sales AS (              -- total sales per rep & region
       SELECT r."name"               AS region_name,
              sr."name"              AS sales_rep_name,
              SUM(o."total_amt_usd") AS rep_total_sales_usd
       FROM   "web_orders"     o
       JOIN   "web_accounts"   a  ON o."account_id"   = a."id"
       JOIN   "web_sales_reps" sr ON a."sales_rep_id" = sr."id"
       JOIN   "web_region"     r  ON sr."region_id"   = r."id"
       GROUP  BY r."name", sr."name"
),
max_reps AS (                    -- keep only the rep(s) at the max per region
       SELECT *
       FROM (
             SELECT rs.*,
                    MAX(rs.rep_total_sales_usd)
                        OVER (PARTITION BY rs.region_name) AS max_region_sales
             FROM  rep_sales rs
            ) AS y
       WHERE rep_total_sales_usd = max_region_sales
),
region_totals AS (               -- orders & sales totals per region
       SELECT r."name"               AS region_name,
              COUNT(*)               AS num_orders,
              SUM(o."total_amt_usd") AS total_sales_usd
       FROM   "web_orders"     o
       JOIN   "web_accounts"   a  ON o."account_id"   = a."id"
       JOIN   "web_sales_reps" sr ON a."sales_rep_id" = sr."id"
       JOIN   "web_region"     r  ON sr."region_id"   = r."id"
       GROUP  BY r."name"
)
SELECT rt.region_name                 AS "Region",
       rt.num_orders                  AS "Number_of_Orders",
       ROUND(rt.total_sales_usd,2)    AS "Total_Sales_USD",
       mr.sales_rep_name              AS "Top_Sales_Rep",
       ROUND(mr.rep_total_sales_usd,2)AS "Rep_Total_Sales_USD"
FROM   region_totals rt
JOIN   max_reps      mr ON rt.region_name = mr.region_name
ORDER  BY rt.region_name, mr.sales_rep_name
Answer:
