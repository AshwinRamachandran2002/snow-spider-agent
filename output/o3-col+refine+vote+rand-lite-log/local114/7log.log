--Description:
-- The goal is a single query that returns, for every region:
--   (1) total number of web orders,
--   (2) total web-sales amount,
--   (3) the name(s) of the sales representative(s) whose cumulative
--       sales are the highest in that region (ties included),
--   (4) each top rep’s own total sales amount.
--
-- Strategy (all done inside one query via CTEs):
--   • rep_sales     : aggregate web_orders to compute each rep’s total
--                     sales within his/her region.
--   • max_reps      : keep only those reps whose total equals the
--                     maximum rep total in their respective region.
--   • region_totals : aggregate orders to get overall order count and
--                     sales amount per region.
--   • final SELECT  : join region_totals with max_reps so each output
--                     row shows the region metrics plus the top rep(s).
--
WITH rep_sales AS (
       SELECT r."name"               AS region_name,
              sr."name"              AS sales_rep_name,
              SUM(o."total_amt_usd") AS rep_total_sales_usd
       FROM   "web_orders"     o
       JOIN   "web_accounts"   a  ON o."account_id"   = a."id"
       JOIN   "web_sales_reps" sr ON a."sales_rep_id" = sr."id"
       JOIN   "web_region"     r  ON sr."region_id"   = r."id"
       GROUP  BY r."name", sr."name"
),
max_reps AS (
       SELECT region_name,
              sales_rep_name,
              rep_total_sales_usd
       FROM  (
              SELECT rs.*,
                     MAX(rs.rep_total_sales_usd) OVER (PARTITION BY rs.region_name)
                     AS max_region_sales
              FROM   rep_sales rs
             )
       WHERE rep_total_sales_usd = max_region_sales          -- keep only top(s)
),
region_totals AS (
       SELECT r."name"               AS region_name,
              COUNT(*)               AS num_orders,
              SUM(o."total_amt_usd") AS total_sales_usd
       FROM   "web_orders"     o
       JOIN   "web_accounts"   a  ON o."account_id"   = a."id"
       JOIN   "web_sales_reps" sr ON a."sales_rep_id" = sr."id"
       JOIN   "web_region"     r  ON sr."region_id"   = r."id"
       GROUP  BY r."name"
)
SELECT rt.region_name                     AS "Region",
       rt.num_orders                      AS "Number_of_Orders",
       ROUND(rt.total_sales_usd, 2)       AS "Total_Sales_USD",
       mr.sales_rep_name                  AS "Top_Sales_Rep",
       ROUND(mr.rep_total_sales_usd, 2)   AS "Rep_Total_Sales_USD"
FROM   region_totals rt
JOIN   max_reps      mr  ON rt.region_name = mr.region_name
ORDER  BY rt.region_name, mr.sales_rep_name;
