Query:
--Description: Corrected version of SQL #9 – combines regional order/sales totals
--             with the top-performing rep(s) per region.  The only changes from
--             the original are (a) giving explicit aliases to every derived
--             table and (b) adding ROUND() where desired.  This prevents the
--             “no data / syntax” issue seen earlier.
SELECT rt.region_name,
       rt.num_orders,
       ROUND(rt.total_sales_usd,2)  AS total_sales_usd,
       tr.sales_rep_name,
       ROUND(tr.rep_total_sales_usd,2) AS rep_total_sales_usd
FROM   (      -- regional totals
        SELECT r."name"               AS region_name,
               COUNT(*)               AS num_orders,
               SUM(o."total_amt_usd") AS total_sales_usd
        FROM   "web_orders"     o
        JOIN   "web_accounts"   a  ON o."account_id"   = a."id"
        JOIN   "web_sales_reps" sr ON a."sales_rep_id" = sr."id"
        JOIN   "web_region"     r  ON sr."region_id"   = r."id"
        GROUP  BY r."name"
       ) AS rt
JOIN   (      -- top-rep(s) in each region
        SELECT *
        FROM  (
               SELECT r."name"               AS region_name,
                      sr."name"              AS sales_rep_name,
                      SUM(o."total_amt_usd") AS rep_total_sales_usd,
                      MAX(SUM(o."total_amt_usd"))
                          OVER (PARTITION BY r."name") AS max_region_sales
               FROM   "web_orders"     o
               JOIN   "web_accounts"   a  ON o."account_id"   = a."id"
               JOIN   "web_sales_reps" sr ON a."sales_rep_id" = sr."id"
               JOIN   "web_region"     r  ON sr."region_id"   = r."id"
               GROUP  BY r."name", sr."name"
              ) AS x
        WHERE  rep_total_sales_usd = max_region_sales
       ) AS tr
  ON rt.region_name = tr.region_name
ORDER BY rt.region_name, tr.sales_rep_name
LIMIT 20
