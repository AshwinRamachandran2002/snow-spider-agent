```sql
-- 1) List all regions available in web_region
SELECT DISTINCT "id", "name"
FROM "web_region"
LIMIT 20;
```

```sql
-- 2) Look at sales-reps together with their region (after joining to web_region)
SELECT DISTINCT sr."id"            AS sales_rep_id,
                sr."name"          AS sales_rep_name,
                r."name"           AS region_name
FROM   "web_sales_reps"  AS sr
JOIN   "web_region"      AS r
       ON sr."region_id" = r."id"
LIMIT 20;
```

```sql
-- 3) Inspect a few accounts with their sales-rep and region
SELECT DISTINCT a."id"          AS account_id,
                a."name"        AS account_name,
                sr."name"       AS sales_rep_name,
                r."name"        AS region_name
FROM   "web_accounts"   AS a
JOIN   "web_sales_reps" AS sr  ON a."sales_rep_id" = sr."id"
JOIN   "web_region"     AS r   ON sr."region_id"   = r."id"
LIMIT 20;
```

```sql
-- 4) Preview some web orders with the account, rep, and region attached
SELECT DISTINCT o."id"              AS order_id,
                o."occurred_at",
                o."total_amt_usd",
                a."name"            AS account_name,
                sr."name"           AS sales_rep_name,
                r."name"            AS region_name
FROM   "web_orders"      AS o
JOIN   "web_accounts"    AS a  ON o."account_id"   = a."id"
JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"      AS r  ON sr."region_id"   = r."id"
LIMIT 20;
```

```sql
-- 5) Get number of orders and total sales amount for every region
SELECT r."name"                     AS region_name,
       COUNT(*)                     AS num_orders,
       ROUND(SUM(o."total_amt_usd"),2) AS total_sales_usd
FROM   "web_orders"  AS o
JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
GROUP BY r."name"
LIMIT 20;
```

```sql
-- 6) Compute total sales per sales-rep (across all his/her accounts)
SELECT sr."id"                       AS sales_rep_id,
       sr."name"                     AS sales_rep_name,
       r."name"                      AS region_name,
       ROUND(SUM(o."total_amt_usd"),2) AS rep_total_sales_usd
FROM   "web_orders"      AS o
JOIN   "web_accounts"    AS a  ON o."account_id"   = a."id"
JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"      AS r  ON sr."region_id"   = r."id"
GROUP BY sr."id", sr."name", r."name"
LIMIT 20;
```

```sql
-- 7) Determine, inside every region, the highest rep sales amount (using a window function)
SELECT region_name,
       sales_rep_name,
       rep_total_sales_usd,
       MAX(rep_total_sales_usd) OVER (PARTITION BY region_name) AS max_sales_in_region
FROM   (
        SELECT sr."name"                        AS sales_rep_name,
               r."name"                         AS region_name,
               ROUND(SUM(o."total_amt_usd"),2)  AS rep_total_sales_usd
        FROM   "web_orders"     AS o
        JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
        JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
        JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
        GROUP BY sr."name", r."name"
       )
LIMIT 20;
```

```sql
-- 8) Keep only those reps whose sales equal the maximum within their region (handles ties)
SELECT region_name,
       sales_rep_name,
       rep_total_sales_usd
FROM   (
        SELECT sr."name"                       AS sales_rep_name,
               r."name"                        AS region_name,
               ROUND(SUM(o."total_amt_usd"),2) AS rep_total_sales_usd,
               MAX(SUM(o."total_amt_usd")) OVER (PARTITION BY r."name") AS max_region_sales
        FROM   "web_orders"     AS o
        JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
        JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
        JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
        GROUP BY sr."name", r."name"
       )
WHERE  rep_total_sales_usd = max_region_sales
LIMIT 20;
```

```sql
-- 9) Combine overall region totals with their top rep(s) – one row per top rep per region
SELECT region_totals.region_name,
       region_totals.num_orders,
       region_totals.total_sales_usd,
       top_reps.sales_rep_name,
       top_reps.rep_total_sales_usd
FROM   (
        -- sub-query: totals by region
        SELECT r."name"                     AS region_name,
               COUNT(*)                     AS num_orders,
               ROUND(SUM(o."total_amt_usd"),2) AS total_sales_usd
        FROM   "web_orders"  AS o
        JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
        JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
        JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
        GROUP BY r."name"
       )                 AS region_totals
JOIN   (
        -- sub-query: reps who achieved the max sales in their region
        SELECT region_name,
               sales_rep_name,
               rep_total_sales_usd
        FROM   (
                SELECT sr."name"                       AS sales_rep_name,
                       r."name"                        AS region_name,
                       ROUND(SUM(o."total_amt_usd"),2) AS rep_total_sales_usd,
                       MAX(SUM(o."total_amt_usd"))
                             OVER (PARTITION BY r."name") AS max_region_sales
                FROM   "web_orders"     AS o
                JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
                JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
                JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
                GROUP BY sr."name", r."name"
               )
        WHERE  rep_total_sales_usd = max_region_sales
       )                 AS top_reps
       ON region_totals.region_name = top_reps.region_name
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER – deliver the complete detailed web-sales report for every region
SELECT region_totals.region_name                 AS "Region",
       region_totals.num_orders                  AS "Number_of_Orders",
       region_totals.total_sales_usd             AS "Total_Sales_USD",
       top_reps.sales_rep_name                   AS "Top_Sales_Rep",
       top_reps.rep_total_sales_usd              AS "Rep_Total_Sales_USD"
FROM   (
        SELECT r."name"  AS region_name,
               COUNT(*)  AS num_orders,
               ROUND(SUM(o."total_amt_usd"),2) AS total_sales_usd
        FROM   "web_orders"  AS o
        JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
        JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
        JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
        GROUP BY r."name"
       ) AS region_totals
JOIN   (
        SELECT region_name,
               sales_rep_name,
               rep_total_sales_usd
        FROM   (
                SELECT sr."name"  AS sales_rep_name,
                       r."name"   AS region_name,
                       ROUND(SUM(o."total_amt_usd"),2) AS rep_total_sales_usd,
                       MAX(SUM(o."total_amt_usd"))
                            OVER (PARTITION BY r."name") AS max_region_sales
                FROM   "web_orders"     AS o
                JOIN   "web_accounts"   AS a  ON o."account_id"   = a."id"
                JOIN   "web_sales_reps" AS sr ON a."sales_rep_id" = sr."id"
                JOIN   "web_region"     AS r  ON sr."region_id"   = r."id"
                GROUP BY sr."name", r."name"
               )
        WHERE  rep_total_sales_usd = max_region_sales         -- keep only the top(s)
       ) AS top_reps
  ON region_totals.region_name = top_reps.region_name
ORDER BY region_totals.region_name, top_reps.sales_rep_name
LIMIT 20;
```
