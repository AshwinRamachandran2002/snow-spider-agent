Query:
--Description: 9) Pull the final report: per region → #orders, total $sales, and every top-performing rep (ties included)  
SELECT
    region_stats."region_name",
    region_stats."orders_cnt",
    region_stats."region_sales_usd",
    rep_stats."sales_rep_name",
    rep_stats."rep_sales_usd"
FROM
    ( /* region level stats */
      SELECT r."name"                        AS "region_name",
             COUNT(o."id")                   AS "orders_cnt",
             ROUND(SUM(o."total_amt_usd"),2) AS "region_sales_usd"
      FROM   "web_orders"      AS o
      JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
      JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
      JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
      GROUP  BY r."name"
    ) AS region_stats
JOIN
    ( /* sales rep totals with region and per-region max filter */
      SELECT
          r."name"                         AS "region_name",
          sr."name"                        AS "sales_rep_name",
          ROUND(SUM(o."total_amt_usd"),2)  AS "rep_sales_usd"
      FROM   "web_orders"      AS o
      JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
      JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
      JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
      GROUP  BY r."name", sr."name"
      HAVING rep_sales_usd = (
            SELECT MAX(inner_totals."rep_sales_usd")
            FROM (
                   SELECT ROUND(SUM(o2."total_amt_usd"),2) AS "rep_sales_usd"
                   FROM   "web_orders"      AS o2
                   JOIN   "web_accounts"    AS a2  ON o2."account_id" = a2."id"
                   JOIN   "web_sales_reps"  AS sr2 ON a2."sales_rep_id" = sr2."id"
                   JOIN   "web_region"      AS r2  ON sr2."region_id"  = r2."id"
                   WHERE  r2."name" = r."name"
                   GROUP  BY sr2."name"
                 ) AS inner_totals
      )
    ) AS rep_stats
ON rep_stats."region_name" = region_stats."region_name"
ORDER BY region_stats."region_name", rep_stats."sales_rep_name"
LIMIT 20;
Answer:
region_name,orders_cnt,region_sales_usd,sales_rep_name,rep_sales_usd
Midwest,897,3013486.51,Charles Bidwell,675637.19
Northeast,2357,7744405.36,Tia Amato,1010690.6
Southeast,2024,6458497.0,Earlie Schleusner,1098137.72
West,1634,5925122.96,Georgianna Chisholm,886244.12
