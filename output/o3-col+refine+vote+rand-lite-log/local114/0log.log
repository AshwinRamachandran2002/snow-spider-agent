--Description: 1) Preview web orders – when they happened and how much was sold  
SELECT DISTINCT "id", "account_id", "occurred_at", "total_amt_usd"
FROM "web_orders"
LIMIT 20;
```

```sql
--Description: 2) Inspect the list of web accounts together with the sales-rep who owns them  
SELECT DISTINCT "id"          AS "account_id",
                "name"        AS "account_name",
                "sales_rep_id"
FROM "web_accounts"
LIMIT 20;
```

```sql
--Description: 3) Look at the sales-rep directory (their id, name, and region_id they belong to)  
SELECT DISTINCT "id"   AS "sales_rep_id",
                "name" AS "sales_rep_name",
                "region_id"
FROM "web_sales_reps"
LIMIT 20;
```

```sql
--Description: 4) Check the region reference table so we know the region_id → region_name mapping  
SELECT DISTINCT "id"   AS "region_id",
                "name" AS "region_name"
FROM "web_region"
LIMIT 20;
```

```sql
--Description: 5) Join accounts to regions to verify that each account resolves to a region name  
SELECT DISTINCT a."id"          AS "account_id",
                a."name"        AS "account_name",
                r."name"        AS "region_name"
FROM   "web_accounts" AS a
JOIN   "web_sales_reps" AS sr
       ON a."sales_rep_id" = sr."id"
JOIN   "web_region" AS r
       ON sr."region_id" = r."id"
LIMIT 20;
```

```sql
--Description: 6) Compute total sales per (region, order) to see if the linkage works  
SELECT DISTINCT r."name"                    AS "region_name",
                o."id"                      AS "order_id",
                o."total_amt_usd"
FROM   "web_orders"      AS o
JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
LIMIT 20;
```

```sql
--Description: 7) Aggregate sales by region to get number of orders and total sales amount  
SELECT r."name"                           AS "region_name",
       COUNT(o."id")                      AS "orders_cnt",
       ROUND(SUM(o."total_amt_usd"), 2)   AS "region_sales_usd"
FROM   "web_orders"      AS o
JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
GROUP  BY r."name"
LIMIT 20;
```

```sql
--Description: 8) Calculate total sales per (region, sales_rep) so we can later pick the best rep(s) in each region  
SELECT r."name"                          AS "region_name",
       sr."name"                         AS "sales_rep_name",
       ROUND(SUM(o."total_amt_usd"), 2)  AS "rep_sales_usd"
FROM   "web_orders"      AS o
JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
GROUP  BY r."name", sr."name"
LIMIT 20;
```

```sql
--Description: 9) Pull the final report: per region → #orders, total $sales, and every top-performing rep (ties included)  
SELECT
    region_stats."region_name",
    region_stats."orders_cnt",
    region_stats."region_sales_usd",
    rep_stats."sales_rep_name",
    rep_stats."rep_sales_usd"
FROM
    ( /* region level stats */
      SELECT r."name"                        AS "region_name",
             COUNT(o."id")                   AS "orders_cnt",
             ROUND(SUM(o."total_amt_usd"),2) AS "region_sales_usd"
      FROM   "web_orders"      AS o
      JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
      JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
      JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
      GROUP  BY r."name"
    ) AS region_stats
JOIN
    ( /* sales rep totals with region and per-region max filter */
      SELECT
          r."name"                         AS "region_name",
          sr."name"                        AS "sales_rep_name",
          ROUND(SUM(o."total_amt_usd"),2)  AS "rep_sales_usd"
      FROM   "web_orders"      AS o
      JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
      JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
      JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
      GROUP  BY r."name", sr."name"
      HAVING rep_sales_usd = (
            SELECT MAX(inner_totals."rep_sales_usd")
            FROM (
                   SELECT ROUND(SUM(o2."total_amt_usd"),2) AS "rep_sales_usd"
                   FROM   "web_orders"      AS o2
                   JOIN   "web_accounts"    AS a2  ON o2."account_id" = a2."id"
                   JOIN   "web_sales_reps"  AS sr2 ON a2."sales_rep_id" = sr2."id"
                   JOIN   "web_region"      AS r2  ON sr2."region_id"  = r2."id"
                   WHERE  r2."name" = r."name"
                   GROUP  BY sr2."name"
                 ) AS inner_totals
      )
    ) AS rep_stats
ON rep_stats."region_name" = region_stats."region_name"
ORDER BY region_stats."region_name", rep_stats."sales_rep_name"
LIMIT 20;
```
