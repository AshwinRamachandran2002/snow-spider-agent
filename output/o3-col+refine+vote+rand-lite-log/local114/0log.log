--Description: 9) Pull the final report: per region → #orders, total $sales, and every top-performing rep (ties included)  
SELECT
    region_stats."region_name",
    region_stats."orders_cnt",
    region_stats."region_sales_usd",
    rep_stats."sales_rep_name",
    rep_stats."rep_sales_usd"
FROM
    ( /* region level stats */
      SELECT r."name"                        AS "region_name",
             COUNT(o."id")                   AS "orders_cnt",
             ROUND(SUM(o."total_amt_usd"),2) AS "region_sales_usd"
      FROM   "web_orders"      AS o
      JOIN   "web_accounts"    AS a  ON o."account_id" = a."id"
      JOIN   "web_sales_reps"  AS sr ON a."sales_rep_id" = sr."id"
      JOIN   "web_region"      AS r  ON sr."region_id"  = r."id"
