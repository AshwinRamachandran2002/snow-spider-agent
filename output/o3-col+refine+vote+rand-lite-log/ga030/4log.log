2025-05-05 04:25:44 - Thread-3101 (execute) - INFO - [Exploration]
Below are 10 successive BigQuery SELECT statements – from very simple inspections up to the final computation.  
Each query is preceded by a short description and is limited to 20 rows except the last one (which is limited to the single best-performing cohort).

```sql
--Description: 1. Peek at the kinds of events that exist on one day (2018-07-02).
SELECT DISTINCT event_name
FROM   `firebase-public-project.analytics_153293282.events_20180702`
LIMIT  20;
```

```sql
--Description: 2. Look at a few raw “session_start” events on that same day.
SELECT  user_pseudo_id,
        event_timestamp,
        DATE(TIMESTAMP_MICROS(event_timestamp)) AS event_date
FROM    `firebase-public-project.analytics_153293282.events_20180702`
WHERE   event_name = 'session_start'
LIMIT   20;
```

```sql
--Description: 3. Find each user’s very first session (all tables July-02 onward).
SELECT  user_pseudo_id,
        MIN(event_timestamp) AS first_session_ts_micros
FROM    `firebase-public-project.analytics_153293282.events_*`
WHERE   _TABLE_SUFFIX >= '20180702'
  AND   event_name = 'session_start'
GROUP BY user_pseudo_id
LIMIT   20;
```

```sql
--Description: 4. Convert those first-session timestamps to cohort Mondays.
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX >= '20180702'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT  user_pseudo_id,
        DATE_TRUNC(DATE(TIMESTAMP_MICROS(first_session_ts_micros)), WEEK(MONDAY)) 
        AS cohort_monday
FROM    first_sessions
LIMIT   20;
```

```sql
--Description: 5. Count users in each weekly cohort (starting 2018-07-02).
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX >= '20180702'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT  DATE_TRUNC(DATE(TIMESTAMP_MICROS(first_session_ts_micros)), WEEK(MONDAY)) 
        AS cohort_monday,
        COUNT(DISTINCT user_pseudo_id)                AS cohort_size
FROM    first_sessions
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT   20;
```

```sql
--Description: 6. Retrieve sessions that occur 21-27 days after the first one
--               (possible “week-4 return” events) – show a sample.
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX >= '20180702'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT  e.user_pseudo_id,
        DATE_DIFF(
          DATE(TIMESTAMP_MICROS(e.event_timestamp)),
          DATE(TIMESTAMP_MICROS(f.first_session_ts_micros)),
          DAY)                               AS days_since_first,
        DATE(TIMESTAMP_MICROS(e.event_timestamp)) AS event_day
FROM    `firebase-public-project.analytics_153293282.events_*` AS e
JOIN    first_sessions  AS f
ON      e.user_pseudo_id = f.user_pseudo_id
WHERE   e.event_name = 'session_start'
  AND   DATE_DIFF(
          DATE(TIMESTAMP_MICROS(e.event_timestamp)),
          DATE(TIMESTAMP_MICROS(f.first_session_ts_micros)),
          DAY) BETWEEN 21 AND 27
LIMIT   20;
```

```sql
--Description: 7. Mark every user as “retained” or “not retained” in week 4.
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX >= '20180702'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
),
week4_returns AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` AS e
  JOIN   first_sessions AS f
  ON     e.user_pseudo_id = f.user_pseudo_id
  WHERE  e.event_name = 'session_start'
    AND  DATE_DIFF(
           DATE(TIMESTAMP_MICROS(e.event_timestamp)),
           DATE(TIMESTAMP_MICROS(f.first_session_ts_micros)),
           DAY) BETWEEN 21 AND 27
)
SELECT  f.user_pseudo_id,
        IF(w.user_pseudo_id IS NULL, 0, 1) AS retained_in_week4
FROM    first_sessions  AS f
LEFT JOIN week4_returns AS w
ON      f.user_pseudo_id = w.user_pseudo_id
LIMIT   20;
```

```sql
--Description: 8. Compute the week-4 retention rate for every cohort Monday.
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX >= '20180702'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT  user_pseudo_id,
          DATE_TRUNC(DATE(TIMESTAMP_MICROS(first_session_ts_micros)), WEEK(MONDAY))
          AS cohort_monday,
          first_session_ts_micros
  FROM    first_sessions
),
week4_returns AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` AS e
  JOIN   cohorts AS c
  ON     e.user_pseudo_id = c.user_pseudo_id
  WHERE  e.event_name = 'session_start'
    AND  DATE_DIFF(
           DATE(TIMESTAMP_MICROS(e.event_timestamp)),
           DATE(TIMESTAMP_MICROS(c.first_session_ts_micros)),
           DAY) BETWEEN 21 AND 27
)
SELECT  c.cohort_monday,
        COUNT(DISTINCT c.user_pseudo_id)                                   AS cohort_size,
        COUNT(DISTINCT w.user_pseudo_id)                                   AS week4_users,
        SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                    COUNT(DISTINCT c.user_pseudo_id))                      AS week4_retention
FROM    cohorts AS c
LEFT JOIN week4_returns AS w
ON      c.user_pseudo_id = w.user_pseudo_id
GROUP BY c.cohort_monday
ORDER BY week4_retention DESC
LIMIT   20;
```

```sql
--Description: 9. Same as #8 but only show cohorts up to 2018-10-01 (sample).
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180702' AND '20181001'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT  user_pseudo_id,
          DATE_TRUNC(DATE(TIMESTAMP_MICROS(first_session_ts_micros)), WEEK(MONDAY))
          AS cohort_monday,
          first_session_ts_micros
  FROM    first_sessions
),
week4_returns AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` e
  JOIN   cohorts c
  ON     e.user_pseudo_id = c.user_pseudo_id
  WHERE  e.event_name = 'session_start'
    AND  DATE_DIFF(
           DATE(TIMESTAMP_MICROS(e.event_timestamp)),
           DATE(TIMESTAMP_MICROS(c.first_session_ts_micros)),
           DAY) BETWEEN 21 AND 27
)
SELECT  c.cohort_monday,
        SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                    COUNT(DISTINCT c.user_pseudo_id)) AS week4_retention
FROM    cohorts c
LEFT JOIN week4_returns w
ON      c.user_pseudo_id = w.user_pseudo_id
GROUP BY c.cohort_monday
ORDER BY week4_retention DESC
LIMIT   20;
```

```sql
--Description: 10. FINAL – return the single cohort Monday (after 2018-07-02)
--                that has the highest week-4 retention rate.
WITH first_sessions AS (
  SELECT  user_pseudo_id,
          MIN(event_timestamp) AS first_session_ts_micros
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX >= '20180702'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT  user_pseudo_id,
          DATE_TRUNC(DATE(TIMESTAMP_MICROS(first_session_ts_micros)), WEEK(MONDAY))
          AS cohort_monday,
          first_session_ts_micros
  FROM    first_sessions
),
week4_returns AS (
  SELECT DISTINCT e.user_pseudo_id
  FROM   `firebase-public-project.analytics_153293282.events_*` AS e
  JOIN   cohorts AS c
  ON     e.user_pseudo_id = c.user_pseudo_id
  WHERE  e.event_name = 'session_start'
    AND  DATE_DIFF(
           DATE(TIMESTAMP_MICROS(e.event_timestamp)),
           DATE(TIMESTAMP_MICROS(c.first_session_ts_micros)),
           DAY) BETWEEN 21 AND 27
)
SELECT  c.cohort_monday            -- ► answer column ◄
FROM    cohorts AS c
LEFT JOIN week4_returns AS w
ON      c.user_pseudo_id = w.user_pseudo_id
GROUP BY c.cohort_monday
ORDER BY SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                     COUNT(DISTINCT c.user_pseudo_id)) DESC
LIMIT   1;
```

Run the last query; it returns exactly one row – the Monday date (`YYYY-MM-DD`) of the cohort that achieved the highest 4-week retention rate.
