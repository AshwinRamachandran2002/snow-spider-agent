--Description: 3) For every user whose first session is on/after 2018-07-02, get that first-session date.
SELECT
  `user_pseudo_id`,
  MIN(PARSE_DATE('%Y%m%d', `event_date`)) AS `first_session_date`
FROM   `firebase-public-project.analytics_153293282.events_*`
WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  AND  `event_name` = 'session_start'
GROUP  BY `user_pseudo_id`
LIMIT 20;
