Query:
--Description: 8) Compute cohort size, week-4 retained users, and the retention rate.
SELECT
  c.`cohort_week`,
  COUNT(DISTINCT c.`user_pseudo_id`)                    AS `cohort_size`,
  COUNT(DISTINCT r.`user_pseudo_id`)                    AS `retained_week4`,
  SAFE_DIVIDE(COUNT(DISTINCT r.`user_pseudo_id`),
              COUNT(DISTINCT c.`user_pseudo_id`))       AS `retention_rate`
FROM (
  SELECT
    `user_pseudo_id`,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', `event_date`)), WEEK(MONDAY)) AS `cohort_week`
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND  `event_name` = 'session_start'
  GROUP  BY `user_pseudo_id`
) c
LEFT JOIN (
  SELECT DISTINCT
    c.`user_pseudo_id`,
    c.`cohort_week`
  FROM (
    SELECT
      `user_pseudo_id`,
      DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', `event_date`)), WEEK(MONDAY)) AS `cohort_week`
    FROM   `firebase-public-project.analytics_153293282.events_*`
    WHERE  _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
      AND  `event_name` = 'session_start'
    GROUP  BY `user_pseudo_id`
  ) c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON   e.`user_pseudo_id` = c.`user_pseudo_id`
  WHERE e.`event_name` = 'session_start'
    AND DATE_DIFF(PARSE_DATE('%Y%m%d', e.`event_date`), c.`cohort_week`, WEEK(MONDAY)) = 4
) r
ON  c.`user_pseudo_id` = r.`user_pseudo_id`
AND c.`cohort_week`   = r.`cohort_week`
GROUP BY c.`cohort_week`
ORDER BY c.`cohort_week`
LIMIT 20;
