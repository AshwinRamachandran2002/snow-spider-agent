```sql
--Description:  The goal is to label every `session_start` with two things:
--              1) cohort_week  – the Monday of the week in which the user’s FIRST
--                 session_start occurred (between 2018-07-02 and 2018-09-30)
--              2) week_index   – how many whole weeks after that cohort_week the
--                 current session_start happened (0 = same week, 3 = fourth week)
--              -----------------------------------------------------------------
--              Step A: in a sub-query (alias c) determine, for each user_pseudo_id,
--                      the earliest table suffix that contains a session_start.
--                      Convert that yyyymmdd into a DATE and truncate to Monday.
--              Step B: join every session_start event (alias e) for the same users
--                      back onto the cohort list.  Again convert the table suffix
--                      to a DATE-Monday (event_week).
--              Step C: compute week_index by taking the day difference between
--                      event_week and cohort_week, integer-dividing by 7.
--              The ambiguous-column error is avoided by referencing c.user_pseudo_id
--              wherever the column appears in the SELECT list.
SELECT
  c.user_pseudo_id,
  c.cohort_week,
  DATE_TRUNC(PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX), WEEK(MONDAY)) AS event_week,
  DIV(
        DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX), WEEK(MONDAY)),
          c.cohort_week,
          DAY),
        7) AS week_index
FROM (
  /* Step A: build the cohort table (one row per user) */
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(_TABLE_SUFFIX)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
) AS c
/* Step B: join every later session_start for those users */
JOIN `firebase-public-project.analytics_153293282.events_*` AS e
  ON c.user_pseudo_id = e.user_pseudo_id
WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
  AND e.event_name = 'session_start'
LIMIT 20;
