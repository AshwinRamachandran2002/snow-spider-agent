```sql
--Description: 9) Calculate the 4-week retention rate for each cohort.  
SELECT
  cohort_week,
  COUNT(DISTINCT CASE WHEN week_index = 3 THEN user_pseudo_id END) AS week4_users,
  COUNT(DISTINCT user_pseudo_id) AS cohort_size,
  SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN week_index = 3 THEN user_pseudo_id END),
              COUNT(DISTINCT user_pseudo_id)) AS week4_retention
FROM (
  SELECT
    user_pseudo_id,
    cohort_week,
    DIV(DATE_DIFF(DATE_TRUNC(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX), WEEK(MONDAY)), cohort_week, DAY), 7) AS week_index
  FROM (
    SELECT
      e.user_pseudo_id,
      DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(e2._TABLE_SUFFIX)), WEEK(MONDAY)) AS cohort_week
    FROM `firebase-public-project.analytics_153293282.events_*` AS e
    JOIN `firebase-public-project.analytics_153293282.events_*` AS e2
    ON e.user_pseudo_id = e2.user_pseudo_id
    WHERE e2._TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
      AND e2.event_name = 'session_start'
    GROUP BY e.user_pseudo_id
  ) AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
  ON c.user_pseudo_id = e.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND e.event_name = 'session_start'
)
GROUP BY cohort_week
ORDER BY week4_retention DESC
LIMIT 20;
```

```sql
--Description: 10) Return the Monday date (cohort_week) that has the **highest** week-4 retention.  
SELECT
  FORMAT_DATE('%Y-%m-%d', cohort_week) AS best_cohort_week_monday
FROM (
  SELECT
    cohort_week,
    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN week_index = 3 THEN user_pseudo_id END),
                COUNT(DISTINCT user_pseudo_id)) AS week4_retention,
    ROW_NUMBER() OVER (ORDER BY SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN week_index = 3 THEN user_pseudo_id END),
                                            COUNT(DISTINCT user_pseudo_id)) DESC) AS rn
  FROM (
    SELECT
      user_pseudo_id,
      cohort_week,
      DIV(DATE_DIFF(DATE_TRUNC(PARSE_DATE('%Y%m%d', _TABLE_SUFFIX), WEEK(MONDAY)), cohort_week, DAY), 7) AS week_index
    FROM (
      SELECT
        e.user_pseudo_id,
        DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(e2._TABLE_SUFFIX)), WEEK(MONDAY)) AS cohort_week
      FROM `firebase-public-project.analytics_153293282.events_*` AS e
      JOIN `firebase-public-project.analytics_153293282.events_*` AS e2
      ON e.user_pseudo_id = e2.user_pseudo_id
      WHERE e2._TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
        AND e2.event_name = 'session_start'
      GROUP BY e.user_pseudo_id
    ) AS c
    JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON c.user_pseudo_id = e.user_pseudo_id
    WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
      AND e.event_name = 'session_start'
  )
  GROUP BY cohort_week
)
WHERE rn = 1
LIMIT 20;
```

