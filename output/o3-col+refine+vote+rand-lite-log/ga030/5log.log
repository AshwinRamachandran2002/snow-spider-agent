--Description: 9) Corrected: compute 4-week retention for every cohort.  All
--              user_pseudo_id references are qualified by alias, removing
--              ambiguity.  
WITH cohort AS (                            -- build cohort table
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(_TABLE_SUFFIX)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
),
week_map AS (                               -- map every session_start to a week
  SELECT
    c.user_pseudo_id,
    c.cohort_week,
    DIV(
        DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX), WEEK(MONDAY)),
          c.cohort_week,
          DAY),
        7) AS week_index
  FROM cohort AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON c.user_pseudo_id = e.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND e.event_name = 'session_start'
)
SELECT
  cohort_week,
  COUNT(DISTINCT CASE WHEN week_index = 3 THEN user_pseudo_id END) AS week4_users,
  COUNT(DISTINCT user_pseudo_id)                                   AS cohort_size,
  SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN week_index = 3 THEN user_pseudo_id END),
              COUNT(DISTINCT user_pseudo_id))                      AS week4_retention
FROM week_map
GROUP BY cohort_week
ORDER BY week4_retention DESC
LIMIT 20
