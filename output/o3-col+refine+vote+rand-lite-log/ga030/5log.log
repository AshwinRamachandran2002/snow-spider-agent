--Description: 4) For every user, find the first day (suffix) they ever fired a session_start **from 2018-07-02 forward**.  
SELECT
  user_pseudo_id,
  MIN(_TABLE_SUFFIX) AS first_session_yyyymmdd
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
  AND event_name = 'session_start'
GROUP BY user_pseudo_id
LIMIT 20;
