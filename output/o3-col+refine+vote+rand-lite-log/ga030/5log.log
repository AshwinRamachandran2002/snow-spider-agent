--Description: 8) Corrected: list all users who came back exactly in the 4-th week
--              after their cohort week. Ambiguous columns are qualified with the
--              appropriate alias (c.user_pseudo_id).  
WITH cohort AS (                         -- Step-1: first session_start → cohort_week
  SELECT
    user_pseudo_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', MIN(_TABLE_SUFFIX)), WEEK(MONDAY)) AS cohort_week
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180930'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
),
week_map AS (                            -- Step-2: attach every later session_start
  SELECT
    c.user_pseudo_id,
    c.cohort_week,
    DIV(
        DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e._TABLE_SUFFIX), WEEK(MONDAY)),
          c.cohort_week,
          DAY),
        7) AS week_index
  FROM cohort AS c
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON c.user_pseudo_id = e.user_pseudo_id
  WHERE e._TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND e.event_name = 'session_start'
)
SELECT DISTINCT
  user_pseudo_id,
  cohort_week
FROM week_map
WHERE week_index = 3                         -- 4-th week
LIMIT 20
