    f.`user_pseudo_id`,
    f.cohort_monday,
    BOOL_OR(
      PARSE_DATE('%Y%m%d', e.`event_date`)
        BETWEEN f.cohort_monday + INTERVAL 21 DAY
            AND f.cohort_monday + INTERVAL 27 DAY
    ) AS week4_returned
  FROM   firsts AS f
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS e
  ON     e.`user_pseudo_id` = f.`user_pseudo_id`
  WHERE  e.`event_name` = 'session_start'
  GROUP  BY f.`user_pseudo_id`, f.cohort_monday
)
SELECT
  cohort_monday,
  SAFE_DIVIDE(COUNTIF(week4_returned), COUNT(*)) AS week4_retention
FROM   returns
GROUP  BY cohort_monday
ORDER  BY week4_retention DESC
LIMIT 20;
