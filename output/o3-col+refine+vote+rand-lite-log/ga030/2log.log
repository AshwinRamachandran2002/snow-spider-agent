```sql
--Description: 
-- We need a single statement that (a) builds weekly cohorts starting Monday 2018-07-02, 
-- (b) checks if users return with at least one `session_start` in days 21-27 
-- after their cohort Monday (week-4 window), (c) computes each cohort’s 
-- 4-week retention rate, and (d) returns the Monday date of the cohort that 
-- achieves the highest such rate.   
-- Logic inside CTEs:  
--   firsts  : each user’s first-ever session date → truncate to Monday for cohort label.  
--   returns : join user to all their session_start events and flag week-4 return with LOGICAL_OR.  
--   cohorts : aggregate to cohort level and calculate retention %.  
--   final   : pick the cohort with MAX retention and output the Monday in ‘YYYY-MM-DD’.  
WITH firsts AS (
  SELECT
    `user_pseudo_id`,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', `event_date`)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE `event_name` = 'session_start'
    AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
  GROUP BY `user_pseudo_id`
),
returns AS (
  SELECT
    f.`user_pseudo_id`,
    f.cohort_monday,
    LOGICAL_OR(
      PARSE_DATE('%Y%m%d', e.`event_date`)
        BETWEEN f.cohort_monday + INTERVAL 21 DAY
            AND f.cohort_monday + INTERVAL 27 DAY
    ) AS week4_returned
  FROM firsts AS f
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON e.`user_pseudo_id` = f.`user_pseudo_id`
  WHERE e.`event_name` = 'session_start'
  GROUP BY f.`user_pseudo_id`, f.cohort_monday
),
cohorts AS (
  SELECT
    cohort_monday,
    COUNT(*)                                AS cohort_size,
    COUNTIF(week4_returned)                 AS retained_users,
    SAFE_DIVIDE(COUNTIF(week4_returned), COUNT(*)) AS week4_retention
  FROM returns
  GROUP BY cohort_monday
)
SELECT
  FORMAT_DATE('%Y-%m-%d', cohort_monday) AS best_cohort_monday
FROM cohorts
ORDER BY week4_retention DESC
LIMIT 1;
```
