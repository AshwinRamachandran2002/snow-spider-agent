--Description: 6)  Count the number of users in each weekly cohort (cohort size)
SELECT
  cohort_monday,
  COUNT(DISTINCT `user_pseudo_id`) AS cohort_size
FROM (
  SELECT
    `user_pseudo_id`,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', `event_date`)), WEEK(MONDAY)) AS cohort_monday
  FROM   `firebase-public-project.analytics_153293282.events_*`
  WHERE  `event_name` = 'session_start'
    AND  PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
  GROUP  BY `user_pseudo_id`
)
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
