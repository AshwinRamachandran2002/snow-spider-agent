Query:
--Description: 8) Aggregate to cohort level – compute the 4-week retention rate
WITH firsts AS (
  SELECT
    `user_pseudo_id`,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', `event_date`)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE `event_name` = 'session_start'
    AND PARSE_DATE('%Y%m%d', `event_date`) >= DATE '2018-07-02'
  GROUP BY `user_pseudo_id`
),
returns AS (
  SELECT
    f.`user_pseudo_id`,
    f.cohort_monday,
    LOGICAL_OR(                                   -- corrected from BOOL_OR
      PARSE_DATE('%Y%m%d', e.`event_date`)
        BETWEEN f.cohort_monday + INTERVAL 21 DAY
            AND f.cohort_monday + INTERVAL 27 DAY
    ) AS week4_returned
  FROM firsts AS f
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON e.`user_pseudo_id` = f.`user_pseudo_id`
  WHERE e.`event_name` = 'session_start'
  GROUP BY f.`user_pseudo_id`, f.cohort_monday
)
SELECT
  cohort_monday,
  COUNTIF(week4_returned)                       AS retained_users,
  COUNT(*)                                      AS cohort_size,
  SAFE_DIVIDE(COUNTIF(week4_returned), COUNT(*)) AS week4_retention
FROM returns
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20
