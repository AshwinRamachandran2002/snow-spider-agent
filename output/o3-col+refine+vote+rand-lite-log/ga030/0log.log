```sql
--Description / Thinking process:
-- Objective: find the Monday-based cohort (first-session week) that shows the highest 4-th-week
-- retention between 2018-07-02 and 2018-09-03, and return that Monday date.
--
-- 1) first_sessions  : for every user grab the timestamp of their very first `session_start`.
-- 2) cohorts         : turn that timestamp into a DATE and truncate it to the Monday of the week
--                      → cohort_monday for each user.
-- 3) wk4_returns     : look at all `session_start` events fired by those users that fall in
--                      [cohort_monday + 21 days, cohort_monday + 27 days] (their 4-th week).
-- 4) retention_table : count users per cohort, count how many of them returned in week-4,
--                      compute retention %, and order descending.
-- 5) Final SELECT    : emit only the cohort_monday with the highest week-4 retention.
WITH first_sessions AS (
  SELECT
    user_pseudo_id,
    TIMESTAMP_MICROS(MIN(event_timestamp)) AS first_session_ts
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
  GROUP BY user_pseudo_id
),
cohorts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(DATE(first_session_ts), WEEK(MONDAY)) AS cohort_monday
  FROM first_sessions
),
wk4_returns AS (
  SELECT DISTINCT
    c.user_pseudo_id,
    c.cohort_monday
  FROM cohorts c
  JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = c.user_pseudo_id
   AND e.event_name = 'session_start'
   AND DATE(TIMESTAMP_MICROS(e.event_timestamp))
       BETWEEN DATE_ADD(c.cohort_monday, INTERVAL 21 DAY)
           AND DATE_ADD(c.cohort_monday, INTERVAL 27 DAY)
  WHERE _TABLE_SUFFIX BETWEEN '20180723' AND '20180930'   -- covers possible week-4 windows
),
retention_table AS (
  SELECT
    c.cohort_monday,
    COUNT(DISTINCT c.user_pseudo_id)              AS cohort_size,
    COUNT(DISTINCT w.user_pseudo_id)              AS retained_wk4,
    SAFE_DIVIDE(COUNT(DISTINCT w.user_pseudo_id),
                COUNT(DISTINCT c.user_pseudo_id)) AS wk4_retention_rate
  FROM cohorts c
  LEFT JOIN wk4_returns w
    ON w.user_pseudo_id = c.user_pseudo_id
   AND w.cohort_monday  = c.cohort_monday
  GROUP BY c.cohort_monday
)
SELECT FORMAT_DATE('%F', cohort_monday) AS best_cohort_monday
FROM retention_table
ORDER BY wk4_retention_rate DESC
LIMIT 1;
```
