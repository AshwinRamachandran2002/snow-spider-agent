Query:
-- 7. Description:  compute, for every cohort, how many of its users came back in their 4-th week
WITH base AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(DATE(TIMESTAMP_MICROS(MIN(event_timestamp))), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
  GROUP BY user_pseudo_id
)
SELECT
       b.cohort_monday,
       COUNT(DISTINCT b.user_pseudo_id)             AS cohort_size,
       COUNT(DISTINCT e.user_pseudo_id)             AS retained_wk4
FROM base b
LEFT JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON e.user_pseudo_id = b.user_pseudo_id
     AND e.event_name = 'session_start'
     AND DATE(TIMESTAMP_MICROS(e.event_timestamp))
           BETWEEN DATE_ADD(b.cohort_monday, INTERVAL 21 DAY)
               AND DATE_ADD(b.cohort_monday, INTERVAL 27 DAY)
GROUP BY b.cohort_monday
ORDER BY b.cohort_monday
LIMIT 20;
