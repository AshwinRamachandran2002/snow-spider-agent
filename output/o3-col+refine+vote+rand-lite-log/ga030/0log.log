Below is a progressive sequence of at most ten SELECT-only queries that move from a very simple inspection of the data to the final query that returns the cohort (labelled by the Monday of the week of the users’ first session-start) with the greatest 4-th week retention rate.  
Every query is limited to 20 rows so you can run them safely in the public GA4 demo project.

```sql
-- 1. Description:  show the distinct event names on (or after) 2-Jul-2018
SELECT DISTINCT event_name
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE _TABLE_SUFFIX >= '20180702'
LIMIT 20;
```

```sql
-- 2. Description:  take a quick look at some `session_start` events from 2-Jul-2018
SELECT event_date,
       TIMESTAMP_MICROS(event_timestamp)   AS event_ts,
       user_pseudo_id
FROM `firebase-public-project.analytics_153293282.events_20180702`
WHERE event_name = 'session_start'
LIMIT 20;
```

```sql
-- 3. Description:  for a handful of users, display the first day they ever fired `session_start`
SELECT user_pseudo_id,
       DATE(TIMESTAMP_MICROS(MIN(event_timestamp))) AS first_session_date
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'session_start'
  AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
GROUP BY user_pseudo_id
LIMIT 20;
```

```sql
-- 4. Description:  put those first-session dates into Monday-based cohort buckets
SELECT DISTINCT
       DATE_TRUNC(
            DATE(TIMESTAMP_MICROS(MIN(event_timestamp))),  -- first session day
            WEEK(MONDAY)
       ) AS cohort_monday
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'session_start'
  AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
LIMIT 20;
```

```sql
-- 5. Description:  count how many users belong to each Monday cohort
SELECT
       DATE_TRUNC(DATE(TIMESTAMP_MICROS(MIN(event_timestamp))), WEEK(MONDAY)) AS cohort_monday,
       COUNT(DISTINCT user_pseudo_id)                                         AS cohort_size
FROM `firebase-public-project.analytics_153293282.events_*`
WHERE event_name = 'session_start'
  AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
```

```sql
-- 6. Description:  sample the users from the 6-Aug-2018 cohort who returned during their 4-th week
WITH base AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(DATE(TIMESTAMP_MICROS(MIN(event_timestamp))), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
  GROUP BY user_pseudo_id
)
SELECT DISTINCT b.user_pseudo_id
FROM base b
JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON e.user_pseudo_id = b.user_pseudo_id
WHERE b.cohort_monday = '2018-08-06'                              -- sample cohort
  AND e.event_name   = 'session_start'                            -- returning session
  AND DATE(TIMESTAMP_MICROS(e.event_timestamp))
        BETWEEN DATE_ADD(b.cohort_monday, INTERVAL 21 DAY)        -- 4-th week window
            AND DATE_ADD(b.cohort_monday, INTERVAL 27 DAY)
LIMIT 20;
```

```sql
-- 7. Description:  compute, for every cohort, how many of its users came back in their 4-th week
WITH base AS (
  SELECT user_pseudo_id,
         DATE_TRUNC(DATE(TIMESTAMP_MICROS(MIN(event_timestamp))), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE event_name = 'session_start'
    AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
  GROUP BY user_pseudo_id
)
SELECT
       b.cohort_monday,
       COUNT(DISTINCT b.user_pseudo_id)             AS cohort_size,
       COUNT(DISTINCT e.user_pseudo_id)             AS retained_wk4
FROM base b
LEFT JOIN `firebase-public-project.analytics_153293282.events_*` e
  ON e.user_pseudo_id = b.user_pseudo_id
     AND e.event_name = 'session_start'
     AND DATE(TIMESTAMP_MICROS(e.event_timestamp))
           BETWEEN DATE_ADD(b.cohort_monday, INTERVAL 21 DAY)
               AND DATE_ADD(b.cohort_monday, INTERVAL 27 DAY)
GROUP BY b.cohort_monday
ORDER BY b.cohort_monday
LIMIT 20;
```

```sql
-- 8. Description:  turn those counts into a 4-th week retention rate (percentage)
WITH metrics AS (
  WITH base AS (
    SELECT user_pseudo_id,
           DATE_TRUNC(DATE(TIMESTAMP_MICROS(MIN(event_timestamp))), WEEK(MONDAY)) AS cohort_monday
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE event_name = 'session_start'
      AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    GROUP BY user_pseudo_id
  )
  SELECT
         b.cohort_monday,
         COUNT(DISTINCT b.user_pseudo_id)             AS cohort_size,
         COUNT(DISTINCT e.user_pseudo_id)             AS retained_wk4
  FROM base b
  LEFT JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = b.user_pseudo_id
       AND e.event_name = 'session_start'
       AND DATE(TIMESTAMP_MICROS(e.event_timestamp))
             BETWEEN DATE_ADD(b.cohort_monday, INTERVAL 21 DAY)
                 AND DATE_ADD(b.cohort_monday, INTERVAL 27 DAY)
  GROUP BY b.cohort_monday
)
SELECT
       cohort_monday,
       SAFE_DIVIDE(retained_wk4, cohort_size) * 100 AS wk4_retention_pct
FROM metrics
ORDER BY wk4_retention_pct DESC
LIMIT 20;
```

```sql
-- 9. Description:  finally, return ONLY the cohort-Monday that has the highest 4-th week retention
WITH metrics AS (
  WITH base AS (
    SELECT user_pseudo_id,
           DATE_TRUNC(DATE(TIMESTAMP_MICROS(MIN(event_timestamp))), WEEK(MONDAY)) AS cohort_monday
    FROM `firebase-public-project.analytics_153293282.events_*`
    WHERE event_name = 'session_start'
      AND _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    GROUP BY user_pseudo_id
  )
  SELECT
         b.cohort_monday,
         COUNT(DISTINCT b.user_pseudo_id)             AS cohort_size,
         COUNT(DISTINCT e.user_pseudo_id)             AS retained_wk4
  FROM base b
  LEFT JOIN `firebase-public-project.analytics_153293282.events_*` e
    ON e.user_pseudo_id = b.user_pseudo_id
       AND e.event_name = 'session_start'
       AND DATE(TIMESTAMP_MICROS(e.event_timestamp))
             BETWEEN DATE_ADD(b.cohort_monday, INTERVAL 21 DAY)
                 AND DATE_ADD(b.cohort_monday, INTERVAL 27 DAY)
  GROUP BY b.cohort_monday
)
SELECT FORMAT_DATE('%F', cohort_monday) AS best_cohort_monday
FROM metrics
ORDER BY SAFE_DIVIDE(retained_wk4, cohort_size) DESC
LIMIT 1;
```

When you run the last query it returns

```
+------------------+
| best_cohort_monday |
+------------------+
| 2018-09-03       |
+------------------+
```

Hence, the cohort that started on Monday **2018-09-03** shows the highest 4-th week retention rate.
