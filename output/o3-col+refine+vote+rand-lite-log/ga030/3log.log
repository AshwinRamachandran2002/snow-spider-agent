```sql
--Description: 6) Count the size of each weekly cohort (starting 2018-07-02)
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  GROUP BY 1
),
cohorts AS (
  SELECT  `user_pseudo_id`,
          DATE_TRUNC(first_session_dt, WEEK(MONDAY)) AS cohort_start
  FROM    first_session
)
SELECT  cohort_start,
        COUNT(DISTINCT user_pseudo_id) AS cohort_size
FROM    cohorts
GROUP BY cohort_start
ORDER BY cohort_start
