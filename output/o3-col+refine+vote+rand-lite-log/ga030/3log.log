--Description: 5) Attach a cohort_start date (Monday of week that contains the
--              first session).  Show some samples.
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180601' AND '20181003'
  GROUP BY 1
)
SELECT  `user_pseudo_id`,
        first_session_dt,
        DATE_TRUNC(first_session_dt, WEEK(MONDAY)) AS cohort_start_monday
FROM    first_session
WHERE   first_session_dt >= '2018-07-02'
LIMIT 20;
