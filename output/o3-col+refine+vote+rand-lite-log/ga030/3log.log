Query:
--Description: 7) Identify every session and compute days since the user’s first
--              session; flag those in the 4-th week (21–27 days)
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  GROUP BY 1
),
all_sessions AS (
  SELECT  s.`user_pseudo_id`,
          PARSE_DATE('%Y%m%d', s.event_date)                AS session_dt,
          f.first_session_dt,
          DATE_DIFF(PARSE_DATE('%Y%m%d', s.event_date),
                    f.first_session_dt, DAY)                AS diff_day,
          DATE_TRUNC(f.first_session_dt, WEEK(MONDAY))      AS cohort_start
  FROM    `firebase-public-project.analytics_153293282.events_*` AS s
  JOIN    first_session AS f
          ON f.user_pseudo_id = s.user_pseudo_id
  WHERE   s.`event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
)
SELECT  *
FROM    all_sessions
WHERE   diff_day BETWEEN 21 AND 27
LIMIT 20;
