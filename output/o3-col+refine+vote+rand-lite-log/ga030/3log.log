```sql
--Description: 7) Identify every session and compute days since the user’s first
--              session; flag those in the 4-th week (21–27 days)
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  GROUP BY 1
),
all_sessions AS (
  SELECT  s.`user_pseudo_id`,
          PARSE_DATE('%Y%m%d', s.event_date)                AS session_dt,
          f.first_session_dt,
          DATE_DIFF(PARSE_DATE('%Y%m%d', s.event_date),
                    f.first_session_dt, DAY)                AS diff_day,
          DATE_TRUNC(f.first_session_dt, WEEK(MONDAY))      AS cohort_start
  FROM    `firebase-public-project.analytics_153293282.events_*` AS s
  JOIN    first_session AS f
          ON f.user_pseudo_id = s.user_pseudo_id
  WHERE   s.`event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
)
SELECT  *
FROM    all_sessions
WHERE   diff_day BETWEEN 21 AND 27
LIMIT 20;
```

```sql
--Description: 8) For each cohort, count distinct users who had ANY session in
--              the 4-th week
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  GROUP BY 1
),
cohort_users AS (
  SELECT  `user_pseudo_id`,
          DATE_TRUNC(first_session_dt, WEEK(MONDAY)) AS cohort_start
  FROM    first_session
),
returns_wk4 AS (
  SELECT DISTINCT cu.cohort_start, s.user_pseudo_id
  FROM   cohort_users        AS cu
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS s
         ON s.user_pseudo_id = cu.user_pseudo_id
  WHERE  s.`event_name` = 'session_start'
    AND  _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND  PARSE_DATE('%Y%m%d', s.event_date)
         BETWEEN DATE_ADD(cu.cohort_start, INTERVAL 21 DAY)
             AND DATE_ADD(cu.cohort_start, INTERVAL 27 DAY)
)
SELECT  cohort_start,
        COUNT(DISTINCT user_pseudo_id) AS returned_wk4
FROM    returns_wk4
GROUP BY cohort_start
ORDER BY cohort_start
LIMIT 20;
```

```sql
--Description: 9) Combine cohort sizes with return counts to compute the
--              4-th-week retention rate
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  GROUP BY 1
),
cohort_users AS (
  SELECT  `user_pseudo_id`,
          DATE_TRUNC(first_session_dt, WEEK(MONDAY)) AS cohort_start
  FROM    first_session
),
cohort_sizes AS (
  SELECT  cohort_start,
          COUNT(DISTINCT user_pseudo_id) AS cohort_size
  FROM    cohort_users
  GROUP BY cohort_start
),
returns_wk4 AS (
  SELECT DISTINCT cu.cohort_start, s.user_pseudo_id
  FROM   cohort_users AS cu
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS s
         ON s.user_pseudo_id = cu.user_pseudo_id
  WHERE  s.`event_name` = 'session_start'
    AND  _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND  PARSE_DATE('%Y%m%d', s.event_date)
         BETWEEN DATE_ADD(cu.cohort_start, INTERVAL 21 DAY)
             AND DATE_ADD(cu.cohort_start, INTERVAL 27 DAY)
),
wk4_counts AS (
  SELECT  cohort_start,
          COUNT(DISTINCT user_pseudo_id) AS returned_wk4
  FROM    returns_wk4
  GROUP BY cohort_start
)
SELECT  s.cohort_start,
        s.cohort_size,
        c.returned_wk4,
        SAFE_DIVIDE(c.returned_wk4, s.cohort_size) AS retention_wk4
FROM    cohort_sizes AS s
LEFT JOIN wk4_counts AS c
       ON s.cohort_start = c.cohort_start
ORDER BY retention_wk4 DESC
LIMIT 20;
```

```sql
--Description: 10) Pick the cohort (Monday date) with the highest 4-th-week
--               retention and output it in the asked format “YYYY-MM-DD”
WITH first_session AS (
  SELECT  `user_pseudo_id`,
          MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_dt
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   `event_name` = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
  GROUP BY 1
),
cohort_users AS (
  SELECT  `user_pseudo_id`,
          DATE_TRUNC(first_session_dt, WEEK(MONDAY)) AS cohort_start
  FROM    first_session
),
cohort_sizes AS (
  SELECT  cohort_start,
          COUNT(DISTINCT user_pseudo_id) AS cohort_size
  FROM    cohort_users
  GROUP BY cohort_start
),
returns_wk4 AS (
  SELECT DISTINCT cu.cohort_start, s.user_pseudo_id
  FROM   cohort_users AS cu
  JOIN   `firebase-public-project.analytics_153293282.events_*` AS s
         ON s.user_pseudo_id = cu.user_pseudo_id
  WHERE  s.`event_name` = 'session_start'
    AND  _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND  PARSE_DATE('%Y%m%d', s.event_date)
         BETWEEN DATE_ADD(cu.cohort_start, INTERVAL 21 DAY)
             AND DATE_ADD(cu.cohort_start, INTERVAL 27 DAY)
),
wk4_counts AS (
  SELECT  cohort_start,
          COUNT(DISTINCT user_pseudo_id) AS returned_wk4
  FROM    returns_wk4
  GROUP BY cohort_start
),
retention AS (
  SELECT  s.cohort_start,
          SAFE_DIVIDE(c.returned_wk4, s.cohort_size) AS retention_wk4
  FROM    cohort_sizes  AS s
  JOIN    wk4_counts    AS c
    ON    s.cohort_start = c.cohort_start
)
SELECT  FORMAT_DATE('%Y-%m-%d', cohort_start) AS best_cohort_monday
FROM    retention
ORDER BY retention_wk4 DESC
LIMIT 20;   -- will return the top row (best cohort)
```

