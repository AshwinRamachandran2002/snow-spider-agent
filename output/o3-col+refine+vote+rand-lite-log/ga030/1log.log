WITH activity AS (
  SELECT  user_pseudo_id,
          DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', event_date) ), WEEK(MONDAY)) AS cohort_monday,
          DATE_DIFF( DATE_TRUNC(PARSE_DATE('%Y%m%d', event_date), WEEK(MONDAY)),
                     DATE_TRUNC(MIN( PARSE_DATE('%Y%m%d', event_date) ), WEEK(MONDAY)),
                     WEEK) AS weeks_since_cohort
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id, event_date
)
