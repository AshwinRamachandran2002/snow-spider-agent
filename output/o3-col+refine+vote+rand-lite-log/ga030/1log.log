```sql
--Description: 7) Keep only week-0 (cohort week) and week-3 (fourth week)
--sessions for every user.  Uses a FIRSTS CTE to capture the first session
--date per user, joins back to all session_start events, then filters on
--weeks_since_cohort ∈ (0,3).
WITH firsts AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_date,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
), activity AS (
  SELECT
    firsts.user_pseudo_id,
    firsts.cohort_monday,
    DATE_DIFF(
      DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
      firsts.cohort_monday,
      WEEK
    ) AS weeks_since_cohort
  FROM firsts
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON e.user_pseudo_id = firsts.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND e._TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
)
SELECT
  cohort_monday,
  user_pseudo_id
FROM activity
WHERE weeks_since_cohort IN (0, 3)
LIMIT 20;
