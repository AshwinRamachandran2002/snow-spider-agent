```sql
--Description: 8) Compute 4-week retention rate for every cohort.
WITH firsts AS (
  SELECT  user_pseudo_id,
          DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', event_date) ), WEEK(MONDAY)) AS cohort_monday
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
),
returns AS (
  SELECT  DISTINCT
          f.user_pseudo_id,
          f.cohort_monday
  FROM    firsts AS f
  JOIN    `firebase-public-project.analytics_153293282.events_*` AS e
    ON    e.user_pseudo_id = f.user_pseudo_id
  WHERE   e.event_name = 'session_start'
    AND   _TABLE_SUFFIX BETWEEN '20180730' AND '20181003'          -- ensures week 3 data
    AND   DATE_DIFF( DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
                     f.cohort_monday,
                     WEEK) = 3                                      -- fourth week
)
SELECT  f.cohort_monday,
        COUNT(DISTINCT r.user_pseudo_id) AS week4_users,
        COUNT(DISTINCT f.user_pseudo_id) AS cohort_size,
        SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
                    COUNT(DISTINCT f.user_pseudo_id)) AS week4_retention
FROM    firsts AS f
LEFT JOIN returns AS r
       ON f.user_pseudo_id = r.user_pseudo_id
GROUP  BY cohort_monday
ORDER BY week4_retention DESC, cohort_monday
LIMIT 20;
```

```sql
--Description: 9) Pick the cohort (Monday) with the highest 4-week
--retention – this is the final answer required.
WITH firsts AS (
  SELECT  user_pseudo_id,
          DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', event_date) ), WEEK(MONDAY)) AS cohort_monday
  FROM    `firebase-public-project.analytics_153293282.events_*`
  WHERE   _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    AND   event_name = 'session_start'
  GROUP BY user_pseudo_id
),
returns AS (
  SELECT  DISTINCT
          f.user_pseudo_id,
          f.cohort_monday
  FROM    firsts AS f
  JOIN    `firebase-public-project.analytics_153293282.events_*` AS e
    ON    e.user_pseudo_id = f.user_pseudo_id
  WHERE   e.event_name = 'session_start'
    AND   DATE_DIFF( DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
                     f.cohort_monday,
                     WEEK) = 3
)
SELECT  cohort_monday        -- <-- “YYYY-MM-DD” format
FROM   (
        SELECT  cohort_monday,
                SAFE_DIVIDE(COUNT(DISTINCT user_pseudo_id IN returns),
                            COUNT(DISTINCT user_pseudo_id)) AS week4_retention
        FROM    firsts
        LEFT JOIN returns USING(user_pseudo_id, cohort_monday)
        GROUP BY cohort_monday
       )
ORDER BY week4_retention DESC
LIMIT 1;
```

