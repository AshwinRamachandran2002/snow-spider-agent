```sql
--Description: 8) Compute 4-week retention (week-3) for every cohort.
WITH firsts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
), week3_returns AS (
  SELECT DISTINCT
    f.user_pseudo_id,
    f.cohort_monday
  FROM firsts AS f
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON e.user_pseudo_id = f.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_monday,
          WEEK
        ) = 3           -- fourth week
)
SELECT
  f.cohort_monday,
  COUNT(DISTINCT r.user_pseudo_id) AS week4_users,
  COUNT(DISTINCT f.user_pseudo_id) AS cohort_size,
  SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
              COUNT(DISTINCT f.user_pseudo_id)) AS week4_retention
FROM firsts AS f
LEFT JOIN week3_returns AS r
  ON f.user_pseudo_id = r.user_pseudo_id
GROUP BY cohort_monday
ORDER BY week4_retention DESC, cohort_monday
LIMIT 20;
```

```sql
--Description: 9) Identify the Monday-based cohort with the highest
--week-4 retention using the result of query 8 (re-computed here for
--completeness).
WITH firsts AS (
  SELECT
    user_pseudo_id,
    DATE_TRUNC(MIN(PARSE_DATE('%Y%m%d', event_date)), WEEK(MONDAY)) AS cohort_monday
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
), week3_returns AS (
  SELECT DISTINCT
    f.user_pseudo_id,
    f.cohort_monday
  FROM firsts AS f
  JOIN `firebase-public-project.analytics_153293282.events_*` AS e
    ON e.user_pseudo_id = f.user_pseudo_id
  WHERE e.event_name = 'session_start'
    AND DATE_DIFF(
          DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
          f.cohort_monday,
          WEEK
        ) = 3
), cohort_metrics AS (
  SELECT
    f.cohort_monday,
    SAFE_DIVIDE(COUNT(DISTINCT r.user_pseudo_id),
                COUNT(DISTINCT f.user_pseudo_id)) AS week4_retention
  FROM firsts AS f
  LEFT JOIN week3_returns AS r
    ON f.user_pseudo_id = r.user_pseudo_id
  GROUP BY cohort_monday
)
SELECT cohort_monday
FROM cohort_metrics
ORDER BY week4_retention DESC
LIMIT 1;
```

