```sql
--Description:  Build the (user, weeks_since_cohort) list without the “ambiguous
--column” error.  1) CTE FIRSTS collects each user’s first session_start date
--   between 2018-07-02 and 2018-09-03.  
--   The Monday of that date represents the cohort week.  
-- 2) Join every daily events_* table (alias e) back to FIRSTS on
--   user_pseudo_id and keep only session_start rows through 2018-10-03.  
-- 3) weeks_since_cohort = whole-weeks difference between the Monday of the
--   event_date and the Monday of the user’s first_session_date.  
-- DISTINCT gives one row per (user, week_number) pair; LIMIT 20 just samples.
WITH firsts AS (
  SELECT
    user_pseudo_id,
    MIN(PARSE_DATE('%Y%m%d', event_date)) AS first_session_date
  FROM `firebase-public-project.analytics_153293282.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
    AND event_name = 'session_start'
  GROUP BY user_pseudo_id
)
SELECT DISTINCT
  firsts.user_pseudo_id,
  DATE_DIFF(
    DATE_TRUNC(PARSE_DATE('%Y%m%d', e.event_date), WEEK(MONDAY)),
    DATE_TRUNC(firsts.first_session_date,            WEEK(MONDAY)),
    WEEK
  ) AS weeks_since_cohort
FROM firsts
JOIN `firebase-public-project.analytics_153293282.events_*` AS e
  ON e.user_pseudo_id = firsts.user_pseudo_id
WHERE e.event_name = 'session_start'
  AND e._TABLE_SUFFIX BETWEEN '20180702' AND '20181003'
LIMIT 20;
