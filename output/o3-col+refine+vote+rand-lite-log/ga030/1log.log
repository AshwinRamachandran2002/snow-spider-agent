Query:
--Description: 5) Count the number of new users in each weekly cohort.
SELECT  cohort_monday,
        COUNT(*) AS cohort_size
FROM   (
        -- sub-query from step-4
        SELECT  user_pseudo_id,
                DATE_TRUNC( MIN( PARSE_DATE('%Y%m%d', event_date) ), WEEK(MONDAY) )
                   AS cohort_monday
        FROM    `firebase-public-project.analytics_153293282.events_*`
        WHERE   _TABLE_SUFFIX BETWEEN '20180702' AND '20180903'
          AND   event_name = 'session_start'
        GROUP BY user_pseudo_id
       )
GROUP BY cohort_monday
ORDER BY cohort_monday
LIMIT 20;
