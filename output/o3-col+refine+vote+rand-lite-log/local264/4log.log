FROM "model"  
LIMIT 20;
```

```sql
--Description: 3) How many times does each exact L1_model value appear?  
SELECT "L1_model", COUNT(*) AS "nb_occurrences"  
FROM "model"  
GROUP BY "L1_model"  
ORDER BY "nb_occurrences" DESC  
LIMIT 20;
```

```sql
--Description: 4) Classify every row as either “Stack model” (if the label
--                contains the word “stack”) or “Traditional model” (all others)  
SELECT
  CASE
      WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack model'
      ELSE 'Traditional model'
  END AS "model_category",
  COUNT(*) AS "nb_occurrences"
FROM "model"
GROUP BY "model_category";
```

```sql
--Description: 5) Which of those two high-level categories occurs most often?  
SELECT
  CASE
      WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack model'
      ELSE 'Traditional model'
  END AS "most_frequent_category",
  COUNT(*) AS "total_count"
FROM "model"
GROUP BY "most_frequent_category"
ORDER BY "total_count" DESC
LIMIT 1;
```
