ORDER  BY "name", "model_category";
```

```sql
-- 10. Summarise: which exact L1_model (e.g., 'regression', 'classification', 'Stack', …) is most frequent overall
SELECT "L1_model",
       COUNT(*) AS "nb_occurrences"
