```sql
-- Description: 1) Show the different model categories (L1_model) that exist. 
SELECT DISTINCT "L1_model"
FROM "model"
LIMIT 20;
```

```sql
-- Description: 2) How many records exist for every model category (overall frequency).  
SELECT "L1_model", COUNT(*) AS "cnt"
FROM "model"
GROUP BY "L1_model"
LIMIT 20;
```

```sql
-- Description: 3) Same as #2 but ordered from the most-frequent to least-frequent.  
SELECT "L1_model", COUNT(*) AS "cnt"
FROM "model"
GROUP BY "L1_model"
ORDER BY "cnt" DESC
LIMIT 20;
```

```sql
-- Description: 4) Count only the rows whose category name contains the word “stack”.  
SELECT COUNT(*) AS "stack_cnt"
FROM "model"
WHERE LOWER("L1_model") LIKE '%stack%';
```

```sql
-- Description: 5) Count the rows that do NOT contain the word “stack” (traditional models).  
SELECT COUNT(*) AS "traditional_cnt"
FROM "model"
WHERE LOWER("L1_model") NOT LIKE '%stack%';
```

```sql
-- Description: 6) Display the categories together with a flag that tells whether they are Stack or Traditional.  
SELECT "L1_model",
       CASE WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack' ELSE 'Traditional' END AS "model_type",
       COUNT(*)                                          AS "cnt"
FROM "model"
GROUP BY "L1_model"
LIMIT 20;
```

```sql
-- Description: 7) Aggregate counts at the coarse level (“Stack” vs “Traditional”).  
SELECT CASE WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack' ELSE 'Traditional' END AS "model_type",
       COUNT(*)                                                                             AS "cnt"
FROM "model"
GROUP BY "model_type"
LIMIT 20;
```

```sql
-- Description: 8) Retrieve the single most frequent coarse category.  
SELECT CASE WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack' ELSE 'Traditional' END AS "model_type",
       COUNT(*)                                                                         AS "cnt"
FROM "model"
GROUP BY "model_type"
ORDER BY "cnt" DESC
LIMIT 1;
```

```sql
-- Description: 9) Retrieve the single most frequent fine-grained L1_model category.  
SELECT "L1_model", COUNT(*) AS "cnt"
FROM "model"
GROUP BY "L1_model"
ORDER BY "cnt" DESC
LIMIT 1;
```

```sql
-- Description: 10) Show all rows so that you can manually see which records belong to which type (for sampling).  
SELECT *
FROM "model"
LIMIT 20;
```
