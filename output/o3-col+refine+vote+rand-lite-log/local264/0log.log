-- Description: Identify which exact L1_model string ('regression' or 'tree') is most frequent overall.
SELECT
    "L1_model",
    COUNT(*) AS occurrences
FROM
    "model"
GROUP BY
    "L1_model"
ORDER BY
    occurrences DESC
LIMIT 1
