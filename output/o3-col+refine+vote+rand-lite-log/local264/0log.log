Query:
-- Description: Provide the final comparative answer—whether “Traditional” (regression) or “Stack” (tree) models are more common, and by how much.
SELECT
       CASE
            WHEN LOWER("L1_model") = 'tree'       THEN 'Stack model'
            ELSE                                    'Traditional model'
       END                  AS model_group,
       COUNT(*)             AS total_occurrences
FROM
    "model"
GROUP BY
    model_group
ORDER BY
    total_occurrences DESC
LIMIT 1
