```

```sql
-- Description: Order the previous count in descending order to see the most frequent category
SELECT "L1_model",
       COUNT(*) AS total_count
FROM   "model"
GROUP  BY "L1_model"
ORDER  BY total_count DESC;
```

```sql
-- Description: Verify how many unique (name, version) pairs correspond to the most-frequent category
SELECT "name",
       "version",
       COUNT(*) AS steps_for_version
FROM   "model"
WHERE  "L1_model" = 'regression'        -- replace with category found in query 4 if different
GROUP  BY "name","version";
```

```sql
-- Description: Double-check if any Stack models exist and their count
SELECT "L1_model",
       COUNT(*) AS stack_count
FROM   "model"
WHERE  "L1_model" LIKE '%stack%'        -- catch possible variants like 'Stack', 'stacking'
GROUP  BY "L1_model";
```

```sql
-- Description: Final check—compare counts between “traditional” (non-stack) vs “stack” categories
SELECT CASE
         WHEN LOWER("L1_model") LIKE '%stack%' THEN 'stack'
         ELSE 'traditional'
       END                           AS model_group,
       COUNT(*)                      AS total_models
FROM   "model"
GROUP  BY model_group;
```

```sql
-- Description: Show the most common traditional L1_model (excluding any stack rows)
SELECT "L1_model",
       COUNT(*) AS total_count
FROM   "model"
WHERE  LOWER("L1_model") NOT LIKE '%stack%'
GROUP  BY "L1_model"
ORDER  BY total_count DESC
LIMIT 1;
```

```sql
-- Description: Provide a sanity-check on individual steps for the leading category
SELECT "name",
       "version",
       "step"
FROM   "model"
WHERE  "L1_model" = 'regression'        -- replace if a different category prevails
LIMIT 20;
```

```sql
-- Description: (Optional) Summarize counts per dataset for the leading category
SELECT "name",
       COUNT(*) AS occurrences
FROM   "model"
WHERE  "L1_model" = 'regression'        -- replace if another category leads
GROUP  BY "name";
```
