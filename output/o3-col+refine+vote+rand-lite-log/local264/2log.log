```sql
-- Description: Preview a few rows to understand the data in the "model" table
SELECT *              -- all columns
FROM "model"
LIMIT 20;
```

```sql
-- Description: List every distinct value that appears in "L1_model"
SELECT DISTINCT "L1_model"
FROM "model"
LIMIT 20;
```

```sql
-- Description: Count how many times each "L1_model" value occurs across all names / versions / steps
SELECT "L1_model",
       COUNT(*) AS cnt
FROM   "model"
GROUP  BY "L1_model"
ORDER  BY cnt DESC
LIMIT 20;
```

```sql
-- Description: Show the breakdown of "L1_model" counts per data-set name to verify distribution
SELECT "name",
       "L1_model",
       COUNT(*) AS cnt
FROM   "model"
GROUP  BY "name", "L1_model"
ORDER  BY cnt DESC
LIMIT 20;
```

```sql
-- Description: Identify only the rows where the L1 model is labelled 'Stack' (if present)
SELECT *
FROM   "model"
WHERE  "L1_model" = 'Stack'
LIMIT 20;
```

```sql
-- Description: Identify only the rows for traditional models (i.e. not 'Stack')
SELECT *
FROM   "model"
WHERE  "L1_model" <> 'Stack'
LIMIT 20;
```

```sql
-- Description: Direct comparison – return counts of 'Stack' vs. non-Stack categories
SELECT CASE WHEN "L1_model" = 'Stack' THEN 'Stack'
            ELSE 'Traditional'
       END                         AS model_category,
       COUNT(*)                    AS total_count
FROM   "model"
GROUP  BY model_category
ORDER  BY total_count DESC;
```

```sql
-- Description: Return the single most frequent model category and its total occurrences
SELECT CASE WHEN "L1_model" = 'Stack' THEN 'Stack'
            ELSE 'Traditional'
       END                         AS model_category,
       COUNT(*)                    AS total_count
FROM   "model"
GROUP  BY model_category
ORDER  BY total_count DESC
LIMIT 1;
```

```sql
-- Description: Extra check – raw detailed rows for the most frequent category
SELECT *
FROM   "model"
WHERE  CASE WHEN "L1_model" = 'Stack' THEN 'Stack'
            ELSE 'Traditional'
       END = (
           SELECT CASE WHEN "L1_model" = 'Stack' THEN 'Stack'
                       ELSE 'Traditional'
                  END
           FROM   "model"
           GROUP  BY CASE WHEN "L1_model" = 'Stack' THEN 'Stack'
                          ELSE 'Traditional'
                     END
           ORDER  BY COUNT(*) DESC
           LIMIT 1
       )
LIMIT 20;
```

```sql
-- Description: Final concise answer in a single query (most frequent category and count)
SELECT CASE WHEN "L1_model" = 'Stack' THEN 'Stack'
            ELSE 'Traditional'
       END                         AS most_frequent_model_category,
       COUNT(*)                    AS occurrences
FROM   "model"
GROUP  BY most_frequent_model_category
ORDER  BY occurrences DESC
LIMIT 1;
```
