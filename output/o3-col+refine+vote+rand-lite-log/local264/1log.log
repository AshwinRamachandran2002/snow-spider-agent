```sql
-- 1. Description: List every distinct model category stored in the “model” table
SELECT DISTINCT "L1_model"
FROM "model"
LIMIT 20;
```

```sql
-- 2. Description: Show the first 20 raw rows to understand how the data are distributed across names, versions and steps
SELECT *
FROM "model"
LIMIT 20;
```

```sql
-- 3. Description: Count how many times each model category (L1_model) occurs in the table
SELECT "L1_model",
       COUNT(*) AS "total_occurrences"
FROM   "model"
GROUP  BY "L1_model"
ORDER  BY "total_occurrences" DESC
LIMIT 20;
```

```sql
-- 4. Description: Focus on possible Stack models (any label that contains the word “stack” – case-insensitive)
SELECT *
FROM   "model"
WHERE  LOWER("L1_model") LIKE '%stack%'
LIMIT 20;
```

```sql
-- 5. Description: Count all rows that belong to Stack-type models
SELECT COUNT(*) AS "stack_model_count"
FROM   "model"
WHERE  LOWER("L1_model") LIKE '%stack%';
```

```sql
-- 6. Description: Count all rows that belong to traditional models (i.e. every row that is NOT a Stack model)
SELECT COUNT(*) AS "traditional_model_count"
FROM   "model"
WHERE  LOWER("L1_model") NOT LIKE '%stack%';
```

```sql
-- 7. Description: Provide a side-by-side comparison of the two broad categories
SELECT CASE
           WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack model'
           ELSE 'Traditional model'
       END                              AS "model_category",
       COUNT(*)                         AS "total_occurrences"
FROM   "model"
GROUP  BY "model_category"
ORDER  BY "total_occurrences" DESC;
```

```sql
-- 8. Description: Return only the most frequent model category among the two and its total count
SELECT CASE
           WHEN LOWER("L1_model") LIKE '%stack%' THEN 'Stack model'
           ELSE 'Traditional model'
       END                              AS "most_frequent_category",
       COUNT(*)                         AS "total_occurrences"
FROM   "model"
GROUP  BY "most_frequent_category"
ORDER  BY "total_occurrences" DESC
LIMIT 1;
```

