```sql
--Description: Campaign-level summary of sends, opens, and bounces during the window  
SELECT s."CAMPAIGN_ID", 
       COUNT(DISTINCT s."USER_ID") AS "unique_sends", 
       COUNT(DISTINCT o."USER_ID") AS "unique_opens", 
       COUNT(DISTINCT b."USER_ID") AS "unique_bounces"  
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW   AS s
LEFT JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW   AS o
       ON s."USER_ID" = o."USER_ID"
      AND s."MESSAGE_VARIATION_ID" = o."MESSAGE_VARIATION_ID"
      AND o."TIME" >= 1685606400
      AND o."TIME" < 1685610000
LEFT JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW AS b
       ON s."USER_ID" = b."USER_ID"
      AND s."MESSAGE_VARIATION_ID" = b."MESSAGE_VARIATION_ID"
      AND b."TIME" >= 1685606400
      AND b."TIME" < 1685610000
WHERE s."TIME" >= 1685606400 
  AND s."TIME" < 1685610000  
GROUP BY s."CAMPAIGN_ID"  
LIMIT 20;
```

```sql
--Description: App-group-level engagement metrics (sends vs. opens) in the window  
SELECT s."APP_GROUP_ID",
       COUNT(*)                        AS "push_notification_sends",
       COUNT(DISTINCT o."USER_ID")     AS "unique_push_notification_opens"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW  AS s
LEFT JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW  AS o
       ON s."USER_ID" = o."USER_ID"
      AND s."MESSAGE_VARIATION_ID" = o."MESSAGE_VARIATION_ID"
      AND o."TIME" >= 1685606400
      AND o."TIME" < 1685610000
WHERE s."TIME" >= 1685606400 
  AND s."TIME" < 1685610000
GROUP BY s."APP_GROUP_ID"
LIMIT 20;
```

```sql
--Description: User-level funnel showing send → open → influenced open counts during the window  
SELECT s."USER_ID",
       COUNT(*)                           AS "sends",
       COUNT(DISTINCT o."ID")             AS "opens",
       COUNT(DISTINCT io."ID")            AS "influenced_opens"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW           AS s
LEFT JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW      AS o
       ON s."USER_ID" = o."USER_ID"
      AND o."TIME" >= 1685606400
      AND o."TIME" < 1685610000
LEFT JOIN BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC.USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW AS io
       ON s."USER_ID" = io."USER_ID"
      AND io."TIME" >= 1685606400
      AND io."TIME" < 1685610000
WHERE s."TIME" >= 1685606400 
  AND s."TIME" < 1685610000
GROUP BY s."USER_ID"
LIMIT 20;
```
