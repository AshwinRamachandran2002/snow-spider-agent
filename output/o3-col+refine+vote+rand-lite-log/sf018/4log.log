Query:
--Description: 8) Join SEND and OPEN counts to compute open-rate (simple version).
SELECT 
    s."CAMPAIGN_ID",
    s."push_notification_sends",
    COALESCE(o."push_notification_opens",0) AS "push_notification_opens",
    CASE 
        WHEN s."push_notification_sends" = 0 THEN 0
        ELSE (o."push_notification_opens"::FLOAT / s."push_notification_sends")
    END AS "open_rate"
FROM (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "push_notification_sends"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "CAMPAIGN_ID"
) s
LEFT JOIN (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "push_notification_opens"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "CAMPAIGN_ID"
) o
ON s."CAMPAIGN_ID" = o."CAMPAIGN_ID"
LIMIT 20;
