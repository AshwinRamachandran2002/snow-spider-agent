    s."CAMPAIGN_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW" s
WHERE s."TIME" BETWEEN 1685606400 AND 1685610000
LIMIT 20;
```

```sql
--Description: 6) Count SEND events per campaign within the hour.
SELECT 
    s."CAMPAIGN_ID",
    COUNT(*) AS "push_notification_sends"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW" s
WHERE s."TIME" BETWEEN 1685606400 AND 1685610000
GROUP BY s."CAMPAIGN_ID"
LIMIT 20;
```

```sql
--Description: 7) Count OPEN events per campaign within the hour.
SELECT 
    o."CAMPAIGN_ID",
    COUNT(*) AS "push_notification_opens"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW" o
WHERE o."TIME" BETWEEN 1685606400 AND 1685610000
GROUP BY o."CAMPAIGN_ID"
LIMIT 20;
```

```sql
--Description: 8) Join SEND and OPEN counts to compute open-rate (simple version).
SELECT 
    s."CAMPAIGN_ID",
    s."push_notification_sends",
    COALESCE(o."push_notification_opens",0) AS "push_notification_opens",
    CASE 
        WHEN s."push_notification_sends" = 0 THEN 0
        ELSE (o."push_notification_opens"::FLOAT / s."push_notification_sends")
    END AS "open_rate"
FROM (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "push_notification_sends"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "CAMPAIGN_ID"
) s
LEFT JOIN (
    SELECT "CAMPAIGN_ID", COUNT(*) AS "push_notification_opens"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "CAMPAIGN_ID"
) o
ON s."CAMPAIGN_ID" = o."CAMPAIGN_ID"
LIMIT 20;
```

```sql
--Description: 9) Unique users who performed any OPEN action in the window.
SELECT 
    COUNT(DISTINCT o."USER_ID") AS "unique_users_opened"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW" o
WHERE o."TIME" BETWEEN 1685606400 AND 1685610000;
```

```sql
--Description: 10) Platform-level summary (sends, opens, influenced opens, bounces) for the hour.
SELECT 
    p."PLATFORM",
    SUM(p."push_notification_sends")               AS "push_notification_sends",
    SUM(p."push_notification_opens")               AS "push_notification_opens",
    SUM(p."push_notification_influenced_opens")    AS "push_notification_influenced_opens",
    SUM(p."push_notification_bounces")             AS "push_notification_bounces"
FROM (
    -- sends
    SELECT "PLATFORM",
           COUNT(*)                                    AS "push_notification_sends",
           0                                           AS "push_notification_opens",
           0                                           AS "push_notification_influenced_opens",
           0                                           AS "push_notification_bounces"
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "PLATFORM"
    
    UNION ALL
    
    -- opens
    SELECT "PLATFORM",
           0,
           COUNT(*),
           0,
           0
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_OPEN_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "PLATFORM"
    
    UNION ALL
    
    -- influenced opens
    SELECT "PLATFORM",
           0,
           0,
           COUNT(*),
           0
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_INFLUENCEDOPEN_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "PLATFORM"
    
    UNION ALL
    
    -- bounces
    SELECT "PLATFORM",
           0,
           0,
           0,
           COUNT(*)
    FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_BOUNCE_VIEW"
    WHERE "TIME" BETWEEN 1685606400 AND 1685610000
    GROUP BY "PLATFORM"
) p
GROUP BY p."PLATFORM"
LIMIT 20;
```
