Query:
--Description: 1) Inspect up to 20 push-notification SEND events that took place between 
-- Jun-01-2023 08:00 UTC and 09:00 UTC.
SELECT 
    s."TIME",
    s."APP_GROUP_ID",
    s."CAMPAIGN_ID",
    s."MESSAGE_VARIATION_ID",
    s."PLATFORM",
    s."USER_ID"
FROM BRAZE_USER_EVENT_DEMO_DATASET.PUBLIC."USERS_MESSAGES_PUSHNOTIFICATION_SEND_VIEW"  s
WHERE s."TIME" BETWEEN 1685606400 AND 1685610000
LIMIT 20;
