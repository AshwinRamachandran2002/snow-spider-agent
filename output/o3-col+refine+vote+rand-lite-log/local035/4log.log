                                               geolocation_lat,
                                               geolocation_lng) AS prev_state,
           LAG(geolocation_city)   OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_city,
           LAG(geolocation_zip_code_prefix) OVER (ORDER BY geolocation_state,
                                                         geolocation_city,
                                                         geolocation_zip_code_prefix,
                                                         geolocation_lat,
                                                         geolocation_lng) AS prev_zip,
           LAG(geolocation_lat)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lat,
           LAG(geolocation_lng)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lng
    FROM olist_geolocation
),
distances AS (
    SELECT *,
           ((geolocation_lat - prev_lat) * (geolocation_lat - prev_lat) +
            (geolocation_lng - prev_lng) * (geolocation_lng - prev_lng)
           ) AS dist_sq
    FROM ordered
    WHERE prev_lat IS NOT NULL
)
SELECT prev_state,
       prev_city,
       prev_zip      AS prev_zip_code_prefix,
       ROUND(prev_lat,6) AS prev_lat,
       ROUND(prev_lng,6) AS prev_lng,
       geolocation_state AS curr_state,
