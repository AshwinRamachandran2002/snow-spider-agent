```sql
-- 1) Look at the distinct Brazilian states that appear in the geolocation file
SELECT DISTINCT geolocation_state
FROM olist_geolocation
LIMIT 20;
```

```sql
-- 2) From one of those states (“SP”) show its first 20 distinct cities
SELECT DISTINCT geolocation_city
FROM olist_geolocation
WHERE geolocation_state = 'SP'
ORDER BY geolocation_city
LIMIT 20;
```

```sql
-- 3) Inspect 20 raw latitude / longitude points for São Paulo (city = 'sao paulo')  
SELECT geolocation_zip_code_prefix,
       geolocation_lat,
       geolocation_lng
FROM olist_geolocation
WHERE geolocation_state = 'SP'
  AND geolocation_city  = 'sao paulo'
LIMIT 20;
```

```sql
-- 4) Build the ordered list exactly as requested and attach the latitude/longitude 
--    of the previous row (window function LAG)
SELECT geolocation_state,
       geolocation_city,
       geolocation_zip_code_prefix,
       geolocation_lat,
       geolocation_lng,
       LAG(geolocation_state)  OVER (ORDER BY geolocation_state,
                                           geolocation_city,
                                           geolocation_zip_code_prefix,
                                           geolocation_lat,
                                           geolocation_lng) AS prev_state,
       LAG(geolocation_city)   OVER (ORDER BY geolocation_state,
                                           geolocation_city,
                                           geolocation_zip_code_prefix,
                                           geolocation_lat,
                                           geolocation_lng) AS prev_city,
       LAG(geolocation_lat)    OVER (ORDER BY geolocation_state,
                                           geolocation_city,
                                           geolocation_zip_code_prefix,
                                           geolocation_lat,
                                           geolocation_lng) AS prev_lat,
       LAG(geolocation_lng)    OVER (ORDER BY geolocation_state,
                                           geolocation_city,
                                           geolocation_zip_code_prefix,
                                           geolocation_lat,
                                           geolocation_lng) AS prev_lng
FROM olist_geolocation
LIMIT 20;
```

```sql
-- 5) On that ordered list, compute the squared-distance between each point  
--    and its immediate predecessor (skipping the very first one)
WITH ordered AS (
    SELECT geolocation_state,
           geolocation_city,
           geolocation_zip_code_prefix,
           geolocation_lat,
           geolocation_lng,
           LAG(geolocation_state)  OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_state,
           LAG(geolocation_city)   OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_city,
           LAG(geolocation_lat)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lat,
           LAG(geolocation_lng)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lng
    FROM olist_geolocation
)
SELECT *,
       ((geolocation_lat - prev_lat) * (geolocation_lat - prev_lat) +
        (geolocation_lng - prev_lng) * (geolocation_lng - prev_lng)) AS dist_sq
FROM ordered
WHERE prev_lat IS NOT NULL
LIMIT 20;
```

```sql
-- 6) Show the 20 largest successive jumps (by squared-distance)  
WITH ordered AS (
    SELECT geolocation_state,
           geolocation_city,
           geolocation_zip_code_prefix,
           geolocation_lat,
           geolocation_lng,
           LAG(geolocation_state)  OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_state,
           LAG(geolocation_city)   OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_city,
           LAG(geolocation_zip_code_prefix) OVER (ORDER BY geolocation_state,
                                                         geolocation_city,
                                                         geolocation_zip_code_prefix,
                                                         geolocation_lat,
                                                         geolocation_lng) AS prev_zip,
           LAG(geolocation_lat)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lat,
           LAG(geolocation_lng)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lng
    FROM olist_geolocation
),
distances AS (
    SELECT *,
           ((geolocation_lat - prev_lat) * (geolocation_lat - prev_lat) +
            (geolocation_lng - prev_lng) * (geolocation_lng - prev_lng)
           ) AS dist_sq
    FROM ordered
    WHERE prev_lat IS NOT NULL
)
SELECT prev_state,
       prev_city,
       prev_zip         AS prev_zip_code_prefix,
       ROUND(prev_lat,6) AS prev_lat,
       ROUND(prev_lng,6) AS prev_lng,
       geolocation_state AS curr_state,
       geolocation_city  AS curr_city,
       geolocation_zip_code_prefix AS curr_zip_code_prefix,
       ROUND(geolocation_lat,6) AS curr_lat,
       ROUND(geolocation_lng,6) AS curr_lng,
       dist_sq
FROM distances
ORDER BY dist_sq DESC
LIMIT 20;
```

```sql
-- 7) FINAL ANSWER – the single pair of consecutive cities that are farthest apart  
WITH ordered AS (
    SELECT geolocation_state,
           geolocation_city,
           geolocation_zip_code_prefix,
           geolocation_lat,
           geolocation_lng,
           LAG(geolocation_state)  OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_state,
           LAG(geolocation_city)   OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_city,
           LAG(geolocation_zip_code_prefix) OVER (ORDER BY geolocation_state,
                                                         geolocation_city,
                                                         geolocation_zip_code_prefix,
                                                         geolocation_lat,
                                                         geolocation_lng) AS prev_zip,
           LAG(geolocation_lat)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lat,
           LAG(geolocation_lng)    OVER (ORDER BY geolocation_state,
                                               geolocation_city,
                                               geolocation_zip_code_prefix,
                                               geolocation_lat,
                                               geolocation_lng) AS prev_lng
    FROM olist_geolocation
),
distances AS (
    SELECT *,
           ((geolocation_lat - prev_lat) * (geolocation_lat - prev_lat) +
            (geolocation_lng - prev_lng) * (geolocation_lng - prev_lng)
           ) AS dist_sq
    FROM ordered
    WHERE prev_lat IS NOT NULL
)
SELECT prev_state,
       prev_city,
       prev_zip      AS prev_zip_code_prefix,
       ROUND(prev_lat,6) AS prev_lat,
       ROUND(prev_lng,6) AS prev_lng,
       geolocation_state AS curr_state,
       geolocation_city  AS curr_city,
       geolocation_zip_code_prefix AS curr_zip_code_prefix,
       ROUND(geolocation_lat,6) AS curr_lat,
       ROUND(geolocation_lng,6) AS curr_lng,
       dist_sq            AS max_distance_squared_between_successive_rows
FROM distances
ORDER BY dist_sq DESC
LIMIT 1;
```

The last query returns the two consecutive cities (along with their zip-code prefixes and coordinates) that are the farthest apart when the entire `olist_geolocation` table is ordered by  
`geolocation_state, geolocation_city, geolocation_zip_code_prefix, geolocation_lat, geolocation_lng`.
