Query:
-- Description: 6)  Compute the distance between each row and its previous row
-- (within the entire ordered set) for one single state to make sure the formula works.
SELECT  "geolocation_state",
        "geolocation_city",
        LAG("geolocation_city") OVER w AS "prev_city",
        "geolocation_lat",
        LAG("geolocation_lat")  OVER w AS "prev_lat",
        "geolocation_lng",
        LAG("geolocation_lng")  OVER w AS "prev_lng",
        -- simple Euclidean distance on the sphere coordinates
        SQRT(  ( "geolocation_lat" - LAG("geolocation_lat") OVER w ) * 
               ( "geolocation_lat" - LAG("geolocation_lat") OVER w ) +
               ( "geolocation_lng" - LAG("geolocation_lng") OVER w ) *
               ( "geolocation_lng" - LAG("geolocation_lng") OVER w ) )    AS "distance_diff"
FROM    "olist_geolocation"
WHERE   "geolocation_state" = 'RJ'
WINDOW  w AS (ORDER BY 
                 "geolocation_state",
                 "geolocation_city",
                 "geolocation_zip_code_prefix",
                 "geolocation_lat",
                 "geolocation_lng")
LIMIT 20;
