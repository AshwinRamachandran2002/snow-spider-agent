```sql
-- Description / Thinking process:
-- We need the pair of CONSECUTIVE rows (after sorting by state ▸ city ▸ zip ▸ lat ▸ lng)
-- whose cities are different and whose geometric gap (straight-line distance
-- between their lat/lng values) is the largest.
-- 1.  In the inner query we keep the table in the requested order (window alias w).
-- 2.  LAG() fetches the previous row’s state, city, latitude and longitude.
-- 3.  A simple Euclidean distance (in degree space) is computed as distance_diff.
-- 4.  The outer query filters to rows where the city changed; then we sort by the
--     distance in descending order and keep only the biggest gap (LIMIT 1).
SELECT
        prev_state  AS state_prev,
        prev_city   AS city_prev,
        curr_state  AS state_curr,
        curr_city   AS city_curr,
        distance_diff
FROM (
        SELECT
                geolocation_state                                    AS curr_state,
                geolocation_city                                     AS curr_city,
                LAG(geolocation_state) OVER w                        AS prev_state,
                LAG(geolocation_city)  OVER w                        AS prev_city,
                -- Distance in raw latitude/longitude degrees
                SQRT( (geolocation_lat - LAG(geolocation_lat) OVER w) *
                      (geolocation_lat - LAG(geolocation_lat) OVER w) +
                      (geolocation_lng - LAG(geolocation_lng) OVER w) *
                      (geolocation_lng - LAG(geolocation_lng) OVER w) ) AS distance_diff
        FROM   olist_geolocation
        WINDOW w AS (ORDER BY
                       geolocation_state,
                       geolocation_city,
                       geolocation_zip_code_prefix,
                       geolocation_lat,
                       geolocation_lng)
) AS ranked
WHERE  curr_city <> prev_city                -- ensure we jumped to another city
ORDER BY distance_diff DESC
LIMIT 1;                                     -- largest jump → required two cities
```
