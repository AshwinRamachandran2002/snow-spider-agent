Query:
--Description: 9)  Produce a compact list of rows where the city changes, together
--               with the distance between the current and previous coordinates.
--               The window logic lives in a sub-query so we can filter on it.
SELECT
       row_no,
       state_now,
       city_now,
       state_prev,
       city_prev,
       distance_diff
FROM (
        SELECT
               ROW_NUMBER() OVER w                        AS row_no,
               geolocation_state                          AS state_now,
               geolocation_city                           AS city_now,
               LAG(geolocation_state) OVER w              AS state_prev,
               LAG(geolocation_city)  OVER w              AS city_prev,
               SQRT( (geolocation_lat - LAG(geolocation_lat) OVER w) *
                     (geolocation_lat - LAG(geolocation_lat) OVER w) +
                     (geolocation_lng - LAG(geolocation_lng) OVER w) *
                     (geolocation_lng - LAG(geolocation_lng) OVER w) )  AS distance_diff
        FROM   olist_geolocation
        WINDOW w AS (ORDER BY
                       geolocation_state,
                       geolocation_city,
                       geolocation_zip_code_prefix,
                       geolocation_lat,
                       geolocation_lng)
) AS s
WHERE  city_now <> city_prev
LIMIT 20
Answer:
row_no,state_now,city_now,state_prev,city_prev,distance_diff
