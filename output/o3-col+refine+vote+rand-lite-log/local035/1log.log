Query:
--Description: For every row, turn those latitude / longitude deltas into an (approximate) straight-line distance in kilometres
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       "prev_lat",
       "prev_lng",
       111.32 * SQRT(POWER("geolocation_lat" - "prev_lat", 2) +
                     POWER(("geolocation_lng" - "prev_lng") * COS(RADIANS(("geolocation_lat" + "prev_lat") / 2.0)), 2)) AS "euclidian_km"
FROM (
        SELECT "geolocation_state",
               "geolocation_city",
               "geolocation_lat",
               "geolocation_lng",
               LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                   "geolocation_city",
                                                   "geolocation_zip_code_prefix",
                                                   "geolocation_lat",
                                                   "geolocation_lng") AS "prev_lat",
               LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                   "geolocation_city",
                                                   "geolocation_zip_code_prefix",
                                                   "geolocation_lat",
                                                   "geolocation_lng") AS "prev_lng"
        FROM   "olist_geolocation"
     )
WHERE  "prev_lat" IS NOT NULL
LIMIT 20;
