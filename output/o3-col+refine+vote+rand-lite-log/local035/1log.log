Query:
--Description: Identify the single pair of consecutive rows (city A → city B) with the largest distance
SELECT "prev_city"  AS "city_a",
       "geolocation_city" AS "city_b",
       "prev_state" AS "state_a",
       "geolocation_state" AS "state_b",
       MAX("euclidian_km") AS "max_distance_km"
FROM (
        SELECT LAG("geolocation_city")  OVER(ORDER BY "geolocation_state",
                                                     "geolocation_city",
                                                     "geolocation_zip_code_prefix",
                                                     "geolocation_lat",
                                                     "geolocation_lng") AS "prev_city",
               LAG("geolocation_state") OVER(ORDER BY "geolocation_state",
                                                     "geolocation_city",
                                                     "geolocation_zip_code_prefix",
                                                     "geolocation_lat",
                                                     "geolocation_lng") AS "prev_state",
               "geolocation_city",
               "geolocation_state",
               111.32 * SQRT(POWER("geolocation_lat" - LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                              "geolocation_city",
                                                                                              "geolocation_zip_code_prefix",
                                                                                              "geolocation_lat",
                                                                                              "geolocation_lng"), 2) +
                             POWER(("geolocation_lng" - LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                                                              "geolocation_city",
                                                                                              "geolocation_zip_code_prefix",
                                                                                              "geolocation_lat",
                                                                                              "geolocation_lng")) *
                                  COS(RADIANS(("geolocation_lat" + LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                         "geolocation_city",
                                                                                                         "geolocation_zip_code_prefix",
                                                                                                         "geolocation_lat",
                                                                                                         "geolocation_lng")) / 2.0)), 2)) AS "euclidian_km"
        FROM   "olist_geolocation"
     )
GROUP BY "city_a", "city_b", "state_a", "state_b"
ORDER BY "max_distance_km" DESC
LIMIT 1;
Answer:
city_a,city_b,state_a,state_b,max_distance_km
