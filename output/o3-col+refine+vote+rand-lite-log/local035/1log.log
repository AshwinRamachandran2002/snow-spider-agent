Query:
--Description: Show the full detail for that largest-distance pair, including the two original rows
SELECT *
FROM (
        SELECT ROW_NUMBER() OVER() AS "rownum",
               "geolocation_state",
               "geolocation_city",
               "geolocation_zip_code_prefix",
               "geolocation_lat",
               "geolocation_lng"
        FROM "olist_geolocation"
        ORDER BY "geolocation_state",
                 "geolocation_city",
                 "geolocation_zip_code_prefix",
                 "geolocation_lat",
                 "geolocation_lng"
     ) AS ordered
WHERE "rownum" = (SELECT MAX("rownum") - 1
                  FROM (
                         SELECT ROW_NUMBER() OVER() AS "rownum",
                                111.32 * SQRT(POWER("geolocation_lat" - LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng"), 2) +
                                              POWER(("geolocation_lng" - LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng")) *
                                                   COS(RADIANS(("geolocation_lat" + LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                                                  "geolocation_city",
                                                                                                                                  "geolocation_zip_code_prefix",
                                                                                                                                  "geolocation_lat",
                                                                                                                                  "geolocation_lng")) / 2.0)), 2)) AS "euclidian_km"
                         FROM "olist_geolocation"
                       )
                  ORDER BY "euclidian_km" DESC
                  LIMIT 1)
   OR "rownum" = (SELECT MAX("rownum")
                  FROM (
                         SELECT ROW_NUMBER() OVER() AS "rownum",
                                111.32 * SQRT(POWER("geolocation_lat" - LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng"), 2) +
                                              POWER(("geolocation_lng" - LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng")) *
                                                   COS(RADIANS(("geolocation_lat" + LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                                                  "geolocation_city",
                                                                                                                                  "geolocation_zip_code_prefix",
                                                                                                                                  "geolocation_lat",
                                                                                                                                  "geolocation_lng")) / 2.0)), 2)) AS "euclidian_km"
                         FROM "olist_geolocation"
                       )
                  ORDER BY "euclidian_km" DESC
                  LIMIT 1)
LIMIT 20;
