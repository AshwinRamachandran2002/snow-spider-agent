         "geolocation_city"
LIMIT 20;
```

```sql
--Description: Display 20 rows already ordered by the sequence requested in the task, so we can visually check the ordering columns
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_zip_code_prefix",
       "geolocation_lat",
       "geolocation_lng"
FROM   "olist_geolocation"
ORDER  BY "geolocation_state",
          "geolocation_city",
          "geolocation_zip_code_prefix",
          "geolocation_lat",
          "geolocation_lng"
LIMIT 20;
```

```sql
--Description: Pick one specific state (e.g., 'SP') to see the latitude / longitude spread among its cities
SELECT DISTINCT "geolocation_city",
                "geolocation_lat",
                "geolocation_lng"
FROM   "olist_geolocation"
WHERE  "geolocation_state" = 'SP'
ORDER  BY "geolocation_city"
LIMIT 20;
```

```sql
--Description: Compute the difference in latitude and longitude between each row and its immediate predecessor in the full ordering
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                           "geolocation_city",
                                           "geolocation_zip_code_prefix",
                                           "geolocation_lat",
                                           "geolocation_lng") AS "prev_lat",
       LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                           "geolocation_city",
                                           "geolocation_zip_code_prefix",
                                           "geolocation_lat",
                                           "geolocation_lng") AS "prev_lng"
FROM   "olist_geolocation"
ORDER  BY "geolocation_state",
          "geolocation_city",
          "geolocation_zip_code_prefix",
          "geolocation_lat",
          "geolocation_lng"
LIMIT 20;
```

```sql
--Description: For every row, turn those latitude / longitude deltas into an (approximate) straight-line distance in kilometres
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       "prev_lat",
       "prev_lng",
       111.32 * SQRT(POWER("geolocation_lat" - "prev_lat", 2) +
                     POWER(("geolocation_lng" - "prev_lng") * COS(RADIANS(("geolocation_lat" + "prev_lat") / 2.0)), 2)) AS "euclidian_km"
FROM (
        SELECT "geolocation_state",
               "geolocation_city",
               "geolocation_lat",
               "geolocation_lng",
               LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                   "geolocation_city",
                                                   "geolocation_zip_code_prefix",
                                                   "geolocation_lat",
                                                   "geolocation_lng") AS "prev_lat",
               LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                   "geolocation_city",
                                                   "geolocation_zip_code_prefix",
                                                   "geolocation_lat",
                                                   "geolocation_lng") AS "prev_lng"
        FROM   "olist_geolocation"
     )
WHERE  "prev_lat" IS NOT NULL
LIMIT 20;
```

```sql
--Description: Rank all consecutive pairs by the computed distance, showing the 20 widest jumps
SELECT *
FROM (
        SELECT "geolocation_state",
               "geolocation_city",
               "prev_lat",
               "prev_lng",
               "geolocation_lat",
               "geolocation_lng",
               111.32 * SQRT(POWER("geolocation_lat" - "prev_lat", 2) +
                             POWER(("geolocation_lng" - "prev_lng") * COS(RADIANS(("geolocation_lat" + "prev_lat") / 2.0)), 2)) AS "euclidian_km"
        FROM (
               SELECT "geolocation_state",
                      "geolocation_city",
                      "geolocation_lat",
                      "geolocation_lng",
                      LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                          "geolocation_city",
                                                          "geolocation_zip_code_prefix",
                                                          "geolocation_lat",
                                                          "geolocation_lng") AS "prev_lat",
                      LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                          "geolocation_city",
                                                          "geolocation_zip_code_prefix",
                                                          "geolocation_lat",
                                                          "geolocation_lng") AS "prev_lng"
               FROM   "olist_geolocation"
             )
        WHERE  "prev_lat" IS NOT NULL
     )
ORDER BY "euclidian_km" DESC
LIMIT 20;
```

```sql
--Description: Identify the single pair of consecutive rows (city A → city B) with the largest distance
SELECT "prev_city"  AS "city_a",
       "geolocation_city" AS "city_b",
       "prev_state" AS "state_a",
       "geolocation_state" AS "state_b",
       MAX("euclidian_km") AS "max_distance_km"
FROM (
        SELECT LAG("geolocation_city")  OVER(ORDER BY "geolocation_state",
                                                     "geolocation_city",
                                                     "geolocation_zip_code_prefix",
                                                     "geolocation_lat",
                                                     "geolocation_lng") AS "prev_city",
               LAG("geolocation_state") OVER(ORDER BY "geolocation_state",
                                                     "geolocation_city",
                                                     "geolocation_zip_code_prefix",
                                                     "geolocation_lat",
                                                     "geolocation_lng") AS "prev_state",
               "geolocation_city",
               "geolocation_state",
               111.32 * SQRT(POWER("geolocation_lat" - LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                              "geolocation_city",
                                                                                              "geolocation_zip_code_prefix",
                                                                                              "geolocation_lat",
                                                                                              "geolocation_lng"), 2) +
                             POWER(("geolocation_lng" - LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                                                              "geolocation_city",
                                                                                              "geolocation_zip_code_prefix",
                                                                                              "geolocation_lat",
                                                                                              "geolocation_lng")) *
                                  COS(RADIANS(("geolocation_lat" + LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                         "geolocation_city",
                                                                                                         "geolocation_zip_code_prefix",
                                                                                                         "geolocation_lat",
                                                                                                         "geolocation_lng")) / 2.0)), 2)) AS "euclidian_km"
        FROM   "olist_geolocation"
     )
GROUP BY "city_a", "city_b", "state_a", "state_b"
ORDER BY "max_distance_km" DESC
LIMIT 1;
```

```sql
--Description: Show the full detail for that largest-distance pair, including the two original rows
SELECT *
FROM (
        SELECT ROW_NUMBER() OVER() AS "rownum",
               "geolocation_state",
               "geolocation_city",
               "geolocation_zip_code_prefix",
               "geolocation_lat",
               "geolocation_lng"
        FROM "olist_geolocation"
        ORDER BY "geolocation_state",
                 "geolocation_city",
                 "geolocation_zip_code_prefix",
                 "geolocation_lat",
                 "geolocation_lng"
     ) AS ordered
WHERE "rownum" = (SELECT MAX("rownum") - 1
                  FROM (
                         SELECT ROW_NUMBER() OVER() AS "rownum",
                                111.32 * SQRT(POWER("geolocation_lat" - LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng"), 2) +
                                              POWER(("geolocation_lng" - LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng")) *
                                                   COS(RADIANS(("geolocation_lat" + LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                                                  "geolocation_city",
                                                                                                                                  "geolocation_zip_code_prefix",
                                                                                                                                  "geolocation_lat",
                                                                                                                                  "geolocation_lng")) / 2.0)), 2)) AS "euclidian_km"
                         FROM "olist_geolocation"
                       )
                  ORDER BY "euclidian_km" DESC
                  LIMIT 1)
   OR "rownum" = (SELECT MAX("rownum")
                  FROM (
                         SELECT ROW_NUMBER() OVER() AS "rownum",
                                111.32 * SQRT(POWER("geolocation_lat" - LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng"), 2) +
                                              POWER(("geolocation_lng" - LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                                                                                               "geolocation_city",
                                                                                                               "geolocation_zip_code_prefix",
                                                                                                               "geolocation_lat",
                                                                                                               "geolocation_lng")) *
                                                   COS(RADIANS(("geolocation_lat" + LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                                                                                                                  "geolocation_city",
                                                                                                                                  "geolocation_zip_code_prefix",
                                                                                                                                  "geolocation_lat",
                                                                                                                                  "geolocation_lng")) / 2.0)), 2)) AS "euclidian_km"
                         FROM "olist_geolocation"
                       )
                  ORDER BY "euclidian_km" DESC
                  LIMIT 1)
LIMIT 20;
```

```sql
--Description: (Optional) Verify that the previous query’s two rows are consecutive by showing their row numbers and distance
SELECT prev."rownum" AS "row_a",
       nxt."rownum"  AS "row_b",
       111.32 * SQRT(POWER(nxt."geolocation_lat" - prev."geolocation_lat", 2) +
                     POWER((nxt."geolocation_lng" - prev."geolocation_lng") *
                          COS(RADIANS((nxt."geolocation_lat" + prev."geolocation_lat") / 2.0)), 2)) AS "distance_km"
FROM (
        SELECT ROW_NUMBER() OVER(ORDER BY "geolocation_state",
                                          "geolocation_city",
                                          "geolocation_zip_code_prefix",
                                          "geolocation_lat",
                                          "geolocation_lng") AS "rownum",
               "geolocation_lat",
               "geolocation_lng"
        FROM "olist_geolocation"
     ) AS prev
JOIN (
        SELECT ROW_NUMBER() OVER(ORDER BY "geolocation_state",
                                          "geolocation_city",
                                          "geolocation_zip_code_prefix",
                                          "geolocation_lat",
                                          "geolocation_lng") AS "rownum",
               "geolocation_lat",
               "geolocation_lng"
        FROM "olist_geolocation"
     ) AS nxt
  ON nxt."rownum" = prev."rownum" + 1
ORDER BY "distance_km" DESC
LIMIT 20;
```

