--Description: Compute the difference in latitude and longitude between each row and its immediate predecessor in the full ordering
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_lat") OVER(ORDER BY "geolocation_state",
                                           "geolocation_city",
                                           "geolocation_zip_code_prefix",
                                           "geolocation_lat",
                                           "geolocation_lng") AS "prev_lat",
       LAG("geolocation_lng") OVER(ORDER BY "geolocation_state",
                                           "geolocation_city",
                                           "geolocation_zip_code_prefix",
                                           "geolocation_lat",
                                           "geolocation_lng") AS "prev_lng"
FROM   "olist_geolocation"
ORDER  BY "geolocation_state",
          "geolocation_city",
          "geolocation_zip_code_prefix",
          "geolocation_lat",
          "geolocation_lng"
LIMIT 20;
