-- 10) (Optional diagnostic) Display the 20 largest gaps together 
--     with both cities and their lat/long for manual inspection
WITH ordered AS (
     SELECT
            "geolocation_state",
            "geolocation_city",
            "geolocation_lat",
            "geolocation_lng",
            LAG("geolocation_state") OVER w AS "prev_state",
            LAG("geolocation_city")  OVER w AS "prev_city",
            LAG("geolocation_lat")   OVER w AS "prev_lat",
            LAG("geolocation_lng")   OVER w AS "prev_lng"
     FROM   "olist_geolocation"
     WINDOW w AS (ORDER BY "geolocation_state",
                            "geolocation_city",
                            "geolocation_zip_code_prefix",
                            "geolocation_lat",
                            "geolocation_lng")
)
SELECT DISTINCT
       "prev_state"   AS "prev_state",
       "prev_city"    AS "prev_city",
       "prev_lat"     AS "prev_lat",
       "prev_lng"     AS "prev_lng",
       "geolocation_state" AS "curr_state",
       "geolocation_city"  AS "curr_city",
       "geolocation_lat"   AS "curr_lat",
       "geolocation_lng"   AS "curr_lng",
       (( "geolocation_lat" - "prev_lat") *
        ( "geolocation_lat" - "prev_lat") +
        ( "geolocation_lng" - "prev_lng") *
        ( "geolocation_lng" - "prev_lng") ) AS "dist2"
FROM   ordered
WHERE  "prev_lat" IS NOT NULL
ORDER  BY "dist2" DESC
LIMIT 20;
