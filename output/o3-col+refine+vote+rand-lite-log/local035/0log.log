FROM   "olist_geolocation"
ORDER  BY "geolocation_state",
         "geolocation_city",
         "geolocation_zip_code_prefix",
         "geolocation_lat",
         "geolocation_lng"
LIMIT 20;
```

```sql
-- 5) Retrieve a row together with its immediate predecessor
SELECT DISTINCT
       "geolocation_state",
       "geolocation_city",
       "geolocation_zip_code_prefix",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_state") OVER (ORDER BY "geolocation_state",
                                                "geolocation_city",
                                                "geolocation_zip_code_prefix",
                                                "geolocation_lat",
                                                "geolocation_lng") AS "prev_state",
       LAG("geolocation_city")  OVER (ORDER BY "geolocation_state",
                                                "geolocation_city",
                                                "geolocation_zip_code_prefix",
                                                "geolocation_lat",
                                                "geolocation_lng") AS "prev_city"
FROM   "olist_geolocation"
ORDER  BY "geolocation_state",
          "geolocation_city",
          "geolocation_zip_code_prefix",
          "geolocation_lat",
          "geolocation_lng"
LIMIT 20;
```

```sql
-- 6) Add predecessor’s latitude & longitude so we can compute distance later
SELECT DISTINCT
       "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_lat") OVER (ORDER BY "geolocation_state",
                                             "geolocation_city",
                                             "geolocation_zip_code_prefix",
                                             "geolocation_lat",
                                             "geolocation_lng") AS "prev_lat",
       LAG("geolocation_lng") OVER (ORDER BY "geolocation_state",
                                             "geolocation_city",
                                             "geolocation_zip_code_prefix",
                                             "geolocation_lat",
                                             "geolocation_lng") AS "prev_lng"
FROM   "olist_geolocation"
ORDER  BY "geolocation_state",
          "geolocation_city",
          "geolocation_zip_code_prefix",
          "geolocation_lat",
          "geolocation_lng"
LIMIT 20;
```

```sql
-- 7) Compute a simple Euclidean distance-squared between each row and its predecessor
SELECT DISTINCT
       "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_state") OVER w AS "prev_state",
       LAG("geolocation_city")  OVER w AS "prev_city",
       LAG("geolocation_lat")   OVER w AS "prev_lat",
       LAG("geolocation_lng")   OVER w AS "prev_lng",
       (( "geolocation_lat" - LAG("geolocation_lat") OVER w ) *
        ( "geolocation_lat" - LAG("geolocation_lat") OVER w ) +
        ( "geolocation_lng" - LAG("geolocation_lng") OVER w ) *
        ( "geolocation_lng" - LAG("geolocation_lng") OVER w ))         AS "dist2"
FROM   "olist_geolocation"
WINDOW w AS (ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng")
ORDER  BY "geolocation_state",
          "geolocation_city"
LIMIT 20;
```

```sql
-- 8) Look at the largest 20 distance-squared gaps
WITH ordered AS (
     SELECT
            "geolocation_state",
            "geolocation_city",
            LAG("geolocation_state") OVER w AS "prev_state",
            LAG("geolocation_city")  OVER w AS "prev_city",
            "geolocation_lat"                            AS "lat",
            "geolocation_lng"                            AS "lng",
            LAG("geolocation_lat") OVER w               AS "prev_lat",
            LAG("geolocation_lng") OVER w               AS "prev_lng"
     FROM   "olist_geolocation"
     WINDOW w AS (ORDER BY "geolocation_state",
                            "geolocation_city",
                            "geolocation_zip_code_prefix",
                            "geolocation_lat",
                            "geolocation_lng")
)
SELECT DISTINCT
       "prev_state",
       "prev_city",
       "geolocation_state",
       "geolocation_city",
       (( lat - prev_lat)*(lat - prev_lat) +
        ( lng - prev_lng)*(lng - prev_lng) )            AS "dist2"
FROM   ordered
WHERE  prev_lat IS NOT NULL
ORDER  BY "dist2" DESC
LIMIT 20;
```

```sql
-- 9) Same query but return only the single largest gap (= the answer)
WITH ordered AS (
     SELECT
            "geolocation_state",
            "geolocation_city",
            LAG("geolocation_state") OVER w AS "prev_state",
            LAG("geolocation_city")  OVER w AS "prev_city",
            "geolocation_lat"                            AS "lat",
            "geolocation_lng"                            AS "lng",
            LAG("geolocation_lat") OVER w               AS "prev_lat",
            LAG("geolocation_lng") OVER w               AS "prev_lng"
     FROM   "olist_geolocation"
     WINDOW w AS (ORDER BY "geolocation_state",
                            "geolocation_city",
                            "geolocation_zip_code_prefix",
                            "geolocation_lat",
                            "geolocation_lng")
)
SELECT DISTINCT
       "prev_state" || ' - ' || "prev_city"        AS "previous_city",
       "geolocation_state" || ' - ' || "geolocation_city" AS "current_city",
       (( lat - prev_lat)*(lat - prev_lat) +
        ( lng - prev_lng)*(lng - prev_lng) )       AS "distance_squared"
FROM   ordered
WHERE  prev_lat IS NOT NULL
ORDER  BY "distance_squared" DESC
LIMIT 1;
```

```sql
-- 10) (Optional diagnostic) Display the 20 largest gaps together 
--     with both cities and their lat/long for manual inspection
WITH ordered AS (
     SELECT
            "geolocation_state",
            "geolocation_city",
            "geolocation_lat",
            "geolocation_lng",
            LAG("geolocation_state") OVER w AS "prev_state",
            LAG("geolocation_city")  OVER w AS "prev_city",
            LAG("geolocation_lat")   OVER w AS "prev_lat",
            LAG("geolocation_lng")   OVER w AS "prev_lng"
     FROM   "olist_geolocation"
     WINDOW w AS (ORDER BY "geolocation_state",
                            "geolocation_city",
                            "geolocation_zip_code_prefix",
                            "geolocation_lat",
                            "geolocation_lng")
)
SELECT DISTINCT
       "prev_state"   AS "prev_state",
       "prev_city"    AS "prev_city",
       "prev_lat"     AS "prev_lat",
       "prev_lng"     AS "prev_lng",
       "geolocation_state" AS "curr_state",
       "geolocation_city"  AS "curr_city",
       "geolocation_lat"   AS "curr_lat",
       "geolocation_lng"   AS "curr_lng",
       (( "geolocation_lat" - "prev_lat") *
        ( "geolocation_lat" - "prev_lat") +
        ( "geolocation_lng" - "prev_lng") *
        ( "geolocation_lng" - "prev_lng") ) AS "dist2"
FROM   ordered
WHERE  "prev_lat" IS NOT NULL
ORDER  BY "dist2" DESC
LIMIT 20;
```

The 9th query returns the two consecutive (state, city) pairs that are farthest apart under the prescribed ordering.
