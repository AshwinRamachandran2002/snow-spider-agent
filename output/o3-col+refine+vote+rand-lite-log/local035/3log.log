```sql
-- Description: Find the two consecutive rows (ordered by state → city → ZIP prefix →
--              latitude → longitude) that are the farthest apart.  Comments outline
--              the thinking steps:
--              1. sorted_cte   : impose the requested ordering and give each row an
--                                index (rn).
--              2. lag_cte      : bring in predecessor’s latitude / longitude and city
--                                identifiers with LAG.
--              3. dist_cte     : calculate squared-Euclidean distance between each row
--                                and its predecessor; ignore the very first row which
--                                has no predecessor.
--              4. max_gap_cte  : retain only the row with the largest distance.
--              5. Final SELECT : output BOTH rows (current + previous) of that pair so
--                                we can clearly see the two cities involved.
WITH sorted_cte AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng"
        ) AS rn,
        "geolocation_state",
        "geolocation_city",
        "geolocation_zip_code_prefix",
        "geolocation_lat",
        "geolocation_lng"
    FROM "olist_geolocation"
),
lag_cte AS (
    SELECT
        rn,
        "geolocation_state"               AS state_curr,
        "geolocation_city"                AS city_curr,
        "geolocation_zip_code_prefix"     AS zip_curr,
        "geolocation_lat"                 AS lat_curr,
        "geolocation_lng"                 AS lng_curr,
        LAG("geolocation_state")           OVER (ORDER BY rn) AS state_prev,
        LAG("geolocation_city")            OVER (ORDER BY rn) AS city_prev,
        LAG("geolocation_zip_code_prefix") OVER (ORDER BY rn) AS zip_prev,
        LAG("geolocation_lat")             OVER (ORDER BY rn) AS lat_prev,
        LAG("geolocation_lng")             OVER (ORDER BY rn) AS lng_prev
    FROM sorted_cte
),
dist_cte AS (
    SELECT
        *,
        ( (lat_curr - lat_prev)*(lat_curr - lat_prev) +
          (lng_curr - lng_prev)*(lng_curr - lng_prev) ) AS squared_distance
    FROM lag_cte
    WHERE lat_prev IS NOT NULL      -- exclude the very first ordered row
),
max_gap_cte AS (
    SELECT *
    FROM dist_cte
    ORDER BY squared_distance DESC
    LIMIT 1
)
SELECT
    'Current Row' AS which,
    state_curr    AS geolocation_state,
    city_curr     AS geolocation_city,
    zip_curr      AS geolocation_zip_code_prefix,
    lat_curr      AS geolocation_lat,
    lng_curr      AS geolocation_lng,
    squared_distance
FROM max_gap_cte
UNION ALL
SELECT
    'Previous Row',
    state_prev,
    city_prev,
    zip_prev,
    lat_prev,
    lng_prev,
    squared_distance
FROM max_gap_cte;
```
