Query:
--Description: 8)  Retrieve BOTH rows (current + previous) that form the largest gap,
--               using ROW_NUMBER for stable indexing and joining on rn-1.
WITH ordered AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng"
        ) AS rn,
        "geolocation_state"            AS st,
        "geolocation_city"             AS city,
        "geolocation_zip_code_prefix"  AS zip,
        "geolocation_lat"              AS lat,
        "geolocation_lng"              AS lng
    FROM "olist_geolocation"
),
dist AS (
    SELECT
        o1.rn,
        o1.st,   o1.city,   o1.zip,   o1.lat,   o1.lng,
        o2.st AS prev_st, o2.city AS prev_city, o2.zip AS prev_zip,
        o2.lat AS prev_lat, o2.lng AS prev_lng,
        ( (o1.lat - o2.lat)*(o1.lat - o2.lat) +
          (o1.lng - o2.lng)*(o1.lng - o2.lng) ) AS squared_distance
    FROM ordered o1
    JOIN ordered o2 ON o2.rn = o1.rn - 1
),
max_pair AS (
    SELECT *
    FROM dist
    ORDER BY squared_distance DESC
    LIMIT 1
)
SELECT *
FROM max_pair
