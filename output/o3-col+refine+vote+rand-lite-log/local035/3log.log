Query:
--Description: 9)  Display only the (state, city, ZIP, lat, lng) for BOTH rows that make
--               up the largest gap, returned as two separate result rows.
WITH ordered AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng"
        ) AS rn,
        "geolocation_state"  AS st,
        "geolocation_city"   AS city,
        "geolocation_zip_code_prefix" AS zip,
        "geolocation_lat"    AS lat,
        "geolocation_lng"    AS lng
    FROM "olist_geolocation"
),
max_rn AS (
    SELECT o1.rn AS rn
    FROM ordered o1
    JOIN ordered o2 ON o2.rn = o1.rn - 1
    ORDER BY ( (o1.lat - o2.lat)*(o1.lat - o2.lat) +
               (o1.lng - o2.lng)*(o1.lng - o2.lng) ) DESC
    LIMIT 1
)
SELECT st, city, zip, lat, lng
FROM ordered
WHERE rn IN (SELECT rn FROM max_rn
             UNION ALL
             SELECT rn - 1 FROM max_rn)
