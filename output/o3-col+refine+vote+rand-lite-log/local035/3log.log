Query:
--Description:  Return how many geolocation rows each of the two cities has that form
--              the single largest distance gap between consecutive records (ordered by
--              state → city → ZIP prefix → latitude → longitude).
WITH ordered AS (                              -- 1) impose ordering & give row index
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng"
        ) AS rn,
        "geolocation_state" AS st,
        "geolocation_city"  AS city,
        "geolocation_lat"   AS lat,
        "geolocation_lng"   AS lng
    FROM "olist_geolocation"
),
dist AS (                                     -- 2) bring predecessor & compute distance
    SELECT
        o.*,
        LAG(rn)  OVER (ORDER BY rn) AS prev_rn,
        LAG(lat) OVER (ORDER BY rn) AS prev_lat,
        LAG(lng) OVER (ORDER BY rn) AS prev_lng,
        ( (lat - LAG(lat) OVER (ORDER BY rn))*(lat - LAG(lat) OVER (ORDER BY rn)) +
          (lng - LAG(lng) OVER (ORDER BY rn))*(lng - LAG(lng) OVER (ORDER BY rn)) ) AS squared_distance
    FROM ordered o
    WHERE rn > 1                                -- first row has no predecessor
),
max_gap AS (                                   -- 3) isolate row with greatest distance
    SELECT rn, prev_rn
    FROM dist
    ORDER BY squared_distance DESC
    LIMIT 1
),
largest_cities AS (                            -- 4) collect BOTH cities in that gap
    SELECT st, city FROM ordered WHERE rn = (SELECT rn     FROM max_gap)
    UNION ALL
    SELECT st, city FROM ordered WHERE rn = (SELECT prev_rn FROM max_gap)
)
SELECT                                         -- 5) final count per city
    g."geolocation_state",
    g."geolocation_city",
    COUNT(*) AS geolocation_rows
FROM "olist_geolocation" AS g
JOIN largest_cities AS lc
      ON lc.st   = g."geolocation_state"
     AND lc.city = g."geolocation_city"
GROUP BY g."geolocation_state",
         g."geolocation_city"
