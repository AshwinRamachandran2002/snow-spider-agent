Query:
--Description: 7)  Single greatest pair-wise distance (current row plus predecessor) using
--               safe sub-query instead of HAVING.  Computes squared-Euclidean distance
--               between each row and its immediate predecessor in the required sort
--               order, then returns only the largest one.
WITH ordered AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng"
        ) AS rn,
        "geolocation_state",
        "geolocation_city",
        "geolocation_zip_code_prefix",
        "geolocation_lat",
        "geolocation_lng"
    FROM "olist_geolocation"
),
dist AS (
    SELECT
        o.*,
        LAG("geolocation_state")            OVER (ORDER BY rn) AS prev_state,
        LAG("geolocation_city")             OVER (ORDER BY rn) AS prev_city,
        LAG("geolocation_zip_code_prefix")  OVER (ORDER BY rn) AS prev_zip,
        LAG("geolocation_lat")              OVER (ORDER BY rn) AS prev_lat,
        LAG("geolocation_lng")              OVER (ORDER BY rn) AS prev_lng
    FROM ordered o
),
dist_nonnull AS (
    SELECT *,
           ( ( "geolocation_lat" - prev_lat ) * ( "geolocation_lat" - prev_lat ) +
             ( "geolocation_lng" - prev_lng ) * ( "geolocation_lng" - prev_lng ) ) AS squared_distance
    FROM dist
    WHERE prev_lat IS NOT NULL
)
SELECT
    "geolocation_state",
    "geolocation_city",
    "geolocation_zip_code_prefix",
    "geolocation_lat",
    "geolocation_lng",
    prev_state,
    prev_city,
    prev_zip,
    prev_lat,
    prev_lng,
    squared_distance
FROM dist_nonnull
ORDER BY squared_distance DESC
LIMIT 1
Answer:
geolocation_state,geolocation_city,geolocation_zip_code_prefix,geolocation_lat,geolocation_lng,prev_state,prev_city,prev_zip,prev_lat,prev_lng,squared_distance
