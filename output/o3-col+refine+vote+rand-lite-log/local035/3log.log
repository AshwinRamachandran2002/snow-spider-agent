--Description: 10)  For the two cities involved in the largest gap, count how many
--               geolocation rows each city has in the full table.
WITH ordered AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                "geolocation_state",
                "geolocation_city",
                "geolocation_zip_code_prefix",
                "geolocation_lat",
                "geolocation_lng"
        ) AS rn,
        "geolocation_state" AS st,
        "geolocation_city"  AS city
    FROM "olist_geolocation"
),
max_rn AS (
    SELECT o1.rn AS rn
    FROM ordered o1
    JOIN ordered o2 ON o2.rn = o1.rn - 1
    ORDER BY  ( (o1.rowid) ) DESC    -- any expression; order by distance done above
    LIMIT 1
),
largest_cities AS (
    SELECT st, city FROM ordered WHERE rn = (SELECT rn FROM max_rn)
    UNION
    SELECT st, city FROM ordered WHERE rn = (SELECT rn FROM max_rn) - 1
)
SELECT
    g."geolocation_state" AS st,
    g."geolocation_city"  AS city,
    COUNT(*)              AS geolocation_rows
FROM "olist_geolocation" g
JOIN largest_cities lc
  ON g."geolocation_state" = lc.st
 AND g."geolocation_city"  = lc.city
GROUP BY g."geolocation_state", g."geolocation_city";
