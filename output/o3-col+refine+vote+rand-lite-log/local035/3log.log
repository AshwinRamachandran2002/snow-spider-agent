```sql
-- Description: 6)  Compute the Euclidean distance (very small-scale approximation)
--                between each record and its predecessor; show only rows where the
--                predecessor exists (prev_lat IS NOT NULL).
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_zip_code_prefix",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_lat") OVER w AS "prev_lat",
       LAG("geolocation_lng") OVER w AS "prev_lng",
       -- Pythagorean formula on lat/lng degrees
       (( "geolocation_lat" - LAG("geolocation_lat") OVER w ) * 
        ( "geolocation_lat" - LAG("geolocation_lat") OVER w ) +
        ( "geolocation_lng" - LAG("geolocation_lng") OVER w ) * 
        ( "geolocation_lng" - LAG("geolocation_lng") OVER w )
       )  AS "squared_distance"
FROM "olist_geolocation"
WINDOW w AS (ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng")
HAVING "prev_lat" IS NOT NULL
ORDER BY "squared_distance" DESC
LIMIT 20;
```

```sql
-- Description: 7)  Identify the single greatest pairwise (consecutive) distance in the
--                entire table using the same ordering rule.
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_zip_code_prefix",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_state") OVER w  AS "prev_state",
       LAG("geolocation_city")  OVER w  AS "prev_city",
       LAG("geolocation_zip_code_prefix") OVER w AS "prev_zip",
       LAG("geolocation_lat")   OVER w  AS "prev_lat",
       LAG("geolocation_lng")   OVER w  AS "prev_lng",
       (( "geolocation_lat" - LAG("geolocation_lat") OVER w ) *
        ( "geolocation_lat" - LAG("geolocation_lat") OVER w ) +
        ( "geolocation_lng" - LAG("geolocation_lng") OVER w ) *
        ( "geolocation_lng" - LAG("geolocation_lng") OVER w )
       ) AS "squared_distance"
FROM "olist_geolocation"
WINDOW w AS (ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng")
HAVING "prev_lat" IS NOT NULL
ORDER BY "squared_distance" DESC
LIMIT 1;
```

```sql
-- Description: 8)  Fetch the previous row (the first city of the pair) explicitly so
--                we can list both cities together (JOIN on rowid created by CTE).
WITH ordered AS (
    SELECT rowid AS rid,
           "geolocation_state"             AS st,
           "geolocation_city"              AS city,
           "geolocation_zip_code_prefix"   AS zip,
           "geolocation_lat"               AS lat,
           "geolocation_lng"               AS lng
    FROM "olist_geolocation"
    ORDER BY st, city, zip, lat, lng
),
max_pair AS (
    SELECT o1.rid,
           o1.st,  o1.city,  o1.zip,  o1.lat,  o1.lng,
           o2.st AS prev_st, o2.city AS prev_city, o2.zip AS prev_zip,
           o2.lat AS prev_lat, o2.lng AS prev_lng,
           ((o1.lat - o2.lat)*(o1.lat - o2.lat) +
            (o1.lng - o2.lng)*(o1.lng - o2.lng)
           ) AS squared_distance
    FROM ordered o1
    JOIN ordered o2 ON o2.rid = o1.rid - 1      -- immediate predecessor
    ORDER BY squared_distance DESC
    LIMIT 1
)
SELECT *
FROM max_pair
LIMIT 20;
```

```sql
-- Description: 9)  Show both cities (state & city names only) of the largest-gap pair
--                as a neat two-row result.
WITH ordered AS (
    SELECT rowid AS rid,
           "geolocation_state"   AS st,
           "geolocation_city"    AS city,
           "geolocation_zip_code_prefix" AS zip,
           "geolocation_lat"     AS lat,
           "geolocation_lng"     AS lng
    FROM "olist_geolocation"
    ORDER BY st, city, zip, lat, lng
),
largest_rid AS (
    SELECT o1.rid AS rid
    FROM ordered o1
    JOIN ordered o2 ON o2.rid = o1.rid - 1
    ORDER BY ((o1.lat - o2.lat)*(o1.lat - o2.lat) +
              (o1.lng - o2.lng)*(o1.lng - o2.lng)) DESC
    LIMIT 1
)
SELECT st, city, zip, lat, lng
FROM ordered
WHERE rid IN (SELECT rid FROM largest_rid
              UNION ALL
              SELECT rid-1 FROM largest_rid)
LIMIT 20;
```

```sql
-- Description: 10)  Quick verification: count how many geolocation rows the two cities
--                 (identified in query #9) have in the data set.
WITH largest_cities AS (
    -- reuse query #9 to isolate the two cities
    WITH ordered AS (
        SELECT rowid AS rid,
               "geolocation_state"   AS st,
               "geolocation_city"    AS city
        FROM "olist_geolocation"
        ORDER BY st, city,
                 "geolocation_zip_code_prefix",
                 "geolocation_lat",
                 "geolocation_lng"
    ),
    largest_rid AS (
        SELECT o1.rid AS rid
        FROM ordered o1
        JOIN ordered o2 ON o2.rid = o1.rid - 1
        ORDER BY 1 DESC
        LIMIT 1
    )
    SELECT DISTINCT st, city
    FROM ordered
    WHERE rid IN (SELECT rid FROM largest_rid
                  UNION ALL
                  SELECT rid-1 FROM largest_rid)
)
SELECT lc.st,
       lc.city,
       COUNT(*) AS geolocation_rows
FROM "olist_geolocation" AS g
JOIN largest_cities AS lc
  ON lc.st   = g."geolocation_state"
 AND lc.city = g."geolocation_city"
GROUP BY lc.st, lc.city
LIMIT 20;
```
