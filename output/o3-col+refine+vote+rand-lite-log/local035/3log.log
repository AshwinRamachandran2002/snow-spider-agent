        ( (lat - LAG(lat) OVER (ORDER BY rn))*(lat - LAG(lat) OVER (ORDER BY rn)) +
          (lng - LAG(lng) OVER (ORDER BY rn))*(lng - LAG(lng) OVER (ORDER BY rn)) ) AS squared_distance
    FROM ordered o
    WHERE rn > 1                         -- row 1 has no predecessor, exclude early
),
max_gap AS (
    SELECT rn, prev_rn
    FROM dist
    ORDER BY squared_distance DESC
    LIMIT 1
),
cities AS (
    SELECT st, city
    FROM ordered
    WHERE rn = (SELECT rn FROM max_gap)
    UNION ALL
    SELECT st, city
    FROM ordered
    WHERE rn = (SELECT prev_rn FROM max_gap)
)
SELECT
    g."geolocation_state",
    g."geolocation_city",
    COUNT(*) AS geolocation_rows
FROM "olist_geolocation" AS g
JOIN cities              AS c
      ON c.st   = g."geolocation_state"
     AND c.city = g."geolocation_city"
GROUP BY g."geolocation_state",
         g."geolocation_city";
