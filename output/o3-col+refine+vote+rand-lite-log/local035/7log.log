-- Description: Final answer – show both cities, their coordinates, and the distance between them
SELECT  curr."geolocation_state"  AS current_state,
        curr."geolocation_city"   AS current_city,
        curr."geolocation_lat"    AS current_lat,
        curr."geolocation_lng"    AS current_lng,
        prev."geolocation_state"  AS previous_state,
        prev."geolocation_city"   AS previous_city,
        prev."geolocation_lat"    AS previous_lat,
        prev."geolocation_lng"    AS previous_lng,
        SQRT( ( curr."geolocation_lat" - prev."geolocation_lat" ) *
              ( curr."geolocation_lat" - prev."geolocation_lat" ) +
              ( curr."geolocation_lng" - prev."geolocation_lng" ) *
              ( curr."geolocation_lng" - prev."geolocation_lng" ) ) AS max_deg_distance
FROM (
    SELECT  *,
            ROW_NUMBER() OVER (
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
            ) AS rn
    FROM "olist_geolocation"
) AS curr
JOIN (
    SELECT  *,
            ROW_NUMBER() OVER (
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
            ) AS rn
    FROM "olist_geolocation"
) AS prev
ON  curr.rn = prev.rn + 1
WHERE 1 = 1
ORDER BY max_deg_distance DESC
LIMIT 1;
