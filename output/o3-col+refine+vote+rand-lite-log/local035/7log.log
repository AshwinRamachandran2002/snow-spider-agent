       "geolocation_lng"
FROM "olist_geolocation"
LIMIT 20;
```

```sql
-- Description: Use LAG to fetch the previous row’s lat/lng & city, allowing distance calculation
SELECT ROW_NUMBER() OVER (
           ORDER BY "geolocation_state",
                    "geolocation_city",
                    "geolocation_zip_code_prefix",
                    "geolocation_lat",
                    "geolocation_lng"
       ) AS rn,
       "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_city") OVER (
              ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng"
       )  AS prev_city,
       LAG("geolocation_lat") OVER (
              ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng"
       )  AS prev_lat,
       LAG("geolocation_lng") OVER (
              ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng"
       )  AS prev_lng
FROM "olist_geolocation"
LIMIT 20;
```

```sql
-- Description: Compute the Euclidean distance (in degree units) to the previous row
SELECT  "geolocation_state",
        "geolocation_city",
        prev_city,
        -- simple Euclidean distance in degrees
        SQRT( ( "geolocation_lat" - prev_lat ) * ( "geolocation_lat" - prev_lat )
            + ( "geolocation_lng" - prev_lng ) * ( "geolocation_lng" - prev_lng ) ) AS deg_distance
FROM (
    SELECT "geolocation_state",
           "geolocation_city",
           "geolocation_lat",
           "geolocation_lng",
           LAG("geolocation_city") OVER (
                 ORDER BY "geolocation_state",
                          "geolocation_city",
                          "geolocation_zip_code_prefix",
                          "geolocation_lat",
                          "geolocation_lng"
           )  AS prev_city,
           LAG("geolocation_lat") OVER (
                 ORDER BY "geolocation_state",
                          "geolocation_city",
                          "geolocation_zip_code_prefix",
                          "geolocation_lat",
                          "geolocation_lng"
           )  AS prev_lat,
           LAG("geolocation_lng") OVER (
                 ORDER BY "geolocation_state",
                          "geolocation_city",
                          "geolocation_zip_code_prefix",
                          "geolocation_lat",
                          "geolocation_lng"
           )  AS prev_lng
    FROM "olist_geolocation"
) AS t
WHERE prev_lat IS NOT NULL
LIMIT 20;
```

```sql
-- Description: Rank all consecutive-row distances and keep the largest 20
SELECT  "geolocation_state",
        "geolocation_city",
        prev_city,
        deg_distance
FROM (
    SELECT "geolocation_state",
           "geolocation_city",
           prev_city,
           SQRT( ( "geolocation_lat" - prev_lat ) * ( "geolocation_lat" - prev_lat )
               + ( "geolocation_lng" - prev_lng ) * ( "geolocation_lng" - prev_lng ) ) AS deg_distance
    FROM (
        SELECT "geolocation_state",
               "geolocation_city",
               "geolocation_lat",
               "geolocation_lng",
               LAG("geolocation_city") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_city,
               LAG("geolocation_lat") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_lat,
               LAG("geolocation_lng") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_lng
        FROM "olist_geolocation"
    )
    WHERE prev_lat IS NOT NULL
) 
ORDER BY deg_distance DESC
LIMIT 20;
```

```sql
-- Description: Fetch the single pair of consecutive cities with the maximum distance
SELECT  "geolocation_state"          AS current_state,
        "geolocation_city"           AS current_city,
        prev_city                    AS previous_city,
        MAX(deg_distance)            AS max_deg_distance
FROM (
    SELECT "geolocation_state",
           "geolocation_city",
           prev_city,
           SQRT( ( "geolocation_lat" - prev_lat ) * ( "geolocation_lat" - prev_lat )
               + ( "geolocation_lng" - prev_lng ) * ( "geolocation_lng" - prev_lng ) ) AS deg_distance
    FROM (
        SELECT "geolocation_state",
               "geolocation_city",
               "geolocation_lat",
               "geolocation_lng",
               LAG("geolocation_city") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_city,
               LAG("geolocation_lat") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_lat,
               LAG("geolocation_lng") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_lng
        FROM "olist_geolocation"
    )
    WHERE prev_lat IS NOT NULL
)
ORDER BY max_deg_distance DESC
LIMIT 1;
```

```sql
-- Description: Final answer – show both cities, their coordinates, and the distance between them
SELECT  curr."geolocation_state"  AS current_state,
        curr."geolocation_city"   AS current_city,
        curr."geolocation_lat"    AS current_lat,
        curr."geolocation_lng"    AS current_lng,
        prev."geolocation_state"  AS previous_state,
        prev."geolocation_city"   AS previous_city,
        prev."geolocation_lat"    AS previous_lat,
        prev."geolocation_lng"    AS previous_lng,
        SQRT( ( curr."geolocation_lat" - prev."geolocation_lat" ) *
              ( curr."geolocation_lat" - prev."geolocation_lat" ) +
              ( curr."geolocation_lng" - prev."geolocation_lng" ) *
              ( curr."geolocation_lng" - prev."geolocation_lng" ) ) AS max_deg_distance
FROM (
    SELECT  *,
            ROW_NUMBER() OVER (
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
            ) AS rn
    FROM "olist_geolocation"
) AS curr
JOIN (
    SELECT  *,
            ROW_NUMBER() OVER (
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
            ) AS rn
    FROM "olist_geolocation"
) AS prev
ON  curr.rn = prev.rn + 1
WHERE 1 = 1
ORDER BY max_deg_distance DESC
LIMIT 1;
```

```sql
-- Description: (Optional sanity check) display the distance in kilometers
SELECT max_deg_distance * 111.111 AS approx_km_distance
FROM (
    SELECT  SQRT( ( curr."geolocation_lat" - prev."geolocation_lat" ) *
                  ( curr."geolocation_lat" - prev."geolocation_lat" ) +
                  ( curr."geolocation_lng" - prev."geolocation_lng" ) *
                  ( curr."geolocation_lng" - prev."geolocation_lng" ) ) AS max_deg_distance
    FROM (
        SELECT  *,
                ROW_NUMBER() OVER (
                    ORDER BY "geolocation_state",
                             "geolocation_city",
                             "geolocation_zip_code_prefix",
                             "geolocation_lat",
                             "geolocation_lng"
                ) AS rn
        FROM "olist_geolocation"
    ) AS curr
    JOIN (
        SELECT  *,
                ROW_NUMBER() OVER (
                    ORDER BY "geolocation_state",
                             "geolocation_city",
                             "geolocation_zip_code_prefix",
                             "geolocation_lat",
                             "geolocation_lng"
                ) AS rn
        FROM "olist_geolocation"
    ) AS prev
      ON curr.rn = prev.rn + 1
    ORDER BY max_deg_distance DESC
    LIMIT 1
);
```
