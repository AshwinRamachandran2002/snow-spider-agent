Query:
-- Description: Compute the Euclidean distance (in degree units) to the previous row
SELECT  "geolocation_state",
        "geolocation_city",
        prev_city,
        -- simple Euclidean distance in degrees
        SQRT( ( "geolocation_lat" - prev_lat ) * ( "geolocation_lat" - prev_lat )
            + ( "geolocation_lng" - prev_lng ) * ( "geolocation_lng" - prev_lng ) ) AS deg_distance
FROM (
    SELECT "geolocation_state",
           "geolocation_city",
           "geolocation_lat",
           "geolocation_lng",
           LAG("geolocation_city") OVER (
                 ORDER BY "geolocation_state",
                          "geolocation_city",
                          "geolocation_zip_code_prefix",
                          "geolocation_lat",
                          "geolocation_lng"
           )  AS prev_city,
           LAG("geolocation_lat") OVER (
                 ORDER BY "geolocation_state",
                          "geolocation_city",
                          "geolocation_zip_code_prefix",
                          "geolocation_lat",
                          "geolocation_lng"
           )  AS prev_lat,
           LAG("geolocation_lng") OVER (
                 ORDER BY "geolocation_state",
                          "geolocation_city",
                          "geolocation_zip_code_prefix",
                          "geolocation_lat",
                          "geolocation_lng"
           )  AS prev_lng
    FROM "olist_geolocation"
) AS t
WHERE prev_lat IS NOT NULL
LIMIT 20;
