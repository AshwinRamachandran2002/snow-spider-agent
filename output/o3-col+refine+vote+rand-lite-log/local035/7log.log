-- Description: Rank all consecutive-row distances and keep the largest 20
SELECT  "geolocation_state",
        "geolocation_city",
        prev_city,
        deg_distance
FROM (
    SELECT "geolocation_state",
           "geolocation_city",
           prev_city,
           SQRT( ( "geolocation_lat" - prev_lat ) * ( "geolocation_lat" - prev_lat )
               + ( "geolocation_lng" - prev_lng ) * ( "geolocation_lng" - prev_lng ) ) AS deg_distance
    FROM (
        SELECT "geolocation_state",
               "geolocation_city",
               "geolocation_lat",
               "geolocation_lng",
               LAG("geolocation_city") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_city,
               LAG("geolocation_lat") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_lat,
               LAG("geolocation_lng") OVER (
                     ORDER BY "geolocation_state",
                              "geolocation_city",
                              "geolocation_zip_code_prefix",
                              "geolocation_lat",
                              "geolocation_lng"
               )  AS prev_lng
        FROM "olist_geolocation"
    )
    WHERE prev_lat IS NOT NULL
) 
ORDER BY deg_distance DESC
LIMIT 20;
