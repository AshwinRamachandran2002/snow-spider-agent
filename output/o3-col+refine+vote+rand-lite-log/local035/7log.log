-- Description: Use LAG to fetch the previous row’s lat/lng & city, allowing distance calculation
SELECT ROW_NUMBER() OVER (
           ORDER BY "geolocation_state",
                    "geolocation_city",
                    "geolocation_zip_code_prefix",
                    "geolocation_lat",
                    "geolocation_lng"
       ) AS rn,
       "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_city") OVER (
              ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng"
       )  AS prev_city,
       LAG("geolocation_lat") OVER (
              ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng"
       )  AS prev_lat,
       LAG("geolocation_lng") OVER (
              ORDER BY "geolocation_state",
                       "geolocation_city",
                       "geolocation_zip_code_prefix",
                       "geolocation_lat",
                       "geolocation_lng"
       )  AS prev_lng
FROM "olist_geolocation"
LIMIT 20;
