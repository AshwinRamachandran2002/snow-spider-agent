           LAG(lat) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lat,
           LAG(lng) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lng
    FROM   city_centroids
),
distances AS (
    SELECT "geolocation_state",
           "geolocation_city",
           prev_lat,
           prev_lng,
           lat,
           lng,
           6371.0 * ACOS(
                 COS(RADIANS(lat))  * COS(RADIANS(prev_lat)) *
                 COS(RADIANS(prev_lng - lng))
               + SIN(RADIANS(lat))  * SIN(RADIANS(prev_lat))
           )  AS haversine_km
    FROM   lagged
    WHERE  prev_lat IS NOT NULL
)
SELECT *
FROM   distances
ORDER  BY haversine_km DESC
LIMIT 20;
