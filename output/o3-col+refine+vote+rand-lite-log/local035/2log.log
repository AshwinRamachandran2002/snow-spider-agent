-- Description: 9)  Final answer – the pair of consecutive cities with the greatest distance.
WITH city_centroids AS (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS lat,
           AVG("geolocation_lng") AS lng
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
),
lagged AS (
    SELECT *,
           LAG(lat) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lat,
           LAG(lng) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lng,
           LAG("geolocation_state") OVER (ORDER BY "geolocation_state",
                                                 "geolocation_city",
                                                 lat,
                                                 lng) AS prev_state,
           LAG("geolocation_city")  OVER (ORDER BY "geolocation_state",
                                                 "geolocation_city",
                                                 lat,
                                                 lng) AS prev_city
    FROM   city_centroids
),
distances AS (
    SELECT prev_state,
           prev_city,
           "geolocation_state" AS curr_state,
           "geolocation_city"  AS curr_city,
           6371.0 * ACOS(
                 COS(RADIANS(lat))  * COS(RADIANS(prev_lat)) *
                 COS(RADIANS(prev_lng - lng))
               + SIN(RADIANS(lat))  * SIN(RADIANS(prev_lat))
           )  AS haversine_km
    FROM   lagged
    WHERE  prev_lat IS NOT NULL
)
SELECT prev_state     AS "first_city_state",
       prev_city      AS "first_city_name",
       curr_state     AS "second_city_state",
       curr_city      AS "second_city_name",
       haversine_km   AS "distance_km"
FROM   distances
ORDER  BY haversine_km DESC
LIMIT 20;
