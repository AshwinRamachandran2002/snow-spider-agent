Query:
-- Description: 6)  Attach the previous city in the sorted list to every current city (window LAG).
WITH city_centroids AS (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS "avg_lat",
           AVG("geolocation_lng") AS "avg_lng"
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
)
SELECT "geolocation_state",
       "geolocation_city",
       "avg_lat",
       "avg_lng",
       LAG("geolocation_city")        OVER (ORDER BY "geolocation_state",
                                                    "geolocation_city",
                                                    "avg_lat",
                                                    "avg_lng") AS "prev_city",
       LAG("avg_lat")                 OVER (ORDER BY "geolocation_state",
                                                    "geolocation_city",
                                                    "avg_lat",
                                                    "avg_lng") AS "prev_lat",
       LAG("avg_lng")                 OVER (ORDER BY "geolocation_state",
                                                    "geolocation_city",
                                                    "avg_lat",
                                                    "avg_lng") AS "prev_lng"
FROM   city_centroids
LIMIT 20;
Answer:
geolocation_state,geolocation_city,avg_lat,avg_lng,prev_city,prev_lat,prev_lng
