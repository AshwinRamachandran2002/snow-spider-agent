```sql
-- Description: 1)  What are the different Brazilian states present in the geolocation table?
SELECT DISTINCT "geolocation_state"
FROM "olist_geolocation"
LIMIT 20;
```

```sql
-- Description: 2)  Sample of (state, city, zip-code, lat, lng) records restricted to the state of São Paulo (SP).
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_zip_code_prefix",
       "geolocation_lat",
       "geolocation_lng"
FROM   "olist_geolocation"
WHERE  "geolocation_state" = 'SP'
LIMIT 20;
```

```sql
-- Description: 3)  See how many raw latitude/longitude rows each (state, city) combination owns.
SELECT "geolocation_state",
       "geolocation_city",
       COUNT(*)            AS "raw_rows"
FROM   "olist_geolocation"
GROUP  BY "geolocation_state", "geolocation_city"
ORDER  BY "raw_rows" DESC
LIMIT 20;
```

```sql
-- Description: 4)  Compute a representative point for every (state, city): the average latitude and longitude.
SELECT "geolocation_state",
       "geolocation_city",
       AVG("geolocation_lat") AS "avg_lat",
       AVG("geolocation_lng") AS "avg_lng"
FROM   "olist_geolocation"
GROUP  BY "geolocation_state", "geolocation_city"
LIMIT 20;
```

```sql
-- Description: 5)  Show those averaged points already sorted by the keys required in the task statement.
SELECT "geolocation_state",
       "geolocation_city",
       "avg_lat",
       "avg_lng"
FROM (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS "avg_lat",
           AVG("geolocation_lng") AS "avg_lng"
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
)
ORDER BY "geolocation_state",
         "geolocation_city",
         "avg_lat",
         "avg_lng"
LIMIT 20;
```

```sql
-- Description: 6)  Attach the previous city in the sorted list to every current city (window LAG).
WITH city_centroids AS (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS "avg_lat",
           AVG("geolocation_lng") AS "avg_lng"
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
)
SELECT "geolocation_state",
       "geolocation_city",
       "avg_lat",
       "avg_lng",
       LAG("geolocation_city")        OVER (ORDER BY "geolocation_state",
                                                    "geolocation_city",
                                                    "avg_lat",
                                                    "avg_lng") AS "prev_city",
       LAG("avg_lat")                 OVER (ORDER BY "geolocation_state",
                                                    "geolocation_city",
                                                    "avg_lat",
                                                    "avg_lng") AS "prev_lat",
       LAG("avg_lng")                 OVER (ORDER BY "geolocation_state",
                                                    "geolocation_city",
                                                    "avg_lat",
                                                    "avg_lng") AS "prev_lng"
FROM   city_centroids
LIMIT 20;
```

```sql
-- Description: 7)  Add a simple Cartesian (Euclidean) distance, purely to check magnitudes.
WITH city_centroids AS (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS "avg_lat",
           AVG("geolocation_lng") AS "avg_lng"
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
),
lagged AS (
    SELECT *,
           LAG("avg_lat") OVER  (ORDER BY "geolocation_state",
                                         "geolocation_city",
                                         "avg_lat",
                                         "avg_lng") AS "prev_lat",
           LAG("avg_lng") OVER  (ORDER BY "geolocation_state",
                                         "geolocation_city",
                                         "avg_lat",
                                         "avg_lng") AS "prev_lng"
    FROM   city_centroids
)
SELECT "geolocation_state",
       "geolocation_city",
       "avg_lat",
       "avg_lng",
       "prev_lat",
       "prev_lng",
       /* Pythagorean distance in degrees (not yet great-circle) */
       SQRT( ( "avg_lat" - "prev_lat") * ("avg_lat" - "prev_lat")
           + ( "avg_lng" - "prev_lng") * ("avg_lng" - "prev_lng") ) AS "cart_dist_deg"
FROM   lagged
WHERE  "prev_lat" IS NOT NULL
ORDER  BY "cart_dist_deg" DESC
LIMIT 20;
```

```sql
-- Description: 8)  Compute the great-circle (Haversine) distance in kilometres between current and previous cities.
WITH city_centroids AS (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS lat,
           AVG("geolocation_lng") AS lng
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
),
lagged AS (
    SELECT *,
           LAG(lat) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lat,
           LAG(lng) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lng
    FROM   city_centroids
),
distances AS (
    SELECT "geolocation_state",
           "geolocation_city",
           prev_lat,
           prev_lng,
           lat,
           lng,
           6371.0 * ACOS(
                 COS(RADIANS(lat))  * COS(RADIANS(prev_lat)) *
                 COS(RADIANS(prev_lng - lng))
               + SIN(RADIANS(lat))  * SIN(RADIANS(prev_lat))
           )  AS haversine_km
    FROM   lagged
    WHERE  prev_lat IS NOT NULL
)
SELECT *
FROM   distances
ORDER  BY haversine_km DESC
LIMIT 20;
```

```sql
-- Description: 9)  Final answer – the pair of consecutive cities with the greatest distance.
WITH city_centroids AS (
    SELECT "geolocation_state",
           "geolocation_city",
           AVG("geolocation_lat") AS lat,
           AVG("geolocation_lng") AS lng
    FROM   "olist_geolocation"
    GROUP  BY "geolocation_state", "geolocation_city"
),
lagged AS (
    SELECT *,
           LAG(lat) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lat,
           LAG(lng) OVER  (ORDER BY "geolocation_state",
                                     "geolocation_city",
                                     lat,
                                     lng) AS prev_lng,
           LAG("geolocation_state") OVER (ORDER BY "geolocation_state",
                                                 "geolocation_city",
                                                 lat,
                                                 lng) AS prev_state,
           LAG("geolocation_city")  OVER (ORDER BY "geolocation_state",
                                                 "geolocation_city",
                                                 lat,
                                                 lng) AS prev_city
    FROM   city_centroids
),
distances AS (
    SELECT prev_state,
           prev_city,
           "geolocation_state" AS curr_state,
           "geolocation_city"  AS curr_city,
           6371.0 * ACOS(
                 COS(RADIANS(lat))  * COS(RADIANS(prev_lat)) *
                 COS(RADIANS(prev_lng - lng))
               + SIN(RADIANS(lat))  * SIN(RADIANS(prev_lat))
           )  AS haversine_km
    FROM   lagged
    WHERE  prev_lat IS NOT NULL
)
SELECT prev_state     AS "first_city_state",
       prev_city      AS "first_city_name",
       curr_state     AS "second_city_state",
       curr_city      AS "second_city_name",
       haversine_km   AS "distance_km"
FROM   distances
ORDER  BY haversine_km DESC
LIMIT 20;
```
