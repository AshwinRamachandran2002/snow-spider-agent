```sql
--Description: For the same ordering, add the previous row’s state & city using LAG
SELECT "geolocation_state",
       "geolocation_city",
       LAG("geolocation_state") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       ) AS "prev_state",
       LAG("geolocation_city")  OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       ) AS "prev_city"
FROM "olist_geolocation"
ORDER BY "geolocation_state",
         "geolocation_city",
         "geolocation_zip_code_prefix",
         "geolocation_lat",
         "geolocation_lng"
LIMIT 20;
```

```sql
--Description: Still in the same ordered list, add the previous row’s latitude & longitude
