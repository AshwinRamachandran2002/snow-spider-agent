       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_lat") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       ) AS "prev_lat",
       LAG("geolocation_lng") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       ) AS "prev_lng"
FROM "olist_geolocation"
ORDER BY "geolocation_state",
         "geolocation_city",
         "geolocation_zip_code_prefix",
         "geolocation_lat",
         "geolocation_lng"
LIMIT 20;
```

```sql
--Description: Compute the Euclidean distance (lat/lng degrees) between each row and its predecessor
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_state") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )  AS "prev_state",
       LAG("geolocation_city")  OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )  AS "prev_city",
       ROUND(
             SQRT(
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
                  +
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
             ), 6
       ) AS "eucl_dist"
FROM "olist_geolocation"
ORDER BY "geolocation_state",
         "geolocation_city",
         "geolocation_zip_code_prefix",
         "geolocation_lat",
         "geolocation_lng"
LIMIT 20;
```

```sql
--Description: Retrieve the 20 largest successive-row distances in the ordered list
SELECT "geolocation_state"            AS "curr_state",
       "geolocation_city"             AS "curr_city",
       LAG("geolocation_state") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )                               AS "prev_state",
       LAG("geolocation_city")  OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )                               AS "prev_city",
       ROUND(
             SQRT(
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
                  +
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
             ), 6
       ) AS "eucl_dist"
FROM "olist_geolocation"
ORDER BY "eucl_dist" DESC
LIMIT 20;
```

```sql
--Description: Identify the single pair of consecutive cities with the maximum distance
SELECT "curr_state",
       "curr_city",
       "prev_state",
       "prev_city",
       MAX("eucl_dist") AS "max_successive_distance"
FROM (
    SELECT "geolocation_state"            AS "curr_state",
           "geolocation_city"             AS "curr_city",
           LAG("geolocation_state") OVER(
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
           )                               AS "prev_state",
           LAG("geolocation_city")  OVER(
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
           )                               AS "prev_city",
           SQRT(
                ( "geolocation_lat" -
                  LAG("geolocation_lat") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                ) *
                ( "geolocation_lat" -
                  LAG("geolocation_lat") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                )
                +
                ( "geolocation_lng" -
                  LAG("geolocation_lng") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                ) *
                ( "geolocation_lng" -
                  LAG("geolocation_lng") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                )
           ) AS "eucl_dist"
    FROM "olist_geolocation"
) 
WHERE "prev_state" IS NOT NULL
ORDER BY "max_successive_distance" DESC
LIMIT 1;
```

```sql
--Description: Show the full list of rows for those two particular cities (for manual verification)
SELECT *
FROM "olist_geolocation"
WHERE ("geolocation_state", "geolocation_city") IN (
      SELECT "curr_state", "curr_city"
      FROM (
           SELECT "geolocation_state" AS "curr_state",
                  "geolocation_city"  AS "curr_city",
                  LAG("geolocation_state") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  ) AS "prev_state",
                  LAG("geolocation_city")  OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  ) AS "prev_city",
                  SQRT(
                       ( "geolocation_lat" -
                         LAG("geolocation_lat") OVER(
                              ORDER BY "geolocation_state",
                                       "geolocation_city",
                                       "geolocation_zip_code_prefix",
                                       "geolocation_lat",
                                       "geolocation_lng"
                         )
                       ) *
                       ( "geolocation_lat" -
                         LAG("geolocation_lat") OVER(
                              ORDER BY "geolocation_state",
                                       "geolocation_city",
                                       "geolocation_zip_code_prefix",
                                       "geolocation_lat",
                                       "geolocation_lng"
                         )
                       )
                       +
                       ( "geolocation_lng" -
                         LAG("geolocation_lng") OVER(
                              ORDER BY "geolocation_state",
                                       "geolocation_city",
                                       "geolocation_zip_code_prefix",
                                       "geolocation_lat",
                                       "geolocation_lng"
                         )
                       ) *
                       ( "geolocation_lng" -
                         LAG("geolocation_lng") OVER(
                              ORDER BY "geolocation_state",
                                       "geolocation_city",
                                       "geolocation_zip_code_prefix",
                                       "geolocation_lat",
                                       "geolocation_lng"
                         )
                       )
                  ) AS "eucl_dist"
           FROM "olist_geolocation"
      )
      ORDER BY "eucl_dist" DESC
      LIMIT 1
)
LIMIT 20;
```
