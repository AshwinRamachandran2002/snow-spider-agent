--Description: Retrieve the 20 largest successive-row distances in the ordered list
SELECT "geolocation_state"            AS "curr_state",
       "geolocation_city"             AS "curr_city",
       LAG("geolocation_state") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )                               AS "prev_state",
       LAG("geolocation_city")  OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )                               AS "prev_city",
       ROUND(
             SQRT(
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
                  +
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
             ), 6
       ) AS "eucl_dist"
FROM "olist_geolocation"
ORDER BY "eucl_dist" DESC
LIMIT 20;
