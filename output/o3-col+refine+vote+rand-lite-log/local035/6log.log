Query:
--Description: Identify the single pair of consecutive cities with the maximum distance
SELECT "curr_state",
       "curr_city",
       "prev_state",
       "prev_city",
       MAX("eucl_dist") AS "max_successive_distance"
FROM (
    SELECT "geolocation_state"            AS "curr_state",
           "geolocation_city"             AS "curr_city",
           LAG("geolocation_state") OVER(
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
           )                               AS "prev_state",
           LAG("geolocation_city")  OVER(
                ORDER BY "geolocation_state",
                         "geolocation_city",
                         "geolocation_zip_code_prefix",
                         "geolocation_lat",
                         "geolocation_lng"
           )                               AS "prev_city",
           SQRT(
                ( "geolocation_lat" -
                  LAG("geolocation_lat") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                ) *
                ( "geolocation_lat" -
                  LAG("geolocation_lat") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                )
                +
                ( "geolocation_lng" -
                  LAG("geolocation_lng") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                ) *
                ( "geolocation_lng" -
                  LAG("geolocation_lng") OVER(
                       ORDER BY "geolocation_state",
                                "geolocation_city",
                                "geolocation_zip_code_prefix",
                                "geolocation_lat",
                                "geolocation_lng"
                  )
                )
           ) AS "eucl_dist"
    FROM "olist_geolocation"
) 
WHERE "prev_state" IS NOT NULL
ORDER BY "max_successive_distance" DESC
LIMIT 1;
