Query:
--Description: Compute the Euclidean distance (lat/lng degrees) between each row and its predecessor
SELECT "geolocation_state",
       "geolocation_city",
       "geolocation_lat",
       "geolocation_lng",
       LAG("geolocation_state") OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )  AS "prev_state",
       LAG("geolocation_city")  OVER(
            ORDER BY "geolocation_state",
                     "geolocation_city",
                     "geolocation_zip_code_prefix",
                     "geolocation_lat",
                     "geolocation_lng"
       )  AS "prev_city",
       ROUND(
             SQRT(
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lat" -
                    LAG("geolocation_lat") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
                  +
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  ) *
                  ( "geolocation_lng" -
                    LAG("geolocation_lng") OVER(
                         ORDER BY "geolocation_state",
                                  "geolocation_city",
                                  "geolocation_zip_code_prefix",
                                  "geolocation_lat",
                                  "geolocation_lng"
                    )
                  )
             ), 6
       ) AS "eucl_dist"
FROM "olist_geolocation"
ORDER BY "geolocation_state",
         "geolocation_city",
         "geolocation_zip_code_prefix",
         "geolocation_lat",
         "geolocation_lng"
LIMIT 20;
