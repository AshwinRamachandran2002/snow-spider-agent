```sql
-- 1.  Get the unique `drugID` that corresponds to Sorafenib   
SELECT DISTINCT `drugID`, `synonym`
FROM   `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
WHERE  LOWER(`synonym`) LIKE '%sorafenib%'
LIMIT 20;
```

```sql
-- 2.  Look at all interaction rows for Sorafenib (Homo-sapiens targets only)  
SELECT  DISTINCT i.*
FROM    `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
JOIN    `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` AS d
        ON i.`drugID` = d.`drugID`
WHERE   LOWER(d.`synonym`) LIKE '%sorafenib%'
  AND   LOWER(i.`targetSpecies`) = 'homo sapiens'
LIMIT 20;
```

```sql
-- 3.  Join those interactions to their experiments and keep the rows that   
--     satisfy the potency cut-offs (median ≤100 AND low/high ≤100 OR NULL)  
SELECT  DISTINCT i.`interactionID`,
        i.`targetID`,
        i.`target_uniprotID`,
        e.`expID`,
        e.`exp_assayValueLow`,
        e.`exp_assayValueMedian`,
        e.`exp_assayValueHigh`
FROM    `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
JOIN    `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` AS d
        ON i.`drugID` = d.`drugID`
JOIN    `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
        ON i.`expID`  = e.`expID`
WHERE   LOWER(d.`synonym`) LIKE '%sorafenib%'
  AND   LOWER(i.`targetSpecies`) = 'homo sapiens'
  AND   e.`exp_assayValueMedian`  <= 100
  AND (e.`exp_assayValueLow`   <= 100 OR e.`exp_assayValueLow`  IS NULL)
  AND (e.`exp_assayValueHigh`  <= 100 OR e.`exp_assayValueHigh` IS NULL)
LIMIT 20;
```

```sql
-- 4.  List the distinct UniProt IDs of Sorafenib targets that pass the filters  
SELECT DISTINCT `target_uniprotID`
FROM (
      -- same sub-query as #3
      SELECT  i.`target_uniprotID`
      FROM    `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
      JOIN    `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` AS d
              ON i.`drugID` = d.`drugID`
      JOIN    `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
              ON i.`expID`  = e.`expID`
      WHERE   LOWER(d.`synonym`) LIKE '%sorafenib%'
        AND   LOWER(i.`targetSpecies`) = 'homo sapiens'
        AND   e.`exp_assayValueMedian`  <= 100
        AND (e.`exp_assayValueLow`   <= 100 OR e.`exp_assayValueLow`  IS NULL)
        AND (e.`exp_assayValueHigh`  <= 100 OR e.`exp_assayValueHigh` IS NULL)
     )
LIMIT 20;
```

```sql
-- 5.  Map those UniProt IDs to Reactome physical entities  
SELECT DISTINCT p.`uniprot_id`, p.`stable_id` AS pe_stable_id
FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
WHERE  p.`uniprot_id` IN (
        -- pull the UniProt list from query #4
        SELECT DISTINCT `target_uniprotID`
        FROM (
              SELECT  i.`target_uniprotID`
              FROM    `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
              JOIN    `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` AS d
                      ON i.`drugID` = d.`drugID`
              JOIN    `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
                      ON i.`expID`  = e.`expID`
              WHERE   LOWER(d.`synonym`) LIKE '%sorafenib%'
                AND   LOWER(i.`targetSpecies`) = 'homo sapiens'
                AND   e.`exp_assayValueMedian`  <= 100
                AND (e.`exp_assayValueLow`   <= 100 OR e.`exp_assayValueLow`  IS NULL)
                AND (e.`exp_assayValueHigh`  <= 100 OR e.`exp_assayValueHigh` IS NULL)
             )
      )
LIMIT 20;
```

```sql
-- 6.  Connect those physical entities to pathways that have TAS evidence  
SELECT DISTINCT pep.`pe_stable_id`,
       pep.`pathway_stable_id`
FROM (
      -- physical entities from #5
      SELECT DISTINCT p.`stable_id` AS pe_stable_id
      FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
      WHERE  p.`uniprot_id` IN (
              SELECT DISTINCT i.`target_uniprotID`
              FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
              JOIN   `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` AS d
                     ON i.`drugID` = d.`drugID`
              JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
                     ON i.`expID`  = e.`expID`
              WHERE  LOWER(d.`synonym`) LIKE '%sorafenib%'
                AND  LOWER(i.`targetSpecies`) = 'homo sapiens'
                AND  e.`exp_assayValueMedian`  <= 100
                AND (e.`exp_assayValueLow`   <= 100 OR e.`exp_assayValueLow`  IS NULL)
                AND (e.`exp_assayValueHigh`  <= 100 OR e.`exp_assayValueHigh` IS NULL)
           )
     ) AS pes
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pep
  ON pes.`pe_stable_id` = pep.`pe_stable_id`
WHERE pep.`evidence_code` = 'TAS'
LIMIT 20;
```

```sql
-- 7.  Keep only the LOWEST-LEVEL Reactome pathways (lowest_level = TRUE)
SELECT DISTINCT pp.`pathway_stable_id`      AS pathway_id,
       pw.`name`                            AS pathway_name
FROM   (
        -- mapping from #6
        SELECT DISTINCT pep.`pathway_stable_id`
        FROM   (
                SELECT DISTINCT p.`stable_id` AS pe_stable_id
                FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
                WHERE  p.`uniprot_id` IN ( /* same sub-query as above */ )
               ) AS pes
        JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pep
          ON pes.`pe_stable_id` = pep.`pe_stable_id`
        WHERE  pep.`evidence_code` = 'TAS'
      ) AS pp
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON   pp.`pathway_stable_id` = pw.`stable_id`
WHERE  pw.`lowest_level` = TRUE
LIMIT 20;
```

```sql
-- 8.  For each of those lowest-level pathways, count how many Sorafenib targets   
--     (physical entities) map to it (TAS evidence).  
SELECT  pathway_id,
        COUNT(DISTINCT pe_stable_id) AS num_targets_in_pathway
FROM (
      -- mapping of sorafenib physical entities to pathways (only lowest level)
      SELECT  pep.`pathway_stable_id` AS pathway_id,
              pep.`pe_stable_id`
      FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pep
      JOIN   (
              SELECT DISTINCT p.`stable_id` AS pe_stable_id
              FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
              WHERE  p.`uniprot_id` IN ( /* UniProt list as above */ )
             ) AS t_pe
        ON  pep.`pe_stable_id` = t_pe.`pe_stable_id`
      JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
        ON   pep.`pathway_stable_id` = pw.`stable_id`
      WHERE  pep.`evidence_code` = 'TAS'
        AND  pw.`lowest_level`   = TRUE
     )
GROUP BY pathway_id
LIMIT 20;
```

```sql
-- 9.  Build the 2×2 contingency table (targets vs non-targets, in vs out)   
--     and calculate the chi-squared statistic for each pathway.  
WITH  
targets AS (           -- physical entities that are Sorafenib targets
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  WHERE  p.`uniprot_id` IN ( /* UniProt list as above */ )
),  
tas_pe AS (            -- All physical entities that have TAS evidence
  SELECT DISTINCT pep.`pe_stable_id`
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pep
  WHERE  pep.`evidence_code` = 'TAS'
),  
path_pe AS (           -- Lowest-level pathways with each of their TAS entities
  SELECT  pep.`pathway_stable_id` AS pathway_id,
          pep.`pe_stable_id`
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pep
  JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
         ON pep.`pathway_stable_id` = pw.`stable_id`
  WHERE  pep.`evidence_code` = 'TAS'
    AND  pw.`lowest_level`   = TRUE
)  
SELECT  pathway_id,
        COUNTIF(pe_stable_id IN (SELECT pe_stable_id FROM targets)) AS a_targets_in,
        COUNTIF(pe_stable_id NOT IN (SELECT pe_stable_id FROM targets)) AS c_nontargets_in,
        (SELECT COUNT(*) FROM targets) -
        COUNTIF(pe_stable_id IN (SELECT pe_stable_id FROM targets))  AS b_targets_out,
        (SELECT COUNT(*) FROM tas_pe) -
        (SELECT COUNT(*) FROM targets) -
        COUNTIF(pe_stable_id NOT IN (SELECT pe_stable_id FROM targets)) AS d_nontargets_out,
        -- Chi-squared:  ( (ad-bc)^2 * n ) / ((a+b)(c+d)(a+c)(b+d))
        ROUND( (POW( ( COUNTIF(pe_stable_id IN (SELECT pe_stable_id FROM targets)) *
                       ( (SELECT COUNT(*) FROM tas_pe) -
                         (SELECT COUNT(*) FROM targets) -
                         COUNTIF(pe_stable_id NOT IN (SELECT pe_stable_id FROM targets)) )
                     -
                      ( (SELECT COUNT(*) FROM targets) -
                        COUNTIF(pe_stable_id IN (SELECT pe_stable_id FROM targets)) )
                      * COUNTIF(pe_stable_id NOT IN (SELECT pe_stable_id FROM targets)) 
                    ), 2)
                *
               (SELECT COUNT(*) FROM tas_pe),
               3)                                                        -- numerator
             /
             ( ( (SELECT COUNT(*) FROM targets) ) *
               ( (SELECT COUNT(*) FROM tas_pe) -
                 (SELECT COUNT(*) FROM targets) ) *
               ( (SELECT COUNT(*) FROM tas_pe) ) *
               ( (SELECT COUNT(*) FROM tas_pe) -
                 (SELECT COUNT(*) FROM targets) ) )                      -- denominator
        )  AS chi_squared
FROM    path_pe
GROUP BY pathway_id
LIMIT 20;
```

```sql
-- 10.  Produce the final answer: the three lowest-level TAS pathways   
--      with the highest chi-squared values and the 2×2 table counts  
WITH  
targets AS (
  /* same CTE as in #9 */
),  
tas_pe AS (
  /* same CTE as in #9 */
),  
path_pe AS (
  /* same CTE as in #9 */
),  
tbl AS (
  SELECT  pathway_id,
          COUNTIF(pe_stable_id IN (SELECT pe_stable_id FROM targets)) AS a_targets_in,
          COUNTIF(pe_stable_id NOT IN (SELECT pe_stable_id FROM targets)) AS c_nontargets_in,
          (SELECT COUNT(*) FROM targets) -
          COUNTIF(pe_stable_id IN (SELECT pe_stable_id FROM targets))  AS b_targets_out,
          (SELECT COUNT(*) FROM tas_pe) -
          (SELECT COUNT(*) FROM targets) -
          COUNTIF(pe_stable_id NOT IN (SELECT pe_stable_id FROM targets)) AS d_nontargets_out
  FROM    path_pe
  GROUP BY pathway_id
)  
SELECT  tbl.pathway_id,
        pw.`name`                           AS pathway_name,
        a_targets_in,
        b_targets_out,
        c_nontargets_in,
        d_nontargets_out,
        ROUND( (POW( (a_targets_in*d_nontargets_out - b_targets_out*c_nontargets_in),2 )
                * (a_targets_in+b_targets_out+c_nontargets_in+d_nontargets_out) )
               /
               ( (a_targets_in+b_targets_out)
                 * (c_nontargets_in+d_nontargets_out)
                 * (a_targets_in+c_nontargets_in)
                 * (b_targets_out+d_nontargets_out) ), 3) AS chi_squared
FROM    tbl
JOIN    `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON    tbl.pathway_id = pw.`stable_id`
ORDER BY chi_squared DESC
LIMIT 3;
```

These ten incremental queries start from identifying Sorafenib in the Targetome tables, filter its Homo-sapiens targets by potency, map to Reactome physical entities and TAS pathways, then build the 2×2 contingency tables for every lowest-level TAS pathway and finally return the three pathways with the greatest chi-squared statistics together with the numbers of (targets / non-targets) inside and outside each pathway.
