```sql
--Description:
-- Build, step-by-step, the set of lowest-level Reactome pathways that have TAS evidence
-- for any Homo sapiens Sorafenib target whose potency (median / low / high) is ≤ 100 nM
-- or NULL.  Everything happens in one statement using CTEs:
--   1. soraf_targets  – UniProt IDs of qualified Sorafenib targets.
--   2. soraf_pe       – Reactome physical-entity stable IDs mapped from those targets.
--   3. tas_pathways   – Pathways (any level) with TAS evidence for those entities.
--   Final SELECT      – Keep only pathways flagged as `lowest_level = TRUE`,
--                       output their stable ID and name.
WITH soraf_targets AS (
  SELECT DISTINCT i.target_uniprotID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
  JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` AS d
    ON i.drugID = d.drugID
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
    ON i.expID  = e.expID
  WHERE LOWER(d.synonym)       LIKE '%sorafenib%'             -- Sorafenib rows
    AND LOWER(i.targetSpecies) = 'homo sapiens'               -- human targets
    AND e.exp_assayValueMedian <= 100                         -- potency ≤ 100 nM
    AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
),
soraf_pe AS (
  SELECT DISTINCT p.stable_id AS pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  WHERE p.uniprot_id IN (SELECT target_uniprotID FROM soraf_targets)
),
tas_pathways AS (
  SELECT DISTINCT pep.pathway_stable_id
  FROM soraf_pe AS sp
  JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pep
    ON sp.pe_stable_id = pep.pe_stable_id
  WHERE pep.evidence_code = 'TAS'                             -- TAS evidence only
)
SELECT tp.pathway_stable_id AS pathway_id,
       pw.name              AS pathway_name
FROM   tas_pathways AS tp
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON   tp.pathway_stable_id = pw.stable_id
WHERE  pw.lowest_level = TRUE                                 -- lowest-level paths
LIMIT 20;
```
