  SELECT ps.pathway_id,
         ROW_NUMBER() OVER (ORDER BY
           ( (SELECT total_pe FROM totals) * POW( targets_in, 2 ) ) DESC ) AS rk
  FROM pathway_stats ps
),
top3 AS (SELECT pathway_id FROM chi_rank WHERE rk <= 3)
SELECT pw.stable_id AS pathway_id,
       pw.name      AS pathway_name,
       pw.url       AS reactome_url
FROM   `isb-cgc-bq.reactome_versioned.pathway_v77` pw
JOIN   top3 t3
  ON   pw.stable_id = t3.pathway_id
