--7)  Count, for every lowest-level TAS pathway, how many sorafenib targets (A)
--    and non-targets (C) lie in that pathway
WITH
--Universe of Homo sapiens physical entities that have TAS evidence to some pathway
tas_human_pe AS (
  SELECT DISTINCT ptp.`pe_stable_id`
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
    ON   ptp.`pe_stable_id` = pe.`stable_id`
  WHERE  ptp.`evidence_code` = 'TAS'
    AND  LOWER(pe.`species`) IS NULL  -- species info not given in PE table; we assume Homo
),

--Set of sorafenib physical entities
sorafenib_pe AS (
  SELECT DISTINCT p.`stable_id`
  FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  JOIN  ( SELECT DISTINCT i.`target_uniprotID`
          FROM   `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
          JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
            ON   i.`expID` = e.`expID`
          WHERE  i.`drugID` IN (SELECT DISTINCT `drugID`
                                FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                                WHERE LOWER(`synonym`) LIKE '%sorafenib%')
            AND  LOWER(i.`targetSpecies`) = 'homo sapiens'
            AND  e.`exp_assayValueMedian` <= 100
            AND (e.`exp_assayValueLow`   <= 100 OR e.`exp_assayValueLow`  IS NULL)
            AND (e.`exp_assayValueHigh`  <= 100 OR e.`exp_assayValueHigh` IS NULL)
        ) AS t
    ON  LOWER(p.`uniprot_id`) = LOWER(t.`target_uniprotID`)
),

--Links PE → Pathway (TAS evidence & lowest level only)
tas_links AS (
  SELECT ptp.`pe_stable_id`, ptp.`pathway_stable_id`
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
    ON   ptp.`pathway_stable_id` = pw.`stable_id`
  WHERE  ptp.`evidence_code` = 'TAS'
    AND  pw.`lowest_level`  = TRUE
)

SELECT
  pw.`stable_id`                                    AS pathway_id,
  pw.`name`                                         AS pathway_name,

  --A: sorafenib targets in pathway
  COUNTIF( sp.`pe_stable_id` IS NOT NULL )          AS targets_in,

  --B: sorafenib targets NOT in pathway
  (SELECT COUNT(*) FROM sorafenib_pe) 
    - COUNTIF( sp.`pe_stable_id` IS NOT NULL )      AS targets_out,

  --C: NON-targets in pathway  (tas PE minus sorafenib PE)
  COUNTIF( sp.`pe_stable_id` IS NULL )              AS nontargets_in,

  --D: NON-targets NOT in pathway
  ( SELECT COUNT(*) FROM tas_human_pe )
     - ( COUNTIF( sp.`pe_stable_id` IS NULL ) 
       + (SELECT COUNT(*) FROM sorafenib_pe) 
       - COUNTIF( sp.`pe_stable_id` IS NOT NULL ) ) AS nontargets_out,

  --Chi-squared statistic for 1 degree of freedom
  ( POWER( ( COUNTIF( sp.`pe_stable_id` IS NOT NULL )
             * ( ( SELECT COUNT(*) FROM tas_human_pe )
                 - COUNTIF( sp.`pe_stable_id` IS NULL )
                 - ( ( SELECT COUNT(*) FROM sorafenib_pe )
                     - COUNTIF( sp.`pe_stable_id` IS NOT NULL ) ) )
           - ( ( SELECT COUNT(*) FROM sorafenib_pe )
               - COUNTIF( sp.`pe_stable_id` IS NOT NULL ) )
             * COUNTIF( sp.`pe_stable_id` IS NULL )
           ), 2)
    * ( ( SELECT COUNT(*) FROM tas_human_pe ) ) )
  / ( ( SELECT COUNT(*) FROM sorafenib_pe )
      * ( ( SELECT COUNT(*) FROM tas_human_pe )
          - ( SELECT COUNT(*) FROM sorafenib_pe ) )
      * ( COUNT(*) )
      * ( ( SELECT COUNT(*) FROM tas_human_pe )
          - COUNT(*) ) )                            AS chi_sq
FROM   tas_links           AS tl
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`  AS pw
  ON   pw.`stable_id` = tl.`pathway_stable_id`
LEFT JOIN sorafenib_pe     AS sp
  ON   tl.`pe_stable_id` = sp.`stable_id`
GROUP BY pw.`stable_id`, pw.`name`
HAVING COUNTIF( sp.`pe_stable_id` IS NOT NULL ) > 0   -- pathway must contain ≥1 target
ORDER BY chi_sq DESC
LIMIT 20;
