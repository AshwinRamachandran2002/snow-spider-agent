--Description:
--We need the 3 lowest-level Reactome pathways (TAS evidence) that are most
--enriched for potent Homo sapiens sorafenib targets (median ≤ 100 nM and
--low/high ≤ 100 nM or NULL).  “Enriched” is measured by the chi-squared
--statistic of a 2×2 table:
--        ┌─────────────────────┬────────────────────────┐
--        │  in pathway         │  outside pathway       │
-- ┌──────┼─────────────────────┼────────────────────────┤
-- │ tgt  │ A = targets_in      │ B = targets_out        │
-- │ non  │ C = nontargets_in   │ D = nontargets_out     │
-- └──────┴─────────────────────┴────────────────────────┘
--χ² = N(AD–BC)² /((A+B)(C+D)(A+C)(B+D)),  N = A+B+C+D.
--
--CTEs:
-- 1) sorafenib_drug           – drugIDs whose synonym contains “sorafenib”.
-- 2) potent_uniprot           – UniProt IDs of human targets passing potency cut-off.
-- 3) sorafenib_pe            – Reactome PE stable_ids mapped from those UniProt IDs.
-- 4) tas_links               – PE→Pathway links (TAS evidence, lowest-level).
-- 5) tas_pe                  – universe of PEs that appear in tas_links.
-- 6) totals                  – counts of total targets and total PEs.
-- 7) pathway_stats           – compute A and C for every pathway.
-- 8) chi_table               – derive B, D and χ²; return top-3 by χ².
WITH
sorafenib_drug AS (
  SELECT DISTINCT drugID
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
  WHERE LOWER(synonym) LIKE '%sorafenib%'
),
potent_uniprot AS (   -- potency + Homo sapiens filter
  SELECT DISTINCT i.target_uniprotID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e
    ON i.expID = e.expID
  WHERE i.drugID IN (SELECT drugID FROM sorafenib_drug)
    AND LOWER(i.targetSpecies) = 'homo sapiens'
    AND e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow  IS NULL OR e.exp_assayValueLow  <= 100)
    AND (e.exp_assayValueHigh IS NULL OR e.exp_assayValueHigh <= 100)
),
sorafenib_pe AS (      -- map UniProt → Reactome PE
  SELECT DISTINCT pe.stable_id AS pe_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` pe
  JOIN potent_uniprot u
    ON LOWER(pe.uniprot_id) = LOWER(u.target_uniprotID)
),
tas_links AS (         -- TAS PE→Pathway, lowest level only
  SELECT DISTINCT ptp.pe_stable_id AS pe_id,
         ptp.pathway_stable_id    AS pathway_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       pw
    ON pw.stable_id = ptp.pathway_stable_id
  WHERE ptp.evidence_code = 'TAS'
    AND pw.lowest_level   = TRUE
),
tas_pe AS (SELECT DISTINCT pe_id FROM tas_links),
totals AS (
  SELECT
    (SELECT COUNT(*) FROM sorafenib_pe) AS total_targets,
    (SELECT COUNT(*) FROM tas_pe)       AS total_pe
),
pathway_stats AS (     -- A and C
  SELECT
    pw.stable_id AS pathway_id,
    pw.name      AS pathway_name,
    COUNTIF(sp.pe_id IS NOT NULL) AS targets_in,     -- A
    COUNTIF(sp.pe_id IS NULL)     AS nontargets_in   -- C
  FROM tas_links tl
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` pw
    ON pw.stable_id = tl.pathway_id
  LEFT JOIN sorafenib_pe sp
    ON sp.pe_id = tl.pe_id
  GROUP BY pw.stable_id, pw.name
  HAVING targets_in > 0                                -- need ≥1 target
),
chi_table AS (
  SELECT
    ps.*,
    tot.total_targets,
    tot.total_pe - tot.total_targets        AS total_nontargets,
    tot.total_targets    - ps.targets_in    AS targets_out,     -- B
    (tot.total_pe - tot.total_targets)
      - ps.nontargets_in                    AS nontargets_out,  -- D
    ( tot.total_pe *
      POW( (ps.targets_in * ((tot.total_pe - tot.total_targets) - ps.nontargets_in)
           - (tot.total_targets - ps.targets_in) * ps.nontargets_in), 2) )
    / ( (ps.targets_in + (tot.total_targets - ps.targets_in))            -- (A+B)
        * (ps.nontargets_in + ((tot.total_pe - tot.total_targets)
                               - ps.nontargets_in))                     -- (C+D)
        * (ps.targets_in + ps.nontargets_in)                             -- (A+C)
        * ((tot.total_targets - ps.targets_in)
           + ((tot.total_pe - tot.total_targets) - ps.nontargets_in))    -- (B+D)
      ) AS chi_sq
  FROM pathway_stats ps, totals tot
)
SELECT
  pathway_id,
  pathway_name,
  targets_in      AS A_targets_in,
  targets_out     AS B_targets_out,
  nontargets_in   AS C_nontargets_in,
  nontargets_out  AS D_nontargets_out,
  chi_sq
FROM chi_table
ORDER BY chi_sq DESC
LIMIT 3;
