Query:
--Description / Thinking process:
-- Same objective as before (top-3 χ² pathways) but protect against divide-by-zero by wrapping the
-- denominator with SAFE_DIVIDE.  Steps:
--   1) Gather potent Homo-sapiens sorafenib targets → Reactome PE IDs.
--   2) Retrieve TAS PE↔pathway edges and lowest-level Homo-sapiens pathways.
--   3) Build 2×2 contingency counts (a,b,c,d) for every pathway.
--   4) Compute χ² using SAFE_DIVIDE.
--   5) Return three pathways with the highest χ² and their counts.
WITH targets AS (          -- Step-1
  SELECT DISTINCT p.stable_id AS pe_stable_id
  FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s
  JOIN `isb-cgc-bq.targetome_versioned.interactions_v1`  i ON i.drugID = s.drugID
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`     e ON i.expID  = e.expID
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
       ON LOWER(p.uniprot_id) = LOWER(i.target_uniprotID)
  WHERE LOWER(s.synonym)      LIKE '%sorafenib%'
    AND LOWER(i.targetSpecies) = 'homo sapiens'
    AND e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
),
tas_pe_pathway AS (        -- Step-2: TAS edges
  SELECT DISTINCT pe_stable_id, pathway_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE evidence_code = 'TAS'
),
lowest_pathways AS (       -- lowest-level human pathways
  SELECT stable_id, name
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE lowest_level = TRUE AND species = 'Homo sapiens'
),
all_pe AS (                -- background universe
  SELECT DISTINCT pe_stable_id FROM tas_pe_pathway
),
cont AS (                  -- Step-3: contingency tables
  SELECT
    lp.stable_id AS pathway_id,
    lp.name      AS pathway_name,
    SUM(CASE WHEN t.pe_stable_id IS NOT NULL AND tp.pe_stable_id IS NOT NULL THEN 1 ELSE 0 END) AS a,
    SUM(CASE WHEN t.pe_stable_id IS NOT NULL AND tp.pe_stable_id IS NULL  THEN 1 ELSE 0 END) AS b,
    SUM(CASE WHEN t.pe_stable_id IS NULL      AND tp.pe_stable_id IS NOT NULL THEN 1 ELSE 0 END) AS c,
    SUM(CASE WHEN t.pe_stable_id IS NULL      AND tp.pe_stable_id IS NULL  THEN 1 ELSE 0 END) AS d
  FROM lowest_pathways lp
  CROSS JOIN all_pe ape
  LEFT JOIN tas_pe_pathway tp
         ON ape.pe_stable_id = tp.pe_stable_id
        AND tp.pathway_stable_id = lp.stable_id
  LEFT JOIN targets t
         ON ape.pe_stable_id = t.pe_stable_id
  GROUP BY pathway_id, pathway_name
),
scored AS (                -- Step-4: χ² with SAFE_DIVIDE
  SELECT
    pathway_id,
    pathway_name,
    a, b, c, d,
    SAFE_DIVIDE(
      (a+b+c+d) * POW(a*d - b*c, 2),
      (a+b) * (c+d) * (a+c) * (b+d)
    ) AS chi2
  FROM cont
)
-- Step-5: output top-3
SELECT
  pathway_id,
  pathway_name,
  a AS targets_in_pathway,
  b AS targets_outside_pathway,
  c AS nontargets_in_pathway,
  d AS nontargets_outside_pathway,
  chi2
FROM scored
ORDER BY chi2 DESC
LIMIT 3
