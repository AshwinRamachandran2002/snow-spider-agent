--Description: Build the full 2×2 contingency table (targets vs non-targets, inside vs outside) for every lowest-level TAS pathway
WITH
targets AS (
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
    WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
      AND LOWER(i.`targetSpecies`) = 'homo sapiens'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
      AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
  ) x
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON LOWER(p.`uniprot_id`) = LOWER(x.`target_uniprotID`)
),
tas_pe_pathway AS (
  SELECT DISTINCT ptp.`pe_stable_id`, ptp.`pathway_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  WHERE ptp.`evidence_code` = 'TAS'
),
lowest_pathways AS (
  SELECT `stable_id`, `name`
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE `lowest_level` = TRUE
    AND `species` = 'Homo sapiens'
),
all_pe AS (
  SELECT DISTINCT `pe_stable_id` FROM tas_pe_pathway
)
SELECT
  lp.`stable_id` AS pathway_id,
  lp.`name`      AS pathway_name,
  SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS targets_in_pathway,
  SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS targets_outside_pathway,
  SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS nontargets_in_pathway,
  SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS nontargets_outside_pathway
FROM lowest_pathways lp
CROSS JOIN all_pe ape
LEFT JOIN tas_pe_pathway tp
  ON ape.`pe_stable_id` = tp.`pe_stable_id`
  AND tp.`pathway_stable_id` = lp.`stable_id`
LEFT JOIN targets t
  ON ape.`pe_stable_id` = t.`pe_stable_id`
GROUP BY pathway_id, pathway_name
LIMIT 20;
