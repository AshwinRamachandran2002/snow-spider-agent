```sql
--Description: Map each filtered UniProt target to its Reactome physical-entity (PE) stable_id
WITH targets AS (
  SELECT DISTINCT i.`target_uniprotID`
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
  JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
  WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
    AND LOWER(i.`targetSpecies`) = 'homo sapiens'
    AND e.`exp_assayValueMedian` <= 100
    AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
    AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
)
SELECT DISTINCT p.`stable_id`   AS pe_stable_id,
                p.`uniprot_id`,
                p.`name`,
                p.`location`
FROM targets t
JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
  ON LOWER(p.`uniprot_id`) = LOWER(t.`target_uniprotID`)
LIMIT 20;
```

```sql
--Description: Link those physical entities to pathways that have TAS evidence
WITH target_pe AS (
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
    WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
      AND LOWER(i.`targetSpecies`) = 'homo sapiens'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
      AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
  ) u
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON LOWER(p.`uniprot_id`) = LOWER(u.`target_uniprotID`)
)
SELECT DISTINCT ptp.`pathway_stable_id`,
                ptp.`pe_stable_id`
FROM target_pe tpe
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  ON tpe.`pe_stable_id` = ptp.`pe_stable_id`
WHERE ptp.`evidence_code` = 'TAS'
LIMIT 20;
```

```sql
--Description: Show all lowest-level Homo sapiens pathways that any of these targets map into by TAS evidence
WITH target_pe AS (
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
    WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
      AND LOWER(i.`targetSpecies`) = 'homo sapiens'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
      AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
  ) u
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON LOWER(p.`uniprot_id`) = LOWER(u.`target_uniprotID`)
)
SELECT DISTINCT pw.`stable_id`,
                pw.`name`,
                pw.`lowest_level`
FROM target_pe tpe
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  ON tpe.`pe_stable_id` = ptp.`pe_stable_id`
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` pw
  ON pw.`stable_id` = ptp.`pathway_stable_id`
WHERE ptp.`evidence_code` = 'TAS'
  AND pw.`lowest_level` = TRUE
  AND pw.`species` = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description: Build the full 2×2 contingency table (targets vs non-targets, inside vs outside) for every lowest-level TAS pathway
WITH
targets AS (
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
    WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
      AND LOWER(i.`targetSpecies`) = 'homo sapiens'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
      AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
  ) x
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON LOWER(p.`uniprot_id`) = LOWER(x.`target_uniprotID`)
),
tas_pe_pathway AS (
  SELECT DISTINCT ptp.`pe_stable_id`, ptp.`pathway_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  WHERE ptp.`evidence_code` = 'TAS'
),
lowest_pathways AS (
  SELECT `stable_id`, `name`
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE `lowest_level` = TRUE
    AND `species` = 'Homo sapiens'
),
all_pe AS (
  SELECT DISTINCT `pe_stable_id` FROM tas_pe_pathway
)
SELECT
  lp.`stable_id` AS pathway_id,
  lp.`name`      AS pathway_name,
  SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS targets_in_pathway,
  SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS targets_outside_pathway,
  SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS nontargets_in_pathway,
  SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS nontargets_outside_pathway
FROM lowest_pathways lp
CROSS JOIN all_pe ape
LEFT JOIN tas_pe_pathway tp
  ON ape.`pe_stable_id` = tp.`pe_stable_id`
  AND tp.`pathway_stable_id` = lp.`stable_id`
LEFT JOIN targets t
  ON ape.`pe_stable_id` = t.`pe_stable_id`
GROUP BY pathway_id, pathway_name
LIMIT 20;
```

```sql
--Description: Calculate the chi-squared statistic for every pathway based on those contingency counts
WITH
targets AS (
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
    WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
      AND LOWER(i.`targetSpecies`) = 'homo sapiens'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
      AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
  ) x
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON LOWER(p.`uniprot_id`) = LOWER(x.`target_uniprotID`)
),
tas_pe_pathway AS (
  SELECT DISTINCT ptp.`pe_stable_id`, ptp.`pathway_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  WHERE ptp.`evidence_code` = 'TAS'
),
lowest_pathways AS (
  SELECT `stable_id`, `name`
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE `lowest_level` = TRUE
    AND `species` = 'Homo sapiens'
),
all_pe AS (
  SELECT DISTINCT `pe_stable_id` FROM tas_pe_pathway
),
cont AS (
  SELECT
    lp.`stable_id` AS pathway_id,
    lp.`name`,
    SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS a,
    SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS b,
    SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS c,
    SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS d
  FROM lowest_pathways lp
  CROSS JOIN all_pe ape
  LEFT JOIN tas_pe_pathway tp
    ON ape.`pe_stable_id` = tp.`pe_stable_id`
    AND tp.`pathway_stable_id` = lp.`stable_id`
  LEFT JOIN targets t
    ON ape.`pe_stable_id` = t.`pe_stable_id`
  GROUP BY pathway_id, lp.`name`
)
SELECT
  pathway_id,
  `name`,
  a, b, c, d,
  ((a + b + c + d) * POW((a*d - b*c), 2)) /
  ((a+b)*(c+d)*(a+c)*(b+d)) AS chi2
FROM cont
ORDER BY chi2 DESC
LIMIT 20;
```

```sql
--Description: Final query – return the three pathways with the highest chi-square along with the 2×2 counts
WITH
targets AS (
  SELECT DISTINCT p.`stable_id` AS pe_stable_id
  FROM (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.drug_synonyms_v1` s ON i.`drugID` = s.`drugID`
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e ON i.`expID`  = e.`expID`
    WHERE LOWER(s.`synonym`) LIKE '%sorafenib%'
      AND LOWER(i.`targetSpecies`) = 'homo sapiens'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  <= 100 OR e.`exp_assayValueLow`  IS NULL)
      AND (e.`exp_assayValueHigh` <= 100 OR e.`exp_assayValueHigh` IS NULL)
  ) x
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
    ON LOWER(p.`uniprot_id`) = LOWER(x.`target_uniprotID`)
),
tas_pe_pathway AS (
  SELECT DISTINCT ptp.`pe_stable_id`, ptp.`pathway_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` ptp
  WHERE ptp.`evidence_code` = 'TAS'
),
lowest_pathways AS (
  SELECT `stable_id`, `name`
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE `lowest_level` = TRUE
    AND `species` = 'Homo sapiens'
),
all_pe AS (
  SELECT DISTINCT `pe_stable_id` FROM tas_pe_pathway
),
cont AS (
  SELECT
    lp.`stable_id` AS pathway_id,
    lp.`name`,
    SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS targets_in_pathway,
    SUM(CASE WHEN t.`pe_stable_id` IS NOT NULL AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS targets_outside_pathway,
    SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NOT NULL THEN 1 ELSE 0 END) AS nontargets_in_pathway,
    SUM(CASE WHEN t.`pe_stable_id` IS NULL  AND tp.`pe_stable_id` IS NULL THEN 1 ELSE 0 END) AS nontargets_outside_pathway
  FROM lowest_pathways lp
  CROSS JOIN all_pe ape
  LEFT JOIN tas_pe_pathway tp
    ON ape.`pe_stable_id` = tp.`pe_stable_id`
    AND tp.`pathway_stable_id` = lp.`stable_id`
  LEFT JOIN targets t
    ON ape.`pe_stable_id` = t.`pe_stable_id`
  GROUP BY pathway_id, lp.`name`
),
scored AS (
  SELECT
    pathway_id,
    `name`,
    targets_in_pathway,
    targets_outside_pathway,
    nontargets_in_pathway,
    nontargets_outside_pathway,
    ((targets_in_pathway + targets_outside_pathway + nontargets_in_pathway + nontargets_outside_pathway) *
     POW((targets_in_pathway * nontargets_outside_pathway - targets_outside_pathway * nontargets_in_pathway), 2))
     /
     ((targets_in_pathway + targets_outside_pathway) *
      (nontargets_in_pathway + nontargets_outside_pathway) *
      (targets_in_pathway + nontargets_in_pathway) *
      (targets_outside_pathway + nontargets_outside_pathway)) AS chi2
  FROM cont
)
SELECT
  pathway_id,
  `name`,
  targets_in_pathway,
  targets_outside_pathway,
  nontargets_in_pathway,
  nontargets_outside_pathway,
  chi2
FROM scored
ORDER BY chi2 DESC
LIMIT 3;
```
