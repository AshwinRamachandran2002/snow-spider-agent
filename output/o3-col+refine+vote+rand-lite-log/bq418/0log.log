    WHERE pv.species = 'Homo sapiens'
      AND pv.lowest_level = TRUE
      AND p2p.evidence_code = 'TAS'
  ),
  totals AS (
    SELECT
      (SELECT COUNT(*) FROM targets)  AS tgt_total,
      (SELECT COUNT(*) FROM universe WHERE pe_id NOT IN (SELECT pe_id FROM targets)) AS non_tgt_total
  ),
  counts AS (
    SELECT
      pp.pathway_id,
      COUNTIF(pp.pe_id IN (SELECT pe_id FROM targets))             AS a,
      COUNTIF(pp.pe_id NOT IN (SELECT pe_id FROM targets))         AS c
    FROM path_pe AS pp
    GROUP BY pp.pathway_id
  ),
  chi AS (
    SELECT
      c.pathway_id,
      a,
      (SELECT tgt_total     FROM totals) - a                       AS b,
      c,
      (SELECT non_tgt_total FROM totals) - c                       AS d,
      (
        SAFE_DIVIDE(POW(a - ((a + b) * (a + c) / (a + b + c + d)), 2),
                    ((a + b) * (a + c) / (a + b + c + d)))
      + SAFE_DIVIDE(POW(b - ((a + b) * (b + d) / (a + b + c + d)), 2),
                    ((a + b) * (b + d) / (a + b + c + d)))
      + SAFE_DIVIDE(POW(c - ((c + d) * (a + c) / (a + b + c + d)), 2),
                    ((c + d) * (a + c) / (a + b + c + d)))
      + SAFE_DIVIDE(POW(d - ((c + d) * (b + d) / (a + b + c + d)), 2),
                    ((c + d) * (b + d) / (a + b + c + d)))
      ) AS chi_sq
    FROM counts AS c
    CROSS JOIN totals
  )
  SELECT
    chi.pathway_id,
    pv.name,
    a, b, c, d,
    chi_sq
  FROM chi
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS pv
    ON chi.pathway_id = pv.stable_id
)
SELECT *
FROM chi_table
ORDER BY chi_sq DESC
LIMIT 3;
```

