```sql
-- 8.  For every candidate lowest-level pathway, count:
--       a = # sorafenib targets inside the pathway
--       b = # sorafenib targets outside the pathway
--       c = # non-target entities inside the pathway
--       d = # non-target entities outside the pathway
--     and compute the chi-squared statistic.
WITH
targets AS ( /* query-4 without LIMIT */ ),
universe AS ( /* query-7 without LIMIT */ ),
path_pe AS (
  SELECT
    p2p.`pathway_stable_id` AS pathway_id,
    p2p.`pe_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS p2p
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pv
    ON p2p.`pathway_stable_id` = pv.`stable_id`
  WHERE pv.`species` = 'Homo sapiens'
    AND pv.`lowest_level` = TRUE
    AND p2p.`evidence_code` = 'TAS'
),
stats AS (
  SELECT
    pp.`pathway_id`,
    COUNTIF(pp.`pe_stable_id` IN (SELECT pe_stable_id FROM targets))             AS a,
    (SELECT COUNT(*) FROM targets) - COUNTIF(pp.`pe_stable_id` IN (SELECT pe_stable_id FROM targets)) AS b,
    COUNTIF(pp.`pe_stable_id` NOT IN (SELECT pe_stable_id FROM targets))         AS c,
    (SELECT COUNT(*) FROM universe) - COUNTIF(pp.`pe_stable_id` IN (SELECT pe_stable_id FROM universe)) 
      - ( (SELECT COUNT(*) FROM targets) - COUNTIF(pp.`pe_stable_id` IN (SELECT pe_stable_id FROM targets)) ) AS d
  FROM path_pe AS pp
  GROUP BY pp.`pathway_id`
),
chi AS (
  SELECT
    s.*,
    /* chi-squared for 1 d.f.  𝜒² = Σ ( (O-E)² / E ) over the 4 cells */
    SAFE_DIVIDE( (POW(a - ( (a+b)*(a+c)/(a+b+c+d) ), 2)) ,   ( (a+b)*(a+c)/(a+b+c+d) ) )
  + SAFE_DIVIDE( (POW(b - ( (a+b)*(b+d)/(a+b+c+d) ), 2)) ,   ( (a+b)*(b+d)/(a+b+c+d) ) )
  + SAFE_DIVIDE( (POW(c - ( (c+d)*(a+c)/(a+b+c+d) ), 2)) ,   ( (c+d)*(a+c)/(a+b+c+d) ) )
  + SAFE_DIVIDE( (POW(d - ( (c+d)*(b+d)/(a+b+c+d) ), 2)) ,   ( (c+d)*(b+d)/(a+b+c+d) ) ) AS chi_sq
  FROM stats AS s
)
SELECT
  c.`pathway_id`,
  pv.`name`,
  a, b, c, d,
  chi_sq
FROM chi  AS c
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS pv
  ON c.`pathway_id` = pv.`stable_id`
ORDER BY chi_sq DESC
LIMIT 10;
```

