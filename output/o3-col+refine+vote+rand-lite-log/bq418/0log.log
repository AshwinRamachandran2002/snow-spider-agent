```sql
--Description:  Build a 2×2 contingency table for every lowest-level Homo sapiens
--              Reactome pathway (TAS evidence) versus sorafenib-target physical
--              entities that meet ≤100 nM potency.  Compute
--                  χ² = ((ad − bc)² · N) / ((a+b)(c+d)(a+c)(b+d))
--              and return the 10 pathways with the largest χ² statistics.
WITH
/* 1 ─ Sorafenib physical entities (targets) that satisfy potency filters */
targets AS (
  SELECT DISTINCT pe.stable_id AS pe_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
  JOIN (
    SELECT DISTINCT i.target_uniprotID
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
      ON i.expID = e.expID
    WHERE i.drugID = 157
      AND LOWER(i.targetSpecies) = 'homo sapiens'
      AND e.exp_assayUnits      = 'nM'
      AND e.exp_assayValueMedian <= 100
      AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
      AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
  ) AS hit
  ON pe.uniprot_id = hit.target_uniprotID
),
/* 2 ─ Universe of PEs in any TAS-supported lowest-level H.s. pathway */
universe AS (
  SELECT DISTINCT p2p.pe_stable_id AS pe_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS p2p
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pv
    ON p2p.pathway_stable_id = pv.stable_id
  WHERE pv.species = 'Homo sapiens'
    AND pv.lowest_level = TRUE
    AND p2p.evidence_code = 'TAS'
),
/* 3 ─ Counts of total targets and non-targets in the universe */
totals AS (
  SELECT
    COUNT(*)                                           AS tgt_total,
    COUNTIF(pe_id NOT IN (SELECT pe_id FROM targets))  AS non_tgt_total
  FROM universe
),
/* 4 ─ PE ↔ pathway pairs restricted to TAS / lowest-level / H.s. */
path_pe AS (
  SELECT
    p2p.pathway_stable_id AS pathway_id,
    p2p.pe_stable_id      AS pe_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS p2p
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pv
    ON p2p.pathway_stable_id = pv.stable_id
  WHERE pv.species = 'Homo sapiens'
    AND pv.lowest_level = TRUE
    AND p2p.evidence_code = 'TAS'
),
/* 5 ─ a (targets in) and c (non-targets in) for each pathway */
in_counts AS (
  SELECT
    pathway_id,
    COUNTIF(pe_id IN  (SELECT pe_id FROM targets)) AS a,
    COUNTIF(pe_id NOT IN (SELECT pe_id FROM targets)) AS c
  FROM path_pe
  GROUP BY pathway_id
),
/* 6 ─ add b and d using totals; compute χ² */
stats AS (
  SELECT
    ic.pathway_id,
    ic.a,
    (tot.tgt_total     - ic.a) AS b,
    ic.c,
    (tot.non_tgt_total - ic.c) AS d
  FROM in_counts AS ic
  CROSS JOIN totals AS tot
),
chi AS (
  SELECT
    s.*,
    SAFE_DIVIDE(
      POW( (s.a * s.d) - (s.b * s.c), 2 ) * (s.a + s.b + s.c + s.d),
      (s.a + s.b) * (s.c + s.d) * (s.a + s.c) * (s.b + s.d)
    ) AS chi_sq
  FROM stats AS s
)
SELECT
  chi.pathway_id,
  pv.name,
  a   AS in_targets,
  b   AS out_targets,
  c   AS in_non_targets,
  d   AS out_non_targets,
  chi_sq
FROM chi
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS pv
  ON chi.pathway_id = pv.stable_id
ORDER BY chi_sq DESC
LIMIT 10;
```
