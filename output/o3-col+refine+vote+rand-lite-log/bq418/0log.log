--Description: (10)  Sanity-check: list the sorafenib target physical entities
--                located inside a specific top pathway (replace PATH_ID).
WITH sorafenib_targets AS (
  SELECT DISTINCT pe.stable_id AS pe_id, pe.name
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
  JOIN (
    SELECT DISTINCT target_uniprotID
    FROM (
      SELECT i.target_uniprotID
      FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
      JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
        ON i.expID = e.expID
      WHERE i.drugID = 157
        AND LOWER(i.targetSpecies) = 'homo sapiens'
        AND e.exp_assayUnits = 'nM'
        AND e.exp_assayValueMedian <= 100
        AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
        AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
    )
  ) AS t
  ON pe.uniprot_id = t.target_uniprotID
)
SELECT DISTINCT
  st.pe_id,
  st.name
FROM sorafenib_targets AS st
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS p2p
  ON p2p.pe_stable_id = st.pe_id
WHERE p2p.pathway_stable_id = 'PATH_ID'      -- replace with a pathway_id from step-9
  AND p2p.evidence_code = 'TAS'
LIMIT 20;
