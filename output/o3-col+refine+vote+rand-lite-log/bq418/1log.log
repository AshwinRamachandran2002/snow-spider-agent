--Description: 7)  Contingency table counts for every lowest-level
--              TAS pathway:  A = targets-in-pathway,
--              B = targets-out, C = non-targets-in,
--              D = non-targets-out.
WITH targets AS ( /* from query 6 */ SELECT DISTINCT pe_stable_id FROM (
        SELECT p.stable_id AS pe_stable_id
        FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
        JOIN ( SELECT DISTINCT target_uniprotID AS uniprot
               FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
               JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
                 ON i.expID = e.expID
               WHERE i.drugID IN ( SELECT DISTINCT drugID
                                   FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                                   WHERE LOWER(synonym) LIKE '%sorafenib%' )
                 AND i.targetSpecies = 'Homo sapiens'
                 AND (e.exp_assayUnits IS NULL OR LOWER(e.exp_assayUnits) = 'nm')
                 AND (e.exp_assayValueMedian <= 100 OR e.exp_assayValueMedian IS NULL)
                 AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
                 AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
             ) AS t
        ON p.uniprot_id = t.uniprot ) ),
all_entities AS (
  SELECT DISTINCT pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
),
pm AS (
  SELECT DISTINCT
         ptp.pathway_stable_id,
         ptp.pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  WHERE  ptp.evidence_code = 'TAS'
),
lowest_pathways AS (
  SELECT stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE  lowest_level = TRUE
)
SELECT
  lp.stable_id                    AS pathway_id,
  COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) AS A_targets_in,
  (SELECT COUNT(*) FROM targets) - COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) AS B_targets_out,
  COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NULL THEN pm.pe_stable_id END)  AS C_nontargets_in,
  ( SELECT COUNT(*) FROM all_entities ) 
      - COUNT(DISTINCT pm.pe_stable_id)
      - ( (SELECT COUNT(*) FROM targets) - COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) )
      AS D_nontargets_out
FROM        lowest_pathways            AS lp
LEFT JOIN   pm                         ON lp.stable_id = pm.pathway_stable_id
LEFT JOIN   targets      AS t          ON t.pe_stable_id = pm.pe_stable_id
GROUP BY    lp.stable_id
LIMIT 20;
