```sql
--Description: 5)  Show every lowest-level Reactome pathway
--              supported by TAS evidence that contains at least
--              one sorafenib target physical entity.
SELECT DISTINCT
       ptp.pathway_stable_id,
       pw.name,
       COUNT(DISTINCT ptp.pe_stable_id) AS n_target_entities
FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`        AS pw
       ON pw.stable_id = ptp.pathway_stable_id
JOIN ( SELECT DISTINCT p.stable_id AS pe_stable_id
       FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
       JOIN ( SELECT DISTINCT target_uniprotID AS uniprot
              FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
              JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
                    ON i.expID = e.expID
              WHERE i.drugID IN ( SELECT DISTINCT drugID
                                   FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                                   WHERE LOWER(synonym) LIKE '%sorafenib%' )
                AND i.targetSpecies = 'Homo sapiens'
                AND (e.exp_assayUnits IS NULL OR LOWER(e.exp_assayUnits) = 'nm')
                AND (e.exp_assayValueMedian <= 100 OR e.exp_assayValueMedian IS NULL)
                AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
                AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
            ) AS t
       ON  p.uniprot_id = t.uniprot ) AS st
ON  ptp.pe_stable_id = st.pe_stable_id
WHERE ptp.evidence_code = 'TAS'
  AND pw.lowest_level = TRUE
GROUP BY ptp.pathway_stable_id, pw.name
LIMIT 20;
```

```sql
--Description: 6)  Build a convenience list of *all* sorafenib
--              target physical entities that survive the potency
--              cut-offs (to be reused in later CTEs).
WITH targets AS (
  SELECT DISTINCT p.stable_id AS pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  JOIN ( SELECT DISTINCT target_uniprotID AS uniprot
         FROM   `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
         JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
                ON i.expID = e.expID
         WHERE  i.drugID IN ( SELECT DISTINCT drugID
                               FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                               WHERE LOWER(synonym) LIKE '%sorafenib%' )
           AND  i.targetSpecies = 'Homo sapiens'
           AND  (e.exp_assayUnits IS NULL OR LOWER(e.exp_assayUnits) = 'nm')
           AND  (e.exp_assayValueMedian <= 100 OR e.exp_assayValueMedian IS NULL)
           AND  (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
           AND  (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
       ) AS s
       ON p.uniprot_id = s.uniprot
)
SELECT * FROM targets
LIMIT 20;
```

```sql
--Description: 7)  Contingency table counts for every lowest-level
--              TAS pathway:  A = targets-in-pathway,
--              B = targets-out, C = non-targets-in,
--              D = non-targets-out.
WITH targets AS ( /* from query 6 */ SELECT DISTINCT pe_stable_id FROM (
        SELECT p.stable_id AS pe_stable_id
        FROM   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
        JOIN ( SELECT DISTINCT target_uniprotID AS uniprot
               FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
               JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
                 ON i.expID = e.expID
               WHERE i.drugID IN ( SELECT DISTINCT drugID
                                   FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                                   WHERE LOWER(synonym) LIKE '%sorafenib%' )
                 AND i.targetSpecies = 'Homo sapiens'
                 AND (e.exp_assayUnits IS NULL OR LOWER(e.exp_assayUnits) = 'nm')
                 AND (e.exp_assayValueMedian <= 100 OR e.exp_assayValueMedian IS NULL)
                 AND (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
                 AND (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
             ) AS t
        ON p.uniprot_id = t.uniprot ) ),
all_entities AS (
  SELECT DISTINCT pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
),
pm AS (
  SELECT DISTINCT
         ptp.pathway_stable_id,
         ptp.pe_stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  WHERE  ptp.evidence_code = 'TAS'
),
lowest_pathways AS (
  SELECT stable_id
  FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE  lowest_level = TRUE
)
SELECT
  lp.stable_id                    AS pathway_id,
  COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) AS A_targets_in,
  (SELECT COUNT(*) FROM targets) - COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) AS B_targets_out,
  COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NULL THEN pm.pe_stable_id END)  AS C_nontargets_in,
  ( SELECT COUNT(*) FROM all_entities ) 
      - COUNT(DISTINCT pm.pe_stable_id)
      - ( (SELECT COUNT(*) FROM targets) - COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) )
      AS D_nontargets_out
FROM        lowest_pathways            AS lp
LEFT JOIN   pm                         ON lp.stable_id = pm.pathway_stable_id
LEFT JOIN   targets      AS t          ON t.pe_stable_id = pm.pe_stable_id
GROUP BY    lp.stable_id
LIMIT 20;
```

```sql
--Description: 8)  Compute the χ² statistic for every pathway
--              using the four counts from query 7.
WITH counts AS (
  /* query 7 up to the SELECT clause, without LIMIT */
  SELECT
    lp.stable_id AS pathway_id,
    COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) AS A,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT pe_stable_id FROM targets)) 
      - COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) AS B,
    COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NULL THEN pm.pe_stable_id END)  AS C,
    ( SELECT COUNT(*) FROM all_entities ) 
        - COUNT(DISTINCT pm.pe_stable_id)
        - ( (SELECT COUNT(*) FROM (
                SELECT DISTINCT pe_stable_id FROM targets)) 
            - COUNT(DISTINCT CASE WHEN t.pe_stable_id IS NOT NULL THEN pm.pe_stable_id END) )
        AS D
  FROM        lowest_pathways AS lp
  LEFT JOIN   pm              ON lp.stable_id = pm.pathway_stable_id
  LEFT JOIN   targets    AS t ON t.pe_stable_id = pm.pe_stable_id
  GROUP BY    lp.stable_id
)
SELECT
  pathway_id,
  A, B, C, D,
  SAFE_DIVIDE( (A+B+C+D) * POW((A*D - B*C),2),
               (A+B)*(C+D)*(A+C)*(B+D) )  AS chi_squared
FROM counts
LIMIT 20;
```

```sql
--Description: 9)  Retrieve the three lowest-level TAS pathways
--              that have the highest χ², together with
--              the four contingency counts.
WITH counts AS ( /* same CTE as query 8 */ SELECT * FROM ( /* see above */ ) )
SELECT
  c.pathway_id,
  pw.name,
  c.A  AS targets_in,
  c.B  AS targets_out,
  c.C  AS nontargets_in,
  c.D  AS nontargets_out,
  c.chi_squared
FROM   counts AS c
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
       ON pw.stable_id = c.pathway_id
ORDER BY c.chi_squared DESC
LIMIT 3;
```

```sql
--Description: 10)  Display the full Reactome URLs for the three
--               top pathways obtained in query 9.
SELECT pw.stable_id AS pathway_id, pw.url
FROM   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
WHERE  pw.stable_id IN ( /* paste the three IDs from query 9 */ )
LIMIT 20;
```
