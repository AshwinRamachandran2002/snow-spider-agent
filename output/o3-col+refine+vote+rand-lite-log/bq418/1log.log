Query:
--Description: 2)  Examine all Targetome interactions for those
--              sorafenib `drugID`s, together with the linked
--              experimental potencies.   Only Homo-sapiens
--              targets are kept and the potency thresholds from
--              the task (< =100 nM for median, low, high) are
--              applied.
SELECT DISTINCT
       i.targetID,
       i.targetName,
       i.target_uniprotID,
       e.exp_assayType,
       e.exp_assayUnits,
       e.exp_assayValueLow,
       e.exp_assayValueMedian,
       e.exp_assayValueHigh
FROM   `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
JOIN   `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
       ON i.expID = e.expID
WHERE  i.drugID IN ( SELECT DISTINCT drugID
                     FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                     WHERE LOWER(synonym) LIKE '%sorafenib%' )
  AND  i.targetSpecies = 'Homo sapiens'
  AND  (e.exp_assayUnits IS NULL OR LOWER(e.exp_assayUnits) = 'nm')
  AND  (e.exp_assayValueMedian <= 100 OR e.exp_assayValueMedian IS NULL)
  AND  (e.exp_assayValueLow   <= 100 OR e.exp_assayValueLow   IS NULL)
  AND  (e.exp_assayValueHigh  <= 100 OR e.exp_assayValueHigh  IS NULL)
LIMIT 20;
Answer:
targetID,targetName,target_uniprotID,exp_assayType,exp_assayUnits,exp_assayValueLow,exp_assayValueMedian,exp_assayValueHigh
