```sql
-- 8.  List the number of sorafenib targets present in each eligible lowest-level pathway
WITH targets AS (
      SELECT DISTINCT p.stable_id
      FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
      JOIN (
            SELECT DISTINCT i.target_uniprotID
            FROM  `isb-cgc-bq.targetome_versioned.interactions_v1` i
            JOIN  `isb-cgc-bq.targetome_versioned.experiments_v1`  e
                  ON i.expID = e.expID
            WHERE i.drugID IN (
                    SELECT DISTINCT drugID
                    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                    WHERE LOWER(synonym) LIKE '%sorafenib%')
              AND i.targetSpecies = 'Homo sapiens'
              AND e.exp_assayValueMedian <= 100
              AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
              AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
           ) u
           ON p.uniprot_id = u.target_uniprotID ),
pathway_map AS (
      SELECT DISTINCT pt.pe_stable_id, pt.pathway_stable_id
      FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` pt
      WHERE  pt.evidence_code = 'TAS'
),
lowest_paths AS (
      SELECT stable_id
      FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
      WHERE  lowest_level = TRUE AND species = 'Homo sapiens'
)
SELECT pm.pathway_stable_id,
       COUNT(DISTINCT pm.pe_stable_id) AS n_sorafenib_targets_in_path
FROM   pathway_map pm
JOIN   lowest_paths lp
       ON pm.pathway_stable_id = lp.stable_id
JOIN   targets t
       ON pm.pe_stable_id = t.stable_id
GROUP  BY pm.pathway_stable_id
ORDER  BY n_sorafenib_targets_in_path DESC
LIMIT 20;
```

```sql
-- 9.  Build 2×2 contingency counts and compute the chi-squared statistic for every pathway
WITH targets AS ( /* same CTE as in query 8 */ 
      SELECT DISTINCT p.stable_id
      FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
      JOIN (
            SELECT DISTINCT i.target_uniprotID
            FROM  `isb-cgc-bq.targetome_versioned.interactions_v1` i
            JOIN  `isb-cgc-bq.targetome_versioned.experiments_v1`  e
                  ON i.expID = e.expID
            WHERE i.drugID IN (
                    SELECT DISTINCT drugID
                    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                    WHERE LOWER(synonym) LIKE '%sorafenib%')
              AND i.targetSpecies = 'Homo sapiens'
              AND e.exp_assayValueMedian <= 100
              AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
              AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
           ) u
           ON p.uniprot_id = u.target_uniprotID ),
pathway_map AS (
      SELECT DISTINCT pt.pe_stable_id, pt.pathway_stable_id
      FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` pt
      WHERE  pt.evidence_code = 'TAS'
),
lowest_paths AS (
      SELECT stable_id
      FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
      WHERE  lowest_level = TRUE AND species = 'Homo sapiens'
),
all_pairs AS (
      SELECT lp.stable_id         AS pathway,
             pm.pe_stable_id      AS pe_id,
             IF(pm.pe_stable_id IN (SELECT stable_id FROM targets),1,0) AS is_target
      FROM   lowest_paths lp
      LEFT JOIN pathway_map pm
             ON lp.stable_id = pm.pathway_stable_id
),
agg AS (
      SELECT pathway,
             SUM(CASE WHEN is_target = 1 THEN 1 ELSE 0 END) AS a,               -- targets  in pathway
             SUM(CASE WHEN is_target = 0 THEN 1 ELSE 0 END) AS c                -- non-targets in pathway
      FROM   all_pairs
      GROUP  BY pathway
),
totals AS (
      SELECT COUNT(DISTINCT stable_id) AS total_targets FROM targets
),
chi_calc AS (
      SELECT a.pathway,
             a,
             (tot.total_targets - a)                       AS b,                -- targets  not in pathway
             c,
             (COUNT(*) OVER() - c - tot.total_targets + a) AS d,                -- non-targets not in pathway
             -- Chi-squared with Yates continuity correction omitted
             ( (a+b+c+d) * POW((a*d - b*c),2) ) /
             ( (a+b) * (c+d) * (a+c) * (b+d) )             AS chi_sq
      FROM  agg a
      CROSS JOIN totals tot
)
SELECT pathway, a AS targets_in_path, b AS targets_not_in_path,
       c AS nontargets_in_path, d AS nontargets_not_in_path,
       chi_sq
FROM   chi_calc
ORDER  BY chi_sq DESC
LIMIT 20;
```

```sql
--10.  Report the three lowest-level pathways with the highest chi-squared values
WITH targets AS ( /* identical to query 9 */ 
      SELECT DISTINCT p.stable_id
      FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
      JOIN (
            SELECT DISTINCT i.target_uniprotID
            FROM  `isb-cgc-bq.targetome_versioned.interactions_v1` i
            JOIN  `isb-cgc-bq.targetome_versioned.experiments_v1`  e
                  ON i.expID = e.expID
            WHERE i.drugID IN (
                    SELECT DISTINCT drugID
                    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                    WHERE LOWER(synonym) LIKE '%sorafenib%')
              AND i.targetSpecies = 'Homo sapiens'
              AND e.exp_assayValueMedian <= 100
              AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
              AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
           ) u
           ON p.uniprot_id = u.target_uniprotID ),
pathway_map AS (
      SELECT DISTINCT pt.pe_stable_id, pt.pathway_stable_id
      FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` pt
      WHERE  pt.evidence_code = 'TAS'
),
lowest_paths AS (
      SELECT stable_id, name
      FROM   `isb-cgc-bq.reactome_versioned.pathway_v77`
      WHERE  lowest_level = TRUE AND species = 'Homo sapiens'
),
all_pairs AS (
      SELECT lp.stable_id         AS pathway,
             lp.name              AS pathway_name,
             pm.pe_stable_id      AS pe_id,
             IF(pm.pe_stable_id IN (SELECT stable_id FROM targets),1,0) AS is_target
      FROM   lowest_paths lp
      LEFT JOIN pathway_map pm
             ON lp.stable_id = pm.pathway_stable_id
),
agg AS (
      SELECT pathway, pathway_name,
             SUM(CASE WHEN is_target = 1 THEN 1 ELSE 0 END) AS a,
             SUM(CASE WHEN is_target = 0 THEN 1 ELSE 0 END) AS c
      FROM   all_pairs
      GROUP  BY pathway, pathway_name
),
totals AS ( SELECT COUNT(DISTINCT stable_id) AS total_targets FROM targets ),
chi_calc AS (
      SELECT a.pathway, a.pathway_name,
             a,
             (tot.total_targets - a)                       AS b,
             c,
             (COUNT(*) OVER() - c - tot.total_targets + a) AS d,
             ( (a+b+c+d) * POW((a*d - b*c),2) ) /
             ( (a+b) * (c+d) * (a+c) * (b+d) )             AS chi_sq
      FROM  agg a
      CROSS JOIN totals tot
)
SELECT pathway, pathway_name,
       a AS targets_in_path,
       b AS targets_not_in_path,
       c AS nontargets_in_path,
       d AS nontargets_not_in_path,
       chi_sq
FROM   chi_calc
ORDER  BY chi_sq DESC
LIMIT 3;
```
