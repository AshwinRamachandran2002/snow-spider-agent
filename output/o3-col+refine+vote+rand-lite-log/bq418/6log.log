--Description:  End-to-end query (single statement) that
--  • identifies Reactome physical entities that are potent (≤100 nM) Homo-sapiens
--    targets of sorafenib;
--  • considers only TAS-supported mappings to lowest-level Homo-sapiens pathways;
--  • builds a 2 × 2 contingency table for every such pathway
--      a = # sorafenib targets in pathway
--      b = # sorafenib targets NOT in pathway
--      c = # non-targets in pathway
--      d = # non-targets NOT in pathway
--  • computes the χ² statistic (no Yates correction) for enrichment of targets,
--  • returns the three pathways with the largest χ² together with the four counts.
WITH
/* ---------- 1. potent Homo-sapiens sorafenib targets (Reactome PE stable_ids) ---------- */
targets AS (
  SELECT DISTINCT p.stable_id
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` p
  JOIN (
        SELECT DISTINCT i.target_uniprotID
        FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
        JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e
              ON i.expID = e.expID
        WHERE i.drugID IN (SELECT DISTINCT drugID
                           FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
                           WHERE LOWER(synonym) LIKE '%sorafenib%')
          AND i.targetSpecies = 'Homo sapiens'
          AND e.exp_assayValueMedian <= 100
          AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
          AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
       ) pot
       ON p.uniprot_id = pot.target_uniprotID
),
/* ---------- 2. TAS entity-to-pathway mappings ---------- */
tas_map AS (
  SELECT DISTINCT pe_stable_id, pathway_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`
  WHERE evidence_code = 'TAS'
),
/* ---------- 3. eligible lowest-level Homo-sapiens pathways ---------- */
eligible_paths AS (
  SELECT stable_id, name
  FROM `isb-cgc-bq.reactome_versioned.pathway_v77`
  WHERE lowest_level = TRUE
    AND species       = 'Homo sapiens'
),
/* ---------- 4. universe of entities limited to eligible pathways ---------- */
universe AS (
  SELECT DISTINCT tm.pe_stable_id
  FROM tas_map tm
  JOIN eligible_paths ep ON ep.stable_id = tm.pathway_stable_id
),
/* ---------- 5. per-pathway counts: a and c ---------- */
per_path AS (
  SELECT
      ep.stable_id  AS pathway,
      ep.name       AS pathway_name,
      COUNT(DISTINCT IF(tm.pe_stable_id IN (SELECT * FROM targets),
                        tm.pe_stable_id, NULL))                   AS a,   -- targets in pathway
      COUNT(DISTINCT IF(tm.pe_stable_id NOT IN (SELECT * FROM targets),
                        tm.pe_stable_id, NULL))                   AS c    -- non-targets in pathway
  FROM eligible_paths ep
  JOIN tas_map tm ON tm.pathway_stable_id = ep.stable_id
  GROUP BY pathway, pathway_name
),
/* ---------- 6. global totals ---------- */
totals AS (
  SELECT
    (SELECT COUNT(*) FROM targets ) AS T,    -- total targets
    (SELECT COUNT(*) FROM universe) AS N     -- total entities
),
/* ---------- 7. χ² per pathway ---------- */
chi_calc AS (
  SELECT
    p.pathway,
    p.pathway_name,
    p.a,
    (tot.T - p.a)                                   AS b,                       -- targets not in path
    p.c,
    ((tot.N - tot.T) - p.c)                         AS d,                       -- non-targets not in path
    SAFE_DIVIDE(
      tot.N * POW( (p.a * ((tot.N - tot.T) - p.c)  -  ( (tot.T - p.a) * p.c)), 2 ),
      ( (p.a + (tot.T - p.a)) *
        (p.c + ((tot.N - tot.T) - p.c)) *
        (p.a + p.c) *
        ((tot.T - p.a) + ((tot.N - tot.T) - p.c)) )
    )                                               AS chi_sq
  FROM per_path p
  CROSS JOIN totals tot
)
/* ---------- 8. deliver top-3 pathways ---------- */
SELECT
  pathway,
  pathway_name,
  a AS targets_in_path,
  b AS targets_not_in_path,
  c AS nontargets_in_path,
  d AS nontargets_not_in_path,
  chi_sq
FROM chi_calc
ORDER BY chi_sq DESC
LIMIT 3;
