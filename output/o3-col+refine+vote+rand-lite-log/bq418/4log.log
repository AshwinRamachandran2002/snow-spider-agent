```sql
--Description:  Map the potent sorafenib targets (derived by the same potency
--              filter as step-3) to Reactome physical entities.  The CTE
--              `potent_targets` isolates the unique UniProt IDs; we then join
--              to `physical_entity_v77` to obtain the corresponding Reactome
--              physical-entity stable IDs (pe_stable_id) together with their
--              UniProt IDs and names.
WITH potent_targets AS (
  SELECT DISTINCT i.target_uniprotID
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
    ON i.expID = e.expID
  WHERE i.drugID = 157
    AND e.exp_assayValueMedian <= 100
    AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
    AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
    AND i.target_uniprotID IS NOT NULL
)
SELECT DISTINCT
  pe.stable_id  AS pe_stable_id,
  pe.uniprot_id,
  pe.name
FROM potent_targets AS pt
JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
  ON pe.uniprot_id = pt.target_uniprotID
LIMIT 20;
```

```sql
--Description:  For each potent sorafenib physical entity (pe_stable_id) obtained
--              above, retrieve every TAS-supported, lowest-level Reactome pathway
--              in which it participates.  This will define the “targets-inside”
--              cells for later contingency-table calculations.
WITH potent_pe AS (                       -- step-4 repeated for completeness
  SELECT DISTINCT pe.stable_id AS pe_stable_id
  FROM (
    SELECT DISTINCT i.target_uniprotID
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
      ON i.expID = e.expID
    WHERE i.drugID = 157
      AND e.exp_assayValueMedian <= 100
      AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
      AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      AND i.target_uniprotID IS NOT NULL
  ) AS t
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
    ON pe.uniprot_id = t.target_uniprotID
)
SELECT DISTINCT
  pe.pe_stable_id,
  pp.pathway_stable_id
FROM potent_pe                    AS pe
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  ON pp.pe_stable_id = pe.pe_stable_id
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
  ON pw.stable_id   = pp.pathway_stable_id
WHERE pp.evidence_code = 'TAS'
  AND pw.lowest_level = TRUE
  AND pw.species      = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description:  Build the “universe” set of all Homo sapiens physical entities
--              that have TAS evidence to any lowest-level Reactome pathway.
--              These entities represent potential non-targets when they do not
--              overlap the set of potent sorafenib targets.
SELECT DISTINCT
  pp.pe_stable_id
FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
  ON pw.stable_id = pp.pathway_stable_id
WHERE pp.evidence_code = 'TAS'
  AND pw.lowest_level  = TRUE
  AND pw.species       = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description:  For every lowest-level Homo sapiens pathway with TAS evidence,
--              construct a 2×2 contingency table:
--              a = potent targets inside pathway
--              b = potent targets outside pathway
--              c = non-targets inside pathway
--              d = non-targets outside pathway
--              Counts are computed using DISTINCT physical-entity IDs.
WITH
potent_pe AS (                           -- same CTE as step-5, condensed
  SELECT DISTINCT pe.stable_id
  FROM (
    SELECT DISTINCT i.target_uniprotID
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  e
      ON i.expID = e.expID
    WHERE i.drugID = 157
      AND e.exp_assayValueMedian <= 100
      AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
      AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      AND i.target_uniprotID IS NOT NULL
  ) t
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` pe
    ON pe.uniprot_id = t.target_uniprotID
),
universe AS (                            -- step-6
  SELECT DISTINCT pp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
    ON pw.stable_id = pp.pathway_stable_id
  WHERE pp.evidence_code = 'TAS'
    AND pw.lowest_level  = TRUE
    AND pw.species       = 'Homo sapiens'
),
tas_pathway_pe AS (                      -- mapping of every pe ↔ pathway (TAS, LL)
  SELECT DISTINCT
    pp.pathway_stable_id,
    pp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
    ON pw.stable_id = pp.pathway_stable_id
  WHERE pp.evidence_code = 'TAS'
    AND pw.lowest_level  = TRUE
    AND pw.species       = 'Homo sapiens'
),
totals AS (                              -- pre-compute overall counts
  SELECT
    (SELECT COUNT(DISTINCT pe_stable_id) FROM potent_pe) AS n_targets,
    (SELECT COUNT(DISTINCT pe_stable_id) FROM universe ) AS n_universe
)
SELECT
  pw.stable_id   AS pathway_id,
  pw.name        AS pathway_name,
  COUNT(DISTINCT IF(tp.pe_stable_id IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL)) AS a_targets_in,
  (SELECT n_targets FROM totals)
    - COUNT(DISTINCT IF(tp.pe_stable_id IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL))                 AS b_targets_out,
  COUNT(DISTINCT IF(tp.pe_stable_id NOT IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL))                AS c_nontargets_in,
  (SELECT n_universe FROM totals) - (SELECT n_targets FROM totals)
    - COUNT(DISTINCT IF(tp.pe_stable_id NOT IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL))            AS d_nontargets_out
FROM tas_pathway_pe AS tp
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON pw.stable_id = tp.pathway_stable_id
GROUP BY pathway_id, pathway_name, totals.n_targets, totals.n_universe
LIMIT 20;
```

```sql
--Description:  Compute the chi-squared statistic for every pathway using the
--              contingency-table counts produced in the preceding step (drop
--              the LIMIT when running this query in practice) and rank the
--              pathways by descending χ² value.
WITH stats AS (                           -- paste step-8 without the LIMIT
  SELECT
    pw.stable_id   AS pathway_id,
    pw.name        AS pathway_name,
    COUNT(DISTINCT IF(tp.pe_stable_id IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL)) AS a_targets_in,
    (SELECT n_targets FROM totals)
      - COUNT(DISTINCT IF(tp.pe_stable_id IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL))       AS b_targets_out,
    COUNT(DISTINCT IF(tp.pe_stable_id NOT IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL))      AS c_nontargets_in,
    (SELECT n_universe FROM totals) - (SELECT n_targets FROM totals)
      - COUNT(DISTINCT IF(tp.pe_stable_id NOT IN (SELECT * FROM potent_pe), tp.pe_stable_id, NULL))  AS d_nontargets_out
  FROM tas_pathway_pe AS tp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` pw
    ON pw.stable_id = tp.pathway_stable_id
  GROUP BY pathway_id, pathway_name, totals.n_targets, totals.n_universe
)
SELECT
  pathway_id,
  pathway_name,
  a_targets_in,
  b_targets_out,
  c_nontargets_in,
  d_nontargets_out,
  -- χ² computation
  ( (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out) *
    POW( a_targets_in * d_nontargets_out - b_targets_out * c_nontargets_in , 2 )
    /
    ( (a_targets_in + b_targets_out) *
      (c_nontargets_in + d_nontargets_out) *
      (a_targets_in + c_nontargets_in) *
      (b_targets_out + d_nontargets_out) )
  ) AS chi_sq
FROM stats
ORDER BY chi_sq DESC
LIMIT 10;
```

```sql
