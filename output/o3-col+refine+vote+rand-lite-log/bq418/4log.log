        COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)
      , 2) /
      ( (COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) +
         t.n_targets -
         COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END)) *
        (COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END) +
         (t.n_universe - t.n_targets) -
         COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)) *
        (COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) +
         COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)) *
        (t.n_targets -
         COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) +
         (t.n_universe - t.n_targets) -
         COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END))
      ) ) AS chi_sq
  FROM tas_pathway_pe tp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` pw
    ON pw.stable_id = tp.pathway_stable_id
  LEFT JOIN potent_pe pot
    ON pot.pe_stable_id = tp.pe_stable_id
  CROSS JOIN totals t
  GROUP BY pathway_id, pathway_name, t.n_targets, t.n_universe
)
SELECT
  pathway_id,
  pathway_name,
  a_targets_in   AS targets_in_pathway,
  b_targets_out  AS targets_outside_pathway,
  c_nontargets_in   AS nontargets_in_pathway,
  d_nontargets_out  AS nontargets_outside_pathway,
  chi_sq
FROM stats
ORDER BY chi_sq DESC
LIMIT 3;
