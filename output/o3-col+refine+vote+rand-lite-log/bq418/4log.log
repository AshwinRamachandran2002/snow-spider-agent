Query:
--Description:  Compute chi-squared values for every lowest-level Homo sapiens
--              Reactome pathway (TAS evidence) against the set of potent
--              sorafenib targets, and list the 10 highest χ² pathways.
WITH
/* potent sorafenib physical entities */
potent_pe AS (
  SELECT DISTINCT pe.stable_id AS pe_stable_id
  FROM (
    SELECT DISTINCT i.target_uniprotID
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1`  i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   e
      ON i.expID = e.expID
    WHERE i.drugID = 157
      AND e.exp_assayValueMedian <= 100
      AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
      AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      AND i.target_uniprotID IS NOT NULL
  ) t
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` pe
    ON pe.uniprot_id = t.target_uniprotID
),
/* universe of all TAS-annotated PEs in lowest-level human pathways */
universe AS (
  SELECT DISTINCT pp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` pp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       pw
    ON pw.stable_id = pp.pathway_stable_id
  WHERE pp.evidence_code = 'TAS'
    AND pw.lowest_level  = TRUE
    AND pw.species       = 'Homo sapiens'
),
/* mapping PE ↔ pathway */
tas_pathway_pe AS (
  SELECT DISTINCT
    pp.pathway_stable_id,
    pp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` pp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       pw
    ON pw.stable_id = pp.pathway_stable_id
  WHERE pp.evidence_code = 'TAS'
    AND pw.lowest_level  = TRUE
    AND pw.species       = 'Homo sapiens'
),
/* overall totals */
totals AS (
  SELECT
    COUNT(DISTINCT pe_stable_id)                            AS n_targets,
    (SELECT COUNT(DISTINCT pe_stable_id) FROM universe)     AS n_universe
  FROM potent_pe
),
/* contingency counts per pathway */
stats AS (
  SELECT
    pw.stable_id AS pathway_id,
    pw.name      AS pathway_name,
    COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) AS a_targets_in,
    t.n_targets -
      COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) AS b_targets_out,
    COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)       AS c_nontargets_in,
    (t.n_universe - t.n_targets) -
      COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)     AS d_nontargets_out
  FROM tas_pathway_pe tp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` pw
    ON pw.stable_id = tp.pathway_stable_id
  LEFT JOIN potent_pe pot
    ON pot.pe_stable_id = tp.pe_stable_id
  CROSS JOIN totals t
  GROUP BY pathway_id, pathway_name, t.n_targets, t.n_universe
)
/* χ² calculation and ranking */
SELECT
  pathway_id,
  pathway_name,
  a_targets_in,
  b_targets_out,
  c_nontargets_in,
  d_nontargets_out,
  ( (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out) *
    POW(a_targets_in * d_nontargets_out - b_targets_out * c_nontargets_in, 2) /
    ( (a_targets_in + b_targets_out) *
      (c_nontargets_in + d_nontargets_out) *
      (a_targets_in + c_nontargets_in) *
      (b_targets_out + d_nontargets_out) ) ) AS chi_sq
FROM stats
ORDER BY chi_sq DESC
LIMIT 10
