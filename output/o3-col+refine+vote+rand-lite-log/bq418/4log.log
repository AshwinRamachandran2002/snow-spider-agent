```

```sql
-- 6) Attach TAS-supported pathway memberships (lowest-level only)
WITH pe AS ( /* query-5 */ )
SELECT DISTINCT pe.`pe_stable_id`,
       pp.`pathway_stable_id`
FROM   pe
JOIN   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  ON   pp.`pe_stable_id` = pe.`pe_stable_id`
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
  ON   pw.`stable_id` = pp.`pathway_stable_id`
WHERE  pp.`evidence_code` = 'TAS'
  AND  pw.`lowest_level`  = TRUE
