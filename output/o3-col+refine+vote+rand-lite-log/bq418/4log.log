```sql
-- 7) Build the universe of ALL Homo sapiens physical entities having TAS evidence
--    to any lowest-level pathway (needed for non-target counts)
SELECT DISTINCT pe.`stable_id` AS pe_stable_id
FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
  ON   pe.`stable_id` = pp.`pe_stable_id`
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON   pw.`stable_id` = pp.`pathway_stable_id`
WHERE  pp.`evidence_code` = 'TAS'
  AND  pw.`lowest_level`  = TRUE
  AND  pw.`species`       = 'Homo sapiens'
LIMIT 20;
```

```sql
-- 8) For every lowest-level pathway, count targets & non-targets inside it
WITH
targets AS ( /* query-5 */ ),               -- sorafenib targets (physical entities)
universe AS ( /* query-7 */ ),              -- all eligible physical entities
tas_pathway_pe AS (
  SELECT pp.`pathway_stable_id`,
         pp.`pe_stable_id`
  FROM   `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
    ON   pw.`stable_id` = pp.`pathway_stable_id`
  WHERE  pp.`evidence_code` = 'TAS'
    AND  pw.`lowest_level`  = TRUE
    AND  pw.`species`       = 'Homo sapiens'
)
SELECT
  pw.`stable_id`                         AS pathway_id,
  pw.`name`                              AS pathway_name,
  COUNTIF(tp.`pe_stable_id` IN (SELECT * FROM targets)) AS a_targets_in,
  COUNTIF(tp.`pe_stable_id` NOT IN (SELECT * FROM targets)) AS c_nontargets_in,
  (SELECT COUNT(*) FROM targets) - COUNTIF(tp.`pe_stable_id` IN (SELECT * FROM targets)) AS b_targets_out,
  (SELECT COUNT(*) FROM universe) - (COUNTIF(tp.`pe_stable_id` NOT IN (SELECT * FROM targets))) - (SELECT COUNT(*) FROM targets) + COUNTIF(tp.`pe_stable_id` IN (SELECT * FROM targets)) AS d_nontargets_out
FROM   tas_pathway_pe   AS tp
JOIN   `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON   pw.`stable_id` = tp.`pathway_stable_id`
GROUP BY pathway_id, pathway_name
LIMIT 20;
```

```sql
-- 9) Compute chi-squared statistic for every pathway and rank them
WITH stats AS ( /* query-8 (drop LIMIT) */ )
SELECT
  pathway_id,
  pathway_name,
  a_targets_in,
  b_targets_out,
  c_nontargets_in,
  d_nontargets_out,
  -- χ² = n(ad-bc)² / ((a+b)(c+d)(a+c)(b+d))
  ( (a_targets_in + b_targets_out + c_nontargets_in + d_nontargets_out) *
    POW( (a_targets_in*d_nontargets_out - b_targets_out*c_nontargets_in), 2 )
    /
    ( (a_targets_in + b_targets_out) *
      (c_nontargets_in + d_nontargets_out) *
      (a_targets_in + c_nontargets_in) *
      (b_targets_out + d_nontargets_out) )
  ) AS chi_sq
FROM stats
ORDER BY chi_sq DESC
LIMIT 10;
```

```sql
-- 10) Final answer: show the top-3 pathways (highest χ²) with their four cell counts
WITH stats AS ( /* same CTE as query-9 */ )
SELECT
  pathway_id,
  pathway_name,
  a_targets_in  AS targets_in_pathway,
  b_targets_out AS targets_outside_pathway,
  c_nontargets_in  AS nontargets_in_pathway,
  d_nontargets_out AS nontargets_outside_pathway,
  chi_sq
FROM (
  SELECT *, ROW_NUMBER() OVER (ORDER BY chi_sq DESC) AS rn
  FROM   stats
)
WHERE rn <= 3;
```

Each successive query builds upon the previous ones, culminating (query 10) in the three lowest-level Reactome pathways with TAS evidence that have the highest chi-squared values, together with the requested 2 × 2 contingency counts.
