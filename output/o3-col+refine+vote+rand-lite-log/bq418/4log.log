--Description: Construct a 2×2 contingency table (a = potent targets in pathway,
--             b = potent targets outside, c = non-targets in pathway,
--             d = non-targets outside) for every lowest-level Homo sapiens
--             Reactome pathway that has TAS evidence.  The query:
--             1) derives the Reactome physical entities (PEs) that are potent
--                sorafenib targets (potent_pe);
--             2) builds the universe of all PEs that appear with TAS evidence
--                in any lowest-level human pathway (universe);
--             3) maps every PE to each qualifying pathway (tas_pathway_pe);
--             4) pre-computes overall counts (totals);
--             5) counts a, b, c, d per pathway via conditional aggregation.
WITH
/* 1 ─ Potent sorafenib physical entities (Reactome PE IDs) */
potent_pe AS (
  SELECT DISTINCT pe.stable_id AS pe_stable_id
  FROM (
    SELECT DISTINCT i.target_uniprotID
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1`  AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`   AS e
      ON i.expID = e.expID
    WHERE i.drugID = 157
      AND e.exp_assayValueMedian <= 100
      AND (e.exp_assayValueLow  <= 100 OR e.exp_assayValueLow  IS NULL)
      AND (e.exp_assayValueHigh <= 100 OR e.exp_assayValueHigh IS NULL)
      AND i.target_uniprotID IS NOT NULL
  ) t
  JOIN `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pe
    ON pe.uniprot_id = t.target_uniprotID
),

/* 2 ─ Universe: all PE IDs with TAS evidence in lowest-level human pathways */
universe AS (
  SELECT DISTINCT pp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
    ON pw.stable_id = pp.pathway_stable_id
  WHERE pp.evidence_code = 'TAS'
    AND pw.lowest_level  = TRUE
    AND pw.species       = 'Homo sapiens'
),

/* 3 ─ Mapping of every PE to each pathway (TAS, LL, Homo sapiens) */
tas_pathway_pe AS (
  SELECT DISTINCT
    pp.pathway_stable_id,
    pp.pe_stable_id
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS pp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS pw
    ON pw.stable_id = pp.pathway_stable_id
  WHERE pp.evidence_code = 'TAS'
    AND pw.lowest_level  = TRUE
    AND pw.species       = 'Homo sapiens'
),

/* 4 ─ Overall counts: total potent targets & total universe size */
totals AS (
  SELECT
    COUNT(DISTINCT pe_stable_id)                            AS n_targets,
    (SELECT COUNT(DISTINCT pe_stable_id) FROM universe)     AS n_universe
  FROM potent_pe
)

SELECT
  pw.stable_id AS pathway_id,
  pw.name      AS pathway_name,

  /* a: potent targets inside pathway */
  COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) AS a_targets_in,

  /* b: potent targets outside pathway */
  t.n_targets -
  COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NOT NULL THEN tp.pe_stable_id END) AS b_targets_out,

  /* c: non-targets inside pathway */
  COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)     AS c_nontargets_in,

  /* d: non-targets outside pathway */
  (t.n_universe - t.n_targets) -
  COUNT(DISTINCT CASE WHEN pot.pe_stable_id IS NULL THEN tp.pe_stable_id END)     AS d_nontargets_out
FROM tas_pathway_pe AS tp
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS pw
  ON pw.stable_id = tp.pathway_stable_id
LEFT JOIN potent_pe AS pot                         -- flag PE as potent target
  ON pot.pe_stable_id = tp.pe_stable_id
CROSS JOIN totals AS t                             -- bring overall counts into scope
GROUP BY pathway_id, pathway_name, t.n_targets, t.n_universe
LIMIT 20;
