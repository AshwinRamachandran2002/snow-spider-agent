```sql
-- 5) Map these UniProt IDs onto Reactome physical entities (Homo sapiens only)
WITH targ AS ( /* query-4 */ )
SELECT DISTINCT p.`stable_id`            AS pe_stable_id,
       p.`uniprot_id`,
       p.`name`
FROM   targ
JOIN   `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  ON   p.`uniprot_id` = targ.`target_uniprotID`
WHERE  LOWER(p.`location`) IS NOT NULL   -- optional filter
