  FROM map_all
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS ptw
    ON map_all.`pathway_stable_id` = ptw.`stable_id`
  WHERE ptw.`lowest_level` = TRUE
    AND ptw.`species`      = 'Homo sapiens'
  GROUP BY ptw.`stable_id`, ptw.`name`
),
tot AS (
  SELECT (SELECT COUNT(*) FROM target_pe)     AS T,
         (SELECT COUNT(*) FROM non_target_pe) AS N
)
SELECT c.`stable_id`   AS pathway_id,
       c.`name`        AS pathway_name,
       c.targets_in,
       (tot.T - c.targets_in)     AS targets_out,
       c.nontargets_in,
       (tot.N - c.nontargets_in)  AS nontargets_out,
       (POWER( (c.targets_in * (tot.N - c.nontargets_in)) -
               (c.nontargets_in * (tot.T - c.targets_in)), 2 )
        /
        (CAST(tot.T AS FLOAT64) * tot.N *
         (c.targets_in + c.nontargets_in) *
         ( (tot.T - c.targets_in) + (tot.N - c.nontargets_in) )
       ))                         AS chi_squared
FROM cnt AS c
CROSS JOIN tot
ORDER BY chi_squared DESC
LIMIT 3;
