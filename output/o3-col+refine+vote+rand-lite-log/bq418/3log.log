--Description: Quick look at how many sorafenib target PEs fall into each pathway.
WITH target_pe AS (
  SELECT DISTINCT p.`stable_id`
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  WHERE p.`uniprot_id` IN (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
      ON i.`expID` = e.`expID`
    WHERE i.`drugID` IN (
      SELECT DISTINCT `drugID`
      FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
      WHERE LOWER(`synonym`) LIKE '%sorafenib%'
    )
      AND e.`exp_assayUnits` = 'nM'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  IS NULL OR e.`exp_assayValueLow`  <= 100)
      AND (e.`exp_assayValueHigh` IS NULL OR e.`exp_assayValueHigh` <= 100)
  )
)
SELECT ptw.`stable_id`, ptw.`name`,
       COUNT(DISTINCT ptp.`pe_stable_id`) AS targets_in_pathway
FROM target_pe AS t
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  ON t.`stable_id` = ptp.`pe_stable_id`
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`        AS ptw
  ON ptp.`pathway_stable_id` = ptw.`stable_id`
WHERE ptp.`evidence_code` = 'TAS'
  AND ptw.`lowest_level`   = TRUE
  AND ptw.`species`        = 'Homo sapiens'
GROUP BY ptw.`stable_id`, ptw.`name`
ORDER BY targets_in_pathway DESC
LIMIT 20;
