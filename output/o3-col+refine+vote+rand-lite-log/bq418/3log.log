  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
    ON i.`expID` = e.`expID`
  WHERE i.`drugID` IN (
    SELECT DISTINCT `drugID`
    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
    WHERE LOWER(`synonym`) LIKE '%sorafenib%'
  )
    AND e.`exp_assayUnits` = 'nM'
    AND e.`exp_assayValueMedian` <= 100
    AND (e.`exp_assayValueLow`  IS NULL OR e.`exp_assayValueLow`  <= 100)
    AND (e.`exp_assayValueHigh` IS NULL OR e.`exp_assayValueHigh` <= 100)
)
LIMIT 20;
```

```sql
--Description: Show TAS-evidence pathway mappings (lowest-level, Homo sapiens)
--             for the sorafenib target physical entities.
SELECT DISTINCT pep.`stable_id`              AS pe_id,
       ptp.`pathway_stable_id`               AS pathway_id,
       ptw.`name`                            AS pathway_name
FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS pep
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77`   AS ptp
  ON pep.`stable_id` = ptp.`pe_stable_id`
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`         AS ptw
  ON ptp.`pathway_stable_id` = ptw.`stable_id`
WHERE pep.`uniprot_id` IN (
  SELECT DISTINCT i.`target_uniprotID`
  FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
  JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
    ON i.`expID` = e.`expID`
  WHERE i.`drugID` IN (
    SELECT DISTINCT `drugID`
    FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
    WHERE LOWER(`synonym`) LIKE '%sorafenib%'
  )
    AND e.`exp_assayUnits` = 'nM'
    AND e.`exp_assayValueMedian` <= 100
    AND (e.`exp_assayValueLow`  IS NULL OR e.`exp_assayValueLow`  <= 100)
    AND (e.`exp_assayValueHigh` IS NULL OR e.`exp_assayValueHigh` <= 100)
)
  AND ptp.`evidence_code` = 'TAS'
  AND ptw.`lowest_level`   = TRUE
  AND ptw.`species`        = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description: Retrieve all Homo sapiens physical entities that have TAS-evidence
--             links to lowest-level pathways (background set).
SELECT DISTINCT ptp.`pe_stable_id`
FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS ptw
  ON ptp.`pathway_stable_id` = ptw.`stable_id`
WHERE ptp.`evidence_code` = 'TAS'
  AND ptw.`lowest_level`  = TRUE
  AND ptw.`species`       = 'Homo sapiens'
LIMIT 20;
```

```sql
--Description: Quick look at how many sorafenib target PEs fall into each pathway.
WITH target_pe AS (
  SELECT DISTINCT p.`stable_id`
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  WHERE p.`uniprot_id` IN (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
      ON i.`expID` = e.`expID`
    WHERE i.`drugID` IN (
      SELECT DISTINCT `drugID`
      FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
      WHERE LOWER(`synonym`) LIKE '%sorafenib%'
    )
      AND e.`exp_assayUnits` = 'nM'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  IS NULL OR e.`exp_assayValueLow`  <= 100)
      AND (e.`exp_assayValueHigh` IS NULL OR e.`exp_assayValueHigh` <= 100)
  )
)
SELECT ptw.`stable_id`, ptw.`name`,
       COUNT(DISTINCT ptp.`pe_stable_id`) AS targets_in_pathway
FROM target_pe AS t
JOIN `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  ON t.`stable_id` = ptp.`pe_stable_id`
JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`        AS ptw
  ON ptp.`pathway_stable_id` = ptw.`stable_id`
WHERE ptp.`evidence_code` = 'TAS'
  AND ptw.`lowest_level`   = TRUE
  AND ptw.`species`        = 'Homo sapiens'
GROUP BY ptw.`stable_id`, ptw.`name`
ORDER BY targets_in_pathway DESC
LIMIT 20;
```

```sql
--Description: Compute 2×2 counts and chi-squared value for every eligible pathway,
--             then list the 20 highest chi-squared scores (sanity check).
WITH all_pe AS (
  SELECT DISTINCT ptp.`pe_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS ptw
    ON ptp.`pathway_stable_id` = ptw.`stable_id`
  WHERE ptp.`evidence_code` = 'TAS'
    AND ptw.`lowest_level`  = TRUE
    AND ptw.`species`       = 'Homo sapiens'
),
target_pe AS (
  SELECT DISTINCT p.`stable_id`
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  WHERE p.`uniprot_id` IN (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
      ON i.`expID` = e.`expID`
    WHERE i.`drugID` IN (
      SELECT DISTINCT `drugID`
      FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
      WHERE LOWER(`synonym`) LIKE '%sorafenib%'
    )
      AND e.`exp_assayUnits` = 'nM'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  IS NULL OR e.`exp_assayValueLow`  <= 100)
      AND (e.`exp_assayValueHigh` IS NULL OR e.`exp_assayValueHigh` <= 100)
  )
),
non_target_pe AS (
  SELECT pe_stable_id
  FROM all_pe
  WHERE pe_stable_id NOT IN (SELECT * FROM target_pe)
),
map_all AS (
  SELECT ptp.`pathway_stable_id`, ptp.`pe_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS ptw
    ON ptp.`pathway_stable_id` = ptw.`stable_id`
  WHERE ptp.`evidence_code` = 'TAS'
    AND ptw.`lowest_level`  = TRUE
    AND ptw.`species`       = 'Homo sapiens'
),
cnt AS (
  SELECT ptw.`stable_id`,
         ptw.`name`,
         COUNTIF(pe_stable_id IN (SELECT * FROM target_pe))       AS targets_in,
         COUNTIF(pe_stable_id IN (SELECT * FROM non_target_pe))   AS nontargets_in
  FROM map_all
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS ptw
    ON map_all.`pathway_stable_id` = ptw.`stable_id`
  GROUP BY ptw.`stable_id`, ptw.`name`
),
tot AS (
  SELECT (SELECT COUNT(*) FROM target_pe)      AS T,
         (SELECT COUNT(*) FROM non_target_pe)  AS N
)
SELECT c.`stable_id`, c.`name`,
       c.targets_in,
       (tot.T - c.targets_in)      AS targets_out,
       c.nontargets_in,
       (tot.N - c.nontargets_in)   AS nontargets_out,
       -- χ2 for 2×2 table
       (POWER( (c.targets_in * (tot.N - c.nontargets_in)) -
               (c.nontargets_in * (tot.T - c.targets_in)), 2 )
        /
        (CAST(tot.T AS FLOAT64) * tot.N *
         (c.targets_in + c.nontargets_in) *
         ( (tot.T - c.targets_in) + (tot.N - c.nontargets_in) ) )
       )                           AS chi_sq
FROM cnt  AS c
CROSS JOIN tot
ORDER BY chi_sq DESC
LIMIT 20;
```

```sql
--Description: FINAL ANSWER – the three lowest-level Reactome pathways
--             (TAS evidence) with the largest chi-squared statistics,
--             along with 2×2 contingency-table counts.
WITH all_pe AS (
  SELECT DISTINCT ptp.`pe_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77`       AS ptw
    ON ptp.`pathway_stable_id` = ptw.`stable_id`
  WHERE ptp.`evidence_code` = 'TAS'
    AND ptw.`lowest_level`  = TRUE
    AND ptw.`species`       = 'Homo sapiens'
),
target_pe AS (
  SELECT DISTINCT p.`stable_id`
  FROM `isb-cgc-bq.reactome_versioned.physical_entity_v77` AS p
  WHERE p.`uniprot_id` IN (
    SELECT DISTINCT i.`target_uniprotID`
    FROM `isb-cgc-bq.targetome_versioned.interactions_v1` AS i
    JOIN `isb-cgc-bq.targetome_versioned.experiments_v1`  AS e
      ON i.`expID` = e.`expID`
    WHERE i.`drugID` IN (
      SELECT DISTINCT `drugID`
      FROM `isb-cgc-bq.targetome_versioned.drug_synonyms_v1`
      WHERE LOWER(`synonym`) LIKE '%sorafenib%'
    )
      AND e.`exp_assayUnits` = 'nM'
      AND e.`exp_assayValueMedian` <= 100
      AND (e.`exp_assayValueLow`  IS NULL OR e.`exp_assayValueLow`  <= 100)
      AND (e.`exp_assayValueHigh` IS NULL OR e.`exp_assayValueHigh` <= 100)
  )
),
non_target_pe AS (
  SELECT pe_stable_id
  FROM all_pe
  WHERE pe_stable_id NOT IN (SELECT * FROM target_pe)
),
map_all AS (
  SELECT ptp.`pathway_stable_id`, ptp.`pe_stable_id`
  FROM `isb-cgc-bq.reactome_versioned.pe_to_pathway_v77` AS ptp
  WHERE ptp.`evidence_code` = 'TAS'
),
cnt AS (
  SELECT ptw.`stable_id`,
         ptw.`name`,
         COUNTIF(pe_stable_id IN (SELECT * FROM target_pe))      AS targets_in,
         COUNTIF(pe_stable_id IN (SELECT * FROM non_target_pe))  AS nontargets_in
  FROM map_all
  JOIN `isb-cgc-bq.reactome_versioned.pathway_v77` AS ptw
    ON map_all.`pathway_stable_id` = ptw.`stable_id`
  WHERE ptw.`lowest_level` = TRUE
    AND ptw.`species`      = 'Homo sapiens'
  GROUP BY ptw.`stable_id`, ptw.`name`
),
tot AS (
  SELECT (SELECT COUNT(*) FROM target_pe)     AS T,
         (SELECT COUNT(*) FROM non_target_pe) AS N
)
SELECT c.`stable_id`   AS pathway_id,
       c.`name`        AS pathway_name,
       c.targets_in,
       (tot.T - c.targets_in)     AS targets_out,
       c.nontargets_in,
       (tot.N - c.nontargets_in)  AS nontargets_out,
       (POWER( (c.targets_in * (tot.N - c.nontargets_in)) -
               (c.nontargets_in * (tot.T - c.targets_in)), 2 )
        /
        (CAST(tot.T AS FLOAT64) * tot.N *
         (c.targets_in + c.nontargets_in) *
         ( (tot.T - c.targets_in) + (tot.N - c.nontargets_in) )
       ))                         AS chi_squared
FROM cnt AS c
CROSS JOIN tot
ORDER BY chi_squared DESC
LIMIT 3;
```
