```sql
--Description: Add the exact number of seconds each 2023 month spans  
SELECT EXTRACT(month FROM TO_TIMESTAMP("block_timestamp"/1000000))                        AS "month",
       COUNT(*)                                                                            AS "monthly_tx_count",
       DATEDIFF('second',
                DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1000000)),
                DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1000000)) + INTERVAL '1 month')
                                                                                           AS "seconds_in_month"
FROM   GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE  EXTRACT(year FROM TO_TIMESTAMP("block_timestamp"/1000000)) = 2023
GROUP  BY "month"
ORDER  BY "monthly_tx_count" DESC
