Query:
--Description: Compute 2023 monthly transaction counts, seconds-in-month and TPS (keep 20 rows)  
WITH monthly AS (
    SELECT
        EXTRACT(month FROM TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month",
        COUNT(*)                                                      AS "monthly_tx_count"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
    WHERE EXTRACT(year FROM TO_TIMESTAMP("block_timestamp" / 1000000)) = 2023
    GROUP BY "month"
)
SELECT
    2023                                                                                 AS "year",
    "month",
    "monthly_tx_count",
    DATEDIFF(
        'second',
        DATE_FROM_PARTS(2023, "month", 1),
        DATEADD(month, 1, DATE_FROM_PARTS(2023, "month", 1))
    )                                                                                    AS "seconds_in_month",
    "monthly_tx_count" * 1.0 /
    DATEDIFF(
        'second',
        DATE_FROM_PARTS(2023, "month", 1),
        DATEADD(month, 1, DATE_FROM_PARTS(2023, "month", 1))
