```sql
--Description / Thinking process:
-- Goal: For each month in 2023, we must return:
--        • monthly transaction-row count  (no de-duplication)
--        • exact seconds in that month
--        • transactions-per-second (TPS)
--        • year and month
-- Approach:
--   1) In CTE monthly_counts, pull rows from LOGS restricted to 2023, 
--      extract month, and COUNT(*) grouped by month.
--   2) In the outer SELECT, derive seconds_in_month using
--      DATE_FROM_PARTS(2023, month, 1) as the first day
--      and DATEADD(month, 1, …) for the first day of next month,
--      then DATEDIFF('second', …).
--   3) Compute TPS = count / seconds_in_month.
--   4) Order by monthly_tx_count DESC as requested.
WITH monthly_counts AS (
    SELECT
        EXTRACT(month FROM TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month",
        COUNT(*)                                                      AS "monthly_tx_count"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
    WHERE EXTRACT(year FROM TO_TIMESTAMP("block_timestamp" / 1000000)) = 2023
    GROUP BY "month"
)
SELECT
    2023                                                                                 AS "year",
    "month",
    "monthly_tx_count",
    DATEDIFF(
        'second',
        DATE_FROM_PARTS(2023, "month", 1),
        DATEADD(month, 1, DATE_FROM_PARTS(2023, "month", 1))
    )                                                                                    AS "seconds_in_month",
    "monthly_tx_count" * 1.0 /
    DATEDIFF(
        'second',
        DATE_FROM_PARTS(2023, "month", 1),
        DATEADD(month, 1, DATE_FROM_PARTS(2023, "month", 1))
    )                                                                                    AS "tx_per_second"
FROM   monthly_counts
ORDER  BY "monthly_tx_count" DESC;
```
