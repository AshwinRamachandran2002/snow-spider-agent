)
SELECT
    2023                                                                                 AS "year",
    "month",
    "monthly_tx_count",
    DATEDIFF(
        'second',
        DATE_FROM_PARTS(2023, "month", 1),
        DATEADD(month, 1, DATE_FROM_PARTS(2023, "month", 1))
    )                                                                                    AS "seconds_in_month",
    "monthly_tx_count" * 1.0 /
    DATEDIFF(
        'second',
        DATE_FROM_PARTS(2023, "month", 1),
        DATEADD(month, 1, DATE_FROM_PARTS(2023, "month", 1))
    )                                                                                    AS "tx_per_second"
FROM   monthly
ORDER  BY "monthly_tx_count" DESC
LIMIT  20
