```sql
--Description / Thinking process:
-- We need, for every month that actually appears in 2023 Arbitrum-One logs,
--   1) total number of log rows (no hash de-duplication),
--   2) exact length of that calendar month in seconds (Snowflake’s DATE logic
--      implicitly applies leap-year rules), and
--   3) transactions-per-second = count ÷ seconds.
-- Approach:
--   • Sub-query “m” aggregates the raw table by (year, month) using the
--     micro-second UNIX timestamp column "block_timestamp".
--   • Outer query takes those aggregates, builds the first day of the month
--     with DATE_FROM_PARTS, then finds the second difference to the first day
--     of the next month via DATEADD('month',1,…).  That yields seconds_in_month.
--   • TPS is computed and rounded to 6 decimals.
--   • Final ordering is by monthly_txn_rows descending, as requested.

SELECT
       m."year",
       m."month",
       m."monthly_txn_rows",
       DATEDIFF(
           'second',
           DATE_FROM_PARTS(m."year", m."month", 1),
           DATEADD('month', 1, DATE_FROM_PARTS(m."year", m."month", 1))
       )                                                AS "seconds_in_month",
       ROUND(
           m."monthly_txn_rows"         /
           DATEDIFF(
               'second',
               DATE_FROM_PARTS(m."year", m."month", 1),
               DATEADD('month', 1, DATE_FROM_PARTS(m."year", m."month", 1))
           ),
           6
       )                                                AS "txn_per_second"
FROM (
        SELECT  YEAR(TO_TIMESTAMP("block_timestamp" / 1e6))   AS "year",
                MONTH(TO_TIMESTAMP("block_timestamp" / 1e6))  AS "month",
                COUNT(*)                                      AS "monthly_txn_rows"
        FROM    GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
        WHERE   "block_timestamp" BETWEEN 1672531200000000      -- 2023-01-01 00:00:00 UTC
                                      AND 1704067199000000      -- 2023-12-31 23:59:59 UTC
        GROUP   BY 1, 2
     ) m
ORDER BY m."monthly_txn_rows" DESC;
```
