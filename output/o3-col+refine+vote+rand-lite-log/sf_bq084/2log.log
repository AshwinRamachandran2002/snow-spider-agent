```sql
--Description: Compute transactions-per-second (TPS) for each month in 2023.  
SELECT YEAR(TO_TIMESTAMP("block_timestamp"/1e6))               AS "year",
       MONTH(TO_TIMESTAMP("block_timestamp"/1e6))              AS "month",
       COUNT(*)                                                AS "monthly_txn_rows",
       DATEDIFF('second',
                DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1e6)),
                DATE_TRUNC('month', DATEADD('month', 1, TO_TIMESTAMP("block_timestamp"/1e6)))
               )                                               AS "seconds_in_month",
       COUNT(*) * 1.0
       / DATEDIFF('second',
                  DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp"/1e6)),
                  DATE_TRUNC('month', DATEADD('month', 1, TO_TIMESTAMP("block_timestamp"/1e6)))
                 )                                             AS "tps"
FROM   GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE  "block_timestamp" BETWEEN 1672531200000000 AND 1704067199000000
GROUP  BY 1,2
ORDER  BY "monthly_txn_rows" DESC
LIMIT  20;
```

