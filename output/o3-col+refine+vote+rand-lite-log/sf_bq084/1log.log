```sql
--Description: Peek at a few raw rows in the LOGS table to confirm the columns we will be using.
SELECT *
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
LIMIT 20;
```

```sql
--Description: Display 20 sample rows whose block timestamps fall in calendar-year 2023
--             (convert the stored micro-second epoch to seconds before casting to TIMESTAMP).
SELECT  "block_number",
        "transaction_hash",
        "log_index",
        TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))  AS "ts"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   TO_TIMESTAMP(FLOOR("block_timestamp"/1000000)) 
            BETWEEN '2023-01-01' AND '2023-12-31 23:59:59'
LIMIT 20;
```

```sql
--Description: Quickly see how many individual log records (no de-duplication)
--             occurred on one sample month (January 2023).
SELECT  COUNT(*) AS "jan_2023_log_rows"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = '2023-01-01';
```

```sql
--Description: Check distinct transaction hashes for the same month to understand
--             how many duplicates (multiple log rows per transaction) exist.
SELECT  COUNT(DISTINCT "transaction_hash") AS "distinct_tx_hashes_jan_2023"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = '2023-01-01';
```

```sql
--Description: Aggregate every 2023 month, counting all log records (no de-duplication).
SELECT  DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) AS "month_start",
        COUNT(*)                                                          AS "monthly_log_rows"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = 2023
GROUP BY 1
ORDER BY 2 DESC
LIMIT 20;
```

```sql
--Description: For each 2023 month, also compute the exact amount of seconds in that month
--             (important for February in any leap year calculation).
SELECT  DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000)))               AS "month_start",
        COUNT(*)                                                                           AS "monthly_log_rows",
        DATEDIFF('second',
                 DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))),
                 DATEADD('month', 1,
                         DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))))) AS "seconds_in_month"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = 2023
GROUP BY 1
ORDER BY 2 DESC;
```

```sql
--Description: Produce the final per-month metrics: total log rows, seconds in month,
--             and derived transactions-per-second (tps), ordered by highest volume first.
SELECT  DATE_PART('year',  DATE_TRUNC('month', dt_month))                      AS "year",
        DATE_PART('month', DATE_TRUNC('month', dt_month))                      AS "month",
        monthly_log_rows                                                       AS "monthly_transaction_count",
        ROUND(monthly_log_rows / seconds_in_month, 6)                          AS "tx_per_second"
FROM  (
        SELECT  DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) AS dt_month,
                COUNT(*)                                                            AS monthly_log_rows,
                DATEDIFF('second',
                         DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))),
                         DATEADD('month', 1,
                                 DATE_TRUNC('month', TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))))) AS seconds_in_month
        FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
        WHERE   YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = 2023
        GROUP BY 1
      ) t
ORDER BY "monthly_transaction_count" DESC;
```

```sql
--Description: As a sanity check, look at the minimum and maximum timestamp values found
--             inside 2023 to confirm full coverage of the year.
SELECT  MIN(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) AS "earliest_2023",
        MAX(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) AS "latest_2023"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = 2023;
```

```sql
--Description: Cross-verify the 2023 row count obtained earlier by counting once more
--             (this query is intentionally simple and can act as a performance benchmark).
SELECT  COUNT(*) AS "total_2023_log_rows"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) = 2023;
```

```sql
--Description: Show a quick comparison of monthly row counts between 2022 and 2023
--             (useful context, although not strictly required for the task).
SELECT  YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000)))  AS "year",
        MONTH(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) AS "month",
        COUNT(*)                                              AS "monthly_log_rows"
FROM    "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
WHERE   YEAR(TO_TIMESTAMP(FLOOR("block_timestamp"/1000000))) IN (2022, 2023)
GROUP BY 1,2
ORDER BY 1,2
LIMIT 20;
```
