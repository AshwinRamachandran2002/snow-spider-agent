--Description: We must know the exact number of seconds in every month that appears in 2023 data.  
--1) Convert micro-second “block_timestamp” to TIMESTAMP and truncate to the first day of the month → month_start.  
--2) Collect DISTINCT month_start values for 2023.  
--3) Use LEAD to peek at the next month’s start.  
--4) Instead of subtracting two TIMESTAMPs (which Snowflake disallows directly), use DATEDIFF('second', …) to measure the gap.  
--5) For December 2023, LEAD returns NULL, so fall back to 1-Jan-2024 with DATE_FROM_PARTS.  
WITH months AS (  
    SELECT DISTINCT  
           DATE_TRUNC('MONTH', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month_start"  
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"  
    WHERE DATE_PART('YEAR', TO_TIMESTAMP("block_timestamp" / 1000000)) = 2023  
)  
SELECT  
    "month_start",  
    LEAD("month_start") OVER (ORDER BY "month_start")                                             AS "next_month_start",  
    COALESCE(  
        DATEDIFF('second', "month_start", LEAD("month_start") OVER (ORDER BY "month_start")),  
        DATEDIFF('second', "month_start", DATE_FROM_PARTS(2024, 1, 1))                             -- handles Dec-2023  
    ) AS "seconds_in_month"  
FROM months  
ORDER BY "month_start";
