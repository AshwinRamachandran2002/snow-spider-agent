```sql
--Description: Combine counts with seconds to compute transactions-per-second (preview only).
WITH month_counts AS (
  SELECT
    DATE_TRUNC('MONTH', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month_start",
    COUNT(*)                                                       AS "monthly_log_rows"
  FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
  WHERE DATE_PART('YEAR', TO_TIMESTAMP("block_timestamp" / 1000000)) = 2023
  GROUP BY 1
),
month_seconds AS (
  SELECT
    "month_start",
    COALESCE(
      DATE_PART('EPOCH_SECOND', LEAD("month_start") OVER (ORDER BY "month_start") - "month_start"),
      DATE_PART('EPOCH_SECOND', DATE_FROM_PARTS(2024,1,1) - "month_start")        -- seconds for Dec-2023
    ) AS "seconds_in_month"
  FROM (
    SELECT DISTINCT DATE_TRUNC('MONTH', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month_start"
    FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"
    WHERE DATE_PART('YEAR', TO_TIMESTAMP("block_timestamp" / 1000000)) = 2023
  )
)
SELECT
  c."month_start",
  c."monthly_log_rows",
  s."seconds_in_month",
  c."monthly_log_rows" * 1.0 / s."seconds_in_month"            AS "tx_per_second"
FROM month_counts c
JOIN month_seconds s USING ("month_start")
ORDER BY c."monthly_log_rows" DESC
LIMIT 20;
```

