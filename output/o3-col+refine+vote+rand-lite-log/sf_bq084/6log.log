Query:
--Description: Identify any difference in transaction activity between tables by sampling hash frequency (unchanged).
SELECT
  l."transaction_hash",
  COUNT(*) AS "log_rows",
  COALESCE(SUM(CASE WHEN d."TRANSACTION_HASH" IS NOT NULL THEN 1 ELSE 0 END), 0) AS "decoded_rows"
FROM "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."LOGS"            l
LEFT JOIN "GOOG_BLOCKCHAIN"."GOOG_BLOCKCHAIN_ARBITRUM_ONE_US"."DECODED_EVENTS" d
       ON l."transaction_hash" = d."TRANSACTION_HASH"
WHERE DATE_PART('YEAR', TO_TIMESTAMP(l."block_timestamp" / 1000000)) = 2023
GROUP BY 1
ORDER BY "log_rows" DESC
LIMIT 20
