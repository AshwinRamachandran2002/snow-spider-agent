  EXTRACT(YEAR FROM TO_TIMESTAMP("block_timestamp" / 1000000)) AS "year"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
ORDER BY "year";
```

```sql
--Description: 3) Total number of log rows that fall inside the 2023 calendar year.
SELECT 
  COUNT(*) AS "total_logs_2023"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
  AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01';
```

```sql
--Description: 4) Get the raw monthly counts of log rows for 2023 (year-month granularity).
SELECT 
  EXTRACT(YEAR  FROM TO_TIMESTAMP("block_timestamp" / 1000000)) AS "year",
  EXTRACT(MONTH FROM TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month",
  COUNT(*) AS "monthly_log_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
  AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01'
GROUP BY 1,2
ORDER BY 3 DESC
LIMIT 20;
```

```sql
--Description: 5) For the same 2023 period, add the exact number of seconds in each month (inclusive of leap-year logic).
SELECT
  DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))                AS "month_start",
  DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))) AS "next_month_start",
  COUNT(*) AS "monthly_log_count",
  DATEDIFF('second',
           DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)),
           DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)))
          ) AS "seconds_in_month"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
  AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01'
GROUP BY 1,2
ORDER BY 3 DESC
LIMIT 20;
```

```sql
--Description: 6) Compute transactions-per-second (TPS) for each 2023 month, sorted by count descending.
SELECT
  EXTRACT(YEAR  FROM "month_start")  AS "year",
  EXTRACT(MONTH FROM "month_start")  AS "month",
  "monthly_log_count",
  "monthly_log_count" / "seconds_in_month" ::FLOAT AS "tps"
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))                AS "month_start",
    DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))) AS "next_month_start",
    COUNT(*) AS "monthly_log_count",
    DATEDIFF('second',
             DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)),
             DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)))
            ) AS "seconds_in_month"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
  WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
    AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01'
  GROUP BY 1,2
)
ORDER BY "monthly_log_count" DESC
LIMIT 20;
```

```sql
--Description: 7) Same TPS calculation but adding the starting and ending ISO-dates for clarity.
SELECT
  "month_start"        AS "month_begin_date",
  "next_month_start"   AS "month_end_date",
  "monthly_log_count",
  "monthly_log_count" / "seconds_in_month"::FLOAT AS "tps"
FROM (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))                AS "month_start",
    DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))) AS "next_month_start",
    COUNT(*) AS "monthly_log_count",
    DATEDIFF('second',
             DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)),
             DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)))
            ) AS "seconds_in_month"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
  WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
    AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01'
  GROUP BY 1,2
)
ORDER BY "monthly_log_count" DESC
LIMIT 20;
```

```sql
--Description: 8) Retrieve the single month with the highest transactions-per-second (peak month of 2023).
WITH monthly AS (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "m",
    COUNT(*) AS "cnt",
    DATEDIFF('second',
             DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)),
             DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)))
            ) AS "sec"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
  WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
    AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01'
  GROUP BY 1
)
SELECT 
  EXTRACT(YEAR  FROM "m") AS "year",
  EXTRACT(MONTH FROM "m") AS "month",
  "cnt"                   AS "monthly_log_count",
  "cnt" / "sec"::FLOAT    AS "tps"
FROM monthly
ORDER BY "tps" DESC
LIMIT 1;
```

