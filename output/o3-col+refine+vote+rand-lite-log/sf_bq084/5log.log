Query:
--Description: 5) For the same 2023 period, add the exact number of seconds in each month (inclusive of leap-year logic).
SELECT
  DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))                AS "month_start",
  DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000))) AS "next_month_start",
  COUNT(*) AS "monthly_log_count",
  DATEDIFF('second',
           DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)),
           DATEADD('month', 1, DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)))
          ) AS "seconds_in_month"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US."LOGS"
WHERE TO_TIMESTAMP("block_timestamp" / 1000000) >= '2023-01-01'
  AND TO_TIMESTAMP("block_timestamp" / 1000000) <  '2024-01-01'
GROUP BY 1,2
ORDER BY 3 DESC
LIMIT 20;
