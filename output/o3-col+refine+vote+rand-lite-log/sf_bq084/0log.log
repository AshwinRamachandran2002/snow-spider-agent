```sql
--Description: 1) Preview a handful of raw log records to understand all columns.
SELECT 
  "transaction_hash",
  "block_number",
  "block_timestamp",
  "log_index",
  "address",
  "topics",
  "data"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
LIMIT 20;
```

```sql
--Description: 2) Show some 2023-era logs by filtering on the micro-second Unix-epoch range  
--(2023-01-01 00:00:00  ➜  2024-01-01 00:00:00).
SELECT 
  "transaction_hash",
  "block_number",
  "block_timestamp"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE "block_timestamp" >= 1672531200*1000000   -- 2023-01-01
  AND "block_timestamp" < 1704067200*1000000    -- 2024-01-01
LIMIT 20;
```

```sql
--Description: 3) Obtain the total raw log count across the whole data set.
SELECT 
  COUNT(*) AS "total_log_rows"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS;
```

```sql
--Description: 4) Count all log rows that fall inside calendar year 2023.
SELECT 
  COUNT(*) AS "log_rows_2023"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE "block_timestamp" >= 1672531200*1000000
  AND "block_timestamp" < 1704067200*1000000;
```

```sql
--Description: 5) Aggregate 2023 log rows by month to get raw monthly counts.  
--Convert micro-seconds ➜ seconds ➜ timestamp, then truncate to month.
SELECT
  DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month_start",
  COUNT(*) AS "monthly_tx_count"
FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
WHERE "block_timestamp" >= 1672531200*1000000
  AND "block_timestamp" < 1704067200*1000000
GROUP BY 1
ORDER BY "month_start"
LIMIT 20;
```

```sql
--Description: 6) For each 2023 month, compute the exact number of seconds it spans.  
--DATEDIFF gives the difference between the first day of next month and the current month.
WITH months AS (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "m"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  WHERE "block_timestamp" >= 1672531200*1000000
    AND "block_timestamp" < 1704067200*1000000
  GROUP BY 1
)
SELECT
  "m" AS "month_start",
  DATEDIFF('second', "m", DATEADD(month, 1, "m")) AS "seconds_in_month"
FROM months
ORDER BY "month_start";
```

```sql
--Description: 7) Join monthly counts with seconds-per-month to derive transactions-per-second.
WITH monthly AS (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "month_start",
    COUNT(*) AS "monthly_tx_count"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  WHERE "block_timestamp" >= 1672531200*1000000
    AND "block_timestamp" < 1704067200*1000000
  GROUP BY 1
), secs AS (
  SELECT
    "m" AS "month_start",
    DATEDIFF('second', "m", DATEADD(month, 1, "m")) AS "seconds_in_month"
  FROM (
    SELECT DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "m"
    FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
    WHERE "block_timestamp" >= 1672531200*1000000
      AND "block_timestamp" < 1704067200*1000000
    GROUP BY 1
  )
)
SELECT
  m."month_start",
  m."monthly_tx_count",
  s."seconds_in_month",
  m."monthly_tx_count" / s."seconds_in_month" AS "tx_per_second"
FROM monthly m
JOIN secs s USING ("month_start")
ORDER BY m."monthly_tx_count" DESC;
```

