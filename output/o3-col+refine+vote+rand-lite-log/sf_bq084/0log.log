Query:
--Description: 6) For each 2023 month, compute the exact number of seconds it spans.  
--DATEDIFF gives the difference between the first day of next month and the current month.
WITH months AS (
  SELECT
    DATE_TRUNC('month', TO_TIMESTAMP("block_timestamp" / 1000000)) AS "m"
  FROM GOOG_BLOCKCHAIN.GOOG_BLOCKCHAIN_ARBITRUM_ONE_US.LOGS
  WHERE "block_timestamp" >= 1672531200*1000000
    AND "block_timestamp" < 1704067200*1000000
  GROUP BY 1
)
SELECT
  "m" AS "month_start",
  DATEDIFF('second', "m", DATEADD(month, 1, "m")) AS "seconds_in_month"
FROM months
ORDER BY "month_start";
