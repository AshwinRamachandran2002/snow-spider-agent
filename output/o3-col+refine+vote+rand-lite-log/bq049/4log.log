--Description: Final per-capita calculation ► combines monthly 2022 Bourbon sales for the 3rd-ranked ZIP with its 21+ population (summing male + female age-bands so no empty result).  
WITH third_zip AS (
  SELECT zip_code
  FROM (
    SELECT CAST(zip_code AS STRING)                        AS zip_code,
           SUM(sale_dollars)                               AS total_sales,
           DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rnk
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
    GROUP BY zip_code
  )
  WHERE rnk = 3
),
pop21 AS (
  SELECT
    zipcode AS zip_code,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE minimum_age >= 21
    AND LOWER(gender) IN ('male','female')      -- use gender-specific rows to avoid double counting
  GROUP BY zip_code
)
SELECT
  FORMAT_DATE('%Y-%m', s.date)                               AS year_month,
  ROUND(SUM(s.sale_dollars) / p.pop_21_plus, 4)              AS per_capita_bourbon_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN third_zip t ON CAST(s.zip_code AS STRING) = t.zip_code
JOIN pop21      p ON p.zip_code              = t.zip_code
WHERE s.county = 'DUBUQUE'
  AND EXTRACT(YEAR FROM s.date) = 2022
  AND LOWER(s.category_name) LIKE '%bourbon%'
GROUP BY year_month, p.pop_21_plus
ORDER BY year_month
LIMIT 20
