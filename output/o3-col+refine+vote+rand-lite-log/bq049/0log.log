```sql
--Description: 7)  Compute population aged 21+ for that ZIP.
SELECT
  r.sanitized_zip AS zipcode,
  SUM(p.population) AS pop_21_plus
FROM (
  SELECT sanitized_zip
  FROM (
    SELECT
      REGEXP_EXTRACT(CAST(zip_code AS STRING), r'^(\d{5})') AS sanitized_zip,
      SUM(sale_dollars) AS total_sales,
      ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS sales_rank
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
    GROUP BY sanitized_zip
  )
  WHERE sales_rank = 3
) AS r
JOIN `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p
ON p.zipcode = r.sanitized_zip
WHERE p.minimum_age >= 21            -- age band starts at 21 or higher
GROUP BY zipcode
LIMIT 20;
```

```sql
--Description: 8)  Monthly 2022 per-capita Bourbon sales (using pop 21+).
WITH ranked_zip AS (
  SELECT sanitized_zip
  FROM (
    SELECT
      REGEXP_EXTRACT(CAST(zip_code AS STRING), r'^(\d{5})') AS sanitized_zip,
      SUM(sale_dollars) AS total_sales,
      ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS sales_rank
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
    GROUP BY sanitized_zip
  )
  WHERE sales_rank = 3
),
pop21 AS (
  SELECT
    zipcode,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE zipcode IN (SELECT sanitized_zip FROM ranked_zip)
    AND minimum_age >= 21
  GROUP BY zipcode
)
SELECT
  FORMAT_DATE('%Y-%m', s.date) AS month,
  SUM(s.sale_dollars) AS monthly_sales_dollars,
  p.pop_21_plus,
  SUM(s.sale_dollars) / p.pop_21_plus AS sales_per_capita_dollars
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN ranked_zip r
  ON REGEXP_EXTRACT(CAST(s.zip_code AS STRING), r'^(\d{5})') = r.sanitized_zip
JOIN pop21 p
  ON p.zipcode = r.sanitized_zip
WHERE s.county = 'DUBUQUE'
  AND EXTRACT(YEAR FROM s.date) = 2022
  AND LOWER(s.category_name) LIKE '%bourbon%'
GROUP BY month, p.pop_21_plus
ORDER BY month
LIMIT 20;
```
