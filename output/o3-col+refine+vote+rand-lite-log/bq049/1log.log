--Description: ⑦  Fetch the 21+ population for the ZIP that ranks 3rd in 2022 Dubuque-County bourbon sales
WITH ranked AS (
  SELECT
    REGEXP_EXTRACT(CAST(s.`zip_code` AS STRING), r'^\d{5}') AS zip5,
    DENSE_RANK() OVER (ORDER BY SUM(s.`sale_dollars`) DESC) AS rk
  FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
  WHERE s.`county` = 'DUBUQUE'
    AND EXTRACT(YEAR FROM s.`date`) = 2022
    AND LOWER(s.`category_name`) LIKE '%bourbon%'
  GROUP BY zip5
)
SELECT
  c.`zipcode`,
  SUM(c.`population`) AS pop_21_plus
FROM ranked AS r
JOIN `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS c
  ON c.`zipcode` = r.zip5
WHERE r.rk = 3
  AND c.`minimum_age` >= 21
GROUP BY c.`zipcode`
LIMIT 20
