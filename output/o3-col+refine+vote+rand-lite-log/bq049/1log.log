```sql
--Description: ⑥  Age-21+ population for every Dubuque-County ZIP that appears in the liquor table.  
--Liquor ZIPs sometimes carry a “.0”, so we trim them to the first 5 digits before matching.
SELECT
  c.`zipcode`,
  SUM(c.`population`) AS pop_21_plus
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS c
WHERE c.`minimum_age` >= 21
  AND c.`zipcode` IN (
        SELECT DISTINCT REGEXP_EXTRACT(CAST(s.`zip_code` AS STRING), r'^\d{5}')
        FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
        WHERE s.`county` = 'DUBUQUE'
      )
GROUP BY c.`zipcode`
LIMIT 20;
```

```sql
--Description: ⑦  Fetch the 21+ population for the ZIP that ranks 3rd in 2022 Dubuque-County bourbon sales
WITH ranked AS (
  SELECT
    REGEXP_EXTRACT(CAST(s.`zip_code` AS STRING), r'^\d{5}') AS zip5,
    DENSE_RANK() OVER (ORDER BY SUM(s.`sale_dollars`) DESC) AS rk
  FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
  WHERE s.`county` = 'DUBUQUE'
    AND EXTRACT(YEAR FROM s.`date`) = 2022
    AND LOWER(s.`category_name`) LIKE '%bourbon%'
  GROUP BY zip5
)
SELECT
  c.`zipcode`,
  SUM(c.`population`) AS pop_21_plus
FROM ranked AS r
JOIN `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS c
  ON c.`zipcode` = r.zip5
WHERE r.rk = 3
  AND c.`minimum_age` >= 21
GROUP BY c.`zipcode`
LIMIT 20;
```

```sql
--Description: ⑧  Monthly per-capita bourbon sales (based on 21+ population) for the 3rd-ranking ZIP in 2022
WITH third_zip AS (
  SELECT zip5
  FROM (
    SELECT
      REGEXP_EXTRACT(CAST(`zip_code` AS STRING), r'^\d{5}') AS zip5,
      DENSE_RANK() OVER (ORDER BY SUM(`sale_dollars`) DESC) AS rk
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE `county` = 'DUBUQUE'
      AND EXTRACT(YEAR FROM `date`) = 2022
      AND LOWER(`category_name`) LIKE '%bourbon%'
    GROUP BY zip5
  )
  WHERE rk = 3
),
pop AS (
  SELECT SUM(`population`) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE `zipcode` IN (SELECT zip5 FROM third_zip)
    AND `minimum_age` >= 21
)
SELECT
  FORMAT_DATE('%Y-%m', s.`date`) AS year_month,
  SUM(s.`sale_dollars`) / pop.pop_21_plus AS per_capita_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
JOIN third_zip z
  ON REGEXP_EXTRACT(CAST(s.`zip_code` AS STRING), r'^\d{5}') = z.zip5
CROSS JOIN pop
WHERE s.`county` = 'DUBUQUE'
  AND EXTRACT(YEAR FROM s.`date`) = 2022
  AND LOWER(s.`category_name`) LIKE '%bourbon%'
GROUP BY year_month, pop.pop_21_plus
ORDER BY year_month
LIMIT 20;
