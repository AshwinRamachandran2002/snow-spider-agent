                      GROUP BY `zip_code`
                    )
                WHERE rk = 3
              ) z
        JOIN `bigquery-public-data.census_bureau_usa.population_by_zip_2010` c
          ON z.`zip_code` = c.`zipcode`
        WHERE c.`minimum_age` >= 21
        GROUP BY c.`zipcode`
