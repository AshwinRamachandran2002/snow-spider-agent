Query:
--Description: ④  Find the ZIP code that ranks third in Dubuque’s 2022 bourbon sales
SELECT `zip_code`,
       total_sales,
       ranking
FROM (
  SELECT `zip_code`,
         SUM(`sale_dollars`) AS total_sales,
         DENSE_RANK() OVER (ORDER BY SUM(`sale_dollars`) DESC) AS ranking
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM `date`) = 2022
    AND LOWER(`category_name`) LIKE '%bourbon%'
  GROUP BY `zip_code`
)
WHERE ranking = 3
LIMIT 20;
