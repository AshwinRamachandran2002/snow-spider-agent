Query:
--Description: 7)  Monthly 2022 Bourbon sales dollars for ZIP 52003  
--               (no changes needed to the liquor-sales logic; only minor cleanup of the
--               RegExp so one back-slash is used instead of the doubled “\\d{5}”). 
WITH sales_2022 AS (
  SELECT
    DATE_TRUNC(`date`, MONTH) AS sales_month,
    SUM(`sale_dollars`)       AS monthly_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE `county` = 'DUBUQUE'
    AND EXTRACT(YEAR FROM `date`) = 2022
    AND LOWER(`category_name`) LIKE '%bourbon%'
    AND REGEXP_EXTRACT(`zip_code`, r'(\d{5})') = '52003'
  GROUP BY sales_month
)
SELECT *
FROM   sales_2022
ORDER  BY sales_month
LIMIT 20
