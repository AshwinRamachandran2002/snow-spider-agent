```sql
--Description: 3)  Aggregate 2022 Bourbon sales dollars by ZIP code (cleaned to 5 digits)  
--                for Dubuque county and rank them to find the 3rd-highest ZIP.
WITH z AS (
  SELECT REGEXP_EXTRACT(`zip_code`, r'(\d{5})') AS zip5,
         SUM(`sale_dollars`)                    AS bourbon_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
  GROUP  BY zip5
)
SELECT zip5,
       bourbon_sales,
       DENSE_RANK() OVER (ORDER BY bourbon_sales DESC) AS sales_rank
FROM   z
ORDER  BY bourbon_sales DESC
LIMIT 20;
