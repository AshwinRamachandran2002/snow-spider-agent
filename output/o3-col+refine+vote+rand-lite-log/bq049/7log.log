```sql
--Description:  One‐statement solution with inline reasoning.
--  • top_zip :  Find the ZIP that finishes 3rd in 2022 Bourbon-whiskey sales for Dubuque County
--               (QUALIFY lets us filter on the analytic rank without a sub-query).
--  • pop      :  2010 adult (age 21+) population for that ZIP.  The census table stores the
--               five-year age-band rows separately for each gender (“male”, “female”); the
--               overall-total rows have NULL ages, so we SUM only the male+female rows whose
--               minimum_age ≥ 21 to avoid double counting.
--  • month_sales :  Aggregate 2022 Bourbon sales dollars by month for that ZIP.
--  • Result   :  Divide each month’s sales by the adult population to obtain per-capita
--               dollars and format the month as YYYY-MM.
WITH top_zip AS (
  SELECT REGEXP_EXTRACT(zip_code, r'(\d{5})') AS zip5
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  county = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM date) = 2022
    AND  LOWER(category_name) LIKE '%bourbon%'
  GROUP  BY zip5
  QUALIFY DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC) = 3    -- 3rd-highest ZIP
),
pop AS (
  SELECT SUM(population) AS pop_21_plus
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE  zipcode IN (SELECT zip5 FROM top_zip)
    AND  LOWER(gender) IN ('male','female')     -- use male + female rows
    AND  minimum_age >= 21                      -- adults (21+)
),
month_sales AS (
  SELECT DATE_TRUNC(date, MONTH) AS month_start,
         SUM(sale_dollars)       AS monthly_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  county = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM date) = 2022
    AND  LOWER(category_name) LIKE '%bourbon%'
    AND  REGEXP_EXTRACT(zip_code, r'(\d{5})') IN (SELECT zip5 FROM top_zip)
  GROUP  BY month_start
)
SELECT FORMAT_DATE('%Y-%m', month_start)          AS month,
       ROUND(monthly_sales / pop_21_plus, 4)      AS per_capita_bourbon_sales_dollars
FROM   month_sales
CROSS  JOIN pop
ORDER  BY month;
```
