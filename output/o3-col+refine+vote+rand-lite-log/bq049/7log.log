Query:
--Description: 8)  Per-capita Bourbon sales: update the population CTE so it sums rows for
--                ZIP 52003 irrespective of `gender` value (NULL or '').  
--                Also keep the single-slash RegExp in the sales CTE.
WITH pop AS (
  SELECT SUM(`population`) AS pop_21_plus
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE  `zipcode`     = '52003'
    AND  (`gender` IS NULL OR `gender` = '')
    AND  `minimum_age` >= 21
),
sales AS (
  SELECT DATE_TRUNC(`date`, MONTH) AS sales_month,
         SUM(`sale_dollars`)       AS monthly_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
    AND  REGEXP_EXTRACT(`zip_code`, r'(\d{5})') = '52003'
  GROUP  BY sales_month
)
SELECT
  sales_month,
  ROUND(monthly_sales / pop_21_plus, 4) AS per_capita_sales_dollars
FROM  sales, pop
ORDER BY sales_month
LIMIT 20
Answer:
sales_month,per_capita_sales_dollars
