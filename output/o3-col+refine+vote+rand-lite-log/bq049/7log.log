--Description: 4)  Pull the ZIP that ranks 3rd (one row expected, shown here for inspection).
WITH z AS (
  SELECT REGEXP_EXTRACT(`zip_code`, r'(\d{5})') AS zip5,
         SUM(`sale_dollars`)                    AS bourbon_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
  GROUP  BY zip5
),
r AS (
  SELECT zip5, bourbon_sales,
         DENSE_RANK() OVER (ORDER BY bourbon_sales DESC) AS rnk
  FROM   z
