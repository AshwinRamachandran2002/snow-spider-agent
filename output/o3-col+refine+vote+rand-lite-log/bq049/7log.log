```sql
--Description: 7)  Monthly 2022 Bourbon sales dollars for that ZIP.
WITH sales_2022 AS (
  SELECT DATE_TRUNC(`date`, MONTH)               AS sales_month,
         SUM(`sale_dollars`)                    AS monthly_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
    AND  REGEXP_EXTRACT(`zip_code`, r'(\d{5})') = '<<ZIP5>>'
  GROUP  BY sales_month
)
SELECT *
FROM   sales_2022
ORDER  BY sales_month
LIMIT 20;
```

```sql
--Description: 8)  Combine population (21+) with the monthly sales to get per-capita Bourbon sales.  
--                Result is “dollars per resident age 21+”.
WITH pop AS (
  SELECT `zipcode`, SUM(`population`) AS pop_21_plus
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE  `zipcode`     = '<<ZIP5>>'
    AND  `gender`      = ''
    AND  `minimum_age` >= 21
  GROUP  BY `zipcode`
),
sales AS (
  SELECT DATE_TRUNC(`date`, MONTH)               AS sales_month,
         SUM(`sale_dollars`)                    AS monthly_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
    AND  REGEXP_EXTRACT(`zip_code`, r'(\d{5})') = '<<ZIP5>>'
  GROUP  BY sales_month
)
SELECT s.sales_month,
       ROUND(s.monthly_sales / p.pop_21_plus, 4) AS per_capita_sales_dollars
FROM   sales AS s
JOIN   pop   AS p
ON     TRUE
ORDER  BY s.sales_month
LIMIT 20;
```

```sql
--Description: 9)  (Optional check) Show the same per-capita figures but also include cumulative-to-date numbers.
WITH pop AS (
  SELECT `zipcode`, SUM(`population`) AS pop_21_plus
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE  `zipcode`     = '<<ZIP5>>'
    AND  `gender`      = ''
    AND  `minimum_age` >= 21
  GROUP  BY `zipcode`
),
sales AS (
  SELECT DATE_TRUNC(`date`, MONTH)               AS sales_month,
         SUM(`sale_dollars`)                    AS monthly_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
    AND  REGEXP_EXTRACT(`zip_code`, r'(\d{5})') = '<<ZIP5>>'
  GROUP  BY sales_month
)
SELECT s.sales_month,
       ROUND(s.monthly_sales / p.pop_21_plus, 4)                         AS per_capita_sales_dollars,
       ROUND(SUM(s.monthly_sales) OVER (ORDER BY s.sales_month)
/ p.pop_21_plus, 4)                                                      AS cumulative_per_capita
FROM   sales AS s
JOIN   pop   AS p ON TRUE
ORDER  BY s.sales_month
LIMIT 20;
```

```sql
--Description: 10)  (Final concise answer) the monthly per-capita Bourbon sales for 2022  
--                 in Dubuque county for the ZIP that ranked 3rd in total Bourbon sales.  
--                 The CTE “ranked_zip” auto-detects that 3rd-place ZIP, so no manual
--                 replacement is required.
WITH ranked_zip AS (
  SELECT REGEXP_EXTRACT(`zip_code`, r'(\d{5})') AS zip5,
         SUM(`sale_dollars`)                    AS total_sales,
         DENSE_RANK() OVER (ORDER BY SUM(`sale_dollars`) DESC) AS rnk
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
  GROUP  BY zip5
  HAVING rnk = 3
),
pop AS (
  SELECT `zipcode`, SUM(`population`) AS pop_21_plus
  FROM   `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE  `gender`      = ''
    AND  `minimum_age` >= 21
    AND  `zipcode` IN (SELECT zip5 FROM ranked_zip)
  GROUP  BY `zipcode`
),
month_sales AS (
  SELECT DATE_TRUNC(`date`, MONTH)               AS sales_month,
         SUM(`sale_dollars`)                    AS monthly_sales
  FROM   `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE  `county` = 'DUBUQUE'
    AND  EXTRACT(YEAR FROM `date`) = 2022
    AND  LOWER(`category_name`) LIKE '%bourbon%'
    AND  REGEXP_EXTRACT(`zip_code`, r'(\d{5})') IN (SELECT zip5 FROM ranked_zip)
  GROUP  BY sales_month
)
SELECT FORMAT_DATE('%Y-%m', sales_month) AS month,
       ROUND(monthly_sales / pop_21_plus, 4) AS per_capita_bourbon_sales_dollars
FROM   month_sales
CROSS  JOIN pop
ORDER  BY month
LIMIT 20;
```
