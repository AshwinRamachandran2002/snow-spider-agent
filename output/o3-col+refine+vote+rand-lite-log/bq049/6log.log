Query:
--Description: Monthly bourbon sales during 2022 for that 3rd-place ZIP
WITH third_zip AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
  ORDER BY SUM(sale_dollars) DESC
  LIMIT 1 OFFSET 2        -- 0-based offset → third row
)
SELECT FORMAT_DATE('%Y-%m', date) AS year_month,
       SUM(sale_dollars)          AS monthly_bourbon_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`, third_zip
WHERE county = 'DUBUQUE'
  AND EXTRACT(YEAR FROM date) = 2022
  AND LOWER(category_name) LIKE '%bourbon%'
  AND SUBSTR(zip_code,1,5) = third_zip.zip5
GROUP BY year_month
ORDER BY year_month
LIMIT 20;
