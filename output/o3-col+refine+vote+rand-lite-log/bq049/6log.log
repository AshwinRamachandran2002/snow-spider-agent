Query:
--Description: Compute monthly per-capita Bourbon sales in 2022 for the Dubuque-county ZIP
--             that ranks 3rd in total Bourbon sales, fixing the population CTE by
--             removing the overly-restrictive `gender IS NULL` filter that caused
--             an empty result set.
WITH third_zip AS (  -- identify the 3-rd highest-sales ZIP (zero-based OFFSET 2)
  SELECT SUBSTR(zip_code,1,5) AS zip5
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
  ORDER BY SUM(sale_dollars) DESC
  LIMIT 1 OFFSET 2
),
population AS (      -- 21+ population for that ZIP (no gender restriction)
  SELECT p.zipcode,
         SUM(p.population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p
  JOIN third_zip
    ON p.zipcode = third_zip.zip5
  WHERE p.minimum_age >= 21      -- adults 21 and older
  GROUP BY p.zipcode
),
monthly_sales AS (    -- 2022 monthly Bourbon sales for that ZIP
  SELECT FORMAT_DATE('%Y-%m', s.date) AS year_month,
         SUM(s.sale_dollars)          AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
  JOIN third_zip
    ON SUBSTR(s.zip_code,1,5) = third_zip.zip5
  WHERE s.county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM s.date) = 2022
    AND LOWER(s.category_name) LIKE '%bourbon%'
  GROUP BY year_month
)
SELECT ms.year_month,
       ms.total_sales,
       p.pop_21_plus,
       ms.total_sales / p.pop_21_plus AS per_capita_sales
FROM monthly_sales AS ms
CROSS JOIN population AS p
ORDER BY ms.year_month
LIMIT 20
