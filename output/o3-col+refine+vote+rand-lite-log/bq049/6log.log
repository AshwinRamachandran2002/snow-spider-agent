Query:
--Description: Find the ZIP that ranks third in 2022 Dubuque-county bourbon sales
WITH ranked_zip AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5,
         SUM(sale_dollars)    AS total_bourbon_sales,
         ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS rn
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
)
SELECT zip5, total_bourbon_sales
FROM ranked_zip
WHERE rn = 3
LIMIT 20;
