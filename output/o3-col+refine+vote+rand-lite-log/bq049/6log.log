       date,
       county,
       zip_code,
       category_name,
       sale_dollars
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE county = 'DUBUQUE'
  AND EXTRACT(YEAR FROM date) = 2022
  AND LOWER(category_name) LIKE '%bourbon%'
LIMIT 20;
```

```sql
--Description: 2022 total bourbon sales by 5-digit ZIP in Dubuque County (highest first)
SELECT SUBSTR(zip_code,1,5) AS zip5,
       SUM(sale_dollars)      AS total_bourbon_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE county = 'DUBUQUE'
  AND EXTRACT(YEAR FROM date) = 2022
  AND LOWER(category_name) LIKE '%bourbon%'
GROUP BY zip5
ORDER BY total_bourbon_sales DESC
LIMIT 20;
```

```sql
--Description: Find the ZIP that ranks third in 2022 Dubuque-county bourbon sales
WITH ranked_zip AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5,
         SUM(sale_dollars)    AS total_bourbon_sales,
         ROW_NUMBER() OVER (ORDER BY SUM(sale_dollars) DESC) AS rn
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
)
SELECT zip5, total_bourbon_sales
FROM ranked_zip
WHERE rn = 3
LIMIT 20;
```

```sql
--Description: Monthly bourbon sales during 2022 for that 3rd-place ZIP
WITH third_zip AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
  ORDER BY SUM(sale_dollars) DESC
  LIMIT 1 OFFSET 2        -- 0-based offset → third row
)
SELECT FORMAT_DATE('%Y-%m', date) AS year_month,
       SUM(sale_dollars)          AS monthly_bourbon_sales
FROM `bigquery-public-data.iowa_liquor_sales.sales`, third_zip
WHERE county = 'DUBUQUE'
  AND EXTRACT(YEAR FROM date) = 2022
  AND LOWER(category_name) LIKE '%bourbon%'
  AND SUBSTR(zip_code,1,5) = third_zip.zip5
GROUP BY year_month
ORDER BY year_month
LIMIT 20;
```

```sql
--Description: Population aged 21 + in the same ZIP (2010 census, total-gender rows only)
WITH third_zip AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
  ORDER BY SUM(sale_dollars) DESC
  LIMIT 1 OFFSET 2
)
SELECT p.zipcode                 AS zip5,
       SUM(p.population)         AS population_21_plus
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p,
     third_zip
WHERE p.zipcode      = third_zip.zip5
  AND p.gender       IS NULL          -- total population rows
  AND p.minimum_age >= 21
GROUP BY p.zipcode
LIMIT 20;
```

```sql
--Description: Final result – monthly per-capita bourbon sales in 2022 (sales ÷ pop 21 +)
WITH third_zip AS (
  SELECT SUBSTR(zip_code,1,5) AS zip5
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY zip5
  ORDER BY SUM(sale_dollars) DESC
  LIMIT 1 OFFSET 2
),
population AS (
  SELECT p.zipcode,
         SUM(p.population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p,
       third_zip
  WHERE p.zipcode = third_zip.zip5
    AND p.gender  IS NULL
    AND p.minimum_age >= 21
  GROUP BY p.zipcode
),
monthly_sales AS (
  SELECT FORMAT_DATE('%Y-%m', s.date) AS year_month,
         SUM(s.sale_dollars)          AS total_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s,
       third_zip
  WHERE s.county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM s.date) = 2022
    AND LOWER(s.category_name) LIKE '%bourbon%'
    AND SUBSTR(s.zip_code,1,5) = third_zip.zip5
  GROUP BY year_month
)
SELECT ms.year_month,
       ms.total_sales,
       p.pop_21_plus,
       ms.total_sales / p.pop_21_plus AS per_capita_sales
FROM monthly_sales AS ms
CROSS JOIN population AS p
ORDER BY ms.year_month
LIMIT 20;
```
