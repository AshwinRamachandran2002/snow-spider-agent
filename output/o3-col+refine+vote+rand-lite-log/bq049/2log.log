```sql
-- 8. Monthly Bourbon sales during 2022 for that ZIP in Dubuque County
SELECT FORMAT_DATE('%Y-%m', date) AS sales_month,
       SUM(sale_dollars) AS monthly_sales_dollars
FROM `bigquery-public-data.iowa_liquor_sales.sales`
WHERE county = 'DUBUQUE'
  AND zip_code = '52002'         -- (← same ZIP)
  AND EXTRACT(YEAR FROM date) = 2022
  AND LOWER(category_name) LIKE '%bourbon%'
GROUP BY sales_month
ORDER BY sales_month
LIMIT 20;
```

```sql
-- 9. Combine the sales and population to produce the monthly per-capita numbers
WITH adult_pop AS (
  SELECT zipcode,
         SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE zipcode = '52002'            -- (← same ZIP)
    AND gender IS NULL
    AND minimum_age >= 21
  GROUP BY zipcode ),
monthly_sales AS (
  SELECT FORMAT_DATE('%Y-%m', date) AS sales_month,
         SUM(sale_dollars)          AS monthly_sales_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND zip_code = '52002'          -- (← same ZIP)
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY sales_month )
SELECT ms.sales_month,
       ms.monthly_sales_dollars,
       ap.pop_21_plus,
       ms.monthly_sales_dollars / ap.pop_21_plus AS sales_per_capita
FROM monthly_sales AS ms
CROSS JOIN adult_pop AS ap
ORDER BY ms.sales_month
LIMIT 20;
```

```sql
-- 10. If you want to round the per-capita figure to cents
SELECT sales_month,
       ROUND(sales_per_capita, 4) AS per_capita_sales_usd
FROM (
  -- (same CTEs as query-9)
  WITH adult_pop AS (
    SELECT zipcode,
           SUM(population) AS pop_21_plus
    FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
    WHERE zipcode = '52002'
      AND gender IS NULL
      AND minimum_age >= 21
    GROUP BY zipcode ),
  monthly_sales AS (
    SELECT FORMAT_DATE('%Y-%m', date) AS sales_month,
           SUM(sale_dollars)          AS monthly_sales_dollars
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND zip_code = '52002'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
    GROUP BY sales_month )
  SELECT ms.sales_month,
         ms.monthly_sales_dollars / ap.pop_21_plus AS sales_per_capita
  FROM monthly_sales ms
  CROSS JOIN adult_pop ap )
ORDER BY sales_month
LIMIT 20;
```

