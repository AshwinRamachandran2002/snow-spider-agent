```sql
--Description: Produce monthly per-capita Bourbon-Whiskey sales for 2022 in Dubuque County
--for the 3rd-ranked ZIP code, using the 21-plus population calculated above.
--(Replace '#####' and POP21 with results from the prior two steps.)
WITH adult_pop AS (
  SELECT '#####' AS zip5, POP21 AS pop_21_plus      -- << replace POP21 with the numeric value
),
monthly_sales AS (
  SELECT
    SAFE_SUBSTRING(zip_code, 1, 5) AS zip5,
    DATE_TRUNC(date, MONTH) AS month,
    SUM(sale_dollars) AS monthly_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
    AND SAFE_SUBSTRING(zip_code, 1, 5) = '#####'
  GROUP BY
    zip5,
    month
)
SELECT
  m.month,
  m.monthly_sales,
  a.pop_21_plus,
  m.monthly_sales / a.pop_21_plus AS sales_per_capita
FROM monthly_sales AS m
JOIN adult_pop  AS a USING (zip5)
ORDER BY m.month
LIMIT 20;
```


