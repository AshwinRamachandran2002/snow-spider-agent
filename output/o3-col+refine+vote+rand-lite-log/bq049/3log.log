```sql
--Description:  One-shot query that returns 2022 monthly per-capita Bourbon-Whiskey sales
--for Dubuque County’s ZIP code that ranks 3rd in total Bourbon sales, using only the
--population aged 21 + from the 2010 census.
--Logical flow inside one statement:
--  • bourbon_cte …… filter 2022 Dubuque rows whose category contains “bourbon”; standardize ZIP.
--  • ranked_cte ……… aggregate sales by ZIP and give each a dense rank (DESC order).
--  • target_zip ……  pick the ZIP(s) whose rank = 3.
--  • pop21_cte ……… 2010 census 21+ population for that ZIP.
--  • monthly_cte ….. monthly sales dollars for that ZIP.
--  • Final SELECT …  join monthly to pop, compute per-capita, list chronologically.
WITH bourbon_cte AS (
    SELECT
        REGEXP_EXTRACT(zip_code, r'(\d{5})') AS zip5,
        date,
        sale_dollars
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
), ranked_cte AS (
    SELECT
        zip5,
        SUM(sale_dollars) AS total_sales,
        DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rnk
    FROM bourbon_cte
    GROUP BY zip5
), target_zip AS (
    SELECT zip5
    FROM ranked_cte
    WHERE rnk = 3
), pop21_cte AS (
    SELECT
        zipcode AS zip5,
        SUM(population) AS pop_21_plus
    FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
    WHERE minimum_age >= 21
      AND zipcode IN (SELECT zip5 FROM target_zip)
    GROUP BY zipcode
), monthly_cte AS (
    SELECT
        REGEXP_EXTRACT(zip_code, r'(\d{5})') AS zip5,
        DATE_TRUNC(date, MONTH) AS month,
        SUM(sale_dollars) AS monthly_sales
    FROM `bigquery-public-data.iowa_liquor_sales.sales`
    WHERE county = 'DUBUQUE'
      AND EXTRACT(YEAR FROM date) = 2022
      AND LOWER(category_name) LIKE '%bourbon%'
      AND REGEXP_EXTRACT(zip_code, r'(\d{5})') IN (SELECT zip5 FROM target_zip)
    GROUP BY zip5, month
)
SELECT
    m.month,
    m.monthly_sales,
    p.pop_21_plus,
    m.monthly_sales / p.pop_21_plus AS sales_per_capita
FROM monthly_cte AS m
JOIN pop21_cte  AS p USING (zip5)
ORDER BY m.month;
```
