```sql
-- Monthly per-capita Bourbon-Whiskey sales in 2022 for the Dubuque-County ZIP
-- that ranks 3rd in total Bourbon sales (population age 21 + from 2010 Census)

WITH ranked_zip AS (   -- rank ZIP codes by 2022 Bourbon sales
  SELECT
    REGEXP_EXTRACT(zip_code, r'(\d{5})')                AS zip5,
    SUM(sale_dollars)                                   AS total_sales,
    DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rnk
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM date) = 2022
    AND LOWER(category_name) LIKE '%bourbon%'
    AND sale_dollars > 0                                -- ignore returns
  GROUP BY zip5
),
target_zip AS (        -- keep the ZIP that ranks 3rd
  SELECT zip5
  FROM ranked_zip
  WHERE rnk = 3
),
monthly_sales AS (     -- monthly Bourbon sales for the target ZIP
  SELECT
    REGEXP_EXTRACT(s.zip_code, r'(\d{5})')      AS zip5,
    DATE_TRUNC(s.date, MONTH)                   AS month_date,
    SUM(s.sale_dollars)                         AS monthly_sales
  FROM `bigquery-public-data.iowa_liquor_sales.sales` AS s
  JOIN target_zip AS t
    ON t.zip5 = REGEXP_EXTRACT(s.zip_code, r'(\d{5})')
  WHERE s.county = 'DUBUQUE'
    AND EXTRACT(YEAR FROM s.date) = 2022
    AND LOWER(s.category_name) LIKE '%bourbon%'
    AND s.sale_dollars > 0
  GROUP BY zip5, month_date
),
pop_21_plus AS (       -- 2010 Census population age 21+ for the target ZIP
  SELECT
    CAST(zipcode AS STRING) AS zip5,
    SUM(population)        AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE CAST(zipcode AS INT64) IN (SELECT CAST(zip5 AS INT64) FROM target_zip)
    AND minimum_age >= 21
    AND (gender IS NULL OR gender = '')          -- avoid double-counting
  GROUP BY zip5
)
SELECT
  FORMAT_DATE('%Y-%m', m.month_date)        AS month,
  m.monthly_sales,
  ROUND(m.monthly_sales / p.pop_21_plus, 4) AS per_capita_sales
FROM monthly_sales AS m
JOIN pop_21_plus  AS p
USING (zip5)
ORDER BY month;
```
