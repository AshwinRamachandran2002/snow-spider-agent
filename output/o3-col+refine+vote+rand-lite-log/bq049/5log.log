```sql
--Description: Aggregate population aged 21 + for that ZIP code
SELECT
  `zipcode`,
  SUM(`population`) AS pop_21_plus
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
WHERE `zipcode` = '??ZIP??'
  AND `minimum_age` IS NOT NULL
  AND `minimum_age` >= 21
