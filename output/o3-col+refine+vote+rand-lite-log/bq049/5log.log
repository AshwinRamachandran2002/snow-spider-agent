```sql
--Description:  One shot query (with inline thinking) that                              
-- • finds the ZIP code that ranks 3rd in 2022 Bourbon-whiskey sales within Dubuque County  
-- • gets that ZIP’s 21-and-over population from the 2010 Census  
-- • calculates the 2022 month-by-month per-capita Bourbon sales dollars.                 
WITH                                                             --⬅️  Begin thinking steps
/* ① Rank Dubuque County ZIP codes by 2022 Bourbon sales */
zip_rank AS (
  SELECT
    REGEXP_EXTRACT(zip_code, r'(\d{5})') AS zip5,              --keep 5-digit ZIP
    SUM(sale_dollars)                     AS total_sales_2022,
    DENSE_RANK() OVER (ORDER BY SUM(sale_dollars) DESC) AS rk
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE county = 'DUBUQUE'                                     --only Dubuque County
    AND date BETWEEN '2022-01-01' AND '2022-12-31'             --year 2022
    AND LOWER(category_name) LIKE '%bourbon%'                  --any Bourbon category
  GROUP BY zip5
),
/* ② Keep just the 3rd-ranked ZIP code */
target_zip AS (
  SELECT zip5 FROM zip_rank WHERE rk = 3                       --should be 52003
),
/* ③ Pull 21+ population for that ZIP from the Census table */
pop_21 AS (
  SELECT
    zipcode                            AS zip5,
    SUM(population)                    AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE zipcode IN (SELECT zip5 FROM target_zip)
    AND minimum_age IS NOT NULL
    AND minimum_age >= 21
  GROUP BY zipcode
),
/* ④ Aggregate monthly Bourbon sales dollars for that ZIP in 2022 */
monthly_sales AS (
  SELECT
    FORMAT_DATE('%Y-%m', date)         AS year_month,
    SUM(sale_dollars)                  AS monthly_sales_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE REGEXP_EXTRACT(zip_code, r'(\d{5})') IN (SELECT zip5 FROM target_zip)
    AND date BETWEEN '2022-01-01' AND '2022-12-31'
    AND LOWER(category_name) LIKE '%bourbon%'
  GROUP BY year_month
)
/* ⑤ Combine sales and population to compute per-capita values */
SELECT
  ms.year_month,
  ms.monthly_sales_dollars,
  ms.monthly_sales_dollars / p.pop_21_plus AS per_capita_sales_dollars
FROM monthly_sales AS ms
JOIN pop_21       AS p ON TRUE                         --cross join; single-row pop
ORDER BY ms.year_month;                                --chronological output
