```sql
--Description: 4) Verify the distinct gender values where the row is an overall total for that gender (no age limits).
SELECT DISTINCT gender
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
WHERE minimum_age IS NULL
  AND maximum_age IS NULL
LIMIT 20;
```

```sql
--Description: 5) Calculate male-plus-female 2010 totals per ZIP in Washington state (state_code = 'WA') just to sanity-check numbers.
SELECT
  z.`zipcode`,
  SUM(p.`population`) AS total_population_mf
FROM `bigquery-public-data.utility_us.zipcode_area` AS z
JOIN `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p
  ON z.`zipcode` = p.`zipcode`
WHERE z.`state_code` = 'WA'
  AND p.`gender` IN ('male', 'female')
  AND p.`minimum_age` IS NULL
  AND p.`maximum_age` IS NULL
GROUP BY z.`zipcode`
LIMIT 20;
```

