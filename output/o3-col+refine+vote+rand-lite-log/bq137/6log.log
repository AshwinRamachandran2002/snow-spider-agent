```sql
--Description: 1) Peek at the ZIP Code Area master table to understand the columns that describe each ZIP polygon.  
SELECT *
FROM `bigquery-public-data.utility_us.zipcode_area`
LIMIT 20;
```

```sql
--Description: 2) Look at ZIP polygons that are within 10 000 m of the Seattle CBD point (-122.3321 lon, 47.6062 lat).  
--We convert the WKT text into GEOGRAPHY so ST_DWITHIN can work even if the column is stored as STRING.
SELECT
  `zipcode`,
  ST_AREA(ST_GEOGFROMTEXT(`zipcode_geom`)) AS polygon_area_m2
FROM `bigquery-public-data.utility_us.zipcode_area`
WHERE ST_DWITHIN(
        ST_GEOGFROMTEXT(`zipcode_geom`),
        ST_MAKEPOINT(-122.3321, 47.6062),
        10000)
LIMIT 20;
```

```sql
--Description: 3) Inspect 2010 population rows to see how gender, age columns look.
SELECT *
FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
LIMIT 20;
