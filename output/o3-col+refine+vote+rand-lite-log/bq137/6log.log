```sql
--Description (thinking process embedded as comments):
-- Goal: return every ZIP Code Tabulation Area (ZCTA) whose polygon lies within 10 km of
--       Seattle’s downtown point (–122.3321 longitude, 47.6062 latitude), along with:
--       • the polygon (as WKT), land & water area (m²), lat / lon, state code & name, city, county
--       • the 2010 Census total population restricted to gender-specific totals (male + female)
-- Steps:
-- 1.  In `utility_us.zipcode_area`, `zipcode_geom` is WKT text; convert to GEOGRAPHY via ST_GEOGFROMTEXT.
-- 2.  Use ST_DWITHIN against ST_GEOGPOINT(–122.3321, 47.6062) with a 10 000 m radius.
-- 3.  Join the resulting ZIPs to `census_bureau_usa.population_by_zip_2010` on `zipcode`.
-- 4.  Keep only rows where minimum_age & maximum_age are NULL (no age bounds) and gender is 'male' or 'female'.
-- 5.  Aggregate population to get combined total per ZIP.
-- 6.  Return the requested columns, sorted by population descending.
SELECT
  z.zipcode                              AS zipcode,
  z.zipcode_geom                         AS polygon,          -- WKT string for GEO visualisations
  z.area_land_meters,
  z.area_water_meters,
  z.latitude,
  z.longitude,
  z.state_code,
  z.state_name,
  z.city,
  z.county,
  SUM(p.population)                      AS total_population_2010
FROM `bigquery-public-data.utility_us.zipcode_area`            AS z
JOIN `bigquery-public-data.census_bureau_usa.population_by_zip_2010` AS p
  ON z.zipcode = p.zipcode
WHERE ST_DWITHIN(
        ST_GEOGFROMTEXT(z.zipcode_geom),      -- ZIP polygon converted to GEOGRAPHY
        ST_GEOGPOINT(-122.3321, 47.6062),     -- Seattle CBD reference point
        10000                                 -- distance threshold in metres (10 km)
      )
  AND p.gender IN ('male', 'female')          -- restrict to gender-specific totals
  AND p.minimum_age IS NULL                   -- no age lower bound ⇒ total males/females
  AND p.maximum_age IS NULL                   -- no age upper bound
GROUP BY
  z.zipcode,
  z.zipcode_geom,
  z.area_land_meters,
  z.area_water_meters,
  z.latitude,
  z.longitude,
  z.state_code,
  z.state_name,
  z.city,
  z.county
ORDER BY total_population_2010 DESC;
```
