```sql
--Description: 1) Take a quick look at the TCGA Clinical Data Resource (CDR) for
--   pancreatic adenocarcinoma (PAAD) patients – this will be the master
--   patient list that we finally merge the mutation information onto.
SELECT *
FROM   `isb-cgc-bq.pancancer_atlas.TCGA_CDR`
WHERE  Study = 'PAAD'
LIMIT  20;
```

```sql
--Description: 2) Inspect somatic‐mutation (MC3) records that belong to PAAD
--   tumours.  These rows contain one representative variant per tumour sample.
SELECT ParticipantBarcode,
       Tumor_SampleBarcode,
       Tumor_AliquotBarcode,
       Hugo_Symbol,
       Variant_Classification
FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`
WHERE  Study = 'PAAD'
LIMIT  20;
```

```sql
--Description: 3) Pull distinct PAAD patients that harbour a KRAS mutation
--   (after removing tumour aliquots that external quality reviewers flagged
--   “Do_not_use = True”).
SELECT DISTINCT m.ParticipantBarcode
FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`  AS m
LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`       AS q
       ON m.Tumor_AliquotBarcode = q.aliquot_barcode
WHERE  m.Study        = 'PAAD'
  AND  m.Hugo_Symbol  = 'KRAS'
  AND  (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
LIMIT  20;
```

```sql
--Description: 4) Pull distinct PAAD patients that harbour a TP53 mutation,
--   using the same quality filter.
SELECT DISTINCT m.ParticipantBarcode
FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`  AS m
LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`       AS q
       ON m.Tumor_AliquotBarcode = q.aliquot_barcode
WHERE  m.Study        = 'PAAD'
  AND  m.Hugo_Symbol  = 'TP53'
  AND  (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
LIMIT  20;
```

```sql
--Description: 5) Inspect the external quality annotation table for PAAD aliquots
--   just to see the type of flags that can appear.
SELECT *
FROM   `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`
WHERE  cancer_type = 'PAAD'
LIMIT  20;
```

```sql
--Description: 6) Build a patient-level mutation matrix (one row per participant,
--   columns = “has KRAS mut?”, “has TP53 mut?”).  Quality filtering applied.
WITH muts AS (
  SELECT  ParticipantBarcode,
          MAX(CASE WHEN Hugo_Symbol = 'KRAS' THEN 1 ELSE 0 END)  AS KRAS_mut,
          MAX(CASE WHEN Hugo_Symbol = 'TP53' THEN 1 ELSE 0 END)  AS TP53_mut
  FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample` AS m
  LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`      AS q
         ON m.Tumor_AliquotBarcode = q.aliquot_barcode
  WHERE  m.Study = 'PAAD'
    AND  (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
  GROUP BY ParticipantBarcode )
SELECT *
FROM   muts
LIMIT  20;
```

```sql
--Description: 7) Merge the above mutation matrix with the clinical CDR so that
--   every PAAD patient in the clinical file is represented (mutated or not).
WITH muts AS (
  SELECT  ParticipantBarcode,
          MAX(CASE WHEN Hugo_Symbol = 'KRAS' THEN 1 ELSE 0 END)  AS KRAS_mut,
          MAX(CASE WHEN Hugo_Symbol = 'TP53' THEN 1 ELSE 0 END)  AS TP53_mut
  FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample` AS m
  LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`      AS q
         ON m.Tumor_AliquotBarcode = q.aliquot_barcode
  WHERE  m.Study = 'PAAD'
    AND  (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
  GROUP BY ParticipantBarcode )
SELECT c.ParticipantBarcode,
       COALESCE(m.KRAS_mut, 0)  AS KRAS_mut,
       COALESCE(m.TP53_mut, 0)  AS TP53_mut,
       c.OS, c.OS_time          -- example follow-up fields
FROM   `isb-cgc-bq.pancancer_atlas.TCGA_CDR`  AS c
LEFT JOIN muts AS m
       ON c.ParticipantBarcode = m.ParticipantBarcode
WHERE  c.Study = 'PAAD'
LIMIT  20;
```

```sql
--Description: 8) Create the 2×2 contingency table for KRAS vs TP53 mutations
--   in PAAD (number of patients in each cell).
WITH muts AS (
  SELECT  ParticipantBarcode,
          MAX(CASE WHEN Hugo_Symbol = 'KRAS' THEN 1 ELSE 0 END)  AS KRAS_mut,
          MAX(CASE WHEN Hugo_Symbol = 'TP53' THEN 1 ELSE 0 END)  AS TP53_mut
  FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample` AS m
  LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`      AS q
         ON m.Tumor_AliquotBarcode = q.aliquot_barcode
  WHERE  m.Study = 'PAAD'
    AND  (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
  GROUP BY ParticipantBarcode ),
all_paad AS (
  SELECT ParticipantBarcode
  FROM   `isb-cgc-bq.pancancer_atlas.TCGA_CDR`
  WHERE  Study = 'PAAD' )
SELECT
  SUM(CASE WHEN KRAS_mut = 1 AND TP53_mut = 1 THEN 1 ELSE 0 END) AS both_mut,
  SUM(CASE WHEN KRAS_mut = 1 AND TP53_mut = 0 THEN 1 ELSE 0 END) AS kras_only,
  SUM(CASE WHEN KRAS_mut = 0 AND TP53_mut = 1 THEN 1 ELSE 0 END) AS tp53_only,
  SUM(CASE WHEN KRAS_mut = 0 AND TP53_mut = 0 THEN 1 ELSE 0 END) AS none
FROM  all_paad  AS p
LEFT JOIN muts  AS m
       ON p.ParticipantBarcode = m.ParticipantBarcode
LIMIT 20;
```

```sql
--Description: 9) Using the contingency counts, calculate the chi-squared
--   statistic for independence between the two genes.
WITH muts AS (
  SELECT  ParticipantBarcode,
          MAX(CASE WHEN Hugo_Symbol = 'KRAS' THEN 1 ELSE 0 END)  AS KRAS_mut,
          MAX(CASE WHEN Hugo_Symbol = 'TP53' THEN 1 ELSE 0 END)  AS TP53_mut
  FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample` AS m
  LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations`      AS q
         ON m.Tumor_AliquotBarcode = q.aliquot_barcode
  WHERE  m.Study = 'PAAD'
    AND  (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
  GROUP BY ParticipantBarcode ),
all_paad AS (
  SELECT ParticipantBarcode
  FROM   `isb-cgc-bq.pancancer_atlas.TCGA_CDR`
  WHERE  Study = 'PAAD' ),
tbl AS (
  SELECT
    SUM(CASE WHEN KRAS_mut = 1 AND TP53_mut = 1 THEN 1 ELSE 0 END) AS a, --both
    SUM(CASE WHEN KRAS_mut = 1 AND TP53_mut = 0 THEN 1 ELSE 0 END) AS b, --KRAS only
    SUM(CASE WHEN KRAS_mut = 0 AND TP53_mut = 1 THEN 1 ELSE 0 END) AS c, --TP53 only
    SUM(CASE WHEN KRAS_mut = 0 AND TP53_mut = 0 THEN 1 ELSE 0 END) AS d  --neither
  FROM  all_paad AS p
  LEFT JOIN muts AS m
         ON p.ParticipantBarcode = m.ParticipantBarcode )
SELECT a,b,c,d,
       (a + b + c + d)                                          AS n,
       -- expected counts
       ((a + b)*(a + c) / (a + b + c + d))  AS exp_a,
       ((a + b)*(b + d) / (a + b + c + d))  AS exp_b,
       ((c + d)*(a + c) / (a + b + c + d))  AS exp_c,
       ((c + d)*(b + d) / (a + b + c + d))  AS exp_d,
       -- chi-square component for each cell
       ((a - ((a + b)*(a + c)/(a + b + c + d)))^2) / ((a + b)*(a + c)/(a + b + c + d)) +
       ((b - ((a + b)*(b + d)/(a + b + c + d)))^2) / ((a + b)*(b + d)/(a + b + c + d)) +
       ((c - ((c + d)*(a + c)/(a + b + c + d)))^2) / ((c + d)*(a + c)/(a + b + c + d)) +
       ((d - ((c + d)*(b + d)/(a + b + c + d)))^2) / ((c + d)*(b + d)/(a + b + c + d))
       AS chi_squared
FROM   tbl
LIMIT 20;
```
