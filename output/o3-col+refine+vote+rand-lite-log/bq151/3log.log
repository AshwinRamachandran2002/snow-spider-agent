--Description: 3) Pull distinct PAAD patients that harbour a KRAS mutation
--   (after removing tumour aliquots that external quality reviewers flagged
--   “Do_not_use = True”).
SELECT DISTINCT m.ParticipantBarcode
FROM   `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample`  AS m
