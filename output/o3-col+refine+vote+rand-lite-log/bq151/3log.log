--Description:
-- Single-query workflow to (1) flag KRAS and TP53 mutations for each PAAD patient
-- (quality-filtered MC3), (2) ensure every PAAD case from the clinical cohort is
-- represented, (3) build the 2×2 contingency table, and (4) calculate the
-- Pearson χ² statistic = Σ (obs-exp)² / exp.
WITH per_patient AS (
  SELECT
    m.ParticipantBarcode,
    MAX(CASE WHEN m.Hugo_Symbol = 'KRAS' THEN 1 ELSE 0 END) AS KRAS_mut,
    MAX(CASE WHEN m.Hugo_Symbol = 'TP53' THEN 1 ELSE 0 END) AS TP53_mut
  FROM `isb-cgc-bq.pancancer_atlas.Filtered_MC3_MAF_V5_one_per_tumor_sample` m
  LEFT JOIN `isb-cgc-bq.pancancer_atlas.merged_sample_quality_annotations` q
         ON m.Tumor_AliquotBarcode = q.aliquot_barcode
  WHERE m.Study = 'PAAD'
    AND (q.Do_not_use IS NULL OR q.Do_not_use = 'False')
  GROUP BY m.ParticipantBarcode
),
all_paad AS (
  SELECT ParticipantBarcode
  FROM   `isb-cgc-bq.pancancer_atlas.TCGA_CDR`
  WHERE  Study = 'PAAD'
),
counts AS (
  SELECT
    SUM(IF(pp.KRAS_mut = 1 AND pp.TP53_mut = 1, 1, 0)) AS a, -- KRAS & TP53
    SUM(IF(pp.KRAS_mut = 1 AND pp.TP53_mut = 0, 1, 0)) AS b, -- KRAS only
    SUM(IF(pp.KRAS_mut = 0 AND pp.TP53_mut = 1, 1, 0)) AS c, -- TP53 only
    SUM(IF(pp.KRAS_mut = 0 AND pp.TP53_mut = 0, 1, 0)) AS d  -- neither
  FROM all_paad ap
  LEFT JOIN per_patient pp
    ON ap.ParticipantBarcode = pp.ParticipantBarcode
)
SELECT
  a, b, c, d,
  (a + b + c + d)                                               AS total_patients,
  CAST((a + b)*(a + c) AS FLOAT64)/(a + b + c + d)              AS exp_a,
  CAST((a + b)*(b + d) AS FLOAT64)/(a + b + c + d)              AS exp_b,
  CAST((c + d)*(a + c) AS FLOAT64)/(a + b + c + d)              AS exp_c,
  CAST((c + d)*(b + d) AS FLOAT64)/(a + b + c + d)              AS exp_d,
  -- χ² = Σ (obs−exp)² / exp
  (
    POWER(a - CAST((a + b)*(a + c) AS FLOAT64)/(a + b + c + d), 2) /
          (CAST((a + b)*(a + c) AS FLOAT64)/(a + b + c + d))
  ) +
  (
    POWER(b - CAST((a + b)*(b + d) AS FLOAT64)/(a + b + c + d), 2) /
          (CAST((a + b)*(b + d) AS FLOAT64)/(a + b + c + d))
  ) +
  (
    POWER(c - CAST((c + d)*(a + c) AS FLOAT64)/(a + b + c + d), 2) /
          (CAST((c + d)*(a + c) AS FLOAT64)/(a + b + c + d))
  ) +
  (
    POWER(d - CAST((c + d)*(b + d) AS FLOAT64)/(a + b + c + d), 2) /
          (CAST((c + d)*(b + d) AS FLOAT64)/(a + b + c + d))
  ) AS chi_squared
FROM counts;
