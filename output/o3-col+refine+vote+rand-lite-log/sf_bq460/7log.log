--Description: Demonstrate the weighting step for 10 tokens of the target article:
--vector ÷ frequency^0.4 (uses the in-SQL tokenizer and joins to both helper tables).
WITH tp AS (
  SELECT tok.value::STRING AS "token"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value IS NOT NULL
    AND tok.value <> ''
  LIMIT 10
), joined AS (
  SELECT tp."token", gv."vector", wf."frequency"
  FROM tp
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
        ON gv."word" = tp."token"
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
        ON wf."word" = tp."token"
)
SELECT
  "token",
  ARRAY_TRANSFORM(
     "vector",
     v -> v / POWER("frequency", 0.4)
  ) AS "weighted_vector"
FROM joined
LIMIT 20
