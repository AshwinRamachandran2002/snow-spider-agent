```sql
--Description: Full workflow — produce cosine-similarity scores between the target
--article and every other article, listing the 10 most-similar.  The query
--tokenises each “body” in-SQL (no external UDF), joins to vector & frequency
--tables, weights vectors, sums them, normalises, and finally computes cosine
--similarity.
WITH base AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
), tokens AS (
  SELECT b."id", tok.value::STRING AS "token"
  FROM base b,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(b."body"), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) tok
  WHERE tok.value IS NOT NULL
    AND tok.value <> ''
), joined AS (
  SELECT t."id", gv."vector", wf."frequency"
  FROM tokens t
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
        ON gv."word" = t."token"
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
        ON wf."word" = t."token"
), summed AS (
  SELECT
    "id",
    ARRAY_AGG(
      ARRAY_TRANSFORM("vector", v -> v / POWER("frequency", 0.4))
    ) AS "vecs"
  FROM joined
  GROUP BY "id"
), aggregated AS (
  SELECT
    "id",
    ARRAY_REDUCE(
      "vecs",
      (acc, v) -> ARRAY_ZIP_WITH(acc, v, (x, y) -> COALESCE(x, 0) + COALESCE(y, 0))
    ) AS "sum_vec"
  FROM summed
), normalised AS (
  SELECT
    "id",
    "sum_vec",
    SQRT(ARRAY_SUM(ARRAY_TRANSFORM("sum_vec", x -> POWER(x, 2)))) AS "norm"
  FROM aggregated
), base_norm AS (
  SELECT *
  FROM normalised
  WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
), others AS (
  SELECT *
  FROM normalised
  WHERE "id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
  o."id",
  n."date",
  n."title",
  ARRAY_DOT_PRODUCT(o."sum_vec", b."sum_vec") / (o."norm" * b."norm") AS "cosine_similarity"
FROM others o
JOIN base_norm b ON 1 = 1
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n ON n."id" = o."id"
ORDER BY "cosine_similarity" DESC
LIMIT 10;
```
