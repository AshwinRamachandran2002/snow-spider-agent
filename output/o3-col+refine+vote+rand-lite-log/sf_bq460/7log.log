--Description: Tokenise several articles at once (first 5 by date) using an ad-hoc SQL tokenizer
--(lower-case, strip non-alphanumerics, SPLIT on blanks) so we can later join the tokens
--to the frequency & vector tables.
WITH sel AS (  
  SELECT "id", "body"  
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"  
  ORDER BY "date"  
  LIMIT 5  
)  
SELECT 
  s."id", 
  tok.value::STRING AS "token" 
FROM sel s, 
     LATERAL FLATTEN(
       INPUT => SPLIT(
                 REGEXP_REPLACE(LOWER(s."body"), '[^a-z0-9]+', ' '),
                 ' '
               )
     ) tok
WHERE tok.value IS NOT NULL
  AND tok.value <> ''
LIMIT 20
