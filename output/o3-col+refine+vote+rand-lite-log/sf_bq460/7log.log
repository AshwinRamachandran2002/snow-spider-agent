```sql
--Description:  Weight word vectors for 10 sample tokens from article
--‘8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373’.  The query:
--  • tokenises the body text (lower-case, strip punctuation, split, flatten);
--  • joins each token to its GloVe vector and corpus frequency;
--  • pre-computes freq_pow = frequency^0.4;
--  • scales every vector element by dividing by freq_pow with ARRAY_TRANSFORM.
WITH tp AS (                       -- 1. grab 10 tokens
  SELECT tok.value::STRING AS token
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value IS NOT NULL
    AND tok.value <> ''
  LIMIT 10
),
joined AS (                       -- 2–3. attach vector, frequency, freq_pow
  SELECT
    tp.token,
    gv.vector,
    POWER(wf.frequency, 0.4) AS freq_pow
  FROM tp
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"   gv ON gv."word" = tp.token
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf ON wf."word" = tp.token
)
SELECT                            -- 4. compute weighted vector
  token,
  ARRAY_TRANSFORM(vector, v -> v / freq_pow) AS weighted_vector
FROM joined
LIMIT 20;
```
