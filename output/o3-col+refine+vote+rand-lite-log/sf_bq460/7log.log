--Description:  Take 10 distinct tokens from the Alzheimer-biomarker article
--(id = 8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373), attach each token’s GloVe vector
--and corpus frequency, compute freq_pow = frequency^0.4, and return the
--frequency-weighted vector (vector ÷ freq_pow) for each token.
WITH tokens AS (                               -- 1. tokenise and get 10 tokens
  SELECT DISTINCT
         tok.value::STRING AS token
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" AS n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) AS tok
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value IS NOT NULL
    AND tok.value <> ''
  LIMIT 10
), enriched AS (                               -- 2. join vectors + frequencies
  SELECT
    t.token,
    gv."vector",
    POWER(wf."frequency", 0.4) AS freq_pow
  FROM tokens AS t
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"   AS gv ON gv."word" = t.token
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" AS wf ON wf."word" = t.token
)
SELECT                                          -- 3. compute weighted vectors
  token,
  ARRAY_TRANSFORM("vector", v -> v / freq_pow) AS weighted_vector
FROM enriched
LIMIT 20;
