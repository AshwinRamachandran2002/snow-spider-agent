--Description: Aggregate the weighted vectors of the first 5 articles into single
--summed vectors (again relying on the ad-hoc tokenizer).
WITH art AS (
  SELECT "id", "body"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
  ORDER BY "date"
  LIMIT 5
), tokens AS (
  SELECT a."id", tok.value::STRING AS "token"
  FROM art a,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(a."body"), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) tok
  WHERE tok.value IS NOT NULL
    AND tok.value <> ''
), joined AS (
  SELECT t."id", gv."vector", wf."frequency"
  FROM tokens t
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv
        ON gv."word" = t."token"
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
        ON wf."word" = t."token"
)
SELECT
  "id",
  ARRAY_AGG(
    ARRAY_TRANSFORM("vector", v -> v / POWER("frequency", 0.4))
  ) AS "weighted_vectors"
FROM joined
GROUP BY "id"
LIMIT 20;
