--Description: Compute “vector ÷ frequency^0.4” for 10 tokens from article
--8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373.  The query:
-- 1) Tokenises the article body in-SQL (lower-case, remove punctuation, split, flatten)
--    and picks 10 distinct tokens.
-- 2) Joins each token to its GloVe vector and its corpus frequency.
-- 3) Calculates freq_pow = frequency^0.4 so it can be used inside ARRAY_TRANSFORM.
-- 4) Produces the weighted vector by dividing every element by freq_pow.
WITH tp AS (                                   -- 1. obtain 10 tokens
  SELECT DISTINCT
         tok.value::STRING AS token
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n.body), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) tok
  WHERE n.id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value IS NOT NULL
    AND tok.value <> ''
  LIMIT 10
), joined AS (                                 -- 2–3. attach vector & frequency
  SELECT
    tp.token,
    gv.vector AS vec,
    POWER(wf.frequency, 0.4) AS freq_pow
  FROM tp
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"   gv ON gv.word = tp.token
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf ON wf.word = tp.token
)
SELECT                                          -- 4. weighted vectors
  token,
  ARRAY_TRANSFORM(vec, v -> v / freq_pow) AS weighted_vector
FROM joined
LIMIT 20;
```
