--Description: Join the tokens of the target article to WORD_FREQUENCIES to inspect
--each token’s corpus frequency (using the same in-SQL tokenizer).
WITH tokens AS (
  SELECT tok.value::STRING AS "token"
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" t,
       LATERAL FLATTEN(
         INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(t."body"), '[^a-z0-9]+', ' '),
                   ' '
                 )
       ) tok
  WHERE t."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    AND tok.value IS NOT NULL
    AND tok.value <> ''
)
SELECT 
  tok."token", 
  wf."frequency" 
FROM tokens tok
LEFT JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
       ON wf."word" = tok."token"
