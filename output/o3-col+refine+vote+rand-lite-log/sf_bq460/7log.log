--Description: Illustrate the weighting step for a subset of tokens: divide each vector by frequency^0.4 (element-wise).  
WITH tp AS (  
  SELECT f.value::STRING AS "token"  
  FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,   
       LATERAL FLATTEN(
         INPUT => "spider2-public-data".word_vectors_us.tokenise_no_stop(n."body")
       ) f  
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'  
  LIMIT 10    --grab just 10 tokens for demonstration  
), joined AS (  
  SELECT tp."token", gv."vector", wf."frequency"  
  FROM tp  
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" gv  
        ON gv."word" = tp."token"  
  JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf  
        ON wf."word" = tp."token"  
)  
SELECT 
  "token", 
  ARRAY_TRANSFORM(
     "vector", 
     v -> v / POWER("frequency", 0.4)
  ) AS "weighted_vector" 
FROM joined 
LIMIT 20;
