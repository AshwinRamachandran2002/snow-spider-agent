```sql
--Description:  Create a fully-worked, single-query version of “step 9” that
-- normalises every article’s aggregate vector (built in step 8) to unit
-- length.  We (1) re-generate the aggregate vectors on-the-fly (same logic
-- as the previous correction, using manual tokenisation and WITHIN GROUP
-- ordering), then (2) compute each vector’s L2-norm with ARRAY_SUM / lambda
-- utilities, and (3) divide every component by that norm to yield a
-- unit-length vector (unit_vec).  Limiting to 20 rows helps us inspect the
-- results.

WITH agg_vecs AS (               /* ── build aggregate vectors ───────────────── */
    SELECT
        summed.id,
        ARRAY_AGG(summed.dim_sum) WITHIN GROUP (ORDER BY summed.pos) AS agg_vec
    FROM (
        SELECT
            n.id,
            fv.index                                 AS pos,
            SUM( (fv.value::FLOAT) /
                 POWER(wf.frequency, 0.4) )          AS dim_sum
        FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
             , LATERAL SPLIT_TO_TABLE(
                   REGEXP_REPLACE(LOWER(n.body), '[^a-z0-9]+', ' '), ' '
               ) tok
             JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
               ON wf.word = tok.value
             JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
               ON gv.word = tok.value
             , LATERAL FLATTEN(input => gv.vector) fv
        WHERE tok.value <> ''
          AND tok.value NOT IN (                          -- stop-word list (abbrev.)
              'a','about','above','after','again','against','all','am','an','and','any',
              'are','as','at','be','because','been','before','being','below','between',
              'both','but','by','can','could','did','do','does','doing','down','during',
              'each','few','for','from','further','had','has','have','having','he','her',
              'here','hers','herself','him','himself','his','how','i','if','in','into',
              'is','it','its','itself','just','me','more','most','my','myself','no','nor',
              'not','now','of','off','on','once','only','or','other','our','ours',
              'ourselves','out','over','own','re','s','same','she','should','so','some',
              'such','than','that','the','their','theirs','them','themselves','then',
              'there','these','they','this','those','through','to','too','under','until',
              'up','very','was','we','were','what','when','where','which','while','who',
              'whom','why','will','with','you','your','yours','yourself','yourselves'
          )
        GROUP BY n.id, fv.index
    ) summed
    GROUP BY summed.id
)
SELECT
    id,
    agg_vec,
    SQRT(ARRAY_SUM(ARRAY_TRANSFORM(agg_vec, v -> v*v)))       AS l2_norm,
    ARRAY_TRANSFORM(
        agg_vec,
        v -> v / NULLIFZERO(SQRT(ARRAY_SUM(ARRAY_TRANSFORM(agg_vec, w -> w*w))))
    )                                                         AS unit_vec
FROM agg_vecs
LIMIT 20;
