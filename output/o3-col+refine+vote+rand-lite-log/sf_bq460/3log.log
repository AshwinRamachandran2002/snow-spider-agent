```sql
--Description: Build the full, weighted & normalised vector for the reference
-- article (ID = ‘8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373’) in one shot.
-- • “tokens” CTE: manual tokenisation → distinct content-words.
-- • “word_vectors” CTE: attach each token’s frequency and 300-D GloVe vector,
--   weighting each dimension by frequency^-0.4.
-- • “dims” CTE: sum weighted values per dimension across all words.
-- • “agg_vec” CTE: re-assemble the 300 sums into a single ARRAY (agg_vec).
-- • “norm_and_unit” CTE: calculate the vector’s L2-norm and divide to obtain a
--   unit-length ARRAY (unit_vec).
-- The final SELECT shows the article ID, the raw aggregate vector, its norm and
-- the normalised vector that can be used for cosine similarity calculations.
WITH tokens AS (      -----------------------------------------------------------
    SELECT DISTINCT
           tok.value::STRING AS token
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(                                          -- manual split
             input => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                 ' ')
         ) tok
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND tok.value::STRING <> ''
      AND tok.value::STRING NOT IN (                               -- stop-word list
          'a','about','above','after','again','against','ain','all','am','an','and','any',
          'are','as','at','be','because','been','before','being','below','between','both',
          'but','by','can','could','did','do','does','doing','down','during','each','few',
          'for','from','further','had','has','have','having','he','her','here','hers',
          'herself','him','himself','his','how','i','if','in','into','is','it','its',
          'itself','just','ll','m','me','more','most','my','myself','no','nor','not','now',
          'of','off','on','once','only','or','other','our','ours','ourselves','out','over',
          'own','re','s','same','she','should','so','some','such','t','than','that','the',
          'their','theirs','them','themselves','then','there','these','they','this','those',
          'through','to','too','under','until','up','ve','very','was','we','were','what',
          'when','where','which','while','who','whom','why','will','with','you','your',
          'yours','yourself','yourselves'
      )
),
word_vectors AS (   -------------------------------------------------------------
    SELECT
        gv."word",
        wf."frequency",
        fv.index                   AS dim,
        (fv.value::FLOAT)
        / POWER(wf."frequency", 0.4)  AS weighted_val
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON wf."word" = t.token
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON gv."word" = t.token
    ,  LATERAL FLATTEN(input => gv."vector") fv        -- expand 300-D vector
),
dims AS (          -------------------------------------------------------------
    SELECT
        dim,
        SUM(weighted_val) AS dim_sum
    FROM word_vectors
    GROUP BY dim
),
agg_vec AS (       -------------------------------------------------------------
    SELECT ARRAY_AGG(dim_sum ORDER BY dim) AS vec
    FROM dims
),
norm_and_unit AS ( -------------------------------------------------------------
    SELECT
        vec,
        SQRT(ARRAY_SUM(ARRAY_TRANSFORM(vec, v -> v*v))) AS l2_norm,
        ARRAY_TRANSFORM(vec, v -> v / NULLIFZERO(
            SQRT(ARRAY_SUM(ARRAY_TRANSFORM(vec, w -> w*w)))
        )) AS unit_vec
    FROM agg_vec
)
SELECT
    '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373' AS article_id,
    vec          AS aggregate_vector,
    l2_norm      AS vector_norm,
    unit_vec     AS normalised_vector
FROM norm_and_unit;
