```sql
--Description: 7) Weight each word vector by frequency^-0.4 then re-assemble it (single article example)
SELECT
  gv."word",
  ARRAY_AGG( (fv.value::FLOAT) / POWER(wf."frequency", 0.4) ORDER BY fv.index ) AS "weighted_vec"
FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv,
     LATERAL FLATTEN(input => gv."vector") fv
JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
  ON wf."word" = gv."word"
WHERE gv."word" IN (
    SELECT DISTINCT f.value::STRING
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(input => WORD_VECTORS_US.WORD_VECTORS_US.tokenise_no_stop(n."body")) f
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
GROUP BY gv."word", wf."frequency"
LIMIT 20;
```

```sql
--Description: 8) Sum all weighted vectors to an aggregate vector for *every* article (truncated result)
SELECT
  n."id",
  ARRAY_AGG( SUM_BY_POS ) AS "agg_vec"         -- each element is summed position-wise
FROM (
  SELECT
    n."id",
    fv.index AS pos,
    SUM( (fv.value::FLOAT) / POWER(wf."frequency", 0.4) ) AS SUM_BY_POS
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => WORD_VECTORS_US.WORD_VECTORS_US.tokenise_no_stop(n."body")) tok,
       WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf,
       WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv,
       LATERAL FLATTEN(input => gv."vector") fv
  WHERE wf."word" = tok.value::STRING
    AND gv."word" = tok.value::STRING
    AND fv.index < 300        -- keep dimensionality guard if desired
    AND gv."word" = wf."word"
  GROUP BY n."id", fv.index
) v
GROUP BY n."id"
LIMIT 20;
```

