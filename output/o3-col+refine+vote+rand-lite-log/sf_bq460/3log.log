),
tokens AS (                                                   /* ── tokenise ── */
    SELECT  art.id,
            LOWER(REGEXP_REPLACE(tok.value, '[^a-z0-9]', '')) AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE art,
         LATERAL SPLIT_TO_TABLE(                              -- split on space
             REGEXP_REPLACE(LOWER(art.body), '[^a-z0-9]+', ' '), ' '
         ) tok
    WHERE tok.value <> ''
      AND tok.value NOT IN (SELECT w FROM stop)
),
weighted AS (                                                 /* ── weight & flatten ── */
    SELECT
        t.id,
        vf.index                                    AS dim,
        (vf.value::FLOAT) /
        POWER(wf.frequency, 0.4)                    AS w_val
    FROM tokens t
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON wf.word = t.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON gv.word = t.word
         , LATERAL FLATTEN(input => gv.vector) vf
),
agg AS (                                                      /* ── sum per id+dim ── */
    SELECT  id, dim, SUM(w_val) AS dim_sum
    FROM    weighted
    GROUP BY id, dim
),
norms AS (                                                    /* ── compute L2 norms ── */
    SELECT
        id,
        SQRT(SUM(dim_sum * dim_sum)) AS l2
    FROM agg
    GROUP BY id
),
unit AS (                                                     /* ── unit-length vecs ── */
