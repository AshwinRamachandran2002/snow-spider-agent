--Description:  Compute cosine-similarity between the reference article
-- (ID = 8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373) and every other article,
-- returning the 10 most-similar (id, date, title, cosine_sim).
-- Pipeline inside one query:
--   1️⃣ tokenise every article, drop stop-words;
--   2️⃣ attach frequency & GloVe vector, flatten to (id,pos,val/freq^0.4);
--   3️⃣ sum per-article+dimension → aggregate vector;
--   4️⃣ normalise each vector to unit length;
--   5️⃣ flatten unit vectors, separate reference vs others;
--   6️⃣ dot-product (Σ v_ref[pos]*v_other[pos]) → cosine similarity;
--   7️⃣ pick top-10.

WITH stop AS ( SELECT COLUMN1 AS w FROM VALUES
    ('a'),('about'),('above'),('after'),('again'),('against'),('all'),('am'),('an'),
    ('and'),('any'),('are'),('as'),('at'),('be'),('because'),('been'),('before'),
    ('being'),('below'),('between'),('both'),('but'),('by'),('can'),('could'),
    ('did'),('do'),('does'),('doing'),('down'),('during'),('each'),('few'),('for'),
    ('from'),('further'),('had'),('has'),('have'),('having'),('he'),('her'),('here'),
    ('hers'),('herself'),('him'),('himself'),('his'),('how'),('i'),('if'),('in'),
    ('into'),('is'),('it'),('its'),('itself'),('just'),('me'),('more'),('most'),
    ('my'),('myself'),('no'),('nor'),('not'),('now'),('of'),('off'),('on'),('once'),
    ('only'),('or'),('other'),('our'),('ours'),('ourselves'),('out'),('over'),
    ('own'),('re'),('s'),('same'),('she'),('should'),('so'),('some'),('such'),
    ('than'),('that'),('the'),('their'),('theirs'),('them'),('themselves'),('then'),
    ('there'),('these'),('they'),('this'),('those'),('through'),('to'),('too'),
    ('under'),('until'),('up'),('very'),('was'),('we'),('were'),('what'),('when'),
    ('where'),('which'),('while'),('who'),('whom'),('why'),('will'),('with'),
    ('you'),('your'),('yours'),('yourself'),('yourselves')
),
tokens AS (                           -- 1️⃣ tokenise & filter
    SELECT
        art.id,
        LOWER(REGEXP_REPLACE(word, '[^a-z0-9]', '')) AS word
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE art,
         LATERAL SPLIT_TO_TABLE(
             REGEXP_REPLACE(LOWER(art.body), '[^a-z0-9]+', ' '), ' '
         ) t(word)
    WHERE word <> ''
      AND word NOT IN (SELECT w FROM stop)
),
weighted AS (                         -- 2️⃣ join freq & GloVe, weight & flatten
    SELECT
        gv.word,
        tok.id,
        vf.index                                       AS dim,
        (vf.value::FLOAT) / POWER(wf.frequency, 0.4)   AS w_val
    FROM tokens tok
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON wf.word = tok.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON gv.word = tok.word
    , LATERAL FLATTEN(input => gv.vector) vf
),
agg AS (                               -- 3️⃣ sum per article per dimension
    SELECT
        id,
        dim,
        SUM(w_val) AS dim_sum
    FROM weighted
    GROUP BY id, dim
),
vec AS (                               -- 4️⃣ assemble array + normalise
    SELECT
        id,
        ARRAY_AGG(dim_sum) WITHIN GROUP (ORDER BY dim)      AS vec,
        SQRT(ARRAY_SUM(ARRAY_AGG(dim_sum*dim_sum) WITHIN GROUP (ORDER BY dim))) AS norm
    FROM agg
    GROUP BY id
),
unit AS (
    SELECT
        id,
        ARRAY_TRANSFORM(vec, v -> v / NULLIFZERO(norm)) AS unit_vec
    FROM vec
),
ref AS (                               -- 5️⃣ flatten reference vector
    SELECT
        f.index AS dim,
        f.value::FLOAT AS val
    FROM unit,
         LATERAL FLATTEN(input => unit_vec) f
    WHERE id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
others AS (                            -- 5️⃣ flatten others
    SELECT
        u.id,
        f.index AS dim,
        f.value::FLOAT AS val
    FROM unit u,
         LATERAL FLATTEN(input => u.unit_vec) f
    WHERE u.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
dot AS (                               -- 6️⃣ dot product
    SELECT
        o.id,
        SUM(o.val * r.val) AS cosine_sim
    FROM others o
    JOIN ref   r USING (dim)
    GROUP BY o.id
)
SELECT
    art.id,
    art.date,
    art.title,
    d.cosine_sim
FROM dot d
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE art
  ON art.id = d.id
ORDER BY cosine_sim DESC
LIMIT 10;
