```sql
--Description:  Build weighted, normalised vectors for every article, then
-- compute cosine–similarity to the reference article
-- (ID = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373') and return the 10 most-similar.

WITH                                                                    -- 1️⃣ TOKENISE
tokens AS (
    SELECT
        n."id",
        LOWER(REGEXP_REPLACE(n."body", '[^a-z0-9]+', ' '))        AS body_clean
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
),                                                                     -- 2️⃣ SPLIT & FILTER
words AS (
    SELECT
        t."id",
        w.value::STRING AS word
    FROM tokens t,
         LATERAL SPLIT_TO_TABLE(t.body_clean, ' ') w
    WHERE w.value <> ''
      AND w.value NOT IN (                               -- stop-words (abbreviated)
          'a','about','above','after','again','against','all','am','an','and','any',
          'are','as','at','be','because','been','before','being','below','between',
          'both','but','by','can','could','did','do','does','doing','down','during',
          'each','few','for','from','further','had','has','have','having','he','her',
          'here','hers','herself','him','himself','his','how','i','if','in','into',
          'is','it','its','itself','just','me','more','most','my','myself','no','nor',
          'not','now','of','off','on','once','only','or','other','our','ours',
          'ourselves','out','over','own','re','s','same','she','should','so','some',
          'such','than','that','the','their','theirs','them','themselves','then',
          'there','these','they','this','those','through','to','too','under','until',
          'up','very','was','we','were','what','when','where','which','while','who',
          'whom','why','will','with','you','your','yours','yourself','yourselves'
      )
),                                                                     -- 3️⃣ ATTACH FREQ + VEC
word_vecs AS (
    SELECT
        w."id",
        gv."vector"           AS vec,
        wf."frequency"        AS freq
    FROM words w
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
      ON wf."word" = w.word
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
      ON gv."word" = w.word
),                                                                     -- 4️⃣ WEIGHT + EXPAND
expanded AS (
    SELECT
        id,
        f.index                         AS dim,
        (f.value::FLOAT) / POWER(freq, 0.4) AS weighted_val
    FROM word_vecs,
         LATERAL FLATTEN(input => vec) f
),                                                                     -- 5️⃣ SUM PER DIM
agg_dims AS (
    SELECT
        id,
        dim,
        SUM(weighted_val) AS dim_sum
    FROM expanded
    GROUP BY id, dim
),                                                                     -- 6️⃣ RE-ASSEMBLE ARRAY
article_vec AS (
    SELECT
        id,
        ARRAY_AGG(dim_sum ORDER BY dim) AS vec
    FROM agg_dims
    GROUP BY id
),                                                                     -- 7️⃣ NORMALISE
unit_vecs AS (
    SELECT
        id,
        vec,
        SQRT(ARRAY_SUM(ARRAY_TRANSFORM(vec, x -> x*x)))          AS norm,
        ARRAY_TRANSFORM(vec, x -> x / NULLIFZERO(
             SQRT(ARRAY_SUM(ARRAY_TRANSFORM(vec, y -> y*y)))
        ))                                                      AS unit_vec
    FROM article_vec
),                                                                     -- 8️⃣ FLATTEN REFERENCE
ref_vec AS (
    SELECT
        f.index AS dim,
        f.value::FLOAT AS val
    FROM unit_vecs,
         LATERAL FLATTEN(input => unit_vec) f
    WHERE id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),                                                                     -- 9️⃣ COSINE SIM
cosine AS (
    SELECT
        u.id,
        SUM(f.value::FLOAT * r.val) AS cos_sim
    FROM unit_vecs u,
         LATERAL FLATTEN(input => u.unit_vec) f
    JOIN ref_vec r
      ON r.dim = f.index
    WHERE u.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    GROUP BY u.id
)                                                                      -- 🔟 RETURN TOP-10
SELECT
    n."id",
    n."date",
    n."title",
    c.cos_sim AS cosine_similarity
FROM cosine c
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
  ON n."id" = c.id
ORDER BY cosine_similarity DESC
LIMIT 10;
```
