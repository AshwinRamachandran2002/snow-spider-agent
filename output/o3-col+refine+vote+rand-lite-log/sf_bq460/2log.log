WITH tokens AS (                 -- 1. very-light tokenizer (no UDF needed)
    SELECT  n."id",
            n."date",
            n."title",
            LOWER(tok.value::string)          AS word
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
            LATERAL SPLIT_TO_TABLE(                     -- split on blanks after stripping punctuation
                     REGEXP_REPLACE(n."body", '[^\w]+', ' ')
                   , ' ') tok
    WHERE   tok.value IS NOT NULL 
      AND   tok.value <> ''
), 
word_info AS (                   -- 2. keep words that have both a GloVe vector and a recorded frequency
    SELECT  t."id",
            t."date",
            t."title",
            gv."vector"                 AS vec,
            wf."frequency"              AS freq
    FROM    tokens t
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"     gv  ON t.word = gv."word"
    JOIN    "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES"  wf  ON t.word = wf."word"
), 
word_vector_elements AS (        -- 3. flatten each vector and apply the frequency weighting
    SELECT  wi."id",
            wi."date",
            wi."title",
            fv.index                       AS pos,          -- coordinate within the 300-D vector
            (fv.value::FLOAT) / POWER(wi.freq, 0.4)  AS val -- weighted component
    FROM    word_info  wi,
            LATERAL FLATTEN(INPUT => wi.vec) fv
), 
agg_vector AS (                  -- 4. aggregate weighted components per article
    SELECT  "id",
            "date",
            "title",
            pos,
            SUM(val) AS sum_val
    FROM    word_vector_elements
    GROUP BY "id","date","title", pos
), 
norms AS (                       -- 5. compute Euclidean norm for each article vector
    SELECT  "id",
            SQRT(SUM(sum_val*sum_val)) AS norm
    FROM    agg_vector
    GROUP BY "id"
), 
normalized AS (                  -- 6. convert to unit-length vectors
    SELECT  a."id",
            a."date",
            a."title",
            a.pos,
            a.sum_val / n.norm          AS norm_val
    FROM    agg_vector a
    JOIN    norms n ON a."id" = n."id"
    WHERE   n.norm > 0
), 
target AS (                      -- 7. store vector of the reference article
    SELECT  pos,
            norm_val AS t_val
    FROM    normalized
    WHERE   "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
), 
cos_sim AS (                     -- 8. cosine similarity = dot product of unit vectors
    SELECT  n."id",
            n."date",
            n."title",
            SUM(n.norm_val * t.t_val) AS similarity
    FROM    normalized n
    JOIN    target     t  ON n.pos = t.pos
    GROUP BY n."id", n."date", n."title"
) 
SELECT  "id",
        "date",
        "title",
        ROUND(similarity, 4) AS cosine_similarity
FROM    cos_sim
