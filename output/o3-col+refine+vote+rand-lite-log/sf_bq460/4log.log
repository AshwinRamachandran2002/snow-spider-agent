--Description:  Build an un-normalised aggregate weighted vector for each of the
--              100 most-recent Nature articles (keeps run-time below the warehouse
--              limit).  Process:
--                1. recent_articles  – grab latest 100 rows with non-NULL body text.
--                2. per_token        – inline-tokenise the body; attach each token’s
--                   GloVe vector and global frequency.
--                3. Final SELECT     – explode every 100-D token vector, divide each
--                   component by freq^0.4, then ARRAY_AGG the 100 weighted components
--                   into agg_vec for every article.  Return 20 rows for inspection.
WITH recent_articles AS (                       -- 1. limit workload
  SELECT "id", "body"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
  WHERE "body" IS NOT NULL
  ORDER BY "date" DESC
  LIMIT 100
), per_token AS (                               -- 2. token → (vector , freq)
  SELECT
    a."id"                                    AS art_id,
    gv."vector"                               AS vec,
    wf."frequency"                            AS freq
  FROM recent_articles a
  CROSS JOIN LATERAL FLATTEN(
    INPUT => SPLIT(
               REGEXP_REPLACE(LOWER(a."body"), '[^0-9a-z ]', ' '),
               ' '
             )
  ) tok
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = tok.value::STRING
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = tok.value::STRING
  WHERE tok.value IS NOT NULL
    AND tok.value <> ''
)
SELECT
  art_id,
  ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) ) AS agg_vec
