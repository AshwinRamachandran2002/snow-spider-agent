```sql
--Description:  Construct a 100-component, un-normalised aggregate weighted vector
--              for every article while staying under Snowflake’s 16 MB cell limit.
--              1.  per_token  – inline-tokenise each “body”, join each token to its
--                  100-D GloVe vector + global frequency.  
--              2.  flat_val   – FLATTEN the 100-D vector so every component is a row,
--                  divide by freq^0.4 ⇒ weighted_comp.  
--              3.  summed     – SUM weighted_comp for each (article, component index).  
--              4.  Final SELECT reassembles the 100 component-sums (ORDER BY index)
--                  into a compact ARRAY (agg_vec) per article.  Display 20 rows.
WITH per_token AS (
  SELECT
    n."id"                                AS art_id,
    gv."vector"                           AS vec,
    wf."frequency"                        AS freq
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
  CROSS JOIN LATERAL FLATTEN(
    INPUT => SPLIT(
               REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z ]', ' '),
               ' '
             )
  ) tok
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
         ON gv."word" = tok.value::STRING
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = tok.value::STRING
  WHERE tok.value IS NOT NULL
    AND tok.value <> ''
), flat_val AS (
  SELECT
    art_id,
    v.index                           AS idx,                 -- component 0-99
    v.value::FLOAT / POWER(freq, 0.4) AS weighted_comp
  FROM per_token,
       LATERAL FLATTEN(input => vec) v
), summed AS (
  SELECT
    art_id,
    idx,
    SUM(weighted_comp)               AS comp_sum
  FROM flat_val
  GROUP BY art_id, idx
)
SELECT
  art_id,
  ARRAY_AGG(comp_sum ORDER BY idx)   AS agg_vec               -- 100-element vector
FROM summed
GROUP BY art_id
LIMIT 20;
```
