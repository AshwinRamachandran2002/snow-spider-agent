```sql
-- 3. Description: Tokenise the body of that same article (stop-words removed) so we can inspect the remaining word list.
SELECT
  token.value::STRING  AS "token"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
     LATERAL FLATTEN(
       input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
     ) token
WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 4. Description: Join those tokens to WORD_FREQUENCIES to see each token’s global frequency.
SELECT
  tok.value::STRING                           AS "word",
  wf."frequency"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE      AS n,
     LATERAL FLATTEN(
       input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
     )                                           AS tok
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES  AS wf
       ON wf."word" = tok.value::STRING
WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 5. Description: Attach GloVe vectors to those same words so we can check that the vectors really exist.
SELECT
  tok.value::STRING                           AS "word",
  gv."vector"
FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE      AS n,
     LATERAL FLATTEN(
       input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
     )                                           AS tok
LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS      AS gv
       ON gv."word" = tok.value::STRING
WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT 20;
```

```sql
-- 6. Description: For that one article, compute the weighted vector for every token
--                (vector / frequency^0.4) and sum them into one aggregate VECTOR column.
WITH tokens AS (
  SELECT
    tok.value::STRING                               AS word,
    gv."vector"                                     AS vec,
    wf."frequency"                                  AS freq
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
       )                                            tok
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = tok.value::STRING
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = tok.value::STRING
  WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
  ARRAY_AGG( (value::FLOAT) / POWER(freq, 0.4) )   WITHIN GROUP (ORDER BY seq4()) AS "weighted_component_vector"
FROM tokens,
     LATERAL FLATTEN(input => tokens.vec);
```

```sql
-- 7. Description: Produce an aggregate (still un-normalised) vector for EVERY article; one row per article.
WITH per_token AS (
  SELECT
    n."id"                                          AS art_id,
    gv."vector"                                     AS vec,
    wf."frequency"                                  AS freq
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(
         input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
       )                                            tok
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = tok.value::STRING
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = tok.value::STRING
)
SELECT
  art_id,
  ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) ) 
     WITHIN GROUP (ORDER BY seq4())                AS agg_vec
FROM per_token,
     LATERAL FLATTEN(input => per_token.vec) val
GROUP BY art_id
LIMIT 20;
```

```sql
-- 8. Description: Take those aggregate vectors and also store their magnitudes
--                (so we can normalise and later compute cosine similarities fast).
WITH agg AS (
  /* re-use the aggregation in query #7 */
  SELECT
    art_id,
    ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) ) 
      WITHIN GROUP (ORDER BY seq4())               AS agg_vec
  FROM (
    SELECT
      n."id"                                         AS art_id,
      gv."vector"                                    AS vec,
      wf."frequency"                                 AS freq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
           input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
         )                                           tok
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
           ON gv."word" = tok.value::STRING
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = tok.value::STRING
  ) inner_tbl,
  LATERAL FLATTEN(input => inner_tbl.vec) val
  GROUP BY art_id
)
SELECT
  art_id,
  agg_vec,
  SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, x -> (x * x)) )) AS mag
FROM agg
LIMIT 20;
```

```sql
-- 9. Description: Pre-normalise those vectors to unit length so cosine similarity reduces to simple dot product.
WITH agg AS (
  /* same aggregation block as above, shortened for clarity */
  SELECT
    art_id,
    ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) ) 
      WITHIN GROUP (ORDER BY seq4())               AS agg_vec
  FROM (
    SELECT
      n."id"                                         AS art_id,
      gv."vector"                                    AS vec,
      wf."frequency"                                 AS freq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
         LATERAL FLATTEN(
           input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
         )                                           tok
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
           ON gv."word" = tok.value::STRING
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = tok.value::STRING
  ) inner_tbl,
  LATERAL FLATTEN(input => inner_tbl.vec) val
  GROUP BY art_id
)
SELECT
  art_id,
  ARRAY_TRANSFORM(
      agg_vec,
      x -> x / SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, y -> (y*y)) ))
  )                                                 AS unit_vec
FROM agg
LIMIT 20;
```

```sql
-- 10. Description: Final query – produce the 10 articles whose unit-vectors have the highest cosine similarity 
--                 (dot product) with the query article’s unit-vector.  
WITH unit_vectors AS (
  /* create one unit-length vector per article (same logic as #9) */
  SELECT
    art_id,
    ARRAY_TRANSFORM(
      agg_vec,
      x -> x / SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, y -> (y*y)) ))
    )                                               AS unit_vec
  FROM (
    /* aggregate weighted vectors per article */
    SELECT
      art_id,
      ARRAY_AGG(weighted.value::FLOAT) 
           WITHIN GROUP (ORDER BY seq4())           AS agg_vec
    FROM (
      SELECT
        n."id"                                      AS art_id,
        gv."vector"                                 AS vec,
        wf."frequency"                              AS freq
      FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL FLATTEN(
             input => spider2-public-data.word_vectors_us.tokenise_no_stop(n."body")
           ) tok
      LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
             ON gv."word" = tok.value::STRING
      LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
             ON wf."word" = tok.value::STRING
    ) per_token,
    LATERAL FLATTEN(input => per_token.vec) raw,
    LATERAL (
      SELECT raw.value::FLOAT / POWER(per_token.freq, 0.4) AS value
    ) weighted
    GROUP BY art_id
  )
),
query_vec AS (
  SELECT unit_vec
  FROM unit_vectors
  WHERE art_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
  n."id",
  n."date",
  n."title",
  ARRAY_SUM(
    ARRAY_ZIP_WITH(
      uv.unit_vec,
      (SELECT unit_vec FROM query_vec),
      (u,q) -> (u*q)
    )
  )                                                AS cosine_similarity
FROM unit_vectors uv
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
     ON n."id" = uv.art_id
WHERE uv.art_id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY cosine_similarity DESC
LIMIT 10;
```
