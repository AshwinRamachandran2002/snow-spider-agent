               REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z ]', ' '),
               ' '
             )
  ) tok
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = tok.value::STRING
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = tok.value::STRING
  WHERE tok.value IS NOT NULL
    AND tok.value <> ''
)
SELECT
  art_id,
  ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) )
      WITHIN GROUP (ORDER BY seq4())              AS agg_vec
FROM per_token,
     LATERAL FLATTEN(input => per_token.vec) val
GROUP BY art_id
LIMIT 20;
```

```sql
--Description:  #8 ‒ Re-use the weighted aggregation from #7, then compute each
--              article’s vector magnitude (Euclidean norm) so we can normalise later.
WITH agg AS (
  SELECT
    art_id,
    ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) )
        WITHIN GROUP (ORDER BY seq4())            AS agg_vec
  FROM (
    SELECT
      n."id"                                      AS art_id,
      gv."vector"                                 AS vec,
      wf."frequency"                              AS freq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
    CROSS JOIN LATERAL FLATTEN(
      INPUT => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z ]', ' '),
                 ' '
               )
    ) tok
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
           ON gv."word" = tok.value::STRING
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = tok.value::STRING
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
  ) src,
  LATERAL FLATTEN(input => src.vec) val
  GROUP BY art_id
)
SELECT
  art_id,
  agg_vec,
  SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, x -> x * x) ))  AS mag
FROM agg
LIMIT 20;
```

```sql
--Description:  #9 ‒ Produce a UNIT-length vector for every article by dividing each
--              component of agg_vec by its magnitude (norm).
WITH agg AS (
  SELECT
    art_id,
    ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) )
        WITHIN GROUP (ORDER BY seq4())            AS agg_vec
  FROM (
    SELECT
      n."id"                                      AS art_id,
      gv."vector"                                 AS vec,
      wf."frequency"                              AS freq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
    CROSS JOIN LATERAL FLATTEN(
      INPUT => SPLIT(
                 REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z ]', ' '),
                 ' '
               )
    ) tok
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
           ON gv."word" = tok.value::STRING
    LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
           ON wf."word" = tok.value::STRING
    WHERE tok.value IS NOT NULL
      AND tok.value <> ''
  ) src,
  LATERAL FLATTEN(input => src.vec) val
  GROUP BY art_id
)
SELECT
  art_id,
  ARRAY_TRANSFORM(
     agg_vec,
     x -> x / SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, y -> y*y ) ))
  )                                               AS unit_vec
FROM agg
LIMIT 20;
```

```sql
--Description:  #10 ‒ Compute cosine similarity (dot product, since vectors are unit
--              length) between every article and the query article, returning the
--              10 most similar articles (ID, date, title, similarity score).
WITH unit_vectors AS (
  /* build unit vectors for every article (same logic as #9) */
  SELECT
    art_id,
    ARRAY_TRANSFORM(
       agg_vec,
       x -> x / SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, y -> y*y ) ))
    )                                             AS unit_vec
  FROM (
    /* aggregate weighted components for each article */
    SELECT
      art_id,
      ARRAY_AGG(weighted.value::FLOAT)
          WITHIN GROUP (ORDER BY seq4())          AS agg_vec
    FROM (
      SELECT
        n."id"                                    AS art_id,
        gv."vector"                               AS vec,
        wf."frequency"                            AS freq
      FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
      CROSS JOIN LATERAL FLATTEN(
        INPUT => SPLIT(
                   REGEXP_REPLACE(LOWER(n."body"), '[^0-9a-z ]', ' '),
                   ' '
                 )
      ) tok
      LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
             ON gv."word" = tok.value::STRING
      LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
             ON wf."word" = tok.value::STRING
      WHERE tok.value IS NOT NULL
        AND tok.value <> ''
    ) per_token,
    LATERAL FLATTEN(input => per_token.vec) raw,
    LATERAL ( SELECT raw.value::FLOAT / POWER(per_token.freq, 0.4) AS value ) weighted
    GROUP BY art_id
  )
),
query_vec AS (
  SELECT unit_vec
  FROM unit_vectors
  WHERE art_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
  n."id",
  n."date",
  n."title",
  ARRAY_SUM(
    ARRAY_ZIP_WITH(
      uv.unit_vec,
      (SELECT unit_vec FROM query_vec),
      (u,q) -> u*q
    )
  )                                               AS cosine_similarity
FROM unit_vectors uv
JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE n
     ON n."id" = uv.art_id
WHERE uv.art_id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER BY cosine_similarity DESC
LIMIT 10;
```
