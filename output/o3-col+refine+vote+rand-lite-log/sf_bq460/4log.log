```sql
--Description:  Produce unit-length (normalised) aggregate vectors for the most-recent
--              50 Nature articles, keeping the workload small enough to avoid timeout.
--              Steps inside the CTE cascade:
--                1. recent_articles  – grab 50 newest rows with non-NULL body text.
--                2. per_token        – inline-tokenise each body, join to GloVe + frequency
--                                       so we have (vector, freq) for every token.
--                3. agg              – build an un-normalised aggregate vector
--                                       Σ( token_vector / freq^0.4 ) for each article.
--                4. final SELECT     – divide each component of agg_vec by its Euclidean
--                                       norm to obtain a unit vector (ready for cosine
--                                       similarity work) and show the first 20 rows.
WITH recent_articles AS (               -- 1. limit to newest 50 articles
  SELECT "id", "body"
  FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE
  WHERE "body" IS NOT NULL
  ORDER BY "date" DESC
  LIMIT 50
), per_token AS (                       -- 2. token → vector + frequency
  SELECT
    a."id"                              AS art_id,
    gv."vector"                         AS vec,
    wf."frequency"                      AS freq
  FROM recent_articles a
  CROSS JOIN LATERAL FLATTEN(
    INPUT => SPLIT(
               REGEXP_REPLACE(LOWER(a."body"), '[^0-9a-z ]', ' '),
               ' '
             )
  ) tok
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS   gv
         ON gv."word" = tok.value::STRING
  LEFT JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
         ON wf."word" = tok.value::STRING
  WHERE tok.value IS NOT NULL
    AND tok.value <> ''
), agg AS (                             -- 3. aggregate weighted vector per article
  SELECT
    art_id,
    ARRAY_AGG( (val.value::FLOAT) / POWER(freq, 0.4) )
        WITHIN GROUP (ORDER BY seq4())  AS agg_vec
  FROM per_token,
       LATERAL FLATTEN(input => per_token.vec) val
  GROUP BY art_id
)
SELECT
  art_id,
  ARRAY_TRANSFORM(                      -- 4. normalise to unit length
     agg_vec,
     x -> x / SQRT(ARRAY_SUM( ARRAY_TRANSFORM(agg_vec, y -> y*y) ))
  ) AS unit_vec
FROM agg
LIMIT 20;
