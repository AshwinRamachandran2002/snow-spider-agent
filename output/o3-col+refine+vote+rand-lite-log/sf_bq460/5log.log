```sql
--Description: 9) Calculate cosine similarity between every article and the reference article, returning top 20 scores.
WITH norm_vecs AS (
    SELECT
        n."id",
        SUM( vec."vector" / POWER(freq."frequency", 0.4) )              AS "agg_vec"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN( input =>
             ("spider2-public-data".word_vectors_us.tokenise_no_stop(n."body"))
         ) w
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" vec
                  ON LOWER(w.value::STRING) = LOWER(vec."word")
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
                  ON LOWER(w.value::STRING) = LOWER(freq."word")
    GROUP BY n."id"
), unit_vecs AS (
    SELECT
        "id",
        "agg_vec" / NULLIF( SQRT( SUM( POWER(value::FLOAT,2) ) ), 0 )   AS "unit_vec"
    FROM norm_vecs, LATERAL FLATTEN( input => norm_vecs."agg_vec" )
    GROUP BY "id", "agg_vec"
), ref AS (
    SELECT "unit_vec" AS "ref_vec"
    FROM unit_vecs
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
    u."id",
    SUM( u."unit_vec"[index]::FLOAT * r."ref_vec"[index]::FLOAT ) AS "cosine_similarity"
FROM unit_vecs u,
     ref r,
     LATERAL FLATTEN( input => ARRAY_CONSTRUCT_SEQUENCE(0, 99) ) f(index)
GROUP BY u."id"
ORDER BY "cosine_similarity" DESC
LIMIT 20;
```

```sql
--Description: 10) Retrieve IDs, dates and titles of the 10 articles most similar to the reference article.
WITH similarities AS (
    /*  (Use query 9 as a CTE here and pick top-10) */
    SELECT
        u."id",
        SUM( u."unit_vec"[idx]::FLOAT * r."ref_vec"[idx]::FLOAT ) AS "score"
    FROM (
            SELECT
                id,
                agg_vec / NULLIF(SQRT(SUM(POWER(value::FLOAT,2))),0) AS unit_vec
            FROM (
                    SELECT n.id,
                           SUM(vec.vector / POWER(freq.frequency,0.4)) AS agg_vec
                    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
                         LATERAL FLATTEN( input =>
                             ("spider2-public-data".word_vectors_us.tokenise_no_stop(n.body))
                         ) w
                         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" vec
                              ON LOWER(w.value::STRING)=LOWER(vec.word)
                         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
                              ON LOWER(w.value::STRING)=LOWER(freq.word)
                    GROUP BY n.id
            ) v,
            LATERAL FLATTEN(input => v.agg_vec)
        ) u,
        ( SELECT unit_vec AS ref_vec
          FROM (
                  SELECT agg_vec / NULLIF(SQRT(SUM(POWER(value::FLOAT,2))),0) AS unit_vec
                  FROM (
                          SELECT SUM(vec.vector / POWER(freq.frequency,0.4)) AS agg_vec
                          FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
                               LATERAL FLATTEN( input =>
                                   ("spider2-public-data".word_vectors_us.tokenise_no_stop(n.body))
                               ) w
                               JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" vec
                                    ON LOWER(w.value::STRING)=LOWER(vec.word)
                               JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
                                    ON LOWER(w.value::STRING)=LOWER(freq.word)
                          WHERE n.id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
                  ), LATERAL FLATTEN(input => agg_vec)
        ) r,
        LATERAL FLATTEN( input => ARRAY_CONSTRUCT_SEQUENCE(0,99) ) idx
    GROUP BY u.id
    ORDER BY score DESC
    LIMIT 10
)
SELECT
    n."id",
    n."date",
    n."title",
    s."score" AS "cosine_similarity"
FROM similarities s
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
     ON n."id" = s."id"
ORDER BY s."score" DESC
LIMIT 20;
```
