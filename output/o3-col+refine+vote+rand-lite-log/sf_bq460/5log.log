```sql
--Description: 8) Build normalised aggregate vectors for ALL articles (first 3 dims) ready for similarity computation.
WITH per_article AS (
    SELECT
        n."id",
        SUM( vec."vector" / POWER(freq."frequency", 0.4) ) AS "agg_vec"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN( input =>
             ("spider2-public-data".word_vectors_us.tokenise_no_stop(n."body"))
         ) w
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" vec
                  ON LOWER(w.value::STRING) = LOWER(vec."word")
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
                  ON LOWER(w.value::STRING) = LOWER(freq."word")
    GROUP BY n."id"
)
SELECT
    "id",
    ("agg_vec"[0]::FLOAT) / NULLIF(SQRT(SUM(POWER(value::FLOAT,2))),0)  AS "n_d0",
    ("agg_vec"[1]::FLOAT) / NULLIF(SQRT(SUM(POWER(value::FLOAT,2))),0)  AS "n_d1",
    ("agg_vec"[2]::FLOAT) / NULLIF(SQRT(SUM(POWER(value::FLOAT,2))),0)  AS "n_d2"
FROM per_article,
     LATERAL FLATTEN( input => per_article."agg_vec" )
GROUP BY "id", "agg_vec"
LIMIT 20;
