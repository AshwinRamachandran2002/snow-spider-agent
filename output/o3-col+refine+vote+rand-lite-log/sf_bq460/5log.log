--Description: 6) Aggregate the weighted vectors of all tokens from the reference article into a single summed vector (first 5 dims).
WITH token_vectors AS (
    SELECT
        ARRAY_CONSTRUCT_SEQUENCE(0, 99)      AS "dim_idx",      -- assume 100-d vectors
        vec."vector" / POWER(freq."frequency", 0.4)              AS "w_vec"
    FROM (
            SELECT w.value::STRING AS "token"
            FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
                 LATERAL FLATTEN( input =>
                     ("spider2-public-data".word_vectors_us.tokenise_no_stop(n."body"))
                 ) w
            WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    ) t
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" vec
              ON LOWER(t."token") = LOWER(vec."word")
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
              ON LOWER(t."token") = LOWER(freq."word")
)
SELECT
    SUM("w_vec"[0])  AS "agg_d0",
    SUM("w_vec"[1])  AS "agg_d1",
    SUM("w_vec"[2])  AS "agg_d2",
    SUM("w_vec"[3])  AS "agg_d3",
    SUM("w_vec"[4])  AS "agg_d4"
FROM token_vectors
LIMIT 20;
