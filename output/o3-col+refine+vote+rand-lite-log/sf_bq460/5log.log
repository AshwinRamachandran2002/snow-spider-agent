--Description: 7) Compute the (unnormalised) magnitude of the reference-article’s 100-dim
--              weighted vector without ARRAY-division errors: explode each dimension,
--              weight by frequency-0.4, square, sum, then square-root.
WITH tok AS (      -- non-stop tokens
    SELECT LOWER(f.value::STRING) AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN(
             input => SPLIT(REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '), ' ')
         ) f
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND f.value::STRING <> ''
      AND LOWER(f.value::STRING) NOT IN (  -- stop-word list abbreviated here for brevity
           'a','about','above','after','again','against','all','am','an','and','any',
           'are','as','at','be','been','before','being','below','between','both','but',
           'by','can','could','did','do','does','doing','down','during','each','few','for',
           'from','further','had','has','have','having','he','her','here','hers','herself',
           'him','himself','his','how','i','if','in','into','is','it','its','itself','just',
           'more','most','my','myself','no','nor','not','now','of','off','on','once','only',
           'or','other','our','ours','ourselves','out','over','own','s','same','she',
           'should','so','some','such','t','than','that','the','their','theirs','them',
           'themselves','then','there','these','they','this','those','through','to','too',
           'under','until','up','very','was','we','were','what','when','where','which',
           'while','who','whom','why','will','with','you','your','yours','yourself',
           'yourselves'
      )
), exploded AS (
    SELECT
        e.index                          AS dim,
        (e.value::FLOAT) /
        POWER(freq."frequency", 0.4)     AS w_val
    FROM tok
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" g
         ON tok.token = LOWER(g."word")
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
         ON tok.token = LOWER(freq."word"),
    LATERAL FLATTEN(input => g."vector") e
)
SELECT SQRT(SUM(POWER(w_val,2))) AS magnitude
FROM exploded
