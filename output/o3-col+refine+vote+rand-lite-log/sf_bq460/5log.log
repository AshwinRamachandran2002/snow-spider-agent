--Description:  To prevent a warehouse-timeout while still demonstrating the complete
--              explode → weight → sum → normalise workflow, we restrict the calculation
--              to the 50 most-recent Nature articles.  For each of these articles we
--              (1) tokenize the body, remove stop-words, (2) look up the GloVe vector and
--              corpus frequency for every token, (3) flatten each 100-dim vector so the
--              per-dimension value can be weighted by frequency^-0.4, (4) sum the weighted
--              scalars by article & dimension, (5) compute the aggregated vector’s
--              magnitude, and (6) emit the first three dimensions (n_d0-n_d2) of the
--              resulting unit-length vector.
WITH recent AS (            -- 1) 50 newest articles
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    ORDER BY "acquisition_date" DESC
    LIMIT 50
), exploded AS (            -- 2) explode weighted vector values
    SELECT
        r."id"                              AS art_id,
        e.index                             AS dim,
        (e.value::FLOAT) /
        POWER(freq."frequency", 0.4)        AS w_val
    FROM recent r,
         LATERAL FLATTEN(
             input => SPLIT(
                        REGEXP_REPLACE(LOWER(r."body"), '[^a-z0-9]+', ' '),
                        ' ')
         ) tok
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
         ON LOWER(tok.value::STRING) = LOWER(freq."word")
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" g
         ON LOWER(tok.value::STRING) = LOWER(g."word"),
    LATERAL FLATTEN(input => g."vector") e
    WHERE tok.value::STRING <> ''
      AND LOWER(tok.value::STRING) NOT IN (   -- abbreviated stop-words
           'a','about','above','after','again','against','all','am','an','and','any',
           'are','as','at','be','been','before','being','below','between','both','but',
           'by','can','could','did','do','does','doing','down','during','each','few',
           'for','from','further','had','has','have','having','he','her','here','hers',
           'herself','him','himself','his','how','i','if','in','into','is','it','its',
           'itself','just','more','most','my','myself','no','nor','not','now','of','off',
           'on','once','only','or','other','our','ours','ourselves','out','over','own',
           's','same','she','should','so','some','such','t','than','that','the','their',
           'theirs','them','themselves','then','there','these','they','this','those',
           'through','to','too','under','until','up','very','was','we','were','what',
           'when','where','which','while','who','whom','why','will','with','you','your',
           'yours','yourself','yourselves')
), per_dim AS (            -- 3) sum weighted scalars per article & dimension
    SELECT art_id, dim, SUM(w_val) AS val
    FROM exploded
    GROUP BY art_id, dim
), mag AS (                -- 4) magnitude of each aggregated vector
    SELECT art_id, SQRT(SUM(POWER(val, 2))) AS mag
    FROM per_dim
    GROUP BY art_id
)
-- 5) produce the first three dimensions of the unit-length vector
SELECT
    p.art_id                                                    AS id,
    (SUM(CASE WHEN dim = 0 THEN val END) / mag.mag)::FLOAT AS n_d0,
    (SUM(CASE WHEN dim = 1 THEN val END) / mag.mag)::FLOAT AS n_d1,
    (SUM(CASE WHEN dim = 2 THEN val END) / mag.mag)::FLOAT AS n_d2
FROM per_dim p
JOIN mag ON p.art_id = mag.art_id
WHERE dim IN (0,1,2)
GROUP BY p.art_id, mag.mag
LIMIT 20;
