--Description: 10) Retrieve IDs, dates, titles and similarity scores of the 10 articles
--               most similar to the reference article, using the same 50-article subset
--               to keep runtime low.
WITH recent AS (
    SELECT "id", "body", "date", "title"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    ORDER BY "acquisition_date" DESC
    LIMIT 50
), exploded AS (
    SELECT
        r."id"                       AS art_id,
        e.index                      AS dim,
        (e.value::FLOAT) / POWER(freq."frequency",0.4) AS w_val
    FROM recent r,
         LATERAL FLATTEN(
             input => SPLIT(
                        REGEXP_REPLACE(LOWER(r."body"), '[^a-z0-9]+', ' '), ' ')
         ) tok
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
         ON LOWER(tok.value::STRING)=LOWER(freq."word")
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" g
         ON LOWER(tok.value::STRING)=LOWER(g."word"),
    LATERAL FLATTEN(input => g."vector") e
    WHERE tok.value::STRING <> ''
      AND LOWER(tok.value::STRING) NOT IN (
           'a','about','above','after','again','against','all','am','an','and','any','are',
           'as','at','be','been','before','being','below','between','both','but','by','can',
           'could','did','do','does','doing','down','during','each','few','for','from',
           'further','had','has','have','having','he','her','here','hers','herself','him',
           'himself','his','how','i','if','in','into','is','it','its','itself','just','more',
           'most','my','myself','no','nor','not','now','of','off','on','once','only','or',
           'other','our','ours','ourselves','out','over','own','s','same','she','should','so',
           'some','such','t','than','that','the','their','theirs','them','themselves','then',
           'there','these','they','this','those','through','to','too','under','until','up',
           'very','was','we','were','what','when','where','which','while','who','whom','why',
           'will','with','you','your','yours','yourself','yourselves')
), per_dim AS (
    SELECT art_id, dim, SUM(w_val) AS val
    FROM exploded
    GROUP BY art_id, dim
), mag AS (
    SELECT art_id, SQRT(SUM(POWER(val,2))) AS mag
    FROM per_dim
    GROUP BY art_id
), unit AS (
    SELECT p.art_id, p.dim, p.val / m.mag AS u_val
    FROM per_dim p
    JOIN mag m ON p.art_id = m.art_id
), ref AS (
    SELECT dim, u_val
    FROM unit
    WHERE art_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
), sims AS (
    SELECT
        u.art_id,
        SUM(u.u_val * r.u_val) AS score
    FROM unit u
    JOIN ref r ON u.dim = r.dim
    GROUP BY u.art_id
    ORDER BY score DESC
    LIMIT 10
)
SELECT
    n."id",
    n."date",
    n."title",
    s."score" AS cosine_similarity
FROM sims s
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
     ON n."id" = s."art_id"
ORDER BY s."score" DESC;
