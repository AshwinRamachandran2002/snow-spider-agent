--Description:  Build a working set that certainly contains the reference article plus the
--              20 most-recent additional papers (by "acquisition_date").  
--              1)  subset  – reference UNION 20 newest others (keeping acquisition_date so
--                             ORDER BY works).  
--              2)  exploded– tokenise each body; join to GloVe vectors and word-frequency;
--                             flatten the 100-dim vector and weight each scalar by
--                             frequency^-0.4.  
--              3)  per_dim – sum the weighted scalars for every (article, dimension).  
--              4)  mag     – compute the magnitude of every article’s aggregate vector.  
--              5)  unit    – normalise the summed vector (value / magnitude).  
--              6)  ref     – pick the unit-rows that belong to the reference article.  
--              7)  final   – dot-product of each article’s unit rows with the reference
--                             unit rows → cosine similarity.  Return the top 20 scores.
WITH subset AS (                             -- 1) reference + 20 newest others
    SELECT  "id",
            "body",
            "acquisition_date"
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE   "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'

    UNION ALL

    SELECT  "id",
            "body",
            "acquisition_date"
    FROM    "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE   "id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    ORDER BY "acquisition_date" DESC
    LIMIT 20
), exploded AS (                             -- 2) tokenise → vector → weight
    SELECT
        s."id"                                            AS art_id,
        v.index                                           AS dim,
        (v.value::FLOAT) / POWER(f."frequency", 0.4)      AS w_val
    FROM subset s,
         LATERAL FLATTEN(                                 -- simple tokenizer
             INPUT => SPLIT(
                        REGEXP_REPLACE(LOWER(s."body"), '[^a-z0-9]+', ' '), ' ')
         ) tok
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" f
         ON LOWER(tok.value::STRING) = LOWER(f."word")
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" g
         ON LOWER(tok.value::STRING) = LOWER(g."word"),
    LATERAL FLATTEN(INPUT => g."vector") v
    WHERE tok.value::STRING <> ''
), per_dim AS (                              -- 3) sum weighted scalars
    SELECT art_id, dim, SUM(w_val) AS val
    FROM exploded
    GROUP BY art_id, dim
), mag AS (                                  -- 4) magnitude per article
    SELECT art_id, SQRT(SUM(POWER(val, 2))) AS mag
    FROM per_dim
    GROUP BY art_id
), unit AS (                                 -- 5) unit-length rows
    SELECT p.art_id,
           p.dim,
           p.val / m.mag                     AS u_val
    FROM per_dim p
    JOIN mag m
      ON p.art_id = m.art_id
), ref AS (                                  -- 6) reference rows
    SELECT dim, u_val
    FROM unit
    WHERE art_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
-- 7) cosine similarity with reference
SELECT
    u.art_id                                 AS "id",
    SUM(u.u_val * r.u_val)                   AS "cosine_similarity"
FROM unit u
JOIN ref r
  ON u.dim = r.dim
GROUP BY u.art_id
ORDER BY "cosine_similarity" DESC
LIMIT 20;
