--Description:  Flatten each 100-dim GloVe vector into (dimension, value) rows, weight every
--              scalar by frequency-0.4, sum per dimension, then pick dimensions 0-4.  
--              This avoids the VARIANT-to-FLOAT cast error that occurs when dividing the
--              whole array at once.
WITH tokens AS (   -- 1) all non-stop tokens of the reference article
    SELECT LOWER(f.value::STRING) AS token
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN(
             input => SPLIT(
                        REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                        ' '
                      )
         ) f
    WHERE n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND f.value::STRING <> ''
      AND LOWER(f.value::STRING) NOT IN (
           'a','about','above','after','again','against','all','am','an','and','any','are',
           'as','at','be','been','before','being','below','between','both','but','by','can',
           'could','did','do','does','doing','down','during','each','few','for','from',
           'further','had','has','have','having','he','her','here','hers','herself','him',
           'himself','his','how','i','if','in','into','is','it','its','itself','just','more',
           'most','my','myself','no','nor','not','now','of','off','on','once','only','or',
           'other','our','ours','ourselves','out','over','own','s','same','she','should','so',
           'some','such','t','than','that','the','their','theirs','them','themselves','then',
           'there','these','they','this','those','through','to','too','under','until','up',
           'very','was','we','were','what','when','where','which','while','who','whom','why',
           'will','with','you','your','yours','yourself','yourselves'
      )
), vec_freq AS (  -- 2) attach GloVe vector and word frequency
    SELECT g."vector" AS vec, f."frequency" AS freq
    FROM tokens t
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" g
         ON t.token = LOWER(g."word")
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" f
         ON t.token = LOWER(f."word")
), exploded AS (  -- 3) explode vector and weight value
    SELECT e.index AS dim,
           (e.value::FLOAT) / POWER(v.freq, 0.4) AS w_val
    FROM vec_freq v,
         LATERAL FLATTEN(input => v.vec) e
), aggregated AS ( -- 4) sum per dimension
    SELECT dim, SUM(w_val) AS agg_val
    FROM exploded
    GROUP BY dim
)
-- 5) pivot first five summed dimensions into columns
SELECT
    MAX(CASE WHEN dim = 0 THEN agg_val END) AS agg_d0,
    MAX(CASE WHEN dim = 1 THEN agg_val END) AS agg_d1,
    MAX(CASE WHEN dim = 2 THEN agg_val END) AS agg_d2,
    MAX(CASE WHEN dim = 3 THEN agg_val END) AS agg_d3,
    MAX(CASE WHEN dim = 4 THEN agg_val END) AS agg_d4
FROM aggregated
WHERE dim BETWEEN 0 AND 4;
