WITH stopwords AS (          -- list of stop-words to exclude
     SELECT COLUMN1 AS stop FROM VALUES
     ('a'),('about'),('above'),('after'),('again'),('against'),('all'),('am'),('an'),('and'),('any'),
     ('are'),('as'),('at'),('be'),('been'),('before'),('being'),('below'),('between'),('both'),('but'),
     ('by'),('can'),('could'),('did'),('do'),('does'),('doing'),('down'),('during'),('each'),('few'),
     ('for'),('from'),('further'),('had'),('has'),('have'),('having'),('he'),('her'),('here'),('hers'),
     ('herself'),('him'),('himself'),('his'),('how'),('i'),('if'),('in'),('into'),('is'),('it'),('its'),
     ('itself'),('just'),('more'),('most'),('my'),('myself'),('no'),('nor'),('not'),('now'),('of'),
     ('off'),('on'),('once'),('only'),('or'),('other'),('our'),('ours'),('ourselves'),('out'),('over'),
     ('own'),('s'),('same'),('she'),('should'),('so'),('some'),('such'),('t'),('than'),('that'),('the'),
     ('their'),('theirs'),('them'),('themselves'),('then'),('there'),('these'),('they'),('this'),
     ('those'),('through'),('to'),('too'),('under'),('until'),('up'),('very'),('was'),('we'),('were'),
     ('what'),('when'),('where'),('which'),('while'),('who'),('whom'),('why'),('will'),('with'),
     ('you'),('your'),('yours'),('yourself'),('yourselves')
),
/*--------------------------------------------------------------------
  1.  Tokenise each article, keep non-stop tokens that have both
      a GloVe vector and a corpus frequency.
--------------------------------------------------------------------*/
token_vectors AS (
    SELECT
        n.id                                              AS article_id,
        gv.index                                          AS dim,                     -- dimension index
        (gv.value::FLOAT) / POWER(wf.frequency, 0.4)      AS weighted_val             -- frequency-weighted
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"             n,
         LATERAL FLATTEN(
                 input => SPLIT(
                           REGEXP_REPLACE(LOWER(n.body), '[^a-z0-9]+', ' '),
                           ' ')
         )                                                 tok                     -- raw tokens
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" g
              ON LOWER(tok.value::STRING) = LOWER(g.word)
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" wf
              ON LOWER(tok.value::STRING) = LOWER(wf.word),
         LATERAL FLATTEN(input => g.vector)               gv                     -- explode vector
    WHERE tok.value::STRING <> ''
      AND NOT EXISTS (SELECT 1 FROM stopwords s WHERE s.stop = tok.value::STRING)
),
/*--------------------------------------------------------------------
  2.  Sum the weighted values → aggregate vector for every article.
--------------------------------------------------------------------*/
agg_vectors AS (
    SELECT article_id, dim, SUM(weighted_val) AS agg_val
    FROM   token_vectors
    GROUP  BY article_id, dim
),
/*--------------------------------------------------------------------
  3.  Magnitude of each aggregate vector (skip zero vectors).
--------------------------------------------------------------------*/
magnitudes AS (
    SELECT article_id,
           SQRT(SUM(POWER(agg_val,2))) AS mag
    FROM   agg_vectors
    GROUP  BY article_id
    HAVING mag > 0
),
/*--------------------------------------------------------------------
  4.  Normalise every aggregate vector to unit length.
--------------------------------------------------------------------*/
norm_vectors AS (
    SELECT a.article_id,
           a.dim,
           a.agg_val / m.mag AS norm_val
    FROM   agg_vectors a
           JOIN magnitudes m
             ON a.article_id = m.article_id
),
/*--------------------------------------------------------------------
  5.  Reference article’s normalised vector.
--------------------------------------------------------------------*/
reference AS (
    SELECT dim, norm_val AS ref_val
    FROM   norm_vectors
    WHERE  article_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
/*--------------------------------------------------------------------
  6.  Cosine similarity (dot product of two unit vectors).
--------------------------------------------------------------------*/
sims AS (
    SELECT n.article_id,
           SUM(n.norm_val * r.ref_val) AS cosine_similarity
    FROM   norm_vectors n
           JOIN reference r
             ON n.dim = r.dim
    GROUP  BY n.article_id
),
/*--------------------------------------------------------------------
  7.  Pick top-10 most similar (excluding the reference itself).
--------------------------------------------------------------------*/
top10 AS (
    SELECT  s.article_id,
            nat.date,
            nat.title,
            s.cosine_similarity
    FROM    sims                             s
            JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" nat
              ON s.article_id = nat.id
    WHERE   s.article_id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    ORDER BY s.cosine_similarity DESC NULLS LAST
    LIMIT   10
)
SELECT *
FROM   top10;
```
