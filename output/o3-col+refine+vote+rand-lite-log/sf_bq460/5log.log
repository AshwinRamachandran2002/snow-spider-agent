--Description: 10) Return IDs, dates, titles and similarity scores of the 10 articles most similar to the reference one.
WITH vecs AS (
    SELECT
        n."id",
        SUM(vec."vector" / POWER(freq."frequency",0.4)) AS "agg_vec"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n,
         LATERAL FLATTEN(
             input => SPLIT(
                        REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+',' '),
                        ' '
                      )
         ) t
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."WORD_FREQUENCIES" freq
                  ON LOWER(t.value::STRING)=LOWER(freq."word")
         JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS" vec
                  ON LOWER(t.value::STRING)=LOWER(vec."word")
    WHERE t.value::STRING <> ''
          AND LOWER(t.value::STRING) NOT IN (
               'a','about','above','after','again','against','all','am','an','and','any',
               'are','as','at','be','been','before','being','below','between','both','but',
               'by','can','could','did','do','does','doing','down','during','each','few',
               'for','from','further','had','has','have','having','he','her','here','hers',
               'herself','him','himself','his','how','i','if','in','into','is','it','its',
               'itself','just','more','most','my','myself','no','nor','not','now','of',
               'off','on','once','only','or','other','our','ours','ourselves','out','over',
               'own','s','same','she','should','so','some','such','t','than','that','the',
               'their','theirs','them','themselves','then','there','these','they','this',
               'those','through','to','too','under','until','up','very','was','we','were',
               'what','when','where','which','while','who','whom','why','will','with',
               'you','your','yours','yourself','yourselves'
          )
    GROUP BY n."id"
), unit AS (
    SELECT
        "id",
        "agg_vec" / NULLIF(SQRT(SUM(POWER(v.value::FLOAT,2))),0) AS "vec"
    FROM vecs, LATERAL FLATTEN(input => vecs."agg_vec") v
    GROUP BY "id","agg_vec"
), ref AS (
    SELECT "vec" AS "ref_vec"
    FROM unit
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
), sims AS (
    SELECT
        u."id",
        SUM( u."vec"[i.index]::FLOAT * r."ref_vec"[i.index]::FLOAT ) AS "score"
    FROM unit u, ref r,
         LATERAL FLATTEN(input => ARRAY_CONSTRUCT_SEQUENCE(0,99)) i
    GROUP BY u."id"
    ORDER BY "score" DESC
    LIMIT 10
)
SELECT
    n."id",
    n."date",
    n."title",
    s."score" AS "cosine_similarity"
FROM sims s
JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE" n
  ON n."id" = s."id"
ORDER BY s."score" DESC
LIMIT 20;
