--Description:  Quickly estimate cosine-similarity between the reference article
--              (id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373') and a small pool of
--              other papers by:  
--              • building a working set = reference + 20 newest additional articles;  
--              • tokenising each body (no stop-word removal to keep it simple);  
--              • keeping only tokens that have a GloVe vector; *no* frequency-based
--                weighting (so every word counts equally);  
--              • summing the vectors of all tokens ➜ one aggregate 100-D vector per
--                article;  
--              • normalising each aggregate vector to unit length;  
--              • computing the dot-product (cosine similarity) with the reference
--                vector and returning the top scores.
WITH subset AS (           -- reference + 20 newest others
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    UNION ALL
    SELECT "id", "body"
    FROM "WORD_VECTORS_US"."WORD_VECTORS_US"."NATURE"
    WHERE "id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    ORDER BY "acquisition_date" DESC
    LIMIT 20
), token_vecs AS (         -- explode tokens; keep those with a GloVe vector
    SELECT
        s."id"                             AS art_id,
        gv."vector"                        AS vec
    FROM subset s,
         LATERAL FLATTEN(
             input => SPLIT(
                        REGEXP_REPLACE(LOWER(s."body"), '[^a-z0-9]+', ' '), ' ')
         ) tok
    JOIN "WORD_VECTORS_US"."WORD_VECTORS_US"."GLOVE_VECTORS"  gv
         ON LOWER(tok.value::STRING) = LOWER(gv."word")
), per_dim AS (            -- sum vectors per article & dimension
    SELECT
        art_id,
        f.index       AS dim,
        SUM(f.value::FLOAT) AS val
    FROM token_vecs,
         LATERAL FLATTEN(input => vec) f
    GROUP BY art_id, dim
), mag AS (                -- magnitude of each aggregate vector
    SELECT
        art_id,
        SQRT(SUM(POWER(val,2))) AS mag
    FROM per_dim
    GROUP BY art_id
), unit AS (               -- unit-length values per dimension
    SELECT
        p.art_id,
        p.dim,
        p.val / m.mag       AS u_val
    FROM per_dim p
    JOIN mag m ON p.art_id = m.art_id
), ref AS (                -- unit rows for reference article
    SELECT dim, u_val
    FROM unit
    WHERE art_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT
    u.art_id                           AS id,
    SUM(u.u_val * r.u_val)             AS cosine_similarity
FROM unit u
JOIN ref r ON u.dim = r.dim
GROUP BY u.art_id
ORDER BY cosine_similarity DESC
LIMIT 20;
