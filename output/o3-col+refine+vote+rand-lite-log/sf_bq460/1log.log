--Description: Re-weight the GloVe vector of a single token from the anchor
--             Nature article by dividing each component by frequency^0.4.
--             Steps
--               1.  Manual tokenisation of the article body (lower-case, strip
--                   punctuation, split on spaces, drop stop-words).
--               2.  Join each token to its GloVe vector and corpus frequency.
--               3.  Flatten the vector into (idx, value) pairs.
--               4.  Divide each value by POWER(frequency, 0.4).
--               5.  Re-assemble the weighted components with
--                  ARRAY_AGG … WITHIN GROUP (ORDER BY idx).
--             LIMIT 1 shows one example token (if the article has any tokens
--             with vectors).
WITH stopwords AS (
    SELECT COLUMN1 AS sw FROM VALUES
    ('a'),('about'),('above'),('after'),('again'),('against'),('ain'),('all'),('am'),
