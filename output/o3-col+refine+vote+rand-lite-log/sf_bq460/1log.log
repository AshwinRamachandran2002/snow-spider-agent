/* ----------  create a small in-memory dictionary so we read     ----------
   ----------  WORD_FREQUENCIES and GLOVE_VECTORS only once        ---------- */
WITH dict AS (
    SELECT
        gv."word",
        gv."vector",          -- 300-D GloVe vector (VARIANT array)
        wf."frequency"
    FROM WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
          ON wf."word" = gv."word"
),

/* ----------  tokenise every Nature article (stop-words removed) ---------- */
tokens AS (      -- one row per (article , token)  – only keep tokens in dict
    SELECT
        n."id",
        n."title",
        n."date",
        d."vector"   AS vec,
        d."frequency" AS freq
    FROM WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,

         LATERAL FLATTEN(        -- tokenise with stop-word removal helper
              INPUT => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")
         ) tok

    JOIN dict d                 -- keep token only if we have vec & frequency
         ON d."word" = tok.value::STRING
),

/* ----------  weight every vector element by freq^-0.4 and explode -------- */
weighted AS (
    SELECT
        t."id",
        f.index                              AS dim,
        (f.value::FLOAT) / POWER(t.freq, 0.4)   AS val     -- weighted element
    FROM tokens t,
         LATERAL FLATTEN( INPUT => t.vec ) f               -- 300 elements
),

/* ----------  aggregate to one vector per article ------------------------- */
agg AS (
    SELECT
        "id",
        dim,
        SUM(val)                       AS agg_val          -- Σ weighted val
    FROM weighted
    GROUP BY "id", dim
),

/* ----------  article-level ℓ2-norm --------------------------------------- */
norms AS (
    SELECT
        "id",
        SQRT(SUM(agg_val * agg_val))   AS norm
    FROM agg
    GROUP BY "id"
),

/* ----------  anchor (target) article vector & its norm ------------------- */
target_vec AS (
    SELECT dim, agg_val
    FROM   agg
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),
target_norm AS (
    SELECT norm AS tgt_norm
    FROM   norms
    WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
),

/* ----------  dot-product of every article with the anchor ---------------- */
dots AS (
    SELECT
        a."id",
        SUM(a.agg_val * t.agg_val)      AS dot_val
    FROM   agg         a
    JOIN   target_vec  t USING (dim)
    GROUP BY a."id"
),

/* ----------  final cosine similarity ------------------------------------- */
cosines AS (
    SELECT
        n."id",
        nat."date",
        nat."title",
        dots.dot_val / (n.norm * tn.tgt_norm)  AS cosine_similarity
    FROM dots
    JOIN norms                                  n   USING ("id")
    JOIN WORD_VECTORS_US.WORD_VECTORS_US.NATURE nat USING ("id")
    CROSS JOIN target_norm                      tn
)

SELECT
    "id",
    "date",
    "title",
    cosine_similarity
FROM   cosines
WHERE  "id" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
ORDER  BY cosine_similarity DESC NULLS LAST
LIMIT  10;
