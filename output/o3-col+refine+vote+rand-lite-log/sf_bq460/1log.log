```sql
--Description: 1) Take a first quick look at the Nature corpus – list some article id’s, titles and dates.
SELECT DISTINCT 
       "id",
       "title",
       "date"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
LIMIT  20;
```

```sql
--Description: 2) Inspect the particular article that will be our query anchor.
SELECT 
       "id",
       "title",
       "date",
       LEFT("body", 500) AS "body_excerpt"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE
WHERE  "id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373';
```

```sql
--Description: 3) Tokenise the body of the anchor article (stop-words already removed) so we can see what the vocabulary looks like.
SELECT 
       tok.value::STRING AS "token"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) tok
WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT  20;
```

```sql
--Description: 4) Join those tokens to the WORD_FREQUENCIES table to see how often each token occurs in the background corpus.
SELECT 
       t.value::STRING                             AS "token",
       wf."frequency"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) t
       JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
            ON wf."word" = t.value::STRING
WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT  20;
```

```sql
--Description: 5) Attach the GloVe vector for each token of the anchor article so we can inspect a few raw vectors.
SELECT 
       t.value::STRING                             AS "token",
       gv."vector"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) t
       JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
            ON gv."word" = t.value::STRING
WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
LIMIT  20;
```

```sql
--Description: 6) Show how a single token’s vector would be re-weighted 
--               by dividing by frequency^0.4 (illustrative for one token).
SELECT 
       t.value::STRING                             AS "token",
       gv."vector",
       wf."frequency",
       ARRAY_AGG( (vec_element.value::FLOAT)/(POWER(wf."frequency", 0.4)) 
                  ORDER BY vec_element.index )     AS "reweighted_vector"
FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
       LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) t
       JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
            ON gv."word" = t.value::STRING
       JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
            ON wf."word" = t.value::STRING,
       LATERAL FLATTEN(input => gv."vector") vec_element
WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
GROUP  BY t.value::STRING, gv."vector", wf."frequency"
LIMIT  1;
```

```sql
--Description: 7) Produce the SUM of all those re-weighted vectors to give the aggregate vector for the anchor article.
WITH anchor_tokens AS (
    SELECT 
           gv."vector",
           wf."frequency"
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) tok
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                ON gv."word" = tok.value::STRING
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                ON wf."word" = tok.value::STRING
    WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
), vec_parts AS (
    SELECT 
           elem.index                                       AS idx,
           SUM( (elem.value::FLOAT) / POWER(frequency,0.4) ) AS component_sum
    FROM   anchor_tokens,
           LATERAL FLATTEN(input => anchor_tokens."vector") elem
    GROUP BY idx
)
SELECT 
       ARRAY_AGG(component_sum ORDER BY idx) AS "anchor_aggregate_vector"
FROM   vec_parts;
```

```sql
--Description: 8) Normalise that aggregate vector to unit length (still only for the anchor article).
WITH anchor_vec AS (      -- reuse previous CTE but inline for brevity
    SELECT 
           elem.index                                       AS idx,
           SUM( (elem.value::FLOAT) / POWER(wf."frequency",0.4) ) AS comp
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) tok
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                ON gv."word" = tok.value::STRING
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                ON wf."word" = tok.value::STRING,
           LATERAL FLATTEN(input => gv."vector") elem
    WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
    GROUP BY elem.index
), norm_calc AS (
    SELECT SQRT(SUM(POWER(comp,2))) AS norm FROM anchor_vec
)
SELECT 
       ARRAY_AGG( comp / norm ORDER BY idx ) AS "anchor_normalised_vec"
FROM   anchor_vec, norm_calc;
```

```sql
--Description: 9) Build *normalised* document vectors for every article in the corpus (one row per article).
WITH article_tokenised AS (
    SELECT 
           n."id",
           n."title",
           n."date",
           tok.value::STRING                      AS word
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) tok
), joined AS (
    SELECT 
           at."id",
           at."title",
           at."date",
           gv."vector",
           wf."frequency"
    FROM   article_tokenised at
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                ON gv."word" = at.word
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                ON wf."word" = at.word
), weighted AS (
    SELECT 
           id,
           title,
           date,
           elem.index                               AS idx,
           SUM( (elem.value::FLOAT)/POWER(frequency,0.4) ) AS comp
    FROM   joined,
           LATERAL FLATTEN(input => joined."vector") elem
    GROUP  BY id, title, date, idx
), norms AS (
    SELECT id,
           SQRT(SUM(POWER(comp,2)))                 AS norm
    FROM   weighted
    GROUP  BY id
), normalised AS (
    SELECT 
           w.id,
           w.title,
           w.date,
           w.idx,
           w.comp / n.norm                          AS norm_comp
    FROM   weighted w
           JOIN norms n ON n.id = w.id
)
SELECT 
       id,
       title,
       date,
       ARRAY_AGG(norm_comp ORDER BY idx)           AS "normalised_vector"
FROM   normalised
GROUP BY id, title, date
LIMIT  20;
```

```sql
--Description: 10) Use those normalised vectors to compute cosine similarity 
--                and return the ten articles most similar to our anchor article.
WITH doc_vecs AS (           -- the “normalised” CTE from query 9, without LIMIT
    SELECT 
           w.id,
           w.title,
           w.date,
           w.idx,
           w.comp / n.norm        AS norm_comp
    FROM  (
            SELECT id, title, date, idx,
                   SUM( (elem.value::FLOAT)/POWER(frequency,0.4) ) AS comp
            FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
                   LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) tok
                   JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                        ON gv."word" = tok.value::STRING
                   JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                        ON wf."word" = tok.value::STRING,
                   LATERAL FLATTEN(input => gv."vector") elem
            GROUP  BY id, title, date, idx
          ) w
          JOIN (
            SELECT id,
                   SQRT(SUM(POWER(comp,2))) AS norm
            FROM  (
                    SELECT id, idx,
                           SUM( (elem.value::FLOAT)/POWER(frequency,0.4) ) AS comp
                    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
                           LATERAL FLATTEN(input => `spider2-public-data`.word_vectors_us.tokenise_no_stop(n."body")) tok
                           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                                ON gv."word" = tok.value::STRING
                           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                                ON wf."word" = tok.value::STRING,
                           LATERAL FLATTEN(input => gv."vector") elem
                    GROUP  BY id, idx
                  )
            GROUP BY id
          ) n
          ON n.id = w.id
), anchor AS (
    SELECT idx, norm_comp AS a_comp
    FROM   doc_vecs
    WHERE  id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
)
SELECT 
       d.id,
       d.date,
       d.title,
       SUM(d.norm_comp * a.a_comp) AS "cosine_similarity"
FROM   doc_vecs d
       JOIN anchor a
         ON a.idx = d.idx
WHERE  d.id <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
GROUP  BY d.id, d.date, d.title
ORDER  BY "cosine_similarity" DESC
LIMIT  10;
```
