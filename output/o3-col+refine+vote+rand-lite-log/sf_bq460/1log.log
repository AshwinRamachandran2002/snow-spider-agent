    ('won'),('wont'),('wouldn'),('wouldnt'),('y'),('you'),('youd'),('youll'),
    ('your'),('youre'),('yours'),('yourself'),('yourselves'),('youve')
),
tokenised AS (
    SELECT
           LOWER(REGEXP_REPLACE(t.word, '[^a-z0-9]+', '')) AS token
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL FLATTEN(
               input => SPLIT(
                           REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                           ' '
                        )
           ) t
    WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND  t.word IS NOT NULL
      AND  t.word <> ''
),
filtered AS (
    SELECT DISTINCT token
    FROM   tokenised
    WHERE  token NOT IN (SELECT sw FROM stopwords)
),
joined AS (
    SELECT
           f.token,
           wf."frequency",
           vec.index            AS idx,
           vec.value::FLOAT     AS val
    FROM   filtered f
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                ON gv."word" = f.token
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                ON wf."word" = f.token,
           LATERAL FLATTEN(input => gv."vector") vec
)
SELECT
       token,
       frequency,
       ARRAY_AGG( val / POWER(frequency, 0.4) )
         WITHIN GROUP (ORDER BY idx)     AS reweighted_vector
FROM   joined
GROUP BY token, frequency
LIMIT 1;
