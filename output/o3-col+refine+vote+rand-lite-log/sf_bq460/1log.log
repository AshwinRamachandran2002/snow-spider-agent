```sql
--Description:  Build the aggregate (unnormalised) document vector for the anchor
--              Nature article (id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373').
--              Process:
--                1. Manual tokenisation of the article body (lower-case, strip
--                   punctuation, split on spaces, drop blanks, remove stop-words).
--                2. Join each token to its GloVe vector and corpus frequency.
--                3. Flatten every vector into (index, value) pairs.
--                4. Divide each component by POWER(frequency, 0.4).
--                5. Sum the weighted components per index.
--                6. Re-assemble the summed components—preserving order—into a
--                   single ARRAY representing the aggregate vector.
WITH stop_words AS (           -- list truncated for brevity; include full list in practice
    SELECT COLUMN1 AS sw FROM VALUES
    ('a'),('about'),('above'),('after'),('again'),('against'),('ain'),('all'),('am'),
    ('an'),('and'),('any'),('are'),('aren'),('arent'),('as'),('at'),('be'),('because'),
    ('been'),('before'),('being'),('below'),('between'),('both'),('but'),('by')
),
tokens AS (
    SELECT tok.value::STRING AS word
    FROM   WORD_VECTORS_US.WORD_VECTORS_US.NATURE n,
           LATERAL FLATTEN(
                input => SPLIT(
                           REGEXP_REPLACE(LOWER(n."body"), '[^a-z0-9]+', ' '),
                           ' '
                       )
           ) tok
    WHERE  n."id" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'
      AND  tok.value::STRING <> ''
      AND  tok.value::STRING NOT IN (SELECT sw FROM stop_words)
),
joined AS (
    SELECT
           gv."vector",
           wf."frequency"
    FROM   tokens t
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.GLOVE_VECTORS gv
                ON gv."word" = t.word
           JOIN WORD_VECTORS_US.WORD_VECTORS_US.WORD_FREQUENCIES wf
                ON wf."word" = t.word
),
weighted_components AS (
    SELECT
           vec.index                                    AS idx,
           SUM( (vec.value::FLOAT) / POWER(frequency, 0.4) ) AS comp_sum
    FROM   joined,
           LATERAL FLATTEN(input => joined."vector") vec
    GROUP BY idx
)
SELECT
       ARRAY_AGG(comp_sum ORDER BY idx) AS "anchor_aggregate_vector"
FROM   weighted_components;
```
