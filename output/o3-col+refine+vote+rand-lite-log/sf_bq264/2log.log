Query:
--Description: Count the number of users whose age equals the oldest age discovered above.
SELECT 
    COUNT(*) AS "oldest_user_cnt"
FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
  AND "age" = (
        SELECT MAX("age")
        FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE.USERS
        WHERE "created_at" BETWEEN 1546300800000000 AND 1651363199000000
