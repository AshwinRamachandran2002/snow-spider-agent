Query:
--Description: Calculate the difference between counts of oldest-age users and youngest-age users in the period
SELECT
       MAX(CASE WHEN "age" = (SELECT MAX("age")
                              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
                              WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000)
                THEN "cnt" END)
     - MAX(CASE WHEN "age" = (SELECT MIN("age")
                              FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
                              WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000)
                THEN "cnt" END)                                          AS "difference_oldest_vs_youngest"
FROM (
      SELECT "age",
             COUNT(*) AS "cnt"
      FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
      WHERE "created_at" BETWEEN 1546300800000000 AND 1651363200000000
      GROUP BY "age"
) t
LIMIT 20;
