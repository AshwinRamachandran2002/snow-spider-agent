```sql
--Description:
--  Goal: find the youngest and oldest ages among users who registered from
--        01-Jan-2019 to 30-Apr-2022, then count how many users fall into each
--        of those two age brackets.  Steps (thinking process):
--   • Step-1  Filter USERS to the date range of interest.
--   • Step-2  Aggregate to get a user-count for every distinct age.
--   • Step-3  Identify the minimum (youngest) and maximum (oldest) ages found.
--   • Step-4  Return two rows (youngest & oldest) with their corresponding counts.
--
WITH age_counts AS (                          -- Step-1 & Step-2
    SELECT "age",
           COUNT(*) AS "num_users"
    FROM THELOOK_ECOMMERCE.THELOOK_ECOMMERCE."USERS"
    WHERE "created_at" BETWEEN 1546300800000000   -- 2019-01-01
                           AND 1651363200000000   -- 2022-04-30
    GROUP BY "age"
),
bounds AS (                                   -- Step-3
    SELECT MIN("age") AS "youngest_age",
           MAX("age") AS "oldest_age"
    FROM age_counts
)
SELECT                                          -- Step-4
       CASE WHEN ac."age" = b."youngest_age" THEN 'youngest'
            ELSE 'oldest'
       END            AS "age_type",
       ac."age"       AS "age_value",
       ac."num_users"
FROM   age_counts ac
JOIN   bounds b
       ON ac."age" IN (b."youngest_age", b."oldest_age")
ORDER BY "age_type"
LIMIT 20;
```
