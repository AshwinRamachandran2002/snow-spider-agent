FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
LIMIT 20;
```

```sql
--Description: 2)  List the first 20 KIRC segments (chromosome, start, end, copy number) to preview the data we will map to cytobands
SELECT "case_barcode",
       "chromosome",
       "start_pos",
       "end_pos",
       "copy_number"
FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
WHERE "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 3)  Count distinct KIRC cases in the allelic-CNV table (needed later for frequency denominators)
SELECT COUNT(DISTINCT "case_barcode") AS "num_kirc_cases"
FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
WHERE "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 4)  Display cytoband coordinates for chromosome 3 to verify their genomic ranges
SELECT "chromosome",
       "cytoband_name",
       "hg38_start",
       "hg38_stop"
FROM "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38"
WHERE "chromosome" = 'chr3'
ORDER BY "hg38_start"
LIMIT 20;
```

```sql
--Description: 5)  Join one KIRC segment set (chromosome 3) to its overlapping cytobands to confirm the overlap logic
SELECT s."case_barcode",
       s."chromosome",
       s."start_pos",
       s."end_pos",
       b."cytoband_name",
       b."hg38_start",
       b."hg38_stop",
       LEAST(s."end_pos", b."hg38_stop") - GREATEST(s."start_pos", b."hg38_start") AS "overlap_len"
FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
  ON s."chromosome" = b."chromosome"
 WHERE s."project_short_name" = 'TCGA-KIRC'
   AND s."chromosome" = 'chr3'
   AND LEAST(s."end_pos", b."hg38_stop") > GREATEST(s."start_pos", b."hg38_start")  -- keeps true overlaps
LIMIT 20;
```

```sql
--Description: 6)  Compute the maximum copy number observed per KIRC case & cytoband (band-level summarisation)
SELECT s."case_barcode",
       b."cytoband_name",
       MAX(s."copy_number") AS "max_copy_number"
FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
  ON s."chromosome" = b."chromosome"
 WHERE s."project_short_name" = 'TCGA-KIRC'
   AND LEAST(s."end_pos", b."hg38_stop") > GREATEST(s."start_pos", b."hg38_start")
GROUP BY s."case_barcode", b."cytoband_name"
LIMIT 20;
```

```sql
--Description: 7)  Classify each case/cytoband’s maximum copy number into the five CNV categories
SELECT t."case_barcode",
       t."cytoband_name",
       t."max_copy_number",
       CASE
         WHEN t."max_copy_number" > 3 THEN 'Amplification'
         WHEN t."max_copy_number" = 3 THEN 'Gain'
         WHEN t."max_copy_number" = 2 THEN 'Normal'
         WHEN t."max_copy_number" = 1 THEN 'Heterozygous Deletion'
         WHEN t."max_copy_number" = 0 THEN 'Homozygous Deletion'
         ELSE 'Other'
       END AS "cnv_class"
FROM (
      SELECT s."case_barcode",
             b."cytoband_name",
             MAX(s."copy_number") AS "max_copy_number"
      FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
      JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
        ON s."chromosome" = b."chromosome"
       WHERE s."project_short_name" = 'TCGA-KIRC'
         AND LEAST(s."end_pos", b."hg38_stop") > GREATEST(s."start_pos", b."hg38_start")
      GROUP BY s."case_barcode", b."cytoband_name"
     ) t
LIMIT 20;
```

```sql
--Description: 8)  Count how many distinct KIRC cases fall into each CNV class per cytoband
SELECT t."cytoband_name",
       t."cnv_class",
       COUNT(DISTINCT t."case_barcode") AS "num_cases_in_class"
FROM (
      -- same sub-query as step 7
      SELECT s."case_barcode",
             b."cytoband_name",
             MAX(s."copy_number") AS "max_copy_number",
             CASE
               WHEN MAX(s."copy_number") > 3 THEN 'Amplification'
               WHEN MAX(s."copy_number") = 3 THEN 'Gain'
               WHEN MAX(s."copy_number") = 2 THEN 'Normal'
               WHEN MAX(s."copy_number") = 1 THEN 'Heterozygous Deletion'
               WHEN MAX(s."copy_number") = 0 THEN 'Homozygous Deletion'
               ELSE 'Other'
             END AS "cnv_class"
      FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
      JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
        ON s."chromosome" = b."chromosome"
       WHERE s."project_short_name" = 'TCGA-KIRC'
         AND LEAST(s."end_pos", b."hg38_stop") > GREATEST(s."start_pos", b."hg38_start")
      GROUP BY s."case_barcode", b."cytoband_name"
     ) t
GROUP BY t."cytoband_name", t."cnv_class"
LIMIT 20;
```

```sql
--Description: 9)  Convert those counts to percentages of all KIRC cases, then sort by chromosome & band name
WITH kirc_cases AS (
  SELECT COUNT(DISTINCT "case_barcode") AS "total_cases"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name" = 'TCGA-KIRC'
),
band_class_counts AS (
  -- reuse query from step 8 without LIMIT
  SELECT t."cytoband_name",
         t."cnv_class",
         COUNT(DISTINCT t."case_barcode") AS "num_cases_in_class"
  FROM (
        SELECT s."case_barcode",
               b."cytoband_name",
               MAX(s."copy_number") AS "max_copy_number",
               CASE
                 WHEN MAX(s."copy_number") > 3 THEN 'Amplification'
                 WHEN MAX(s."copy_number") = 3 THEN 'Gain'
                 WHEN MAX(s."copy_number") = 2 THEN 'Normal'
                 WHEN MAX(s."copy_number") = 1 THEN 'Heterozygous Deletion'
                 WHEN MAX(s."copy_number") = 0 THEN 'Homozygous Deletion'
                 ELSE 'Other'
               END AS "cnv_class"
        FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
        JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
          ON s."chromosome" = b."chromosome"
        WHERE s."project_short_name" = 'TCGA-KIRC'
          AND LEAST(s."end_pos", b."hg38_stop") > GREATEST(s."start_pos", b."hg38_start")
        GROUP BY s."case_barcode", b."cytoband_name"
       ) t
  GROUP BY t."cytoband_name", t."cnv_class"
)
SELECT b."cytoband_name",
       b."cnv_class",
       ROUND(100.0 * b."num_cases_in_class" / c."total_cases", 2) AS "pct_cases"
FROM band_class_counts b
CROSS JOIN kirc_cases c
ORDER BY SPLIT_PART(b."cytoband_name",'p',1),   -- crude sort by chromosome number
         b."cytoband_name",
         b."cnv_class"
LIMIT 20;
```

```sql
--Description: 10)  Same percentage table but showing only Amplifications & Homozygous Deletions, the two extreme CNV classes
WITH kirc_cases AS (
  SELECT COUNT(DISTINCT "case_barcode") AS "total_cases"
  FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23"
  WHERE "project_short_name" = 'TCGA-KIRC'
),
band_class_counts AS (
  SELECT t."cytoband_name",
         t."cnv_class",
         COUNT(DISTINCT t."case_barcode") AS "num_cases_in_class"
  FROM (
        SELECT s."case_barcode",
               b."cytoband_name",
               MAX(s."copy_number") AS "max_copy_number",
               CASE
                 WHEN MAX(s."copy_number") > 3 THEN 'Amplification'
                 WHEN MAX(s."copy_number") = 3 THEN 'Gain'
                 WHEN MAX(s."copy_number") = 2 THEN 'Normal'
                 WHEN MAX(s."copy_number") = 1 THEN 'Heterozygous Deletion'
                 WHEN MAX(s."copy_number") = 0 THEN 'Homozygous Deletion'
                 ELSE 'Other'
               END AS "cnv_class"
        FROM "TCGA_MITELMAN"."TCGA_VERSIONED"."COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23" s
        JOIN "TCGA_MITELMAN"."PROD"."CYTOBANDS_HG38" b
          ON s."chromosome" = b."chromosome"
        WHERE s."project_short_name" = 'TCGA-KIRC'
          AND LEAST(s."end_pos", b."hg38_stop") > GREATEST(s."start_pos", b."hg38_start")
        GROUP BY s."case_barcode", b."cytoband_name"
       ) t
  GROUP BY t."cytoband_name", t."cnv_class"
)
SELECT b."cytoband_name",
       b."cnv_class",
       ROUND(100.0 * b."num_cases_in_class" / c."total_cases", 2) AS "pct_cases"
FROM band_class_counts b
CROSS JOIN kirc_cases c
WHERE b."cnv_class" IN ('Amplification', 'Homozygous Deletion')
ORDER BY SPLIT_PART(b."cytoband_name",'p',1),
         b."cytoband_name",
         b."cnv_class"
LIMIT 20;
```
