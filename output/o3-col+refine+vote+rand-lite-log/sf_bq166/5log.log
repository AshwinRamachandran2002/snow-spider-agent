--Description:
-- Derive cytoband-level copy-number status for all TCGA-KIRC cases, then
-- report the percentage of cases that fall into each CNV subtype
-- (Amplification, Gain, Normal, Heterozygous Deletion, Homozygous Deletion)
-- for every cytoband.  The logic proceeds in four CTE layers:
--
--   1) per_band
--        • Join CNV segments to cytobands (matching chromosome).
--        • For each (case, cytoband) keep the segment that overlaps the band
--          the most (ROW_NUMBER on overlap length).  Take that segment’s
--          copy_number as the band-level “max_cn”.
--
--   2) categorized
--        • Translate max_cn to the requested categorical subtypes.
--
--   3) totals
--        • Count how many distinct TCGA-KIRC cases are represented in each
--          cytoband (denominator for percentages).
--
--   4) freqs
--        • Count how many distinct cases per (cytoband, subtype)
--          (numerator for percentages).
--
-- The final SELECT computes 100 * numerator / denominator, rounds to two
-- decimals, and lists the first 20 rows (ordered by cytoband then subtype).
WITH per_band AS (
    SELECT
        j."case_barcode",
        j."cytoband_name",
        MAX(j."copy_number") AS "max_cn"
    FROM (
        SELECT
            s."case_barcode",
            b."cytoband_name",
            s."copy_number",
            ROW_NUMBER() OVER (
                PARTITION BY s."case_barcode", b."cytoband_name"
                ORDER BY GREATEST(
                           0,
                           LEAST(s."end_pos",  b."hg38_stop") -
                           GREATEST(s."start_pos", b."hg38_start")
                       ) DESC
            ) AS rn
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
        JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
          ON s."chromosome" = b."chromosome"
        WHERE s."project_short_name" = 'TCGA-KIRC'
    ) j
    WHERE j.rn = 1
    GROUP BY j."case_barcode", j."cytoband_name"
),
categorized AS (
    SELECT
        pb."case_barcode",
        pb."cytoband_name",
        CASE
            WHEN pb."max_cn" > 3 THEN 'Amplification'
            WHEN pb."max_cn" = 3 THEN 'Gain'
            WHEN pb."max_cn" = 2 THEN 'Normal'
            WHEN pb."max_cn" = 1 THEN 'Heterozygous Deletion'
            WHEN pb."max_cn" = 0 THEN 'Homozygous Deletion'
        END AS "cn_subtype"
    FROM per_band pb
),
totals AS (
    SELECT
        "cytoband_name",
        COUNT(DISTINCT "case_barcode") AS "total_cases"
    FROM categorized
    GROUP BY "cytoband_name"
),
freqs AS (
    SELECT
        "cytoband_name",
        "cn_subtype",
        COUNT(DISTINCT "case_barcode") AS "n_cases_subtype"
    FROM categorized
    GROUP BY "cytoband_name", "cn_subtype"
)
SELECT
    f."cytoband_name",
    f."cn_subtype",
    ROUND(100.0 * f."n_cases_subtype" / t."total_cases", 2) AS "percent_cases"
FROM freqs f
JOIN totals t
  ON f."cytoband_name" = t."cytoband_name"
ORDER BY f."cytoband_name", f."cn_subtype"
LIMIT 20;
```
