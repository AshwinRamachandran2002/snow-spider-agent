--Description: 8)  Categorize each sample’s cytoband-level CN status using the defined thresholds
WITH per_band AS (
    SELECT 
           "case_barcode",
           "cytoband_name",
           MAX("copy_number") AS "max_cn"
    FROM (
        -- reuse logic from step 7 but inline for brevity
        SELECT 
               s."case_barcode",
               b."cytoband_name",
               s."copy_number",
               ROW_NUMBER() OVER (PARTITION BY s."case_barcode", b."cytoband_name"
                                  ORDER BY GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                                                   -  GREATEST(s."start_pos", b."hg38_start")) DESC) AS rn
        FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
        JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
               ON  s."chromosome" = b."chromosome"
        WHERE  s."project_short_name" = 'TCGA-KIRC'
    ) t
    WHERE rn = 1
    GROUP BY "case_barcode", "cytoband_name"
)
SELECT 
       "case_barcode",
       "cytoband_name",
       "max_cn",
       CASE 
            WHEN "max_cn" > 3 THEN 'Amplification'
            WHEN "max_cn" = 3 THEN 'Gain'
            WHEN "max_cn" = 2 THEN 'Normal'
            WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
            WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
       END AS "cn_subtype"
FROM   per_band
LIMIT 20;
