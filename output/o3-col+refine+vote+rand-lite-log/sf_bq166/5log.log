```sql
--Description: 4)  Look at cytoband definitions for one chromosome to confirm genomic coordinates
SELECT 
       "chromosome",
       "cytoband_name",
       "hg38_start",
       "hg38_stop"
FROM   TCGA_MITELMAN.PROD.CYTOBANDS_HG38
WHERE  "chromosome" = 'chr14'
LIMIT 20;
```

```sql
--Description: 5)  Join TCGA-KIRC CNV segments to cytobands on matching chromosome to see raw overlaps
SELECT 
       s."case_barcode",
       s."chromosome",
       s."start_pos"            AS "seg_start",
       s."end_pos"              AS "seg_end",
       b."cytoband_name",
       b."hg38_start"           AS "band_start",
       b."hg38_stop"            AS "band_end"
FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
       ON  s."chromosome" = b."chromosome"
WHERE  s."project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 6)  Add the genomic overlap length between each CNV segment and cytoband
SELECT 
       s."case_barcode",
       b."cytoband_name",
       GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                    -  GREATEST(s."start_pos", b."hg38_start")) AS "overlap_bp"
FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
       ON  s."chromosome" = b."chromosome"
WHERE  s."project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 7)  For each KIRC sample & cytoband, retain the segment with the largest overlap 
--                then capture its maximum copy number
WITH joined AS (
    SELECT 
           s."case_barcode",
           b."cytoband_name",
           s."copy_number",
           ROW_NUMBER() OVER (PARTITION BY s."case_barcode", b."cytoband_name"
                              ORDER BY GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                                                   -  GREATEST(s."start_pos", b."hg38_start")) DESC) AS rn
    FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
    JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
           ON  s."chromosome" = b."chromosome"
    WHERE  s."project_short_name" = 'TCGA-KIRC'
)
SELECT 
       "case_barcode",
       "cytoband_name",
       MAX("copy_number") AS "max_cn"   -- should be only the row with rn=1
FROM   joined
WHERE  rn = 1
GROUP  BY "case_barcode", "cytoband_name"
LIMIT 20;
```

```sql
--Description: 8)  Categorize each sample’s cytoband-level CN status using the defined thresholds
WITH per_band AS (
    SELECT 
           "case_barcode",
           "cytoband_name",
           MAX("copy_number") AS "max_cn"
    FROM (
        -- reuse logic from step 7 but inline for brevity
        SELECT 
               s."case_barcode",
               b."cytoband_name",
               s."copy_number",
               ROW_NUMBER() OVER (PARTITION BY s."case_barcode", b."cytoband_name"
                                  ORDER BY GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                                                   -  GREATEST(s."start_pos", b."hg38_start")) DESC) AS rn
        FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
        JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
               ON  s."chromosome" = b."chromosome"
        WHERE  s."project_short_name" = 'TCGA-KIRC'
    ) t
    WHERE rn = 1
    GROUP BY "case_barcode", "cytoband_name"
)
SELECT 
       "case_barcode",
       "cytoband_name",
       "max_cn",
       CASE 
            WHEN "max_cn" > 3 THEN 'Amplification'
            WHEN "max_cn" = 3 THEN 'Gain'
            WHEN "max_cn" = 2 THEN 'Normal'
            WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
            WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
       END AS "cn_subtype"
FROM   per_band
LIMIT 20;
```

```sql
--Description: 9)  Count how many distinct TCGA-KIRC cases fall into each CN subtype per cytoband
WITH categorized AS (
    -- (reuse query from step 8)
    SELECT 
           "case_barcode",
           "cytoband_name",
           CASE 
                WHEN "max_cn" > 3 THEN 'Amplification'
                WHEN "max_cn" = 3 THEN 'Gain'
                WHEN "max_cn" = 2 THEN 'Normal'
                WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
                WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
           END AS "cn_subtype"
    FROM (
        SELECT 
               "case_barcode",
               "cytoband_name",
               MAX("copy_number") AS "max_cn"
        FROM (
            SELECT 
                   s."case_barcode",
                   b."cytoband_name",
                   s."copy_number",
                   ROW_NUMBER() OVER (PARTITION BY s."case_barcode", b."cytoband_name"
                                      ORDER BY GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                                                       -  GREATEST(s."start_pos", b."hg38_start")) DESC) AS rn
            FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
            JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
                   ON  s."chromosome" = b."chromosome"
            WHERE  s."project_short_name" = 'TCGA-KIRC'
        ) q
        WHERE rn = 1
        GROUP BY "case_barcode", "cytoband_name"
    ) p
)
SELECT 
       "cytoband_name",
       "cn_subtype",
       COUNT(DISTINCT "case_barcode") AS "n_cases"
FROM   categorized
GROUP  BY "cytoband_name", "cn_subtype"
LIMIT 20;
```

```sql
--Description: 10)  Convert counts to subtype percentages per cytoband, then sort by chromosome & name
WITH totals AS (
    SELECT 
           "cytoband_name",
           COUNT(DISTINCT "case_barcode") AS "total_cases"
    FROM (
        -- reuse categorized CTE from step 9
        SELECT 
               "case_barcode",
               "cytoband_name",
               CASE 
                    WHEN "max_cn" > 3 THEN 'Amplification'
                    WHEN "max_cn" = 3 THEN 'Gain'
                    WHEN "max_cn" = 2 THEN 'Normal'
                    WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
                    WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
               END AS "cn_subtype"
        FROM (
            SELECT 
                   s."case_barcode",
                   b."cytoband_name",
                   s."copy_number",
                   ROW_NUMBER() OVER (PARTITION BY s."case_barcode", b."cytoband_name"
                                      ORDER BY GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                                                       -  GREATEST(s."start_pos", b."hg38_start")) DESC) AS rn
            FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
            JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
                   ON  s."chromosome" = b."chromosome"
            WHERE  s."project_short_name" = 'TCGA-KIRC'
        ) w
        WHERE rn = 1
    ) v
    GROUP BY "cytoband_name"
),
freqs AS (
    SELECT 
           c."cytoband_name",
           c."cn_subtype",
           COUNT(DISTINCT c."case_barcode") AS "n_cases_subtype"
    FROM   (
        -- same categorized subquery as above
        SELECT 
               "case_barcode",
               "cytoband_name",
               CASE 
                    WHEN "max_cn" > 3 THEN 'Amplification'
                    WHEN "max_cn" = 3 THEN 'Gain'
                    WHEN "max_cn" = 2 THEN 'Normal'
                    WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
                    WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
               END AS "cn_subtype"
        FROM (
            SELECT 
                   s."case_barcode",
                   b."cytoband_name",
                   s."copy_number",
                   ROW_NUMBER() OVER (PARTITION BY s."case_barcode", b."cytoband_name"
                                      ORDER BY GREATEST(0, LEAST(s."end_pos",  b."hg38_stop") 
                                                       -  GREATEST(s."start_pos", b."hg38_start")) DESC) AS rn
            FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
            JOIN   TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
                   ON  s."chromosome" = b."chromosome"
            WHERE  s."project_short_name" = 'TCGA-KIRC'
        ) u
        WHERE rn = 1
    ) c
    GROUP BY c."cytoband_name", c."cn_subtype"
)
SELECT 
       f."cytoband_name",
       f."cn_subtype",
       ROUND(100.0 * f."n_cases_subtype" / t."total_cases", 2) AS "percent_cases"
FROM   freqs f
JOIN   totals t
       ON f."cytoband_name" = t."cytoband_name"
ORDER  BY SPLIT_PART(f."cytoband_name", 'p', 1),   -- crude chromosome sort
          f."cytoband_name",
          f."cn_subtype"
LIMIT 20;
```
