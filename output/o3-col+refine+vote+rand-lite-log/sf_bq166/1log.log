-- 9) Description: Calculate frequency of each CNV subtype per cytoband across TCGA-KIRC cases
SELECT res."chromosome",
       res."cytoband_name",
       res."cnv_subtype",
       COUNT(DISTINCT res."case_barcode") * 100.0
         / ( SELECT COUNT(DISTINCT "case_barcode")
             FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
             WHERE "project_short_name" = 'TCGA-KIRC' ) AS "frequency_pct"
FROM (
      SELECT s."case_barcode",
             c."chromosome",
             c."cytoband_name",
             CASE
               WHEN MAX(s."copy_number") > 3 THEN 'Amplification'
               WHEN MAX(s."copy_number") = 3 THEN 'Gain'
               WHEN MAX(s."copy_number") = 2 THEN 'Normal'
               WHEN MAX(s."copy_number") = 1 THEN 'Heterozygous Deletion'
               WHEN MAX(s."copy_number") = 0 THEN 'Homozygous Deletion'
               ELSE 'Other'
             END AS "cnv_subtype"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 AS s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  AS c
        ON s."chromosome" = c."chromosome"
       AND s."start_pos" <= c."hg38_stop"
       AND s."end_pos"   >= c."hg38_start"
      WHERE s."project_short_name" = 'TCGA-KIRC'
      GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
     ) res
GROUP BY res."chromosome", res."cytoband_name", res."cnv_subtype"
ORDER BY res."chromosome", res."cytoband_name"
LIMIT 20;
