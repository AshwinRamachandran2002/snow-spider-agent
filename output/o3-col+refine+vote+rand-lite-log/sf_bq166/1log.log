```sql
-- 6) Description: For every KIRC case and cytoband, compute the maximum copy-number observed
SELECT s."case_barcode",
       c."chromosome",
       c."cytoband_name",
       MAX(s."copy_number") AS "max_copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 AS s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  AS c
  ON s."chromosome" = c."chromosome"
 AND s."start_pos" <= c."hg38_stop"
 AND s."end_pos"   >= c."hg38_start"
WHERE s."project_short_name" = 'TCGA-KIRC'
GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
LIMIT 20;
```

```sql
-- 7) Description: Add biological subtype classification to each (case, cytoband) maximum CN
SELECT "case_barcode",
       "chromosome",
       "cytoband_name",
       "max_copy_number",
       CASE
         WHEN "max_copy_number" > 3 THEN 'Amplification'
         WHEN "max_copy_number" = 3 THEN 'Gain'
         WHEN "max_copy_number" = 2 THEN 'Normal'
         WHEN "max_copy_number" = 1 THEN 'Heterozygous Deletion'
         WHEN "max_copy_number" = 0 THEN 'Homozygous Deletion'
         ELSE 'Other'
       END AS "cnv_subtype"
FROM (
      SELECT s."case_barcode",
             c."chromosome",
             c."cytoband_name",
             MAX(s."copy_number") AS "max_copy_number"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 AS s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  AS c
        ON s."chromosome" = c."chromosome"
       AND s."start_pos" <= c."hg38_stop"
       AND s."end_pos"   >= c."hg38_start"
      WHERE s."project_short_name" = 'TCGA-KIRC'
      GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
     ) q
LIMIT 20;
```

```sql
-- 8) Description: Determine total number of distinct KIRC cases with CN-segment data
SELECT COUNT(DISTINCT "case_barcode") AS "total_kirc_cases"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
WHERE "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
-- 9) Description: Calculate frequency of each CNV subtype per cytoband across TCGA-KIRC cases
SELECT res."chromosome",
       res."cytoband_name",
       res."cnv_subtype",
       COUNT(DISTINCT res."case_barcode") * 100.0
         / ( SELECT COUNT(DISTINCT "case_barcode")
             FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
             WHERE "project_short_name" = 'TCGA-KIRC' ) AS "frequency_pct"
FROM (
      SELECT s."case_barcode",
             c."chromosome",
             c."cytoband_name",
             CASE
               WHEN MAX(s."copy_number") > 3 THEN 'Amplification'
               WHEN MAX(s."copy_number") = 3 THEN 'Gain'
               WHEN MAX(s."copy_number") = 2 THEN 'Normal'
               WHEN MAX(s."copy_number") = 1 THEN 'Heterozygous Deletion'
               WHEN MAX(s."copy_number") = 0 THEN 'Homozygous Deletion'
               ELSE 'Other'
             END AS "cnv_subtype"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 AS s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  AS c
        ON s."chromosome" = c."chromosome"
       AND s."start_pos" <= c."hg38_stop"
       AND s."end_pos"   >= c."hg38_start"
      WHERE s."project_short_name" = 'TCGA-KIRC'
      GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
     ) res
GROUP BY res."chromosome", res."cytoband_name", res."cnv_subtype"
ORDER BY res."chromosome", res."cytoband_name"
LIMIT 20;
```

```sql
-- 10) Description: Full final-answer style query (still limited to 20 rows) showing cytoband-level
-- subtype frequencies for TCGA-KIRC, sorted by chromosome then cytoband
WITH kirc_cases AS (
    SELECT DISTINCT "case_barcode"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
    WHERE "project_short_name" = 'TCGA-KIRC'
), cytoband_max AS (
    SELECT s."case_barcode",
           c."chromosome",
           c."cytoband_name",
           MAX(s."copy_number") AS "max_copy"
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 AS s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                  AS c
      ON s."chromosome" = c."chromosome"
     AND s."start_pos" <= c."hg38_stop"
     AND s."end_pos"   >= c."hg38_start"
    WHERE s."project_short_name" = 'TCGA-KIRC'
    GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
), classified AS (
    SELECT "case_barcode",
           "chromosome",
           "cytoband_name",
           CASE
             WHEN "max_copy" > 3 THEN 'Amplification'
             WHEN "max_copy" = 3 THEN 'Gain'
             WHEN "max_copy" = 2 THEN 'Normal'
             WHEN "max_copy" = 1 THEN 'Heterozygous Deletion'
             WHEN "max_copy" = 0 THEN 'Homozygous Deletion'
             ELSE 'Other'
           END AS "cnv_subtype"
    FROM cytoband_max
), freq AS (
    SELECT "chromosome",
           "cytoband_name",
           "cnv_subtype",
           COUNT(DISTINCT "case_barcode") AS "num_cases"
    FROM classified
    GROUP BY "chromosome", "cytoband_name", "cnv_subtype"
)
SELECT f."chromosome",
       f."cytoband_name",
       f."cnv_subtype",
       f."num_cases" * 100.0 / (SELECT COUNT(*) FROM kirc_cases) AS "frequency_pct"
FROM freq AS f
ORDER BY f."chromosome", f."cytoband_name"
LIMIT 20;
```
