```sql
--Description: For one representative KIRC sample, retrieve the maximum copy number observed per cytoband
WITH joined AS (
  SELECT s."case_barcode",
         s."chromosome",
         c."cytoband_name",
         s."copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON s."chromosome" = c."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."project_short_name" = 'TCGA-KIRC'
    AND s."case_barcode" = (
        SELECT MIN("case_barcode")
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
        WHERE "project_short_name" = 'TCGA-KIRC'
    )
)
SELECT "case_barcode",
       "chromosome",
       "cytoband_name",
       MAX("copy_number") AS "max_copy_number"
FROM joined
GROUP BY "case_barcode", "chromosome", "cytoband_name"
LIMIT 20;
```

```sql
--Description: Classify max copy numbers for that same sample into the five CNV categories
WITH joined AS (
  SELECT s."case_barcode",
         s."chromosome",
         c."cytoband_name",
         s."copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON s."chromosome" = c."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."project_short_name" = 'TCGA-KIRC'
    AND s."case_barcode" = (
        SELECT MIN("case_barcode")
        FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
        WHERE "project_short_name" = 'TCGA-KIRC'
    )
),
max_cn AS (
  SELECT "case_barcode",
         "chromosome",
         "cytoband_name",
         MAX("copy_number") AS "max_copy_number"
  FROM joined
  GROUP BY "case_barcode", "chromosome", "cytoband_name"
)
SELECT "case_barcode",
       "chromosome",
       "cytoband_name",
       "max_copy_number",
       CASE
         WHEN "max_copy_number" > 3 THEN 'Amplification'
         WHEN "max_copy_number" = 3 THEN 'Gain'
         WHEN "max_copy_number" = 2 THEN 'Normal'
         WHEN "max_copy_number" = 1 THEN 'Heterozygous Deletion'
         WHEN "max_copy_number" = 0 THEN 'Homozygous Deletion'
       END AS "cnv_class"
FROM max_cn
LIMIT 20;
```

```sql
--Description: Across all KIRC cases, count how many fall into each CNV class per cytoband (sample rows)
WITH joined AS (
  SELECT s."case_barcode",
         c."cytoband_name",
         s."copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON s."chromosome" = c."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."project_short_name" = 'TCGA-KIRC'
),
max_cn AS (
  SELECT "case_barcode",
         "cytoband_name",
         MAX("copy_number") AS "max_copy_number"
  FROM joined
  GROUP BY "case_barcode", "cytoband_name"
),
classified AS (
  SELECT "cytoband_name",
         CASE
           WHEN "max_copy_number" > 3 THEN 'Amplification'
           WHEN "max_copy_number" = 3 THEN 'Gain'
           WHEN "max_copy_number" = 2 THEN 'Normal'
           WHEN "max_copy_number" = 1 THEN 'Heterozygous Deletion'
           WHEN "max_copy_number" = 0 THEN 'Homozygous Deletion'
         END AS "cnv_class"
  FROM max_cn
)
SELECT "cytoband_name",
       "cnv_class",
       COUNT(*) AS "case_count"
FROM classified
GROUP BY "cytoband_name", "cnv_class"
LIMIT 20;
```

```sql
--Description: Show percentage distribution of CNV classes for cytobands on chromosome 3 (TCGA-KIRC)
WITH joined AS (
  SELECT s."case_barcode",
         s."chromosome",
         c."cytoband_name",
         s."copy_number"
  FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
  JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 c
    ON s."chromosome" = c."chromosome"
   AND LEAST(s."end_pos", c."hg38_stop") > GREATEST(s."start_pos", c."hg38_start")
  WHERE s."project_short_name" = 'TCGA-KIRC'
    AND s."chromosome" = 'chr3'
),
max_cn AS (
  SELECT "case_barcode",
         "cytoband_name",
         MAX("copy_number") AS "max_copy_number"
  FROM joined
  GROUP BY "case_barcode", "cytoband_name"
),
classified AS (
  SELECT "cytoband_name",
         CASE
           WHEN "max_copy_number" > 3 THEN 'Amplification'
           WHEN "max_copy_number" = 3 THEN 'Gain'
           WHEN "max_copy_number" = 2 THEN 'Normal'
           WHEN "max_copy_number" = 1 THEN 'Heterozygous Deletion'
           WHEN "max_copy_number" = 0 THEN 'Homozygous Deletion'
         END AS "cnv_class"
  FROM max_cn
),
totals AS (
  SELECT COUNT(DISTINCT j."case_barcode") AS "total_cases"
  FROM joined j
)
SELECT c."cytoband_name",
       c."cnv_class",
       ROUND(
         (COUNT(*) / (SELECT "total_cases" FROM totals)::FLOAT) * 100,
         2
       ) AS "percentage_cases"
FROM classified c
GROUP BY c."cytoband_name", c."cnv_class"
LIMIT 20;
```

