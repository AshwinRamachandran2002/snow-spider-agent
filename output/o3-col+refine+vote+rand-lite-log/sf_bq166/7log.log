--Description: 
-- We need a single query that, step-by-step, does the following for the TCGA-KIRC cohort:
--   • Count the total number of unique cases   →  denominator.
--   • For every (case, cytoband) pair, find the segment with the highest (most extreme) copy_number.
--   • Translate that maximum copy number into one of five biological sub-types:
--         >3 = Amplification, 3 = Gain, 2 = Normal, 1 = Het-del, 0 = Homo-del.
--   • For each cytoband / subtype, count how many distinct cases have that call.
--   • Convert those counts to a percentage of the total KIRC cases.
--   • Finally, order the report by chromosome: numeric 1-22, then X (23), Y (24),
--     avoiding the cast error we saw earlier by using REGEXP_SUBSTR to pull the
--     chromosome prefix and mapping ‘X’/‘Y’ explicitly.
-- The CTE names reflect each conceptual step so the “thinking process” is preserved
-- while remaining a single executable SQL block.
WITH
-- 1) total number of KIRC cases
total AS (
    SELECT COUNT(DISTINCT "case_barcode") AS tot
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
    WHERE "project_short_name" = 'TCGA-KIRC'
),
-- 2) max copy number per (case, cytoband)
per_sample_band AS (
    SELECT
        s."case_barcode",
        b."cytoband_name",
        MAX(s."copy_number") AS max_cn
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
    JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38 b
      ON s."chromosome"       = b."chromosome"
     AND s."project_short_name" = 'TCGA-KIRC'
     AND s."start_pos" <= b."hg38_stop"
     AND s."end_pos"   >= b."hg38_start"
    GROUP BY s."case_barcode", b."cytoband_name"
),
-- 3) classify & count cases per (band, subtype)
counts AS (
    SELECT
        psb."cytoband_name",
        CASE
            WHEN psb."max_cn" > 3 THEN 'Amplification'
            WHEN psb."max_cn" = 3 THEN 'Gain'
            WHEN psb."max_cn" = 2 THEN 'Normal'
            WHEN psb."max_cn" = 1 THEN 'Heterozygous Deletion'
            ELSE                 'Homozygous Deletion'
        END AS cn_subtype,
        COUNT(DISTINCT psb."case_barcode") AS num_cases
    FROM per_sample_band psb
    GROUP BY
        psb."cytoband_name",
        CASE
            WHEN psb."max_cn" > 3 THEN 'Amplification'
            WHEN psb."max_cn" = 3 THEN 'Gain'
            WHEN psb."max_cn" = 2 THEN 'Normal'
            WHEN psb."max_cn" = 1 THEN 'Heterozygous Deletion'
            ELSE                 'Homozygous Deletion'
        END
)
-- 4) compute percentages & order sensibly
SELECT
    c."cytoband_name",
    c."cn_subtype",
    ROUND(100.0 * c."num_cases" / t.tot, 2) AS percent_of_cases
FROM counts c
CROSS JOIN total t
ORDER BY
    CASE
        WHEN REGEXP_LIKE(c."cytoband_name", '^X') THEN 23
        WHEN REGEXP_LIKE(c."cytoband_name", '^Y') THEN 24
        ELSE TO_NUMBER(REGEXP_SUBSTR(c."cytoband_name", '^[0-9]+'))
    END,
    c."cytoband_name",
    c."cn_subtype";
