      ON s."chromosome"        = b."chromosome"
     AND s."project_short_name" = 'TCGA-KIRC'
     AND s."start_pos" <= b."hg38_stop"
     AND s."end_pos"   >= b."hg38_start"
    GROUP BY s."case_barcode", b."cytoband_name"
), counts_cte AS (
    SELECT
        psb."cytoband_name",
        CASE
            WHEN psb."max_cn" > 3 THEN 'Amplification'
            WHEN psb."max_cn" = 3 THEN 'Gain'
            WHEN psb."max_cn" = 2 THEN 'Normal'
            WHEN psb."max_cn" = 1 THEN 'Heterozygous Deletion'
            ELSE                  'Homozygous Deletion'
        END                           AS cn_subtype,
        COUNT(DISTINCT psb."case_barcode") AS num_cases
    FROM per_sample_band psb
    GROUP BY
        psb."cytoband_name",
        CASE
            WHEN psb."max_cn" > 3 THEN 'Amplification'
            WHEN psb."max_cn" = 3 THEN 'Gain'
            WHEN psb."max_cn" = 2 THEN 'Normal'
