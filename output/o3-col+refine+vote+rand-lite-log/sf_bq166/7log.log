--  1. total_cte         → Count distinct TCGA-KIRC cases.  This will be our
--                         denominator for all percentage calculations.
--  2. per_sample_band   → Join allelic CNV segments to cytobands (same
--                         chromosome AND coordinate overlap) and, for every
--                         (case, band) pair, keep the *maximum* copy_number
--                         observed.  That single number summarizes the
--                         strongest CN event the sample shows in the band.
--  3. counts_cte        → Translate each max_cn into five biological CN
--                         sub-types and count distinct cases per
--                         (cytoband, subtype).
--  4. Final SELECT      → Convert counts to percentages of the total number
--                         of KIRC cases and sort bands in chromosome order
--                         (1-22, X, Y).  REGEXP_SUBSTR safely extracts the
--                         leading numeric/letter chromosome to avoid the
--                         casting errors that arose earlier.
WITH total_cte AS (
    SELECT COUNT(DISTINCT "case_barcode") AS tot_cases
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
    WHERE "project_short_name" = 'TCGA-KIRC'
), per_sample_band AS (
    SELECT
        s."case_barcode",
        b."cytoband_name",
        MAX(s."copy_number") AS max_cn
    FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 s
