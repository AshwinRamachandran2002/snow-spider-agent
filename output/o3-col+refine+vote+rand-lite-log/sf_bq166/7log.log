```sql
--Description: 2)  Preview a handful of KIRC copy-number segments
SELECT "project_short_name",
       "case_barcode",
       "chromosome",
       "start_pos",
       "end_pos",
       "copy_number"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
WHERE "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 3)  Inspect cytoband (hg38) definitions for a quick sanity check
SELECT "chromosome",
       "cytoband_name",
       "hg38_start",
       "hg38_stop"
FROM TCGA_MITELMAN.PROD.CYTOBANDS_HG38
LIMIT 20;
```

```sql
--Description: 4)  Demonstrate how one joins KIRC segments to cytobands on chromosome & genomic overlap
SELECT s."case_barcode",
       s."chromosome",
       s."start_pos"  AS "seg_start",
       s."end_pos"    AS "seg_end",
       b."cytoband_name",
       b."hg38_start" AS "band_start",
       b."hg38_stop"  AS "band_end"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                        b
  ON s."chromosome" = b."chromosome"
 AND s."project_short_name" = 'TCGA-KIRC'
 AND s."start_pos" <= b."hg38_stop"
 AND s."end_pos"   >= b."hg38_start"
LIMIT 20;
```

```sql
--Description: 5)  For each KIRC sample & cytoband, obtain the maximum observed copy number
SELECT s."case_barcode",
       b."cytoband_name",
       MAX(s."copy_number") AS "max_cn"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                        b
  ON s."chromosome" = b."chromosome"
 AND s."project_short_name" = 'TCGA-KIRC'
 AND s."start_pos" <= b."hg38_stop"
 AND s."end_pos"   >= b."hg38_start"
GROUP BY s."case_barcode", b."cytoband_name"
LIMIT 20;
```

```sql
--Description: 6)  Classify those maximum CN values into AMP, GAIN, HD, HETDEL, or NORMAL
SELECT "case_barcode",
       "cytoband_name",
       "max_cn",
       CASE 
            WHEN "max_cn" > 3 THEN 'Amplification'
            WHEN "max_cn" = 3 THEN 'Gain'
            WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
            WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
            ELSE 'Normal'
       END AS "cn_subtype"
FROM (
      SELECT s."case_barcode",
             b."cytoband_name",
             MAX(s."copy_number") AS "max_cn"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                        b
        ON s."chromosome" = b."chromosome"
       AND s."project_short_name" = 'TCGA-KIRC'
       AND s."start_pos" <= b."hg38_stop"
       AND s."end_pos"   >= b."hg38_start"
      GROUP BY s."case_barcode", b."cytoband_name"
) q
LIMIT 20;
```

```sql
--Description: 7)  Count per cytoband the number of distinct KIRC cases in each CN subtype
SELECT "cytoband_name",
       "cn_subtype",
       COUNT(DISTINCT "case_barcode") AS "num_cases"
FROM (
      SELECT s."case_barcode",
             b."cytoband_name",
             MAX(s."copy_number") AS "max_cn"
      FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
      JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                        b
        ON s."chromosome" = b."chromosome"
       AND s."project_short_name" = 'TCGA-KIRC'
       AND s."start_pos" <= b."hg38_stop"
       AND s."end_pos"   >= b."hg38_start"
      GROUP BY s."case_barcode", b."cytoband_name"
) t
CROSS JOIN LATERAL (
     SELECT CASE 
               WHEN t."max_cn" > 3 THEN 'Amplification'
               WHEN t."max_cn" = 3 THEN 'Gain'
               WHEN t."max_cn" = 0 THEN 'Homozygous Deletion'
               WHEN t."max_cn" = 1 THEN 'Heterozygous Deletion'
               ELSE 'Normal'
            END AS "cn_subtype"
) u
GROUP BY "cytoband_name", "cn_subtype"
LIMIT 20;
```

```sql
--Description: 8)  Determine the total number of distinct KIRC cases in the dataset (denominator for percentages)
SELECT COUNT(DISTINCT "case_barcode") AS "total_kirc_cases"
FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
WHERE "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 9)  Compute frequency (%) of each CN subtype per cytoband using the total case count
WITH total AS (
     SELECT COUNT(DISTINCT "case_barcode") AS "tot" 
     FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
     WHERE "project_short_name" = 'TCGA-KIRC'
), counts AS (
     SELECT "cytoband_name",
            CASE 
                WHEN "max_cn" > 3 THEN 'Amplification'
                WHEN "max_cn" = 3 THEN 'Gain'
                WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
                WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
                ELSE 'Normal'
            END AS "cn_subtype",
            COUNT(DISTINCT "case_barcode") AS "num_cases"
     FROM (
          SELECT s."case_barcode",
                 b."cytoband_name",
                 MAX(s."copy_number") AS "max_cn"
          FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
          JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                        b
            ON s."chromosome" = b."chromosome"
           AND s."project_short_name" = 'TCGA-KIRC'
           AND s."start_pos" <= b."hg38_stop"
           AND s."end_pos"   >= b."hg38_start"
          GROUP BY s."case_barcode", b."cytoband_name"
     ) z
     GROUP BY "cytoband_name", "cn_subtype"
)
SELECT c."cytoband_name",
       c."cn_subtype",
       ROUND(100.0 * c."num_cases" / t."tot", 2) AS "percent_of_cases"
FROM counts c, total t
ORDER BY SPLIT_PART(c."cytoband_name", 'p', 1)::INTEGER,  -- crude chromosome sort
         c."cytoband_name",
         c."cn_subtype"
LIMIT 20;
```

```sql
--Description: 10)  Show the final sorted frequency table for all records (no LIMIT) ready for export / visualization
WITH total AS (
     SELECT COUNT(DISTINCT "case_barcode") AS "tot" 
     FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
     WHERE "project_short_name" = 'TCGA-KIRC'
), counts AS (
     SELECT "cytoband_name",
            CASE 
                WHEN "max_cn" > 3 THEN 'Amplification'
                WHEN "max_cn" = 3 THEN 'Gain'
                WHEN "max_cn" = 0 THEN 'Homozygous Deletion'
                WHEN "max_cn" = 1 THEN 'Heterozygous Deletion'
                ELSE 'Normal'
            END AS "cn_subtype",
            COUNT(DISTINCT "case_barcode") AS "num_cases"
     FROM (
          SELECT s."case_barcode",
                 b."cytoband_name",
                 MAX(s."copy_number") AS "max_cn"
          FROM TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
          JOIN TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                        b
            ON s."chromosome" = b."chromosome"
           AND s."project_short_name" = 'TCGA-KIRC'
           AND s."start_pos" <= b."hg38_stop"
           AND s."end_pos"   >= b."hg38_start"
          GROUP BY s."case_barcode", b."cytoband_name"
     ) z
     GROUP BY "cytoband_name", "cn_subtype"
)
SELECT c."cytoband_name",
       c."cn_subtype",
       ROUND(100.0 * c."num_cases" / t."tot", 2) AS "percent_of_cases"
FROM counts c, total t
ORDER BY SPLIT_PART(c."cytoband_name", 'p', 1)::INTEGER,  -- sort by chromosome number
         c."cytoband_name",
         c."cn_subtype";
```
