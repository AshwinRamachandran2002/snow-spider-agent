```sql
--Description: 5)  Compute the maximum copy-number per case & cytoband (sample rows)
SELECT  s."case_barcode",
        c."chromosome",
        c."cytoband_name",
        MAX(s."copy_number") AS "max_cn"
FROM    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
JOIN    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                     c
  ON    s."chromosome"  = c."chromosome"
 AND    s."start_pos"  <= c."hg38_stop"
 AND    s."end_pos"    >= c."hg38_start"
WHERE   s."project_short_name" = 'TCGA-KIRC'
GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
LIMIT   20;
```

```sql
--Description: 6)  Categorise those maxima into Amp/Gain/Del types (sample rows)
SELECT  "case_barcode",
        "chromosome",
        "cytoband_name",
        "max_cn",
        CASE
             WHEN "max_cn" > 3 THEN 'Amplification'
             WHEN "max_cn" = 3 THEN 'Gain'
             WHEN "max_cn" = 2 THEN 'Normal'
             WHEN "max_cn" = 1 THEN 'Het_Del'
             WHEN "max_cn" = 0 THEN 'Homo_Del'
        END AS "cnv_class"
FROM   (
        SELECT  s."case_barcode",
                c."chromosome",
                c."cytoband_name",
                MAX(s."copy_number") AS "max_cn"
        FROM    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
        JOIN    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                     c
          ON    s."chromosome"  = c."chromosome"
         AND    s."start_pos"  <= c."hg38_stop"
         AND    s."end_pos"    >= c."hg38_start"
        WHERE   s."project_short_name" = 'TCGA-KIRC'
        GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
) q
LIMIT 20;
```

```sql
--Description: 7)  Count total number of distinct KIRC cases (single value preview)
SELECT COUNT(DISTINCT "case_barcode") AS "total_kirc_cases"
FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
WHERE  "project_short_name" = 'TCGA-KIRC'
LIMIT 20;
```

```sql
--Description: 8)  Count KIRC cases per cytoband & CNV class (sample rows)
WITH per_case AS (
        SELECT  s."case_barcode",
                c."chromosome",
                c."cytoband_name",
                MAX(s."copy_number") AS "max_cn"
        FROM    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
        JOIN    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                     c
          ON    s."chromosome"  = c."chromosome"
         AND    s."start_pos"  <= c."hg38_stop"
         AND    s."end_pos"    >= c."hg38_start"
        WHERE   s."project_short_name" = 'TCGA-KIRC'
        GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
)
SELECT  "chromosome",
        "cytoband_name",
        CASE
             WHEN "max_cn" > 3 THEN 'Amplification'
             WHEN "max_cn" = 3 THEN 'Gain'
             WHEN "max_cn" = 2 THEN 'Normal'
             WHEN "max_cn" = 1 THEN 'Het_Del'
             WHEN "max_cn" = 0 THEN 'Homo_Del'
        END AS "cnv_class",
        COUNT(DISTINCT "case_barcode") AS "n_cases"
FROM    per_case
GROUP BY "chromosome","cytoband_name","cnv_class"
LIMIT 20;
```

```sql
--Description: 9)  Combine totals with counts to compute % frequency (sample rows)
WITH totals AS (
        SELECT COUNT(DISTINCT "case_barcode") AS "total_cases"
        FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
        WHERE  "project_short_name" = 'TCGA-KIRC'
), per_case AS (
        SELECT  s."case_barcode",
                c."chromosome",
                c."cytoband_name",
                MAX(s."copy_number") AS "max_cn"
        FROM    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
        JOIN    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                     c
          ON    s."chromosome"  = c."chromosome"
         AND    s."start_pos"  <= c."hg38_stop"
         AND    s."end_pos"    >= c."hg38_start"
        WHERE   s."project_short_name" = 'TCGA-KIRC'
        GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
), summary AS (
        SELECT  "chromosome",
                "cytoband_name",
                CASE
                     WHEN "max_cn" > 3 THEN 'Amplification'
                     WHEN "max_cn" = 3 THEN 'Gain'
                     WHEN "max_cn" = 2 THEN 'Normal'
                     WHEN "max_cn" = 1 THEN 'Het_Del'
                     WHEN "max_cn" = 0 THEN 'Homo_Del'
                END AS "cnv_class",
                COUNT(DISTINCT "case_barcode") AS "n_cases"
        FROM    per_case
        GROUP BY "chromosome","cytoband_name","cnv_class"
)
SELECT  s."chromosome",
        s."cytoband_name",
        s."cnv_class",
        ROUND(100.0 * s."n_cases" / t."total_cases", 2) AS "pct_cases"
FROM    summary s
CROSS JOIN totals t
ORDER BY  s."chromosome",
          s."cytoband_name",
          s."cnv_class"
LIMIT 20;
```

```sql
--Description: 10)  Final ordered frequency table for all cytobands (show first 20 rows)
WITH totals AS (
        SELECT COUNT(DISTINCT "case_barcode") AS "total_cases"
        FROM   TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23
        WHERE  "project_short_name" = 'TCGA-KIRC'
), per_case AS (
        SELECT  s."case_barcode",
                c."chromosome",
                c."cytoband_name",
                MAX(s."copy_number") AS "max_cn"
        FROM    TCGA_MITELMAN.TCGA_VERSIONED.COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23  s
        JOIN    TCGA_MITELMAN.PROD.CYTOBANDS_HG38                                     c
          ON    s."chromosome"  = c."chromosome"
         AND    s."start_pos"  <= c."hg38_stop"
         AND    s."end_pos"    >= c."hg38_start"
        WHERE   s."project_short_name" = 'TCGA-KIRC'
        GROUP BY s."case_barcode", c."chromosome", c."cytoband_name"
), summary AS (
        SELECT  "chromosome",
                "cytoband_name",
                CASE
                     WHEN "max_cn" > 3 THEN 'Amplification'
                     WHEN "max_cn" = 3 THEN 'Gain'
                     WHEN "max_cn" = 2 THEN 'Normal'
                     WHEN "max_cn" = 1 THEN 'Het_Del'
                     WHEN "max_cn" = 0 THEN 'Homo_Del'
                END AS "cnv_class",
                COUNT(DISTINCT "case_barcode") AS "n_cases"
        FROM    per_case
        GROUP BY "chromosome","cytoband_name","cnv_class"
)
SELECT  "chromosome",
        "cytoband_name",
        "cnv_class",
        ROUND(100.0 * "n_cases" / (SELECT "total_cases" FROM totals), 2) AS "pct_cases"
FROM    summary
ORDER BY "chromosome"::INTEGER NULLS LAST,    -- put chr1..chr22 numeric order
         "cytoband_name",
         "cnv_class"
LIMIT 20;
```
