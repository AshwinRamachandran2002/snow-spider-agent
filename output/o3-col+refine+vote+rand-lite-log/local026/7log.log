```sql
--Description: Compute total runs conceded in every over-bowler pair (batsman + extras).
SELECT
    b."match_id",
    b."innings_no",
    b."over_id",
    b."bowler",
    SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_conceded"
FROM "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS bs
       ON  b."match_id" = bs."match_id"
       AND b."over_id"  = bs."over_id"
       AND b."ball_id"  = bs."ball_id"
       AND b."innings_no" = bs."innings_no"
LEFT JOIN "extra_runs" AS er
       ON  b."match_id" = er."match_id"
       AND b."over_id"  = er."over_id"
       AND b."ball_id"  = er."ball_id"
       AND b."innings_no" = er."innings_no"
GROUP BY
    b."match_id",
    b."innings_no",
    b."over_id",
    b."bowler"
LIMIT 20;
```

```sql
--Description: For every match, find the maximum runs conceded in any single over.
WITH over_runs AS (
    SELECT
        b."match_id",
        b."innings_no",
        b."over_id",
        b."bowler",
        SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_conceded"
    FROM "ball_by_ball"  AS b
    LEFT JOIN "batsman_scored" AS bs
           ON b."match_id" = bs."match_id"
          AND b."over_id"  = bs."over_id"
          AND b."ball_id"  = bs."ball_id"
          AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs"  AS er
           ON b."match_id" = er."match_id"
          AND b."over_id"  = er."over_id"
          AND b."ball_id"  = er."ball_id"
          AND b."innings_no" = er."innings_no"
    GROUP BY b."match_id", b."innings_no", b."over_id", b."bowler"
)
SELECT
    "match_id",
    MAX("runs_conceded") AS "max_runs_over"
FROM over_runs
GROUP BY "match_id"
LIMIT 20;
```

```sql
--Description: List every over that achieved the maximum conceded-runs value for its match.
WITH over_runs AS (
    SELECT
        b."match_id",
        b."innings_no",
        b."over_id",
        b."bowler",
        SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_conceded"
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
           ON b."match_id" = bs."match_id"
          AND b."over_id"  = bs."over_id"
          AND b."ball_id"  = bs."ball_id"
          AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs" AS er
           ON b."match_id" = er."match_id"
          AND b."over_id"  = er."over_id"
          AND b."ball_id"  = er."ball_id"
          AND b."innings_no" = er."innings_no"
    GROUP BY b."match_id", b."innings_no", b."over_id", b."bowler"
),
match_max AS (
    SELECT
        "match_id",
        MAX("runs_conceded") AS "max_runs_over"
    FROM over_runs
    GROUP BY "match_id"
)
SELECT
    o."match_id",
    o."innings_no",
    o."over_id",
    o."bowler",
    o."runs_conceded"
FROM over_runs AS o
JOIN match_max AS m
  ON o."match_id" = m."match_id"
 AND o."runs_conceded" = m."max_runs_over"
LIMIT 20;
```

```sql
--Description: Attach bowler names to the overs where they conceded the most runs for that match.
WITH over_runs AS (
    SELECT
        b."match_id",
        b."innings_no",
        b."over_id",
        b."bowler",
        SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_conceded"
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
           ON b."match_id" = bs."match_id"
          AND b."over_id"  = bs."over_id"
          AND b."ball_id"  = bs."ball_id"
          AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs" AS er
           ON b."match_id" = er."match_id"
          AND b."over_id"  = er."over_id"
          AND b."ball_id"  = er."ball_id"
          AND b."innings_no" = er."innings_no"
    GROUP BY b."match_id", b."innings_no", b."over_id", b."bowler"
),
match_max AS (
    SELECT
        "match_id",
        MAX("runs_conceded") AS "max_runs_over"
    FROM over_runs
    GROUP BY "match_id"
)
SELECT
    o."match_id",
    p."player_name"       AS "bowler_name",
    o."runs_conceded"
FROM over_runs  AS o
JOIN match_max  AS m  ON o."match_id" = m."match_id"
                     AND o."runs_conceded" = m."max_runs_over"
JOIN "player"   AS p  ON p."player_id"  = o."bowler"
LIMIT 20;
```

```sql
--Description: Retrieve the top 3 instances (bowler & match) of highest runs conceded in a single over, 
--considering only overs that were the worst in their respective matches.
WITH over_runs AS (
    SELECT
        b."match_id",
        b."innings_no",
        b."over_id",
        b."bowler",
        SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_conceded"
    FROM "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs
           ON b."match_id" = bs."match_id"
          AND b."over_id"  = bs."over_id"
          AND b."ball_id"  = bs."ball_id"
          AND b."innings_no" = bs."innings_no"
    LEFT JOIN "extra_runs" AS er
           ON b."match_id" = er."match_id"
          AND b."over_id"  = er."over_id"
          AND b."ball_id"  = er."ball_id"
          AND b."innings_no" = er."innings_no"
    GROUP BY b."match_id", b."innings_no", b."over_id", b."bowler"
),
match_max AS (
    SELECT
        "match_id",
        MAX("runs_conceded") AS "max_runs_over"
    FROM over_runs
    GROUP BY "match_id"
),
worst_overs AS (
    SELECT
        o."match_id",
        o."bowler",
        o."runs_conceded"
    FROM over_runs AS o
    JOIN match_max AS m
      ON o."match_id" = m."match_id"
     AND o."runs_conceded" = m."max_runs_over"
)
SELECT
    p."player_name"    AS "bowler_name",
    w."match_id",
    w."runs_conceded"
FROM worst_overs AS w
JOIN "player"  AS p ON p."player_id" = w."bowler"
ORDER BY w."runs_conceded" DESC, p."player_name"
LIMIT 3;
```

These six progressively complex queries culminate in the final one, which returns the three bowlers who, in the worst over of their respective matches, conceded the most runs in a single over across the entire dataset, together with the match in which each instance occurred.
