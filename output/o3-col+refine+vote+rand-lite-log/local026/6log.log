```sql
-- 1) Look at the bowler id’s that occur in the delivery-wise data together with the
--    corresponding player names ( LIMIT 20 ).
SELECT DISTINCT b."bowler", p."player_name"
FROM "ball_by_ball" AS b
JOIN "player"       AS p ON p."player_id" = b."bowler"
LIMIT 20;
```

```sql
-- 2) Inspect how overs are represented – show one line per (match, over, bowler)
--    so we know the three basic grouping keys we will need later.
SELECT DISTINCT b."match_id", b."over_id", b."bowler"
FROM "ball_by_ball" AS b
ORDER BY b."match_id", b."over_id"
LIMIT 20;
```

```sql
-- 3) Check how many runs the striker actually scores on each ball
--    ( batsman_scored  table) – join it to the delivery table for context.
SELECT DISTINCT b."match_id", b."over_id", b."ball_id",
       bs."runs_scored"
FROM   "ball_by_ball"   AS b
LEFT JOIN "batsman_scored" AS bs
       ON  bs."match_id" = b."match_id"
       AND bs."over_id"  = b."over_id"
       AND bs."ball_id"  = b."ball_id"
       AND bs."innings_no" = b."innings_no"
LIMIT 20;
```

```sql
-- 4) Check how extra runs are stored and can be joined in the same way.
SELECT DISTINCT b."match_id", b."over_id", b."ball_id",
       er."extra_type", er."extra_runs"
FROM   "ball_by_ball" AS b
LEFT  JOIN "extra_runs" AS er
       ON  er."match_id" = b."match_id"
       AND er."over_id"  = b."over_id"
       AND er."ball_id"  = b."ball_id"
       AND er."innings_no" = b."innings_no"
LIMIT 20;
```

```sql
-- 5) Compute the total runs conceded by a bowler on every single delivery
--    (batsman + extras).  This is the atomic number we will later aggregate.
SELECT b."match_id", b."over_id", b."bowler",
       SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_ball"
FROM   "ball_by_ball"   AS b
LEFT  JOIN "batsman_scored" AS bs
       ON  bs."match_id" = b."match_id"
       AND bs."over_id"  = b."over_id"
       AND bs."ball_id"  = b."ball_id"
       AND bs."innings_no" = b."innings_no"
LEFT  JOIN "extra_runs" AS er
       ON  er."match_id" = b."match_id"
       AND er."over_id"  = b."over_id"
       AND er."ball_id"  = b."ball_id"
       AND er."innings_no" = b."innings_no"
GROUP BY b."match_id", b."over_id", b."bowler"
LIMIT 20;
```

```sql
-- 6) Aggregate the previous result to find, for each (match, over, bowler),
--    the total runs conceded in the complete over.
--    (This query already gives us over-level totals.)
SELECT b."match_id", b."over_id", b."bowler",
       SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
FROM   "ball_by_ball"   AS b
LEFT  JOIN "batsman_scored" AS bs
       ON  bs."match_id" = b."match_id"
       AND bs."over_id"  = b."over_id"
       AND bs."ball_id"  = b."ball_id"
       AND bs."innings_no" = b."innings_no"
LEFT  JOIN "extra_runs" AS er
       ON  er."match_id" = b."match_id"
       AND er."over_id"  = b."over_id"
       AND er."ball_id"  = b."ball_id"
       AND er."innings_no" = b."innings_no"
GROUP BY b."match_id", b."over_id", b."bowler"
ORDER BY b."match_id", "runs_in_over" DESC
LIMIT 20;
```

```sql
-- 7) For every match, pick only those overs that are the MOST expensive
--    (max runs conceded in that match).  Return match-id, bowler, and runs.
WITH over_totals AS (
      SELECT b."match_id", b."over_id", b."bowler",
             SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
      FROM   "ball_by_ball"   AS b
      LEFT  JOIN "batsman_scored" AS bs
             ON  bs."match_id" = b."match_id"
             AND bs."over_id"  = b."over_id"
             AND bs."ball_id"  = b."ball_id"
             AND bs."innings_no" = b."innings_no"
      LEFT  JOIN "extra_runs" AS er
             ON  er."match_id" = b."match_id"
             AND er."over_id"  = b."over_id"
             AND er."ball_id"  = b."ball_id"
             AND er."innings_no" = b."innings_no"
      GROUP BY b."match_id", b."over_id", b."bowler"
), max_in_match AS (
      SELECT  "match_id", MAX("runs_in_over") AS "max_runs"
      FROM    over_totals
      GROUP BY "match_id"
)
SELECT o."match_id", o."bowler", o."runs_in_over" AS "max_over_runs"
FROM   over_totals AS o
JOIN   max_in_match AS m
       ON  m."match_id"  = o."match_id"
       AND m."max_runs"  = o."runs_in_over"
LIMIT 20;
```

```sql
-- 8) Rank all such “most-expensive overs” across every match, sort by runs
--    conceded, and keep the overall top-3.  Attach bowler names as well.
WITH over_totals AS (
      SELECT b."match_id", b."over_id", b."bowler",
             SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
      FROM   "ball_by_ball"   AS b
      LEFT  JOIN "batsman_scored" AS bs
             ON  bs."match_id" = b."match_id"
             AND bs."over_id"  = b."over_id"
             AND bs."ball_id"  = b."ball_id"
             AND bs."innings_no" = b."innings_no"
      LEFT  JOIN "extra_runs" AS er
             ON  er."match_id" = b."match_id"
             AND er."over_id"  = b."over_id"
             AND er."ball_id"  = b."ball_id"
             AND er."innings_no" = b."innings_no"
      GROUP BY b."match_id", b."over_id", b."bowler"
), max_in_match AS (
      SELECT  "match_id", MAX("runs_in_over") AS "max_runs"
      FROM    over_totals
      GROUP BY "match_id"
), costly_overs AS (
      SELECT o."match_id", o."bowler", o."runs_in_over"
      FROM   over_totals AS o
      JOIN   max_in_match AS m
             ON  m."match_id"  = o."match_id"
             AND m."max_runs"  = o."runs_in_over"
)
SELECT c."match_id",
       p."player_name"           AS "bowler_name",
       c."runs_in_over"          AS "runs_conceded"
FROM   costly_overs AS c
JOIN   "player"     AS p ON p."player_id" = c."bowler"
ORDER BY c."runs_in_over" DESC
LIMIT 3;
```

```sql
-- 9) (Optional deeper dive) Show every delivery of the single most expensive over
--    revealed in query 8, to verify the calculation.
--    Replace :match_id, :bowler, :over_id with the actual numbers obtained.
SELECT b."match_id", b."over_id", b."ball_id",
       COALESCE(bs."runs_scored",0) AS "bat_runs",
       COALESCE(er."extra_runs",0)  AS "extra_runs",
       (COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0)) AS "total"
FROM   "ball_by_ball" AS b
LEFT  JOIN "batsman_scored" AS bs
       ON  bs."match_id" = b."match_id"
       AND bs."over_id"  = b."over_id"
       AND bs."ball_id"  = b."ball_id"
       AND bs."innings_no" = b."innings_no"
LEFT  JOIN "extra_runs" AS er
       ON  er."match_id" = b."match_id"
       AND er."over_id"  = b."over_id"
       AND er."ball_id"  = b."ball_id"
       AND er."innings_no" = b."innings_no"
WHERE  b."match_id" = :match_id
  AND  b."over_id"  = :over_id
  AND  b."bowler"   = :bowler
LIMIT 20;
```

```sql
-- 10) Final answer again, but grouped in the requested format
--     (bowler, match) – kept here for completeness.
WITH over_totals AS (
      SELECT b."match_id", b."over_id", b."bowler",
             SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
      FROM   "ball_by_ball"   AS b
      LEFT  JOIN "batsman_scored" AS bs
             ON  bs."match_id" = b."match_id"
             AND bs."over_id"  = b."over_id"
             AND bs."ball_id"  = b."ball_id"
             AND bs."innings_no" = b."innings_no"
      LEFT  JOIN "extra_runs" AS er
             ON  er."match_id" = b."match_id"
             AND er."over_id"  = b."over_id"
             AND er."ball_id"  = b."ball_id"
             AND er."innings_no" = b."innings_no"
      GROUP BY b."match_id", b."over_id", b."bowler"
), max_in_match AS (
      SELECT  "match_id", MAX("runs_in_over") AS "max_runs"
      FROM    over_totals
      GROUP BY "match_id"
), costly_overs AS (
      SELECT o."match_id", o."bowler", o."runs_in_over"
      FROM   over_totals AS o
      JOIN   max_in_match AS m
             ON  m."match_id"  = o."match_id"
             AND m."max_runs"  = o."runs_in_over"
)
SELECT p."player_name" AS "bowler_name",
       c."match_id",
       c."runs_in_over" AS "runs_conceded"
FROM   costly_overs AS c
JOIN   "player" AS p ON p."player_id" = c."bowler"
ORDER BY c."runs_in_over" DESC
LIMIT 3;
```

Each successive query builds the necessary pieces to arrive at the final list of the top-3 bowlers who conceded the highest number of runs in the most expensive over of their respective matches, together with the match in which it happened.
