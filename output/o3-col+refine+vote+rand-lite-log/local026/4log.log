```sql
-- 1) Inspect a few distinct bowler IDs that appear in the ball-by-ball log
SELECT DISTINCT bowler
FROM ball_by_ball
LIMIT 20;
```

```sql
-- 2) Look at how batsman runs join to a bowler for a handful of deliveries
SELECT b.match_id,
       b.over_id,
       b.ball_id,
       b.bowler,
       bs.runs_scored
FROM ball_by_ball AS b
JOIN batsman_scored AS bs
  USING (match_id, over_id, ball_id, innings_no)
LIMIT 20;
```

```sql
-- 3) Glimpse at the extra-runs table to see the structure and values
SELECT match_id,
       over_id,
       ball_id,
       innings_no,
       extra_type,
       extra_runs
FROM extra_runs
LIMIT 20;
```

```sql
-- 4) Compute TOTAL runs given away on each ball (bat + extras) – sample rows
SELECT b.match_id,
       b.over_id,
       b.ball_id,
       b.bowler,
       COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0) AS total_runs
FROM ball_by_ball AS b
LEFT JOIN batsman_scored AS bs
  USING (match_id, over_id, ball_id, innings_no)
LEFT JOIN extra_runs AS er
  USING (match_id, over_id, ball_id, innings_no)
LIMIT 20;
```

```sql
-- 5) Aggregate the above to runs conceded PER OVER by each bowler (sample)
SELECT b.match_id,
       b.over_id,
       b.bowler,
       SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
FROM ball_by_ball AS b
LEFT JOIN batsman_scored AS bs
  USING (match_id, over_id, ball_id, innings_no)
LEFT JOIN extra_runs AS er
  USING (match_id, over_id, ball_id, innings_no)
GROUP BY b.match_id, b.over_id, b.bowler
LIMIT 20;
```

```sql
-- 6) For every match, find the MAXIMUM runs conceded in any single over
SELECT tmp.match_id,
       MAX(tmp.runs_in_over) AS max_runs_in_over
FROM (
    SELECT b.match_id,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
      USING (match_id, over_id, ball_id, innings_no)
    LEFT JOIN extra_runs AS er
      USING (match_id, over_id, ball_id, innings_no)
    GROUP BY b.match_id, b.over_id, b.bowler
) AS tmp
GROUP BY tmp.match_id
LIMIT 20;
```

```sql
-- 7) Extract ONLY those overs that match the per-match maximum found above
SELECT o.match_id,
       o.over_id,
       o.bowler,
       o.runs_in_over
FROM (
    SELECT b.match_id,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
      USING (match_id, over_id, ball_id, innings_no)
    LEFT JOIN extra_runs AS er
      USING (match_id, over_id, ball_id, innings_no)
    GROUP BY b.match_id, b.over_id, b.bowler
) AS o
JOIN (
    SELECT tmp.match_id,
           MAX(tmp.runs_in_over) AS max_runs_in_over
    FROM (
        SELECT b.match_id,
               b.over_id,
               b.bowler,
               SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          USING (match_id, over_id, ball_id, innings_no)
        LEFT JOIN extra_runs AS er
          USING (match_id, over_id, ball_id, innings_no)
        GROUP BY b.match_id, b.over_id, b.bowler
    ) AS tmp
    GROUP BY tmp.match_id
) AS m
  ON o.match_id = m.match_id
 AND o.runs_in_over = m.max_runs_in_over
LIMIT 20;
```

```sql
-- 8) Order the ‘max-overs’ from all matches by runs conceded and keep top 10
SELECT o.match_id,
       o.bowler,
       o.runs_in_over
FROM (
    -- (same sub-query as in #7 that produces overs with match-maximum runs)
    SELECT o2.match_id,
           o2.bowler,
           o2.runs_in_over
    FROM (
        SELECT b.match_id,
               b.over_id,
               b.bowler,
               SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          USING (match_id, over_id, ball_id, innings_no)
        LEFT JOIN extra_runs AS er
          USING (match_id, over_id, ball_id, innings_no)
        GROUP BY b.match_id, b.over_id, b.bowler
    ) AS o2
    JOIN (
        SELECT tmp.match_id,
               MAX(tmp.runs_in_over) AS max_runs_in_over
        FROM (
            SELECT b.match_id,
                   b.over_id,
                   b.bowler,
                   SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
            FROM ball_by_ball AS b
            LEFT JOIN batsman_scored AS bs
              USING (match_id, over_id, ball_id, innings_no)
            LEFT JOIN extra_runs AS er
              USING (match_id, over_id, ball_id, innings_no)
            GROUP BY b.match_id, b.over_id, b.bowler
        ) AS tmp
        GROUP BY tmp.match_id
    ) AS m2
      ON o2.match_id = m2.match_id
     AND o2.runs_in_over = m2.max_runs_in_over
) AS o
ORDER BY o.runs_in_over DESC
LIMIT 10;
```

```sql
-- 9) Add the bowler’s actual name to those top ‘worst’ overs (top 10)
SELECT p.player_name AS bowler_name,
       o.match_id,
       o.runs_in_over
FROM (
    -- same ordered list from #8
    SELECT o.match_id,
           o.bowler,
           o.runs_in_over
    FROM (
        SELECT b.match_id,
               b.over_id,
               b.bowler,
               SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          USING (match_id, over_id, ball_id, innings_no)
        LEFT JOIN extra_runs AS er
          USING (match_id, over_id, ball_id, innings_no)
        GROUP BY b.match_id, b.over_id, b.bowler
    ) AS o2
    JOIN (
        SELECT tmp.match_id,
               MAX(tmp.runs_in_over) AS max_runs_in_over
        FROM (
            SELECT b.match_id,
                   b.over_id,
                   b.bowler,
                   SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
            FROM ball_by_ball AS b
            LEFT JOIN batsman_scored AS bs
              USING (match_id, over_id, ball_id, innings_no)
            LEFT JOIN extra_runs AS er
              USING (match_id, over_id, ball_id, innings_no)
            GROUP BY b.match_id, b.over_id, b.bowler
        ) AS tmp
        GROUP BY tmp.match_id
    ) AS m2
      ON o2.match_id = m2.match_id
     AND o2.runs_in_over = m2.max_runs_in_over
    ORDER BY o2.runs_in_over DESC
    LIMIT 10
) AS o
JOIN player AS p
  ON p.player_id = o.bowler
LIMIT 10;
```

```sql
-- 10) FINAL – Top 3 bowlers who conceded the most runs in the ‘worst’ over of each match
SELECT p.player_name   AS bowler_name,
       top.match_id,
       top.runs_in_over
FROM (
    SELECT o.match_id,
           o.bowler,
           o.runs_in_over
    FROM (
        SELECT b.match_id,
               b.over_id,
               b.bowler,
               SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          USING (match_id, over_id, ball_id, innings_no)
        LEFT JOIN extra_runs AS er
          USING (match_id, over_id, ball_id, innings_no)
        GROUP BY b.match_id, b.over_id, b.bowler
    ) AS o
    JOIN (
        SELECT tmp.match_id,
               MAX(tmp.runs_in_over) AS max_runs_in_over
        FROM (
            SELECT b.match_id,
                   b.over_id,
                   b.bowler,
                   SUM(COALESCE(bs.runs_scored, 0) + COALESCE(er.extra_runs, 0)) AS runs_in_over
            FROM ball_by_ball AS b
            LEFT JOIN batsman_scored AS bs
              USING (match_id, over_id, ball_id, innings_no)
            LEFT JOIN extra_runs AS er
              USING (match_id, over_id, ball_id, innings_no)
            GROUP BY b.match_id, b.over_id, b.bowler
        ) AS tmp
        GROUP BY tmp.match_id
    ) AS m
      ON o.match_id = m.match_id
     AND o.runs_in_over = m.max_runs_in_over
    ORDER BY o.runs_in_over DESC     -- greatest concessions first
    LIMIT 3                          -- keep only top 3 across all matches
) AS top
JOIN player AS p
  ON p.player_id = top.bowler;
```
