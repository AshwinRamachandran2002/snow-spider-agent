Query:
--Description: 
-- Corrected version of the “FINAL” query.  It gathers the total runs conceded by every
-- bowler in every over (over_runs), identifies the maximum-run over of each match
-- (match_max), filters to only those overs that equal that per-match maximum 
-- (worst_overs), then returns the three bowlers who conceded the most runs in any
-- such over, along with the match id and the runs conceded.
WITH over_runs AS (
    SELECT
        b.match_id,
        b.over_id,
        b.bowler,
        SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
           USING (match_id, over_id, ball_id, innings_no)
    LEFT JOIN extra_runs AS er
           USING (match_id, over_id, ball_id, innings_no)
    GROUP BY b.match_id, b.over_id, b.bowler
),
match_max AS (
    SELECT
        match_id,
        MAX(runs_in_over) AS max_runs_in_over
    FROM over_runs
    GROUP BY match_id
),
worst_overs AS (
    SELECT
        o.match_id,
        o.bowler,
        o.runs_in_over
    FROM over_runs o
    JOIN match_max m
      ON o.match_id      = m.match_id
     AND o.runs_in_over = m.max_runs_in_over
)
SELECT
    p.player_name AS bowler_name,
    w.match_id,
    w.runs_in_over
FROM worst_overs w
JOIN player p
  ON p.player_id = w.bowler
ORDER BY w.runs_in_over DESC
LIMIT 3
