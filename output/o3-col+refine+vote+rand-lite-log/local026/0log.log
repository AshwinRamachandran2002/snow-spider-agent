2025-05-05 04:29:53 - Thread-3241 (execute) - INFO - [Exploration]
Below are up-to-10 exploratory SQL statements, progressing from very basic inspections to the final query that returns the required result.  
(Each query is limited to 20 rows, uses DISTINCT where it makes sense, and adds a short description.)

```sql
-- 1. Peek at a few deliveries to understand the basic columns we’ll use
SELECT *
FROM ball_by_ball
LIMIT 20;
```

```sql
-- 2. Inspect how many runs a striker scored on some of those deliveries
SELECT DISTINCT b.match_id, b.over_id, b.ball_id, bs.runs_scored
FROM ball_by_ball AS b
LEFT JOIN batsman_scored AS bs
  ON b.match_id = bs.match_id
 AND b.over_id  = bs.over_id
 AND b.ball_id  = bs.ball_id
LIMIT 20;
```

```sql
-- 3. Inspect extra runs on the same deliveries
SELECT DISTINCT b.match_id, b.over_id, b.ball_id, er.extra_type, er.extra_runs
FROM ball_by_ball AS b
LEFT JOIN extra_runs AS er
  ON b.match_id = er.match_id
 AND b.over_id  = er.over_id
 AND b.ball_id  = er.ball_id
LIMIT 20;
```

```sql
-- 4. Compute total runs per ball (batsman + extras) for a small sample
SELECT b.match_id,
       b.over_id,
       b.ball_id,
       b.bowler,
       COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0) AS total_runs
FROM ball_by_ball AS b
LEFT JOIN batsman_scored AS bs
  ON b.match_id = bs.match_id
 AND b.over_id  = bs.over_id
 AND b.ball_id  = bs.ball_id
LEFT JOIN extra_runs AS er
  ON b.match_id = er.match_id
 AND b.over_id  = er.over_id
 AND b.ball_id  = er.ball_id
LIMIT 20;
```

```sql
-- 5. Aggregate to runs‐per‐over for a single match to verify logic
SELECT b.match_id,
       b.over_id,
       b.bowler,
       SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
FROM ball_by_ball AS b
LEFT JOIN batsman_scored AS bs
  ON b.match_id = bs.match_id
 AND b.over_id  = bs.over_id
 AND b.ball_id  = bs.ball_id
LEFT JOIN extra_runs AS er
  ON b.match_id = er.match_id
 AND b.over_id  = er.over_id
 AND b.ball_id  = er.ball_id
WHERE b.match_id = 335987                 -- example match
GROUP BY b.match_id, b.over_id, b.bowler
LIMIT 20;
```

```sql
-- 6. For every match, calculate runs conceded per over and pick the maximum-run over(s)
WITH over_runs AS (
    SELECT b.match_id,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
      ON b.match_id = bs.match_id
     AND b.over_id  = bs.over_id
     AND b.ball_id  = bs.ball_id
    LEFT JOIN extra_runs AS er
      ON b.match_id = er.match_id
     AND b.over_id  = er.over_id
     AND b.ball_id  = er.ball_id
    GROUP BY b.match_id, b.over_id, b.bowler
),
match_max AS (
    SELECT match_id, MAX(runs_in_over) AS max_runs_in_match
    FROM over_runs
    GROUP BY match_id
)
SELECT o.match_id,
       o.over_id,
       o.bowler,
       o.runs_in_over
FROM over_runs AS o
JOIN match_max  AS m
  ON o.match_id = m.match_id
 AND o.runs_in_over = m.max_runs_in_match
LIMIT 20;
```

```sql
-- 7. See how many such “max-run” overs a given bowler has (optional sanity check)
WITH max_overs AS (
    /* same CTEs as query 6 */
    WITH over_runs AS (
        SELECT b.match_id, b.over_id, b.bowler,
               SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          ON b.match_id = bs.match_id
         AND b.over_id  = bs.over_id
         AND b.ball_id  = bs.ball_id
        LEFT JOIN extra_runs AS er
          ON b.match_id = er.match_id
         AND b.over_id  = er.over_id
         AND b.ball_id  = er.ball_id
        GROUP BY b.match_id, b.over_id, b.bowler
    ),
    match_max AS (
        SELECT match_id, MAX(runs_in_over) AS max_runs_in_match
        FROM over_runs
        GROUP BY match_id
    )
    SELECT o.match_id, o.over_id, o.bowler, o.runs_in_over
    FROM over_runs AS o
    JOIN match_max  AS m
      ON o.match_id = m.match_id
     AND o.runs_in_over = m.max_runs_in_match
)
SELECT bowler, COUNT(*) AS times_bowler_in_max_over
FROM max_overs
GROUP BY bowler
ORDER BY times_bowler_in_max_over DESC
LIMIT 20;
```

```sql
-- 8. Identify the single worst such over for every bowler
WITH over_runs AS (
    SELECT b.match_id,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
      ON b.match_id = bs.match_id
     AND b.over_id  = bs.over_id
     AND b.ball_id  = bs.ball_id
    LEFT JOIN extra_runs AS er
      ON b.match_id = er.match_id
     AND b.over_id  = er.over_id
     AND b.ball_id  = er.ball_id
    GROUP BY b.match_id, b.over_id, b.bowler
),
match_max AS (
    SELECT match_id, MAX(runs_in_over) AS max_runs_in_match
    FROM over_runs
    GROUP BY match_id
),
bowler_worst AS (
    SELECT o.bowler,
           MAX(o.runs_in_over) AS worst_runs_conceded
    FROM over_runs AS o
    JOIN match_max  AS m
      ON o.match_id = m.match_id
     AND o.runs_in_over = m.max_runs_in_match
    GROUP BY o.bowler
)
SELECT *
FROM bowler_worst
ORDER BY worst_runs_conceded DESC
LIMIT 20;
```

```sql
-- 9. Get the top-3 bowlers along with the exact match where each conceded their worst (ties kept)
WITH over_runs AS (
    SELECT b.match_id,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
    FROM ball_by_ball AS b
    LEFT JOIN batsman_scored AS bs
      ON b.match_id = bs.match_id
     AND b.over_id  = bs.over_id
     AND b.ball_id  = bs.ball_id
    LEFT JOIN extra_runs AS er
      ON b.match_id = er.match_id
     AND b.over_id  = er.over_id
     AND b.ball_id  = er.ball_id
    GROUP BY b.match_id, b.over_id, b.bowler
),
match_max AS (
    SELECT match_id, MAX(runs_in_over) AS max_runs_in_match
    FROM over_runs
    GROUP BY match_id
),
max_overs AS (
    SELECT o.*
    FROM over_runs AS o
    JOIN match_max  AS m
      ON o.match_id = m.match_id
     AND o.runs_in_over = m.max_runs_in_match
),
bowler_worst AS (
    SELECT bowler,
           MAX(runs_in_over) AS worst_runs_conceded
    FROM max_overs
    GROUP BY bowler
),
top3 AS (
    SELECT bowler, worst_runs_conceded
    FROM bowler_worst
    ORDER BY worst_runs_conceded DESC
    LIMIT 3
)
SELECT p.player_name      AS bowler_name,
       t3.worst_runs_conceded,
       m.match_id,
       m.over_id
FROM top3                AS t3
JOIN max_overs           AS m
  ON m.bowler = t3.bowler
 AND m.runs_in_over = t3.worst_runs_conceded
JOIN player              AS p
  ON p.player_id = t3.bowler
ORDER BY t3.worst_runs_conceded DESC;
```

```sql
-- 10. (Optional) Also show opponent & date for those three performances
SELECT res.bowler_name,
       res.worst_runs_conceded,
       tm.name         AS match_winner_team,
       mt.match_date,
       res.match_id,
       res.over_id
FROM (
    /* query 9 repeated as an inline view */
    WITH over_runs AS (
        SELECT b.match_id,
               b.over_id,
               b.bowler,
               SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          ON b.match_id = bs.match_id
         AND b.over_id  = bs.over_id
         AND b.ball_id  = bs.ball_id
        LEFT JOIN extra_runs AS er
          ON b.match_id = er.match_id
         AND b.over_id  = er.over_id
         AND b.ball_id  = er.ball_id
        GROUP BY b.match_id, b.over_id, b.bowler
    ),
    match_max AS (
        SELECT match_id, MAX(runs_in_over) AS max_runs_in_match
        FROM over_runs
        GROUP BY match_id
    ),
    max_overs AS (
        SELECT o.*
        FROM over_runs AS o
        JOIN match_max  AS m
          ON o.match_id = m.match_id
         AND o.runs_in_over = m.max_runs_in_match
    ),
    bowler_worst AS (
        SELECT bowler,
               MAX(runs_in_over) AS worst_runs_conceded
        FROM max_overs
        GROUP BY bowler
    ),
    top3 AS (
        SELECT bowler, worst_runs_conceded
        FROM bowler_worst
        ORDER BY worst_runs_conceded DESC
        LIMIT 3
    )
    SELECT p.player_name AS bowler_name,
           t3.worst_runs_conceded,
           m.match_id,
           m.over_id
    FROM top3       AS t3
    JOIN max_overs  AS m
      ON m.bowler = t3.bowler
     AND m.runs_in_over = t3.worst_runs_conceded
    JOIN player     AS p
      ON p.player_id = t3.bowler
) AS res
LEFT JOIN match AS mt
  ON mt.match_id = res.match_id
LEFT JOIN team  AS tm
  ON tm.team_id = mt.match_winner
ORDER BY res.worst_runs_conceded DESC;
```

These queries build up the logic step-by-step and finally return the top-3 bowlers (with their names, runs conceded, match id, and over id) who, in the highest-run overs of each match, allowed the most runs in a single over across all matches.
