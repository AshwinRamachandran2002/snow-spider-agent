-- 10. (Optional) Also show opponent & date for those three performances
SELECT res.bowler_name,
       res.worst_runs_conceded,
       tm.name         AS match_winner_team,
       mt.match_date,
       res.match_id,
       res.over_id
FROM (
    /* query 9 repeated as an inline view */
    WITH over_runs AS (
        SELECT b.match_id,
               b.over_id,
               b.bowler,
               SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS runs_in_over
        FROM ball_by_ball AS b
        LEFT JOIN batsman_scored AS bs
          ON b.match_id = bs.match_id
         AND b.over_id  = bs.over_id
         AND b.ball_id  = bs.ball_id
        LEFT JOIN extra_runs AS er
          ON b.match_id = er.match_id
         AND b.over_id  = er.over_id
         AND b.ball_id  = er.ball_id
        GROUP BY b.match_id, b.over_id, b.bowler
    ),
    match_max AS (
        SELECT match_id, MAX(runs_in_over) AS max_runs_in_match
        FROM over_runs
        GROUP BY match_id
    ),
    max_overs AS (
        SELECT o.*
        FROM over_runs AS o
        JOIN match_max  AS m
          ON o.match_id = m.match_id
         AND o.runs_in_over = m.max_runs_in_match
    ),
    bowler_worst AS (
        SELECT bowler,
               MAX(runs_in_over) AS worst_runs_conceded
        FROM max_overs
        GROUP BY bowler
    ),
    top3 AS (
        SELECT bowler, worst_runs_conceded
        FROM bowler_worst
        ORDER BY worst_runs_conceded DESC
        LIMIT 3
    )
    SELECT p.player_name AS bowler_name,
           t3.worst_runs_conceded,
           m.match_id,
           m.over_id
    FROM top3       AS t3
    JOIN max_overs  AS m
      ON m.bowler = t3.bowler
     AND m.runs_in_over = t3.worst_runs_conceded
    JOIN player     AS p
      ON p.player_id = t3.bowler
) AS res
LEFT JOIN match AS mt
  ON mt.match_id = res.match_id
LEFT JOIN team  AS tm
  ON tm.team_id = mt.match_winner
ORDER BY res.worst_runs_conceded DESC;
