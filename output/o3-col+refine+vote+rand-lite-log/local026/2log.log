```sql
-- 1. Inspect a few deliveries to see bowler information
SELECT DISTINCT "match_id", "over_id", "innings_no", "bowler"
FROM "ball_by_ball"
LIMIT 20;

-- 2. Inspect batsman-scored runs that will be charged to the bowler
SELECT DISTINCT "match_id", "over_id", "ball_id", "runs_scored", "innings_no"
FROM "batsman_scored"
LIMIT 20;

-- 3. Inspect extra runs; these can add to the runs conceded in an over
SELECT DISTINCT "match_id", "over_id", "ball_id",
       "extra_type", "extra_runs", "innings_no"
FROM "extra_runs"
LIMIT 20;

-- 4. Compute total runs conceded by every bowler in every over
SELECT  bb."match_id",
        bb."over_id",
        bb."innings_no",
        bb."bowler",
        SUM(bs."runs_scored")                       AS "batsman_runs",
        SUM(COALESCE(er."extra_runs",0))            AS "extra_runs",
        SUM(bs."runs_scored")+SUM(COALESCE(er."extra_runs",0)) AS "total_runs"
FROM   "ball_by_ball"  AS bb
LEFT   JOIN "batsman_scored" AS bs
       ON  bb."match_id" = bs."match_id"
       AND bb."over_id"  = bs."over_id"
       AND bb."ball_id"  = bs."ball_id"
       AND bb."innings_no" = bs."innings_no"
LEFT   JOIN "extra_runs"     AS er
       ON  bb."match_id" = er."match_id"
       AND bb."over_id"  = er."over_id"
       AND bb."ball_id"  = er."ball_id"
       AND bb."innings_no" = er."innings_no"
GROUP  BY bb."match_id", bb."over_id", bb."innings_no", bb."bowler"
LIMIT 20;

-- 5. For every match, find the maximum runs conceded in any single over
WITH over_runs AS (
       SELECT  bb."match_id",
               bb."over_id",
               bb."innings_no",
               bb."bowler",
               SUM(bs."runs_scored")+SUM(COALESCE(er."extra_runs",0)) AS "total_runs"
       FROM   "ball_by_ball"  AS bb
       LEFT   JOIN "batsman_scored" AS bs
              ON bb."match_id"=bs."match_id"
             AND bb."over_id" =bs."over_id"
             AND bb."ball_id" =bs."ball_id"
             AND bb."innings_no"=bs."innings_no"
       LEFT   JOIN "extra_runs"     AS er
              ON bb."match_id"=er."match_id"
             AND bb."over_id" =er."over_id"
             AND bb."ball_id" =er."ball_id"
             AND bb."innings_no"=er."innings_no"
       GROUP  BY bb."match_id", bb."over_id", bb."innings_no", bb."bowler"
)
SELECT  "match_id", MAX("total_runs") AS "max_runs_in_match"
FROM    over_runs
GROUP  BY "match_id"
LIMIT 20;

-- 6. Isolate only those overs that are the costliest (max-runs) in their match
WITH over_runs AS (
       SELECT  bb."match_id", bb."over_id", bb."innings_no", bb."bowler",
               SUM(bs."runs_scored")+SUM(COALESCE(er."extra_runs",0)) AS "total_runs"
       FROM   "ball_by_ball"  AS bb
       LEFT   JOIN "batsman_scored" AS bs
              ON bb."match_id"=bs."match_id"
             AND bb."over_id" =bs."over_id"
             AND bb."ball_id" =bs."ball_id"
             AND bb."innings_no"=bs."innings_no"
       LEFT   JOIN "extra_runs"     AS er
              ON bb."match_id"=er."match_id"
             AND bb."over_id" =er."over_id"
             AND bb."ball_id" =er."ball_id"
             AND bb."innings_no"=er."innings_no"
       GROUP  BY bb."match_id", bb."over_id", bb."innings_no", bb."bowler"
),
max_runs AS (
       SELECT "match_id", MAX("total_runs") AS "max_runs"
       FROM   over_runs
       GROUP  BY "match_id"
)
SELECT  o."match_id", o."over_id", o."innings_no", o."bowler", o."total_runs"
FROM    over_runs AS o
JOIN    max_runs  AS m
   ON   o."match_id" = m."match_id"
  AND   o."total_runs" = m."max_runs"
LIMIT 20;

-- 7. Rank these costliest overs across all matches by runs conceded
WITH over_runs AS (
       SELECT  bb."match_id", bb."over_id", bb."innings_no", bb."bowler",
               SUM(bs."runs_scored")+SUM(COALESCE(er."extra_runs",0)) AS "total_runs"
       FROM   "ball_by_ball"  AS bb
       LEFT   JOIN "batsman_scored" AS bs
              ON bb."match_id"=bs."match_id"
             AND bb."over_id" =bs."over_id"
             AND bb."ball_id" =bs."ball_id"
             AND bb."innings_no"=bs."innings_no"
       LEFT   JOIN "extra_runs"     AS er
              ON bb."match_id"=er."match_id"
             AND bb."over_id" =er."over_id"
             AND bb."ball_id" =er."ball_id"
             AND bb."innings_no"=er."innings_no"
       GROUP  BY bb."match_id", bb."over_id", bb."innings_no", bb."bowler"
),
max_runs AS (
       SELECT "match_id", MAX("total_runs") AS "max_runs"
       FROM   over_runs
       GROUP  BY "match_id"
),
costliest_overs AS (
       SELECT  o.*
       FROM    over_runs AS o
       JOIN    max_runs  AS m
         ON    o."match_id" = m."match_id"
        AND    o."total_runs" = m."max_runs"
)
SELECT *
FROM   costliest_overs
ORDER BY "total_runs" DESC
LIMIT 20;

-- 8. Pick the top 3 most expensive overs (bowler + match)
WITH over_runs AS (
       SELECT  bb."match_id", bb."over_id", bb."innings_no", bb."bowler",
               SUM(bs."runs_scored")+SUM(COALESCE(er."extra_runs",0)) AS "total_runs"
       FROM   "ball_by_ball"  AS bb
       LEFT   JOIN "batsman_scored" AS bs
              ON bb."match_id"=bs."match_id"
             AND bb."over_id" =bs."over_id"
             AND bb."ball_id" =bs."ball_id"
             AND bb."innings_no"=bs."innings_no"
       LEFT   JOIN "extra_runs"     AS er
              ON bb."match_id"=er."match_id"
             AND bb."over_id" =er."over_id"
             AND bb."ball_id" =er."ball_id"
             AND bb."innings_no"=er."innings_no"
       GROUP  BY bb."match_id", bb."over_id", bb."innings_no", bb."bowler"
),
max_runs AS (
       SELECT "match_id", MAX("total_runs") AS "max_runs"
       FROM   over_runs
       GROUP  BY "match_id"
),
costliest_overs AS (
       SELECT  o.*
       FROM    over_runs AS o
       JOIN    max_runs  AS m
         ON    o."match_id" = m."match_id"
        AND    o."total_runs" = m."max_runs"
)
SELECT  p."player_name"          AS "bowler_name",
        c."match_id",
        c."total_runs"
FROM    costliest_overs AS c
JOIN    "player"        AS p
   ON   p."player_id" = c."bowler"
ORDER  BY c."total_runs" DESC
LIMIT 3;
```
