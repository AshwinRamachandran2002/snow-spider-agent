        bb."over_id",
        bb."innings_no",
        bb."bowler",
        SUM(bs."runs_scored")                       AS "batsman_runs",
        SUM(COALESCE(er."extra_runs",0))            AS "extra_runs",
        SUM(bs."runs_scored")+SUM(COALESCE(er."extra_runs",0)) AS "total_runs"
