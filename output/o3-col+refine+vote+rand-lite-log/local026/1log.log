```sql
-- 4) Compute total runs conceded per delivery for ONE match (illustrative)
SELECT bb."match_id",
       bb."over_id",
       bb."ball_id",
       bb."bowler",
       COALESCE(bs."runs_scored", 0) +
       COALESCE(er."extra_runs", 0)   AS "total_runs"
FROM   "ball_by_ball"  AS bb
LEFT  JOIN "batsman_scored" AS bs
       ON  bs."match_id" = bb."match_id"
       AND bs."over_id"  = bb."over_id"
       AND bs."ball_id"  = bb."ball_id"
       AND bs."innings_no" = bb."innings_no"
LEFT  JOIN "extra_runs"     AS er
       ON  er."match_id" = bb."match_id"
       AND er."over_id"  = bb."over_id"
       AND er."ball_id"  = bb."ball_id"
       AND er."innings_no" = bb."innings_no"
WHERE  bb."match_id" = 335987
LIMIT 20;
```

```sql
-- 5) Runs conceded PER OVER by each bowler for the same sample match
SELECT bb."match_id",
       bb."bowler",
       bb."over_id",
       SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
FROM   "ball_by_ball" AS bb
LEFT  JOIN "batsman_scored" AS bs
       ON  bs."match_id" = bb."match_id"
       AND bs."over_id"  = bb."over_id"
       AND bs."ball_id"  = bb."ball_id"
       AND bs."innings_no" = bb."innings_no"
LEFT  JOIN "extra_runs" AS er
       ON  er."match_id" = bb."match_id"
       AND er."over_id"  = bb."over_id"
       AND er."ball_id"  = bb."ball_id"
       AND er."innings_no" = bb."innings_no"
WHERE  bb."match_id" = 335987
GROUP  BY bb."match_id", bb."bowler", bb."over_id"
ORDER  BY "runs_in_over" DESC
LIMIT 20;
```

```sql
-- 6) Runs conceded PER OVER by each bowler across ALL matches
SELECT bb."match_id",
       bb."bowler",
       bb."over_id",
       SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
FROM   "ball_by_ball" AS bb
LEFT  JOIN "batsman_scored" AS bs
       ON  bs."match_id" = bb."match_id"
       AND bs."over_id"  = bb."over_id"
       AND bs."ball_id"  = bb."ball_id"
       AND bs."innings_no" = bb."innings_no"
LEFT  JOIN "extra_runs" AS er
       ON  er."match_id" = bb."match_id"
       AND er."over_id"  = bb."over_id"
       AND er."ball_id"  = bb."ball_id"
       AND er."innings_no" = bb."innings_no"
GROUP  BY bb."match_id", bb."bowler", bb."over_id"
ORDER  BY "runs_in_over" DESC
LIMIT 20;
```

```sql
-- 7) For every match, find the MAXIMUM runs conceded in any single over
WITH over_runs AS (
    SELECT bb."match_id",
           bb."over_id",
           bb."bowler",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
    FROM   "ball_by_ball" AS bb
    LEFT  JOIN "batsman_scored" AS bs
           ON  bs."match_id" = bb."match_id"
           AND bs."over_id"  = bb."over_id"
           AND bs."ball_id"  = bb."ball_id"
           AND bs."innings_no" = bb."innings_no"
    LEFT  JOIN "extra_runs" AS er
           ON  er."match_id" = bb."match_id"
           AND er."over_id"  = bb."over_id"
           AND er."ball_id"  = bb."ball_id"
           AND er."innings_no" = bb."innings_no"
    GROUP  BY bb."match_id", bb."over_id", bb."bowler"
)
SELECT "match_id",
       MAX("runs_in_over") AS "max_runs_in_match"
FROM   over_runs
GROUP  BY "match_id"
LIMIT 20;
```

```sql
-- 8) Keep ONLY those overs in each match that actually had the maximum runs
WITH over_runs AS (
    SELECT bb."match_id",
           bb."over_id",
           bb."bowler",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
    FROM   "ball_by_ball" AS bb
    LEFT  JOIN "batsman_scored" AS bs
           ON  bs."match_id" = bb."match_id"
           AND bs."over_id"  = bb."over_id"
           AND bs."ball_id"  = bb."ball_id"
           AND bs."innings_no" = bb."innings_no"
    LEFT  JOIN "extra_runs" AS er
           ON  er."match_id" = bb."match_id"
           AND er."over_id"  = bb."over_id"
           AND er."ball_id"  = bb."ball_id"
           AND er."innings_no" = bb."innings_no"
    GROUP  BY bb."match_id", bb."over_id", bb."bowler"
), match_max AS (
    SELECT "match_id",
           MAX("runs_in_over") AS "max_runs_in_match"
    FROM   over_runs
    GROUP  BY "match_id"
)
SELECT o."match_id",
       o."over_id",
       o."bowler",
       o."runs_in_over"
FROM   over_runs AS o
JOIN   match_max AS m
       ON m."match_id"        = o."match_id"
      AND m."max_runs_in_match" = o."runs_in_over"
ORDER  BY o."runs_in_over" DESC
LIMIT 20;
```

```sql
-- 9) Same as above but add bowler names for readability
WITH over_runs AS (
    SELECT bb."match_id",
           bb."over_id",
           bb."bowler",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
    FROM   "ball_by_ball" AS bb
    LEFT  JOIN "batsman_scored" AS bs
           ON  bs."match_id" = bb."match_id"
           AND bs."over_id"  = bb."over_id"
           AND bs."ball_id"  = bb."ball_id"
           AND bs."innings_no" = bb."innings_no"
    LEFT  JOIN "extra_runs" AS er
           ON  er."match_id" = bb."match_id"
           AND er."over_id"  = bb."over_id"
           AND er."ball_id"  = bb."ball_id"
           AND er."innings_no" = bb."innings_no"
    GROUP  BY bb."match_id", bb."over_id", bb."bowler"
), match_max AS (
    SELECT "match_id",
           MAX("runs_in_over") AS "max_runs_in_match"
    FROM   over_runs
    GROUP  BY "match_id"
), filtered AS (
    SELECT o.*
    FROM   over_runs AS o
    JOIN   match_max AS m
           ON m."match_id" = o."match_id"
          AND m."max_runs_in_match" = o."runs_in_over"
)
SELECT f."match_id",
       f."over_id",
       f."bowler",
       p."player_name",
       f."runs_in_over"
FROM   filtered AS f
JOIN   "player" AS p
       ON p."player_id" = f."bowler"
ORDER  BY f."runs_in_over" DESC
LIMIT 20;
```

```sql
-- 10) FINAL: Top-3 bowlers (with match) who conceded the MOST runs
--      in an over that was the costliest for its match
WITH over_runs AS (
    SELECT bb."match_id",
           bb."over_id",
           bb."bowler",
           SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "runs_in_over"
    FROM   "ball_by_ball" AS bb
    LEFT  JOIN "batsman_scored" AS bs
           ON  bs."match_id" = bb."match_id"
           AND bs."over_id"  = bb."over_id"
           AND bs."ball_id"  = bb."ball_id"
           AND bs."innings_no" = bb."innings_no"
    LEFT  JOIN "extra_runs" AS er
           ON  er."match_id" = bb."match_id"
           AND er."over_id"  = bb."over_id"
           AND er."ball_id"  = bb."ball_id"
           AND er."innings_no" = bb."innings_no"
    GROUP  BY bb."match_id", bb."over_id", bb."bowler"
), match_max AS (
    SELECT "match_id",
           MAX("runs_in_over") AS "max_runs_in_match"
    FROM   over_runs
    GROUP  BY "match_id"
), filtered AS (
    SELECT o.*
    FROM   over_runs AS o
    JOIN   match_max AS m
           ON m."match_id" = o."match_id"
          AND m."max_runs_in_match" = o."runs_in_over"
)
SELECT f."bowler"       AS "bowler_id",
       p."player_name",
       f."match_id",
       f."runs_in_over" AS "runs_conceded_in_that_over"
FROM   filtered AS f
JOIN   "player" AS p
       ON p."player_id" = f."bowler"
ORDER  BY f."runs_in_over" DESC
LIMIT 3;               -- top 3 bowlers
```
