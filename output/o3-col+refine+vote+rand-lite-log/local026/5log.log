```sql
--Description: Find the top-3 most expensive overs ever bowled, but ONLY among those
--             overs that were already the costliest within their respective matches.
--             Steps inside CTEs:
--             1) over_runs  – total runs (batsman + extras) conceded by each bowler
--                in every over of every match.
--             2) match_max  – for each match, the single-over run maximum.
--             3) worst_overs – overs whose total equals that match maximum.
--             Final SELECT joins to player to show bowler names, orders by runs,
--             and returns the three biggest values.
WITH over_runs AS (
    SELECT  bb.match_id,
            bb.over_id,
            bb.innings_no,
            bb.bowler,
            SUM( COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0) ) AS over_total_runs
    FROM   ball_by_ball AS bb
    LEFT   JOIN batsman_scored AS bs
           ON  bs.match_id   = bb.match_id
           AND bs.over_id    = bb.over_id
           AND bs.ball_id    = bb.ball_id
           AND bs.innings_no = bb.innings_no
    LEFT   JOIN extra_runs AS er
           ON  er.match_id   = bb.match_id
           AND er.over_id    = bb.over_id
           AND er.ball_id    = bb.ball_id
           AND er.innings_no = bb.innings_no
    GROUP  BY bb.match_id, bb.over_id, bb.innings_no, bb.bowler
),
match_max AS (
    SELECT  match_id,
            MAX(over_total_runs) AS match_max_runs
    FROM    over_runs
    GROUP   BY match_id
),
worst_overs AS (
    SELECT  o.*
    FROM    over_runs AS o
    JOIN    match_max AS m
      ON    m.match_id       = o.match_id
     AND    m.match_max_runs = o.over_total_runs
)
SELECT  p.player_name AS bowler_name,
        w.match_id,
        w.over_total_runs
FROM    worst_overs AS w
JOIN    player      AS p ON p.player_id = w.bowler
ORDER BY w.over_total_runs DESC
LIMIT 3;
```
