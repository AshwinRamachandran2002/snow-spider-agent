```sql
-- 5) Compute TOTAL runs conceded on every SINGLE BALL  
--    (batsman runs + any extras)
SELECT DISTINCT bb.match_id,
                bb.over_id,
                bb.ball_id,
                bb.innings_no,
                bb.bowler,
                ( COALESCE(bs.runs_scored,0)
                + COALESCE(er.extra_runs ,0) ) AS ball_total_runs
FROM   ball_by_ball    AS bb
LEFT   JOIN batsman_scored AS bs
       ON  bs.match_id   = bb.match_id
       AND bs.over_id    = bb.over_id
       AND bs.ball_id    = bb.ball_id
       AND bs.innings_no = bb.innings_no
LEFT   JOIN extra_runs     AS er
       ON  er.match_id   = bb.match_id
       AND er.over_id    = bb.over_id
       AND er.ball_id    = bb.ball_id
       AND er.innings_no = bb.innings_no
LIMIT 20;
```

```sql
-- 6) Aggregate the previous result to RUNS PER OVER for every bowler
SELECT DISTINCT match_id,
                over_id,
                innings_no,
                bowler,
                SUM( COALESCE(bs.runs_scored,0)
                  + COALESCE(er.extra_runs ,0) )  AS over_total_runs
FROM   ball_by_ball    AS bb
LEFT   JOIN batsman_scored AS bs
       ON  bs.match_id   = bb.match_id
       AND bs.over_id    = bb.over_id
       AND bs.ball_id    = bb.ball_id
       AND bs.innings_no = bb.innings_no
LEFT   JOIN extra_runs     AS er
       ON  er.match_id   = bb.match_id
       AND er.over_id    = bb.over_id
       AND er.ball_id    = bb.ball_id
       AND er.innings_no = bb.innings_no
GROUP  BY match_id, over_id, innings_no, bowler
LIMIT 20;
```

```sql
-- 7) For every MATCH, find what the MAXIMUM runs conceded  
--    in ANY over of that match was
WITH over_runs AS (
  SELECT match_id,
         over_id,
         innings_no,
         bowler,
         SUM( COALESCE(bs.runs_scored,0)
           + COALESCE(er.extra_runs ,0) ) AS over_total_runs
  FROM   ball_by_ball AS bb
  LEFT   JOIN batsman_scored AS bs
         ON  bs.match_id   = bb.match_id
         AND bs.over_id    = bb.over_id
         AND bs.ball_id    = bb.ball_id
         AND bs.innings_no = bb.innings_no
  LEFT   JOIN extra_runs     AS er
         ON  er.match_id   = bb.match_id
         AND er.over_id    = bb.over_id
         AND er.ball_id    = bb.ball_id
         AND er.innings_no = bb.innings_no
  GROUP  BY match_id, over_id, innings_no, bowler
)
SELECT DISTINCT match_id,
                MAX(over_total_runs) AS match_max_runs_in_an_over
FROM   over_runs
GROUP  BY match_id
LIMIT 20;
```

```sql
-- 8) Keep ONLY the overs that actually achieved the “match-max” figure
WITH over_runs AS (
  SELECT match_id,
         over_id,
         innings_no,
         bowler,
         SUM( COALESCE(bs.runs_scored,0)
           + COALESCE(er.extra_runs ,0) ) AS over_total_runs
  FROM   ball_by_ball AS bb
  LEFT   JOIN batsman_scored AS bs
         ON  bs.match_id   = bb.match_id
         AND bs.over_id    = bb.over_id
         AND bs.ball_id    = bb.ball_id
         AND bs.innings_no = bb.innings_no
  LEFT   JOIN extra_runs     AS er
         ON  er.match_id   = bb.match_id
         AND er.over_id    = bb.over_id
         AND er.ball_id    = bb.ball_id
         AND er.innings_no = bb.innings_no
  GROUP  BY match_id, over_id, innings_no, bowler
),
match_max AS (
  SELECT match_id,
         MAX(over_total_runs) AS match_max_runs_in_an_over
  FROM   over_runs
  GROUP  BY match_id
)
SELECT DISTINCT o.match_id,
                o.over_id,
                o.innings_no,
                o.bowler,
                o.over_total_runs
FROM   over_runs  AS o
JOIN   match_max  AS m
  ON   m.match_id = o.match_id
 AND   m.match_max_runs_in_an_over = o.over_total_runs
LIMIT 20;
```

```sql
-- 9) Rank those “worst” overs across ALL matches  
--    and see who gave away the most in a single over
WITH over_runs AS (
  SELECT match_id,
         over_id,
         innings_no,
         bowler,
         SUM( COALESCE(bs.runs_scored,0)
           + COALESCE(er.extra_runs ,0) ) AS over_total_runs
  FROM   ball_by_ball AS bb
  LEFT   JOIN batsman_scored AS bs
         ON  bs.match_id   = bb.match_id
         AND bs.over_id    = bb.over_id
         AND bs.ball_id    = bb.ball_id
         AND bs.innings_no = bb.innings_no
  LEFT   JOIN extra_runs     AS er
         ON  er.match_id   = bb.match_id
         AND er.over_id    = bb.over_id
         AND er.ball_id    = bb.ball_id
         AND er.innings_no = bb.innings_no
  GROUP  BY match_id, over_id, innings_no, bowler
),
match_max AS (
  SELECT match_id,
         MAX(over_total_runs) AS match_max_runs_in_an_over
  FROM   over_runs
  GROUP  BY match_id
),
worst_overs AS (
  SELECT o.*
  FROM   over_runs  AS o
  JOIN   match_max  AS m
    ON   m.match_id = o.match_id
   AND   m.match_max_runs_in_an_over = o.over_total_runs
)
SELECT DISTINCT w.match_id,
                w.bowler,
                w.over_total_runs
FROM   worst_overs AS w
ORDER  BY w.over_total_runs DESC
LIMIT 20;
```

```sql
-- 10) FINAL ANSWER:  top-3 bowlers (with their names) who conceded the 
--     highest runs in an over that was ALSO the worst over of that match
WITH over_runs AS (
  SELECT match_id,
         over_id,
         innings_no,
         bowler,
         SUM( COALESCE(bs.runs_scored,0)
           + COALESCE(er.extra_runs ,0) ) AS over_total_runs
  FROM   ball_by_ball AS bb
  LEFT   JOIN batsman_scored AS bs
         ON  bs.match_id   = bb.match_id
         AND bs.over_id    = bb.over_id
         AND bs.ball_id    = bb.ball_id
         AND bs.innings_no = bb.innings_no
  LEFT   JOIN extra_runs     AS er
         ON  er.match_id   = bb.match_id
         AND er.over_id    = bb.over_id
         AND er.ball_id    = bb.ball_id
         AND er.innings_no = bb.innings_no
  GROUP  BY match_id, over_id, innings_no, bowler
),
match_max AS (
  SELECT match_id,
         MAX(over_total_runs) AS match_max_runs_in_an_over
  FROM   over_runs
  GROUP  BY match_id
),
worst_overs AS (
  SELECT o.*
  FROM   over_runs  AS o
  JOIN   match_max  AS m
    ON   m.match_id = o.match_id
   AND   m.match_max_runs_in_an_over = o.over_total_runs
)
SELECT DISTINCT p.player_name      AS bowler_name,
                w.match_id,
                w.over_total_runs
FROM   worst_overs AS w
JOIN   player      AS p  ON p.player_id = w.bowler
ORDER  BY w.over_total_runs DESC
LIMIT 3;
```
