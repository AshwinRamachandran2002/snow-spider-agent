```sql
-- 1. See a few deliveries to understand the linkage between match, over, ball and bowler
SELECT DISTINCT "match_id", "over_id", "ball_id", "bowler"
FROM "ball_by_ball"
LIMIT 20;
```

```sql
-- 2. Inspect how many runs a striker scores on a delivery
SELECT DISTINCT "match_id", "over_id", "ball_id", "runs_scored"
FROM "batsman_scored"
LIMIT 20;
```

```sql
-- 3. Inspect extra–runs that can add to the total runs of a delivery
SELECT DISTINCT "match_id", "over_id", "ball_id", "extra_type", "extra_runs"
FROM "extra_runs"
LIMIT 20;
```

```sql
-- 4. Combine the three tables to calculate total-runs per delivery
SELECT  b."match_id",
        b."over_id",
        b."ball_id",
        b."bowler",
        COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) AS "total_runs"
FROM      "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
LIMIT 20;
```

```sql
-- 5. Aggregate the delivery data to get runs conceded in every over by every bowler
SELECT  b."match_id",
        b."over_id",
        b."bowler",
        SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "over_runs"
FROM      "ball_by_ball" AS b
LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
GROUP BY  b."match_id", b."over_id", b."bowler"
LIMIT 20;
```

```sql
-- 6. For each match, find the maximum runs conceded in any single over
WITH over_totals AS (
    SELECT  b."match_id",
            b."over_id",
            b."bowler",
            SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "over_runs"
    FROM      "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
    LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
    GROUP BY  b."match_id", b."over_id", b."bowler"
)
SELECT DISTINCT "match_id", MAX("over_runs") AS "max_over_runs"
FROM   over_totals
GROUP BY "match_id"
LIMIT 20;
```

```sql
-- 7. Identify the overs that actually reached those per-match maxima
WITH over_totals AS (
    SELECT  b."match_id",
            b."over_id",
            b."bowler",
            SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "over_runs"
    FROM      "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
    LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
    GROUP BY  b."match_id", b."over_id", b."bowler"
),
max_per_match AS (
    SELECT  "match_id", MAX("over_runs") AS "max_runs"
    FROM    over_totals
    GROUP BY "match_id"
)
SELECT ot."match_id", ot."over_id", ot."bowler", ot."over_runs"
FROM   over_totals AS ot
JOIN   max_per_match AS mm
       ON ot."match_id" = mm."match_id"
      AND ot."over_runs" = mm."max_runs"
LIMIT 20;
```

```sql
-- 8. Bring in the bowler’s name for easier interpretation
WITH over_totals AS (
    SELECT  b."match_id",
            b."over_id",
            b."bowler",
            SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "over_runs"
    FROM      "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
    LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
    GROUP BY  b."match_id", b."over_id", b."bowler"
),
max_per_match AS (
    SELECT  "match_id", MAX("over_runs") AS "max_runs"
    FROM    over_totals
    GROUP BY "match_id"
),
max_overs AS (
    SELECT ot.*
    FROM   over_totals AS ot
    JOIN   max_per_match AS mm
           ON ot."match_id" = mm."match_id"
          AND ot."over_runs" = mm."max_runs"
)
SELECT  mo."match_id",
        mo."over_id",
        p."player_name"     AS "bowler_name",
        mo."over_runs"
FROM   max_overs AS mo
JOIN   "player"  AS p
       ON p."player_id" = mo."bowler"
LIMIT 20;
```

```sql
-- 9. Rank all such ‘maximum-overs’ across the entire league by runs conceded
WITH over_totals AS (
    SELECT  b."match_id",
            b."over_id",
            b."bowler",
            SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "over_runs"
    FROM      "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
    LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
    GROUP BY  b."match_id", b."over_id", b."bowler"
),
max_per_match AS (
    SELECT  "match_id", MAX("over_runs") AS "max_runs"
    FROM    over_totals
    GROUP BY "match_id"
),
max_overs AS (
    SELECT ot.*
    FROM   over_totals AS ot
    JOIN   max_per_match AS mm
           ON ot."match_id" = mm."match_id"
          AND ot."over_runs" = mm."max_runs"
)
SELECT  p."player_name"     AS "bowler_name",
        mo."match_id",
        mo."over_runs"
FROM   max_overs AS mo
JOIN   "player" AS p
       ON p."player_id" = mo."bowler"
ORDER BY mo."over_runs" DESC
LIMIT 20;
```

```sql
-- 10. Finally, show the top-3 bowlers who conceded the most runs in one such ‘maximum’ over
WITH over_totals AS (
    SELECT  b."match_id",
            b."over_id",
            b."bowler",
            SUM( COALESCE(bs."runs_scored",0) + COALESCE(er."extra_runs",0) ) AS "over_runs"
    FROM      "ball_by_ball" AS b
    LEFT JOIN "batsman_scored" AS bs USING ("match_id","over_id","ball_id")
    LEFT JOIN "extra_runs"     AS er USING ("match_id","over_id","ball_id")
    GROUP BY  b."match_id", b."over_id", b."bowler"
),
max_per_match AS (
    SELECT  "match_id", MAX("over_runs") AS "max_runs"
    FROM    over_totals
    GROUP BY "match_id"
),
max_overs AS (
    SELECT ot.*
    FROM   over_totals AS ot
    JOIN   max_per_match AS mm
           ON ot."match_id" = mm."match_id"
          AND ot."over_runs" = mm."max_runs"
)
SELECT  p."player_name"     AS "bowler_name",
        mo."match_id",
        mo."over_runs"      AS "runs_in_over"
FROM   max_overs AS mo
JOIN   "player" AS p
       ON p."player_id" = mo."bowler"
ORDER BY mo."runs_in_over" DESC
LIMIT 3;
```
