```sql
--Description / Thinking process:
-- We must find, across all matches, the three bowlers who conceded the most runs
-- in an over that was the single costliest over of its match.
-- 1. over_totals  : For every bowler-over in every match, sum batsman runs
--    (batsman_scored) + extras (extra_runs) to get total runs conceded.
-- 2. max_per_match: Per match, locate the maximum runs conceded in any over.
-- 3. max_overs    : Keep only those overs whose run-total equals that match
--    maximum (i.e., the match’s most expensive overs).
-- 4. Finally order these overs by runs conceded and take the top three,
--    joining to the player table to show the bowler’s name.
WITH over_totals AS (
    SELECT  b.match_id,
            b.over_id,
            b.bowler,
            SUM( COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0) ) AS over_runs
    FROM   ball_by_ball AS b
    LEFT   JOIN batsman_scored AS bs
           ON  bs.match_id = b.match_id
           AND bs.over_id  = b.over_id
           AND bs.ball_id  = b.ball_id
    LEFT   JOIN extra_runs AS er
           ON  er.match_id = b.match_id
           AND er.over_id  = b.over_id
           AND er.ball_id  = b.ball_id
    GROUP  BY b.match_id, b.over_id, b.bowler
),
max_per_match AS (
    SELECT match_id, MAX(over_runs) AS max_runs
    FROM   over_totals
    GROUP  BY match_id
),
max_overs AS (
    SELECT ot.*
    FROM   over_totals ot
    JOIN   max_per_match mm
           ON  ot.match_id  = mm.match_id
           AND ot.over_runs = mm.max_runs
)
SELECT  p.player_name AS bowler_name,
        mo.match_id,
        mo.over_runs AS runs_in_over
FROM    max_overs mo
JOIN    player p ON p.player_id = mo.bowler
ORDER BY mo.over_runs DESC
LIMIT 3;
