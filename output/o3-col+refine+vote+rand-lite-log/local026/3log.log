```sql
--Description / Thinking process:
-- Goal: Top-3 bowlers who conceded the most runs in an over that was itself the
--       most expensive over of its match, plus the match in which it happened.
-- Steps
-- 1) over_totals   – total runs a bowler gave in every over (batsman runs + extras).
-- 2) max_per_match – per match, the highest runs conceded in any single over.
-- 3) max_overs     – keep only those overs whose run-tally equals that match
--                    maximum (i.e. the costliest overs of each match).
-- 4) bowler_best   – for every bowler, pick *one* such over: the one with the
--                    greatest runs (ties resolved by the smallest match_id).
-- 5) Return the three largest of these worst overs.
WITH over_totals AS (
    SELECT b.match_id,
           b.over_id,
           b.bowler,
           SUM(COALESCE(bs.runs_scored,0) + COALESCE(er.extra_runs,0)) AS over_runs
    FROM   ball_by_ball b
    LEFT   JOIN batsman_scored USING (match_id, over_id, ball_id)
    LEFT   JOIN extra_runs     USING (match_id, over_id, ball_id)
    GROUP  BY b.match_id, b.over_id, b.bowler
),
max_per_match AS (
    SELECT match_id, MAX(over_runs) AS max_runs
    FROM   over_totals
    GROUP  BY match_id
),
max_overs AS (
    SELECT ot.*
    FROM   over_totals ot
    JOIN   max_per_match mm
           ON  ot.match_id = mm.match_id
           AND ot.over_runs = mm.max_runs
),
bowler_best AS (
    -- one “worst” over per bowler (highest runs; if several, take lowest match_id)
    SELECT bowler,
           MIN(match_id) AS match_id,        -- deterministic pick on tie
           MAX(over_runs) AS over_runs
    FROM   max_overs
    GROUP  BY bowler
)
SELECT p.player_name AS bowler_name,
       bb.match_id,
       bb.over_runs AS runs_in_over
FROM   bowler_best bb
JOIN   player p ON p.player_id = bb.bowler
ORDER  BY bb.over_runs DESC
LIMIT 3;
```
