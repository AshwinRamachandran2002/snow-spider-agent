```sql
-- count of distinct overlapping road pairs in California that:
--   • have highway tags (motorway, trunk, primary, secondary, residential)
--   • carry no bridge tag
--   • geometrically overlap but do not share any nodes
WITH ca_boundary AS (   ------------------------------------------------------------------
  SELECT ST_GEOMFROMWKB("state_geom")            AS geom
  FROM   GEO_OPENSTREETMAP_BOUNDARIES.GEO_US_BOUNDARIES.STATES
  WHERE  "state_fips_code" = '06'                                    -- California
),                                                                   
roads_ca AS (          ------------------------------------------------
  /* eligible OSM ways that lie (at least partly) in California       */
  SELECT
      w."id"                                          AS way_id ,
      ST_GEOMFROMWKB(w."geometry")                    AS geom   ,
      ARRAY_AGG( TO_NUMBER(n.value:id) )              AS node_ids
  FROM  GEO_OPENSTREETMAP_BOUNDARIES.GEO_OPENSTREETMAP.PLANET_WAYS w
        ,TABLE(FLATTEN(input => w."nodes")) n
        ,ca_boundary cb
  WHERE ST_INTERSECTS(cb.geom , ST_GEOMFROMWKB(w."geometry"))        -- in CA
    /* highway tag filter */
    AND EXISTS (
          SELECT 1
          FROM   TABLE(FLATTEN(input => w."all_tags")) t
          WHERE  t.value:key   = 'highway'
            AND  t.value:value IN ('motorway','trunk','primary',
                                   'secondary','residential')
        )
    /* exclude bridge‑tagged ways */
    AND NOT EXISTS (
          SELECT 1
          FROM   TABLE(FLATTEN(input => w."all_tags")) t
          WHERE  t.value:key = 'bridge'
        )
  GROUP BY w."id", w."geometry"
),                                                                   
pair_count AS (     ---------------------------------------------------
  SELECT COUNT(*) AS overlaps_without_shared_nodes
  FROM   roads_ca  r1
  JOIN   roads_ca  r2
         ON r1.way_id < r2.way_id                       -- unique ordered pairs
        AND ST_INTERSECTS(r1.geom, r2.geom)             -- geometries overlap
        AND ARRAY_SIZE(
              ARRAY_INTERSECTION(r1.node_ids, r2.node_ids)
            ) = 0                                       -- no common nodes
)                                                                   
SELECT overlaps_without_shared_nodes
FROM   pair_count;
```
