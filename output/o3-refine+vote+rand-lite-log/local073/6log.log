```sql
WITH order_base AS (      --  every pizza order with its cleaned strings
    SELECT
        o.order_id                         AS row_id,        -- treat order_id as the row id
        o.order_id,
        o.customer_id,
        CASE WHEN o.pizza_id = 1 THEN 1 ELSE 2 END           AS std_pizza_id,
        pn.pizza_name,
        o.order_time,
        REPLACE(IFNULL(o.exclusions,''),' ','')              AS excl_str,
        REPLACE(IFNULL(o.extras    ,''),' ','')              AS extra_str,
        REPLACE(pr.toppings,' ','')                          AS std_str
    FROM pizza_clean_customer_orders o
    JOIN pizza_names   pn ON (CASE WHEN o.pizza_id = 1 THEN 1 ELSE 2 END) = pn.pizza_id
    JOIN pizza_recipes pr ON (CASE WHEN o.pizza_id = 1 THEN 1 ELSE 2 END) = pr.pizza_id
),
/* ------------ split the comma‑separated lists into rows ------------- */
RECURSIVE std_split(order_id,topping_id,rest) AS (
        SELECT ob.order_id,
               CAST(substr(ob.std_str,1,instr(ob.std_str||',',',')-1) AS INTEGER),
               substr(ob.std_str||',',instr(ob.std_str||',',',')+1)
        FROM order_base ob
        UNION ALL
        SELECT order_id,
               CAST(substr(rest,1,instr(rest,',')-1) AS INTEGER),
               substr(rest,instr(rest,',')+1)
        FROM std_split
        WHERE rest<>''
),
extras_start AS ( SELECT * FROM order_base WHERE extra_str<>'' ),
RECURSIVE extra_split(order_id,topping_id,rest) AS (
        SELECT ob.order_id,
               CAST(substr(ob.extra_str,1,instr(ob.extra_str||',',',')-1) AS INTEGER),
               substr(ob.extra_str||',',instr(ob.extra_str||',',',')+1)
        FROM extras_start ob
        UNION ALL
        SELECT order_id,
               CAST(substr(rest,1,instr(rest,',')-1) AS INTEGER),
               substr(rest,instr(rest,',')+1)
        FROM extra_split
        WHERE rest<>''
),
excl_start AS ( SELECT * FROM order_base WHERE excl_str<>'' ),
RECURSIVE excl_split(order_id,topping_id,rest) AS (
        SELECT ob.order_id,
               CAST(substr(ob.excl_str,1,instr(ob.excl_str||',',',')-1) AS INTEGER),
               substr(ob.excl_str||',',instr(ob.excl_str||',',',')+1)
        FROM excl_start ob
        UNION ALL
        SELECT order_id,
               CAST(substr(rest,1,instr(rest,',')-1) AS INTEGER),
               substr(rest,instr(rest,',')+1)
        FROM excl_split
        WHERE rest<>''
),
/* ---------------- build counts and apply exclusions ----------------- */
ingredient_counts AS (           -- 1 copy for every standard or extra appearance
        SELECT order_id, topping_id, COUNT(*) AS cnt
        FROM (
                SELECT order_id, topping_id FROM std_split      -- standard toppings
                UNION ALL
                SELECT order_id, topping_id FROM extra_split    -- extra toppings
        )
        GROUP BY order_id, topping_id
),
final_counts AS (                -- remove any excluded toppings
        SELECT ic.*
        FROM ingredient_counts ic
        LEFT JOIN excl_split ex
               ON ic.order_id = ex.order_id
              AND ic.topping_id = ex.topping_id
        WHERE ex.topping_id IS NULL
)
/* -------------------- assemble the final answer --------------------- */
SELECT
    ob.row_id,
    ob.order_id,
    ob.customer_id,
    ob.pizza_name,
    ( ob.pizza_name || ': ' ||
      ( SELECT GROUP_CONCAT(
                 CASE WHEN fc.cnt>1
                      THEN printf('%dx %s',fc.cnt,pt.topping_name)
                      ELSE                pt.topping_name
                 END,
                 ', '
             )
        FROM final_counts fc
        JOIN pizza_toppings pt ON pt.topping_id = fc.topping_id
        WHERE fc.order_id = ob.order_id
        ORDER BY pt.topping_name                -- alphabetical
      )
    ) AS final_ingredients
FROM order_base ob
GROUP BY ob.row_id, ob.order_id, ob.pizza_name, ob.order_time
ORDER BY ob.row_id;
```
