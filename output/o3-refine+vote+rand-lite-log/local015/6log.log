```sql
WITH motorcycle_collisions AS (
    -- all collisions that involve a motorcycle
    SELECT
        c."case_id",
        COALESCE(c."motorcyclist_killed_count",0) AS motorcyclist_killed_count
    FROM "collisions" AS c
    WHERE c."motorcycle_collision" = 1
),

motorcycle_parties AS (
    -- parties in those collisions that are motorcycles
    SELECT
        p."case_id",
        /* TRUE if any safety‑equipment field mentions a helmet */
        CASE
            WHEN lower(COALESCE(p."party_safety_equipment_1",'')) LIKE '%helmet%'
              OR lower(COALESCE(p."party_safety_equipment_2",'')) LIKE '%helmet%'
            THEN 1 ELSE 0
        END                                                           AS helmet_used,
        /* TRUE if any safety‑equipment field explicitly says helmet not used */
        CASE
            WHEN lower(COALESCE(p."party_safety_equipment_1",'')) LIKE '%helmet not used%'
              OR lower(COALESCE(p."party_safety_equipment_2",'')) LIKE '%helmet not used%'
            THEN 1 ELSE 0
        END                                                           AS helmet_not_used
    FROM "parties" AS p
    JOIN motorcycle_collisions mc ON mc."case_id" = p."case_id"
    WHERE lower(COALESCE(p."statewide_vehicle_type",'')) LIKE '%motorcycle%'
),

collision_helmet_flags AS (
    /* for every motorcycle collision, decide whether a helmet was worn or not worn */
    SELECT
        mc."case_id",
        mc.motorcyclist_killed_count,
        MAX(mp.helmet_used)      AS helmet_used,        -- 1 if any motorcyclist wore a helmet
        MAX(mp.helmet_not_used)  AS helmet_not_used     -- 1 if any motorcyclist did not wear a helmet
    FROM motorcycle_collisions mc
    LEFT JOIN motorcycle_parties mp USING ("case_id")
    GROUP BY mc."case_id"
),

group_totals AS (
    SELECT
        CASE
            WHEN helmet_used = 1                                THEN 'helmet_used'
            WHEN helmet_used = 0 AND helmet_not_used = 1        THEN 'helmet_not_used'
            ELSE 'unknown'
        END                             AS helmet_group,
        SUM(motorcyclist_killed_count)  AS total_killed,
        COUNT(*)                        AS total_collisions
    FROM collision_helmet_flags
    GROUP BY helmet_group
)

SELECT
    ROUND(
        100.0 * (SELECT total_killed FROM group_totals WHERE helmet_group='helmet_used')
        /
        (SELECT total_collisions FROM group_totals WHERE helmet_group='helmet_used')
    ,4) AS helmet_used_fatality_percentage,

    ROUND(
        100.0 * (SELECT total_killed FROM group_totals WHERE helmet_group='helmet_not_used')
        /
        (SELECT total_collisions FROM group_totals WHERE helmet_group='helmet_not_used')
    ,4) AS helmet_not_used_fatality_percentage;
```
