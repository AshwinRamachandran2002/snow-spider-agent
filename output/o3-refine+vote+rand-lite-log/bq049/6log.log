```sql
WITH population_21_plus AS (
  -- 21+ population (both genders combined) per ZIP code
  SELECT
    LPAD(zipcode, 5, '0') AS zip5,
    SUM(population) AS pop_21_plus
  FROM `bigquery-public-data.census_bureau_usa.population_by_zip_2010`
  WHERE gender IS NULL                         -- overall (not male/female split)
    AND minimum_age IS NOT NULL               -- ignore “total‑population” rows
    AND minimum_age >= 21                     -- keep only 21 years and older
  GROUP BY zip5
),
sales_2022 AS (
  -- 2022 Bourbon‐Whiskey sales in Dubuque County, aggregated by month & ZIP
  SELECT
    DATE_TRUNC(date, MONTH) AS month,
    CAST(REGEXP_EXTRACT(zip_code, r'(\d{5})') AS STRING) AS zip5,
    SUM(sale_dollars) AS sales_dollars
  FROM `bigquery-public-data.iowa_liquor_sales.sales`
  WHERE EXTRACT(YEAR FROM date) = 2022
    AND UPPER(county) = 'DUBUQUE'
    AND LOWER(category_name) LIKE '%bourbon%'   -- any Bourbon Whiskey category
  GROUP BY month, zip5
),
zip_ranking AS (
  -- rank Dubuque‑county ZIP codes by total 2022 Bourbon sales
  SELECT
    zip5,
    SUM(sales_dollars) AS total_2022_sales,
    RANK() OVER (ORDER BY SUM(sales_dollars) DESC) AS sales_rank
  FROM sales_2022
  GROUP BY zip5
),
third_place_zip AS (
  -- the ZIP code that ranks 3rd
  SELECT zip5
  FROM zip_ranking
  WHERE sales_rank = 3
)
-- final monthly per‑capita figures
SELECT
  FORMAT_DATE('%Y-%m', s.month)                   AS month,
  s.sales_dollars / p.pop_21_plus                 AS per_capita_bourbon_sales
FROM sales_2022 AS s
JOIN third_place_zip AS z  ON s.zip5 = z.zip5
JOIN population_21_plus AS p ON p.zip5 = s.zip5
ORDER BY month;
```
