WITH airport_coords AS (
    SELECT
        airport_code,
        json_extract(city,'$.en') AS city,
        CAST(substr(coordinates, 2, instr(coordinates,',')-2) AS REAL)                                AS lon_deg,
        CAST(substr(coordinates,
                    instr(coordinates,',')+1,
                    instr(coordinates,')')-instr(coordinates,',')-1) AS REAL)                        AS lat_deg
    FROM airports_data
    WHERE city IS NOT NULL
),
airport_rads AS (
    SELECT
        airport_code,
        city,
        lat_deg * (3.141592653589793/180.0) AS lat_rad,
        lon_deg * (3.141592653589793/180.0) AS lon_rad
    FROM airport_coords
),
routes AS (                       -- every flight, but grouped on city names (not airport codes)
    SELECT
        CASE WHEN d.city < a.city THEN d.city ELSE a.city END AS city1,
        CASE WHEN d.city < a.city THEN a.city ELSE d.city END AS city2,
        d.lat_rad AS lat1,
        d.lon_rad AS lon1,
        a.lat_rad AS lat2,
        a.lon_rad AS lon2
    FROM flights AS f
    JOIN airport_rads AS d ON d.airport_code = f.departure_airport
    JOIN airport_rads AS a ON a.airport_code = f.arrival_airport
    WHERE d.city <> a.city
),
h_values AS (                     -- “h” of the haversine formula (no sqrt/acos needed)
    SELECT
        city1,
        city2,
        (sin((lat2-lat1)/2.0) * sin((lat2-lat1)/2.0)) +
        cos(lat1) * cos(lat2) *
        (sin((lon2-lon1)/2.0) * sin((lon2-lon1)/2.0))         AS h_val
    FROM routes
),
avg_h AS (                        -- average “h” for each unordered city pair
    SELECT city1,
           city2,
           AVG(h_val) AS h_avg
    FROM h_values
    GROUP BY city1, city2
),
bucketed AS (                     -- assign each pair to a distance range via h‑thresholds
    SELECT
        CASE
            WHEN h_avg < (sin(1000.0/(2.0*6371.0)) * sin(1000.0/(2.0*6371.0))) THEN '0'
            WHEN h_avg < (sin(2000.0/(2.0*6371.0)) * sin(2000.0/(2.0*6371.0))) THEN '1000'
            WHEN h_avg < (sin(3000.0/(2.0*6371.0)) * sin(3000.0/(2.0*6371.0))) THEN '2000'
            WHEN h_avg < (sin(4000.0/(2.0*6371.0)) * sin(4000.0/(2.0*6371.0))) THEN '3000'
            WHEN h_avg < (sin(5000.0/(2.0*6371.0)) * sin(5000.0/(2.0*6371.0))) THEN '4000'
            WHEN h_avg < (sin(6000.0/(2.0*6371.0)) * sin(6000.0/(2.0*6371.0))) THEN '5000'
            ELSE '6000+'
        END AS range_tag
    FROM avg_h
),
bucket_counts AS (
    SELECT range_tag,
           COUNT(*) AS pair_cnt
    FROM bucketed
    GROUP BY range_tag
)
SELECT MIN(pair_cnt) AS fewest_city_pairs
FROM bucket_counts;
