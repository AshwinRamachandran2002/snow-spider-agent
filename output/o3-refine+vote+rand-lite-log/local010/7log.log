WITH airport_coords AS (                -- longitude / latitude in degrees for every airport
    SELECT
        airport_code,
        json_extract(city,'$.en')                                           AS city,
        CAST(substr(coordinates,2, instr(coordinates,',')-2)      AS REAL) AS lon_deg,
        CAST(substr(
                 coordinates,
                 instr(coordinates,',')+1,
                 instr(coordinates,')')-instr(coordinates,',')-1) AS REAL) AS lat_deg
    FROM airports_data
    WHERE city IS NOT NULL
),
routes AS (                              -- every flight rewritten as an *unordered* city pair
    SELECT
        CASE WHEN d.city < a.city THEN d.city ELSE a.city END     AS city1,
        CASE WHEN d.city < a.city THEN a.city ELSE d.city END     AS city2,
        d.lat_deg                                                AS lat1,
        d.lon_deg                                                AS lon1,
        a.lat_deg                                                AS lat2,
        a.lon_deg                                                AS lon2
