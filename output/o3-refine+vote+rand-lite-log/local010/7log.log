                                           * ( ((lat1+lat2)/2.0)*(3.141592653589793/180.0) ) )/2.0
                                       + ( pow( ((lat1+lat2)/2.0)*(3.141592653589793/180.0),4) )/24.0
                                       - ( pow( ((lat1+lat2)/2.0)*(3.141592653589793/180.0),6) )/720.0
