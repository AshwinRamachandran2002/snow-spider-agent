WITH airports AS (
    /* unpack coordinates and pre‑calculate them in radians                */
    SELECT
        airport_code,
        json_extract(city,'$.en')                                            AS city ,
        (   /* longitude  */ 
            CAST(substr(REPLACE(REPLACE(coordinates,'(',''),')',''),
                         1,
                         instr(REPLACE(REPLACE(coordinates,'(',''),')',''), ',')-1) AS REAL)
          * 0.017453292519943295                                             /* DEG→RAD */
        )                                                                   AS lon_rad ,
        (   /* latitude   */
            CAST(substr(REPLACE(REPLACE(coordinates,'(',''),')',''),
                         instr(REPLACE(REPLACE(coordinates,'(',''),')',''), ',')+1) AS REAL)
          * 0.017453292519943295
        )                                                                   AS lat_rad
    FROM airports_data
),
flight_distances AS (
    /* great‑circle distance (km) for every flight; store as unordered city pair          */
    SELECT
        CASE WHEN a1.city < a2.city THEN a1.city ELSE a2.city END           AS city_from ,
        CASE WHEN a1.city < a2.city THEN a2.city ELSE a1.city END           AS city_to   ,
        6371.0 *
        acos( 
              sin(a1.lat_rad) * sin(a2.lat_rad)
            + cos(a1.lat_rad) * cos(a2.lat_rad) * cos(a1.lon_rad - a2.lon_rad)
        )                                                                   AS distance_km
    FROM flights          AS f
    JOIN airports AS a1 ON f.departure_airport = a1.airport_code
    JOIN airports AS a2 ON f.arrival_airport   = a2.airport_code
),
pair_avg AS (
    /* average distance for every unique (unordered) city pair                         */
    SELECT
        city_from ,
        city_to   ,
        AVG(distance_km)                                                    AS avg_distance
    FROM flight_distances
    GROUP BY city_from , city_to
),
pairs_by_range AS (
    /* bucket the pairs into the requested distance ranges                             */
    SELECT
        CASE
            WHEN avg_distance < 1000 THEN '0‑999'
            WHEN avg_distance < 2000 THEN '1000‑1999'
            WHEN avg_distance < 3000 THEN '2000‑2999'
            WHEN avg_distance < 4000 THEN '3000‑3999'
            WHEN avg_distance < 5000 THEN '4000‑4999'
            WHEN avg_distance < 6000 THEN '5000‑5999'
            ELSE                       '6000+'
        END                                               AS distance_band ,
        COUNT(*)                                          AS pair_count
    FROM pair_avg
    GROUP BY distance_band
)
SELECT MIN(pair_count) AS fewest_pairs
FROM pairs_by_range;
```
