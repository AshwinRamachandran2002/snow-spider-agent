```sql
WITH
/* ------------------------------------------------------------
   1) Order‑lines in the sequence they were entered for order 423
      – together with running totals per product.
-------------------------------------------------------------*/
order_lines AS (
    SELECT  id                              AS orderline_id,
            product_id,
            qty                             AS line_qty,

            /* cumulative demand just BEFORE / AFTER this line */
            SUM(qty) OVER (PARTITION BY product_id
                           ORDER BY id
                           ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS cum_need_start,

            SUM(qty) OVER (PARTITION BY product_id
                           ORDER BY id
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_need_end
    FROM    orderlines
    WHERE   order_id = 423
),
/* ------------------------------------------------------------
   2) Inventory that can be used (warehouse 1 only) ordered by
      – earlier purchase date first
      – then by the smallest remaining lot size.
      Running totals show how much stock is available up to,
      and including, the current location row.
-------------------------------------------------------------*/
inv AS (
    SELECT  i.id                            AS inventory_id,
            i.product_id,
            i.qty                           AS inv_qty,
            l.aisle,
            l.position,
            p.purchased,

            /* cumulative stock BEFORE / AFTER this location */
            SUM(i.qty) OVER (PARTITION BY i.product_id
                             ORDER BY p.purchased, i.qty
                             ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS cum_inv_start,

            SUM(i.qty) OVER (PARTITION BY i.product_id
                             ORDER BY p.purchased, i.qty
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_inv_end
    FROM        inventory  i
    JOIN        locations  l ON l.id = i.location_id
    JOIN        purchases  p ON p.id = i.purchase_id
    WHERE       l.warehouse = 1
      AND       i.qty > 0
      AND       i.product_id IN (SELECT DISTINCT product_id
                                 FROM orderlines
                                 WHERE order_id = 423)
),
/* ------------------------------------------------------------
   3) Cross the two result sets and calculate the overlap
      between “what is still needed” and “what this location
      still holds”.  The overlap is the quantity to pick.
-------------------------------------------------------------*/
calc AS (
   SELECT  ol.orderline_id,
           ol.product_id,
           inv.aisle,
           inv.position,
           inv.purchased,
           inv.inv_qty,

           CASE
               WHEN inv.cum_inv_end   <= ol.cum_need_start THEN 0   -- stock before demand
               WHEN inv.cum_inv_start >= ol.cum_need_end   THEN 0   -- stock after demand
               ELSE
                   /* minimum of the two ‘ends’ … */
                   (CASE WHEN inv.cum_inv_end < ol.cum_need_end
                         THEN inv.cum_inv_end
                         ELSE ol.cum_need_end
                    END)
                 - /* … minus maximum of the two ‘starts’ */
                   (CASE WHEN inv.cum_inv_start > ol.cum_need_start
                         THEN inv.cum_inv_start
                         ELSE ol.cum_need_start
                    END)
           END                                               AS pick_qty
   FROM   order_lines  ol
   JOIN   inv          ON inv.product_id = ol.product_id
)
/* ------------------------------------------------------------
   4) Final pick list.
-------------------------------------------------------------*/
SELECT  orderline_id          AS order_line,
        product_id,
        aisle,
        position,
        pick_qty
FROM    calc
WHERE   pick_qty > 0                -- ignore rows with no pick
ORDER BY
        order_line,                 -- respect order‑line sequence
        purchased,                  -- older lots first
        inv_qty;                    -- then smaller lots
```
