/* -----------------------------------------------------------------
   Produce the pick‑list (product, aisle, position, quantity) that
   fulfils every order‑line in order 423.  
   • Only inventory from warehouse 1 is used
   • Older purchases are picked before newer ones
   • If two lots have the same purchase date, the smaller lot
     is taken first
------------------------------------------------------------------*/
WITH
/* 1. Order‑lines in entry order with running demand per product */
order_lines AS (
    SELECT  id                       AS orderline_id,
            product_id,
            qty                      AS line_qty,
            /* demand BEFORE and AFTER the current line          */
            SUM(qty) OVER (PARTITION BY product_id
                           ORDER BY id
                           ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS cum_need_start,
            SUM(qty) OVER (PARTITION BY product_id
                           ORDER BY id
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_need_end
    FROM    orderlines
    WHERE   order_id = 423
),
/* 2. Relevant inventory in warehouse 1, oldest first, then
      smallest lot first – plus running supply per product      */
inv AS (
    SELECT  i.id                    AS inventory_id,
            i.product_id,
            i.qty                   AS inv_qty,
            l.aisle,
            l.position,
            COALESCE(p.purchased,'9999-12-31') AS purchased,
            SUM(i.qty) OVER (PARTITION BY i.product_id
                             ORDER BY COALESCE(p.purchased,'9999-12-31'), i.qty,
                                      i.id            -- stable order
                             ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS cum_inv_start,
            SUM(i.qty) OVER (PARTITION BY i.product_id
                             ORDER BY COALESCE(p.purchased,'9999-12-31'), i.qty,
                                      i.id
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_inv_end
    FROM       inventory  i
    JOIN       locations  l ON l.id = i.location_id
    LEFT JOIN  purchases  p ON p.id = i.purchase_id      -- keep rows even if purchase is missing
    WHERE      l.warehouse = 1
      AND      i.qty > 0
      AND      i.product_id IN (
                 SELECT DISTINCT product_id
                 FROM   orderlines
                 WHERE  order_id = 423 )
),
/* 3. Intersection of cumulative demand and cumulative supply
      gives the quantity that has to be taken from each location
      for each order‑line                                            */
alloc AS (
    SELECT  ol.orderline_id,
            ol.product_id,
            inv.aisle,
            inv.position,
            /* quantity to pick from this location for this line */
            CASE
                WHEN inv.cum_inv_end   <= ol.cum_need_start THEN 0
                WHEN inv.cum_inv_start >= ol.cum_need_end   THEN 0
                ELSE
                      MIN(inv.cum_inv_end , ol.cum_need_end)
                    - MAX(inv.cum_inv_start, ol.cum_need_start)
            END AS pick_qty,
            inv.purchased,
            inv.inv_qty
    FROM   order_lines AS ol
    JOIN   inv         ON inv.product_id = ol.product_id
)
/* 4. Final pick‑list */
SELECT  orderline_id   AS order_line,
        product_id,
        aisle,
        position,
        pick_qty
FROM    alloc
WHERE   pick_qty > 0
ORDER BY
        order_line,                 -- preserve order‑line sequence
        purchased,                  -- oldest purchase first
        inv_qty;                    -- then smallest remaining lot
