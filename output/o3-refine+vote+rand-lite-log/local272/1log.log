```sql
/* ------------------------------------------------------------
   Pick‑list for order 423
-------------------------------------------------------------*/
WITH
/* 1. Order‑lines in entry order plus running demand per product */
order_lines AS (
    SELECT  id        AS orderline_id,
            product_id,
            qty       AS line_qty,

            /* demand before/after the present line */
            SUM(qty) OVER (PARTITION BY product_id
                           ORDER BY id
                           ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS cum_need_start,
            SUM(qty) OVER (PARTITION BY product_id
                           ORDER BY id
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_need_end
    FROM    orderlines
    WHERE   order_id = 423
),
/* 2. Inventory in warehouse 1, oldest purchases first,
      then the smallest lots – including running totals */
inv AS (
    SELECT  i.id         AS inventory_id,
            i.product_id,
            i.qty        AS inv_qty,
            l.aisle,
            l.position,
            p.purchased,

            SUM(i.qty) OVER (PARTITION BY i.product_id
                             ORDER BY p.purchased, i.qty
                             ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS cum_inv_start,
            SUM(i.qty) OVER (PARTITION BY i.product_id
                             ORDER BY p.purchased, i.qty
                             ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_inv_end
    FROM   inventory  i
    JOIN   locations  l ON l.id = i.location_id
    JOIN   purchases  p ON p.id = i.purchase_id
    WHERE  l.warehouse = 1
      AND  i.qty > 0
      AND  i.product_id IN (SELECT DISTINCT product_id FROM orderlines WHERE order_id = 423)
),
/* 3. For every (order‑line × inventory) pair calculate the
      intersection of the two cumulative ranges – that is the
      quantity that should be picked from that location
      for that particular order‑line.                              */
alloc AS (
    SELECT  ol.orderline_id,
            ol.product_id,
            inv.aisle,
            inv.position,
            inv.inv_qty,
            inv.purchased,

            /* amount to pick (= overlap between the 2 ranges) */
            CASE
                 WHEN inv.cum_inv_end   <= ol.cum_need_start THEN 0
                 WHEN inv.cum_inv_start >= ol.cum_need_end   THEN 0
                 ELSE
                       (MIN(inv.cum_inv_end , ol.cum_need_end)
                        - MAX(inv.cum_inv_start, ol.cum_need_start))
            END AS pick_qty
    FROM   order_lines AS ol
    JOIN   inv         ON inv.product_id = ol.product_id
)
/* 4. Final pick‑list */
SELECT  orderline_id           AS order_line,
        product_id,
        aisle,
        position,
        pick_qty
FROM    alloc
WHERE   pick_qty > 0                    -- ignore zero rows
ORDER BY
        order_line,                     -- keep order‑line sequence
        purchased,                      -- oldest stock first
        inv_qty;                        -- then smaller lots
