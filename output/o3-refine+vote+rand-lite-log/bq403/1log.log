2025-05-02 07:37:56 - Thread-2890 (execute) - INFO - [Try to run SQL in self-refine]
```sql
WITH data AS (
  -- gather total revenue and total functional expenses for each filing year
  SELECT
    CAST(REGEXP_EXTRACT(_TABLE_SUFFIX, r'(\d{4})') AS INT64) AS filing_year,
    totrevenue  AS revenue,
    totfuncexpns AS expenses
  FROM `bigquery-public-data.irs_990.irs_990_20*`
  WHERE _TABLE_SUFFIX IN ('2012','2013','2014','2015','2016','2017')
),
medians AS (
  -- compute the medians for each year
  SELECT
    filing_year,
    APPROX_QUANTILES(revenue ,2)[OFFSET(1)]  AS median_revenue,
    APPROX_QUANTILES(expenses,2)[OFFSET(1)]  AS median_expenses
  FROM data
  GROUP BY filing_year
),
diffs AS (
  -- absolute difference between the two medians
  SELECT
    filing_year,
    ABS(median_revenue - median_expenses) AS median_diff
  FROM medians
)
-- return the three years with the smallest differences
SELECT 
  filing_year AS year,
  median_diff AS difference
FROM diffs
ORDER BY median_diff ASC, filing_year
LIMIT 3;
```
