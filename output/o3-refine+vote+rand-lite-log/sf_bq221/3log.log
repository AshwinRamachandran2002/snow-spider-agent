        "cpc_group",
        "full_cpc_title",
        "year"                       AS "best_year",
        ROW_NUMBER()
          OVER (PARTITION BY "cpc_group"
                ORDER BY ema DESC, "year" ASC)  AS rn
    FROM ema_recursive
)
SELECT
    "cpc_group",
    "full_cpc_title",
    "best_year"
FROM best_year
WHERE rn = 1
ORDER BY "cpc_group";
