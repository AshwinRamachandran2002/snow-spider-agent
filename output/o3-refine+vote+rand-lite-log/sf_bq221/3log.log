WITH base AS (   -- 1. keep only publications with a (first) CPC code, valid filing date & application number
    SELECT  
        p."publication_number",
        p."filing_date",
        fl.value:"code"::string                                  AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p ,
         LATERAL FLATTEN( INPUT => p."cpc") fl
    WHERE fl."SEQ" = 0                                    -- first CPC code only
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
), cpc_lvl5 AS (        -- 2. map every CPC code to its level‑5 group and get the full CPC title
    SELECT  
        b."publication_number",
        b."filing_date",
        d."symbol"                                           AS "cpc_group",
        d."titleFull"                                        AS "full_cpc_title"
    FROM base b
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON b."cpc_code" LIKE d."symbol" || '%'
         AND d."level" = 5                                   -- level‑5 groups only
), per_year AS (        -- 3. yearly filing counts per CPC level‑5 group
    SELECT  
        "cpc_group",
        "full_cpc_title",
        FLOOR("filing_date"/10000)::INT                      AS "year",
        COUNT(DISTINCT "publication_number")                 AS "filings"
    FROM cpc_lvl5
    GROUP BY "cpc_group","full_cpc_title","year"
), ema_calc AS (        -- 4. exponential moving average (α = 0.2) of yearly filings
    SELECT  
        "cpc_group",
        "full_cpc_title",
        "year",
        "filings",
        EMA("filings",0.2) 
          OVER (PARTITION BY "cpc_group" ORDER BY "year")    AS "ema_value"
    FROM per_year
), best_year AS (       -- 5. pick the year with the highest EMA for each CPC group
    SELECT  
        "cpc_group",
        "full_cpc_title",
        "year"                                              AS "best_year",
        ROW_NUMBER() 
          OVER (PARTITION BY "cpc_group" 
                ORDER BY "ema_value" DESC, "year" ASC)       AS "rn"
    FROM ema_calc
)
SELECT  
    "cpc_group",
    "full_cpc_title",
    "best_year"
FROM best_year
WHERE "rn" = 1
ORDER BY "cpc_group";
```
