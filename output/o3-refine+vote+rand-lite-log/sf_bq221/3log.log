      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
),
cpc_lvl5 AS (    --------------------------------------------------- 2
    SELECT
        b."publication_number",
        b."filing_date",
        d."symbol"          AS "cpc_group",
        d."titleFull"       AS "full_cpc_title"
    FROM base b
    JOIN PATENTS.PATENTS.CPC_DEFINITION d
          ON b."cpc_code" LIKE d."symbol" || '%'
         AND d."level" = 5                      -- level‑5 groups only
),
per_year AS (    ---------------------------------------------------- 3
    SELECT
        "cpc_group",
        "full_cpc_title",
        FLOOR("filing_date"/10000)::INT  AS "year",
        COUNT(DISTINCT "publication_number") AS "filings"
    FROM cpc_lvl5
    GROUP BY "cpc_group","full_cpc_title","year"
),
ordered_per_year AS (  --------------------------------------------- 4
    SELECT
        "cpc_group",
        "full_cpc_title",
        "year",
        "filings",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM per_year
),
/* Recursive EMA computation:
   ema_1 = filings_1
   ema_n = 0.2*filings_n + 0.8*ema_(n‑1)                             */
ema_recursive AS (  ----------------------------------------------- 5
