/*  Best “level‑5” CPC (main‑group) year by exponential moving average (α = 0.2) */
WITH base AS (                                           -- 1. publications with a 1st CPC code
    SELECT
        p."publication_number",
        p."filing_date",
        fl.value:"code"::STRING           AS "cpc_code"
    FROM PATENTS.PATENTS.PUBLICATIONS p,
         LATERAL FLATTEN (INPUT => p."cpc") fl
    WHERE fl."SEQ" = 0
      AND p."filing_date" IS NOT NULL
      AND p."application_number" IS NOT NULL
      AND p."application_number" <> ''
),
main_group AS (                                          -- 2. derive CPC main‑group (“level‑5”)
    SELECT
        b."publication_number",
        b."filing_date",
        (SPLIT_PART(b."cpc_code", '/', 1) || '/00')  AS "cpc_group"
    FROM base b
),
with_titles AS (                                         -- 3. attach full CPC title if available
    SELECT
        m."publication_number",
        m."filing_date",
        m."cpc_group",
        COALESCE(d."titleFull", m."cpc_group") AS "full_cpc_title"
    FROM main_group m
    LEFT JOIN PATENTS.PATENTS.CPC_DEFINITION d
           ON d."symbol" = m."cpc_group"
),
per_year AS (                                            -- 4. yearly filing counts
    SELECT
        "cpc_group",
        "full_cpc_title",
        FLOOR("filing_date"/10000)::INT  AS "year",
        COUNT(DISTINCT "publication_number") AS "filings"
    FROM with_titles
    GROUP BY "cpc_group","full_cpc_title","year"
),
ordered_years AS (                                       -- 5. add row number per CPC group
    SELECT
        "cpc_group",
        "full_cpc_title",
        "year",
        "filings",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group" ORDER BY "year") AS rn
    FROM per_year
),
/* ------------------------------------------------------
   6. Recursive EMA:  ema_1 = filings_1,
                      ema_n = 0.2*filings_n + 0.8*ema_(n‑1)
   ------------------------------------------------------ */
ema_recursive AS (
    SELECT                                               -- anchor (first year)
        o."cpc_group",
        o."full_cpc_title",
        o."year",
        o."filings",
        CAST(o."filings" AS DOUBLE)    AS "ema",
        o.rn
    FROM ordered_years o
    WHERE o.rn = 1

    UNION ALL                                            -- recursive part
    SELECT
        o."cpc_group",
        o."full_cpc_title",
        o."year",
        o."filings",
        0.2 * o."filings" + 0.8 * r."ema"  AS "ema",
        o.rn
    FROM ordered_years o
    JOIN ema_recursive r
      ON o."cpc_group" = r."cpc_group"
     AND o.rn          = r.rn + 1
),
best_year AS (                                           -- 7. pick year with highest EMA
    SELECT
        "cpc_group",
        "full_cpc_title",
        "year"         AS "best_year",
        ROW_NUMBER() OVER (PARTITION BY "cpc_group"
                           ORDER BY "ema" DESC, "year" ASC) AS rk
    FROM ema_recursive
)
SELECT                                                   -- 8. final answer
    "cpc_group",
    "full_cpc_title",
    "best_year"
FROM best_year
WHERE rk = 1
ORDER BY "cpc_group";
```
