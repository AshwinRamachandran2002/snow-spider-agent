    SELECT
        o."cpc_group",
        o."full_cpc_title",
        o."year",
        o."filings",
        CAST(o."filings" AS DOUBLE)          AS ema,
        o.rn
    FROM ordered_per_year o
    WHERE o.rn = 1

    UNION ALL

    -- recursive part
    SELECT
        o."cpc_group",
        o."full_cpc_title",
        o."year",
        o."filings",
        0.2 * o."filings" + 0.8 * r.ema      AS ema,
        o.rn
    FROM ordered_per_year o
    JOIN ema_recursive r
      ON o."cpc_group" = r."cpc_group"
     AND o.rn        = r.rn + 1
