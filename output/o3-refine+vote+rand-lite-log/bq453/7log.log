  -- χ² statistic for HWE
  (
    SAFE_DIVIDE(POW(obs_hom_ref - POW(p_ref,2)*total_genotypes,2),
                NULLIF(POW(p_ref,2)*total_genotypes,0))
    +
    SAFE_DIVIDE(POW(obs_het - 2*p_ref*q_alt*total_genotypes,2),
                NULLIF(2*p_ref*q_alt*total_genotypes,0))
    +
    SAFE_DIVIDE(POW(obs_hom_alt - POW(q_alt,2)*total_genotypes,2),
                NULLIF(POW(q_alt,2)*total_genotypes,0))
  )                                     AS chi_squared,
  -- calculated allele frequencies
  p_ref                                 AS ref_allele_freq,
  q_alt                                 AS alt_allele_freq,
  -- 1000 Genomes provided allele frequencies
  AF, AFR_AF, AMR_AF, EUR_AF, ASN_AF
FROM hwe
ORDER BY start_position;
```
