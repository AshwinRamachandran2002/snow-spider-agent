/*  Variants on chr17 (positions 41 196 311‑41 277 499) together with
    Hardy‑Weinberg statistics and 1KG allele frequencies           */

WITH variant_calls AS (
  SELECT
    v.reference_name,
    v.start,
    v.end,
    v.reference_bases,
    ARRAY(SELECT DISTINCT alt FROM UNNEST(v.alternate_bases) alt)        AS alternate_bases,
    v.VT                                                               AS variant_type,
    v.AF, v.AFR_AF, v.AMR_AF, v.EUR_AF, v.ASN_AF,
    c.genotype
  FROM  `spider2-public-data.1000_genomes.variants` v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '17'
    AND v.start BETWEEN 41196311 AND 41277499
    -- keep diploid, non‑missing genotypes only
    AND ARRAY_LENGTH(c.genotype) = 2
    AND c.genotype[OFFSET(0)] != -1
    AND c.genotype[OFFSET(1)] != -1
),
genotype_counts AS (
  SELECT
    reference_name, start, end, reference_bases, alternate_bases,
    variant_type, AF, AFR_AF, AMR_AF, EUR_AF, ASN_AF,
    COUNT(*)                                                                    AS total_genotypes,
    COUNTIF(genotype[OFFSET(0)] = 0 AND genotype[OFFSET(1)] = 0)                AS obs_hom_ref,
    COUNTIF((genotype[OFFSET(0)] = 0 AND genotype[OFFSET(1)] = 1) OR
            (genotype[OFFSET(0)] = 1 AND genotype[OFFSET(1)] = 0))              AS obs_het,
    COUNTIF(genotype[OFFSET(0)] = 1 AND genotype[OFFSET(1)] = 1)                AS obs_hom_alt
  FROM variant_calls
  GROUP BY
    reference_name, start, end, reference_bases, alternate_bases,
    variant_type, AF, AFR_AF, AMR_AF, EUR_AF, ASN_AF
),
hwe AS (
  SELECT
    *,
    -- allele frequencies
    SAFE_DIVIDE(2*obs_hom_ref + obs_het , 2*total_genotypes)                    AS p_ref,
    SAFE_DIVIDE(2*obs_hom_alt + obs_het , 2*total_genotypes)                    AS q_alt
  FROM genotype_counts
),
final AS (
  SELECT
    reference_name        AS chromosome,
    start,
    end,
    reference_bases,
    alternate_bases,
    variant_type,
    total_genotypes,
    -- observed counts
    obs_hom_ref,
    obs_het,
    obs_hom_alt,
    -- expected counts under HWE
    POW(p_ref,2)*total_genotypes                                                AS exp_hom_ref,
    2*p_ref*q_alt*total_genotypes                                               AS exp_het,
    POW(q_alt,2)*total_genotypes                                                AS exp_hom_alt,
    -- Chi‑square statistic
    (
        SAFE_DIVIDE( POW(obs_hom_ref - POW(p_ref,2)*total_genotypes,2),
                     POW(p_ref,2)*total_genotypes )
      + SAFE_DIVIDE( POW(obs_het     - 2*p_ref*q_alt*total_genotypes,2),
                     2*p_ref*q_alt*total_genotypes )
      + SAFE_DIVIDE( POW(obs_hom_alt - POW(q_alt,2)*total_genotypes,2),
                     POW(q_alt,2)*total_genotypes )
    )                                                                           AS chi_squared,
    -- allele frequencies
    p_ref                                                                       AS ref_allele_freq,
    q_alt                                                                       AS alt_allele_freq,
    -- 1KG allele frequencies already provided in table
    AF, AFR_AF, AMR_AF, EUR_AF, ASN_AF
  FROM hwe
)
SELECT *
FROM final
ORDER BY start;
```
