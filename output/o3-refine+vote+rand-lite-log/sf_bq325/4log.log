```sql
/* -----------------------------------------------------------
   Top‑10 genes with the overall smallest variant p‑values
   ----------------------------------------------------------- */
WITH
/* ---------- 1.   best (lowest‑p) variant per gene in DISEASE_VARIANT_GENE ------ */
disease_gene AS (
    SELECT
        "gene_id",
        MIN("pval")                                           AS min_pval,
        MIN_BY("study_id" , "pval")                           AS study_id,
        MIN_BY("tag_chrom", "pval")                           AS chrom,
        MIN_BY("tag_pos"  , "pval")                           AS pos,
        MIN_BY("tag_ref"  , "pval")                           AS ref,
        MIN_BY("tag_alt"  , "pval")                           AS alt
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id"
),

/* ---------- 2.   best (lowest‑p) variant per gene in SA_MOLECULAR_TRAIT -------- */
moltrait_gene AS (
    SELECT
        "gene_id",
        MIN("pval")                                           AS min_pval,
        MIN_BY("study_id", "pval")                            AS study_id,
        MIN_BY("chrom"   , "pval")                            AS chrom,
        MIN_BY("pos"     , "pval")                            AS pos,
        MIN_BY("ref"     , "pval")                            AS ref,
        MIN_BY("alt"     , "pval")                            AS alt
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.SA_MOLECULAR_TRAIT
    WHERE "pval" IS NOT NULL
    GROUP BY "gene_id"
),

/* ---------- 3.   combine both sources ---------------------------------------- */
combined AS (
    SELECT * FROM disease_gene
    UNION ALL
    SELECT * FROM moltrait_gene
),

/* ---------- 4.   choose best overall variant per gene ----------------------- */
best_gene AS (
    SELECT
        "gene_id",
        MIN(min_pval)                                         AS pval,
        MIN_BY(study_id, min_pval)                            AS study_id,
        MIN_BY(chrom   , min_pval)                            AS chrom,
        MIN_BY(pos     , min_pval)                            AS pos,
        MIN_BY(ref     , min_pval)                            AS ref,
        MIN_BY(alt     , min_pval)                            AS alt
    FROM combined
    GROUP BY "gene_id"
)

/* ---------- 5.   final top‑10 list ----------------------------------------- */
SELECT
    bg."gene_id",
    g."gene_name",
    bg."study_id",
    bg."chrom",
    bg."pos",
    bg."ref",
    bg."alt",
    bg."pval"
FROM best_gene bg
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.GENES g
       ON bg."gene_id" = g."gene_id"
ORDER BY bg."pval" ASC
LIMIT 10;
```
