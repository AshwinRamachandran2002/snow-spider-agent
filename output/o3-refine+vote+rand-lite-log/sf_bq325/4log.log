```sql
WITH union_variants AS (
    /* collect variant–gene associations with p‑values from both study tables */
    SELECT
        "gene_id",
        "study_id",
        "tag_chrom"  AS "chrom",
        "tag_pos"    AS "pos",
        "tag_ref"    AS "ref",
        "tag_alt"    AS "alt",
        "pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE "pval" IS NOT NULL

    UNION ALL

    SELECT
        "gene_id",
        "study_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.SA_MOLECULAR_TRAIT
    WHERE "pval" IS NOT NULL
),

/* pick, for each (gene, study) pair, the variant with the lowest p‑value */
best_per_gene_study AS (
    SELECT
        *
    FROM (
        SELECT
            uv.*,
            ROW_NUMBER() OVER (PARTITION BY "gene_id", "study_id"
                               ORDER BY "pval" ASC) AS rn
        FROM union_variants uv
    )
    WHERE rn = 1
),

/* for every gene, keep the single strongest association (lowest p‑value) observed across all studies */
best_per_gene AS (
    SELECT
        "gene_id",
        FIRST_VALUE("study_id") OVER (PARTITION BY "gene_id" ORDER BY "pval") AS "study_id",
        FIRST_VALUE("chrom")    OVER (PARTITION BY "gene_id" ORDER BY "pval") AS "chrom",
        FIRST_VALUE("pos")      OVER (PARTITION BY "gene_id" ORDER BY "pval") AS "pos",
        FIRST_VALUE("ref")      OVER (PARTITION BY "gene_id" ORDER BY "pval") AS "ref",
        FIRST_VALUE("alt")      OVER (PARTITION BY "gene_id" ORDER BY "pval") AS "alt",
        MIN("pval") AS "pval"
    FROM best_per_gene_study
    GROUP BY "gene_id"
)

/* return the ten genes with the strongest (smallest) p‑values */
SELECT
    bp."gene_id",
    g."gene_name",
    bp."study_id",
    bp."chrom",
    bp."pos",
    bp."ref",
    bp."alt",
    bp."pval"
FROM best_per_gene bp
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.GENES g
       ON bp."gene_id" = g."gene_id"
ORDER BY bp."pval" ASC
LIMIT 10;
```
