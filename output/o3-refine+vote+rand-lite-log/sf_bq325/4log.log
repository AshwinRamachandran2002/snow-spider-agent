```sql
/* -----------------------------------------------------------
   Top‑10 genes with the strongest associations (smallest p‑values)
   Steps
   1)  Gather variant–gene rows (with p‑values) from two sources.
   2)  For every (gene, study) keep the variant that has the
       minimum p‑value in that study.
   3)  From those, keep the single best variant per gene
       (lowest p‑value across all studies).
   4)  Return the 10 genes with the overall smallest p‑values.
   ----------------------------------------------------------- */

WITH union_variants AS (          -- step 1
    SELECT
        "gene_id",
        "study_id",
        "tag_chrom"  AS "chrom",
        "tag_pos"    AS "pos",
        "tag_ref"    AS "ref",
        "tag_alt"    AS "alt",
        "pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE "pval" IS NOT NULL

    UNION ALL

    SELECT
        "gene_id",
        "study_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "pval"
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.SA_MOLECULAR_TRAIT
    WHERE "pval" IS NOT NULL
),

-- step 2 : best variant per (gene,study)
min_pval_gene_study AS (
    SELECT
        "gene_id",
        "study_id",
        MIN("pval") AS min_pval
    FROM union_variants
    GROUP BY "gene_id", "study_id"
),
best_gene_study AS (
    SELECT  /* tie‑breaker on (chrom,pos) if several variants share same p‑value */
        uv.*
    FROM union_variants uv
    JOIN min_pval_gene_study m
      ON uv."gene_id"  = m."gene_id"
     AND uv."study_id" = m."study_id"
     AND uv."pval"     = m.min_pval
    QUALIFY ROW_NUMBER() OVER (PARTITION BY uv."gene_id", uv."study_id"
                               ORDER BY uv."chrom", uv."pos") = 1
),

-- step 3 : best variant per gene (across all studies)
best_per_gene AS (
    SELECT
        bgs.*
    FROM best_gene_study bgs
    QUALIFY ROW_NUMBER() OVER (PARTITION BY "gene_id"
                               ORDER BY "pval") = 1
)

-- step 4 : final top‑10 list
SELECT
    bp."gene_id",
    g."gene_name",
    bp."study_id",
    bp."chrom",
    bp."pos",
    bp."ref",
    bp."alt",
    bp."pval"
FROM best_per_gene bp
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.GENES g
       ON bp."gene_id" = g."gene_id"
ORDER BY bp."pval" ASC
LIMIT 10;
```
