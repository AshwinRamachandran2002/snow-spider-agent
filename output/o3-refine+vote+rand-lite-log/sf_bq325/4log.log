```sql
/* -----------------------------------------------------------
   Goal : Top‑10 genes with the smallest variant p‑values
           (one best variant per gene, after first taking the
            best variant per gene‑per‑study inside each source)
   ----------------------------------------------------------- */
WITH
/* ---------- 1. best (gene,study) variants from disease table ---------- */
best_disease AS (
    SELECT
        "gene_id",
        "study_id",
        "tag_chrom"  AS "chrom",
        "tag_pos"    AS "pos",
        "tag_ref"    AS "ref",
        "tag_alt"    AS "alt",
        "pval",
        ROW_NUMBER() OVER (PARTITION BY "gene_id", "study_id"
                           ORDER BY "pval") AS rn
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.DISEASE_VARIANT_GENE
    WHERE "pval" IS NOT NULL
    QUALIFY rn = 1        -- keep only best per (gene,study)
),

/* ---------- 2. best (gene,study) variants from molecular‑trait table --- */
best_moltrait AS (
    SELECT
        "gene_id",
        "study_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "pval",
        ROW_NUMBER() OVER (PARTITION BY "gene_id", "study_id"
                           ORDER BY "pval") AS rn
    FROM OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.SA_MOLECULAR_TRAIT
    WHERE "pval" IS NOT NULL
    QUALIFY rn = 1
),

/* ---------- 3. combine both sources ----------------------------------- */
combined_best AS (
    SELECT * FROM best_disease
    UNION ALL
    SELECT * FROM best_moltrait
),

/* ---------- 4. best overall variant per gene --------------------------- */
best_per_gene AS (
    SELECT
        cb.*,
        ROW_NUMBER() OVER (PARTITION BY "gene_id"
                           ORDER BY "pval") AS gene_rn
    FROM combined_best cb
    QUALIFY gene_rn = 1    -- best variant for each gene across all studies
)

/* ---------- 5. top‑10 genes with strongest p‑values -------------------- */
SELECT
    bp."gene_id",
    g."gene_name",
    bp."study_id",
    bp."chrom",
    bp."pos",
    bp."ref",
    bp."alt",
    bp."pval"
FROM best_per_gene bp
LEFT JOIN OPEN_TARGETS_GENETICS_2.OPEN_TARGETS_GENETICS.GENES g
       ON bp."gene_id" = g."gene_id"
ORDER BY bp."pval" ASC
LIMIT 10;
```
