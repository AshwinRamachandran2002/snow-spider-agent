    GROUP BY DATE_TRUNC('hour', "DATETIME")
),

/*--------------------------------------------------------------------
  Solar Generation  (forecast id = 662 , actual id = 650)
--------------------------------------------------------------------*/
solar_forecast AS (
    SELECT
        "DATETIME",
        "VALUE"       AS "SOLAR_GEN_FORECAST",
