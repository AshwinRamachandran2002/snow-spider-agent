```sql
-- 1) Utah ZIP codes
WITH utah_zips AS (
  SELECT DISTINCT
         zip_code
  FROM `bigquery-public-data.geo_us_boundaries.zip_codes`
  WHERE state_code = 'UT'
),

-- 2) Number of FDIC bank locations per ZIP (first 5 characters of FDIC ZIP)
bank_locs AS (
  SELECT
    LPAD(SUBSTR(zip_code,1,5),5,'0') AS zip_code,
    COUNT(*)                    AS bank_cnt
  FROM `bigquery-public-data.fdic_banks.locations`
  WHERE zip_code IS NOT NULL
  GROUP BY zip_code
),

-- 3) Attach counts to Utah ZIPs and find the one(s) with the fewest banks
utah_bank_cnt AS (
  SELECT
    z.zip_code,
    COALESCE(b.bank_cnt,0) AS bank_cnt
  FROM utah_zips z
  LEFT JOIN bank_locs b
  USING (zip_code)
),
fewest_zip AS (
  SELECT
    zip_code
  FROM utah_bank_cnt
  ORDER BY bank_cnt ASC, zip_code          -- tie‑break by ZIP
  LIMIT 1
)

-- 4) Employment rate (ACS 2017 5‑year) for that ZIP code
SELECT
  RIGHT(a.geo_id,5)                 AS zip_code,
  a.employment_rate                 AS employment_rate_2017_population_16_plus
FROM `bigquery-public-data.census_bureau_acs.acs_2017_5yr` a
JOIN fewest_zip f
  ON RIGHT(a.geo_id,5) = f.zip_code
```
