Table full name: mitelman-db.prod.Cytogen
Column name: RefNo Type: INT64 Description: reference number (but treated as a string)
Column name: CaseNo Type: STRING Description: case number (usually a number, but can be a string, therefore treating as string)
Column name: Sex Type: STRING Description: one of 'M', 'F', or blank
Column name: Age Type: INT64 Description: can be blank, otherwise an integer between 0 and 100
Column name: Race Type: STRING Description: one of 'W', 'A', 'B', or 'O' (or blank)
Column name: Series Type: STRING Description: one of 'U', 'S', or 'D' (never blank)
Column name: Country Type: STRING Description: country code, eg '3020'
Column name: PrevTum Type: STRING Description: previous-tumor flag, either blank or 'Y'
Column name: PrevMorph Type: STRING Description: morphology code (eg '3111') for previous-tumor (frequently blank)
Column name: PrevTopo Type: STRING Description: topology code (eg '0401') for previous-tumor (frequently blank)
Column name: PrevTreat Type: STRING Description: one or more characters indicating previous treatment type(s), eg 'C', or 'C,R', or 'R,S' (or blank)
Column name: HerDis Type: STRING Description: hereditary disease code (eg '110')
Column name: SpecHerDis Type: STRING Description: specific hereditary disease, eg 'Fanconi anemia' or 'inv(9)(p11q13)'
Column name: Morph Type: STRING Description: morphology code, eg '1602'
Column name: SpecMorph Type: STRING Description: specific morphology, eg 'Aplastic anemia', or 'AML with cup-like nuclei'
Column name: Topo Type: STRING Description: topology code, eg '0902'
Column name: Immunology Type: STRING Description: most frequently blank, otherwise 'B' or 'T'
Column name: SpecObs Type: STRING Description: unknown/unnecessary field -- always blank
Column name: Origin Type: STRING Description: blank about half the time, otherwise 'L'
Column name: PatientID Type: STRING Description: unknown/unnecessary field -- always blank
Column name: PatientName Type: STRING Description: unknown/unnecessary field -- always blank
Column name: CaseOrder Type: INT64 Description: unknown integer field between 0 and 991807
Sample rows:
[{'RefNo': 223, 'CaseNo': '1', 'Sex': 'M', 'Age': 60, 'Race': 'W', 'Series': 'S', 'Country': '3020', 'PrevTum': ' ', 'PrevMorph': None, 'PrevTopo': None, 'PrevTreat': None, 'HerDis': None, 'SpecHerDis': None, 'Morph': '1010', 'SpecMorph': None, 'Topo': ' ', 'Immunology': None, 'SpecObs': None, 'Origin': ' ', 'PatientID': None, 'PatientName': None, 'CaseOrder': 1}, {'RefNo': 234, 'CaseNo': '4', 'Sex': 'F', 'Age': 67, 'Race': None, 'Series': 'U', 'Country': '6101', 'PrevTum': ' ', 'PrevMorph': None, 'PrevTopo': None, 'PrevTreat': None, 'HerDis': None, 'SpecHerDis': None, 'Morph': '1010', 'SpecMorph': None, 'Topo': ' ', 'Immunology': None, 'SpecObs': None, 'Origin': ' ', 'PatientID': None, 'PatientName': None, 'CaseOrder': 4}, {'RefNo': 427, 'CaseNo': '1', 'Sex': 'F', 'Age': 3, 'Race': None, 'Series': 'S', 'Country': '5270', 'PrevTum': ' ', 'PrevMorph': None, 'PrevTopo': None, 'PrevTreat': None, 'HerDis': None, 'SpecHerDis': None, 'Morph': '1010', 'SpecMorph': None, 'Topo': ' ', 'Immunology': None, 'SpecObs': None, 'Origin': ' ', 'PatientID': None, 'PatientName': None, 'CaseOrder': 1}, {'RefNo': 427, 'CaseNo': '2', 'Sex': 'F', 'Age': 2, 'Race': None, 'Series': 'S', 'Country': '5270', 'PrevTum': ' ', 'PrevMorph': None, 'PrevTopo': None, 'PrevTreat': None, 'HerDis': None, 'SpecHerDis': None, 'Morph': '1010', 'SpecMorph': None, 'Topo': ' ', 'Immunology': None, 'SpecObs': None, 'Origin': ' ', 'PatientID': None, 'PatientName': None, 'CaseOrder': 2}, {'RefNo': 428, 'CaseNo': '1', 'Sex': 'M', 'Age': 76, 'Race': None, 'Series': 'S', 'Country': '5260', 'PrevTum': ' ', 'PrevMorph': None, 'PrevTopo': None, 'PrevTreat': None, 'HerDis': None, 'SpecHerDis': None, 'Morph': '1010', 'SpecMorph': None, 'Topo': ' ', 'Immunology': None, 'SpecObs': None, 'Origin': ' ', 'PatientID': None, 'PatientName': None, 'CaseOrder': 1}]

