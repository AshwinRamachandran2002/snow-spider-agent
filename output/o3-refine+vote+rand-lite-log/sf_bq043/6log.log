```sql
/*  Bladder‑cancer (TCGA‑BLCA) RNA‑seq expression (FPKM) for
    MDM2, TP53, CDKN1A and CCNE1 in cases that harbour
    CDKN2A somatic mutations (hg19, Feb‑2017 MC3 set),
    together with selected clinical attributes from
    GDC clinical release 39                                      */

WITH mutated_cases AS (          -- BLCA cases with CDKN2A mutations
    SELECT DISTINCT "case_barcode"
    FROM TCGA.TCGA_VERSIONED."SOMATIC_MUTATION_HG19_MC3_2017_02"
    WHERE "project_short_name" = 'TCGA-BLCA'
      AND "Hugo_Symbol"        = 'CDKN2A'
),

rna_expression AS (             -- FPKM values for the 4 genes of interest
    SELECT
        r."case_barcode",
        r."sample_barcode",
        r."gene_name",
        r."HTSeq__FPKM"  AS "fpkm"
    FROM TCGA.TCGA_VERSIONED."RNASEQ_HG38_GDC_R39"  r
    JOIN mutated_cases mc
      ON r."case_barcode" = mc."case_barcode"
    WHERE r."project_short_name" = 'TCGA-BLCA'
      AND r."gene_name" IN ('MDM2', 'TP53', 'CDKN1A', 'CCNE1')
),

clinical AS (                   -- key clinical fields from GDC R39
    SELECT
        c."submitter_id"                     AS "case_barcode",
        c."demo__gender"                     AS "gender",
        c."demo__race"                       AS "race",
        c."demo__ethnicity"                  AS "ethnicity",
        c."demo__vital_status"               AS "vital_status",
        c."diag__ajcc_pathologic_stage"      AS "ajcc_stage",
        c."diag__year_of_diagnosis"          AS "year_of_diagnosis",
        c."diag__age_at_diagnosis"           AS "age_at_diagnosis"
    FROM TCGA.TCGA_VERSIONED."CLINICAL_GDC_R39"  c
    WHERE c."proj__project_id" = 'TCGA-BLCA'
)

SELECT
    e."case_barcode",
    e."sample_barcode",
    e."gene_name",
    e."fpkm",
    cl."gender",
    cl."race",
    cl."ethnicity",
    cl."vital_status",
    cl."ajcc_stage",
    cl."year_of_diagnosis",
    cl."age_at_diagnosis"
FROM rna_expression  e
LEFT JOIN clinical  cl
  ON e."case_barcode" = cl."case_barcode"
ORDER BY e."case_barcode",
         e."gene_name";
```
