```sql
SELECT
  name
FROM (
  SELECT
    wy.name,
    SUM(wy.number) AS wy_total,
    SUM(all_states.number) OVER (PARTITION BY wy.name) AS us_total,
    SUM(wy.number) / SUM(all_states.number) OVER (PARTITION BY wy.name) AS proportion
  FROM `bigquery-public-data.usa_names.usa_1910_current` AS wy
  JOIN `bigquery-public-data.usa_names.usa_1910_current` AS all_states
    ON wy.name = all_states.name
    AND wy.gender = all_states.gender
    AND wy.year = all_states.year
  WHERE
    wy.state = 'WY'
    AND wy.gender = 'F'
    AND wy.year = 2021
)
ORDER BY proportion DESC, name
LIMIT 1;
```
