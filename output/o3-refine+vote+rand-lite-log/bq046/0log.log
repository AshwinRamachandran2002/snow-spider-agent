```sql
/*  CASE BARCODES & CORRESPONDING FILE URLS  
    – Female (≤30 yrs) BRCA patients (TCGA)  
    – Exclude patients that have a Patient‑level annotation with  
      category = 'History of unacceptable prior treatment related to a prior/other malignancy'  
      OR classification = 'Redaction'  
    – Use GDC release 14 metadata to retrieve file URLs                                    */

WITH
/* 1)  Patients who have disqualifying annotations --------------------------------------- */
ann AS (
  SELECT
    case_barcode,
    category     AS categoryName,
    classification AS classificationName
  FROM `isb-cgc.TCGA_bioclin_v0.Annotations`
  WHERE entity_type = 'Patient'
    AND (category = 'History of unacceptable prior treatment related to a prior/other malignancy'
         OR classification = 'Redaction')
),

/* 2)  Female BRCA cases aged ≤ 30 -------------------------------------------------------- */
clin AS (
  SELECT
    case_barcode,
    case_gdc_id,
    gender,
    age_at_diagnosis
  FROM `isb-cgc.TCGA_bioclin_v0.Clinical`
  WHERE UPPER(disease_code) = 'BRCA'
    AND UPPER(gender)       = 'FEMALE'
    AND age_at_diagnosis    IS NOT NULL
    AND age_at_diagnosis   <= 30
),

/* 3)  FULL JOIN and keep only rows with no disqualifying annotation --------------------- */
valid_cases AS (
  SELECT DISTINCT
    COALESCE(c.case_barcode , a.case_barcode) AS case_barcode,
    c.case_gdc_id
  FROM clin c
  FULL JOIN ann a
    ON c.case_barcode = a.case_barcode
  WHERE a.categoryName      IS NULL         -- keep only if NO bad category
    AND a.classificationName IS NULL        -- and NO redaction classification
    AND c.case_gdc_id        IS NOT NULL    -- need the case UUID for file lookup
),

/* 4)  Attach file UUIDs from release‑14 current files ----------------------------------- */
case_files AS (
  SELECT
    v.case_barcode,
    f.file_id
  FROM valid_cases v
  JOIN `isb-cgc.GDC_metadata.rel14_fileData_current` f
    ON (f.associated_entities__case_id = v.case_gdc_id
        OR f.cases__case_id            = v.case_gdc_id)
),

/* 5)  Map file UUIDs to their Google‑Cloud Storage URLs --------------------------------- */
urls AS (
  SELECT DISTINCT
    cf.case_barcode,
    u.file_gdc_url
  FROM case_files cf
  JOIN `isb-cgc.GDC_metadata.rel14_GDCfileID_to_GCSurl_NEW` u
    ON u.file_gdc_id = cf.file_id
)

-- Final output ---------------------------------------------------------------------------
SELECT
  case_barcode,
  file_gdc_url
FROM urls
ORDER BY case_barcode;
```
