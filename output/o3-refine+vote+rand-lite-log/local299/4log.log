/* -----------------------------------------------------------
   Monthly total of summed “maximum 30‑day rolling‑average
   balances” for all customers, with each customer’s first
   calendar‑month of activity treated as a baseline and removed
   from the final results.
------------------------------------------------------------ */
WITH daily_change AS (          /* 1. net movement per customer per day */
    SELECT
        "customer_id",
        DATE("txn_date")                 AS txn_date,
        SUM(
            CASE
                WHEN "txn_type" = 'deposit' THEN  txn_amount      -- deposits add
                ELSE                         -txn_amount          -- every other type subtracts
            END
        )                                AS net_change
    FROM   customer_transactions
    GROUP  BY "customer_id",
             DATE("txn_date")
),

running_balance AS (            /* 2. running balance for every day     */
    SELECT
        "customer_id",
        txn_date,
        SUM(net_change) OVER (
            PARTITION BY "customer_id"
            ORDER BY     txn_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS balance
    FROM  daily_change
),

rolling_30 AS (                 /* 3. 30‑day rolling average of balance */
    SELECT
        r."customer_id",
        r.txn_date,
        /* how many rows (days) are actually in the 30‑row frame? */
        COUNT(*)  OVER (
            PARTITION BY r."customer_id"
            ORDER BY     r.txn_date
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                                               AS rows_in_frame,
        AVG(balance) OVER (
            PARTITION BY r."customer_id"
            ORDER BY     r.txn_date
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                                               AS avg_30_raw
    FROM running_balance r
),

rolling_30_clean AS (           /* 4. keep values only after 30 rows and clip negatives to 0 */
    SELECT
        "customer_id",
        txn_date,
        CASE
            WHEN rows_in_frame = 30 THEN
                 MAX(0, avg_30_raw)     -- negative averages become zero
            ELSE NULL                  -- before 30 rows: ignore
        END AS avg_30
    FROM rolling_30
),

monthly_customer_max AS (       /* 5. per‑customer, per‑month maximum of that 30‑day average */
    SELECT
        "customer_id",
        strftime('%Y-%m', txn_date) AS month_yr,
        MAX(avg_30)                 AS max_avg_30
    FROM rolling_30_clean
    WHERE avg_30 IS NOT NULL        -- discard days without a full 30‑day window
    GROUP BY "customer_id",
             month_yr
),

first_month AS (                /* 6. identify each customer’s first calendar month */
    SELECT
        "customer_id",
        strftime('%Y-%m', MIN(DATE(txn_date))) AS first_month_yr
    FROM customer_transactions
    GROUP BY "customer_id"
),

filtered_max AS (               /* 7. eliminate every customer’s baseline month */
    SELECT m.*
    FROM   monthly_customer_max m
    JOIN   first_month f
           ON m."customer_id" = f."customer_id"
    WHERE  m.month_yr <> f.first_month_yr
),

final_totals AS (               /* 8. sum the remaining maxima across all customers */
    SELECT
        month_yr                       AS month,
        ROUND(SUM(max_avg_30), 4)      AS total_of_max_30_day_avgs
    FROM   filtered_max
    GROUP  BY month_yr
    ORDER  BY month_yr
)

SELECT *
FROM   final_totals;
```
