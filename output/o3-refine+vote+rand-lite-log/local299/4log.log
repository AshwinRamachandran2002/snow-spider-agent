/*  Monthly totals of the summed, per‑customer maximum
    30‑day rolling‑average balances,
    excluding each customer’s first calendar‑month of activity  */

WITH daily_change AS (                 -- 1. net movement per customer per day
    SELECT
        customer_id,
        DATE(txn_date) AS txn_date,
        SUM(
            CASE
                 WHEN txn_type = 'deposit' THEN  txn_amount   -- deposits add
                 ELSE                     -txn_amount         -- everything else subtracts
            END
        ) AS net_change
    FROM   customer_transactions
    GROUP  BY customer_id,
             DATE(txn_date)
),

running_balance AS (                   -- 2. cumulative (running) balance
    SELECT
        customer_id,
        txn_date,
        SUM(net_change) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS balance
    FROM   daily_change
),

rolling_30 AS (                        -- 3. 30‑day rolling average of balance
    SELECT
        customer_id,
        txn_date,
        COUNT(*) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                                               AS days_in_window,
        AVG(balance) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                                               AS avg_30_raw
    FROM   running_balance
),

rolling_30_clean AS (                  -- 4. keep only full 30‑day windows, clip negatives
    SELECT
        customer_id,
        txn_date,
        CASE
            WHEN days_in_window = 30 THEN
                 CASE WHEN avg_30_raw < 0 THEN 0 ELSE avg_30_raw END
        END AS avg_30
    FROM   rolling_30
    WHERE  days_in_window = 30
),

monthly_customer_max AS (              -- 5. each customer’s max 30‑day avg per month
    SELECT
        customer_id,
        strftime('%Y-%m', txn_date)  AS month_yr,
        MAX(avg_30)                  AS max_avg_30
    FROM   rolling_30_clean
    GROUP  BY customer_id,
             month_yr
),

first_month AS (                       -- 6. first activity month for every customer
    SELECT
        customer_id,
        strftime('%Y-%m', MIN(DATE(txn_date))) AS first_month_yr
    FROM   customer_transactions
    GROUP  BY customer_id
),

filtered_max AS (                      -- 7. drop every customer’s baseline month
    SELECT  m.*
    FROM    monthly_customer_max m
    JOIN    first_month f
      ON    m.customer_id = f.customer_id
    WHERE   m.month_yr <> f.first_month_yr
)

SELECT
    month_yr                                          AS month,
    ROUND(SUM(max_avg_30), 4)                         AS monthly_total_max_30d_avg
FROM   filtered_max
GROUP  BY month_yr
ORDER  BY month_yr;
