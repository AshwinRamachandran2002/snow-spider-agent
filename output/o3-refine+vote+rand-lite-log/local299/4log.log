/*  -------------------------------------------------------------
    Monthly totals of the summed, per‑customer maximum
    30‑day rolling‑average balances,
    excluding each customer’s first calendar‑month of activity
    -------------------------------------------------------------
    – deposits add to the balance, every other txn_type subtracts
    – negative rolling‑averages are clipped to zero
    – missing calendar days are filled with a “0” net‑change so the
      30‑day window is always based on consecutive days
---------------------------------------------------------------- */

WITH daily_change AS (                 -- 1. net movement per customer per day
    SELECT
        customer_id,
        DATE(txn_date) AS txn_date,
        SUM(
            CASE
                 WHEN txn_type = 'deposit' THEN  txn_amount
                 ELSE                         -txn_amount
            END
        ) AS net_change
    FROM   customer_transactions
    GROUP  BY customer_id,
             DATE(txn_date)
),

/* 2. build a complete calendar for every customer so that
      the 30‑day window is truly “daily” even on days with
      no transactions                                              */
RECURSIVE calendar_dates(customer_id, txn_date, last_day) AS (
    SELECT
        customer_id,
        MIN(DATE(txn_date))                               AS txn_date,
        MAX(DATE(txn_date))                               AS last_day
    FROM   customer_transactions
    GROUP  BY customer_id

    UNION ALL

    SELECT
        customer_id,
        DATE(txn_date,'+1 day')                           AS txn_date,
        last_day
    FROM   calendar_dates
    WHERE  DATE(txn_date,'+1 day') <= last_day
),

all_days AS (                         -- 3. attach net_change (0 if none)
    SELECT
        c.customer_id,
        c.txn_date,
        COALESCE(d.net_change, 0)     AS net_change
    FROM   calendar_dates c
    LEFT   JOIN daily_change d
           ON  d.customer_id = c.customer_id
           AND d.txn_date   = c.txn_date
),

running_balance AS (                  -- 4. running balance per day
    SELECT
        customer_id,
        txn_date,
        SUM(net_change) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS balance
    FROM   all_days
),

rolling_30 AS (                       -- 5. 30‑day rolling average (needs 30 days)
    SELECT
        customer_id,
        txn_date,
        COUNT(*)  OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                       AS day_count,
        AVG(balance) OVER (
            PARTITION BY customer_id
            ORDER BY     txn_date
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        )                       AS avg_30_raw
    FROM   running_balance
),

rolling_30_clean AS (                 -- 6. keep only full 30‑day windows, clip negatives
    SELECT
        customer_id,
        txn_date,
        CASE
             WHEN day_count = 30
                  THEN CASE WHEN avg_30_raw < 0 THEN 0 ELSE avg_30_raw END
        END AS avg_30
    FROM   rolling_30
    WHERE  day_count = 30
),

monthly_customer_max AS (             -- 7. customer’s monthly maximum 30‑day average
    SELECT
        customer_id,
        strftime('%Y-%m', txn_date)  AS month_yr,
        MAX(avg_30)                  AS max_avg_30
    FROM   rolling_30_clean
    GROUP  BY customer_id,
             month_yr
),

first_month AS (                      -- 8. identify each customer’s baseline month
    SELECT
        customer_id,
        strftime('%Y-%m', MIN(DATE(txn_date))) AS first_month_yr
    FROM   customer_transactions
    GROUP  BY customer_id
),

filtered_max AS (                     -- 9. discard the baseline month
    SELECT  m.*
    FROM    monthly_customer_max m
    JOIN    first_month f
           ON m.customer_id = f.customer_id
    WHERE   m.month_yr <> f.first_month_yr
)

/* 10. final answer: sum of those maxima across all customers,
        reported per calendar month                                */
SELECT
    month_yr                                    AS month,
    ROUND(SUM(max_avg_30), 4)                   AS monthly_total_max_30d_avg
FROM   filtered_max
GROUP  BY month_yr
ORDER  BY month_yr;
