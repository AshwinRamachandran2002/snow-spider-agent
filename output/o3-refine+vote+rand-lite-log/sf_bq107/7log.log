```sql
WITH longest_ref AS (
    SELECT
        "name"  AS reference_name,
        "length"
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_REFERENCE_201703
    ORDER BY "length" DESC NULLS LAST
    LIMIT 1
),
variant_ct AS (
    SELECT
        COUNT(*) AS variant_count
    FROM GENOMICS_CANNABIS.GENOMICS_CANNABIS.MNPR01_TRANSCRIPTOME_201703 v
    JOIN longest_ref r
      ON v."reference_name" = r.reference_name
    WHERE EXISTS (
        SELECT 1
        FROM LATERAL FLATTEN(input => v."call") c      -- each call
        ,    LATERAL FLATTEN(input => c.value:"genotype") g   -- each genotype value
        WHERE g.value::INT > 0                         -- at least one allele > 0
    )
