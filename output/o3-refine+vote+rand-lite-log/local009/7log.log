```sql
WITH airport_coords AS (
    SELECT
        airport_code,
        /* coordinates are stored like '(longitude,latitude)' */
        CAST(SUBSTR(coordinates, 2, INSTR(coordinates, ',') - 2) AS REAL) AS lon,
        CAST(SUBSTR(coordinates, INSTR(coordinates, ',') + 1,
                     LENGTH(coordinates) - INSTR(coordinates, ',') - 1) AS REAL) AS lat
    FROM airports_data
),
abakan_airports AS (
    SELECT airport_code
    FROM airports_data
    WHERE json_extract(city, '$.en') = 'Abakan'
),
routes AS (
    /* flights where Abakan is either origin or destination */
    SELECT
        f.flight_id,
        d.lon AS lon1, d.lat AS lat1,
        a.lon AS lon2, a.lat AS lat2
    FROM flights AS f
    JOIN airport_coords AS d ON d.airport_code = f.departure_airport
    JOIN airport_coords AS a ON a.airport_code = f.arrival_airport
    WHERE f.departure_airport IN (SELECT airport_code FROM abakan_airports)
       OR f.arrival_airport   IN (SELECT airport_code FROM abakan_airports)
),
distances AS (
    /* great‑circle distance via spherical law of cosines (no SQRT needed) */
    SELECT
        flight_id,
        6371 * ACOS(
            CASE                /* guard against round‑off outside [-1,1] */
                WHEN cosine >  1 THEN  1
                WHEN cosine < -1 THEN -1
                ELSE cosine
            END
        ) AS distance_km
    FROM (
        SELECT
            flight_id,
            SIN(lat1 * 3.141592653589793 / 180.0) * SIN(lat2 * 3.141592653589793 / 180.0) +
            COS(lat1 * 3.141592653589793 / 180.0) * COS(lat2 * 3.141592653589793 / 180.0) *
            COS((lon2 - lon1) * 3.141592653589793 / 180.0)               AS cosine
        FROM routes
    )
)
SELECT MAX(distance_km) AS longest_abakan_route_km
FROM distances;
```
