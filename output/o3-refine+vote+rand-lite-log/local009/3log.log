```sql
WITH abakan_routes AS (            -- flights that start or finish in Abakan
    SELECT  f.flight_id,
            dep.coordinates AS dep_coord,
            arr.coordinates AS arr_coord
    FROM    flights         AS f
    JOIN    airports_data   AS dep  ON dep.airport_code = f.departure_airport
    JOIN    airports_data   AS arr  ON arr.airport_code = f.arrival_airport
    WHERE   json_extract(dep.city,'$.en') = 'Abakan'
        OR  json_extract(arr.city,'$.en') = 'Abakan'
),
coords AS (                        -- turn the (lon,lat) POINT into 4 numeric columns (degrees)
    SELECT  flight_id,
            CAST(substr(dep_clean ,1 ,instr(dep_clean ,',')-1) AS REAL) AS dep_lon_deg,
            CAST(substr(dep_clean ,instr(dep_clean,',')+1)      AS REAL) AS dep_lat_deg,
            CAST(substr(arr_clean ,1 ,instr(arr_clean ,',')-1) AS REAL) AS arr_lon_deg,
            CAST(substr(arr_clean ,instr(arr_clean,',')+1)      AS REAL) AS arr_lat_deg
    FROM (
        SELECT  flight_id,
                REPLACE(REPLACE(dep_coord,'(','') ,')','') AS dep_clean,
                REPLACE(REPLACE(arr_coord,'(','') ,')','') AS arr_clean
        FROM    abakan_routes
    )
),
calc AS (                          -- basic angular differences (radians)
    SELECT  flight_id,
            (arr_lat_deg - dep_lat_deg) * 0.017453292519943295  AS dlat,      -- Δφ
            (arr_lon_deg - dep_lon_deg) * 0.017453292519943295  AS dlon,      -- Δλ
            ((arr_lat_deg + dep_lat_deg)/2.0) * 0.017453292519943295          AS lat_avg
    FROM    coords
),
distances AS (                     -- planar‑on‑sphere approximation (needs only cos)
    SELECT  flight_id,
            6371.0 * sqrt( dlat*dlat +
                           (cos_lat_avg*cos_lat_avg) * dlon*dlon ) AS distance_km
    FROM (
        SELECT  c.flight_id,
                c.dlat,
                c.dlon,
                /* cosine via 6‑term Taylor series: cos x ≈ 1 − x²/2 + x⁴/24 − x⁶/720 */
                (1.0 - lat2/2.0 + lat4/24.0 - lat6/720.0) AS cos_lat_avg
        FROM (
            SELECT  flight_id,
                    dlat,
                    dlon,
                    lat_avg,
                    lat_avg*lat_avg                                   AS lat2,
                    (lat_avg*lat_avg)*(lat_avg*lat_avg)               AS lat4,
                    (lat_avg*lat_avg)*(lat_avg*lat_avg)*(lat_avg*lat_avg) AS lat6
            FROM    calc
        ) AS c
    )
)
SELECT  MAX(distance_km) AS longest_route_km
FROM    distances;
