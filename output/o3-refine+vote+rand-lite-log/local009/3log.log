```sql
WITH abakan_routes AS (
    /* flights that depart from, or arrive to, the city of Abakan */
    SELECT  f.flight_id,
            dep.coordinates AS dep_coord,
            arr.coordinates AS arr_coord
    FROM    flights         AS f
    JOIN    airports_data   AS dep  ON dep.airport_code = f.departure_airport
    JOIN    airports_data   AS arr  ON arr.airport_code = f.arrival_airport
    WHERE   json_extract(dep.city ,'$.en') = 'Abakan'
       OR   json_extract(arr.city ,'$.en') = 'Abakan'
),
coords AS (
    /* obtain the four geographic coordinates (in degrees) */
    SELECT  flight_id,
            CAST( substr(dep_clean ,1 ,instr(dep_clean ,',')-1) AS REAL) AS dep_lon_deg,
            CAST( substr(dep_clean ,instr(dep_clean,',')+1)      AS REAL) AS dep_lat_deg,
            CAST( substr(arr_clean ,1 ,instr(arr_clean ,',')-1) AS REAL) AS arr_lon_deg,
            CAST( substr(arr_clean ,instr(arr_clean,',')+1)      AS REAL) AS arr_lat_deg
    FROM (
        SELECT  flight_id,
                REPLACE(REPLACE(dep_coord,'(','') ,')','') AS dep_clean,
                REPLACE(REPLACE(arr_coord,'(','') ,')','') AS arr_clean
        FROM    abakan_routes
    )
),
distances AS (
    /* haversine formula (all angles converted to radians first) */
    SELECT  flight_id,
            6371.0 * 2.0 *                                    -- Earth radius (km) * central angle
            atan2(
                sqrt(h), sqrt(1.0 - h)
            ) AS distance_km
    FROM (
        SELECT  flight_id,
                /* convert degrees to radians */
                dep_lat_deg*0.017453292519943295  AS dep_lat,
                arr_lat_deg*0.017453292519943295  AS arr_lat,
                dep_lon_deg*0.017453292519943295  AS dep_lon,
                arr_lon_deg*0.017453292519943295  AS arr_lon,
                /* haversine "a" component */
                ( sin((arr_lat_deg*0.017453292519943295 - dep_lat_deg*0.017453292519943295)/2.0)
                  * sin((arr_lat_deg*0.017453292519943295 - dep_lat_deg*0.017453292519943295)/2.0)
                  + cos(dep_lat_deg*0.017453292519943295)
                  * cos(arr_lat_deg*0.017453292519943295)
                  * sin((arr_lon_deg*0.017453292519943295 - dep_lon_deg*0.017453292519943295)/2.0)
                  * sin((arr_lon_deg*0.017453292519943295 - dep_lon_deg*0.017453292519943295)/2.0)
                ) AS h
        FROM coords
    )
)
SELECT MAX(distance_km) AS longest_route_km
FROM   distances;
```
