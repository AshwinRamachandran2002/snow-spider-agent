```sql
WITH cte_flights AS (
    SELECT  f.flight_id,
            dep.airport_code  AS dep_code,
            arr.airport_code  AS arr_code,
            dep.coordinates   AS dep_coord,
            arr.coordinates   AS arr_coord
    FROM    flights AS f
    JOIN    airports_data AS dep ON dep.airport_code = f.departure_airport
    JOIN    airports_data AS arr ON arr.airport_code = f.arrival_airport
    WHERE   json_extract(dep.city,'$.en') = 'Abakan'
        OR  json_extract(arr.city,'$.en') = 'Abakan'
),
cte_parsed AS (
    SELECT  flight_id,
            /* departure longitude & latitude */
            CAST( substr(dep_coord, 2,
                         instr(dep_coord, ',') - 2)                   AS REAL) AS dep_lon,
            CAST( replace(substr(dep_coord,
                         instr(dep_coord, ',') + 1), ')','')         AS REAL) AS dep_lat,
            /* arrival longitude & latitude */
            CAST( substr(arr_coord, 2,
                         instr(arr_coord, ',') - 2)                   AS REAL) AS arr_lon,
            CAST( replace(substr(arr_coord,
                         instr(arr_coord, ',') + 1), ')','')         AS REAL) AS arr_lat
    FROM    cte_flights
),
cte_distances AS (
    SELECT  flight_id,
            6371 * 2 * ASIN(
                   SQRT(
                       POWER( SIN( ( (arr_lat - dep_lat) * 3.141592653589793 / 180 ) / 2 ), 2 )
                       + COS( dep_lat * 3.141592653589793 / 180 )
                       * COS( arr_lat * 3.141592653589793 / 180 )
                       * POWER( SIN( ( (arr_lon - dep_lon) * 3.141592653589793 / 180 ) / 2 ), 2 )
                   )
            ) AS distance_km
    FROM    cte_parsed
)
SELECT MAX(distance_km) AS longest_route_km
FROM   cte_distances;
```
