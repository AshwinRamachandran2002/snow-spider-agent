```sql
WITH
/*--------------------------------------------------------------------
1.  Ports in region 6585 that are located inside a U.S. state polygon
--------------------------------------------------------------------*/
us_ports AS (
    SELECT
        p."index_number"                          AS port_id,
        p."port_name",
        s."state_name",
        TO_GEOGRAPHY(p."port_geom")               AS port_geog
    FROM NOAA_PORTS.GEO_INTERNATIONAL_PORTS."WORLD_PORT_INDEX"  p
    JOIN NOAA_PORTS.GEO_US_BOUNDARIES."STATES"    s
          ON ST_WITHIN( TO_GEOGRAPHY(p."port_geom")
                       ,TO_GEOGRAPHY(s."state_geom") )
    WHERE p."region_number" = '6585'              -- requested region
      AND p."country"       = 'US'                -- only U.S. ports
),

/*--------------------------------------------------------------------
2.  North‑Atlantic named storms that meet wind / category thresholds
    – build a GEOGRAPHY point for every 6‑hour fix
--------------------------------------------------------------------*/
atl_storm_pts AS (
    SELECT
        h."sid",
        h."name",
        h."usa_sshs"                              AS cat,          -- Saffir‑Simpson category
        h."usa_wind"                              AS wind_kt,      -- kts
        DATE_PART('year', TO_TIMESTAMP_NTZ(h."iso_time"/1000)) AS storm_year,
        TO_GEOGRAPHY(
            'POINT(' || h."longitude" || ' ' || h."latitude" || ')'
        )                                         AS storm_geog
    FROM NOAA_PORTS.NOAA_HURRICANES."HURRICANES"  h
    WHERE h."basin"       = 'NA'                  -- North Atlantic basin
      AND h."usa_wind"   >= 35                   -- ≥ 35 kt
      AND h."usa_sshs"   >= 0                    -- at least TS category
      AND h."name"      IS NOT NULL
),

/*--------------------------------------------------------------------
3.  Spatial join – a storm “affects” a port if any 6‑hour fix
    is within 50 nautical miles ≈ 92 600 m
--------------------------------------------------------------------*/
port_storm_hits AS (
    SELECT
        p.port_id,
        p."port_name",
        p."state_name",
        s."sid",
        s."name",
        s.storm_year,
        s.cat,
        s.wind_kt,
        p.port_geog,
        s.storm_geog
    FROM us_ports          p
    JOIN atl_storm_pts     s
      ON ST_DISTANCE(p.port_geog, s.storm_geog) <= 92600   -- 50 nm buffer
)

/*--------------------------------------------------------------------
4.  Aggregate per port
--------------------------------------------------------------------*/
SELECT
    port_id,
    "port_name",
    "state_name",
    ARRAY_AGG(DISTINCT storm_year)                      AS years_impacted,
    COUNT(DISTINCT sid)                                 AS distinct_storms,
    ARRAY_AGG(DISTINCT name)                            AS storm_names,
    ROUND(AVG(cat),2)                                   AS avg_category,
    ROUND(AVG(wind_kt),2)                               AS avg_wind_kt,
    port_geog                                           AS port_geometry,
    ST_COLLECT(ARRAY_AGG(DISTINCT storm_geog))          AS storm_geometries
FROM port_storm_hits
GROUP BY port_id, "port_name", "state_name", port_geog
ORDER BY "port_name";
```
