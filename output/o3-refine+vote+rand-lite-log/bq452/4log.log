    pos_end,
    cases_ref,
    cases_alt,
    controls_ref,
    controls_alt,
    tot_cases,
    tot_ctrls,
    -- expected counts
    tot_cases * tot_ref / tot_all AS exp_cr,
    tot_cases * tot_alt / tot_all AS exp_ca,
    tot_ctrls * tot_ref / tot_all AS exp_nr,
    tot_ctrls * tot_alt / tot_all AS exp_na
  FROM chi_pre
),
-- 5. Chi‑square with Yates’s correction; keep rows with all expected ≥ 5
