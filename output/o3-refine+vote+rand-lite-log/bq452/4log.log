      POW(ABS(eas_ref - exp_eas_ref) - 0.5, 2) / exp_eas_ref +
      POW(ABS(eas_alt - exp_eas_alt) - 0.5, 2) / exp_eas_alt +
      POW(ABS(oth_ref - exp_oth_ref) - 0.5, 2) / exp_oth_ref +
      POW(ABS(oth_alt - exp_oth_alt) - 0.5, 2) / exp_oth_alt
    ) AS chi_squared
  FROM expected
  WHERE exp_eas_ref >= 5 AND exp_eas_alt >= 5
    AND exp_oth_ref >= 5 AND exp_oth_alt >= 5
)
-- 6. Return variants with χ² ≥ 29.71679
SELECT
  pos_start AS start_pos,
  pos_end   AS end_pos,
  chi_squared
FROM chi_sq
WHERE chi_squared >= 29.71679
ORDER BY chi_squared DESC, start_pos;
