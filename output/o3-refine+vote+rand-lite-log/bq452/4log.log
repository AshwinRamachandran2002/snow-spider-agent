/* Identify chromosome‑12 variants whose allele distribution differs
   between EAS (cases) and non‑EAS (controls).
   Chi‑square test uses Yates’s correction; keep rows with every
   expected count ≥ 5 and χ² ≥ 29.71679. */
WITH
-- 1. Expand call records and count reference (0) and first‑alternate (1) alleles
calls AS (
  SELECT
    v.`start` AS pos_start,
    v.`end`   AS pos_end,
    c.call_set_name                   AS sample_id,
    (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) g) AS ref_cnt,
    (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) g) AS alt_cnt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '12'            -- chromosome 12 only
    AND ARRAY_LENGTH(v.alternate_bases) = 1 -- biallelic sites
),
-- 2. Attach super‑population label
calls_with_pop AS (
  SELECT
    pos_start,
    pos_end,
    s.Super_Population AS super_pop,
    ref_cnt,
    alt_cnt
  FROM calls
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = calls.sample_id
  WHERE s.Super_Population IS NOT NULL
),
-- 3. Aggregate allele counts by variant and group
allele_counts AS (
  SELECT
    pos_start,
    pos_end,
    SUM(IF(super_pop = 'EAS', ref_cnt, 0)) AS cases_ref,
    SUM(IF(super_pop = 'EAS', alt_cnt, 0)) AS cases_alt,
    SUM(IF(super_pop != 'EAS', ref_cnt, 0)) AS controls_ref,
    SUM(IF(super_pop != 'EAS', alt_cnt, 0)) AS controls_alt
  FROM calls_with_pop
  GROUP BY pos_start, pos_end
),
-- 4. Totals & expected counts
chi_pre AS (
  SELECT
    pos_start,
    pos_end,
    cases_ref,
    cases_alt,
    controls_ref,
    controls_alt,
    (cases_ref + cases_alt)                               AS tot_cases,
    (controls_ref + controls_alt)                         AS tot_ctrls,
    (cases_ref + cases_alt + controls_ref + controls_alt) AS tot_all,
    (cases_ref + controls_ref)                            AS tot_ref,
    (cases_alt + controls_alt)                            AS tot_alt
  FROM allele_counts
),
expected AS (
