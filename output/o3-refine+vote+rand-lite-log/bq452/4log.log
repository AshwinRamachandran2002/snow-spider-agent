/*  Chromosome‑12 variants whose allele distribution differs
    between East Asian (EAS) samples and all other samples.
    EAS populations: CHB, JPT, CHS, CDX, KHV                         */

WITH
-- 1.  Unnest genotype calls and count ref/alt alleles per sample
calls AS (
  SELECT
    v.start AS pos_start,
    v.end   AS pos_end,
    c.call_set_name                     AS sample_id,
    (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) g) AS ref_cnt,
    (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) g) AS alt_cnt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '12'          -- chromosome 12 only
    AND ARRAY_LENGTH(v.alternate_bases) = 1   -- biallelic sites
),
-- 2.  Attach population code from pedigree and derive EAS / OTHER tag
calls_with_group AS (
  SELECT
    pos_start,
    pos_end,
    CASE
      WHEN p.Population IN ('CHB','JPT','CHS','CDX','KHV') THEN 'EAS'
      ELSE 'OTHER'
    END                      AS grp,
    ref_cnt,
    alt_cnt
  FROM calls AS cl
  JOIN `spider2-public-data.1000_genomes.pedigree` AS p
    ON p.Individual_ID = cl.sample_id
),
-- 3.  Aggregate allele counts per variant and group
agg AS (
  SELECT
    pos_start,
    pos_end,
    SUM(IF(grp = 'EAS',   ref_cnt, 0)) AS eas_ref,
    SUM(IF(grp = 'EAS',   alt_cnt, 0)) AS eas_alt,
    SUM(IF(grp = 'OTHER', ref_cnt, 0)) AS oth_ref,
    SUM(IF(grp = 'OTHER', alt_cnt, 0)) AS oth_alt
  FROM calls_with_group
  GROUP BY pos_start, pos_end
),
-- 4.  Compute totals, expected counts and Yates‑corrected χ²
stats AS (
  SELECT
    pos_start,
    pos_end,
    eas_ref,
    eas_alt,
    oth_ref,
    oth_alt,
    (eas_ref + eas_alt)                     AS n_eas,
    (oth_ref + oth_alt)                     AS n_oth,
    (eas_ref + eas_alt + oth_ref + oth_alt) AS n_tot,
    (eas_ref + oth_ref)                     AS n_ref,
    (eas_alt + oth_alt)                     AS n_alt
  FROM agg
),
expected AS (
  SELECT
    pos_start,
    pos_end,
    eas_ref, eas_alt, oth_ref, oth_alt,
    n_eas, n_oth, n_tot, n_ref, n_alt,
    n_eas * n_ref / n_tot AS exp_eas_ref,
    n_eas * n_alt / n_tot AS exp_eas_alt,
    n_oth * n_ref / n_tot AS exp_oth_ref,
    n_oth * n_alt / n_tot AS exp_oth_alt
  FROM stats
),
chi_squared AS (
  SELECT
    pos_start,
    pos_end,
    (
      POW(ABS(eas_ref -  exp_eas_ref) - 0.5, 2) / exp_eas_ref +
      POW(ABS(eas_alt -  exp_eas_alt) - 0.5, 2) / exp_eas_alt +
      POW(ABS(oth_ref -  exp_oth_ref) - 0.5, 2) / exp_oth_ref +
      POW(ABS(oth_alt -  exp_oth_alt) - 0.5, 2) / exp_oth_alt
    ) AS chi_sq
  FROM expected
  WHERE exp_eas_ref  >= 5 AND exp_eas_alt  >= 5
    AND exp_oth_ref  >= 5 AND exp_oth_alt  >= 5          -- expected counts ≥ 5
)
-- 5.  Return variants with χ² ≥ 29.71679
SELECT
  pos_start AS start,
  pos_end   AS end,
  chi_sq    AS chi_squared
FROM chi_squared
WHERE chi_sq >= 29.71679
ORDER BY chi_squared DESC, start;
