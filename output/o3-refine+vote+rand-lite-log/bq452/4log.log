```sql
-- Variants on chr 12 whose allele distribution differs between
-- EAS (cases) and all other super populations (controls).
-- Chi–square uses Yates’s correction and only keeps variants
-- whose four expected counts are ≥ 5 and χ² ≥ 29.71679.
WITH
-- 1.  Expand the calls and count reference (0) and first‑alternate (1) alleles
calls AS (
  SELECT
    v.start,
    v.end,
    c.call_set_name       AS sample,
    (SELECT COUNTIF(g = 0) FROM UNNEST(c.genotype) g) AS ref_cnt,
    (SELECT COUNTIF(g = 1) FROM UNNEST(c.genotype) g) AS alt_cnt
  FROM `spider2-public-data.1000_genomes.variants` v
  CROSS JOIN UNNEST(v.call) AS c
  WHERE v.reference_name = '12'                       -- chromosome 12 only
    AND ARRAY_LENGTH(v.alternate_bases) = 1           -- keep biallelic sites
),
-- 2.  Attach super–population label
calls_with_pop AS (
  SELECT
    start,
    end,
    s.Super_Population AS super_pop,
    ref_cnt,
    alt_cnt
  FROM calls
  JOIN `spider2-public-data.1000_genomes.sample_info` AS s
    ON s.Sample = calls.sample
  WHERE s.Super_Population IS NOT NULL                -- ignore samples lacking label
),
-- 3.  Aggregate allele counts by variant and group
allele_counts AS (
  SELECT
    start,
    end,
    SUM(IF(super_pop = 'EAS', ref_cnt, 0)) AS cases_ref,
    SUM(IF(super_pop = 'EAS', alt_cnt, 0)) AS cases_alt,
    SUM(IF(super_pop != 'EAS', ref_cnt, 0)) AS controls_ref,
    SUM(IF(super_pop != 'EAS', alt_cnt, 0)) AS controls_alt
  FROM calls_with_pop
  GROUP BY start, end
),
-- 4.  Compute totals, expected counts and Yates‑corrected χ²
chi_stats AS (
  SELECT
    start,
    end,
    cases_ref,
    cases_alt,
    controls_ref,
    controls_alt,
    (cases_ref + cases_alt)                           AS tot_cases,
    (controls_ref + controls_alt)                     AS tot_ctrls,
    (cases_ref + cases_alt + controls_ref + controls_alt) AS tot_alleles,
    (cases_ref + controls_ref)                        AS tot_ref,
    (cases_alt + controls_alt)                        AS tot_alt
  FROM allele_counts
),
chi_sq AS (
  SELECT
    start,
    end,
    -- expected counts
    tot_cases * tot_ref / tot_alleles   AS exp_cr,
    tot_cases * tot_alt / tot_alleles   AS exp_ca,
    tot_ctrls * tot_ref / tot_alleles   AS exp_nr,
    tot_ctrls * tot_alt / tot_alleles   AS exp_na,
    cases_ref,
    cases_alt,
    controls_ref,
    controls_alt
  FROM chi_stats
),
-- 5.  Keep variants with all expected counts ≥ 5 and χ² ≥ threshold
filtered AS (
  SELECT
    start,
    end,
    (
      POW(ABS(cases_ref   - exp_cr) - 0.5, 2) / exp_cr +
      POW(ABS(cases_alt   - exp_ca) - 0.5, 2) / exp_ca +
      POW(ABS(controls_ref- exp_nr) - 0.5, 2) / exp_nr +
      POW(ABS(controls_alt- exp_na) - 0.5, 2) / exp_na
    ) AS chi_squared
  FROM chi_sq
  WHERE exp_cr >= 5 AND exp_ca >= 5 AND exp_nr >= 5 AND exp_na >= 5
)
-- 6.  Output variants whose χ² ≥ 29.71679, ordered by χ² desc
SELECT
  start,
  end,
  chi_squared
FROM filtered
WHERE chi_squared >= 29.71679
ORDER BY chi_squared DESC, start;
```
