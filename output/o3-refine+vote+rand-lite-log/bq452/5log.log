    ) AS chi_sq
  FROM filtered
)
SELECT
  start_pos AS start,
  end_pos   AS `end`,
  ROUND(chi_sq, 5) AS chi_squared
FROM chi2
WHERE chi_sq >= 29.71679
ORDER BY chi_sq DESC, start_pos;
