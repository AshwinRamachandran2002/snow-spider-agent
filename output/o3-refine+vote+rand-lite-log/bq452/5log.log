```sql
-- variants on chr12 whose allele–group association is highly significant
WITH sample_labels AS (
  SELECT
    Sample AS sample_id,
    Super_Population
  FROM `spider2-public-data.1000_genomes.sample_info`
),
allele_counts AS (
  -- count reference (0) and alternate (1) alleles in cases (EAS) and controls (non‑EAS)
  SELECT
    v.start,
    v.end,
    SUM(CASE WHEN sl.Super_Population = 'EAS' AND g = 0 THEN 1 END) AS cases_ref,
    SUM(CASE WHEN sl.Super_Population = 'EAS' AND g = 1 THEN 1 END) AS cases_alt,
    SUM(CASE WHEN sl.Super_Population <> 'EAS' AND g = 0 THEN 1 END) AS controls_ref,
    SUM(CASE WHEN sl.Super_Population <> 'EAS' AND g = 1 THEN 1 END) AS controls_alt
  FROM `spider2-public-data.1000_genomes.variants` AS v
  JOIN UNNEST(v.call)            AS c
  JOIN UNNEST(c.genotype)        AS g           -- each chromosome of each sample
  JOIN sample_labels             AS sl
    ON sl.sample_id = c.call_set_name
  WHERE v.reference_name = '12'                 -- chromosome 12 only
    AND ARRAY_LENGTH(v.alternate_bases) = 1     -- bi‑allelic sites
    AND g IN (0,1)                              -- ignore missing / multi‑allelic codes
  GROUP BY v.start, v.end
),
stats AS (
  -- totals and expectations
  SELECT
    start,
    end,
    cases_ref, cases_alt, controls_ref, controls_alt,
    (cases_ref + cases_alt)                       AS n_cases,
    (controls_ref + controls_alt)                 AS n_ctrls,
    (cases_ref + controls_ref)                    AS n_ref,
    (cases_alt + controls_alt)                    AS n_alt,
    (cases_ref + cases_alt + controls_ref + controls_alt) AS n_tot
  FROM allele_counts
),
chi2_calc AS (
  SELECT
    start,
    end,
    -- expected counts
    n_cases * n_ref / n_tot  AS e_cases_ref,
    n_cases * n_alt / n_tot  AS e_cases_alt,
    n_ctrls * n_ref / n_tot  AS e_ctrl_ref,
    n_ctrls * n_alt / n_tot  AS e_ctrl_alt,
    cases_ref, cases_alt, controls_ref, controls_alt
  FROM stats
  -- keep only rows where every expected count ≥ 5
  WHERE
    n_cases * n_ref / n_tot  >= 5 AND
    n_cases * n_alt / n_tot  >= 5 AND
    n_ctrls * n_ref / n_tot  >= 5 AND
    n_ctrls * n_alt / n_tot  >= 5
)
SELECT
  start,
  end,
  ROUND(               -- Yates‑corrected χ² statistic
    (POW(GREATEST(0, ABS(cases_ref   - e_cases_ref ) - 0.5), 2) / e_cases_ref ) +
    (POW(GREATEST(0, ABS(cases_alt   - e_cases_alt ) - 0.5), 2) / e_cases_alt ) +
    (POW(GREATEST(0, ABS(controls_ref- e_ctrl_ref  ) - 0.5), 2) / e_ctrl_ref  ) +
    (POW(GREATEST(0, ABS(controls_alt- e_ctrl_alt  ) - 0.5), 2) / e_ctrl_alt  )
  , 5) AS chi_squared
FROM chi2_calc
WHERE
  (POW(GREATEST(0, ABS(cases_ref   - e_cases_ref ) - 0.5), 2) / e_cases_ref ) +
  (POW(GREATEST(0, ABS(cases_alt   - e_cases_alt ) - 0.5), 2) / e_cases_alt ) +
  (POW(GREATEST(0, ABS(controls_ref- e_ctrl_ref  ) - 0.5), 2) / e_ctrl_ref  ) +
  (POW(GREATEST(0, ABS(controls_alt- e_ctrl_alt  ) - 0.5), 2) / e_ctrl_alt  ) >= 29.71679
ORDER BY chi_squared DESC, start;
```
