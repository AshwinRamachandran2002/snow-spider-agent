  SELECT
    Sample AS sample_id,
    Super_Population
  FROM `bigquery-public-data.genomics_1000_genomes.sample_info`
),
allele_tally AS (                          -- count each allele (0 = ref, 1 = alt)
  SELECT
    v.start         AS start_pos,
    v.end           AS end_pos,
    SUM(CASE WHEN sl.Super_Population = 'EAS' AND g = 0 THEN 1 ELSE 0 END) AS cases_ref,
    SUM(CASE WHEN sl.Super_Population = 'EAS' AND g = 1 THEN 1 ELSE 0 END) AS cases_alt,
    SUM(CASE WHEN sl.Super_Population <> 'EAS' AND g = 0 THEN 1 ELSE 0 END) AS controls_ref,
    SUM(CASE WHEN sl.Super_Population <> 'EAS' AND g = 1 THEN 1 ELSE 0 END) AS controls_alt
  FROM `bigquery-public-data.genomics_1000_genomes.variants` AS v
  JOIN UNNEST(v.call)     AS c
  JOIN UNNEST(c.genotype) AS g
  JOIN sample_labels      AS sl
    ON sl.sample_id = c.call_set_name
  WHERE v.reference_name = '12'                -- chromosome 12 only
    AND ARRAY_LENGTH(v.alternate_bases) = 1    -- bi‑allelic variants
    AND g IN (0, 1)                            -- ignore missing / non‑diploid codes
  GROUP BY start_pos, end_pos
),
stats AS (                                  -- totals and allele expectations
  SELECT
    start_pos,
    end_pos,
    cases_ref, cases_alt, controls_ref, controls_alt,
    (cases_ref + cases_alt)                               AS n_cases,
    (controls_ref + controls_alt)                         AS n_ctrls,
    (cases_ref + controls_ref)                            AS n_ref,
    (cases_alt + controls_alt)                            AS n_alt,
    (cases_ref + cases_alt + controls_ref + controls_alt) AS n_tot
  FROM allele_tally
),
filtered AS (                               -- retain rows with all expected counts ≥ 5
  SELECT
    *,
    n_cases  * n_ref / n_tot AS e_cases_ref,
    n_cases  * n_alt / n_tot AS e_cases_alt,
    n_ctrls  * n_ref / n_tot AS e_ctrl_ref,
    n_ctrls  * n_alt / n_tot AS e_ctrl_alt
