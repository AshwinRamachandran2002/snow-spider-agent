WITH sample_pop AS (
  SELECT
    Sample AS sample_id,
    Super_Population
  FROM
    `spider2-public-data.1000_genomes.sample_info`
),
-- 1. Count reference (allele 0) and alternate (allele 1) alleles
--    in EAS (cases) versus non‑EAS (controls) for every Chr‑12 variant
variant_counts AS (
  SELECT
    v.start AS start_pos,
    v.end   AS end_pos,
    SUM(IF(sp.Super_Population = 'EAS' AND allele = 1, 1, 0)) AS cases_alt,
    SUM(IF(sp.Super_Population = 'EAS' AND allele = 0, 1, 0)) AS cases_ref,
    SUM(IF((sp.Super_Population <> 'EAS' OR sp.Super_Population IS NULL)
           AND allele = 1, 1, 0))                             AS controls_alt,
    SUM(IF((sp.Super_Population <> 'EAS' OR sp.Super_Population IS NULL)
           AND allele = 0, 1, 0))                             AS controls_ref
  FROM
    `spider2-public-data.1000_genomes.variants` AS v
  JOIN
    UNNEST(v.call)        AS c
  LEFT JOIN
    sample_pop            AS sp
  ON
    sp.sample_id = c.call_set_name
  JOIN
    UNNEST(c.genotype)    AS allele
  WHERE
    v.reference_name = '12'
    AND allele IN (0, 1)          -- ignore missing / multi‑allelic codes
  GROUP BY
    start_pos, end_pos
),
-- 2. Compute expected counts, keep rows where every expected count ≥ 5
stats AS (
  SELECT
    *,
    (cases_alt + cases_ref)                AS row_cases,
    (controls_alt + controls_ref)          AS row_ctrls,
    (cases_alt + controls_alt)             AS col_alt,
    (cases_ref + controls_ref)             AS col_ref,
    (cases_alt + cases_ref + controls_alt + controls_ref) AS n
  FROM
    variant_counts
),
filtered AS (
  SELECT
    *,
    (row_cases * col_alt) / n AS exp_a,
    (row_cases * col_ref) / n AS exp_b,
    (row_ctrls * col_alt) / n AS exp_c,
    (row_ctrls * col_ref) / n AS exp_d
  FROM
    stats
  WHERE
    n > 0
    AND (row_cases * col_alt) / n  >= 5
    AND (row_cases * col_ref) / n  >= 5
    AND (row_ctrls * col_alt) / n  >= 5
    AND (row_ctrls * col_ref) / n  >= 5
),
-- 3. Chi‑squared statistic with Yates’s correction
chi_sq AS (
  SELECT
    start_pos,
    end_pos,
    cases_alt    AS a,
    cases_ref    AS b,
    controls_alt AS c,
    controls_ref AS d,
    n,
    (n * POW(GREATEST(0.0, ABS(a * d - b * c) - n / 2.0), 2))
      / ((a + b) * (c + d) * (a + c) * (b + d)) AS chi_squared
  FROM
    filtered
)
-- 4. Return variants whose χ² ≥ 29.71679
SELECT
  start_pos AS start,
  end_pos   AS end,
  chi_squared
FROM
  chi_sq
WHERE
  chi_squared >= 29.71679
ORDER BY
  chi_squared DESC,
  start;
