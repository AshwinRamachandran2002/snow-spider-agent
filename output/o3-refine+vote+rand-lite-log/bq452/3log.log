```sql
/*-----------------------------------------------------------
  Identify chromosome‑12 variants whose allele distribution
  differs between EAS (cases) and non‑EAS (controls)
  with χ² ≥ 29.71679 (Yates‑corrected) and adequate
  expected counts (≥ 5 in every cell)
-----------------------------------------------------------*/
WITH sample_pop AS (
  SELECT
    sample_id,
    super_population
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_sample_info`
),
variant_counts AS (
  /* Count alleles in cases vs controls for each variant */
  SELECT
    v.start_position AS start_pos,
    v.end_position   AS end_pos,
    SUM(IF(sp.super_population = 'EAS' AND allele = 1, 1, 0)) AS cases_alt,
    SUM(IF(sp.super_population = 'EAS' AND allele = 0, 1, 0)) AS cases_ref,
    SUM(IF((sp.super_population <> 'EAS' OR sp.super_population IS NULL)
           AND allele = 1, 1, 0))                             AS controls_alt,
    SUM(IF((sp.super_population <> 'EAS' OR sp.super_population IS NULL)
           AND allele = 0, 1, 0))                             AS controls_ref
  FROM
    `bigquery-public-data.human_genome_variants.1000_genomes_variants` AS v
  JOIN
    UNNEST(v.call)                      AS c
  LEFT JOIN
    sample_pop                          AS sp
  ON
    sp.sample_id = c.call_set_name
  JOIN
    UNNEST(c.genotype)                  AS allele
  WHERE
    v.reference_name = '12'
    AND allele IN (0, 1)                -- ignore missing / multi‑allelic codes
  GROUP BY
    start_pos,
    end_pos
),
counts_with_exp AS (
  /* Add row/column/overall totals and keep variants
     whose expected counts in every cell are ≥ 5          */
  SELECT
    *,
    (cases_alt + cases_ref)                AS row_cases,
    (controls_alt + controls_ref)          AS row_ctrls,
    (cases_alt + controls_alt)             AS col_alt,
    (cases_ref + controls_ref)             AS col_ref,
    (cases_alt + cases_ref + controls_alt + controls_ref) AS n
  FROM
    variant_counts
  WHERE
    (cases_alt + cases_ref + controls_alt + controls_ref) > 0
    AND (cases_alt + controls_alt) * (cases_alt + cases_ref) / 
        (cases_alt + cases_ref + controls_alt + controls_ref) >= 5
    AND (cases_ref + controls_ref) * (cases_alt + cases_ref) / 
        (cases_alt + cases_ref + controls_alt + controls_ref) >= 5
    AND (cases_alt + controls_alt) * (controls_alt + controls_ref) / 
        (cases_alt + cases_ref + controls_alt + controls_ref) >= 5
    AND (cases_ref + controls_ref) * (controls_alt + controls_ref) / 
        (cases_alt + cases_ref + controls_alt + controls_ref) >= 5
),
chi_sq AS (
  /* Yates‑corrected χ² statistic for each remaining variant */
  SELECT
    start_pos,
    end_pos,
    cases_alt    AS a,
    cases_ref    AS b,
    controls_alt AS c,
    controls_ref AS d,
    (cases_alt + cases_ref + controls_alt + controls_ref) AS n,
    ( (cases_alt + cases_ref + controls_alt + controls_ref) *
      POW(
        GREATEST(0.0, ABS(cases_alt * controls_ref - cases_ref * controls_alt) -
                 (cases_alt + cases_ref + controls_alt + controls_ref) / 2.0),
        2
      )
    ) /
    ( (cases_alt + cases_ref) *
      (controls_alt + controls_ref) *
      (cases_alt + controls_alt) *
      (cases_ref + controls_ref) )                            AS chi_squared
  FROM
    counts_with_exp
)
SELECT
  start_pos  AS start_position,
  end_pos    AS end_position,
  chi_squared
FROM
  chi_sq
WHERE
  chi_squared >= 29.71679
ORDER BY
  chi_squared DESC,
  start_position;
