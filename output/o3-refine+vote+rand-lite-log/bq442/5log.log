```sql
WITH parsed_trades AS (
  SELECT
    -- 1. Unique identifier for the trade
    OrderID                                                AS tradeID,

    -- 2. Maturity date of the trade
    MaturityDate                                           AS tradeTimestamp,

    -- 3. Algorithm derived from the first four characters of TargetCompID
    CASE
      WHEN SUBSTR(TargetCompID, 1, 4) = 'MOMO' THEN 'Momentum'
      WHEN SUBSTR(TargetCompID, 1, 4) = 'LUCK' THEN 'Feeling Lucky'
      WHEN SUBSTR(TargetCompID, 1, 4) = 'PRED' THEN 'Prediction'
      ELSE 'Unknown'
    END                                                   AS algorithm,

    -- 4. Trading symbol
    Symbol                                                 AS symbol,

    -- 5. Opening price (rounded to 4 decimals)
    ROUND(LastPx, 4)                                       AS openPrice,

    -- 6. Closing price (rounded to 4 decimals)
    ROUND(StrikePrice, 4)                                  AS closePrice,

    -- 7. Trade direction from nested Sides array
    side_struct.Side                                       AS tradeDirection,

    -- 8. Multiplier derived from direction
    CASE
      WHEN side_struct.Side = 'SHORT' THEN -1
      WHEN side_struct.Side = 'LONG'  THEN  1
      ELSE NULL
    END                                                   AS tradeMultiplier
  FROM
    `bigquery-public-data.cymbal_investments.trade_capture_report`
  CROSS JOIN
    UNNEST(Sides) AS side_struct
)

SELECT *
FROM parsed_trades
ORDER BY
  closePrice DESC,           -- primary sort: highest closing prices
  tradeID                    -- secondary sort to make ordering deterministic
LIMIT 6;
```
